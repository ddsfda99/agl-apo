0\u2192            serializer = JsonSerializer()\n   451\u2192\n   452\u2192            task_def = TaskDefinition(**message.data or {})\n   453\u2192            event = serializer.deserialize(task_def.input)\n   454\u2192            async with self.lock:\n   455\u2192                self._events_buffer[task_def.task_id].put_nowait(event)\n   456\u2192\n   457\u2192        else:\n   458\u2192            raise ValueError(f\"Unhandled action: {message.action}\")\n   459\u2192\n   460\u2192    def as_consumer(self, remote: bool = False) -> BaseMessageQueueConsumer:\n   461\u2192        \"\"\"Get the consumer for the message queue.\n   462\u2192\n   463\u2192        Args:\n   464\u2192            remote (bool):\n   465\u2192                Whether the consumer is remote. Defaults to False.\n   466\u2192                If True, the consumer will be a RemoteMessageConsumer that uses the `process_message` endpoint.\n   467\u2192        \"\"\"\n   468\u2192        if remote:\n   469\u2192            url = (\n   470\u2192                f\"http://{self.host}:{self.port}{self._app.url_path_for('process_message')}\"\n   471\u2192                if self.port\n   472\u2192                else f\"http://{self.host}{self._app.url_path_for('process_message')}\"\n   473\u2192            )\n   474\u2192            return RemoteMessageConsumer(\n   475\u2192                id_=self.publisher_id,\n   476\u2192                url=url,\n   477\u2192                message_type=self.service_name,\n   478\u2192            )\n   479\u2192\n   480\u2192        return CallableMessageConsumer(\n   481\u2192            id_=self.publisher_id,\n   482\u2192            message_type=self.service_name,\n   483\u2192            handler=self.process_message,\n   484\u2192        )\n   485\u2192\n   486\u2192    async def launch_local(self) -> asyncio.Task:\n   487\u2192        \"\"\"Launch the service in-process.\"\"\"\n   488\u2192        logger.info(f\"{self.service_name} launch_local\")\n   489\u219