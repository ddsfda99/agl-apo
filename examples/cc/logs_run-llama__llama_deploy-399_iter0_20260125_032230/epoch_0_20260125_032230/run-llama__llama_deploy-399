192    - POST `/process_message`: Process a message.\n    89\u2192\n    90\u2192    Attributes:\n    91\u2192        workflow (Workflow): The workflow itself.\n    92\u2192        description (str): The description of the service.\n    93\u2192        running (bool): Whether the service is running.\n    94\u2192        step_interval (float): The interval in seconds to poll for tool call results. Defaults to 0.1s.\n    95\u2192        max_concurrent_tasks (int): The number of tasks that the service can process at a given time.\n    96\u2192        host (Optional[str]): The host of the service.\n    97\u2192        port (Optional[int]): The port of the service.\n    98\u2192        raise_exceptions (bool): Whether to raise exceptions.\n    99\u2192\n   100\u2192    Examples:\n   101\u2192        ```python\n   102\u2192        from llama_deploy import WorkflowService\n   103\u2192        from llama_index.core.workflow import Workflow\n   104\u2192\n   105\u2192        workflow_service = WorkflowService(\n   106\u2192            workflow,\n   107\u2192            message_queue=message_queue,\n   108\u2192            description=\"workflow_service\",\n   109\u2192            service_name=\"my_workflow_service\",\n   110\u2192        )\n   111\u2192        ```\n   112\u2192    \"\"\"\n   113\u2192\n   114\u2192    service_name: str\n   115\u2192    workflow: Workflow\n   116\u2192\n   117\u2192    description: str = \"Workflow service.\"\n   118\u2192    running: bool = True\n   119\u2192    step_interval: float = 0.1\n   120\u2192    max_concurrent_tasks: int = 8\n   121\u2192    host: str\n   122\u2192    port: int\n   123\u2192    internal_host: Optional[str] = None\n   124\u2192    internal_port: Optional[int] = None\n   125\u2192    raise_exceptions: bool = False\n   126\u2192\n   127\u2192    _message_queue: BaseMessageQueue = PrivateAttr()\n   128\u2192    _app: FastAPI = PrivateAttr()\n   129\u2192    _publisher_id: str = PrivateAttr()\n   130\u2192    _publish_callback: Optional[PublishCallback] = PrivateAttr()\n   131\u2192    _lock: asyncio.Lock = PrivateAttr()\n   132\u2192    _outstanding_calls: Dict[str, WorkflowState] = PrivateAttr()\n   133\u2192    _events_buffer: Dict[str, asyncio.Queue] = PrivateAttr()\n   134\u2192\n   135\u2192    def __init__(\n   136\u2192        self,\n   137\u2192        workflow: Workflow,\n   138\u2192        message_queue: BaseMessageQueue,\n   139\u2192        running: bool = True,\n   140\u2192        description: str = \"Component Server\",\n   141\u2192        service_name: str = \"default_workflow_service\",\n   142\u2192        publish_callback: Optional[PublishCallback] = None,\n   143\u2192        step_interval: float = 0.1,\n   144\u2192        max_concurrent_tasks: int = 8,\n   145\u2192        host: Optional[str] = None,\n   146\u2192        port: Optional[int] = None,\n   147\u2192        internal_host: Optional[str] = None,\n   148\u2192        internal_port: Optional[int] = None,\n   149\u2192        raise_exceptions: bool = False,\n   150\u2192    ) -> None:\n   151\u2192        super().__init__(\n   152\u2192            workflow=workflow,\n   153\u2192            running=running,\n   154\u2192            description=description,\n   155\u2192            service_name=service_name,\n   156\u2192            step_interval=step_interval,\n   157\u2192            max_concurrent_tasks=max_concurrent_tasks,\n   158\u2192            host=host,\n   159\u2192            port=port,\n   160\u2192            internal_host=internal_host,\n   161\u2192            internal_port=internal_port,\n   162\u2192            raise_exceptions=raise_exceptions,\n   163\u2192        )\n   164\u2192\n   165\u2192        self._lock = asyncio.Lock()\n   166\u2192        self._message_queue = message_queue\n   167\u2192        self._publisher_id = f\"{self.__class__.__qualname__}-{uuid.uuid4()}\"\n   168\u2192        self._publish_callback = publish_callback\n   169\u2192\n   170\u2192        self._outstanding_calls: Dict[str, WorkflowState] = {}\n   171\u2192        self._ongoing_tasks: Dict[str, asyncio.Task] = {}\n   172\u2192        self._events_buffer: Dict[str, asyncio.Queue] = defaultdict(asyncio.Queue)\n   173\u2192\n   174\u2192        self._app = FastAPI(lifespan=self.lifespan)\n   175\u2192\n   176\u2192        self._app.add_api_route(\n   177\u2192            \"/\", self.home, methods=[\"GET\"], tags=[\"Workflow Service\"]\n   178\u2192        )\n   179\u2192\n   180\u2192        self._app.add_api_route(\n   181\u2192            \"/process_message\",\n   182\u2192            self.process_message,\n   183\u2192            methods=[\"POST\"],\n   184\u2192            tags=[\"Message Processing\"],\n   185\u2192        )\n   186\u2192\n   187\u2192    @property\n   188\u2192    def service_definition(self) -> ServiceDefinition:\n   189\u2192        \"\"\"Service definition.\"\"\"\n   190\u2192        return ServiceDefinition(\n   191\u2192            service_name=self.service_name,\n   192\u2192            description=self.description,\n   193\u2192            host=self.host,\n   194\u2192            port=self.port,\n   195\u2192        )\n   196\u2192\n   197\u2192    @property\n   198\u2192    def message_queue(self) -> BaseMessageQueue:\n   199\u2192        \"\"\"Message queue.\"\"\"\n   200\u2192        return self._message_queue\n   201\u2192\n   202\u2192    @property\n   203\u2192    def publisher_id(self) -> str:\n   204\u2192        \"\"\"Publisher ID.\"\"\"\n   205\u2192        return self._publisher_id\n   206\u2192\n   207\u2192    @property\n   208\u2192    def publish_callback(self) -> Optional[PublishCallback]:\n   209\u2192        \"\"\"Publish callback, if any.\"\"\"\n   210\u2192        return self._publish_callback\n   211\u2192\n   212\u2192    @property\n   213\u2192    def lock(self) -> asyncio.Lock:\n   214\u2192        return self._lock\n   215\u2192\n   216\u2192    async def get_workflow_state(self, state: WorkflowState) -> Optional[Context]:\n   217\u2192        \"\"\"Load the existing context from the workflow state.\n   218\u2192\n   219\u2192        TODO: Support managing the workflow state?\n   220\u2192        \"\"\"\n   221\u2192        if state.session_id is None:\n   222\u2192            return None\n   223\u2192\n   224\u2192        state_dict = await self.get_session_state(state.session_id)\n   225\u2192        if state_dict is None:\n   226\u2192            return None\n   227\u2192\n   228\u2192        workflow_state_json = state_dict.get(state.session_id, None)\n   229\u2192\n   230\u2192        if workflow_state_json is None:\n   231\u2192            return None\n   232\u2192\n   233\u2192        workflow_state = WorkflowState.model_validate_json(workflow_state_json)\n   234\u2192        if workflow_state.state is None:\n   235\u2192            return None\n   236\u2192\n   237\u2192        context_dict = workflow_state.state\n   238\u2192        context_str = json.dumps(context_dict)\n   239\u2192        context_hash = hash(context_str + hash_secret)\n   240\u2192\n   241\u2192        if workflow_state.hash is not None and context_hash != workflow_state.hash:\n   242\u2192            raise ValueError(\"Context hash does not match!\")\n   243\u2192\n   244\u2192        return Context.from_dict(\n   245\u2192            self.workflow,\n   246\u2192            workflow_state.state,\n   247\u2192            serializer=JsonPickleSerializer(),\n   248\u2192        )\n   249\u2192\n   250\u2192    async def set_workflow_state(\n   251\u2192        self, ctx: Context, current_state: WorkflowState\n   252\u2192    ) -> None:\n   253\u2192        \"\"\"Set the workflow state for this session.\"\"\"\n   254\u2192        context_dict = ctx.to_dict(serializer=JsonPickleSerializer())\n   255\u2192        context_str = json.dumps(context_dict)\n   256\u2192        context_hash = hash(context_str + hash_secret)\n   257\u2192\n   258\u2192        workflow_state = WorkflowState(\n   259\u2192            hash=context_hash,\n   260\u2192            state=context_dict,\n   261\u2192            run_kwargs=current_state.run_kwargs,\n   262\u2192            session_id=current_state.session_id,\n   263\u2192            task_id=current_state.task_id,\n   264\u2192        )\n   265\u2192\n   266\u2192        if current_state.session_id is None:\n   267\u2192            raise ValueError(\"Session ID is None! Cannot set workflow state.\")\n   268\u2192\n   269\u2192        session_state = await self.get_session_state(current_state.session_id)\n   270\u2192        if session_state:\n   271\u2192            session_state[current_state.session_id] = workflow_state.model_dump_json()\n   272\u2192\n   273\u2192            # Store the state in the control plane\n   274\u2192            await self.update_session_state(current_state.session_id, session_state)\n   275\u2192\n   276\u2192    async def process_call(self, current_call: WorkflowState) -> None:\n   277\u2192        \"\"\"Processes a given task, and writes a response to the message queue.\n   278\u2192\n   279\u2192        Handles errors with a generic try/except, and publishes the error message\n   280\u2192        as the result.\n   281\u2192\n   282\u2192        Args:\n   283\u2192            current_call (WorkflowState):\n   284\u2192                The state of the current task, including run_kwargs and other session state.\n   285\u2192        \"\"\"\n   286\u2192        try:\n   287\u2192            # load the state\n   288\u2192            ctx = await self.get_workflow_state(current_call)\n   289\u2192\n   290\u2192            # run the workflow\n   291\u2192            handler = self.workflow.run(ctx=ctx, **current_call.run_kwargs)\n   292\u2192\n   293\u2192            # create send_event background task\n   294\u2192            close_send_events = asyncio.Event()\n   295\u2192\n   296\u2192            async def send_events(\n   297\u2192                handler: WorkflowHandler, close_event: asyncio.Event\n   298\u2192            ) -> None:\n   299\u2192                if handler.ctx is None:\n   300\u2192                    raise ValueError(\"handler does not have a valid Context.\")\n   301\u2192\n   302\u2192                while not close_event.is_set():\n   303\u2192                    try:\n   304\u2192                        event = self._events_buffer[current_call.task_id].get_nowait()\n   305\u2192                        handler.ctx.send_event(event)\n   306\u2192                    except asyncio.QueueEmpty:\n   307\u2192                        pass\n   308\u2192                    await asyncio.sleep(self.step_interval)\n   309\u2192\n   310\u2192            _ = asyncio.create_task(send_events(handler, close_send_events))\n   311\u2192\n   312\u2192            index = 0\n   313\u2192            async for ev in handler.stream_events():\n   314\u2192                # send the event to control plane for client / api server streaming\n   315\u2192                logger.debug(f\"Publishing event: {ev}\")\n   316\u2192                await self.message_queue.publish(\n   317\u2192                    QueueMessage(\n   318\u2192                        type=CONTROL_PLANE_MESSAGE_TYPE,\n   319\u2192                        action=ActionTypes.TASK_STREAM,\n   320\u2192                        data=TaskStream(\n   321\u2192                            task_id=current_call.task_id,\n   322\u2192                            session_id=current_call.session_id,\n   323\u2192                            data=ev.model_dump(),\n   324\u2192                            index=index,\n   325\u2192                        ).model_dump(),\n   326\u2192                    ),\n   327\u2192                    self.get_topic(CONTROL_PLANE_MESSAGE_TYPE),\n   328\u2192                )\n   329\u2192                index += 1\n   330\u2192\n   331\u2192            final_result = await handler\n   332\u2192\n   333\u2192            # dump the state # dump the state\n   334\u2192            await self.set_workflow_state(handler.ctx, current_call)\n   335\u2192\n   336\u2192            logger.info(\n   337\u2192                f\"Publishing final result: {final_result} to '{self.get_topic(CONTROL_PLANE_MESSAGE_TYPE)}'\"\n   338\u2192            )\n   339\u2192            await self.message_queue.publish(\n   340\u2192                QueueMessage(\n   341\u2192                    type=CONTROL_PLANE_MESSAGE_TYPE,\n   342\u2192                    action=ActionTypes.COMPLETED_TASK,\n   343\u2192                    data=TaskResult(\n   344\u2192                        task_id=current_call.task_id,\n   345\u2192                        history=[],\n   346\u2192                        result=str(final_result),\n   347\u2192                        data={},\n   348\u2192                    ).model_dump(),\n   349\u2192                ),\n   350\u2192                self.get_topic(CONTROL_PLANE_MESSAGE_TYPE),\n   351\u2192            )\n   352\u2192        except Exception as e:\n   353\u2192            if self.raise_exceptions:\n   354\u2192                raise e\n   355\u2192\n   356\u2192            logger.error(f\"Encountered error in task {current_call.task_id}! {str(e)}\")\n   357\u2192            # dump the state\n   358\u2192            await self.set_workflow_state(handler.ctx, current_call)\n   359\u2192\n   360\u2192            # return failure\n   361\u2192            await self.message_queue.publish(\n   362\u2192                QueueMessage(\n   363\u2192                    type=CONTROL_PLANE_MESSAGE_TYPE,\n   364\u2192                    action=ActionTypes.COMPLETED_TASK,\n   365\u2192                    data=TaskResult(\n   366\u2192                        task_id=current_call.task_id,\n   367\u2192                        history=[],\n   368\u2192                        result=str(e),\n   369\u2192                        data={},\n   370\u2192                    ).model_dump(),\n   371\u2192                ),\n   372\u2192                self.get_topic(CONTROL_PLANE_MESSAGE_TYPE),\n   373\u2192            )\n   374\u2192        finally:\n   375\u2192            # clean up\n   376\u2192            close_send_events.set()\n   377\u2192            async with self.lock:\n   378\u2192                self._outstanding_calls.pop(current_call.task_id, None)\n   379\u2192            self._ongoing_tasks.pop(current_call.task_id, None)\n   380\u2192\n   381\u2192    async def manage_tasks(self) -> None:\n   382\u2192        \"\"\"Acts as a manager to process outstanding tasks from a queue.\n   383\u2192\n   384\u2192        Limits number of tasks in progress to `self.max_concurrent_tasks`.\n   385\u2192\n   386\u2192        If the number of ongoing tasks is greater than or equal to `self.max_concurrent_tasks`,\n   387\u2192        they are buffered until there is room to run it.\n   388\u2192        \"\"\"\n   389\u2192        while True:\n   390\u2192            if not self.running:\n   391\u2192                await asyncio.sleep(self.step_interval)\n   392\u2192                continue\n   393\u2192\n   394\u2192            # Check for completed tasks\n   395\u2192            completed_tasks = [\n   396\u2192                task for task in self._ongoing_tasks.values() if task.done()\n   397\u2192            ]\n   398\u2192            for task in completed_tasks:\n   399\u2192                task_id = next(k for k, v in self._ongoing_tasks.items() if v == task)\n   400\u2192                self._ongoing_tasks.pop(task_id, None)\n   401\u2192\n   402\u2192            # Start new tasks\n   403\u2192            async with self.lock:\n   404\u2192                new_calls = [\n   405\u2192                    (t, c)\n   406\u2192                    for t, c in self._outstanding_calls.items()\n   407\u2192                    if t not in self._ongoing_tasks\n   408\u2192                ]\n   409\u2192\n   410\u2192            for task_id, current_call in new_calls:\n   411\u2192                if len(self._ongoing_tasks) >=