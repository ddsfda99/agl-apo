                 or kwargs.pop(\"epic_colour\", None)\n   276\u2192                    or \"green\"  # Default color\n   277\u2192                )\n   278\u2192\n   279\u2192                # Store for post-creation update\n   280\u2192                kwargs[\"__epic_color_field\"] = epic_color_field\n   281\u2192                kwargs[\"__epic_color_value\"] = epic_color\n   282\u2192                logger.info(\n   283\u2192                    f\"Storing Epic Color ({epic_color_field}: {epic_color}) for post-creation update\"\n   284\u2192                )\n   285\u2192\n   286\u2192            # Store any other epic-related fields for later update\n   287\u2192            for key, value in list(kwargs.items()):\n   288\u2192                if key.startswith(\"epic_\") and key in field_ids:\n   289\u2192                    field_key = key.replace(\"epic_\", \"\")\n   290\u2192                    # Store for post-creation update\n   291\u2192                    kwargs[f\"__epic_{field_key}_field\"] = field_ids[key]\n   292\u2192                    kwargs[f\"__epic_{field_key}_value\"] = value\n   293\u2192                    logger.info(\n   294\u2192                        f\"Storing Epic field ({field_ids[key]} from {key}: {value}) for post-creation update\"\n   295\u2192                    )\n   296\u2192                    kwargs.pop(key)  # Remove from kwargs to avoid duplicate processing\n   297\u2192\n   298\u2192            # Warn if epic_name field is required but wasn't discovered\n   299\u2192            if not epic_name_field:\n   300\u2192                logger.warning(\n   301\u2192                    \"Could not find Epic Name field ID. Epic creation may fail. \"\n   302\u2192                    \"Consider setting it explicitly in your kwargs.\"\n   303\u2192                )\n   304\u2192\n   305\u2192        except Exception as e:\n   306\u2192            logger.error(f\"Error preparing Epic-specific fields: {str(e)}\")\n   307\u2192\n   308\u2192    def _get_epic_name_field_id(self, field_ids: dict[str, str]) -> str | None:\n   309\u2192        \"\"\"\n   310\u2192        Get the field ID for Epic Name, using multiple strategies.\n   311\u2192\n   312\u2192        Args:\n   313\u2192            field_ids: Dictionary of field IDs\n   314\u2192\n   315\u2192        Returns:\n   316\u2192            The field ID for Epic Name if found, None otherwise\n   317\u2192        \"\"\"\n   318\u2192        # Strategy 1: Check if already discovered by get_jira_field_ids\n   319\u2192        if \"epic_name\" in field_ids:\n   320\u2192            return field_ids[\"epic_name\"]\n   321\u2192        if \"Epic Name\" in field_ids:\n   322\u2192            return field_ids[\"Epic Name\"]\n   323\u2192\n   324\u2192        # Strategy 2: Check common field IDs used across different Jira instances\n   325\u2192        common_ids = [\"customfield_10011\", \"customfield_10005\", \"customfield_10004\"]\n   326\u2192        for field_id in common_ids:\n   327\u2192            if field_id in field_ids.values():\n   328\u2192                logger.debug(f\"Using common Epic Name field ID: {field_id}\")\n   329\u2192                return field_id\n   330\u2192\n   331\u2192        # Strategy 3: Try to find by dynamic name pattern in available fields\n   332\u2192        for key, value in field_ids.items():\n   333\u2192            if (\n   334\u2192                \"epic\" in key.lower() and \"name\" in key.lower()\n   335\u2192            ) or \"epicname\" in key.lower():\n   336\u2192                logger.debug(f\"Found potential Epic Name field by pattern: {value}\")\n   337\u2192                return value\n   338\u2192\n   339\u2192        logger.debug(\"Could not determine Epic Name field ID\")\n   340\u2192        return None\n   341\u2192\n   342\u2192    def _get_epic_color_field_id(self, field_ids: dict[str, str]) -> str | None:\n   343\u2192        \"\"\"\n   344\u2192        Get the field ID for Epic Color, using multiple strategies.\n   345\u2192\n   346\u2192        Args:\n   347\u2192            field_ids: Dictionary of field IDs\n   348\u2192\n   349\u2192        Returns:\n   350\u2192            The field ID for Epic Color if found, None otherwise\n   351\u2192        \"\"\"\n   352\u2192        # Strategy 1: Check if already discovered by get_jira_field_ids\n   353\u2192        if \"epic_color\" in field_ids:\n   354\u2192            return field_ids[\"epic_color\"]\n   355\u2192        if \"epic_colour\" in field_ids:\n   356\u2192            return field_ids[\"epic_colour\"]\n   357\u2192\n   358\u2192        # Strategy 2: Check common field IDs\n   359\u2192        common_ids = [\"customfield_10012\", \"customfield_10013\"]\n   360\u2192        for field_id in common_ids:\n   361\u2192            if field_id in field_ids.values():\n   362\u2192                logger.debug(f\"Using common Epic Color field ID: {field_id}\")\n   363\u2192                return field_id\n   364\u2192\n   365\u2192        # Strategy 3: Find by dynamic name pattern\n   366\u2192        for key, value in field_ids.items():\n   367\u2192            if \"epic\" in key.lower() and (\n   368\u2192                \"color\" in key.lower() or \"colour\" in key.lower()\n   369\u2192            ):\n   370\u2192                logger.debug(f\"Found potential Epic Color field by pattern: {value}\")\n   371\u2192                return value\n   372\u2192\n   373\u2192        logger.debug(\"Could not determine Epic Color field ID\")\n   374\u2192        return None\n   375\u2192\n   376\u2192    def link_issue_to_epic(self, issue_key: str, epic_key: str) -> JiraIssue:\n   377\u2192        \"\"\"\n   378\u2192        Link an existing issue to an epic.\n   379\u2192\n   380\u2192        Args:\n   381\u2192            issue_key: The key of the issue to link (e.g. 'PROJ-123')\n   382\u2192            epic_key: The key of the epic to link to (e.g. 'PROJ-456')\n   383\u2192\n   384\u2192        Returns:\n   385\u2192            JiraIssue: The updated issue\n   386\u2192\n   387\u2192        Raises:\n   388\u2192            ValueError: If the epic_key is not an actual epic\n   389\u2192            Exception: If there is an error linking the issue to the epic\n   390\u2192        \"\"\"\n   391\u2192        try:\n   392\u2192            # Verify that both issue and epic exist\n   393\u2192            issue = self.jira.get_issue(issue_key)\n   394\u2192            epic = self.jira.get_issue(epic_key)\n   395\u2192\n   396\u2192            # Check if the epic key corresponds to an actual epic\n   397\u2192            fields = epic.get(\"fields\", {})\n   398\u2192            issue_type = fields.get(\"issuetype\", {}).get(\"name\", \"\").lower()\n   399\u2192\n   400\u2192            if issue_type != \"epic\":\n   401\u2192                error_msg = f\"Error linking issue to epic: {epic_key} is not an Epic\"\n   402\u2192                raise ValueError(error_msg)\n   403\u2192\n   404\u2192            # Get the dynamic field IDs for this Jira instance\n   405\u2192            field_ids = self.get_jira_field_ids()\n   406\u2192\n   407\u2192            # Try the parent field first (if discovered or natively supported)\n   408\u2192            if \"parent\" in field_ids or \"parent\" not in field_ids:\n   409\u2192                try:\n   410\u2192                    fields = {\"parent\": {\"key\": epic_key}}\n   411\u2192                    self.jira.update_issue(\n   412\u2192                        issue_key=issue_key, update={\"fields\": fields}\n   413\u2192                    )\n   414\u2192                    logger.info(\n   415\u2192                        f\"Successfully linked {issue_key} to {epic_key} using parent field\"\n   416\u2192                    )\n   417\u2192                    return self.get_issue(issue_key)\n   418\u2192                except Exception as e:\n   419\u2192                    logger.info(\n   420\u2192                        f\"Couldn't link using parent field: {str(e)}. Trying discovered fields...\"\n   421\u2192                    )\n   422\u2192\n   423\u2192            # Try using the discovered Epic Link field\n   424\u2192            if \"epic_link\" in field_ids:\n   425\u2192                try:\n   426\u2192                    epic_link_fields: dict[str, str] = {\n   427\u2192                        field_ids[\"epic_link\"]: epic_key\n   428\u2192                    }\n   429\u2192                    self.jira.update_issue(\n   430\u2192                        issue_key=issue_key, update={\"fields\": epic_link_fields}\n   431\u2192                    )\n   432\u2192                    logger.info(\n   433\u2192                        f\"Successfully linked {issue_key} to {epic_key} using discovered epic_link field: {field_ids['epic_link']}\"\n   434\u2192                    )\n   435\u2192                    return self.get_issue(issue_key)\n   436\u2192                except Exception as e:\n   437\u2192                    logger.info(\n   438\u2192                        f\"Couldn't link using discovered epic_link field: {str(e)}. Trying fallback methods...\"\n   439\u2192                    )\n   440\u2192\n   441\u2192            # Fallback to common custom fields if dynamic discovery didn't work\n   442\u2192            custom_field_attempts: list[dict[str, str]] = [\n   443\u2192                {\"customfield_10014\": epic_key},  # Common in Jira Cloud\n   444\u2192                {\"customfield_10008\": epic_key},  # Common in Jira Server\n   445\u2192                {\"customfield_10000\": epic_key},  # Also common\n   446\u2192                {\"customfield_11703\": epic_key},  # Known from previous error\n   447\u2192                {\"epic_link\": epic_key},  # Sometimes used\n   448\u2192            ]\n   449\u2192\n   450\u2192            for fields in custom_field_attempts:\n   451\u2192                try:\n   452\u2192                    self.jira.update_issue(\n   453\u2192                        issue_key=issue_key, update={\"fields\": fields}\n   454\u2192                    )\n   455\u2192                    field_id = list(fields.keys())[0]\n   456\u2192                    logger.info(\n   457\u2192                        f\"Successfully linked {issue_key} to {epic_key} using field: {field_id}\"\n   458\u2192                    )\n   459\u2192\n   460\u2192                    # If we get here, it worked - update our cached field ID\n   461\u2192                    if not hasattr(self, \"_field_ids_cache\"):\n   462\u2192                        self._field_ids_cache = {}\n   463\u2192                    self._field_ids_cache[\"epic_link\"] = field_id\n   464\u2192                    return self.get_issue(issue_key)\n   465\u2192                except Exception as e:\n   466\u2192                    logger.info(f\"Couldn't link using fields {fields}: {str(e)}\")\n   467\u2192                    continue\n   468\u2192\n   469\u2192            # Method 2: Try to use direct issue linking (relates to, etc.)\n   470\u2192            try:\n   471\u2192                logger.info(\n   472\u2192                    f\"Attempting to create issue link between {issue_key} and {epic_key}\"\n   473\u2192                )\n   474\u2192                link_data = {\n   475\u2192                    \"type\": {\"name\": \"Relates to\"},\n   476\u2192                    \"inwardIssue\": {\"key\": issue_key},\n   477\u2192                    \"outwardIssue\": {\"key\": epic_key},\n   478\u2192                }\n   479\u2192                self.jira.create_issue_link(link_data)\n   480\u2192                logger.info(\n   481\u2192                    f\"Created relationship link between {issue_key} and {epic_key}\"\n   482\u2192                )\n   483\u2192                return self.get_issue(issue_key)\n   484\u2192            except Exception as link_error:\n   485\u2192                logger.error(f\"Error creating issue link: {str(link_error)}\")\n   486\u2192\n   487\u2192            # If we get here, none of our attempts worked\n   488\u2192            raise ValueError(\n   489\u2192                f\"Could not link issue {issue_key} to epic {epic_key}. Your Jira instance might use a different field for epic links.\"\n   490\u2192            )\n   491\u2192\n   492\u2192        except ValueError as e:\n   493\u2192            # Re-raise ValueError as is\n   494\u2192            raise\n   495\u2192        except Exception as e:\n   496\u2192            logger.error(f\"Error linking {issue_key} to epic {epic_key}: {str(e)}\")\n   497\u2192            # Ensure exception messages follow the expected format for tests\n   498\u2192            if \"API error\" in str(e):\n   499\u2192                raise Exception(f\"Error linking issue to epic: {str(e)}\")\n   500\u2192            raise\n   501\u2192\n   502\u2192    def get_epic_issues(\n   503\u2192        self, epic_key: str, start: int = 0, limit: int = 50\n   504\u2192    ) -> list[JiraIssue]:\n   505\u2192        \"\"\"\n   506\u2192        Get all issues linked to a specific epic.\n   507\u2192\n   508\u2192        Args:\n   509\u2192            epic_key: The key of the epic (e.g. 'PROJ-123')\n   510\u2192            start: Starting index for pagination\n   511\u2192            limit: Maximum number of issues to return\n   512\u2192\n   513\u2192        Returns:\n   514\u2192            List of JiraIssue models representing the issues linked to the epic\n   515\u2192\n   516\u2192        Raises:\n   517\u2192            ValueError: If the issue is not an Epic\n   518\u2192            Exception: If there is an error getting epic issues\n   519\u2192        \"\"\"\n   520\u2192        try:\n   521\u2192            # First, check if the issue is an Epic\n   522\u2192            epic = self.jira.get_issue(epic_key)\n   523\u2192            fields_data = epic.get(\"fields\", {})\n   524\u2192\n   525\u2192            # Safely check if the issue is an Epic\n   526\u2192            issue_type = None\n   527\u2192            issuetype_data = fields_data.get(\"issuetype\")\n   528\u2192            if issuetype_data is not None:\n   529\u2192                issue_type = issuetype_data.get(\"name\", \"\")\n   530\u2192\n   531\u2192            if issue_type != \"Epic\":\n   532\u2192                error_msg = (\n   533\u2192                    f\"Issue {epic_key} is not an Epic, it is a \"\n   534\u2192                    f\"{issue_type or 'unknown type'}\"\n   535\u2192                )\n   536\u2192                raise ValueError(error_msg)\n   537\u2192\n   538\u2192            # Track which methods we've tried\n   539\u2192            tried_methods = set()\n   540\u2192            issues = []\n   541\u2192\n   542\u2192            # Find the Epic Link field\n   543\u2192            field_ids = self.get_jira_field_ids()\n   544\u2192            epic_link_field = self._find_epic_link_field(field_ids)\n   545\u2192\n   546\u2192            # METHOD 1: Try with 'issueFunction in issuesScopedToEpic' - this works in many Jira instances\n   547\u2192            if \"issueFunction\" not in tried_methods:\n   548\u2192                tried_methods.add(\"issueFunction\")\n   549\u2192                try:\n   550\u2192                    jql = f'issueFunction in issuesScopedToEpic(\"{epic_key}\")'\n   551\u2192                    logger.info(f\"Trying to get epic issues with issueFunction: {jql}\")\n   552\u2192\n   553\u2192                    search_result = self.search_issues(jql, start=start, limit=limit)\n   554\u2192                    if search_result:\n   555\u2192                        logger.info(\n   556\u2192                            f\"Successfully found {len(search_result.issues)} issues for epic {epic_key} using issueFunction\"\n   557\u2192                        )\n   558\u2192                        return search_result.issues\n   559\u2192                except Exception as e:\n   560\u2192                    # Log exception but continue with fallback\n   561\u2192                    logger.warning(\n   562\u2192                        f\"Error searching epic issues with issueFunction: {str(e)}\"\n   563\u2192                    )\n   564\u2192\n   565\u2192            # METHOD 2: Try using parent relationship - common in many Jira setups\n   566\u2192            if \"parent\" not in tried_methods:\n   567\u2192                tried_methods.add(\"parent\")\n   568\u2192                try:\n   569\u2192                    jql = f'parent = \"{epic_key}\"'\n   570\u2192                    logger.info(\n   571\u2192                        f\"Trying to get epic issues with parent relationship: {jql}\"\n   572\u2192                    )\n   573\u2192                    issues = self._get_epic_issues_by_jql(epic_key, jql, start, limit)\n   574\u2192                    if issues:\n   575\u2192                        logger.info(\n   576\u2192                            f\"Successfully found {len(issues)} issues for epic {epic_key} using parent relationship\"\n   577\u2192                        )\n   578\u2192                        return issues\n   579\u2192                except Exception as parent_error:\n   580\u2192                    logger.warning(\n   581\u2192                        f\"Error with parent relationship approach: {str(parent_error)}\"\n   582\u2192                    )\n   583\u2192\n   584\u2192            # METHOD 3: If we found an Epic Link field, try using it\n   585\u2192            if epic_link_field and \"epicLinkField\" not in tried_methods:\n   586\u2192                tried_methods.add(\"epicLinkField\")\n   587\u2192                try:\n   588\u2192                    jql = f'\"{epic_link_field}\" = \"{epic_key}\"'\n   589\u2192                    logger.info(\n   590\u2192                        f\"Trying to get epic issues with epic link field: {jql}\"\n   591\u2192                    )\n   592\u2192                    issues = self._get