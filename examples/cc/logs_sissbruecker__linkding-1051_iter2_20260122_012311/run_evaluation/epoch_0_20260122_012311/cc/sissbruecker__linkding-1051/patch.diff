diff --git a/bookmarks/templatetags/shared.py b/bookmarks/templatetags/shared.py
index 5da3c1c..5f2c0e9 100644
--- a/bookmarks/templatetags/shared.py
+++ b/bookmarks/templatetags/shared.py
@@ -141,6 +141,33 @@ def render_markdown(context, markdown_text):
         renderer = context["markdown_renderer"]
 
     as_html = renderer.convert(markdown_text)
-    sanitized_html = bleach.clean(as_html, markdown_tags, markdown_attrs)
+
+    # Linkify plain URLs after markdown conversion but before sanitization.
+    # Skip existing anchors and code/pre blocks to avoid linkifying inside links or code.
+    linkified_html = bleach.linkify(as_html, skip_tags=["a", "code", "pre"])
+
+    # Ensure anchor tags and href attributes are allowed for sanitized output
+    allowed_tags = markdown_tags
+    if "a" not in allowed_tags:
+        allowed_tags = list(allowed_tags) + ["a"]
+
+    allowed_attrs = markdown_attrs
+    try:
+        # If attributes are defined per-tag
+        if isinstance(allowed_attrs, dict):
+            allowed_attrs = dict(allowed_attrs)
+            attrs_for_a = allowed_attrs.get("a", [])
+            if "href" not in attrs_for_a:
+                allowed_attrs["a"] = list(attrs_for_a) + ["href"]
+        else:
+            # Attributes are a global list
+            if "href" not in allowed_attrs:
+                allowed_attrs = list(allowed_attrs) + ["href"]
+    except Exception:
+        # Fallback: pass through original allowlist unmodified
+        allowed_attrs = markdown_attrs
+
+    # Sanitize the output to preserve the existing security model
+    sanitized_html = bleach.clean(linkified_html, allowed_tags, allowed_attrs)
 
     return mark_safe(sanitized_html)
