--- a/src/urllib3/response.py
+++ b/src/urllib3/response.py
@@ -1067,12 +1067,15 @@ class HTTPResponse(BaseHTTPResponse):
         return True
 
     def close(self) -> None:
-        if not self.closed and self._fp:
-            self._fp.close()
-
+        # Close the underlying connection first to ensure any concurrent
+        # blocking reads on another thread are interrupted by socket closure.
         if self._connection:
             self._connection.close()
 
+        # Now close the file-like object if present and not already closed.
+        if not self.closed and self._fp:
+            self._fp.close()
+
         if not self.auto_close:
             io.IOBase.close(self)
 
