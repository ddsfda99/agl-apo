u2192    return systems\n   265\u2192\n   266\u2192\n   267\u2192@pytest.fixture\n   268\u2192def dsystem_type(request, dsystem_dt):\n   269\u2192    \"\"\"Return system by typekey\"\"\"\n   270\u2192    systype = request.param\n   271\u2192    return dsystem_dt[systype]\n   272\u2192\n   273\u2192\n   274\u2192@pytest.mark.usefixtures(\"legacy_plot_signature\")\n   275\u2192@pytest.mark.parametrize(\"dsystem_dt\", [0.1, True], indirect=True)\n   276\u2192@pytest.mark.parametrize(\"dsystem_type\", ['sssiso', 'ssmimo', 'tf'],\n   277\u2192                         indirect=True)\n   278\u2192def test_discrete(dsystem_type):\n   279\u2192    \"\"\"Test discrete-time frequency response\"\"\"\n   280\u2192    dsys = dsystem_type\n   281\u2192    # Set frequency range to just below Nyquist freq (for Bode)\n   282\u2192    omega_ok = np.linspace(10e-4, 0.99, 100) * np.pi / dsys.dt\n   283\u2192\n   284\u2192    # Test frequency response\n   285\u2192    dsys.frequency_response(omega_ok)\n   286\u2192\n   287\u2192    # Check for warning if frequency is out of range\n   288\u2192    with pytest.warns(UserWarning, match=\"above.*Nyquist\"):\n   289\u2192        # Look for a warning about sampling above Nyquist frequency\n   290\u2192        omega_bad = np.linspace(10e-4, 1.1, 10) * np.pi / dsys.dt\n   291\u2192        dsys.frequency_response(omega_bad)\n   292\u2192\n   293\u2192    # Test bode plots (currently only implemented for SISO)\n   294\u2192    if (dsys.ninputs == 1 and dsys.noutputs == 1):\n   295\u2192        # Generic call (frequency range calculated automatically)\n   296\u2192        bode(dsys)\n   297\u2192\n   298\u2192        # Convert to transfer function and test bode again\n   299\u2192        systf = tf(dsys)\n   300\u2192        bode(systf)\n   301\u2192\n   302\u2192        # Make sure we can pass a frequency range\n   303\u2192        bode(dsys, omega_ok)\n   304\u2192\n   305\u2192    else:\n   306\u2192        # Calling bode should generate a not implemented error\n   307\u2192        # with pytest.raises(NotImplementedError):\n   308\u2192        # TODO: check results\n   309\u2192        bode((dsys,))\n   310\u2192\n   311\u2192\n   312\u2192@pytest.mark.usefixtures(\"legacy_plot_signature\")\n   313\u2192def test_options(editsdefaults):\n   314\u2192    \"\"\"Test ability to set parameter values\"\"\"\n   315\u2192    # Generate a Bode plot of a transfer function\n   316\u2192    sys = ctrl.tf([1000], [1, 25, 100, 0])\n   317\u2192    fig1 = plt.figure()\n   318\u2192    ctrl.bode_plot(sys, dB=False, deg=True, Hz=False)\n   319\u2192\n   320\u2192    # Save the parameter values\n   321\u2192    left1, right1 = fig1.axes[0].xaxis.get_data_interval()\n   322\u2192    numpoints1 = len(fig1.axes[0].lines[0].get_data()[0])\n   323\u2192\n   324\u2192    # Same transfer function, but add a decade on each end\n   325\u2192    ctrl.config.set_defaults('freqplot', feature_periphery_decades=2)\n   326\u2192    fig2 = plt.figure()\n   327\u2192    ctrl.bode_plot(sys, dB=False, deg=True, Hz=False)\n   328\u2192    left2, right2 = fig2.axes[0].xaxis.get_data_interval()\n   329\u2192\n   330\u2192    # Make sure we got an extra decade on each end\n   331\u2192    assert_allclose(left2, 0.1 * left1)\n   332\u2192    assert_allclose(right2, 10 * right1)\n   333\u2192\n   334\u2192    # Same transfer function, but add more points to the plot\n   335\u2192    ctrl.config.set_defaults(\n   336\u2192        'freqplot', feature_periphery_decades=2, number_of_samples=13)\n   337\u2192    fig3 = plt.figure()\n   338\u2192    ctrl.bode_plot(sys, dB=False, deg=True, Hz=False)\n   339\u2192    numpoints3 = len(fig3.axes[0].lines[0].get_data()[0])\n   340\u2192\n   341\u2192    # Make sure we got the right number of points\n   342\u2192    assert numpoints1 != numpoints3\n   343\u2192    assert numpoints3 == 13\n   344\u2192\n   345\u2192@pytest.mark.usefixtures(\"legacy_plot_signature\")\n   346\u2192@pytest.mark.parametrize(\n   347\u2192    \"TF, initial_phase, default_phase, expected_phase\",\n   348\u2192    [pytest.param(ctrl.tf([1], [1, 0]),\n   349\u2192                  None, -math.pi/2, -math.pi/2,         id=\"order1, default\"),\n   350\u2192     pytest.param(ctrl.tf([1], [1, 0]),\n   351\u2192                  180, -math.pi/2, 3*math.pi/2,         id=\"order1, 180\"),\n   352\u2192     pytest.param(ctrl.tf([1], [1, 0, 0]),\n   353\u2192                  None, -math.pi, -math.pi,             id=\"order2, default\"),\n   354\u2192     pytest.param(ctrl.tf([1], [1, 0, 0]),\n   355\u2192                  180, -math.pi, math.pi,               id=\"order2, 180\"),\n   356\u2192     pytest.param(ctrl.tf([1], [1, 0, 0, 0]),\n   357\u2192                  None, -3*math.pi/2, -3*math.pi/2,     id=\"order2, default\"),\n   358\u2192     pytest.param(ctrl.tf([1], [1, 0, 0, 0]),\n   359\u2192                  180, -3*math.pi/2, math.pi/2,         id=\"order2, 180\"),\n   360\u2192     pytest.param(ctrl.tf([1], [1, 0, 0, 0, 0]),\n   361\u2192                  None, 0, 0,                           id=\"order4, default\"),\n   362\u2192     pytest.param(ctrl.tf([1], [1, 0, 0, 0, 0]),\n   363\u2192                  180, 0, 0,                            id=\"order4, 180\"),\n   364\u2192     pytest.param(ctrl.tf([1], [1, 0, 0, 0, 0]),\n   365\u2192                  -360, 0, -2*math.pi,                  id=\"order4, -360\"),\n   366\u2192     ])\n   367\u2192def test_initial_phase(TF, initial_phase, default_phase, expected_phase):\n   368\u2192    # Check initial phase of standard transfer functions\n   369\u2192    mag, phase, omega = ctrl.bode(TF, plot=True)\n   370\u2192    assert(abs(phase[0] - default_phase) < 0.1)\n   371\u2192\n   372\u2192    # Now reset the initial phase to +180 and see if things work\n   373\u2192    mag, phase, omega = ctrl.bode(TF, initial_phase=initial_phase, plot=True)\n   374\u2192    assert(abs(phase[0] - expected_phase) < 0.1)\n   375\u2192\n   376\u2192    # Make sure everything works in rad/sec as well\n   377\u2192    if initial_phase:\n   378\u2192        plt.xscale('linear')  # avoids xlim warning on next line\n   379\u2192        plt.clf()  # clear previous figure (speeds things up)\n   380\u2192        mag, phase, omega = ctrl.bode(\n   381\u2192            TF, initial_phase=initial_phase/180. * math.pi,\n   382\u2192            deg=False, plot=True)\n   383\u2192        assert(abs(phase[0] - expected_phase) < 0.1)\n   384\u2192\n   385\u2192\n   386\u2192@pytest.mark.usefixtures(\"legacy_plot_signature\")\n   387\u2192@pytest.mark.parametrize(\n   388\u2192    \"TF, wrap_phase, min_phase, max_phase\",\n   389\u2192    [pytest.param(ctrl.tf([1], [1, 0]),\n   390\u2192                  None, -math.pi/2, 0,              id=\"order1, default\"),\n   391\u2192     pytest.param(ctrl.tf([1], [1, 0]),\n   392\u2192                  True, -math.pi, math.pi,          id=\"order1, True\"),\n   393\u2192     pytest.param(ctrl.tf([1], [1, 0]),\n   394\u2192                  -270, -3*math.pi/2, math.pi/2,    id=\"order1, -270\"),\n   395\u2192     pytest.param(ctrl.tf([1], [1, 0, 0, 0]),\n   396\u2192                  None, -3*math.pi/2, 0,            id=\"order3, default\"),\n   397\u2192     pytest.param(ctrl.tf([1], [1, 0, 0, 0]),\n   398\u2192                  True, -math.pi, math.pi,          id=\"order3, True\"),\n   399\u2192     pytest.param(ctrl.tf([1], [1, 0, 0, 0]),\n   400\u2192                  -270, -3*math.pi/2, math.pi/2,    id=\"order3, -270\"),\n   401\u2192     pytest.param(ctrl.tf([1], [1, 0, 0, 0, 0, 0]),\n   402\u2192                  True, -3*math.pi/2, 0,            id=\"order5, default\"),\n   403\u2192     pytest.param(ctrl.tf([1], [1, 0, 0, 0, 0, 0]),\n   404\u2192                  True, -math.pi, math.pi,          id=\"order5, True\"),\n   405\u2192     pytest.param(ctrl.tf([1], [1, 0, 0, 0, 0, 0]),\n   406\u2192                  -270, -3*math.pi/2, math.pi/2,    id=\"order5, -270\"),\n   407\u2192    ])\n   408\u2192def test_phase_wrap(TF, wrap_phase, min_phase, max_phase):\n   409\u2192    mag, phase, omega = ctrl.bode(TF, wrap_phase=wrap_phase, plot=True)\n   410\u2192    assert(min(phase) >= min_phase)\n   411\u2192    assert(max(phase) <= max_phase)\n   412\u2192\n   413\u2192\n   414\u2192@pytest.mark.usefixtures(\"legacy_plot_signature\")\n   415\u2192def test_phase_wrap_multiple_systems():\n   416\u2192    sys_unstable = ctrl.zpk([],[1,1], gain=1)\n   417\u2192\n   418\u2192    mag, phase, omega = ctrl.bode(sys_unstable, plot=False)\n   419\u2192    assert(np.min(phase) >= -2*np.pi)\n   420\u2192    assert(np.max(phase) <= -1*np.pi)\n   421\u2192\n   422\u2192    mag, phase, omega = ctrl.bode((sys_unstable, sys_unstable), plot=False)\n   423\u2192    assert(np.min(phase) >= -2*np.pi)\n   424\u2192    assert(np.max(phase) <= -1*np.pi)\n   425\u2192\n   426\u2192\n   427\u2192def test_freqresp_warn_infinite():\n   428\u2192    \"\"\"Test evaluation warnings for transfer functions w/ pole at the origin\"\"\"\n   429\u2192    sys_finite = ctrl.tf([1], [1, 0.01])\n   430\u2192    sys_infinite = ctrl.tf([1], [1, 0.01, 0])\n   431\u2192\n   432\u2192    # Transfer function with finite zero frequency gain\n   433\u2192    np.testing.assert_almost_equal(sys_finite(0), 100)\n   434\u2192    np.testing.assert_almost_equal(sys_finite(0, warn_infinite=False), 100)\n   435\u2192    np.testing.assert_almost_equal(sys_finite(0, warn_infinite=True), 100)\n   436\u2192\n   437\u2192    # Transfer function with infinite zero frequency gain\n   438\u2192    with pytest.warns() as record:\n   439\u2192        np.testing.assert_almost_equal(\n   440\u2192            sys_infinite(0), complex(np.inf, np.nan))\n   441\u2192    assert len(record) == 2     # generates two RuntimeWarnings\n   442\u2192    assert record[0].category is RuntimeWarning\n   443\u2192    assert re.search(\"divide by zero\", str(record[0].message))\n   444\u2192    assert record[1].category is RuntimeWarning\n   445\u2192    assert re.search(\"invalid value\", str(record[1].message))\n   446\u2192\n   447\u2192    with pytest.warns() as record:\n   448\u2192        np.testing.assert_almost_equal(\n   449\u2192            sys_infinite(0, warn_infinite=True), complex(np.inf, np.nan))\n   450\u2192    np.testing.assert_almost_equal(\n   451\u2192        sys_infinite(0, warn_infinite=False), complex(np.inf, np.nan))\n   452\u2192    assert len(record) == 2     # generates two RuntimeWarnings\n   453\u2192    assert record[0].category is RuntimeWarning\n   454\u2192    assert re.search(\"divide by zero\", str(record[0].message))\n   455\u2192    assert record[1].category is RuntimeWarning\n   456\u2192    assert re.search(\"invalid value\", str(record[1].message))\n   457\u2192\n   458\u2192    # Switch to state space\n   459\u2192    sys_finite = ctrl.tf2ss(sys_finite)\n   460\u2192    sys_infinite = ctrl.tf2ss(sys_infinite)\n   461\u2192\n   462\u2192    # State space system with finite zero frequency gain\n   463\u2192    np.testing.assert_almost_equal(sys_finite(0), 100)\n   464\u2192    np.testing.assert_almost_equal(sys_finite(0, warn_infinite=False), 100)\n   465\u2192    np.testing.assert_almost_equal(sys_finite(0, warn_infinite=True), 100)\n   466\u2192\n   467\u2192    # State space system with infinite zero frequency gain\n   468\u2192    with pytest.warns(RuntimeWarning, match=\"singular matrix\"):\n   469\u2192        np.testing.assert_almost_equal(\n   470\u2192            sys_infinite(0), complex(np.inf, np.nan))\n   471\u2192    with pytest.warns(RuntimeWarning, match=\"singular matrix\"):\n   472\u2192        np.testing.assert_almost_equal(\n   473\u2192            sys_infinite(0, warn_infinite=True), complex(np.inf, np.nan))\n   474\u2192    np.testing.assert_almost_equal(sys_infinite(\n   475\u2192        0, warn_infinite=False), complex(np.inf, np.nan))\n   476\u2192\n   477\u2192\n   478\u2192def test_dcgain_consistency():\n   479\u2192    \"\"\"Test to make sure that DC gain is consistently evaluated\"\"\"\n   480\u2192    # Set up transfer function with pole at the origin\n   481\u2192    sys_tf = ctrl.tf([1], [1, 0])\n   482\u2192    assert 0 in sys_tf.poles()\n   483\u2192\n   484\u2192    # Set up state space system with pole at the origin\n   485\u2192    sys_ss = ctrl.tf2ss(sys_tf)\n   486\u2192    assert 0 in sys_ss.poles()\n   487\u2192\n   488\u2192    # Finite (real) numerator over 0 denominator => inf + nanj\n   489\u2192    np.testing.assert_equal(\n   490\u2192        sys_tf(0, warn_infinite=False), complex(np.inf, np.nan))\n   491\u2192    np.testing.assert_equal(\n   492\u2192        sys_ss(0, warn_infinite=False), complex(np.inf, np.nan))\n   493\u2192    np.testing.assert_equal(\n   494\u2192        sys_tf(0j, warn_infinite=False), complex(np.inf, np.nan))\n   495\u2192    np.testing.assert_equal(\n   496\u2192        sys_ss(0j, warn_infinite=False), complex(np.inf, np.nan))\n   497\u2192    np.testing.assert_equal(\n   498\u2192        sys_tf.dcgain(), np.inf)\n   499\u2192    np.testing.assert_equal(\n   500\u2192        sys_ss.dcgain(), np.inf)\n   501\u2192\n   502\u2192    # Set up transfer function with pole, zero at the origin\n   503\u2192    sys_tf = ctrl.tf([1, 0], [1, 0])\n   504\u2192    assert 0 in sys_tf.poles()\n   505\u2192    assert 0 in sys_tf.zeros()\n   506\u2192\n   507\u2192    # Pole and zero at the origin should give nan + nanj for the response\n   508\u2192    np.testing.assert_equal(\n   509\u2192        sys_tf(0, warn_infinite=False), complex(np.nan, np.nan))\n   510\u2192    np.testing.assert_equal(\n   511\u2192        sys_tf(0j, warn_infinite=False), complex(np.nan, np.nan))\n   512\u2192    np.testing.assert_equal(\n   513\u2192        sys_tf.dcgain(), np.nan)\n   514\u2192\n   515\u2192    # Set up state space version\n   516\u2192    sys_ss = ctrl.tf2ss(ctrl.tf([1, 0], [1, 1])) * \\\n   517\u2192        ctrl.tf2ss(ctrl.tf([1], [1, 0]))\n   518\u2192\n   519\u2192    # Different systems give different representations => test accordingly\n   520\u2192    if 0 in sys_ss.poles() and 0 in sys_ss.zeros():\n   521\u2192        # Pole and zero at the origin => should get (nan + nanj)\n   522\u2192        np.testing.assert_equal(\n   523\u2192            sys_ss(0, warn_infinite=False), complex(np.nan, np.nan))\n   524\u2192        np.testing.assert_equal(\n   525\u2192            sys_ss(0j, warn_infinite=False), complex(np.nan, np.nan))\n   526\u2192        np.testing.assert_equal(\n   527\u2192            sys_ss.dcgain(), np.nan)\n   528\u2192    elif 0 in sys_ss.poles():\n   529\u2192        # Pole at the origin, but zero elsewhere => should get (inf + nanj)\n   530\u2192        np.testing.assert_equal(\n   531\u2192            sys_ss(0, warn_infinite=False), complex(np.inf, np.nan))\n   532\u2192        np.testing.assert_equal(\n   533\u2192            sys_ss(0j, warn_infinite=False), complex(np.inf, np.nan))\n   534\u2192        np.testing.assert_equal(\n   535\u2192            sys_ss.dcgain(), np.inf)\n   536\u2192    else:\n   537\u2192        # Near pole/zero cancellation => nothing sensible to check\n   538\u2192        pass\n   539\u2192\n   540\u2192    # Pole with non-zero, complex numerator => inf + infj\n   541\u2192    s = ctrl.tf('s')\n   542\u2192    sys_tf = (s + 1) / (s**2 + 1)\n   543\u2192    assert 1j in sys_tf.poles()\n   544\u2192\n   545\u2192    # Set up state space system with pole on imaginary axis\n   546\u2192    sys_ss = ctrl.tf2ss(sys_tf)\n   547\u2192    assert 1j in sys_tf.poles()\n   548\u2192\n   549\u2192    # Make sure we get correct response if evaluated at the pole\n   550\u2192    np.testing.assert_equal(\n   551\u2192        sys_tf(1j, warn_infinite=False), complex(np.inf, np.inf))\n   552\u2192\n   553\u2192    # For state space, numerical errors come into play\n   554\u2192    resp_ss = sys_ss(1j, warn_infinite=False)\n   555\u2192    if np.isfinite(resp_ss):\n   556\u2192        assert abs(r