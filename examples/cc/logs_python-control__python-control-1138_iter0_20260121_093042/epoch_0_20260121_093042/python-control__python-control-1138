s.\n   126→\n   127→    This class is used as the return type for control plotting functions.\n   128→    It contains the information required to access portions of the plot\n   129→    that the user might want to adjust, as well as providing methods to\n   130→    modify some of the properties of the plot.\n   131→\n   132→    A control figure consists of a `matplotlib.figure.Figure` with\n   133→    an array of `matplotlib.axes.Axes`.  Each axes in the figure has\n   134→    a number of lines that represent the data for the plot.  There may also\n   135→    be a legend present in one or more of the axes.\n   136→\n   137→    Parameters\n   138→    ----------\n   139→    lines : array of list of `matplotlib.lines.Line2D`\n   140→        Array of Line2D objects for each line in the plot.  Generally, the\n   141→        shape of the array matches the subplots shape and the value of the\n   142→        array is a list of Line2D objects in that subplot.  Some plotting\n   143→        functions will return variants of this structure, as described in\n   144→        the individual documentation for the functions.\n   145→    axes : 2D array of `matplotlib.axes.Axes`\n   146→        Array of Axes objects for each subplot in the plot.\n   147→    figure : `matplotlib.figure.Figure`\n   148→        Figure on which the Axes are drawn.\n   149→    legend : `matplotlib.legend.Legend` (instance or ndarray)\n   150→        Legend object(s) for the plot.  If more than one legend is\n   151→        included, this will be an array with each entry being either None\n   152→        (for no legend) or a legend object.\n   153→\n   154→    \"\"\"\n   155→    def __init__(self, lines, axes=None, figure=None, legend=None):\n   156→        self.lines = lines\n   157→        if axes is None:\n   158→            _get_axes = np.vectorize(lambda lines: lines[0].axes)\n   159→            axes = _get_axes(lines)\n   160→        self.axes = np.atleast_2d(axes)\n   161→        if figure is None:\n   162→            figure = self.axes[0, 0].figure\n   163→        self.figure = figure\n   164→        self.legend = legend\n   165→\n   166→    # Implement methods and properties to allow legacy interface (np.array)\n   167→    __iter__ = lambda self: self.lines\n   168→    __len__ = lambda self: len(self.lines)\n   169→    def __getitem__(self, item):\n   170→        warnings.warn(\n   171→            \"return of Line2D objects from plot function is deprecated in \"\n   172→            \"favor of ControlPlot; use out.lines to access Line2D objects\",\n   173→            category=FutureWarning)\n   174→        return self.lines[item]\n   175→    def __setitem__(self, item, val):\n   176→        self.lines[item] = val\n   177→    shape = property(lambda self: self.lines.shape, None)\n   178→    def reshape(self, *args):\n   179→        \"\"\"Reshape lines array (legacy).\"\"\"\n   180→        return self.lines.reshape(*args)\n   181→\n   182→    def set_plot_title(self, title, frame='axes'):\n   183→        \"\"\"Set the title for a control plot.\n   184→\n   185→        This is a wrapper for the matplotlib `suptitle` function, but by\n   186→        setting `frame` to 'axes' (default) then the title is centered on\n   187→        the midpoint of the axes in the figure, rather than the center of\n   188→        the figure.  This usually looks better (particularly with\n   189→        multi-panel plots), though it takes longer to render.\n   190→\n   191→        Parameters\n   192→        ----------\n   193→        title : str\n   194→            Title text.\n   195→        fig : Figure, optional\n   196→            Matplotlib figure.  Defaults to current figure.\n   197→        frame : str, optional\n   198→            Coordinate frame for centering: 'axes' (default) or 'figure'.\n   199→        **kwargs : `matplotlib.pyplot.suptitle` keywords, optional\n   200→            Additional keywords (passed to matplotlib).\n   201→\n   202→        \"\"\"\n   203→        _update_plot_title(\n   204→            title, fig=self.figure, frame=frame, use_existing=False)\n   205→\n   206→#\n   207→# User functions\n   208→#\n   209→# The functions below can be used by users to modify control plots or get\n   210→# information about them.\n   211→#\n   212→\n   213→def suptitle(\n   214→        title, fig=None, frame='axes', **kwargs):\n   215→    \"\"\"Add a centered title to a figure.\n   216→\n   217→    .. deprecated:: 0.10.1\n   218→        Use `ControlPlot.set_plot_title`.\n   219→\n   220→    \"\"\"\n   221→    warnings.warn(\n   222→        \"suptitle() is deprecated; use cplt.set_plot_title()\", FutureWarning)\n   223→    _update_plot_title(\n   224→        title, fig=fig, frame=frame, use_existing=False, **kwargs)\n   225→\n   226→\n   227→# Create vectorized function to find axes from lines\n   228→def get_plot_axes(line_array):\n   229→    \"\"\"Get a list of axes from an array of lines.\n   230→\n   231→    .. deprecated:: 0.10.1\n   232→        This function will be removed in a future version of python-control.\n   233→        Use `cplt.axes` to obtain axes for an instance of `ControlPlot`.\n   234→\n   235→    This function can be used to return the set of axes corresponding\n   236→    to the line array that is returned by `time_response_plot`.  This\n   237→    is useful for generating an axes array that can be passed to\n   238→    subsequent plotting calls.\n   239→\n   240→    Parameters\n   241→    ----------\n   242→    line_array : array of list of `matplotlib.lines.Line2D`\n   243→        A 2D array with elements corresponding to a list of lines appearing\n   244→        in an axes, matching the return type of a time response data plot.\n   245→\n   246→    Returns\n   247→    -------\n   248→    axes_array : array of list of `matplotlib.axes.Axes`\n   249→        A 2D array with elements corresponding to the Axes associated with\n   250→        the lines in `line_array`.\n   251→\n   252→    Notes\n   253→    -----\n   254→    Only the first element of each array entry is used to determine the axes.\n   255→\n   256→    \"\"\"\n   257→    warnings.warn(\n   258→        \"get_plot_axes() is deprecated; use cplt.axes()\", FutureWarning)\n   259→    _get_axes = np.vectorize(lambda lines: lines[0].axes)\n   260→    if isinstance(line_array, ControlPlot):\n   261→        return _get_axes(line_array.lines)\n   262→    else:\n   263→        return _get_axes(line_array)\n   264→\n   265→\n   266→def pole_zero_subplots(\n   267→        nrows, ncols, grid=None, dt=None, fig=None, scaling=None,\n   268→        rcParams=None):\n   269→    \"\"\"Create axes for pole/zero plot.\n   270→\n   271→    Parameters\n   272→    ----------\n   273→    nrows, ncols : int\n   274→        Number of rows and columns.\n   275→    grid : True, False, or 'empty', optional\n   276→        Grid style to use.  Can also be a list, in which case each subplot\n   277→        will have a different style (columns then rows).\n   278→    dt : timebase, option\n   279→        Timebase for each subplot (or a list of timebases).\n   280→    scaling : 'auto', 'equal', or None\n   281→        Scaling to apply to the subplots.\n   282→    fig : `matplotlib.figure.Figure`\n   283→        Figure to use for creating subplots.\n   284→    rcParams : dict\n   285→        Override the default parameters used for generating plots.\n   286→        Default is set by `config.defaults['ctrlplot.rcParams']`.\n   287→\n   288→    Returns\n   289→    -------\n   290→    ax_array : ndarray\n   291→        2D array of axes.\n   292→\n   293→    \"\"\"\n   294→    from .grid import nogrid, sgrid, zgrid\n   295→    from .iosys import isctime\n   296→\n   297→    if fig is None:\n   298→        fig = plt.gcf()\n   299→    rcParams = config._get_param('ctrlplot', 'rcParams', rcParams)\n   300→\n   301→    if not isinstance(grid, list):\n   302→        grid = [grid] * nrows * ncols\n   303→    if not isinstance(dt, list):\n   304→        dt = [dt] * nrows * ncols\n   305→\n   306→    ax_array = np.full((nrows, ncols), None)\n   307→    index = 0\n   308→    with plt.rc_context(rcParams):\n   309→        for row, col in itertools.product(range(nrows), range(ncols)):\n   310→            match grid[index], isctime(dt=dt[index]):\n   311→                case 'empty', _:        # empty grid\n   312→                    ax_array[row, col] = fig.add_subplot(nrows, ncols, index+1)\n   313→\n   314→                case True, True:        # continuous-time grid\n   315→                    ax_array[row, col], _ = sgrid(\n   316→                        (nrows, ncols, index+1), scaling=scaling)\n   317→\n   318→                case True, False:       # discrete-time grid\n   319→                    ax_array[row, col] = fig.add_subplot(nrows, ncols, index+1)\n   320→                    zgrid(ax=ax_array[row, col], scaling=scaling)\n   321→\n   322→                case False | None, _:   # no grid (just stability boundaries)\n   323→                    ax_array[row, col] = fig.add_subplot(nrows, ncols, index+1)\n   324→                    nogrid(\n   325→                        ax=ax_array[row, col], dt=dt[index], scaling=scaling)\n   326→            index += 1\n   327→    return ax_array\n   328→\n   329→\n   330→def reset_rcParams():\n   331→    \"\"\"Reset rcParams to default values for control plots.\"\"\"\n   332→    _ctrlplot_rcParams.update(rcParams_default)\n   333→\n   334→\n   335→#\n   336→# Utility functions\n   337→#\n   338→# These functions are used by plotting routines to provide a consistent way\n   339→# of processing and displaying information.\n   340→#\n   341→\n   342→def _process_ax_keyword(\n   343→        axs, shape=(1, 1), rcParams=None, squeeze=False, clear_text=False,\n   344→        create_axes=True, sharex=False, sharey=False):\n   345→    \"\"\"Process ax keyword to plotting commands.\n   346→\n   347→    This function processes the `ax` keyword to plotting commands.  If no\n   348→    ax keyword is passed, the current figure is checked to see if it has\n   349→    the correct shape.  If the shape matches the desired shape, then the\n   350→    current figure and axes are returned.  Otherwise a new figure is\n   351→    created with axes of the desired shape.\n   352→\n   353→    If `create_axes` is False and a new/empty figure is returned, then `axs`\n   354→    is an array of the proper shape but None for each element.  This allows\n   355→    the calling function to do the actual axis creation (needed for\n   356→    curvilinear grids that use the AxisArtist module).\n   357→\n   358→    Legacy behavior: some of the older plotting commands use a axes label\n   359→    to identify the proper axes for plotting.  This behavior is supported\n   360→    through the use of the label keyword, but will only work if shape ==\n   361→    (1, 1) and squeeze == True.\n   362→\n   363→    \"\"\"\n   364→    if axs is None:\n   365→        fig = plt.gcf()         # get current figure (or create new one)\n   366→        axs = fig.get_axes()\n   367→\n   368→        # Check to see if axes are the right shape; if not, create new figure\n   369→        # Note: can't actually check the shape, just the total number of axes\n   370→        if len(axs) != np.prod(shape):\n   371→            with plt.rc_context(rcParams):\n   372→                if len(axs) != 0 and create_axes:\n   373→                    # Create a new figure\n   374→                    fig, axs = plt.subplots(\n   375→                        *shape, sharex=sharex, sharey=sharey, squeeze=False)\n   376→                elif create_axes:\n   377→                    # Create new axes on (empty) figure\n   378→                    axs = fig.subplots(\n   379→                        *shape, sharex=sharex, sharey=sharey, squeeze=False)\n   380→                else:\n   381→                    # Create an empty array and let user create axes\n   382→                    axs = np.full(shape, None)\n   383→            if create_axes:     # if not creating axes, leave these to caller\n   384→                fig.set_layout_engine('tight')\n   385→                fig.align_labels()\n   386→\n   387→        else:\n   388→            # Use the existing axes, properly reshaped\n   389→            axs = np.asarray(axs).reshape(*shape)\n   390→\n   391→            if clear_text:\n   392→                # Clear out any old text from the current figure\n   393→                for text in fig.texts:\n   394→                    text.set_visible(False)     # turn off the text\n   395→                    del text                    # get rid of it completely\n   396→    else:\n   397→        axs = np.atleast_1d(axs)\n   398→        try:\n   399→            axs = axs.reshape(shape)\n   400→        except ValueError:\n   401→            raise ValueError(\n   402→                \"specified axes are not the right shape; \"\n   403→                f\"got {axs.shape} but expecting {shape}\")\n   404→        fig = axs[0, 0].figure\n   405→\n   406→    # Process the squeeze keyword\n   407→    if squeeze and shape == (1, 1):\n   408→        axs = axs[0, 0]         # Just return the single axes object\n   409→    elif squeeze:\n   410→        axs = axs.squeeze()\n   411→\n   412→    return fig, axs\n   413→\n   414→\n   415→# Turn label keyword into array indexed by trace, output, input\n   416→# TODO: move to ctrlutil.py and update parameter names to reflect general use\n   417→def _process_line_labels(label, ntraces=1, ninputs=0, noutputs=0):\n   418→    if label is None:\n   419→        return None\n   420→\n   421→    if isinstance(label, str):\n   422→        label = [label] * ntraces          # single label for all traces\n   423→\n   424→    # Convert to an ndarray, if not done already\n   425→    try:\n   426→        line_labels = np.asarray(label)\n   427→    except ValueError:\n   428→        raise ValueError(\"label must be a string or array_like\")\n   429→\n   430→    # Turn the data into a 3D array of appropriate shape\n   431→    # TODO: allow more sophisticated broadcasting (and error checking)\n   432→    try:\n   433→        if ninputs > 0 and noutputs > 0:\n   434→            if line_labels.ndim == 1 and line_labels.size == ntraces:\n   435→                line_labels = line_labels.reshape(ntraces, 1, 1)\n   436→                line_labels = np.broadcast_to(\n   437→                    line_labels, (ntraces, ninputs, noutputs))\n   438→            else:\n   439→                line_labels = line_labels.reshape(ntraces, ninputs, noutputs)\n   440→    except ValueError:\n   441→        if line_labels.shape[0] != ntraces:\n   442→            raise ValueError(\"number of labels must match number of traces\")\n   443→        else:\n   444→            raise ValueError(\"labels must be given for each input/output pair\")\n   445→\n   446→    return line_labels\n   447→\n   448→\n   449→# Get labels for all lines in an axes\n   450→def _get_line_labels(ax, use_color=True):\n   451→    labels_colors, lines = [], []\n   452→    last_color, counter = None, 0       # label unknown systems\n   453→    for i, line in enumerate(ax.get_lines()):\n   454→        label = line.get_label()\n   455→        color = line.get_color()\n   456→        if use_color and label.startswith(\"Unknown\"):\n   457→            label = f\"Unknown-{counter}\"\n   458→            if last_color != color:\n   459→                counter += 1\n   460→            last_color = color\n   461→        elif label[0] == '_':\n   462→            continue\n   463→\n   464→        if (label, color) not in labels_colors:\n   465→            lines.append(line)\n   466→            labels_colors.append((label, color))\n   467→\n   468→    return lines, [label for label, color in labels_colors]\n   469→\n   470→\n   471→def _process_legend_keywords(\n   472→        kwargs, shape=None, default_loc='center right'):\n   473→    legend_loc = kwargs.pop('legend_loc', None)\n   474→    if shape is None and 'legend_map' in kwargs:\n   475→        raise TypeError(\"unexpected keyword argument 'legend_map'\")\n   476→    else:\n   477→        legend_map = kwargs.pop('legend_map', None)\n   478→    show_legend = kwargs.pop('show_legend', None)\n   479→\n   480→    # If legend_loc or legend_map were given, always show the legend\n   481→    if legend_loc is False or legend_map is False:\n   482→        if show_legend is True:\n   483→            warnings.warn(\n   484→                \"show_legend ignored; legend_loc or legend_map was given\")\n   485→        show_legend = False\n   486→        legend_loc = legend_map = None\n   487→    elif legend_loc is not None or legend_map is not None:\n   488→        if show_legend is False:\n   489→            warnings.warn(\n   490→                \"show_legend ignored; legend_loc or legend_map was given\")\n   491→        show_legend = True\n   492→\n   493→    if legend_loc is None:\n   494→        legend_loc = default_loc\n   495→    elif not isinstance(legend_loc, (int, str)):\n   496→        raise ValueError(\"legend_loc must be string or int\")\n   497→\n   498→    # Make sure the legend map is the right size\n   499→    if legend_map is not None:\n   500→        legend_map = np.atleast_2d(legend_map)\n   501→        if legend_map.shape != shape:\n   502→            raise ValueError(\"legend_map shape just match axes shape\")\n   503→\n   504→    return legend_loc, legend_map, show_legend\n   505→\n   506→\n   507→# Utility function to make legend labels\n   508→def _make_legend_labels(labels, ignore_common=False):\n   509→    if len(labels) == 1:\n   510→        return labels\n   511→\n   512→    # Look for a common prefix (up to a space)\n   513→    common_prefix = commonprefix(labels)\n   514→    last_space = common_prefix.rfind(', ')\n   515→    if last_space < 0 or ignore_common:\n   516→        common_prefix = ''\n   517→    elif last_space > 0:\n   518→        common_prefix = common_prefix[:last_space + 2]\n   519→    prefix_len = len(common_prefix)\n   520→\n   521→    # Look for a common suffix (up to a space)\n   522→    common_suffix = commonprefix(\n   523→        [label[::-1] for label in labels])[::-1]\n   524→    suffix_len = len(common_suffix)\n   525→    # Only chop things off after a comma or space\n   526→    while suffix_len > 0 and common_suffix[-suffix_len] != ',':\n   527→        suffix_len -= 1\n   528→\n   529→    # Strip the labels of common information\n   530→    if suffix_len > 0 and not ignore_common:\n   531→        labels = [label[prefix_len:-suffix_len] for label in labels]\n   532→    else:\n   533→        labels = [label[prefix_len:] for label in labels]\n   534→\n   535→    return labels\n   536→\n   537→\n   538→def _update_plot_title(\n   539→        title, fig=None, frame='axes', use_existing=True, **kwargs):\n   540→    if title is False or title is None:\n   541→        return\n   542→    if fig is None:\n   543→        fig = plt.gcf()\n   544→    rcParams = config._get_param('ctrlplot', 'rcParams', kwargs, pop=True)\n   545→\n   546→    if use_existing:\n   547→        # Get the current title, if it exists\n   548→        old_title = None if fig._suptitle is None else fig._suptitle._text\n   549→\n   550→        if old_title is not None:\n   551→            # Find the common part of the titles\n   552→            common_prefix = commonprefix([old_title, title])\n   553→\n   554→            # Back up to the last space\n   555→            last_space = common_prefix.rfind(' ')\n   556→            if last_space > 0:\n   557→                common_prefix = common_prefix[:last_space]\n   558→            common_len = len(common_prefix)\n   559→\n   560→            # Add the new part of the title (usually the system name)\n   561→            if old_title[common_len:] != title[common_len:]:\n   562→                separator = ',' if len(common_prefix) > 0 else ';'\n   563→                title = old_title + separator + title[common_len:]\n   564→\n   565→    if frame == 'figure':\n   566→        with plt.rc_context(rcParams):\n   567→            fig.suptitle(title, **kwargs)\n   568→\n   569→    elif frame == 'axes':\n   570→        with plt.rc_context(rcParams):\n   571→            fig.suptitle(title, **kwargs)           # Place title in center\n   572→            plt.tight_layout()                      # Put everything into place\n   573→            xc, _ = _find_axes_center(fig, fig.get_axes())\n   574→            fig.suptitle(title, x=xc, **kwargs)     # Redraw title, centered\n   575→\n   576→    else:\n   577→        raise ValueError(f\"unknown frame '{frame}'\")\n   578→\n   579→\n   580→def _find_axes_center(fig, axs):\n   581→    \"\"\"Find the midpoint between axes in display coordinates.\n   582→\n   583→    This function finds the middle of a plot as defined by a set of axes.\n   584→\n   585→    \"\"\"\n   586→    inv_transform = fig.transFigure.inverted()\n   587→    xlim = ylim = [1, 0]\n   588→    for ax in axs:\n   589→        ll = inv_transform.transform(ax.transAxes.transform((0, 0)))\n   590→        ur = inv_transform.transform(ax.transAxes.transform((1, 1)))\n   591→\n   592→        xlim = [min(ll[0], xlim[0]), max(ur[0], xlim[1])]\n   593→        ylim = [min(ll[1], ylim[0]), max(ur[1], ylim[1])]\n   594→\n   595→    return (np.sum(xlim)/2, np.sum(ylim)/2)\n   596→\n   597→\n   598→# Internal function to add arrows to a curve\n   599→def _add_arrows_to_line2D(\n   600→        axes, line, arrow_locs=[0.2, 0.4, 0.6, 0.8],\n   601→        arrowstyle='-|>', arrowsize=1, dir=1):\n   602→    \"\"\"\n   603→    Add arrows to a matplotlib.lines.Line2D at selected locations.\n   604→\n   605→    Parameters\n   606→    ----------\n   607→    axes: Axes object as returned by axes command (or gca)\n   608→    line: Line2D object as returned by plot command\n   609→    arrow_locs: list of locations where to insert arrows, % of total length\n   610→    arrowstyle: style of the arrow\n   611→    arrowsize: size of the arrow\n   612→\n   613→    Returns\n   614→    -------\n   615→    arrows : list of arrows\n   616→\n   617→    Notes\n   618→    -----\n   619→    Based on https://stackoverflow.com/questions/26911898/\n   620→\n   621→    \"\"\"\n   622→    # Get the coordinates of the line, in plot coordinates\n   623→    if not isinstance(line, mpl.lines.Line2D):\n   624→        raise ValueError(\"expected a matplotlib.lines.Line2D object\")\n   625→    x, y = line.get_xdata(), line.get_ydata()\n   626→\n   627→    # Determine the arrow properties\n   628→    arrow_kw = {\"arrowstyle\": arrowstyle}\n   629→\n   630→    color = line.get_color()\n   631→    use_multicolor_lines = isinstance(color, np.ndarray)\n   632→    if use_multicolor_lines:\n   633→        raise NotImplementedError(\"multi-color lines not supported\")\n   634→    else:\n   635→        arrow_kw['color'] = color\n   636→\n   637→    linewidth = line.get_linewidth()\n   638→    if isinstance(linewidth, np.ndarray):\n   639→        raise NotImplementedError(\"multi-width lines not supported\")\n   640→    else:\n   641→        arrow_kw['linewidth'] = linewidth\n   642→\n   643→    # Figure out the size of the axes (length of diagonal)\n   644→    xlim, ylim = axes.get_xlim(), axes.get_ylim()\n   645→    ul, lr = np.array([xlim[0], ylim[0]]), np.array([xlim[1], ylim[1]])\n   646→    diag = np.linalg.norm(ul - lr)\n   647→\n   648→    # Compute the arc length along the curve\n   649→    s = np.cumsum(np.sqrt(np.diff(x) ** 2 + np.diff(y) ** 2))\n   650→\n   651→    # Truncate the number of arrows if the curve is short\n   652→    # TODO: figure out a smarter way to do this\n   653→    frac = min(s[-1] / diag, 1)\n   654→    if len(arrow_locs) and frac < 0.05:\n   655→        arrow_locs = []         # too short; no arrows at all\n   656→    elif len(arrow_locs) and frac < 0.2:\n   657→        arrow_locs = [0.5]      # single arrow in the middle\n   658→\n   659→    # Plot the arrows (and return list if patches)\n   660→    arrows = []\n   661→    for loc in arrow_locs:\n   662→        n = np.searchsorted(s, s[-1] * loc)\n   663→\n   664→        if dir == 1 and n == 0:\n   665→            # Move the arrow forward by one if it is at start of a segment\n   666→            n = 1\n   667→\n   668→        # Place the head of the arrow at the desired location\n   669→        arrow_head = [x[n], y[n]]\n   670→        arrow_tail = [x[n - dir], y[n - dir]]\n   671→\n   672→        p = mpl.patches.FancyArrowPatch(\n   673→            arrow_tail, arrow_head, transform=axes.transData, lw=0,\n   674→            **arrow_kw)\n   675→        axes.add_patch(p)\n   676→        arrows.append(p)\n   677→    return arrows\n   678→\n   679→\n   680→def _get_color_offset(ax, color_cycle=None):\n   681→    \"\"\"Get color offset based on current lines.\n   682→\n   683→    This function determines that the current offset is for the next color\n   684→    to use based on current colors in a plot.\n   685→\n   686→    Parameters\n   687→    ----------\n   688→    ax : `matplotlib.axes.Axes`\n   689→        Axes containing already plotted lines.\n   690→    color_cycle : list of matplotlib color specs, optional\n   691→        Colors to use in plotting lines.  Defaults to matplotlib rcParams\n   692→        color cycle.\n   693→\n   694→    Returns\n   695→    -------\n   696→    color_offset : matplotlib color spec\n   697→        Starting color for next line to be drawn.\n   698→    color_cycle : list of matplotlib color specs\n   699→        Color cycle used to determine colors.\n   700→\n   701→    \"\"\"\n   702→    if color_cycle is None:\n   703→        color_cycle = plt.rcParams['axes.prop_cycle'].by_key()['color']\n   704→\n   705→    color_offset = 0\n   706→    if len(ax.lines) > 0:\n   707→        last_color = ax.lines[-1].get_color()\n   708→        if last_color in color_cycle:\n   709→            color_offset = color_cycle.index(last_color) + 1\n   710→\n   711→   