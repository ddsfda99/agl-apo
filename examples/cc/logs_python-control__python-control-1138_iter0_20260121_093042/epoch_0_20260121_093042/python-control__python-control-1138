es object as returned by axes command (or gca)\n   608\u2192    line: Line2D object as returned by plot command\n   609\u2192    arrow_locs: list of locations where to insert arrows, % of total length\n   610\u2192    arrowstyle: style of the arrow\n   611\u2192    arrowsize: size of the arrow\n   612\u2192\n   613\u2192    Returns\n   614\u2192    -------\n   615\u2192    arrows : list of arrows\n   616\u2192\n   617\u2192    Notes\n   618\u2192    -----\n   619\u2192    Based on https://stackoverflow.com/questions/26911898/\n   620\u2192\n   621\u2192    \"\"\"\n   622\u2192    # Get the coordinates of the line, in plot coordinates\n   623\u2192    if not isinstance(line, mpl.lines.Line2D):\n   624\u2192        raise ValueError(\"expected a matplotlib.lines.Line2D object\")\n   625\u2192    x, y = line.get_xdata(), line.get_ydata()\n   626\u2192\n   627\u2192    # Determine the arrow properties\n   628\u2192    arrow_kw = {\"arrowstyle\": arrowstyle}\n   629\u2192\n   630\u2192    color = line.get_color()\n   631\u2192    use_multicolor_lines = isinstance(color, np.ndarray)\n   632\u2192    if use_multicolor_lines:\n   633\u2192        raise NotImplementedError(\"multi-color lines not supported\")\n   634\u2192    else:\n   635\u2192        arrow_kw['color'] = color\n   636\u2192\n   637\u2192    linewidth = line.get_linewidth()\n   638\u2192    if isinstance(linewidth, np.ndarray):\n   639\u2192        raise NotImplementedError(\"multi-width lines not supported\")\n   640\u2192    else:\n   641\u2192        arrow_kw['linewidth'] = linewidth\n   642\u2192\n   643\u2192    # Figure out the size of the axes (length of diagonal)\n   644\u2192    xlim, ylim = axes.get_xlim(), axes.get_ylim()\n   645\u2192    ul, lr = np.array([xlim[0], ylim[0]]), np.array([xlim[1], ylim[1]])\n   646\u2192    diag = np.linalg.norm(ul - lr)\n   647\u2192\n   648\u2192    # Compute the arc length along the curve\n   649\u2192    s = np.cumsum(np.sqrt(np.diff(x) ** 2 + np.diff(y) ** 2))\n   650\u2192\n   651\u2192    # Truncate the number of arrows if the curve is short\n   652\u2192    # TODO: figure out a smarter way to do this\n   653\u2192    frac = min(s[-1] / diag, 1)\n   654\u2192    if len(arrow_locs) and frac < 0.05:\n   655\u2192        arrow_locs = []         # too short; no arrows at all\n   656\u2192    elif len(arrow_locs) and frac < 0.2:\n   657\u2192        arrow_locs = [0.5]      # single arrow in the middle\n   658\u2192\n   659\u2192    # Plot the arrows (and return list if patches)\n   660\u2192    arrows = []\n   661\u2192    for loc in arrow_locs:\n   662\u2192        n = np.searchsorted(s, s[-1] * loc)\n   663\u2192\n   664\u2192        if dir == 1 and n == 0:\n   665\u2192            # Move the arrow forward by one if it is at start of a segment\n   666\u2192            n = 1\n   667\u2192\n   668\u2192        # Place the head of the arrow at the desired location\n   669\u2192        arrow_head = [x[n], y[n]]\n   670\u2192        arrow_tail = [x[n - dir], y[n - dir]]\n   671\u2192\n   672\u2192        p = mpl.patches.FancyArrowPatch(\n   673\u2192            arrow_tail, arrow_head, transform=axes.transData, lw=0,\n   674\u2192            **arrow_kw)\n   675\u2192        axes.add_patch(p)\n   676\u2192        arrows.append(p)\n   677\u2192    return arrows\n   678\u2192\n   679\u2192\n   680\u2192def _get_color_offset(ax, color_cycle=None):\n   681\u2192    \"\"\"Get color offset based on current lines.\n   682\u2192\n   683\u2192    This function determines that the current offset is for the next color\n   684\u2192    to use based on current colors in a plot.\n   685\u2192\n   686\u2192    Parameters\n   687\u2192    ----------\n   688\u2192    ax : `matplotlib.axes.Axes`\n   689\u2192        Axes containing already plotted lines.\n   690\u2192    color_cycle : list of matplotlib color specs, optional\n   691\u2192        Colors to use in plotting lines.  Defaults to matplotlib rcParams\n   692\u2192        color cycle.\n   