→\n   671→        raise AttributeError(\n   672→            f\"The State var has no attribute '{name}' or may have been annotated wrongly.\",\n   673→        )\n   674→\n   675→    def operation(\n   676→        self,\n   677→        op: str = \"\",\n   678→        other: Var | None = None,\n   679→        type_: Type | None = None,\n   680→        flip: bool = False,\n   681→        fn: str | None = None,\n   682→        invoke_fn: bool = False,\n   683→    ) -> Var:\n   684→        \"\"\"Perform an operation on a var.\n   685→\n   686→        Args:\n   687→            op: The operation to perform.\n   688→            other: The other var to perform the operation on.\n   689→            type_: The type of the operation result.\n   690→            flip: Whether to flip the order of the operation.\n   691→            fn: A function to apply to the operation.\n   692→            invoke_fn: Whether to invoke the function.\n   693→\n   694→        Returns:\n   695→            The operation result.\n   696→\n   697→        Raises:\n   698→            TypeError: If the operation between two operands is invalid.\n   699→            ValueError: If flip is set to true and value of operand is not provided\n   700→        \"\"\"\n   701→        if isinstance(other, str):\n   702→            other = Var.create(json.dumps(other))\n   703→        else:\n   704→            other = Var.create(other)\n   705→\n   706→        type_ = type_ or self._var_type\n   707→\n   708→        if other is None and flip:\n   709→            raise ValueError(\n   710→                \"flip_operands cannot be set to True if the value of 'other' operand is not provided\"\n   711→            )\n   712→\n   713→        left_operand, right_operand = (other, self) if flip else (self, other)\n   714→\n   715→        def get_operand_full_name(operand):\n   716→            # operand vars that are string literals need to be wrapped in back ticks.\n   717→            return (\n   718→                operand.