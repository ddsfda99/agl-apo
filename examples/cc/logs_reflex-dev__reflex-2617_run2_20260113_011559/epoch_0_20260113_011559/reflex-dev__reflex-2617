\n   535→            i: The index to index into.\n   536→\n   537→        Returns:\n   538→            The indexed var.\n   539→\n   540→        Raises:\n   541→            TypeError: If the var is not indexable.\n   542→        \"\"\"\n   543→        # Indexing is only supported for strings, lists, tuples, dicts, and dataframes.\n   544→        if not (\n   545→            types._issubclass(self._var_type, Union[List, Dict, Tuple, str])\n   546→            or types.is_dataframe(self._var_type)\n   547→        ):\n   548→            if self._var_type == Any:\n   549→                raise TypeError(\n   550→                    \"Could not index into var of type Any. (If you are trying to index into a state var, \"\n   551→                    \"add the correct type annotation to the var.)\"\n   552→                )\n   553→            raise TypeError(\n   554→                f\"Var {self._var_name} of type {self._var_type} does not support indexing.\"\n   555→            )\n   556→\n   557→        # The type of the indexed var.\n   558→        type_ = Any\n   559→\n   560→        # Convert any vars to local vars.\n   561→        if isinstance(i, Var):\n   562→            i = i._replace(_var_is_local=True)\n   563→\n   564→        # Handle list/tuple/str indexing.\n   565→        if types._issubclass(self._var_type, Union[List, Tuple, str]):\n   566→            # List/Tuple/String indices must be ints, slices, or vars.\n   567→            if (\n   568→                not isinstance(i, types.get_args(Union[int, slice, Var]))\n   569→                or isinstance(i, Var)\n   570→                and not i._var_type == int\n   571→            ):\n   572→                raise TypeError(\"Index must be an integer or an integer var.\")\n   573→\n   574→            # Handle slices first.\n   575→            if isinstance(i, slice):\n   576→                # Get the start and stop indices.\n   577→                start = i.start or 0\n   578→                stop = i.stop or \"undefined\"\n   579→\n   580→                # Use the slice function.\n   581→                return self._replace(\n   582→                    _var_name=f\"{self._var_name}.slice({start}, {stop})\",\n   583→                    _var_is_string=False,\n   584→                )\n   585→\n   586→            # Get the type of the indexed var.\n   587→            if types.is_generic_alias(self._var_type):\n   588→                type_ = types.get_args(self._var_type)[0]\n   589→            elif types._issubclass(self._var_type, str):\n   590→                type_ = str\n   591→\n   592→            # Use `at` to support negative indices.\n   593→            return self._replace(\n   594→                _var_name=f\"{self._var_name}.at({i})\",\n   595→                _var_type=type_,\n   596→                _var_is_string=False,\n   597→            )\n   598→\n   599→        # Dictionary / dataframe indexing.\n   600→        # Tuples are currently not supported as indexes.\n   601→        if (\n   602→            (\n   603→                types._issubclass(self._var_type, Dict)\n   604→                or types.is_dataframe(self._var_type)\n   605→            )\n   606→            and not isinstance(i, types.get_args(Union[int, str, float, Var]))\n   607→        ) or (\n   608→            isinstance(i, Var)\n   609→            and not types._issubclass(\n   610→                i._var_type, types.get_args(Union[int, str, float])\n   611→            )\n   612→        ):\n   613→            raise TypeError(\n   614→                \"Index must be one of the following types: int, str, int or str Var\"\n   615→            )\n   616→        # Get the type of the indexed var.\n   617→        if isinstance(i, str):\n   618→            i = format.wrap(i, '\"')\n   619→        type_ = (\n   620→            types.get_args(self._var_type)[1]\n   621→            if types.is_generic_alias(self._var_type)\n   622→            else Any\n   623→        )\n   624→\n   625→        # Use normal