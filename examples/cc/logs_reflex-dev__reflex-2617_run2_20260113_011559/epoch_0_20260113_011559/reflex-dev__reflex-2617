105\u2192    \"\"\"\n   106\u2192    lines = text.splitlines()\n   107\u2192    if len(lines) < 2:\n   108\u2192        return text\n   109\u2192    return os.linesep.join(f\"{' ' * indent_level}{line}\" for line in lines) + os.linesep\n   110\u2192\n   111\u2192\n   112\u2192def to_snake_case(text: str) -> str:\n   113\u2192    \"\"\"Convert a string to snake case.\n   114\u2192\n   115\u2192    The words in the text are converted to lowercase and\n   116\u2192    separated by underscores.\n   117\u2192\n   118\u2192    Args:\n   119\u2192        text: The string to convert.\n   120\u2192\n   121\u2192    Returns:\n   122\u2192        The snake case string.\n   123\u2192    \"\"\"\n   124\u2192    s1 = re.sub(\"(.)([A-Z][a-z]+)\", r\"\\1_\\2\", text)\n   125\u2192    return re.sub(\"([a-z0-9])([A-Z])\", r\"\\1_\\2\", s1).lower().replace(\"-\", \"_\")\n   126\u2192\n   127\u2192\n   128\u2192def to_camel_case(text: str, allow_hyphens: bool = False) -> str:\n   129\u2192    \"\"\"Convert a string to camel case.\n   130\u2192\n   131\u2192    The first word in the text is converted to lowercase and\n   132\u2192    the rest of the words are converted to title case, removing underscores.\n   133\u2192\n   134\u2192    Args:\n   135\u2192        text: The string to convert.\n   136\u2192        allow_hyphens: Whether to allow hyphens in the string.\n   137\u2192\n   138\u2192    Returns:\n   139\u2192        The camel case string.\n   140\u2192    \"\"\"\n   141\u2192    char = \"_\" if allow_hyphens else \"-_\"\n   142\u2192    words = re.split(f\"[{char}]\", text.lstrip(char))\n   143\u2192    leading_underscores_or_hyphens = \"\".join(re.findall(rf\"^[{char}]+\", text))\n   144\u2192    # Capitalize the first letter of each word except the first one\n   145\u2192    converted_word = words[0] + \"\".join(x.capitalize() for x in words[1:])\n   146\u2192    return leading_underscores_or_hyphens + converted_word\n   147\u2192\n   148\u2192\n   149\u2192def to_title_case(text: str) -> str:\n   150\u2192    \"\"\"Convert a string from snake case to title case.\n   151\u2192\n   152\u2192    Args:\n   153\u2192        text: The string to convert.\n   154\u2192\n   155\u2192    Returns:\n   156\u2192        The title case string.\n   157\u2192    \"\"\"\n   158\u2192    return \"\".join(word.capitalize() for word in text.split(\"_\"))\n   159\u2192\n   160\u2192\n   161\u2192def to_kebab_case(text: str) -> str:\n   162\u2192    \"\"\"Convert a string to kebab case.\n   163\u2192\n   164\u2192    The words in the text are converted to lowercase and\n   165\u2192    separated by hyphens.\n   166\u2192\n   167\u2192    Args:\n   168\u2192        text: The string to convert.\n   169\u2192\n   170\u2192    Returns:\n   171\u2192        The title case string.\n   172\u2192    \"\"\"\n   173\u2192    return to_snake_case(text).replace(\"_\", \"-\")\n   174\u2192\n   175\u2192\n   176\u2192def format_string(string: str) -> str:\n   177\u2192    \"\"\"Format the given string as a JS string literal..\n   178\u2192\n   179\u2192    Args:\n   180\u2192        string: The string to format.\n   181\u2192\n   182\u2192    Returns:\n   183\u2192        The formatted string.\n   184\u2192    \"\"\"\n   185\u2192    # Escape backticks.\n   186\u2192    string = string.replace(r\"\\`\", \"`\")\n   187\u2192    string = string.replace(\"`\", r\"\\`\")\n   188\u2192\n   189\u2192    # Wrap the string so it looks like {`string`}.\n   190\u2192    string = wrap(string, \"`\")\n   191\u2192    string = wrap(string, \"{\")\n   192\u2192\n   193\u2192    return string\n   194\u2192\n   195\u2192\n   196\u2192def format_var(var: Var) -> str:\n   197\u2192    \"\"\"Format the given Var as a javascript value.\n   198\u2192\n   199\u2192    Args:\n   200\u2192        var: The Var to format.\n   201\u2192\n   202\u2192    Returns:\n   203\u2192        The formatted Var.\n   204\u2192    \"\"\"\n   205\u2192    if not var._var_is_local or var._var_is_string:\n   206\