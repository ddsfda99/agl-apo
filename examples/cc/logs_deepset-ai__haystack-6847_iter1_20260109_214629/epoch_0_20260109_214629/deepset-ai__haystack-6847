import Any, Protocol, runtime_checkable\n    76\u2192\n    77\u2192from haystack.core.component.sockets import InputSocket, OutputSocket, _empty\n    78\u2192from haystack.core.errors import ComponentError\n    79\u2192\n    80\u2192logger = logging.getLogger(__name__)\n    81\u2192\n    82\u2192\n    83\u2192@runtime_checkable\n    84\u2192class Component(Protocol):\n    85\u2192    \"\"\"\n    86\u2192    Note this is only used by type checking tools.\n    87\u2192\n    88\u2192    In order to implement the `Component` protocol, custom components need to\n    89\u2192    have a `run` method. The signature of the method and its return value\n    90\u2192    won't be checked, i.e. classes with the following methods:\n    91\u2192\n    92\u2192        def run(self, param: str) -> Dict[str, Any]:\n    93\u2192            ...\n    94\u2192\n    95\u2192    and\n    96\u2192\n    97\u2192        def run(self, **kwargs):\n    98\u2192            ...\n    99\u2192\n   100\u2192    will be both considered as respecting the protocol. This makes the type\n   101\u2192    checking much weaker, but we have other places where we ensure code is\n   102\u2192    dealing with actual Components.\n   103\u2192\n   104\u2192    The protocol is runtime checkable so it'll be possible to assert:\n   105\u2192\n   106\u2192        isinstance(MyComponent, Component)\n   107\u2192    \"\"\"\n   108\u2192\n   109\u2192    def run(self, *args: Any, **kwargs: Any):  # pylint: disable=missing-function-docstring\n   110\u2192        ...\n   111\u2192\n   112\u2192\n   113\u2192class ComponentMeta(type):\n   114\u2192    def __call__(cls, *args, **kwargs):\n   115\u2192        \"\"\"\n   116\u2192        This method is called when clients instantiate a Component and\n   117\u2192        runs before __new__ and __init__.\n   118\u2192        \"\"\"\n   119\u2192        # This will call __new__ then __init__, giving us back the Component instance\n   120\u2192        instance = super().__call__(*args, **kwargs)\n   121\u2192\n   122\u2192        # Before returning, we have the chance to modify the newly created\n   123\u2192        # Component instance, so we take the chance and set up the I/O sockets\n   124\u2192\n   125\u2192        # If `component.set_output_types()` was called in the component constructor,\n   126\u2192        # `__haystack_output__` is already populated, no need to do anything.\n   127\u2192        if not hasattr(instance, \"__haystack_output__\"):\n   128\u2192            # If that's not the case, we need to populate `__haystack_output__`\n   129\u2192            #\n   130\u2192            # If the `run` method was decorated, it has a `_output_types_cache` field assigned\n   131\u2192            # that stores the output specification.\n   132\u2192            # We deepcopy the content of the cache to transfer ownership from the class method\n   133\u2192            # to the actual instance, so that different instances of the same class won't share this data.\n   134\u2192            instance.__haystack_output__ = deepcopy(getattr(instance.run, \"_output_types_cache\", {}))\n   135\u2192\n   136\u2192        # Create the sockets if set_input_types() wasn't called in the constructor.\n   137\u2192        # If it was called and there are some parameters also in the `run()` method, these take precedence.\n   138\u2192        if not hasattr(instance, \"__haystack_input__\"):\n   139\u2192            instance.__haystack_input__ = {}\n   140\u2192        run_signature = inspect.signature(getattr(cls, \"run\"))\n   141\u2192        for param in list(run_signature.parameters)[1:]:  # First is 'self' and it doesn't matter.\n   142\u2192            if run_signature.parameters[param].kind not in (\n   143\u2192                inspect.Parameter.VAR_POSITIONAL,\n   144\u2192                inspect.Parameter.VAR_KEYWORD,\n   145\u2192            ):  # ignore variable args\n   146\u2192                socket_kwargs = {\"name\": param, \"type\": run_signature.parameters[param].annotation}\n   147\u2192                if run_signature.parameters[param].default != inspect.Parameter.empty:\n   148\u2192                    socket_kwargs[\"default_value\"] = run_signature.parameters[param].default\n   149\u2192                instance.__haystack_input__[param] = InputSocket(**socket_kwargs)\n   150\u2192        return instance\n   151\u2192\n   152\u2192\n   153\u2192class _Component:\n   154\u2192    \"\"\"\n   155\u2192    See module's docstring.\n   156\u2192\n   157\u2192    Args:\n   158\u2192        class_: the class that Canals should use as a component.\n   159\u2192        serializable: whether to check, at init time, if the component can be saved with\n   160\u2192        `save_pipelines()`.\n   161\u2192\n   162\u2192    Returns:\n   163\u2192        A class that can be recognized as a component.\n   164\u2192\n   165\u2192    Raises:\n   166\u2192        ComponentError: if the class provided has no `run()` method or otherwise doesn't respect the component contract.\n   167\u2192    \"\"\"\n   168\u2192\n   169\u2192    def __init__(self):\n   170\u2192        self.registry = {}\n   171\u2192\n   172\u2192    def set_input_type(self, instance, name: str, type: Any, default: Any = _empty):\n   173\u2192        \"\"\"\n   174\u2192        Add a single input socket to the component instance.\n   175\u2192\n   176\u2192        :param instance: Component instance where the input type will be added.\n   177\u2192        :param name: name of the input socket.\n   178\u2192        :param type: type of the input socket.\n   179\u2192        :param default: default value of the input socket, defaults to _empty\n   180\u2192        \"\"\"\n   181\u2192        if not hasattr(instance, \"__haystack_input__\"):\n   182\u2192            instance.__haystack_input__ = {}\n   183\u2192        instance.__haystack_input__[name] = InputSocket(name=name, type=type, default_value=default)\n   184\u2192\n   185\u2192    def set_input_types(self, instance, **types):\n   186\u2192        \"\"\"\n   187\u2192        Method that specifies the input types when 'kwargs' is passed to the run method.\n   188\u2192\n   189\u2192        Use as:\n   190\u2192\n   191\u2192        ```python\n   192\u2192        @component\n   193\u2192        class MyComponent:\n   194\u2192\n   195\u2192            def __init__(self, value: int):\n   196\u2192                component.set_input_types(value_1=str, value_2=str)\n   197\u2192                ...\n   198\u2192\n   199\u2192            @component.output_types(output_1=int, output_2=str)\n   200\u2192            def run(self, **kwargs):\n   201\u2192                return {\"output_1\": kwargs[\"value_1\"], \"output_2\": \"\"}\n   202\u2192        ```\n   203\u2192\n   204\u2192        Note that if the `run()` method also specifies some parameters, those will take precedence.\n   205\u2192\n   206\u2192        For example:\n   207\u2192\n   208\u2192        ```python\n   209\u2192        @component\n   210\u2192        class MyComponent:\n   211\u2192\n   212\u2192            def __init__(self, value: int):\n   213\u2192                component.set_input_types(value_1=str, value_2=str)\n   214\u2192                ...\n   215\u2192\n   216\u2192            @component.output_types(output_1=int, output_2=str)\n   217\u2192            def run(self, value_0: str, value_1: Optional[str] = None, **kwargs):\n   218\u2192                return {\"output_1\": kwargs[\"value_1\"], \"output_2\": \"\"}\n   219\u2192        ```\n   220\u2192\n   221\u2192        would add a mandatory `value_0` parameters, make the `value_1`\n   222\u2192        parameter optional with a default None, and keep the `value_2`\n   223\u2192        parameter mandatory as specified in `set_input_types`.\n   224\u2192\n   225\u2192        \"\"\"\n   226\u2192        instance.__haystack_input__ = {name: InputSocket(name=name, type=type_) for name, type_ in types.items()}\n   227\u2192\n   228\u2192    def set_output_types(self, instance, **types):\n   229\u2192        \"\"\"\n   230\u2192        Method that specifies the output types when the 'run' method is not decorated\n   231\u2192        with 'component.output_types'.\n   232\u2192\n   233\u2192        Use as:\n   234\u2192\n   235\u2192        ```python\n   236\u2192        @component\n   237\u2192        class MyComponent:\n   238\u2192\n   239\u2192            def __init__(self, value: int):\n   240\u2192                component.set_output_types(output_1=int, output_2=str)\n   241\u2192                ...\n   242\u2192\n   243\u2192            # no decorators here\n   244\u2192            def run(self, value: int):\n   245\u2192                return {\"output_1\": 1, \"output_2\": \"2\"}\n   246\u2192        ```\n   247\u2192        \"\"\"\n   248\u2192        instance.__haystack_output__ = {name: OutputSocket(name=name, type=type_) for name, type_ in types.items()}\n   249\u2192\n   250\u2192    def output_types(self, **types):\n   251\u2192        \"\"\"\n   252\u2192        Decorator factory that specifies the output types of a component.\n   253\u2192\n   254\u2192        Use as:\n   255\u2192\n   256\u2192        ```python\n   257\u2192        @component\n   258\u2192        class MyComponent:\n   259\u2192            @component.output_types(output_1=int, output_2=str)\n   260\u2192            def run(self, value: int):\n   261\u2192                return {\"output_1\": 1, \"output_2\": \"2\"}\n   262\u2192        ```\n   263\u2192        \"\"\"\n   264\u2192\n   265\u2192        def output_types_decorator(run_method):\n   266\u2192            \"\"\"\n   267\u2192            This happens at class creation time, and since we don't have the decorated\n   268\u2192            class available here, we temporarily store the output types as an attribute of\n   269\u2192            the decorated method. The ComponentMeta metaclass will use this data to create\n   270\u2192            sockets at instance creation time.\n   271\u2192            \"\"\"\n   272\u2192            setattr(\n   273\u2192                run_method,\n   274\u2192                \"_output_types_cache\",\n   275\u2192                {name: OutputSocket(name=name, type=type_) for name, type_ in types.items()},\n   276\u2192            )\n   277\u2192            return run_method\n   278\u2192\n   279\u2192        return output_types_decorator\n   280\u2192\n   281\u2192    def _component(self, class_):\n   282\u2192        \"\"\"\n   283\u2192        Decorator validating the structure of the component and registering it in the components registry.\n   284\u2192        \"\"\"\n   285\u2192        logger.debug(\"Registering %s as a component\", class_)\n   286\u2192\n   287\u2192        # Check for required methods and fail as soon as possible\n   288\u2192        if not hasattr(class_, \"run\"):\n   289\u2192            raise ComponentError(f\"{class_.__name__} must have a 'run()' method. See the docs for more information.\")\n   290\u2192\n   291\u2192        def copy_class_namespace(namespace):\n   292\u2192            \"\"\"\n   293\u2192            This is the callback that `typing.new_class` will use\n   294\u2192            to populate the newly created class. We just copy\n   295\u2192            the whole namespace from the decorated class.\n   296\u2192            \"\"\"\n   297\u2192            for key, val in dict(class_.__dict__).items():\n   298\u2192                # __dict__ and __weakref__ are class-bound, we should let Python recreate them.\n   299\u2192                if key in (\"__dict__\", \"__weakref__\"):\n   300\u2192                    continue\n   301\u2192                namespace[key] = val\n   302\u2192\n   303\u2192        # Recreate the decorated component class so it uses our metaclass\n   304\u2192        class_ = new_class(class_.__name__, class_.__bases__, {\"metaclass\": ComponentMeta}, copy_class_namespace)\n   305\u2192\n   306\u2192        # Save the