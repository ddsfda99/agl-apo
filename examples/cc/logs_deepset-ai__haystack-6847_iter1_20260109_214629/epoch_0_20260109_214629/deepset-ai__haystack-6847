:\n    41\u2192        \"\"\"\n    42\u2192        Creates the Pipeline.\n    43\u2192\n    44\u2192        Args:\n    45\u2192            metadata: arbitrary dictionary to store metadata about this pipeline. Make sure all the values contained in\n    46\u2192                this dictionary can be serialized and deserialized if you wish to save this pipeline to file with\n    47\u2192                `save_pipelines()/load_pipelines()`.\n    48\u2192            max_loops_allowed: how many times the pipeline can run the same node before throwing an exception.\n    49\u2192            debug_path: when debug is enabled in `run()`, where to save the debug data.\n    50\u2192        \"\"\"\n    51\u2192        self.metadata = metadata or {}\n    52\u2192        self.max_loops_allowed = max_loops_allowed\n    53\u2192        self.graph = networkx.MultiDiGraph()\n    54\u2192        self._debug: Dict[int, Dict[str, Any]] = {}\n    55\u2192        self._debug_path = Path(debug_path)\n    56\u2192\n    57\u2192    def __eq__(self, other) -> bool:\n    58\u2192        \"\"\"\n    59\u2192        Equal pipelines share every metadata, node and edge, but they're not required to use\n    60\u2192        the same node instances: this allows pipeline saved and then loaded back to be equal to themselves.\n    61\u2192        \"\"\"\n    62\u2192        if not isinstance(other, Pipeline):\n    63\u2192            return False\n    64\u2192        return self.to_dict() == other.to_dict()\n    65\u2192\n    66\u2192    def to_dict(self) -> Dict[str, Any]:\n    67\u2192        \"\"\"\n    68\u2192        Returns this Pipeline instance as a dictionary.\n    69\u2192        This is meant to be an intermediate representation but it can be also used to save a pipeline to file.\n    70\u2192        \"\"\"\n    71\u2192        components = {}\n    72\u2192        for name, instance in self.graph.nodes(data=\"instance\"):  # type:ignore\n    73\u2192            components[name] = component_to_dict(instance)\n    74\u2192\n    75\u2192        connections = []\n    76\u2192        for sender, receiver, edge_data in self.graph.edges.data():\n    77\u2192            sender_socket = edge_data[\"from_socket\"].name\n    78\u2192            receiver_socket = edge_data[\"to_socket\"].name\n    79\u2192            connections.append({\"sender\": f\"{sender}.{sender_socket}\", \"receiver\": f\"{receiver}.{receiver_socket}\"})\n    80\u2192        return {\n    81\u2192            \"metadata\": self.metadata,\n    82\u2192            \"max_loops_allowed\": self.max_loops_allowed,\n    83\u2192            \"components\": components,\n    84\u2192            \"connections\": connections,\n    85\u2192        }\n    86\u2192\n    87\u2192    @classmethod\n    88\u2192    def from_dict(cls: Type[T], data: Dict[str, Any], **kwargs) -> T:\n    89\u2192        \"\"\"\n    90\u2192        Creates a Pipeline instance from a dictionary.\n    91\u2192        A sample `data` dictionary could be formatted like so:\n    92\u2192        ```\n    93\u2192        {\n    94\u2192            \"metadata\": {\"test\": \"test\"},\n    95\u2192            \"max_loops_allowed\": 100,\n    96\u2192            \"components\": {\n    97\u2192                \"add_two\": {\n    98\u2192                    \"type\": \"AddFixedValue\",\n    99\u2192                    \"init_parameters\": {\"add\": 2},\n   100\u2192                },\n   101\u2192                \"add_default\": {\n   102\u2192                    \"type\": \"AddFixedValue\",\n   103\u2192                    \"init_parameters\": {\"add\": 1},\n   104\u2192                },\n   105\u2192                \"double\": {\n   106\u2192                    \"type\": \"Double\",\n   107\u2192                },\n   108\u2192            },\n   109\u2192            \"connections\": [\n   110\u2192                {\"sender\": \"add_two.result\", \"receiver\": \"double.value\"},\n   111\u2192                {\"sender\": \"double.value\", \"rec