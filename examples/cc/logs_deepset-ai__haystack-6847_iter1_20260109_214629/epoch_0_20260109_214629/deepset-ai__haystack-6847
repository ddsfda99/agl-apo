f, name: str, instance: Component) -> None:\n        \"\"\"\n        Create a component for the given component. Components are not connected to anything by default:\n        use `Pipeline.connect()` to connect components together.\n\n        Component names must be unique. Reusing the same component instance across different pipelines is unsupported because it can cause side effects; create a new instance per pipeline.\n\n        Args:\n            name: the name of the component.\n            instance: the component instance.\n\n        Returns:\n            None\n\n        Raises:\n            ValueError: if a component with the same name already exists\n            PipelineValidationError: if the given instance is not a Canals component\n        \"\"\"\n        # Component names are unique\n        if name in self.graph.nodes:\n            raise ValueError(f\"A component named '{name}' already exists in this pipeline: choose another name.\")\n\n        # Components can't be named `_debug`\n        if name == \"_debug\":\n            raise ValueError(\"'_debug' is a reserved name for debug output. Choose another name.\")\n\n        # Component instances must be components\n        if not isinstance(instance, Component):\n            raise PipelineValidationError(\n                f\"'{type(instance)}' doesn't seem to be a component. Is this class decorated with @component?\"\n            )\n\n        # Prevent reusing the same component instance across different pipelines.\n        # Reuse can cause side effects due to mutable internal socket state leaking between pipelines.\n        owner_id = getattr(instance, \"_haystack_pipeline_owner_id\", None)\n        if owner_id is not None and owner_id != id(self):\n            comp_cls_name = type(instance).__name__\n            raise PipelineValidationError(\n                \"Adding the same component instance to different pipelines is not supported because it can cause side \"\n                \"effects (for example