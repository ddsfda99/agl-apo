len(component.__haystack_input__) == 0:\n   528\u2192                # Component has no input, can run right away\n   529\u2192                to_run.append((node_name, component))\n   530\u2192                continue\n   531\u2192\n   532\u2192            for socket in component.__haystack_input__.values():\n   533\u2192                if not socket.senders or socket.is_variadic:\n   534\u2192                    # Component has at least one input not connected or is variadic, can run right away.\n   535\u2192                    to_run.append((node_name, component))\n   536\u2192                    break\n   537\u2192\n   538\u2192        # These variables are used to detect when we're stuck in a loop.\n   539\u2192        # Stuck loops can happen when one or more components are waiting for input but\n   540\u2192        # no other component is going to run.\n   541\u2192        # This can happen when a whole branch of the graph is skipped for example.\n   542\u2192        # When we find that two consecutive iterations of the loop where the waiting_for_input list is the same,\n   543\u2192        # we know we're stuck in a loop and we can't make any progress.\n   544\u2192        before_last_waiting_for_input: Optional[Set[str]] = None\n   545\u2192        last_waiting_for_input: Optional[Set[str]] = None\n   546\u2192\n   547\u2192        # The waiting_for_input list is used to keep track of components that are waiting for input.\n   548\u2192        waiting_for_input: List[Tuple[str, Component]] = []\n   549\u2192\n   550\u2192        # This is what we'll return at the end\n   551\u2192        final_outputs = {}\n   552        while len(to_run) > 0:\n   553\u2192            name, comp = to_run.pop(0)\n   554\u2192\n   555\u2192            if any(socket.is_variadic for socket in comp.__haystack_input__.values()) and not getattr(  # type: ignore\n   556\u2192                comp, \"is_greedy\", False\n   557\u2192            ):\n   558\u2192                there_ar