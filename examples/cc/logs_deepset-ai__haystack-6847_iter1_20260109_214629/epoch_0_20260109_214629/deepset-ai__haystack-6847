e component that delivers the value. This can be either just a component name or can be\n   211\u2192                in the format `component_name.connection_name` if the component has multiple outputs.\n   212\u2192            connect_to: the component that receives the value. This can be either just a component name or can be\n   213\u2192                in the format `component_name.connection_name` if the component has multiple inputs.\n   214\u2192\n   215\u2192        Returns:\n   216\u2192            None\n   217\u2192\n   218\u2192        Raises:\n   219\u2192            PipelineConnectError: if the two components cannot be connected (for example if one of the components is\n   220\u2192                not present in the pipeline, or the connections don't match by type, and so on).\n   221\u2192        \"\"\"\n   222\u2192        # Edges may be named explicitly by passing 'node_name.edge_name' to connect().\n   223\u2192        sender, sender_socket_name = parse_connect_string(connect_from)\n   224\u2192        receiver, receiver_socket_name = parse_connect_string(connect_to)\n   225\u2192\n   226\u2192        # Get the nodes data.\n   227\u2192        try:\n   228\u2192            from_sockets = self.graph.nodes[sender][\"output_sockets\"]\n   229\u2192        except KeyError as exc:\n   230\u2192            raise ValueError(f\"Component named {sender} not found in the pipeline.\") from exc\n   231\u2192        try:\n   232\u2192            to_sockets = self.graph.nodes[receiver][\"input_sockets\"]\n   233\u2192        except KeyError as exc:\n   234\u2192            raise ValueError(f\"Component named {receiver} not found in the pipeline.\") from exc\n   235\u2192\n   236\u2192        # If the name of either socket is given, get the socket\n   237\u2192        sender_socket: Optional[OutputSocket] = None\n   238\u2192        if sender_socket_name:\n   239\u2192            sender_socket = from_sockets.get(sender_socket_name)\n   240\u2192            if not sender_socket:\n   241\u2192                raise PipelineConnectError(\n   242\u2192                    f\"'{connect_from} does not exist. \"\n   243\u2192                    f\"Output connections of {sender} are: \"\n   244\u2192                    + \", \".join([f\"{name} (type {_type_name(socket.type)})\" for name, socket in from_sockets.items()])\n   245\u2192                )\n   246\u2192\n   247\u2192        receiver_socket: Optional[InputSocket] = None\n   248\u2192        if receiver_socket_name:\n   249\u2192            receiver_socket = to_sockets.get(receiver_socket_name)\n   250\u2192            if not receiver_socket:\n   251\u2192                raise PipelineConnectError(\n   252\u2192                    f\"'{connect_to} does not exist. \"\n   253\u2192                    f\"Input connections of {receiver} are: \"\n   254\u2192                    + \", \".join([f\"{name} (type {_type_name(socket.type)})\" for name, socket in to_sockets.items()])\n   255\u2192                )\n   256\u2192\n   257\u2192        # Look for a matching connection among the possible ones.\n   258\u2192        # Note that if there is more than one possible connection but two sockets match by name, they're paired.\n   259\u2192        sender_socket_candidates: List[OutputSocket] = [sender_socket] if sender_socket else list(from_sockets.values())\n   260\u2192        receiver_socket_candidates: List[InputSocket] = (\n   261\u2192            [receiver_socket] if receiver_socket else list(to_sockets.values())\n   262\u2192        )\n   263\u2192\n   264\u2192        # Find all possible connections between these two components\n   265\u2192        possible_connections = [\n   266\u2192            (sender_sock, receiver_sock)\n   267\u2192            for sender_sock, receiver_sock in itertools.product(sender_socket_candidates, receiver_socket_candidates)\n   268\u2192            if _types_are_compatible(sender_sock.type, receiver_sock.type)\n   269\u2192        ]\n   270\u2192\n   271\u2192        # We need this status for error messages, since we might need it in multiple places we calculate it here\n   272\u2192        status = _connections_status(\n   273\u2192            sender_node=sender,\n   274\u2192            sender_sockets=sender_socket_candidates,\n   275\u2192            receiver_node=receiver,\n   276\u2192            receiver_sockets=receiver_socket_candidates,\n   277\u2192        )\n   278\u2192\n   279\u2192        if not possible_connections:\n   280\u2192            # There's no possible connection between these two components\n   281\u2192            if len(sender_socket_candidates) == len(receiver_socket_candidates) == 1:\n   282\u2192                msg = (\n   283\u2192                    f\"Cannot connect '{sender}.{sender_socket_candidates[0].name}' with '{receiver}.{receiver_socket_candidates[0].name}': \"\n   284\u2192                    f\"their declared input and output types do not match.\\n{status}\"\n   285\u2192                )\n   286\u2192            else:\n   287\u2192                msg = f\"Cannot connect '{sender}' with '{receiver}': \" f\"no matching connections available.\\n{status}\"\n   288\u2192            raise PipelineConnectError(msg)\n   289\u2192\n   290\u2192        if len(possible_connections) == 1:\n   291\u2192            # There's only one possible connection, use it\n   292\u2192            sender_socket = possible_connections[0][0]\n   293\u2192            receiver_socket = possible_connections[0][1]\n   294\u2192\n   295\u2192        if len(possible_connections) > 1:\n   296\u2192            # There are multiple possible connection, let's try to match them by name\n   297\u2192            name_matches = [\n   298\u2192                (out_sock, in_sock) for out_sock, in_sock in possible_connections if in_sock.name == out_sock.name\n   299\u2192            ]\n   300\u2192            if len(name_matches) != 1:\n   301\u2192                # There's are either no matches or more than one, we can't pick one reliably\n   302\u2192                msg = (\n   303\u2192                    f\"Cannot connect '{sender}' with '{receiver}': more than one connection is possible \"\n   304\u2192                    \"between these components. Please specify the connection name, like: \"\n   305\u2192                    f\"pipeline.connect('{sender}.{possible_connections[0][0].name}', \"\n   306\u2192                    f\"'{receiver}.{possible_connections[0][1].name}').\\n{status}\"\n   307\u2192                )\n   308\u2192                raise PipelineConnectError(msg)\n   309\u2192\n   310\u2192            # Get the only possible match\n   311\u2192            sender_socket = name_matches[0][0]\n   312\u2192            receiver_socket = name_matches[0][1]\n   313\u2192\n   314\u2192        # Connection must be valid on both sender/receiver sides\n   315\u2192        if not sender_socket or not receiver_socket or not sender or not receiver:\n   316\u2192            if sender and sender_socket:\n   317\u2192                sender_repr = f\"{sender}.{sender_socket.name} ({_type_name(sender_socket.type)})\"\n   318\u2192            else:\n   319\u2192                sender_repr = \"input needed\"\n   320\u2192\n   321\u2192            if receiver and receiver_socket:\n   322\u2192                receiver_repr = f\"({_type_name(receiver_socket.type)}) {receiver}.{receiver_socket.name}\"\n   323\u2192            else:\n   324\u2192                receiver_repr = \"output\"\n   325\u2192            msg = f\"Connection must have both sender and receiver: {sender_repr} -> {receiver_repr}\"\n   326\u2192            raise PipelineConnectError(msg)\n   327\u2192\n   328\u2192        logger.debug(\"Connecting '%s.%s' to '%s.%s'\", sender, sender_socket.name, receiver, receiver_socket.name)\n   329\u2192\n   330\u2192        if receiver in sender_socket.receivers and sender in receiver_socket.senders:\n   331\u2192            # This is already connected, nothing to do\n   332\u2192            return\n   333\u2192\n   334\u2192        if receiver_socket.senders and not receiver_socket.is_variadic:\n   335\u2192            # Only variadic input sockets can receive from multiple senders\n   336\u2192            msg = (\n   337\u2192                f\"Cannot connect '{sender}.{sender_socket.name}' with '{receiver}.{receiver_socket.name}': \"\n   338\u2192                f\"{receiver}.{receiver_socket.name} is already connected to {receiver_socket.senders}.\\n\"\n   339\u2192            )\n   340\u2192            raise PipelineConnectError(msg)\n   341\u2192\n   342\u2192        # Update the sockets with the new connection\n   343\u2192        sender_socket.receivers.append(receiver)\n   344\u2192        receiver_socket.senders.append(sender)\n   345\u2192\n   346\u2192        # Create the new connection\n   347\u2192        self.graph.add_edge(\n   348\u2192            sender,\n   349\u2192            receiver,\n   350\u2192            key=f\"{sender_socket.name}/{receiver_socket.name}\",\n   351\u2192            conn_type=_type_name(sender_socket.type),\n   352\u2192            from_socket=sender_socket,\n   353\u2192            to_socket=receiver_socket,\n   354\u2192            mandatory=receiver_socket.is_mandatory,\n   355\u2192        )\n   356\u2192\n   357\u2192    def get_component(self, name: str) -> Component:\n   358\u2192        \"\"\"\n   359\u2192        Returns an instance of a component.\n   360\u2192\n   361\u2192        Args:\n   362\u2192            name: the name of the component\n   363\u2192\n   364\u2192        Returns:\n   365\u2192            The instance of that component.\n   366\u2192\n   367\u2192        Raises:\n   368\u2192            ValueError: if a component with that name is not present in the pipeline.\n   369\u2192        \"\"\"\n   370\u2192        try:\n   371\u2192            return self.graph.nodes[name][\"instance\"]\n   372\u2192        except KeyError as exc:\n   373\u2192            raise ValueError(f\"Component named {name} not found in the pipeline.\") from exc\n   374\u2192\n   375\u2192    def inputs(self) -> Dict[str, Dict[str, Any]]:\n   376\u2192        \"\"\"\n   377\u2192        Returns a dictionary containing the inputs of a pipeline. Each key in the dictionary\n   378\u2192        corresponds to a component name, and its value is another dictionary that describes the\n   379\u2192        input sockets of that component, including their types and whether they are optional.\n   380\u2192\n   381\u2192        Returns:\n   382\u2192            A dictionary where each key is a pipeline component name and each value is a dictionary of\n   383\u2192            inputs sockets of that component.\n   384\u2192        \"\"\"\n   385\u2192        inputs: Dict[str, Dict[str, Any]] = {}\n   386\u2192        for component_name, data in find_pipeline_inputs(self.graph).items():\n   387\u2192            sockets_description = {}\n   388\u2192            for socket in data:\n   389\u2192                sockets_description[socket.name] = {\"type\": socket.type, \"is_mandatory\": socket.is_mandatory}\n   390\u2192                if not socket.is_mandatory:\n   391\u2192                    sockets_description[socket.name][\"default_value\"] = socket.default_value\n   392\u2192\n   393\u2192            if sockets_description:\n   394\u2192                inputs[component_name] = sockets_description\n   395\u2192        return inputs\n   396\u2192\n   397\u2192    def outputs(self) -> Dict[str, Dict[str, Any]]:\n   398\u2192        \"\"\"\n   399\u2192        Returns a dictionary containing the outputs of a pipeline. Each key in the dictionary\n   400\u2192        corresponds to a component name, and its value is another dictionary that describes the\n   401\u2192        output sockets of that component.\n   402\u2192\n   403\u2192        Returns:\n   404\u2192            A dictionary where each key is a pipeline component name and each value is a dictionary of\n   405\u2192            output sockets of that component.\n   406\u2192        \"\"\"\n   407\u2192        outputs = {\n   408\u2192            comp: {socket.name: {\"type\": socket.type} for socket in data}\n   409\u2192            for comp, data in find_pipeline_outputs(self.graph).items()\n   410\u2192            if data\n   411\u2192        }\n   412\u2192        return outputs\n   413\u2192\n   414\u2192    def draw(self, path: Path, engine: RenderingEngines = \"mermaid-image\") -> None:\n   415\u2192        \"\"\"\n   416\u2192        Draws the pipeline. Requires either `graphviz` as a system dependency, or an internet connection for Mermaid.\n   417\u2192        Run `pip install graphviz` or `pip install mermaid` to install missing dependencies.\n   418\u2192\n   419\u2192        Args:\n   420\u2192            path: where to save the diagram.\n   421\u2192            engine: which format to save the graph as. Accepts 'graphviz', 'mermaid-text', 'mermaid-image'.\n   422\u2192                Default is 'mermaid-image'.\n   423\u2192\n   424\u2192        Returns:\n   425\u2192            None\n   426\u2192\n   427\u2192        Raises:\n   428\u2192            ImportError: if `engine='graphviz'` and `pygraphviz` is not installed.\n   429\u2192            HTTPConnectionError: (and similar) if the internet connection is down or other connection issues.\n   430\u2192        \"\"\"\n   431\u2192        _draw(graph=networkx.MultiDiGraph(self.graph), path=path, engine=engine)\n   432\u2192\n   433\u2192    def warm_up(self):\n   434\u2192        \"\"\"\n   435\u2192        Make sure all nodes are warm.\n   436\u2192\n   437\u2192        It's the node's responsibility to make sure this method can be called at every `Pipeline.run()`\n   438\u2192        without re-initializing everything.\n   439\u2192        \"\"\"\n   440\u2192        for node in self.graph.nodes:\n   441\u2192            if hasattr(self.graph.nodes[node][\"instance\"], \"warm_up\"):\n   442\u2192                logger.info(\"Warming up component %s...\", node)\n   443\u2192                self.graph.nodes[node][\"instance\"].warm_up()\n   444\u2192\n   445\u2192    def _validate_input(self, data: Dict[str, Any]):\n   446\u2192        \"\"\"\n   447\u2192        Validates that data:\n   448\u2192        * Each Component name actually exists in the Pipeline\n   449\u2192        * Each Component is not missing any input\n   450\u2192        * Each Component has only one input per input socket, if not variadic\n   451\u2192        * Each Component doesn't receive inputs that are already sent by another Component\n   452\u2192\n   453\u2192        Raises ValueError if any of the above is not true.\n   454\u2192        \"\"\"\n   455\u2192        for component_name, component_inputs in data.items():\n   456\u2192            if component_name not in self.graph.nodes:\n   457\u2192                raise ValueError(f\"Component named {component_name} not found in the pipeline.\")\n   458\u2192            instance = self.graph.nodes[component_name][\"instance\"]\n   459\u2192            for socket_name, socket in instance.__haystack_input__.items():\n   460\u2192                if socket.senders == [] and socket.is_mandatory and socket_name not in component_inputs:\n   461\u2192                    raise ValueError(f\"Missing input for component {component_name}: {socket_name}\")\n   462\u2192            for input_name in component_inputs.keys():\n   463\u2192                if input_name not in instance.__haystack_input__:\n   464\u2192                    raise ValueError(f\"Input {input_name} not found in component {component_name}.\")\n   465\u2192\n   466\u2192        for component_name in self.graph.nodes:\n   467\u2192            instance = self.graph.nodes[component_name][\"instance\"]\n   468\u2192            for socket_name, socket in instance.__haystack_input__.items():\n   469\u2192                component_inputs = data.get(component_name, {})\n   470\u2192                if socket.senders == [] and socket.is_mandatory and socket_name not in component_inputs:\n   471\u2192                    raise ValueError(f\"Missing input for component {component_name}: {socket_name}\")\n   472\u2192                if socket.senders and socket_name in component_inputs and not socket.is_variadic:\n   473\u2192                    raise ValueError(\n   474\u2192                        f\"Input {socket_name} for component {component_name} is already sent by {socket.senders}.\"\n   475\u2192                    )\n   476\u2192\n   477\u2192    # TODO: We're ignoring this linting rules for the time being, after we properly optimize this function we'll remove the noqa\n   478\u2192    def run(  # noqa: C901, PLR0912 pylint: disable=too-many-branches\n   479\u2192        self, data: Dict[str, Any], debug: bool = False\n   480\u2192    ) -> Dict[str, Any]:\n   481\u2192        # NOTE: We're assuming data is formatted like so as of now\n   482\u2192        # data = {\n   483\u2192        #     \"comp1\": {\"input1\": 1, \"input2\": 2},\n   484\u2192        # }\n   485\u2192        #\n   486\u2192        # TODO: Support also this format:\n   487\u2192        # data = {\n   488\u2192        #     \"input1\": 1, \"input2\": 2,\n   489\u2192        # }\n   490\u2192\n   491\u2192        # TODO: Remove this warmup once we can check reliably whether a component has been warmed up or not\n   492\u2192        # As of now it's here to make sure we don't have failing tests that assume warm_up() is called in run()\n   493\u2192        self.warm_up()\n   494\u2192\n   495\u2192        # Raise if input is malformed in some way\n   496\u2192        self._validate_input(data)\n   497\u2192\n   498\u2192        # NOTE: The above NOTE and TODO are technically not true.\n   499\u2192        # This implementation of run supports only the first format, but the second format is actually\n   500\u2192        # never received by this method. It's handled by the `run