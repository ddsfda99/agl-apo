ions): An instance of the Conditions class used for managing conditions.\n    46→        graph (Graph): An instance of the Graph class used for representing the template structure.\n    47→    \"\"\"\n    48→\n    49→    def __init__(\n    50→        self,\n    51→        filename: str | None,\n    52→        template: dict[str, Any],\n    53→        regions: list[str] | None = None,\n    54→    ):\n    55→        \"\"\"Initialize a Template instance.\n    56→\n    57→        Args:\n    58→            filename (str | None): The filename of the template file, if available.\n    59→            template (dict[str, Any]): The dictionary representing the CloudFormation template.\n    60→            regions (list[str] | None): A list of AWS regions associated with the template.\n    61→        \"\"\"\n    62→        if regions is None:\n    63→            self.regions = [cfnlint.helpers.REGION_PRIMARY]\n    64→        else:\n    65→            self.regions = regions\n    66→        self.filename = filename\n    67→        self.template = template\n    68→        self.transform_pre: dict[str, Any] = {}\n    69→        self.transform_pre[\"Globals\"] = {}\n    70→        self.transform_pre[\"Ref\"] = self.search_deep_keys(\"Ref\")\n    71→        self.transform_pre[\"Fn::Sub\"] = self.search_deep_keys(\"Fn::Sub\")\n    72→        self.transform_pre[\"Fn::FindInMap\"] = self.search_deep_keys(\"Fn::FindInMap\")\n    73→        self.transform_pre[\"Transform\"] = self.template.get(\"Transform\", [])\n    74→        self.transform_pre[\"Fn::ForEach\"] = self.search_deep_keys(\n    75→            cfnlint.helpers.FUNCTION_FOR_EACH\n    76→        )\n    77→\n    78→        self.conditions = cfnlint.conditions.Conditions(self)\n    79→        self.graph = None\n    80→        try:\n    81→            self.graph = Graph(self)\n    82→        except KeyError as err:\n    83→            LOGGER.debug(\n    84→                \"Encountered KeyError error while building graph. Ignored as this \"\n    85→                \"should be caught by other rules and is more than likely a template \"\n    86→                \"formatting error: %s\",\n    87→                err,\n    88→            )\n    89→        except Exception as err:  # pylint: disable=broad-except\n    90→            LOGGER.info(\"Encountered unknown error while building graph: %s\", err)\n    91→\n    92→        self.context = create_context_for_template(self)\n    93→        self.search_deep_keys = functools.lru_cache()(self.search_deep_keys)  # type: ignore\n    94→\n    95→    def __deepcopy__(self, memo):\n    96→        cls = self.__class__\n    97→        result = cls.__new__(cls)\n    98→        memo[id(self)] = result\n    99→        for k, v in self.__dict__.items():\n   100→            setattr(result, k, deepcopy(v, memo))\n   101→        return result\n   102→\n   103→    def _cache_clear(self):\n   104→        self.search_deep_keys.cache_clear()\n   105→\n   106→    def transform(self) -> list[Match]:\n   107→        \"\"\"\n   108→        Transform the template.\n   109→\n   110→        Returns:\n   111→            list[Match]: A list of Match objects representing the transformed template.\n   112→        \"\"\"\n   113→        transform = Transform()\n   114→        results = transform.transform(self)\n   115→        self._cache_clear()\n   116→        return results\n   117→\n   118→    def build_graph(self) -> None:\n   119→        \"\"\"Generates a DOT representation of the template\"\"\"\n   120→        filename = self.filename or \"cfn-lint\"\n   121→        path = filename + \".dot\"\n   122→        if not self.graph:\n   123→            return\n   124→        try:\n   125→            self.graph.to_dot(path)\n   126→            LOGGER.info(\"DOT representation of the graph written to %s\", path)\n   127→        except ImportError:\n   128→            LOGGER.error(\n   129→                (\n   130→                    \"Could not write the graph in DOT format. \"\n   131→                    \"Please install either `pygraphviz` or `pydot` modules.\"\n   132→                )\n   133→            )\n   134→\n   135→    def has_language_extensions_transform(self) -> bool:\n   136→        \"\"\"Check if the template has the AWS::LanguageExtensions transform declared.\n   137→\n   138→        Returns:\n   139→            bool: True if the AWS::LanguageExtensions transform is declared, False otherwise.\n   140→        \"\"\"\n   141→        lang_extensions_transform = \"AWS::LanguageExtensions\"\n   142→        transform_declaration = self.transform_pre[\"Transform\"]\n   143→        transform_type = (\n   144→            transform_declaration\n   145→            if isinstance(transform_declaration, list)\n   146→            else [transform_declaration]\n   147→        )\n   148→        return bool(lang_extensions_transform in transform_type)\n   149→\n   150→    def has_serverless_transform(self) -> bool:\n   151→        \"\"\"Check if the template has the AWS::Serverless-2016-10-31 transform declared.\n   152→\n   153→        Returns:\n   154→            bool: True if the AWS::Serverless-2016-10-31 transform is declared, False otherwise.\n   155→        \"\"\"\n   156→        lang_extensions_transform = \"AWS::Serverless-2016-10-31\"\n   157→        transform_declaration = self.transform_pre[\"Transform\"]\n   158→        transform_type = (\n   159→            transform_declaration\n   160→            if isinstance(transform_declaration, list)\n   161→            else [transform_declaration]\n   162→        )\n   163→        return bool(lang_extensions_transform in transform_type)\n   164→\n   165→    def is_cdk_template(self) -> bool:\n   166→        \"\"\"Check if the template was created by the AWS Cloud Development Kit (CDK).\n   167→\n   168→        Returns:\n   169→            bool: True if the template was created by CDK, False otherwise.\n   170→        \"\"\"\n   171→        resources = self.template.get(\"Resources\")\n   172→        if not isinstance(resources, dict):\n   173→            return False\n   174→\n   175→        for _, properties in resources.items():\n   176→            if not isinstance(properties, dict):\n   177→                continue\n   178→            resource_type = properties.get(\"Type\")\n   179→            if not isinstance(resource_type, str):\n   180→                continue\n   181→            if resource_type == \"AWS::CDK::Metadata\":\n   182→                return True\n   183→\n   184→        return False\n   185→\n   186→    def get_resources(\n   187→        self, resource_type: list[str] | str = []\n   188→    ) -> dict[str, dict[str, Any]]:\n   189→        \"\"\"Get the resources in the template.\n   190→\n   191→        Args:\n   192→            resource_type (list[str] | str): An optional list or string of resource types to filter by.\n   193→\n   194→        Returns:\n   195→            dict[str, dict[str, Any]]: A dictionary containing the resources, where the keys are resource names\n   196→                and the values are the resource dictionaries.\n   197→        \"\"\"\n   198→        resources = self.template.get(\"Resources\", {})\n   199→        if not isinstance(resources, dict):\n   200→            return {}\n   201→        if isinstance(resource_type, str):\n   202→            resource_type = [resource_type]\n   203→\n   204→        results = {}\n   205→        for k, v in resources.items():\n   206→            if isinstance(v, dict):\n   207→                if (v.get(\"Type\", None) in resource_type) or (\n   208→                    not resource_type and v.get(\"Type\") is not None\n   209→                ):\n   210→                    results[k] = v\n   211→\n   212→        return results\n   213→\n   214→    def get_resource_children(\n   215→        self, resource_name: str, types: list[str] | None = None\n   216→    ) -> Iterator[str]:\n   217→        \"\"\"Get the resource children for a given resource name.\n   218→\n   219→        Args:\n   220→            resource_name (str): The name of the resource.\n   221→            types (list[str] | None): An optional list of resource types to filter by.\n   222→\n   223→        Yields:\n   224→            str: The name of each resource child.\n   225→        \"\"\"\n   226→        types = types or []\n   227→\n   228→        if self.graph:\n   229→            for node_name in self.graph.graph.predecessors(resource_name):\n   230→                node = self.graph.graph.nodes[node_name]\n   231→                if node[\"type\"] != \"Resource\":\n   232→                    continue\n   233→\n   234→                if types:\n   235→                    if node[\"resource_type\"] in types:\n   236→                        yield node_name\n   237→                else:\n   238→                    yield node_name\n   239→\n   240→    def get_parameters_valid(self) -> dict[str, dict[str, Any]]:\n   241→        \"\"\"Get the valid parameters in the template.\n   242→\n   243→        Returns:\n   244→            dict[str, dict[str, Any]]: A dictionary containing the valid parameters, where the keys are parameter names\n   245→                and the values are the parameter dictionaries.\n   246→        \"\"\"\n   247→        result = {}\n   248→        if isinstance(self.template.get(\"Parameters\"), dict):\n   249→            parameters = self.template.get(\"Parameters\", {})\n   250→            for parameter_name, parameter_value in parameters.items():\n   251→                if isinstance(parameter_value, dict):\n   252→                    if isinstance(parameter_value.get(\"Type\"), str):\n   253→                        result[parameter_name] = parameter_value\n   254→\n   255→        return result\n   256→\n   257→    def get_modules(self) -> dict[str, dict[str, Any]]:\n   258→        \"\"\"Get the modules in the template.\n   259→\n   260→        Returns:\n   261→            dict[str, dict[str, Any]]: A dictionary containing the modules, where the keys are module names\n   262→                and the values are the module dictionaries.\n   263→        \"\"\"\n   264→        resources = self.template.get(\"Resources\", {})\n   265→        if not resources:\n   266→            return {}\n   267→\n   268→        results = {}\n   269→        for k, v in resources.items():\n   270→            if isinstance(v, dict):\n   271→                if v.get(\"Type\") is not None and str(v.get(\"Type\")).endswith(\n   272→                    \"::MODULE\"\n   273→                ):\n   274→                    results[k] = v\n   275→\n   276→        return results\n   277→\n   278→    def get_valid_refs(self) -> cfnlint.helpers.RegexDict:\n   279→        \"\"\"Get a dictionary of valid references in the template.\n   280→\n   281→        Returns:\n   282→            cfnlint.helpers.RegexDict: A dictionary containing valid references, where the keys are reference names\n   283→                and the values are dictionaries with information about the reference type and source.\n   284→        \"\"\"\n   285→        results = cfnlint.helpers.RegexDict()\n   286→        parameters = self.template.get(\"Parameters\", {})\n   287→        if parameters:\n   288→            for name, value in parameters.items():\n   289→                if isinstance(value, dict):\n   290→                    if \"Type\" in value:\n   291→                        element = {}\n   292→                        element[\"Type\"] = value[\"Type\"]\n   293→                        element[\"From\"] = \"Parameters\"\n   294→                        results[name] = element\n   295→        resources = self.template.get(\"Resources\", {})\n   296→        if resources:\n   297→            for name, value in resources.items():\n   298→                resource_type = value.get(\"Type\", \"\")\n   299→                if not isinstance(resource_type, str):\n   300→                    continue\n   301→                if resource_type.endswith(\"::MODULE\"):\n   302→                    element = {}\n   303→                    element[\"Type\"] = \"MODULE\"\n   304→                    element[\"From\"] = \"Resources\"\n   305→                    results[f\"{name}.*\"] = element\n   306→                elif resource_type:\n   307→                    element = {}\n   308→                    element[\"Type\"] = resource_type\n   309→                    element[\"From\"] = \"Resources\"\n   310→                    results[name] = element\n   311→\n   312→        for pseudoparam in cfnlint.helpers.PSEUDOPARAMS:\n   313→            element = {}\n   314→            element[\"Type\"] = \"Pseudo\"\n   315→            element[\"From\"] = \"Pseudo\"\n   316→            results[pseudoparam] = element\n   317→        return results\n   318→\n   319→    def get_valid_getatts(self) -> GetAtts:\n   320→        \"\"\"Get an instance of GetAtts containing valid GetAtt references in the template.\n   321→\n   322→        Returns:\n   323→            GetAtts: An instance of GetAtts containing valid GetAtt references.\n   324→        \"\"\"\n   325→        results = GetAtts(self.regions)\n   326→\n   327→        for name, value in self.context.resources.items():\n   328→            results.add(name, value.type)\n   329→\n   330→        return results\n   331→\n   332→    def get_directives(self) -> dict[str, list[str]]:\n   333→        \"\"\"Get the directives (ignore_checks) in the template.\n   334→\n   335→        Returns:\n   336→            dict[str, list[str]]: A dictionary containing directives, where the keys are directive names\n   337→                and the values are lists of resource names associated with the directive.\n   338→        \"\"\"\n   339→        results: dict[str, list[str]] = {}\n   340→        resources = self.get_resources()\n   341→        if resources:\n   342→            for resource_name, resource_values in resources.items():\n   343→                if isinstance(resource_values, dict):\n   344→                    ignore_rule_ids = (\n   345→                        resource_values.get(\"Metadata\", {})\n   346→                        .get(\"cfn-lint\", {})\n   347→                        .get(\"config\", {})\n   348→                        .get(\"ignore_checks\", [])\n   349→                    )\n   350→                    for ignore_rule_id in ignore_rule_ids:\n   351→                        if ignore_rule_id not in results:\n   352→                            results[ignore_rule_id] = []\n   353→                        results[ignore_rule_id].append(resource_name)\n   354→        return results\n   355→\n   356→    # pylint: disable=dangerous-default-value\n   357→    def _search_deep_keys(self, searchText: str | re.Pattern, cfndict, path: Path):\n   358→        \"\"\"Search deep for keys and get their values.\n   359→\n   360→        Args:\n   361→            searchText (str | re.Pattern): The text or regular expression pattern to search for.\n   362→            cfndict (Any): The dictionary or list to search in.\n   363→            path (list[Any]): The current path in the dictionary or list.\n   364→\n   365→        Returns:\n   366→            list[list[Any]]: A list of paths where the searchText was found.\n   367→        \"\"\"\n   368→        keys = []\n   369→        if isinstance(cfndict, dict):\n   370→            for key in cfndict:\n   371→                pathprop: Path = path[:]\n   372→                pathprop.append(key)\n   373→                if isinstance(searchText, str):\n   374→                    if key == searchText:\n   375→                        pathprop.append(cfndict[key])\n   376→                        keys.append(pathprop)\n   377→                        # pop the last element off for nesting of found elements for\n   378→                        # dict and list checks\n   379→                        pathprop = pathprop[:-1]\n   380→                elif isinstance(searchText, re.Pattern):\n   381→                    if isinstance(key, str):\n   382→                        if re.match(searchText, key):\n   383→                            pathprop.append(cfndict[key])\n   384→                            keys.append(pathprop)\n   385→                            # pop the last element off for nesting of found elements for\n   386→                            # dict and list checks\n   387→                            pathprop = pathprop[:-1]\n   388→                if isinstance(cfndict[key], dict):\n   389→                    keys.extend(\n   390→                        self._search_deep_keys(searchText, cfndict[key], pathprop)\n   391→                    )\n   392→                elif isinstance(cfndict[key], list):\n   393→                    for index, item in enumerate(cfndict[key]):\n   394→                        pathproparr = pathprop[:]\n   395→                        pathproparr.append(index)\n   396→                        keys.extend(\n   397→                            self._search_deep_keys(searchText, item, pathproparr)\n   398→                        )\n   399→        elif isinstance(cfndict, list):\n   400→            for index, item in enumerate(cfndict):\n   401→                pathprop = path[:]\n   402→                pathprop.append(index)\n   403→                keys.extend(self._search_deep_keys(searchText, item, pathprop))\n   404→\n   405→        return keys\n   406→\n   407→    def search_deep_keys(\n   408→        self, searchText: str | re.Pattern, includeGlobals: bool = True\n   409→    ):\n   410→        \"\"\"Search for a key in all parts of the template.\n   411→\n   412→        Args:\n   413→            searchText (str | re.Pattern): The text or regular expression pattern to search for.\n   414→            includeGlobals (bool): Whether to include globals in the search.\n   415→\n   416→        Returns:\n   417→            liist[[Any]]: A list of paths where the searchText was found.\n   418→\n   419→        Example:\n   420→            If searchText is \"Ref\", the return value could be something like\n   421→            ['Resources', 'myInstance', 'Properties', 'ImageId', 'Ref', 'Ec2ImageId']\n   422→        \"\"\"\n   423→        results = []\n   424→        results.extend(self._search_deep_keys(searchText, self.template, []))\n   425→        # Globals are removed during a transform.  They need to be checked manually\n   426→        if includeGlobals:\n   427→            pre_results = self._search_deep_keys(\n   428→                searchText, self.transform_pre.get(\"Globals\"), []\n   429→            )\n   430→            for pre_result in pre_results:\n   431→                results.append([\"Globals\"] + pre_result)\n   432→        return results\n   433→\n   434→    def get_condition_values(self, template, path: Path | None) -> list[dict[str, Any]]:\n   435→        \"\"\"\n   436→        Evaluates conditions in the provided CloudFormation template and returns the values.\n   437→\n   438→        Args:\n   439→            template (list): The CloudFormation template to evaluate.\n   440→            path (list, optional): The current path in the template. Defaults to an empty list.\n   441→\n   442→        Returns:\n   443→            list: A list of dictionaries, where each dictionary contains the following keys:\n   444→                - \"Path\": The path to the condition value in the template.\n   445→                - \"Value\": The value of the condition.\n   446→        \"\"\"\n   447→        path = path or []\n   448→        matches: list[dict[str, Any]] = []\n   449→        if not isinstance(template, list):\n   450→            return matches\n   451→        if not len(template) == 3:\n   452→            return matches\n   453→\n   454→        for index, item in enumerate(template[1:]):\n   455→            result: dict[str, Any] = {}\n   456→            result[\"Path\"] = path[:] + [index + 1]\n   457→            if not isinstance(item, (dict, list)):\n   458→                # Just straight values and pass them through\n   459→                result[\"Value\"] = item\n   460→                matches.append(result)\n   461→            elif len(item) == 1:\n   462→                # Checking for conditions inside of conditions\n   463→                if isinstance(item, dict):\n   464→                    for sub_key, sub_value in item.items():\n   465→                        if sub_key in cfnlint.helpers.CONDITION_FUNCTIONS:\n   466→                            results = self.get_condition_values(\n   467→                                sub_value, result[\"Path\"] + [sub_key]\n   468→                            )\n   469→                            if isinstance(results, list):\n   470→                                matches.extend(results)\n   471→                        elif sub_key == \"Ref\":\n   472→                            if sub_value != \"AWS::NoValue\":\n   473→                                result[\"Value\"] = item\n   474→                                matches.append(result)\n   475→                        else:\n   476→                            # Return entire Item\n   477→                            result[\"Value\"] = item\n   478→                            matches.append(result)\n   479→                else:\n   480→                    # Return entire Item\n   481→                    result[\"Value\"] = item\n   482→                    matches.append(result)\n   483→            else:\n   484→                # Length longer than 1 means a list or object that\n   485→                # should be fully returned\n   486→                result[\"Value\"] = item\n   487→                matches.append(result)\n   488→\n   489→        return matches\n   490→\n   491→    def get_values(self, obj, key, path: Path | None = None):\n   492→        \"\"\"\n   493→        Logic for getting the value of a key in the provided object.\n   494→\n   495→        Args:\n   496→            obj (dict): The object to search for the key.\n   497→            key (str): The key to search for in the object.\n   498→            path (list, optional): The current path in the object. Defaults to an empty list.\n   499→\n   500→        Returns:\n   501→            list: A list of dictionaries, where each dictionary contains the following keys:\n   502→            - \"Path\": The path to the value in the object.\n   503→            - \"Value\": The value found for the key.\n   504→\n   505→            Types of return values\n   506→            - Returns None if the item isn't found\n   507→            - Returns empty list if the item is found but Ref or GetAtt\n   508→            - Returns all the values as a list if condition\n   509→            - Returns the value if its just a string, int, boolean, etc.\n   510→        \"\"\"\n   511→        path = path or []\n   512→        matches = []\n   513→\n   514→        if not isinstance(obj, dict):\n   515→            return None\n   516→        value = obj.get(key)\n   517→        if value is None:\n   518→            return None\n   519→        if isinstance(value, (dict)):\n   520→            if len(value) == 1:\n   521→                is_condition = False\n   522→                is_no_value = False\n   523→                for obj_key, obj_value in value.items():\n   524→                    if obj_key in cfnlint.helpers.CONDITION_FUNCTIONS:\n   525→                        is_condition = True\n   526→                        results = self.get_condition_values(\n   527→                            obj_value, path[:] + [obj_key]\n   528→                        )\n   529→                        if isinstance(results, list):\n   530→                            for result in results:\n   531→                                check_obj = obj.copy()\n   532→                                check_obj[key] = result[\"Value\"]\n   533→                                matches.extend(\n   534→                                    self.get_values(check_obj, key, result[\"Path\"])\n   535→                                )\n   536→                    elif obj_key == \"Ref\" and obj_value == \"AWS::NoValue\":\n   537→                        is_no_value = True\n   538→                if not is_condition and not is_no_value:\n   539→                    result = {}\n   540→                    result[\"Path\"] = path[:]\n   541→                    result[\"Value\"] = value\n   542→                    matches.append(result)\n   543→            else:\n   544→                result = {}\n   545→                result[\"Path\"] = path[:]\n   546→                result[\"Value\"] = value\n   547→                matches.append(result)\n   548→        elif isinstance(value, (list)):\n   549→            for list_index, list_value in enumerate(value):\n   550→                if isinstance(list_value, dict):\n   551→                    if len(list_value) == 1:\n   552→                        is_condition = False\n   553→                        is_no_value = False\n   554→                        for obj_key, obj_value in list_value.items():\n   555→                            if obj_key in cfnlint.helpers.CONDITION_FUNCTIONS:\n   556→                                is_condition = True\n   557→                                results = self.get_condition_values(\n   558→                                    obj_value, path[:] + [list_index, obj_key]\n   559→                                )\n   560→                                if isinstance(results, list):\n   561→                                    matches.extend(results)\n   562→                            elif obj_key == \"Ref\" and obj_value == \"AWS::NoValue\":\n   563→                                is_no_value = True\n   564→                        if not is_condition and not is_no_value:\n   565→                            result = {}\n   566→                            result[\"Path\"] = path[:] + [list_index]\n   567→                            result[\"Value\"] = list_value\n   568→                            matches.append(result)\n   569→                    else:\n   570→                        result = {}\n   571→                        result[\"Path\"] = path[:] + [list_index]\n   572→                        result[\"Value\"] = list_value\n   573→                        matches.append(result)\n   574→                else:\n   575→                    result = {}\n   576→                    result[\"Path\"] = path[:] + [list_index]\n   577→                    result[\"Value\"] = list_value\n   578→                    matches.append(result)\n   579→        else:\n   580→            result = {}\n   581→            result[\"Path\"] = path[:]\n   582→            result[\"Value\"] = value\n   583→            matches.append(result)\n   584→\n   585→        return matches\n   586→\n   587→    def _loc(self, obj: Any) -> tuple[int, int, int, int]:\n   588→        \"\"\"Return location of object\"\"\"\n   589→        return (\n   590→            obj.start_mark.line,\n   591→            obj.start_mark.column,\n   592→            obj.end_mark.line,\n   593→            obj.end_mark.column,\n   594→        )\n   595→\n   596→    def get_sub_parameters(self, sub_string):\n   597→        \"\"\"\n   598→        Gets the parameters out of a Sub String.\n   599→\n   600→        Args:\n   601→            sub_string (str): The Sub string to extract parameters from.\n   602→\n   603→        Returns:\n   604→            list: A list of the parameter names found in the Sub string.\n   605→        \"\"\"\n   606→        results = []\n   607→        if not isinstance(sub_string, str):\n   608→            return results\n   609→        regex = re.compile(r\"\\${[^!].*?}\")\n   610→        string_params = regex.findall(sub_string)\n   611→\n   612→        for string_param in string_params:\n   613→            results.append(string_param[2:-1].strip())\n   614→\n   615→        return results\n   616→\n   617→    def get_location_yaml(self, text: Any, path: Path):\n   618→        \"\"\"\n   619→        Get the location information for the given YAML text and path.\n   620→\n   621→        Args:\n   622→            text (str): The YAML text to search.\n   623→            path (list): The path to the location within the YAML text.\n   624→\n   625→        Returns:\n   626→            dict or None: A dictionary containing the location information, or None if the location could not be found.\n   627→            The dictionary has the following keys:\n   628→                - \"start_mark\": A dictionary with \"line\" and \"column\" keys indicating the start of the location.\n   629→                - \"end_mark\": A dictionary with \"line\" and \"column\" keys indicating the end of the location.\n   630→        \"\"\"\n   631→        result = None\n   632→        if not path:\n   633→            result = self._loc(text)\n   634→        elif len(path) > 1:\n   635→            try:\n   636→                result = self.get_location_yaml(text[path[0]], path[1:])\n   637→            except KeyError:\n   638→                pass\n   639→            # TypeError will help catch string indices must be integers for when\n   640→            # we parse JSON string and get a path inside that json string\n   641→            except TypeError:\n   642→                pass\n   643→            if not result:\n   644→                try:\n   645→                    for key in text:\n   646→                        if key == path[0]:\n   647→                            result = self._loc(key)\n   648→                except AttributeError as err:\n   649→                    LOGGER.debug(err)\n   650→        else:\n   651→            # If the last item of the path is an integer, and the vaue is an array,\n   652→            # Get the location of the item in the array\n   653→            if isinstance(text, list) and isinstance(path[0], int):\n   654→                try:\n   655→                    result = self._loc(text[path[0]])\n   656→                except AttributeError as err:\n   657→                    LOGGER.debug(err)\n   658→            else:\n   659→                try:\n   660→                    for key in text:\n   661→                        if key == path[0]:\n   662→                            result = self._loc(key)\n   663→                except AttributeError as err:\n   664→                    LOGGER.debug(err)\n   665→\n   666→        return result\n   667→\n   668→    # pylint: disable=W0613,too-many-locals\n   669→    def check_value(\n   670→        self,\n   671→        obj: dict[str, Any],\n   672→        key: str,\n   673→        path: Path,\n   674→        check_value: CheckValueFn | None = None,\n   675→        check_ref: CheckValueFn | None = None,\n   676→        check_get_att: CheckValueFn | None = None,\n   677→        check_find_in_map: CheckValueFn | None = None,\n   678→        check_split: CheckValueFn | None = None,\n   679→        check_join: CheckValueFn | None = None,\n   680→        check_import_value: CheckValueFn | None = None,\n   681→        check_sub: CheckValueFn | None = None,\n   682→        pass_if_null: bool = False,\n   683→        **kwargs: dict[str, Any],\n   684→    ) -> list[RuleMatch]:\n   685→        \"\"\"\n   686→        Check the value of a key in the provided object.\n   687→\n   688→        Args:\n   689→            obj (dict): The object to check the value of.\n   690→            key (str): The key to check the value of.\n   691→            path (list): The path to the current location in the object.\n   692→            check_value (callable, optional): A function to check the value of the key.\n   693→            check_ref (callable, optional): A function to check the \"Ref\" function.\n   694→            check_get_att (callable, optional): A function to check the \"Fn::GetAtt\" function.\n   695→            check_find_in_map (callable, optional): A function to check the \"Fn::FindInMap\" function.\n   696→            check_split (callable, optional): A function to check the \"Fn::Split\" function.\n   697→            check_join (callable, optional): A function to check the \"Fn::Join\" function.\n   698→            check_import_value (callable, optional): A function to check the \"Fn::ImportValue\" function.\n   699→            check_sub (callable, optional): A function to check the \"Fn::Sub\" function.\n   700→            pass_if_null (bool, optional): Whether to pass if the value is null. Defaults to False.\n   701→            **kwargs (dict): Additional keyword arguments to pass to the check functions.\n   702→\n   703→        Returns:\n   704→            list[RuleMatch]: A list of matches found during the check.\n   705→        \"\"\"\n   706→        matches = []\n   707→        values_obj = self.get_values(obj=obj, key=key)\n   708→        new_path = path[:] + [key]\n   709→        if values_obj is None and pass_if_null:\n   710→            if check_value:\n   711→                matches.extend(\n   712→                    check_value(value=values_obj, path=new_path[:], **kwargs)\n   713→                )\n   714→        elif not values_obj:\n   715→            return matches\n   716→        else:\n   717→            for value_obj in values_obj:\n   718→                value = value_obj[\"Value\"]\n   719→                child_path = value_obj[\"Path\"]\n   720→                if not isinstance(value, dict):\n   721→                    if check_value:\n   722→                        matches.extend(\n   723→                            check_value(\n   724→                                value=value, path=new_path[:] + child_path, **kwargs\n   725→                            )\n   726→                        )\n   727→                else:\n   728→                    if len(value) == 1:\n   729→                        for dict_name, _ in value.items():\n   730→                            # If this is a function we shouldn't fall\n   731→                            # back to a check_value check\n   732→                            if dict_name in cfnlint.helpers.FUNCTIONS:\n   733→                                # convert the function name from camel case\n   734→                                # to underscore\n   735→                                # Example: Fn::FindInMap becomes\n   736→                                # check_find_in_map\n   737→                                # ruff: noqa: E501\n   738→                                function_name = f'check_{camel_to_snake(dict_name.replace(\"Fn::\", \"\"))}'\n   739→                                if function_name == \"check_ref\":\n   740→                                    if check_ref:\n   741→                                        matches.extend(\n   742→                                            check_ref(\n   743→                                                value=value.get(\"Ref\"),\n   744→                                                path=new_path[:] + child_path + [\"Ref\"],\n   745→                                                parameters=self.template.get(\n   746→                                                    \"Parameters\", {}\n   747→                                                ),\n   748→                                                resources=self.get_resources(),\n   749→                                                **kwargs,\n   750→                                            )\n   751→                                        )\n   752→                                else:\n   753→                                    if locals().get(function_name):\n   754→                                        matches.extend(\n   755→                                            locals()[function_name](\n   756→                                                value=value.get(dict_name),\n   757→                                                path=new_path[:]\n   758→                                                + child_path\n   759→                                                + [dict_name],\n   760→                                                **kwargs,\n   761→                                            )\n   762→                                        )\n   763→                            else:\n   764→                                if check_value:\n   765→                                    matches.extend(\n   766→                                        check_value(\n   767→                                            value=value,\n   768→                                            path=new_path[:] + child_path,\n   769→                                            **kwargs,\n   770→                                        )\n   771→                                    )\n   772→                    else:\n   773→                        if check_value:\n   774→                            matches.extend(\n   775→                                check_value(\n   776→                                    value=value, path=new_path[:] + child_path, **kwargs\n   777→                                )\n   778→                            )\n   779→\n   780→        return matches\n   781→\n   782→    def is_resource_available(self, path: Path, resource: str) -> list[dict[str, bool]]:\n   783→        \"\"\"\n   784→        Compares a path to a resource to see if it is available.\n   785→\n   786→        This function returns scenarios that may result in the resource not existing.\n   787→\n   788→        Args:\n   789→            path (list): An array that is a path to the object being checked.\n   790→            resource (str): The resource being compared.\n   791→\n   792→        Returns:\n   793→            list: If the resource is available, the result is an empty list [].\n   794→                If the resource is not available, the function returns a list of dictionaries,\n   795→                where each dictionary represents a scenario where the resource is not available.\n   796→                The dictionary keys are the condition names, and the values indicate whether\n   797→                the condition is True or False.\n   798→        \"\"\"\n   799→        results: list[dict[str, bool]] = []\n   800→        path_conditions = self.get_conditions_from_path(self.template, path)\n   801→        resource_condition = (\n   802→            self.template.get(\"Resources\", {}).get(resource, {}).get(\"Condition\")\n   803→        )\n   804→        if isinstance(resource_condition, str):\n   805→            # if path conditions are empty that means its always true\n   806→            if not path_conditions:\n   807→                return [{resource_condition: False}]\n   808→\n   809→            # resource conditions are always true.  If the same resource condition\n   810→            # exists in the path with the True then nothing else matters\n   811→            if True in path_conditions.get(resource_condition, {False}):\n   812→                return []\n   813→\n   814→            # resource conditions are always true.  If the same resource condition\n   815→            # exists in the path with the False then nothing else matters\n   816→            if False in path_conditions.get(resource_condition, {True}):\n   817→                return [{resource_condition: False}]\n   818→\n   819→            # if any condition paths loop back on themselves with the opposite\n   820→            # then its unreachable code\n   821→            scenario = {}\n   822→            for condition_name, condition_bool in path_conditions.items():\n   823→                if len(condition_bool) > 1:\n   824                    return results\n   825→                scenario[condition_name] = list(condition_bool)[0]\n   826→\n   827→            if self.conditions.check_implies(scenario, resource_condition):\n   828→                return [{**{resource_condition: False}, **scenario}]\n   829→\n   830→        # if resource condition isn't available then the resource is available\n   831→        return results\n   832→\n   833→    def get_object_without_nested_conditions(\n   834→        self, obj: dict | list, path: Path, region: str | None = None\n   835→    ):\n   836→        \"\"\"\n   837→        Get a list of object values without conditions included.\n   838→\n   839→        Evaluates deep into the object removing any nested conditions as well.\n   840→\n   841→        Args:\n   842→            obj (dict): The object to process.\n   843→            path (list): The current path in the object.\n   844→            region (str, optional): The AWS region to use for evaluating conditions. Defaults to None.\n   845→\n   846→        Returns:\n   847→            list: A list of dictionaries, where each dictionary contains the following keys:\n   848→                - \"Scenario\": The scenario for the object, or None if there are no conditions.\n   849→                - \"Object\": The object with conditions removed.\n   850→        \"\"\"\n   851→        results = []\n   852→        scenarios = self.get_condition_scenarios_below_path(path, False, region)\n   853→        if not isinstance(obj, (dict, list)):\n   854→            return results\n   855→\n   856→        def get_value(value, scenario):  # pylint: disable=R0911\n   857→            \"\"\"Get the value based on the scenario resolving nesting\"\"\"\n   858→            if isinstance(value, dict):\n   859→                if len(value) == 1:\n   860→                    if \"Fn::If\" in value:\n   861→                        if_values = value.get(\"Fn::If\")\n   862→                        if len(if_values) == 3:\n   863→                            if_path = scenario.get(if_values[0], None)\n   864→                            if if_path is not None:\n   865→                                if if_path:\n   866→                                    return get_value(if_values[1], scenario)\n   867→                                return get_value(if_values[2], scenario)\n   868→                    elif value.get(\"Ref\") == \"AWS::NoValue\":\n   869→                        return None\n   870→\n   871→                new_object = {}\n   872→                for k, v in value.items():\n   873→                    new_v = get_value(v, scenario)\n   874→                    if new_v is not None:\n   875→                        new_object[k] = get_value(v, scenario)\n   876→                return new_object\n   877→            if isinstance(value, list):\n   878→                new_list = []\n   879→                for item in value:\n   880→                    new_value = get_value(item, scenario)\n   881→                    if new_value is not None:\n   882→                        new_list.append(get_value(item, scenario))\n   883→\n   884→                return new_list\n   885→\n   886→            return value\n   887→\n   888→        if not scenarios:\n   889→            if isinstance(obj, dict):\n   890→                if len(obj) == 1:\n   891→                    if obj.get(\"Ref\") == \"AWS::NoValue\":\n   892→                        return [{\"Scenario\": None, \"Object\": {}}]\n   893→            return [{\"Scenario\": None, \"Object\": get_value(obj, {})}]\n   894→\n   895→        for scenario in scenarios:\n   896→            results.append({\"Scenario\": scenario, \"Object\": get_value(obj, scenario)})\n   897→\n   898→        return results\n   899→\n   900→    def get_value_from_scenario(self, obj, scenario):\n   901→        \"\"\"\n   902→        Get object values from a provided scenario.\n   903→\n   904→        This function recursively processes the provided object, resolving any\n   905→        conditional logic (such as Fn::If) based on the given scenario.\n   906→\n   907→        Args:\n   908→            obj (dict): The object to process.\n   909→            scenario (dict): The scenario to use when resolving conditional logic.\n   910→\n   911→        Returns:\n   912→            dict or list or any: The processed object, with conditional logic resolved.\n   913→            The return type can be a dictionary, list, or any other data type,\n   914→            depending on the structure of the input object.\n   915→        \"\"\"\n   916→\n   917→        def get_value(value, scenario):  # pylint: disable=R0911\n   918→            \"\"\"Get the value based on the scenario resolving nesting\"\"\"\n   919→            if isinstance(value, dict):\n   920→                if len(value) == 1:\n   921→                    if \"Fn::If\" in value:\n   922→                        if_values = value.get(\"Fn::If\")\n   923→                        if len(if_values) == 3:\n   924→                            if_path = scenario.get(if_values[0], None)\n   925→                            if if_path is not None:\n   926→                                if if_path:\n   927→                                    return get_value(if_values[1], scenario)\n   928→                                return get_value(if_values[2], scenario)\n   929→                    elif value.get(\"Ref\") == \"AWS::NoValue\":\n   930→                        return None\n   931→                    else:\n   932→                        return value\n   933→\n   934→                return value\n   935→            if isinstance(value, list):\n   936→                new_list = []\n   937→                for item in value:\n   938→                    new_value = get_value(item, scenario)\n   939→                    if new_value is not None:\n   940→                        new_list.append(get_value(item, scenario))\n   941→\n   942→                return new_list\n   943→\n   944→            return value\n   945→\n   946→        if isinstance(obj, dict):\n   947→            result = dict_node({}, obj.start_mark, obj.end_mark)\n   948→            if len(obj) == 1:\n   949→                if obj.get(\"Fn::If\"):\n   950→                    new_value = get_value(obj, scenario)\n   951→                    if new_value is not None:\n   952→                        result = new_value\n   953→                else:\n   954→                    for key, value in obj.items():\n   955→                        new_value = get_value(value, scenario)\n   956→                        if new_value is not None:\n   957→                            result[key] = new_value\n   958→            else:\n   959→                for key, value in obj.items():\n   960→                    new_value = get_value(value, scenario)\n   961→                    if new_value is not None:\n   962→                        result[key] = new_value\n   963→            return result\n   964→        if isinstance(obj, list):\n   965→            result = list_node({}, obj.start_mark, obj.end_mark)\n   966→            for item in obj:\n   967→                element = get_value(item, scenario)\n   968→                if element is not None:\n   969→                    result.append(element)\n   970→\n   971→            return result\n   972→\n   973→        return obj\n   974→\n   975→    def get_object_without_conditions(self, obj, property_names=None, region=None):\n   976→        \"\"\"\n   977→        Gets a list of object values without conditions included\n   978→        Input:\n   979→            obj: The object/dict that makes up a set of properties\n   980→            Example:\n   981→                {\n   982→                    \"DBSnapshotIdentifier\" : {\n   983→                        \"Fn::If\" : [\n   984→                            \"UseDBSnapshot\",\n   985→                            {\"Ref\" : \"DBSnapshotName\"},\n   986→                            {\"Ref\" : \"AWS::NoValue\"}\n   987→                        ]\n   988→                    }\n   989→                }\n   990→        Output:\n   991→            A list of objects with scenarios for the conditions played out.\n   992→            If Ref to AWS::NoValue remove the property\n   993→            Example: [\n   994→                {\n   995→                    Object: {\n   996→                        \"DBSnapshotIdentifier\" : {\"Ref\" : \"DBSnapshotName\"}\n   997→                    },\n   998→                    Scenario: {UseDBSnapshot: True}\n   999→                }, {\n  1000→                    Object: {\n  1001→                    },\n  1002→                    Scenario: {UseDBSnapshot: False}\n  1003→                }\n  1004→            ]\n  1005→        \"\"\"\n  1006→        if not isinstance(obj, (dict, list)):\n  1007→            return [{\"Scenario\": None, \"Object\": obj}]\n  1008→        property_names = [] if property_names is None else property_names\n  1009→        if getattr(obj, \"start_mark\", None):\n  1010→            start_mark = obj.start_mark\n  1011→            end_mark = obj.end_mark\n  1012→        else:\n  1013→            start_mark = (0, 0)\n  1014→            end_mark = (0, 0)\n  1015→        if isinstance(obj, list):\n  1016→            o = list_node(deepcopy(obj), start_mark=start_mark, end_mark=end_mark)\n  1017→        else:\n  1018→            if property_names:\n  1019→                o = dict_node({}, start_mark=start_mark, end_mark=end_mark)\n  1020→                for property_name in property_names:\n  1021→                    o[property_name] = deepcopy(obj.get(property_name))\n  1022→            else:\n  1023→                o = dict_node(deepcopy(obj), start_mark=start_mark, end_mark=end_mark)\n  1024→\n  1025→        results = []\n  1026→\n  1027→        scenarios = self.get_conditions_scenarios_from_object(o, region)\n  1028→\n  1029→        if isinstance(obj, list):\n  1030→            if not scenarios:\n  1031→                return [\n  1032→                    {\"Scenario\": None, \"Object\": self.get_value_from_scenario(o, {})}\n  1033→                ]\n  1034→            for scenario in scenarios:\n  1035→                result_list = []\n  1036→                for o in obj:\n  1037→                    result_obj = self.get_value_from_scenario(o, scenario)\n  1038→                    if result_obj:\n  1039→                        result_list.append(result_obj)\n  1040→                results.append({\"Scenario\": scenario