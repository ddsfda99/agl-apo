              pathprop.append(cfndict[key])\n   384\u2192                            keys.append(pathprop)\n   385\u2192                            # pop the last element off for nesting of found elements for\n   386\u2192                            # dict and list checks\n   387\u2192                            pathprop = pathprop[:-1]\n   388\u2192                if isinstance(cfndict[key], dict):\n   389\u2192                    keys.extend(\n   390\u2192                        self._search_deep_keys(searchText, cfndict[key], pathprop)\n   391\u2192                    )\n   392\u2192                elif isinstance(cfndict[key], list):\n   393\u2192                    for index, item in enumerate(cfndict[key]):\n   394\u2192                        pathproparr = pathprop[:]\n   395\u2192                        pathproparr.append(index)\n   396\u2192                        keys.extend(\n   397\u2192                            self._search_deep_keys(searchText, item, pathproparr)\n   398\u2192                        )\n   399\u2192        elif isinstance(cfndict, list):\n   400\u2192            for index, item in enumerate(cfndict):\n   401\u2192                pathprop = path[:]\n   402\u2192                pathprop.append(index)\n   403\u2192                keys.extend(self._search_deep_keys(searchText, item, pathprop))\n   404\u2192\n   405\u2192        return keys\n   406\u2192\n   407\u2192    def search_deep_keys(\n   408\u2192        self, searchText: str | re.Pattern, includeGlobals: bool = True\n   409\u2192    ):\n   410\u2192        \"\"\"Search for a key in all parts of the template.\n   411\u2192\n   412\u2192        Args:\n   413\u2192            searchText (str | re.Pattern): The text or regular expression pattern to search for.\n   414\u2192            includeGlobals (bool): Whether to include globals in the search.\n   415\u2192\n   416\u2192        Returns:\n   417\u2192            liist[[Any]]: A list of paths where the searchText was found.\n   418\u2192\n   419\u2192        Example:\n   420\u2192            If searchText is \"Ref\", the return value could be something like\n   421\u2192            ['Resources', 'myInstance', 'Properties', 'ImageId', 'Ref', 'Ec2ImageId']\n   422\u2192        \"\"\"\n   423\u2192        results = []\n   424\u2192        results.extend(self._search_deep_keys(searchText, self.template, []))\n   425\u2192        # Globals are removed during a transform.  They need to be checked manually\n   426\u2192        if includeGlobals:\n   427\u2192            pre_results = self._search_deep_keys(\n   428\u2192                searchText, self.transform_pre.get(\"Globals\"), []\n   429\u2192            )\n   430\u2192            for pre_result in pre_results:\n   431\u2192                results.append([\"Globals\"] + pre_result)\n   432\u2192        return results\n   433\u2192\n   434\u2192    def get_condition_values(self, template, path: Path | None) -> list[dict[str, Any]]:\n   435\u2192        \"\"\"\n   436\u2192        Evaluates conditions in the provided CloudFormation template and returns the values.\n   437\u2192\n   438\u2192        Args:\n   439\u2192            template (list): The CloudFormation template to evaluate.\n   440\u2192            path (list, optional): The current path in the template. Defaults to an empty list.\n   441\u2192\n   442\u2192        Returns:\n   443\u2192            list: A list of dictionaries, where each dictionary contains the following keys:\n   444\u2192                - \"Path\": The path to the condition value in the template.\n   445\u2192                - \"Value\": The value of the condition.\n   446\u2192        \"\"\"\n   447\u2192        path = path or []\n   448\u2192        matches: list[dict[str, Any]] = []\n   449\u2192        if not isinstance(template, list):\n   450\u2192            return matches\n   451\u2192        if not len(template) == 3:\n   452\u2192            return matches\n   453\u2192\n   454\u2192        for index, item in enumerate(template[1:]):\n   455\u2192            result: dict[str, Any] = {}\n   456\u2192            result[\"Path\"] = path[:] + [index + 1]\n   457\u2192            if not isinstance(item, (dict, list)):\n   458\u2192                # Just straight values and pass them through\n   459\u2192                result[\"Value\"] = item\n   460\u2192                matches.append(result)\n   461\u2192            elif len(item) == 1:\n   462\u2192                # Checking for conditions inside of conditions\n   463\u2192                if isinstance(item, dict):\n   464\u2192                    for sub_key, sub_value in item.items():\n   465\u2192                        if sub_key in cfnlint.helpers.CONDITION_FUNCTIONS:\n   466\u2192                            results = self.get_condition_values(\n   467\u2192                                sub_value, result[\"Path\"] + [sub_key]\n   468\u2192                            )\n   469\u2192                            if isinstance(results, list):\n   470\u2192                                matches.extend(results)\n   471\u2192                        elif sub_key == \"Ref\":\n   472\u2192                            if sub_value != \"AWS::NoValue\":\n   473\u2192                                result[\"Value\"] = item\n   474\u2192                                matches.append(result)\n   475\u2192                        else:\n   476\u2192                            # Return entire Item\n   477\u2192                            result[\"Value\"] = item\n   478\u2192                            matches.append(result)\n   479\u2192                else:\n   480\u2192                    # Return entire Item\n   481\u2192                    result[\"Value\"] = item\n   482\u2192                    matches.append(result)\n   483\u2192            else:\n   484\u2192                # Length longer than 1 means a list or object that\n   485\u2192                # should be fully returned\n   486\u2192                result[\"Value\"] = item\n   487\u2192                matches.append(result)\n   488\u2192\n   489\u2192        return matches\n   490\u2192\n   491\u2192    def get_values(self, obj, key, path: Path | None = None):\n   492\u2192        \"\"\"\n   493\u2192        Logic for getting the value of a key in the provided object.\n   494\u2192\n   495\u2192        Args:\n   496\u2192            obj (dict): The object to search for the key.\n   497\u2192            key (str): The key to search for in the object.\n   498\u2192            path (list, optional): The current path in the object. Defaults to an empty list.\n   499\u2192\n   500\u2192        Returns:\n   501\u2192            list: A list of dictionaries, where each dictionary contains the following keys:\n   502\u2192            - \"Path\": The path to the value in the object.\n   503\u2192            - \"Value\": The value found for the key.\n   504\u2192\n   505\u2192            Types of return values\n   506\u2192            - Returns None if the item isn't found\n   507\u2192            - Returns empty list if the item is found but Ref or GetAtt\n   508\u2192            - Returns all the values as a list if condition\n   509\u2192            - Returns the value if its just a string, int, boolean, etc.\n   510\u2192        \"\"\"\n   511\u2192        path = path or []\n   512\u2192        matches = []\n   513\u2192\n   514\u2192        if not isinstance(obj, dict):\n   515\u2192            return None\n   516\u2192        value = obj.get(key)\n   517\u2192        if value is None:\n   518\u2192            return None\n   519\u2192        if isinstance(value, (dict)):\n   520\u2192            if len(value) == 1:\n   521\u2192                is_condition = False\n   522\u2192                is_no_value = False\n   523\u2192                for obj_key, obj_value in value.items():\n   524\u2192                    if obj_key in cfnlint.helpers.CONDITION_FUNCTIONS:\n   525\u2192                        is_condition = True\n   526\u2192                        results = self.get_condition_values(\n   527\u2192                            obj_value, path[:] + [obj_key]\n   528\u2192                        )\n   529\u2192                        if isinstance(results, list):\n   530\u2192                            for result in results:\n   531\u2192                                check_obj = obj.copy()\n   532\u2192                                check_obj[key] = result[\"Value\"]\n   533\u2192                                matches.extend(\n   534\u2192                                    self.get_values(check_obj, key, result[\"Path\"])\n   535\u2192                                )\n   536\u2192                    elif obj_key == \"Ref\" and obj_value == \"AWS::NoValue\":\n   537\u2192                        is_no_value = True\n   538\u2192                if not is_condition and not is_no_value:\n   539\u2192                    result = {}\n   540\u2192                    result[\"Path\"] = path[:]\n   541\u2192                    result[\"Value\"] = value\n   542\u2192                    matches.append(result)\n   543\u2192            else:\n   544\u2192                result = {}\n   545\u2192                result[\"Path\"] = path[:]\n   546\u2192                result[\"Value\"] = value\n   547\u2192                matches.append(result)\n   548\u2192        elif isinstance(value, (list)):\n   549\u2192            for list_index, list_value in enumerate(value):\n   550\u2192                if isinstance(list_value, dict):\n   551\u2192                    if len(list_value) == 1:\n   552\u2192                        is_condition = False\n   553\u2192                        is_no_value = False\n   554\u2192                        for obj_key, obj_value in list_value.items():\n   555\u2192                            if obj_key in cfnlint.helpers.CONDITION_FUNCTIONS:\n   556\u2192                                is_condition = True\n   557\u2192                                results = self.get_condition_values(\n   558\u2192                                    obj_value, path[:] + [list_index, obj_key]\n   559\u2192                                )\n   560\u2192                                if isinstance(results, list):\n   561\u2192                                    matches.extend(results)\n   562\u2192                            elif obj_key == \"Ref\" and obj_value == \"AWS::NoValue\":\n   563\u2192                                is_no_value = True\n   564\u2192                        if not is_condition and not is_no_value:\n   565\u2192                            result = {}\n   566\u2192                            result[\"Path\"] = path[:] + [list_index]\n   567\u2192                            result[\"Value\"] = list_value\n   568\u2192                            matches.append(result)\n   569\u2192                    else:\n   570\u2192                        result = {}\n   571\u2192                        result[\"Path\"] = path[:] + [list_index]\n   572\u2192                        result[\"Value\"] = list_value\n   573\u2192                        matches.append(result)\n   574\u2192                else:\n   575\u2192                    result = {}\n   576\u2192                    result[\"Path\"] = path[:] + [list_index]\n   577\u2192                    result[\"Value\"] = list_value\n   578\u2192                    matches.append(result)\n   579\u2192        else:\n   580\u2192            result = {}\n   581\u2192            result[\"Path\"] = path[:]\n   582\u2192            result[\"Value\"] = value\n   583\u2192            matches.append(result)\n   584\u2192\n   585\u2192        return matches\n   586\u2192\n   587\u2192    def _loc(self, obj: Any) -> tuple[int, int, int, int]:\n   588\u2192        \"\"\"Return location of object\"\"\"\n   589\u2192        return (\n   590\u2192            obj.start_mark.line,\n   591\u2192            obj.start_mark.column,\n   592\u2192            obj.end_mark.line,\n   593\u2192            obj.end_mark.column,\n   594\u2192        )\n   595\u2192\n   596\u2192    def get_sub_parameters(self, sub_string):\n   597\u2192        \"\"\"\n   598\u2192        Gets the parameters out of a Sub String.\n   599\u2192\n   600\u2192        Args:\n   601\u2192            sub_string (str): The Sub string to extract parameters from.\n   602\u2192\n   603\u2192        Returns:\n   604\u2192            list: A list of the parameter names found in the Sub string.\n   605\u2192        \"\"\"\n   606\u2192        results = []\n   607\u2192        if not isinstance(sub_string, str):\n   608\u2192            return results\n   609\u2192        regex = re.compile(r\"\\${[^!].*?}\")\n   610\u2192        string_params = regex.findall(sub_string)\n   611\u2192\n   612\u2192        for string_param in string_params:\n   613\u2192            results.append(string_param[2:-1].strip())\n   614\u2192\n   615\u2192        return results\n   616\u2192\n   617\u2192    def get_location_yaml(self, text: Any, path: Path):\n   618\u2192        \"\"\"\n   619\u2192        Get the location information for the given YAML text and path.\n   620\u2192\n   621\u2192        Args:\n   622\u2192            text (str): The YAML text to search.\n   623\u2192            path (list): The path to the location within the YAML text.\n   624\u2192\n   625\u2192        Returns:\n   626\u2192            dict or None: A dictionary containing the location information, or None if the location could not be found.\n   627\u2192            The dictionary has the following keys:\n   628\u2192                - \"start_mark\": A dictionary with \"line\" and \"column\" keys indicating the start of the location.\n   629\u2192                - \"end_mark\": A dictionary with \"line\" and \"column\" keys indicating the end of the location.\n   630\u2192        \"\"\"\n   631\u2192        result = None\n   632\u2192        if not path:\n   633\u2192            result = self._loc(text)\n   634\u2192        elif len(path) > 1:\n   635\u2192            try:\n   636\u2192                result = self.get_location_yaml(text[path[0]], path[1:])\n   637\u2192            except KeyError:\n   638\u2192                pass\n   639\u2192            # TypeError will help catch string indices must be integers for when\n   640\u2192            # we parse JSON string and get a path inside that json string\n   641\u2192            except TypeError:\n   642\u2192                pass\n   643\u2192            if not result:\n   644\u2192                try:\n   645\u2192                    for key in text:\n   646\u2192                        if key == path[0]:\n   647\u2192                            result = self._loc(key)\n   648\u2192                except AttributeError as err:\n   649\u2192                    LOGGER.debug(err)\n   650\u2192        else:\n   651\u2192            # If the last item of the path is an integer, and the vaue is an array,\n   652\u2192            # Get the location of the item in the array\n   653\u2192            if isinstance(text, list) and isinstance(path[0], int):\n   654\u2192                try:\n   655\u2192                    result = self._loc(text[path[0]])\n   656\u2192                except AttributeError as err:\n   657\u2192                    LOGGER.debug(err)\n   658\u2192            else:\n   659\u2192                try:\n   660\u2192                    for key in text:\n   661\u2192                        if key == path[0]:\n   662\u2192                            result = self._loc(key)\n   663\u2192                except AttributeError as err:\n   664\u2192                    LOGGER.debug(err)\n   665\u2192\n   666\u2192        return result\n   667\u2192\n   668\u2192    # pylint: disable=W0613,too-many-locals\n   669\u2192    def check_value(\n   670\u2192        self,\n   671\u2192        obj: dict[str, Any],\n   672\u2192        key: str,\n   673\u2192        path: Path,\n   674\u2192        check_value: CheckValueFn | None = None,\n   675\u2192        check_ref: CheckValueFn | None = None,\n   676\u2192        check_get_att: CheckValueFn | None = None,\n   677\u2192        check_find_in_map: CheckValueFn | None = None,\n   678\u2192        check_split: CheckValueFn | None = None,\n   679\u2192        check_join: CheckValueFn | None = None,\n   680\u2192        check_import_value: CheckValueFn | None = None,\n   681\u2192        check_sub: CheckValueFn | None = None,\n   682\u2192        pass_if_null: bool = False,\n   683\u2192        **kwargs: dict[str, Any],\n   684\u2192    ) -> list[RuleMatch]:\n   685\u2192        \"\"\"\n   686\u2192        Check the value of a key in the provided object.\n   687\u2192\n   688\u2192        Args:\n   689\u2192            obj (dict): The object to check the value of.\n   690\u2192            key (str): The key to check the value of.\n   691\u2192            path (list): The path to the current location in the object.\n   692\u2192            check_value (callable, optional): A function to check the value of the key.\n   693\u2192            check_ref (callable, optional): A function to check the \"Ref\" function.\n   694\u2192            check_get_att (callable, optional): A function to check the \"Fn::GetAtt\" function.\n   695\u2192            check_find_in_map (callable, optional): A function to check the \"Fn::FindInMap\" function.\n   696\u2192            check_split (callable, optional): A function to check the \"Fn::Split\" function.\n   697\u2192            check_join (callable, optional): A function to check the \"Fn::Join\" function.\n   698\u2192            check_import_value (callable, optional): A function to check the \"Fn::ImportValue\" function.\n   699\u2192            check_sub (callable, optional): A function to check the \"Fn::Sub\" function.\n   700\u2192            pass_if_null (bool, optional): Whether to pass if the value is null. Defaults to False.\n   701\u2192            **kwargs (dict): Additional keyword arguments to pass to the check functions.\n   702\u2192\n   703\u2192        Returns:\n   704\u2192            list[RuleMatch]: A list of matches found during the check.\n   705\u2192        \"\"\"\n   706\u2192        matches = []\n   707\u2192        values_obj = self.get_values(obj=obj, key=key)\n   708\u2192        new_path = path[:] + [key]\n   709\u2192        if values_obj is None and pass_if_null:\n   710\u2192            if check_value:\n   711\u2192                matches.extend(\n   712\u2192                    check_value(value=values_obj, path=new_path[:], **kwargs)\n   713\u2192                )\n   714\u2192        elif not values_obj:\n   715\u2192            return matches\n   716\u2192        else:\n   717\u2192            for value_obj in values_obj:\n   718\u2192                value = value_obj[\"Value\"]\n   719\u2192                child_path = value_obj[\"Path\"]\n   720\u2192                if not isinstance(value, dict):\n   721\u2192                    if check_value:\n   722\u2192                        matches.extend(\n   723\u2192                            check_value(\n   724\u2192                                value=value, path=new_path[:] + child_path, **kwargs\n   725\u2192                            )\n   726\u2192                        )\n   727\u2192                else:\n   728\u2192                    if len(value) == 1:\n   729\u2192                        for dict_name, _ in value.items():\n   730\u2192                            # If this is a function we shouldn't fall\n   731\u2192                            # back to a check_value check\n   732\u2192                            if dict_name in cfnlint.helpers.FUNCTIONS:\n   733\u2192                                # convert the function name from camel case\n   734\u2192                                # to underscore\n   735\u2192                                # Example: Fn::FindInMap becomes\n   736\u2192                                # check_find_in_map\n   737\u2192                                # 