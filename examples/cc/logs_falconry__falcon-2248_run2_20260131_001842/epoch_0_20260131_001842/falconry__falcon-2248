\u2192                raise TypeError(\n   332\u2192                    'The callback object appears to '\n   333\u2192                    'be a coroutine, rather than a coroutine function. Please '\n   334\u2192                    'pass the function itself, rather than the result obtained '\n   335\u2192                    'by calling the function. '\n   336\u2192                )\n   337\u2192            elif is_python_func(callback):  # pragma: nocover\n   338\u2192                raise TypeError('The callback must be a coroutine function.')\n   339\u2192\n   340\u2192            # NOTE(kgriffs): The implicit \"else\" branch is actually covered\n   341\u2192            #   by tests running in a Cython environment, but we can't\n   342\u2192            #   detect it with the coverage tool.\n   343\u2192\n   344\u2192        rc = (callback, True)\n   345\u2192\n   346\u2192        if not self._registered_callbacks:\n   347\u2192            self._registered_callbacks = [rc]\n   348\u2192        else:\n   349\u2192            self._registered_callbacks.append(rc)\n   350\u2192\n   351\u2192    def schedule_sync(self, callback):\n   352\u2192        \"\"\"Schedule a synchronous callback to run soon after sending the HTTP response.\n   353\u2192\n   354\u2192        This method can be used to execute a background job after the\n   355\u2192        response has been returned to the client.\n   356\u2192\n   357\u2192        The callback is assumed to be a synchronous (non-coroutine) function.\n   358\u2192        It will be scheduled on the event loop's default\n   359\u2192        :class:`~concurrent.futures.Executor` (which can be overridden via\n   360\u2192        :meth:`asyncio.AbstractEventLoop.set_default_executor`).\n   361\u2192\n   362\u2192        The callback will be invoked without arguments. Use\n   363\u2192        :any:`functools.partial` to pass arguments to the callback\n   364\u2192        as needed.\n   365\u2192\n   366\u2192        Note:\n   367\u2