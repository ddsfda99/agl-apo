me__.partition('simulate_')[-1]\n    73→\n    74→    return alias\n    75→\n    76→\n    77→class Cookie:\n    78→    \"\"\"Represents a cookie returned by a simulated request.\n    79→\n    80→    Args:\n    81→        morsel: A ``Morsel`` object from which to derive the cookie\n    82→            data.\n    83→\n    84→    Attributes:\n    85→        name (str): The cookie's name.\n    86→        value (str): The value of the cookie.\n    87→        expires(datetime.datetime): Expiration timestamp for the cookie,\n    88→            or ``None`` if not specified.\n    89→        path (str): The path prefix to which this cookie is restricted,\n    90→            or ``None`` if not specified.\n    91→        domain (str): The domain to which this cookie is restricted,\n    92→            or ``None`` if not specified.\n    93→        max_age (int): The lifetime of the cookie in seconds, or\n    94→            ``None`` if not specified.\n    95→        secure (bool): Whether or not the cookie may only only be\n    96→            transmitted from the client via HTTPS.\n    97→        http_only (bool): Whether or not the cookie may only be\n    98→            included in unscripted requests from the client.\n    99→    \"\"\"\n   100→\n   101→    def __init__(self, morsel):\n   102→        self._name = morsel.key\n   103→        self._value = morsel.value\n   104→\n   105→        for name in (\n   106→            'expires',\n   107→            'path',\n   108→            'domain',\n   109→            'max_age',\n   110→            'secure',\n   111→            'httponly',\n   112→            'samesite',\n   113→        ):\n   114→            value = morsel[name.replace('_', '-')] or None\n   115→            setattr(self, '_' + name, value)\n   116→\n   117→    @property\n   118→    def name(self) -> str:\n   119→        return self._name\n   120→\n   121→    @property\n   122→    def value(self) -> str:\n   123→        return self._value\n   124→\n   125→    @property\n   126→    def expires(self) -> Optional[dt.datetime]:\n   127→        if self._expires:  # type: ignore[attr-defined]\n   128→            return http_date_to_dt(self._expires, obs_date=True)  # type: ignore[attr-defined]  # noqa E501\n   129→\n   130→        return None\n   131→\n   132→    @property\n   133→    def path(self) -> str:\n   134→        return self._path  # type: ignore[attr-defined]\n   135→\n   136→    @property\n   137→    def domain(self) -> str:\n   138→        return self._domain  # type: ignore[attr-defined]\n   139→\n   140→    @property\n   141→    def max_age(self) -> Optional[int]:\n   142→        return int(self._max_age) if self._max_age else None  # type: ignore[attr-defined]  # noqa E501\n   143→\n   144→    @property\n   145→    def secure(self) -> bool:\n   146→        return bool(self._secure)  # type: ignore[attr-defined]\n   147→\n   148→    @property\n   149→    def http_only(self) -> bool:\n   150→        return bool(self._httponly)  # type: ignore[attr-defined]\n   151→\n   152→    @property\n   153→    def same_site(self) -> Optional[int]:\n   154→        return self._samesite if self._samesite else None  # type: ignore[attr-defined]\n   155→\n   156→\n   157→class _ResultBase:\n   158→    \"\"\"Base class for the result of a simulated request.\n   159→\n   160→    Args:\n   161→        status (str): An HTTP status string, including status code and\n   162→            reason string\n   163→        headers (list): A list of (header_name, header_value) tuples,\n   164→            per PEP-3333\n   165→\n   166→    Attributes:\n   167→        status (str): HTTP status string given in the response\n   168→        status_code (int): The code portion of the HTTP status string\n   169→        headers (CaseInsensitiveDict): A case-insensitive dictionary\n   170→            containing all the headers in the response, except for\n   171→            cookies, which may be accessed via the `cookies`\n   172→            attribute.\n   173→\n   174→            Note:\n   175→\n   176→                Multiple instances of a header in the response are\n   177→                currently not supported; it is unspecified which value\n   178→                will \"win\" and be represented in `headers`.\n   179→\n   180→        cookies (dict): A dictionary of\n   181→            :py:class:`falcon.testing.Cookie` values parsed from the\n   182→            response, by name.\n   183→\n   184→            The cookies dictionary can be used directly in subsequent requests::\n   185→\n   186→                client = testing.TestClient(app)\n   187→                response_one = client.simulate_get('/')\n   188→                response_two = client.simulate_post('/', cookies=response_one.cookies)\n   189→\n   190→        encoding (str): Text encoding of the response body, or ``None``\n   191→            if the encoding can not be determined.\n   192→    \"\"\"\n   193→\n   194→    def __init__(self, status, headers):\n   195→        self._status = status\n   196→        self._status_code = int(status[:3])\n   197→        self._headers = CaseInsensitiveDict(headers)\n   198→\n   199→        cookies = http_cookies.SimpleCookie()\n   200→        for name, value in headers:\n   201→            if name.lower() == 'set-cookie':\n   202→                cookies.load(value)\n   203→\n   204→        self._cookies = dict(\n   205→            (morsel.key, Cookie(morsel)) for morsel in cookies.values()\n   206→        )\n   207→\n   208→        self._encoding = helpers.get_encoding_from_headers(self._headers)\n   209→\n   210→    @property\n   211→    def status(self) -> str:\n   212→        return self._status\n   213→\n   214→    @property\n   215→    def status_code(self) -> int:\n   216→        return self._status_code\n   217→\n   218→    @property\n   219→    def headers(self) -> CaseInsensitiveDict:\n   220→        # NOTE(kgriffs): It would probably be better to annotate this with\n   221→        #   a generic Mapping[str, str