er):\n   403→        super().__init__(status, headers)\n   404→\n   405→        self._task = task\n   406→        self._stream = ResultBodyStream(body_chunks)\n   407→        self._req_event_emitter = req_event_emitter\n   408→\n   409→    @property\n   410→    def stream(self) -> ResultBodyStream:\n   411→        return self._stream\n   412→\n   413→    async def finalize(self):\n   414→        \"\"\"Finalize the encapsulated simulated request.\n   415→\n   416→        This method causes the request event emitter to begin emitting\n   417→        ``'http.disconnect'`` events and then awaits the completion of the\n   418→        asyncio task that is running the simulated ASGI request.\n   419→        \"\"\"\n   420→        self._req_event_emitter.disconnect()\n   421→        await self._task\n   422→\n   423→\n   424→# NOTE(kgriffs): The default of asgi_disconnect_ttl was chosen to be\n   425→#   relatively long (5 minutes) to help testers notice when something\n   426→#   appears to be \"hanging\", which might indicates that the app is\n   427→#   not handling the reception of events correctly.\n   428→def simulate_request(\n   429→    app,\n   430→    method='GET',\n   431→    path='/',\n   432→    query_string=None,\n   433→    headers=None,\n   434→    content_type=None,\n   435→    body=None,\n   436→    json=None,\n   437→    file_wrapper=None,\n   438→    wsgierrors=None,\n   439→    params=None,\n   440→    params_csv=False,\n   441→    protocol='http',\n   442→    host=helpers.DEFAULT_HOST,\n   443→    remote_addr=None,\n   444→    extras=None,\n   445→    http_version='1.1',\n   446→    port=None,\n   447→    root_path=None,\n   448→    cookies=None,\n   449→    asgi_chunk_size=4096,\n   450→    asgi_disconnect_ttl=300,\n   451→) -> _ResultBase:\n   452→    \"\"\"Simulate a request to a WSGI or ASGI application.\n   453→\n   454→    Performs a request against a WSGI or ASGI application. In the case of\n   455→    WSGI, uses :any:`wsgiref.validate` to ensure the response is valid.\n   456→\n   457→    Note:\n   458→        In the case of an ASGI request, this method will simulate the entire\n   459→        app lifecycle in a single shot, including lifespan and client\n   460→        disconnect events. In order to simulate multiple interleaved\n   461→        requests, or to test a streaming endpoint (such as one that emits\n   462→        server-sent events), :class:`~falcon.testing.ASGIConductor` can be\n   463→        used to more precisely control the app lifecycle.\n   464→\n   465→    Keyword Args:\n   466→        app (callable): The WSGI or ASGI application to call\n   467→        method (str): An HTTP method to use in the request\n   468→            (default: 'GET')\n   469→        path (str): The URL path to request (default: '/').\n   470→\n   471→            Note:\n   472→                The path may contain a query string. However, neither\n   473→                `query_string` nor `params` may be specified in this case.\n   474→\n   475→        root_path (str): The initial portion of the request URL's \"path\" that\n   476→            corresponds to the application object, so that the application\n   477→            knows its virtual \"location\". This defaults to the empty string,\n   478→            indicating that the application corresponds to the \"root\" of the\n   479→            server.\n   480→        protocol: The protocol to use for the URL scheme\n   481→            (default: 'http')\n   482→        port (int): The TCP port to simulate. Defaults to\n   483→            the standard port used by the given scheme (i.e., 80 for 'http'\n   484→            and 443 for 'https'). A string may also be passed, as long as\n   485→            it can be parsed as an int.\n   486→        params (dict): A dictionary of query string parameters,\n   487→            where each key is a parameter name, and each value is\n   488→            either a ``str`` or something that can be converted\n   489→            into a ``str``, or a list of such values. If a ``list``,\n   490→            the value will be converted to a comma-delimited string\n   491→            of values (e.g., 'thing=1,2,3').\n   492→        params_csv (bool): Set to ``True`` to encode list values\n   493→            in query string params as comma-separated values\n   494→            (e.g., 'thing=1,2,3'). Otherwise, parameters will be encoded by\n   495→            specifying multiple instances of the parameter\n   496→            (e.g., 'thing=1&thing=2&thing=3'). Defaults to ``False``.\n   497→        query_string (str): A raw query string to include in the\n   498→            request (default: ``None``). If specified, overrides\n   499→            `params`.\n   500→        content_type (str): The value to use for the Content-Type header in\n   501→            the request. If specified, this value will take precedence over\n   502→            any value set for the Content-Type header in the\n   503→            `headers` keyword argument. The ``falcon`` module provides a number\n   504→            of :ref:`constants for common media types <media_type_constants>`.\n   505→        headers (dict): Extra headers as a dict-like (Mapping) object, or an\n   506→            iterable yielding a series of two-member (*name*, *value*)\n   507→            iterables. Each pair of strings provides the name and value\n   508→            for an HTTP header. If desired, multiple header values may be\n   509→            combined into a single (*name*, *value*) pair by joining the values\n   510→            with a comma when the header in question supports the list\n   511→            format (see also RFC 7230 and RFC 7231). Header names are not\n   512→            case-sensitive.\n   513→\n   514→            Note:\n   515→                If a User-Agent header is not provided, it will default to::\n   516→\n   517→                    f'falcon-client/{falcon.__version__}'\n   518→\n   519→        body (str): The body of the request (default ''). The value will be\n   520→            encoded as UTF-8 in the WSGI environ. Alternatively, a byte string\n   521→            may be passed, in which case it will be used as-is.\n   522→        json(JSON serializable): A JSON document to serialize as the\n   523→            body of the request (default: ``None``). If specified,\n   524→            overrides `body` and sets the Content-Type header to\n   525→            ``'application/json'``, overriding any value specified by either\n   526→            the `content_type` or `headers` arguments.\n   527→        file_wrapper (callable): Callable that returns an iterable,\n   528→            to be used as the value for *wsgi.file_wrapper* in the\n   529→            WSGI environ (default: ``None``). This can be used to test\n   530→            high-performance file transmission when `resp.stream` is\n   531→            set to a file-like object.\n   532→        host(str): A string to use for the hostname part of the fully\n   533→            qualified request URL (default: 'falconframework.org')\n   534→        remote_addr (str): A string to use as the remote IP address for the\n   535→            request (default: '127.0.0.1'). For WSGI, this corresponds to\n   536→            the 'REMOTE_ADDR' environ variable. For ASGI, this corresponds\n   537→            to the IP address used for the 'client' field in the connection\n   538→            scope.\n   539→        http_version (str): The HTTP version to simulate. Must be either\n   540→            '2', '2.0', 1.1', '1.0', or '1' (default '1.1'). If set to '1.0',\n   541→            the Host header will not be added to the scope.\n   542→        wsgierrors (io): The stream to use as *wsgierrors* in the WSGI\n   543→            environ (default ``sys.stderr``)\n   544→        asgi_chunk_size (int): The maximum number of bytes that will be\n   545→            sent to the ASGI app in a single ``'http.request'`` event (default\n   546→            4096)