    the WebSocket is disconnected.\n   552→        \"\"\"\n   553→\n   554→        event = await self._receive()\n   555→\n   556→        # PERF(kgriffs): When we normally expect the key to be\n   557→        #   present, this pattern is faster than get()\n   558→        try:\n   559→            text = event['text']\n   560→        except KeyError:\n   561→            text = None\n   562→\n   563→        # NOTE(kgriffs): Even if the key is present, it may be None\n   564→        if text is None:\n   565→            raise falcon_errors.PayloadTypeError(\n   566→                'Expected TEXT payload but got BINARY instead'\n   567→            )\n   568→\n   569→        return text\n   570→\n   571→    async def receive_data(self) -> bytes:\n   572→        \"\"\"Receive a message from the app with a binary data payload.\n   573→\n   574→        Awaiting this coroutine will block until a message is available or\n   575→        the WebSocket is disconnected.\n   576→        \"\"\"\n   577→\n   578→        event = await self._receive()\n   579→\n   580→        # PERF(kgriffs): When we normally expect the key to be\n   581→        #   present, EAFP is faster than get()\n   582→        try:\n   583→            data = event['bytes']\n   584→        except KeyError:\n   585→            data = None\n   586→\n   587→        # NOTE(kgriffs): Even if the key is present, it may be None\n   588→        if data is None:\n   589→            raise falcon_errors.PayloadTypeError(\n   590→                'Expected BINARY payload but got TEXT instead'\n   591→            )\n   592→\n   593→        return data\n   594→\n   595→    async def receive_json(self) -> object:\n   596→        \"\"\"Receive a message from the app with a JSON-encoded TEXT payload.\n   597\n   598→        Awaiting this coroutine will block until a message is available or\n   599→        the WebSocket is disconnected.\n   600→        \"\"\"\n   601→\n   602→        text = await self.receive_text()\n   603→        return json.loads(text)\n   604→\n   605→    async def receive_msgpack(self) -> object:\n   606→        \"\"\"Receive a message from the app with a MessagePack-encoded BINARY payload.\n   607→\n   608→        Awaiting this coroutine will block until a message is available or\n   609→        the WebSocket is disconnected.\n   610→        \"\"\"\n   611→\n   612→        data = await self.receive_data()\n   613→        return self._msgpack.unpackb(data, use_list=True, raw=False)\n   614→\n   615→    @property\n   616→    def _msgpack(self):\n   617→        # NOTE(kgriffs): A property is used in lieu of referencing\n   618→        #   the msgpack module directly, in order to bubble up the\n   619→        #   import error in an obvious way, when the package has\n   620→        #   not been installed.\n   621→\n   622→        if not self.__msgpack:\n   623→            import msgpack\n   624→\n   625→            self.__msgpack = msgpack\n   626→\n   627→        return self.__msgpack\n   628→\n   629→    def _require_accepted(self):\n   630→        if self._state == _WebSocketState.ACCEPTED:\n   631→            return\n   632→\n   633→        if self._state in {_WebSocketState.CONNECT, _WebSocketState.HANDSHAKE}:\n   634→            raise falcon_errors.OperationNotAllowed(\n   635→                'WebSocket connection has not yet been accepted'\n   636→            )\n   637→        elif self._state == _WebSocketState.CLOSED:\n   638→            raise falcon_errors.WebSocketDisconnected(self._close_code)\n   639→\n   640→        assert self._state == _WebSocketState.DENIED\n   641→\n   642→        if self._close_code == WSCloseCode.PATH_NOT_FOUND:\n   643→            raise falcon_errors.WebSocketPathNotFound(WSCloseCode.PATH_NOT_FOUND)\n   644→\n   645→        if self._close_code == WSCloseCode.SERVER_ERROR:\n   646→            raise falcon_errors.WebSocketServerError(WSCloseCode.SERVER_ERROR)\n   647→\n   648→        if self._close_code == WSCloseCode.HANDLER_NOT_FOUND:\n   649→            raise falcon_errors.WebSocketHandlerNotFound(WSCloseCode.HANDLER_NOT_FOUND)\n   650→\n   651→        raise falcon_errors.WebSocketDisconnected(self._close_code)\n   652→\n   653→    # NOTE(kgriffs): This is a coroutine just in case we need it to be\n   654→    #   in a future code revision. It also makes it more consistent\n   655→    #   with the other methods.\n   656→    async def _send(self, data: Optional[bytes] = None, text: Optional[str] = None):\n   657→        self._require_accepted()\n   658→\n   659→        # NOTE(kgriffs): From the client's perspective, it was a send,\n   660→        #   but the server will be expecting websocket.receive\n   661→        event = {'type': EventType.WS_RECEIVE}  # type: Dict[str, Union[bytes, str]]\n   662→\n   663→        if data is not None:\n   664→            event['bytes'] = data\n   665→\n   666→        if text is not None:\n   667→            event['text'] = text\n   668→\n   669→        self._collected_client_events.append(event)\n   670→\n   671→        # NOTE(kgriffs): If something is waiting to read this data on the\n   672→        #   other side, give it a chance to progress (because we like to party\n   673→        #   like it's 1992.)\n   674→        await asyncio.sleep(0)\n   675→\n   676→    async def _receive(self) -> Dict[str, Any]:\n   677→        while not self._collected_server_events:\n   678→            self._require_accepted()\n   679→            await asyncio.sleep(0)\n   680→\n   681→        self._require_accepted()\n   682→        return self._collected_server_events.popleft()\n   683→\n   684→    async def _emit(self) -> Dict[str, Any]:\n   685→        if self._state == _WebSocketState.CONNECT:\n   686→            self._state = _WebSocketState.HANDSHAKE\n   687→            return {'type': EventType.WS_CONNECT}\n   688→\n   689→        if self._state == _WebSocketState.HANDSHAKE:\n   690→            # NOTE(kgriffs): We need to wait for the handshake to\n   691→            #   complete, before proceeding.\n   692→            await self._event_handshake_complete.wait()\n   693→\n   694→        while not self._collected_client_events:\n   695→            await asyncio.sleep(0)\n   696→            if self.closed:\n   697→                return self._create_checked_disconnect()\n   698→\n   699→        return self._collected_client_events.popleft()\n   700→\n   701→    async def _collect(self, event: Dict[str, Any]):\n   702→        assert event\n   703→\n   704→        if self._state == _WebSocketState.CONNECT:\n   705→            raise falcon_errors.OperationNotAllowed(\n   706→                'An ASGI application must receive the first websocket.connect '\n   707→                'event before attempting to send any events.'\n   708→            )\n   709→\n   710→        event_type = event['type']\n   711→        if self._state == _WebSocketState.HANDSHAKE:\n   712→            if event_type == EventType.WS_ACCEPT:\n   713→                self._state = _WebSocketState.ACCEPTED\n   714→                self._accepted_subprotocol = event.get('subprotocol')\n   715→                self._accepted_headers = event.get('headers')\n   716→                self._event_handshake_complete.set()\n   717→\n   718→                # NOTE(kgriffs): Yield to other pending tasks that may be\n   719→                #   waiting on the completion of the handshake. This ensures\n   720→                #   that the simulated client connection can enter its context\n   721→                #   before the app logic continues and potentially closes the\n   722→                #   connection from that side.\n   723→                await asyncio.sleep(0)\n   724→\n   725→            elif event_type == EventType.WS_CLOSE:\n   726→                self._state = _WebSocketState.DENIED\n   727→\n   728→                desired_code = event.get('code', WSCloseCode.NORMAL)\n   729→                if desired_code == WSCloseCode.SERVER_ERROR or (\n   730→                    3000 <= desi