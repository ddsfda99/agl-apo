th a factory function (as\n   142\u2192                opposed to a class), the function is called like a method of\n   143\u2192                the current Response instance. Therefore the first argument is\n   144\u2192                the Response instance itself (self).\n   145\u2192\n   146\u2192        options (dict): Set of global options passed from the App handler.\n   147\u2192\n   148\u2192        headers (dict): Copy of all headers set for the response,\n   149\u2192            sans cookies. Note that a new copy is created and returned each\n   150\u2192            time this property is referenced.\n   151\u2192\n   152\u2192        complete (bool): Set to ``True`` from within a middleware method to\n   153\u2192            signal to the framework that request processing should be\n   154\u2192            short-circuited (see also :ref:`Middleware <middleware>`).\n   155\u2192    \"\"\"\n   156\u2192\n   157\u2192    __slots__ = (\n   158\u2192        'text',\n   159\u2192        'context',\n   160\u2192        'options',\n   161\u2192        'status',\n   162\u2192        'stream',\n   163\u2192        '_cookies',\n   164\u2192        '_data',\n   165\u2192        '_extra_headers',\n   166\u2192        '_headers',\n   167\u2192        '_media',\n   168\u2192        '_media_rendered',\n   169\u2192        '__dict__',\n   170\u2192    )\n   171\u2192\n   172\u2192    complete = False\n   173\u2192\n   174\u2192    # Child classes may override this\n   175\u2192    context_type = structures.Context\n   176\u2192\n   177\u2192    def __init__(self, options=None):\n   178\u2192        self.status = '200 OK'\n   179\u2192        self._headers = {}\n   180\u2192\n   181\u2192        # NOTE(kgriffs): Collection of additional headers as a list of raw\n   182\u2192        #   tuples, to use in cases where we need more control over setting\n   183\u2192        #   headers and duplicates are allowable or even necessary.\n   184\u2192        #\n   185\u2192        # PERF(kgriffs): Save some CPU cycles and a few bytes of RAM by\n   186\u2192        #   only instantiating the list object later on IFF it is needed.\n   187\u2192        self._extra_headers = None\n   188\u2192\n   189\u2192        self.options = options if options else ResponseOptions()\n   190\u2192\n   191\u2192        # NOTE(tbug): will be set to a SimpleCookie object\n   192\u2192        # when cookie is set via set_cookie\n   193\u2192        self._cookies = None\n   194\u2192\n   195\u2192        self.text = None\n   196\u2192        self.stream = None\n   197\u2192        self._data = None\n   198\u2192        self._media = None\n   199\u2192        self._media_rendered = _UNSET\n   200\u2192\n   201\u2192        self.context = self.context_type()\n   202\u2192\n   203\u2192    @property\n   204\u2192    def status_code(self) -> int:\n   205\u2192        return http_status_to_code(self.status)\n   206\u2192\n   207\u2192    @status_code.setter\n   208\u2192    def status_code(self, value):\n   209\u2192        self.status = value\n   210\u2192\n   211\u2192    @property  # type: ignore\n   212\u2192    def body(self):\n   213\u2192        raise AttributeRemovedError(\n   214\u2192            'The body attribute is no longer supported. '\n   215\u2192            'Please use the text attribute instead.'\n   216\u2192        )\n   217\u2192\n   218\u2192    @body.setter  # type: ignore\n   219\u2192    def body(self, value):\n   220\u2192        raise AttributeRemovedError(\n   221\u2192            'The body attribute is no longer supported. '\n   222\u2192            'Please use the text attribute instead.'\n   223\u2192        )\n   224\u2192\n   225\u2192    @property\n   226\u2192    def data(self):\n   227\u2192        return self._data\n   228\u2192\n   229\u2192    @data.setter\n   230\u2192    def data(self, value):\n   231\u2192        self._data = value\n   232\u2192\n   233\u2192    @property\n   234\u2192    def headers(self):\n   235\u2192        return self._headers.copy()\n   236\u2192\n   237\u2192    @property\n   238\u2192    def media(self):\n   239\u2192        return self._media\n   240\u2192\n   241\u2192    @media.setter\n   242\u2192    def media(self, value):\n   243\u2192        self._media = value\n   244\u2192        self._media_rendered = _UNSET\n   245\u2192\n   246\u2192    @property\n   247\u2192    def stream_len(self):\n   248\u2192        # NOTE(kgriffs): Provide some additional information by raising the\n   249\u2192        #   error explicitly.\n   250\u2192        raise AttributeError(_STREAM_LEN_REMOVED_MSG)\n   251\u2192\n   252\u2192    @stream_len.setter\n   253\u2192    def stream_len(self, value):\n   254\u2192        # NOTE(kgriffs): We explicitly disallow setting the deprecated attribute\n   255\u2192        #   so that apps relying on it do not fail silently.\n   256\u2192        raise AttributeError(_STREAM_LEN_REMOVED_MSG)\n   257\u2192\n   258\u2192    def render_body(self):\n   259\u2192        \"\"\"Get the raw bytestring content for the response body.\n   260\u2192\n   261\u2192        This method returns the raw data for the HTTP response body, taking\n   262\u2192        into account the :attr:`~.text`, :attr:`~.data`, and :attr:`~.media`\n   263\u2192        attributes.\n   264\u2192\n   265\u2192        Note:\n   266\u2192            This method ignores :attr:`~.stream`; the caller must check\n   267\u2192            and handle that attribute directly.\n   268\u2192\n   269\u2192        Returns:\n   270\u2192            bytes: The UTF-8 encoded value of the `text` attribute, if\n   271\u2192            set. Otherwise, the value of the `data` attribute if set, or\n   272\u2192            finally the serialized value of the `media` attribute. If\n   273\u2192            none of these attributes are set, ``None`` is returned.\n   274\u2192        \"\"\"\n   275\u2192\n   276\u2192        text = self.text\n   277\u2192        if text is None:\n   278\u2192            data = self._data\n   279\u2192\n   280\u2192            if data is None and self._media is not None:\n   281\u2192                # NOTE(kgriffs): We use a special _UNSET singleton since\n   282\u2192                #   None is ambiguous (the media handler might return None).\n   283\u2192                if self._media_rendered is _UNSET:\n   284\u2192                    if not self.content_type:\n   285\u2192                        self.content_type = self.options.default_media_type\n   286\u2192\n   287\u2192                    handler, _, _ = self.options.media_handlers._resolve(\n   288\u2192                        self.content_type, self.options.default_media_type\n   289\u2192                    )\n   290\u2192\n   291\u2192                    self._media_rendered = handler.serialize(\n   292\u2192                        self._media, self.content_type\n   293\u2192                    )\n   294\u2192\n   295\u2192                data = self._media_rendered\n   296\u2192        else:\n   297\u2192            try:\n   298\u2192                # NOTE(kgriffs): Normally we expect text to be a string\n   299\u2192                data = text.encode()\n   300\u2192            except AttributeError:\n   301\u2192                # NOTE(kgriffs): Assume it was a bytes object already\n   302\u2192                data = text\n   303\u2192\n   304\u2192        return data\n   305\u2192\n   306\u2192    def __repr__(self):\n   307\u2192        return '<%s: %s>' % (self.__class__.__name__, self.status)\n   308\u2192\n   309\u2192    def set_stream(self, stream, content_length):\n   310\u2192        \"\"\"Set both `stream` and `content_length`.\n   311\u2192\n   312\u2192        Although the :attr:`~falcon.Response.stream` and\n   313\u2192        :attr:`~falcon.Response.content_length` properties may be set\n   314\u2192        directly, using this method ensures\n   315\u2192        :attr:`~falcon.Response.content_length` is not accidentally\n   316\u2192        neglected when the length of the stream is known in advance. Using this\n   317\u2192        method is also slightly more performant as compared to setting the\n   318\u2192        properties individually.\n   319\u2192\n   320\u2192        Note:\n   321\u2192            If the stream length is unknown, you can set\n   322\u2192            :attr:`~falcon.Response.stream` directly, and ignore\n   323\u2192            :attr:`~falcon.Response.content_length`. In this case, the ASGI\n   324\u2192            server may choose to use chunked encoding or one\n   325\u2192            of the other strategies suggested by PEP-3333.\n   326\u2192\n   327\u2192        Args:\n   328\u2192            stream: A readable file-like object.\n   329\u2192            content_length (int): Length of the stream, used for the\n   330\u2192                Content-Length header in the response.\n   331\u2192        \"\"\"\n   332\u2192\n   333\u2192        self.stream = stream\n   334\u2192\n   335\u2192        # PERF(kgriffs): Set directly rather than incur the overhead of\n   336\u2192        #   the self.content_length property.\n   337\u2192        self._headers['content-length'] = str(content_length)\n   338\u2192\n   339\u2192    def set_cookie(\n   340\u2192        self,\n   341\u2192        name,\n   342\u2192        value,\n   343\u2192        expires=None,\n   344\u2192        max_age=None,\n   345\u2192        domain=None,\n   346\u2192        path=None,\n   347\u2192        secure=None,\n   348\u2192        http_only=True,\n   349\u2192        same_site=None,\n   350\u2192        partitioned=None,\n   351\u2192    ):\n   352\u2192        \"\"\"Set a response cookie.\n   353\u2192\n   354\u2192        Note:\n   355\u2192            This method can be called multiple times to add one or\n   356\u2192            more cookies to the response.\n   357\u2192\n   358\u2192        See Also:\n   359\u2192            To learn more about setting cookies, see\n   360\u2192            :ref:`Setting Cookies <setting-cookies>`. The parameters\n   361\u2192            listed below correspond to those defined in `RFC 6265`_.\n   362\u2192\n   363\u2192        Args:\n   364\u2192            name (str): Cookie name\n   365\u2192            value (str): Cookie value\n   366\u2192\n   367\u2192        Keyword Args:\n   368\u2192            expires (datetime): Specifies when the cookie should expire.\n   369\u2192                By default, cookies expire when the user agent exits.\n   370\u2192\n   371\u2192                (See also: RFC 6265, Section 4.1.2.1)\n   372\u2192            max_age (int): Defines the lifetime of the cookie in\n   373\u2192                seconds. By default, cookies expire when the user agent\n   374\u2192                exits. If both `max_age` and `expires` are set, the\n   375\u2192                latter is ignored by the user agent.\n   376\u2192\n   377\u2192                Note:\n   378\u2192                    Coercion to ``int`` is attempted if provided with\n   379\u2192                    ``float`` or ``str``.\n   380\u2192\n   381\u2192                (See also: RFC 6265, Section 4.1.2.2)\n   382\u2192\n   383\u2192            domain (str): Restricts the cookie to a specific domain and\n   384\u2192                any subdomains of that domain. By default, the user\n   385\u2192                agent will return the cookie only to the origin server.\n   386\u2192                When overriding this default behavior, the specified\n   387\u2192                domain must include the origin server. Otherwise, the\n   388\u2192                user agent will reject the cookie.\n   389\u2192\n   390\u2192                Note:\n   391\u2192                    Cookies do not provide isolation by port, so the domain\n   392\u2192                    should not provide one. (See also: RFC 6265, Section 8.5)\n   393\u2192\n   394\u2192                (See also: RFC 6265, Section 4.1.2.3)\n   395\u2192\n   396\u2192            path (str): Scopes