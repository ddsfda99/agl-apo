aximum number of seconds to wait\n   748→            since the request was initiated, before emitting an\n   749→            ``'http.disconnect'`` event when the app calls the\n   750→            receive() function (default 300).\n   751→        extras (dict): Additional values to add to the WSGI\n   752→            ``environ`` dictionary or the ASGI scope for the request\n   753→            (default: ``None``)\n   754→        cookies (dict): Cookies as a dict-like (Mapping) object, or an\n   755→            iterable yielding a series of two-member (*name*, *value*)\n   756→            iterables. Each pair of items provides the name and value\n   757→            for the 'Set-Cookie' header.\n   758→\n   759→    Returns:\n   760→        :py:class:`~.Result`: The result of the request\n   761→    \"\"\"\n   762→\n   763→    path, query_string, headers, body, extras = _prepare_sim_args(\n   764→        path,\n   765→        query_string,\n   766→        params,\n   767→        params_csv,\n   768→        content_type,\n   769→        headers,\n   770→        body,\n   771→        json,\n   772→        extras,\n   773→    )\n   774→\n   775→    # ---------------------------------------------------------------------\n   776→    # NOTE(kgriffs): 'http' scope\n   777→    # ---------------------------------------------------------------------\n   778→    content_length = None\n   779→\n   780→    if body is not None:\n   781→        if isinstance(body, str):\n   782→            body = body.encode()\n   783→\n   784→        content_length = len(body)\n   785→\n   786→    http_scope = helpers.create_scope(\n   787→        path=path,\n   788→        query_string=query_string,\n   789→        method=method,\n   790→        headers=headers,\n   791→        host=host,\n   792→        scheme=protocol,\n   793→        port=port,\n   794→        http_version=http_version,\n   795→        remote_addr=remote_addr,\n   796→        root_path=root_path,\n   797→        content_length=content_length,\n   798→        cookies=cookies,\n   799→    )\n   800→\n   801→    if 'method' in extras and extras['method'] != method.upper():\n   802→        raise ValueError(\n   803→            'ASGI scope extras may not override the request method. '\n   804→            'Please use the method parameter.'\n   805→        )\n   806→\n   807→    http_scope.update(extras)\n   808→    # ---------------------------------------------------------------------\n   809→\n   810→    if asgi_disconnect_ttl == 0:  # Special case\n   811→        disconnect_at = 0\n   812→    else:\n   813→        disconnect_at = time.time() + max(0, asgi_disconnect_ttl)\n   814→\n   815→    req_event_emitter = helpers.ASGIRequestEventEmitter(\n   816→        (body or b''),\n   817→        chunk_size=asgi_chunk_size,\n   818→        disconnect_at=disconnect_at,\n   819→    )\n   820→\n   821→    resp_event_collector = helpers.ASGIResponseEventCollector()\n   822→\n   823→    if not _one_shot:\n   824→        task_req = create_task(app(http_scope, req_event_emitter, resp_event_collector))\n   825→\n   826→        if _stream_result:\n   827→            # NOTE(kgriffs): Wait until the response has been started and give\n   828→            #   the task a chance to progress. Otherwise, we won't have a\n   829→            #   status or headers to pass to StreamedResult.\n   830→            while not resp_event_collector.status:\n   831→                await asyncio.sleep(0)\n   832→\n   833→            return StreamedResult(\n   834→                resp_event_collector.body_chunks,\n   835→                code_to_http_status(resp_event_collector.status),\n   836→                resp_event_collector.headers,\n   837→                task_req,\n   838→                req_event_emitter,\n   839→            )\n   840→\n   841→        req_event_emitter.disconnect()\n   842→        await task_req\n   843→        return Result(\n   844→            resp_event_collector.body_chunks,\n   845→            code_to_http_status(resp_event_collector.status),\n   846→            resp_event_collector.headers,\n   847→        )\n   848→\n   849→    # ---------------------------------------------------------------------\n   850→    # NOTE(kgriffs): 'lifespan' scope\n   851→    # ---------------------------------------------------------------------\n   852→    lifespan_scope = {\n   853→        'type': ScopeType.LIFESPAN,\n   854→        'asgi': {\n   855→            'version': '3.0',\n   856→            'spec_version': '2.0',\n   857→        },\n   858→    }\n   859→\n   860→    shutting_down = asyncio.Condition()\n   861→    lifespan_event_emitter = helpers.ASGILifespanEventEmitter(shutting_down)\n   862→    lifespan_event_collector = helpers.ASGIResponseEventCollector()\n   863→    # ---------------------------------------------------------------------\n   864→\n   865→    async def conductor():\n   866→        # NOTE(kgriffs): We assume this is a Falcon ASGI app, which supports\n   867→        #   the lifespan protocol and thus we do not need to catch\n   868→        #   exceptions that would signify no lifespan protocol support.\n   869→        task_lifespan = get_running_loop().create_task(\n   870→            app(lifespan_scope, lifespan_event_emitter, lifespan_event_collector)\n   871→        )\n   872→\n   873→        await _wait_for_startup(lifespan_event_collector.events)\n   874→\n   875→        task_req = create_task(app(http_scope, req_event_emitter, resp_event_collector))\n   876→        req_event_emitter.disconnect()\n   877→        await task_req\n   878→\n   879→        # NOTE(kgriffs): Notify lifespan_event_emitter that it is OK\n   880→        #   to proceed.\n   881→        async with shutting_down:\n   882→            shutting_down.notify()\n   883→\n   884→        await _wait_for_shutdown(lifespan_event_collector.events)\n   885→        await task_lifespan\n   886→\n   887→    await conductor()\n   888→\n   889→    if resp_event_collector.status is None:\n   890→        # NOTE(kgriffs): An immediate disconnect was simulated, and so\n   891→        #   the app could not return a status.\n   892→        raise ConnectionError('An immediate disconnect was simulated.')\n   893→\n   894→    return Result(\n   895→        resp_event_collector.body_chunks,\n   896→        code_to_http_status(resp_event_collector.status),\n   897→        resp_event_collector.headers,\n   898→    )\n   899→\n   900→\n   901→class ASGIConductor:\n   902→    \"\"\"Test conductor for ASGI apps.\n   903→\n   904→    This class provides more control over the lifecycle of a simulated\n   905→    request as compared to :class:`~.TestClient`. In addition, the conductor's\n   906→    asynchronous interface affords interleaved requests and the testing of\n   907→    streaming protocols such as\n   908→    :attr:`Server-Sent Events (SSE) <falcon.asgi.Response.sse>`\n   909→    and :ref:`WebSocket <ws>`.\n   910→\n   911→    :class:`~.ASGIConductor` is implemented as a context manager. Upon\n   912→    entering and exiting the context, the appropriate ASGI lifespan events\n   913→    will be simulated.\n   914→\n   915→    Within the context, HTTP requests can be simulated using an interface\n   916→    that is similar to :class:`~.TestClient`, except that all ``simulate_*()``\n   917→    methods are coroutines::\n   918→\n   919→        async with testing.ASGIConductor(some_app) as conductor:\n   920→            async def post_events():\n   921→                for i in range(100):\n   922→                    await conductor.simulate_post('/events', json={'id': i}):\n   923→                    await asyncio.sleep(0.01)\n   924→\n   925→            async def get_events_sse():\n   926→                # Here, we will get only some of the single server-sent events\n   927→                # because the non-streaming method is \"single-shot\". In other\n   928→                # words, simulate_get() will emit a client disconnect event\n   929→                # into the app before returning.\n   930→                result = await conductor.simulate_get('/events')\n   931→\n   932→                # Alternatively, we can use simulate_get_stream() as a context\n   933→                # manager to perform a series of reads on the result body that\n   934→                # are interleaved with the execution of the post_events()\n   935→                # coroutine.\n   936→                async with conductor.simulate_get_stream('/events') as sr:\n   937→                    while some_condition:\n   938→                        # Read next body chunk that was received (if any).\n   939→                        chunk = await sr.stream.read()\n   940→\n   941→                        if chunk:\n   942→                            # TODO: Do something with the chunk\n   943→                            pass\n   944→\n   945→                    # Exiting the context causes the request event emitter to\n   946→                    # begin emitting ``'http.disconnect'`` events and then awaits\n   947→                    # the completion of the asyncio task that is running the\n   948→                    # simulated ASGI request.\n   949→\n   950→            asyncio.gather(post_events(), get_events_sse())\n   951→\n   952→    Note:\n   953→        Because the :class:`~.ASGIConductor` interface uses coroutines,\n   954→        it cannot be used directly with synchronous testing frameworks such as\n   955→        pytest.\n   956→\n   957→        As a workaround, the test can be adapted by wrapping it in\n   958→        an inline async function and then invoking it via\n   959→        :meth:`falcon.async_to_sync` or decorating the test function\n   960→        with :meth:`falcon.runs_sync`.\n   961→\n   962→        Alternatively, you can try searching PyPI to see if an async plugin is\n   963→        available for your testing framework of choice. For example, the\n   964→        ``pytest-asyncio`` plugin is available for ``pytest`` users.\n   965→\n   966→    Similar to the :class:`TestClient`, :class:`ASGIConductor` also exposes\n   967→    convenience aliases without the ``simulate_`` prefix. Just as with a\n   968→    typical asynchronous HTTP client, it is possible to simply invoke::\n   969→\n   970→        await conductor.get('/messages')\n   971→        await conductor.request('LOCK', '/files/first')\n   972→\n   973→    Args:\n   974→        app (callable): An ASGI application to target when simulating\n   975→            requests.\n   976→\n   977→    Keyword Arguments:\n   978→        headers (dict): Default headers to set on every request (default\n   979→            ``None``). These defaults may be overridden by passing values\n   980→            for the same headers to one of the ``simulate_*()`` methods.\n   981→\n   982→    Attributes:\n   983→        app: The app that this client instance was configured to use.\n   984→\n   985→    \"\"\"\n   986→\n   987→    def __init__(self, app, headers=None):\n   988→        if not _is_asgi_app(app):\n   989→            raise CompatibilityError('ASGIConductor may only be used with an ASGI app')\n   990→\n   991→        self.app = app\n   992→        self._default_headers = headers\n   993→\n   994→        self._shutting_down = asyncio.Condition()\n   995→        self._lifespan_event_collector = helpers.ASGIResponseEventCollector()\n   996→        self._lifespan_task = None\n   997→\n   998→    async def __aenter__(self):\n   999→        lifespan_scope = {\n  1000→            'type': ScopeType.LIFESPAN,\n  1001→            'asgi': {\n  1002→                'version': '3.0',\n  1003→                'spec_version': '2.0',\n  1004→            },\n  1005→        }\n  1006→\n  1007→        lifespan_event_emitter = helpers.ASGILifespanEventEmitter(self._shutting_down)\n  1008→\n  1009→        # NOTE(kgriffs): We assume this is a Falcon ASGI app, which supports\n  1010→        #   the lifespan protocol and thus we do not need to catch\n  1011→        #   exceptions that would signify no lifespan protocol support.\n  1012→        self._lifespan_task = get_running_loop().create_task(\n  1013→            self.app(\n  1014→                lifespan_scope, lifespan_event_emitter, self._lifespan_event_collector\n  1015→            )\n  1016→        )\n  1017→\n  1018→        await _wait_for_startup(self._lifespan_event_collector.events)\n  1019→\n  1020→        return self\n  1021→\n  1022→    async def __aexit__(self, ex_type, ex, tb):\n  1023→        if ex_type:\n  1024→            return False\n  1025→\n  1026→        # NOTE(kgriffs): Notify lifespan_event_emitter that it is OK\n  1027→        #   to proceed.\n  1028→        async with self._shutting_down:\n  1029→            self._shutting_down.notify()\n  1030→\n  1031→        await _wait_for_shutdown(self._lifespan_event_collector.events)\n  1032→        await self._lifespan_task\n  1033→\n  1034→        return True\n  1035→\n  1036→    async def simulate_get(self, path='/', **kwargs) -> _ResultBase:\n  1037→        \"\"\"Simulate a GET request to an ASGI application.\n  1038→\n  1039→        (See also: :py:meth:`falcon.testing.simulate_get`)\n  1040→        \"\"\"\n  1041→        return await self.simulate_request('GET', path, **kwargs)\n  1042→\n  1043→    def simulate_get_stream(self, path='/', **kwargs):\n  1044→        \"\"\"Simulate a GET request to an ASGI application with a streamed response.\n  1045→\n  1046→        (See also: :py:meth:`falcon.testing.simulate_get` for a list of\n  1047→        supported keyword arguments.)\n  1048→\n  1049→        This method returns an async context manager that can be used to obtain\n  1050→        a managed :class:`~.StreamedResult` instance. Exiting the context\n  1051→        will automatically finalize the result object, causing the request\n  1052→        event emitter to begin emitting ``'http.disconnect'`` events and then\n  1053→        await the completion of the task that is running the simulated ASGI\n  1054→        request.\n  1055→\n  1056→        In the following example, a series of streamed body chunks are read\n  1057→        from the response::\n  1058→\n  1059→            async with conductor.simulate_get_stream('/events') as sr:\n  1060→                while some_condition:\n  1061→                    # Read next body chunk that was received (if any).\n  1062→                    chunk = await sr.stream.read()\n  1063→\n  1064→                    if chunk:\n  1065→                        # TODO: Do something with the chunk. For example,\n  1066→                        #   a series of server-sent events could be validated\n  1067→                        #   by concatenating the chunks and splitting on\n  1068→                        #   double-newlines to obtain individual events.\n  1069→                        pass\n  1070→\n  1071→        \"\"\"\n  1072→\n  1073→        kwargs['_stream_result'] = True\n  1074→\n  1075→        return _AsyncContextManager(self.simulate_request('GET', path, **kwargs))\n  1076→\n  1077→    def simulate_ws(self, path='/', **kwargs):\n  1078→        \"\"\"Simulate a WebSocket connection to an ASGI application.\n  1079→\n  1080→        All keyword arguments are passed through to\n  1081→        :py:meth:`falcon.testing.create_scope_ws`.\n  1082→\n  1083→        This method returns an async context manager that can be used to obtain\n  1084→        a managed :class:`falcon.testing.ASGIWebSocketSimulator` instance.\n  1085→        Exiting the context will simulate a close on the WebSocket (if not\n  1086→        already closed) and await the completion of the task that is\n  1087→        running the simulated ASGI request.\n  1088→\n  1089→        In the following example, a series of WebSocket TEXT events are\n  1090→        received from the ASGI app::\n  1091→\n  1092→            async with conductor.simulate_ws('/events') as ws:\n  1093→                while some_condition:\n  1094→                    message = await ws.receive_text()\n  1095→\n  1096→        \"\"\"\n  1097→\n  1098→        scope = helpers.create_scope_ws(path=path, **kwargs)\n  1099→        ws = helpers.ASGIWebSocketSimulator()\n  1100→\n  1101→        task_req = create_task(self.app(scope, ws._emit, ws._collect))\n  1102→\n  1103→        return _WSContextManager(ws, task_req)\n  1104→\n  1105→    async def simulate_head(self, path='/', **kwargs) -> _ResultBase:\n  1106→        \"\"\"Simulate a HEAD request to an ASGI application.\n  1107→\n  1108→        (See also: :py:meth:`falcon.testing.simulate_head`)\n  1109→        \"\"\"\n  1110→        return await self.simulate_request('HEAD', path, **kwargs)\n  1111→\n  1112→    async def simulate_post(self, path='/', **kwargs) -> _ResultBase:\n  1113→        \"\"\"Simulate a POST request to an ASGI application.\n  1114→\n  1115→        (See also: :py:meth:`falcon.testing.simulate_post`)\n  1116→        \"\"\"\n  1117→        return await self.simulate_request('POST', path, **kwargs)\n  1118→\n  1119→    async def simulate_put(self, path='/', **kwargs) -> _ResultBase:\n  1120→        \"\"\"Simulate a PUT request to an ASGI application.\n  1121→\n  1122→        (See also: :py:meth:`falcon.testing.simulate_put`)\n  1123→        \"\"\"\n  1124→        return await self.simulate_request('PUT', path, **kwargs)\n  1125→\n  1126→    async def simulate_options(self, path='/', **kwargs) -> _ResultBase:\n  1127→        \"\"\"Simulate an OPTIONS request to an ASGI application.\n  1128→\n  1129→        (See also: :py:meth:`falcon.testing.simulate_options`)\n  1130→        \"\"\"\n  1131→        return await self.simulate_request('OPTIONS', path, **kwargs)\n  1132→\n  1133→    async def simulate_patch(self, path='/', **kwargs) -> _ResultBase:\n  1134→        \"\"\"Simulate a PATCH request to an ASGI application.\n  1135→\n  1136→        (See also: :py:meth:`falcon.testing.simulate_patch`)\n  1137→        \"\"\"\n  1138→        return await self.simulate_request('PATCH', path, **kwargs)\n  1139→\n  1140→    async def simulate_delete(self, path='/', **kwargs) -> _ResultBase:\n  1141→        \"\"\"Simulate a DELETE request to an ASGI application.\n  1142→\n  1143→        (See also: :py:meth:`falcon.testing.simulate_delete`)\n  1144→        \"\"\"\n  1145→        return await self.simulate_request('DELETE', path, **kwargs)\n  1146→\n  1147→    async def simulate_request(self, *args, **kwargs) -> _ResultBase:\n  1148→        \"\"\"Simulate a request to an ASGI application.\n  1149→\n  1150→        Wraps :py:meth:`falcon.testing.simulate_request` to perform a\n  1151→        WSGI request directly against ``self.app``. Equivalent to::\n  1152→\n  1153→            falcon.testing.simulate_request(self.app, *args, **kwargs)\n  1154→        \"\"\"\n  1155→\n  1156→        if self._default_headers:\n  1157→            # NOTE(kgriffs): Handle the case in which headers is explicitly\n  1158→            # set to None.\n  1159→            additional_headers = kwargs.get('headers', {}) or {}\n  1160→\n  1161→            merged_headers = self._default_headers.copy()\n  1162→            merged_headers.update(additional_headers)\n  1163→\n  1164→            kwargs['headers'] = merged_headers\n  1165→\n  1166→        # NOTE(kgriffs): The conductor takes care of startup/shutdown\n  1167→        kwargs['_one_shot'] = False\n  1168→\n  1169→        return await _simulate_request_asgi(self.app, *args, **kwargs)\n  1170→\n  1171→    delete = _simulate_method_alias(simulate_delete)\n  1172→    get = _simulate_method_alias(simulate_get)\n  1173→    get_stream = _simulate_method_alias(simulate_get_stream, replace_name='get_stream')\n  1174→    head = _simulate_method_alias(simulate_head)\n  1175→    options = _simulate_method_alias(simulate_options)\n  1176→    patch = _simulate_method_alias(simulate_patch)\n  1177→    post = _simulate_method_alias(simulate_post)\n  1178→    put = _simulate_method_alias(simulate_put)\n  1179→    request = _simulate_method_alias(simulate_request)\n  1180→    websocket = _simulate_method_alias(simulate_ws, replace_name='websocket')\n  1181→\n  1182→\n  1183→def simulate_get(app, path, **kwargs) -> _ResultBase:\n  1184→    \"\"\"Simulate a GET request to a WSGI or ASGI application.\n  1185→\n  1186→    Equivalent to::\n  1187→\n  1188→         simulate_request(app, 'GET', path, **kwargs)\n  1189→\n  1190→    Note:\n  1191→        In the case of an ASGI request, this method will simulate the entire\n  1192→        app lifecycle in a single shot, including lifespan and client\n  1193→        disconnect events. In order to simulate multiple interleaved\n  1194→        requests, or to test a streaming endpoint (such as one that emits\n  1195→        server-sent events), :class:`~falcon.testing.ASGIConductor` can be\n  1196→        used to more precisely control the app lifecycle.\n  1197→\n  1198→    Args:\n  1199→        app (callable): The application to call\n  1200→        path (str): The URL path to request\n  1201→\n  1202→            Note:\n  1203→                The path may contain a query string. However, neither\n  1204→                `query_string` nor `params` may be specified in this case.\n  1205→\n  1206→    Keyword Args:\n  1207→        root_path (str): The initial portion of the request URL's \"path\" that\n  1208→            corresponds to the application object, so that the application\n  1209→            knows its virtual \"location\". This defaults to the empty string,\n  1210→            indicating that the application corresponds to the \"root\" of the\n  1211→            server.\n  1212→        protocol: The protocol to use for the URL scheme\n  1213→            (default: 'http')\n  1214→        port (int): The TCP port to simulate. Defaults to\n  1215→            the standard port used by the given scheme (i.e., 80 for 'http'\n  1216→            and 443 for 'https'). A string may also be passed, as long as\n  1217→            it can be parsed as an int.\n  1218→        params (dict): A dictionary of