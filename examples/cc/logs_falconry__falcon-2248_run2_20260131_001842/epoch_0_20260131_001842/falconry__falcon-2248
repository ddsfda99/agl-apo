extension\n   899→        # relation type, in which case it will be a URL that may contain\n   900→        # reserved characters. Otherwise, don't waste time running the\n   901→        # string through uri.encode\n   902→        #\n   903→        # Example values for rel:\n   904→        #\n   905→        #     \"next\"\n   906→        #     \"http://example.com/ext-type\"\n   907→        #     \"https://example.com/ext-type\"\n   908→        #     \"alternate http://example.com/ext-type\"\n   909→        #     \"http://example.com/ext-type alternate\"\n   910→        #\n   911→        if '//' in rel:\n   912→            if ' ' in rel:\n   913→                rel = '\"' + ' '.join([uri_encode(r) for r in rel.split()]) + '\"'\n   914→            else:\n   915→                rel = '\"' + uri_encode(rel) + '\"'\n   916→\n   917→        value = '<' + uri_encode(target) + '>; rel=' + rel\n   918→\n   919→        if title is not None:\n   920→            value += '; title=\"' + title + '\"'\n   921→\n   922→        if title_star is not None:\n   923→            value += (\n   924→                \"; title*=UTF-8'\"\n   925→                + title_star[0]\n   926→                + \"'\"\n   927→                + uri_encode_value(title_star[1])\n   928→            )\n   929→\n   930→        if type_hint is not None:\n   931→            value += '; type=\"' + type_hint + '\"'\n   932→\n   933→        if hreflang is not None:\n   934→            if isinstance(hreflang, str):\n   935→                value += '; hreflang=' + hreflang\n   936→            else:\n   937→                value += '; '\n   938→                value += '; '.join(['hreflang=' + lang for lang in hreflang])\n   939→\n   940→        if anchor is not None:\n   941→            value += '; anchor=\"' + uri_encode(anchor) + '\"'\n   942→\n   943→        if crossorigin is not None:\n   944→            crossorigin = crossorigin.lower()\n   945→            if crossorigin not in _RESERVED_CROSSORIGIN_VALUES:\n   946→                raise ValueError(\n   947→                    'crossorigin must be set to either '\n   948→                    \"'anonymous' or 'use-credentials'\"\n   949→                )\n   950→            if crossorigin == 'anonymous':\n   951→                value += '; crossorigin'\n   952→            else:  # crossorigin == 'use-credentials'\n   953→                # PERF(vytas): the only remaining value is inlined.\n   954→                # Un-inline in case more values are supported in the future.\n   955→                value += '; crossorigin=\"use-credentials\"'\n   956→\n   957→        if link_extension is not None:\n   958→            value += '; '\n   959→            value += '; '.join([p + '=' + v for p, v in link_extension])\n   960→\n   961→        _headers = self._headers\n   962→        if 'link' in _headers:\n   963→            _headers['link'] += ', ' + value\n   964→        else:\n   965→            _headers['link'] = value\n   966→\n   967→    # NOTE(kgriffs): Alias deprecated as of 3.0\n   968→    add_link = deprecated('Please use append_link() instead.', method_name='add_link')(\n   969→        append_link\n   970→    )\n   971→\n   972→    cache_control = header_property(\n   973→        'Cache-Control',\n   974→        \"\"\"Set the Cache-Control header.\n   975→\n   976→        Used to set a list of cache directives to use as the value of the\n   977→        Cache-Control header. The list will be joined with \", \" to produce\n   978→        the value for the header.\n   979→\n   980→        \"\"\",\n   981→        format_header_value_list,\n   982→    )\n   983→\n   984→    content_location = header_property(\n   985→        'Content-Location',\n   986→        \"\"\"Set the Content-Location header.\n   987→\n   988→        This value will be URI encoded per RFC 3986. If the value that is\n   989→        being set is already URI encoded it should be decoded first or the\n   990→        header should be set manually using the set_h