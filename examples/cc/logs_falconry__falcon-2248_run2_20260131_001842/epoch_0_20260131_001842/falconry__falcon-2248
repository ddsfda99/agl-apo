ody.setter  # type: ignore\n   219→    def body(self, value):\n   220→        raise AttributeRemovedError(\n   221→            'The body attribute is no longer supported. '\n   222→            'Please use the text attribute instead.'\n   223→        )\n   224→\n   225→    @property\n   226→    def data(self):\n   227→        return self._data\n   228→\n   229→    @data.setter\n   230→    def data(self, value):\n   231→        self._data = value\n   232→\n   233→    @property\n   234→    def headers(self):\n   235→        return self._headers.copy()\n   236→\n   237→    @property\n   238→    def media(self):\n   239→        return self._media\n   240→\n   241→    @media.setter\n   242→    def media(self, value):\n   243→        self._media = value\n   244→        self._media_rendered = _UNSET\n   245→\n   246→    @property\n   247→    def stream_len(self):\n   248→        # NOTE(kgriffs): Provide some additional information by raising the\n   249→        #   error explicitly.\n   250→        raise AttributeError(_STREAM_LEN_REMOVED_MSG)\n   251→\n   252→    @stream_len.setter\n   253→    def stream_len(self, value):\n   254→        # NOTE(kgriffs): We explicitly disallow setting the deprecated attribute\n   255→        #   so that apps relying on it do not fail silently.\n   256→        raise AttributeError(_STREAM_LEN_REMOVED_MSG)\n   257→\n   258→    def render_body(self):\n   259→        \"\"\"Get the raw bytestring content for the response body.\n   260→\n   261→        This method returns the raw data for the HTTP response body, taking\n   262→        into account the :attr:`~.text`, :attr:`~.data`, and :attr:`~.media`\n   263→        attributes.\n   264→\n   265→        Note:\n   266→            This method ignores :attr:`~.stream`; the caller must check\n   267→            and handle that attribute directly.\n   268→\n   269→        Returns:\n   270→            bytes: The UTF-8 encoded value of the `text` attribute, if\n   271→            set. Otherwise, the value of the `data` attribute if set, or\n   272→            finally the serialized value of the `media` attribute. If\n   273→            none of these attributes are set, ``None`` is returned.\n   274→        \"\"\"\n   275→\n   276→        text = self.text\n   277→        if text is None:\n   278→            data = self._data\n   279→\n   280→            if data is None and self._media is not None:\n   281→                # NOTE(kgriffs): We use a special _UNSET singleton since\n   282→                #   None is ambiguous (the media handler might return None).\n   283→                if self._media_rendered is _UNSET:\n   284→                    if not self.content_type:\n   285→                        self.content_type = self.options.default_media_type\n   286→\n   287→                    handler, _, _ = self.options.media_handlers._resolve(\n   288→                        self.content_type, self.options.default_media_type\n   289→                    )\n   290→\n   291→                    self._media_rendered = handler.serialize(\n   292→                        self._media, self.content_type\n   293→                    )\n   294→\n   295→                data = self._media_rendered\n   296→        else:\n   297→            try:\n   298→                # NOTE(kgriffs): Normally we expect text to be a string\n   299→                data = text.encode()\n   300→            except AttributeError:\n   301→                # NOTE(kgriffs): Assume it was a bytes object already\n   302→                data = text\n   303→\n   304→        return data\n   305→\n   306→    def __repr__(self):\n   307→        return '<%s: %s>' % (self.__class__.__name__, self.status)\n   308→\n   309→    def set_stream(self, stream, content_length):\n   310→        \"\"\"Set both `stream` and `content_length`.\n   311→\n   312→        Although the :attr:`~falcon.Response.stream` and\n   313→        :attr:`~falcon.Response.content_length` properties may be set\n   314→        directly, using this method ensures\n   315→        :attr:`~falcon.Response.content_length` is not accidentally\n   316→        neglected when the length of the stream is known in advance. Using this\n   317→        method is also slightly more performant as compared to setting the\n   318→        properties individually.\n   319→\n   320→        Note:\n   321→            If the stream length is unknown, you can set\n   322→            :attr:`~falcon.Response.stream` directly, and ignore\n   323→            :attr:`~falcon.Response.content_length`. In this case, the ASGI\n   324→            server may choose to use chunked encoding or one\n   325→            of the other strategies suggested by PEP-3333.\n   326→\n   327→        Args:\n   328→            stream: A readable file-like object.\n   329→            content_length (int): Length of the stream, used for the\n   330→                Content-Length header in the response.\n   331→        \"\"\"\n   332→\n   333→        self.stream = stream\n   334→\n   335→        # PERF(kgriffs): Set directly rather than incur the overhead of\n   336→        #   the self.content_length property.\n   337→        self._headers['content-length'] = str(content_length)\n   338→\n   339→    def set_cookie(\n   340→        self,\n   341→        name,\n   342→        value,\n   343→        expires=None,\n   344→        max_age=None,\n   345→        domain=None,\n   346→        path=None,\n   347→        secure=None,\n   348→        http_only=True,\n   349→        same_site=None,\n   350→    ):\n   351→        \"\"\"Set a response cookie.\n   352→\n   353→        Note:\n   354→            This method can be called multiple times to add one or\n   355→            more cookies to the response.\n   356→\n   357→        See Also:\n   358→            To learn more about setting cookies, see\n   359→            :ref:`Setting Cookies <setting-cookies>`. The parameters\n   360→            listed below correspond to those defined in `RFC 6265`_.\n   361→\n   362→        Args:\n   363→            name (str): Cookie name\n   364→            value (str): Cookie value\n   365→\n   366→        Keyword Args:\n   367→            expires (datetime): Specifies when the cookie should expire.\n   368→                By default, cookies expire when the user agent exits.\n   369→\n   370→                (See also: RFC 6265, Section 4.1.2.1)\n   371→            max_age (int): Defines the lifetime of the cookie in\n   372→                seconds. By default, cookies expire when the user agent\n   373→                exits. If both `max_age` and `expires` are set, the\n   374→                latter is ignored by the user agent.\n   375→\n   376→                Note:\n   377→                    Coercion to ``int`` is attempted if provided with\n   378→                    ``float`` or ``str``.\n   379→\n   380→                (See also: RFC 6265, Section 4.1.2.2)\n   381→\n   382→            domain (str): Restricts the cookie to a specific domain and\n   383→                any subdomains of that domain. By default, the user\n   384→                agent will return the cookie only to the origin server.\n   385→                When overriding this default behavior, the specified\n   386→                domain must include the origin server. Otherwise, the\n   387→                user agent will reject the cookie.\n   388→\n   389→                Note:\n   390→                    Cookies do not provide isolation by port, so the domain\n   391→                    should not provide one. (See also: RFC 6265, Section 8.5)\n   392→\n   393→                (See also: RFC 6265, Section 4.1.2.3)\n   394→\n   395→            path (str): Scopes the cookie to the given path plus any\n   396→                subdirectories under that path (the \"/\" character is\n   397→                interpreted as a directory separator). If the cookie\n   398→                does not specify a path, the user agent defaults to the\n   399→                path component of the requested URI.\n   400→\n   401→                Warning:\n   402→                    User agent interfaces do not always isolate\n   403→                    cookies by path, and so this should not be\n   404→                    considered an effective security measure.\n   405→\n   406→                (See also: RFC 6265, Section 4.1.2.4)\n   407→\n   408→            secure (bool): Direct the client to only return the cookie\n   409→                in subsequent requests if they are made over HTTPS\n   410→                (default: ``True``). This prevents attackers from\n   411→                reading sensitive cookie data.\n   412→\n   413→                Note:\n   414→                    The default value for this argument is normally\n   415→                    ``True``, but can be modified by setting\n   416→                    :py:attr:`~.ResponseOptions.secure_cookies_by_default`\n   417→                    via :any:`App.resp_options`.\n   418→\n   419→                Warning:\n   420→                    For the `secure` cookie attribute to be effective,\n   421→                    your application will need to enforce HTTPS.\n   422→\n   423→                (See also: RFC 6265, Section 4.1.2.5)\n   424→\n   425→            http_only (bool): The HttpOnly attribute limits the scope of the\n   426→                cookie to HTTP requests.  In particular, the attribute\n   427→                instructs the user agent to omit the cookie when providing\n   428→                access to cookies via \"non-HTTP\" APIs. This is intended to\n   429→                mitigate some forms of cross-site scripting. (default: ``True``)\n   430→\n   431→                Note:\n   432→                    HttpOnly cookies are not visible to javascript scripts\n   433→                    in the browser. They are automatically sent to the server\n   434→                    on javascript ``XMLHttpRequest`` or ``Fetch`` requests.\n   435→\n   436→                (See also: RFC 6265, Section 4.1.2.6)\n   437→\n   438→            same_site (str): Helps protect against CSRF attacks by restricting\n   439→                when a cookie will be attached to the request by the user agent.\n   440→                When set to ``'Strict'``, the cookie will only be sent along\n   441→                with \"same-site\" requests.  If the value is ``'Lax'``, the\n   442→                cookie will be sent with same-site requests, and with\n   443→                \"cross-site\" top-level navigations.  If the value is ``'None'``,\n   444→                the cookie will be sent with same-site and cross-site requests.\n   445→                Finally, when this attribute is not set on the cookie, the\n   446→                attribute will be treated as if it had been set to ``'None'``.\n   447→\n   448→                (See also: `Same-Site RFC Draft`_)\n   449→\n   450→        Raises:\n   451→            KeyError: `name` is not a valid cookie name.\n   452→            ValueError: `value` is not a valid cookie value.\n   453→\n   454→        .. _RFC 6265:\n   455→            http://tools.ietf.org/html/rfc6265\n   456→\n   457→        .. _Same-Site RFC Draft:\n   458→            https://tools.ietf.org/html/draft-ietf-httpbis-rfc6265bis-03#section-4.1.2.7\n   459→\n   460→        \"\"\"\n   461→\n   462→        if not is_ascii_encodable(name):\n   463→            raise KeyError('name is not ascii encodable')\n   464→        if not is_ascii_encodable(value):\n   465→            raise ValueError('value is not ascii encodable')\n   466→\n   467→        value = str(value)\n   468→\n   469→        if self._cookies is None:\n   470→            self._cookies = http_cookies.SimpleCookie()\n   471→\n   472→        try:\n   473→            self._cookies[name] = value\n   474→        except http_cookies.CookieError as e:  # pragma: no cover\n   475→            # NOTE(tbug): we raise a KeyError here, to avoid leaking\n   476→            # the CookieError to the user. SimpleCookie (well, BaseCookie)\n   477→            # only throws CookieError on issues with the cookie key\n   478→            raise KeyError(str(e))\n   479→\n   480→        if expires:\n   481→            # set Expires on cookie. Format is Wdy, DD Mon YYYY HH:MM:SS GMT\n   482→\n   483→            # NOTE(tbug): we never actually need to\n   484→            # know that GMT is named GMT when formatting cookies.\n   485→            # It is a function call less to just write \"GMT\" in the fmt string:\n   486→            fmt = '%a, %d %b %Y %H:%M:%S GMT'\n   487→            if expires.tzinfo is None:\n   488→                # naive\n   489→                self._cookies[name]['expires'] = expires.strftime(fmt)\n   490→            else:\n   491→                # aware\n   492→                gmt_expires = expires.astimezone(GMT_TIMEZONE)\n   493→                self._cookies[name]['expires'] = gmt_expires.strftime(fmt)\n   494→\n   495→        if max_age:\n   496→            # RFC 6265 section 5.2.2 says about the max-age value:\n   497→            #   \"If the remainder of attribute-value contains a non-DIGIT\n   498→            #    character, ignore the cookie-av.\"\n   499→            # That is, RFC-compliant response parsers will ignore the max-age\n   500→            # attribute if the value contains a dot, as in floating point\n   501→            # numbers. Therefore, attempt to convert the value to an integer.\n   502→            self._cookies[name]['max-age'] = int(max_age)\n   503→\n   504→        if domain:\n   505→            self._cookies[name]['domain'] = domain\n   506→\n   507→        if path:\n   508→            self._cookies[name]['path'] = path\n   509→\n   510→        is_secure = self.options.secure_cookies_by_default if secure is None else secure\n   511→\n   512→        if is_secure:\n   513            self._cookies[name]['secure'] = True\n   514→\n   515→        if http_only:\n   516→            self._cookies[name]['httponly'] = http_only\n   517→\n   518→        # PERF(kgriffs): Morsel.__setitem__() will lowercase this anyway,\n   519→        #   so we can just pass this in and when __setitem__() calls\n   520→        #   lower() it will be very slightly faster.\n   521→        if same_site:\n   522→            same_site = same_site.lower()\n   523→\n   524→            if same_site not in _RESERVED_SAMESITE_VALUES:\n   525→                raise ValueError(\n   526→                    \"same_site must be set to either 'lax', 'strict', or 'none'\"\n   527→                )\n   528→\n   529→            self._cookies[name]['samesite'] = same_site.capitalize()\n   530→\n   531→    def unset_cookie(self, name, samesite='Lax', domain=None, path=None):\n   532→        \"\"\"Unset a cookie in the response.\n   533→\n   534→        Clears the contents of the cookie, and instructs the user\n   535→        agent to immediately expire its own copy of the cookie.\n   536→\n   537→        Note:\n   538→            Modern browsers place restriction on cookies without the\n   539→            \"same-site\" cookie attribute set. To that end this attribute\n   540→            is set to ``'Lax'`` by this method.\n   541→\n   542→            (See also: `Same-Site warnings`_)\n   543→\n   544→        Warning:\n   545→            In order to successfully remove a cookie, both the\n   546→            path and the domain must match the values that were\n   547→            used when the cookie was created.\n   548→\n   549→        Args:\n   550→            name (str): Cookie name\n   551→\n   552→        Keyword Args:\n   553→            samesite (str): Allows to override the default 'Lax' same_site\n   554→                    setting for the unset cookie.\n   555→\n   556→            domain (str): Restricts the cookie to a specific domain and\n   557→                    any subdomains of that domain. By default, the user\n   558→                    agent will return the cookie only to the origin server.\n   559→                    When overriding this default behavior, the specified\n   560→                    domain must include the origin server. Otherwise, the\n   561→                    user agent will reject the cookie.\n   562→\n   563→                    Note:\n   564→                        Cookies do not provide isolation by port, so the domain\n   565→                        should not provide one. (See also: RFC 6265, Section 8.5)\n   566→\n   567→                    (See also: RFC 6265, Section 4.1.2.3)\n   568→\n   569→            path (str): Scopes the cookie to the given path plus any\n   570→                subdirectories under that path (the \"/\" character is\n   571→                interpreted as a directory separator). If the cookie\n   572→                does not specify a path, the user agent defaults to the\n   573→                path component of the requested URI.\n   574→\n   575→                Warning:\n   576→                    User agent interfaces do not always isolate\n   577→                    cookies by path, and so this should not be\n   578→                    considered an effective security measure.\n   579→\n   580→                (See also: RFC 6265, Section 4.1.2.4)\n   581→\n   582→        .. _Same-Site warnings:\n   583→            https://developer.mozilla.org/en-US/docs/Web/HTTP/Headers/Set-Cookie/SameSite#Fixing_common_warnings\n   584→        \"\"\"  # noqa: E501\n   585→        if self._cookies is None:\n   586→            self._cookies = http_cookies.SimpleCookie()\n   587→\n   588→        self._cookies[name] = ''\n   589→\n   590→        # NOTE(Freezerburn): SimpleCookie apparently special cases the\n   591→        # expires attribute to automatically use strftime and set the\n   592→        # time as a delta from the current time. We use -1 here to\n   593→        # basically tell the browser to immediately expire the cookie,\n   594→        # thus removing it from future request objects.\n   595→        self._cookies[name]['expires'] = -1\n   596→\n   597→        # NOTE(CaselIT): Set SameSite to Lax to avoid setting invalid cookies.\n   598→        # See https://developer.mozilla.org/en-US/docs/Web/HTTP/Headers/Set-Cookie/SameSite#Fixing_common_warnings  # noqa: E501\n   599→        self._cookies[name]['samesite'] = samesite\n   600→\n   601→        if domain:\n   602→            self._cookies[name]['domain'] = domain\n   603→\n   604→        if path:\n   605→            self._cookies[name]['path'] = path\n   606→\n   607→    def get_header(self, name, default=None):\n   608→        \"\"\"Retrieve the raw string value for the given header.\n   609→\n   610→        Normally, when a header has multiple values, they will be\n   611→        returned as a single, comma-delimited string. However, the\n   612→        Set-Cookie header does not support this format, and so\n   613→        attempting to retrieve it will raise an error.\n   614→\n   615→        Args:\n   616→            name (str): Header name, case-insensitive. Must be of type ``str``\n   617→                or ``StringType``, and only character values 0x00 through 0xFF\n   618→                may be used on platforms that use wide characters.\n   619→        Keyword Args:\n   620→            default: Value to return if the header\n   621→                is not found (default ``None``).\n   622→\n   623→        Raises:\n   624→            ValueError: The value of the 'Set-Cookie' header(s) was requested.\n   625→\n   626→        Returns:\n   627→            str: The value of the specified header if set, or\n   628→            the default value if not set.\n   629→        \"\"\"\n   630→\n   631→        # NOTE(kgriffs): normalize name by lowercasing it\n   632→        name = name.lower()\n   633→\n   634→        if name == 'set-cookie':\n   635→            raise HeaderNotSupported('Getting Set-Cookie is not currently supported.')\n   636→\n   637→        return self._headers.get(name, default)\n   638→\n   639→    def set_header(self, name, value):\n   640→        \"\"\"Set a header for this response to a given value.\n   641→\n   642→        Warning:\n   643→            Calling this method overwrites any values already set for this\n   644→            header. To append an additional value for this header, use\n   645→            :meth:`~.append_header` instead.\n   646→\n   647→        Warning:\n   648→            This method cannot be used to set cookies; instead, use\n   649→            :meth:`~.append_header` or :meth:`~.set_cookie`.\n   650→\n   651→        Args:\n   652→            name (str): Header name (case-insensitive). The name may contain\n   653→                only US-ASCII characters.\n   654→            value (str): Value for the header. As with the header's name, the\n   655→                value may contain only US-ASCII characters.\n   656→\n   657→        Raises:\n   658→            ValueError: `name` cannot be ``'Set-Cookie'``.\n   659→        \"\"\"\n   660→\n   661→        # NOTE(kgriffs): uwsgi fails with a TypeError if any header\n   662→        # is not a str, so do the conversion here. It's actually\n   663→        # faster to not do an isinstance check. str() will encode\n   664→        # to US-ASCII.\n   665→        value = str(value)\n   666→\n   667→        # NOTE(kgriffs): normalize name by lowercasing it\n   668→        name = name.lower()\n   669→\n   670→        if name == 'set-cookie':\n   671→            raise HeaderNotSupported('This method cannot be used to set cookies')\n   672→\n   673→        self._headers[name] = value\n   674→\n   675→    def delete_header(self, name):\n   676→        \"\"\"Delete a header that was previously set for this response.\n   677→\n   678→        If the header was not previously set, nothing is done (no error is\n   679→        raised). Otherwise, all values set for the header will be removed\n   680→        from the response.\n   681→\n   682→        Note that calling this method is equivalent to setting the\n   683→        corresponding header property (when said property is available) to\n   684→        ``None``. For example::\n   685→\n   686→            resp.etag = None\n   687→\n   688→        Warning:\n   689→            This method cannot be used with the Set-Cookie header. Instead,\n   690→            use :meth:`~.unset_cookie` to remove a cookie and ensure that the\n   691→            user agent expires its own copy of the data as well.\n   692→\n   693→        Args:\n   694→            name (str): Header name (case-insensitive). The name may\n   695→                contain only US-ASCII characters.\n   696→\n   697→        Raises:\n   698→            ValueError: `name` cannot be ``'Set-Cookie'``.\n   699→        \"\"\"\n   700→\n   701→        # NOTE(kgriffs): normalize name by lowercasing it\n   702→        name = name.lower()\n   703→\n   704→        if name == 'set-cookie':\n   705→            raise HeaderNotSupported('This method cannot be used to remove cookies')\n   706→\n   707→        self._headers.pop(name, None)\n   708→\n   709→    def append_header(self, name, value):\n   710→        \"\"\"Set or append a header for this response.\n   711→\n   712→        If the header already exists, the new value will normally be appended\n   713→        to it, delimited by a comma. The notable exception to this rule is\n   714→        Set-Cookie, in which case a separate header line for each value will be\n   715→        included in the response.\n   716→\n   717→        Note:\n   718→            While this method can be used to efficiently append raw\n   719→            Set-Cookie headers to the response, you may find\n   720→            :py:meth:`~.set_cookie` to be more convenient.\n   721→\n   722→        Args:\n   723→            name (str): Header name (case-insensitive). The name may contain\n   724→                only US-ASCII characters.\n   725→            value (str): Value for the header. As with the header's name, the\n   726→                value may contain only US-ASCII characters.\n   727→        \"\"\"\n   728→\n   729→        # NOTE(kgriffs): uwsgi fails with a TypeError if any header\n   730→        # is not a str, so do the conversion here. It's actually\n   731→        # faster to not do an isinstance check. str() will encode\n   732→        # to US-ASCII.\n   733→        value = str(value)\n   734→\n   735→        # NOTE(kgriffs): normalize name by lowercasing it\n   736→        name = name.lower()\n   737→\n   738→        if name == 'set-cookie':\n   739→            if not self._extra_headers:\n   740→                self._extra_headers = [(name, value)]\n   741→            else:\n   742→                self._extra_headers.append((name, value))\n   743→        else:\n   744→            if name in self._headers:\n   745→                value = self._headers[name] + ', ' + value\n   746→\n   747→            self._headers[name] = value\n   748→\n   749→    def set_headers(self, headers):\n   750→        \"\"\"Set several headers at once.\n   751→\n   752→        This method can be used to set a collection of raw header names and\n   753→        values all at once.\n   754→\n   755→        Warning:\n   756→            Calling this method overwrites any existing values for the given\n   757→            header. If a list containing multiple instances of the same header\n   758→            is provided, only the last value will be used. To add multiple\n   759→            values to the response for a given header, see\n   760→            :meth:`~.append_header`.\n   761→\n   762→        Warning:\n   763→            This method cannot be used to set cookies; instead, use\n   764→            :meth:`~.append_header` or :meth:`~.set_cookie`.\n   765→\n   766→        Args:\n   767→            headers (Iterable[[str, str]]): An iterable of ``[name, value]`` two-member\n   768→                iterables, or a dict-like object that implements an ``items()`` method.\n   769→                Both *name* and *value* must be of type ``str`` and\n   770→                contain only US-ASCII characters.\n   771→\n   772→                Note:\n   773→                    Falcon can process an iterable of tuples slightly faster\n   774→                    than a dict.\n   775→\n   776→        Raises:\n   777→            ValueError: `headers` was not a ``dict`` or ``list`` of ``tuple``\n   778→                         or ``Iterable[[str, str]]``.\n   779→        \"\"\"\n   780→\n   781→        header_items = getattr(headers, 'items', None)\n   782→\n   783→        if callable(header_items):\n   784→            headers = header_items()\n   785→\n   786→        # NOTE(kgriffs): We can't use dict.update because we have to\n   787→        # normalize the header names.\n   788→        _headers = self._headers\n   789→\n   790→        for name, value in headers:\n   791→            # NOTE(kgriffs): uwsgi fails with a TypeError if any header\n   792→            # is not a str, so do the conversion here. It's actually\n   793→            # faster to not do an isinstance check. str() will encode\n   794→            # to US-ASCII.\n   795→            value = str(value)\n   796→\n   797→            name = name.lower()\n   798→            if name == 'set-cookie':\n   799→                raise HeaderNotSupported('This method cannot be used to set cookies')\n   800→\n   801→            _headers[name] = value\n   802→\n   803→    def append_link(\n   804→        self,\n   805→        target,\n   806→        rel,\n   807→        title=None,\n   808→        title_star=None,\n   809→        anchor=None,\n   810→        hreflang=None,\n   811→        type_hint=None,\n   812→        crossorigin=None,\n   813→        link_extension=None,\n   814→    ):\n   815→        \"\"\"Append a link header to the response.\n   816→\n   817→        (See also: RFC 5988, Section 1)\n   818→\n   819→        Note:\n   820→            Calling this method repeatedly will cause each link to be\n   821→            appended to the Link header value, separated by commas.\n   822→\n   823→        Args:\n   824→            target (str): Target IRI for the resource identified by the\n   825→                link. Will be converted to a URI, if necessary, per\n   826→                RFC 3987, Section 3.1.\n   827→            rel (str): Relation type of the link, such as \"next\" or\n   828→                \"bookmark\".\n   829→\n   830→                (See also:\n   831→                http://www.iana.org/assignments/link-relations/link-relations.xhtml)\n   832→\n   833→        Keyword Args:\n   834→            title (str): Human-readable label for the destination of\n   835→                the link (default ``None``). If the title includes non-ASCII\n   836→                characters, you will need to use `title_star` instead, or\n   837→                provide both a US-ASCII version using `title` and a\n   838→                Unicode version using `title_star`.\n   839→            title_star (tuple of str): Localized title describing the\n   840→                destination of the link (default ``None``). The value must be a\n   841→                two-member tuple in the form of (*language-tag*, *text*),\n   842→                where *language-tag* is a standard language identifier as\n   843→                defined in RFC 5646, Section 2.1, and *text* is a Unicode\n   844→                string.\n   845→\n   846→                Note:\n   847→                    *language-tag* may be an empty string, in which case the\n   848→                    client will assume the language from the general context\n   849→                    of the current request.\n   850→\n   851→                Note:\n   852→                    *text* will always be encoded as UTF-8.\n   853→\n   854→            anchor (str): Override the context IRI with a different URI\n   855→                (default None). By default, the context IRI for the link is\n   856→                simply the IRI of the requested resource. The value\n   857→                provided may be a relative URI.\n   858→            hreflang (str or iterable): Either a single *language-tag*, or\n   859→                a ``list`` or ``tuple`` of such tags to provide a hint to the\n   860→                client as to the language of the result of following the link.\n   861→                A list of tags may be given in order to indicate to the\n   862→                client that the target resource is available in multiple\n   863→                languages.\n   864→            type_hint(str): Provides a hint as to the media type of the\n   865→                result of dereferencing the link (default ``None``). As noted\n   866→                in RFC 5988, this is only a hint and does not override the\n   867→                Content-Type header returned when the link is followed.\n   868→            crossorigin(str):  Determines how cross origin requests are handled.\n   869→                Can take values 'anonymous' or 'use-credentials' or None.\n   870→                (See:\n   871→                https://www.w3.org/TR/html50/infrastructure.html#cors-settings-attribute)\n   872→            link_extension(iterable): Provides additional custom attributes, as\n   873→                described in RFC 8288, Section 3.4.2. Each member of the iterable\n   874→                must be a two-tuple in the form of (*param*, *value*).\n   875→                (See: https://datatracker.ietf.org/doc/html/rfc8288#section-3.4.2)\n   876→\n   877→        \"\"\"\n   878→\n   879→        # PERF(kgriffs): Heuristic to detect possibility of an extension\n   880→        # relation type, in which case it will be a URL that may contain\n   881→        # reserved characters. Otherwise, don't waste time running the\n   882→        # string through uri.encode\n   883→        #\n   884→        # Example values for rel:\n   885→        #\n   886→        #     \"next\"\n   887→        #     \"http://example.com/ext-type\"\n   888→        #     \"https://example.com/ext-type\"\n   889→        #     \"alternate http://example.com/ext-type\"\n   890→        #     \"http://example.com/ext-type alternate\"\n   891→        #\n   892→        if '//' in rel:\n   893→            if ' ' in rel:\n   894→                rel = '\"' + ' '.join([uri_encode(r) for r in rel.split()]) + '\"'\n   895→            else:\n   896→                rel = '\"' + uri_encode(rel) + '\"'\n   897→\n   898→        value = '<' + uri_encode(target) + '>; rel=' + rel\n   899→\n   900→        if title is not None:\n   901→            value += '; title=\"' + title + '\"'\n   902→\n   903→        if title_star is not None:\n   904→            value += (\n   905→                \"; title*=UTF-8'\"\n   906→                + title_star[0]\n   907→                + \"'\"\n   908→                + uri_encode_value(title_star[1])\n   909→            )\n   910→\n   911→        if type_hint is not None:\n   912→            value += '; type=\"' + type_hint + '\"'\n   913→\n   914→        if hreflang is not None:\n   915→            if isinstance(hreflang, str):\n   916→                value += '; hreflang=' + hreflang\n   917→            else:\n   918→                value += '; '\n   919→                value += '; '.join(['hreflang=' + lang for lang in hreflang])\n   920→\n   921→        if anchor is not None:\n   922→            value += '; anchor=\"' + uri_encode(anchor) + '\"'\n   923→\n   924→        if crossorigin is not None:\n   925→            crossorigin = crossorigin.lower()\n   926→            if crossorigin not in _RESERVED_CROSSORIGIN_VALUES:\n   927→                raise ValueError(\n   928→                    'crossorigin must be set to either '\n   929→                    \"'anonymous' or 'use-credentials'\"\n   930→                )\n   931→            if crossorigin == 'anonymous':\n   932→                value += '; crossorigin'\n   933→            else:  # crossorigin == 'use-credentials'\n   934→                # PERF(vytas): the only remaining value is inlined.\n   935→                # Un-inline in case more values are supported in the future.\n   936→                value += '; crossorigin=\"use-credentials\"'\n   937→\n   938→        if link_extension is not None:\n   939→            value += '; '\n   940→            value += '; '.join([p + '=' + v for p, v in link_extension])\n   941→\n   942→        _headers = self._headers\n   943→        if 'link' in _headers:\n   944→            _headers['link'] += ', ' + value\n   945→        else:\n   946→            _headers['link'] = value\n   947→\n   948→    # NOTE(kgriffs): Alias deprecated as of 3.0\n   949→    add_link = deprecated('Please use append_link() instead.', method_name='add_link')(\n   950→        append_link\n   951→    )\n   952→\n   953→    cache_control = header_property(\n   954→        'Cache-Control',\n   955→        \"\"\"Set the Cache-Control header.\n   956→\n   957→        Used to set a list of cache directives to use as the value of the\n   958→        Cache-Control header. The list will be joined with \", \" to produce\n   959→        the value for the header.\n   960→\n   961→        \"\"\",\n   962→        format_header_value_list,\n   963→    )\n   964→\n   965→    content_location = header_property(\n   966→        'Content-Location',\n   967→        \"\"\"Set the Content-Location header.\n   968→\n   969→        This value will be URI encoded per RFC 3986. If the value that is\n   970→        being set is already URI encoded it should be decoded first or the\n   971→        header should be set manually using the set_header method.\n   972→        \"\"\",\n   973→        uri_encode,\n   974→    )\n   975→\n   976→    content_length = header_property(\n   977→        'Content-Length',\n   978→        \"\"\"Set the Content-Length header.\n   979→\n   980→        This property can be used for responding to HEAD requests when you\n   981→        aren't actually providing the response body, or when streaming the\n   982→        response. If either the `text` property or the `data` property is set\n   983→        on the response, the framework will force Content-Length to be the\n   984→        length of the given text bytes. Therefore, it is only necessary to\n   985→        manually set the content length when those properties are not used.\n   986→\n   987→        Note:\n   988→            In cases where the response content is a stream (readable\n   989→            file-like object), Falcon will not supply a Content-Length header\n   990→            to the server unless `content_length` is explicitly set.\n   991→            Consequently, the server may choose to use chunked encoding in this\n   992→            case.\n   993→\n   994→        \"\"\",\n   995→    )\n   996→\n   997→    content_range = header_property(\n   998→        'Content-Range',\n   999→        \"\"\"A tuple to use in constructing a value for the Content-Range header.\n  1000→\n  1001→        The tuple has the form (*start*, *end*, *length*, [*unit*]), where *start* and\n  1002→        *end* designate the range (inclusive), and *length* is the\n  1003→        total length, or '\\\\*' if unknown. You may pass ``int``'s for\n  1004→        these numbers (no need to convert to ``str`` beforehand). The optional value\n  1005→        *unit* describes the range unit and defaults to 'bytes'\n  1006→\n  1007→        Note:\n  1008→            You only need to use the alternate form, 'bytes \\\\*/1234', for\n  1009→            responses that use the status '416 Range Not Satisfiable'. In this\n  1010→            case, raising ``falcon.HTTPRangeNotSatisfiable`` will do the right\n  1011→            thing.\n  1012→\n  1013→        (See also: RFC 7233, Section 4.2)\n  1014→        \"\"\",\n  1015→        format_range,\n  1016→    )\n  1017→\n  1018→    content_type = header_property(\n  1019→        'Content-Type',\n  1020→        \"\"\"Sets the Content-Type header.\n  1021→\n  1022→        The ``falcon`` module provides a number of constants for\n  1023→        common media types, including ``falcon.MEDIA_JSON``,\n  1024→        ``falcon.MEDIA_MSGPACK``, ``falcon.MEDIA_YAML``,\n  1025→        ``falcon.MEDIA_XML``, ``falcon.MEDIA_HTML``,\n  1026→        ``falcon.MEDIA_JS``, ``falcon.MEDIA_TEXT``,\n  1027→        ``falcon.MEDIA_JPEG``, ``falcon.MEDIA_PNG``,\n  1028→        and ``falcon.MEDIA_GIF``.\n  1029→        \"\"\",\n  1030→    )\n  1031→\n  1032→    downloadable_as = header_property(\n  1033→        'Content-Disposition',\n  1034→        \"\"\"Set the Content-Disposition header using the given filename.\n  1035→\n  1036→        The value will be used for the ``filename`` directive. For example,\n  1037→        given ``'report.pdf'``, the Content-Disposition header would be set\n  1038→        to: ``'attachment; filename=\"report.pdf\"'``.\n  1039→\n  1040→        As per `RFC 6266 <https://tools.ietf.org/html/rfc6266#appendix-D>`_\n  1041→        recommendations, non-ASCII filenames will be encoded using the\n  1042→        ``filename*`` directive, whereas ``filename`` will contain the US\n  1043→        ASCII fallback.\n  1044→        \"\"\",\n  1045→        functools.partial(format_content_disposition, disposition_type='attachment'),\n  1046→    )\n  1047→\n  1048→    viewable_as = header_property(\n  1049→        'Content-Disposition',\n  1050→        \"\"\"Set an inline Content-Disposition header using the given filename.\n  1051→\n  1052→        The value will be used for the ``filename`` directive. For example,\n  1053→        given ``'report.pdf'``, the Content-Disposition header would be set\n  1054→        to: ``'inline; filename=\"report.pdf\"'``.\n  1055→\n  1056→        As per `RFC 6266 <https://tools.ietf.org/html/rfc6266#appendix-D>`_\n  1057→        recommendations, non-ASCII filenames will be encoded using the\n  1058→        ``filename*`` directive, whereas ``filename`` will contain the US\n  1059→        ASCII fallback.\n  1060→\n  1061→        .. versionadded:: 3.1\n  1062→        \"\"\",\n  1063→        functools.partial(format_content_disposition, disposition_type='inline'),\n  1064→    )\n  1065→\n  1066→    etag = header_property(\n  1067→        'ETag',\n  1068→        \"\"\"Set the ETag header.\n  1069→\n  1070→        The ETag header will be wrapped with double quotes ``\"value\"`` in case\n  1071→        the user didn't pass it.\n  1072→        \"\"\",\n  1073→        format_etag_header,\n  1074→    )\n  1075→\n  1076→    expires = header_property(\n  1077→        'Expires',\n  1078→        \"\"\"Set the Expires header. Set to a ``datetime`` (UTC) instance.\n  1079→\n  1080→        Note:\n  1081→            Falcon will format the ``datetime`` as an HTTP date string.\n  1082→        \"\"\",\n  1083→        dt_to_http,\n  1084→    )\n  1085→\n  1086→    last_modified = header_property(\n  1087→        'Last-Modified',\n  1088→        \"\"\"Set the Last-Modified header. Set to a ``datetime`` (UTC) instance.\n  1089→\n  1090→        Note:\n  1091→            Falcon will format the ``datetime`` as an HTTP date string.\n  1092→        \"\"\",\n  1093→        dt_to_http,\n  1094→    )\n  1095→\n  1096→    location = header_property(\n  1097→        'Location',\n  1098→        \"\"\"Set the Location header.\n  1099→\n  1100→        This value will be URI encoded per RFC 3986. If the value that is\n  1101→        being set is already URI encoded it should be decoded first or the\n  1102→        header should be set manually using the set_header method.\n  1103→        \"\"\",\n  1104→        uri_encode,\n  1105→    )\n  1106→\n  1107→    retry_after = header_property(\n  1108→        'Retry-After',\n  1109→        \"\"\"Set the Retry-After header.\n  1110→\n  1111→        The expected value is an integral number of seconds to use as the\n  1112→        value for the header. The HTTP-date syntax is not supported.\n  1113→        \"\"\",\n  1114→        str,\n  1115→    )\n  1116→\n  1117→    vary = header_property(\n  1118→        'Vary',\n  1119→        \"\"\"Value to use for the Vary header.\n  1120→\n  1121→        Set this property to an iterable of header names. For a single\n  1122→        asterisk or field value, simply pass a single-element ``list``\n  1123→        or ``tuple``.\n  1124→\n  1125→        The \"Vary\" header field in a response describes what parts of\n  1126→        a request message, aside from the method, Host header field,\n  1127→        and request target, might influence the origin server's\n  1128→        process for selecting and representing this response.  The\n  1129→        value consists of either a single asterisk (\"*\") or a list of\n  1130→        header field names (case-insensitive).\n  1131→\n  1132→        (See also: RFC 7231, Section 7.1.4)\n  1133→        \"\"\",\n  1134→        format_header_value_list,\n  1135→    )\n  1136→\n  1137→    accept_ranges = header_property(\n  1138→        'Accept-Ranges',\n  1139→        \"\"\"Set the Accept-Ranges header.\n  1140→\n  1141→        The Accept-Ranges header field indicates to the client which\n  1142→        range units are supported (e.g. \"bytes\") for the target\n  1143→        resource.\n  1144→\n  1145→        If range requests are not supported for the target resource,\n  1146→        the header may be set to \"none\" to advise the client not to\n  1147→        attempt any such requests.\n  1148→\n  1149→        Note:\n  1150→            \"none\" is the literal string, not Python's built-in ``None``\n  1151→            type.\n  1152→\n  1153→        \"\"\",\n  1154→    )\n  1155→\n  1156→    def _set_media_type(self, media_type=None):\n  1157→        \"\"\"Set a content-type; wrapper around set_header.\n  1158→\n  1159→        Args:\n  1160→            media_type: Media type to use for the Content-Type\n  1161→                header.\n  1162→\n  1163→        \"\"\"\n  1164→\n  1165→        # PERF(kgriffs): Using \"in\" like this is faster than dict.setdefault()\n  1166→        #   in most cases, except on PyPy where it is only a fraction of a\n  1167→        #   nanosecond slower. Last tested on Python versions 3.5-3.7.\n  1168→        if media_type is not None and 'content-type' not in self._headers:\n  1169→            self._headers['content-type'] = media_type\n  1170→\n  1171→    def _wsgi_headers(self, media_type=None):\n  1172→        \"\"\"Convert headers into the format expected by WSGI servers.\n  1173→\n  1174→        Args:\n  1175→            media_type: Default media type to use for the Content-Type\n  1176→                header if the header was not set explicitly (default ``None``).\n  1177→\n  1178→        \"\"\"\n  1179→\n  1180→        headers = self._headers\n  1181→        # PERF(vytas): uglier inline version of Response._set_media_type\n  1182→        if media_type is not None and 'content-type' not in headers:\n  1183→            headers['content-type'] = media_type\n  1184→\n  1185→        items = list(headers.items())\n  1186→\n  1187→        if self._extra_headers:\n  1188→            items += self._extra_headers\n  1189→\n  1190→        # NOTE(kgriffs): It is important to append these after self._extra_headers\n  1191→        #   in case the latter contains Set-Cookie headers that should be\n  1192→        #   overridden by a call to unset_cookie().\n  1193→        if self._cookies is not None:\n  1194→            # PERF(tbug):\n  1195→            # The below implementation is ~23% faster than\n  1196→            # the alternative:\n  1197→            #\n  1198→            #     self._cookies.output().split(\"\\\\r\\\\n\")\n  1199→            #\n  1200→            # Even without the .split(\"\\\\r\\\\n\"), the below\n  1201→            # is still ~17% faster, so don't use .output()\n  1202→            items += [('set-cookie', c.OutputString()) for c in self._cookies.values()]\n  1203→        return items\n  1204→\n  1205→\n  1206→class ResponseOptions:\n  1207→    \"\"\"Defines a set of configurable response options.\n  1208→\n  1209→    An instance of this class is exposed via :attr:`falcon.App.resp_options`\n  1210→    and :attr:`falcon.asgi.App.resp_options` for configuring certain\n  1211→    :py:class:`~.Response` behaviors.\n  1212→\n  1213→    Attributes:\n  1214→        secure_cookies_by_default (bool): Set to ``False`` in development\n  1215→            environments to make the `secure` attribute for all cookies\n  1216→            default to ``False``. This can make testing easier by\n  1217→            not requiring HTTPS. Note, however, that this setting can\n  1218→            be overridden via `set_cookie()`'s `secure` kwarg.\n  1219→\n  1220→        default_media_type (str): The default Internet media type (RFC 2046) to\n  1221→            use when rendering a response, when the Content-Type header\n  1222→            is not set explicitly. This value is normally set to the\n  1223→            media type provided when a :class:`falcon.App` is initialized;\n  1224→            however, if created independently, this will default to\n  1225→            :attr:`falcon.DEFAULT_MEDIA_TYPE`..\n  1226→\n  1227→        media_handlers (Handlers): A dict-like object for configuring the\n  1228→            media-types to handle. By default, handlers are provided for the\n  1229→            ``application/json``, ``application/x-www-form-urlencoded`` and\n  1230→            ``multipart/form-data`` media types.\n  1231→\n  1232→        static_media_types (dict): A mapping of dot-prefixed file extensions to\n  1233→            Internet media types (RFC 2046). Defaults to ``mimetypes.types_map``\n  1234→            after calling ``mimetypes.init()``.\n  1235→    \"\"\"\n  1236→\n  1237→    secure_cookies_by_default: bool\n  1238→    default_media_type: Optional[str]\n  1239→    media_handlers: Handlers\n  1240→    static_media_types: dict\n  1241→\n  1242→    __slots__ = (\n  1243→        'secure_cookies_by_default',\n  1244→        'default_media_type',\n  1245→        'media_handlers',\n  1246→        'static_media_types',\n  1247→    )\n  1248→\n  1249→    def __init__(self):\n  1250→        self.secure_cookies_by_default = True\n  1251→        self.default_media_type = DEFAULT_MEDIA_TYPE\n  1252→        self.media_handlers = Handlers()\n  1253→\n  1254→        if not mimetypes.inited:\n  1255→            mimetypes.init()\n  1256→        self.static_media_types = mimetypes.types_map.copy()\n  1257→        self.static_media_types.update(_DEFAULT_STATIC_MEDIA_TYPES)\n  1258→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"b240414f-8e7e-4c49-be5d-27a4d34e3ec4","uuid":"6570fc88-60b2-498b-b719-11fc2b5a48b8","tool_use_result":{"type":"text","file":{"filePath":"/testbed/falcon/response.py","content":"# Copyright 2013 by Rackspace Hosting, Inc.\n#\n# Licensed under the Apache License, Version 2.0 (the \"License\");\n# you may not use this file except in compliance with the License.\n# You may obtain a copy of the License at\n#\n#    http://www.apache.org/licenses/LICENSE-2.0\n#\n# Unless required by applicable law or agreed to in writing, software\n# distributed under the License is distributed on an \"AS IS\" BASIS,\n# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.\n# See the License for the specific language governing permissions and\n# limitations under the License.\n\n\"\"\"Response class.\"\"\"\n\nimport functools\nimport mimetypes\nfrom typing import Optional\n\nfrom falcon.constants import _DEFAULT_STATIC_MEDIA_TYPES\nfrom falcon.constants import _UNSET\nfrom falcon.constants import DEFAULT_MEDIA_TYPE\nfrom falcon.errors import HeaderNotSupported\nfrom falcon.media import Handlers\nfrom falcon.response_helpers import format_content_disposition\nfrom falcon.response_helpers import format_etag_header\nfrom falcon.response_helpers import format_header_value_list\nfrom falcon.response_helpers import format_range\nfrom falcon.response_helpers import header_property\nfrom falcon.response_helpers import is_ascii_encodable\nfrom falcon.util import dt_to_http\nfrom falcon.util import http_cookies\nfrom falcon.util import http_status_to_code\nfrom falcon.util import structures\nfrom falcon.util import TimezoneGMT\nfrom falcon.util.deprecation import AttributeRemovedError\nfrom falcon.util.deprecation import deprecated\nfrom falcon.util.uri import encode_check_escaped as uri_encode\nfrom falcon.util.uri import encode_value_check_escaped as uri_encode_value\n\nGMT_TIMEZONE = TimezoneGMT()\n\n_STREAM_LEN_REMOVED_MSG = (\n    'The deprecated stream_len property was removed in Falcon 3.0. '\n    'Please use Response.set_stream() or Response.content_length instead.'\n)\n\n_RESERVED_CROSSORIGIN_VALUES = frozenset({'anonymous', 'use-credentials'})\n\n_RESERVED_SAMESITE_VALUES = frozenset({'lax', 'strict', 'none'})\n\n\nclass Response:\n    \"\"\"Represents an HTTP response to a client request.\n\n    Note:\n        ``Response`` is not meant to be instantiated directly by responders.\n\n    Keyword Arguments:\n        options (dict): Set of global options passed from the App handler.\n\n    Attributes:\n        status (Union[str,int]): HTTP status code or line (e.g., ``'200 OK'``).\n            This may be set to a member of :class:`http.HTTPStatus`, an HTTP\n            status line string or byte string (e.g., ``'200 OK'``), or an\n            ``int``.\n\n            Note:\n                The Falcon framework itself provides a number of constants for\n                common status codes. They all start with the ``HTTP_`` prefix,\n                as in: ``falcon.HTTP_204``. (See also: :ref:`status`.)\n\n        status_code (int): HTTP status code normalized from :attr:`status`.\n            When a code is assigned to this property, :attr:`status` is updated,\n            and vice-versa. The status code can be useful when needing to check\n            in middleware for codes that fall into a certain class, e.g.::\n\n                if resp.status_code >= 400:\n                    log.warning(f'returning error response: {resp.status_code}')\n\n        media (object): A serializable object supported by the media handlers\n            configured via :class:`falcon.RequestOptions`.\n\n            Note:\n                See also :ref:`media` for more information regarding media\n                handling.\n\n        text (str): String representing response content.\n\n            Note:\n                Falcon will encode the given text as UTF-8\n                in the response. If the content is already a byte string,\n                use the :attr:`data` attribute instead (it's faster).\n\n        data (bytes): Byte string representing response content.\n\n            Use this attribute in lieu of `text` when your content is\n            already a byte string (of type ``bytes``). See also the note below.\n\n            Warning:\n                Always use the `text` attribute for text, or encode it\n                first to ``bytes`` when using the `data` attribute, to\n                ensure Unicode characters are properly encoded in the\n                HTTP response.\n\n        stream: Either a file-like object with a `read()` method that takes\n            an optional size argument and returns a block of bytes, or an\n            iterable object, representing response content, and yielding\n            blocks as byte strings. Falcon will use *wsgi.file_wrapper*, if\n            provided by the WSGI server, in order to efficiently serve\n            file-like objects.\n\n            Note:\n                If the stream is set to an iterable object that requires\n                resource cleanup, it can implement a close() method to do so.\n                The close() method will be called upon completion of the request.\n\n        context (object): Empty object to hold any data (in its attributes)\n            about the response which is specific to your app (e.g. session\n            object). Falcon itself will not interact with this attribute after\n            it has been initialized.\n\n            Note:\n                **New in 2.0:** The default `context_type` (see below) was\n                changed from :class:`dict` to a bare class; the preferred way to\n                pass response-specific data is now to set attributes directly\n                on the `context` object. For example::\n\n                    resp.context.cache_strategy = 'lru'\n\n        context_type (class): Class variable that determines the factory or\n            type to use for initializing the `context` attribute. By default,\n            the framework will instantiate bare objects (instances of the bare\n            :class:`falcon.Context` class). However, you may override this\n            behavior by creating a custom child class of\n            :class:`falcon.Response`, and then passing that new class to\n            ``falcon.App()`` by way of the latter's `response_type` parameter.\n\n            Note:\n                When overriding `context_type` with a factory function (as\n                opposed to a class), the function is called like a method of\n                the current Response instance. Therefore the first argument is\n                the Response instance itself (self).\n\n        options (dict): Set of global options passed from the App handler.\n\n        headers (dict): Copy of all headers set for the response,\n            sans cookies. Note that a new copy is created and returned each\n            time this property is referenced.\n\n        complete (bool): Set to ``True`` from within a middleware method to\n            signal to the framework that request processing should be\n            short-circuited (see also :ref:`Middleware <middleware>`).\n    \"\"\"\n\n    __slots__ = (\n        'text',\n        'context',\n        'options',\n        'status',\n        'stream',\n        '_cookies',\n        '_data',\n        '_extra_headers',\n        '_headers',\n        '_media',\n        '_media_rendered',\n        '__dict__',\n    )\n\n    complete = False\n\n    # Child classes may override this\n    context_type = structures.Context\n\n    def __init__(self, options=None):\n        self.status = '200 OK'\n        self._headers = {}\n\n        # NOTE(kgriffs): Collection of additional headers as a list of raw\n        #   tuples, to use in cases where we need more control over setting\n        #   headers and duplicates are allowable or even necessary.\n        #\n        # PERF(kgriffs): Save some CPU cycles and a few bytes of RAM by\n        #   only instantiating the list object later on IFF it is needed.\n        self._extra_headers = None\n\n        self.options = options if options else ResponseOptions()\n\n        # NOTE(tbug): will be set to a SimpleCookie object\n        # when cookie is set via set_cookie\n        self._cookies = None\n\n        self.text = None\n        self.stream = None\n        self._data = None\n        self._media = None\n        self._media_rendered = _UNSET\n\n        self.context = self.context_type()\n\n    @property\n    def status_code(self) -> int:\n        return http_status_to_code(self.status)\n\n    @status_code.setter\n    def status_code(self, value):\n        self.status = value\n\n    @property  # type: ignore\n    def body(self):\n        raise AttributeRemovedError(\n            'The body attribute is no longer supported. '\n            'Please use the text attribute instead.'\n        )\n\n    @body.setter  # type: ignore\n    def body(self, value):\n        raise AttributeRemovedError(\n            'The body attribute is no longer supported. '\n            'Please use the text attribute instead.'\n        )\n\n    @property\n    def data(self):\n        return self._data\n\n    @data.setter\n    def data(self, value):\n        self._data = value\n\n    @property\n    def headers(self):\n        return self._headers.copy()\n\n    @property\n    def media(self):\n        return self._media\n\n    @media.setter\n    def media(self, value):\n        self._media = value\n        self._media_rendered = _UNSET\n\n    @property\n    def stream_len(self):\n        # NOTE(kgriffs): Provide some additional information by raising the\n        #   error explicitly.\n        raise AttributeError(_STREAM_LEN_REMOVED_MSG)\n\n    @stream_len.setter\n    def stream_len(self, value):\n        # NOTE(kgriffs): We explicitly disallow setting the deprecated attribute\n        #   so that apps relying on it do not fail silently.\n        raise AttributeError(_STREAM_LEN_REMOVED_MSG)\n\n    def render_body(self):\n        \"\"\"Get the raw bytestring content for the response body.\n\n        This method returns the raw data for the HTTP response body, taking\n        into account the :attr:`~.text`, :attr:`~.data`, and :attr:`~.media`\n        attributes.\n\n        Note:\n            This method ignores :attr:`~.stream`; the caller must check\n            and handle that attribute directly.\n\n        Returns:\n            bytes: The UTF-8 encoded value of the `text` attribute, if\n            set. Otherwise, the value of the `data` attribute if set, or\n            finally the serialized value of the `media` attribute. If\n            none of these attributes are set, ``None`` is returned.\n        \"\"\"\n\n        text = self.text\n        if text is None:\n            data = self._data\n\n            if data is None and self._media is not None:\n                # NOTE(kgriffs): We use a special _UNSET singleton since\n                #   None is ambiguous (the media handler might return None).\n                if self._media_rendered is _UNSET:\n                    if not self.content_type:\n                        self.content_type = self.options.default_media_type\n\n                    handler, _, _ = self.options.media_handlers._resolve(\n                        self.content_type, self.options.default_media_type\n                    )\n\n                    self._media_rendered = handler.serialize(\n                        self._media, self.content_type\n                    )\n\n                data = self._media_rendered\n        else:\n            try:\n                # NOTE(kgriffs): Normally we expect text to be a string\n                data = text.encode()\n            except AttributeError:\n                # NOTE(kgriffs): Assume it was a bytes object already\n                data = text\n\n        return data\n\n    def __repr__(self):\n        return '<%s: %s>' % (self.__class__.__name__, self.status)\n\n    def set_stream(self, stream, content_length):\n        \"\"\"Set both `stream` and `content_length`.\n\n        Although the :attr:`~falcon.Response.stream` and\n        :attr:`~falcon.Response.content_length` properties may be set\n        directly, using this method ensures\n        :attr:`~falcon.Response.content_length` is not accidentally\n        neglected when the length of the stream is known in advance. Using this\n        method is also slightly more performant as compared to setting the\n        properties individually.\n\n        Note:\n            If the stream length is unknown, you can set\n            :attr:`~falcon.Response.stream` directly, and ignore\n            :attr:`~falcon.Response.content_length`. In this case, the ASGI\n            server may choose to use chunked encoding or one\n            of the other strategies suggested by PEP-3333.\n\n        Args:\n            stream: A readable file-like object.\n            content_length (int): Length of the stream, used for the\n                Content-Length header in the response.\n        \"\"\"\n\n        self.stream = stream\n\n        # PERF(kgriffs): Set directly rather than incur the overhead of\n        #   the self.content_length property.\n        self._headers['content-length'] = str(content_length)\n\n    def set_cookie(\n        self,\n        name,\n        value,\n        expires=None,\n        max_age=None,\n        domain=None,\n        path=None,\n        secure=None,\n        http_only=True,\n        same_site=None,\n    ):\n        \"\"\"Set a response cookie.\n\n        Note:\n            This method can be called multiple times to add one or\n            more cookies to the response.\n\n        See Also:\n            To learn more about setting cookies, see\n            :ref:`Setting Cookies <setting-cookies>`. The parameters\n            listed below correspond to those defined in `RFC 6265`_.\n\n        Args:\n            name (str): Cookie name\n            value (str): Cookie value\n\n        Keyword Args:\n            expires (datetime): Specifies when the cookie should expire.\n                By default, cookies expire when the user agent exits.\n\n                (See also: RFC 6265, Section 4.1.2.1)\n            max_age (int): Defines the lifetime of the cookie in\n                seconds. By default, cookies expire when the user agent\n                exits. If both `max_age` and `expires` are set, the\n                latter is ignored by the user agent.\n\n                Note:\n                    Coercion to ``int`` is attempted if provided with\n                    ``float`` or ``str``.\n\n                (See also: RFC 6265, Section 4.1.2.2)\n\n            domain (str): Restricts the cookie to a specific domain and\n                any subdomains of that domain. By default, the user\n                agent will return the cookie only to the origin server.\n                When overriding this default behavior, the specified\n                domain must include the origin server. Otherwise, the\n                user agent will reject the cookie.\n\n                Note:\n                    Cookies do not provide isolation by port, so the domain\n                    should not provide one. (See also: RFC 6265, Section 8.5)\n\n                (See also: RFC 6265, Section 4.1.2.3)\n\n            path (str): Scopes the cookie to the given path plus any\n                subdirectories under that path (the \"/\" character is\n                interpreted as a directory separator). If the cookie\n                does not specify a path, the user agent defaults to the\n                path component of the requested URI.\n\n                Warning:\n                    User agent interfaces do not always isolate\n                    cookies by path, and so this should not be\n                    considered an effective security measure.\n\n                (See also: RFC 6265, Section 4.1.2.4)\n\n            secure (bool): Direct the client to only return the cookie\n                in subsequent requests if they are made over HTTPS\n                (default: ``True``). This prevents attackers from\n                reading sensitive cookie data.\n\n                Note:\n                    The default value for this argument is normally\n                    ``True``, but can be modified by setting\n                    :py:attr:`~.ResponseOptions.secure_cookies_by_default`\n                    via :any:`App.resp_options`.\n\n                Warning:\n                    For the `secure` cookie attribute to be effective,\n                    your application will need to enforce HTTPS.\n\n                (See also: RFC 6265, Section 4.1.2.5)\n\n            http_only (bool): The HttpOnly attribute limits the scope of the\n                cookie to HTTP requests.  In particular, the attribute\n                instructs the user agent to omit the cookie when providing\n                access to cookies via \"non-HTTP\" APIs. This is intended to\n                mitigate some forms of cross-site scripting. (default: ``True``)\n\n                Note:\n                    HttpOnly cookies are not visible to javascript scripts\n                    in the browser. They are automatically sent to the server\n                    on javascript ``XMLHttpRequest`` or ``Fetch`` requests.\n\n                (See also: RFC 6265, Section 4.1.2.6)\n\n            same_site (str): Helps protect against CSRF attacks by restricting\n                when a cookie will be attached to the request by the user agent.\n                When set to ``'Strict'``, the cookie will only be sent along\n                with \"same-site\" requests.  If the value is ``'Lax'``, the\n                cookie will be sent with same-site requests, and with\n                \"cross-site\" top-level navigations.  If the value is ``'None'``,\n                the cookie will be sent with same-site and cross-site requests.\n                Finally, when this attribute is not set on the cookie, the\n                attribute will be treated as if it had been set to ``'None'``.\n\n                (See also: `Same-Site RFC Draft`_)\n\n        Raises:\n            KeyError: `name` is not a valid cookie name.\n            ValueError: `value` is not a valid cookie value.\n\n        .. _RFC 6265:\n            http://tools.ietf.org/html/rfc6265\n\n        .. _Same-Site RFC Draft:\n            https://tools.ietf.org/html/draft-ietf-httpbis-rfc6265bis-03#section-4.1.2.7\n\n        \"\"\"\n\n        if not is_ascii_encodable(name):\n            raise KeyError('name is not ascii encodable')\n        if not is_ascii_encodable(value):\n            raise ValueError('value is not ascii encodable')\n\n        value = str(value)\n\n        if self._cookies is None:\n            self._cookies = http_cookies.SimpleCookie()\n\n        try:\n            self._cookies[name] = value\n        except http_cookies.CookieError as e:  # pragma: no cover\n            # NOTE(tbug): we raise a KeyError here, to avoid leaking\n            # the CookieError to the user. SimpleCookie (well, BaseCookie)\n            # only throws CookieError on issues with the cookie key\n            raise KeyError(str(e))\n\n        if expires:\n            # set Expires on cookie. Format is Wdy, DD Mon YYYY HH:MM:SS GMT\n\n            # NOTE(tbug): we never actually need to\n            # know that GMT is named GMT when formatting cookies.\n            # It is a function call less to just write \"GMT\" in the fmt string:\n            fmt = '%a, %d %b %Y %H:%M:%S GMT'\n            if expires.tzinfo is None:\n                # naive\n                self._cookies[name]['expires'] = expires.strftime(fmt)\n            else:\n                # aware\n                gmt_expires = expires.astimezone(GMT_TIMEZONE)\n                self._cookies[name]['expires'] = gmt_expires.strftime(fmt)\n\n        if max_age:\n            # RFC 6265 section 5.2.2 says about the max-age value:\n            #   \"If the remainder of attribute-value contains a non-DIGIT\n            #    character, ignore the cookie-av.\"\n            # That is, RFC-compliant response parsers will ignore the max-age\n            # attribute if the value contains a dot, as in floating point\n            # numbers. Therefore, attempt to convert the value to an integer.\n            self._cookies[name]['max-age'] = int(max_age)\n\n        if domain:\n            self._cookies[name]['domain'] = domain\n\n        if path:\n            self._cookies[name]['path'] = path\n\n        is_secure = self.options.secure_cookies_by_default if secure is None else secure\n\n        if is_secure:\n            self._cookies[name]['secure'] = True\n\n        if http_only:\n            self._cookies[name]['httponly'] = http_only\n\n        # PERF(kgriffs): Morsel.__setitem__() will lowercase this anyway,\n        #   so we can just pass this in and when __setitem__() calls\n        #   lower() it will be very slightly faster.\n        if same_site:\n            same_site = same_site.lower()\n\n            if same_site not in _RESERVED_SAMESITE_VALUES:\n                raise ValueError(\n                    \"same_site must be set to either 'lax', 'strict', or 'none'\"\n                )\n\n            self._cookies[name]['samesite'] = same_site.capitalize()\n\n    def unset_cookie(self, name, samesite='Lax', domain=None, path=None):\n        \"\"\"Unset a cookie in the response.\n\n        Clears the contents of the cookie, and instructs the user\n        agent to immediately expire its own copy of the cookie.\n\n        Note:\n            Modern browsers place restriction on cookies without the\n            \"same-site\" cookie attribute set. To that end this attribute\n            is set to ``'Lax'`` by this method.\n\n            (See also: `Same-Site warnings`_)\n\n        Warning:\n            In order to successfully remove a cookie, both the\n            path and the domain must match the values that were\n            used when the cookie was created.\n\n        Args:\n            name (str): Cookie name\n\n        Keyword Args:\n            samesite (str): Allows to override the default 'Lax' same_site\n                    setting for the unset cookie.\n\n            domain (str): Restricts the cookie to a specific domain and\n                    any subdomains of that domain. By default, the user\n                    agent will return the cookie only to the origin server.\n                    When overriding this default behavior, the specified\n                    domain must include the origin server. Otherwise, the\n                    user agent will reject the cookie.\n\n                    Note:\n                        Cookies do not provide isolation by port, so the domain\n                        should not provide one. (See also: RFC 6265, Section 8.5)\n\n                    (See also: RFC 6265, Section 4.1.2.3)\n\n            path (str): Scopes the cookie to the given path plus any\n                subdirectories under that path (the \"/\" character is\n                interpreted as a directory separator). If the cookie\n                does not specify a path, the user agent defaults to the\n                path component of the requested URI.\n\n                Warning:\n                    User agent interfaces do not always isolate\n                    cookies by path, and so this should not be\n                    considered an effective security measure.\n\n                (See also: RFC 6265, Section 4.1.2.4)\n\n        .. _Same-Site warnings:\n            https://developer.mozilla.org/en-US/docs/Web/HTTP/Headers/Set-Cookie/SameSite#Fixing_common_warnings\n        \"\"\"  # noqa: E501\n        if self._cookies is None:\n            self._cookies = http_cookies.SimpleCookie()\n\n        self._cookies[name] = ''\n\n        # NOTE(Freezerburn): SimpleCookie apparently special cases the\n        # expires attribute to automatically use strftime and set the\n        # time as a delta from the current time. We use -1 here to\n        # basically tell the browser to immediately expire the cookie,\n        # thus removing it from future request objects.\n        self._cookies[name]['expires'] = -1\n\n        # NOTE(CaselIT): Set SameSite to Lax to avoid setting invalid cookies.\n        # See https://developer.mozilla.org/en-US/docs/Web/HTTP/Headers/Set-Cookie/SameSite#Fixing_common_warnings  # noqa: E501\n        self._cookies[name]['samesite'] = samesite\n\n        if domain:\n            self._cookies[name]['domain'] = domain\n\n        if path:\n            self._cookies[name]['path'] = path\n\n    def get_header(self, name, default=None):\n        \"\"\"Retrieve the raw string value for the given header.\n\n        Normally, when a header has multiple values, they will be\n        returned as a single, comma-delimited string. However, the\n        Set-Cookie header does not support this format, and so\n        attempting to retrieve it will raise an error.\n\n        Args:\n            name (str): Header name, case-insensitive. Must be of type ``str``\n                or ``StringType``, and only character values 0x00 through 0xFF\n                may be used on platforms that use wide characters.\n        Keyword Args:\n            default: Value to return if the header\n                is not found (default ``None``).\n\n        Raises:\n            ValueError: The value of the 'Set-Cookie' header(s) was requested.\n\n        Returns:\n            str: The value of the specified header if set, or\n            the default value if not set.\n        \"\"\"\n\n        # NOTE(kgriffs): normalize name by lowercasing it\n        name = name.lower()\n\n        if name == 'set-cookie':\n            raise HeaderNotSupported('Getting Set-Cookie is not currently supported.')\n\n        return self._headers.get(name, default)\n\n    def set_header(self, name, value):\n        \"\"\"Set a header for this response to a given value.\n\n        Warning:\n            Calling this method overwrites any values already set for this\n            header. To append an additional value for this header, use\n            :meth:`~.append_header` instead.\n\n        Warning:\n            This method cannot be used to set cookies; instead, use\n            :meth:`~.append_header` or :meth:`~.set_cookie`.\n\n        Args:\n            name (str): Header name (case-insensitive). The name may contain\n                only US-ASCII characters.\n            value (str): Value for the header. As with the header's name, the\n                value may contain only US-ASCII characters.\n\n        Raises:\n            ValueError: `name` cannot be ``'Set-Cookie'``.\n        \"\"\"\n\n        # NOTE(kgriffs): uwsgi fails with a TypeError if any header\n        # is not a str, so do the conversion here. It's actually\n        # faster to not do an isinstance check. str() will encode\n        # to US-ASCII.\n        value = str(value)\n\n        # NOTE(kgriffs): normalize name by lowercasing it\n        name = name.lower()\n\n        if name == 'set-cookie':\n            raise HeaderNotSupported('This method cannot be used to set cookies')\n\n        self._headers[name] = value\n\n    def delete_header(self, name):\n        \"\"\"Delete a header that was previously set for this response.\n\n        If the header was not previously set, nothing is done (no error is\n        raised). Otherwise, all values set for the header will be removed\n        from the response.\n\n        Note that calling this method is equivalent to setting the\n        corresponding header property (when said property is available) to\n        ``None``. For example::\n\n            resp.etag = None\n\n        Warning:\n            This method cannot be used with the Set-Cookie header. Instead,\n            use :meth:`~.unset_cookie` to remove a cookie and ensure that the\n            user agent expires its own copy of the data as well.\n\n        Args:\n            name (str): Header name (case-insensitive). The name may\n                contain only US-ASCII characters.\n\n        Raises:\n            ValueError: `name` cannot be ``'Set-Cookie'``.\n        \"\"\"\n\n        # NOTE(kgriffs): normalize name by lowercasing it\n        name = name.lower()\n\n        if name == 'set-cookie':\n            raise HeaderNotSupported('This method cannot be used to remove cookies')\n\n        self._headers.pop(name, None)\n\n    def append_header(self, name, value):\n        \"\"\"Set or append a header for this response.\n\n        If the header already exists, the new value will normally be appended\n        to it, delimited by a comma. The notable exception to this rule is\n        Set-Cookie, in which case a separate header line for each value will be\n        included in the response.\n\n        Note:\n            While this method can be used to efficiently append raw\n            Set-Cookie headers to the response, you may find\n            :py:meth:`~.set_cookie` to be more convenient.\n\n        Args:\n            name (str): Header name (case-insensitive). The name may contain\n                only US-ASCII characters.\n            value (str): Value for the header. As with the header's name, the\n                value may contain only US-ASCII characters.\n        \"\"\"\n\n        # NOTE(kgriffs): uwsgi fails with a TypeError if any header\n        # is not a str, so do the conversion here. It's actually\n        # faster to not do an isinstance check. str() will encode\n        # to US-ASCII.\n        value = str(value)\n\n        # NOTE(kgriffs): normalize name by lowercasing it\n        name = name.lower()\n\n        if name == 'set-cookie':\n            if not self._extra_headers:\n                self._extra_headers = [(name, value)]\n            else:\n                self._extra_headers.append((name, value))\n        else:\n            if name in self._headers:\n                value = self._headers[name] + ', ' + value\n\n            self._headers[name] = value\n\n    def set_headers(self, headers):\n        \"\"\"Set several headers at once.\n\n        This method can be used to set a collection of raw header names and\n        values all at once.\n\n        Warning:\n            Calling this method overwrites any existing values for the given\n            header. If a list containing multiple instances of the same header\n            is provided, only the last value will be used. To add multiple\n            values to the response for a given header, see\n            :meth:`~.append_header`.\n\n        Warning:\n            This method cannot be used to set cookies; instead, use\n            :meth:`~.append_header` or :meth:`~.set_cookie`.\n\n        Args:\n            headers (Iterable[[str, str]]): An iterable of ``[name, value]`` two-member\n                iterables, or a dict-like object that implements an ``items()`` method.\n                Both *name* and *value* must be of type ``str`` and\n                contain only US-ASCII characters.\n\n             