comma when the header in question supports the list\n  1110→            format (see also RFC 7230 and RFC 7231). Header names are not\n  1111→            case-sensitive.\n  1112→\n  1113→            Note:\n  1114→                If a User-Agent header is not provided, it will default to::\n  1115→\n  1116→                    f'falcon-client/{falcon.__version__}'\n  1117→\n  1118→        root_path (str): Value for the ``SCRIPT_NAME`` environ variable, described in\n  1119→            PEP-333: 'The initial portion of the request URL's \"path\" that\n  1120→            corresponds to the application object, so that the application\n  1121→            knows its virtual \"location\". This may be an empty string, if the\n  1122→            application corresponds to the \"root\" of the server.' (default ``''``)\n  1123→        app (str): Deprecated alias for `root_path`. If both kwargs are passed,\n  1124→            `root_path` takes precedence.\n  1125→        body (str): The body of the request (default ``''``). The value will be\n  1126→            encoded as UTF-8 in the WSGI environ. Alternatively, a byte string\n  1127→            may be passed, in which case it will be used as-is.\n  1128→        method (str): The HTTP method to use (default ``'GET'``)\n  1129→        wsgierrors (io): The stream to use as *wsgierrors*\n  1130→            (default ``sys.stderr``)\n  1131→        file_wrapper: Callable that returns an iterable, to be used as\n  1132→            the value for *wsgi.file_wrapper* in the environ.\n  1133→        remote_addr (str): Remote address for the request to use as the\n  1134→            ``'REMOTE_ADDR'`` environ variable (default ``None``)\n  1135→        cookies (dict): Cookies as a dict-like (Mapping) object, or an\n  1136→            iterable yielding a series of two-member (*name*, *value*)\n  1137→            iterables. Each pair of items provides the name and value\n  1138→            for the Set-Cookie header.\n  1139→\n  1140→    \"\"\"\n  1141→\n  1142→    http_version = _fixup_http_version(http_version)\n  1143→\n  1144→    if query_string and query_string.startswith('?'):\n  1145→        raise ValueError(\"query_string should not start with '?'\")\n  1146→\n  1147→    body = io.BytesIO(body.encode() if isinstance(body, str) else body)\n  1148→\n  1149→    # NOTE(kgriffs): wsgiref, gunicorn, and uWSGI all unescape\n  1150→    # the paths before setting PATH_INFO but preserve raw original\n  1151→    raw_path = path\n  1152→    path = uri.decode(path, unquote_plus=False)\n  1153→\n  1154→    # NOTE(kgriffs): The decoded path may contain UTF-8 characters.\n  1155→    # But according to the WSGI spec, no strings can contain chars\n  1156→    # outside ISO-8859-1. Therefore, to reconcile the URI\n  1157→    # encoding standard that allows UTF-8 with the WSGI spec\n  1158→    # that does not, WSGI servers tunnel the string via\n  1159→    # ISO-8859-1. falcon.testing.create_environ() mimics this\n  1160→    # behavior, e.g.:\n  1161→    #\n  1162→    #   tunnelled_path = path.encode('utf-8').decode('iso-8859-1')\n  1163→    #\n  1164→    # falcon.Request does the following to reverse the process:\n  1165→    #\n  1166→    #   path = tunnelled_path.encode('iso-8859-1').decode('utf-8', 'replace')\n  1167→    #\n  1168→    path = path.encode().decode('iso-8859-1')\n  1169→\n  1170→    scheme = scheme.lower()\n  1171→    if port is None:\n  1172→        port = '80' if scheme == 'http' else '443'\n  1173→    else:\n  1174→        # NOTE(kgriffs): Running it through int() first ensures that if\n  1175→        #   a string was passed, it is a valid integer.\n  1176→        port = str(int(port))\n  1177→\n  1178→    root_path = root_path or app or ''\n  1179→\n  1180→    # NOTE(kgriffs): Judging by the algorithm given in PEP-3333 for\n  1181→    # reconstructing the URL, SCRIPT_NAME is expected to contain a\n  1182→    # preceding slash character.\n  1183→    if root_path and not root_path.startswith('/'):\n  1184→        root_path = '/' + root_path\n  1185→\n  1186→    env = {\n  1187→        'SERVER_PROTOCOL': 'HTTP/' + http_version,\n  1188→        'SERVER_SOFTWARE': 'gunicorn/0.17.0',\n  1189→        'SCRIPT_NAME': (root_path or ''),\n  1190→        'REQUEST_METHOD': method,\n  1191→        'PATH_INFO': path,\n  1192→        'QUERY_STRING': query_string,\n  1193→        'REMOTE_PORT': '65133',\n  1194→        'RAW_URI': raw_path,\n  1195→        'SERVER_NAME': host,\n  1196→        'SERVER_PORT': port,\n  1197→        'wsgi.version': (1, 0),\n  1198→        'wsgi.url_scheme': scheme,\n  1199→        'wsgi.input': body,\n  1200→        'wsgi.errors': wsgierrors or sys.stderr,\n  1201→        'wsgi.multithread': False,\n  1202→        'wsgi.multiprocess': True,\n  1203→        'wsgi.run_once': False,\n  1204→    }\n  1205→\n  1206→    # NOTE(kgriffs): It has been observed that WSGI servers do not always\n  1207→    #   set the REMOTE_ADDR variable, so we don't always set it either, to\n  1208→    #   ensure the framework/app handles that case correctly.\n  1209→    if remote_addr:\n  1210→        env['REMOTE_ADDR'] = remote_addr\n  1211→\n  1212→    if file_wrapper is not None:\n  1213→        env['wsgi.file_wrapper'] = file_wrapper\n  1214→\n  1215→    if http_version != '1.0':\n  1216→        host_header = host\n  1217→\n  1218→        if scheme == 'https':\n  1219→            if port != '443':\n  1220→                host_header += ':' + port\n  1221→        else:\n  1222→            if port != '80':\n  1223→                host_header += ':' + port\n  1224→\n  1225→        env['HTTP_HOST'] = host_header\n  1226→\n  1227→    content_length = body.seek(0, 2)\n  1228→    body.seek(0)\n  1229→\n  1230→    if content_length != 0:\n  1231→        env['CONTENT_LENGTH'] = str(content_length)\n  1232→\n  1233→    # NOTE(myusko): Clients discard Set-Cookie header\n  1234→    #  in the response to the OPTIONS method.\n  1235→    if cookies is not None and method != 'OPTIONS