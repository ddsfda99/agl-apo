n   816→def get_unused_port() -> int:\n   817→    \"\"\"Get an unused localhost port for use by a test server.\n   818→\n   819→    Warning:\n   820→        It is possible for a third party to bind to the returned port\n   821→        before the caller is able to do so. The caller will need to\n   822→        retry with a different port in that case.\n   823→\n   824→    Warning:\n   825→        This method has only be tested on POSIX systems and may not\n   826→        work elsewhere.\n   827→    \"\"\"\n   828→\n   829→    with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as s:\n   830→        s.bind(('localhost', 0))\n   831→        return s.getsockname()[1]\n   832→\n   833→\n   834→def rand_string(min, max) -> str:\n   835→    \"\"\"Return a randomly-generated string, of a random length.\n   836→\n   837→    Args:\n   838→        min (int): Minimum string length to return, inclusive\n   839→        max (int): Maximum string length to return, inclusive\n   840→\n   841→    \"\"\"\n   842→\n   843→    int_gen = random.randint\n   844→    string_length = int_gen(min, max)\n   845→    return ''.join([chr(int_gen(ord(' '), ord('~'))) for __ in range(string_length)])\n   846→\n   847→\n   848→def create_scope(\n   849→    path='/',\n   850→    query_string='',\n   851→    method='GET',\n   852→    headers=None,\n   853→    host=DEFAULT_HOST,\n   854→    scheme=None,\n   855→    port=None,\n   856→    http_version='1.1',\n   857→    remote_addr=None,\n   858→    root_path=None,\n   859→    content_length=None,\n   860→    include_server=True,\n   861→    cookies=None,\n   862→) -> Dict[str, Any]:\n   863→    \"\"\"Create a mock ASGI scope ``dict`` for simulating HTTP requests.\n   864→\n   865→    Keyword Args:\n   866→        path (str): The path for the request (default ``'/'``)\n   867→        query_string (str): The query string to simulate, without a\n   868→            leading ``'?'`` (default ``''``). The query string is passed as-is\n   869→            (it will not be percent-encoded).\n   870→        method (str): The HTTP method to use (default ``'GET'``)\n   871→        headers (dict): Headers as a dict-like (Mapping) object, or an\n   872→            iterable yielding a series of two-member (*name*, *value*)\n   873→            iterables. Each pair of strings provides the name and value\n   874→            for an HTTP header. If desired, multiple header values may be\n   875→            combined into a single (*name*, *value*) pair by joining the values\n   876→            with a comma when the header in question supports the list\n   877→            format (see also RFC 7230 and RFC 7231). When the\n   878→            request will include a body, the Content-Length header should be\n   879→            included in this list. Header names are not case-sensitive.\n   880→\n   881→            Note:\n   882→                If a User-Agent header is not provided, it will default to::\n   883→\n   884→                    f'falcon-client/{falcon.__version__}'\n   885→\n   886→        host(str): Hostname for the request (default ``'falconframework.org'``).\n   887→            This also determines the value of the Host header in the\n   888→            request.\n   889→        scheme (str): URL scheme, either ``'http'`` or ``'https'``\n   890→            (default ``'http'``)\n   891→        port (int): The TCP port to simulate. Defaults to\n   892→            the standard port used by the given scheme (i.e., 80 for ``'http'``\n   893→            and 443 for ``'https'``). A string may also be passed, as long as\n   894→            it can be parsed as an int.\n   895→        http_version (str): The HTTP version to simulate. Must be either\n   896→            ``'2'``, ``'2.0'``, ``'1.1'``, ``'1.0'``, or ``'1'``\n   897→            (default ``'1.1'``). If set to ``'1.0'``, the Host header will not\n   898→            be added to the scope.\n   899→        remote_addr (str): Remote address for the request to use for\n   900→            the 'client' field in the connection scope (default None)\n   901→        root_path (str): The root path this application is mounted at; same as\n   902→            SCRIPT_NAME in WSGI (default ``''``).\n   903→        content_length (int): The expected content length of the request\n   904→            body (default ``None``). If specified, this value will be\n   905→            used to set the Content-Length header in the request.\n   906→        include_server (bool): Set to ``False`` to not set the 'server' key\n   907→            in the scope ``dict`` (default ``True``).\n   908→        cookies (dict): Cookies as a dict-like (Mapping) object, or an\n   909→            iterable yielding a series of two-member (*name*, *value*)\n   910→            iterables. Each pair of items provides the name and value\n   911→            for the 'Set-Cookie' header.\n   912→    \"\"\"\n   913→\n   914→    http_version = _fixup_http_version(http_version)\n   915→\n   916→    path = uri.decode(path, unquote_plus=False)\n   917→\n   918→    # NOTE(kgriffs): Handles both None and ''\n   919→    query_string = query_string.encode() if query_string else b''\n   920→\n   921→    if query_string and query_string.startswith(b'?'):\n   922→        raise ValueError(\"query_string should not start with '?'\")\n   923→\n   924→    scope = {\n   925→        'type': ScopeType.HTTP,\n   926→        'asgi': {\n   927→            'version': '3.0',\n   928→            'spec_version': '2.1',\n   929→        },\n   930→        'http_version': http_version,\n   931→        'method': method.upper(),\n   932→        'path': path,\n   933→        'query_string': query_string,\n   934→    }\n   935→\n   936→    # NOTE(kgriffs): Explicitly test against None so that the caller\n   937→    #   is able to simulate setting app to an empty string if they\n   938→    #   need to cover that branch in their code.\n   939→    if root_path is not None:\n   940→        # NOTE(kgriffs): Judging by the algorithm given in PEP-3333 for\n   941→        #   reconstructing the URL, SCRIPT_NAME is expected to contain a\n   942→        #   preceding slash character. Since ASGI states that this value is\n   943→        #   the same as WSGI's SCRIPT_NAME, we will follow suit here.\n   944→        if root_path and not root_path.startswith('/'):\n   945→            scope['root_path'] = '/' + root_path\n   946→        else:\n   947→            scope['root_path'] = root_path\n   948→\n   949→    if scheme:\n   950→        if scheme not in {'http', 'https', 'ws', 'wss'}:\n   951→            raise ValueError(\"scheme must be either 'http', 'https', 'ws', or 'wss'\")\n   952→\n   953→        scope['scheme'] = scheme\n   954→\n   955→    if port is None:\n   956→        if (scheme or 'http') in {'http', 'ws'}:\n   957→            port = 80\n   958→        else:\n   959→            port = 443\n   960→    else:\n   961→        port = int(port)\n   962→\n   963→    if remote_addr:\n   964→        # NOTE(kgriffs): Choose from the standard IANA dynamic range\n   965→        remote_port = random.randint(49152, 65535)\n   966→\n   967→        # NOTE(kgriffs): Expose as an iterable to ensure the framework/app\n   968→        #   isn't hard-coded to only work with a list or tuple.\n   969→        scope['client'] = iter([remote_addr, remote_port])\n   970→\n   971→    if include_server:\n   972→        scope['server'] = iter([host, port])\n   973→\n   974→    # NOTE(myusko): Clients discard Set-Cookie header\n   975→    #  in the response to the OPTIONS method.\n   976→    if method == 'OPTIONS' and cookies is not None:\n   977→        cookies = None\n   978→\n   979→    _add_headers_to_scope(\n   980→        scope, headers, content_length, host, port, scheme, http_version, cookies\n   981→    )\n   982→\n   983→    return scope\n   984→\n   985→\n   986→def create_scope_ws(\n   987→    path='/',\n   988→    query_string='',\n   989→    headers=None,\n   990→    host=DEFAULT_HOST,\n   991→    