os = len(self._chunks)\n   271→\n   272→        return data\n   273→\n   274→\n   275→class Result(_ResultBase):\n   276→    \"\"\"Encapsulates the result of a simulated request.\n   277→\n   278→    Args:\n   279→        iterable (iterable): An iterable that yields zero or more\n   280→            bytestrings, per PEP-3333\n   281→        status (str): An HTTP status string, including status code and\n   282→            reason string\n   283→        headers (list): A list of (header_name, header_value) tuples,\n   284→            per PEP-3333\n   285→\n   286→    Attributes:\n   287→        status (str): HTTP status string given in the response\n   288→        status_code (int): The code portion of the HTTP status string\n   289→        headers (CaseInsensitiveDict): A case-insensitive dictionary\n   290→            containing all the headers in the response, except for\n   291→            cookies, which may be accessed via the `cookies`\n   292→            attribute.\n   293→\n   294→            Note:\n   295→\n   296→                Multiple instances of a header in the response are\n   297→                currently not supported; it is unspecified which value\n   298→                will \"win\" and be represented in `headers`.\n   299→\n   300→        cookies (dict): A dictionary of\n   301→            :py:class:`falcon.testing.Cookie` values parsed from the\n   302→            response, by name.\n   303→        encoding (str): Text encoding of the response body, or ``None``\n   304→            if the encoding can not be determined.\n   305→        content (bytes): Raw response body, or ``bytes`` if the\n   306→            response body was empty.\n   307→        text (str): Decoded response body of type ``str``.\n   308→            If the content type does not specify an encoding, UTF-8 is\n   309→            assumed.\n   310→        json (JSON serializable): Deserialized JSON body. Will be ``None`` if\n   311→            the body has no content to deserialize