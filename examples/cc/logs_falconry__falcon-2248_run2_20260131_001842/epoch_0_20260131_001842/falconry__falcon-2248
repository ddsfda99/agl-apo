type,\n   594→        headers,\n   595→        body,\n   596→        json,\n   597→        extras,\n   598→    )\n   599→\n   600→    env = helpers.create_environ(\n   601→        method=method,\n   602→        scheme=protocol,\n   603→        path=path,\n   604→        query_string=(query_string or ''),\n   605→        headers=headers,\n   606→        body=body,\n   607→        file_wrapper=file_wrapper,\n   608→        host=host,\n   609→        remote_addr=remote_addr,\n   610→        wsgierrors=wsgierrors,\n   611→        http_version=http_version,\n   612→        port=port,\n   613→        root_path=root_path,\n   614→        cookies=cookies,\n   615→    )\n   616→\n   617→    if 'REQUEST_METHOD' in extras and extras['REQUEST_METHOD'] != method:\n   618→        # NOTE(vytas): Even given the duct tape nature of overriding\n   619→        # arbitrary environ variables, changing the method can potentially\n   620→        # be very confusing, particularly when using specialized\n   621→        # simulate_get/post/patch etc methods.\n   622→        raise ValueError(\n   623→            'WSGI environ extras may not override the request method. '\n   624→            'Please use the method parameter.'\n   625→        )\n   626→\n   627→    env.update(extras)\n   628→\n   629→    srmock = StartResponseMock()\n   630→    validator = wsgiref.validate.validator(app)\n   631→\n   632→    iterable = validator(env, srmock)\n   633→\n   634→    return Result(helpers.closed_wsgi_iterable(iterable), srmock.status, srmock.headers)\n   635→\n   636→\n   637→# NOTE(kgriffs): The default of asgi_disconnect_ttl was chosen to be\n   638→#   relatively long (5 minutes) to help testers notice when something\n   639→#   appears to be \"hanging\", which might indicates that the app is\n   640→#   not handling the reception of events correctly.\n   641→async def _simulate_request_asgi(\n   642→    app,\n   643→    method='GET',\n   644→    path='/',\n   645→    query_string=None,\n   646→    headers=None,\n   647→    content_type=None,\n   648→    body=None,\n   649→    json=None,\n   650→    params=None,\n   651→    params_csv=True,\n   652→    protocol='http',\n   653→    host=helpers.DEFAULT_HOST,\n   654→    remote_addr=None,\n   655→    extras=None,\n   656→    http_version='1.1',\n   657→    port=None,\n   658→    root_path=None,\n   659→    asgi_chunk_size=4096,\n   660→    asgi_disconnect_ttl=300,\n   661→    cookies=None,\n   662→    # NOTE(kgriffs): These are undocumented because they are only\n   663→    #   meant to be used internally by the framework (i.e., they are\n   664→    #   not part of the public interface.) In case we ever expose\n   665→    #   simulate_request_asgi() as part of the public interface, we\n   666→    #   don't want these kwargs to be documented.\n   667→    _one_shot=True,\n   668→    _stream_result=False,\n   669→) -> _ResultBase:\n   670→    \"\"\"Simulate a request to an ASGI application.\n   671→\n   672→    Keyword Args:\n   673→        app (callable): The WSGI or ASGI application to call\n   674→        method (str): An HTTP method to use in the request\n   675→            (default: 'GET')\n   676→        path (str): The URL path to request (default: '/').\n   677→\n   678→            Note:\n   679→                The path may contain a query string. However, neither\n   680→                `query_string` nor `params` may be specified in this case.\n   681→\n   682→        root_path (str): The initial portion of the request URL's \"path\" that\n   683→            corresponds to the application object, so that the application\n   684→            knows its virtual \"location\". This defaults to the empty string,\n   685→            indicating that the application corresponds to the \"root\" of the\n   686→            server.\n   687→        protocol: The protocol to use for the URL scheme\n   688→            (default: 'http')\n   689→        port (int): The TCP port to simulate. Defaults to\n   690→          