    48\u2192from falcon.util import uri\n    49\u2192from falcon.util.mediatypes import parse_header\n    50\u2192\n    51\u2192# NOTE(kgriffs): Changed in 3.0 from 'curl/7.24.0 (x86_64-apple-darwin12.0)'\n    52\u2192DEFAULT_UA = 'falcon-client/' + falcon.__version__\n    53\u2192DEFAULT_HOST = 'falconframework.org'\n    54\u2192\n    55\u2192\n    56\u2192class ASGILifespanEventEmitter:\n    57\u2192    \"\"\"Emits ASGI lifespan events to an ASGI app.\n    58\u2192\n    59\u2192    This class can be used to drive a standard ASGI app callable in order to\n    60\u2192    perform functional tests on the app in question.\n    61\u2192\n    62\u2192    When simulating both lifespan and per-request events, each event stream\n    63\u2192    will require a separate invocation of the ASGI callable; one with a\n    64\u2192    lifespan event emitter, and one with a request event emitter. An\n    65\u2192    asyncio :class:`~asyncio.Condition` can be used to pause the\n    66\u2192    lifespan emitter until all of the desired request events have been\n    67\u2192    emitted.\n    68\u2192\n    69\u2192    Keyword Args:\n    70\u2192        shutting_down (asyncio.Condition): An instance of\n    71\u2192            :class:`asyncio.Condition` that will be awaited before\n    72\u2192            emitting the final shutdown event (``'lifespan.shutdown``).\n    73\u2192    \"\"\"\n    74\u2192\n    75\u2192    def __init__(self, shutting_down):\n    76\u2192        self._state = 0\n    77\u2192        self._shutting_down = shutting_down\n    78\u2192\n    79\u2192    async def emit(self):\n    80\u2192        if self._state == 0:\n    81\u2192            self._state += 1\n    82\u2192            return {'type': EventType.LIFESPAN_STARTUP}\n    83\u2192\n    84\u2192        if self._state == 1:\n    85\u2192            self._state += 1\n    86\u2192            # NOTE(kgriffs): This verifies the app ignores events it does\n    87\u2192            #   not recognize.\n    88\u2192            return {'type': 'lifespan._nonstandard_event'}\n    89\u2192\n    90\u2192        async with self._shutting_down:\n    91\u2192            await self._shutting_down.wait()\n    92\u2192\n    93\u2192        return {'type': EventType.LIFESPAN_SHUTDOWN}\n    94\u2192\n    95\u2192    __call__ = emit\n    96\u2192\n    97\u2192\n    98\u2192class ASGIRequestEventEmitter:\n    99\u2192    \"\"\"Emits events on-demand to an ASGI app.\n   100\u2192\n   101\u2192    This class can be used to drive a standard ASGI app callable in order to\n   102\u2192    perform functional tests on the app in question.\n   103\u2192\n   104\u2192    Note:\n   105\u2192        In order to ensure the app is able to handle subtle variations\n   106\u2192        in the ASGI events that are allowed by the specification, such\n   107\u2192        variations are applied to the emitted events at unspecified\n   108\u2192        intervals. This includes whether or not the `more_body` field\n   109\u2192        is explicitly set, or whether or not the request `body` chunk in\n   110\u2192        the event is occasionally empty,\n   111\u2192\n   112\u2192    Keyword Args:\n   113\u2192        body (str): The body content to use when emitting http.request\n   114\u2192            events. May be an empty string. If a byte string, it will\n   115\u2192            be used as-is; otherwise it will be encoded as UTF-8\n   116\u2192            (default ``b''``).\n   117\u2192        chunk_size (int): The maximum number of bytes to include in\n   118\u2192            a single http.request event (default 4096).\n   119\u2192        disconnect_at (float): The Unix timestamp after which to begin\n   120\u2192            emitting ``'http.disconnect'`` events (default now + 30s). The\n   121\u2192            value may be either an ``int`` or a ``float``, depending\n   122\u2192            on the precision required. Setting `disconnect_at` to\n   123\u2192            ``0`` is treated as a special case, and will result in an\n   124\u2192            ``'http.disconnect'`` event being immediately emitted (rather than\n   125\u2192            first emitting an ``'http.request'`` event).\n   126\u2192\n   127\u2192    Attributes:\n   128\u2192        disconnected (bool): Returns ``True`` if the simulated client\n   129\u2192            connection is in a \"disconnected\" state.\n   130\u2192    \"\"\"\n   131\u2192\n   132\u2192    # TODO(kgriffs): If this pattern later becomes useful elsewhere,\n   133\u2192    #   factor out into a standalone helper class.\n   134\u2192    _branch_decider = defaultdict(bool)  # type: defaultdict\n   135\u2192\n   136\u2192    def __init__(\n   137\u2192        self,\n   138\u2192        body: Optional[Union[str, bytes]] = None,\n   139\u2192        chunk_size: Optional[int] = None,\n   140\u2192        disconnect_at: Optional[Union[int, float]] = None,\n   141\u2192    ):\n   142\u2192        if body is None:\n   143\u2192            body = b''\n   144\u2192        elif not isinstance(body, bytes):\n   145\u2192            body = body.encode()\n   146\u2192\n   147\u2192        body = memoryview(body)\n   148\u2192\n   149\u2192        if disconnect_at is None:\n   150\u2192            disconnect_at = time.time() + 30\n   151\u2192\n   152\u2192        if chunk_size is None:\n   153\u2192            chunk_size = 4096\n   154\u2192\n   155\u2192        self._body = body  # type: Optional[memoryview]\n   156\u2192        self._chunk_size = chunk_size\n   157\u2192        self._emit_empty_chunks = True\n   158\u2192        self._disconnect_at = disconnect_at\n   159\u2192        self._disconnected = False\n   160\u2192        self._exhaust_body = True\n   161\u2192\n   162\u2192        self._emitted_empty_chunk_a = False\n   163\u2192        self._emitted_empty_chunk_b = False\n   164\u2192\n   165\u2192    @property\n   166\u2192    def disconnected(self):\n   167\u2192        return self._disconnected or (self._disconnect_at <= time.time())\n   168\u2192\n   169\u2192    def disconnect(self, exhaust_body: Optional[bool] = None):\n   170\u2192        \"\"\"Set the client connection state to disconnected.\n   171\u2192\n   172\u2192        Call this method to simulate an immediate client disconnect and\n   173\u2192        begin emitting ``'http.disconnect'`` events.\n   174\u2192\n   175\u2192        Arguments:\n   176\u2192            exhaust_body (bool): Set to ``False`` in order to\n   177\u2192                begin emitting ``'http.disconnect'`` events without first\n   178\u2192                emitting at least one ``'http.request'`` event.\n   179\u2192        \"\"\"\n   180\u2192\n   181\u2192        if exhaust_body is not None:\n   182\u2192            self._exhaust_body = exhaust_body\n   183\u2192\n   184\u2192        self._disconnected = True\n   185\u2192\n   186\u2192    async def emit(self) -> Dict[str, Any]:\n   187\u2192        # NOTE(kgriffs): Special case: if we are immediately disconnected,\n   188\u2192        #   the first event should be 'http.disconnnect'\n   189\u2192        if self._disconnect_at == 0:\n   190\u2192            return {'type': EventType.HTTP_DISCONNECT}\n   191\u2192\n   192\u2192        #\n   193\u2192        # NOTE(kgriffs): Based on my reading of the ASGI spec, at least one\n   194\u2192        #   'http.request' event should be emitted before 'http.disconnect'\n   195\u2192        #   for normal requests. However, the server may choose to\n   196\u2192        #   immediately abandon a connection for some reason, in which case\n   197\u2192        #   an 'http.request' event may never be sent.\n   198\u2192        #\n   199\u2192        #   See also: https://asgi.readthedocs.io/en/latest/specs/main.html#events\n   200\u2192        #\n   201\u2192        if self._body is None or not self._exhaust_body:\n   202\u2192            # NOTE(kgriffs): When there are no more events, an ASGI\n   203\u2192            #   server will hang until the client connection\n   204\u2192            #   disconnects.\n   205\u2192            while not self.disconnected:\n   206\u2192                await asyncio.sleep(0.001)\n   207\u2192\n   208\u2192            return {'type': EventType.HTTP_DISCONNECT}\n   209\u2192\n   210\u2192        event = {'type': EventType.HTTP_REQUEST}  # type: Dict[str, Any]\n   211\u2192\n   212\u2192        if self._emit_empty_chunks:\n   213\u2192            # NOTE(kgriffs): Return a couple variations on empty chunks\n   214\u2192            #   every time, to ensure test coverage.\n   215\u2192            if not self._emitted_empty_chunk_a:\n   216\u2192                self._emitted_empty_chunk_a = True\n   217\u2192                event['more_body'] = True\n   218\u2192                return event\n   219\u2192\n   220\u2192            if not self._emitted_empty_chunk_b:\n   221\u2192                self._emitted_empty_chunk_b = True\n   222\u2192                event['more_body'] = True\n   223\u2192                event['body'] = b''\n   224\u2192                return event\n   225\u2192\n   226\u2192            # NOTE(kgriffs): Part of the time just return an\n   227\u2192            #   empty chunk to make sure the app handles that\n   228\u2192            #   correctly.\n   229\u2192            if self._toggle_branch('return_empty_chunk'):\n   230\u2192                event['more_body'] = True\n   231\u2192\n   232\u2192                # NOTE(kgriffs): Since ASGI specifies that\n   233\u2192                #   'body' is optional, we toggle whether\n   234\u2192                #   or not to explicitly set it to b'' to ensure\n   235\u2192                #   the app handles both correctly.\n   236\u2192                if self._toggle_branch('explicit_empty_body_1'):\n   237\u2192                    event['body'] = b''\n   238\u2192\n   239\u2192                return event\n   240\u2192\n   241\u2192        chunk = self._body[: self._chunk_size]\n   242\u2192        self._body = self._body[self._chunk_size :] or None\n   243\u2192\n   244\u2192        if chunk:\n   245\u2192            event['body'] = bytes(chunk)\n   246\u2192        elif self._toggle_branch('explicit_empty_body_2'):\n   247\u2192            # NOTE(kgriffs): Since ASGI specifies that\n   248\u2192            #   'body' is optional, we toggle whether\n   249\u2192            #   or not to explicitly set it to b'' to ensure\n   250\u2192            #   the app handles both correctly.\n   251\u2192            event['body'] = b''\n   252\u2192\n   253\u2192        if self._body:\n   254\u2192            event['more_body'] = True\n   255\u2192        elif self._toggle_branch('set_more_body_false'):\n   256\u2192            # NOTE(kgriffs): The ASGI spec allows leaving off\n   257\u2192            #   the 'more_body' key when it would be set to\n   258\u2192            #   False, so toggle one of the approaches\n   259\u2192            #   to make sure the app handles both cases.\n   260\u2192            event['more_body'] = False\n   261\u2192\n   262\u2192        return event\n   263\u2192\n   264\u2192    __call__ = emit\n   265\u2192\n   266\u2192    def _toggle_branch(self, name: str):\n   267\u2192        self._branch_decider[name] = not self._branch_decider[name]\n   268\u2192        return self._branch_decider[name]\n   269\u2192\n   270\u2192\n   271\u2192class ASGIResponseEventCollector:\n   272\u2192    \"\"\"Collects and validates ASGI events returned by an app.\n   273\u2192\n   274\u2192    Attributes:\n   275\u2192        events (iterable): An iterable of events that were emitted by\n   276\u2192            the app, collected as-is from the app.\n   277\u2192        headers (iterable): An iterable of (str, str) tuples representing\n   278\u2192            the ISO-8859-1 decoded headers emitted by the app in the body of\n   279\u2192            the ``'http.response.start'`` event.\n   280\u2192        status (int): HTTP status code emitted by the app in the body of\n   281\u2192            the ``'http.response.start'`` event.\n   282\u2192        body_chunks (iterable): An iterable of ``bytes`` objects emitted\n   283\u2192            by the app via ``'http.response.body'`` events.\n   284\u2192        more_body (bool): Whether or not the app expects to emit more\n   285\u2192            body chunks. Will be ``None`` if unknown (i.e., the app has\n   286\u2192            not yet emitted any ``'http.response.body'`` events.)\n   287\u2192\n   288\u2192    Raises:\n   289\u2192        TypeError: An event field emitted by the app was of an unexpected type.\n   290\u2192        ValueError: Invalid event name or field value.\n   291\u2192    \"\"\"\n   292\u2192\n   293\u2192    _LIFESPAN_EVENT_TYPES = frozenset(\n   294\u2192        [\n   295\u2192            'lifespan.startup.complete',\n   296\u2192            'lifespan.startup.failed',\n   297\u2192            'lifespan.shutdown.complete',\n   298\u2192            'lifespan.shutdown.failed',\n   299\u2192        ]\n   300\u2192    )\n   301\u2192\n   302\u2192    _HEADER_NAME_RE = re.compile(rb'^[a-zA-Z][a-zA-Z0-9\\-_]*$')\n   303\u2192    _BAD_HEADER_VALUE_RE = re.compile(rb'[\\000-\\037]')\n   304\u2192\n   305\u2192    def __init__(self):\n   306\u2192        self.events = []\n   307\u2192        self.headers = []\n   308\u2192        self.status = None\n   309\u2192        self.body_chunks = []\n   310\u2192        self.more_body = None\n   311\u2192\n   312\u2192    async def collect(self, event: Dict[str, Any]):\n   313\u2192        if self.more_body is False:\n   314\u2192            # NOTE(kgriffs): According to the ASGI spec, once we get a\n   315\u2192            #   message setting more_body to False, any further messages\n   316\u2192            #   on the channel are ignored.\n   317\u2192            return\n   318\u2192\n   319\u2192        self.events.append(event)\n   320\u2192\n   321\u2192        event_type = event['type']\n   322\u2192        if not isinstance(event_type, str):\n   323\u2192            raise TypeError('ASGI event type must be a Unicode string')\n   324\u2192\n   325\u2192        if event_type == EventType.HTTP_RESPONSE_START:\n   326\u2192            for name, value in event.get('headers', []):\n   327\u2192                if not isinstance(name, bytes):\n   328\u2192                    raise TypeError('ASGI header names must be byte strings')\n   329\u2192                if not isinstance(value, bytes):\n   330\u2192                    raise TypeError('ASGI header names must be byte strings')\n   331\u2192\n   332\u2192                # NOTE(vytas): Ported basic validation from wsgiref.validate.\n   333\u2192                if not self._HEADER_NAME_RE.match(name):\n   334\u2192                    raise ValueError('Bad header name: {!r}'.format(name))\n   335\u2192                if self._BAD_HEADER_VALUE_RE.search(value):\n   336\u2192                    raise ValueError('Bad header value: {!r}'.format(value))\n   337\u2192\n   338\u2192                # NOTE(vytas): After the name validation above, the name is\n   339\u2192                #   guaranteed to only contain a subset of ASCII.\n   340\u2192                name_decoded = name.decode()\n   341\u2192                if not name_decoded.islower():\n   342\u2192                    raise ValueError('ASGI header names must be lowercase')\n   343\u2192\n   344\u2192                self.headers.append((name_decoded, value.decode('latin1')))\n   345\u2192\n   346\u2192            self.status = event['status']\n   347\u2192\n   348\u2192            if not isinstance(self.status, int):\n   349\u2192                raise TypeError('ASGI status must be an int')\n   350\u2192\n   351\u2192        elif event_type == EventType.HTTP_RESPONSE_BODY:\n   352\u2192            chunk = event.get('body', b'')\n   353\u2192            if not isinstance(chunk, bytes):\n   354\u2192                raise TypeError('ASGI body content must be a byte string')\n   355\u2192\n   356\u2192            self.body_chunks.append(chunk)\n   357\u2192\n   358\u2192            self.more_body = event.get('more_body', False)\n   359\u2192            if not isinstance(self.more_body, bool):\n   360\u2192                raise TypeError('ASGI more_body flag must be a bool')\n   361\u2192\n   362\u2192        elif event_type not in self._LIFESPAN_EVENT_TYPES:\n   363\u2192            raise ValueError('Invalid ASGI event type: ' + event_type)\n   364\u2192\n   365\u2192    __call__ = collect\n   366\u2192\n   367\u2192\n   368\u2192_WebSocketState = Enum('_WebSocketState', 'CONNECT HANDSHAKE ACCEPTED DENIED CLOSED')\n   369\u2192\n   370\u2192\n   371\u2192class ASGIWebSocketSimulator:\n   372\u2192    \"\"\"Simulates a WebSocket client for testing a Falcon ASGI app.\n   373\u2192\n   374\u2192    This class provides a way to test WebSocket endpoints in a Falcon ASGI app\n   375\u2192    without having to interact with an actual ASGI server. While it is certainly\n   376\u2192    important to test against a real server, a number of functional tests can be\n   377\u2192    satisfied more efficiently and transparently with a simulated connection.\n   378\u2192\n   379\u2192    Note:\n   380\u2192\n   381\u2192        The ASGIWebSocketSimulator class is not designed to be instantiated\n   382\u2192        directly; rather it should be obtained via\n   383\u2192        :meth:`~falcon.testing.ASGIConductor.simulate_ws`.\n   384\u2192\n   385\u2192    Attributes:\n   386\u2192        ready (bool): ``True`` if the WebSocket connection has been\n   387\u2192            accepted and the client is still connected, ``False`` otherwise.\n   388\u2192        closed (bool): ``True`` if the WebSocket connection has been\n   389\u2192            denied or closed by the app, or the client has disconnected.\n   390\u2192        close_code (int): The WebSocket close code provided by the app if\n   391\u2192            the connection is closed, or ``None`` if the connection is open.\n   392\u2192        subprotocol (str): The subprotocol the app wishes to accept, or\n   393\u2192            ``None`` if not specified.\n   394\u2192        headers (Iterable[Iterable[bytes]]): An iterable of ``[name, value]``\n   395\u2192            two-item iterables, where *name* is the header name, and *value* is\n   396\u2192            the header value for each header returned by the app when\n   397\u2192            it accepted the WebSocket connection. This property resolves to\n   398\u2192            ``None`` if the connection has not been accepted.\n   399\u2192    \"\"\"\n   400\u2192\n   401\u2192    _DEFAULT_WAIT_READY_TIMEOUT = 5\n   402\u2192\n   403\u2192    def __init__(self):\n   404\u2192        self.__msgpack = None\n   405\u2192\n   406\u2192        self._state = _WebSocketState.CONNECT\n   407\u2192        self._disconnect_emitted = False\n   408\u2192        self._close_code = None\n   409\u2192        self._accepted_subprotocol = None\n   410\u2192        self._accepted_headers = None\n   411\u2192        self._collected_server_events = deque()\n   412\u2192        self._collected_client_events = deque()\n   413\u2192\n   414\u2192        self._event_handshake_complete = asyncio.Event()\n   415\u2192\n   416\u2192    @property\n   417\u2192    def ready(self) -> bool:\n   418\u2192        return self._state == _WebSocketState.ACCEPTED\n   419\u2192\n   420\u2192    @property\n   421\u2192    def closed(self) -> bool:\n   422\u2192        return self._state in {_WebSocketState.DENIED, _WebSocketState.CLOSED}\n   423\u2192\n   424\u2192    @property\n   425\u2192    def close_code(self) -> int:\n   426\u2192        return self._close_code\n   427\u2192\n   428\u2192    @property\n   429\u2192    def subprotocol(self) -> str:\n   430\u2192        return self._accepted_subprotocol\n   431\u2192\n   432\u2192    @property\n   433\u2192    def headers(self) -> Iterable[Iterable[bytes]]:\n   434\u2192        return self._accepted_headers\n   435\u2192\n   436\u2192    async def wait_ready(self, timeout: Optional[int] = None):\n   437\u2192        \"\"\"Wait until the connection has been accepted or denied.\n   438\u2192\n   439\u2192        This coroutine can be awaited in order to pause execution until the\n   440\u2192        app has accepted or denied the connection. In the latter case, an\n   441\u2192        error will be raised to the caller.\n   442\u2192\n   443\u2192        Keyword Args:\n   444\u2192            timeout (int): Number of seconds to wait before giving up and\n   445\u2192                raising an error (default: ``5``).\n   446\u2192        \"\"\"\n   447\u2192\n   448\u2192        timeout = timeout or self._DEFAULT_WAIT_READY_TIMEOUT\n   449\u2192\n   450\u2192        try:\n   451\u2192            await asyncio.wait_for(self._event_handshake_complete.wait(), timeout)\n   452\u2192        except asyncio.TimeoutError:\n   453\u2192            msg = (\n   454\u2192                f'Timed out after waiting {timeout} seconds for the WebSocket '\n   455\u2192                f'handshake to complete. Check the on_websocket responder and '\n   456\u2192                f'any middleware for any conditions that may be stalling the '\n   457\u2192                f'request flow.'\n   458\u2192            )\n   459\u2192            raise asyncio.TimeoutError(msg)\n   460\u2192\n   461\u2192        self._require_accepted()\n   462\u2192\n   463\u2192    # NOTE(kgriffs): This is a coroutine just in case we need it to be\n   464\u2192    #   in a future code revision. It also makes it more consistent\n   465\u2192    #   with the other methods.\n   466\u2192    async def close(self, code: Optional[int] = None):\n   467\u2192        \"\"\"Close the simulated connection.\n   468\u2192\n   469\u2192        Keyword Args:\n   470\u2192            code (int): The WebSocket close code to send to the application\n   471\u2192                per the WebSocket spec (default: ``1000``).\n   472\u2192        \"\"\"\