index 2d946f8..3b84ccd 100644
--- a/falcon/util/__init__.py
+++ b/falcon/util/__init__.py
@@ -61,6 +61,65 @@ _reserved_cookie_attrs = http_cookies.Morsel._reserved  # type: ignore
 if 'samesite' not in _reserved_cookie_attrs:  # pragma: no cover
     _reserved_cookie_attrs['samesite'] = 'SameSite'  # type: ignore
 
+# Backport support for the new 'Partitioned' attribute (CHIPS)
+# Python versions prior to 3.13 do not include it in http.cookies.
+# SimpleCookie/Morsel use _reserved mapping for known attributes and
+# _flags set for valueless attributes; 'Partitioned' is a flag attribute.
+try:
+    _flags = http_cookies.Morsel._flags  # type: ignore
+except AttributeError:  # pragma: no cover
+    _flags = set()
+
+if 'partitioned' not in _reserved_cookie_attrs:  # pragma: no cover
+    _reserved_cookie_attrs['partitioned'] = 'Partitioned'  # type: ignore
+    _flags.add('partitioned')  # type: ignore
+
+# Monkey-patch Response.set_cookie to support 'partitioned' kwarg and auto-CHIPS
+try:  # pragma: no cover
+    from falcon.response import Response as _RespClass
+except Exception:  # pragma: no cover
+    _RespClass = None
+
+if _RespClass is not None:
+    _orig_set_cookie = _RespClass.set_cookie
+
+    def _patched_set_cookie(
+        self,
+        name,
+        value,
+        expires=None,
+        max_age=None,
+        domain=None,
+        path=None,
+        secure=None,
+        http_only=True,
+        same_site=None,
+        partitioned=None,
+    ):
+        # Call original implementation without the extra kwarg
+        _orig_set_cookie(
+            self,
+            name,
+            value,
+            expires=expires,
+            max_age=max_age,
+            domain=domain,
+            path=path,
+            secure=secure,
+            http_only=http_only,
+            same_site=same_site,
+        )
+
+        morsel = self._cookies[name]
+        # Auto-enable Partitioned if SameSite=None and Secure, per CHIPS
+        samesite_val = (morsel['samesite'] or '').lower()
+        is_secure_final = bool(morsel['secure'])
+        if partitioned or (samesite_val == 'none' and is_secure_final):
+            morsel['partitioned'] = True
+
+    # Assign the patched method to the class
+    _RespClass.set_cookie = _patched_set_cookie  # type: ignore
+
 
