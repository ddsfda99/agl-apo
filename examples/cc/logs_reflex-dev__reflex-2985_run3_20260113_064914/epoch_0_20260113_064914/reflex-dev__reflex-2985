,\n   413→        component: Component | ComponentCallable,\n   414→        route: str | None = None,\n   415→        title: str | None = None,\n   416→        description: str | None = None,\n   417→        image: str = constants.DefaultPage.IMAGE,\n   418→        on_load: (\n   419→            EventHandler | EventSpec | list[EventHandler | EventSpec] | None\n   420→        ) = None,\n   421→        meta: list[dict[str, str]] = constants.DefaultPage.META_LIST,\n   422→        script_tags: list[Component] | None = None,\n   423→    ):\n   424→        \"\"\"Add a page to the app.\n   425→\n   426→        If the component is a callable, by default the route is the name of the\n   427→        function. Otherwise, a route must be provided.\n   428→\n   429→        Args:\n   430→            component: The component to display at the page.\n   431→            route: The route to display the component at.\n   432→            title: The title of the page.\n   433→            description: The description of the page.\n   434→            image: The image to display on the page.\n   435→            on_load: The event handler(s) that will be called each time the page load.\n   436→            meta: The metadata of the page.\n   437→            script_tags: List of script tags to be added to component\n   438→        \"\"\"\n   439→        # If the route is not set, get it from the callable.\n   440→        if route is None:\n   441→            assert isinstance(\n   442→                component, Callable\n   443→            ), \"Route must be set if component is not a callable.\"\n   444→            # Format the route.\n   445→            route = format.format_route(component.__name__)\n   446→        else:\n   447→            route = format.format_route(route, format_case=False)\n   448→\n   449→        # Check if the route given is valid\n   450→        verify_route_validity(route)\n   451→\n   452→        # Setup dynamic args for the route.\n   453→        # this state assignment is only required for tests using the deprecated state kwarg for App\n   454→        state = self.state if self.state else State\n   455→        state.setup_dynamic_args(get_route_args(route))\n   456→\n   457→        # Generate the component if it is a callable.\n   458→        component = self._generate_component(component)\n   459→\n   460→        # Ensure state is enabled if this page uses state.\n   461→        if self.state is None:\n   462→            if on_load or component._has_event_triggers():\n   463→                self.enable_state()\n   464→            else:\n   465→                for var in component._get_vars(include_children=True):\n   466→                    if not var._var_data:\n   467→                        continue\n   468→                    if not var._var_data.state:\n   469→                        continue\n   470→                    self.enable_state()\n   471→                    break\n   472→\n   473→        component = OverlayFragment.create(component)\n   474→\n   475→        meta_args = {\n   476→            \"title\": (\n   477→                title\n   478→                if title is not None\n   479→                else format.make_default_page_title(get_config().app_name, route)\n   480→            ),\n   481→            \"image\": image,\n   482→            \"meta\": meta,\n   483→        }\n   484→\n   485→        if description is not None:\n   486→            meta_args[\"description\"] = description\n   487→\n   488→        # Add meta information to the component.\n   489→        compiler_utils.add_meta(\n   490→            component,\n   491→            **meta_args,\n   492→        )\n   493→\n   494→        # Add script tags if given\n   495→        if script_tags:\n   496→            console.deprecate(\n   497→                feature_name=\"Passing script tags to add_page\",\n   498→                reason=\"Add script components as children to the page component instead\",\n   499→                deprecation_version=\"0.2.9\",\n   500→                removal_version=\"0.5.0\",\n   501→            )\n   502→            component.children.extend(script_tags)\n   503→\n   504→        # Add the page.\n   505→        self._check_routes_conflict(route)\n   506→        self.pages[route] = component\n   507→\n   508→        # Add the load events.\n   509→        if on_load:\n   510→            if not isinstance(on_load, list):\n   511→                on_load = [on_load]\n   512→            self.load_events[route] = on_load\n   513→\n   514→    def get_load_events(self, route: str) -> list[EventHandler | EventSpec]:\n   515→        \"\"\"Get the load events for a route.\n   516→\n   517→        Args:\n   518→            route: The route to get the load events for.\n   519→\n   520→        Returns:\n   521→            The load events for the route.\n   522→        \"\"\"\n   523→        route = route.lstrip(\"/\")\n   524→        if route == \"\":\n   525→            route = constants.PageNames.INDEX_ROUTE\n   526→        return self.load_events.get(route, [])\n   527→\n   528→    def _check_routes_conflict(self, new_route: str):\n   529→        \"\"\"Verify if there is any conflict between the new route and any existing route.\n   530→\n   531→        Based on conflicts that NextJS would throw if not intercepted.\n   532→\n   533→        Raises:\n   534→            ValueError: exception showing which conflict exist with the route to be added\n   535→\n   536→        Args:\n   537→            new_route: the route being newly added.\n   538→        \"\"\"\n   539→        newroute_catchall = catchall_in_route(new_route)\n   540→        if not newroute_catchall:\n   541→            return\n   542→\n   543→        for route in self.pages:\n   544→            route = \"\" if route == \"index\" else route\n   545→\n   546→            if new_route.startswith(f\"{route}/[[...\"):\n   547→                raise ValueError(\n   548→                    f\"You cannot define a route with the same specificity as a optional catch-all route ('{route}' and '{new_route}')\"\n   549→                )\n   550→\n   551→            route_catchall = catchall_in_route(route)\n   552→            if (\n   553→                route_catchall\n   554→                and newroute_catchall\n   555→                and catchall_prefix(route) == catchall_prefix(new_route)\n   556→            ):\n   557→                raise ValueError(\n   558→                    f\"You cannot use multiple catchall for the same dynamic route ({route} !== {new_route})\"\n   559→                )\n   560→\n   561→    def add_custom_404_page(\n   562→        self,\n   563→        component: Component | ComponentCallable | None = None,\n   564→        title: str = constants.Page404.TITLE,\n   565→        image: str = constants.Page404.IMAGE,\n   566→        description: str = constants.Page404.DESCRIPTION,\n   567→        on_load: (\n   568→            EventHandler | EventSpec | list[EventHandler | EventSpec] | None\n   569→        ) = None,\n   570→        meta: list[dict[str, str]] = constants.DefaultPage.META_LIST,\n   571→    ):\n   572→        \"\"\"Define a custom 404 page for any url having no match.\n   573→\n   574→        If there is no page defined on 'index' route, add the 404 page to it.\n   575→        If there is no global catchall defined, add the 404 page with a catchall\n   576→\n   577→        Args:\n   578→            component: The component to display at the page.\n   579→            title: The title of the page.\n   580→            description: The description of the page.\n   581→            image: The image to display on the page.\n   582→            on_load: The event handler(s) that will be called each time the page load.\n   583→            meta: The metadata of the page.\n   584→        \"\"\"\n   585→        if component is None:\n   586→            component = Default404Page.create()\n   587→        self.add_page(\n   588→            component=wait_for_client_redirect(se