tants.IS_WINDOWS:\n   834\u2192        console.warn(\n   835\u2192            \"\"\"Windows Subsystem for Linux (WSL) is recommended for improving initial install times.\"\"\"\n   836\u2192        )\n   837\u2192        if sys.version_info >= (3, 12):\n   838\u2192            console.warn(\n   839\u2192                \"Python 3.12 on Windows has known issues with hot reload (reflex-dev/reflex#2335). \"\n   840\u2192                \"Python 3.11 is recommended with this release of Reflex.\"\n   841\u2192            )\n   842\u2192\n   843\u2192\n   844\u2192def is_latest_template() -> bool:\n   845\u2192    \"\"\"Whether the app is using the latest template.\n   846\u2192\n   847\u2192    Returns:\n   848\u2192        Whether the app is using the latest template.\n   849\u2192    \"\"\"\n   850\u2192    if not os.path.exists(constants.Reflex.JSON):\n   851\u2192        return False\n   852\u2192    with open(constants.Reflex.JSON) as f:  # type: ignore\n   853\u2192        app_version = json.load(f)[\"version\"]\n   854\u2192    return app_version == constants.Reflex.VERSION\n   855\u2192\n   856\u2192\n   857\u2192def validate_bun():\n   858\u2192    \"\"\"Validate bun if a custom bun path is specified to ensure the bun version meets requirements.\n   859\u2192\n   860\u2192    Raises:\n   861\u2192        Exit: If custom specified bun does not exist or does not meet requirements.\n   862\u2192    \"\"\"\n   863\u2192    # if a custom bun path is provided, make sure its valid\n   864\u2192    # This is specific to non-FHS OS\n   865\u2192    bun_path = get_config().bun_path\n   866    if bun_path != constants.Bun.DEFAULT_PATH:\n   867\u2192        console.info(f\"Using custom Bun path: {bun_path}\")\n   868\u2192        bun_version = get_bun_version()\n   869\u2192        if not bun_version:\n   870\u2192            console.error(\n   871\u2192                \"Failed to obtain bun version. Make sure the specified bun path in your config is correct.\"\n   872\u2192