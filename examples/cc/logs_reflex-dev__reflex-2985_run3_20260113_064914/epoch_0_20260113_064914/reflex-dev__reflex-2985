  fixed_pages_within_executor = 5\n   764→        progress.start()\n   765→        task = progress.add_task(\n   766→            \"Compiling:\",\n   767→            total=len(self.pages)\n   768→            + fixed_pages_within_executor\n   769→            + adhoc_steps_without_executor,\n   770→        )\n   771→\n   772→        # Get the env mode.\n   773→        config = get_config()\n   774→\n   775→        # Store the compile results.\n   776→        compile_results = []\n   777→\n   778→        # Add the app wrappers.\n   779→        app_wrappers: Dict[tuple[int, str], Component] = {\n   780→            # Default app wrap component renders {children}\n   781→            (0, \"AppWrap\"): AppWrap.create()\n   782→        }\n   783→        if self.theme is not None:\n   784→            # If a theme component was provided, wrap the app with it\n   785→            app_wrappers[(20, \"Theme\")] = self.theme\n   786→\n   787→        progress.advance(task)\n   788→\n   789→        # Fix up the style.\n   790→        self.style = evaluate_style_namespaces(self.style)\n   791→\n   792→        # Track imports and custom components found.\n   793→        all_imports = {}\n   794→        custom_components = set()\n   795→\n   796→        for _route, component in self.pages.items():\n   797→            # Merge the component style with the app style.\n   798→            component.add_style(self.style)\n   799→\n   800→            component.apply_theme(self.theme)\n   801→\n   802→            # Add component.get_imports() to all_imports.\n   803→            all_imports.update(component.get_imports())\n   804→\n   805→            # Add the app wrappers from this component.\n   806→            app_wrappers.update(component.get_app_wrap_components())\n   807→\n   808→            # Add the custom components from the page to the set.\n   809→            custom_components |= component.get_custom_components()\n   810→\n   811→        progress.advance(task)\n   812→\n   813→        