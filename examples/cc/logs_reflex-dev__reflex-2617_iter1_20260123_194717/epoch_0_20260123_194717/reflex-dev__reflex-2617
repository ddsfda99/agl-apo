      order.append(\"blocker\")\n  1551\u2192            await asyncio.sleep(LOCK_EXPIRE_SLEEP)\n  1552\u2192            state.num1 = unexp_num1\n  1553\u2192\n  1554\u2192    async def _coro_waiter():\n  1555\u2192        while \"blocker\" not in order:\n  1556\u2192            await asyncio.sleep(0.005)\n  1557\u2192        async with state_manager_redis.modify_state(token) as state:\n  1558\u2192            order.append(\"waiter\")\n  1559\u2192            assert state.num1 != unexp_num1\n  1560\u2192            state.num1 = exp_num1\n  1561\u2192\n  1562\u2192    tasks = [\n  1563\u2192        asyncio.create_task(_coro_blocker()),\n  1564\u2192        asyncio.create_task(_coro_waiter()),\n  1565\u2192    ]\n  1566\u2192    with pytest.raises(LockExpiredError):\n  1567\u2192        await tasks[0]\n  1568\u2192    await tasks[1]\n  1569\u2192\n  1570\u2192    assert order == [\"blocker\", \"waiter\"]\n  1571\u2192    assert (await state_manager_redis.get_state(token)).num1 == exp_num1\n  1572\u2192\n  1573\u2192\n  1574\u2192@pytest.fixture(scope=\"function\")\n  1575\u2192def mock_app(monkeypatch, state_manager: StateManager) -> rx.App:\n  1576\u2192    \"\"\"Mock app fixture.\n  1577\u2192\n  1578\u2192    Args:\n  1579\u2192        monkeypatch: Pytest monkeypatch object.\n  1580\u2192        state_manager: A state manager.\n  1581\u2192\n  1582\u2192    Returns:\n  1583\u2192        The app, after mocking out prerequisites.get_app()\n  1584\u2192    \"\"\"\n  1585\u2192    app = App(state=TestState)\n  1586\u2192\n  1587\u2192    app_module = Mock()\n  1588\u2192\n  1589\u2192    setattr(app_module, CompileVars.APP, app)\n  1590\u2192    app.state = TestState\n  1591\u2192    app._state_manager = state_manager\n  1592\u2192    app.event_namespace.emit = AsyncMock()  # type: ignore\n  1593\u2192\n  1594\u2192    def _mock_get_app(*args, **kwargs):\n  1595\u2192        return app_module\n  1596\u2192\n  1597\u2192    monkeypatch.setattr(prerequisites, \"get_app\", _mock_get_app)\n  1598\u2192    return app\n  1599\u2192\n  1600\u2192\n  1601\u2192@pytest.mark.asyncio\n  1602\u2192async def test_state_proxy(grandchild_state: GrandchildState, mock_app: rx.App):\n  1603\u2192    \"\"\"Test that the state proxy works.\n  1604\u2192\n  1605\u2192    Args:\n  1606\u2192        grandchild_state: A grandchild state.\n  1607\u2192        mock_app: An app that will be returned by `get_app()`\n  1608\u2192    \"\"\"\n  1609\u2192    child_state = grandchild_state.parent_state\n  1610\u2192    assert child_state is not None\n  1611\u2192    parent_state = child_state.parent_state\n  1612\u2192    assert parent_state is not None\n  1613\u2192    if isinstance(mock_app.state_manager, StateManagerMemory):\n  1614\u2192        mock_app.state_manager.states[parent_state.get_token()] = parent_state\n  1615\u2192\n  1616\u2192    sp = StateProxy(grandchild_state)\n  1617\u2192    assert sp.__wrapped__ == grandchild_state\n  1618\u2192    assert sp._self_substate_path == grandchild_state.get_full_name().split(\".\")\n  1619\u2192    assert sp._self_app is mock_app\n  1620\u2192    assert not sp._self_mutable\n  1621\u2192    assert sp._self_actx is None\n  1622\u2192\n  1623\u2192    # cannot use normal contextmanager protocol\n  1624\u2192    with pytest.raises(TypeError), sp:\n  1625\u2192        pass\n  1626\u2192\n  1627\u2192    with pytest.raises(ImmutableStateError):\n  1628\u2192        # cannot directly modify state proxy outside of async context\n  1629\u2192        sp.value2 = 16\n  1630\u2192\n  1631\u2192    async with sp:\n  1632\u2192        assert sp._self_actx is not None\n  1633\u2192        assert sp._self_mutable  # proxy is mutable inside context\n  1634\u2192        if isinstance(mock_app.state_manager, StateManagerMemory):\n  1635\u2192            # For in-process store, only one instance of the state exists\n  1636\u2192            assert sp.__wrapped__ is grandchild_state\n  1637\u2192        else:\n  1638\u2192            # When redis is used, a new+updated instance is assigned to the proxy\n  1639\u2192            assert sp.__wrapped__ is not grandchild_state\n  1640\u2192        sp.value2 = 42\n  1641\u2192    assert not sp._self_mutable  # proxy is not mutable after exiting context\n  1642\u2192    assert sp._self_actx is None\n  1643\u2192    assert sp.value2 == 42\n  1644\u2192\n  1645\u2192    # Get the state from the state manager directly and check that the value is updated\n  1646\u2192    gotten_state = await mock_app.state_manager.get_state(grandchild_state.get_token())\n  1647\u2192    if isinstance(mock_app.state_manager, StateManagerMemory):\n  1648\u2192        # For in-process store, only one instance of the state exists\n  1649\u2192        assert gotten_state is parent_state\n  1650\u2192    else:\n  1651\u2192        assert gotten_state is not parent_state\n  1652\u2192    gotten_grandchild_state = gotten_state.get_substate(sp._self_substate_path)\n  1653\u2192    assert gotten_grandchild_state is not None\n  1654\u2192    assert gotten_grandchild_state.value2 == 42\n  1655\u2192\n  1656\u2192    # ensure state update was emitted\n  1657\u2192    assert mock_app.event_namespace is not None\n  1658\u2192    mock_app.event_namespace.emit.assert_called_once()\n  1659\u2192    mcall = mock_app.event_namespace.emit.mock_calls[0]\n  1660\u2192    assert mcall.args[0] == str(SocketEvent.EVENT)\n  1661\u2192    assert json.loads(mcall.args[1]) == StateUpdate(\n  1662\u2192        delta={\n  1663\u2192            parent_state.get_full_name(): {\n  1664\u2192                \"upper\": \"\",\n  1665\u2192                \"sum\": 3.14,\n  1666\u2192            },\n  1667\u2192            grandchild_state.get_full_name(): {\n  1668\u2192                \"value2\": 42,\n  1669\u2192            },\n  1670\u2192        }\n  1671\u2192    )\n  1672\u2192    assert mcall.kwargs[\"to\"] == grandchild_state.get_sid()\n  1673\u2192\n  1674\u2192\n  1675\u2192class BackgroundTaskState(BaseState):\n  1676\u2192    \"\"\"A state with a background task.\"\"\"\n  1677\u2192\n  1678\u2192    order: List[str] = []\n  1679\u2192    dict_list: Dict[str, List[int]] = {\"foo\": [1, 2, 3]}\n  1680\u2192\n  1681\u2192    @rx.var\n  1682\u2192    def computed_order(self) -> List[str]:\n  1683\u2192        \"\"\"Get the order as a computed var.\n  1684\u2192\n  1685\u2192        Returns:\n  1686\u2192            The value of 'order' var.\n  1687\u2192        \"\"\"\n  1688\u2192        return self.order\n  1689\u2192\n  1690\u2192    @rx.background\n  1691\u2192    async def background_task(self):\n  1692\u2192        \"\"\"A background task that updates the state.\"\"\"\n  1693\u2192        async with self:\n  1694\u2192            assert not self.order\n  1695\u2192            self.order.append(\"background_task:start\")\n  1696\u2192\n  1697\u2192        assert isinstance(self, StateProxy)\n  1698\u2192        with pytest.raises(ImmutableStateError):\n  1699\u2192            self.order.append(\"bad idea\")\n  1700\u2192\n  1701\u2192        with pytest.raises(ImmutableStateError):\n  1702\u2192            # Even nested access to mutables raises an exception.\n  1703\u2192            self.dict_list[\"foo\"].append(42)\n  1704\u2192\n  1705\u2192        with pytest.raises(ImmutableStateError):\n  1706\u2192            # Direct calling another handler that modifies state raises an exception.\n  1707\u2192            self.other()\n  1708\u2192\n  1709\u2192        with pytest.raises(ImmutableStateError):\n  1710\u2192            # Calling other methods that modify state raises an exception.\n  1711\u2192            self._private_method()\n  1712\u2192\n  1713\u2192        # wait for some other event to happen\n  1714\u2192        while len(self.order) == 1:\n  1715\u2192            await asyncio.sleep(0.01)\n  1716\u2192            async with self:\n  1717\u2192                pass  # update proxy instance\n  1718\u2192\n  1719\u2192        async with self:\n  1720\u2192            # Methods on ImmutableMutableProxy should return their wrapped return value.\n  1721\u2192            assert self.dict_list.pop(\"foo\") == [1, 2, 3]\n  1722\u2192\n  1723\u2192            self.order.append(\"background_task:stop\")\n  1724\u2192            self.other()  # direct calling event handlers works in context\n  1725\u2192            self._private_method()\n  1726\u2192\n  1727\u2192    @rx.background\n  1728\u2192    async def background_task_reset(self):\n  1729\u2192        \"\"\"A background task that resets the state.\"\"\"\n  1730\u2192        with pytest.raises(ImmutableStateError):\n  1731\u2192            # Resetting the state should be explicitly blocked.\n  1732\u2192            self.reset()\n  1733\u2192\n  1734\u2192        async with self:\n  1735\u2192            self.order.append(\"foo\")\n  1736\u2192            self.reset()\n  1737\u2192        assert not self.order\n  1738\u2192        async with self:\n  1739\u2192            self.order.append(\"reset\")\n  1740\u2192\n  1741\u2192    @rx.background\n  1742\u2192    async def background_task_generator(self):\n  1743\u2192        \"\"\"A background task generator that does nothing.\n  1744\u2192\n  1745\u2192        Yields:\n  1746\u2192            None\n  1747\u2192        \"\"\"\n  1748\u2192        yield\n  1749\u2192\n  1750\u2192    def other(self):\n  1751\u2192        \"\"\"Some other event that updates the state.\"\"\"\n  1752\u2192        self.order.append(\"other\")\n  1753\u2192\n  1754\u2192    def _private_method(self):\n  1755\u2192        \"\"\"Some private method that updates the state.\"\"\"\n  1756\u2192        self.order.append(\"private\")\n  1757\u2192\n  1758\u2192    async def bad_chain1(self):\n  1759\u2192        \"\"\"Test that a background task cannot be chained.\"\"\"\n  1760\u2192        await self.background_task()\n  1761\u2192\n  1762\u2192    async def bad_chain2(self):\n  1763\u2192        \"\"\"Test that a background task generator cannot be chained.\"\"\"\n  1764\u2192        async for _foo in self.background_task_generator():\n  1765\u2192            pass\n  1766\u2192\n  1767\u2192\n  1768\u2192@pytest.mark.asyncio\n  1769\u2192async def test_background_task_no_block(mock_app: rx.App, token: str):\n  1770\u2192    \"\"\"Test that a background task does not block other events.\n  1771\u2192\n  1772\u2192    Args:\n  1773\u2192        mock_app: An app that will be returned by `get_app()`\n  1774\u2192        token: A token.\n  1775\u2192    \"\"\"\n  1776\u2192    router_data = {\"query\": {}}\n  1777\u2192    mock_app.state_manager.state = mock_app.state = BackgroundTaskState\n  1778\u2192    async for update in rx.app.process(  # type: ignore\n  1779\u2192        mock_app,\n  1780\u2192        Event(\n  1781\u2192            token=token,\n  1782\u2192            name=f\"{BackgroundTaskState.get_name()}.background_task\",\n  1783\u2192            router_data=router_data,\n  1784\u2192            payload={},\n  1785\u2192        ),\n  1786\u2192        sid=\"\",\n  1787\u2192        headers={},\n  1788\u2192        client_ip=\"\",\n  1789\u2192    ):\n  1790\u2192        # background task returns empty update immediately\n  1791\u2192        assert update == StateUpdate()\n  1792\u2192\n  1793\u2192    # wait for the coroutine to start\n  1794\u2192    await asyncio.sleep(0.5 if CI else 0.1)\n  1795\u2192    assert len(mock_app.background_tasks) == 1\n  1796\u2192\n  1797\u2192    # Process another normal event\n  1798\u2192    async for update in rx.app.process(  # type: ignore\n  1799\u2192        mock_app,\n  1800\u2192        Event(\n  1801\u2192            token=token,\n  1802\u2192            name=f\"{BackgroundTaskState.get_name()}.other\",\n  1803\u2192            router_data=router_data,\n  1804\u2192            payload={},\n  1805\u2192        ),\n  1806\u2192        sid=\"\",\n  1807\u2192        headers={},\n  1808\u2192        client_ip=\"\",\n  1809\u2192    ):\n  1810\u2192        # other task returns delta\n  1811\u2192        assert update == StateUpdate(\n  1812            delta={\n  1813\u2192                BackgroundTaskState.get_name(): {\n  1814\u2192                    \"order\": [\n  1815\u2192                        \"background_task:start\",\n  1816\u2192                        \"other\",\n  1817\u2192                    ],\n  1818\u2192                    \"computed_order\": [\n  1819\u2192                        \"background_task:start\",\n  1820\u2192                        \"other\",\n  1821\u2192                    ],\n  1822\u2192                }\n  1823\u2192            }\n  1824\u2192        )\n  1825\u2192\n  1826\u2192    # Explicit wait for background tasks\n  1827\u2192    for task in tuple(mock_app.background_tasks):\n  1828\u2192        await task\n  1829\u2192    assert not mock_app.background_tasks\n  1830\u2192\n  1831\u2192    exp_order = [\n  1832\u2192        \"background_task:start\",\n  1833\u2192        \"other\",\n  1834\u2192        \"background_task:stop\",\n  1835\u2192        \"other\",\n  1836\u2192        \"private\",\n  1837\u2192    ]\n  1838\u2192\n  1839\u2192    assert (await mock_app.state_manager.get_state(token)).order == exp_order\n  1840\u2192\n  1841\u2192    assert mock_app.event_namespace is not None\n  1842\u2192    emit_mock = mock_app.event_namespace.emit\n  1843\u2192\n  1844\u2192    first_ws_message = json.loads(emit_mock.mock_calls[0].args[1])\n  1845\u2192    assert first_ws_message[\"delta\"][\"background_task_state\"].pop(\"router\") is not None\n  1846\u2192    assert first_ws_message == {\n  1847\u2192        \"delta\": {\n  1848\u2192            \"background_task_state\": {\n  1849\u2192                \"order\": [\"background_task:start\"],\n  1850\u2192                \"computed_order\": [\"background_task:start\"],\n  1851\u2192            }\n  1852\u2192        },\n  1853\u2192        \"events\": [],\n  1854\u2192        \"final\": True,\n  1855\u2192    }\n  1856\u2192    for call in emit_mock.mock_calls[1:5]:\n  1857\u2192        assert json.loads(call.args[1]) == {\n  1858\u2192            \"delta\": {\n  1859\u2192                \"background_task_state\": {\"computed_order\": [\"background_task:start\"]}\n  1860\u2192            },\n  1861\u2192            \"events\": [],\n  1862\u2192            \"final\": True,\n  1863\u2192        }\n  1864\u2192    assert json.loads(emit_mock.mock_calls[-2].args[1]) == {\n  1865\u2192        \"delta\": {\n  1866\u2192            \"background_task_state\": {\n  1867\u2192                \"order\": exp_order,\n  1868\u2192                \"computed_order\": exp_order,\n  1869\u2192                \"dict_list\": {},\n  1870\u2192            }\n  1871\u2192        },\n  1872\u2192        \"events\": [],\n  1873\u2192        \"final\": True,\n  1874\u2192    }\n  1875\u2192    assert json.loads(emit_mock.mock_calls[-1].args[1]) == {\n  1876\u2192        \"delta\": {\n  1877\u2192            \"background_task_state\": {\n  1878\u2192                \"computed_order\": exp_order,\n  1879\u2192            },\n  1880\u2192        },\n  1881\u2192        \"events\": [],\n  1882\u2192        \"final\": True,\n  1883\u2192    }\n  1884\u2192\n  1885\u2192\n  1886\u2192@pytest.mark.asyncio\n  1887\u2192async def test_background_task_reset(mock_app: rx.App, token: str):\n  1888\u2192    \"\"\"Test that a background task calling reset is protected by the state proxy.\n  1889\u2192\n  1890\u2192    Args:\n  1891\u2192        mock_app: An app that will be returned by `get_app()`\n  1892\u2192        token: A token.\n  1893\u2192    \"\"\"\n  1894\u2192    router_data = {\"query\": {}}\n  1895\u2192    mock_app.state_manager.state = mock_app.state = BackgroundTaskState\n  1896\u2192    async for update in rx.app.process(  # type: ignore\n  1897\u2192        mock_app,\n  1898\u2192        Event(\n  1899\u2192            token=token,\n  1900\u2192            name=f\"{BackgroundTaskState.get_name()}.background_task_reset\",\n  1901\u2192            router_data=router_data,\n  1902\u2192            payload={},\n  1903\u2192        ),\n  1904\u2192        sid=\"\",\n  1905\u2192        headers={},\n  1906\u2192        client_ip=\"\",\n  1907\u2192    ):\n  1908\u2192        # background task returns empty update immediately\n  1909\u2192        assert update == StateUpdate()\n  1910\u2192\n  1911\u2192    # Explicit wait for background tasks\n  1912\u2192    for task in tuple(mock_app.background_tasks):\n  1913\u2192        await task\n  1914\u2192    assert not mock_app.background_tasks\n  1915\u2192\n  1916\u2192    assert (await mock_app.state_manager.get_state(token)).order == [\n  1917\u2192        \"reset\",\n  1918\u2192    ]\n  1919\u2192\n  1920\u2192\n  1921\u2192@pytest.mark.asyncio\n  1922\u2192async def test_background_task_no_chain():\n  1923\u2192    \"\"\"Test that a background task cannot be chained.\"\"\"\n  1924\u2192    bts = BackgroundTaskState()\n  1925\u2192    with pytest.raises(RuntimeError):\n  1926\u2192        await bts.bad_chain1()\n  1927\u2192    with pytest.raises(RuntimeError):\n  1928\u2192        await bts.bad_chain2()\n  1929\u2192\n  1930\u2192\n  1931\u2192def test_mutable_list(mutable_state):\n  1932\u2192    \"\"\"Test that mutable lists are tracked correctly.\n  1933\u2192\n  1934\u2192    Args:\n  1935\u2192        mutable_state: A test state.\n  1936\u2192    \"\"\"\n  1937\u2192    assert not mutable_state.dirty_vars\n  1938\u2192\n  1939\u2192    def assert_array_dirty():\n  1940\u2192        assert mutable_state.dirty_vars == {\"array\"}\n  1941\u2192        mutable_state._clean()\n  1942\u2192        assert not mutable_state.dirty_vars\n  1943\u2192\n  1944\u2192    # Test all list operations\n  1945\u2192    mutable_state.array.append(42)\n  1946\u2192    assert_array_dirty()\n  1947\u2192    mutable_state.array.extend([1, 2, 3])\n  1948\u2192    assert_array_dirty()\n  1949\u2192    mutable_state.array.insert(0, 0)\n  1950\u2192    assert_array_dirty()\n  1951\u2192    mutable_state.array.pop()\n  1952\u2192    assert_array_dirty()\n  1953\u2192    mutable_state.array.remove(42)\n  1954\u2192    assert_array_dirty()\n  1955\u2192    mutable_state.array.clear()\n  1956\u2192    assert_array_dirty()\n  1957\u2192    mutable_state.array += [1, 2, 3]\n  1958\u2192    assert_array_dirty()\n  1959\u2192    mutable_state.array.reverse()\n  1960\u2192    assert_array_dirty()\n  1961\u2192    mutable_state.array.sort()\n  1962\u2192    assert_array_dirty()\n  1963\u2192    mutable_state.array[0] = 666\n  1964\u2192    assert_array_dirty()\n  1965\u2192    del mutable_state.array[0]\n  1966\u2192    assert_array_dirty()\n  1967\u2192\n  1968\u2192    # Test nested list operations\n  1969\u2192    mutable_state.array[0] = [1, 2, 3]\n  1970\u2192    assert_array_dirty()\n  1971\u2192    mutable_state.array[0].append(4)\n  1972\u2192    assert_array_dirty()\n  1973\u2192    assert isinstance(mutable_state.array[0], MutableProxy)\n  1974\u2192\n  1975\u2192    # Test proxy returned from __iter__\n  1976\u2192    mutable_state.array = [{}]\n  1977\u2192    assert_array_dirty()\n  1978\u2192    assert isinstance(mutable_state.array[0], MutableProxy)\n  1979\u2192    for item in mutable_state.array:\n  1980\u2192        assert isinstance(item, MutableProxy)\n  1981\u2192        item[\"foo\"] = \"bar\"\n  1982\u2192        assert_array_dirty()\n  1983\u2192\n  1984\u2192\n  1985\u2192def test_mutable_dict(mutable_state):\n  1986\u2192    \"\"\"Test that mutable dicts are tracked correctly.\n  1987\u2192\n  1988\u2192    Args:\n  1989\u2192        mutable_state: A test state.\n  1990\u2192    \"\"\"\n  1991\u2192    assert not mutable_state.dirty_vars\n  1992\u2192\n  1993\u2192    def assert_hashmap_dirty():\n  1994\u2192        assert mutable_state.dirty_vars == {\"hashmap\"}\n  1995\u2192        mutable_state._clean()\n  1996\u2192        assert not mutable_state.dirty_vars\n  1997\u2192\n  1998\u2192    # Test all dict operations\n  1999\u2192    mutable_state.hashmap.update({\"new_key\": 43})\n  2000\u2192    assert_hashmap_dirty()\n  2001\u2192    assert mutable_state.hashmap.setdefault(\"another_key\", 66) == \"another_value\"\n  2002\u2192    assert_hashmap_dirty()\n  2003\u2192    assert mutable_state.hashmap.setdefault(\"setdefault_key\", 67) == 67\n  2004\u2192    assert_hashmap_dirty()\n  2005\u2192    assert mutable_state.hashmap.setdefault(\"setdefault_key\", 68) == 67\n  2006\u2192    assert_hashmap_dirty()\n  2007\u2192    assert mutable_state.hashmap.pop(\"new_key\") == 43\n  2008\u2192    assert_hashmap_dirty()\n  2009\u2192    mutable_state.hashmap.popitem()\n  2010\u2192    assert_hashmap_dirty()\n  2011\u2192    mutable_state.hashmap.clear()\n  2012\u2192    assert_hashmap_dirty()\n  2013\u2192    mutable_state.hashmap[\"new_key\"] = 42\n  2014    assert_hashmap_dirty()\n  2015\u2192    del mutable_state.hashmap[\"new_key\"]\n  2016\u2192    assert_hashmap_dirty()\n  2017\u2192    if sys.version_info >= (3, 9):\n  2018\u2192        mutable_state.hashmap |= {\"new_key\": 44}\n  2019\u2192        assert_hashmap_dirty()\n  2020\u2192\n  2021\u2192    # Test nested dict operations\n  2022\u2192    mutable_state.hashmap[\"array\"] = []\n  2023\u2192    assert_hashmap_dirty()\n  2024\u2192    mutable_state.hashmap[\"array\"].append(1)\n  2025\u2192    assert_hashmap_dirty()\n  2026\u2192    mutable_state.hashmap[\"dict\"] = {}\n  2027\u2192    assert_hashmap_dirty()\n  2028\u2192    mutable_state.hashmap[\"dict\"][\"key\"] = 42\n  2029\u2192    assert_hashmap_dirty()\n  2030\u2192    mutable_state.hashmap[\"dict\"][\"dict\"] = {}\n  2031\u2192    assert_hashmap_dirty()\n  2032\u2192    mutable_state.hashmap[\"dict\"][\"dict\"][\"key\"] = 43\n  2033\u2192    assert_hashmap_dirty()\n  2034\u2192\n  2035\u2192    # Test proxy returned from `setdefault` and `get`\n  2036\u2192    mutable_value = mutable_state.hashmap.setdefault(\"setdefault_mutable_key\", [])\n  2037\u2192    assert_hashmap_dirty()\n  2038\u2192    assert mutable_value == []\n  2039\u2192    assert isinstance(mutable_value, MutableProxy)\n  2040\u2192    mutable_value.append(\"foo\")\n  2041\u2192    assert_hashmap_dirty()\n  2042\u2192    mutable_value_other_ref = mutable_state.hashmap.get(\"setdefault_mutable_key\")\n  2043\u2192    assert isinstance(mutable_value_other_ref, MutableProxy)\n  2044\u2192    assert mutable_value is not mutable_value_other_ref\n  2045\u2192    assert mutable_value == mutable_value_other_ref\n  2046\u2192    assert not mutable_state.dirty_vars\n  2047\u2192    mutable_value_other_ref.append(\"bar\")\n  2048\u2192    assert_hashmap_dirty()\n  2049\u2192\n  2050\u2192    # `pop` should NOT return a proxy, because the returned value is no longer in the dict\n  2051\u2192    mutable_value_third_ref = mutable_state.hashmap.pop(\"setdefault_mutable_key\")\n  2052\u2192    assert not isinstance(mutable_value_third_ref, MutableProxy)\n  2053\u2192    assert_hashmap_dirty()\n  2054\u2192    mutable_value_third_ref.append(\"baz\")\n  2055\u2192    assert not mutable_state.dirty_vars\n  2056\u2192    # Unfortunately previous refs still will mark the state dirty... nothing doing about that\n  2057\u2192    assert mutable_value.pop()\n  2058\u2192    assert_hashmap_dirty()\n  2059\u2192\n  2060\u2192\n  2061\u2192def test_mutable_set(mutable_state):\n  2062\u2192    \"\"\"Test that mutable sets are tracked correctly.\n  2063\u2192\n  2064\u2192    Args:\n  2065\u2192        mutable_state: A test state.\n  2066\u2192    \"\"\"\n  2067\u2192    assert not mutable_state.dirty_vars\n  2068\u2192\n  2069\u2192    def assert_set_dirty():\n  2070\u2192        assert mutable_state.dirty_vars == {\"test_set\"}\n  2071\u2192        mutable_state._clean()\n  2072\u2192        assert not mutable_state.dirty_vars\n  2073\u2192\n  2074\u2192    # Test all set operations\n  2075\u2192    mutable_state.test_set.add(42)\n  2076\u2192    assert_set_dirty()\n  2077\u2192    mutable_state.test_set.update([1, 2, 3])\n  2078\u2192    assert_set_dirty()\n  2079\u2192    mutable_state.test_set.remove(42)\n  2080\u2192    assert_set_dirty()\n  2081\u2192    mutable_state.test_set.discard(3)\n  2082\u2192    assert_set_dirty()\n  2083\u2192    mutable_state.test_set.pop()\n  2084\u2192    assert_set_dirty()\n  2085\u2192    mutable_state.test_set.intersection_update([1, 2, 3])\n  2086\u2192    assert_set_dirty()\n  2087\u2192    mutable_state.test_set.difference_update([99])\n  2088\u2192    assert_set_dirty()\n  2089\u2192    mutable_state.test_set.symmetric_difference_update([102, 99])\n  2090\u2192    assert_set_dirty()\n  2091\u2192    mutable_state.test_set |= {1, 2, 3}\n  2092\u2192    assert_set_dirty()\n  2093\u2192    mutable_state.test_set &= {2, 3, 4}\n  2094\u2192    assert_set_dirty()\n  2095\u2192    mutable_state.test_set -= {2}\n  2096\u2192    assert_set_dirty()\n  2097\u2192    mutable_state.test_set ^= {42}\n  2098\u2192    assert_set_dirty()\n  2099\u2192    mutable_state.test_set.clear()\n  2100\u2192    assert_set_dirty()\n  2101\u2192\n  2102\u2192\n  2103\u2192def test_mutable_custom(mutable_state):\n  2104\u2192    \"\"\"Test that mutable custom types derived from Base are tracked correctly.\n  2105\u2192\n  2106\u2192    Args:\n  2107\u2192        mutable_state: A test state.\n  2108\u2192    \"\"\"\n  2109\u2192    assert not mutable_state.dirty_vars\n  2110\u2192\n  2111\u2192    def assert_custom_dirty():\n  2112\u2192        assert mutable_state.dirty_vars == {\"custom\"}\n  2113\u2192        mutable_state._clean()\n  2114\u2192        assert not mutable_state.dirty_vars\n  2115\u2192\n  2116\u2192    mutable_state.custom.foo = \"bar\"\n  2117\u2192    assert_custom_dirty()\n  2118\u2192    mutable_state.custom.array.append(42)\n  2119\u2192    assert_custom_dirty()\n  2120\u2192    mutable_state.custom.hashmap[\"key\"] = 68\n  2121\u2192    assert_custom_dirty()\n  2122\u2192    mutable_state.custom.test_set.add(42)\n  2123\u2192    assert_custom_dirty()\n  2124\u2192    mutable_state.custom.custom.bar = \"baz\"\n  2125\u2192    assert_custom_dirty()\n  2126\u2192\n  2127\u2192\n  2128\u2192def test_mutable_backend(mutable_state):\n  2129\u2192    \"\"\"Test that mutable backend vars are tracked correctly.\n  2130\u2192\n  2131\u2192    Args:\n  2132\u2192        mutable_state: A test state.\n  2133\u2192    \"\"\"\n  2134\u2192    assert not mutable_state.dirty_vars\n  2135\u2192\n  2136\u2192    def assert_custom_dirty():\n  2137\u2192        assert mutable_state.dirty_vars == {\"_be_custom\"}\n  2138\u2192        mutable_state._clean()\n  2139\u2192        assert not mutable_state.dirty_vars\n  2140\u2192\n  2141\u2192    mutable_state._be_custom.foo = \"bar\"\n  2142\u2192    assert_custom_dirty()\n  2143\u2192    mutable_state._be_custom.array.append(42)\n  2144\u2192    assert_custom_dirty()\n  2145\u2192    mutable_state._be_custom.hashmap[\"key\"] = 68\n  2146\u2192    assert_custom_dirty()\n  2147\u2192    mutable_state._be_custom.test_set.add(42)\n  2148\u2192    assert_custom_dirty()\n  2149\u2192    mutable_state._be_custom.custom.bar = \"baz\"\n  2150\u2192    assert_custom_dirty()\n  2151\u2192\n  2152\u2192\n  2153\u2192@pytest.mark.parametrize(\n  2154\u2192    (\"copy_func\",),\n  2155\u2192    [\n  2156\u2192        (copy.copy,),\n  2157\u2192        (copy.deepcopy,),\n  2158\u2192    ],\n  2159\u2192)\n  2160\u2192def test_mutable_copy(mutable_state, copy_func):\n  2161\u2192    \"\"\"Test that mutable types are copied correctly.\n  2162\u2192\n  2163\u2192    Args:\n  2164\u2192        mutable_state: A test state.\n  2165\u2192        copy_func: A copy function.\n  2166\u2192    \"\"\"\n  2167\u2192    ms_copy = copy_func(mutable_state)\n  2168\u2192    assert ms_copy is not mutable_state\n  2169\u2192    for attr in (\"array\", \"hashmap\", \"test_set\", \"custom\"):\n  2170\u2192        assert getattr(ms_copy, attr) == getattr(mutable_state, attr)\n  2171\u2192        assert getattr(ms_copy, attr) is not getattr(mutable_state, attr)\n  2172\u2192    ms_copy.custom.array.append(42)\n  2173\u2192    assert \"custom\" in ms_copy.dirty_vars\n  2174\u2192    if copy_func is copy.copy:\n  2175\u2192        assert \"custom\" in mutable_state.dirty_vars\n  2176\u2192    else:\n  2177\u2192        assert not mutable_state.dirty_vars\n  2178\u2192\n  2179\u2192\n  2180\u2192@pytest.mark.parametrize(\n  2181\u2192    (\"copy_func\",),\n  2182\u2192    [\n  2183\u2192        (copy.copy,),\n  2184\u2192        (copy.deepcopy,),\n  2185\u2192    ],\n  2186\u2192)\n  2187\u2192def test_mutable_copy_vars(mutable_state, copy_func):\n  2188\u2192    \"\"\"Test that mutable types are copied correctly.\n  2189\u2192\n  2190\u2192    Args:\n  2191\u2192        mutable_state: A test state.\n  2192\u2192        copy_func: A copy function.\n  2193\u2192    \"\"\"\n  2194\u2192    for attr in (\"array\", \"hashmap\", \"test_set\", \"custom\"):\n  2195\u2192        var_orig = getattr(mutable_state, attr)\n  2196\u2192        var_copy = copy_func(var_orig)\n  2197\u2192        assert var_orig is not var_copy\n  2198\u2192        assert var_orig == var_copy\n  2199\u2192        # copied vars should never be proxies, as they by definition are no longer attached to the state.\n  2200\u2192        assert not isinstance(var_copy, MutableProxy)\n  2201\u2192\n  2202\u2192\n  2203\u2192def test_duplicate_substate_class(mocker):\n  2204\u2192    mocker.patch(\"reflex.state.os.environ\", {})\n  2205\u2192    with pytest.raises(ValueError):\n  2206\u2192\n  2207\u2192        class TestState(BaseState):\n  2208\u2192            pass\n  2209\u2192\n  2210\u2192        class ChildTestState(TestState):  # type: ignore # noqa\n  2211\u2192            pass\n  2212\u2192\n  2213\u2192        class ChildTestState(TestState):  # type: ignore # noqa\n  2214\u2192            pass\n  2215\u2192\n  2216\u2192        return Tes