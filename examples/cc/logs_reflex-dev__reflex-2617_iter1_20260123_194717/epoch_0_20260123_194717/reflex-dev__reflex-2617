]:\n  1683→        \"\"\"Get the order as a computed var.\n  1684→\n  1685→        Returns:\n  1686→            The value of 'order' var.\n  1687→        \"\"\"\n  1688→        return self.order\n  1689→\n  1690→    @rx.background\n  1691→    async def background_task(self):\n  1692→        \"\"\"A background task that updates the state.\"\"\"\n  1693→        async with self:\n  1694→            assert not self.order\n  1695→            self.order.append(\"background_task:start\")\n  1696→\n  1697→        assert isinstance(self, StateProxy)\n  1698→        with pytest.raises(ImmutableStateError):\n  1699→            self.order.append(\"bad idea\")\n  1700→\n  1701→        with pytest.raises(ImmutableStateError):\n  1702→            # Even nested access to mutables raises an exception.\n  1703→            self.dict_list[\"foo\"].append(42)\n  1704→\n  1705→        with pytest.raises(ImmutableStateError):\n  1706→            # Direct calling another handler that modifies state raises an exception.\n  1707→            self.other()\n  1708→\n  1709→        with pytest.raises(ImmutableStateError):\n  1710→            # Calling other methods that modify state raises an exception.\n  1711→            self._private_method()\n  1712→\n  1713→        # wait for some other event to happen\n  1714→        while len(self.order) == 1:\n  1715→            await asyncio.sleep(0.01)\n  1716→            async with self:\n  1717→                pass  # update proxy instance\n  1718→\n  1719→        async with self:\n  1720→            # Methods on ImmutableMutableProxy should return their wrapped return value.\n  1721→            assert self.dict_list.pop(\"foo\") == [1, 2, 3]\n  1722→\n  1723→            self.order.append(\"background_task:stop\")\n  1724→            self.other()  # direct calling event handlers works in context\n  1725→            self._private_method()\n  1726→\n  1727→    @rx.background\n  1728→    async def background_task_reset(self):\n  1729→        \"\"\"A background task that resets the state.\"\"\"\n  1730→        with pytest.raises(ImmutableStateError):\n  1731→            # Resetting the state should be explicitly blocked.\n  1732→            self.reset()\n  1733→\n  1734→        async with self:\n  1735→            self.order.append(\"foo\")\n  1736→            self.reset()\n  1737→        assert not self.order\n  1738→        async with self:\n  1739→            self.order.append(\"reset\")\n  1740→\n  1741→    @rx.background\n  1742→    async def background_task_generator(self):\n  1743→        \"\"\"A background task generator that does nothing.\n  1744→\n  1745→        Yields:\n  1746→            None\n  1747→        \"\"\"\n  1748→        yield\n  1749→\n  1750→    def other(self):\n  1751→        \"\"\"Some other event that updates the state.\"\"\"\n  1752→        self.order.append(\"other\")\n  1753→\n  1754→    def _private_method(self):\n  1755→        \"\"\"Some private method that updates the state.\"\"\"\n  1756→        self.order.append(\"private\")\n  1757→\n  1758→    async def bad_chain1(self):\n  1759→        \"\"\"Test that a background task cannot be chained.\"\"\"\n  1760→        await self.background_task()\n  1761→\n  1762→    async def bad_chain2(self):\n  1763→        \"\"\"Test that a background task generator cannot be chained.\"\"\"\n  1764→        async for _foo in self.background_task_generator():\n  1765→            pass\n  1766→\n  1767→\n  1768→@pytest.mark.asyncio\n  1769→async def test_background_task_no_block(mock_app: rx.App, token: str):\n  1770→    \"\"\"Test that a background task does not block other events.\n  1771→\n  1772→    Args:\n  1773→        mock_app: An app that will be returned by `get_app()`\n  1774→        token: A token.\n  1775→    \"\"\"\n  1776→    router_data = {\"query\": {}}\n  1777→    mock_app.state_manager.state = mock_app.state = BackgroundTaskState\n  1778→    async for update in rx.app.process(  # type: ignore\n  1779→        mock_app,\n  1780→        Event(\n  1781→            token=token,\n  1782→            name=f\"{BackgroundTaskState.get_name()}.background_task\",\n  1783→            router_data=router_data,\n  1784→            payload={},\n  1785→        ),\n  1786→        sid=\"\",\n  1787→        headers={},\n  1788→        client_ip=\"\",\n  1789→    ):\n  1790→        # background task returns empty update immediately\n  1791→        assert update == StateUpdate()\n  1792→\n  1793→    # wait for the coroutine to start\n  1794→    await asyncio.sleep(0.5 if CI else 0.1)\n  1795→    assert len(mock_app.background_tasks) == 1\n  1796→\n  1797→    # Process another normal event\n  1798→    async for update in rx.app.process(  # type: ignore\n  1799→        mock_app,\n  1800→        Event(\n  1801→            token=token,\n  1802→            name=f\"{BackgroundTaskState.get_name()}.other\",\n  1803→            router_data=router_data,\n  1804→            payload={},\n  1805→        ),\n  1806→        sid=\"\",\n  1807→        headers={},\n  1808→        client_ip=\"\",\n  1809→    ):\n  1810→        # other task returns delta\n  1811→        assert update == StateUpdate(\n  1812            delta={\n  1813→                BackgroundTaskState.get_name(): {\n  1814→                    \"order\": [\n  1815→                        \"background_task:start\",\n  1816→                        \"other\",\n  1817→                    ],\n  1818→                    \"computed_order\": [\n  1819→                        \"background_task:start\",\n  1820→                        \"other\",\n  1821→                    ],\n  1822→                }\n  1823→            }\n  1824→        )\n  1825→\n  1826→    # Explicit wait for background tasks\n  1827→    for task in tuple(mock_app.background_tasks):\n  1828→        await task\n  1829→    assert not mock_app.background_tasks\n  1830→\n  1831→    exp_order = [\n  1832→        \"background_task:start\",\n  1833→        \"other\",\n  1834→        \"background_task:stop\",\n  1835→        \"other\",\n  1836→        \"private\",\n  1837→    ]\n  1838→\n  1839→    assert (await mock_app.state_manager.get_state(token)).order == exp_order\n  1840→\n  1841→    assert mock_app.event_namespace is not None\n  1842→    emit_mock = mock_app.event_namespace.emit\n  1843→\n  1844→    first_ws_message = json.loads(emit_mock.mock_calls[0].args[1])\n  1845→    assert first_ws_message[\"delta\"][\"background_task_state\"].pop(\"router\") is not None\n  1846→    assert first_ws_message == {\n  1847→        \"delta\": {\n  1848→            \"background_task_state\": {\n  1849→                \"order\": [\"background_task:start\"],\n  1850→                \"computed_order\": [\"background_task:start\"],\n  1851→            }\n  1852→        },\n  1853→        \"events\": [],\n  1854→        \"final\": True,\n  1855→    }\n  1856→    for call in emit_mock.mock_calls[1:5]:\n  1857→        assert json.loads(call.args[1]) == {\n  1858→            \"delta\": {\n  1859→                \"background_task_state\": {\"computed_order\": [\"background_task:start\"]}\n  1860→            },\n  1861→            \"events\": [],\n  1862→            \"final\": True,\n  1863→        }\n  1864→    assert json.loads(emit_mock.mock_calls[-2].args[1]) == {\n  1865→        \"delta\": {\n  1866→            \"background_task_state\": {\n  1867→                \"order\": exp_order,\n  1868→                \"computed_order\": exp_order,\n  1869→                \"dict_list\": {},\n  1870→            }\n  1871→        },\n  1872→        \"events\": [],\n  1873→        \"final\": True,\n  1874→    }\n  1875→    assert json.loads(emit_mock.mock_calls[-1].args[1]) == {\n  1876→        \"delta\": {\n  1877→            \"background_task_state\": {\n  1878→                \"computed_order\": exp_order,\n  1879→            },\n  1880→        },\n  1881→        \"events\": [],\n  1882→        \"final\": True,\n  1883→    }\n  1884→\n  1885→\n  1886→@pytest.mark.asyncio\n  1887→async def test_background_task_reset(mock_app: rx.App, token: str):\n  1888→    \"\"\"Test that a background task calling reset is protected by the state proxy.\n  1889→\n  1890→    Args:\n  1891→        mock_app: An app that will be returned by `get_app()`\n  1892→        token: A token.\n  1893→    \"\"\"\n  1894→    router_data = {\"query\": {}}\n  1895→    mock_app.state_manager.state = mock_app.state = BackgroundTaskState\n  1896→    async for update in rx.app.process(  # type: ignore\n  1897→        mock_app,\n  1898→        Event(\n  1899→            token=token,\n  1900→            name=f\"{BackgroundTaskState.get_name()}.background_task_reset\",\n  1901→            router_data=router_data,\n  1902→            payload={},\n  1903→        ),\n  1904→        sid=\"\",\n  1905→        headers={},\n  1906→        client_ip=\"\",\n  1907→    ):\n  1908→        # background task returns empty update immediately\n  1909→        assert update == StateUpdate()\n  1910→\n  1911→    # Explicit wait for background tasks\n  1912→    for task in tuple(mock_app.background_tasks):\n  1913→        await task\n  1914→    assert not mock_app.background_tasks\n  1915→\n  1916→    assert (await mock_app.state_manager.get_state(token)).order == [\n  1917→        \"reset\",\n  1918→    ]\n  1919→\n  1920→\n  1921→@pytest.mark.asyncio\n  1922→async def test_background_task_no_chain():\n  1923→    \"\"\"Test that a background task cannot be chained.\"\"\"\n  1924→    bts = BackgroundTaskState()\n  1925→    with pytest.raises(RuntimeError):\n  1926→        await bts.bad_chain1()\n  1927→    with pytest.raises(RuntimeError):\n  1928→        await bts.bad_chain2()\n  1929→\n  1930→\n  1931→def test_mutable_list(mutable_state):\n  1932→    \"\"\"Test that mutable lists are tracked correctly.\n  1933→\n  1934→    Args:\n  1935→        mutable_state: A test state.\n  1936→    \"\"\"\n  1937→    assert not mutable_state.dirty_vars\n  1938→\n  1939→    def assert_array_dirty():\n  1940→        assert mutable_state.dirty_vars == {\"array\"}\n  1941→        mutable_state._clean()\n  1942→        assert not mutable_state.dirty_vars\n  1943→\n  1944→    # Test all list operations\n  1945→    mutable_state.array.append(42)\n  1946→    assert_array_dirty()\n  1947→    mutable_state.array.extend([1, 2, 3])\n  1948→    assert_array_dirty()\n  1949→    mutable_state.array.insert(0, 0)\n  1950→    assert_array_dirty()\n  1951→    mutable_state.array.pop()\n  1952→    assert_array_dirty()\n  1953→    mutable_state.array.remove(42)\n  1954→    assert_array_dirty()\n  1955→    mutable_state.array.clear()\n  1956→    assert_array_dirty()\n  1957→    mutable_state.array += [1, 2, 3]\n  1958→    assert_array_dirty()\n  1959→    mutable_state.array.reverse()\n  1960→    assert_array_dirty()\n  1961→    mutable_state.array.sort()\n  1962→    assert_array_dirty()\n  1963→    mutable_state.array[0] = 666\n  1964→    assert_array_dirty()\n  1965→    del mutable_state.array[0]\n  1966→    assert_array_dirty()\n  1967→\n  1968→    # Test nested list operations\n  1969→    mutable_state.array[0] = [1, 2, 3]\n  1970→    assert_array_dirty()\n  1971→    mutable_state.array[0].append(4)\n  1972→    assert_array_dirty()\n  1973→    assert isinstance(mutable_state.array[0], MutableProxy)\n  1974→\n  1975→    # Test proxy returned from __iter__\n  1976→    mutable_state.array = [{}]\n  1977→    assert_array_dirty()\n  1978→    assert isinstance(mutable_state.array[0], MutableProxy)\n  1979→    for item in mutable_state.array:\n  1980→        assert isinstance(item, MutableProxy)\n  1981→        item[\"foo\"] = \"bar\"\n  1982→        assert_array_dirty()\n  1983→\n  1984→\n  1985→def test_mutable_dict(mutable_state):\n  1986→    \"\"\"Test that mutable dicts are tracked correctly.\n  1987→\n  1988→    Args:\n  1989→        mutable_state: A test state.\n  1990→    \"\"\"\n  1991→    assert not mutable_state.dirty_vars\n  1992→\n  1993→    def assert_hashmap_dirty():\n  1994→        assert mutable_state.dirty_vars == {\"hashmap\"}\n  1995→        mutable_state._clean()\n  1996→        assert not mutable_state.dirty_vars\n  1997→\n  1998→    # Test all dict operations\n  1999→    mutable_state.hashmap.update({\"new_key\": 43})\n  2000→    assert_hashmap_dirty()\n  2001→    assert mutable_state.hashmap.setdefault(\"another_key\", 66) == \"another_value\"\n  2002→    assert_hashmap_dirty()\n  2003→    assert mutable_state.hashmap.setdefault(\"setdefault_key\", 67) == 67\n  2004→    assert_hashmap_dirty()\n  2005→    assert mutable_state.hashmap.setdefault(\"setdefault_key\", 68) == 67\n  2006→    assert_hashmap_dirty()\n  2007→    assert mutable_state.hashmap.pop(\"new_key\") == 43\n  2008→    assert_hashmap_dirty()\n  2009→    mutable_state.hashmap.popitem()\n  2010→    assert_hashmap_dirty()\n  2011→    mutable_state.hashmap.clear()\n  2012→    assert_hashmap_dirty()\n  2013→    mutable_state.hashmap[\"new_key\"] = 42\n  2014    assert_hashmap_dirty()\n  2015→    del mutable_state.hashmap[\"new_key\"]\n  2016→    assert_hashmap_dirty()\n  2017→    if sys.version_info >= (3, 9):\n  2018→        mutable_state.hashmap |= {\"new_key\": 44}\n  2019→        assert_hashmap_dirty()\n  2020→\n  2021→    # Test nested dict operations\n  2022→    mutable_state.hashmap[\"array\"] = []\n  2023→    assert_hashmap_dirty()\n  2024→    mutable_state.hashmap[\"array\"].append(1)\n  2025→    assert_hashmap_dirty()\n  2026→    mutable_state.hashmap[\"dict\"] = {}\n  2027→    assert_hashmap_dirty()\n  2028→    mutable_state.hashmap[\"dict\"][\"key\"] = 42\n  2029→    assert_hashmap_dirty()\n  2030→    mutable_state.hashmap[\"dict\"][\"dict\"] = {}\n  2031→    assert_hashmap_dirty()\n  2032→    mutable_state.hashmap[\"dict\"][\"dict\"][\"key\"] = 43\n  2033→    assert_hashmap_dirty()\n  2034→\n  2035→    # Test proxy returned from `setdefault` and `get`\n  2036→    mutable_value = mutable_state.hashmap.setdefault(\"setdefault_mutable_key\", [])\n  2037→    assert_hashmap_dirty()\n  2