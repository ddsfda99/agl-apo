e state name into.\n   200→\n   201→    Returns:\n   202→        The encoded var.\n   203→    \"\"\"\n   204→    if value._var_data:\n   205→        return (\n   206→            f\"{constants.REFLEX_VAR_OPENING_TAG}{value._var_data.json()}{constants.REFLEX_VAR_CLOSING_TAG}\"\n   207→            + str(value)\n   208→        )\n   209→    return str(value)\n   210→\n   211→\n   212→def _decode_var(value: str) -> tuple[VarData | None, str]:\n   213→    \"\"\"Decode the state name from a formatted var.\n   214→\n   215→    Args:\n   216→        value: The value to extract the state name from.\n   217→\n   218→    Returns:\n   219→        The extracted state name and the value without the state name.\n   220→    \"\"\"\n   221→    var_datas = []\n   222→    if isinstance(value, str):\n   223→        # Extract the state name from a formatted var\n   224→        while m := re.match(\n   225→            pattern=rf\"(.*){constants.REFLEX_VAR_OPENING_TAG}(.*){constants.REFLEX_VAR_CLOSING_TAG}(.*)\",\n   226→            string=value,\n   227→            flags=re.DOTALL,  # Ensure . matches newline characters.\n   228→        ):\n   229→            value = m.group(1) + m.group(3)\n   230→            try:\n   231→                var_datas.append(VarData.parse_raw(m.group(2)))\n   232→            except pydantic.ValidationError:\n   233→                # If the VarData is invalid, it was probably json-encoded twice...\n   234→                var_datas.append(VarData.parse_raw(json.loads(f'\"{m.group(2)}\"')))\n   235→    if var_datas:\n   236→        return VarData.merge(*var_datas), value\n   237→    return None, value\n   238→\n   239→\n   240→def _extract_var_data(value: Iterable) -> list[VarData | None]:\n   241→    \"\"\"Extract the var imports and hooks from an iterable containing a Var.\n   242→\n   243→    Args:\n   244→        value: The iterable to extract the VarData from\n   245→\n   246→    Returns:\n   247→        The extracted VarDatas.\n   248→    \"\"\"\n   249→    from reflex.style import Style\n   250→\n   251→    var_datas = []\n   252→    with contextlib.suppress(TypeError):\n   253→        for sub in value:\n   254→            if isinstance(sub, Var):\n   255→                var_datas.append(sub._var_data)\n   256→            elif not isinstance(sub, str):\n   257→                # Recurse into dict values.\n   258→                if hasattr(sub, \"values\") and callable(sub.values):\n   259→                    var_datas.extend(_extract_var_data(sub.values()))\n   260→                # Recurse into iterable values (or dict keys).\n   261→                var_datas.extend(_extract_var_data(sub))\n   262→\n   263→    # Style objects should already have _var_data.\n   264→    if isinstance(value, Style):\n   265→        var_datas.append(value._var_data)\n   266→    else:\n   267→        # Recurse when value is a dict itself.\n   268→        values = getattr(value, \"values\", None)\n   269→        if callable(values):\n   270→            var_datas.extend(_extract_var_data(values()))\n   271→    return var_datas\n   272→\n   273→\n   274→class Var:\n   275→    \"\"\"An abstract var.\"\"\"\n   276→\n   277→    # The name of the var.\n   278→    _var_name: str\n   279→\n   280→    # The type of the var.\n   281→    _var_type: Type\n   282→\n   283→    # Whether this is a local javascript variable.\n   284→    _var_is_local: bool\n   285→\n   286→    # Whether the var is a string literal.\n   287→    _var_is_string: bool\n   288→\n   289→    # _var_full_name should be prefixed with _var_state\n   290→    _var_full_name_needs_state_prefix: bool\n   291→\n   292→    # Extra metadata associated with the Var\n   293→    _var_data: Optional[VarData]\n   294→\n   295→    @classmethod\n   296→    def create(\n   297→        cls, value: Any, _var_is_local: bool = True, _var_is_string: bool = False\n   298→    ) -> Var | None:\n   299→        \"\"\"Create a var from a value.\n   300→\n   301→        Args:\n   302→            value: The