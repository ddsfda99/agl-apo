192)\n   119\u2192def test_full_name(prop, expected):\n   120\u2192    \"\"\"Test that the full name of a var is correct.\n   121\u2192\n   122\u2192    Args:\n   123\u2192        prop: The var to test.\n   124\u2192        expected: The expected full name.\n   125\u2192    \"\"\"\n   126\u2192    assert prop._var_full_name == expected\n   127\u2192\n   128\u2192\n   129\u2192@pytest.mark.parametrize(\n   130\u2192    \"prop,expected\",\n   131\u2192    zip(\n   132\u2192        test_vars,\n   133\u2192        [\"{prop1}\", \"{key}\", \"{state.value}\", \"state.local\", \"local2\"],\n   134\u2192    ),\n   135\u2192)\n   136\u2192def test_str(prop, expected):\n   137\u2192    \"\"\"Test that the string representation of a var is correct.\n   138\u2192\n   139\u2192    Args:\n   140\u2192        prop: The var to test.\n   141\u2192        expected: The expected string representation.\n   142\u2192    \"\"\"\n   143\u2192    assert str(prop) == expected\n   144\u2192\n   145\u2192\n   146\u2192@pytest.mark.parametrize(\n   147\u2192    \"prop,expected\",\n   148\u2192    [\n   149\u2192        (BaseVar(_var_name=\"p\", _var_type=int), 0),\n   150\u2192        (BaseVar(_var_name=\"p\", _var_type=float), 0.0),\n   151\u2192        (BaseVar(_var_name=\"p\", _var_type=str), \"\"),\n   152\u2192        (BaseVar(_var_name=\"p\", _var_type=bool), False),\n   153\u2192        (BaseVar(_var_name=\"p\", _var_type=list), []),\n   154\u2192        (BaseVar(_var_name=\"p\", _var_type=dict), {}),\n   155\u2192        (BaseVar(_var_name=\"p\", _var_type=tuple), ()),\n   156\u2192        (BaseVar(_var_name=\"p\", _var_type=set), set()),\n   157\u2192    ],\n   158\u2192)\n   159\u2192def test_default_value(prop, expected):\n   160\u2192    \"\"\"Test that the default value of a var is correct.\n   161\u2192\n   162\u2192    Args:\n   163\u2192        prop: The var to test.\n   164\u2192        expected: The expected default value.\n   165\u2192    \"\"\"\n   166\u2192    assert prop.get_default_value() == expected\n   167\u2192\n   168\u2192\n   169\u2192@pytest.mark.parametrize(\n   170\u2192    \"prop,expected\",\n   171\u2192    zip(\n   172\u2192        test_vars,\n   173\u2192        [\n   174\u2192            \"set_prop1\",\n   175\u2192            \"set_key\",\n   176\u2192            \"state.set_value\",\n   177\u2192            \"state.set_local\",\n   178\u2192            \"set_local2\",\n   179\u2192        ],\n   180\u2192    ),\n   181\u2192)\n   182\u2192def test_get_setter(prop, expected):\n   183\u2192    \"\"\"Test that the name of the setter function of a var is correct.\n   184\u2192\n   185\u2192    Args:\n   186\u2192        prop: The var to test.\n   187\u2192        expected: The expected name of the setter function.\n   188\u2192    \"\"\"\n   189\u2192    assert prop.get_setter_name() == expected\n   190\u2192\n   191\u2192\n   192\u2192@pytest.mark.parametrize(\n   193\u2192    \"value,expected\",\n   194\u2192    [\n   195\u2192        (None, None),\n   196\u2192        (1, BaseVar(_var_name=\"1\", _var_type=int, _var_is_local=True)),\n   197\u2192        (\"key\", BaseVar(_var_name=\"key\", _var_type=str, _var_is_local=True)),\n   198\u2192        (3.14, BaseVar(_var_name=\"3.14\", _var_type=float, _var_is_local=True)),\n   199\u2192        ([1, 2, 3], BaseVar(_var_name=\"[1, 2, 3]\", _var_type=list, _var_is_local=True)),\n   200\u2192        (\n   201\u2192            {\"a\": 1, \"b\": 2},\n   202\u2192            BaseVar(_var_name='{\"a\": 1, \"b\": 2}', _var_type=dict, _var_is_local=True),\n   203\u2192        ),\n   204\u2192    ],\n   205\u2192)\n   206\u2192def test_create(value, expected):\n   207\u2192    \"\"\"Test the var create function.\n   208\u2192\n   209\u2192    Args:\n   210\u2192        value: The value to create a var from.\n   211\u2192        expected: The expected name of the setter function.\n   212\u2192    \"\"\"\n   213\u2192    prop = Var.create(value)\n   214\u2192    if value is None:\n   215\u2192        assert prop == expected\n   216\u2192    else:\n   217\u2192        assert prop.equals(expected)  # type: ignore\n   218\u2192\n   219\u2192\n   220\u2192def test_create_type_error():\n   221\u2192    \"\"\"Test the var create function when inputs type error.\"\"\"\n   222\u2192\n   223\u2192    class ErrorType:\n   224\u2192        pass\n   225\u2192\n   226\u2192    value = ErrorType()\n   227\u2192\n   228\u2192    with pytest.raises(TypeError):\n   229\u2192        Var.create(value)\n   230\u2192\n   231\u2192\n   232\u2192def v(value) -> Var:\n   233\u2192    val = (\n   234\u2192        Var.create(json.dumps(value), _var_is_string=True, _var_is_local=False)\n   235\u2192        if isinstance(value, str)\n   236\u2192        else Var.create(value, _var_is_local=False)\n   237\u2192    )\n   238\u2192    assert val is not None\n   239\u2192    return val\n   240\u2192\n   241\u2192\n   242\u2192def test_basic_operations(TestObj):\n   243\u2192    \"\"\"Test the var operations.\n   244\u2192\n   245\u2192    Args:\n   246\u2192        TestObj: The test object.\n   247\u2192    \"\"\"\n   248\u2192    assert str(v(1) == v(2)) == \"{(1 === 2)}\"\n   249\u2192    assert str(v(1) != v(2)) == \"{(1 !== 2)}\"\n   250\u2192    assert str(v(1) < v(2)) == \"{(1 < 2)}\"\n   251\u2192    assert str(v(1) <= v(2)) == \"{(1 <= 2)}\"\n   252\u2192    assert str(v(1) > v(2)) == \"{(1 > 2)}\"\n   253\u2192    assert str(v(1) >= v(2)) == \"{(1 >= 2)}\"\n   254\u2192    assert str(v(1) + v(2)) == \"{(1 + 2)}\"\n   255\u2192    assert str(v(1) - v(2)) == \"{(1 - 2)}\"\n   256\u2192    assert str(v(1) * v(2)) == \"{(1 * 2)}\"\n   257\u2192    assert str(v(1) / v(2)) == \"{(1 / 2)}\"\n   258\u2192    assert str(v(1) // v(2)) == \"{Math.floor(1 / 2)}\"\n   259\u2192    assert str(v(1) % v(2)) == \"{(1 % 2)}\"\n   260\u2192    assert str(v(1) ** v(2)) == \"{Math.pow(1 , 2)}\"\n   261\u2192    assert str(v(1) & v(2)) == \"{(1 && 2)}\"\n   262\u2192    assert str(v(1) | v(2)) == \"{(1 || 2)}\"\n   263\u2192    assert str(v([1, 2, 3])[v(0)]) == \"{[1, 2, 3].at(0)}\"\n   264\u2192    assert str(v({\"a\": 1, \"b\": 2})[\"a\"]) == '{{\"a\": 1, \"b\": 2}[\"a\"]}'\n   265\u2192    assert str(v(\"foo\") == v(\"bar\")) == '{(\"foo\" === \"bar\")}'\n   266\u2192    assert (\n   267\u2192        str(\n   268\u2192            Var.create(\"foo\", _var_is_local=False)\n   269\u2192            == Var.create(\"bar\", _var_is_local=False)\n   270\u2192        )\n   271\u2192        == \"{(foo === bar)}\"\n   272\u2192    )\n   273\u2192    assert (\n   274\u2192        str(\n   275\u2192            BaseVar(\n   276\u2192                _var_name=\"foo\", _var_type=str, _var_is_string=True, _var_is_local=True\n   277\u2192            )\n   278\u2192            == BaseVar(\n   279\u2192                _var_name=\"bar\", _var_type=str, _var_is_string=True, _var_is_local=True\n   280\u2192            )\n   281\u2192        )\n   282\u2192        == \"(`foo` === `bar`)\"\n   283\u2192    )\n   284\u2192    assert (\n   285\u2192        str(\n   286\u2192            BaseVar(\n   287\u2192                _var_name=\"foo\",\n   288\u2192                _var_type=TestObj,\n   289\u2192                _var_is_string=True,\n   290\u2192                _var_is_local=False,\n   291\u2192            )\n   292\u2192            ._var_set_state(\"state\")\n   293\u2192            .bar\n   294\u2192            == BaseVar(\n   295\u2192                _var_name=\"bar\", _var_type=str, _var_is_string=True, _var_is_local=True\n   296\u2192            )\n   297\u2192        )\n   298\u2192        == \"{(state.foo.bar === `bar`)}\"\n   299\u2192    )\n   300\u2192    assert (\n   301\u2192        str(BaseVar(_var_name=\"foo\", _var_type=TestObj)._var_set_state(\"state\").bar)\n   302\u2192        == \"{state.foo.bar}\"\n   303\u2192    )\n   304\u2192    assert str(abs(v(1))) == \"{Math.abs(1)}\"\n   305\u2192    assert str(v([1, 2, 3]).length()) == \"{[1, 2, 3].length}\"\n   306\u2192    assert str(v([1, 2]) + v([3, 4])) == \"{spreadArraysOrObjects([1, 2] , [3, 4])}\"\n   307\u2192\n   308\u2192    # Tests for reverse operation\n   309\u2192    assert str(v([1, 2, 3]).reverse()) == \"{[...[1, 2, 3]].reverse()}\"\n   310\u2192    assert str(v([\"1\", \"2\", \"3\"]).reverse()) == '{[...[\"1\", \"2\", \"3\"]].reverse()}'\n   311\u2192    assert (\n   312\u2192        str(BaseVar(_var_name=\"foo\", _var_type=list)._var_set_state(\"state\").reverse())\n   313\u2192        == \"{[...state.foo].reverse()}\"\n   314\u2192    )\n   315\u2192    assert (\n   316\u2192        str(BaseVar(_var_name=\"foo\", _var_type=list).reverse())\n   317\u2192        == \"{[...foo].reverse()}\"\n   318\u2192    )\n   319\u2192    assert str(BaseVar(_var_name=\"foo\", _var_type=str)._type()) == \"{typeof foo}\"  # type: ignore\n   320\u2192    assert (\n   321\u2192        str(BaseVar(_var_name=\"foo\", _var_type=str)._type() == str)  # type: ignore\n   322\u2192        == \"{(typeof foo === `string`)}\"\n   323\u2192    )\n   324\u2192    assert (\n   325\u2192        str(BaseVar(_var_name=\"foo\", _var_type=str)._type() == str)  # type: ignore\n   326\u2192        == \"{(typeof foo === `string`)}\"\n   327\u2192    )\n   328\u2192    assert (\n   329\u2192        str(BaseVar(_var_name=\"foo\", _var_type=str)._type() == int)  # type: ignore\n   330\u2192        == \"{(typeof foo === `number`)}\"\n   331\u2192    )\n   332\u2192    assert (\n   333\u2192        str(BaseVar(_var_name=\"foo\", _var_type=str)._type() == list)  # type: ignore\n   334\u2192        == \"{(typeof foo === `Array`)}\"\n   335\u2192    )\n   336\u2192    assert (\n   337\u2192        str(BaseVar(_var_name=\"foo\", _var_type=str)._type() == float)  # type: ignore\n   338\u2192        == \"{(typeof foo === `number`)}\"\n   339\u2192    )\n   340\u2192    assert (\n   341\u2192        str(BaseVar(_var_name=\"foo\", _var_type=str)._type() == tuple)  # type: ignore\n   342\u2192        == \"{(typeof foo === `Array`)}\"\n   343\u2192    )\n   344\u2192    assert (\n   345\u2192        str(BaseVar(_var_name=\"foo\", _var_type=str)._type() == dict)  # type: ignore\n   346\u2192        == \"{(typeof foo === `Object`)}\"\n   347\u2192    )\n   348\u2192    assert (\n   349\u2192        str(BaseVar(_var_name=\"foo\", _var_type=str)._type() != str)  # type: ignore\n   350\u2192        == \"{(typeof foo !== `string`)}\"\n   351\u2192    )\n   352\u2192    assert (\n   353\u2192        str(BaseVar(_var_name=\"foo\", _var_type=str)._type() != int)  # type: ignore\n   354\u2192        == \"{(typeof foo !== `number`)}\"\n   355\u2192    )\n   356\u2192    assert (\n   357\u2192        str(BaseVar(_var_name=\"foo\", _var_type=str)._type() != list)  # type: ignore\n   358\u2192        == \"{(typeof foo !== `Array`)}\"\n   359\u2192    )\n   360\u2192    assert (\n   361\u2192        str(BaseVar(_var_name=\"foo\", _var_type=str)._type() != float)  # type: ignore\n   362\u2192        == \"{(typeof foo !== `number`)}\"\n   363\u2192    )\n   364\u2192    assert (\n   365\u2192        str(BaseVar(_var_name=\"foo\", _var_type=str)._type() != tuple)  # type: ignore\n   366\u2192        == \"{(typeof foo !== `Array`)}\"\n   367\u2192    )\n   368\u2192    assert (\n   369\u2192        str(BaseVar(_var_name=\"foo\", _var_type=str)._type() != dict)  # type: ignore\n   370\u2192        == \"{(typeof foo !== `Object`)}\"\n   371\u2192    )\n   372\u2192\n   373\u2192\n   374\u2192@pytest.mark.parametrize(\n   375\u2192    \"var, expected\",\n   376\u2192    [\n   377\u2192        (v([1, 2, 3]), \"[1, 2, 3]\"),\n   378\u2192        (v([\"1\", \"2\", \"3\"]), '[\"1\", \"2\", \"3\"]'),\n   379\u2192        (BaseVar(_var_name=\"foo\", _var_type=list)._var_set_state(\"state\"), \"state.foo\"),\n   380\u2192        (BaseVar(_var_name=\"foo\", _var_type=list), \"foo\"),\n   381\u2192        (v((1, 2, 3)), \"[1, 2, 3]\"),\n   382\u2192        (v((\"1\", \"2\", \"3\")), '[\"1\", \"2\", \"3\"]'),\n   383\u2192        (\n   384\u2192            BaseVar(_var_name=\"foo\", _var_type=tuple)._var_set_state(\"state\"),\n   385\u2192            \"state.foo\",\n   386\u2192        ),\n   387\u2192        (BaseVar(_var_name=\"foo\", _var_type=tuple), \"foo\"),\n   388\u2192    ],\n   389\u2192)\n   390\u2192def test_list_tuple_contains(var, expected):\n   391\u2192    assert str(var.contains(1)) == f\"{{{expected}.includes(1)}}\"\n   392\u2192    assert str(var.contains(\"1\")) == f'{{{expected}.includes(\"1\")}}'\n   393\u2192    assert str(var.contains(v(1))) == f\"{{{expected}.includes(1)}}\"\n   394\u2192    assert str(var.contains(v(\"1\"))) == f'{{{expected}.includes(\"1\")}}'\n   395\u2192    other_state_var = BaseVar(_var_name=\"other\", _var_type=str)._var_set_state(\"state\")\n   396\u2192    other_var = BaseVar(_var_name=\"other\", _var_type=str)\n   397\u2192    assert str(var.contains(other_state_var)) == f\"{{{expected}.includes(state.other)}}\"\n   398\u2192    assert str(var.contains(other_var)) == f\"{{{expected}.includes(other)}}\"\n   399\u2192\n   400\u2192\n   401\u2192@pytest.mark.parametrize(\n   402\u2192    \"var, expected\",\n   403\u2192    [\n   404\u2192        (v(\"123\"), json.dumps(\"123\")),\n   405\u2192        (BaseVar(_var_name=\"foo\", _var_type=str)._var_set_state(\"state\"), \"state.foo\"),\n   406\u2192        (BaseVar(_var_name=\"foo\", _var_type=str), \"foo\"),\n   407\u2192    ],\n   408\u2192)\n   409\u2192def test_str_contains(var, expected):\n   410\u2192    assert str(var.contains(\"1\")) == f'{{{expected}.includes(\"1\")}}'\n   411\u2192    assert str(var.contains(v(\"1\"))) == f'{{{expected}.includes(\"1\")}}'\n   412\u2192    other_state_var = BaseVar(_var_name=\"other\", _var_type=str)._var_set_state(\"state\")\n   413\u2192    other_var = BaseVar(_var_name=\"other\", _var_type=str)\n   414\u2192    assert str(var.contains(other_state_var)) == f\"{{{expected}.includes(state.other)}}\"\n   415\u2192    assert str(var.contains(other_var)) == f\"{{{expected}.includes(other)}}\"\n   416\u2192\n   417\u2192\n   418\u2192@pytest.mark.parametrize(\n   419\u2192    \"var, expected\",\n   420\u2192    [\n   421\u2192        (v({\"a\": 1, \"b\": 2}), '{\"a\": 1, \"b\": 2}'),\n   422\u2192        (BaseVar(_var_name=\"foo\", _var_type=dict)._var_set_state(\"state\"), \"state.foo\"),\n   423\u2192        (BaseVar(_var_name=\"foo\", _var_type=dict), \"foo\"),\n   424\u2192    ],\n   425\u2192)\n   426\u2192def test_dict_contains(var, expected):\n   427\u2192    assert str(var.contains(1)) == f\"{{{expected}.hasOwnProperty(1)}}\"\n   428\u2192    assert str(var.contains(\"1\")) == f'{{{expected}.hasOwnProperty(\"1\")}}'\n   429\u2192    assert str(var.contains(v(1))) == f\"{{{expected}.hasOwnProperty(1)}}\"\n   430\u2192    assert str(var.contains(v(\"1\"))) == f'{{{expected}.hasOwnProperty(\"1\")}}'\n   431\u2192    other_state_var = BaseVar(_var_name=\"other\", _var_type=str)._var_set_state(\"state\")\n   432\u2192    other_var = BaseVar(_var_name=\"other\", _var_type=str)\n   433\u2192    assert (\n   434\u2192        str(var.contains(other_state_var))\n   435\u2192        == f\"{{{expected}.hasOwnProperty(state.other)}}\"\n   436\u2192    )\n   437\u2192    assert str(var.contains(other_var)) == f\"{{{expected}.hasOwnProperty(other)}}\"\n   438\u2192\n   439\u2192\n   440\u2192@pytest.mark.parametrize(\n   441\u2192    \"var\",\n   442\u2192    [\n   443\u2192        BaseVar(_var_name=\"list\", _var_type=List[int]),\n   444\u2192        BaseVar(_var_name=\"tuple\", _var_type=Tuple[int, int]),\n   445\u2192        BaseVar(_var_name=\"str\", _var_type=str),\n   446\u2192    ],\n   447\u2192)\n   448\u2192def test_var_indexing_lists(var):\n   449\u2192    \"\"\"Test that we can index into str, list or tuple vars.\n   450\u2192\n   451\u2192    Args:\n   452\u2192        var : The str, list or tuple base var.\n   453\u2192    \"\"\"\n   454\u2192    # Test basic indexing.\n  