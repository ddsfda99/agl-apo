_full_name_needs_state_prefix=kwargs.pop(\n   400→                \"_var_full_name_needs_state_prefix\",\n   401→                self._var_full_name_needs_state_prefix,\n   402→            ),\n   403→            _var_data=VarData.merge(\n   404→                kwargs.get(\"_var_data\", self._var_data), merge_var_data\n   405→            ),\n   406→        )\n   407→        return BaseVar(**field_values)\n   408→\n   409→    def _decode(self) -> Any:\n   410→        \"\"\"Decode Var as a python value.\n   411→\n   412→        Note that Var with state set cannot be decoded python-side and will be\n   413→        returned as full_name.\n   414→\n   415→        Returns:\n   416→            The decoded value or the Var name.\n   417→        \"\"\"\n   418→        if self._var_is_string:\n   419→            return self._var_name\n   420→        try:\n   421→            return json.loads(self._var_name)\n   422→        except ValueError:\n   423→            return self._var_name\n   424→\n   425→    def equals(self, other: Var) -> bool:\n   426→        \"\"\"Check if two vars are equal.\n   427→\n   428→        Args:\n   429→            other: The other var to compare.\n   430→\n   431→        Returns:\n   432→            Whether the vars are equal.\n   433→        \"\"\"\n   434→        return (\n   435→            self._var_name == other._var_name\n   436→            and self._var_type == other._var_type\n   437→            and self._var_is_local == other._var_is_local\n   438→            and self._var_full_name_needs_state_prefix\n   439→            == other._var_full_name_needs_state_prefix\n   440→            and self._var_data == other._var_data\n   441→        )\n   442→\n   443→    def _merge(self, other) -> Var:\n   444→        \"\"\"Merge two or more dicts.\n   445→\n   446→        Args:\n   447→            other: The other var to merge.\n   448→\n   449→        Returns:\n   450→            The merged var.\n   451→        \"\"\"\n   452→        if other is None:\