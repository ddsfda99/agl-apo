0→    assert str(prop) == \"{test_state.complex[1].prop1}\"\n   371→\n   372→\n   373→def test_get_parent_state():\n   374→    \"\"\"Test getting the parent state.\"\"\"\n   375→    assert TestState.get_parent_state() is None\n   376→    assert ChildState.get_parent_state() == TestState\n   377→    assert ChildState2.get_parent_state() == TestState\n   378→    assert GrandchildState.get_parent_state() == ChildState\n   379→\n   380→\n   381→def test_get_substates():\n   382→    \"\"\"Test getting the substates.\"\"\"\n   383→    assert TestState.get_substates() == {ChildState, ChildState2}\n   384→    assert ChildState.get_substates() == {GrandchildState}\n   385→    assert ChildState2.get_substates() == set()\n   386→    assert GrandchildState.get_substates() == set()\n   387→\n   388→\n   389→def test_get_name():\n   390→    \"\"\"Test getting the name of a state.\"\"\"\n   391→    assert TestState.get_name() == \"test_state\"\n   392→    assert ChildState.get_name() == \"child_state\"\n   393→    assert ChildState2.get_name() == \"child_state2\"\n   394→    assert GrandchildState.get_name() == \"grandchild_state\"\n   395→\n   396→\n   397→def test_get_full_name():\n   398→    \"\"\"Test getting the full name.\"\"\"\n   399→    assert TestState.get_full_name() == \"test_state\"\n   400→    assert ChildState.get_full_name() == \"test_state.child_state\"\n   401→    assert ChildState2.get_full_name() == \"test_state.child_state2\"\n   402→    assert GrandchildState.get_full_name() == \"test_state.child_state.grandchild_state\"\n   403→\n   404→\n   405→def test_get_class_substate():\n   406→    \"\"\"Test getting the substate of a class.\"\"\"\n   407→    assert TestState.get_class_substate((\"child_state\",)) == ChildState\n   408→    assert TestState.get_class_substate((\"child_state2\",)) == ChildState2\n   409→    assert ChildState.get_class_substate((\"grandchild_state\",)) == GrandchildState\n   410→    assert (\n   411→        TestState.get_class_substate((\"child_state\", \"grandchild_state\"))\n   412→        == GrandchildState\n   413→    )\n   414→    with pytest.raises(ValueError):\n   415→        TestState.get_class_substate((\"invalid_child\",))\n   416→    with pytest.raises(ValueError):\n   417→        TestState.get_class_substate(\n   418→            (\n   419→                \"child_state\",\n   420→                \"invalid_child\",\n   421→            )\n   422→        )\n   423→\n   424→\n   425→def test_get_class_var():\n   426→    \"\"\"Test getting the var of a class.\"\"\"\n   427→    assert TestState.get_class_var((\"num1\",)).equals(TestState.num1)\n   428→    assert TestState.get_class_var((\"num2\",)).equals(TestState.num2)\n   429→    assert ChildState.get_class_var((\"value\",)).equals(ChildState.value)\n   430→    assert GrandchildState.get_class_var((\"value2\",)).equals(GrandchildState.value2)\n   431→    assert TestState.get_class_var((\"child_state\", \"value\")).equals(ChildState.value)\n   432→    assert TestState.get_class_var(\n   433→        (\"child_state\", \"grandchild_state\", \"value2\")\n   434→    ).equals(\n   435→        GrandchildState.value2,\n   436→    )\n   437→    assert ChildState.get_class_var((\"grandchild_state\", \"value2\")).equals(\n   438→        GrandchildState.value2,\n   439→    )\n   440→    with pytest.raises(ValueError):\n   441→        TestState.get_class_var((\"invalid_var\",))\n   442→    with pytest.raises(ValueError):\n   443→        TestState.get_class_var(\n   444→            (\n   445→                \"child_state\",\n   446→                \"invalid_var\",\n   447→            )\n   448→        )\n   449→\n   450→\n   451→def test_set_class_var():\n   452→    \"\"\"Test setting the var of a class.\"\"\"\n   453→    with pytest.raises(AttributeError):\n   454→        TestState.num3  # type: ignore\n   455→    TestState._set_var(\n   456→        BaseVar(_var_name=\"num3\", _var_type=int)._var_set_state(TestState)\n   457→    )\n   458→    var = TestState.num3  # type: ignore\n   459→    assert var._var_name == \"num3\"\n   460→    assert var._var_type == int\n   461→    assert var._var_state == TestState.get_full_name()\n   462→\n   463→\n   464→def test_set_parent_and_substates(test_state, child_state, grandchild_state):\n   465→    \"\"\"Test setting the parent and substates.\n   466→\n   467→    Args:\n   468→        test_state: A state.\n   469→        child_state: A child state.\n   470→        grandchild_state: A grandchild state.\n   471→    \"\"\"\n   472→    assert len(test_state.substates) == 2\n   473→    assert set(test_state.substates) == {\"child_state\", \"child_state2\"}\n   474→\n   475→    assert child_state.parent_state == test_state\n   476→    assert len(child_state.substates) == 1\n   477→    assert set(child_state.substates) == {\"grandchild_state\"}\n   478→\n   479→    assert grandchild_state.parent_state == child_state\n   480→    assert len(grandchild_state.substates) == 0\n   481→\n   482→\n   483→def test_get_child_attribute(test_state, child_state, child_state2, grandchild_state):\n   484→    \"\"\"Test getting the attribute of a state.\n   485→\n   486→    Args:\n   487→        test_state: A state.\n   488→        child_state: A child state.\n   489→        child_state2: A child state.\n   490→        grandchild_state: A grandchild state.\n   491→    \"\"\"\n   492→    assert test_state.num1 == 0\n   493→    assert child_state.value == \"\"\n   494→    assert child_state2.value == \"\"\n   495→    assert child_state.count == 23\n   496→    assert grandchild_state.value2 == \"\"\n   497→    with pytest.raises(AttributeError):\n   498→        test_state.invalid\n   499→    with pytest.raises(AttributeError):\n   500→        test_state.child_state.invalid\n   501→    with pytest.raises(AttributeError):\n   502→        test_state.child_state.grandchild_state.invalid\n   503→\n   504→\n   505→def test_set_child_attribute(test_state, child_state, grandchild_state):\n   506→    \"\"\"Test setting the attribute of a state.\n   507→\n   508→    Args:\n   509→        test_state: A state.\n   510→        child_state: A child state.\n   511→        grandchild_state: A grandchild state.\n   512→    \"\"\"\n   513→    test_state.num1 = 10\n   514→    assert test_state.num1 == 10\n   515→    assert child_state.num1 == 10\n   516→    assert grandchild_state.num1 == 10\n   517→\n   518→    grandchild_state.num1 = 5\n   519→    assert test_state.num1 == 5\n   520→    assert child_state.num1 == 5\n   521→    assert grandchild_state.num1 == 5\n   522→\n   523→    child_state.value = \"test\"\n   524→    assert child_state.value == \"test\"\n   525→    assert grandchild_state.value == \"test\"\n   526→\n   527→    grandchild_state.value = \"test2\"\n   528→    assert child_state.value == \"test2\"\n   529→    assert grandchild_state.value == \"test2\"\n   530→\n   531→    grandchild_state.value2 = \"test3\"\n   532→    assert grandchild_state.value2 == \"test3\"\n   533→\n   534→\n   535→def test_get_substate(test_state, child_state, child_state2, grandchild_state):\n   536→    \"\"\"Test getting the substate of a state.\n   537→\n   538→    Args:\n   539→        test_state: A state.\n   540→        child_state: A child state.\n   541→        child_state2: A child state.\n   542→        grandchild_state: A grandchild state.\n   543→    \"\"\"\n   544→    assert test_state.get_substate((\"child_state\",)) == child_state\n   545→    assert test_state.get_substate((\"child_state2\",)) == child_state2\n   546→    assert (\n   547→        test_state.get_substate((\"child_state\", \"grandchild_state\")) == grandchild_state\n   548→    )\n   549→    assert child_state.get_substate((\"grandchild_state\",)) == grandchild_state\n   550→    with pytest.raises(ValueError):\n   551→        test_state.get_substate((\"invalid\",))\n   552→    with pytest.raises(ValueError):\n   553→        test_state.get_substate((\"child_state\", \"invalid\"))\n   554→    with pytest.raises(ValueError):\n   555→        test_state.get_substate((\"child_state\", \"grandchild_state\", \"invalid\"))\n   556→\n   557→\n   558→def test_set_dirty_var(test_state):\n   559→    \"\"\"Test changing state vars marks the value as dirty.\n   560→\n   561→    Args:\n   562→        test_state: A state.\n   563→    \"\"\"\n   564→    # Initially there should be no dirty vars.\n   565→    assert test_state.dirty_vars == set()\n   566→\n   567→    # Setting a var should mark it as dirty.\n   568→    test_state.num1 = 1\n   569→    assert test_state.dirty_vars == {\"num1\", \"sum\"}\n   570→\n   571→    # Setting another var should mark it as dirty.\n   572→    test_state.num2 = 2\n   573→    assert test_state.dirty_vars == {\"num1\", \"num2\", \"sum\"}\n   574→\n   575→    # Cleaning the state should remove all dirty vars.\n   576→    test_state._clean()\n   577→    assert test_state.dirty_vars == set()\n   578→\n   579→\n   580→def test_set_dirty_substate(test_state, child_state, child_state2, grandchild_state):\n   581→    \"\"\"Test changing substate vars marks the value as dirty.\n   582→\n   583→    Args:\n   584→        test_state: A state.\n   585→        child_state: A child state.\n   586→        child_state2: A child state.\n   587→        grandchild_state: A grandchild state.\n   588→    \"\"\"\n   589→    # Initially there should be no dirty vars.\n   590→    assert test_state.dirty_vars == set()\n   591→    assert child_state.dirty_vars == set()\n   592→    assert child_state2.dirty_vars == set()\n   593→    assert grandchild_state.dirty_vars == set()\n   594→\n   595→    # Setting a var should mark it as dirty.\n   596→    child_state.value = \"test\"\n   597→    assert child_state.dirty_vars == {\"value\"}\n   598→    assert test_state.dirty_substates == {\"child_state\"}\n   599→    assert child_state.dirty_substates == set()\n   600→\n   601→    # Cleaning the parent state should remove the dirty substate.\n   602→    test_state._clean()\n   603→    assert test_state.dirty_substates == set()\n   604→    assert child_state.dirty_vars == set()\n   605→\n   606→    # Setting a var on the grandchild should bubble up.\n   607→    grandchild_state.value2 = \"test2\"\n   608→    assert child_state.dirty_substates == {\"grandchild_state\"}\n   609→    assert test_state.dirty_substates == {\"child_state\"}\n   610→\n   611→    # Cleaning the middle state should keep the parent state dirty.\n   612→    child_state._clean()\n   613→    assert test_state.dirty_substates == {\"child_state\"}\n   614→    assert child_state.dirty_substates == set()\n   615→    assert grandchild_state.dirty_vars == set()\n   616→\n   617→\n   618→def test_reset(test_state, child_state):\n   619→    \"\"\"Test resetting the state.\n   620→\n   621→    Args:\n   622→        test_state: A state.\n   623→        child_state: A child state.\n   624→    \"\"\"\n   625→    # Set some values.\n   626→    test_state.num1 = 1\n   627→    test_state.num2 = 2\n   628→    child_state.value = \"test\"\n   629→\n   630→    # Reset the state.\n   631→    test_state.reset()\n   632→\n   633→    # The values should be reset.\n   634→    assert test_state.num1 == 0\n   635→    assert test_state.num2 == 3.14\n   636→    assert child_state.value == \"\"\n   637→\n   638→    expected_dirty_vars = {\n   639→        \"num1\",\n   640→        \"num2\",\n   641→        \"obj\",\n   642→        \"upper\",\n   643→        \"complex\",\n   644→        \"fig\",\n   645→        \"key\",\n   646→        \"sum\",\n   647→        \"array\",\n   648→        \"map_key\",\n   649→        \"mapping\",\n   650→        \"dt\",\n   651→    }\n   652→\n   653→    # The dirty vars should be reset.\n   654→    assert test_state.dirty_vars == expected_dirty_vars\n   655→    assert child_state.dirty_vars == {\"count\", \"value\"}\n   656→\n   657→    # The dirty substates should be reset.\n   658→    assert test_state.dirty_substates == {\"child_state\", \"child_state2\"}\n   659→\n   660→\n   661→@pytest.mark.asyncio\n   662→async def test_process_event_simple(test_state):\n   663→    \"\"\"Test processing an event.\n   664→\n   665→    Args:\n   666→        test_state: A state.\n   667→    \"\"\"\n   668→    assert test_state.num1 == 0\n   669→\n   670→    event = Event(token=\"t\", name=\"set_num1\", payload={\"value\": 69})\n   671→    update = await test_state._process(event).__anext__()\n   672→\n   673→    # The event should update the value.\n   674→    assert test_state.num1 == 69\n   675→\n   676→    # The delta should contain the changes, including computed vars.\n   677→    # assert update.delta == {\"test_state\": {\"num1\": 69, \"sum\": 72.14}}\n   678→    assert update.delta == {\"test_state\": {\"num1\": 69, \"sum\": 72.14, \"upper\": \"\"}}\n   679→    assert update.events == []\n   680→\n   681→\n   682→@pytest.mark.asyncio\n   683→async def test_process_event_substate(test_state, child_state, grandchild_state):\n   684→    \"\"\"Test processing an event on a substate.\n   685→\n   686→    Args:\n   687→        test_state: A state.\n   688→        child_state: A child state.\n   689→        grandchild_state: A grandchild state.\n   690→    \"\"\"\n   691→    # Events should bubble down to the substate.\n   692→    assert child_state.value == \"\"\n   693→    assert child_state.count == 23\n   694→    event = Event(\n   695→        token=\"t\", name=\"child_state.change_both\", payload={\"value\": \"hi\", \"count\": 12}\n   696→    )\n   697→    update = await test_state._process(event).__anext__()\n   698→    assert child_state.value == \"HI\"\n   699→    assert child_state.count == 24\n   700→    assert update.delta == {\n   701→        \"test_state\": {\"sum\": 3.14, \"upper\": \"\"},\n   702→        \"test_state.child_state\": {\"value\": \"HI\", \"count\": 24},\n   703→    }\n   704→    test_state._clean()\n   705→\n   706→    # Test with the granchild state.\n   707→    assert grandchild_state.value2 == \"\"\n   708→    event = Event(\n   709→        token=\"t\",\n   710→        name=\"child_state.grandchild_state.set_value2\",\n   711→        payload={\"value\": \"new\"},\n   712→    )\n   713→    update = await test_state._process(event).__anext__()\n   714→    assert grandchild_state.value2 == \"new\"\n   715→    assert update.delta == {\n   716→        \"test_state\": {\"sum\": 3.14, \"upper\": \"\"},\n   717→        \"test_state.child_state.grandchild_state\": {\"value2\": \"new\"},\n   718→    }\n   719→\n   720→\n   721→@pytest.mark.asyncio\n   722→async def test_process_event_generator():\n   723→    \"\"\"Test event handlers that generate multiple updates.\"\"\"\n   724→    gen_state = GenState()  # type: ignore\n   725→    event = Event(\n   726→        token=\"t\",\n   727→        name=\"go\",\n   728→        payload={\"c\": 5},\n   729→    )\n   730→    gen = gen_state._process(event)\n   731→\n   732→    count = 0\n   733→    async for update in gen:\n   734→        count += 1\n   735→        if count == 6:\n   736→            assert update.delta == {}\n   737→            assert update.final\n   738→        else:\n   739→            assert gen_state.value == count\n   740→            assert update.delta == {\n   741→                \"gen_state\": {\"value\": count},\n   742→            }\n   743→            assert not update.final\n   744→\n   745→    assert count == 6\n   746→\n   747→\n   748→def test_get_token(test_state, mocker, router_data):\n   749→    \"\"\"Test that the token obtained from the router_data is correct.\n   750→\n   751→    Args:\n   752→        test_state: The test state.\n   753→        mocker: Pytest Mocker object.\n   754→        router_data: The router data fixture.\n   755→    \"\"\"\n   756→    mocker.patch.object(test_state, \"router_data\", router_data)\n   757→\n   758→    assert test_state.get_token() == \"b181904c-3953-4a79-dc18-ae9518c22f05\"\n   759→\n   760→\n   761→def test_get_sid(test_state, mocker, router_data):\n   762→    \"\"\"Test getting session id.\n   763→\n   764→    Args:\n   765→        test_state: A state.\n   766→        mocker: Pytest Mocker object.\n   767→        router_data: The router data fixture.\n   768→    \"\"\"\n   769→    mocker.patch.object(test_state, \"router_data\", router_data)\n   770→\n   771→    assert test_state.get_sid() == \"9fpxSzPb9aFMb4wFAAAH\"\n   772→\n   773→\n   774→def test_get_headers(test_state, mocker, router_data, router_data_headers):\n   775→    \"\"\"Test getting client headers.\n   776→\n   777→    Args:\n   778→        test_state: A state.\n   779→        mocker: Pytest Mocker object.\n   780→        router_data: The router data fixture.\n   781→        router_data_headers: The expected headers.\n   782→    \"\"\"\n   783→    mocker.patch.object(test_state, \"router_data\", router_data)\n   784→\n   785→    assert test_state.get_headers() == router_data_headers\n   786→\n   787→\n   788→def test_get_client_ip(test_state, mocker, router_data):\n   789→    \"\"\"Test getting client IP.\n   790→\n   791→    Args:\n   792→        test_state: A state.\n   793→        mocker: Pytest Mocker object.\n   794→        router_data: The router data fixture.\n   795→    \"\"\"\n   796→    mocker.patch.object(test_state, \"router_data\", router_data)\n   797→\n   798→    assert test_state.get_client_ip() == \"127.0.0.1\"\n   799→\n   800→\n   801→def test_get_cookies(test_state, mocker, router_data):\n   802→    \"\"\"Test getting client cookies.\n   803→\n   804→    Args:\n   805→        test_state: A state.\n   806→        mocker: Pytest Mocker object.\n   807→        router_data: The router data fixture.\n   808→    \"\"\"\n   809→    mocker.patch.object(test_state, \"router_data\", router_data)\n   810→\n   811→    assert test_state.get_cookies() == {\n   812→        \"csrftoken\": \"mocktoken\",\n   813→        \"name\": \"reflex\",\n   814→        \"list_cookies\": [\"some\", \"random\", \"cookies\"],\n   815→        \"dict_cookies\": {\"name\": \"reflex\"},\n   816→        \"val\": True,\n   817→    }\n   818→\n   819→\n   820→def test_get_current_page(test_state):\n   821→    assert test_state.get_current_page() == \"\"\n   822→\n   823→    route = \"mypage/subpage\"\n   824→    test_state.router = RouterData({RouteVar.PATH: route})\n   825→\n   826→    assert test_state.get_current_page() == route\n   827→\n   828→\n   829→def test_get_query_params(test_state):\n   830→    assert test_state.get_query_params() == {}\n   831→\n   832→    params = {\"p1\": \"a\", \"p2\": \"b\"}\n   833→    test_state.router_data = {RouteVar.QUERY: params}\n   834→\n   835→    assert test_state.get_query_params() == params\n   836→\n   837→\n   838→def test_add_var():\n   839→    class DynamicState(BaseState):\n   840→        pass\n   841→\n   842→    ds1 = DynamicState()\n   843→    assert \"dynamic_int\" not in ds1.__dict__\n   844→    assert not hasattr(ds1, \"dynamic_int\")\n   845→    ds1.add_var(\"dynamic_int\", int, 42)\n   846→    # Existing instances get the BaseVar\n   847→    assert ds1.dynamic_int.equals(DynamicState.dynamic_int)  # type: ignore\n   848→    # New instances get an actual value with the default\n   849→    assert DynamicState().dynamic_int == 42\n   850→\n   851→    ds1.add_var(\"dynamic_list\", List[int], [5, 10])\n   852→    assert ds1.dynamic_list.equals(DynamicState.dynamic_list)  # type: ignore\n   853→    ds2 = DynamicState()\n   854→    assert ds2.dynamic_list == [5, 10]\n   855→    ds2.dynamic_list.append(15)\n   856→    assert ds2.dynamic_list == [5, 10, 15]\n   857→    assert DynamicState().dynamic_list == [5, 10]\n   858→\n   859→    ds1.add_var(\"dynamic_dict\", Dict[str, int], {\"k1\": 5, \"k2\": 10})\n   860→    assert ds1.dynamic_dict.equals(DynamicState.dynamic_dict)  # type: ignore\n   861→    assert ds2.dynamic_dict.equals(DynamicState.dynamic_dict)  # type: ignore\n   862→    assert DynamicState().dynamic_dict == {\"k1\": 5, \"k2\": 10}\n   863→    assert DynamicState().dynamic_dict == {\"k1\": 5, \"k2\": 10}\n   864→\n   865→\n   866→def test_add_var_default_handlers(test_state):\n   867→    test_state.add_var(\"rand_int\", int, 10)\n   868→    assert \"set_rand_int\" in test_state.event_handlers\n   869→    assert isinstance(test_state.event_handlers[\"set_rand_int\"], EventHandler)\n   870→\n   871→\n   872→class InterdependentState(BaseState):\n   873→    \"\"\"A state with 3 vars and 3 computed vars.\n   874→\n   875→    x: a variable that no computed var depends on\n   876→    v1: a varable that one computed var directly depeneds on\n   877→    _v2: a backend variable that one computed var directly depends on\n   878→\n   879→    v1x2: a computed var that depends on v1\n   880→    v2x2: a computed var that depends on backend var _v2\n   881→    v1x2x2: a computed var that depends on computed var v1x2\n   882→    \"\"\"\n   883→\n   884→    x: int = 0\n   885→    v1: int = 0\n   886→    _v2: int = 1\n   887→\n   888→    @rx.cached_var\n   889→    def v1x2(self) -> int:\n   890→        \"\"\"Depends on var v1.\n   891→\n   892→        Returns:\n   893→            Var v1 multiplied by 2\n   894→        \"\"\"\n   895→        return self.v1 * 2\n   896→\n   897→    @rx.cached_var\n   898→    def v2x2(self) -> int:\n   899→        \"\"\"Depends on backend var _v2.\n   900→\n   901→        Returns:\n   902→            backend var _v2 multiplied by 2\n   903→        \"\"\"\n   904→        return self._v2 * 2\n   905→\n   906→    @rx.cached_var\n   907→    def v1x2x2(self) -> int:\n   908→        \"\"\"Depends on ComputedVar v1x2.\n   909→\n   910→        Returns:\n   911→            ComputedVar v1x2 multiplied by 2\n   912→        \"\"\"\n   913→        return self.v1x2 * 2  # type: ignore\n   914→\n   915→\n   916→@pytest.fixture\n   917→def interdependent_state() -> BaseState:\n   918→    \"\"\"A state with varying dependency between vars.\n   919→\n   920→    Returns:\n   921→        instance of InterdependentState\n   922→    \"\"\"\n   923→    s = InterdependentState()\n   924→    s.dict()  # prime initial relationships by accessing all ComputedVars\n   925→    return s\n   926→\n   927→\n   928→def test_not_dirty_computed_var_from_var(interdependent_state):\n   929→    \"\"\"Set Var that no ComputedVar depends on, expect no recalculation.\n   930→\n   931→    Args:\n   932→        interdependent_state: A state with varying Var dependencies.\n   933→    \"\"\"\n   934→    interdependent_state.x = 5\n   935→    assert interdependent_state.get_delta() == {\n   936→        interdependent_state.get_full_name(): {\"x\": 5},\n   937→    }\n   938→\n   939→\n   940→def test_dirty_computed_var_from_var(interdependent_state):\n   941→    \"\"\"Set Var that ComputedVar depends on, expect recalculation.\n   942→\n   943→    The other ComputedVar depends on the changed ComputedVar and should also be\n   944→    recalculated. No other ComputedVars should be recalculated.\n   945→\n   946→    Args:\n   947→        interdependent_state: A state with varying Var dependencies.\n   948→    \"\"\"\n   949→    interdependent_state.v1 = 1\n   950→    assert interdependent_state.get_delta() == {\n   951→        interdependent_state.get_full_name(): {\"v1\": 1, \"v1x2\": 2, \"v1x2x2\": 4},\n   952→    }\n   953→\n   954→\n   955→def test_dirty_computed_var_from_backend_var(interdependent_state):\n   956→    \"\"\"Set backend var that ComputedVar depends on, expect recalculation.\n   957→\n   958→    Args:\n   959→        interdependent_state: A state with varying Var dependencies.\n   960→    \"\"\"\n   961→    interdependent_state._v2 = 2\n   962→    assert interdependent_state.get_delta() == {\n   963→        interdependent_state.get_full_name(): {\"v2x2\": 4},\n   964→    }\n   965→\n   966→\n   967→def test_per_state_backend_var(interdependent_state):\n   968→    \"\"\"Set backend var on one instance, expect no affect in other instances.\n   969→\n   970→    Args:\n   971→        interdependent_state: A state with varying Var dependencies.\n   972→    \"\"\"\n   973→    s2 = InterdependentState()\n   974→    assert s2._v2 == interdependent_state._v2\n   975→    interdependent_state._v2 = 2\n   976→    assert s2._v2 != interdependent_state._v2\n   977→    s3 = InterdependentState()\n   978→    assert s3._v2 != interdependent_state._v2\n   979→    # both s2 and s3 should still have the default value\n   980→    assert s2._v2 == s3._v2\n   981→    # changing s2._v2 should not affect others\n   982→    s2._v2 = 4\n   983→    assert s2._v2 != interdependent_state._v2\n   984→    assert s2._v2 != s3._v2\n   985→\n   986→\n   987→def test_child_state():\n   988→    \"\"\"Test that the child state computed vars can reference parent state vars.\"\"\"\n   989→\n   990→    class MainState(BaseState):\n   991→        v: int = 2\n   992→\n   993→    class ChildState(MainState):\n   994→        @ComputedVar\n   995→        def rendered_var(self):\n   996→            return self.v\n   997→\n   998→    ms = MainState()\n   999→    cs = ms.substates[ChildState.get_name()]\n  1000→    assert ms.v == 2\n  1001→    assert cs.v == 2\n  1002→    assert cs.rendered_var == 2\n  1003→\n  1004→\n  1005→def test_conditional_computed_vars():\n  1006→    \"\"\"Test that computed vars can have conditionals.\"\"\"\n  1007→\n  1008→    class MainState(BaseState):\n  1009→        flag: bool = False\n  1010→        t1: str = \"a\"\n  1011→        t2: str = \"b\"\n  1012→\n  1013→        @ComputedVar\n  1014→        def rendered_var(self) -> str:\n  1015→            if self.flag:\n  1016→                return self.t1\n  1017→            return self.t2\n  1018→\n  1019→    ms = MainState()\n  1020→    # Initially there are no dirty computed vars.\n  1021→    assert ms._dirty_computed_vars(from_vars={\"flag\"}) == {\"rendered_var\"}\n  1022→    assert ms._dirty_computed_vars(from_vars={\"t2\"}) == {\"rendered_var\"}\n  1023→    assert ms._dirty_computed_vars(from_vars={\"t1\"}) == {\"rendered_var\"}\n  1024→    assert ms.computed_vars[\"rendered_var\"]._deps(objclass=MainState) == {\n  1025→        \"flag\",\n  1026→        \"t1\",\n  1027→        \"t2\",\n  1028→    }\n  1029→\n  1030→\n  1031→def test_event_handlers_convert_to_fns(test_state, child_state):\n  1032→    \"\"\"Test that when the state is initialized, event handlers are converted to fns.\n  1033→\n  1034→    Args:\n  1035→        test_state: A state with event handlers.\n  1036→        child_state: A child state with event handlers.\n  1037→    \"\"\"\n  1038→    # The class instances should be event handlers.\n  1039→    assert isinstance(TestState.do_something, EventHandler)\n  1040→    assert isinstance(ChildState.change_both, EventHandler)\n  1041→\n  1042→    # The object instances should be fns.\n  1043→    test_state.do_something()\n  1044→\n  1045→    child_state.change_both(value=\"goose\", count=9)\n  1046→    assert child_state.value == \"GOOSE\"\n  1047→    assert child_state.count == 18\n  1048→\n  1049→\n  1050→def test_event_handlers_call_other_handlers():\n  1051→    \"\"\"Test that event handlers can call other event handlers.\"\"\"\n  1052→\n  1053→    class MainState(BaseState):\n  1054→        v: int = 0\n  1055→\n  1056→        def set_v(self, v: int):\n  1057→            self.v = v\n  1058→\n  1059→        def set_v2(self, v: int):\n  1060→            self.set_v(v)\n  1061→\n  1062→    class SubState(MainState):\n  1063→        def set_v3(self, v: int):\n  1064→            self.set_v2(v)\n  1065→\n  1066→    ms = MainState()\n  1067→    ms.set_v2(1)\n  1068→    assert ms.v == 1\n  1069→\n  1070→    # ensure handler can be called from substate\n  1071→    ms.substates[SubState.get_name()].set_v3(2)\n  1072→    assert ms.v == 2\n  1073→\n  1074→\n  1075→def test_computed_var_cached():\n  1076→    \"\"\"Test that a ComputedVar doesn't recalculate when accessed.\"\"\"\n  1077→    comp_v_calls = 0\n  1078→\n  1079→    class ComputedState(BaseState):\n  1080→        v: int = 0\n  1081→\n  1082→        @rx.cached_var\n  1083→        def comp_v(self) -> int:\n  1084→            nonlocal comp_v_calls\n  1085→            comp_v_calls += 1\n  1086→            return self.v\n  1087→\n  1088→    cs = ComputedState()\n  1089→    assert cs.dict()[cs.get_full_name()][\"v\"] == 0\n  1090→    assert comp_v_calls == 1\n  1091→    assert cs.dict()[cs.get_full_name()][\"comp_v\"] == 0\n  1092→    assert comp_v_calls == 1\n  1093→    assert cs.comp_v == 0\n  1094→    assert comp_v_calls == 1\n  1095→    cs.v = 1\n  1096→    assert comp_v_calls == 1\n  1097→    assert cs.comp_v == 1\n  1098→    assert comp_v_calls == 2\n  1099→\n  1100→\n  1101→def test_computed_var_cached_depends_on_non_cached():\n  1102→    \"\"\"Test that a cached_var is recalculated if it depends on non-cached ComputedVar.\"\"\"\n  1103→\n  1104→    class ComputedState(BaseState):\n  1105→        v: int = 0\n  1106→\n  1107→        @rx.var\n  1108→        def no_cache_v(self) -> int:\n  1109→            return self.v\n  1110→\n  1111→        @rx.cached_var\n  1112→        def dep_v(self) -> int:\n  1113→            return self.no_cache_v  # type: ignore\n  1114→\n  1115→        @rx.cached_var\n  1116→        def comp_v(self) -> int:\n  1117→            return self.v\n  1118→\n  1119→    cs = ComputedState()\n  1120→    assert cs.dirty_vars == set()\n  1121→    assert cs.get_delta() == {cs.get_name(): {\"no_cache_v\": 0, \"dep_v\": 0}}\n  1122→    cs._clean()\n  1123→    assert cs.dirty_vars == set()\n  1124→    assert cs.get_delta() == {cs.get_name(): {\"no_cache_v\": 0, \"dep_v\": 0}}\n  1125→    cs._clean()\n  1126→    assert cs.dirty_vars == set()\n  1127→    cs.v = 1\n  1128→    assert cs.dirty_vars == {\"v\", \"comp_v\", \"dep_v\", \"no_cache_v\"}\n  1129→    assert cs.get_delta() == {\n  1130→        cs.get_name(): {\"v\": 1, \"no_cache_v\": 1, \"dep_v\": 1, \"comp_v\": 1}\n  1131→    }\n  1132→    cs._clean()\n  1133→    assert cs.dirty_vars == set()\n  1134→    assert cs.get_delta() == {cs.get_name(): {\"no_cache_v\": 1, \"dep_v\": 1}}\n  1135→    cs._clean()\n  1136→    assert cs.dirty_vars == set()\n  1137→    assert cs.get_delta() == {cs.get_name(): {\"no_cache_v\": 1, \"dep_v\": 1}}\n  1138→    cs._clean()\n  1139→    assert cs.dirty_vars == set()\n  1140→\n  1141→\n  1142→def test_computed_var_depends_on_parent_non_cached():\n  1143→    \"\"\"Child state cached_var that depends on parent state un cached var is always recalculated.\"\"\"\n  1144→    counter = 0\n  1145→\n  1146→    class ParentState(BaseState):\n  1147→        @rx.var\n  1148→        def no_cache_v(self) -> int:\n  1149→            nonlocal counter\n  1150→            counter += 1\n  1151→            return counter\n  1152→\n  1153→    class ChildState(ParentState):\n  1154→        @rx.cached_var\n  1155→        def dep_v(self) -> int:\n  1156→            return self.no_cache_v  # type: ignore\n  1157→\n  1158→    ps = ParentState()\n  1159→    cs = ps.substates[ChildState.get_name()]\n  1160→\n  1161→    assert ps.dirty_vars == set()\n  1162→    assert cs.dirty_vars == set()\n  1163→\n  1164→    dict1 = ps.dict()\n  1165→    assert dict1[ps.get_full_name()] == {\n  1166→        \"no_cache_v\": 1,\n  1167→        \"router\": formatted_router,\n  1168→    }\n  1169→    assert dict1[cs.get_full_name()] == {\"dep_v\": 2}\n  1170→    dict2 = ps.dict()\n  1171→    assert dict2[ps.get_full_name()] == {\n  1172→        \"no_cache_v\": 3,\n  1173→        \"router\": formatted_router,\n  1174→    }\n  1175→    assert dict2[cs.get_full_name()] == {\"dep_v\": 4}\n  1176→    dict3 = ps.dict()\n  1177→    assert dict3[ps.get_full_name()] == {\n  1178→        \"no_cache_v\": 5,\n  1179→        \"router\": formatted_router,\n  1180→    }\n  1181→    assert dict3[cs.get_full_name()] == {\"dep_v\": 6}\n  1182→    assert counter == 6\n  1183→\n  1184→\n  1185→@pytest.mark.parametrize(\"use_partial\", [True, False])\n  1186→def test_cached_var_depends_on_event_handler(use_partial: bool):\n  1187→    \"\"\"A cached_var that calls an event handler calculates deps correctly.\n  1188→\n  1189→    Args:\n  1190→        use_partial: if true, replace the EventHandler with functools.partial\n  1191→    \"\"\"\n  1192→    counter = 0\n  1193→\n  1194→    class HandlerState(BaseState):\n  1195→        x: int = 42\n  1196→\n  1197→        def handler(self):\n  1198→            self.x = self.x + 1\n  1199→\n  1200→        @rx.cached_var\n  1201→        def cached_x_side_effect(self) -> int:\n  1202→            self.handler()\n  1203→            nonlocal counter\n  1204→            counter += 1\n  1205→            return counter\n  1206→\n  1207→    if use_partial:\n  1208→        HandlerState.handler = functools.partial(HandlerState.handler.fn)\n  1209→        assert isinstance(HandlerState.handler, functools.partial)\n  1210→    else:\n  1211→        assert isinstance(HandlerState.handler, EventHandler)\n  1212→\n  1213→    s = HandlerState()\n  1214→    assert \"cached_x_side_effect\" in s._computed_var_dependencies[\"x\"]\n  1215→    assert s.cached_x_side_effect == 1\n  1216→    assert s.x == 43\n  1217→    s.handler()\n  1218→    assert s.cached_x_side_effect == 2\n  1219→    assert s.x == 45\n  1220→\n  1221→\n  1222→def test_computed_var_dependencies():\n  1223→    \"\"\"Test that a ComputedVar correctly tracks its dependencies.\"\"\"\n  1224→\n  1225→    class ComputedState(BaseState):\n  1226→        v: int = 0\n  1227→        w: int = 0\n  1228→        x: int = 0\n  1229→        y: List[int] = [1, 2, 3]\n  1230→        _z: List[int] = [1, 2, 3]\n  1231→\n  1232→        @rx.cached_var\n  1233→        def comp_v(self) -> int:\n  1234→            \"\"\"Direct access.\n  1235→\n  1236→            Returns:\n  1237→                The value of self.v.\n  1238→            \"\"\"\n  1239→            return self.v\n  1240→\n  1241→        @rx.cached_var\n  1242→        def comp_w(self):\n  1243→            \"\"\"Nested lambda.\n  1244→\n  1245→            Returns:\n  1246→                A lambda that returns the value of self.w.\n  1247→            \"\"\"\n  1248→            return lambda: self.w\n  1249→\n  1250→        @rx.cached_var\n  1251→        def comp_x(self):\n  1252→            \"\"\"Nested function.\n  1253→\n  1254→            Returns:\n  1255→                A function that returns the value of self.x.\n  1256→            \"\"\"\n  1257→\n  1258→            def _():\n  1259→                return self.x\n  1260→\n  1261→            return _\n  1262→\n  1263→        @rx.cached_var\n  1264→        def comp_y(self) -> List[int]:\n  1265→            \"\"\"Comprehension iterating over attribute.\n  1266→\n  1267→            Returns:\n  1268→                A list of the values of self.y.\n  1269→            \"\"\"\n  1270→            return [round(y) for y in self.y]\n  1271→\n  1272→        @rx.cached_var\n  1273→        def comp_z(self) -> List[bool]:\n  1274→            \"\"\"Comprehension accesses attribute.\n  1275→\n  1276→            Returns:\n  1277→                A list of whether the values 0-4 are in self._z.\n  1278→            \"\"\"\n  1279→            return [z in self._z for z in range(5)]\n  1280→\n  1281→    cs = ComputedState()\n  1282→    assert cs._computed_var_dependencies[\"v\"] == {\"comp_v\"}\n  1283→    assert cs._computed_var_dependencies[\"w\"] == {\"comp_w\"}\n  1284→    assert cs._computed_var_dependencies[\"x\"] == {\"comp_x\"}\n  1285→    assert cs._computed_var_dependencies[\"y\"] == {\"comp_y\"}\n  1286→    assert cs._computed_var_dependencies[\"_z\"] == {\"comp_z\"}\n  1287→\n  1288→\n  1289→def test_backend_method():\n  1290→    \"\"\"A method with leading underscore should be callable from event handler.\"\"\"\n  1291→\n  1292→    class BackendMethodState(BaseState):\n  1293→        def _be_method(self):\n  1294→            return True\n  1295→\n  1296→        def handler(self):\n  1297→            assert self._be_method()\n  1298→\n  1299→    bms = BackendMethodState()\n  1300→    bms.handler()\n  1301→    assert bms._be_method()\n  1302→\n  1303→\n  1304→def test_setattr_of_mutable_types(mutable_state):\n  1305→    \"\"\"Test that mutable types are converted to corresponding Reflex wrappers.\n  1306→\n  1307→    Args:\n  1308→        mutable_state: A test state.\n  1309→    \"\"\"\n  1310→    array = mutable_state.array\n  1311→    hashmap = mutable_state.hashmap\n  1312→    test_set = mutable_state.test_set\n  1313→\n  1314→    assert isinstance(array, MutableProxy)\n  1315→    assert isinstance(array, list)\n  1316→    assert isinstance(array[1], MutableProxy)\n  1317→    assert isinstance(array[1], list)\n  1318→    assert isinstance(array[2], MutableProxy)\n  1319→    assert isinstance(array[2], dict)\n  1320→\n  1321→    assert isinstance(hashmap, MutableProxy)\n  1322→    assert isinstance(hashmap, dict)\n  1323→    assert isinstance(hashmap[\"key\"], MutableProxy)\n  1324→    assert isinstance(hashmap[\"key\"], list)\n  1325→    assert isinstance(hashmap[\"third_key\"], MutableProxy)\n  1326→    assert isinstance(hashmap[\"third_key\"], dict)\n  1327→\n  1328→    assert isinstance(test_set, MutableProxy)\n  1329→    assert isinstance(test_set, set)\n  1330→\n  1331→    assert isinstance(mutable_state.custom, MutableProxy)\n  1332→    assert isinstance(mutable_state.custom.array, MutableProxy)\n  1333→    assert isinstance(mutable_state.custom.array, list)\n  1334→    assert isinstance(mutable_state.custom.hashmap, MutableProxy)\n  1335→    assert isinstance(mutable_state.custom.hashmap, dict)\n  1336→    assert isinstance(mutable_state.custom.test_set, MutableProxy)\n  1337→    assert isinstance(mutable_state.custom.test_set, set)\n  1338→    assert isinstance(mutable_state.custom.custom, MutableProxy)\n  1339→\n  1340→    mutable_state.reassign_mutables()\n  1341→\n  1342→    array = mutable_state.array\n  1343→    hashmap = mutable_state.hashmap\n  1344→    test_set = mutable_state.test_set\n  1345→\n  1346→    assert isinstance(array, MutableProxy)\n  1347→    assert isinstance(array, list)\n  1348→    assert isinstance(array[1], MutableProxy)\n  1349→    assert isinstance(array[1], list)\n  1350→    assert isinstance(array[2], MutableProxy)\n  1351→    assert isinstance(array[2], dict)\n  1352→\n  1353→    assert isinstance(hashmap, MutableProxy)\n  1354→    assert isinstance(hashmap, dict)\n  1355→    assert isinstance(hashmap[\"mod_key\"], MutableProxy)\n  1356→    assert isinstance(hashmap[\"mod_key\"], list)\n  1357→    assert isinstance(hashmap[\"mod_third_key\"], MutableProxy)\n  1358→    assert isinstance(hashmap[\"mod_third_key\"], dict)\n  1359→\n  1360→    assert isinstance(test_set, MutableProxy)\n  1361→    assert isinstance(test_set, set)\n  1362→\n  1363→\n  1364→def test_error_on_state_method_shadow():\n  1365→    \"\"\"Test that an error is thrown when an event handler shadows a state method.\"\"\"\n  1366→    with pytest.raises(NameError) as err:\n  1367→\n  1368→        class InvalidTest(BaseState):\n  1369→            def reset(self):\n  1370→                pass\n  1371→\n  1372→    assert (\n  1373→        err.value.args[0]\n  1374→        == f\"The event handler name `reset` shadows a builtin State method; use a different name instead\"\n  1375→    )\n  1376→\n  1377→\n  1378→@pytest.mark.asyncio\n  1379→async def test_state_with_invalid_yield(capsys):\n  1380→    \"\"\"Test that an error is thrown when a state yields an invalid value.\n  1381→\n  1382→    Args:\n  1383→        capsys: Pytest fixture for capture standard streams.\n  1384→    \"\"\"\n  1385→\n  1386→    class StateWithInvalidYield(BaseState):\n  1387→        \"\"\"A state that yields an invalid value.\"\"\"\n  1388→\n  1389→        def invalid_handler(self):\n  1390→            \"\"\"Invalid handler.\n  1391→\n  1392→            Yields:\n  1393→                an invalid value.\n  1394→            \"\"\"\n  1395→            yield 1\n  1396→\n  1397→    invalid_state = StateWithInvalidYield()\n  1398→    async for update in invalid_state._process(\n  1399→        rx.event.Event(token=\"fake_token\", name=\"invalid_handler\")\n  1400→    ):\n  1401→        assert not update.delta\n  1402→        assert update.events == rx.event.fix_events(\n  1403→            [rx.window_alert(\"An error occurred. See logs for details.\")],\n  1404→            token=\"\",\n  1405→        )\n  1406→    captured = capsys.readouterr()\n  1407→    assert \"must only return/yield: None, Events or other EventHandlers\" in captured.out\n  1408→\n  1409→\n  1410→@pytest.fixture(scope=\"function\", params=[\"in_process\", \"redis\"])\n  1411→def state_manager(request) -> Generator[StateManager, None, None]:\n  1412→    \"\"\"Instance of state manager parametrized for redis and in-process.\n  1413→\n  1414→    Args:\n  1415→        request: pytest request object.\n  1416→\n  1417→    Yields:\n  1418→        A state manager instance\n  1419→    \"\"\"\n  1420→    state_manager = StateManager.create(state=TestState)\n  1421→    if request.param == \"redis\":\n  1422→        if not isinstance(state_manager, StateManagerRedis):\n  1423→            pytest.skip(\"Test requires redis\")\n  1424→    else:\n  1425→        # explicitly NOT using redis\n  1426→        state_manager = StateManagerMemory(state=TestState)\n  1427→        assert not state_manager._states_locks\n  1428→\n  1429→    yield state_manager\n  1430→\n  1431→    if isinstance(state_manager, StateManagerRedis):\n  1432→        asyncio.get_event_loop().run_until_complete(state_manager.close())\n  1433→\n  1434→\n  1435→@pytest.mark.asyncio\n  1436→async def test_state_manager_modify_state(state_manager: StateManager, token: str):\n  1437→    \"\"\"Test that the state manager can modify a state exclusively.\n  1438→\n  1439→    Args:\n  1440→        state_manager: A state manager instance.\n  1441→        token: A token.\n  1442→    \"\"\"\n  1443→    async with state_manager.modify_state(token):\n  1444→        if isinstance(state_manager, StateManagerRedis):\n  1445→            assert await state_manager.redis.get(f\"{token}_lock\")\n  1446→        elif isinstance(state_manager, StateManagerMemory):\n  1447→            assert token in state_manager._states_locks\n  1448→            assert state_manager._states_locks[token].locked()\n  1449→    # lock should be dropped after exiting the context\n  1450→    if isinstance(state_manager, StateManagerRedis):\n  1451→        assert (await state_manager.redis.get(f\"{token}_lock\")) is None\n  1452→    elif isinstance(state_manager, StateManagerMemory):\n  1453→        assert not state_manager._states_locks[token].locked()\n  1454→\n  1455→        # separate instances should NOT share locks\n  1456→        sm2 = StateManagerMemory(state=TestState)\n  1457→        assert sm2._state_manager_lock is state_manager._state_manager_lock\n  1458→        assert not sm2._states_locks\n  1459→        if state_manager._states_locks:\n  1460→            assert sm2._states_locks != state_manager._states_locks\n  1461→\n  1462→\n  1463→@pytest.mark.asyncio\n  1464→async def test_state_manager_contend(state_manager: StateManager, token: str):\n  1465→    \"\"\"Multiple coroutines attempting to access the same state.\n  1466→\n  1467→    Args:\n  1468→        state_manager: A state manager instance.\n  1469→        token: A token.\n  1470→    \"\"\"\n  1471→    n_coroutines = 10\n  1472→    exp_num1 = 10\n  1473→\n  1474→    async with state_manager.modify_state(token) as state:\n  1475→        state.num1 = 0\n  1476→\n  1477→    async def _coro():\n  1478→        async with state_manager.modify_state(token) as state:\n  1479→            await asyncio.sleep(0.01)\n  1480→            state.num1 += 1\n  1481→\n  1482→    tasks = [asyncio.create_task(_coro()) for _ in range(n_coroutines)]\n  1483→\n  1484→    for f in asyncio.as_completed(tasks):\n  1485→        await f\n  1486→\n  1487→    assert (await state_manager.get_state(token)).num1 == exp_num1\n  1488→\n  1489→    if isinstance(state_manager, StateManagerRedis):\n  1490→        assert (await state_manager.redis.get(f\"{token}_lock\")) is None\n  1491→    elif isinstance(state_manager, StateManagerMemory):\n  1492→        assert token in state_manager._states_locks\n  1493→        assert not state_manager._states_locks[token].locked()\n  1494→\n  1495→\n  1496→@pytest.fixture(scope=\"function\")\n  1497→def state_manager_redis() -> Generator[StateManager, None, None]:\n  1498→    \"\"\"Instance of state manager for redis only.\n  1499→\n  1500→    Yields:\n  1501→        A state manager instance\n  1502→    \"\"\"\n  1503→    state_manager = StateManager.create(TestState)\n  1504→\n  1505→    if not isinstance(state_manager, StateManagerRedis):\n  1506→        pytest.skip(\"Test requires redis\")\n  1507→\n  1508→    yield state_manager\n  1509→\n  1510→    asyncio.get_event_loop().run_until_complete(state_manager.close())\n  1511→\n  1512→\n  1513→@pytest.mark.asyncio\n  1514→async def test_state_manager_lock_expire(state_manager_redis: StateManager, token: str):\n  1515→    \"\"\"Test that the state manager lock expires and raises exception exiting context.\n  1516→\n  1517→    Args:\n  1518→        state_manager_redis: A state manager instance.\n  1519→        token: A token.\n  1520→    \"\"\"\n  1521→    state_manager_redis.lock_expiration = LOCK_EXPIRATION\n  1522→\n  1523→    async with state_manager_redis.modify_state(token):\n  1524→        await asyncio.sleep(0.01)\n  1525→\n  1526→    with pytest.raises(LockExpiredError):\n  1527→        async with state_manager_redis.modify_state(token):\n  1528→            await asyncio.sleep(LOCK_EXPIRE_SLEEP)\n  1529→\n  1530→\n  1531→@pytest.mark.asyncio\n  1532→async def test_state_manager_lock_expire_contend(\n  1533→    state_manager_redis: StateManager, token: str\n  1534→):\n  1535→    \"\"\"Test that the state manager lock expires and queued waiters proceed.\n  1536→\n  1537→    Args:\n  1538→        state_manager_redis: A state manager instance.\n  1539→        token: A token.\n  1540→    \"\"\"\n  1541→    exp_num1 = 4252\n  1542→    unexp_num1 = 666\n  1543→\n  1544→    state_manager_redis.lock_expiration = LOCK_EXPIRATION\n  1545→\n  1546→    order = []\n  1547→\n  1548→    async def _coro_blocker():\n  1549→        async with state_manager_redis.modify_state(token) as state:\n  1550→            order.append(\"blocker\")\n  1551→            await asyncio.sleep(LOCK_EXPIRE_SLEEP)\n  1552→            state.num1 = unexp_num1\n  1553→\n  1554→    async def _coro_waiter():\n  1555→        while \"blocker\" not in order:\n  1556→            await asyncio.sleep(0.005)\n  1557→        async with state_manager_redis.modify_state(token) as state:\n  1558→            order.append(\"waiter\")\n  1559→            assert state.num1 != unexp_num1\n  1560→            state.num1 = exp_num1\n  1561→\n  1562→    tasks = [\n  1563→        asyncio.create_task(_coro_blocker()),\n  1564→        asyncio.create_task(_coro_waiter()),\n  1565→    ]\n  1566→    with pytest.raises(LockExpiredError):\n  1567→        await tasks[0]\n  1568→    await tasks[1]\n  1569→\n  1570→    assert order == [\"blocker\", \"waiter\"]\n  1571→    assert (await state_manager_redis.get_state(token)).num1 == exp_num1\n  1572→\n  1573→\n  1574→@pytest.fixture(scope=\"function\")\n  1575→def mock_app(monkeypatch, state_manager: StateManager) -> rx.App:\n  1576→    \"\"\"Mock app fixture.\n  1577→\n  1578→    Args:\n  1579→        monkeypatch: Pytest monkeypatch object.\n  1580→        state_manager: A state manager.\n  1581→\n  1582→    Returns:\n  1583→        The app, after mocking out prerequisites.get_app()\n  1584→    \"\"\"\n  1585→    app = App(state=TestState)\n  1586→\n  1587→    app_module = Mock()\n  1588→\n  1589→    setattr(app_module, CompileVars.APP, app)\n  1590→    app.state = TestState\n  1591→    app._state_manager = state_manager\n  1592→    app.event_namespace.emit = AsyncMock()  # type: ignore\n  1593→\n  1594→    def _mock_get_app(*args, **kwargs):\n  1595→        return app_module\n  1596→\n  1597→    monkeypatch.setattr(prerequisites, \"get_app\", _mock_get_app)\n  1598→    return app\n  1599→\n  1600→\n  1601→@pytest.mark.asyncio\n  1602→async def test_state_proxy(grandchild_state: GrandchildState, mock_app: rx.App):\n  1603→    \"\"\"Test that the state proxy works.\n  1604→\n  1605→    Args:\n  1606→        grandchild_state: A grandchild state.\n  1607→        mock_app: An app that will be returned by `get_app()`\n  1608→    \"\"\"\n  1609→    child_state = grandchild_state.parent_state\n  1610→    assert child_state is not None\n  1611→    parent_state = child_state.parent_state\n  1612→    assert parent_state is not None\n  1613→    if isinstance(mock_app.state_manager, StateManagerMemory):\n  1614→        mock_app.state_manager.states[parent_state.get_token()] = parent_state\n  1615→\n  1616→    sp = StateProxy(grandchild_state)\n  1617→    assert sp.__wrapped__ == grandchild_state\n  1618→    assert sp._self_substate_path == grandchild_state.get_full_name().split(\".\")\n  1619→    assert sp._self_app is mock_app\n  1620→    assert not sp._self_mutable\n  1621→    assert sp._self_actx is None\n  1622→\n  1623→    # cannot use normal contextmanager protocol\n  1624→    with pytest.raises(TypeError), sp:\n  1625→        pass\n  1626→\n  1627→    with pytest.raises(ImmutableStateError):\n  1628→        # cannot directly modify state proxy outside of async context\n  1629→        sp.value2 = 16\n  1630→\n  1631→    async with sp:\n  1632→        assert sp._self_actx is not None\n  1633→        assert sp._self_mutable  # proxy is mutable inside context\n  1634→        if isinstance(mock_app.state_manager, StateManagerMemory):\n  1635→            # For in-process store, only one instance of the state exists\n  1636→            assert sp.__wrapped__ is grandchild_state\n  1637→        else:\n  1638→            # When redis is used, a new+updated instance is assigned to the proxy