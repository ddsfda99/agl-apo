diff --git a/src/cfnlint/rules/parameters/Used.py b/src/cfnlint/rules/parameters/Used.py
index b0f6a0033..1692c4bd4 100644
--- a/src/cfnlint/rules/parameters/Used.py
+++ b/src/cfnlint/rules/parameters/Used.py
@@ -22,6 +22,27 @@ class Used(CloudFormationLintRule):
     def match(self, cfn: Template) -> RuleMatches:
         matches: RuleMatches = []
 
+        # If the template uses AWS::Include via Fn::Transform, parameters may be
+        # referenced in the included file which we cannot analyze here. Avoid
+        # false positives by disabling this check in that scenario.
+        try:
+            for t in cfn.search_deep_keys("Fn::Transform"):
+                value = t[-1]
+                if isinstance(value, dict):
+                    name = value.get("Name")
+                    if isinstance(name, str) and name == "AWS::Include":
+                        self.logger.debug(
+                            (
+                                "Template uses Fn::Transform with AWS::Include. "
+                                "Disabling check %s to avoid false positives."
+                            ),
+                            self.id,
+                        )
+                        return matches
+        except Exception:  # pylint: disable=broad-except
+            # If any unexpected structure prevents checking, fall back to normal processing
+            pass
+
         le_refs = None
         if cfn.has_language_extensions_transform():
             le_refs = cfn.search_deep_keys("Ref")
