@@ -144,6 +144,16 @@ def test_from_wkt_none():
     assert shapely.from_wkt(None) is None
 
 
+def test_from_wkt_fix_structure_unclosed_ring():
+    bad = "POLYGON ((0 0, 1 0, 1 1, 0 1))"
+    # default strict behavior: raises
+    with pytest.raises(shapely.GEOSException, match="LinearRing.*closed|Points of LinearRing do not form a closed linestring|do not form a closed"):
+        shapely.wkt.loads(bad)
+    # with fix_structure=True: succeeds and ring is closed
+    geom = shapely.wkt.loads(bad, fix_structure=True)
+    assert tuple(geom.exterior.coords[0]) == tuple(geom.exterior.coords[-1])
+
