  if isinstance(data, Series):\n    48\u2192            data = GeoSeries(data)\n    49\u2192        if data.crs is None and crs is not None:\n    50\u2192            # Avoids caching issues/crs sharing issues\n    51\u2192            data = data.copy()\n    52\u2192            data.crs = crs\n    53\u2192        return data\n    54\u2192    else:\n    55\u2192        if isinstance(data, Series):\n    56\u2192            out = from_shapely(np.asarray(data), crs=crs)\n    57\u2192            return GeoSeries(out, index=data.index, name=data.name)\n    58\u2192        else:\n    59\u2192            out = from_shapely(data, crs=crs)\n    60\u2192            return out\n    61\u2192\n    62\u2192\n    63\u2192crs_mismatch_error = (\n    64\u2192    \"CRS mismatch between CRS of the passed geometries \"\n    65\u2192    \"and 'crs'. Use 'GeoDataFrame.set_crs(crs, \"\n    66\u2192    \"allow_override=True)' to overwrite CRS or \"\n    67\u2192    \"'GeoDataFrame.to_crs(crs)' to reproject geometries. \"\n    68\u2192)\n    69\u2192\n    70\u2192\n    71\u2192class GeoDataFrame(GeoPandasBase, DataFrame):\n    72\u2192    \"\"\"\n    73\u2192    A GeoDataFrame object is a pandas.DataFrame that has a column\n    74\u2192    with geometry. In addition to the standard DataFrame constructor arguments,\n    75\u2192    GeoDataFrame also accepts the following keyword arguments:\n    76\u2192\n    77\u2192    Parameters\n    78\u2192    ----------\n    79\u2192    crs : value (optional)\n    80\u2192        Coordinate Reference System of the geometry objects. Can be anything accepted by\n    81\u2192        :meth:`pyproj.CRS.from_user_input() <pyproj.crs.CRS.from_user_input>`,\n    82\u2192        such as an authority string (eg \"EPSG:4326\") or a WKT string.\n    83\u2192    geometry : str or array (optional)\n    84\u2192        If str, column to use as geometry. If array, will be set as 'geometry'\n    85\u2192        column on GeoDataFrame.\n    86\u2192\n    87\u2192    Examples\n    88\u2192    --------\n    89\u2192    Constructing GeoDataFrame from a dictionary.\n    90\u2192\n    91\u2192    >>> from shapely.geometry import Point\n    92\u2192    >>> d = {'col1': ['name1', 'name2'], 'geometry': [Point(1, 2), Point(2, 1)]}\n    93\u2192    >>> gdf = geopandas.GeoDataFrame(d, crs=\"EPSG:4326\")\n    94\u2192    >>> gdf\n    95\u2192        col1     geometry\n    96\u2192    0  name1  POINT (1 2)\n    97\u2192    1  name2  POINT (2 1)\n    98\u2192\n    99\u2192    Notice that the inferred dtype of 'geometry' columns is geometry.\n   100\u2192\n   101\u2192    >>> gdf.dtypes\n   102\u2192    col1          object\n   103\u2192    geometry    geometry\n   104\u2192    dtype: object\n   105\u2192\n   106\u2192    Constructing GeoDataFrame from a pandas DataFrame with a column of WKT geometries:\n   107\u2192\n   108\u2192    >>> import pandas as pd\n   109\u2192    >>> d = {'col1': ['name1', 'name2'], 'wkt': ['POINT (1 2)', 'POINT (2 1)']}\n   110\u2192    >>> df = pd.DataFrame(d)\n   111\u2192    >>> gs = geopandas.GeoSeries.from_wkt(df['wkt'])\n   112\u2192    >>> gdf = geopandas.GeoDataFrame(df, geometry=gs, crs=\"EPSG:4326\")\n   113\u2192    >>> gdf\n   114\u2192        col1          wkt     geometry\n   115\u2192    0  name1  POINT (1 2)  POINT (1 2)\n   116\u2192    1  name2  POINT (2 1)  POINT (2 1)\n   117\u2192\n   118\u2192    See also\n   119\u2192    --------\n   120\u2192    GeoSeries : Series object designed to store shapely geometry objects\n   121\u2192    \"\"\"\n   122\u2192\n   123\u2192    _metadata = [\"_geometry_column_name\"]\n   124\u2192\n   125\u2192    _internal_names = DataFrame._internal_names + [\"geometry\"]\n   126\u2192    _internal_names_set = set(_internal_names)\n   127\u2192\n   128\u2192    _geometry_column_name = None\n   129\u2192\n   130\u2192    def __init__(self, data=None, *args, geometry=None, crs=None, **kwargs):\n   131\u2192        if (\n   132\u2192            kwargs.get(\"copy\") is None\n   133\u2192            and isinstance(data, DataFrame)\n   134\u2192            and not isinstance(data, GeoDataFrame)\n   135\u2192        ):\n   136\u2192            kwargs.update(copy=True)\n   137\u2192        super().__init__(data, *args, **kwargs)\n   138\u2192\n   139\u2192        # set_geometry ensures the geometry data have the proper dtype,\n   140\u2192        # but is not called if `geometry=None` ('geometry' column present\n   141\u2192        # in the data), so therefore need to ensure it here manually\n   142\u2192        # but within a try/except because currently non-geometries are\n   143\u2192        # allowed in that case\n   144\u2192        # TODO do we want to raise / return normal DataFrame in this case?\n   145\u2192\n   146\u2192        # if gdf passed in and geo_col is set, we use that for geometry\n   147\u2192        if geometry is None and isinstance(data, GeoDataFrame):\n   148\u2192            self._geometry_column_name = data._geometry_column_name\n   149\u2192            if crs is not None and data.crs != crs:\n   150\u2192                raise ValueError(crs_mismatch_error)\n   151\u2192\n   152\u2192        if (\n   153\u2192            geometry is None\n   154\u2192            and self.columns.nlevels == 1\n   155\u2192            and \"geometry\" in self.columns\n   156\u2192        ):\n   157\u2192            # Check for multiple columns with name \"geometry\". If there are,\n   158\u2192            # self[\"geometry\"] is a gdf and constructor gets recursively recalled\n   159\u2192            # by pandas internals trying to access this\n   160\u2192            if (self.columns == \"geometry\").sum() > 1:\n   161\u2192                raise ValueError(\n   162\u2192                    \"GeoDataFrame does not support multiple columns \"\n   163\u2192                    \"using the geometry column name 'geometry'.\"\n   164\u2192                )\n   165\u2192\n   166\u2192            # only if we have actual geometry values -> call set_geometry\n   167\u2192            try:\n   168\u2192                if (\n   169\u2192                    hasattr(self[\"geometry\"].values, \"crs\")\n   170\u2192                    and self[\"geometry\"].values.crs\n   171\u2192                    and crs\n   172\u2192                    and not self[\"geometry\"].values.crs == crs\n   173\u2192                ):\n   174\u2192                    raise ValueError(crs_mismatch_error)\n   175\u2192                self[\"geometry\"] = _ensure_geometry(self[\"geometry\"].values, crs)\n   176\u2192            except TypeError:\n   177\u2192                pass\n   178\u2192            else:\n   179\u2192                geometry = \"geometry\"\n   180\u2192\n   181\u2192        if geometry is not None:\n   182\u2192            if (\n   183\u2192                hasattr(geometry, \"crs\")\n   184\u2192                and geometry.crs\n   185\u2192                and crs\n   186\u2192                and not geometry.crs == crs\n   187\u2192            ):\n   188\u2192                raise ValueError(crs_mismatch_error)\n   189\u2192\n   190\u2192            self.set_geometry(geometry, inplace=True, crs=crs)\n   191\u2192\n   192\u2192        if geometry is None and crs:\n   193\u2192            raise ValueError(\n   194\u2192                \"Assigning CRS to a GeoDataFrame without a geometry column is not \"\n   195\u2192                \"supported. Supply geometry using the 'geometry=' keyword argument, \"\n   196\u2192                \"or by providing a DataFrame with column name 'geometry'\",\n   197\u2192            )\n   198\u2192\n   199\u2192    def __setattr__(self, attr, val):\n   200\u2192        # have to special case geometry b/c pandas tries to use as column...\n   201\u2192        if attr == \"geometry\":\n   202\u2192            object.__setattr__(self, attr, val)\n   203\u2192        else:\n   204\u2192            super().__setattr__(attr, val)\n   205\u2192\n   206\u2192    def _get_geometry(self):\n   207\u2192        if self._geometry_column_name not in self:\n   208\u2192            if self._geometry_column_name is None:\n   209\u2192                msg = (\n   210\u2192                    \"You are calling a geospatial method on the GeoDataFrame, \"\n   211\u2192                    \"but the active geometry column to use has not been set. \"\n   212\u2192                )\n   213\u2192            else:\n   214\u2192                msg = (\n   215\u2192                    \"You are calling a geospatial method on the GeoDataFrame, \"\n   216\u2192                    f\"but the active geometry column ('{self._geometry_column_name}') \"\n   217\u2192                    \"is not present. \"\n   218\u2192                )\n   219\u2192            geo_cols = list(self.columns[self.dtypes == \"geometry\"])\n   220\u2192            if len(geo_cols) > 0:\n   221\u2192                msg += (\n   222\u2192                    f\"\\nThere are columns with geometry data type ({geo_cols}), and \"\n   223\u2192                    \"you can either set one as the active geometry with \"\n   224\u2192                    'df.set_geometry(\"name\") or access the column as a '\n   225\u2192                    'GeoSeries (df[\"name\"]) and call the method directly on it.'\n   226\u2192                )\n   227\u2192            else:\n   228\u2192                msg += (\n   229\u2192                    \"\\nThere are no existing columns with geometry data type. You can \"\n   230\u2192                    \"add a geometry column as the active geometry column with \"\n   231\u2192                    \"df.set_geometry. \"\n   232\u2192                )\n   233\u2192\n   234\u2192            raise AttributeError(msg)\n   235\u2192        return self[self._geometry_column_name]\n   236\u2192\n   237\u2192    def _set_geometry(self, col):\n   238\u2192        if not pd.api.types.is_list_like(col):\n   239\u2192            raise ValueError(\"Must use a list-like to set the geometry property\")\n   240\u2192        self._persist_old_default_geometry_colname()\n   241\u2192        self.set_geometry(col, inplace=True)\n   242\u2192\n   243\u2192    geometry = property(\n   244\u2192        fget=_get_geometry, fset=_set_geometry, doc=\"Geometry data for GeoDataFrame\"\n   245\u2192    )\n   246\u2192\n   247\u2192    def set_geometry(self, col, drop=False, inplace=False, crs=None):\n   248\u2192        \"\"\"\n   249\u2192        Set the GeoDataFrame geometry using either an existing column or\n   250\u2192        the specified input. By default yields a new object.\n   251\u2192\n   252\u2192        The original geometry column is replaced with the input.\n   253\u2192\n   254\u2192        Parameters\n   255\u2192        ----------\n   256\u2192        col : column label or array\n   257\u2192        drop : boolean, default False\n   258\u2192            Delete column to be used as the new geometry\n   259\u2192        inplace : boolean, default False\n   260\u2192            Modify the GeoDataFrame in place (do not create a new object)\n   261\u2192        crs : pyproj.CRS, optional\n   262\u2192            Coordinate system to use. The value can be anything accepted\n   263\u2192            by :meth:`pyproj.CRS.from_user_input() <pyproj.crs.CRS.from_user_input>`,\n   264\u2192            such as an authority string (eg \"EPSG:4326\") or a WKT string.\n   265\u2192            If passed, overrides both DataFrame and col's crs.\n   266\u2192            Otherwise, tries to get crs from passed col values or DataFrame.\n   267\u2192\n   268\u2192        Examples\n   269\u2192        --------\n   270\u2192        >>> from shapely.geometry import Point\n   271\u2192        >>> d = {'col1': ['name1', 'name2'], 'geometry': [Point(1, 2), Point(2, 1)]}\n   272\u2192        >>> gdf = geopandas.GeoDataFrame(d, crs=\"EPSG:4326\")\n   273\u2192        >>> gdf\n   274\u2192            col1     geometry\n   275\u2192        0  name1  POINT (1 2)\n   276\u2192        1  name2  POINT (2 1)\n   277\u2192\n   278\u2192        Passing an array:\n   279\u2192\n   280\u2192        >>> df1 = gdf.set_geometry([Point(0,0), Point(1,1)])\n   281\u2192        >>> df1\n   282\u2192            col1     geometry\n   283\u2192        0  name1  POINT (0 0)\n   284\u2192        1  name2  POINT (1 1)\n   285\u2192\n   286\u2192        Using existing column:\n   287\u2192\n   288\u2192        >>> gdf[\"buffered\"] = gdf.buffer(2)\n   289\u2192        >>> df2 = gdf.set_geometry(\"buffered\")\n   290\u2192        >>> df2.geometry\n   291\u2192        0    POLYGON ((3 2, 2.99037 1.80397, 2.96157 1.6098...\n   292\u2192        1    POLYGON ((4 1, 3.99037 0.80397, 3.96157 0.6098...\n   293\u2192        Name: buffered, dtype: geometry\n   294\u2192\n   295\u2192        Returns\n   296\u2192        -------\n   297\u2192        GeoDataFrame\n   298\u2192\n   299\u2192        See also\n   300\u2192        --------\n   301\u2192        GeoDataFrame.rename_geometry : rename an active geometry column\n   302\u2192        \"\"\"\n   303\u2192        # Most of the code here is taken from DataFrame.set_index()\n   304\u2192        if inplace:\n   305\u2192            frame = self\n   306\u2192        else:\n   307\u2192            frame = self.copy()\n   308\u2192\n   309\u2192        to_remove = None\n   310\u2192        geo_column_name = self._geometry_column_name\n   311\u2192        if geo_column_name is None:\n   312\u2192            geo_column_name = \"geometry\"\n   313\u2192        if isinstance(col, (Series, list, np.ndarray, GeometryArray)):\n   314\u2192            level = col\n   315\u2192        elif hasattr(col, \"ndim\") and col.ndim > 1:\n   316\u2192            raise ValueError(\"Must pass array with one dimension only.\")\n   317\u2192        else:\n   318\u2192            try:\n   319\u2192                level = frame[col]\n   320\u2192            except KeyError:\n   321\u2192                raise ValueError(\"Unknown column %s\" % col)\n   322\u2192            if isinstance(level, DataFrame):\n   323\u2192                raise ValueError(\n   324\u2192                    \"GeoDataFrame does not support setting the geometry column where \"\n   325\u2192                    \"the column name is shared by multiple columns.\"\n   326\u2192                )\n   327\u2192\n   328\u2192            if drop:\n   329\u2192                to_remove = col\n   330\u2192            else:\n   331\u2192                geo_column_name = col\n   332\u2192\n   333\u2192        if to_remove:\n   334\u2192            del frame[to_remove]\n   335\u2192\n   336\u2192        if not crs:\n   337\u2192            crs = getattr(level, \"crs\", None)\n   338\u2192\n   339\u2192        if isinstance(level, (GeoSeries, GeometryArray)) and level.crs != crs:\n   340\u2192            # Avoids caching issues/crs sharing issues\n   341\u2192            level = level.copy()\n   342\u2192            level.crs = crs\n   343\u2192\n   344\u2192        # Check that we are using a listlike of geometries\n   345\u2192        level = _ensure_geometry(level, crs=crs)\n   346\u2192        # update _geometry_column_name prior to assignment\n   347\u2192        # to avoid default is None warning\n   348\u2192        frame._geometry_column_name = geo_column_name\n   349\u2192        frame[geo_column_name] = level\n   350\u2192\n   351\u2192        if not inplace:\n   352\u2192            return frame\n   353\u2192\n   354\u2192    def rename_geometry(self, col, inplace=False):\n   355\u2192        \"\"\"\n   356\u2192        Renames the GeoDataFrame geometry column to\n   357\u2192        the specified name. By default yields a new object.\n   358\u2192\n   359\u2192        The original geometry column is replaced with the input.\n   360\u2192\n   361\u2192        Parameters\n   362\u2192        ----------\n   363\u2192        col : new geometry column label\n   364\u2192        inplace : boolean, default False\n   365\u2192            Modify the GeoDataFrame in place (do not create a new object)\n   366\u2192\n   367\u2192        Examples\n   368\u2192        --------\n   369\u2192        >>> from shapely.geometry import Point\n   370\u2192        >>> d = {'col1': ['name1', 'name2'], 'geometry': [Point(1, 2), Point(2, 1)]}\n   371\u2192        >>> df = geopandas.GeoDataFrame(d, crs=\"EPSG:4326\")\n   372\u2192        >>> df1 = df.rename_geometry('geom1')\n   373\u2192        >>> df1.geometry.name\n   374\u2192        'geom1'\n   375\u2192        >>> df.rename_geometry('geom1', inplace=True)\n   376\u2192        >>> df.geometry.name\n   377\u2192        'geom1'\n   378\u2192\n   379\u2192        Returns\n   380\u2192        -------\n   381\u2192        geodataframe : GeoDataFrame\n   382\u2192\n   383\u2192        See also\n   384\u2192        --------\n   385\u2192        GeoDataFrame.set_geometry : set the active geometry\n   386\u2192        \"\"\"\n   387\u2192        geometry_col = self.geometry.name\n   388\u2192        if col in self.columns:\n   389\u2192            raise ValueError(f\"Column named {col} already exists\")\n   390\u2192        else:\n   391\u2192            if not inplace:\n   392\u2192                return self.rename(columns={geometry_col: col}).set_geometry(\n   393\u2192                    col, inplace\n   394\u2192                )\n   395\u2192            self.rename(columns={geometry_col: col}, inplace=inplace)\n   396\u2192            self.set_geometry(col, inplace=inplace)\n   397\u2192\n   398\u2192    @property\n   399\u2192    def active_geometry_name(self):\n   400\u2192        \"\"\"Return the name of the active geometry column\n   401\u2192\n   402\u2192        Returns a string name if a GeoDataFrame has an active geometry column set.\n   403\u2192        Otherwise returns None. You can also access the active geometry column using the\n   404\u2192        ``.geometry`` property. You can set a GeoSeries to be an active geometry\n   405\u2192        using the :meth:`~GeoDataFrame.set_geometry` method.\n   406\u2192\n   407\u2192        Returns\n   408\u2192        -------\n   409\u2192        str\n   410\u2192            name of an active geometry column or None\n   411\u2192\n   412\u2192        See also\n   413\u2192        --------\n   414\u2192        GeoDataFrame.set_geometry : set the active geometry\n   415\u2192        \"\"\"\n   416\u2192        return self._geometry_column_name\n   417\u2192\n   418\u2192    @property\n   419\u2192    def crs(self):\n   420\u2192        \"\"\"\n   421\u2192        The Coordinate Reference System (CRS) represented as a ``pyproj.CRS``\n   422\u2192        object.\n   423\u2192\n   424\u2192        Returns None if the CRS is not set, and to set the value it\n   425\u2192        :getter: Returns a ``pyproj.CRS`` or None. When setting, the value\n   426\u2192        can be anything accepted by\n   427\u2192        :meth:`pyproj.CRS.from_user_input() <pyproj.crs.CRS.from_user_input>`,\n   428\u2192        such as an authority string (eg \"EPSG:4326\") or a WKT string.\n   429\u2192\n   430\u2192        Examples\n   431\u2192        --------\n   432\u2192\n   433\u2192        >>> gdf.crs  # doctest: +SKIP\n   434\u2192        <Geographic 2D CRS: EPSG:4326>\n   435\u2192        Name: WGS 84\n   436\u2192        Axis Info [ellipsoidal]:\n   437\u2192        - Lat[north]: Geodetic latitude (degree)\n   438\u2192        - Lon[east]: Geodetic longitude (degree)\n   439\u2192        Area of Use:\n   440\u2192        - name: World\n   441\u2192        - bounds: (-180.0, -90.0, 180.0, 90.0)\n   442\u2192        Datum: World Geodetic System 1984\n   443\u2192        - Ellipsoid: WGS 84\n   444\u2192        - Prime Meridian: Greenwich\n   445\u2192\n   446\u2192        See also\n   447\u2192        --------\n   448\u2192        GeoDataFrame.set_crs : assign CRS\n   449\u2192        GeoDataFrame.to_crs : re-project to another CRS\n   450\u2192\n   451\u2192        \"\"\"\n   452\u2192        try:\n   453\u2192            return self.geometry.crs\n   454\u2192        except AttributeError:\n   455\u2192            raise AttributeError(\n   456\u2192                \"The CRS attribute of a GeoDataFrame without an active \"\n   457\u2192                \"geometry column is not defined. Use GeoDataFrame.set_geometry \"\n   458\u2192                \"to set the active geometry column.\"\n   459\u2192            )\n   460\u2192\n   461\u2192    @crs.setter\n   462\u2192    def crs(self, value):\n   463\u2192        \"\"\"Sets the value of the crs\"\"\"\n   464\u2192        if self._geometry_column_name is None:\n   465\u2192            raise ValueError(\n   466\u2192                \"Assigning CRS to a GeoDataFrame without a geometry column is not \"\n   467\u2192                \"supported. Use GeoDataFrame.set_geometry to set the active \"\n   468\u2192                \"geometry column.\",\n   469\u2192            )\n   470\u2192\n   471\u2192        if hasattr(self.geometry.values, \"crs\"):\n   472\u2192            self.geometry.values.crs = value\n   473\u2192        else:\n   474\u2192            # column called 'geometry' without geometry\n   475\u2192            raise ValueError(\n   476\u2192                \"Assigning CRS to a GeoDataFrame without an active geometry \"\n   477\u2192                \"column is not supported. Use GeoDataFrame.set_geometry to set \"\n   478\u2192                \"the active geometry column.\",\n   479\u2192            )\n   480\u2192\n   481\u2192    def __setstate__(self, state):\n   482\u2192        # overriding DataFrame method for compat with older pickles (CRS handling)\n   483\u2192        crs = None\n   484\u2192        if isinstance(state, dict):\n   485\u2192            if \"crs\" in state and \"_crs\" not in state:\n   486\u2192                crs = state.pop(\"crs\", None)\n   487\u2192            else:\n   488\u2192                crs = state.pop(\"_crs\", None)\n   489\u2192            crs = CRS.from_user_input(crs) if crs is not None else crs\n   490\u2192\n   491\u2192        super().__setstate__(state)\n   492\u2192\n   493\u2192        # for some versions that didn't yet have CRS at array level -> crs is set\n   494\u2192        # at GeoDataFrame level with '_crs' (and not 'crs'), so without propagating\n   495\u2192        # to the GeoSeries/GeometryArray\n   496\u2192        try:\n   497\u2192            if crs is not None:\n   498\u2192                if self.geometry.values.crs is None:\n   499\u2192                    self.crs = crs\n   500\u2192        except Exception:\n   501\u2192            pass\n   502\u2192\n   503\u2192    @classmethod\n   504\u2192    def from_dict(cls, data, geometry=None, crs=None, **kwargs):\n   505\u2192        \"\"\"\n   506\u2192        Construct GeoDataFrame from dict of array-like or dicts by\n   507\u2192        overriding DataFrame.from_dict method with geometry and crs\n   508\u2192\n   509\u2192        Parameters\n   510\u2192        ----------\n   511\u2192        data : dict\n   512\u2192            Of the form {field : array-like} or {field : dict}.\n   513\u2192        geometry : str or array (optional)\n   514\u2192            If str, column to use as geometry. If array, will be set as 'geometry'\n   515\u2192            column on GeoDataFrame.\n   516\u2192        crs : str or dict (optional)\n   517\u2192            Coordinate reference system to set on the resulting frame.\n   518\u2192        kwargs : key-word arguments\n   519\u2192            These arguments are passed to DataFrame.from_dict\n   520\u2192\n   521\u2192        Returns\n   522\u2192        -------\n   523\u2192        GeoDataFrame\n   524\u2192\n   525\u2192        \"\"\"\n   526\u2192        dataframe = DataFrame.from_dict(data, **kwargs)\n   527\u2192        return cls(dataframe, geometry=geometry, crs=crs)\n   528\u2192\n   529\u2192    @classmethod\n   530\u2192    def from_file(cls, filename, **kwargs):\n   531\u2192        \"\"\"Alternate constructor to create a ``GeoDataFrame`` from a file.\n   532\u2192\n   533\u2192        It is recommended to use :func:`geopandas.read_file` instead.\n   534\u2192\n   535\u2192        Can load a ``GeoDataFrame`` from a file in any format recognized by\n   536\u2192        `fiona`. See http://fiona.readthedocs.io/en/latest/manual.html for details.\n   537\u2192\n   538\u2192        Parameters\n   539\u2192        ----------\n   540\u2192        filename : str\n   541\u2192            File path or file handle to read from. Depending on which kwargs\n   542\u2192            are included, the content of filename may vary. See\n   543\u2192            http://fiona.readthedocs.io/en/latest/README.html#usage for usage details.\n   544\u2192        kwargs : key-word arguments\n   545\u2192            These arguments are passed to fiona.open, and can be used to\n   546\u2192            access multi-layer data, data stored within archives (zip files),\n   547\u2192            etc.\n   548\u2192\n   549\u2192        Examples\n   550\u2192        --------\n   551\u2192        >>> import geodatasets\n   552\u2192        >>> path = geodatasets.get_path('nybb')\n   553\u2192        >>> gdf = geopandas.GeoDataFrame.from_file(path)\n   554\u2192        >>> gdf  # doctest: +SKIP\n   555\u2192           BoroCode       BoroName     Shape_Leng    Shape_Area                 \\\n   556\u2192                          geometry\n   557\u2192        0         5  Staten Island  330470.010332  1.623820e+09  MULTIPOLYGON ((\\\n   558\u2192(970217.022 145643.332, 970227....\n   559\u2192        1         4         Queens  896344.047763  3.045213e+09  MULTIPOLYGON ((\\\n   560\u2192(1029606.077 156073.814, 102957...\n   561\u2192        2         3       Brooklyn  741080.523166  1.937479e+09  MULTIPOLYGON ((\\\n   562\u2192(1021176.479 151374.797, 102100...\n   563\u2192        3         1      Manhattan  359299.096471  6.364715e+08  MULTIPOLYGON ((\\\n   564\u2192(981219.056 188655.316, 980940....\n   565\u2192        4         2          Bronx  464392.991824  1.186925e+09  MULTIPOLYGON ((\\\n   566\u2192(1012821.806 229228.265, 101278...\n   567\u2192\n   568\u2192        The recommended method of reading files is :func:`geopandas.read_file`:\n   569\u2192\n   570\u2192        >>> gdf = geopandas.read_file(path)\n   571\u2192\n   572\u2192        See also\n   573\u2192        --------\n   574\u2192        read_file : read file to GeoDataFame\n   575\u2192        GeoDataFrame.to_file : write GeoDataFrame to file\n   576\u2192\n   577\u2192        \"\"\"\n   578\u2192        return geopandas.io.file._read_file(filename, **kwargs)\n   579\u2192\n   580\u2192    @classmethod\n   581\u2192    def from_features(cls, features, crs=None, columns=None):\n   582\u2192        \"\"\"\n   583\u2192        Alternate constructor to create GeoDataFrame from an iterable of\n   584\u2192        features or a feature collection.\n   585\u2192\n   586\u2192        Parameters\n   587\u2192        ----------\n   588\u2192        features\n   589\u2192            - Iterable of features, where each element must be a feature\n   590\u2192              dictionary or implement the __geo_interface__.\n   591\u2192            - Feature collection, where the 'features' key contains an\n   592\u2192              iterable of features.\n   593\u2192            - Object holding a feature collection that implements the\n   594\u2192              ``__geo_interface__``.\n   595\u2192        crs : str or dict (optional)\n   596\u2192            Coordinate reference system to set on the resulting frame.\n   597\u2192        columns : list of column names, optional\n   598\u2192            Optionally specify the column names to include in the output frame.\n   599\u2192            This does not overwrite the property names of the input, but can\n   600\u2192            ensure a consistent output format.\n   601\u2192\n   602\u2192        Returns\n   603\u2192        -------\n   604\u2192        GeoDataFrame\n   605\u2192\n   606\u2192        Notes\n   607\u2192        -----\n   608\u2192        For more information about the ``__geo_interface__``, see\n   609\u2192        https://gist.github.com/sgillies/2217756\n   610\u2192\n   611\u2192        Examples\n   612\u2192        --------\n   613\u2192        >>> feature_coll = {\n   614\u2192        ...     \"type\": \"FeatureCollection\",\n   615\u2192        ...     \"features\": [\n   616\u2192        ...         {\n   617\u2192        ...             \"id\": \"0\",\n   618\u2192        ...             \"type\": \"Feature\",\n   619\u2192        ...             \"properties\": {\"col1\": \"name1\"},\n   620\u2192        ...             \"geometry\": {\"type\": \"Point\", \"coordinates\": (1.0, 2.0)},\n   621\u2192        ...             \"bbox\": (1.0, 2.0, 1.0, 2.0),\n   622\u2192        ...         },\n   623\u2192        ...         {\n   624\u2192        ...             \"id\": \"1\",\n   625\u2192        ...             \"type\": \"Feature\",\n   626\u2192        ...             \"properties\": {\"col1\": \"name2\"},\n   627\u2192        ...             \"geometry\": {\"type\": \"Point\", \"coordinates\": (2.0, 1.0)},\n   628\u2192        ...             \"bbox\": (2.0, 1.0, 2.0, 1.0),\n   629\u2192        ...         },\n   630\u2192        ...     ],\n   631\u2192        ...     \"bbox\": (1.0, 1.0, 2.0, 2.0),\n   632\u2192        ... }\n   633\u2192        >>> df = geopandas.GeoDataFrame.from_features(feature_coll)\n   634\u2192        >>> df\n   635\u2192              geometry   col1\n   636\u2192        0  POINT (1 2)  name1\n   637\u2192        1  POINT (2 1)  name2\n   638\u2192\n   639\u2192        \"\"\"\n   640\u2192        # Handle feature collections\n   641\u2192        if hasattr(features, \"__geo_interface__\"):\n   642\u2192            fs = features.__geo_interface__\n   643\u2192        else:\n   644\u2192            fs = features\n   645\u2192\n   646\u2192        if isinstance(fs, dict) and fs.get(\"type\") == \"FeatureCollection\":\n   647\u2192            features_lst = fs[\"features\"]\n   648\u2192        else:\n   649\u2192            features_lst = features\n   650\u2192\n   651\u2192        rows = []\n   652\u2192        for feature in features_lst:\n   653\u2192            # load geometry\n   654\u2192            if hasattr(feature, \"__geo_interface__\"):\n   655\u2192                feature = feature.__geo_interface__\n   656\u2192            row = {\n   657\u2192                \"geometry\": shape(feature[\"geometry\"]) if feature[\"geometry\"] else None\n   658\u2192            }\n   659\u2192            # load properties\n   660\u2192            properties = feature[\"properties\"]\n   661\u2192            if properties is None:\n   662\u2192                properties = {}\n   663\u2192            row.update(properties)\n   664\u2192            rows.append(row)\n   665\u2192        return cls(rows, columns=columns, crs=crs)\n   666\n   667\u2192    @classmethod\n   668\u2192    def from_postgis(\n   669\u2192        cls,\n   670\u2192        sql,\n   671\u2192        con,\n   672\u2192        geom_col=\"geom\",\n   673\u2192        crs=None,\n   674\u2192        index_col=None,\n   675\u2192        coerce_float=True,\n   676\u2192        parse_dates=None,\n   677\u2192        params=None,\n   678\u2192        chunksize=None,\n   679\u2192    ):\n   680\u2192        \"\"\"\n   681\u2192        Alternate constructor to create a ``GeoDataFrame`` from a sql query\n   682\u2192        containing a geometry column in WKB representation.\n   683\u2192\n   684\u2192        Parameters\n   685\u2192        ----------\n   686\u2192        sql : string\n   687\u2192        con : sqlalchemy.engine.Connection or sqlalchemy.engine.Engine\n   688\u2192        geom_col : string, default 'geom'\n   689\u2192            column name to convert to shapely geometries\n   690\u2192        crs : optional\n   691\u2192            Coordinate reference system to use for the returned GeoDataFrame\n   692\u2192        index_col : string or list of strings, optional, default: None\n   693\u2192            Column(s) to set as index(MultiIndex)\n   694\u2192        coerce_float : boolean, default True\n   695\u2192            Attempt to convert values of non-string, non-numeric objects (like\n   696\u2192            decimal.Decimal) to floating point, useful for SQL result sets\n   697\u2192        parse_dates : list or dict, default None\n   698\u2192            - List of column names to parse as dates.\n   699\u2192            - Dict of ``{column_name: format string}`` where format string is\n   700\u2192              strftime compatible in case of parsing string times, or is one of\n   701\u2192              (D, s, ns, ms, us) in case of parsing integer timestamps.\n   702\u2192            - Dict of ``{column_name: arg dict}``, where the arg dict\n   703\u2192              corresponds to the keyword arguments of\n   704\u2192              :func:`pandas.to_datetime`. Especially useful with databases\n   705\u2192              without native Datetime support, such as SQLite.\n   706\u2192        params : list, tuple or dict, optional, default None\n   707\u2192            List of parameters to pass to execute method.\n   708\u2192        chunksize : int, default None\n   709\u2192            If specified, return an iterator where chunksize is the number\n   710\u2192            of rows to include in each chunk.\n   711\u2192\n   712\u2192        Examples\n   713\u2192        --------\n   714\u2192        PostGIS\n   715\u2192\n   716\u2192        >>> from sqlalchemy import create_engine  # doctest: +SKIP\n   717\u2192        >>> db_connection_url = \"postgresql://myusername:mypassword@myhost:5432/mydb\"\n   718\u2192        >>> con = create_engine(db_connection_url)  # doctest: +SKIP\n   719\u2192        >>> sql = \"SELECT geom, highway FROM roads\"\n   720\u2192        >>> df = geopandas.GeoDataFrame.from_postgis(sql, con)  # doctest: +SKIP\n   721\u2192\n   722\u2192        SpatiaLite\n   723\u2192\n   724\u2192        >>> sql = \"SELECT ST_Binary(geom) AS geom, highway FROM roads\"\n   725\u2192        >>> df = geopandas.GeoDataFrame.from_postgis(sql, con)  # doctest: +SKIP\n   726\u2192\n   727\u2192        The recommended method of reading from PostGIS is\n   728\u2192        :func:`geopandas.read_postgis`:\n   729\u2192\n   730\u2192        >>> df = geopandas.read_postgis(sql, con)  # doctest: +SKIP\n   731\u2192\n   732\u2192        See also\n   733\u2192        --------\n   734\u2192        geopandas.read_postgis : read PostGIS database to GeoDataFrame\n   735\u2192        \"\"\"\n   736\u2192\n   737\u2192        df = geopandas.io.sql._read_postgis(\n   738\u2192            sql,\n   739\u2192            con,\n   740\u2192            geom_col=geom_col,\n   741\u2192            crs=crs,\n   742\u2192            index_col=index_col,\n   743\u2192            coerce_float=coerce_float,\n   744\u2192            parse_dates=parse_dates,\n   745\u2192            params=params,\n   746\u2192            chunksize=chunksize,\n   747\u2192        )\n   748\u2192\n   749\u2192        return df\n   750\u2192\n   751\u2192    def to_json(\n   752\u2192        self, na=\"null\", show_bbox=False, drop_id=False, to_wgs84=False, **kwargs\n   753\u2192    ):\n   754\u2192        \"\"\"\n   755\u2192        Returns a GeoJSON representation of the ``GeoDataFrame`` as a string.\n   756\u2192\n   757\u2192        Parameters\n   758\u2192        ----------\n   759\u2192        na : {'null', 'drop', 'keep'}, default 'null'\n   760\u2192            Indicates how to output missing (NaN) values in the GeoDataFrame.\n   761\u2192            See below.\n   762\u2192        show_bbox : bool, optional, default: False\n   763\u2192            Include bbox (bounds) in the geojson\n   764\u2192        drop_id : bool, default: False\n   765\u2192            Whether to retain the index of the GeoDataFrame as the id property\n   766\u2192            in the generated GeoJSON. Default is False, but may want True\n   767\u2192            if the index is just arbitrary row numbers.\n   768\u2192        to_wgs84: bool, optional, default: False\n   769\u2192            If the CRS is set on the active geometry column it is exported as\n   770\u2192            WGS84 (EPSG:4326) to meet the `2016 GeoJSON specification\n   771\u2192            <https://tools.ietf.org/html/rfc7946>`_.\n   772\u2192            Set to True to force re-projection and set to False to ignore CRS. False by\n   773\u2192            default.\n   774\u2192\n   775\u2192        Notes\n   776\u2192        -----\n   777\u2192        The remaining *kwargs* are passed to json.dumps().\n   778\u2192\n   779\u2192        Missing (NaN) values in the GeoDataFrame can be represented as follows:\n   780\u2192\n   781\u2192        - ``null``: output the missing entries as JSON null.\n   782\u2192        - ``drop``: remove the property from the feature. This applies to each\n   783\u2192          feature individually so that features may have different properties.\n   784\u2192        - ``keep``: output the missing entries as NaN.\n   785\u2192\n   786\u2192        If the GeoDataFrame has a defined CRS, its definition will be included\n   787\u2192        in the output unless it is equal to WGS84 (default GeoJSON CRS) or not\n   788\u2192        possible to represent in the URN OGC format, or unless ``to_wgs84=True``\n   789\u2192        is specified.\n   790\u2192\n   791\u2192        Examples\n   792\u2192        --------\n   793\u2192\n   794\u2192        >>> from shapely.geometry import Point\n   795\u2192        >>> d = {'col1': ['name1', 'name2'], 'geometry': [Point(1, 2), Point(2, 1)]}\n   796\u2192        >>> gdf = geopandas.GeoDataFrame(d, crs=\"EPSG:3857\")\n   797\u2192        >>> gdf\n   798\u2192            col1     geometry\n   799\u2192        0  name1  POINT (1 2)\n   800\u2192        1  name2  POINT (2 1)\n   801\u2192\n   802\u2192        >>> gdf.to_json()\n   803\u2192        '{\"type\": \"FeatureCollection\", \"features\": [{\"id\": \"0\", \"type\": \"Feature\", \\\n   804\u2192\"properties\": {\"col1\": \"name1\"}, \"geometry\": {\"type\": \"Point\", \"coordinates\": [1.0,\\\n   805\u2192 2.0]}}, {\"id\": \"1\", \"type\": \"Feature\", \"properties\": {\"col1\": \"name2\"}, \"geometry\"\\\n   806\u2192: {\"type\": \"Point\", \"coordinates\": [2.0, 1.0]}}], \"crs\": {\"type\": \"name\", \"properti\\\n   807\u2192es\": {\"name\": \"urn:ogc:def:crs:EPSG::3857\"}}}'\n   808\u2192\n   809\u2192        Alternatively, you can write GeoJSON to file:\n   810\u2192\n   811\u2192        >>> gdf.to_file(path, driver=\"GeoJSON\")  # doctest: +SKIP\n   812\u2192\n   813\u2192        See also\n   814\u2192        --------\n   815\u2192        GeoDataFrame.to_file : write GeoDataFrame to file\n   816\u2192\n   817\u2192        \"\"\"\n   818\u2192        if to_wgs84:\n   819\u2192            if self.crs:\n   820\u2192                df = self.to_crs(epsg=4326)\n   821\u2192            else:\n   822\u2192                raise ValueError(\n   823\u2192                    \"CRS is not set. Cannot re-project to WGS84 (EPSG:4326).\"\n   824\u2192                )\n   825\u2192        else:\n   826\u2192            df = self\n   827\u2192\n   828\u2192        geo = df._to_geo(na=na, show_bbox=show_bbox, drop_id=drop_id)\n   829\u2192\n   830\u2192        # if the geometry is not in WGS84, include CRS in the JSON\n   831\u2192        if df.crs is not None and not df.crs.equals(\"epsg:4326\"):\n   832\u2192            auth_crsdef = self.crs.to_authority()\n   833\u2192            allowed_authorities = [\"EDCS\", \"EPSG\", \"OGC\", \"SI\", \"UCUM\"]\n   834\u2192\n   835\u2192            if auth_crsdef is None or auth_crsdef[0] not in allowed_authorities:\n   836\u2192                warnings.warn(\n   837\u2192                    \"GeoDataFrame's CRS is not representable in URN OGC \"\n   838\u2192                    \"format. Resulting JSON will contain no CRS information.\",\n   839\u2192                    stacklevel=2,\n   840\u2192                )\n   841\u2192            else:\n   842\u2192                authority, code = auth_crsdef\n   843\u2192                ogc_crs = f\"urn:ogc:def:crs:{authority}::{code}\"\n   844\u2192                geo[\"crs\"] = {\"type\": \"name\", \"properties\": {\"name\": ogc_crs}}\n   845\u2192\n   846\u2192        return json.dumps(geo, **kwargs)\n   847\u2192\n   848\u2192    @property\n   849\u2192    def __geo_interface__(self):\n   850\u2192        \"\"\"Returns a ``GeoDataFrame`` as a python feature collection.\n   851\u2192\n   852\u2192        Implements the `geo_interface`. The returned python data structure\n   853\u2192        represents the ``GeoDataFrame`` as a GeoJSON-like\n   854\u2192        ``FeatureCollection``.\n   855\u2192\n   856\u2192        This differs from `_to_geo()` only in that it is a property with\n   857\u2192        default args instead of a method.\n   858\u2192\n   859\u2192        CRS of the dataframe is not passed on to the output, unlike\n   860\u2192        :meth:`~GeoDataFrame.to_json()`.\n   861\u2192\n   862\u2192        Examples\n   863\u2192        --------\n   864\u2192\n   865\u2192        >>> from shapely.geometry import Point\n   866\u2192        >>> d = {'col1': ['name1', 'name2'], 'geometry': [Point(1, 2), Point(2, 1)]}\n   867\u2192        >>> gdf = geopandas.GeoDataFrame(d, crs=\"EPSG:4326\")\n   868\u2192        >>> gdf\n   869\u2192            col1     geometry\n   870\u2192        0  name1  POINT (1 2)\n   871\u2192        1  name2  POINT (2 1)\n   872\u2192\n   873\u2192        >>> gdf.__geo_interface__\n   874\u2192        {'type': 'FeatureCollection', 'features': [{'id': '0', 'type': 'Feature', \\\n   875\u2192'properties': {'col1': 'name1'}, 'geometry': {'type': 'Point', 'coordinates': (1.0\\\n   876\u2192, 2.0)}, 'bbox': (1.0, 2.0, 1.0, 2.0)}, {'id': '1', 'type': 'Feature', 'properties\\\n   877\u2192': {'col1': 'name2'}, 'geometry': {'type': 'Point', 'coordinates': (2.0, 1.0)}, 'b\\\n   878\u2192box': (2.0, 1.0, 2.0, 1.0)}], 'bbox': (1.0, 1.0, 2.0, 2.0)}\n   879\u2192        \"\"\"\n   880\u2192        return self._to_geo(na=\"null\", show_bbox=True, drop_id=False)\n   881\u2192\n   882\u2192    def iterfeatures(self, na=\"null\", show_bbox=False, drop_id=False):\n   883\u2192        \"\"\"\n   884\u2192        Returns an iterator that yields feature dictionaries that comply with\n   885\u2192        __geo_interface__\n   886\u2192\n   887\u2192        Parameters\n   888\u2192        ----------\n   889\u2192        na : str, optional\n   890\u2192            Options are {'null', 'drop', 'keep'}, default 'null'.\n   891\u2192            Indicates how to output missing (NaN) values in the GeoDataFrame\n   892\u2192\n   893\u2192            - null: output the missing entries as JSON null\n   894\u2192            - drop: remove the property from the feature. This applies to each feature \\\n   895\u2192individually so that features may have different properties\n   896\u2192            - keep: output the missing entries as NaN\n   897\u2192\n   898\u2192        show_bbox : bool, optional\n   899\u2192            Include bbox (bounds) in the geojson. Default False.\n   900\u2192        drop_id : bool, default: False\n   901\u2192            Whether to retain the index of the GeoDataFrame as the id property\n   902\u2192            in the generated GeoJSON. Default is False, but may want True\n   903\u2192            if the index is just arbitrary row numbers.\n   904\u2192\n   905\u2192        Examples\n   906\u2192        --------\n   907\u2192\n   908\u2192        >>> from shapely.geometry import Point\n   909\u2192        >>> d = {'col1': ['name1', 'name2'], 'geometry': [Point(1, 2), Point(2, 1)]}\n   910\u2192        >>> gdf = geopandas.GeoDataFrame(d, crs=\"EPSG:4326\")\n   911\u2192        >>> gdf\n   912\u2192            col1     geometry\n   913\u2192        0  name1  POINT (1 2)\n   914\u2192        1  name2  POINT (2 1)\n   915\u2192\n   916\u2192        >>> feature = next(gdf.iterfeatures())\n   917\u2192        >>> feature\n   918\u2192        {'id': '0', 'type': 'Feature', 'properties': {'col1': 'name1'}, 'geometry': {\\\n   919\u2192'type': 'Point', 'coordinates': (1.0, 2.0)}}\n   920\u2192        \"\"\"\n   921\u2192        if na not in [\"null\", \"drop\", \"keep\"]:\n   922\u2192            raise ValueError(\"Unknown na method {0}\".format(na))\n   923\u2192\n   924\u2192        if self._geometry_column_name not in self:\n   925\u2192            raise AttributeError(\n   926\u2192                \"No geometry data set (expected in\"\n   927\u2192                \" column '%s').\" % self._geometry_column_name\n   928\u2192            )\n   929\u2192\n   930\u2192        ids = np.array(self.index, copy=False)\n   931\u2192        geometries = np.array(self[self._geometry_column_name], copy=False)\n   932\u2192\n   933\u2192        if not self.columns.is_unique:\n   934\u2192            raise ValueError(\"GeoDataFrame cannot contain duplicated column names.\")\n   935\u2192\n   936\u2192        properties_cols = self.columns.drop(self._geometry_column_name)\n   937\u2192\n   938\u2192        if len(properties_cols) > 0:\n   939\u2192            # convert to object to get python scalars.\n   940\u2192            properties_cols = self[properties_cols]\n   941\u2192            properties = properties_cols.astype(object)\n   942\u2192            na_mask = pd.isna(properties_cols).values\n   943\u2192\n   944\u2192            if na == \"null\":\n   945\u2192                properties[na_mask] = None\n   946\u2192\n   947\u2192            for i, row in enumerate(properties.values):\n   948\u2192                geom = geometries[i]\n   949\u2192\n   950\u2192                if na == \"drop\":\n   951\u2192                    na_mask_row = na_mask[i]\n   952\u2192                    properties_items = {\n   953\u2192                        k: v\n   954\u2192                        for k, v, na in zip(properties_cols, row, na_mask_row)\n   955\u2192                        if not na\n   956\u2192                    }\n   957\u2192                else:\n   958\u2192                    properties_items = dict(zip(properties_cols, row))\n   959\u2192\n   960\u2192                if drop_id:\n   961\u2192                    feature = {}\n   962\u2192                else:\n   963\u2192                    feature = {\"id\": str(ids[i])}\n   964\u2192\n   965\u2192                feature[\"type\"] = \"Feature\"\n   966\u2192                feature[\"properties\"] = properties_items\n   967\u2192                feature[\"geometry\"] = mapping(geom) if geom else None\n   968\u2192\n   969\u2192                if show_bbox:\n   970\u2192                    feature[\"bbox\"] = geom.bounds if geom else None\n   971\u2192\n   972\u2192                yield feature\n   973\u2192\n   974\u2192        else:\n   975\u2192            for fid, geom in zip(ids, geometries):\n   976\u2192                if drop_id:\n   977\u2192                    feature = {}\n   978\u2192                else:\n   979\u2192                    feature = {\"id\": str(fid)}\n   980\u2192\n   981\u2192                feature[\"type\"] = \"Feature\"\n   982\u2192                feature[\"properties\"] = {}\n   983\u2192                feature[\"geometry\"] = mapping(geom) if geom else None\n   984\u2192\n   985\u2192                if show_bbox:\n   986\u2192                    feature[\"bbox\"] = geom.bounds if geom else None\n   987\u2192\n   988\u2192                yield feature\n   989\u2192\n   990\u2192    def _to_geo(self, **kwargs):\n   991\u2192        \"\"\"\n   992\u2192        Returns a python feature collection (i.e. the geointerface)\n   993\u2192        representation of the GeoDataFrame.\n   994\u2192\n   995\u2192        \"\"\"\n   996\u2192        geo = {\n   997\u2192            \"type\": \"FeatureCollection\",\n   998\u2192            \"features\": list(self.iterfeatures(**kwargs)),\n   999\u2192        }\n  1000\u2192\n  1001\u2192        if kwargs.get(\"show_bbox\", False):\n  1002\u2192            geo[\"bbox\"] = tuple(self.total_bounds)\n  1003\u2192\n  1004\u2192        return geo\n  1005\u2192\n  1006\u2192    def to_wkb(self, hex=False, **kwargs):\n  1007\u2192        \"\"\"\n  1008\u2192        Encode all geometry columns in the GeoDataFrame to WKB.\n  1009\u2192\n  1010\u2192        Parameters\n  1011\u2192        ----------\n  1012\u2192        hex : bool\n  1013\u2192            If true, export the WKB as a hexadecimal string.\n  1014\u2192            The default is to return a binary bytes object.\n  1015\u2192        kwargs\n  1016\u2192            Additional keyword args will be passed to\n  1017\u2192            :func:`shapely.to_wkb`.\n  1018\u2192\n  1019\u2192        Returns\n  1020\u2192        -------\n  1021\u2192        DataFrame\n  1022\u2192            geometry columns are encoded to WKB\n  1023\u2192        \"\"\"\n  1024\u2192\n  1025\u2192        df = DataFrame(self.copy())\n  1026\u2192\n  1027\u2192        # Encode all geometry columns to WKB\n  1028\u2192        for col in df.columns[df.dtypes == \"geometry\"]:\n  1029\u2192            df[col] = to_wkb(df[col].values, hex=hex, **kwargs)\n  1030\u2192\n  1031\u2192        return df\n  1032\u2192\n  1033\u2192    def to_wkt(self, **kwargs):\n  1034\u2192        \"\"\"\n  1035\u2192        Encode all geometry columns in the GeoDataFrame to WKT.\n  1036\u2192\n  1037\u2192        Parameters\n  1038\u2192        ----------\n  1039\u2192        kwargs\n  1040\u2192            Keyword args will be passed to :func:`shapely.to_wkt`.\n  1041\u2192\n  1042\u2192        Returns\n  1043\u2192        -------\n  1044\u2192        DataFrame\n  1045\u2192            geometry columns are encoded to WKT\n  1046\u2192        \"\"\"\n  1047\u2192\n  1048\u2192        df = DataFrame(self.copy())\n  1049\u2192\n  1050\u2192        # Encode all geometry columns to WKT\n  1051\u2192        for col in df.columns[df.dtypes == \"geometry\"]:\n  1052\u2192            df[col] = to_wkt(df[col].values, **kwargs)\n  1053\u2192\n  1054\u2192        return df\n  1055\u2192\n  1056\u2192    def to_parquet(\n  1057\u2192        self, path, index=None, compression=\"snappy\", schema_version=None, **kwargs\n  1058\u2192    ):\n  1059\u2192        \"\"\"Write a GeoDataFrame to the Parquet format.\n  1060\u2192\n  1061\u2192        Any geometry columns present are serialized to WKB format in the file.\n  1062\u2192\n  1063\u2192        Requires 'pyarrow'.\n  1064\u2192\n  1065\u2192        .. versionadded:: 0.8\n  1066\u2192\n  1067\u2192        Parameters\n  1068\u2192        ----------\n  1069\u2192        path : str, path object\n  1070\u2192        index : bool, default None\n  1071\u2192            If ``True``, always include the dataframe's index(es) as columns\n  1072\u2192            in the file output.\n  1073\u2192            If ``False``, the index(es) will not be written to the file.\n  1074\u2192            If ``None``, the index(ex) will be included as columns in the file\n  1075\u2192            output except `RangeIndex` which is stored as metadata only.\n  1076\u2192        compression : {'snappy', 'gzip', 'brotli', None}, default 'snappy'\n  1077\u2192            Name of the compression to use. Use ``None`` for no compression.\n  1078\u2192        schema_version : {'0.1.0', '0.4.0', '1.0.0', None}\n  1079\u2192            GeoParquet specification version; if not provided will default to\n  1080\u2192            latest supported version.\n  1081\u2192        kwargs\n  1082\u2192            Additional keyword arguments passed to :func:`pyarrow.parquet.write_table`.\n  1083\u2192\n  1084\u2192        Examples\n  1085\u2192        --------\n  1086\u2192\n  1087\u2192        >>> gdf.to_parquet('data.parquet')  # doctest: +SKIP\n  1088\u2192\n  1089\u2192        See also\n  1090\u2192        --------\n  1091\u2192        GeoDataFrame.to_feather : write GeoDataFrame to feather\n  1092\u2192        GeoDataFrame.to_file : write GeoDataFrame to file\n  1093\u2192        \"\"\"\n  1094\u2192\n  1095\u2192        # Accept engine keyword for compatibility with pandas.DataFrame.to_parquet\n  1096\u2192        # The only engine currently supported by GeoPandas is pyarrow, so no\n  1097\u2192        # other engine should be specified.\n  1098\u2192        engine = kwargs.pop(\"engine\", \"auto\")\n  1099\u2192        if engine not in (\"auto\", \"pyarrow\"):\n  1100\u2192            raise ValueError(\n  1101\u2192                f\"GeoPandas only supports using pyarrow as the engine for \"\n  1102\u2192                f\"to_parquet: {engine!r} passed instead.\"\n  1103\u2192            )\n  1104\u2192\n  1105\u2192        from geopandas.io.arrow import _to_parquet\n  1106\u2192\n  1107\u2192        _to_parquet(\n  1108\u2192            self,\n  1109\u2192            path,\n  1110\u2192            compression=compression,\n  1111\u2192            index=index,\n  1112\u2192            schema_version=schema_version,\n  1113\u2192            **kwargs,\n  1114\u2192        )\n  1115\u2192\n  1116\u2192    def to_feather(\n  1117\u2192        self, path, index=None, compression=None, schema_version=None, **kwargs\n  1118\u2192    ):\n  1119\u2192        \"\"\"Write a GeoDataFrame to the Feather format.\n  1120\u2192\n  1121\u2192        Any geometry columns present are serialized to WKB format in the file.\n  1122\u2192\n  1123\u2192        Requires 'pyarrow' >= 0.17.\n  1124\u2192\n  1125\u2192        .. versionadded:: 0.8\n  1126\u2192\n  1127\u2192        Parameters\n  1128\u2192        ----------\n  1129\u2192        path : str, path object\n  1130\u2192        index : bool, default None\n  1131\u2192            If ``True``, always include the dataframe's index(es) as columns\n  1132\u2192            in the file output.\n  1133\u2192            If ``False``, the index(es) will not be written to the file.\n  1134\u2192            If ``None``, the index(ex) will be included as columns in the file\n  1135\u2192            output except `RangeIndex` which is stored as metadata only.\n  1136\u2192        compression : {'zstd', 'lz4', 'uncompressed'}, optional\n  1137\u2192            Name of the compression to use. Use ``\"uncompressed\"`` for no\n  1138\u2192            compression. By default uses LZ4 if available, otherwise uncompressed.\n  1139\u2192        schema_version : {'0.1.0', '0.4.0', '1.0.0', None}\n  1140\u2192            GeoParquet specification version; if not provided will default to\n  1141\u2192            latest supported version.\n  1142\u2192        kwargs\n  1143\u2192            Additional keyword arguments passed to to\n  1144\u2192            :func:`pyarrow.feather.write_feather`.\n  1145\u2192\n  1146\u2192        Examples\n  1147\u2192        --------\n  1148\u2192\n  1149\u2192        >>> gdf.to_feather('data.feather')  # doctest: +SKIP\n  1150\u2192\n  1151\u2192        See also\n  1152\u2192        --------\n  1153\u2192        GeoDataFrame.to_parquet : write GeoDataFrame to parquet\n  1154\u2192        GeoDataFrame.to_file : write GeoDataFrame to file\n  1155\u2192        \"\"\"\n  1156\u2192\n  1157\u2192        from geopandas.io.arrow import _to_feather\n  1158\u2192\n  1159\u2192        _to_feather(\n  1160\u2192            self,\n  1161\u2192            path,\n  1162\u2192            index=index,\n  1163\u2192            compression=compression,\n  1164\u2192            schema_version=schema_version,\n  1165\u2192            **kwargs,\n  1166\u2192        )\n  1167\u2192\n  1168\u2192    def to_file(self, filename, driver=None, schema=None, index=None, **kwargs):\n  1169\u2192        \"\"\"Write the ``GeoDataFrame`` to a file.\n  1170\u2192\n  1171\u2192        By default, an ESRI shapefile is written, but any OGR data source\n  1172\u2192        supported by Fiona can be written. A dictionary of supported OGR\n  1173\u2192        providers is available via:\n  1174\u2192\n  1175\u2192        >>> import fiona\n  1176\u2192        >>> fiona.supported_drivers  # doctest: +SKIP\n  1177\u2192\n  1178\u2192        Parameters\n  1179\u2192        ----------\n  1180\u2192        filename : string\n  1181\u2192            File path or file handle to write to. The path may specify a\n  1182\u2192            GDAL VSI scheme.\n  1183\u2192        driver : string, default None\n  1184\u2192            The OGR format driver used to write the vector file.\n  1185\u2192            If not specified, it attempts to infer it from the file extension.\n  1186\u2192            If no extension is specified, it saves ESRI Shapefile to a folder.\n  1187\u2192        schema : dict, default None\n  1188\u2192            If specified, the schema dictionary is passed to Fiona to\n  1189\u2192            better control how the file is written. If None, GeoPandas\n  1190\u2192            will determine the schema based on each column's dtype.\n  1191\u2192            Not supported for the \"pyogrio\" engine.\n  1192\u2192        index : bool, default None\n  1193\u2192            If True, write index into one or more columns (for MultiIndex).\n  1194\u2192            Default None writes the index into one or more columns only if\n  1195\u2192            the index is named, is a MultiIndex, or has a non-integer data\n  1196\u2192            type. If False, no index is written.\n  1197\u2192\n  1198\u2192            .. versionadded:: 0.7\n  1199\u2192                Previously the index was not written.\n  1200\u2192        mode : string, default 'w'\n  1201\u2192            The write mode, 'w' to overwrite the existing file and 'a' to append.\n  1202\u2192            Not all drivers support appending. The drivers that support appending\n  1203\u2192            are listed in fiona.supported_drivers or\n  1204\u2192            https://github.com/Toblerity/Fiona/blob/master/fiona/drvsupport.py\n  1205\u2192        crs : pyproj.CRS, default None\n  1206\u2192            If specified, the CRS is passed to Fiona to\n  1207\u2192            better control how the file is written. If None, GeoPandas\n  1208\u2192            will determine the crs based on crs df attribute.\n  1209\u2192            The value can be anything accepted\n  1210\u2192            by :meth:`pyproj.CRS.from_user_input() <pyproj.crs.CRS.from_user_input>`,\n  1211\u2192            such as an authority string (eg \"EPSG:4326\") or a WKT string.\n  1212\u2192        engine : str, \"fiona\" or \"pyogrio\"\n  1213\u2192            The underlying library that is used to write the file. Currently, the\n  1214\u2192            supported options are \"fiona\" and \"pyogrio\". Defaults to \"fiona\" if\n  1215\u2192            installed, otherwise tries \"pyogrio\".\n  1216\u2192        **kwargs :\n  1217\u2192            Keyword args to be passed to the engine, and can be used to write\n  1218\u2192            to multi-layer data, store data within archives (zip files), etc.\n  1219\u2192            In case of the \"fiona\" engine, the keyword arguments are passed to\n  1220\u2192            fiona.open`. For more information on possible keywords, type:\n  1221\u2192            ``import fiona; help(fiona.open)``. In case of the \"pyogrio\" engine,\n  1222\u2192            the keyword arguments are passed to `pyogrio.write_dataframe`.\n  1223\u2192\n  1224\u2192        Notes\n  1225\u2192        -----\n  1226\u2192        The format drivers will attempt to detect the encoding of your data, but\n  1227\u2192        may fail. In this case, the proper encoding can be specified explicitly\n  1228\u2192        by using the encoding keyword parameter, e.g. ``encoding='utf-8'``.\n  1229\u2192\n  1230\u2192        See Also\n  1231\u2192        --------\n  1232\u2192        GeoSeries.to_file\n  1233\u2192        GeoDataFrame.to_postgis : write GeoDataFrame to PostGIS database\n  1234\u2192        GeoDataFrame.to_parquet : write GeoDataFrame to parquet\n  1235\u2192        GeoDataFrame.to_feather : write GeoDataFrame to feather\n  1236\u2192\n  1237\u2192        Examples\n  1238\u2192        --------\n  1239\u2192\n  1240\u2192        >>> gdf.to_file('dataframe.shp')  # doctest: +SKIP\n  1241\u2192\n  1242\u2192        >>> gdf.to_file('dataframe.gpkg', driver='GPKG', layer='name')  # doctest: +SKIP\n  1243\u2192\n  1244\u2192        >>> gdf.to_file('dataframe.geojson', driver='GeoJSON')  # doctest: +SKIP\n  1245\u2192\n  1246\u2192        With selected drivers you can also append to a file with `mode=\"a\"`:\n  1247\u2192\n  1248\u2192        >>> gdf.to_file('dataframe.shp', mode=\"a\")  # doctest: +SKIP\n  1249\u2192\n  1250\u2192        Using the engine-specific keyword arguments it is possible to e.g. create a\n  1251\u2192        spatialite file with a custom layer name:\n  1252\u2192\n  1253\u2192        >>> gdf.to_file(\n  1254\u2192        ...     'dataframe.sqlite', driver='SQLite', spatialite=True, layer='test'\n  1255\u2192        ... )  # doctest: +SKIP\n  1256\u2192\n  1257\u2192        \"\"\"\n  1258\u2192        from geopandas.io.file import _to_file\n  1259\u2192\n  1260\u2192        _to_file(self, filename, driver, schema, index, **kwargs)\n  1261\u2192\n  1262\u2192    def set_crs(self, crs=None, epsg=None, inplace=False, allow_override=False):\n  1263\u2192        \"\"\"\n  1264\u2192        Set the Coordinate Reference System (CRS) of the ``GeoDataFrame``.\n  1265\u2192\n  1266\u2192        If there are multiple geometry columns within the GeoDataFrame, only\n  1267\u2192        the CRS of the active geometry column is set.\n  1268\u2192\n  1269\u2192        NOTE: The underlying geometries are not transformed to this CRS. To\n  1270\u2192        transform the geometries to a new CRS, use the ``to_crs`` method.\n  1271\u2192\n  1272\u2192        Parameters\n  1273\u2192        ----------\n  1274\u2192        crs : pyproj.CRS, optional if `epsg` is specified\n  1275\u2192            The value can be anything accepted\n  1276\u2192            by :meth:`pyproj.CRS.from_user_input() <pyproj.crs.CRS.from_user_input>`,\n  1277\u2192            such as an authority string (eg \"EPSG:4326\") or a WKT string.\n  1278\u2192        epsg : int, optional if `crs` is specified\n  1279\u2192            EPSG code specifying the projection.\n  1280\u2192        inplace : bool, default False\n  1281\u2192            If True, the CRS of the GeoDataFrame will be changed in place\n  1282\u2192            (while still returning the result) instead of making a copy of\n  1283\u2192            the GeoDataFrame.\n  1284\u2192        allow_override : bool, default False\n  1285\u2192            If the the GeoDataFrame already has a CRS, allow to replace the\n  1286\u2192            existing CRS, even when both are not equal.\n  1287\u2192\n  1288\u2192        Examples\n  1289\u2192        --------\n  1290\u2192        >>> from shapely.geometry import Point\n  1291\u2192        >>> d = {'col1': ['name1', 'name2'], 'geometry': [Point(1, 2), Point(2, 1)]}\n  1292\u2192        >>> gdf = geopandas.GeoDataFrame(d)\n  1293\u2192        >>> gdf\n  1294\u2192            col1     geometry\n  1295\u2192        0  name1  POINT (1 2)\n  1296\u2192        1  name2  POINT (2 1)\n  1297\u2192\n  1298\u2192        Setting CRS to a GeoDataFrame without one:\n  1299\u2192\n  1300\u2192        >>> gdf.crs is None\n  1301\u2192        True\n  1302\u2192\n  1303\u2192        >>> gdf = gdf.set_crs('epsg:3857')\n  1304\u2192        >>> gdf.crs  # doctest: +SKIP\n  1305\u2192        <Projected CRS: EPSG:3857>\n  1306\u2192        Name: WGS 84 / Pseudo-Mercator\n  1307\u2192        Axis Info [cartesian]:\n  1308\u2192        - X[east]: Easting (metre)\n  1309\u2192        - Y[north]: Northing (metre)\n  1310\u2192        Area of Use:\n  1311\u2192        - name: World - 85\u00b0S to 85\u00b0N\n  1312\u2192        - bounds: (-180.0, -85.06, 180.0, 85.06)\n  1313\u2192        Coordinate Operation:\n  1314\u2192        - name: Popular Visualisation Pseudo-Mercator\n  1315\u2192        - method: Popular Visualisation Pseudo Mercator\n  1316\u2192        Datum: World Geodetic System 1984\n  1317\u2192        - Ellipsoid: WGS 84\n  1318\u2192        - Prime Meridian: Greenwich\n  1319\u2192\n  1320\u2192        Overriding existing CRS:\n  1321\u2192\n  1322\u2192        >>> gdf = gdf.set_crs(4326, allow_override=True)\n  1323\u2192\n  1324\u2192        Without ``allow_override=True``, ``set_crs`` returns an error if you try to\n  1325\u2192        override CRS.\n  1326\u2192\n  1327\u2192        See also\n  1328\u2192        --------\n  1329\u2192        GeoDataFrame.to_crs : re-project to another CRS\n  1330\u2192\n  1331\u2192        \"\"\"\n  1332\u2192        if not inplace:\n  1333\u2192            df = self.copy()\n  1334\u2192        else:\n  1335\u2192            df = self\n  1336\u2192        df.geometry = df.geometry.set_crs(\n  1337\u2192            crs=crs, epsg=epsg, allow_override=allow_override, inplace=True\n  1338\u2192        )\n  1339\u2192        return df\n  1340\u2192\n  1341\u2192    def to_crs(self, crs=None, epsg=None, inplace=False):\n  1342\u2192        \"\"\"Transform geometries to a new coordinate reference system.\n  1343\u2192\n  1344\u2192        Transform all geometries in an active geometry column to a different coordinate\n  1345\u2192        reference system.  The ``crs`` attribute on the current GeoSeries must\n  1346\u2192        be set.  Either ``crs`` or ``epsg`` may be specified for output.\n  1347\u2192\n  1348\u2192        This method will transform all points in all objects. It has no notion\n  1349\u2192        of projecting entire geometries.  All segments joining points are\n  1350\u2192        assumed to be lines in the current projection, not geodesics. Objects\n  1351\u2192        crossing the dateline (or other projection boundary) will have\n  1352\u2192        undesirable behavior.\n  1353\u2192\n  1354\u2192        Parameters\n  1355\u2192        ----------\n  1356\u2192        crs : pyproj.CRS, optional if `epsg` is specified\n  1357\u2192            The value can be anything accepted by\n  1358\u2192            :meth:`pyproj.CRS.from_user_input() <pyproj.crs.CRS.from_user_input>`,\n  1359\u2192            such as an authority string (eg \"EPSG:4326\") or a WKT string.\n  1360\u2192        epsg : int, optional if `crs` is specified\n  1361\u2192            EPSG code specifying output projection.\n  1362\u2192        inplace : bool, optional, default: False\n  1363\u2192            Whether to return a new GeoDataFrame or do the transformation in\n  1364\u2192            place.\n  1365\u2192\n  1366\u2192        Returns\n  1367\u2192        -------\n  1368\u2192        GeoDataFrame\n  1369\u2192\n  1370\u2192        Examples\n  1371\u2192        --------\n  1372\u2192        >>> from shapely.geometry import Point\n  1373\u2192        >>> d = {'col1': ['name1', 'name2'], 'geometry': [Point(1, 2), Point(2, 1)]}\n  1374\u2192        >>> gdf = geopandas.GeoDataFrame(d, crs=4326)\n  1375\u2192        >>> gdf\n  1376\u2192            col1     geometry\n  1377\u2192        0  name1  POINT (1 2)\n  1378\u2192        1  name2  POINT (2 1)\n  1379\u2192        >>> gdf.crs  # doctest: +SKIP\n  1380\u2192        <Geographic 2D CRS: EPSG:4326>\n  1381\u2192        Name: WGS 84\n  1382\u2192        Axis Info [ellipsoidal]:\n  1383\u2192        - Lat[north]: Geodetic latitude (degree)\n  1384\u2192        - Lon[east]: Geodetic longitude (degree)\n  1385\u2192        Area of Use:\n  1386\u2192        - name: World\n  1387\u2192        - bounds: (-180.0, -90.0, 180.0, 90.0)\n  1388\u2192        Datum: World Geodetic System 1984\n  1389\u2192        - Ellipsoid: WGS 84\n  1390\u2192        - Prime Meridian: Greenwich\n  1391\u2192\n  1392\u2192        >>> gdf = gdf.to_crs(3857)\n  1393\u2192        >>> gdf\n  1394\u2192            col1                       geometry\n  1395\u2192        0  name1  POINT (111319.491 222684.209)\n  1396\u2192        1  name2  POINT (222638.982 111325.143)\n  1397\u2192        >>> gdf.crs  # doctest: +SKIP\n  1398\u2192        <Projected CRS: EPSG:3857>\n  1399\u2192        Name: WGS 84 / Pseudo-Mercator\n  1400\u2192        Axis Info [cartesian]:\n  1401\u2192        - X[east]: Easting (metre)\n  1402\u2192        - Y[north]: Northing (metre)\n  1403\u2192        Area of Use:\n  1404\u2192        - name: World - 85\u00b0S to 85\u00b0N\n  1405\u2192        - bounds: (-180.0, -85.06, 180.0, 85.06)\n  1406\u2192        Coordinate Operation:\n  1407\u2192        - name: Popular Visualisation Pseudo-Mercator\n  1408\u2192        - method: Popular Visualisation Pseudo Mercator\n  1409\u2192        Datum: World Geodetic System 1984\n  1410\u2192        - Ellipsoid: WGS 84\n  1411\u2192        - Prime Meridian: Greenwich\n  1412\u2192\n  1413\u2192        See also\n  1414\u2192        --------\n  1415\u2192        GeoDataFrame.set_crs : assign CRS without re-projection\n  1416\u2192        \"\"\"\n  1417\u2192        if inplace:\n  1418\u2192            df = self\n  1419\u2192        else:\n  1420\u2192            df = self.copy()\n  1421\u2192        geom = df.geometry.to_crs(crs=crs, epsg=epsg)\n  1422\u2192        df.geometry = geom\n  1423\u2192        if not inplace:\n  1424\u2192            return df\n  1425\u2192\n  1426\u2192    def estimate_utm_crs(self, datum_name=\"WGS 84\"):\n  1427\u2192        \"\"\"Returns the estimated UTM CRS based on the bounds of the dataset.\n  1428\u2192\n  1429\u2192        .. versionadded:: 0.9\n  1430\u2192\n  1431\u2192        Parameters\n  1432\u2192        ----------\n  1433\u2192        datum_name : str, optional\n  1434\u2192            The name of the datum to use in the query. Default is WGS 84.\n  1435\u2192\n  1436\u2192        Returns\n  1437\u2192        -------\n  1438\u2192        pyproj.CRS\n  1439\u2192\n  1440\u2192        Examples\n  1441\u2192        --------\n  1442\u2192        >>> import geodatasets\n  1443\u2192        >>> df = geopandas.read_file(\n  1444\u2192        ...     geodatasets.get_path(\"geoda.chicago_health\")\n  1445\u2192        ... )\n  1446\u2192        >>> df.estimate_utm_crs()  # doctest: +SKIP\n  1447\u2192        <Derived Projected CRS: EPSG:32616>\n  1448\u2192        Name: WGS 84 / UTM zone 16N\n  1449\u2192        Axis Info [cartesian]:\n  1450\u2192        - E[east]: Easting (metre)\n  1451\u2192        - N[north]: Northing (metre)\n  1452\u2192        Area of Use:\n  1453\u2192        - name: Between 90\u00b0W and 84\u00b0W, northern hemisphere between equator and 84\u00b0N...\n  1454\u2192        - bounds: (-90.0, 0.0, -84.0, 84.0)\n  1455\u2192        Coordinate Operation:\n  1456\u2192        - name: UTM zone 16N\n  1457\u2192        - method: Transverse Mercator\n  1458\u2192        Datum: World Geodetic System 1984 ensemble\n  1459\u2192        - Ellipsoid: WGS 84\n  1460\u2192        - Prime Meridian: Greenwich\n  1461\u2192        \"\"\"\n  1462\u2192        return self.geometry.estimate_utm_crs(datum_name=datum_name)\n  1463\u2192\n  1464\u2192    def __getitem__(self, key):\n  1465\u2192        \"\"\"\n  1466\u2192        If the result is a column containing only 'geometry', return a\n  1467\u2192        GeoSeries. If it's a DataFrame with any columns of GeometryDtype,\n  1468\u2192        return a GeoDataFrame.\n  1469\u2192        \"\"\"\n  1470\u2192        result = super().__getitem__(key)\n  1471\u2192        # Custom logic to avoid waiting for pandas GH51895\n  1472\u2192        # result is not geometry dtype for multi-indexes\n  1473\u2192        if (\n  1474\u2192            pd.api.types.is_scalar(key)\n  1475\u2192            and key == \"\"\n  1476\u2192            and isinstance(self.columns, pd.MultiIndex)\n  1477\u2192            and isinstance(result, Series)\n  1478\u2192            and not is_geometry_type(result)\n  1479\u2192        ):\n  1480\u2192            loc = self.columns.get_loc(key)\n  1481\u2192            # squeeze stops multilevel columns from returning a gdf\n  1482\u2192            result = self.iloc[:, loc].squeeze(axis=\"columns\")\n  1483\u2192        geo_col = self._geometry_column_name\n  1484\u2192        if isinstance(result, Series) and isinstance(result.dtype, GeometryDtype):\n  1485\u2192            result.__class__ = GeoSeries\n  1486\u2192        elif isinstance(result, DataFrame):\n  1487\u2192            if (result.dtypes == \"geometry\").sum() > 0:\n  1488\u2192                result.__class__ = GeoDataFrame\n  1489\u2192                if geo_col in result:\n  1490\u2192                    result._geometry_column_name = geo_col\n  1491\u2192            else:\n  1492\u2192                result.__class__ = DataFrame\n  1493\u2192        return result\n  1494\u2192\n  1495\u2192    def _persist_old_default_geometry_colname(self):\n  1496\u2192        \"\"\"Internal util to temporarily persist the default geometry column\n  1497\u2192        name of 'geometry' for backwards compatibility.\"\"\"\n  1498\u2192        # self.columns check required to avoid this warning in __init__\n  1499\u2192        if self._geometry_column_name is None and \"geometry\" not in self.columns:\n  1500\u2192            msg = (\n  1501\u2192                \"You are adding a column named 'geometry' to a GeoDataFrame \"\n  1502\u2192                \"constructed without an active geometry column. Currently, \"\n  1503\u2192                \"this automatically sets the active geometry column to 'geometry' \"\n  1504\u2192                \"but in the future that will no longer happen. Instead, either \"\n  1505\u2192                \"provide geometry to the GeoDataFrame constructor \"\n  1506\u2192                \"(GeoDataFrame(... geometry=GeoSeries()) or use \"\n  1507\u2192                \"`set_geometry('geometry')` \"\n  1508\u2192                \"to explicitly set the active geometry column.\"\n  1509\u2192            )\n  1510\u2192            warnings.warn(msg, category=FutureWarning, stacklevel=3)\n  1511\u2192            self._geometry_column_name = \"geometry\"\n  1512\u2192\n  1513\u2192    def __setitem__(self, key, value):\n  1514\u2192        \"\"\"\n  1515\u2192        Overwritten to preserve CRS of GeometryArray in cases like\n  1516\u2192        df['geometry'] = [geom... for geom in df.geometry]\n  1517\u2192        \"\"\"\n  1518\u2192\n  1519\u2192        if not pd.api.types.is_list_like(key) and (\n  1520\u2192            key == self._geometry_column_name\n  1521\u2192            or key == \"geometry\"\n  1522\u2192            and self._geometry_column_name is None\n  1523\u2192        ):\n  1524\u2192            if pd.api.types.is_scalar(value) or isinstance(value, BaseGeometry):\n  1525\u2192                value = [value] * self.shape[0]\n  1526\u2192            try:\n  1527\u2192                if self._geometry_column_name is not None:\n  1528\u2192                    crs = getattr(self, \"crs\", None)\n  1529\u2192                else:  # don't use getattr, because a col \"crs\" might exist\n  1530\u2192                    crs = None\n  1531\u2192                value = _ensure_geometry(value, crs=crs)\n  1532\u2192                if key == \"geometry\":\n  1533\u2192                    self._persist_old_default_geometry_colname()\n  1534\u2192            except TypeError:\n  1535\u2192                warnings.warn(\n  1536\u2192                    \"Geometry column does not contain geometry.\",\n  1537\u2192                    stacklevel=2,\n  1538\u2192                )\n  1539\u2192        super().__setitem__(key, value)\n  1540\u2192\n  1541\u2192    #\n  1542\u2192    # Implement pandas methods\n  1543\u2192    #\n  1544\u2192    @doc(pd.DataFrame)\n  1545\u2192    def copy(self, deep=True):\n  1546\u2192        copied = super().copy(deep=deep)\n  1547\u2192      