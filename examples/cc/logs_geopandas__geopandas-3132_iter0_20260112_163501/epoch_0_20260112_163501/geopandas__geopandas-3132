rame index is [4,3,2,1,0] and the\n   316→        # GeoSeries index is [0,1,2,3,4]. Make sure set_geometry aligns\n   317→        # them to match indexes\n   318→        df = self.df.set_geometry(g)\n   319→\n   320→        for i, r in df.iterrows():\n   321→            assert i == r[\"geometry\"].x\n   322→            assert i == r[\"geometry\"].y\n   323→\n   324→    def test_set_geometry_empty(self):\n   325→        df = pd.DataFrame(columns=[\"a\", \"geometry\"], index=pd.DatetimeIndex([]))\n   326→        result = df.set_geometry(\"geometry\")\n   327→        assert isinstance(result, GeoDataFrame)\n   328→        assert isinstance(result.index, pd.DatetimeIndex)\n   329→\n   330→    def test_set_geometry_np_int(self):\n   331→        self.df.loc[:, 0] = self.df.geometry\n   332→        df = self.df.set_geometry(np.int64(0))\n   333→        assert df.geometry.name == 0\n   334→\n   335→    def test_get_geometry_invalid(self):\n   336→        df = GeoDataFrame()\n   337→        # no column \"geometry\" ever added\n   338→        df[\"geom\"] = self.df.geometry\n   339→        msg_geo_col_none = \"active geometry column to use has not been set. \"\n   340→\n   341→        with pytest.raises(AttributeError, match=msg_geo_col_none):\n   342→            df.geometry\n   343→        # \"geometry\" originally present but dropped (but still a gdf)\n   344→        col_subset_drop_geometry = [\"BoroCode\", \"BoroName\", \"geom2\"]\n   345→        df2 = self.df.copy().assign(geom2=self.df.geometry)[col_subset_drop_geometry]\n   346→        with pytest.raises(AttributeError, match=\"is not present.\"):\n   347→            df2.geometry\n   348→\n   349→        msg_other_geo_cols_present = \"There are columns with geometry data type\"\n   350→        msg_no_other_geo_cols = \"There are no existing columns with geometry data type\"\n   351→        with pytest.raises(AttributeError, match=msg_other_geo_cols_present):\n   352→            df2.geometry\n   353→\n   354→        with pytest.raises(AttributeError, match=msg_no_other_geo_cols):\n   355→            GeoDataFrame().geometry\n   356→\n   357→    def test_get_geometry_geometry_inactive(self):\n   358→        # https://github.com/geopandas/geopandas/issues/2574\n   359→        df = self.df.assign(geom2=self.df.geometry).set_geometry(\"geom2\")\n   360→        df = df.loc[:, [\"BoroName\", \"geometry\"]]\n   361→        assert df._geometry_column_name == \"geom2\"\n   362→        msg_geo_col_missing = \"is not present. \"\n   363→        # Check that df.geometry raises if active geometry column is missing,\n   364→        # it should not fall back to column named \"geometry\"\n   365→        with pytest.raises(AttributeError, match=msg_geo_col_missing):\n   366→            df.geometry\n   367→\n   368→    def test_active_geometry_name(self):\n   369→        # default single active called \"geometry\"\n   370→        assert self.df.active_geometry_name == \"geometry\"\n   371→\n   372→        # one GeoSeries, not active\n   373→        no_active = GeoDataFrame({\"foo\": self.df.BoroName, \"bar\": self.df.geometry})\n   374→        assert no_active.active_geometry_name is None\n   375→        assert no_active.set_geometry(\"bar\").active_geometry_name == \"bar\"\n   376→\n   377→        # multiple, none active\n   378→        multiple = GeoDataFrame({\"foo\": self.df.geometry, \"bar\": self.df.geometry})\n   379→        assert multiple.active_geometry_name is None\n   380→        assert multiple.set_geometry(\"foo\").active_geometry_name == \"foo\"\n   381→        assert multiple.set_geometry(\"bar\").active_geometry_name == \"bar\"\n   382→\n   383→    def test_align(self):\n   384→        df = self.df2\n   385→\n   386→        res1, res2 = df.align(df)\n   387→        assert_geodataframe_equal(res1, df)\n   388→        assert_geodataframe_equal(res2, df)\n   389→\n   390→        res1, res2 = df.align(df.copy())\n   391→        assert_geodataframe_equal(res1, df)\n   392→        assert_geodataframe_equal(res2, df)\n   393→\n   394→        # assert crs is / is not preserved on mixed dataframes\n   395→        df_nocrs = df.copy()\n   396→        df_nocrs.crs = None\n   397→        res1, res2 = df.align(df_nocrs)\n   398→        assert_geodataframe_equal(res1, df)\n   399→        assert res1.crs is not None\n   400→        assert_geodataframe_equal(res2, df_nocrs)\n   401→        assert res2.crs is None\n   402→\n   403→        # mixed GeoDataFrame / DataFrame\n   404→        df_nogeom = pd.DataFrame(df.drop(\"geometry\", axis=1))\n   405→        res1, res2 = df.align(df_nogeom, axis=0)\n   406→        assert_geodataframe_equal(res1, df)\n   407→        assert type(res2) == pd.DataFrame\n   408→        assert_frame_equal(res2, df_nogeom)\n   409→\n   410→        # same as above but now with actual alignment\n   411→        df1 = df.iloc[1:].copy()\n   412→        df2 = df.iloc[:-1].copy()\n   413→\n   414→        exp1 = df.copy()\n   415→        exp1.iloc[0] = np.nan\n   416→        exp2 = df.copy()\n   417→        exp2.iloc[-1] = np.nan\n   418→        res1, res2 = df1.align(df2)\n   419→        assert_geodataframe_equal(res1, exp1)\n   420→        assert_geodataframe_equal(res2, exp2)\n   421→\n   422→        df2_nocrs = df2.copy()\n   423→        df2_nocrs.crs = None\n   424→        exp2_nocrs = exp2.copy()\n   425→        exp2_nocrs.crs = None\n   426→        res1, res2 = df1.align(df2_nocrs)\n   427→        assert_geodataframe_equal(res1, exp1)\n   428→        assert res1.crs is not None\n   429→        assert_geodataframe_equal(res2, exp2_nocrs)\n   430→        assert res2.crs is None\n   431→\n   432→        df2_nogeom = pd.DataFrame(df2.drop(\"geometry\", axis=1))\n   433→        exp2_nogeom = pd.DataFrame(exp2.drop(\"geometry\", axis=1))\n   434→        res1, res2 = df1.align(df2_nogeom, axis=0)\n   435→        assert_geodataframe_equal(res1, exp1)\n   436→        assert type(res2) == pd.DataFrame\n   437→        assert_frame_equal(res2, exp2_nogeom)\n   438→\n   439→    def test_to_json(self):\n   440→        text = self.df.to_json(to_wgs84=True)\n   441→        data = json.loads(text)\n   442→        assert data[\"type\"] == \"FeatureCollection\"\n   443→        assert len(data[\"features\"]) == 5\n   444→        assert \"id\" in data[\"features\"][0].keys()\n   445→\n   446→        # check it converts to WGS84\n   447→        coord = data[\"features\"][0][\"geometry\"][\"coordinates\"][0][0][0]\n   448→        np.testing.assert_allclose(coord, [-74.0505080640324, 40.5664220341941])\n   449→\n   450→    def test_to_json_wgs84_false(self):\n   451→        text = self.df.to_json()\n   452→        data = json.loads(text)\n   453→        # check it doesn't convert to WGS84\n   454→        coord = data[\"features\"][0][\"geometry\"][\"coordinates\"][0][0][0]\n   455→        assert coord == [970217.0223999023, 145643.33221435547]\n   456→\n   457→    def test_to_json_no_crs(self):\n   458→        self.df.crs = None\n   459→        with pytest.raises(ValueError, match=\"CRS is not set\"):\n   460→            self.df.to_json(to_wgs84=True)\n   461→\n   462→    @pytest.mark.filterwarnings(\n   463→        \"ignore:Geometry column does not contain geometry:UserWarning\"\n   464→    )\n   465→    def test_to_json_geom_col(self):\n   466→        df = self.df.copy()\n   467→        df[\"geom\"] = df[\"geometry\"]\n   468→        df[\"geometry\"] = np.arange(len(df))\n   469→        df.set_geometry(\"geom\", inplace=True)\n   470→\n   471→        text = df.to_json()\n   472→        data = json.loads(text)\n   473→        assert data[\"type\"] == \"FeatureCollection\"\n   474→        assert len(data[\"features\"]) == 5\n   475→\n   476→    def test_to_json_only_geom_column(self):\n   477→        text = self.df[[\"geometry\"]].to_json()\n   478→        data = json.loads(text)\n   479→        assert len(data[\"features\"]) == 5\n   480→        assert \"id\" in data[\"features\"][0].keys()\n   481→\n   482→    def test_to_json_na(self):\n   483→        # Set a value as nan and make sure it's written\n   484→        self.df.loc[self.df[\"BoroName\"] == \"Queens\", \"Shape_Area\"] = np.nan\n   485→\n   486→        text = self.df.to_json()\n   487→        data = json.loads(text)\n   488→        assert len(data[\"features\"]) == 5\n   489→        for f in data[\"features\"]:\n   490→            props = f[\"properties\"]\n   491→            assert len(props) == 4\n   492→            if props[\"BoroName\"] == \"Queens\":\n   493→                assert props[\"Shape_Area\"] is None\n   494→\n   495→    def test_to_json_bad_na(self):\n   496→        # Check that a bad na argument raises error\n   497→        with pytest.raises(ValueError):\n   498→            self.df.to_json(na=\"garbage\")\n   499→\n   500→    def test_to_json_dropna(self):\n   501→        self.df.loc[self.df[\"BoroName\"] == \"Queens\", \"Shape_Area\"] = np.nan\n   502→        self.df.loc[self.df[\"BoroName\"] == \"Bronx\", \"Shape_Leng\"] = np.nan\n   503→\n   504→        text = self.df.to_json(na=\"drop\")\n   505→        data = json.loads(text)\n   506→        assert len(data[\"features\"]) == 5\n   507→        for f in data[\"features\"]:\n   508→            props = f[\"properties\"]\n   509→            if props[\"BoroName\"] == \"Queens\":\n   510→                assert len(props) == 3\n   511→                assert \"Shape_Area\" not in props\n   512→                # Just make sure setting it to nan in a different row\n   513→                # doesn't affect this one\n   514→                assert \"Shape_Leng\" in props\n   515→            elif props[\"BoroName\"] == \"Bronx\":\n   516→                assert len(props) == 3\n   517→                assert \"Shape_Leng\" not in props\n   518→                assert \"Shape_Area\" in props\n   519→            else:\n   520→                assert len(props) == 4\n   521→\n   522→    def test_to_json_keepna(self):\n   523→        self.df.loc[self.df[\"BoroName\"] == \"Queens\", \"Shape_Area\"] = np.nan\n   524→        self.df.loc[self.df[\"BoroName\"] == \"Bronx\", \"Shape_Leng\"] = np.nan\n   525→\n   526→        text = self.df.to_json(na=\"keep\")\n   527→        data = json.loads(text)\n   528→        assert len(data[\"features\"]) == 5\n   529→        for f in data[\"features\"]:\n   530→            props = f[\"properties\"]\n   531→            assert len(props) == 4\n   532→            if props[\"BoroName\"] == \"Queens\":\n   533→                assert np.isnan(props[\"Shape_Area\"])\n   534→                # Just make sure setting it to nan in a different row\n   535→                # doesn't affect this one\n   536→                assert \"Shape_Leng\" in props\n   537→            elif props[\"BoroName\"] == \"Bronx\":\n   538→                assert np.isnan(props[\"Shape_Leng\"])\n   539→                assert \"Shape_Area\" in props\n   540→\n   541→    def test_to_json_drop_id(self):\n   542→        text = self.df.to_json(drop_id=True)\n   543→        data = json.loads(text)\n   544→        assert len(data[\"features\"]) == 5\n   545→        for f in data[\"features\"]:\n   546→            assert \"id\" not in f.keys()\n   547→\n   548→    def test_to_json_drop_id_only_geom_column(self):\n   549→        text = self.df[[\"geometry\"]].to_json(drop_id=True)\n   550→        data = json.loads(text)\n   551→        assert len(data[\"features\"]) == 5\n   552→        for f in data[\"features\"]:\n   553→            assert \"id\" not in f.keys()\n   554→\n   555→    def test_to_json_with_duplicate_columns(self):\n   556→        df = GeoDataFrame(\n   557→            data=[[1, 2, 3]], columns=[\"a\", \"b\", \"a\"], geometry=[Point(1, 1)]\n   558→        )\n   559→        with pytest.raises(\n   560→            ValueError, match=\"GeoDataFrame cannot contain duplicated column names.\"\n   561→        ):\n   562→            df.to_json()\n   563→\n   564→    def test_copy(self):\n   565→        df2 = self.df.copy()\n   566→        assert type(df2) is GeoDataFrame\n   567→        assert self.df.crs == df2.crs\n   568→\n   569→    def test_empty_copy(self):\n   570→        # https://github.com/geopandas/geopandas/issues/2765\n   571→        df = GeoDataFrame()\n   572→        df2 = df.copy()\n   573→        assert type(df2) is GeoDataFrame\n   574→        df3 = df.copy(deep=True)\n   575→        assert type(df3) is GeoDataFrame\n   576→\n   577→    def test_no_geom_copy(self):\n   578→        df = GeoDataFrame(pd.DataFrame({\"a\": [1, 2, 3]}))\n   579→        assert type(df) is GeoDataFrame\n   580→        assert type(df.copy()) is GeoDataFrame\n   581→\n   582→    def test_bool_index(self):\n   583→        # Find boros with 'B' in their name\n   584→        df = self.df[self.df[\"BoroName\"].str.contains(\"B\")]\n   585→        assert len(df) == 2\n   586→        boros = df[\"BoroName\"].values\n   587→        assert \"Brooklyn\" in boros\n   588→        assert \"Bronx\" in boros\n   589→        assert type(df) is GeoDataFrame\n   590→\n   591→    def test_coord_slice_points(self):\n   592→        assert self.df2.cx[-2:-1, -2:-1].empty\n   593→        assert_frame_equal(self.df2, self.df2.cx[:, :])\n   594→        assert_frame_equal(self.df2.loc[5:], self.df2.cx[5:, :])\n   595→        assert_frame_equal(self.df2.loc[5:], self.df2.cx[:, 5:])\n   596→        assert_frame_equal(self.df2.loc[5:], self.df2.cx[5:, 5:])\n   597→\n   598→    def test_from_dict(self):\n   599→        data = {\"A\": [1], \"geometry\": [Point(0.0, 0.0)]}\n   600→        df = GeoDataFrame.from_dict(data, crs=3857)\n   601→        assert df.crs == \"epsg:3857\"\n   602→        assert df._geometry_column_name == \"geometry\"\n   603→\n   604→        data = {\"B\": [1], \"location\": [Point(0.0, 0.0)]}\n   605→        df = GeoDataFrame.from_dict(data, geometry=\"location\")\n   606→        assert df._geometry_column_name == \"location\"\n   607→\n   608→    def test_from_features(self, nybb_filename):\n   609→        fiona = pytest.importorskip(\"fiona\")\n   610→        with fiona.open(nybb_filename) as f:\n   611→            features = list(f)\n   612→            crs = f.crs_wkt\n   613→\n   614→        df = GeoDataFrame.from_features(features, crs=crs)\n   615→        validate_boro_df(df, case_sensitive=True)\n   616→        assert df.crs == crs\n   617→\n   618→    def test_from_features_unaligned_properties(self):\n   619→        p1 = Point(1, 1)\n   620→        f1 = {\n   621→            \"type\": \"Feature\",\n   622→            \"properties\": {\"a\": 0},\n   623→            \"geometry\": p1.__geo_interface__,\n   624→        }\n   625→\n   626→        p2 = Point(2, 2)\n   627→        f2 = {\n   628→            \"type\": \"Feature\",\n   629→            \"properties\": {\"b\": 1},\n   630→            \"geometry\": p2.__geo_interface__,\n   631→        }\n   632→\n   633→        p3 = Point(3, 3)\n   634→        f3 = {\n   635→            \"type\": \"Feature\",\n   636→            \"properties\": None,\n   637→            \"geometry\": p3.__geo_interface__,\n   638→        }\n   639→\n   640→        df = GeoDataFrame.from_features([f1, f2, f3])\n   641→\n   642→        result = df[[\"a\", \"b\"]]\n   643→        expected = pd.DataFrame.from_dict(\n   644→            [{\"a\": 0, \"b\": np.nan}, {\"a\": np.nan, \"b\": 1}, {\"a\": np.nan, \"b\": np.nan}]\n   645→        )\n   646→        assert_frame_equal(expected, result)\n   647→\n   648→    def test_from_features_empty_properties(self):\n   649→        geojson_properties_object = \"\"\"{\n   650→          \"type\": \"FeatureCollection\",\n   651→          \"features\": [\n   652→            {\n   653→              \"type\": \"Feature\",\n   654→              \"properties\": {},\n   655→              \"geometry\": {\n   656→                \"type\": \"Polygon\",\n   657→                \"coordinates\": [\n   658→                  [\n   659→                    [\n   660→                      11.3456529378891,\n   661→                      46.49461446367692\n   662→                    ],\n   663→                    [\n   664→                      11.345674395561216,\n   665→                      46.494097442978195\n   666→                    ],\n   667→                    [\n   668→                      11.346918940544128,\n   669→                      46.49385370294394\n   670→                    ],\n   671→                    [\n   672→                      11.347616314888,\n   673→                      46.4938352377453\n   674→                    ],\n   675→                    [\n   676→                      11.347514390945435,\n   677→                      46.49466985846028\n   678→                    ],\n   679→                    [\n   680→                      11.3456529378891,\n   681→                      46.49461446367692\n   682→                    ]\n   683→                  ]\n   684→                ]\n   685→              }\n   686→            }\n   687→          ]\n   688→        }\"\"\"\n   689→\n   690→        geojson_properties_null = \"\"\"{\n   691→          \"type\": \"FeatureCollection\",\n   692→          \"features\": [\n   693→            {\n   694→              \"type\": \"Feature\",\n   695→              \"properties\": null,\n   696→              \"geometry\": {\n   697→                \"type\": \"Polygon\",\n   698→                \"coordinates\": [\n   699→                  [\n   700→                    [\n   701→                      11.3456529378891,\n   702→                      46.49461446367692\n   703→                    ],\n   704→                    [\n   705→                      11.345674395561216,\n   706→                      46.494097442978195\n   707→                    ],\n   708→                    [\n   709→                      11.346918940544128,\n   710→                      46.49385370294394\n   711→                    ],\n   712→                    [\n   713→                      11.347616314888,\n   714→                      46.4938352377453\n   715→                    ],\n   716→                    [\n   717→                      11.347514390945435,\n   718→                      46.49466985846028\n   719→                    ],\n   720→                    [\n   721→                      11.3456529378891,\n   722→                      46.49461446367692\n   723→                    ]\n   724→                  ]\n   725→                ]\n   726→              }\n   727→            }\n   728→          ]\n   729→        }\"\"\"\n   730→\n   731→        # geoJSON with empty properties\n   732→        gjson_po = json.loads(geojson_properties_object)\n   733→        gdf1 = GeoDataFrame.from_features(gjson_po)\n   734→\n   735→        # geoJSON with null properties\n   736→        gjson_null = json.loads(geojson_properties_null)\n   737→        gdf2 = GeoDataFrame.from_features(gjson_null)\n   738→\n   739→        assert_frame_equal(gdf1, gdf2)\n   740→\n   741→    def test_from_features_geom_interface_feature(self):\n   742→        class Placemark(object):\n   743→            def __init__(self, geom, val):\n   744→                self.__geo_interface__ = {\n   745→                    \"type\": \"Feature\",\n   746→                    \"properties\": {\"a\": val},\n   747→                    \"geometry\": geom.__geo_interface__,\n   748→                }\n   749→\n   750→        p1 = Point(1, 1)\n   751→        f1 = Placemark(p1, 0)\n   752→        p2 = Point(3, 3)\n   753→        f2 = Placemark(p2, 0)\n   754→        df = GeoDataFrame.from_features([f1, f2])\n   755→        assert sorted(df.columns) == [\"a\", \"geometry\"]\n   756→        assert df.geometry.tolist() == [p1, p2]\n   757→\n   758→    def test_from_feature_collection(self):\n   759→        data = {\n   760→            \"name\": [\"a\", \"b\", \"c\"],\n   761→            \"lat\": [45, 46, 47.5],\n   762→            \"lon\": [-120, -121.2, -122.9],\n   763→        }\n   764→\n   765→        df = pd.DataFrame(data)\n   766→        geometry = [Point(xy) for xy in zip(df[\"lon\"], df[\"lat\"])]\n   767→        gdf = GeoDataFrame(df, geometry=geometry)\n   768→        # from_features returns sorted columns\n   769→        expected = gdf[[\"geometry\", \"name\", \"lat\", \"lon\"]]\n   770→\n   771→        # test FeatureCollection\n   772→        res = GeoDataFrame.from_features(gdf.__geo_interface__)\n   773→        assert_frame_equal(res, expected)\n   774→\n   775→        # test list of Features\n   776→        res = GeoDataFrame.from_features(gdf.__geo_interface__[\"features\"])\n   777→        assert_frame_equal(res, expected)\n   778→\n   779→        # test __geo_interface__ attribute (a GeoDataFrame has one)\n   780→        res = GeoDataFrame.from_features(gdf)\n   781→        assert_frame_equal(res, expected)\n   782→\n   783→    def test_dataframe_to_geodataframe(self):\n   784→        df = pd.DataFrame(\n   785→            {\"A\": range(len(self.df)), \"location\": np.array(self.df.geometry)},\n   786→            index=self.df.index,\n   787→        )\n   788→        gf = df.set_geometry(\"location\", crs=self.df.crs)\n   789→        assert isinstance(df, pd.DataFrame)\n   790→        assert isinstance(gf, GeoDataFrame)\n   791→        assert_geoseries_equal(gf.geometry, self.df.geometry)\n   792→        assert gf.geometry.name == \"location\"\n   793→        assert \"geometry\" not in gf\n   794→\n   795→        gf2 = df.set_geometry(\"location\", crs=self.df.crs, drop=True)\n   796→        assert isinstance(df, pd.DataFrame)\n   797→        assert isinstance(gf2, GeoDataFrame)\n   798→        assert gf2.geometry.name == \"geometry\"\n   799→        assert \"geometry\" in gf2\n   800→        assert \"location\" not in gf2\n   801→        assert \"location\" in df\n   802→\n   803→        # should be a copy\n   804→        df.loc[0, \"A\"] = 100\n   805→        assert gf.loc[0, \"A\"] == 0\n   806→        assert gf2.loc[0, \"A\"] == 0\n   807→\n   808→        with pytest.raises(ValueError):\n   809→            df.set_geometry(\"location\", inplace=True)\n   810→\n   811→    def test_dataframe_not_manipulated(self):\n   812→        df = pd.DataFrame(\n   813→            {\n   814→                \"A\": range(len(self.df)),\n   815→                \"latitude\": self.df.geometry.centroid.y,\n   816→                \"longitude\": self.df.geometry.centroid.x,\n   817→            },\n   818→            index=self.df.index,\n   819→        )\n   820→        df_copy = df.copy()\n   821→        gf = GeoDataFrame(\n   822→            df,\n   823→            geometry=points_from_xy(df[\"longitude\"], df[\"latitude\"]),\n   824→            crs=self.df.crs,\n   825→        )\n   826→        assert type(df) == pd.DataFrame\n   827→        assert \"geometry\" not in df\n   828→        assert_frame_equal(df, df_copy)\n   829→        assert isinstance(gf, GeoDataFrame)\n   830→        assert hasattr(gf, \"geometry\")\n   831→\n   832→        # ensure mutating columns in gf doesn't update df\n   833→        gf.loc[0, \"A\"] = 7\n   834→        assert_frame_equal(df, df_copy)\n   835→        gf[\"A\"] = 3\n   836→        assert_frame_equal(df, df_copy)\n   837→\n   838→    def test_geodataframe_geointerface(self):\n   839→        assert self.df.__geo_interface__[\"type\"] == \"FeatureCollection\"\n   840→        assert len(self.df.__geo_interface__[\"features\"]) == self.df.shape[0]\n   841→\n   842→    def test_geodataframe_iterfeatures(self):\n   843→        df = self.df.iloc[:1].copy()\n   844→        df.loc[0, \"BoroName\"] = np.nan\n   845→        # when containing missing values\n   846→        # null: output the missing entries as JSON null\n   847→        result = list(df.iterfeatures(na=\"null\"))[0][\"properties\"]\n   848→        assert result[\"BoroName\"] is None\n   849→        # drop: remove the property from the feature.\n   850→        result = list(df.iterfeatures(na=\"drop\"))[0][\"properties\"]\n   851→        assert \"BoroName\" not in result.keys()\n   852→        # keep: output the missing entries as NaN\n   853→        result = list(df.iterfeatures(na=\"keep\"))[0][\"properties\"]\n   854→        assert np.isnan(result[\"BoroName\"])\n   855→\n   856→        # test for checking that the (non-null) features are python scalars and\n   857→        # not numpy scalars\n   858→        assert type(df.loc[0, \"Shape_Leng\"]) is np.float64\n   859→        # null\n   860→        result = list(df.iterfeatures(na=\"null\"))[0]\n   861→        assert type(result[\"properties\"][\"Shape_Leng\"]) is float\n   862→        # drop\n   863→        result = list(df.iterfeatures(na=\"drop\"))[0]\n   864→        assert type(result[\"properties\"][\"Shape_Leng\"]) is float\n   865→        # keep\n   866→        result = list(df.iterfeatures(na=\"keep\"))[0]\n   867→        assert type(result[\"properties\"][\"Shape_Leng\"]) is float\n   868→\n   869→        # when only having numerical columns\n   870→        df_only_numerical_cols = df[[\"Shape_Leng\", \"Shape_Area\", \"geometry\"]]\n   871→        assert type(df_only_numerical_cols.loc[0, \"Shape_Leng\"]) is np.float64\n   872→        # null\n   873→        result = list(df_only_numerical_cols.iterfeatures(na=\"null\"))[0]\n   874→        assert type(result[\"properties\"][\"Shape_Leng\"]) is float\n   875→        # drop\n   876→        result = list(df_only_numerical_cols.iterfeatures(na=\"drop\"))[0]\n   877→        assert type(result[\"properties\"][\"Shape_Leng\"]) is float\n   878→        # keep\n   879→        result = list(df_only_numerical_cols.iterfeatures(na=\"keep\"))[0]\n   880→        assert type(result[\"properties\"][\"Shape_Leng\"]) is float\n   881→\n   882→        with pytest.raises(\n   883→            ValueError, match=\"GeoDataFrame cannot contain duplicated column names.\"\n   884→        ):\n   885→            df_with_duplicate_columns = df[\n   886→                [\"Shape_Leng\", \"Shape_Leng\", \"Shape_Area\", \"geometry\"]\n   887→            ]\n   888→            list(df_with_duplicate_columns.iterfeatures())\n   889→\n   890→        # geometry not set\n   891→        df = GeoDataFrame({\"values\": [0, 1], \"geom\": [Point(0, 1), Point(1, 0)]})\n   892→        with pytest.raises(AttributeError):\n   893→            list(df.iterfeatures())\n   894→\n   895→    def test_geodataframe_iterfeatures_non_scalars(self):\n   896→        # When some features in geodataframe are non-scalar values\n   897→        df = GeoDataFrame(\n   898→            {\"geometry\": [Point(1, 2)], \"non-scalar\": [[1, 2]], \"test_col\": None}\n   899→        )\n   900→        # null\n   901→        expected = {\"non-scalar\": [1, 2], \"test_col\": None}\n   902→        result = list(df.iterfeatures(na=\"null\"))[0].get(\"properties\")\n   903→        assert expected == result\n   904→        # drop\n   905→        expected = {\"non-scalar\": [1, 2]}\n   906→        result = list(df.iterfeatures(na=\"drop\"))[0].get(\"properties\")\n   907→        assert expected == result\n   908→        # keep\n   909→        expected = {\"non-scalar\": [1, 2], \"test_col\": None}\n   910→        result = list(df.iterfeatures(na=\"keep\"))[0].get(\"properties\")\n   911→        assert expected == result\n   912→\n   913→    def test_geodataframe_geojson_no_bbox(self):\n   914→        geo = self.df._to_geo(na=\"null\", show_bbox=False)\n   915→        assert \"bbox\" not in geo.keys()\n   916→        for feature in geo[\"features\"]:\n   917→            assert \"bbox\" not in feature.keys()\n   918→\n   919→    def test_geodataframe_geojson_bbox(self):\n   920→        geo = self.df._to_geo(na=\"null\", show_bbox=True)\n   921→        assert \"bbox\" in geo.keys()\n   922→        assert len(geo[\"bbox\"]) == 4\n   923→        assert isinstance(geo[\"bbox\"], tuple)\n   924→        for feature in geo[\"features\"]:\n   925→            assert \"bbox\" in feature.keys()\n   926→\n   927→    def test_pickle(self):\n   928→        import pickle\n   929→\n   930→        df2 = pickle.loads(pickle.dumps(self.df))\n   931→        assert_geodataframe_equal(self.df, df2)\n   932→\n   933→    def test_pickle_method(self):\n   934→        filename = os.path.join(self.tempdir, \"df.pkl\")\n   935→        self.df.to_pickle(filename)\n   936→        unpickled = pd.read_pickle(filename)\n   937→        assert_frame_equal(self.df, unpickled)\n   938→        assert self.df.crs == unpickled.crs\n   939→\n   940→    def test_estimate_utm_crs(self):\n   941→        assert self.df.estimate_utm_crs() == CRS(\"EPSG:32618\")\n   942→        assert self.df.estimate_utm_crs(\"NAD83\") == CRS(\"EPSG:26918\")\n   943→\n   944→    def test_to_wkb(self):\n   945→        wkbs0 = [\n   946→            (\n   947→                b\"\\x01\\x01\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\"\n   948→                b\"\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\"\n   949→            ),  # POINT (0 0)\n   950→            (\n   951→                b\"\\x01\\x01\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\"\n   952→                b\"\\x00\\xf0?\\x00\\x00\\x00\\x00\\x00\\x00\\xf0?\"\n   953→            ),  # POINT (1 1)\n   954→        ]\n   955→        wkbs1 = [\n   956→            (\n   957→                b\"\\x01\\x01\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\"\n   958→                b\"\\x00\\x00@\\x00\\x00\\x00\\x00\\x00\\x00\\x00@\"\n   959→            ),  # POINT (2 2)\n   960→            (\n   961→                b\"\\x01\\x01\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\"\n   962→                b\"\\x00\\x08@\\x00\\x00\\x00\\x00\\x00\\x00\\x08@\"\n   963→            ),  # POINT (3 3)\n   964→        ]\n   965→        gs0 = GeoSeries.from_wkb(wkbs0)\n   966→        gs1 = GeoSeries.from_wkb(wkbs1)\n   967→        gdf = GeoDataFrame({\"geom_col0\": gs0, \"geom_col1\": gs1})\n   968→\n   969→        expected_df = pd.DataFrame({\"geom_col0\": wkbs0, \"geom_col1\": wkbs1})\n   970→        assert_frame_equal(expected_df, gdf.to_wkb())\n   971→\n   972→    def test_to_wkt(self):\n   973→        wkts0 = [\"POINT (0 0)\", \"POINT (1 1)\"]\n   974→        wkts1 = [\"POINT (2 2)\", \"POINT (3 3)\"]\n   975→        gs0 = GeoSeries.from_wkt(wkts0)\n   976→        gs1 = GeoSeries.from_wkt(wkts1)\n   977→        gdf = GeoDataFrame({\"gs0\": gs0, \"gs1\": gs1})\n   978→\n   979→        expected_df = pd.DataFrame({\"gs0\": wkts0, \"gs1\": wkts1})\n   980→        assert_frame_equal(expected_df, gdf.to_wkt())\n   981→\n   982→    @pytest.mark.parametrize(\"how\", [\"left\", \"inner\", \"right\"])\n   983→    @pytest.mark.parametrize(\"predicate\", [\"intersects\", \"within\", \"contains\"])\n   984→    def test_sjoin(self, how, predicate, naturalearth_cities, naturalearth_lowres):\n   985→        \"\"\"\n   986→        Basic test for availability of the GeoDataFrame method. Other\n   987→        sjoin tests are located in /tools/tests/test_sjoin.py\n   988→        \"\"\"\n   989→        left = read_file(naturalearth_cities)\n   990→        right = read_file(naturalearth_lowres)\n   991→\n   992→        expected = geopandas.sjoin(left, right, how=how, predicate=predicate)\n   993→        result = left.sjoin(right, how=how, predicate=predicate)\n   994→        assert_geodataframe_equal(result, expected)\n   995→\n   996→    @pytest.mark.parametrize(\"how\", [\"left\", \"inner\", \"right\"])\n   997→    @pytest.mark.parametrize(\"distance\", [0, 3])\n   998→    @pytest.mark.skipif(\n   999→        not compat.GEOS_GE_310,\n  1000→        reason=\"`dwithin` requires GEOS 3.10\",\n  1001→    )\n  1002→    def test_sjoin_dwithin(self, how, distance):\n  1003→        \"\"\"\n  1004→        Basic test for predicate='dwithin' availability of the GeoDataFrame method.\n  1005→        Other sjoin tests are located in /tools/tests/test_sjoin.py\n  1006→        \"\"\"\n  1007→        left = GeoDataFrame(geometry=points_from_xy([0, 1, 2], [0, 1, 1]))\n  1008→        right = GeoDataFrame(geometry=[box(0, 0, 1, 1)])\n  1009→\n  1010→        expected = geopandas.sjoin(\n  1011→            left, right, how=how, predicate=\"dwithin\", distance=distance\n  1012→        )\n  1013→        result = left.sjoin(right, how=how, predicate=\"dwithin\", distance=distance)\n  1014→        assert_geodataframe_equal(result, expected)\n  1015→\n  1016→    @pytest.mark.parametrize(\"how\", [\"left\", \"inner\", \"right\"])\n  1017→    @pytest.mark.parametrize(\"max_distance\", [None, 1])\n  1018→    @pytest.mark.parametrize(\"distance_col\", [None, \"distance\"])\n  1019→    @pytest.mark.filterwarnings(\"ignore:Geometry is in a geographic CRS:UserWarning\")\n  1020→    def test_sjoin_nearest(\n  1021→        self, how, max_distance, distance_col, naturalearth_cities, naturalearth_lowres\n  1022→    ):\n  1023→        \"\"\"\n  1024→        Basic test for availability of the GeoDataFrame method. Other\n  1025→        sjoin tests are located in /tools/tests/test_sjoin.py\n  1026→        \"\"\"\n  1027→        left = read_file(naturalearth_cities)\n  1028→        right = read_file(naturalearth_lowres)\n  1029→\n  1030→        expected = geopandas.sjoin_nearest(\n  1031→            left, right, how=how, max_distance=max_distance, distance_col=distance_col\n  1032→        )\n  1033→        result = left.sjoin_nearest(\n  1034→            right, how=how, max_distance=max_distance, distance_col=distance_col\n  1035→        )\n  1036→        assert_geodataframe_equal(result, expected)\n  1037→\n  1038→    def test_clip(self, naturalearth_cities, naturalearth_lowres):\n  1039→        \"\"\"\n  1040→        Basic test for availability of the GeoDataFrame method. Other\n  1041→        clip tests are located in /tools/tests/test_clip.py\n  1042→        \"\"\"\n  1043→        left = read_file(naturalearth_cities)\n  1044→        world = read_file(naturalearth_lowres)\n  1045→        south_america = world[world[\"continent\"] == \"South America\"]\n  1046→\n  1047→        expected = geopandas.clip(left, south_america)\n  1048→        result = left.clip(south_america)\n  1049→        assert_geodataframe_equal(result, expected)\n  1050→\n  1051→    def test_overlay(self, dfs, how):\n  1052→        \"\"\"\n  1053→        Basic test for availability of the GeoDataFrame method. Other\n  1054→        overlay tests are located in tests/test_overlay.py\n  1055→        \"\"\"\n  1056→        df1, df2 = dfs\n  1057→\n  1058→        expected = geopandas.overlay(df1, df2, how=how)\n  1059→        result = df1.overlay(df2, how=how)\n  1060→        assert_geodataframe_equal(result, expected)\n  1061→\n  1062→\n  1063→def check_geodataframe(df, geometry_column=\"geometry\"):\n  1064→    assert isinstance(df, GeoDataFrame)\n  1065→    assert isinstance(df.geometry, GeoSeries)\n  1066→    assert isinstance(df[geometry_column], GeoSeries)\n  1067→    assert df._geometry_column_name == geometry_column\n  1068→    assert df.geometry.name == geometry_column\n  1069→    assert isinstance(df.geometry.values, GeometryArray)\n  1070→    assert isinstance(df.geometry.dtype, GeometryDtype)\n  1071→\n  1072→\n  1073→class TestConstructor:\n  1074→    def test_dict(self):\n  1075→        data = {\n  1076→            \"A\": range(3),\n  1077→            \"B\": np.arange(3.0),\n  1078→            \"geometry\": [Point(x, x) for x in range(3)],\n  1079→        }\n  1080→        df = GeoDataFrame(data)\n  1081→        check_geodataframe(df)\n  1082→\n  1083→        # with specifying other kwargs\n  1084→        df = GeoDataFrame(data, index=list(\"abc\"))\n  1085→        check_geodataframe(df)\n  1086→        assert_index_equal(df.index, pd.Index(list(\"abc\")))\n  1087→\n  1088→        df = GeoDataFrame(data, columns=[\"B\", \"A\", \"geometry\"])\n  1089→        check_geodataframe(df)\n  1090→        assert_index_equal(df.columns, pd.Index([\"B\", \"A\", \"geometry\"]))\n  1091→\n  1092→        df = GeoDataFrame(data, columns=[\"A\", \"geometry\"])\n  1093→        check_geodataframe(df)\n  1094→        assert_index_equal(df.columns, pd.Inde