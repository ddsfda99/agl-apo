be labelled 0, 1, …, n - 1,\n  1824→            ignoring `index_parts`.\n  1825→        index_parts : boolean, default True\n  1826→            If True, the resulting index will be a multi-index (original\n  1827→            index with an additional level indicating the multiple\n  1828→            geometries: a new zero-based index for each single part geometry\n  1829→            per multi-part geometry).\n  1830→\n  1831→        Returns\n  1832→        -------\n  1833→        GeoDataFrame\n  1834→            Exploded geodataframe with each single geometry\n  1835→            as a separate entry in the geodataframe.\n  1836→\n  1837→        Examples\n  1838→        --------\n  1839→\n  1840→        >>> from shapely.geometry import MultiPoint\n  1841→        >>> d = {\n  1842→        ...     \"col1\": [\"name1\", \"name2\"],\n  1843→        ...     \"geometry\": [\n  1844→        ...         MultiPoint([(1, 2), (3, 4)]),\n  1845→        ...         MultiPoint([(2, 1), (0, 0)]),\n  1846→        ...     ],\n  1847→        ... }\n  1848→        >>> gdf = geopandas.GeoDataFrame(d, crs=4326)\n  1849→        >>> gdf\n  1850→            col1               geometry\n  1851→        0  name1  MULTIPOINT ((1 2), (3 4))\n  1852→        1  name2  MULTIPOINT ((2 1), (0 0))\n  1853→\n  1854→        >>> exploded = gdf.explode(index_parts=True)\n  1855→        >>> exploded\n  1856→              col1     geometry\n  1857→        0 0  name1  POINT (1 2)\n  1858→          1  name1  POINT (3 4)\n  1859→        1 0  name2  POINT (2 1)\n  1860→          1  name2  POINT (0 0)\n  1861→\n  1862→        >>> exploded = gdf.explode(index_parts=False)\n  1863→        >>> exploded\n  1864→            col1     geometry\n  1865→        0  name1  POINT (1 2)\n  1866→        0  name1  POINT (3 4)\n  1867→        1  name2  POINT (2 1)\n  1868→        1  name2  POINT (0 0)\n  1869→\n  1870→        >>> exploded = gdf.explode(ignore_index=True)\n  1871→        >>> exploded\n  1872→            col1     geometry\n  1873→        0  name1  POINT (1 2)\n  1874→        1  name1  POINT (3 4)\n  1875→        2  name2  POINT (2 1)\n  1876→        3  name2  POINT (0 0)\n  1877→\n  1878→        See also\n  1879→        --------\n  1880→        GeoDataFrame.dissolve : dissolve geometries into a single observation.\n  1881→\n  1882→        \"\"\"\n  1883→\n  1884→        # If no column is specified then default to the active geometry column\n  1885→        if column is None:\n  1886→            column = self.geometry.name\n  1887→        # If the specified column is not a geometry dtype use pandas explode\n  1888→        if not isinstance(self[column].dtype, GeometryDtype):\n  1889→            return super().explode(column, ignore_index=ignore_index, **kwargs)\n  1890→\n  1891→        if index_parts is None:\n  1892→            if not ignore_index:\n  1893→                warnings.warn(\n  1894→                    \"Currently, index_parts defaults to True, but in the future, \"\n  1895→                    \"it will default to False to be consistent with Pandas. \"\n  1896→                    \"Use `index_parts=True` to keep the current behavior and \"\n  1897→                    \"True/False to silence the warning.\",\n  1898→                    FutureWarning,\n  1899→                    stacklevel=2,\n  1900→                )\n  1901→            index_parts = True\n  1902→\n  1903→        exploded_geom = self.geometry.reset_index(drop=True).explode(index_parts=True)\n  1904→\n  1905→        df = self.drop(self._geometry_column_name, axis=1).take(\n  1906→            exploded_geom.index.droplevel(-1)\n  1907→        )\n  1908→        df[exploded_geom.name] = exploded_geom.values\n  1909→        df = df.set_geometry(self._geometry_column_name).__finalize__(self)\n  1910→\n  1911→        if ignore_index:\n  1912→            df.reset_index(inplace=True, drop=True)\n  1913→        elif index_parts:\n  1914→            # reset to MultiIndex, otherwise df index is only first level of\n  1915→            # exploded GeoSeries index.\n  1916→            df = df.set_index(\n  1917→                exploded_geom.index.droplevel(\n  1918→                    list(range(exploded_geom.index.nlevels - 1))\n  1919→                ),\n  1920→                append=True,\n  1921→            )\n  1922→\n  1923→        return df\n  1924→\n  1925→    # overrides the pandas astype method to ensure the correct return type\n  1926→    # should be removable when pandas 1.4 is dropped\n  1927→    def astype(self, dtype, copy=True, errors=\"raise\", **kwargs):\n  1928→        \"\"\"\n  1929→        Cast a pandas object to a specified dtype ``dtype``.\n  1930→        Returns a GeoDataFrame when the geometry column is kept as geometries,\n  1931→        otherwise returns a pandas DataFrame.\n  1932→        See the pandas.DataFrame.astype docstring for more details.\n  1933→        Returns\n  1934→        -------\n  1935→        GeoDataFrame or DataFrame\n  1936→        \"\"\"\n  1937→        df = super().astype(dtype, copy=copy, errors=errors, **kwargs)\n  1938→\n  1939→        try:\n  1940→            geoms = df[self._geometry_column_name]\n  1941→            if is_geometry_type(geoms):\n  1942→                return geopandas.GeoDataFrame(df, geometry=self._geometry_column_name)\n  1943→        except KeyError:\n  1944→            pass\n  1945→        # if the geometry column is converted to non-geometries or did not exist\n  1946→        # do not return a GeoDataFrame\n  1947→        return pd.DataFrame(df)\n  1948→\n  1949→    def to_postgis(\n  1950→        self,\n  1951→        name,\n  1952→        con,\n  1953→        schema=None,\n  1954→        if_exists=\"fail\",\n  1955→        index=False,\n  1956→        index_label=None,\n  1957→        chunksize=None,\n  1958→        dtype=None,\n  1959→    ):\n  1960→        \"\"\"\n  1961→        Upload GeoDataFrame into PostGIS database.\n  1962→\n  1963→        This method requires SQLAlchemy and GeoAlchemy2, and a