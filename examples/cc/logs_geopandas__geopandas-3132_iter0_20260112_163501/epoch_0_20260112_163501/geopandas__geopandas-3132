fixtures(\"_setup_class_nybb_filename\")\n    51\u2192class TestDataFrame:\n    52\u2192    def setup_method(self):\n    53\u2192        N = 10\n    54\u2192        # self.nybb_filename attached via _setup_class_nybb_filename\n    55\u2192        self.df = read_file(self.nybb_filename)\n    56\u2192        # TODO re-write instance variables to be fixtures\n    57\u2192        self.tempdir = tempfile.mkdtemp()\n    58\u2192        self.crs = \"epsg:4326\"\n    59\u2192        self.df2 = GeoDataFrame(\n    60\u2192            [\n    61\u2192                {\"geometry\": Point(x, y), \"value1\": x + y, \"value2\": x * y}\n    62\u2192                for x, y in zip(range(N), range(N))\n    63\u2192            ],\n    64\u2192            crs=self.crs,\n    65\u2192        )\n    66\u2192        self.df3 = read_file(\n    67\u2192            os.path.join(PACKAGE_DIR, \"geopandas\", \"tests\", \"data\", \"null_geom.geojson\")\n    68\u2192        )\n    69\u2192\n    70\u2192    def teardown_method(self):\n    71\u2192        shutil.rmtree(self.tempdir)\n    72\u2192\n    73\u2192    def test_df_init(self):\n    74\u2192        assert type(self.df2) is GeoDataFrame\n    75\u2192        assert self.df2.crs == self.crs\n    76\u2192\n    77\u2192    def test_different_geo_colname(self):\n    78\u2192        data = {\n    79\u2192            \"A\": range(5),\n    80\u2192            \"B\": range(-5, 0),\n    81\u2192            \"location\": [Point(x, y) for x, y in zip(range(5), range(5))],\n    82\u2192        }\n    83\u2192        df = GeoDataFrame(data, crs=self.crs, geometry=\"location\")\n    84\u2192        locs = GeoSeries(data[\"location\"], crs=self.crs)\n    85\u2192        assert_geoseries_equal(df.geometry, locs)\n    86\u2192        assert \"geometry\" not in df\n    87\u2192        assert df.geometry.name == \"location\"\n    88\u2192        # internal implementation detail\n    89\u2192        assert df._geometry_column_name == \"location\"\n    90\u2192\n    91\u2192        geom2 = [Point(x, y) for x, y in zip(range(5, 10), range(5))]\n    92\u2192        with pytest.raises(CRSError):\n    93\u2192            df.set_geometry(geom2, crs=\"dummy_crs\")\n    94\u2192\n    95\u2192    @pytest.mark.filterwarnings(\"ignore:Geometry is in a geographic CRS\")\n    96\u2192    def test_geo_getitem(self):\n    97\u2192        data = {\n    98\u2192            \"A\": range(5),\n    99\u2192            \"B\": range(-5, 0),\n   100\u2192            \"location\": [Point(x, y) for x, y in zip(range(5), range(5))],\n   101\u2192        }\n   102\u2192        df = GeoDataFrame(data, crs=self.crs, geometry=\"location\")\n   103\u2192        assert isinstance(df.geometry, GeoSeries)\n   104\u2192        df[\"geometry\"] = df[\"A\"]\n   105\u2192        assert isinstance(df.geometry, GeoSeries)\n   106\u2192        assert df.geometry[0] == data[\"location\"][0]\n   107\u2192        # good if this changed in the future\n   108\u2192        assert not isinstance(df[\"geometry\"], GeoSeries)\n   109\u2192        assert isinstance(df[\"location\"], GeoSeries)\n   110\u2192\n   111\u2192        df[\"buff\"] = df.buffer(1)\n   112\u2192        assert isinstance(df[\"buff\"], GeoSeries)\n   113\u2192\n   114\u2192        df[\"array\"] = from_shapely([Point(x, y) for x, y in zip(range(5), range(5))])\n   115\u2192        assert isinstance(df[\"array\"], GeoSeries)\n   116\u2192\n   117\u2192        data[\"geometry\"] = [Point(x + 1, y - 1) for x, y in zip(range(5), range(5))]\n   118\u2192        df = GeoDataFrame(data, crs=self.crs)\n   119\u2192        assert isinstance(df.geometry, GeoSeries)\n   120\u2192        assert isinstance(df[\"geometry\"], GeoSeries)\n   121\u2192        # good if this changed in the future\n   122\u2192        assert not isinstance(df[\"location\"], GeoSeries)\n   123\u2192\n   124\u2192    def test_getitem_no_geometry(self):\n   125\u2192        res = self.df2[[\"value1\", \"value2\"]]\n   126\u2192        assert isinstance(res, pd.DataFrame)\n   127\u2192        assert not isinstance(res, GeoDataFrame)\n   128\u2192\n   129\u2192        # with different name\n   130\u2192        df = self.df2.copy()\n   131\u2192        df = df.rename(columns={\"geometry\": \"geom\"}).set_geometry(\"geom\")\n   132\u2192        assert isinstance(df, GeoDataFrame)\n   133\u2192        res = df[[\"value1\", \"value2\"]]\n   134\u2192        assert isinstance(res, pd.DataFrame)\n   135\u2192        assert not isinstance(res, GeoDataFrame)\n   136\u2192\n   137\u2192        df[\"geometry\"] = np.arange(len(df))\n   138\u2192        res = df[[\"value1\", \"value2\", \"geometry\"]]\n   139\u2192        assert isinstance(res, pd.DataFrame)\n   140\u2192        assert not isinstance(res, GeoDataFrame)\n   141\u2192\n   142\u2192    def test_geo_setitem(self):\n   143\u2192        data = {\n   144\u2192            \"A\": range(5),\n   145\u2192            \"B\": np.arange(5.0),\n   146\u2192            \"geometry\": [Point(x, y) for x, y in zip(range(5), range(5))],\n   147\u2192        }\n   148\u2192        df = GeoDataFrame(data)\n   149\u2192        s = GeoSeries([Point(x, y + 1) for x, y in zip(range(5), range(5))])\n   150\u2192\n   151\u2192        # setting geometry column\n   152\u2192        for vals in [s, s.values]:\n   153\u2192            df[\"geometry\"] = vals\n   154\u2192            assert_geoseries_equal(df[\"geometry\"], s)\n   155\u2192            assert_geoseries_equal(df.geometry, s)\n   156\u2192\n   157\u2192        # non-aligned values\n   158\u2192        s2 = GeoSeries([Point(x, y + 1) for x, y in zip(range(6), range(6))])\n   159\u2192        df[\"geometry\"] = s2\n   160\u2192        assert_geoseries_equal(df[\"geometry\"], s)\n   161\u2192        assert_geoseries_equal(df.geometry, s)\n   162\u2192\n   163\u2192        # setting other column with geometry values -> preserve geometry type\n   164\u2192        for vals in [s, s.values]:\n   165\u2192            df[\"other_geom\"] = vals\n   166\u2192            assert isinstance(df[\"other_geom\"].values, GeometryArray)\n   167\u2192\n   168\u2192        # overwriting existing non-geometry column -> preserve geometry type\n   169\u2192        data = {\n   170\u2192            \"A\": range(5),\n   171\u2192            \"B\": np.arange(5.0),\n   172\u2192            \"other_geom\": range(5),\n   173\u2192            \"geometry\": [Point(x, y) for x, y in zip(range(5), range(5))],\n   174\u2192        }\n   175\u2192        df = GeoDataFrame(data)\n   176\u2192        for vals in [s, s.values]:\n   177\u2192            df[\"other_geom\"] = vals\n   178\u2192            assert isinstance(df[\"other_geom\"].values, GeometryArray)\n   179\u2192\n   180\u2192    def test_geometry_property(self):\n   181\u2192        assert_geoseries_equal(\n   182\u2192            self.df.geometry,\n   183\u2192            self.df[\"geometry\"],\n   184\u2192            check_dtype=True,\n   185\u2192            check_index_type=True,\n   186\u2192        )\n   187\u2192\n   188\u2192        df = self.df.copy()\n   189\u2192        new_geom = [\n   190\u2192            Point(x, y) for x, y in zip(range(len(self.df)), range(len(self.df)))\n   191\u2192        ]\n   192\u2192        df.geometry = new_geom\n   193\u2192\n   194\u2192        new_geom = GeoSeries(new_geom, index=df.index, crs=df.crs)\n   195\u2192        assert_geoseries_equal(df.geometry, new_geom)\n   196\u2192        assert_geoseries_equal(df[\"geometry\"], new_geom)\n   197\u2192\n   198\u2192        # new crs\n   199\u2192        gs = new_geom.to_crs(crs=\"epsg:3857\")\n   200\u2192        df.geometry = gs\n   201\u2192        assert df.crs == \"epsg:3857\"\n   202\u2192\n   203\u2192    def test_geometry_property_errors(self):\n   204\u2192        with pytest.raises(AttributeError):\n   205\u2192            df = self.df.copy()\n   206\u2192            del df[\"geometry\"]\n   207\u2192            df.geometry\n   208\u2192\n   209\u2192        # list-like error\n   210\u2192        with pytest.raises(ValueError):\n   211\u2192            df = self.df2.copy()\n   212\u2192            df.geometry = \"value1\"\n   213\u2192\n   214\u2192        # list-like error\n   215\u2192        with pytest.raises(ValueError):\n   216\u2192            df = self.df.copy()\n   217\u2192            df.geometry = \"apple\"\n   218\u2192\n   219\u2192        # non-geometry error\n   220\u2192        with pytest.raises(TypeError):\n   221\u2192            df = self.df.copy()\n   222\u2192            df.geometry = list(range(df.shape[0]))\n   223\u2192\n   224\u2192        with pytest.raises(KeyError):\n   225\u2192            df = self.df.copy()\n   226\u2192            del df[\"geometry\"]\n   227\u2192            df[\"geometry\"]\n   228\u2192\n   229\u2192        # ndim error\n   230\u2192        with pytest.raises(ValueError):\n   231\u2192            df = self.df.copy()\n   232\u2192            df.geometry = df\n   233\u2192\n   234\u2192    def test_rename_geometry(self):\n   235\u2192        assert self.df.geometry.name == \"geometry\"\n   236\u2192        df2 = self.df.rename_geometry(\"new_name\")\n   237\u2192        assert df2.geometry.name == \"new_name\"\n   238\u2192        df2 = self.df.rename_geometry(\"new_name\", inplace=True)\n   239\u2192        assert df2 is None\n   240\u2192        assert self.df.geometry.name == \"new_name\"\n   241\u2192\n   242\u2192        # existing column error\n   243\u2192        msg = \"Column named Shape_Area already exists\"\n   244\u2192        with pytest.raises(ValueError, match=msg):\n   245\u2192            df2 = self.df.rename_geometry(\"Shape_Area\")\n   246\u2192        with pytest.raises(ValueError, match=msg):\n   247\u2192            self.df.rename_geometry(\"Shape_Area\", inplace=True)\n   248\u2192\n   249\u2192    def test_set_geometry(self):\n   250\u2192        geom = GeoSeries([Point(x, y) for x, y in zip(range(5), range(5))])\n   251\u2192        original_geom = self.df.geometry\n   252\u2192\n   253\u2192        df2 = self.df.set_geometry(geom)\n   254\u2192        assert self.df is not df2\n   255\u2192        assert_geoseries_equal(df2.geometry, geom, check_crs=False)\n   256\u2192        assert_geoseries_equal(self.df.geometry, original_geom)\n   257\u2192        assert_geoseries_equal(self.df[\"geometry\"], self.df.geometry)\n   258\u2192        # unknown column\n   259\u2192        with pytest.raises(ValueError):\n   260\u2192            self.df.set_geometry(\"nonexistent-column\")\n   261\u2192\n   262\u2192        # ndim error\n   263\u2192        with pytest.raises(ValueError):\n   264\u2192            self.df.set_geometry(self.df)\n   265\u2192\n   266\u2192        # new crs - setting should default to GeoSeries' crs\n   267\u2192        gs = GeoSeries(geom, crs=\"epsg:3857\")\n   268\u2192        new_df = self.df.set_geometry(gs)\n   269\u2192        assert new_df.crs == \"epsg:3857\"\n   270\u2192\n   271\u2192        # explicit crs overrides self and dataframe\n   272\u2192        new_df = self.df.set_geometry(gs, crs=\"epsg:26909\")\n   273\u2192        assert new_df.crs == \"epsg:26909\"\n   274\u2192        assert new_df.geometry.crs == \"epsg:26909\"\n   275\u2192\n   276\u2192        # Series should use dataframe's\n   277\u2192        new_df = self.df.set_geometry(geom.values)\n   278\u2192        assert new_df.crs == self.df.crs\n   279\u2192        assert new_df.geometry.crs == self.df.crs\n   280\u2192\n   281\u2192    def test_set_geometry_col(self):\n   282\u2192        g = self.df.geometry\n   283\u2192        g_simplified = g.simplify(100)\n   284\u2192        self.df[\"simplified_geometry\"] = g_simplified\n   285\u2192        df2 = self.df.set_geometry(\"simplified_geometry\")\n   286\u2192\n   287\u2192        # Drop is false by default\n   288\u2192        assert \"simplified_geometry\" in df2\n   289\u2192        assert_geoseries_equal(df2.geometry, g_simplified)\n   290\u2192\n   291\u2192        # If True, drops column and renames to geometry\n   292\u2192        df3 = self.df.set_geometry(\"simplified_geometry\", drop=True)\n   293\u2192        assert \"simplified_geometry\" not in df3\n   294\u2192        assert_geoseries_equal(df3.geometry, g_simplified)\n   295\u2192\n   296\u2192    def test_set_geometry_inplace(self):\n   297\u2192        geom = [Point(x, y) for x, y in zip(range(5), range(5))]\n   298\u2192        ret = self.df.set_geometry(geom, inplace=True)\n   299\u2192        assert ret is None\n   300\u2192        geom = GeoSeries(geom, index=self.df.index, crs=self.df.crs)\n   301\u2192        assert_geoseries_equal(self.df.geometry, geom)\n   302\u2192\n   303\u2192    def test_set_geometry_series(self):\n   304\u2192        # Test when setting geometry with a Series that\n   305\u2192        # alignment will occur\n   306\u2192        #\n   307\u2192        # Reverse the index order\n   308\u2192        # Set the Series to be Point(i,i) where i is the index\n   309\u2192        self.df.index = range(len(self.df) - 1, -1, -1)\n   310\u2192\n   311\u2192        d = {}\n   312\u2192        for i in range(len(self.df)):\n   313\u2192            d[i] = Point(i, i)\n   314\u2192        g = GeoSeries(d)\n   315\u2192        # At this point, the DataFrame index is [4,3,2,1,0] and the\n   316\u2192        # GeoSeries index is [0,1,2,3,4]. Make sure set_geometry aligns\n   317\u2192        # them to match indexes\n   318\u2192        df = self.df.set_geometry(g)\n   319\u2192\n   320\u2192        for i, r in df.iterrows():\n   321\u2192            assert i == r[\"geometry\"].x\n   322\u2192            assert i == r[\"geometry\"].y\n   323\u2192\n   324\u2192    def test_set_geometry_empty(self):\n   325\u2192        df = pd.DataFrame(columns=[\"a\", \"geometry\"], index=pd.DatetimeIndex([]))\n   326\u2192        result = df.set_geometry(\"geometry\")\n   327\u2192        assert isinstance(result, GeoDataFrame)\n   328\u2192        assert isinstance(result.index, pd.DatetimeIndex)\n   329\u2192\n   330\u2192    def test_set_geometry_np_int(self):\n   331\u2192        self.df.loc[:, 0] = self.df.geometry\n   332\u2192        df = self.df.set_geometry(np.int64(0))\n   333\u2192        assert df.geometry.name == 0\n   334\u2192\n   335\u2192    def test_get_geometry_invalid(self):\n   336\u2192        df = GeoDataFrame()\n   337\u2192        # no column \"geometry\" ever added\n   338\u2192        df[\"geom\"] = self.df.geometry\n   339\u2192        msg_geo_col_none = \"active geometry column to use has not been set. \"\n   340\u2192\n   341\u2192        with pytest.raises(AttributeError, match=msg_geo_col_none):\n   342\u2192            df.geometry\n   343\u2192        # \"geometry\" originally present but dropped (but still a gdf)\n   344\u2192        col_subset_drop_geometry = [\"BoroCode\", \"BoroName\", \"geom2\"]\n   345\u2192        df2 = self.df.copy().assign(geom2=self.df.geometry)[col_subset_drop_geometry]\n   346\u2192        with pytest.raises(AttributeError, match=\"is not present.\"):\n   347\u2192            df2.geometry\n   348\u2192\n   349\u2192        msg_other_geo_cols_present = \"There are columns with geometry data type\"\n   350\u2192        msg_no_other_geo_cols = \"There are no existing columns with geometry data type\"\n   351\u2192        with pytest.raises(AttributeError, match=msg_other_geo_cols_present):\n   352\u2192            df2.geometry\n   353\u2192\n   354\u2192        with pytest.raises(AttributeError, match=msg_no_other_geo_cols):\n   355\u2192            GeoDataFrame().geometry\n   356\u2192\n   357\u2192    def test_get_geometry_geometry_inactive(self):\n   358\u2192        # https://github.com/geopandas/geopandas/issues/2574\n   359\u2192        df = self.df.assign(geom2=self.df.geometry).set_geometry(\"geom2\")\n   360\u2192        df = df.loc[:, [\"BoroName\", \"geometry\"]]\n   361\u2192        assert df._geometry_column_name == \"geom2\"\n   362\u2192        msg_geo_col_missing = \"is not present. \"\n   363\u2192        # Check that df.geometry raises if active geometry column is missing,\n   364\u2192        # it should not fall back to column named \"geometry\"\n   365\u2192        with pytest.raises(AttributeError, match=msg_geo_col_missing):\n   366\u2192            df.geometry\n   367\u2192\n   368\u2192    def test_active_geometry_name(self):\n   369\u2192        # default single active called \"geometry\"\n   370\u2192        assert self.df.active_geometry_name == \"geometry\"\n   371\u2192\n   372\u2192        # one GeoSeries, not active\n   373\u2192        no_active = GeoDataFrame({\"foo\": self.df.BoroName, \"bar\": self.df.geometry})\n   374\u2192        assert no_active.active_geometry_name is None\n   375\u2192        assert no_active.set_geometry(\"bar\").active_geometry_name == \"bar\"\n   376\u2192\n   377\u2192        # multiple, none active\n   378\u2192        multiple = GeoDataFrame({\"foo\": self.df.geometry, \"bar\": self.df.geometry})\n   379\u2192        assert multiple.active_geometry_name is None\n   380\u2192        assert multiple.set_geometry(\"foo\").active_geometry_name == \"foo\"\n   381\u2192        assert multiple.set_geometry(\"bar\").active_geometry_name == \"bar\"\n   382\u2192\n   383\u2192    def test_align(self):\n   384\u2192        df = self.df2\n   385\u2192\n   386\u2192        res1, res2 = df.align(df)\n   387\u2192        assert_geodataframe_equal(res1, df)\n   388\u2192        assert_geodataframe_equal(res2, df)\n   389\u2192\n   390\u2192        res1, res2 = df.align(df.copy())\n   391\u2192        assert_geodataframe_equal(res1, df)\n   392\u2192        assert_geodataframe_equal(res2, df)\n   393\u2192\n   394\u2192        # assert crs is / is not preserved on mixed dataframes\n   395\u2192        df_nocrs = df.copy()\n   396\u2192        df_nocrs.crs = None\n   397\u2192        res1, res2 = df.align(df_nocrs)\n   398\u2192        assert_geodataframe_equal(res1, df)\n   399\u2192        assert res1.crs is not None\n   400\u2192        assert_geodataframe_equal(res2, df_nocrs)\n   401\u2192        assert res2.crs is None\n   402\u2192\n   403\u2192        # mixed GeoDataFrame / DataFrame\n   404\u2192        df_nogeom = pd.DataFrame(df.drop(\"geometry\", axis=1))\n   405\u2192        res1, res2 = df.align(df_nogeom, axis=0)\n   406\u2192        assert_geodataframe_equal(res1, df)\n   407\u2192        assert type(res2) == pd.DataFrame\n   408\u2192        assert_frame_equal(res2, df_nogeom)\n   409\u2192\n   410\u2192        # same as above but now with actual alignment\n   411\u2192        df1 = df.iloc[1:].copy()\n   412\u2192        df2 = df.iloc[:-1].copy()\n   413\u2192\n   414\u2192        exp1 = df.copy()\n   415\u2192        exp1.iloc[0] = np.nan\n   416\u2192        exp2 = df.copy()\n   417\u2192        exp2.iloc[-1] = np.nan\n   418\u2192        res1, res2 = df1.align(df2)\n   419\u2192        assert_geodataframe_equal(res1, exp1)\n   420\u2192        assert_geodataframe_equal(res2, exp2)\n   421\u2192\n   422\u2192        df2_nocrs = df2.copy()\n   423\u2192        df2_nocrs.crs = None\n   424\u2192        exp2_nocrs = exp2.copy()\n   425\u2192        exp2_nocrs.crs = None\n   426\u2192        res1, res2 = df1.align(df2_nocrs)\n   427\u2192        assert_geodataframe_equal(res1, exp1)\n   428\u2192        assert res1.crs is not None\n   429\u2192        assert_geodataframe_equal(res2, exp2_nocrs)\n   430\u2192        assert res2.crs is None\n   431\u2192\n   432\u2192        df2_nogeom = pd.DataFrame(df2.drop(\"geometry\", axis=1))\n   433\u2192        exp2_nogeom = pd.DataFrame(exp2.drop(\"geometry\", axis=1))\n   434\u2192        res1, res2 = df1.align(df2_nogeom, axis=0)\n   435\u2192        assert_geodataframe_equal(res1, exp1)\n   436\u2192        assert type(res2) == pd.DataFrame\n   437\u2192        assert_frame_equal(res2, exp2_nogeom)\n   438\u2192\n   439\u2192    def test_to_json(self):\n   440\u2192        