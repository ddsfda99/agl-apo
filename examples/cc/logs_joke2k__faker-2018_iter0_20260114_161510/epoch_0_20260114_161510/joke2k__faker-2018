om ``elements``.\n   420\u2192\n   421\u2192        Set ``unique`` to ``False`` for random sampling with replacement, and set ``unique`` to\n   422\u2192        ``True`` for random sampling without replacement.\n   423\u2192\n   424\u2192        If ``length`` is set to ``None`` or is omitted, ``length`` will be set to a random\n   425\u2192        integer from 1 to the size of ``elements``.\n   426\u2192\n   427\u2192        The value of ``length`` cannot be greater than the number of objects\n   428\u2192        in ``elements`` if ``unique`` is set to ``True``.\n   429\u2192\n   430\u2192        The value of ``elements`` can be any sequence type (``list``, ``tuple``, ``set``,\n   431\u2192        ``string``, etc) or an ``OrderedDict`` type. If it is the latter, the keys will be\n   432\u2192        used as the objects for sampling, and the values will be used as weighted probabilities\n   433\u2192        if ``unique`` is set to ``False``. For example:\n   434\u2192\n   435\u2192        .. code-block:: python\n   436\u2192\n   437\u2192            # Random sampling with replacement\n   438\u2192            fake.random_elements(\n   439\u2192                elements=OrderedDict([\n   440\u2192                    (\"variable_1\", 0.5),        # Generates \"variable_1\" 50% of the time\n   441\u2192                    (\"variable_2\", 0.2),        # Generates \"variable_2\" 20% of the time\n   442\u2192                    (\"variable_3\", 0.2),        # Generates \"variable_3\" 20% of the time\n   443\u2192                    (\"variable_4\": 0.1),        # Generates \"variable_4\" 10% of the time\n   444\u2192                ]), unique=False\n   445\u2192            )\n   446\u2192\n   447\u2192            # Random sampling without replacement (defaults to uniform distribution)\n   448\u2192            fake.random_elements(\n   449\u2192                elements=OrderedDict([\n   450\u2192                    (\"variable_1\", 0.5),\n   451\u2192                    (\"variable_2\", 0.2),\n   452\u2192                    (\"variable_3\", 0.2),\n   453\u2192                    (\"variable_4\": 0.1),\n   454\u2192                ]), unique=True\n   455\u2192            )\n   456\u2192\n   457\u2192        :sample: elements=('a', 'b', 'c', 'd'), unique=False\n   458\u2192        :sample: elements=('a', 'b', 'c', 'd'), unique=True\n   459\u2192        :sample: elements=('a', 'b', 'c', 'd'), length=10, unique=False\n   460\u2192        :sample: elements=('a', 'b', 'c', 'd'), length=4, unique=True\n   461\u2192        :sample: elements=OrderedDict([\n   462\u2192                        (\"a\", 0.45),\n   463\u2192                        (\"b\", 0.35),\n   464\u2192                       (\"c\", 0.15),\n   465\u2192                       (\"d\", 0.05),\n   466\u2192                   ]), length=20, unique=False\n   467\u2192        :sample: elements=OrderedDict([\n   468\u2192                       (\"a\", 0.45),\n   469\u2192                       (\"b\", 0.35),\n   470\u2192                       (\"c\", 0.15),\n   471\u2192                       (\"d\", 0.05),\n   472\u2192                   ]), unique=True\n   473\u2192        \"\"\"\n   474\u2192        use_weighting = use_weighting if use_weighting is not None else self.__use_weighting__\n   475\u2192\n   476\u2192        if isinstance(elements, dict) and not isinstance(elements, OrderedDict):\n   477\u2192            raise ValueError(\"Use OrderedDict only to avoid dependency on PYTHONHASHSEED (See #363).\")\n   478\u2192\n   479\u2192        fn = choices_distribution_unique if unique else choices_distribution\n   480\u2192\n   481\u2192        if length is None:\n   482\u2192            length = self.generator.random.randint(1, len(elements))\n   483\u2192\n   484\u2192        if unique and length > len(elements):\n   485\u2192            raise ValueError(\"Sample length cannot be longer than the number of unique elements to pick from.\")\n   486\u2192\n   487\u2192        if isinstance(elements, dict):\n   488\u2192            if not hasattr(elements, \"_key_cache\"):\n   489\u2192                elements._key_cache = tuple(elements.keys())  # type: ignore\n   490\u2192\n   491\u2192            choices = elements._key_cache  # type: ignore[attr-defined, union-attr]\n   492\u2192            probabilities = tuple(elements.values()) if use_weighting else None\n   493\u2192        else:\n   494\u2192            if unique:\n   495\u2192                # shortcut\n   496\u2192                return self.generator.random.sample(elements, length)\n   497\u2192            choices = elements\n   498\u2192            probabilities = None\n   499\u2192\n   500\u2192        return fn(\n   501\u2192            tuple(choices),\n   502\u2192            probabilities,\n   503\u2192            self.generator.random,\n   504\u2192            length=length,\n   505\u2192        )\n   506\u2192\n   507\u2192    def random_choices(\n   508\u2192        self,\n   509\u2192        elements: ElementsType[T] = (\"a\", \"b\", \"c\"),  # type: ignore[assignment]\n   510\u2192        length: Optional[int] = None,\n   511\u2192    ) -> Sequence[T]:\n   512\u2192        \"\"\"Generate a list of objects randomly sampled from ``elements`` with replacement.\n   513\u2192\n   514\u2192        For information on the ``elements`` and ``length`` arguments, please refer to\n   515\u2192        :meth:`random_elements() <faker.providers.BaseProvider.random_elements>` which\n   516\u2192        is used under the hood with the ``unique`` argument explicitly set to ``False``.\n   517\u2192\n   518\u2192        :sample: elements=('a', 'b', 'c', 'd')\n   519\u2192        :sample: elements=('a', 'b', 'c', 'd'), length=10\n   520\u2192        :sample: elements=OrderedDict([\n   521\u2192                     (\"a\", 0.45),\n   522\u2192                     (\"b\", 0.35),\n   523\u2192                     (\"c\", 0.15),\n   524\u2192                     (\"d\", 0.05),\n   525\u2192        