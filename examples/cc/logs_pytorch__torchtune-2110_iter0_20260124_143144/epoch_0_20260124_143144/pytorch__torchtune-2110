    10→from torchtune.data._utils import format_content_with_images, load_image\n    11→\n    12→from torchtune.modules.transforms import Transform\n    13→\n    14→Role = Literal[\n    15→    \"system\",  # Origin is system prompt\n    16→    \"user\",  # Origin is user\n    17→    \"assistant\",  # Origin is the model output\n    18→    \"ipython\",  # Origin is return from a tool call\n    19→]\n    20→\n    21→\n    22→class Message:\n    23→    \"\"\"\n    24→    This class represents individual messages in a fine-tuning dataset. It supports\n    25→    text-only content, text with interleaved images, and tool calls. The :class:`~torchtune.modules.tokenizers.ModelTokenizer`\n    26→    will tokenize the content of the message using ``tokenize_messages`` and attach\n    27→    the appropriate special tokens based on the flags set in this class.\n    28→\n    29→    Args:\n    30→        role (Role): role of the message writer. Can be \"system\" for system prompts,\n    31→            \"user\" for human prompts, \"assistant\" for model responses, or \"ipython\"\n    32→            for tool call returns.\n    33→        content (Union[str, List[Dict[str, Any]]]): content of the message. If it is text only content,\n    34→            you can pass in a string. If it is multimodal content, pass in a list of dictionaries formatted\n    35→            as follows::\n    36→\n    37→                [\n    38→                    {\"type\": \"image\", \"content\": <PIL.Image.Image>},\n    39→                    {\"type\": \"text\", \"content\": \"What is in this image?\"},\n    40→                ]\n    41→\n    42→        masked (bool): whether the message is masked in the sample. If True, do not use\n    43→            in loss calculation. Default: False\n    44→        ipython (bool): whether the message is a tool call. Default: False\n    45→        eot (bool): whether the message corresponds to the end of a turn, where control is handed over\n    46→            to the assistant from the user or the user from the assistant. Default: True. Should be true\n    47→            in most cases except for:\n    48→\n    49→            - For multiple consecutive assistant messages (i.e., tool calls\n    50→              by assistant), only the last assistant message will have ``eot=True``\n    51→            - All ipython messages (tool call returns) should set ``eot=False``.\n    52→\n    53→    Note:\n    54→        Message class expects any image content to be in\n    55→        `PIL Image format <https://pillow.readthedocs.io/en/stable/reference/Image.html#PIL.Image.Image>`_.\n    56→    \"\"\"\n    57→\n    58→    def __init__(\n    59→        self,\n    60→        role: Role,\n    61→        content: Union[str, List[Dict[str, Any]]],\n    62→        masked: bool = False,\n    63→        ipython: bool = False,\n    64→        eot: bool = True,\n    65→    ):\n    66→        self.role = role\n    67→        self.content = self._convert_to_list_of_dict(content)\n    68→        self.masked = masked\n    69→        self.ipython = ipython\n    70→        self.eot = eot\n    71→\n    72→        self._validate_message()\n    73→\n    74→    def _convert_to_list_of_dict(self, content) -> List[Dict[str, Any]]:\n    75→        \"\"\"User is currently allowed to pass in a string for text-only content.\n    76→        This ensures that the content is formatted as a list of dictionaries.\"\"\"\n    77→        if isinstance(content, str):\n    78→            return [{\"type\": \"text\", \"content\": content}]\n    79→\n    80→        assert isinstance(\n    81→            content, list\n    82→        ), f\"content must be of type List[Dict[str, Any]], got {content}\"\n    83→\n    84→        return content\n    85→\n    86→    @classmethod\n    87→    def from_dict(cls, d: dict) -> \"Message\":\n    88→        \"\"\"\n    89→        Construct a Message from a dictionary.\n    90→\n    91→        Args:\n    92→            d (dict): dictionary containing the fields of the Message.\n    93→\n    94→        Returns:\n    95→            Message: constructed Message.\n    96→        \"\"\"\n    97→        return cls(\n    98→            role=d[\"role\"],\n    99→            content=d[\"content\"],\n   100→            masked=d.get(\"masked\", False),\n   101→            ipython=d.get(\"ipython\", False),\n   102→            eot=d.get(\"eot\", True),\n   103→        )\n   104→\n   105→    def get_media(self) -> List[\"PIL.Image.Image\"]:\n   106→        \"\"\"\n   107→        Returns media content of the message.\n   108→        \"\"\"\n   109→        return [\n   110→            content[\"content\"] for content in self.content if content[\"type\"] == \"image\"\n   111→        ]\n   112→\n   113→    @property\n   114→    def contains_media(self) -> bool:\n   115→        \"\"\"\n   116→        Returns whether the message contains media.\n   117→        \"\"\"\n   118→        return any(content[\"type\"] == \"image\" for content in self.content)\n   119→\n   120→    @property\n   121→    def text_content(self) -> str:\n   122→        \"\"\"\n   123→        Returns text-only content of the message.\n   124→        \"\"\"\n   125→        return \"\".join(\n   126→            content[\"content\"] for content in self.content if content[\"type\"] == \"text\"\n   127→        )\n   128→\n   129→    def _validate_message(self) -> None:\n   130→        if self.ipython and self.contains_media:\n   131→            raise ValueError(\n   132→                f\"Media tokens in tool calls are not supported. Both are set in message: {self.text_content}\"\n   133→            )\n   134→        if self.ipython and self.role != \"assistant\":\n   135→            raise ValueError(\n   136→                f\"Only assistant messages can be tool calls. Found role {self.role} in message: {self.text_content}\"\n   137→            )\n   138→\n   139→    def __repr__(self) -> str:\n   140→        content_only = [content[\"content\"] for content in self.content]\n   141→        return f\"Message(role='{self.role}', content={content_only!r})\"\n   142→\n   143→\n   144→class InputOutputToMessages(Transform):\n   145→    \"\"\"\n   146→    Message transform class that converts a single sample with \"input\" and \"output\" fields,\n   147→    (or equivalent fields specified in column_map) to user and assistant messages,\n   148→    respectively. This is useful for datasets that have two columns, one containing\n   149→    the user prompt string and the other containing the model response string::\n   150→\n   151→        |  input          |  output          |\n   152→        |-----------------|------------------|\n   153→        | \"user prompt\"   | \"model response\" |\n   154→\n   155→    Args:\n   156→        train_on_input (bool): Whether the model is trained on the user prompt or not.\n   157→            Default is False.\n   158→        column_map (Optional[Dict[str, str]]): a mapping to change the expected \"input\"\n   159→            and \"output\" column names to the actual column names in the dataset. Keys should\n   160→            be \"input\" and \"output\" and values should be the actual column names. Default is None,\n   161→            keeping the default \"input\" and \"output\" column names.\n   162→        new_system_prompt (Optional[str]): if specified, prepend a system message. This can\n   163→            serve as instructions to guide the model response. Default is None.\n   164→        image_dir (Optional[Path]): path to the directory containing the images that is prepended to all image\n   165→            paths in the dataset. For example, if ``image_dir=\"/home/user/dataset/\"` and the sample image path\n   166→            was ``\"images/1.jpg\"``, the final image path that will be loaded is ``\"/home/user/dataset/images/1.jpg\"``.\n   167→            If None, assume images are available in current working directory or are located\n   168→            on a remote url. For text-only, leave as None. Default is None.\n   169→\n   170→    Raises:\n   171→        ValueError: If ``column_map`` is provided and ``input`` not in ``column_map``, or\n   172→            ``output`` not in ``column_map``.\n   173→    \"\"\"\n   174→\n   175→    def __init__(\n   176→        self,\n   177→        train_on_input: bool = False,\n   178→        column_map: Optional[Dict[str, str]] = None,\n   179→        new_system_prompt: Optional[str] = None,\n   180→        image_dir: Optional[Path] = None,\n   181→    ):\n   182→        self.train_on_input = train_on_input\n   183→        self.new_system_prompt = new_system_prompt\n   184→\n   185→        self.column_map = column_map\n   186→\n   187→        if self.column_map is not None:\n   188→            if \"input\" not in self.column_map:\n   189→                raise ValueError(\n   190→                    f\"Expected a key of 'input' in column_map but found {self.column_map.keys()}.\"\n   191→                )\n   192→            if \"output\" not in self.column_map:\n   193→                raise ValueError(\n   194→                    f\"Expected a key of 'output' in column_map but found {self.column_map.keys()}.\"\n   195→                )\n   196→        else:\n   197→            self.column_map = {\"input\": \"input\", \"output\": \"output\", \"image\": \"image\"}\n   198→\n   199→        self.image_dir = image_dir\n   200→\n   201→    def __call__(self, sample: Mapping[str, Any]) -> Mapping[str, Any]:\n   202→        is_multimodal = \"image\" in sample or (\n   203→            \"image\" in self.column_map and self.column_map[\"image\"] in sample\n   204→        )\n   205→\n   206→        if is_multimodal:\n   207→            image_path = sample[self.column_map[\"image\"]]\n   208→            if isinstance(image_path, str):\n   209→                if self.image_dir is not None:\n   210→                    image_path = self.image_dir / image_path\n   211→                # Load if not loaded\n   212→                pil_image = load_image(image_path)\n   213→            else:\n   214→                pil_image = image_path\n   215→            content = [\n   216→                {\"type\": \"image\", \"content\": pil_image},\n   217→                {\"type\": \"text\", \"content\": sample[self.column_map[\"input\"]]},\n   218→            ]\n   219→        else:\n   220→            content = [{\"type\": \"text\", \"content\": sample[self.column_map[\"input\"]]}]\n   221→\n   222→        output_content = [\n   223→            {\"type\": \"text\", \"content\": sample[self.column_map[\"output\"]]}\n   224→        ]\n   225→\n   226→        messages = [\n   227→            Message(\n   228→                role=\"user\",\n   229→                content=content,\n   230→                masked=not self.train_on_input,\n   231→                eot=True,\n   232→            ),\n   233→            Message(\n   234→                role=\"assistant\",\n   235→                content=output_content,\n   236→                masked=False,\n   237→                eot=True,\n   238→            ),\n   239→        ]\n   240→        if self.new_system_prompt is not None:\n   241→            messages = [\n   242→                Message(\n   243→                    role=\"system\", content=self.new_system_prompt, masked=True, eot=True\n   244→                )\n   245→            ] + messages\n   246→        return {\"messages\": messages}\n   247→\n   248→\n   249→class ChosenRejectedToMessages(Transform):\n   250→    \"\"\"\n   251→    Transform for converting a single sample from datasets with \"chosen\" and \"rejected\" columns\n   252→    containing conversations to a list of chosen and rejected messages. For example::\n   253→\n   254→        |  chosen                                |  rejected                              |\n   255→        |----------------------------------------|----------------------------------------|\n   256→        | [{\"role\": \"user\", \"content\": Q1},      | [{\"role\": \"user\", \"content\": Q1},      |\n   257→        |  {\"role\": \"assistant\", \"content\": A1}] |  {\"role\": \"assistant\", \"content\": A2}] |\n   258→\n   259→    will be converted to:\n   260→\n   261→    .. code-block:: python\n   262→\n   263→        chosen = [\n   264→            Message(role=\"user\", content=\"Q1\"),\n   265→            Message(role=\"assistant\", content=\"A1\"),\n   266→        ]\n   267→        rejected = [\n   268→            Message(role=\"user\", content=\"Q1\"),\n   269→            Message(role=\"assistant\", content=\"A2\"),\n   270→        ]\n   271→\n   272→    A single sample typically consists of a single optional system prompt and one or multiple\n   273→    turns of user and assistant messages.\n   274→\n   275→    Args:\n   276→        train_on_input (bool): Whether the model is trained on the user prompt or not.\n   277→            Default is False.\n   278→        column_map (Optional[Dict[str, str]]): a mapping to change the expected\n   279→            \"chosen\" and \"rejected\" column names to the actual column names in the dataset.\n   280→            Keys should be \"chosen\" and \"rejected\" and values should be the actual column names.\n   281→            Default is None, keeping the default column names.\n   282→        new_system_prompt (Optional[str]): if specified, prepend a system message. This can\n   283→            serve as instructions to guide the model response. Setting this will OVERRIDE any system\n   284→            messages already present in the dataset. Default is None.\n   285→\n   286→    Raises:\n   287→        ValueError: If ``column_map`` is provided and ``chosen`` not in ``column_map``, or\n   288→            ``rejected`` not in ``column_map``.\n   289→    \"\"\"\n   290→\n   291→    def __init__(\n   292→        self,\n   293→        train_on_input: bool = False,\n   294→        column_map: Optional[Dict[str, str]] = None,\n   295→        new_system_prompt: Optional[str] = None,\n   296→    ):\n   297→        self.train_on_input = train_on_input\n   298→        self.new_system_prompt = new_system_prompt\n   299→        if column_map:\n   300→            if \"chosen\" not in column_map:\n   301→                raise ValueError(\n   302→                    f\"Expected a key of 'chosen' in column_map but found {column_map.keys()}.\"\n   303→                )\n   304→            if \"rejected\" not in column_map:\n   305→                raise ValueError(\n   306→                    f\"Expected a key of 'rejected' in column_map but found {column_map.keys()}.\"\n   307→                )\n   308→            self._column_map = column_map\n   309→        else:\n   310→            self._column_map = {\"chosen\": \"chosen\", \"rejected\": \"rejected\"}\n   311→\n   312→    def __call__(self, sample: Mapping[str, Any]) -> Mapping[str, Any]:\n   313→        chosen_messages = []\n   314→        for message in sample[self._column_map[\"chosen\"]]:\n   315→            if message[\"role\"] == \"system\" and self.new_system_prompt is not None:\n   316→                continue\n   317→            message[\"masked\"] = (message[\"role\"] != \"assistant\") and (\n   318→                not self.train_on_input\n   319→            )\n   320→            chosen_messages.append(Message.from_dict(message))\n   321→\n   322→        rejected_messages = []\n   323→        for message in sample[self._column_map[\"rejected\"]]:\n   324→            if message[\"role\"] == \"system\" and self.new_system_prompt is not None:\n   325→                continue\n   326→            message[\"masked\"] = (message[\"role\"] != \"assistant\") and (\n   327→                not self.train_on_input\n   328→            )\n   329→            rejected_messages.append(Message.from_dict(message))\n   330→\n   331→        if self.new_system_prompt is not None:\n   332→            chosen_messages = [\n   333→                Message(\n   334→                    role=\"system\", content=self.new_system_prompt, masked=True, eot=True\n   335→                )\n   336→            ] + chosen_messages\n   337→            rejected_messages = [\n   338→                Message(\n   339→                    role=\"system\", content=self.new_system_prompt, masked=True, eot=True\n   340→                )\n   341→            ] + rejected_messages\n   342→\n   343→        return {\"chosen\": chosen_messages, \"rejected\": rejected_messages}\n   344→\n   345→\n   346→class ShareGPTToMessages(Transform):\n   347→    \"\"\"\n   348→    Convert a single chat sample adhering to the ShareGPT JSON structure to torchtune's :class:`~torchtune.data.Message`\n   349→    structure.\n   350→\n   351→    A single sample typically consists of a single optional system prompt and one or multiple\n   352→    turns of user and assistant messages.\n   353→\n   354→    ShareGPT follows::\n   355→\n   356→        {\n   357→            \"conversations\": [\n   358→                {\n   359→                    \"from\": <system|human|gpt>,\n   360→                    \"value\": <message>,\n   361→                },\n   362→                ...\n   363→            ]\n   364→        }\n   365→\n   366→    :class:`~torchtune.data.Message` follows::\n   367→\n   368→        [\n   369→            {\n   370→                \"role\": <system|user|assistant>,\n   371→                \"content\": <message>,\n   372→            },\n   373→            ...\n   374→        ]\n   375→\n   376→    Args:\n   377→        train_on_input (bool): whether the prompt should remain unmasked. For multimodal datasets, ``train_on_input``\n   378→            is always False and this value is ignored. Default: False\n   379→        column_map (Optional[Dict[str, str]]): a mapping from the expected columns (\"conversations\")\n   380→            to the new column names in the dataset. Key should be \"conversations\" and value should\n   381→            be the new column name. If None, keep the default \"conversations\".\n   382→            Default is None.\n   383→        new_system_prompt (Optional[str]): if specified, prepend a system message. This can\n   384→            serve as instructions to guide the model response. Setting this will OVERRIDE any system\n   385→            messages already present in the dataset. Default is None.\n   386→        image_dir (Optional[Path]): path to the directory containing the images that is prepended to all image\n   387→            paths in the dataset. For example, if ``image_dir=\"/home/user/dataset/\"` and the sample image path\n   388→            was ``\"images/1.jpg\"``, the final image path that will be loaded is ``\"/home/user/dataset/images/1.jpg\"``.\n   389→            If None, assume images are available in current working directory or are located\n   390→            on a remote url. For text-only, leave as None. Default is None.\n   391→        image_tag (Optional[str]): placeholder tags in the text content of each message to be replaced by image\n   392→            special tokens. If images are present and this is None, then will prepend image tokens to the first\n   393→            user message in the sample by default. If text-only, this field is ignored. Default is ``\"<image>\"``.\n   394→\n   395→    Raises:\n   396→        ValueError: If ``column_map`` is provided and ``conversations`` not in ``column_map``.\n   397→    \"\"\"\n   398→\n   399→    def __init__(\n   400→        self,\n   401→        train_on_input: bool = False,\n   402→        column_map: Optional[Dict[str, str]] = None,\n   403→        new_system_prompt: Optional[str] = None,\n   404→        image_dir: Optional[Path] = None,\n   405→        image_tag: Optional[str] = \"<image>\",\n   406→    ):\n   407→        self.train_on_input = train_on_input\n   408→        self.new_system_prompt = new_system_prompt\n   409→        if column_map:\n   410→            if \"conversations\" not in column_map:\n   411→                raise ValueError(\n   412→                    f\"Expected a key of 'conversations' in column_map but found {column_map.keys()}.\"\n   413→                )\n   414→            self._column_map = column_map\n   415→        else:\n   416→            self._column_map = {\"conversations\": \"conversations\", \"image\": \"image\"}\n   417→        self.image_dir = image_dir\n   418→        self.image_tag = image_tag\n   419→\n   420→    def __call__(self, sample: Mapping[str, Any]) -> Mapping[str, Any]:\n   421→        \"\"\"\n   422→        Return a list of Message objects from the provided sample dict.\n   423→\n   424→        Args:\n   425→            sample (Mapping[str, Any]): a single data sample with \"messages\" field pointing\n   426→                to a list of dict messages.\n   427→\n   428→        Returns:\n   429→            List[Message]: A list of messages with \"role\" and \"content\" fields.\n   430→        \"\"\"\n   431→        role_map = {\"system\": \"system\", \"human\": \"user\", \"gpt\": \"assistant\"}\n   432→        messages = []\n   433→        if self.new_system_prompt is not None:\n   434→            messages.append(\n   435→                Message(\n   436→                    role=\"system\", content=self.new_system_prompt, masked=True, eot=True\n   437→                )\n   438→            )\n   439→\n   440→        is_multimodal = \"image\" in sample or (\n   441→            \"image\" in self._column_map and self._column_map[\"image\"] in sample\n   442→        )\n   443→\n   444→        # Gate variable to ensure that we only prepend image tokens to the first user message\n   445        image_loaded = False\n   446→        for message in sample[self._column_map[\"conversations\"]]:\n   447→            role = role_map[message[\"from\"]]\n   448→            content = message[\"value\"]\n   449→            if role == \"system\" and self.new_system_prompt is not None:\n   450→                continue\n   451→            if role == \"user\":\n   452→                if is_multimodal and 