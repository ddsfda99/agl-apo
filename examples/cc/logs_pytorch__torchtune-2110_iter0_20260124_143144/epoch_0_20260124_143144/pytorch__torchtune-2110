ompt = new_system_prompt\n   299\u2192        if column_map:\n   300\u2192            if \"chosen\" not in column_map:\n   301\u2192                raise ValueError(\n   302\u2192                    f\"Expected a key of 'chosen' in column_map but found {column_map.keys()}.\"\n   303\u2192                )\n   304\u2192            if \"rejected\" not in column_map:\n   305\u2192                raise ValueError(\n   306\u2192                    f\"Expected a key of 'rejected' in column_map but found {column_map.keys()}.\"\n   307\u2192                )\n   308\u2192            self._column_map = column_map\n   309\u2192        else:\n   310\u2192            self._column_map = {\"chosen\": \"chosen\", \"rejected\": \"rejected\"}\n   311\u2192\n   312\u2192    def __call__(self, sample: Mapping[str, Any]) -> Mapping[str, Any]:\n   313\u2192        chosen_messages = []\n   314\u2192        for message in sample[self._column_map[\"chosen\"]]:\n   315\u2192            if message[\"role\"] == \"system\" and self.new_system_prompt is not None:\n   316\u2192                continue\n   317\u2192            message[\"masked\"] = (message[\"role\"] != \"assistant\") and (\n   318\u2192                not self.train_on_input\n   319\u2192            )\n   320\u2192            chosen_messages.append(Message.from_dict(message))\n   321\u2192\n   322\u2192        rejected_messages = []\n   323\u2192        for message in sample[self._column_map[\"rejected\"]]:\n   324\u2192            if message[\"role\"] == \"system\" and self.new_system_prompt is not None:\n   325\u2192                continue\n   326\u2192            message[\"masked\"] = (message[\"role\"] != \"assistant\") and (\n   327\u2192                not self.train_on_input\n   328\u2192            )\n   329\u2192            rejected_messages.append(Message.from_dict(message))\n   330\u2192\n   331\u2192        if self.new_system_prompt is not None:\n   332\u2192            chosen_messages = [\n   333\u2192                Message(\n   334\u2192                    role=\"system\", content=self.new_system_prompt, masked=True, eot=True\n   335\u2192                )\n   336\u2192            ] + chosen_messages\n   337\u2192            rejected_messages = [\n   338\u2192                Message(\n   339\u2192                    role=\"system\", content=self.new_system_prompt, masked=True, eot=True\n   340\u2192                )\n   341\u2192            ] + rejected_messages\n   342\u2192\n   343\u2192        return {\"chosen\": chosen_messages, \"rejected\": rejected_messages}\n   344\u2192\n   345\u2192\n   346\u2192class ShareGPTToMessages(Transform):\n   347\u2192    \"\"\"\n   348\u2192    Convert a single chat sample adhering to the ShareGPT JSON structure to torchtune's :class:`~torchtune.data.Message`\n   349\u2192    structure.\n   350\u2192\n   351\u2192    A single sample typically consists of a single optional system prompt and one or multiple\n   352\u2192    turns of user and assistant messages.\n   353\u2192\n   354\u2192    ShareGPT follows::\n   355\u2192\n   356\u2192        {\n   357\u2192            \"conversations\": [\n   358\u2192                {\n   359\u2192                    \"from\": <system|human|gpt>,\n   360\u2192                    \"value\": <message>,\n   361\u2192                },\n   362\u2192                ...\n   363\u2192            ]\n   364\u2192        }\n   365\u2192\n   366\u2192    :class:`~torchtune.data.Message` follows::\n   367\u2192\n   368\u2192        [\n   369\u2192            {\n   370\u2192                \"role\": <system|user|assistant>,\n   371\u2192                \"content\": <message>,\n   372\u2192            },\n   373\u2192            ...\n   374\u2192        ]\n   375\u2192\n   376\u2192    Args:\n   377\u2192        train_on_input (bool): whether the prompt should remain unmasked. For multimodal datasets, ``train_on_input``\n   378\u2192            is always False and this value is ignored. Default: False\n   379\u2192        column_map (Optional[Dict[str, str]]): a mapping from the expected columns (\"conversations\")\n   380\u2192            to the new column names in the dataset. Key should be \"conversations\" and value should\n   381\u2192            be the new column name. If None, keep the default \"conversations\".\n   382\u2192            Default is None.\n   383\u2192        new_system_prompt (Optional[str]): if specified, prepend a system message. This can\n   384\u2192            serve as instructions to guide the model response. Setting this will OVERRIDE any system\n   385\u2192            messages already present in the dataset. Default is None.\n   386\u2192        image_dir (Optional[Path]): path to the directory containing the images that is prepended to all image\n   387\u2192            paths in the dataset. For example, if ``image_dir=\"/home/user/dataset/\"` and the sample image path\n   388\u2192            was ``\"images/1.jpg\"``, the final image path that will be loaded is ``\"/home/user/dataset/images/1.jpg\"``.\n   389\u2192            If None, assume images are available in current working directory or are located\n   390\u2192            on a remote url. For text-only, leave as None. Default is None.\n   391\u2192        image_tag (Optional[str]): placeholder tags in the text content of each message to be replaced by image\n   392\u2192            special tokens. If images are present and this is None, then will prepend image tokens to the first\n   393\u2192            user message in the sample by default. If text-only, this field is ignored. Default is ``\"<image>\"``.\n   394\u2192\n   395\u2192    Raises:\n   396\u2192        ValueError: If ``column_map`` is provided and ``conversations`` not in ``column_map``.\n   397\u2192    \"\"\"\n   398\u2192\n   399\u2192    def __init__(\n   400\u2192        self,\n   401\u2192        train_on_input: bool = False,\n   402\u2192        column_map: Optional[Dict[str, str]] = None,\n   403\u2192        new_system_prompt: Optional[str] = None,\n   404\u2192        image_dir: Optional[Path] = None,\n   405\u2192        image_tag: Optional[str] = \"<image>\",\n   406\u2192    ):\n   407\u2192        self.train_on_input = train_on_input\n   408\u2192        self.new_system_prompt = new_system_prompt\n   409\u2192        if column_map:\n   410\u2192            if \"conversations\" not in column_map:\n   411\u2192                raise ValueError(\n   412\u2192                    f\"Expected a key of 'conversations' in column_map but found {column_map.keys()}.\"\n   413\u2192                )\n   414\u2192            self._column_map = column_map\n   415\u2192        else:\n   416\u2192            self._column_map = {\"conversations\": \"conversations\", \"image\": \"image\"}\n   417\u2192        self.image_dir = image_dir\n   418\u2192        self.image_tag = image_tag\n   419\u2192\n   420\u2192    def __call__(self, sample: Mapping[str, Any]) -> Mapping[str, Any]:\n   421\u2192        \"\"\"\n   422\u2192        Return a list of Message objects from the provided sample dict.\n   423\u2192\n   424\u2192        Args:\n   425\u2192            sample (Mapping[str, Any]): a single data sample with \"messages\" field pointing\n   426\u2192                to a list of dict messages.\n   427\u2192\n   428\u2192        Returns:\n   429\u2192            List[Message]: A list of messages with \"role\" and \"content\" fields.\n   430\u2192        \"\"\"\n   431\u2192        role_map = {\"system\": \"system\", \"human\": \"user\", \"gpt\": \"assistant\"}\n   432\u2192        messages = []\n   433\u2192        if self.new_system_prompt is not None:\n   434\u2192            messages.append(\n   435\u2192                Message(\n   436\u2192                    role=\"system\", content=self.new_system_prompt, masked=True, eot=True\n   437\u2192                )\n   438\u2192            )\n   439\u2192\n   440\u2192        is_multimodal = \"image\" in sample or (\n   441\u2192            \"image\" in self._column_map and self._column_map[\"image\"] in sample\n   442\u2192        )\n   443\u2192\n   444\u2192        # Gate variable to ensure that we only prepend image tokens to the first user message\n   445        image_loaded = False\n   446\u2192        for message in sample[self._column_map[\"conversations\"]]:\n   447\u2192            role = role_map[message[\"from\"]]\n   448\u2192            content = message[\"value\"]\n   449\u2192            if role == \"system\" and self.new_system_prompt is not None:\n   450\u2192                continue\n   451\u2192            if role == \"user\":\n   452\u2192                if is_multimodal and not image_loaded:\n   453\u2192                    image_path = sample[self._column_map[\"image\"]]\n   454\u2192                    if self.image_dir is not None:\n   455\u2192                        image_path = self.image_dir / image_path\n   456\u2192                    pil_image = load_image(image_path)\n   457\u2192                    # If image tag is not specified, prepend by default\n   458\u2192                    if self.image_tag is None:\n   459\u2192                        content = [\n   460\u2192                            {\"type\": \"image\", \"content\": pil_image},\n   461\u2192                            {\"type\": \"text\", \"content\": content},\n   462\u2192                        ]\n   463\u2192                    else:\n   464\u2192                        content = format_content_with_images(\n   465\u2192                            content,\n   466\u2192                            image_tag=self.image_tag,\n   467\u2192                            images=[pil_image],\n   468\u2192                        )\n   469\u2192                    image_loaded = True\n   470\u2192\n   471\u2192            # If multimodal and user message, always mask\n   472\u2192            # Otherwise, if user message, mask if train_on_input is False\n   473\u2192            masked = (role != \"assistant\") and (\n   474\u2192                not self.train_on_input or is_multimodal\n   475\u2192            )\n   476\u2192            messages.append(Message(role=role, content=content, masked=masked))\n   477\u2192\n   478\u2192        return {\"messages\": messages}\n   479\u2192\n   480\u2192\n   481\u2192class OpenAIToMessages(Transform):\n   482\u2192    \"\"\"\n   483\u2192    Convert a single chat sample adhering to the `OpenAI chat completion <https://platform.openai.com/docs/api-reference/chat>`_\n   484\u2192    JSON structure to torchtune's :class:`~torchtune.data.Message` structure. This supports both\n   485\u2192    text and image messages.\n   486\u2192\n   487\u2192    A single sample typically consists of a single optional system prompt and one or multiple\n   488\u2192    turns of user and assistant messages.\n   489\u2192\n   490\u2192    For example::\n   491\u2192\n   492\u2192        {\n   493\u2192            \"messages\": [\n   494\u2192                {\n   495\u2192                    \"role\": <system|user|assistant>,\n   496\u2192                    \"content\": [\n   497\u2192                        {\n   498\u2192                            \"type\": \"text\",\n   499\u2192                            \"text\": \"What'\\''s in this image?\",\n   500\u2192                        },\n   501\u2192                        {\n   502\u2192                            \"type\": \"image_url\",\n   503\u2192                            \"image_url\": {\n   504\u2192                                \"url\": <url>,\n   505\u2192                            },\n   506\u2192                        },\n   507\u2192                },\n   508\u2192                ...\n   509\u2192            ]\n   510\u2192        }\n   511\u2192\n   512\u2192    :class:`~torchtune.data.Message` follows::\n   513\u2192\n   514\u2192        [\n   515\u2192            {\n   516\u2192                \"role\": <system|user|assistant>,\n   517\u2192                \"content\": [\n   518\u2192                    {\n   519\u2192                        \"type\": \"text\",\n   520\u2192                        \"content\": \"What'\\''s in this image?\",\n   521\u2192                    },\n   522\u2192                    {\n   523\u2192                        \"type\": \"image\",\n   524\u2192                        \"content\": <PIL.Image.Image>,\n   525\u2192                    },\n   526\u2192                ],\n   527\u2192            },\n   528\u2192            ...\n   529\u2192        ]\n   530\u2192\n   531\u2192    Args:\n   532\u2192        train_on_input (bool): whether the prompt should remain unmasked. Default: False\n   533\u2192        column_map (Optional[Dict[str, str]]): a mapping from the expected columns (\"messages\")\n   534\u2192            to the new column names in the dataset. Key should be \"messages\" and value should be\n   535\u2192            the new column name. If None, keep the default \"messages\".\n   536\u2192            Default is None.\n   537\u2192        new_system_prompt (Optional[str]): if specified, prepend a system message. This can\n   538\u2192            serve as instructions to guide the model response. Setting this will OVERRIDE any system\n   539\u2192            messages already present in the dataset. Default is None.\n   540\u2192\n   541\u2192    Raises:\n   542\u2192        ValueError: If ``column_map`` is provided and ``messages`` not in ``column_map``.\n   543\u2192    \"\"\"\n   544\u2192\n   545\u2192    def __init__(\n   546\u2192        self,\n   547\u2192        train_on_input: bool = False,\n   548\u2192        column_map: Optional[Dict[str, str]] = None,\n   549\u2192        new_system_prompt: Optional[str] = None,\n   550\u2192    ):\n   551\u2192        self.train_on_input = train_on_input\n   552\u2192        self.new_system_prompt = new_system_prompt\n   553\u2192        if column_map:\n   554\u2192            if \"messages\" not in column_map:\n   555\u2192                raise ValueError(\n   556\u2192                    f\"Expected a key of 'messages' in column_map but found {column_map.keys()}.\"\n   557\u2192                )\n   558\u2192            self._column_map = column_map\n   559\u2192        else:\n   560\u2192            self._column_map = {\"messages\": \"messages\"}\n   561\u2192\n   562\u2192    def _convert_from_openai_content(\n   563\u2192        self, content: List[Dict[str, Any]]\n   564\u2192    ) -> List[Dict[str, Any]]:\n   565\u2192        \"\"\"Converts a list of content dicts from the OpenAI format to the torchtune format.\"\"\"\n   566\u2192        converted_content = []\n   567\u2192        for content_dict in content:\n   568\u2192            if content_dict[\"type\"] == \"text\":\n   569\u2192                converted_content.append(\n   570\u2192                    {\"type\": \"text\", \"content\": content_dict[\"text\"]}\n   571\u2192                )\n   572\u2192            elif content_dict[\"type\"] == \"image_url\":\n   573\u2192                converted_content.append(\n   574\u2192                    {\n   575\u2192                        \"type\": \"image\",\n   576\u2192                        \"content\": load_image(content_dict[\"image_url\"][\"url\"]),\n   577\u2192                    }\n   578\u2192                )\n   579\u2192        return converted_content\n   580\u2192\n   581\u2192    def __call__(self, sample: Mapping[str, Any]) -> Mapping[str, Any]:\n   582\u2192        \"\"\"\n   583\u2192        Return a list of Message objects from the provided sample dict.\n   584\u2192\n   585\u2192        Args:\n   586\u2192            sample (Mapping[str, Any]): a single data sample with \"messages\" field pointing\n   587\u2192                to a list of dict messages.\n   588\u2192\n   589\u2192        Returns:\n   590\u2192            List[Message]: A list of messages with \"role\" and \"content\" fields.\n   591\u2192        \"\"\"\n   592\u2192        updated_messages = []\n   593\u2192        if self.new_system_prompt is not None:\n   594\u2192            updated_messages.append(\n   595\u2192                Message(\n   596\u2192                    role=\"system\", content=self.new_system_prompt, masked=True, eot=True\n   597\u2192                )\n   598\u2192            )\n   599\u2192        for message in sample[self._column_map[\"messages\"]]:\n   600\u2192            if message[\"role\"] == \"system\" and self.new_system_prompt is not None:\n   601\u2192                continue\n   602\u2192            masked = (message[\"role\"] != \"assistant\") and (not self.train_on_input)\n   603\u2192            if isinstance(message[\"content\"], list):\n   604\u2192                content = self._convert_from_openai_content(message[\"content\"])\n   605\u2192            elif isinstance(message[\"content\"], str):\n   606\u2192                content = message[\"content\"]\n   607\u2192            updated_messages.append(\n   608\u2192                Message(\n   609\u2192                    role=message[\"role\"],\n   610\u2192                    content=content,\n   611\u2192                    masked=masked,\n   612\u2192                ),\n   613\u2192            )\n   614\u2192\n   615\u2192        return {\"messages\": updated_messages}\n   616\u2192\n   617\u2192\n   618\u2192def validate_messages(\n   619\u2192    messages: List[Message],\n   620\u2192) -> None:\n   621\u2192    \"\"\"\n   622\u2192    Given a list of messages, ensure that messages form a valid\n   623\u2192    back-and-forth conversation. An error will be raised if:\n   624\u2192\n   625\u2192    - There is a system message that's not the first message\n   626\u2192    - There are two consecutive user messages\n   627\u2192    - An assistant message comes before the first user message\n   628\u2192    - The message is empty\n   629\u2192    - Messages are shorter than length of 2 (min. one user-assistant turn)\n   630\u2192\n   631\u2192\n   632\u2192    Args:\n   633\u2192        messages (List[Message]): the messages to validate.\n   634\u2192\n   635\u2192    Raises:\n   636\u2192        ValueError: If the messages are invalid.\n   637\u2192    \"\"\"\n   638\u2192    if len(messages) < 2:\n   639\u2192        raise ValueError(\n   640\u2192            f\"Messages must be at least length 2, but got {len(messages)} messages\"\n   641\u2192        )\n   642\u2192\n   643\u2192    last_turn = \"assistant\"\n   644\u2192    for i, message in enumerate(messages):\n   645\u2192        if message.role == \"assistant\" and last_turn != \"user\":\n   646\u2192            raise ValueError(\n   647\u2192                f\"Assistant message before expected user message at index {i} in messages\"\n   648\u2192            )\n   649\u2192        if message.role == \"user\" and last_turn == \"user\":\n   650\u2192            raise ValueError(\n   651\u2192                f\"Two consecutive user messages at index {i} and {i - 1} in messages\"\n   652\u2192            )\n   653\u2192        if message.role == \"system\" and i > 0:\n   654\u2192            raise ValueError(\n   655\u2192                f\"System message at index {i} in messages, but system messages must come first\"\n   656\u2192            )\n   657\u2192        last_turn = message.role\n   658\u2192\n   659\u2192\n   660\u2192class AlpacaToMessages(Transform):\n   661\u2192    \"\"\"\n   662\u2192    Message transform class for Alpaca-style datasets with \"instruction\", \"input\", and \"output\"\n   663\u2192    (or equivalent fields specified in column_map) columns. User messages are formed from the\n   664\u2192    instruction + input columns and assistant messages are formed from the output column. Prompt\n   665\u2192    templating is conditional on the presence of the \"input\" column, and thus is handled directly\n   666\u2192    in this transform class instead of a dedicated :class:`~torchtune.data.PromptTemplate` class\n   667\u2192    due to this custom logic.\n   668\u2192\n   669\u2192    Args:\n   670\u2192        train_on_input (bool): Whether the model is trained on the user prompt or not.\n   671\u2192            Default is True.\n   672\u2192        column_map (Optional[Dict[str, str]]): a mapping to change the expected \"instruction\", \"input\",\n   673\u2192            and \"output\" column names to the actual column names in the dataset. Default is None,\n   674\u2192            keeping the default column names.\n   675\u2192    \"\"\"\n   676\u2192\n   677\u2192    def __init__(\n   678\u2192        self, train_on_input: bool = True, column_map: Optional[Dict[str, str]] = None\n   679\u2192    ):\n   680\u2192        self.train_on_input = train_on_input\n   681\u2192        self.column_map = column_map\n   682\u2192        self.template = {\n   683\u2192            \"prompt_input\": (\n   684\u2192                \"Below is an instruction that describes a task, paired with an input that provides further context. \"\n   685\u2192                \"Write a response that appropriately completes the request.\\n\\n\"\n   686\u2192                \"### Instruction:\\n{instruction}\\n\\n### Input:\\n{input}\\n\\n### Response:\\n\"\n   687\u2192            ),\n   688\u2192            \"prompt_no_input\": (\n   689\u2192                \"Below is an instruction that describes a task. \"\n   690\u2192                \"Write a response that appropriately completes the request.\\n\\n\"\n   691\u2192                \"### Instruction:\\n{instruction}\\n\\n### Response:\\n\"\n   692\u2192            ),\n   693\u2192        }\n   694\u2192\n   695\u2192    def __call__(self, sample: Mapping[str, Any]) -> Mapping[str, Any]:\n   696\u2192        column_map = self.column_map or {}\n   697\u2192        key_input = column_map.get(\"input\", \"input\")\n   698\u2192        key_instruction = column_map.get(\"instruction\", \"instruction\")\n   699\u2192        key_output = column_map.get(\"output\", \"output\")\n   700\u2192\n   701\u2192        if key_input in sample and sample[key_input]:\n   702\u2192            prompt = self.template[\"prompt_input\"].format(\n   703\u2192                instruction=sample[key_instruction], input=sample[key_input]\n   704\u2192            )\n   705\u2192        else:\n   706\u2192            prompt = self.template[\"prompt_no_input\"].format(\n   707\u2192                instruction=sample[key_instruction]\n   708\u2192            )\n   709\u2192\n   710\u2192        messages = [\n   711\u2192            Message(\n   712\u2192                role=\"user\",\n   713\u2192                content=prompt,\n   714\u2192                masked=not self.train_on_input,\n   715\u2192                eot=True,\n   716\u2192            ),\n   717\u2192            Message(\n   718\u2192                role=\"assistant\",\n   719\u2192                content=sample[key_output],\n   720\u2192                masked=False,\n   721\u2192                eot=True,\n   722\u2192            ),\n   723\u2192        ]\n   724\u2192        return {\"messages\": messages}\n   725\u2192\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"
