ether the model is trained on the user prompt or not.\n   157\u2192            Default is False.\n   158\u2192        column_map (Optional[Dict[str, str]]): a mapping to change the expected \"input\"\n   159\u2192            and \"output\" column names to the actual column names in the dataset. Keys should\n   160\u2192            be \"input\" and \"output\" and values should be the actual column names. Default is None,\n   161\u2192            keeping the default \"input\" and \"output\" column names.\n   162\u2192        new_system_prompt (Optional[str]): if specified, prepend a system message. This can\n   163\u2192            serve as instructions to guide the model response. Default is None.\n   164\u2192        image_dir (Optional[Path]): path to the directory containing the images that is prepended to all image\n   165\u2192            paths in the dataset. For example, if ``image_dir=\"/home/user/dataset/\"` and the sample image path\n   166\u2192            was ``\"images/1.jpg\"``, the final image path that will be loaded is ``\"/home/user/dataset/images/1.jpg\"``.\n   167\u2192            If None, assume images are available in current working directory or are located\n   168\u2192            on a remote url. For text-only, leave as None. Default is None.\n   169\u2192\n   170\u2192    Raises:\n   171\u2192        ValueError: If ``column_map`` is provided and ``input`` not in ``column_map``, or\n   172\u2192            ``output`` not in ``column_map``.\n   173\u2192    \"\"\"\n   174\u2192\n   175\u2192    def __init__(\n   176\u2192        self,\n   177\u2192        train_on_input: bool = False,\n   178\u2192        column_map: Optional[Dict[str, str]] = None,\n   179\u2192        new_system_prompt: Optional[str] = None,\n   180\u2192        image_dir: Optional[Path] = None,\n   181\u2192    ):\n   182\u2192        self.train_on_input = train_on_input\n   183\u2192        self.new_system_prompt = new_system_prompt\n   184\u2192\n   185\u2192        self.column_map = column_map\n   186\u2192\n   187\u2192        if self.column_map is not None:\n   188\u2192            if \"input\" not in self.column_map:\n   189\u2192                raise ValueError(\n   190\u2192                    f\"Expected a key of 'input' in column_map but found {self.column_map.keys()}.\"\n   191\u2192                )\n   192\u2192            if \"output\" not in self.column_map:\n   193\u2192                raise ValueError(\n   194\u2192                    f\"Expected a key of 'output' in column_map but found {self.column_map.keys()}.\"\n   195\u2192                )\n   196\u2192        else:\n   197\u2192            self.column_map = {\"input\": \"input\", \"output\": \"output\", \"image\": \"image\"}\n   198\u2192\n   199\u2192        self.image_dir = image_dir\n   200\u2192\n   201\u2192    def __call__(self, sample: Mapping[str, Any]) -> Mapping[str, Any]:\n   202\u2192        is_multimodal = \"image\" in sample or (\n   203\u2192            \"image\" in self.column_map and self.column_map[\"image\"] in sample\n   204\u2192        )\n   205\u2192\n   206\u2192        if is_multimodal:\n   207\u2192            image_path = sample[self.column_map[\"image\"]]\n   208\u2192            if isinstance(image_path, str):\n   209\u2192                if self.image_dir is not None:\n   210\u2192                    image_path = self.image_dir / image_path\n   211\u2192                # Load if not loaded\n   212\u2192                pil_image = load_image(image_path)\n   213\u2192            else:\n   214\u2192                pil_image = image_path\n   215\u2192            content = [\n   216\u2192                {\"type\": \"image\", \"content\": pil_image},\n   217\u2192                {\"type\": \"text\", \"content\": sample[self.column_map[\"input\"]]},\n   218\u2192            ]\n   219\u2192        else:\n   220\u2192            content = [{\"type\": \"text\", \"content\": sample[self.column_map[\"input\"]]}]\n   221\u2192\n   222\u2192        output_content = [\n   223\u2192            {\"type\": \"text\", \"content\": sample[self.column_map[\"output\"]]}\n   224\u2192        ]\n   225\u2192\n   226\u2192        messages = [\n   227\u2192            Message(\n   228\u2192                role=\"user\",\n   229\u2192                content=content,\n   230\u2192                masked=not self.train_on_input,\n   231\u2192                eot=True,\n   232\u2192            ),\n   233\u2192            Message(\n   234\u2192                role=\"assistant\",\n   235\u2192                content=output_content,\n   236\u2192                masked=False,\n   237\u2192                eot=True,\n   238\u2192            ),\n   239\u2192        ]\n   240\u2192        if self.new_system_prompt is not None:\n   241\u2192            messages = [\n   242\u2192                Message(\n   243\u2192                    role=\"system\", content=self.new_system_prompt, masked=True, eot=True\n   244\u2192                )\n   245\u2192            ] + messages\n   246\u2192        return {\"messages\": messages}\n   247\u2192\n   248\u2192\n   249\u2192class ChosenRejectedToMessages(Transform):\n   250\u2192    \"\"\"\n   251\u2192    Transform for converting a single sample from datasets with \"chosen\" and \"rejected\" columns\n   252\u2192    containing conversations to a list of chosen and rejected messages. For example::\n   253\u2192\n   254\u2192        |  chosen                                |  rejected                              |\n   255\u2192        |----------------------------------------|----------------------------------------|\n   256\u2192        | [{\"role\": \"user\", \"content\": Q1},      | [{\"role\": \"user\", \"content\": Q1},      |\n   257\u2192        |  {\"role\": \"assistant\", \"content\": A1}] |  {\"role\": \"assistant\", \"content\": A2}] |\n   258\u2192\n   259\u2192    will be converted to:\n   260\u2192\n   261\u2192    .. code-block:: python\n   262\u2192\n   263\u2192        chosen 