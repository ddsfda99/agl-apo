+def test_input_output_to_messages_with_image_dir_str(mock_load_image):
+    # Ensure passing image_dir as a string works and calls load_image with joined path
+    test_img = Image.new(mode="RGB", size=(4, 4))
+    mock_load_image.return_value = test_img
+
+    image_dir = "/home/user/dataset"
+    sample = {
+        "input": "Describe the image",
+        "output": "A description",
+        "image": "images/1.jpg",
+    }
+    transform = InputOutputToMessages(image_dir=image_dir)
+    result = transform(sample)
+
+    # Should produce one user and one assistant message
+    assert len(result["messages"]) == 2
+    assert result["messages"][0].contains_media
+
+    from pathlib import Path
+
+    mock_load_image.assert_called_once_with(Path(image_dir) / "images/1.jpg")
+
