      choices = {}\n   952→        # A full index of available devices. Devices can be looked up by any valid key -\n   953→        # ID *or* AVD.\n   954→        device_index = {}\n   955→\n   956→        # Iterate over all the running devices.\n   957→        # If the device is a virtual device, use ADB to get the emulator AVD name.\n   958→        # If it is a physical device, use the device name.\n   959→        # Keep a log of all running AVDs\n   960→        running_avds = {}\n   961→        for d, details in sorted(running_devices.items(), key=lambda d: d[1][\"name\"]):\n   962→            name = details[\"name\"]\n   963→            avd = self.adb(d).avd_name()\n   964→            if avd:\n   965→                # It's a running emulator\n   966→                running_avds[avd] = d\n   967→                full_name = f\"@{avd} (running emulator)\"\n   968→                choices[d] = full_name\n   969→\n   970→                # Save the AVD as a device detail.\n   971→                details[\"avd\"] = avd\n   972→\n   973→                # Device can be looked up by device ID or AVD\n   974→                device_index[d] = full_name\n   975→                device_index[f\"@{avd}\"] = full_name\n   976→            else:\n   977→                # It's a physical device (might be disabled)\n   978→                full_name = f\"{name} ({d})\"\n   979→                choices[d] = full_name\n   980→                device_index[d] = full_name\n   981→\n   982→        # Add any non-running emulator AVDs to the list of candidate devices\n   983→        for avd in self.emulators():\n   984→            if avd not in running_avds:\n   985→                name = f\"@{avd} (emulator)\"\n   986→                choices[f\"@{avd}\"] = name\n   987→                device_index[f\"@{avd}\"] = name\n   988→\n   989→        # If a device or AVD has been provided, check it against the available\n   990→        # device list.\n   991→        if device_or_avd:\n   992→            try:\n   993→                name = device_index[device_or_avd]\n   994→\n   995→                if device_or_avd.startswith(\"@\"):\n   996→                    # specifier is an AVD\n   997→                    avd = device_or_avd[1:]\n   998→                    try:\n   999→                        device = running_avds[avd]\n  1000→                    except KeyError:\n  1001→                        # device_or_avd isn't in the list of running avds;\n  1002→                        # it must be a non-running emulator.\n  1003→                        return None, name, avd\n  1004→                else:\n  1005→                    # Specifier is a direct device ID\n  1006→                    device = device_or_avd\n  1007→\n  1008→                details = running_devices[device]\n  1009→                avd = details.get(\"avd\")\n  1010→                if details[\"authorized\"]:\n  1011→                    # An authorized, running device (emulator or physical)\n  1012→                    return device, name, avd\n  1013→                else:\n  1014→                    # An unauthorized physical device\n  1015→                    raise AndroidDeviceNotAuthorized(device)\n  1016→\n  1017→            except KeyError as e:\n  1018→                # Provided device_or_id isn't a valid device identifier.\n  1019→                id_type = (\n  1020→                    \"emulator AVD\" if device_or_avd.startswith(\"@\") else \"device ID\"\n  1021→                )\n  1022→                raise InvalidDeviceError(id_type, device_or_avd) from e\n  1023→        # We weren't given a device/AVD; we have to select from the list.\n  1024→        # If we're selecting from a list, there's always one last choice\n  1025→        choices[\"-\"] = \"Create a new Android emulator\"\n  1026→\n  1027→        # Show the choices to the user.\n  1028→        try:\n  1029→            choice = self.tools.console.selection_question(\n  1030→                intro=\"Select Android device to use:\",\n  1031→                description=\"Android device\",\n  1032→                options=choices,\n  1033→            )\n  1034→        except InputDisabled as e:\n  1035→            # If input is disabled, and there's only one actual simulator,\n  1036→            # select it. If there are no simulators, select \"Create simulator\"\n  1037→            if len(choices) <= 2:\n  1038→                choice = next(iter(choices))\n  1039→            else:\n  1040→                raise BriefcaseCommandError(\n  1041→                    \"\"\"\\\n  1042→Input has been disabled; can't select a device to target.\n  1043→Use the -d/--device option to explicitly specify the device to use.\n  1044→\"\"\"\n  1045→                ) from e\n  1046→\n  1047→        # Process the user's choice\n  1048→        if choice == \"-\":\n  1049→            # Create a new emulator. No device ID or AVD.\n  1050→            device = None\n  1051→            avd = None\n  1052→            name = None\n  1053→        elif choice.startswith(\"@\"):\n  1054→            # A non-running emulator. We have an AVD, but no device ID.\n  1055→            device = None\n  1056→            name = device_index[choice]\n  1057→            avd = choice[1:]\n  1058→        else:\n  1059→            # Either a running emulator, or a physical device. Regardless,\n  1060→            # we need to check if the device is developer enabled.\n  1061→            # Functionally, we know the device *must* be in the list of\n  1062→            # choices; which means it's also in the list of running devices\n  1063→            # and the list of device choices, so any KeyError on those lookups\n  1064→            # indicates a deeper problem.\n  1065→            details = running_devices[choice]\n  1066→            if not details[\"authorized\"]:\n  1067→                # An unauthorized physical device\n  1068→                raise AndroidDeviceNotAuthorized(choice)\n  1069→\n  1070→            # Return the device ID and name.\n  1071→            device = choice\n  1072→            name = device_index[choice]\n  1073→            avd = details.get(\"avd\")\n  1074→\n  1075→        if avd:\n  1076→            self.tools.console.info(\n  1077→                f\"\"\"\n  1078→In future, you can specify this device by running:\n  1079→\n  1080→    $ briefcase run android -d \"@{avd}\"\n  1081→\"\"\"\n  1082→            )\n  1083→        elif device:\n  1084→            self.tools.console.info(\n  1085→                f\"\"\"\n  1086→In future, you can specify this device by running:\n  1087→\n  1088→    $ briefcase run android -d {device}\n  1089→\"\"\"\n  1090→            )\n  1091→\n  1092→        return device, name, avd\n  1093→\n  1094→    def create_emulator(self) -> str:\n  1095→        \"\"\"Create a new Android emulator.\n  1096→\n  1097→        :returns: The AVD of the newly created emulator.\n  1098→        \"\"\"\n  1099→        # Get the list of existing emulators\n  1100→        emulators = set(self.emulators())\n  1101→\n  1102→        default_avd = \"beePhone\"\n  1103→        i = 1\n  1104→        # Make sure the default name is unique\n  1105→        while default_avd in emulators:\n  1106→            i += 1\n  1107→            default_avd = f\"beePhone{i}\"\n  1108→\n  1109→        # Prompt for a device avd until a valid one is provided.\n  1110→        avd = self.tools.console.text_question(\n  1111→            intro=f\"\"\"\\\n  1112→You need to select a name for your new emulator. This is an identifier that\n  1113→can be used to start the emulator in future. It should follow the same naming\n  1114→conventions as a Python package (i.e., it may only contain letters, numbers,\n  1115→hyphens and underscores). If you don't provide a name, Briefcase will use the\n  1116→a default name '{default_avd}'.\n  1117→\"\"\",\n  1118→            description=\"Emulator Name\",\n  1119→            default=default_avd,\n  1120→            validator=create_avd_validator(emulators),\n  1121→        )\n  1122→\n  1123→        # TODO: Provide a list of options for device types with matching skins\n  1124→        device_type = self.DEFAULT_DEVICE_TYPE\n  1125→        skin = self.DEFAULT_DEVICE_SKIN\n  1126→\n  1127→        # TODO: Provide a list of options for system images.\n  1128→        system_image = self.DEFAULT_SYSTEM_IMAGE\n  1129→\n  1130→        self._create_emulator(\n  1131→            avd=avd,\n  1132→            device_type=device_type,\n  1133→            skin=skin,\n  1134→            system_image=system_image,\n  1135→        )\n  1136→\n  1137→        self.tools.console.info(\n  1138→            f\"\"\"\n  1139→Android emulator '{avd}' created.\n  1140→\n  1141→In future, you can specify this device by running:\n  1142→\n  1143→    $ briefcase run android -d @{avd}\n  1144→\"\"\"\n  1145→        )\n  1146→\n  1147→        return avd\n  1148→\n  1149→    def _create_emulator(\n  1150→        self,\n  1151→        avd: str,\n  1152→        device_type: str | None = None,\n  1153→        skin: str | None = None,\n  1154→        system_image: str | None = None,\n  1155→    ):\n  1156→        \"\"\"Internal method that does the actual work of creating the emulator.\n  1157→\n  1158→        AVD is the only required argument; all other arguments will assume reasonable\n  1159→        defaults.\n  1160→\n  1161→        :param avd: The AVD for the new emulator\n  1162→        :param device_type: The device type for the new emulator (e.g., \"pixel\")\n  1163→        :param skin: The skin for the new emulator to use (e.g., \"pixel_3a\")\n  1164→        :param system_image: The system image to use on the new emulator. (e.g.,\n  1165→            \"system-images;android-31;default;arm64-v8a\")\n  1166→        \"\"\"\n  1167→        if device_type is None:\n  1168→            device_type = self.DEFAULT_DEVICE_TYPE\n  1169→        if skin is None:\n  1170→            skin = self.DEFAULT_DEVICE_SKIN\n  1171→        if system_image is None:\n  1172→            system_image = self.DEFAULT_SYSTEM_IMAGE\n  1173→\n  1174→        # Ensure the required skin is available.\n  1175→        self.verify_emulator_skin(skin)\n  1176→\n  1177→        # Ensure the required system image is available.\n  1178→        self.verify_system_image(system_image)\n  1179→\n  1180→        with self.tools.console.wait_bar(f\"Creating Android emulator {avd}...\"):\n  1181→            try:\n  1182→                self.tools.subprocess.check_output(\n  1183→                    [\n  1184→                        self.avdmanager_path,\n  1185→                        \"--verbose\",\n  1186→                        \"create\",\n  1187→                        \"avd\",\n  1188→                        \"--name\",\n  1189→                        avd,\n  1190→                        \"--abi\",\n  1191→                        self.emulator_abi,\n  1192→                        \"--package\",\n  1193→                        system_image,\n  1194→                        \"--device\",\n  1195→                        device_type,\n  1196→                    ],\n  1197→                    # Ensure XDG_CONFIG_HOME is not set so avdmanager uses the default\n  1198→                    # location (i.e. ~/.android) because the emulator does not respect\n  1199→                    # XDG_CONFIG_HOME and will not be able to find the AVD to run it.\n  1200→                    env={\n  1201→                        **self.env,\n  1202→                        **{\"XDG_CONFIG_HOME\": None},\n  1203→                    },\n  1204→                )\n  1205→            except subprocess.CalledProcessError as e:\n  1206→                raise BriefcaseCommandError(\"Unable to create Android emulator\") from e\n  1207→\n  1208→        with self.tools.console.wait_bar(\"Adding extra device configuration...\"):\n  1209→            self.update_emulator_config(\n  1210→                avd,\n  1211→                {\n  1212→                    \"avd.id\": avd,\n  1213→                    \"avd.name\": avd,\n  1214→                    \"disk.dataPartition.size\": \"4096M\",\n  1215→                    \"hw.keyboard\": \"yes\",\n  1216→                    \"skin.dynamic\": \"yes\",\n  1217→                    \"skin.name\": skin,\n  1218→                    \"skin.path\": f\"skins/{skin}\",\n  1219→                    \"showDeviceFrame\": \"yes\",\n  1220→                },\n  1221→            )\n  1222→\n  1223→    def avd_config(self, avd: str) -> dict[str, str]:\n  1224→        \"\"\"Obtain the AVD configuration as key-value pairs.\n  1225→\n  1226→        :params avd: The AVD whose config will be retrieved\n  1227→        \"\"\"\n  1228→        # Parse the existing config into key-value pairs\n  1229→        avd_config = {}\n  1230→        try:\n  1231→            with self.avd_config_filename(avd).open(\"r\", encoding=\"utf-8\") as f:\n  1232→                for line in f:\n  1233→                    try:\n  1234→                        key, value = line.rstrip().split(\"=\", 1)\n  1235→                        avd_config[key.strip()] = value.strip()\n  1236→                    except ValueError:\n  1237→                        pass\n  1238→        except OSError as e:\n  1239→            raise BriefcaseCommandError(\n  1240→                f\"Unable to read configuration of AVD @{avd}\"\n  1241→            ) from e\n  1242→\n  1243→        return avd_config\n  1244→\n  1245→    def update_emulator_config(self, avd: str, updates: dict[str, str]):\n  1246→        \"\"\"Update the AVD configuration with specific values.\n  1247→\n  1248→        :params avd: The AVD whose config will be updated\n  1249→        :params updates: A dictionary containing the new key-value to add to the device\n  1250→            configuration.\n  1251→        \"\"\"\n  1252→        avd_config = self.avd_config(avd)\n  1253→\n  1254→        # Augment the config with the new key-values pairs\n  1255→        avd_config.update(updates)\n  1256→\n  1257→        # Write the update configuration.\n  1258→        with self.avd_config_filename(avd).open(\"w\", encoding=\"utf-8\") as f:\n  1259→            for key, value in avd_config.items():\n  1260→                f.write(f\"{key}={value}\\n\")\n  1261→\n  1262→    def start_emulator(\n  1263→        self,\n  1264→        avd: str,\n  1265→        extra_args: list[str] | None = None,\n  1266→    ) -> tuple[str, str]:\n  1267→        \"\"\"Start an existing Android emulator.\n  1268→\n  1269→        Returns when the emulator is booted and ready to accept apps.\n  1270→\n  1271→        :param avd: The AVD of the device.\n  1272→        :param extra_args: Additional command line arguments to pass when starting the\n  1273→            emulator.\n  1274→        \"\"\"\n  1275→        if avd not in set(self.emulators()):\n  1276→            raise InvalidDeviceError(\"emulator AVD\", avd)\n  1277→\n  1278→        if extra_args is None:\n  1279→            extra_args = []\n  1280→\n  1281→        # Start the emulator\n  1282→        emulator_popen = self.tools.subprocess.Popen(\n  1283→            [self.emulator_path, f\"@{avd}\", \"-dns-server\", \"8.8.8.8\"] + extra_args,\n  1284→            env=self.env,\n  1285→            stdout=subprocess.PIPE,\n  1286→            stderr=subprocess.STDOUT,\n  1287→            bufsize=1,\n  1288→            start_new_session=True,\n  1289→        )\n  1290→\n  1291→        # Start capturing the emulator's output\n  1292→        # On Windows, the emulator can block until stdout is read and the emulator will\n  1293→        # not actually run until the user sends CTRL+C to Briefcase (#1573). This\n  1294→        # avoids that scenario while also ensuring emulator output is always available\n  1295→        # to print in the console if other issues occur.\n  1296→        emulator_streamer = self.tools.subprocess.stream_output_non_blocking(\n  1297→            label=\"Android emulator\",\n  1298→            popen_process=emulator_popen,\n  1299→            capture_output=True,\n  1300→        )\n  1301→\n  1302→        # wrap AVD name in quotes since '@' is a special char in PowerShell\n  1303→        emulator_command = \" \".join(\n  1304→            f'\"{arg}\"' if arg.startswith(\"@\") else arg\n  1305→            for arg in map(str, emulator_popen.args)\n  1306→        )\n  1307→\n  1308→        general_error_msg = f\"\"\"\n  1309→Review the emulator output above for:\n  1310→ - Troubleshooting or resolution steps such as enabling hardware acceleration\n  1311→ - Other errors or warnings that may be suggesting the cause of the startup failure\n  1312→\n  1313→Ensure your Android SDK is up-to-date by running:\n  1314→\n  1315→    $ briefcase upgrade {AndroidSDK.name}\n  1316→\n  1317→To review Google's general troubleshooting steps for the emulator, visit:\n  1318→\n  1319→    https://developer.android.com/studio/run/emulator-troubleshooting\n  1320→\n  1321→You can also start the emulator manually by running:\n  1322→\n  1323→    $ {emulator_command}\n  1324→\"\"\"\n  1325→\n  1326→        failed_startup_error_msg = f\"{{prologue}}\\n{general_error_msg}\"\n  1327→\n  1328→        # The boot process happens in 2 phases.\n  1329→        # First, the emulator appears in the device list. However, it's not ready until\n  1330→        # the boot process has finished. To determine the boot status, we need the\n  1331→        # device ID, and an ADB connection.\n  1332→\n  1333→        # Phase 1: Wait for the device to appear so we can get an ADB instance for it.\n  1334→        try:\n  1335→            with self.tools.console.wait_bar(\"Starting emulator...\") as keep_alive:\n  1336→                adb = None\n  1337→                known_devices = set()\n  1338→                while adb is None:\n  1339→                    if emulator_popen.poll() is not None:\n  1340→                        raise BriefcaseCommandError(\n  1341→                            failed_startup_error_msg.format(\n  1342→                                prologue=\"Android emulator was unable to start!\"\n  1343→                            )\n  1344→                        )\n  1345→\n  1346→                    for device, details in sorted(self.devices().items()):\n  1347→                        # Only process authorized devices that we haven't seen.\n  1348→                        if details[\"authorized\"] and device not in known_devices:\n  1349→                            adb = self.adb(device)\n  1350→                            device_avd = adb.avd_name()\n  1351→\n  1352→                            if device_avd == avd:\n  1353→                                # Found an active device that matches\n  1354→                                # the AVD we are starting.\n  1355→                                full_name = f\"@{avd} (running emulator)\"\n  1356→                                break\n  1357→                            else:\n  1358→                                # Not the one. Zathras knows.\n  1359→                                adb = None\n  1360→                                known_devices.add(device)\n  1361→\n  1362→                    # If we haven't found a device, try again in 2 seconds...\n  1363→                    if adb is None:\n  1364→                        keep_alive.update()\n  1365→                        self.sleep(2)\n  1366→\n  1367→            # Phase 2: Wait for the boot process to complete\n  1368→            if not adb.has_booted():\n  1369→                with self.tools.console.wait_bar(\"Booting emulator...\") as keep_alive:\n  1370→                    while not adb.has_booted():\n  1371→                        if emulator_popen.poll() is not None:\n  1372→                            raise BriefcaseCommandError(\n  1373→                                failed_startup_error_msg.format(\n  1374→                                    prologue=\"Android emulator was unable to boot!\"\n  1375→                                )\n  1376→                            )\n  1377→\n  1378→                        # Try again in 2 seconds...\n  1379→                        keep_alive.update()\n  1380→                        self.sleep(2)\n  1381→        except BaseException as e:\n  1382→            self.tools.console.warning(\n  1383→                \"Emulator output log for startup failure\",\n  1384→                prefix=self.name,\n  1385→            )\n  1386→            self.tools.console.info(emulator_streamer.captured_output)\n  1387→\n  1388→            # Provide troubleshooting steps if user gives up on the emulator starting\n  1389→            if isinstance(e, KeyboardInterrupt):\n  1390→                self.tools.console.warning(\n  1391→                    \"Is the Android emulator not starting up properly?\",\n  1392→                    prefix=self.name,\n  1393→                )\n  1394→                self.tools.console.info(\n  1395→                    \"\"\"\n  1396→If the emulator opened after pressing CTRL+C, then leave the emulator open and\n  1397→run Briefcase again. The running emulator can then be selected from the list.\n  1398→\"\"\"\n  1399→                )\n  1400→                self.tools.console.info(general_error_msg)\n  1401→\n  1402→            raise\n  1403→        finally:\n  1404→            emulator_streamer.request_stop()\n  1405→\n  1406→        # Return the device ID and full name.\n  1407→        return device, full_name\n  1408→\n  1409→\n  1410→class ADB:\n  1411→    def __init__(self, tools: ToolCache, device: str):\n  1412→        \"\"\"An API integration for the Android Debug Bridge (ADB).\n  1413→\n  1414→        :param tools: ToolCache of available tools\n  1415→        :param device: The ID of the device to target (in a format usable by `adb -s`)\n  1416→        \"\"\"\n  1417→        self.tools = tools\n  1418→        self.device = device\n  1419→\n  1420→    def avd_name(self) -> str | None:\n  1421→        \"\"\"Get the AVD name for the device.\n  1422→\n  1423→        :returns: T