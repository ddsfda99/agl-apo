192            # Provide troubleshooting steps if user gives up on the emulator starting\n  1389\u2192            if isinstance(e, KeyboardInterrupt):\n  1390\u2192                self.tools.console.warning(\n  1391\u2192                    \"Is the Android emulator not starting up properly?\",\n  1392\u2192                    prefix=self.name,\n  1393\u2192                )\n  1394\u2192                self.tools.console.info(\n  1395\u2192                    \"\"\"\n  1396\u2192If the emulator opened after pressing CTRL+C, then leave the emulator open and\n  1397\u2192run Briefcase again. The running emulator can then be selected from the list.\n  1398\u2192\"\"\"\n  1399\u2192                )\n  1400\u2192                self.tools.console.info(general_error_msg)\n  1401\u2192\n  1402\u2192            raise\n  1403\u2192        finally:\n  1404\u2192            emulator_streamer.request_stop()\n  1405\u2192\n  1406\u2192        # Return the device ID and full name.\n  1407\u2192        return device, full_name\n  1408\u2192\n  1409\u2192\n  1410\u2192class ADB:\n  1411\u2192    def __init__(self, tools: ToolCache, device: str):\n  1412\u2192        \"\"\"An API integration for the Android Debug Bridge (ADB).\n  1413\u2192\n  1414\u2192        :param tools: ToolCache of available tools\n  1415\u2192        :param device: The ID of the device to target (in a format usable by `adb -s`)\n  1416\u2192        \"\"\"\n  1417\u2192        self.tools = tools\n  1418\u2192        self.device = device\n  1419\u2192\n  1420\u2192    def avd_name(self) -> str | None:\n  1421\u2192        \"\"\"Get the AVD name for the device.\n  1422\u2192\n  1423\u2192        :returns: The AVD name for the device; or ``None`` if the device isn't\n  1424\u2192            an emulator\n  1425\u2192        \"\"\"\n  1426\u2192        try:\n  1427\u2192            output = self.run(\"emu\", \"avd\", \"name\")\n  1428\u2192            return output.split(\"\\n\")[0]\n  1429\u2192        except subprocess.CalledProcessError as e:\n  1430\u2192            # Status code 1 is a normal \"it's not an emulator\" error response\n  1431\u2192            if e.returncode == 1:\n  1432\u2192                return None\n  1433\u2192            else:\n  1434\u2192                raise BriefcaseCommandError(\n  1435\u2192                    f\"Unable to interrogate AVD name of device {self.device}\"\n  1436\u2192                ) from e\n  1437\u2192\n  1438\u2192    def has_booted(self) -> bool:\n  1439\u2192        \"\"\"Determine if the device has completed booting.\n  1440\u2192\n  1441\u2192        :returns: True if it has booted; False otherwise.\n  1442\u2192        \"\"\"\n  1443\u2192        try:\n  1444\u2192            # When the sys.boot_completed property of the device\n  1445\u2192            # returns '1', the boot is complete. Any other response indicates\n  1446\u2192            # booting is underway.\n  1447\u2192            output = self.run(\"shell\", \"getprop\", \"sys.boot_completed\")\n  1448\u2192            return output.strip() == \"1\"\n  1449\u2192        except subprocess.CalledProcessError as e:\n  1450\u2192            raise BriefcaseCommandError(\n  1451\u2192                f\"Unable to determine if emulator {self.device} has booted.\"\n  1452\u2192            ) from e\n  1453\u2192\n  1454\u2192    def run(self, *arguments: SubprocessArgT, quiet: bool = False) -> str:\n  1455\u2192        \"\"\"Run a command on a device using Android debug bridge, `adb`. The device name\n  1456\u2192        is mandatory to ensure clarity in the case of multiple attached devices.\n  1457\u2192\n  1458\u2192        :param arguments: List of strings to pass to `adb` as arguments.\n  1459\u2192        :param quiet: Should the invocation of this command be silent, and\n  1460\u2192            *not* appear in the logs? This should almost always be False;\n  1461\u2192            however, for some calls (most notably, calls that are called\n  1462\u2192            frequently to evaluate the status of another process), logging can\n  1463\u2192            be turned off so that log output isn't corrupted by thousands of\n  1464\u2192            polling calls.\n  1465\u2192        :returns: `adb` output on success; raises an exception on failure.\n  1466\u2192        \"\"\"\n  1467\u2192        # The ADB integration operates on the basis of running commands before\n  1468\u2192        # checking that they are valid, then parsing output to notice errors.\n  1469\u2192        # This keeps performance good in the success case.\n  1470\u2192        try:\n  1471\u2192            output = self.tools.subprocess.check_output(\n  1472\u2192                [self.tools.android_sdk.adb_path, \"-s\", self.device] + list(arguments),\n  1473\u2192                quiet=quiet,\n  1474\u2192            )\n  1475\u2192            # add returns status code 0 in the case of failure. The only tangible evidence\n  1476\u2192            # of failure is the message \"Failure [INSTALL_FAILED_OLDER_SDK]\" in the,\n  1477\u2192            # console output; so if that message exists in the output, raise an exception.\n  1478\u2192            if \"Failure [INSTALL_FAILED_OLDER_SDK]\" in output:\n  1479\u2192                raise BriefcaseCommandError(\n  1480\u2192                    \"Your device doesn't meet the minimum SDK requirements of this app.\"\n  1481\u2192                )\n  1482\u2192            return output\n  1483\u2192        except subprocess.CalledProcessError as e:\n  1484\u2192            if any(DEVICE_NOT_FOUND.match(line) for line in e.output.split(\"\\n\")):\n  1485\u2192                raise InvalidDeviceError(\"device id\", self.device) from e\n  1486\u2192            raise\n  1487\u2192\n  1488\u2192    def install_apk(self, apk_path: str | Path):\n  1489\u2192        \"\"\"Install an APK file on an Android device.\n  1490\u2192\n  1491\u2192        :param apk_path: The path of the Android APK file to install.\n  1492\u2192        :returns: `None` on success; raises an exception on failure.\n  1493\u2192        \"\"\"\n  1494\u2192        try:\n  1495\u2192            self.run(\"install\", \"-r\", apk_path)\n  1496\u2192        except subprocess.CalledProcessError as e:\n  1497\u2192            raise BriefcaseCommandError(\n  1498\u2192                f\"Unable to install APK {apk_path} on {self.device}\"\n  1499\u2192            ) from e\n  1500\u2192\n  1501\u2192    def force_stop_app(self, package: str):\n  1502\u2192        \"\"\"Force-stop an app, specified as a package name.\n  1503\u2192\n  1504\u2192        :param package: The name of the Android package, e.g., com.username.myapp.\n  1505\u2192        :returns: `None` on success; raises an exception on failure.\n  1506\u2192        \"\"\"\n  1507\u2192        # In my testing, `force-stop` exits with status code 0 (success) so long\n  1508\u2192        # as you pass a package name, even if the package does not exist, or the\n  1509\u2192        # package is not running.\n  1510\u2192        try:\n  1511\u2192            self.run(\"shell\", \"am\", \"force-stop\", package)\n  1512\u2192        except subprocess.CalledProcessError as e:\n  1513\u2192            raise BriefcaseCommandError(\n  1514\u2192                f\"Unable to force stop app {package} on {self.device}\"\n  1515\u2192            ) from e\n  1516\u2192\n  1517\u2192    def start_app(self, package: str, activity: str, passthrough: list[str]):\n  1518\u2192        \"\"\"Start an app, specified as a package name & activity name.\n  1519\u2192\n  1520\u2192        If you have an APK file, and you are not sure of the package or activity\n  1521\u2192        name, you can find it using `aapt dump badging filename.apk` and looking\n  1522\u2192        for \"package\" and \"launchable-activity\" in the output.\n  1523\u2192\n  1524\u2192        :param package: The name of the Android package, e.g., com.username.myapp.\n  1525\u2192        :param activity: The activity of the APK to start.\n  1526\u2192        :param passthrough: Arguments to pass to the app.\n  1527\u2192        :returns: `None` on success; raises an exception on failure.\n  1528\u2192        \"\"\"\n  1529\u2192        try:\n  1530\u2192            # `am start` also accepts string array extras, but we pass the arguments as a\n  1531\u2192            # single JSON string, because JSON deals with edge cases like whitespace and\n  1532\u2192            # escaping in a reliable and well-documented way.\n  1533\u2192            output = self.run(\n  1534\u2192                \"shell\",\n  1535\u2192                \"am\",\n  1536\u2192                \"start\",\n  1537\u2192                \"-n\",\n  1538\u2192                f\"{package}/{activity}\",\n  1539\u2192                \"-a\",\n  1540\u2192                \"android.intent.action.MAIN\",\n  1541\u2192                \"-c\",\n  1542\u2192                \"android.intent.category.LAUNCHER\",\n  1543\u2192                \"--es\",\n  1544\u2192                \"org.beeware.ARGV\",\n  1545\u2192                shlex.quote(json.dumps(passthrough)),  # Protect from Android's shell\n  1546\u2192            )\n  1547\u2192\n  1548\u2192            # `adb shell am start` always exits with status zero. We look for error\n  1549\u2192            # messages in the output.\n  1550\u2192            if any(\n  1551\u2192                line.startswith(\"Error: Activity class \")\n  1552\u2192                and line.endswith(\"does not exist.\")\n  1553\u2192                for line in output.split(\"\\n\")\n  1554\u2192            ):\n  1555\u2192                raise BriefcaseCommandError(\n  1556\u2192                    f\"\"\"\\\n  1557\u2192Activity class not found while starting app.\n  1558\u2192\n  1559\u2192`adb` output:\n  1560\u2192\n  1561\u2192    {output}\n  1562\u2192\"\"\"\n  1563\u2192                )\n  1564\u2192        except subprocess.CalledProcessError as e:\n  1565\u2192            raise BriefcaseCommandError(\n  1566\u2192                f\"Unable to start {package}/{activity} on {self.device}\"\n  1567\u2192            ) from e\n  1568\u2192\n  1569\u2192    def logcat(self, pid: str) -> subprocess.Popen:\n  1570\u2192        \"\"\"Start following the adb log for the device.\n  1571\u2192\n  1572\u2192        :param pid: The PID whose logs you want to display.\n  1573\u2192        :returns: A Popen object for the logcat call\n  1574\u2192        \"\"\"\n  1575\u2192        # As best as we can make out, adb logcat returns UTF-8 output.\n  1576\u2192        # See #1425 for details.\n  1577\u2192        return self.tools.subprocess.Popen(\n  1578\u2192            [\n  1579\u2192                self.tools.android_sdk.adb_path,\n  1580\u2192                \"-s\",\n  1581\u2192                self.device,\n  1582\u2192                \"logcat\",\n  1583\u2192                \"--format=tag\",\n  1584\u2192                \"--pid\",  # This option is available since API level 24.\n  1585\u2192                pid,\n  1586\u2192            ]\n  1587\u2192            # Filter out some noisy and useless tags.\n  1588\u2192            + [f\"{tag}:S\" for tag in [\"EGL_emulation\"]]\n  1589\u2192            + ([\"--format=color\"] if self.tools.console.is_color_enabled else []),\n  1590\u2192            env=self.tools.android_sdk.env,\n  1591            encoding=\"UTF-8\",\n  1592\u2192            stdout=subprocess.PIPE,\n  1593\u2192            stderr=subprocess.STDOUT,\n  1594\u2192            bufsize=1,\n  1595\u2192        )\n  1596\u2192\n  1597\u2192    def logcat_tail(self, since: datetime):\n  1598\u2192        \"\"\"Show the tail of the logs for Python-like apps, starting from a given\n  1599\u2192        timestamp.\n  1600\u2192\n  1601\u2192        :param since: The start time from which logs should be displayed\n  1602\u2192        \"\"\"\n  1603\u2192        try:\n  1604\u2192            # As best as we can make out, adb logcat returns UTF-8 output.\n  1605\u2192            # See #1425 for details.\n  1606\u2192            self.tools.subprocess.run(\n  1607\u2192                [\n  1608\u2192                    self.tools.android_sdk.adb_path,\n  1609\u2192                    \"-s\",\n  1610\u2192                    self.device,\n  1611\u2192                    \"logcat\",\n  1612\u2192                    \"--format=tag\",\n  1613\u2192                    \"-t\",\n  1614\u2192                    since.strftime(\"%m-%d %H:%M:%S.000000\"),\n  1615\u2192                    \"-s\",\n  1616\u2192                    # This is a collection of log labels that should catch\n  1617\u2192                    # most Python app output.\n  1618\u2192                    \"MainActivity:*\",\n  1619\u2192                    \"stdio:*\",\n  1620\u2192                    \"python.stdout:*\",\n  1621\u2192                    \"AndroidRuntime:*\",\n  1622\u2192                ]\n  1623\u2192                + ([\"--format=color\"] if self.tools.console.is_color_enabled else []),\n  1624\u2192                env=self.tools.android_sdk.env,\n  1625\u2192                check=True,\n  1626\u2192                encoding=\"UTF-8\",\n  1627\u2192            )\n  1628\u2192        except subprocess.CalledProcessError as e:\n  1629\u2192            raise BriefcaseCommandError(\"Error starting ADB logcat.\") from e\n  1630\u2192\n  1631\u2192    def pidof(self, package: str, **kwargs) -> str | None:\n  1632\u2192        \"\"\"Obtain the PID of a running app by package name.\n  1633\u2192\n  1634\u2192        :param package: The package ID for the application (e.g.,\n  1635\u2192            ``org.beeware.tutorial``)\n  1636\u2192        :returns: The PID of the given app as a string, or None if it isn't\n  1637\u2192        running.\n  1638\u2192        \"\"\"\n  1639\u2192        # The pidof command is available since API level 24. The level 23 emulator image also\n  1640\u2192        # includes it, but it doesn't work correctly (it returns all processes).\n  1641\u2192        try:\n  1642\u2192            # Exit status is unreliable: some devices (e.g. Nexus 4) return 0 even when no\n  1643\u2192            # process was found.\n  1644\u2192            return self.run(\"shell\", \"pidof\", \"-s\", package, **kwargs).strip() or None\n  1645\u2192        except subprocess.CalledProcessError:\n  1646\u2192            return None\n  1647\u2192\n  1648\u2192    def pid_exists(self, pid: str, **kwargs) -> bool:\n  1649\u2192        \"\"\"Confirm if the PID exists on the emulator.\n  1650\u2192\n  1651\u2192        :param pid: The PID to check\n  1652\u2192        :returns: True if the PID exists, False if it doesn't.\n  1653\u2192        \"\"\"\n  1654\u2192        # Look for the existence of /proc/<PID> on the device filesystem.\n  1655\u2192        # If that file exists, so does the process.\n  1656\u2192        try:\n  1657\u2192            self.run(\"shell\", \"test\", \"-e\", f\"/proc/{pid}\", **kwargs)\n  1658\u2192            return True\n  1659\u2192        except subprocess.CalledProcessError:\n  1660\u2192            return False\n  1661\u2192\n  1662\u2192    def kill(self):\n  1663\u2192        \"\"\"Stop the running Android emulator.\"\"\"\n  1664\u2192        try:\n  1665\u2192            self.run(\"emu\", \"kill\")\n  1666\u2192        except subprocess.CalledProcessError as e:\n  1667\u2192            raise BriefcaseCommandError(\"Error stopping the Android emulator.\") from e\n  1668\u2192\n  1669\u2192    def datetime(self) -> datetime:\n  1670\u2192        \"\"\"Obtain the device's current date/time.\n  1671\u2192\n  1672\u2192        This date/time is naive (i.e. not timezone aware) and in the device's \"local\"\n  1673\u2192        time. Therefore, it may be quite different from the date/time for Briefcase and\n  1674\u2192        caution should be used if comparing it to machine's \"local\" time.\n  1675\u2192        \"\"\"\n  1676\u2192        datetime_format = \"%Y-%m-%d %H:%M:%S\"\n  1677\u