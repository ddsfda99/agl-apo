e \"avdmanager\"\n   130\u2192        )\n   131\u2192        return self.cmdline_tools_path / \"bin\" / avdmanager\n   132\u2192\n   133\u2192    @property\n   134\u2192    def emulator_path(self) -> Path:\n   135\u2192        emulator = \"emulator.exe\" if self.tools.host_os == \"Windows\" else \"emulator\"\n   136\u2192        return self.root_path / \"emulator\" / emulator\n   137\u2192\n   138\u2192    @property\n   139\u2192    def avd_path(self) -> Path:\n   140\u2192        return self.dot_android_path / \"avd\"\n   141\u2192\n   142\u2192    def avd_config_filename(self, avd: str) -> Path:\n   143\u2192        return self.avd_path / f\"{avd}.avd/config.ini\"\n   144\u2192\n   145\u2192    @property\n   146\u2192    def env(self) -> dict[str, str]:\n   147\u2192        return {\n   148\u2192            \"ANDROID_HOME\": os.fsdecode(self.root_path),\n   149\u2192            \"ANDROID_SDK_ROOT\": os.fsdecode(self.root_path),\n   150\u2192            \"JAVA_HOME\": str(self.tools.java.java_home),\n   151\u2192        }\n   152\u2192\n   153\u2192    @property\n   154\u2192    def emulator_abi(self) -> str:\n   155\u2192        \"\"\"The ABI to use for the Android emulator.\"\"\"\n   156\u2192        try:\n   157\u2192            return {\n   158\u2192                \"Linux\": {\n   159\u2192                    \"x86_64\": \"x86_64\",\n   160\u2192                    \"aarch64\": \"arm64-v8a\",\n   161\u2192                },\n   162\u2192                \"Darwin\": {\n   163\u2192                    \"x86_64\": \"x86_64\",\n   164\u2192                    \"arm64\": \"arm64-v8a\",\n   165\u2192                },\n   166\u2192                \"Windows\": {\n   167\u2192                    \"AMD64\": \"x86_64\",\n   168\u2192                },\n   169\u2192            }[self.tools.host_os][self.tools.host_arch]\n   170\u2192        except KeyError:\n   171\u2192            raise BriefcaseCommandError(\n   172\u2192                \"The Android emulator does not currently support \"\n   173\u2192                f\"{self.tools.host_os} {self.tools.host_arch} hardware.\"\n   174\u2192            )\n   175\u2192\n   176\u2192    @property\n   177\u2192    def DEFAULT_DEVICE_TYPE(self) -> str:\n   178\u2192        return \"pixel\"\n   179\u2192\n   180\u2192    @property\n   181\u2192    def DEFAULT_DEVICE_SKIN(self) -> str:\n   182\u2192        return \"pixel_7_pro\"\n   183\u2192\n   184\u2192    @property\n   185\u2192    def DEFAULT_SYSTEM_IMAGE(self) -> str:\n   186\u2192        return f\"system-images;android-31;default;{self.emulator_abi}\"\n   187\u2192\n   188\u2192    @classmethod\n   189\u2192    def sdk_path_from_env(cls, tools: ToolCache) -> tuple[str | None, str | None]:\n   190\u2192        \"\"\"Determine the file path to an Android SDK from the environment.\n   191\u2192\n   192\u2192        Android has historically supported several env vars to set the location of an\n   193\u2192        Android SDK for build tools. The currently preferred source is ANDROID_HOME;\n   194\u2192        however, ANDROID_SDK_ROOT is also supported as a deprecated setting.\n   195\u2192\n   196\u2192        These values must be same if both set; otherwise, Gradle will error.\n   197\u2192\n   198\u2192        :param tools: ToolCache of available tools\n   199\u2192        :returns: Tuple of path to SDK and the env var name that provided that path\n   200\u2192        \"\"\"\n   201\u2192        android_home = tools.os.environ.get(\"ANDROID_HOME\")\n   202\u2192        android_sdk_root = tools.os.environ.get(\"ANDROID_SDK_ROOT\")\n   203\u2192\n   204\u2192        if android_home:\n   205\u2192            if android_sdk_root and android_sdk_root != android_home:\n   206\u2192                tools.console.warning(\n   207\u2192                    f\"\"\"\n   208\u2192*************************************************************************\n   209\u2192** WARNING: ANDROID_HOME and ANDROID_SDK_ROOT are inconsistent         **\n   210\u2192*************************************************************************\n   211\u2192\n   212\u2192    The ANDROID_HOME and ANDROID_SDK_ROOT environment variables are set\n   213\u2192    to different paths:\n   214\u2192\n   215\u2192        ANDROID_HOME:     {android_home}\n   216\u2192        ANDROID_SDK_ROOT: {android_sdk_root}\n   217\u2192\n   218\u2192    Briefcase will ignore ANDROID_SDK_ROOT and only use the path\n   219\u2192    specified by ANDROID_HOME.\n   220\u2192\n   221\u2192    You should update your environment configuration to either not set\n   222\u2192    ANDROID_SDK_ROOT, or set both environment variables to the same\n   223\u2192    path.\n   224\u2192\n   225\u2192*************************************************************************\n   226\u2192\"\"\"\n   227\u2192                )\n   228\u2192            sdk_root = android_home\n   229\u2192            sdk_source = \"ANDROID_HOME\"\n   230\u2192        elif android_sdk_root:\n   231\u2192            sdk_root = android_sdk_root\n   232\u2192            sdk_source = \"ANDROID_SDK_ROOT\"\n   233\u2192        else:\n   234\u2192            sdk_root = None\n   235\u2192            sdk_source = None\n   236\u2192\n   237\u2192        return sdk_root, sdk_source\n   238\u2192\n   239\u2192    @classmethod\n   240\u2192    def verify_install(\n   241\u2192        cls,\n   242\u2192        tools: ToolCache,\n   243\u2192        install: bool = True,\n   244\u2192        **kwargs,\n   245\u2192    ) -> AndroidSDK:\n   246\u2192        \"\"\"Verify an Android SDK is available.\n   247\u2192\n   248\u2192        The file paths in ANDROID_HOME and ANDROID_SDK_ROOT environment variables will\n   249\u2192        be checked for a valid SDK.\n   250\u2192\n   251\u2192        If those file paths do not contain an SDK, or no file path is provided, an SDK\n   252\u2192        is downloaded.\n   253\u2192\n   254\u2192        :param tools: ToolCache of available tools\n   255\u2192        :param install: Should the tool be installed if it is not found?\n   256\u2192        :returns: A valid Android SDK wrapper. If Android SDK is not available, and was\n   257\u2192            not installed, raises MissingToolError.\n   258\u2192        \"\"\"\n   259\u2192        # short circuit since already verified and available\n   260\u2192        if hasattr(tools, \"android_sdk\"):\n   261\u2192            return tools.android_sdk\n   262\u2192\n   263\u2192        JDK.verify(tools=tools, install=install)\n   264\u2192\n   265\u2192        sdk = None\n   266\u2192\n   267\u2192        # Verify externally-managed Android SDK\n   268\u2192        sdk_root_env, sdk_source_env = cls.sdk_path_from_env(tools=tools)\n   269\u2192        if sdk_root_env:\n   270\u2192            tools.console.debug(\"Evaluating ANDROID_HOME...\", prefix=cls.full_name)\n   271\u2192            tools.console.debug(f\"{sdk_source_env}={sdk_root_env}\")\n   272\u2192            sdk = AndroidSDK(tools=tools, root_path=Path(sdk_root_env))\n   273\u2192\n   274\u2192            if sdk.exists():\n   275\u2192                if sdk_source_env == \"ANDROID_SDK_ROOT\":\n   276\u2192                    tools.console.warning(\n   277\u2192                        \"\"\"\n   278\u2192*************************************************************************\n   279\u2192** WARNING: Using Android SDK from ANDROID_SDK_ROOT                    **\n   280\u2192*************************************************************************\n   281\u2192\n   282\u2192    Briefcase is using the Android SDK specified by the ANDROID_SDK_ROOT\n   283\u2192    environment variable.\n   284\u2192\n   285\u2192    Android has deprecated ANDROID_SDK_ROOT in favor of the\n   286\u2192    ANDROID_HOME environment variable.\n   287\u2192\n   288\u2192    Update your environment configuration to set ANDROID_HOME instead of\n   289\u2192    ANDROID_SDK_ROOT to ensure future compatibility.\n   290\u2192\n   291\u2192*************************************************************************\n   292\u2192\"\"\"\n   293\u2192                    )\n   294\u2192            elif sdk.cmdline_tools_path.parent.exists():\n   295\u2192                # a cmdline-tools directory exists but the required version isn't installed.\n   296\u2192                # try to install the required version using the 'latest' version.\n   297\u2192                if not sdk.install_cmdline_tools():\n   298\u2192                    sdk = None\n   299\u2192                    tools.console.warning(\n   300\u2192                        f\"\"\"\n   301\u2192*************************************************************************\n   302\u2192** WARNING: Incompatible Command-Line Tools Version                    **\n   303\u2192*************************************************************************\n   304\u2192\n   305\u2192    The Android SDK specified by {sdk_source_env} at:\n   306\u2192\n   307\u2192    {sdk_root_env}\n   308\u2192\n   309\u2192    does not contain Command-Line Tools version {cls.SDK_MANAGER_VER}. Briefcase requires\n   310\u2192    this version to be installed to use an external Android SDK.\n   311\u2192\n   312\u2192    Use Android Studio's SDK Manager to install Command-Line Tools {cls.SDK_MANAGER_VER}.\n   313\u2192\n   314\u2192    Briefcase will proceed using its own SDK instance.\n   315\u2192\n   316\u2192*************************************************************************\n   317\u2192\"\"\"\n   318\u2192                    )\n   319\u2192            else:\n   320\u2192                tools.console.warning(\n   321\u2192                    f\"\"\"\n   322\u2192*************************************************************************\n   323\u2192** {f\"WARNING: {sdk_source_env} does not point to an Android SDK\":67} **\n   324\u2192*************************************************************************\n   325\u2192\n   326\u2192    The location pointed to by the {sdk_source_env} environment\n   327\u2192    variable:\n   328\u2192\n   329\u2192    {sdk_root_env}\n   330\u2192\n   331\u2192    doesn't appear to contain an Android SDK with the Command-line Tools installed.\n   332\u2192\n   333\u2192    If {sdk_source_env} is an Android SDK, ensure it is the root directory\n   334\u2192    of the Android SDK instance such that\n   335\u2192\n   336\u2192    ${sdk_source_env}{os.sep}{sdk.sdkmanager_path.relative_to(sdk.root_path)}\n   337\u2192\n   338\u2192    is a valid filepath.\n   339\u2192\n   340\u2192    Briefcase will proceed using its own SDK instance.\n   341\u2192\n   342\u2192*************************************************************************\n   343\u2192\"\"\"\n   344\u2192                )\n   345\u2192                sdk = None\n   346\u2192\n   347\u2192        # Verify Briefcase-managed Android SDK\n   348\u2192        if sdk is None:\n   349\u2192            sdk_root_path = tools.base_path / \"android_sdk\"\n   350\u2192            sdk = AndroidSDK(tools=tools, root_path=sdk_root_path)\n   351\u2192\n   352\u2192            if not sdk.exists():\n   353\u2192                if not install:\n   354\u2192                    raise MissingToolError(\"Android SDK\")\n   355\u2192\n   356\u2192                sdk.delete_legacy_sdk_tools()\n   357\u2192\n   358\u2192                if sdk.cmdline_tools_path.parent.exists():\n   359\u2192                    tools.console.info(\"Upgrading Android SDK...\", prefix=cls.name)\n   360\u2192                else:\n   361\u2192                    tools.console.info(\n   362\u2192                        \"The Android SDK was not found; downloading and installing...\",\n   363\u2192                        prefix=cls.name,\n   364\u2192                    )\n   365\u2192                    tools.console.info(\n   366\u2192                        \"To use an existing Android SDK instance, specify its root \"\n   367\u2192                        \"directory path in the ANDROID_HOME environment variable.\"\n   368\u2192                    )\n   369\u2192                    tools.console.info()\n   370\u2192                sdk.install()\n   371\u2192\n   372\u2192        # Licences must be accepted to use the SDK\n   373\u2192        sdk.verify_license()\n   374\u2192\n   375\u2192        tools.console.debug(f\"Using Android SDK at {sdk.root_path}\")\n   376\u2192        tools.android_sdk = sdk\n   377\u2192        return sdk\n   378\u2192\n   379\u2192    def exists(self) -> bool:\n   380\u2192        \"\"\"Confirm that the SDK actually exists.\n   381\u2192\n   382\u2192        Look for the sdkmanager; and, if necessary, confirm that it is executable.\n   383\u2192        \"\"\"\n   384\u2192        return self.sdkmanager_path.is_file() and (\n   385\u2192            self.tools.host_os == \"Windows\"\n   386\u2192            or self.tools.os.access(self.sdkmanager_path, self.tools.os.X_OK)\n   387\u2192        )\n   388\u2192\n   389\u2192    @property\n   390\u2192    def managed_install(self) -> bool:\n   391\u2192        \"\"\"Is the Android SDK install managed by Briefcase?\"\"\"\n   392\u2192        # Although the end-user can provide their own SDK, the SDK also\n   393\u2192        # provides a built-in upgrade mechanism. Therefore, all Android SDKs\n   394\u2192        # are managed installs.\n   395\u2192        return True\n   396\u2192\n   397\u2192    def uninstall(self):\n   398\u2192        \"\"\"The Android SDK is upgraded in-place instead of being reinstalled.\"\"\"\n   399\u2192\n   400\u2192    def install(self):\n   401\u2192        \"\"\"Download and install the Android SDK.\"\"\"\n   402\u2192        cmdline_tools_zip_path = self.tools.file.download(\n   403\u2192            url=self.cmdline_tools_url,\n   404\u2192            download_path=self.tools.base_path,\n   405\u2192            role=\"Android SDK Command-Line Tools\",\n   406\u2192        )\n   407\u2192\n   408\u2192        # The cmdline-tools package *must* be installed as:\n   409\u2192        #     <sdk_path>/cmdline-tools/<cmdline-tools version>\n   410\u2192        #\n   411\u2192        # However, the zip file unpacks a top-level folder named `cmdline-tools`.\n   412\u2192        # So, the unpacking process is:\n   413\u2192        #\n   414\u2192        #  1. Make a <sdk_path>/cmdline-tools folder\n   415\u2192        #  2. Unpack the zip file into that folder, creating <sdk_path>/cmdline-tools/cmdline-tools\n   416\u2192        #  3. Move <sdk_path>/cmdline-tools/cmdline-tools to <sdk_path>/cmdline-tools/<cmdline-tools version>\n   417\u2192\n   418\u2192        with self.tools.console.wait_bar(\n   419\u2192            f\"Installing Android SDK Command-Line Tools {self.SDK_MANAGER_VER}...\"\n   420\u2192        ):\n   421\u2192            self.cmdline_tools_path.parent.mkdir(parents=True, exist_ok=True)\n   422\u2192            try:\n   423\u2192                self.tools.file.unpack_archive(\n   424\u2192                    cmdline_tools_zip_path, extract_dir=self.cmdline_tools_path.parent\n   425\u2192                )\n   426\u2192            except (shutil.ReadError, EOFError) as e:\n   427\u2192                raise BriefcaseCommandError(\n   428\u2192                    f\"\"\"\\\n   429\u2192Unable to unpack Android SDK Command-Line Tools ZIP file. The download may have been interrupted\n   430\u2192or corrupted.\n   431\u2192\n   432\u2192Delete {cmdline_tools_zip_path} and run briefcase again.\n   433\u2192\"\"\"\n   434\u2192                ) from e\n   435\u2192\n   436\u2192            # If there's an existing version of the cmdline tools, delete them.\n   437\u2192            if self.cmdline_tools_path.exists():\n   438\u2192                self.tools.shutil.rmtree(self.cmdline_tools_path)\n   439\u2192\n   440\u2192            # Rename the top level zip content to the final name\n   441\u2192            (self.cmdline_tools_path.parent / \"cmdline-tools\").rename(\n   442\u2192                self.cmdline_tools_path\n   443\u2192            )\n   444\u2192\n   445\u2192            # Zip file no longer needed once unpacked.\n   446\u2192            cmdline_tools_zip_path.unlink()\n   447\u2192\n   448\u2192            # Python zip unpacking ignores permission metadata.\n   449\u2192            # On non-Windows, we manually fix permissions.\n   450\u2192            if (  # pragma: no branch\n   451\u2192                self.tools.host_os != \"Windows\"\n   452\u2192            ):  # pragma: no-cover-if-is-windows\n   453\u2192                for binpath in (self.cmdline_tools_path / \"bin\").glob(\"*\"):\n   454\u2192                    if not self.tools.os.access(binpath, self.tools.os.X_OK):\n   455\u2192                        binpath.chmod(0o755)\n   456\u2192\n   457\u2192        with self.tools.console.wait_bar(\"Removing older Android SDK packages...\"):\n   458\u2192            self.cleanup_old_installs()\n   459\u2192\n   460\u2192    def upgrade(self):\n   461\u2192        \"\"\"Upgrade the Android SDK.\"\"\"\n   462\u2192        try:\n   463\u2192            # Using subprocess.run() with no I/O redirection so the user sees\n   464\u2192            # the full output and can send input.\n   465\u2192            self.tools.subprocess.run(\n   466\u2192                [self.sdkmanager_path, \"--update\"],\n   467\u2192                env=self.env,\n   468\u2192                check=True,\n   469\u2192                stream_output=False,\n   470\u2192            )\n   471\u2192        except subprocess.CalledProcessError as e:\n   472\u2192            raise BriefcaseCommandError(\n   473\u2192                f\"\"\"\\\n   474\u2192Error while updating the Android SDK manager. Please run this command and examine\n   475\u2192its output for errors.\n   476\u2192\n   477\u2192    $ {self.sdkmanager_path} --update\n   478\u2192\"\"\"\n   479\u2192            ) from e\n   480\u2192\n   481\u2192    def install_cmdline_tools(self) -> bool:\n   482\u2192        \"\"\"Attempt to use 'latest' cmdline-tools to install the currently required\n   483\u2192        version of the Command-Line Tools.\n   484\u2192\n   485\u2192        The Briefcase-managed SDK should always have the required version of cmdline-\n   486\u2192        tools installed; however, user-provided SDKs may not have it.\n   487\u2192\n   488\u2192        :returns: True if successfully installed; False otherwise\n   489\u2192        \"\"\"\n   490\u2192        self.tools.console.info(\n   491\u2192            f\"Installing Android Command-Line Tools {self.SDK_MANAGER_VER}...\",\n   492\u2192            prefix=self.full_name,\n   493\u2192        )\n   494\u2192        self.tools.console.info(f\"Using Android SDK at {self.root_path}\")\n   495\u2192        latest_sdkmanager_path = (\n   496\u2192            self.root_path\n   497\u2192            / \"cmdline-tools\"\n   498\u2192            / \"latest\"\n   499\u2192            / \"bin\"\n   500\u2192            / self.sdkmanager_filename\n   501\u2192        )\n   502\u2192        try:\n   503\u2192            self.tools.subprocess.run(\n   504\u2192                [\n   505\u2192                    latest_sdkmanager_path,\n   506\u2192                    f\"cmdline-tools;{self.SDK_MANAGER_VER}\",\n   507\u2192                ],\n   508\u2192                check=True,\n   509\u2192                stream_output=False,\n   510\u2192            )\n   511\u2192        except (OSError, subprocess.CalledProcessError) as e:\n   512\u2192            self.tools.console.debug(str(e))\n   513\u2192            self.tools.console.warning(\n   514\u2192                f\"Failed to install cmdline-tools;{self.SDK_MANAGER_VER}\"\n   515\u2192            )\n   516\u2192            return False\n   517\u2192        return True\n   518\u2192\n   519\u2192    def delete_legacy_sdk_tools(self):\n   520\u2192        \"\"\"Delete any legacy Android SDK tools that are installed.\n   521\u2192\n   522\u2192        If no versions of the Command-Line Tools are installed but the 'tools' directory\n   523\u2192        exists, the legacy SDK Tools are probably installed. Since they have been\n   524\u2192        deprecated by more recent releases of SDK Manager, delete them and perform a\n   525\u2192        fresh install.\n   526\u2192\n   527\u2192        The Android SDK Tools were deprecated in Sept 2017.\n   528\u2192        \"\"\"\n   529\u2192        if (\n   530\u2192            not self.cmdline_tools_path.parent.exists()\n   531\u2192            and (self.root_path / \"tools\").exists()\n   532\u2192        ):\n   533\u2192            self.tools.console.warning(\n   534\u2192                f\"\"\"\n   535\u2192*************************************************************************\n   536\u2192** WARNING: Upgrading Android SDK tools                                **\n   537\u2192*************************************************************************\n   538\u2192\n   539\u2192    Briefcase needs to replace the older Android SDK Tools with the\n   540\u2192    newer Android SDK Command-Line Tools. This will involve some large\n   541\u2192    downloads, as well as re-accepting the licenses for the Android\n   542\u2192    SDKs.\n   543\u2192\n   544\u2192    Any emulators created with the older Android SDK Tools will not be\n   545\u2192    compatible with the new tools. You will need to create new\n   546\u2192    emulators. Old emulators can be removed by deleting the files\n   547\u2192    in {self.avd_path} matching the emulator name.\n   548\u2192\n   549\u2192*************************************************************************\n   550\u2192\"\"\"\n   551\u2192            )\n   552\u2192            self.tools.shutil.rmtree(self.root_path)\n   553\u2192\n   554\u2192    def cleanup_old_installs(self):\n   555\u2192        \"\"\"Remove old versions of Android SDK packages and version markers.\n   556\u2192\n   557\u2192        When the Android SDK is upgraded, old versions of packages should be removed to\n   558\u2192        keep the SDK tidy. This is namely the Command-line Tools that are used to manage\n   559\u2192        the SDK and AVDs. Additionally, previous version of Briefcase created a version\n   560\u2192        marker file that needs to be deleted.\n   561\u2192        \"\"\"\n   562\u2192        if (ver_file := self.cmdline_tools_path.parent / \"8092744\").is_file():\n   563\u2192            self.tools.os.unlink(ver_file)\n   564\u2192        if (latest := self.cmdline_tools_path.parent / \"latest\").is_dir():\n   565\u2192            self.tools.shutil.rmtree(latest)\n   566\u2192\n   567\u2192    def list_packages(self):\n   568\u2192        \"\"\"In debug output, list the packages currently managed by the SDK.\"\"\"\n   569\u2192        try:\n   570\u2192            # check_output always writes its output to debug\n   571\u2192            self.tools.subprocess.check_output(\n   572\u2192                [self.sdkmanager_path, \"--list_installed\"],\n   573\u2192                env=self.env,\n   574\u2192            )\n   575\u2192        except subprocess.CalledProcessError as e:\n   576\u2192            raise BriefcaseCommandError(\n   577\u2192                \"Unable to invoke the Android SDK manager\"\n   578\u2192            ) from e\n   579\u2192\n   580\u2192    def adb(self, device: str) -> ADB:\n   581\u2192        \"\"\"Obtain an ADB instance for managing a specific device.\n   582\u2192\n   583\u2192        :param device: The device ID to manage.\n   584\u2192        \"\"\"\n   585\u2192        return ADB(tools=self.tools, device=device)\n   586\u2192\n   587\u2192    def verify_license(self):\n   588\u2192        \"\"\"Verify that all necessary licenses have been accepted.\n   589\u2192\n   590\u2192        If they haven't, prompt the user to do so.\n   591\u2192\n   592\u2192        Raises an error if licenses are not.\n   593\u2192        \"\"\"\n   594\u2192        license_path = self.root_path / \"licenses/android-sdk-license\"\n   595\u2192        if license_path.exists():\n   596\u2192            return\n   597\u2192\n   598\u2192        self.tools.console.info(\n   599\u2192            \"\"\"\n   600\u2192The Android tools provided by Google have license terms that you must accept\n   601\u2192before you may use those tools.\n   602\u2192\"\"\"\n   603\u2192        )\n   604\u2192        try:\n   605\u2192            # Using subprocess.run() with no I/O redirection so the user sees\n   606\u2192            # the full output and can send input.\n   607\u2192            self.tools.subprocess.run(\n   608\u2192                [self.sdkmanager_path, \"--licenses\"],\n   609\u2192                env=self.env,\n   610\u2192                check=True,\n   611\u2192                stream_output=False,\n   612\u2192            )\n   613\u2192        except (subprocess.CalledProcessError, OSError) as e:\n   614\u2192            raise BriefcaseCommandError(\n   615\u2192                f\"\"\"\\\n   616\u2192Error while reviewing Android SDK licenses. Please run this command and examine\n   617\u2192its output for errors.\n   618\u2192\n   619\u2192    $ {self.sdkmanager_path} --licenses\n   620\u2192\"\"\"\n   621\u2192            ) from e\n   622\u2192\n   623\u2192        if not license_path.exists():\n   624\u2192            raise BriefcaseCommandError(\n   625\u2192                \"\"\"\\\n   626\u2192You did not accept the Android SDK licenses. Please re-run the briefcase command\n   627\u2192and accept the Android SDK license when prompted. You may need an Internet\n   628\u2192connection.\n   629\u2192\"\"\"\n   630\u2192            )\n   631\u2192\n   632\u2192    def verify_emulator(self):\n   633\u2192        \"\"\"Verify that Android emulator has been installed, and is in a runnable state.\n   634\u2192\n   635\u2192        Raises an error if the emulator can't be installed.\n   636\u2192        \"\"\"\n   637\u2192        # Ensure the `platforms` folder exists.\n   638\u2192        # See the discussion on #766 for details; as of June 2022, if this folder\n   639\u2192        # doesn't exist, the emulator won't start, raising the error:\n   640\u2192        #\n   641\u2192        #    PANIC: Cannot find AVD system path. Please define ANDROID_SDK_ROOT\n   642\u2192        #\n   643\u2192        # Creating an empty platforms folder is enough to overcome this. This folder\n   644\u2192        # will be created automatically when you build a project; but if you have a\n   645\u2192        # clean Android SDK install that hasn't been used to build a project, it\n   646\u2192        # might be missing.\n   647\u2192        (self.root_path / \"platforms\").mkdir(exist_ok=True)\n   648\u2192\n   649\u2192        if self.emulator_path.exists():\n   650\u2192            self.tools.console.debug(\"Android emulator is already installed.\")\n   651\u2192            return\n   652\u2192\n   653\u2192        self.tools.console.info(\"Downloading the Android emulator...\")\n   654\u2192        try:\n   655\u2192            self.tools.subprocess.run(\n   656\u2192                [self.sdkmanager_path, \"platform-tools\", \"emulator\"],\n   657\u2192                env=self.env,\n   658\u2192                check=True,\n   659\u2192                stream_output=False,\n   660\u2192            )\n   661\u2192        except subprocess.CalledProcessError as e:\n   662\u2192            raise BriefcaseCommandError(\n   663\u2192                \"Error while installing Android emulator.\"\n   664\u2192            ) from e\n   665\u2192\n   666\u2192    def verify_avd(self, avd: str):\n   667\u2192        \"\"\"Verify that the AVD has the necessary system components to launch.\n   668\u2192\n   669\u2192        This includes:\n   670\u2192            * AVD system image\n   671\u2192            * Emulator skin\n   672\u2192\n   673\u2192        :param avd: The AVD name to verify.\n   674\u2192        \"\"\"\n   675\u2192        # Read the AVD configuration to retrieve the system image.\n   676\u2192        # This is stored in the AVD configuration file with the key:\n   677\u2192        #   image.sysdir.1=system-images/android-31/default/arm64-v8a/\n   678\u2192        avd_config = self.avd_config(avd)\n   679\u2192\n   680\u2192        try:\n   681\u2192            system_image_path = Path(avd_config[\"image.sysdir.1\"])\n   682\u2192\n   683\u2192            # Convert the path into a system image name, and verify it.\n   684\u2192            self.verify_system_image(\";\".join(system_image_path.parts))\n   685\u2192        except KeyError:\n   686\u2192            self.tools.console.warning(\n   687\u2192                f\"\"\"\n   688\u2192*************************************************************************\n   689\u2192** WARNING: Unable to determine AVD system image                       **\n   690\u2192*************************************************************************\n   691\u2192\n   692\u2192    Briefcase was unable to determine the system image of the Android\n   693\u2192    emulator AVD {avd!r} from it's configuration file.\n   694\u2192\n   695\u2192    Briefcase will proceed assuming the emulator is correctly\n   696\u2192    configured. If you experience any problems running the emulator,\n   697\u2192    this may be the cause of the problem.\n   698\u2192\n   699\u2192*************************************************************************\n   700\u2192\"\"\"\n   701\u2192            )\n   702\u2192\n   703\u2192        try:\n   704\u2192            skin = avd_config[\"skin.name\"]\n   705\u2192            skin_path = Path(avd_config[\"skin.path\"])\n   706\u2192            if skin_path == Path(\"_no_skin\"):\n   707\u2192                self.tools.console.debug(\"Emulator does not use a skin.\")\n   708\u2192            elif skin_path != Path(\"skins\") / skin:\n   709\u2192                self.tools.console.warning(\n   710\u2192                    f\"\"\"\n   711\u2192*************************************************************************\n   712\u2192** WARNING: Unrecognized device skin                                   **\n   713\u2192*************************************************************************\n   714\u2192\n   715\u2192    Briefcase does not recognize the skin {skin!r} used by the\n   716\u2192    Android emulator AVD {avd!r}.\n   717\u2192\n   718\u2192    Briefcase will proceed assuming the emulator is correctly\n   719\u2192    configured. If you experience any problems running the emulator,\n   720\u2192    this may be the cause of the problem.\n   721\u2192\n   722\u2192*************************************************************************\n   723\u2192\"\"\"\n   724\u2192                )\n   725\u2192            else:\n   726\u2192                # Convert the path into a system image name, and verify it.\n   727\u2192                self.verify_emulator_skin(skin)\n   728\u2192\n   729\u2192        except KeyError:\n   730\u2192            self.tools.console.debug(f\"Device {avd!r} doesn't define a skin.\")\n   731\u2192\n   732\u2192    def verify_system_image(self, system_image: str):\n   733\u2192        \"\"\"Verify that the required system image is installed.\n   734\u2192\n   735\u2192        :param system_image: The SDKManager identifier for the system image (e.g.,\n   736\u2192            ``\"system-images;android-31;default;x86_64\"``)\n   737\u2192        \"\"\"\n   738\u2192        # Look for the directory named as a system image.\n   739\u2192        # If it exists, we already have the system image.\n   740\u2192        system_image_parts = system_image.split(\";\")\n   741\u2192\n   742\u2192        if len(system_image_parts) < 4 or system_image_parts[0] != \"system-images\":\n   743\u2192            raise BriefcaseCommandError(\n   744\u2192                f\"{system_image!r} is not a valid system image name.\"\n   745\u2192            )\n   746\u2192\n   747\u2192        if system_image_parts[-1] != self.emulator_abi:\n   748\u2192            self.tools.console.warning(\n   749\u2192                f\"\"\"\n   750\u2192*************************************************************************\n   751\u2192** WARNING: Unexpected emulator ABI                                    **\n   752\u2192*************************************************************************\n   753\u2192\n   754\u2192    The system image {system_image!r}\n   755\u2192    does not match the architecture of this computer ({self.emulator_abi}).\n   756\u2192\n   757\u2192    Briefcase will proceed assuming the emulator is correctly\n   758\u2192    configured. If you experience any problems running the emulator,\n   759\u2192    this may be the cause of the problem.\n   760\u2192\n   761\u2192*************************************************************************\n   762\u2192\"\"\"\n   763\u2192            )\n   764\u2192\n   765\u2192        # Convert the system image into a path where that system image\n   766\u2192        # would be expected, and see if the location exists.\n   767\u2192        system_image_path = self.root_path\n   768\u2192        for part in system_image_parts:\n   769\u2192            system_image_path = system_image_path / part\n   770\u2192\n   771\u2192        if system_image_path.exists():\n   772\u2192            # Found the system image.\n   773\u2192            return\n   774\u2192\n   775\u2192        # System image not found; download it.\n   776\u2192        self.tools.console.info(\n   777\u2192            f\"Downloading the {system_image!r} Android system image...\",\n   778\u2192            prefix=self.name,\n   779\u2192        )\n   780\u2192        try:\n   781\u2192            self.tools.subprocess.run(\n   782\u2192                [self.sdkmanager_path, system_image],\n   783\u2192                env=self.env,\n   784\u2192                check=True,\n   785\u2192                stream_output=False,\n   786\u2192            )\n   787\u2192        except subprocess.CalledProcessError as e:\n   788\u2192            raise BriefcaseCommandError(\n   789\u2192                f\"Error while installing the {system_image!r} Android system image.\"\n   790\u2192            ) from e\n   791\u2192\n   792\u2192    def verify_emulator_skin(self, skin: str):\n   793\u2192        \"\"\"Verify that an emulator skin is available.\n   794\u2192\n   795\u2192        A human-readable list of available skins can be found here:\n   796\u2192\n   797\u2192            https://android.googlesource.com/platform/tools/adt/idea/+/refs/heads/mirror-goog-studio-main/artwork/resources/device-art-resources/\n   798\u2192\n   799\u2192        :param skin: The name of the skin to obtain\n   800\u2192        \"\"\"\n   801\u2192        # Check for a device skin. If it doesn't exist, download it.\n   802\u2192        skin_path = self.root_path / \"skins\" / skin\n   803\u2192        if skin_path.exists():\n   804\u2192            self.tools.console.debug(f\"Device skin {skin!r} already exists.\")\n   805\u2192            return\n   806\u2192\n   807\u2192        self.tools.console.info(f\"Obtaining {skin} device skin...\", prefix=self.name)\n   808\u2192\n   809\u2192        skin_url = (\n   810\u2192            \"https://android.googlesource.com/platform/tools/adt/idea/\"\n   811\u2192            \"+archive/refs/heads/mirror-goog-studio-main/\"\n   812\u2192            f\"artwork/resources/device-art-resources/{skin}.tar.gz\"\n   813\u2192        )\n   814\u2192\n   815\u2192        skin_tgz_path = self.tools.file.download(\n   816\u2192            url=skin_url,\n   817\u2192            download_path=self.root_path,\n   818\u2192            role=f\"{skin} device skin\",\n   819\u2192        )\n   820\u2192\n   821\u2192        # Unpack skin archive\n   822\u2192        with self.tools.console.wait_bar(\"Installing device skin...\"):\n   823\u2192            try:\n   824\u2192                self.tools.file.unpack_archive(\n   825\u2192                    skin_tgz_path,\n   826\u2192                    extract_dir=skin_path,\n   827\u2192                )\n   828\u2192            except (shutil.ReadError, EOFError) as e:\n   829\u2192                raise BriefcaseCommandError(\n   830\u2192                    f\"Unable to unpack {skin} device skin.\"\n   831\u2192                ) from e\n   832\u2192\n   833\u2192            # Delete the downloaded file.\n   834\u2192            skin_tgz_path.unlink()\n   835\u2192\n   836\u2192    def emulators(self) -> list[str]:\n   837\u2192        \"\"\"Find the list of emulators that are available.\"\"\"\n   838\u2192        try:\n   839\u2192            emulators = self.tools.subprocess.check_output(\n   840\u2192                [self.emulator_path, \"-list-avds\"]\n   841\u2192            ).strip()\n   842\u2192        except subprocess.CalledProcessError as e:\n   843\u2192            raise BriefcaseCommandError(\"Unable to obtain Android emulator list\") from e\n   844\u2192        else:\n   845\u2192            return [\n   846\u2192                emu\n   847\u2192                for emu in emulators.split(\"\\n\")\n   848\u2192                # ignore any logging output included in output list\n   849\u2192                if emu and not emu.startswith((\"INFO    |\", \"WARNING |\", \"ERROR   |\"))\n   850\u2192            ]\n   851\u2192\n   852\u2192    def devices(self) -> dict[str, dict[str, str | bool]]:\n   853\u2192        \"\"\"Find the devices that are attached and available to ADB.\"\"\"\n   854\u2192        try:\n   855\u2192            output = self.tools.subprocess.check_output(\n   856\u2192                [self.adb_path, \"devices\", \"-l\"]\n   857\u2192            ).strip()\n   858\u2192            # Process the output of `adb devices -l`.\n   859\u2192            # The first line is header information.\n   860\u2192            # Each subsequent line is a single device descriptor.\n   861\u2192            devices = {}\n   862\u2192            header_found = False\n   863\u2192            for line in output.split(\"\\n\"):\n   864\u2192                if line == \"List of devices attached\":\n   865\u2192                    header_found = True\n   866\u2192                elif header_found and line:\n   867\u2192                    parts = re.sub(r\"\\s+\", \" \", line).split(\" \")\n   868\u2192\n   869\u2192                    details = {}\n   870\u2192                    for part in parts[2:]:\n   871\u2192                        try:\n   872\u2192                            key, value = part.split(\":\")\n   873\u2192                            details[key] = value\n   874\u2192                        except ValueError:\n   875\u2192                            # Ignore any entry that isn't in \"key:value\" format.\n   876\u2192                            pass\n   877\u2192\n   878\u2192                    if parts[1] == \"device\":\n   879\u2192                        try:\n   880\u2192                            name = details[\"model\"].replace(\"_\", \" \")\n   881\u2192                        except KeyError:\n   882\u2192                            name = \"Unknown device (no model name)\"\n   883\u2192                        authorized = True\n   884\u2192                    elif parts[1] == \"offline\":\n   885\u2192                        name = \"Unknown device (offline)\"\n   886\u2192                        authorized = False\n   887\u2192                    else:\n   888\u2192                        name = f\"Device not available for development ({' '.join(parts[1:])})\"\n   889\u2192                        authorized = False\n   890\u2192\n   891\u2192                    devices[parts[0]] = {\n   892\u2192                        \"name\": name,\n   893\u2192                        \"authorized\": authorized,\n   894\u2192                    }\n   895\u2192\n   896\u2192            return devices\n   897\u2192        except subprocess.CalledProcessError as e:\n   898\u2192            raise BriefcaseCommandError(\"Unable to obtain Android device list\") from e\n   899\u2192\n   900\u2192    def select_target_device(\n   901\u2192        self,\n   902\u2192        device_or_avd: str | None,\n   903\u2192    ) -> tuple[str | None, str | None, str | None]:\n   904\u2192        \"\"\"Select a device to be the target for actions.\n   905\u2192\n   906\u2192        Interrogates the system to get the list of available devices.\n   907\u2192\n   908\u2192        If the user has specified a device at the command line, that device will\n   909\u2192        be validated, and then automatically selected.\n   910\u2192\n   911\u2192        :param device_or_avd: The device or AVD to target. Can be a physical\n   912\u2192            device id (a hex string), an emulator id (``emulator-5554``), or an\n   913\u2192            emulator AVD name (``@robotfriend``), or a JSON payload describing\n   914\u2192            the properties of an emulator that will be created (e.g.,\n   915\u2192            ``'{\"avd\":\"beePhone\",\"device_type\":\"pixel\",\"skin\":\"pixel_3a\",\"system_image\":\"system-images;android-31;default;arm64-v8a\"}'``)\n   916\u2192            If ``None``, the user will be asked to select a device from the list\n   917\u2192            available.\n   918\u2192        :returns: A tuple containing ``(device, name, avd)``. ``avd`` will only\n   919\u2192            be provided if an emulator with that AVD is not currently running.\n   920\u2192            If ``device`` is None, a new emulator should be created.\n   921\u2192        \"\"\"\n   922\u2192        # If the device_or_avd starts with \"{\", it's a definition for a new\n   923\u2192        # emulator to be created.\n   924\u2192        if device_or_avd and device_or_avd.startswith(\"{\"):\n   925\u2192            try:\n   926\u2192                emulator_config = json.loads(device_or_avd)\n   927\u2192                emulators = set(self.emulators())\n   928\u2192\n   929\u2192                # If an emulator with this AVD already exists, use it\n   930\u2192                avd = emulator_config[\"avd\"]\n   931\u2192                if avd not in emulators:\n   932\u2192                    self._create_emulator(**emulator_config)\n   933\u2192\n   934\u2192                return None, f\"@{avd} (emulator)\", avd\n   935\u2192            except json.JSONDecodeError as e:\n   936\u2192                raise BriefcaseCommandError(\n   937\u2192                    f\"Unable to create emulator with definition {device_or_avd!r}\"\n   938\u2192                ) from e\n   939\u2192            except KeyError:\n   940\u2192                raise BriefcaseCommandError(\"No AVD provided for new device.\")\n   941\u2192            except TypeError as e:\n   942\u2192                property = str(e).split(\" \")[-1]\n   943\u2192                raise BriefcaseCommandError(f\"Unknown device property {property}.\")\n   944\u2192\n   945\u2192        # Get the list of attached devices (includes running emulators)\n   946\u2192        running_devices = self.devices()\n   947\u2192\n   948\u2192        # Choices is an ordered list of options that can be shown to the user.\n   949\u2192        # Each device should appear only once, and be keyed by AVD only if\n   950\u2192        # a device ID isn't available.\n   951\u2192        choices = {}\n   952\u2192        # A full index of available devices. Devices can be looked up by any valid key -\n   953\u2192        # ID *or* AVD.\n   954\u2192        device_index = {}\n   955\u2192\n   956\u2192        # Iterate over all the running devices.\n   957\u2192        # If the device is a virtual device, use ADB to get the emulator AVD name.\n   958\u2192        # If it is a physical device, use the device name.\n   959\u2192        # Keep a log of all running AVDs\n   960\u2192        running_avds = {}\n   961\u2192        for d, details in sorted(running_devices.items(), key=lambda d: d[1][\"name\"]):\n   962\u2192            name = details[\"name\"]\n   963\u2192            avd = self.adb(d).avd_name()\n   964\u2192            if avd:\n   965\u2192                # It's a running emulator\n   966\u2192                running_avds[avd] = d\n   967\u2192                full_name = f\"@{avd} (running emulator)\"\n   968\u2192                choices[d] = full_name\n   969\u2192\n   970\u2192                # Save the AVD as a device detail.\n   971\u2192                details[\"avd\"] = avd\n   972\u2192\n   973\u2192                # Device can be looked up by device ID or AVD\n   974\u2192                device_index[d] = full_name\n   975\u2192                device_index[f\"@{avd}\"] = full_name\n   976\u2192            else:\n   977\u2192                # It's a physical device (might be disabled)\n   978\u2192                full_name = f\"{name} ({d})\"\n   979\u2192                choices[d] = full_name\n   980\u2192                device_index[d] = full_name\n   981\u2192\n   982\u2192        # Add any non-running emulator AVDs to the list of candidate devices\n   983\u2192        for avd in self.emulators():\n   984\u2192            if avd not in running_avds:\n   985\u2192                name = f\"@{avd} (emulator)\"\n   986\u2192                choices[f\"@{avd}\"] = name\n   987\u2192                device_index[f\"@{avd}\"] = name\n   988\u2192\n   989\u2192        # If a device or AVD has been provided, check it against the available\n   990\u2192        # device list.\n   991\u2192        if device_or_avd:\n   992\u2192            try:\n   993\u2192                name = device_index[device_or_avd]\n   994\u2192\n   995\u2192                if device_or_avd.startswith(\"@\"):\n   996\u2192                    # specifier is an AVD\n   997\u2192                    avd = device_or_avd[1:]\n   998\u2192                    try:\n   999\u2192                        device = running_avds[avd]\n  1000\u2192                    except KeyError:\n  1001\u2192                        # device_or_avd isn't in the list of running avds;\n  1002\u2192                        # it must be a non-running emulator.\n  1003\u2192                        return None, name, avd\n  1004\u2192                else:\n  1005\u2192                    # Specifier is a direct device ID\n  1006\u2192                    device = device_or_avd\n  1007\u2192\n  1008\u2192                details = running_devices[device]\n  1009\u2192                avd = details.get(\"avd\")\n  1010\u2192                if details[\"authorized\"]:\n  1011\u2192                    # An authorized, running device (emulator or physical)\n  1012\u2192                    return device, name, avd\n  1013\u2192                else:\n  1014\u2192                    # An unauthorized physical device\n  1015\u2192                    raise AndroidDeviceNotAuthorized(device)\n  1016\u2192\n  1017\u2192            except KeyError as e:\n  1018\u2192                # Provided device_or_id isn't a valid device identifier.\n  1019\u2192                id_type = (\n  1020\u2192                    \"emulator AVD\" if device_or_avd.startswith(\"@\") else \"device ID\"\n  1021\u2192                )\n  1022\u2192                raise InvalidDeviceError(id_type, device_or_avd) from e\n  1023\u2192        # We weren't given a device/AVD; we have to select from the list.\n  1024\u2192        # If we're selecting from a list, there's always one last choice\n  1025\u2192        choices[\"-\"] = \"Create a new Android emulator\"\n  1026\u2192\n  1027\u2192        # Show the choices to the user.\n  1028\u2192        try:\n  1029\u2192            choice = self.tools.console.selection_question(\n  1030\u2192                intro=\"Select Android device to use:\",\n  1031\u2192                description=\"Android device\",\n  1032\u2192                options=choices,\n  1033\u2192            )\n  1034\u2192        except InputDisabled as e:\n  1035\u2192            # If input is disabled, and there's only one actual simulator