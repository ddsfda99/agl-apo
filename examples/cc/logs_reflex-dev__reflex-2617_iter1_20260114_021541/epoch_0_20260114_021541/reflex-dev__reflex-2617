                        "content": "     1\u2192\"\"\"Define a state var.\"\"\"\n     2\u2192from __future__ import annotations\n     3\u2192\n     4\u2192import contextlib\n     5\u2192import dataclasses\n     6\u2192import dis\n     7\u2192import inspect\n     8\u2192import json\n     9\u2192import random\n    10\u2192import re\n    11\u2192import string\n    12\u2192import sys\n    13\u2192from types import CodeType, FunctionType\n    14\u2192from typing import (\n    15\u2192    TYPE_CHECKING,\n    16\u2192    Any,\n    17\u2192    Callable,\n    18\u2192    Dict,\n    19\u2192    Iterable,\n    20\u2192    List,\n    21\u2192    Literal,\n    22\u2192    Optional,\n    23\u2192    Set,\n    24\u2192    Tuple,\n    25\u2192    Type,\n    26\u2192    Union,\n    27\u2192    _GenericAlias,  # type: ignore\n    28\u2192    cast,\n    29\u2192    get_args,\n    30\u2192    get_origin,\n    31\u2192    get_type_hints,\n    32\u2192)\n    33\u2192\n    34\u2192import pydantic\n    35\u2192\n    36\u2192from reflex import constants\n    37\u2192from reflex.base import Base\n    38\u2192from reflex.utils import console, format, imports, serializers, types\n    39\u2192\n    40\u2192# This module used to export ImportVar itself, so we still import it for export here\n    41\u2192from reflex.utils.imports import ImportDict, ImportVar\n    42\u2192\n    43\u2192if TYPE_CHECKING:\n    44\u2192    from reflex.state import BaseState\n    45\u2192\n    46\u2192# Set of unique variable names.\n    47\u2192USED_VARIABLES = set()\n    48\u2192\n    49\u2192# Supported operators for all types.\n    50\u2192ALL_OPS = [\"==\", \"!=\", \"!==\", \"===\", \"&&\", \"||\"]\n    51\u2192# Delimiters used between function args or operands.\n    52\u2192DELIMITERS = [\",\"]\n    53\u2192# Mapping of valid operations for different type combinations.\n    54\u2192OPERATION_MAPPING = {\n    55\u2192    (int, int): {\n    56\u2192        \"+\",\n    57\u2192        \"-\",\n    58\u2192        \"/\",\n    59\u2192        \"//\",\n    60\u2192        \"*\",\n    61\u2192        \"%\",\n    62\u2192        \"**\",\n    63        \">\",\n    64\u2192        \"<\",\n    65\u2192        \"<=\",\n    66\u2192        \">=\",\n    67\u2192        \"|\",\n    68\u2192        \"&\",\n    69\u2192    },\n    70\u2192    (int, str): {\"*\"},\n    71\u2192    (int, list): {\"*\"},\n    72\u2192    (str, str): {\"+\", \">\", \"<\", \"<=\", \">=\"},\n    73\u2192    (float, float): {\"+\", \"-\", \"/\", \"//\", \"*\", \"%\", \"**\", \">\", \"<\", \"<=\", \">=\"},\n    74\u2192    (float, int): {\"+\", \"-\", \"/\", \"//\", \"*\", \"%\", \"**\", \">\", \"<\", \"<=\", \">=\"},\n    75\u2192    (list, list): {\"+\", \">\", \"<\", \"<=\", \">=\"},\n    76\u2192}\n    77\u2192\n    78\u2192# These names were changed in reflex 0.3.0\n    79\u2192REPLACED_NAMES = {\n    80\u2192    \"full_name\": \"_var_full_name\",\n    81\u2192    \"name\": \"_var_name\",\n    82\u2192    \"state\": \"_var_data.state\",\n    83\u2192    \"type_\": \"_var_type\",\n    84\u2192    \"is_local\": \"_var_is_local\",\n    85\u2192    \"is_string\": \"_var_is_string\",\n    86\u2192    \"set_state\": \"_var_set_state\",\n    87\u2192    \"deps\": \"_deps\",\n    88\u2192}\n    89\u2192\n    90\u2192PYTHON_JS_TYPE_MAP = {\n    91\u2192    (int, float): \"number\",\n    92\u2192    (str,): \"string\",\n    93\u2192    (bool,): \"boolean\",\n    94\u2192    (list, tuple): \"Array\",\n    95\u2192    (dict,): \"Object\",\n    96\u2192    (None,): \"null\",\n    97\u2192}\n    98\u2192\n    99\u2192\n   100\u2192def get_unique_variable_name() -> str:\n   101\u2192    \"\"\"Get a unique variable name.\n   102\u2192\n   103\u2192    Returns:\n   104\u2192        The unique variable name.\n   105\u2192    \"\"\"\n   106\u2192    name = \"\".join([random.choice(string.ascii_lowercase) for _ in range(8)])\n   107\u2192    if name not in USED_VARIABLES:\n   108\u2192        USED_VARIABLES.add(name)\n   109\u2192        return name\n   110\u2192    return get_unique_variable_name()\n   111\u2192\n   112\u2192\n   113\u2192class VarData(Base):\n   114\u2192    \"\"\"Metadata associated with a Var.\"\"\"\n   115\u2192\n   116\u2192    # The name of the enclosing state.\n   117\u2192    state: str = \"\"\n   118\u2192\n   119\u2192    # Imports needed to render this var\n   120\u2192    imports: ImportDict = {}\n   121\u2192\n   122\u2192    # Hooks that need to be present in the component to render this var\n   123\u2192    hooks: Set[str] = set()\n   124\u2192\n   125\u2192    @classmethod\n   126\u2192    def merge(cls, *others: VarData | None) -> VarData | None:\n   127\u2192        \"\"\"Merge multiple var data objects.\n   128\u2192\n   129\u2192        Args:\n   130\u2192            *others: The var data objects to merge.\n   131\u2192\n   132\u2192        Returns:\n   133\u2192            The merged var data object.\n   134\u2192        \"\"\"\n   135\u2192        state = \"\"\n   136\u2192        _imports = {}\n   137\u2192        hooks = set()\n   138\u2192        for var_data in others:\n   139\u2192            if var_data is None:\n   140\u2192                continue\n   141\u2192            state = state or var_data.state\n   142\u2192            _imports = imports.merge_imports(_imports, var_data.imports)\n   143\u2192            hooks.update(var_data.hooks)\n   144\u2192        return (\n   145\u2192            cls(\n   146\u2192                state=state,\n   147\u2192                imports=_imports,\n   148\u2192                hooks=hooks,\n   149\u2192            )\n   150\u2192            or None\n   151\u2192        )\n   152\u2192\n   153\u2192    def __bool__(self) -> bool:\n   154\u2192        \"\"\"Check if the var data is non-empty.\n   155\u2192\n   156\u2192        Returns:\n   157\u2192            True if any field is set to a non-default value.\n   158\u2192        \"\"\"\n   159\u2192        return bool(self.state or self.imports or self.hooks)\n   160\u2192\n   161\u2192    def __eq__(self, other: Any) -> bool:\n   162\u2192        \"\"\"Check if two var data objects are equal.\n   163\u2192\n   164\u2192        Args:\n   165\u2192            other: The other var data object to compare.\n   166\u2192\n   167\u2192        Returns:\n   168\u2192            True if all fields are equal and collapsed imports are equal.\n   169\u2192        \"\"\"\n   170\u2192        if not isinstance(other, VarData):\n   171\u2192            return False\n   172\u2192        return (\n   173\u2192            self.state == other.state\n   174\u2192            and self.hooks == other.hooks\n   175\u2192            and imports.collapse_imports(self.imports)\n   176\u2192            == imports.collapse_imports(other.imports)\n   177\u2192        )\n   178\u2192\n   179\u2192    def dict(self) -> dict:\n   180\u2192        \"\"\"Convert the var data to a dictionary.\n   181\u2192\n   182\u2192        Returns:\n   183\u2192            The var data dictionary.\n   184\u2192        \"\"\"\n   185\u2192        return {\n   186\u2192            \"state\": self.state,\n   187\u2192            \"imports\": {\n   188\u2192                lib: [import_var.dict() for import_var in import_vars]\n   189\u2192                for lib, import_vars in self.imports.items()\n   190\u2192            },\n   191\u2192            \"hooks\": list(self.hooks),\n   192\u2192        }\n   193\u2192\n   194\u2192\n   195\u2192def _encode_var(value: Var) -> str:\n   196\u2192    \"\"\"Encode the state name into a formatted var.\n   197\u2192\n   198\u2192    Args:\n   199\u2192        value: The value to encode the state name into.\n   200\u2192\n   201\u2192    Returns:\n   202\u2192        The encoded var.\n   203\u2192    \"\"\"\n   204\u2192    if value._var_data:\n   205\u2192        return (\n   206\u2192            f\"{constants.REFLEX_VAR_OPENING_TAG}{value._var_data.json()}{constants.REFLEX_VAR_CLOSING_TAG}\"\n   207\u2192            + str(value)\n   208\u2192        )\n   209\u2192    return str(value)\n   210\u2192\n   211\u2192\n   212\u2192def _decode_var(value: str) -> tuple[VarData | None, str]:\n   213\u2192    \"\"\"Decode the state name from a formatted var.\n   214\u2192\n   215\u2192    Args:\n   216\u2192        value: The value to extract the state name from.\n   217\u2192\n   218\u2192    Returns:\n   219\u2192        The extracted state name and the value without the state name.\n   220\u2192    \"\"\"\n   221\u2192    var_datas = []\n   222\u2192    if isinstance(value, str):\n   223\u2192        # Extract the state name from a formatted var\n   224\u2192        while m := re.match(\n   225\u2192            pattern=rf\"(.*){constants.REFLEX_VAR_OPENING_TAG}(.*){constants.REFLEX_VAR_CLOSING_TAG}(.*)\",\n   226\u2192            string=value,\n   227\u2192            flags=re.DOTALL,  # Ensure . matches newline characters.\n   228\u2192        ):\n   229\u2192            value = m.group(1) + m.group(3)\n   230\u2192            try:\n   231\u2192                var_datas.append(VarData.parse_raw(m.group(2)))\n   232\u2192            except pydantic.ValidationError:\n   233\u2192                # If the VarData is invalid, it was probably json-encoded twice...\n   234\u2192                var_datas.append(VarData.parse_raw(json.loads(f'\"{m.group(2)}\"')))\n   235\u2192    if var_datas:\n   236\u2192        return VarData.merge(*var_datas), value\n   237\u2192    return None, value\n   238\u2192\n   239\u2192\n   240\u2192def _extract_var_data(value: Iterable) -> list[VarData | None]:\n   241\u2192    \"\"\"Extract the var imports and hooks from an iterable containing a Var.\n   242\u2192\n   243\u2192    Args:\n   244\u2192        value: The iterable to extract the VarData from\n   245\u2192\n   246\u2192    Returns:\n   247\u2192        The extracted VarDatas.\n   248\u2192    \"\"\"\n   249\u2192    from reflex.style import Style\n   250\u2192\n   251\u2192    var_datas = []\n   252\u2192    with contextlib.suppress(TypeError):\n   253\u2192        for sub in value:\n   254\u2192            if isinstance(sub, Var):\n   255\u2192                var_datas.append(sub._var_data)\n   256\u2192            elif not isinstance(sub, str):\n   257\u2192                # Recurse into dict values.\n   258\u2192                if hasattr(sub, \"values\") and callable(sub.values):\n   259\u2192                    var_datas.extend(_extract_var_data(sub.values()))\n   260\u2192                # Recurse into iterable values (or dict keys).\n   261\u2192                var_datas.extend(_extract_var_data(sub))\n   262\u2192\n   263\u2192    # Style objects should already have _var_data.\n   264\u2192    if isinstance(value, Style):\n   265\u2192        var_datas.append(value._var_data)\n   266\u2192    else:\n   267\u2192        # Recurse when value is a dict itself.\n   268\u2192        values = getattr(value, \"values\", None)\n   269\u2192        if callable(values):\n   270\u2192            var_datas.extend(_extract_var_data(values()))\n   271\u2192    return var_datas\n   272\u2192\n   273\u2192\n   274\u2192class Var:\n   275\u2192    \"\"\"An abstract var.\"\"\"\n   276\u2192\n   277\u2192    # The name of the var.\n   278\u2192    _var_name: str\n   279\u2192\n   280\u2192    # The type of the var.\n   281\u2192    _var_type: Type\n   282\u2192\n   283\u2192    # Whether this is a local javascript variable.\n   284\u2192    _var_is_local: bool\n   285\u2192\n   286\u2192    # Whether the var is a string literal.\n   287\u2192    _var_is_string: bool\n   288\u2192\n   289\u2192    # _var_full_name should be prefixed with _var_state\n   290\u2192    _var_full_name_needs_state_prefix: bool\n   291\u2192\n   292\u2192    # Extra metadata associated with the Var\n   293\u2192    _var_data: Optional[VarData]\n   294\u2192\n   295\u2192    @classmethod\n   296\u2192    def create(\n   297\u2192        cls, value: Any, _var_is_local: bool = True, _var_is_string: bool = False\n   298\u2192    ) -> Var | None:\n   299\u2192        \"\"\"Create a var from a value.\n   300\u2192\n   301\u2192        Args:\n   302\u2192            value: The value to create the var from.\n   303\u2192            _var_is_local: Whether the var is local.\n   304\u2192            _var_is_string: Whether the var is a string literal.\n   305\u2192\n   306\u2192        Returns:\n   307\u2192            The var.\n   308\u2192\n   309\u2192        Raises:\n   310\u2192            TypeError: If the value is JSON-unserializable.\n   311\u2192        \"\"\"\n   312\u2192        # Check for none values.\n   313\u2192        if value is None:\n   314\u2192            return None\n   315\u2192\n   316\u2192        # If the value is already a var, do nothing.\n   317\u2192        if isinstance(value, Var):\n   318\u2192            return value\n   319\u2192\n   320\u2192        # Try to pull the imports and hooks from contained values.\n   321\u2192        _var_data = None\n   322\u2192        if not isinstance(value, str):\n   323\u2192            _var_data = VarData.merge(*_extract_var_data(value))\n   324\u2192\n   325\u2192        # Try to serialize the value.\n   326\u2192        type_ = type(value)\n   327\u2192        name = value if type_ in types.JSONType else serializers.serialize(value)\n   328\u2192        if name is None:\n   329\u2192            raise TypeError(\n   330\u2192                f\"No JSON serializer found for var {value} of type {type_}.\"\n   331\u2192            )\n   332\u2192        name = name if isinstance(name, str) else format.json_dumps(name)\n   333\u2192\n   334\u2192        return BaseVar(\n   335\u2192            _var_name=name,\n   336\u2192            _var_type=type_,\n   337\u2192            _var_is_local=_var_is_local,\n   338\u2192            _var_is_string=_var_is_string,\n   339\u2192            _var_data=_var_data,\n   340\u2192        )\n   341\u2192\n   342\u2192    @classmethod\n   343\u2192    def create_safe(\n   344\u2192        cls, value: Any, _var_is_local: bool = True, _var_is_string: bool = False\n   345\u2192    ) -> Var:\n   346\u2192        \"\"\"Create a var from a value, asserting that it is not None.\n   347\u2192\n   348\u2192        Args:\n   349\u2192            value: The value to create the var from.\n   350\u2192            _var_is_local: Whether the var is local.\n   351\u2192            _var_is_string: Whether the var is a string literal.\n   352\u2192\n   353\u2192        Returns:\n   354\u2192            The var.\n   355\u2192        \"\"\"\n   356\u2192        var = cls.create(\n   357\u2192            value,\n   358\u2192            _var_is_local=_var_is_local,\n   359\u2192            _var_is_string=_var_is_string,\n   360\u2192        )\n   361\u2192        assert var is not None\n   362\u2192        return var\n   363\u2192\n   364\u2192    @classmethod\n   365\u2192    def __class_getitem__(cls, type_: str) -> _GenericAlias:\n   366\u2192        \"\"\"Get a typed var.\n   367\u2192\n   368\u2192        Args:\n   369\u2192            type_: The type of the var.\n   370\u2192\n   371\u2192        Returns:\n   372\u2192            The var class item.\n   373\u2192        \"\"\"\n   374\u2192        return _GenericAlias(cls, type_)\n   375\u2192\n   376\u2192    def __post_init__(self) -> None:\n   377\u2192        \"\"\"Post-initialize the var.\"\"\"\n   378\u2192        # Decode any inline Var markup and apply it to the instance\n   379\u2192        _var_data, _var_name = _decode_var(self._var_name)\n   380\u2192        if _var_data:\n   381\u2192            self._var_name = _var_name\n   382\u2192            self._var_data = VarData.merge(self._var_data, _var_data)\n   383\u2192\n   384\u2192    def _replace(self, merge_var_data=None, **kwargs: Any) -> Var:\n   385\u2192        \"\"\"Make a copy of this Var with updated fields.\n   386\u2192\n   387\u2192        Args:\n   388\u2192            merge_var_data: VarData to merge into the existing VarData