lf._var_name, str(self._var_type)))\n   479\u2192\n   480\u2192    def __str__(self) -> str:\n   481\u2192        \"\"\"Wrap the var so it can be used in templates.\n   482\u2192\n   483\u2192        Returns:\n   484\u2192            The wrapped var, i.e. {state.var}.\n   485\u2192        \"\"\"\n   486\u2192        out = (\n   487\u2192            self._var_full_name\n   488\u2192            if self._var_is_local\n   489\u2192            else format.wrap(self._var_full_name, \"{\")\n   490\u2192        )\n   491\u2192        if self._var_is_string:\n   492\u2192            out = format.format_string(out)\n   493\u2192        return out\n   494\u2192\n   495\u2192    def __bool__(self) -> bool:\n   496\u2192        \"\"\"Raise exception if using Var in a boolean context.\n   497\u2192\n   498\u2192        Raises:\n   499\u2192            TypeError: when attempting to bool-ify the Var.\n   500\u2192        \"\"\"\n   501\u2192        raise TypeError(\n   502\u2192            f\"Cannot convert Var {self._var_full_name!r} to bool for use with `if`, `and`, `or`, and `not`. \"\n   503\u2192            \"Instead use `rx.cond` and bitwise operators `&` (and), `|` (or), `~` (invert).\"\n   504\u2192        )\n   505\u2192\n   506\u2192    def __iter__(self) -> Any:\n   507\u2192        \"\"\"Raise exception if using Var in an iterable context.\n   508\u2192\n   509\u2192        Raises:\n   510\u2192            TypeError: when attempting to iterate over the Var.\n   511\u2192        \"\"\"\n   512\u2192        raise TypeError(\n   513\u2192            f\"Cannot iterate over Var {self._var_full_name!r}. Instead use `rx.foreach`.\"\n   514\u2192        )\n   515\u2192\n   516\u2192    def __format__(self, format_spec: str) -> str:\n   517\u2192        \"\"\"Format the var into a Javascript equivalent to an f-string.\n   518\u2192\n   519\u2192        Args:\n   520\u2192            format_spec: The format specifier (Ignored for now).\n   521\u2192\n   522\u2192        Returns:\