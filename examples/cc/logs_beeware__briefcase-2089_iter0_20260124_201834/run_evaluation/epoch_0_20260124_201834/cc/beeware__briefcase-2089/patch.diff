+    def input_console_app(self, override_value: str | None) -> bool:
+        """Ask if the existing app is a console app.
+
+        Console apps write output directly to stdout/stderr and require
+        ``console_app = true`` in the Briefcase configuration.
+
+        :returns: True if the app is a console app; False otherwise.
+        """
+        selection = self.select_option(
+            intro=(
+                "Is the existing application a console app?\n\n"
+                "Console apps write output directly to the terminal (stdout/stderr) and "
+                "require 'console_app = true' in pyproject.toml."
+            ),
+            variable="Console app",
+            default="No",
+            options=["No", "Yes"],
+            override_value=override_value,
+        )
+        return selection == "Yes"
