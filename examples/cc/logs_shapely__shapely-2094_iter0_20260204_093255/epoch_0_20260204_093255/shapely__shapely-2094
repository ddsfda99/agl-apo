e([None, geometry])\n   546→    assert result[0] is None\n   547→    assert_geometries_equal(result[1], expected)\n   548→\n   549→\n   550→@pytest.mark.parametrize(\"geom\", [\"Not a geometry\", 1])\n   551→def test_reverse_invalid_type(geom):\n   552→    with pytest.raises(TypeError, match=\"One of the arguments is of incorrect type\"):\n   553→        shapely.reverse(geom)\n   554→\n   555→\n   556→@pytest.mark.parametrize(\n   557→    \"geom,expected\",\n   558→    [\n   559→        # Point outside\n   560→        (Point(0, 0), GeometryCollection()),\n   561→        # Point inside\n   562→        (Point(15, 15), Point(15, 15)),\n   563→        # Point on boundary\n   564→        (Point(15, 10), GeometryCollection()),\n   565→        # Line outside\n   566→        (LineString([(0, 0), (-5, 5)]), GeometryCollection()),\n   567→        # Line inside\n   568→        (LineString([(15, 15), (16, 15)]), LineString([(15, 15), (16, 15)])),\n   569→        # Line on boundary\n   570→        (LineString([(10, 15), (10, 10), (15, 10)]), GeometryCollection()),\n   571→        # Line splitting rectangle\n   572→        (LineString([(10, 5), (25, 20)]), LineString([(15, 10), (20, 15)])),\n   573→    ],\n   574→)\n   575→def test_clip_by_rect(geom, expected):\n   576→    actual = shapely.clip_by_rect(geom, 10, 10, 20, 20)\n   577→    assert_geometries_equal(actual, expected)\n   578→\n   579→\n   580→@pytest.mark.parametrize(\n   581→    \"geom, rect, expected\",\n   582→    [\n   583→        # Polygon hole (CCW) fully on rectangle boundary\"\"\"\n   584→        (\n   585→            Polygon(\n   586→                ((0, 0), (0, 30), (30, 30), (30, 0), (0, 0)),\n   587→                holes=[((10, 10), (20, 10), (20, 20), (10, 20), (10, 10))],\n   588→            ),\n   589→            (10, 10, 20, 20),\n   590→            GeometryCollection(),\n   591→        ),\n   592→        # Polygon hole (CW) fully on rectangle boundary\"\"\"\n   593→        (\n   594→            Polygon(\n   595→                ((0, 0), (0, 30), (30, 30), (30, 0), (0, 0)),\n   596→                holes=[((10, 10), (10, 20), (20, 20), (20, 10), (10, 10))],\n   597→            ),\n   598→            (10, 10, 20, 20),\n   599→            GeometryCollection(),\n   600→        ),\n   601→        # Polygon fully within rectangle\"\"\"\n   602→        (\n   603→            Polygon(\n   604→                ((1, 1), (1, 30), (30, 30), (30, 1), (1, 1)),\n   605→                holes=[((10, 10), (20, 10), (20, 20), (10, 20), (10, 10))],\n   606→            ),\n   607→            (0, 0, 40, 40),\n   608→            Polygon(\n   609→                ((1, 1), (1, 30), (30, 30), (30, 1), (1, 1)),\n   610→                holes=[((10, 10), (20, 10), (20, 20), (10, 20), (10, 10))],\n   611→            ),\n   612→        ),\n   613→        # Polygon overlapping rectanglez\n   614→        (\n   615→            Polygon(\n   616→                [(0, 0), (0, 30), (30, 30), (30, 0), (0, 0)],\n   617→                holes=[[(10, 10), (20, 10), (20, 20), (10, 20), (10, 10)]],\n   618→            ),\n   619→            (5, 5, 15, 15),\n   620→            Polygon([(5, 5), (5, 15), (10, 15), (10, 10), (15, 10), (15, 5), (5, 5)]),\n   621→        ),\n   622→    ],\n   623→)\n   624→def test_clip_by_rect_polygon(geom, rect, expected):\n   625→    actual = shapely.clip_by_rect(geom, *rect)\n   626→    assert_geometries_equal(actual, expected)\n   627→\n   628→\n   629→@pytest.mark.parametrize(\"geometry\", all_types)\n   630→def test_clip_by_rect_array(geometry):\n   631→    if (\n   632→        geometry.is_empty\n   633→        and shapely.get_type_id(geometry) == 0\n   634→        and shapely.geos_version < (3, 9, 5)\n   635→    ):\n   636→        # GEOS GH-913\n   637→        with pytest.raises(GEOSException):\n   638→            shapely.clip_by_rect([geometry, geometry], 0.0, 0.0, 1.0, 1.0)\n   639→        return\n   640→    actual = shapely.clip_by_rect([geometry, geometry], 0.0, 0.0, 1.0, 1.0)\n   641→    assert actual.shape == (2,)\n   642→    assert actual[0] is None or isinstance(actual[0], Geometry)\n   643→\n   644→\n   645→def test_clip_by_rect_missing():\n   646→    actual = shapely.clip_by_rect(None, 0, 0, 1, 1)\n   647→    assert actual is None\n   648→\n   649→\n   650→@pytest.mark.parametrize(\"geom\", [empty, empty_line_string, empty_polygon])\n   651→def test_clip_by_rect_empty(geom):\n   652→    # TODO empty point\n   653→    actual = shapely.clip_by_rect(geom, 0, 0, 1, 1)\n   654→    assert actual == GeometryCollection()\n   655→\n   656→\n   657→def test_clip_by_rect_non_scalar_kwargs():\n   658→    msg = \"only accepts scalar values\"\n   659→    with pytest.raises(TypeError, match=msg):\n   660→        shapely.clip_by_rect([line_string, line_string], 0, 0, 1, np.array([0, 1]))\n   661→\n   662→\n   663→def test_polygonize():\n   664→    lines = [\n   665→        LineString([(0, 0), (1, 1)]),\n   666→        LineString([(0, 0), (0, 1)]),\n   667→        LineString([(0, 1), (1, 1)]),\n   668→        LineString([(1, 1), (1, 0)]),\n   669→        LineString([(1, 0), (0, 0)]),\n   670→        LineString([(5, 5), (6, 6)]),\n   671→        Point(0, 0),\n   672→        None,\n   673→    ]\n   674→    result = shapely.polygonize(lines)\n   675→    assert shapely.get_type_id(result) == 7  # GeometryCollection\n   676→    expected = GeometryCollection(\n   677→        [\n   678→            Polygon([(0, 0), (1, 1), (1, 0), (0, 0)]),\n   679→            Polygon([(1, 1), (0, 0), (0, 1), (1, 1)]),\n   680→        ]\n   681→    )\n   682→    assert result == expected\n   683→\n   684→\n   685→def test_polygonize_array():\n   686→    lines = [\n   687→        LineString([(0, 0), (1, 1)]),\n   688→        LineString([(0, 0), (0, 1)]),\n   689→        LineString([(0, 1), (1, 1)]),\n   690→    ]\n   691→    expected = GeometryCollection([Polygon([(1, 1), (0, 0), (0, 1), (1, 1)])])\n   692→    result = shapely.polygonize(np.array(lines))\n   693→    asser