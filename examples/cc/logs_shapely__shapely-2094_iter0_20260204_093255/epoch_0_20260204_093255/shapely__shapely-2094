max, ymax]):\n   362→        raise TypeError(\"xmin/ymin/xmax/ymax only accepts scalar values\")\n   363→    return lib.clip_by_rect(\n   364→        geometry,\n   365→        np.double(xmin),\n   366→        np.double(ymin),\n   367→        np.double(xmax),\n   368→        np.double(ymax),\n   369→        **kwargs,\n   370→    )\n   371→\n   372→\n   373→@requires_geos(\"3.11.0\")\n   374→@multithreading_enabled\n   375→def concave_hull(geometry, ratio=0.0, allow_holes=False, **kwargs):\n   376→    \"\"\"Compute a concave geometry that encloses an input geometry.\n   377→\n   378→    Parameters\n   379→    ----------\n   380→    geometry : Geometry or array_like\n   381→        Geometry or geometries for which to compute the concave hull.\n   382→    ratio : float, default 0.0\n   383→        Number in the range [0, 1]. Higher numbers will include fewer vertices\n   384→        in the hull.\n   385→    allow_holes : bool, default False\n   386→        If set to True, the concave hull may have holes.\n   387→    **kwargs\n   388→        See :ref:`NumPy ufunc docs <ufuncs.kwargs>` for other keyword arguments.\n   389→\n   390→    Examples\n   391→    --------\n   392→    >>> from shapely import MultiPoint, Polygon\n   393→    >>> concave_hull(MultiPoint([(0, 0), (0, 3), (1, 1), (3, 0), (3, 3)]), ratio=0.1)\n   394→    <POLYGON ((0 0, 0 3, 1 1, 3 3, 3 0, 0 0))>\n   395→    >>> concave_hull(MultiPoint([(0, 0), (0, 3), (1, 1), (3, 0), (3, 3)]), ratio=1.0)\n   396→    <POLYGON ((0 0, 0 3, 3 3, 3 0, 0 0))>\n   397→    >>> concave_hull(Polygon())\n   398→    <POLYGON EMPTY>\n   399→\n   400→    \"\"\"\n   401→    if not np.isscalar(ratio):\n   402→        raise TypeError(\"ratio must be scalar\")\n   403→    if not np.isscalar(allow_holes):\n   404→        raise TypeError(\"allow_holes must be scalar\")\n   405→    return lib.concave_hull(geometry, np.double(ratio), np.bool_(allow_holes), **kwargs)\n   406→\n   407→\n   408→@multithreading_enabled\n   409→def convex_hull(geometry, **kwargs):\n   410→    \"\"\"Compute the minimum convex geometry that encloses an input geometry.\n   411→\n   412→    Parameters\n   413→    ----------\n   414→    geometry : Geometry or array_like\n   415→        Geometry or geometries for which to compute the convex hull.\n   416→    **kwargs\n   417→        See :ref:`NumPy ufunc docs <ufuncs.kwargs>` for other keyword arguments.\n   418→\n   419→    Examples\n   420→    --------\n   421→    >>> from shapely import MultiPoint, Polygon\n   422→    >>> convex_hull(MultiPoint([(0, 0), (10, 0), (10, 10)]))\n   423→    <POLYGON ((0 0, 10 10, 10 0, 0 0))>\n   424→    >>> convex_hull(Polygon())\n   425→    <GEOMETRYCOLLECTION EMPTY>\n   426→\n   427→    \"\"\"\n   428→    return lib.convex_hull(geometry, **kwargs)\n   429→\n   430→\n   431→@multithreading_enabled\n   432→def delaunay_triangles(geometry, tolerance=0.0, only_edges=False, **kwargs):\n   433→    \"\"\"Compute a Delaunay triangulation around the vertices of an input geometry.\n   434→\n   435→    The output is a geometrycollection containing polygons (default)\n   436→    or linestrings (see only_edges). Returns an None if an input geometry\n   437→    contains less than 3 vertices.\n   438→\n   439→    Parameters\n   440→    ----------\n   441→    geometry : Geometry or array_like\n   442→        Geometry or geometries for which to compute the Delaunay triangulation.\n   443→    tolerance : float or array_like, default 0.0\n   444→        Snap input vertices together if their distance is less than this value.\n   445→    only_edges : bool or array_like, default False\n   446→        If set to True, the triangulation will return a collection of\n   447→        linestrings instead of polygons.\n   448→    **kwargs\n   449→        See :ref:`NumPy ufunc docs <ufuncs.kwargs>` for other keyword arguments.\n   450→\n   451→    Examples\n   452→    --------\n   453→    >>> from shapely import GeometryCollection, LineString, MultiPoint, Polygon\n   454→    >>> points = MultiPoint([(50, 30), (60, 30), (100, 100)])\n   455→    >>> delaunay_triangles(points).normalize()\n   456→    <GEOMETRYCOLLECTION (POLYGON ((50 30, 100 100, 60 30, 50 30)))>\n   457→    >>> delaunay_triangles(points, only_edges=True)\n   458→    <MULTILINESTRING ((50 30, 100 100), (50 30, 60 30), ...>\n   459→    >>> delaunay_triangles(MultiPoint([(50, 30), (51, 30), (60, 30), (100, 100)]), \\\n   460→tolerance=2).normalize()\n   461→    <GEOMETRYCOLLECTION (POLYGON ((50 30, 100 100, 60 30, 50 30)))>\n   462→    >>> delaunay_triangles(Polygon([(50, 30), (60, 30), (100, 100), (50, 30)]))\\\n   463→.normalize()\n   464→    <GEOMETRYCOLLECTION (POLYGON ((50 30, 100 100, 60 30, 50 30)))>\n   465→    >>> delaunay_triangles(LineString([(50, 30), (60, 30), (100, 100)])).normalize()\n   466→    <GEOMETRYCOLLECTION (POLYGON ((50 30, 100 100, 60 30, 50 30)))>\n   467→    >>> delaunay_triangles(GeometryCollection([]))\n   468→    <GEOMETRYCOLLECTION EMPTY>\n   469→\n   470→    \"\"\"\n   471→    return lib.delaunay_triangles(geometry, tolerance, only_edges, **kwargs)\n   472→\n   473→\n   474→@multithreading_enabled\n   475→def envelope(geometry, **kwargs):\n   476→    \"\"\"Compute the minimum bounding box that encloses an input geometry.\n   477→\n   478→    Parameters\n   479→    ----------\n   480→    geometry : Geometry or array_like\n   481→        Geometry or geometries for which to compute the envelope.\n   482→    **kwargs\n   483→        See :ref:`NumPy ufunc docs <ufuncs.kwargs>` for other keyword arguments.\n   484→\n   485→    Examples\n   486→    --------\n   487→    >>> from shapely import GeometryCollection, LineString, MultiPoint, Point\n   488→    >>> envelope(LineString([(0, 0), (10, 10)]))\n   489→    <POLYGON ((0 0, 10 0, 10 10, 0 10, 0 0))>\n   490→    >>> envelope(MultiPoint([(0, 0), (10, 10)]))\n   491→    <POLYGON ((0 0, 10 0, 10 10, 0 10, 0 0))>\n   492→    >>> envelope(Point(0, 0))\n   493→    <POINT (0 0)>\n   494→    >>> envelope(GeometryCollection([]))\n   495→    <POINT EMPTY>\n   496→\n   497→    \"\"\"\n   498→    return lib.envelope(geometry, **kwargs)\n   499→\n   500→\n   501→@multithreading_enabled\n   502→def extract_unique_points(geometry, **kwargs):\n   503→    \"\"\"Return all distinct vertices of an input geometry as a multipoint.\n   504→\n   505→    Note that only 2 dimensions of the vertices are considered when testing\n   506→    for equality.\n   507→\n   508→    Parameters\n   509→    ----------\n   510→    geometry : Geometry or array_like\n   511→        Geometry or geometries for which to extract unique points.\n   512→    **kwargs\n   513→        See :ref:`NumPy ufunc docs <ufuncs.kwargs>` for other keyword arguments.\n   514→\n   515→    Examples\n   516→    --------\n   517→    >>> from shapely import LineString, MultiPoint, Point, Polygon\n   518→    >>> extract_unique_points(Point(0, 0))\n   519→    <MULTIPOINT ((0 0))>\n   520→    >>> extract_unique_points(LineString([(0, 0), (1, 1), (1, 1)]))\n   521→    <MULTIPOINT ((0 0), (1 1))>\n   522→    >>> extract_unique_points(Polygon([(0, 0), (1, 0), (1, 1), (0, 1), (0, 0)]))\n   523→    <MULTIPOINT ((0 0), (1 0), (1 1), (0 1))>\n   524→    >>> extract_unique_points(MultiPoint([(0, 0), (1, 1), (0, 0)]))\n   525→    <MULTIPOINT ((0 0), (1 1))>\n   526→    >>> extract_unique_points(LineString())\n   527→    <MULTIPOINT EMPTY>\n   528→\n   529→    \"\"\"\n   530→    return lib.extract_unique_points(geometry, **kwargs)\n   531→\n   532→\n   533→@multithreading_enabled\n   534→def build_area(geometry, **kwargs):\n   535→    \"\"\"Create an areal geometry formed by the constituent linework of given geometry.\n   536→\n   537→    Equivalent of the PostGIS ST_BuildArea() function.\n   538→\n   539→    Parameters\n   540→    ----------\n   541→    geometry : Geometry or array_like\n   542→        Geometry or geometries for which to build an area.\n   543→    **kwargs\n   544→        See :ref:`NumPy ufunc docs <ufuncs.kwargs>` for other keyword arguments.\n   545→\n   546→    Examples\n   547→    --------\n   548→    >>> from shapely import GeometryCollection, Polygon\n   549→    >>> polygon1 = Polygon([(0, 0), (3, 0), (3, 3), (0, 3), (0, 0)])\n   550→    >>> polygon2 = Polygon([(1, 1), (1, 2), (2, 2), (1, 1)])\n   551→    >>> build_area(GeometryCollection([polygon1, polygon2]))\n   552→    <POLYGON ((0 0, 0 3, 3 3, 3 0, 0 0), (1 1, 2 2, 1 2, 1 1))>\n   553→\n   554→    \"\"\"\n   555→    return lib.build_area(geometry, **kwargs)\n   556→\n   557→\n   558→@multithreading_enabled\n   559→def make_valid(geometry, method=\"linework\", keep_collapsed=True, **kwargs):\n   560→    \"\"\"Repair invalid geometries.\n   561→\n   562→    Two ``methods`` are available:\n   563→\n   564→    * the 'linework' algorithm tries to preserve every edge and vertex in the input. It\n   565→      combines all rings into a set of noded lines and then extracts valid polygons from\n   566→      that linework. An alternating even-odd strategy is used to assign areas as\n   567→      interior or exterior. A disadvantage is that for some relatively simple invalid\n   568→      geometries this produces rather complex results.\n   569→    * the 'structure' algorithm tries to reason from the structure of the input to find\n   570→      the 'correct' repair: exterior rings bound area, interior holes exclude area.\n   571→      It first makes all rings valid, then shells are merged and holes are subtracted\n   572→      from the shells to generate valid result. It assumes that holes and shells are\n   573→      correctly categorized in the input geometry.\n   574→\n   575→    Example:\n   576→\n   577→    .. plot:: code/make_valid_methods.py\n   578→\n   579→    When using ``make_valid`` on a Polygon, the result can be a GeometryCollection. For\n   580→    this example this is the case when the 'linework' ``method`` is used. LineStrings in\n   581→    the result are drawn in red.\n   582→\n   583→    Parameters\n   584→    ----------\n   585→    geometry : Geometry or array_like\n   586→        Geometry or geometries to repair.\n   587→    method : {'linework', 'structure'}, default 'linework'\n   588→        Algorithm to use when repairing geometry. 'structure'\n   589→        requires GEOS >= 3.10.\n   590→\n   591→        .. versionadded:: 2.1.0\n   592→    keep_collapsed : bool, default True\n   593→        For the 'structure' method, True will keep components that have collapsed into a\n   594→        lower dimensionality. For example, a ring collapsing to a line, or a line\n   595→        collapsing to a point. Must be True for the 'linework' method.\n   596→\n   597→        .. versionadded:: 2.1.0\n   598→    **kwargs\n   599→        See :ref:`NumPy ufunc docs <ufuncs.kwargs>` for other keyword arguments.\n   600→\n   601→    Examples\n   602→    --------\n   603→    >>> from shapely import is_valid, Polygon\n   604→    >>> polygon = Polygon([(0, 0), (1, 1), (1, 2), (1, 1), (0, 0)])\n   605→    >>> is_valid(polygon)\n   606→    False\n   607→    >>> make_valid(polygon)\n   608→    <MULTILINESTRING ((0 0, 1 1), (1 1, 1 2))>\n   609→    >>> make_valid(polygon, method=\"structure\", keep_collapsed=True)\n   610→    <LINESTRING (0 0, 1 1, 1 2, 1 1, 0 0)>\n   611→    >>> make_valid(polygon, method=\"structure\", keep_collapsed=False)\n   612→    <POLYGON EMPTY>\n   613→\n   614→    \"\"\"\n   615→    if not np.isscalar(method):\n   616→        raise TypeError(\"method only accepts scalar values\")\n   617→    if not np.isscalar(keep_collapsed):\n   618→        raise TypeError(\"keep_collapsed only accepts scalar values\")\n   619→\n   620→    if method == \"linework\":\n   621→        if keep_collapsed is False:\n   622→            raise ValueError(\n   623→                \"The 'linework' method does not support 'keep_collapsed=False'\"\n   624→            )\n   625→\n   626→        # The make_valid code can be removed once support for GEOS < 3.10 is dropped.\n   627→        # In GEOS >= 3.10, make_valid just calls make_valid_with_params with\n   628→        # method=\"linework\" and keep_collapsed=True, so there is no advantage to keep\n   629→        # both code paths in shapely on long term.\n   630→        return lib.make_valid(geometry, **kwargs)\n   631→\n   632→    elif method == \"structure\":\n   633→        if lib.geos_version < (3, 10, 0):\n   634→            raise ValueError(\n   635→                \"The 'structure' method is only available in GEOS >= 3.10.0\"\n   636→            )\n   637→\n   638→        return lib.make_valid_with_params(\n   639→            geometry, np.intc(1), np.bool_(keep_collapsed), **kwargs\n   640→        )\n   641→\n   642→    else:\n   643→        raise ValueError(f\"Unknown method: {method}\")\n   644→\n   645→\n   646→@multithreading_enabled\n   647→def minimum_clearance_line(geometry, **kwargs):\n   648→    \"\"\"Return a LineString whose endpoints define the minimum clearance.\n   649→\n   650→    A geometry's \"minimum clearance\" is the smallest distance by which a vertex\n   651→    of the geometry could be moved to produce an invalid geometry.\n   652→\n   653→    If the geometry has no minimum clearance, an empty LineString will be\n   654→    returned.\n   655→\n   656→    .. versionadded:: 2.1.0\n   657→\n   658→    Parameters\n   659→    ----------\n   660→    geometry : Geometry or array_like\n   661→        Geometry or geometries to determine the minimum clearance line for.\n   662→    **kwargs\n   663→        For other keyword-only arguments, see the\n   664→        `NumPy ufunc docs <https://numpy.org/doc/stable/reference/ufuncs.html#ufuncs-kwargs>`_.\n   665→\n   666→    Examples\n   667→    --------\n   668→    >>> from shapely import Polygon\n   669→    >>> poly = Polygon([(0, 0), (10, 0), (10, 10), (5, 5), (0, 10), (0, 0)])\n   670→    >>> minimum_clearance_line(poly)\n   671→    <LINESTRING (5 5, 5 0)>\n   672→\n   673→    See Also\n   674→    --------\n   675→    minimum_clearance\n   676→\n   677→    \"\"\"\n   678→    return lib.minimum_clearance_line(geometry, **kwargs)\n   679→\n   680→\n   681→@multithreading_enabled\n   682→def normalize(geometry, **kwargs):\n   683→    \"\"\"Convert Geometry to strict normal form (or canonical form).\n   684→\n   685→    In :ref:`strict canonical form <canonical-form>`, the coordinates, rings of\n   686→    a polygon and parts of multi geometries are ordered consistently. Typically\n   687→    useful for testing purposes (for example in combination with\n   688→    ``equals_exact``).\n   689→\n   690→    Parameters\n   691→    ----------\n   692→    geometry : Geometry or array_like\n   693→        Geometry or geometries to normalize.\n   694→    **kwargs\n   695→        See :ref:`NumPy ufunc docs <ufuncs.kwargs>` for other keyword arguments.\n   696→\n   697→    Examples\n   698→    --------\n   699→    >>> from shapely import MultiLineString\n   700→    >>> line = MultiLineString([[(0, 0), (1, 1)], [(2, 2), (3, 3)]])\n   701→    >>> normalize(line)\n   702→    <MULTILINESTRING ((2 2, 3 3), (0 0, 1 1))>\n   703→\n   704→    \"\"\"\n   705→    return lib.normalize(geometry, **kwargs)\n   706→\n   707→\n   708→@multithreading_enabled\n   709→def point_on_surface(geometry, **kwargs):\n   710→    \"\"\"Return a point that intersects an input geometry.\n   711→\n   712→    Parameters\n   713→    ----------\n   714→    geometry : Geometry or array_like\n   715→        Geometry or geometries for which to compute a point on the surface.\n   716→    **kwargs\n   717→        See :ref:`NumPy ufunc docs <ufuncs.kwargs>` for other keyword arguments.\n   718→\n   719→    Examples\n   720→    --------\n   721→    >>> from shapely import LineString, MultiPoint, Polygon\n   722→    >>> point_on_surface(Polygon([(0, 0), (10, 0), (10, 10), (0, 10), (0, 0)]))\n   723→    <POINT (5 5)>\n   724→    >>> point_on_surface(LineString([(0, 0), (2, 2), (10, 10)]))\n   725→    <POINT (2 2)>\n   726→    >>> point_on_surface(MultiPoint([(0, 0), (10, 10)]))\n   727→    <POINT (0 0)>\n   728→    >>> point_on_surface(Polygon())\n   729→    <POINT EMPTY>\n   730→\n   731→    \"\"\"\n   732→    return lib.point_on_surface(geometry, **kwargs)\n   733→\n   734→\n   735→@multithreading_enabled\n   736→def node(geometry, **kwargs):\n   737→    \"\"\"Return the fully noded version of the linear input as MultiLineString.\n   738→\n   739→    Given a linear input geometry, this function returns a new MultiLineString\n   740→    in which no lines cross each other but only touch at and points. To\n   741→    obtain this, all intersections between segments are computed and added\n   742→    to the segments, and duplicate segments are removed.\n   743→\n   744→    Non-linear input (points) will result in an empty MultiLineString.\n   745→\n   746→    This function can for example be used to create a fully-noded linework\n   747→    suitable to passed as input to ``polygonize``.\n   748→\n   749→    Parameters\n   750→    ----------\n   751→    geometry : Geometry or array_like\n   752→        Geometry or geometries for which to compute the noded version.\n   753→    **kwargs\n   754→        See :ref:`NumPy ufunc docs <ufuncs.kwargs>` for other keyword arguments.\n   755→\n   756→    Examples\n   757→    --------\n   758→    >>> from shapely import LineString, Point\n   759→    >>> line = LineString([(0, 0), (1,1), (0, 1), (1, 0)])\n   760→    >>> node(line)\n   761→    <MULTILINESTRING ((0 0, 0.5 0.5), (0.5 0.5, 1 1, 0 1, 0.5 0.5), (0.5 0.5, 1 0))>\n   762→    >>> node(Point(1, 1))\n   763→    <MULTILINESTRING EMPTY>\n   764→\n   765→    \"\"\"\n   766→    return lib.node(geometry, **kwargs)\n   767→\n   768→\n   769→def polygonize(geometries, **kwargs):\n   770→    \"\"\"Create polygons formed from the linework of a set of Geometries.\n   771→\n   772→    Polygonizes an array of Geometries that contain linework which\n   773→    represents the edges of a planar graph. Any type of Geometry may be\n   774→    provided as input; only the constituent lines and rings will be used to\n   775→    create the output polygons.\n   776→\n   777→    Lines or rings that when combined do not completely close a polygon\n   778→    will result in an empty GeometryCollection.  Duplicate segments are\n   779→    ignored.\n   780→\n   781→    This function returns the polygons within a GeometryCollection.\n   782→    Individual Polygons can be obtained using ``get_geometry`` to get\n   783→    a single polygon or ``get_parts`` to get an array of polygons.\n   784→    MultiPolygons can be constructed from the output using\n   785→    ``shapely.multipolygons(shapely.get_parts(shapely.polygonize(geometries)))``.\n   786→\n   787→    Parameters\n   788→    ----------\n   789→    geometries : array_like\n   790→        An array of geometries.\n   791→    axis : int\n   792→        Axis along which the geometries are polygonized.\n   793→        The default is to perform a reduction over the last dimension\n   794→        of the input array. A 1D array results in a scalar geometry.\n   795→    **kwargs\n   796→        See :ref:`NumPy ufunc docs <ufuncs.kwargs>` for other keyword arguments.\n   797→\n   798→    Returns\n   799→    -------\n   800→    GeometryCollection or array of GeometryCollections\n   801→\n   802→    See Also\n   803→    --------\n   804→    get_parts, get_geometry\n   805→    polygonize_full\n   806→    node\n   807→\n   808→    Examples\n   809→    --------\n   810→    >>> from shapely import LineString\n   811→    >>> lines = [\n   812→    ...     LineString([(0, 0), (1, 1)]),\n   813→    ...     LineString([(0, 0), (0, 1)]),\n   814→    ...     LineString([(0, 1), (1, 1)])\n   815→    ... ]\n   816→    >>> polygonize(lines)\n   817→    <GEOMETRYCOLLECTION (POLYGON ((1 1, 0 0, 0 1, 1 1)))>\n   818→\n   819→    \"\"\"\n   820→    return lib.polygonize(geometries, **kwargs)\n   821→\n   822→\n   823→def polygonize_full(geometries, **kwargs):\n   824→    \"\"\"Create polygons formed from the linework of a set of Geometries.\n   825→\n   826→    All extra outputs are returned as well.\n   827→\n   828→    Polygonizes an array of Geometries that contain linework which\n   829→    represents the edges of a planar graph. Any type of Geometry may be\n   830→    provided as input; only the constituent lines and rings will be used to\n   831→    create the output polygons.\n   832→\n   833→    This function performs the same polygonization as ``polygonize`` but does\n   834→    not only return the polygonal result but all extra outputs as well. The\n   835→    return value consists of 4 elements:\n   836→\n   837→    * The polygonal valid output\n   838→    * **Cut edges**: edges connected on both ends but not part of polygonal output\n   839→    * **dangles**: edges connected on one end but not part of polygonal output\n   840→    * **invalid rings**: polygons formed but which are not valid\n   841→\n   842→    This function returns the geometries within GeometryCollections.\n   843→    Individual geometries can be obtained using ``get_geometry`` to get\n   844→    a single geometry or ``get_parts`` to get an array of geometries.\n   845→\n   846→    Parameters\n   847→    ----------\n   848→    geometries : array_like\n   849→        An array of geometries.\n   850→    axis : int\n   851→        Axis along which the geometries are polygonized.\n   852→        The default is to perform a reduction over the last dimension\n   853→        of the input array. A 1D array results in a scalar geometry.\n   854→    **kwargs\n   855→        See :ref:`NumPy ufunc docs <ufuncs.kwargs>` for other keyword arguments.\n   856→\n   857→    Returns\n   858→    -------\n   859→    (polygons, cuts, dangles, invalid)\n   860→        tuple of 4 GeometryCollections or arrays of GeometryCollections\n   861→\n   862→    See Also\n   863→    --------\n   864→    polygonize\n   865→\n   866→    Examples\n   867→    --------\n   868→    >>> from shapely import LineString\n   869→    >>> lines = [\n   870→    ...     LineString([(0, 0), (1, 1)]),\n   871→    ...     LineString([(0, 0), (0, 1), (1, 1)]),\n   872→    ...     LineString([(0, 1), (1, 1)])\n   873→    ... ]\n   874→    >>> polygonize_full(lines)  # doctest: +NORMALIZE_WHITESPACE\n   875→    (<GEOMETRYCOLLECTION (POLYGON ((1 1, 0 0, 0 1, 1 1)))>,\n   876→     <GEOMETRYCOLLECTION EMPTY>,\n   877→     <GEOMETRYCOLLECTION (LINESTRING (0 1, 1 1))>,\n   878→     <GEOMETRYCOLLECTION EMPTY>)\n   879→\n   880→    \"\"\"\n   881→    return lib.polygonize_full(geometries, **kwargs)\n   882→\n   883→\n   884→@requires_geos(\"3.11.0\")\n   885→@multithreading_enabled\n   886→def remove_repeated_points(geometry, tolerance=0.0, **kwargs):\n   887→    \"\"\"Return a copy of a Geometry with repeated points removed.\n   888→\n   889→    From the start of the coordinate sequence, each next point within the\n   890→    tolerance is removed.\n   891→\n   892→    Removing repeated points with a non-zero tolerance may result in an invalid\n   893→    geometry being returned.\n   894→\n   895→    Parameters\n   896→    ----------\n   897→    geometry : Geometry or array_like\n   898→        Geometry or geometries to remove repeated points from.\n   899→    tolerance : float or array_like, default=0.0\n   900→        Use 0.0 to remove only exactly repeated points.\n   901→    **kwargs\n   902→        See :ref:`NumPy ufunc docs <ufuncs.kwargs>` for other keyword arguments.\n   903→\n   904→    Examples\n   905→    --------\n   906→    >>> from shapely import LineString, Polygon\n   907→    >>> remove_repeated_points(LineString([(0,0), (0,0), (1,0)]), tolerance=0)\n   908→    <LINESTRING (0 0, 1 0)>\n   909→    >>> remove_repeated_points(Polygon([(0, 0), (0, .5), (0, 1), (.5, 1), (0,0)]), tolerance=.5)\n   910→    <POLYGON ((0 0, 0 1, 0 0))>\n   911→\n   912→    \"\"\"  # noqa: E501\n   913→    return lib.remove_repeated_points(geometry, tolerance, **kwargs)\n   914→\n   915→\n   916→@multit