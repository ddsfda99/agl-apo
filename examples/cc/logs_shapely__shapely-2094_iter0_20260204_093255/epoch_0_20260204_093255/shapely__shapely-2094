xpected\",\n   920→    [\n   921→        pytest.param(empty_point, POINT_NAN_WKB, id=\"POINT EMPTY\"),\n   922→        pytest.param(multi_point_empty, MULTIPOINT_NAN_WKB, id=\"MULTIPOINT EMPTY\"),\n   923→        pytest.param(\n   924→            shapely.geometrycollections([empty_point]),\n   925→            GEOMETRYCOLLECTION_NAN_WKB,\n   926→            id=\"GEOMETRYCOLLECTION (POINT EMPTY)\",\n   927→        ),\n   928→        pytest.param(\n   929→            shapely.geometrycollections([multi_point_empty]),\n   930→            NESTED_COLLECTION_NAN_WKB,\n   931→            id=\"GEOMETRYCOLLECTION (MULTIPOINT EMPTY)\",\n   932→        ),\n   933→    ],\n   934→)\n   935→def test_to_wkb_point_empty_2d_output_dim_3(geom, expected):\n   936→    actual = shapely.to_wkb(geom, output_dimension=3, byte_order=1)\n   937→    # Split 'actual' into header and coordinates\n   938→    coordinate_length = 16\n   939→    header_length = len(expected) - coordinate_length\n   940→    # Check the total length (this checks the correct dimensionality)\n   941→    assert len(actual) == header_length + coordinate_length\n   942→    # Check the header\n   943→    assert actual[:header_length] == expected[:header_length]\n   944→    # Check the coordinates (using numpy.isnan; there are many byte representations for\n   945→    # NaN)\n   946→    assert np.isnan(struct.unpack(\"<2d\", actual[header_length:])).all()\n   947→\n   948→\n   949→@pytest.mark.parametrize(\n   950→    \"wkb,expected_type,expected_dim\",\n   951→    [\n   952→        pytest.param(POINT_NAN_WKB, 0, 2, id=\"POINT_NAN_WKB\"),\n   953→        pytest.param(POINTZ_NAN_WKB, 0, 3, id=\"POINTZ_NAN_WKB\"),\n   954→        pytest.param(MULTIPOINT_NAN_WKB, 4, 2, id=\"MULTIPOINT_NAN_WKB\"),\n   955→        pytest.param(MULTIPOINTZ_NAN_WKB, 4, 3, id=\"MULTIPOINTZ_NAN_WKB\"),\n   956→        pytest.param(GEOMETRYCOLLECTION_NAN_WKB, 7, 2, id=\"GEOMETRYCOLLECTION_NAN_WKB\"),\n   957→        pytest.param(\n   958→            GEOMETRYCOLLECTIONZ_NAN_WKB, 7, 3, id=\"GEOMETRYCOLLECTIONZ_NAN_WKB\"\n   959→        ),\n   960→        pytest.param(NESTED_COLLECTION_NAN_WKB, 7, 2, id=\"NESTED_COLLECTION_NAN_WKB\"),\n   961→        pytest.param(NESTED_COLLECTIONZ_NAN_WKB, 7, 3, id=\"NESTED_COLLECTIONZ_NAN_WKB\"),\n   962→    ],\n   963→)\n   964→def test_from_wkb_point_empty(wkb, expected_type, expected_dim):\n   965→    geom = shapely.from_wkb(wkb)\n   966→    # POINT (nan nan) transforms to an empty point\n   967→    assert shapely.is_empty(geom)\n   968→    assert shapely.get_type_id(geom) == expected_type\n   969→    assert shapely.get_coordinate_dimension(geom) == expected_dim\n   970→\n   971→\n   972→@pytest.mark.skipif(\n   973→    shapely.geos_version < (3, 12, 0),\n   974→    reason=\"M coordinates not supported with GEOS < 3.12\",\n   975→)\n   976→@pytest.mark.parametrize(\n   977→    \"wkb,expected_type\",\n   978→    [\n   979→        pytest.param(POINTM_NAN_WKB, 0, id=\"POINTM_NAN_WKB\"),\n   980→        pytest.param(MULTIPOINTM_NAN_WKB, 4, id=\"MULTIPOINTM_NAN_WKB\"),\n   981→        pytest.param(GEOMETRYCOLLECTIONM_NAN_WKB, 7, id=\"GEOMETRYCOLLECTIONM_NAN_WKB\"),\n   982→        pytest.param(NESTED_COLLECTIONM_NAN_WKB, 7, id=\"NESTED_COLLECTIONM_NAN_WKB\"),\n   983→    ],\n   984→)\n   985→def test_from_wkb_point_empty_m(wkb, expected_type):\n   986→    geom = shapely.from_wkb(wkb)\n   987→\n   988→    assert shapely.is_empty(geom)\n   989→    assert shapely.get_type_id(geom) == expected_type\n   990→    assert shapely.get_coordinate_dimension(geom) == 3\n   991→    assert not shapely.has_z(geom)\n   992→    assert shapely.has_m(geom)\n   993→\n   994→\n   995→@pytest.mark.skipif(\n   996→    shapely.geos_version < (3, 12, 0),\n   997→    reason=\"M coordinates not supported with GEOS < 3.12\",\n   998→)\n   999→@pytest.mark.parametrize(\n  1000→    \"wkb,expected_type\",\n  1001→    [\n  1002→        pytest.param(POINTZM_NAN_WKB, 0, id=\"POINTZM_NAN_WKB\"),\n  1003→        pytest.param(MULTIPOINTZM_NAN_WKB, 4, id=\"MULTIPOINTZM_NAN_WKB\"),\n  1004→        pytest.param(\n  1005→            GEOMETRYCOLLECTIONZM_NAN_WKB, 7, id=\"GEOMETRYCOLLECTIONZM_NAN_WKB\"\n  1006→        ),\n  1007→        pytest.param(NESTED_COLLECTIONZM_NAN_WKB, 7, id=\"NESTED_COLLECTIONZM_NAN_WKB\"),\n  1008→    ],\n  1009→)\n  1010→def test_from_wkb_point_empty_zm(wkb, expected_type):\n  1011→    geom = shapely.from_wkb(wkb)\n  1012→\n  1013→    assert shapely.is_empty(geom)\n  1014→    assert shapely.get_type_id(geom) == expected_type\n  1015→    assert shapely.get_coordinate_dimension(geom) == 4\n  1016→    assert shapely.has_z(geom)\n  1017→    assert shapely.has_m(geom)\n  1018→\n  1019→\n  1020→def test_to_wkb_point_empty_srid():\n  1021→    expected = shapely.set_srid(empty_point, 4236)\n  1022→    wkb = shapely.to_wkb(expected, include_srid=True)\n  1023→    actual = shapely.from_wkb(wkb)\n  1024→    assert shapely.get_srid(actual) == 4236\n  1025→\n  1026→\n  1027→@pytest.mark.parametrize(\"geom\", all_types + (point_z, empty_point))\n  1028→def test_pickle(geom):\n  1029→    pickled = pickle.dumps(geom)\n  1030→    assert_geometries_equal(pickle.loads(pickled), geom, tolerance=0)\n  1031→\n  1032→\n  1033→@pytest.mark.parametrize(\"geom\", all_types_z)\n  1034→def test_pickle_z(geom):\n  1035→    if shapely.get_type_id(geom) == shapely.GeometryType.LINEARRING:\n  1036→        # https://github.com/shapely/shapely/pull/1808#discussion_r1182174077\n  1037→        pytest.xfail(\"TODO: Z gets dropped for LinearRing\")\n  1038→    pickled = pickle.dumps(geom)\n  1039→    actual = pickle.loads(pickled)\n  1040→    assert_geometries_equal(actual, geom, tolerance=0)\n  1041→    if not actual.is_empty:  # GEOSHasZ with EMPTY geometries is inconsistent\n  1042→        assert actual.has_z\n  1043→    if shapely.geos_version >= (3, 12, 0):\n  1044→        assert not actual.has_m\n  1045→\n  1046→\n  1047→@pytest.mark.skipif(\n  1048→    shapely.geos_version < (3, 12, 0),\n