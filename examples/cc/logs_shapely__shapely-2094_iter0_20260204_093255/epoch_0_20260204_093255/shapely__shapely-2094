98\u2192        geometry,\n   199\u2192        np.bool_(hex),\n   200\u2192        np.intc(output_dimension),\n   201\u2192        np.intc(byte_order),\n   202\u2192        np.bool_(include_srid),\n   203\u2192        np.intc(flavor),\n   204\u2192        **kwargs,\n   205\u2192    )\n   206\u2192\n   207\u2192\n   208\u2192@requires_geos(\"3.10.0\")\n   209\u2192def to_geojson(geometry, indent=None, **kwargs):\n   210\u2192    \"\"\"Convert to the GeoJSON representation of a Geometry.\n   211\u2192\n   212\u2192    The GeoJSON format is defined in the `RFC 7946 <https://geojson.org/>`__.\n   213\u2192    NaN (not-a-number) coordinates will be written as 'null'.\n   214\u2192\n   215\u2192    The following are currently unsupported:\n   216\u2192\n   217\u2192    - Geometries of type LINEARRING: these are output as 'null'.\n   218\u2192    - Three-dimensional geometries: the third dimension is ignored.\n   219\u2192\n   220\u2192    Parameters\n   221\u2192    ----------\n   222\u2192    geometry : str, bytes or array_like\n   223\u2192        Geometry or geometries to convert to GeoJSON.\n   224\u2192    indent : int, optional\n   225\u2192        If indent is a non-negative integer, then GeoJSON will be formatted.\n   226\u2192        An indent level of 0 will only insert newlines. None (the default)\n   227\u2192        selects the most compact representation.\n   228\u2192    **kwargs\n   229\u2192        See :ref:`NumPy ufunc docs <ufuncs.kwargs>` for other keyword arguments.\n   230\u2192\n   231\u2192    Examples\n   232\u2192    --------\n   233\u2192    >>> from shapely import Point\n   234\u2192    >>> point = Point(1, 1)\n   235\u2192    >>> to_geojson(point)\n   236\u2192    '{\"type\":\"Point\",\"coordinates\":[1.0,1.0]}'\n   237\u2192    >>> print(to_geojson(point, indent=2))\n   238\u2192    {\n   239\u2192      \"type\": \"Point\",\n   240\u2192      \"coordinates\": [\n   241\u2192          1.0,\n   242\u2192          1.0\n   243\u2192      ]\n   244\u2192    }\n   245\u2192\n   246\u2192    \"\"\"\n   247\u2192    # GEOS Tickets:\n   248\u2192    # - handle linearrings: https://trac.osgeo.org/geos/ticket/1140\n   249\u2192    # - support 3D: https://trac.osgeo.org/geos/ticket/1141\n   250\u2192    if indent is None:\n   251\u2192        indent = -1\n   252\u2192    elif not np.isscalar(indent):\n   253\u2192        raise TypeError(\"indent only accepts scalar values\")\n   254\u2192    elif indent < 0:\n   255\u2192        raise ValueError(\"indent cannot be negative\")\n   256\u2192\n   257\u2192    return lib.to_geojson(geometry, np.intc(indent), **kwargs)\n   258\u2192\n   259\u2192\n   260\u2192def from_wkt(geometry, on_invalid=\"raise\", **kwargs):\n   261\u2192    \"\"\"Create geometries from the Well-Known Text (WKT) representation.\n   262\u2192\n   263\u2192    The Well-known Text format is defined in the `OGC Simple Features\n   264\u2192    Specification for SQL <https://www.opengeospatial.org/standards/sfs>`__.\n   265\u2192\n   266\u2192    Parameters\n   267\u2192    ----------\n   268\u2192    geometry : str or array_like\n   269\u2192        The WKT string(s) to convert.\n   270\u2192    on_invalid : {\"raise\", \"warn\", \"ignore\"}, default \"raise\"\n   271\u2192        - raise: an exception will be raised if WKT input geometries are invalid.\n   272\u2192        - warn: a warning will be raised and invalid WKT geometries will be\n   273\u2192          returned as ``None``.\n   274\u2192        - ignore: invalid WKT geometries will be returned as ``None`` without a warning.\n   275\u2192    **kwargs\n   276\u2192        See :ref:`NumPy ufunc docs <ufuncs.kwargs>` for other keyword arguments.\n   277\u2192\n   278\u2192    Examples\n   279\u2192    --------\n   280\u2192    >>> from_wkt('POINT (0 0)')\n   281\u2192    <POINT (0 0)>\n   282\u2192\n   283\u2192    \"\"\"\n   284\u2192    if not np.isscalar(on_invalid):\n   285\u2192        raise TypeError(\"on_invalid only accepts scalar values\")\n   286\u2192\n   287\u2192    invalid_handler = np.uint8(DecodingErrorOptions.get_value(on_invalid))\n   288\u2192\n   289\u2192    return lib.from_wkt(geometry, invalid_handler, **kwargs)\n   290\u2192\n   291\u2192\n   292\u2192def from_wkb(geometry, on_invalid=\"raise\", **kwargs):\n   293\u2192    r\"\"\"Create geometries from the Well-Known Binary (WKB) representation.\n   294\u2192\n   295\u2192    The Well-Known Binary format is defined in the `OGC Simple Features\n   296\u2192    Specification for SQL <https://www.opengeospatial.org/standards/sfs>`__.\n   297\u2192\n   298\u2192    Parameters\n   299\u2192    ----------\n   300\u2192    geometry : str or array_like\n   301\u2192        The WKB byte object(s) to convert.\n   302\u2192    on_invalid : {\"raise\", \"warn\", \"ignore\"}, default \"raise\"\n   303\u2192        - raise: an exception will be raised if a WKB input geometry is invalid.\n   304\u2192        - warn: a warning will be raised and invalid WKB geometries will be\n   305\u2192          returned as ``None``.\n   306\u2192        - ignore: invalid WKB geometries will be returned as ``None`` without a warning.\n   307\u2192    **kwargs\n   308\u2192        See :ref:`NumPy ufunc docs <ufuncs.kwargs>` for other keyword arguments.\n   309\u2192\n   310\u2192    Examples\n   311\u2192    --------\n   312\u2192    >>> from_wkb(b'\\x01\\x01\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\xf0?\\x00\\x00\\x00\\x00\\x00\\x00\\xf0?')\n   313\u2192    <POINT (1 1)>\n   314\u2192\n   315\u2192    \"\"\"  # noqa: E501\n   316\u2192    if not np.isscalar(on_invalid):\n   317\u2192        raise TypeError(\"on_invalid only accepts scalar values\")\n   318\u2192\n   319\u2192    invalid_handler = np.uint8(DecodingErrorOptions.get_value(on_invalid))\n   320\u2192\n   321\u2192    # ensure the input has object dtype, to avoid numpy inferring it as a\n   322\u2192    # fixed-length string dtype (which removes trailing null bytes upon access\n   323\u2192    # of array elements)\n   324\u2192    geometry = np.asarray(geometry, dtype=object)\n   325\u2192    return lib.from_wkb(geometry, invalid_handler, **kwargs)\n   326\u2192\n   327\u2192\n   328\u2192@requires_geos(\"3.10.1\")\n   329\u2192def from_geojson(geometry, on_invalid=\"raise\", **kwargs):\n   330\u2192    \"\"\"Create geometries from GeoJSON representations (strings).\n   331\u2192\n   332\u2192    If a GeoJSON is a FeatureCollection, it is read as a single geometry\n   333\u2192    (with type GEOMETRYCOLLECTION). This may be unpacked using\n   334\u2192    :meth:`shapely.get_parts`. Properties are not read.\n   335\u2192\n   336\u2192    The GeoJSON format is defined in `RFC 7946 <https://geojson.org/>`__.\n   337\u2192\n   338\u2192    The following are currently unsupported:\n   339\u2192\n   340\u2192    - Three-dimensional geometries: the third dimension is ignored.\n   341\u2192    - Geometries having 'null' in the coordinates.\n   342\u2192\n   343\u2192    Parameters\n   344\u2192    ----------\n   345\u2192    geometry : str, bytes or array_like\n   346\u2192        The GeoJSON string or byte object(s) to convert.\n   347\u2192    on_invalid : {\"raise\", \"warn\", \"ignore\"}, default \"raise\"\n   348\u2192        - raise: an exception will be raised if an input GeoJSON is invalid.\n   349\u2192        - warn: a warning will be raised and invalid input geometries will be\n   350\u2192          returned as ``None``.\n   351\u2192        - ignore: invalid input geometries will be returned as ``None`` without\n   352\u2192          a warning.\n   353\u2192    **kwargs\n   354\u2192        See :ref:`NumPy ufunc docs <ufuncs.kwargs>` for other keyword arguments.\n   355\u2192\n   356\u2192    See Also\n   357\u2192    --------\n   358\u2192    get_parts\n   359\u2192\n   360\u2192    Examples\n   361\u2192    --------\n   362\u2192    >>> from_geojson('{\"type\": \"Point\",\"coordinates\": [1, 2]}')\n   363\u2192    <POINT (1 2)>\n   364\u2192\n   365\u2192    \"\"\"\n   366\u2192    # GEOS Tickets:\n   367\u2192    # - support 3D: https://trac.osgeo.org/geos/ticket/1141\n   368\u2192    # - handle null coordinates: https://trac.osgeo.org/geos/ticket/1142\n   369\u2192    if not np.isscalar(on_invalid):\n   370\u2192        raise TypeError(\"on_invalid only accepts scalar values\")\n   371\u2192\n   372\u2192    invalid_handler = np.uint8(DecodingErrorOptions.get_value(on_invalid))\n   373\u2192\n   374\u2192    # ensure the input has object dtype, to avoid numpy inferring it as a\n   375\u2192    # fixed-length string dtype (which removes trailing null bytes upon access\n   376\u2192    # of array elements)\n   377\u2192    geometry = np.asarray(geometry, dtype=object)\n   378\u2192\n   379\u2192    return lib.from_geojson(geometry, invalid_handler, **kwargs)\n   380\u2192\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"
