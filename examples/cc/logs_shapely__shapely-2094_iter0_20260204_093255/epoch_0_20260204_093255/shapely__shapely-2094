g([(0, 0), (1, 2), (1, 3), (0, 0)]),\n   410→        ),\n   411→        (\n   412→            Polygon([(0, 0), (0, 0), (1, 0), (1, 1), (1, 0), (0, 0)]),\n   413→            Polygon([(0, 0), (1, 0), (1, 1), (1, 0), (0, 0)]),\n   414→        ),\n   415→        (\n   416→            Polygon(\n   417→                [(0, 0), (10, 0), (10, 10), (0, 10), (0, 0)],\n   418→                holes=[[(2, 2), (2, 2), (2, 4), (4, 4), (4, 2), (2, 2)]],\n   419→            ),\n   420→            Polygon(\n   421→                [(0, 0), (10, 0), (10, 10), (0, 10), (0, 0)],\n   422→                holes=[[(2, 2), (2, 4), (4, 4), (4, 2), (2, 2)]],\n   423→            ),\n   424→        ),\n   425→        (\n   426→            MultiPolygon(\n   427→                [\n   428→                    Polygon([(0, 0), (0, 0), (1, 0), (1, 1), (0, 1), (0, 0)]),\n   429→                    Polygon([(2, 2), (2, 2), (2, 3), (3, 3), (3, 2), (2, 2)]),\n   430→                ]\n   431→            ),\n   432→            MultiPolygon(\n   433→                [\n   434→                    Polygon([(0, 0), (1, 0), (1, 1), (0, 1), (0, 0)]),\n   435→                    Polygon([(2, 2), (2, 3), (3, 3), (3, 2), (2, 2)]),\n   436→                ]\n   437→            ),\n   438→        ),\n   439→        # points are unchanged\n   440→        (point, point),\n   441→        (point_z, point_z),\n   442→        (multi_point, multi_point),\n   443→        # empty geometries are unchanged\n   444→        (empty_point, empty_point),\n   445→        (empty_line_string, empty_line_string),\n   446→        (empty, empty),\n   447→        (empty_polygon, empty_polygon),\n   448→    ],\n   449→)\n   450→def test_remove_repeated_points(geom, expected):\n   451→    assert_geometries_equal(shapely.remove_repeated_points(geom, 0), expected)\n   452→\n   453→\n   454→@pytest.mark.skipif(shapely.geos_version < (3, 12, 0), reason=\"GEOS < 3.12\")\n   455→@pytest.mark.parametrize(\n   456→    \"geom, tolerance\", [[Polygon([(