ection([Point(0, 0)])) is None\n   112→    True\n   113→\n   114→    \"\"\"\n   115→    return lib.boundary(geometry, **kwargs)\n   116→\n   117→\n   118→@multithreading_enabled\n   119→def buffer(\n   120→    geometry,\n   121→    distance,\n   122→    quad_segs=8,\n   123→    cap_style=\"round\",\n   124→    join_style=\"round\",\n   125→    mitre_limit=5.0,\n   126→    single_sided=False,\n   127→    **kwargs,\n   128→):\n   129→    \"\"\"Compute the buffer of a geometry for positive and negative buffer distance.\n   130→\n   131→    The buffer of a geometry is defined as the Minkowski sum (or difference,\n   132→    for negative distance) of the geometry with a circle with radius equal\n   133→    to the absolute value of the buffer distance.\n   134→\n   135→    The buffer operation always returns a polygonal result. The negative\n   136→    or zero-distance buffer of lines and points is always empty.\n   137→\n   138→    Parameters\n   139→    ----------\n   140→    geometry : Geometry or array_like\n   141→        Geometry or geometries for which to compute the buffer.\n   142→    distance : float or array_like\n   143→        Specifies the circle radius in the Minkowski sum (or difference).\n   144→    quad_segs : int, default 8\n   145→        Specifies the number of linear segments in a quarter circle in the\n   146→        approximation of circular arcs.\n   147→    cap_style : shapely.BufferCapStyle or {'round', 'square', 'flat'}, default 'round'\n   148→        Specifies the shape of buffered line endings. BufferCapStyle.round ('round')\n   149→        results in circular line endings (see ``quad_segs``). Both BufferCapStyle.square\n   150→        ('square') and BufferCapStyle.flat ('flat') result in rectangular line endings,\n   151→        only BufferCapStyle.flat ('flat') will end at the original vertex,\n   152→        while BufferCapStyle.square ('square') involves adding the buffer width.\n   153→    join_style : shapely.BufferJoinStyle or {'round', 'mitre', 'bevel'}, default 'round'\n   154→        Specifies the shape of buffered line midpoints. BufferJoinStyle.round ('round')\n   155→        results in rounded shapes. BufferJoinStyle.bevel ('bevel') results in a beveled\n   156→        edge that touches the original vertex. BufferJoinStyle.mitre ('mitre') results\n   157→        in a single vertex that is beveled depending on the ``mitre_limit`` parameter.\n   158→    mitre_limit : float, default 5.0\n   159→        Crops of 'mitre'-style joins if the point is displaced from the\n   160→        buffered vertex by more than this limit.\n   161→    single_sided : bool, default False\n   162→        Only buffer at one side of the geometry.\n   163→    **kwargs\n   164→        See :ref:`NumPy ufunc docs <ufuncs.kwargs>` for other keyword arguments.\n   165→\n   166→    Examples\n   167→    --------\n   168→    >>> from shapely import LineString, Point, Polygon, BufferCapStyle, BufferJoinStyle\n   169→    >>> buffer(Point(10, 10), 2, quad_segs=1)\n   170→    <POLYGON ((12 10, 10 8, 8 10, 10 12, 12 10))>\n   171→    >>> buffer(Point(10, 10), 2, quad_segs=2)\n   172→    <POLYGON ((12 10, 11.414 8.586, 10 8, 8.586 8.586, 8 10, 8.5...>\n   173→    >>> buffer(Point(10, 10), -2, quad_segs=1)\n   174→    <POLYGON EMPTY>\n   175→    >>> line = LineString([(10, 10), (20, 10)])\n   176→    >>> buffer(line, 2, cap_style=\"square\")\n   177→    <POLYGON ((20 12, 22 12, 22 8, 10 8, 8 8, 8 12, 20 12))>\n   178→    >>> buffer(line, 2, cap_style=\"flat\")\n   179→    <POLYGON ((20 12, 20 8, 10 8, 10 12, 20 12))>\n   180→    >>> buffer(line, 2, single_sided=True, cap_style=\"flat\")\n   181→    <POLYGON ((20 10, 10 10, 10 12, 20 12, 20 10))>\n   182→    >>> line2 = LineString([(10, 10), (20, 10), (20, 20)])\n   183→    >>> buffer(line2, 2, cap_style=\"flat\", join_style=\"bevel\")\n   184→    <POLYGON ((18 12, 18 20, 22 20, 22 10, 20 8, 10 8, 10 12, 18 12))>\n   185→    >>> buffer(line2, 2, cap_style=\"flat\", join_style=\"mitre\")\n   186→    <POLYGON ((18 12, 18 20, 22 20, 22 8, 10 8, 10 12, 18 12))>\n   187→    >>> buffer(line2, 2, cap_style=\"flat\", join_style=\"mitre\", mitre_limit=1)\n   188→    <POLYGON ((18 12, 18 20, 22 20, 22 9.172, 20.828 8, 10 8, 10 12, 18 12))>\n   189→    >>> square = Polygon([(0, 0), (10, 0), (10, 10), (0, 10), (0, 0)])\n   190→    >>> buffer(square, 2, join_style=\"mitre\")\n   191→    <POLYGON ((-2 -2, -2 12, 12 12, 12 -2, -2 -2))>\n   192→    >>> buffer(square, -2, join_style=\"mitre\")\n   193→    <POLYGON ((2 2, 2 8, 8 8, 8 2, 2 2))>\n   194→    >>> buffer(square, -5, join_style=\"mitre\")\n   195→    <POLYGON EMPTY>\n   196→    >>> buffer(line, float(\"nan\")) is None\n   197→    True\n   198→\n   199→    \"\"\"\n   200→    if isinstance(cap_style, str):\n   201→        cap_style = BufferCapStyle.get_value(cap_style)\n   202→    if isinstance(join_style, str):\n   203→        join_style = BufferJoinStyle.get_value(join_style)\n   204→    if not np.isscalar(quad_segs):\n   205→        raise TypeError(\"quad_segs only accepts scalar values\")\n   206→    if not np.isscalar(cap_style):\n   207→        raise TypeError(\"cap_style only accepts scalar values\")\n   208→    if not np.isscalar(join_style):\n   209→        raise TypeError(\"join_style only accepts scalar values\")\n   210→    if not np.isscalar(mitre_limit):\n   211→        raise TypeError(\"mitre_limit only accepts scalar values\")\n   212→    if not np.isscalar(single_sided):\n   213→        raise TypeError(\"single_sided only accepts scalar values\")\n   214→    return lib.buffer(\n   215→        geometry,\n   216→        distance,\n   217→        np.intc(quad_segs),\n   218→        np.intc(cap_style),\n   219→        np.intc(join_style),\n   220→        mitre_limit,\n   221→        np.bool_(single_sided),\n   222→        **kwargs,\n   223→    )\n   224→\n   225→\n   226→@multithreading_enabled\n   227→def offset_curve(\n   228→    geometry, distance, quad_segs=8, join_style=\"round\", mitre_limit=5.0, **kwargs\n   229→):\n   230→    \"\"\"Return a (Multi)LineString at a distance from the object.\n   231→\n   232→    For positive distance the offset will be at the left side of the input\n   233→    line. For a negative distance it will be at the right side. In general,\n   234→    this function tries to preserve the direction of the input.\n   235→\n   236→    Note: the behaviour regarding orientation of the resulting line depends\n   237→    on the GEOS version. With GEOS < 3.11, the line retains the same\n   238→    direction for a left offset (positive distance) or has opposite direction\n   239→    for a right offset (negative distance), and this behaviour was documented\n   240→    as such in previous Shapely versions. Starting with GEOS 3.11, the\n   241→    function tries to preserve the orientation of the original line.\n   242→\n   243→    Parameters\n   244→    ----------\n   245→    geometry : Geometry or array_like\n   246→        Geometry or geometries for which to compute the offset.\n   247→    distance : float or array_like\n   248→        Specifies the offset distance from the input geometry. Negative\n   249→        for right side offset, positive for left side offset.\n   250→    quad_segs : int, default 8\n   251→        Specifies the number of linear segments in a quarter circle in the\n   252→        approximation of circular arcs.\n   253→    join_style : {'round', 'bevel', 'mitre'}, default 'round'\n   254→        Specifies the shape of outside corners. 'round' results in\n   255→        rounded shapes. 'bevel' results in a beveled edge that touches the\n   256→        original vertex. 'mitre' results in a single vertex that is beveled\n   257→        depending on the ``mitre_limit`` parameter.\n   258→    mitre_limit : float, default 5.0\n   259→        Crops of 'mitre'-style joins if the point is displaced from the\n   260→        buffered vertex by more than this limit.\n   261→    **kwargs\n   262→        See :ref:`NumPy ufunc docs <ufuncs.kwargs>` for other keyword arguments.\n   263→\n   264→    Examples\n   265→    --------\n   266→    >>> from shapely import LineString\n   267→    >>> line = LineString([(0, 0), (0, 2)])\n   268→    >>> offset_curve(line, 2)\n   269→    <LINESTRING (-2 0, -2 2)>\n   270→    >>> offset_curve(line, -2)\n   271→    <LINESTRING (2 0, 2 2)>\n   272→\n   273→    \"\"\"\n   274→    if isinstance(join_style, str):\n   275→        join_style = BufferJoinStyle.get_value(join_style)\n   276→    if not np.isscalar(quad_segs):\n   277→        raise TypeError(\"quad_segs only accepts scalar values\")\n   278→    if not np.isscalar(join_style):\n   279→        raise TypeError(\"join_style only accepts scalar values\")\n   280→    if not np.isscalar(mitre_limit):\n   281→        raise TypeError(\"mitre_limit only accepts scalar values\")\n   282→    return lib.offset_curve(\n   283→        geometry,\n   284→        distance,\n   285→        np.intc(quad_segs),\n   286→        np.intc(join_style),\n   287→        np.double(mitre_limit),\n   288→        **kwargs,\n   289→    )\n   290→\n   291→\n   292→@multithreading_enabled\n   293→def centroid(geometry, **kwargs):\n   294→    \"\"\"Compute the geometric center (center-of-mass) of a geometry.\n   295→\n   296→    For multipoints this is computed as the mean of the input coordinates.\n   297→    For multilinestrings the centroid is weighted by the length of each\n   298→    line segment. For multipolygons the centroid is weighted by the area of\n   299→    each polygon.\n   300→\n   301→    Parameters\n   302→    ----------\n   303→    geometry : Geometry or array_like\n   304→        Geometry or geometries for which to compute the centroid.\n   305→    **kwargs\n   306→        See :ref:`NumPy ufunc docs <ufuncs.kwargs>` for other keyword arguments.\n   307→\n   308→    Examples\n   309→    --------\n   310→    >>> from shapely import LineString, MultiPoint, Polygon\n   311→    >>> centroid(Polygon([(0, 0), (10, 0