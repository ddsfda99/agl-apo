turn\n   311\u2192\n   312\u2192        # Set default domains\n   313\u2192        domains = {**EMPTY_DOMAINS, **domains}\n   314\u2192\n   315\u2192        # Check domains don't clash\n   316\u2192        for level, dom in domains.items():\n   317\u2192            if level not in DOMAIN_LEVELS:\n   318\u2192                raise pybamm.DomainError(\n   319\u2192                    f\"Domain keys must be one of '{DOMAIN_LEVELS}'\"\n   320\u2192                )\n   321\u2192            if isinstance(dom, str):\n   322\u2192                domains[level] = [dom]\n   323\u2192\n   324\u2192        values = [tuple(val) for val in domains.values() if val != []]\n   325\u2192        if len(set(values)) != len(values):\n   326\u2192            raise pybamm.DomainError(\"All domains must be different\")\n   327\u2192\n   328\u2192        for i, level in enumerate(DOMAIN_LEVELS[:-1]):\n   329\u2192            if domains[level] == []:\n   330\u2192                if domains[DOMAIN_LEVELS[i + 1]] != []:\n   331\u2192                    raise pybamm.DomainError(\"Domain levels must be filled in order\")\n   332\u2192                # don't test further if we have already found a missing domain\n   333\u2192                break\n   334\u2192\n   335\u2192        self._domains = domains\n   336\u2192        self.set_id()\n   337\u2192\n   338\u2192    @property\n   339\u2192    def domain(self):\n   340\u2192        \"\"\"\n   341\u2192        list of applicable domains.\n   342\u2192\n   343\u2192        Returns\n   344\u2192        -------\n   345\u2192            iterable of str\n   346\u2192        \"\"\"\n   347\u2192        return self._domains[\"primary\"]\n   348\u2192\n   349\u2192    @domain.setter\n   350\u2192    def domain(self, domain):\n   351\u2192        raise NotImplementedError(\n   352\u2192            \"Cannot set domain directly, use domains={'primary': domain} instead\"\n   353\u2192        )\n   354\u2192\n   355\u2192    @property\n   356\u2192    def auxiliary_domains(self):\n   357\u2192        \"\"\"Returns auxiliary domains.\"\"\"\n   358\u2192        raise NotImplementedError(\n   359\u2192            \"symbol.auxiliary_domains has been deprecated, use symbol.domains instead\"\n   360\u2192        )\n   361\u2192\n   362\u2192    @property\n   363\u2192    def secondary_domain(self):\n   364\u2192        \"\"\"Helper function to get the secondary domain of a symbol.\"\"\"\n   365\u2192        return self._domains[\"secondary\"]\n   366\u2192\n   367\u2192    @property\n   368\u2192    def tertiary_domain(self):\n   369\u2192        \"\"\"Helper function to get the tertiary domain of a symbol.\"\"\"\n   370\u2192        return self._domains[\"tertiary\"]\n   371\u2192\n   372\u2192    @property\n   373\u2192    def quaternary_domain(self):\n   374\u2192        \"\"\"Helper function to get the quaternary domain of a symbol.\"\"\"\n   375\u2192        return self._domains[\"quaternary\"]\n   376\u2192\n   377\u2192    def copy_domains(self, symbol: Symbol):\n   378\u2192        \"\"\"Copy the domains from a given symbol, bypassing checks.\"\"\"\n   379\u2192        if self._domains != symbol._domains:\n   380\u2192            self._domains = symbol._domains\n   381\u2192            self.set_id()\n   382\u2192\n   383\u2192    def clear_domains(self):\n   384\u2192        \"\"\"Clear domains, bypassing checks.\"\"\"\n   385\u2192        if self._domains != EMPTY_DOMAINS:\n   386\u2192            self._domains = EMPTY_DOMAINS\n   387\u2192            self.set_id()\n   388\u2192\n   389\u2192    def get_children_domains(self, children: Sequence[Symbol]):\n   390\u2192        \"\"\"Combine domains from children, at all levels.\"\"\"\n   391\u2192        domains: dict = {}\n   392\u2192        for child in children:\n   393\u2192            for level in child.domains.keys():\n   394\u2192                if child.domains[level] == []:\n   395\u2192                    pass\n   396\u2192                elif (\n   397\u2192                    level not in domains\n   398\u2192                    or domains[level] == []\n   399\u2192                    or child.domains[level] == domains[level]\n   400\u2192                ):\n   401\u2192                    domains[level] = child.domains[level]\n   402\u2192                else:\n   403\u2192                    raise pybamm.DomainError(\n   404\u2192                        \"children must have same or empty domains, \"\n   405\u2192                        f\"not {domains[level]} and {child.domains[level]}\"\n   406\u2192                    )\n   407\u2192\n   408\u2192        return domains\n   409\u2192\n   410\u2192    def read_domain_or_domains(\n   411\u2192        self,\n   412\u2192        domain: DomainType,\n   413\u2192        auxiliary_domains: AuxiliaryDomainType,\n   414\u2192        domains: DomainsType,\n   415\u2192    ):\n   416\u2192        if domains is None:\n   417\u2192            if isinstance(domain, str):\n   418\u2192                domain = [domain]\n   419\u2192            elif domain is None:\n   420\u2192                domain = []\n   421\u2192            auxiliary_domains = auxiliary_domains or {}\n   422\u2192\n   423\u2192            domains = {\"primary\": domain, **auxiliary_domains}\n   424\u2192        else:\n   425\u2192            if domain is not None:\n   426\u2192                raise ValueError(\"Only one of 'domain' or 'domains' should be provided\")\n   427\u2192            if auxiliary_domains is not None:\n   428\u2192                raise ValueError(\n   429\u2192                    \"Only one of 'auxiliary_domains' or 'domains' should be provided\"\n   430\u2192                )\n   431\u2192        return domains\n   432\u2192\n   433\u2192    @property\n   434\u2192    def id(self):\n   435\u2192        return self._id\n   436\u2192\n   437\u2192    def set_id(self):\n   438\u2192        \"\"\"\n   439\u2192        Set the immutable \"identity\" of a variable (e.g. for identifying y