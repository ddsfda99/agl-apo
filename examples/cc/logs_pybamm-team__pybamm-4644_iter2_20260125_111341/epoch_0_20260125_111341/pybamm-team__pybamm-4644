        A dictionary that contains information about the size and location of\n    26→        the tabs\n    27→    \"\"\"\n    28→\n    29→    def __init__(self, edges, coord_sys, tabs):\n    30→        skfem = import_optional_dependency(\"skfem\")\n    31→        self.edges = edges\n    32→        self.nodes = dict.fromkeys([\"y\", \"z\"])\n    33→        for var in self.nodes.keys():\n    34→            self.nodes[var] = (self.edges[var][1:] + self.edges[var][:-1]) / 2\n    35→        self.npts = len(self.edges[\"y\"]) * len(self.edges[\"z\"])\n    36→        self.coord_sys = coord_sys\n    37→\n    38→        # save tabs for serialisation\n    39→        self.tabs = tabs\n    40→\n    41→        # create mesh\n    42→        self.fem_mesh = skfem.MeshTri.init_tensor(self.edges[\"y\"], self.edges[\"z\"])\n    43→\n    44→        # get coordinates (returns a vector size 2*(Ny*Nz))\n    45→        self.coordinates = self.fem_mesh.p\n    46→\n    47→        # create elements and basis\n    48→        self.element = skfem.ElementTriP1()\n    49→        self.basis = skfem.InteriorBasis(self.fem_mesh, self.element)\n    50→        self.facet_basis = skfem.FacetBasis(self.fem_mesh, self.element)\n    51→\n    52→        # get degrees of freedom and facets which correspond to tabs, and\n    53→        # create facet basis for sub regions\n    54→        self.negative_tab_dofs = self.basis.get_dofs(\n    55→            lambda x: self.on_boundary(x[0], x[1], tabs[\"negative\"])\n    56→        ).all()\n    57→        self.positive_tab_dofs = self.basis.get_dofs(\n    58→            lambda x: self.on_boundary(x[0], x[1], tabs[\"positive\"])\n    59→        ).all()\n    60→        self.negative_tab_facets = self.fem_mesh.facets_satisfying(\n    61→            lambda x: self.on_boundary(x[0], x[1], tabs[\"negative\"])\n    62→        )\n    63→        self.positive_tab_facets = self.fem_mesh.facets_satisfying(\n    64→            lambda x: self.on_boundary(x[0], x[1], tabs[\"positive\"])\n    65→        )\n    66→        self.negative_tab_basis = skfem.FacetBasis(\n    67→            self.fem_mesh, self.element, facets=self.negative_tab_facets\n    68→        )\n    69→        self.positive_tab_basis = skfem.FacetBasis(\n    70→            self.fem_mesh, self.element, facets=self.positive_tab_facets\n    71→        )\n    72→\n    73→    def read_lims(self, lims):\n    74→        # Separate limits and tabs\n    75→        # Read and remove tabs. If \"tabs\" is not a key in \"lims\", then tabs is set to\n    76→        # \"None\" and nothing is removed from lims\n    77→        tabs = lims.pop(\"tabs\", None)\n    78→\n    79→        # check that two variables have been passed in\n    80→        if len(lims) != 2:\n    81→            raise pybamm.GeometryError(\n    82→                f\"lims should contain exactly two variables, not {len(lims)}\"\n    83→            )\n    84→\n    85→        # get spatial variables\n    86→        spatial_vars = list(lims.keys())\n    87→\n    88→        for i, var in enumerate(spatial_vars):\n    89→            if isinstance(var, str):\n    90→                spatial_vars[i] = getattr(pybamm.standard_spatial_vars, var)\n    91→\n    92→        # check coordinate system agrees\n    93→        if spatial_vars[0].coord_sys != spatial_vars[1].coord_sys:\n    94→            raise pybamm.DomainError(\n    95→                \"spatial variables should have the same coordinate system, \"\n    96→                f\"but have coordinate systems {spatial_vars[0].coord_sys} and {spatial_vars[1].coord_sys}\"\n    97→            )\n    98→        return spatial_vars, tabs\n    99→\n   100→    def on_boundary(self, y, z, tab):\n   101→        \"\"\"\n   102→        A method to get the degrees of freedom corresponding to the subdomains\n   103→        for the tabs.\n   104→        \"\"\"\n   105→\n   106→        l_y = self.edges[\"y\"][-1]\n   107→        l_z = self.edges[\"z\"][-1]\n   108→\n   109→        def near(x, point, tol=3e-16):\n   110→            return abs(x - point) < tol\n   111→\n   112→        def between(x, interval, tol=3e-16):\n   113→            return x > interval[0] - tol and x < interval[1] + tol\n   114→\n   115→        # Tab on top\n   116→        if near(tab[\"z_centre\"], l_z):\n   117→            tab_left = tab[\"y_centre\"] - tab[\"width\"] / 2\n   118→            tab_right = tab[\"y_centre\"] + tab[\"width\"] / 2\n   119→            return [\n   120→                near(Z, l_z) and between(Y, [tab_left, tab_right]) for Y, Z in zip(y, z)\n   121→            ]\n   122→        # Tab on bottom\n   123→        elif near(tab[\"z_centre\"], 0):\n   124→            tab_left = tab[\"y_centre\"] - tab[\"width\"] / 2\n   125→            tab_right = tab[\"y_centre\"] + tab[\"width\"] / 2\n   126→            return [\n   127→                near(Z, 0) and between(Y, [tab_left, tab_right]) for Y, Z in zip(y, z)\n   128→            ]\n   129→        # Tab on left\n   130→        elif near(tab[\"y_centre\"], 0):\n   131→            tab_bottom = tab[\"z_centre\"] - tab[\"width\"] / 2\n   132→            tab_top = tab[\"z_centre\"] + tab[\"width\"] / 2\n   133→            return [\n   134→                near(Y, 0) and between(Z, [tab_bottom, tab_top]) for Y, Z in zip(y, z)\n   135→            ]\n   136→        # Tab on right\n   137→        elif near(tab[\"y_centre\"], l_y):\n   138→            tab_bottom = tab[\"z_centre\"] - tab[\"width\"] / 2\n   139→            tab_top = tab[\"z_centre\"] + tab[\"width\"] / 2\n   140→            return [\n   141→                near(Y, l_y) and between(Z, [tab_bottom, tab_top]) for Y, Z in zip(y, z)\n   142→            ]\n   143→        else:\n   144→            raise pybamm.GeometryError(\"tab location not valid\")\n   145→\n   146→    def to_json(self):\n   147→        json_dict = {\n   148→            \"edges\": {k: v.tolist() for k, v in self.edges.items()},\n   149→            \"coord_sys\": self.coord_sys,\n   150→         