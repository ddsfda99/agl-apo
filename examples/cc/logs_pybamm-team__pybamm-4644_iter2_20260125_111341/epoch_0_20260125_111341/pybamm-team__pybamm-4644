s only allows for the use of piecewise-linear triangular\n   285\u2192    finite elements.\n   286\u2192\n   287\u2192    Parameters\n   288\u2192    ----------\n   289\u2192    lims : dict\n   290\u2192        A dictionary that contains the limits of each\n   291\u2192        spatial variable\n   292\u2192    npts : dict\n   293\u2192        A dictionary that contains the number of points to be used on each\n   294\u2192        spatial variable\n   295\u2192    \"\"\"\n   296\u2192\n   297\u2192    def __init__(self, lims, npts):\n   298\u2192        spatial_vars, tabs = self.read_lims(lims)\n   299\u2192        coord_sys = spatial_vars[0].coord_sys\n   300\u2192\n   301\u2192        # compute edges\n   302\u2192        edges = {}\n   303\u2192        for var in spatial_vars:\n   304\u2192            if var.name not in [\"y\", \"z\"]:\n   305\u2192                raise pybamm.DomainError(\n   306\u2192                    f\"spatial variable must be y or z not {var.name}\"\n   307\u2192                )\n   308\u2192            else:\n   309\u2192                # Create N Chebyshev nodes in the interval (a,b)\n   310\u2192                N = npts[var.name] - 2\n   311\u2192                ii = np.array(range(1, N + 1))\n   312\u2192                a = lims[var.name][\"min\"]\n   313\u2192                b = lims[var.name][\"max\"]\n   314\u2192                x_cheb = (a + b) / 2 + (b - a) / 2 * np.cos(\n   315\u2192                    (2 * ii - 1) * np.pi / 2 / N\n   316\u2192                )\n   317\u2192\n   318\u2192                # Append the boundary nodes. Note: we need to flip the order the\n   319\u2192                # Chebyshev nodes as they are created in descending order.\n   320\u2192                edges[var.name] = np.concatenate(([a], np.flip(x_cheb), [b]))\n   321\u2192\n   322\u2192        super().__init__(edges, coord_sys, tabs)\n   323\u2192\n   324\u2192\n   325\u2192class UserSupplied2DSubMesh(ScikitSubMesh2D):\n   326\u2192    \"\"\"\n   3