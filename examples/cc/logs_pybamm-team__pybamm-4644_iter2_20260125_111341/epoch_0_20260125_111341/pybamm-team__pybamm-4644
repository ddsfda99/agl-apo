6→    else:\n    57→        size = sum(hash(dom) % 100 for dom in domain)\n    58→    return size\n    59→\n    60→\n    61→def create_object_of_size(size: int, typ=\"vector\"):\n    62→    \"\"\"Return object, consisting of NaNs, of the right shape.\"\"\"\n    63→    if typ == \"vector\":\n    64→        return np.nan * np.ones((size, 1))\n    65→    elif typ == \"matrix\":\n    66→        return np.nan * np.ones((size, size))\n    67→\n    68→\n    69→def evaluate_for_shape_using_domain(domains: dict[str, list[str] | str], typ=\"vector\"):\n    70→    \"\"\"\n    71→    Return a vector of the appropriate shape, based on the domains.\n    72→    Domain 'sizes' can clash, but are unlikely to, and won't cause failures if they do.\n    73→    \"\"\"\n    74→    if isinstance(domains, dict):\n    75→        _domain_sizes = int(np.prod([domain_size(dom) for dom in domains.values()]))\n    76→    else:\n    77→        _domain_sizes = domain_size(domains)\n    78→    return create_object_of_size(_domain_sizes, typ)\n    79→\n    80→\n    81→def is_constant(symbol: Symbol):\n    82→    return isinstance(symbol, numbers.Number) or symbol.is_constant()\n    83→\n    84→\n    85→def is_scalar_x(expr: Symbol, x: int):\n    86→    \"\"\"\n    87→    Utility function to test if an expression evaluates to a constant scalar value\n    88→    \"\"\"\n    89→    if is_constant(expr):\n    90→        result = expr.evaluate_ignoring_errors(t=None)\n    91→        return isinstance(result, numbers.Number) and result == x\n    92→    else:\n    93→        return False\n    94→\n    95→\n    96→def is_scalar_zero(expr: Symbol):\n    97→    \"\"\"\n    98→    Utility function to test if an expression evaluates to a constant scalar zero\n    99→    \"\"\"\n   100→    return is_scalar_x(expr, 0)\n   101→\n   102→\n   103→def is_scalar_one(expr: Symbol):\n   104→    \"\"\"\n   105→    Utility function to test if an expression evaluates to a constant scalar one\n   106→    \"\"\"\n   107→    return is_scalar_x(expr, 1)\n   108→\n   109→\n   110→def is_scalar_minus_one(expr: Symbol):\n   111→    \"\"\"\n   112→    Utility function to test if an expression evaluates to a constant scalar minus one\n   113→    \"\"\"\n   114→    return is_scalar_x(expr, -1)\n   115→\n   116→\n   117→def is_matrix_x(expr: Symbol, x: int):\n   118→    \"\"\"\n   119→    Utility function to test if an expression evaluates to a constant matrix value\n   120→    \"\"\"\n   121→    if isinstance(expr, pybamm.Broadcast):\n   122→        return is_scalar_x(expr.child, x) or is_matrix_x(expr.child, x)\n   123→\n   124→    if is_constant(expr):\n   125→        result = expr.evaluate_ignoring_errors(t=None)\n   126→        return (\n   127→            issparse(result)\n   128→            and (\n   129→                (x == 0 and np.prod(len(result.__dict__[\"data\"])) == 0)\n   130→                or (\n   131→                    len(result.__dict__[\"data\"]) == np.prod(result.shape)\n   132→                    and np.all(result.__dict__[\"data\"] == x)\n   133→                )\n   134→            )\n   135→        ) or (isinstance(result, np.ndarray) and np.all(result == x))\n   136→    else:\n   137→        return False\n   138→\n   139→\n   140→def is_matrix_zero(expr: Symbol):\n   141→    \"\"\"\n   142→    Utility function to test if an expression evaluates to a constant matrix zero\n   143→    \"\"\"\n   144→    return is_matrix_x(expr, 0)\n   145→\n   146→\n   147→def is_matrix_one(expr: Symbol):\n   148→    \"\"\"\n   149→    Utility function to test if an expression evaluates to a constant matrix one\n   150→    \"\"\"\n   151→    return is_matrix_x(expr, 1)\n   152→\n   153→\n   154→def is_matrix_minus_one(expr: Symbol):\n   155→    \"\"\"\n   156→    Utility function to test if an expression evaluates to a constant matrix minus one\n   157→    \"\"\"\n   158→    return is_matrix_x(expr, -1)\n   159→\n   160→\n   161→def simplify_if_constant(symbol: pybamm.Symbol):\n   162→    \"\"\"\n   163→    Utility function to simplify an expression tree if it evalutes to a constant\n   164→    scalar, vector or matrix\n   165→    \"\"\"\n   166→    if symbol.is_constant():\n   167→        result = symbol.evaluate_ignoring_errors()\n   168→        if result is not None:\n   169→            if (\n   170→                isinstance(result, numbers.Number)\n   171→                or (isinstance(result, np.ndarray) and result.ndim == 0)\n   172→                or isinstance(result, np.bool_)\n   173→            ):\n   174→                # type-narrow for Scalar\n   175→                new_result = cast(float, result)\n   176→                return pybamm.Scalar(new_result)\n   177→            elif isinstance(result, np.ndarray) or issparse(result):\n   178→                if result.ndim == 1 or result.shape[1] == 1:\n   179→                    return pybamm.Vector(result, domains=symbol.domains)\n   180→                else:\n   181→                    # Turn matrix of zeros into sparse matrix\n   182→                    if isinstance(result, np.ndarray) and np.all(result == 0):\n   183→                        result = csr_matrix(result)\n   184→                    return pybamm.Matrix(result, domains=symbol.domains)\n   185→\n   186→    return symbol\n   187→\n   188→\n   189→class Symbol:\n   190→    \"\"\"\n   191→    Base node class for the expression tree.\n   192→\n   193→    Parameters\n   194→    ----------\n   195→\n   196→    name : str\n   197→        name for the node\n   198→    children : iterable :class:`Symbol`, optional\n   199→        children to attach to this node, default to an empty list\n   200→    domain : iterable of str, or str\n   201→        list of domains over which the node is valid (empty list indicates the symbol\n   202→        is valid over all domains)\n   203→    auxiliary_domains : dict of str\n   204→        dictionary of auxiliary domains over which the node is valid (empty dictionary\n   205→        indicates no auxiliary domains). Keys can be \"secondary\", \"tertiary\" or\n   206→        \"quaternary\". The symbol is broadcast over its auxiliary domains.\n   207→        For example, a symbol might have domain \"negative particle\", secondary domain\n   208→        \"separator\" and tertiary domain \"current collector\" (`domain=\"negative\n   209→        particle\", auxiliary_domains={\"secondary\": \"separator\", \"tertiary\": \"current\n   210→        collector\"}`).\n   211→    domains : dict\n   212→        A dictionary equivalent to {'primary': domain, auxiliary_domains}. Either\n   213→        'domain' and 'auxiliary_domains', or just 'domains', should be provided\n   214→        (not both). In future, the 'domain' and 'auxiliary_domains' arguments may be\n   215→        deprecated.\n   216→    \"\"\"\n   217→\n   218→    def __init__(\n   219→        self,\n   220→        name: str,\n   221→        children: Sequence[Symbol] | None = None,\n   222→        domain: DomainType = None,\n   223→        auxiliary_domains: AuxiliaryDomainType = None,\n   224→        domains: DomainsType = None,\n   225→    ):\n   226→        super().__init__()\n   227→        self.name = name\n   228→\n   229→        if children is None:\n   230→            children = []\n   231→\n   232→        self._children = children\n   233→        # Keep a separate \"orphans\" attribute for backwards compatibility\n   234→        self._orphans = children\n   235→\n   236→        # Set domains (and hence id)\n   237→        self.domains = self.read_domain_or_domains(domain, auxiliary_domains, domains)\n   238→\n   239→        self._saved_evaluates_on_edges: dict = {}\n   240→        self._print_name = None\n   241→\n   242→        # Test shape on everything but nodes that contain the base Symbol class or\n   243→        # the base BinaryOperator class\n   244→        if pybamm.settings.debug_mode is True:\n   245→            if not any(\n   246→                issubclass(pybamm.Symbol, type(x))\n   247→                or issubclass(pybamm.BinaryOperator, type(x))\n   248→                for x in self.pre_order()\n   249→            ):\n   250→                self.test_shape()\n   251→\n   252→    @classmethod\n   253→    def _from_json(cls, snippet: dict):\n   254→        \"\"\"\n   255→        Reconstructs a Symbol instance during deserialisation of a JSON file.\n   256→\n   257→        Parameters\n   258→        ----------\n   259→        snippet: dict\n   260→            Contains the information needed to reconstruct a specific instance.\n   261→            At minimum, should contain \"name\", \"children\" and \"domains\".\n   262→        \"\"\"\n   263→\n   264→        return cls(\n   265→            snippet[\"name\"], children=snippet[\"children\"], domains=snippet[\"domains\"]\n   266→        )\n   267→\n   268→    @property\n   269→    def children(self):\n   270→        \"\"\"\n   271→        returns the cached children of this node.\n   272→\n   273→        Note: it is assumed that children of a node are not modified after initial\n   274→        creation\n   275→        \"\"\"\n   276→        return self._children\n   277→\n   278→    @property\n   279→    def name(self):\n   280→        \"\"\"name of the node.\"\"\"\n   281→        return self._name\n   282→\n   283→    @name.setter\n   284→    def name(self, value: str):\n   285→        if not isinstance(value, str):\n   286→            raise TypeError(f\"{value} must be of type str\")\n   287→        self._name = value\n   288→\n   289→    @property\n   290→    def domains(self):\n   291→        return self._domains\n   292→\n   293→    @domains.setter\n   294→    def domains(self, domains):\n   295→        try:\n   296→            if (\n   297→                self._domains == domains\n   298→                # accounting for empty domains\n   299→                or {k: v for k, v in self._domains.items() if v != []} == domains\n   300→            ):\n   301→                return  # no change\n   302→        except AttributeError:\n   303→            # self._domains has not been set yet\n   304→            pass\n   305→\n   306→        # Turn dictionary into appropriate form\n   307→        if domains == {\"primary\": []}:\n   308→            self._domains = EMPTY_DOMAINS\n   309→            self.set_id()\n   310→            return\n   311→\n   312→        # Set default domains\n   313→        domains = {**EMPTY_DOMAINS, **domains}\n   314→\n   315→        # Check domains don't clash\n   316→        for level, dom in domains.items():\n   317→            if level not in DOMAIN_LEVELS:\n   318→                raise pybamm.DomainError(\n   319→                    f\"Domain keys must be one of '{DOMAIN_LEVELS}'\"\n   320→                )\n   321→            if isinstance(dom, str):\n   322→                domains[level] = [dom]\n   323→\n   324→        values = [tuple(val) for val in domains.values() if val != []]\n   325→        if len(set(values)) != len(values):\n   326→            raise pybamm.DomainError(\"All domains must be different\")\n   327→\n   328→        for i, level in enumerate(DOMAIN_LEVELS[:-1]):\n   329→            if domains[level] == []:\n   330→                if domains[DOMAIN_LEVELS[i + 1]] != []:\n   331→                    raise pybamm.DomainError(\"Domain levels must be filled in order\")\n   332→                # don't test further if we have already found a missing domain\n   333→                break\n   334→\n   335→        self._domains = domains\n   336→        self.set_id()\n   337→\n   338→    @property\n   339→    def domain(self):\n   340→        \"\"\"\n   341→        list of applicable domains.\n   342→\n   343→        Returns\n   344→        -------\n   345→            iterable of str\n   346→        \"\"\"\n   347→        return self._domains[\"primary\"]\n   348→\n   349→    @domain.setter\n   350→    def domain(self, domain):\n   351→        raise NotImplementedError(\n   352→            \"Cannot set domain directly, use domains={'primary': domain} instead\"\n   353→        )\n   354→\n   355→    @property\n   356→    def auxiliary_domains(self):\n   357→        \"\"\"Returns auxiliary domains.\"\"\"\n   358→        raise NotImplementedError(\n   359→            \"symbol.auxiliary_domains has been deprecated, use symbol.domains instead\"\n   360→        )\n   361→\n   362→    @property\n   363→    def secondary_domain(self):\n   364→        \"\"\"Helper function to get the secondary domain of a symbol.\"\"\"\n   365→        return self._domains[\"secondary\"]\n   366→\n   367→    @property\n   368→    def tertiary_domain(self):\n   369→        \"\"\"Helper function to get the tertiary domain of a symbol.\"\"\"\n   370→        return self._domains[\"tertiary\"]\n   371→\n   372→    @property\n   373→    def quaternary_domain(self):\n   374→        \"\"\"Helper function to get the quaternary domain of a symbol.\"\"\"\n   375→        return self._domains[\"quaternary\"]\n   376→\n   377→    def copy_domains(self, symbol: Symbol):\n   378→        \"\"\"Copy the domains from a given symbol, bypassing checks.\"\"\"\n   379→        if self._domains != symbol._domains:\n   380→            self._domains = symbol._domains\n   381→            self.set_id()\n   382→\n   383→    def clear_domains(self):\n   384→        \"\"\"Clear domains, bypassing checks.\"\"\"\n   385→        if self._domains != EMPTY_DOMAINS:\n   386→            self._domains = EMPTY_DOMAINS\n   387→            self.set_id()\n   388→\n   389→    def get_children_domains(self, children: Sequence[Symbol]):\n   390→        \"\"\"Combine domains from children, at all levels.\"\"\"\n   391→        domains: dict = {}\n   392→        for child in children:\n   393→            for level in child.domains.keys():\n   394→                if child.domains[level] == []:\n   395→                    pass\n   396→                elif (\n   397→                    level not in domains\n   398→                    or domains[level] == []\n   399→                    or child.domains[level] == domains[level]\n   400→                ):\n   401→                    domains[level] = child.domains[level]\n   402→                else:\n   403→                    raise pybamm.DomainError(\n   404→                        \"children must have same or empty domains, \"\n   405→                        f\"not {domains[level]} and {child.domains[level]}\"\n   406→                    )\n   407→\n   408→        return domains\n   409→\n   410→    def read_domain_or_domains(\n   411→        self,\n   412→        domain: DomainType,\n   413→        auxiliary_domains: AuxiliaryDomainType,\n   414→        domains: DomainsType,\n   415→    ):\n   416→        if domains is None:\n   417→            if isinstance(domain, str):\n   418→                domain = [domain]\n   419→            elif domain is None:\n   420→                domain = []\n   421→            auxiliary_domains = auxiliary_domains or {}\n   422→\n   423→            domains = {\"primary\": domain, **auxiliary_domains}\n   424→        else:\n   425→            if domain is not None:\n   426→                raise ValueError(\"Only one of 'domain' or 'domains' should be provided\")\n   427→            if auxiliary_domains is not None:\n   428→                raise ValueError(\n   429→                    \"Only one of 'auxiliary_domains' or 'domains' should be provided\"\n   430→                )\n   431→        return domains\n   432→\n   433→    @property\n   434→    def id(self):\n   435→        return self._id\n   436→\n   437→    def set_id(self):\n   438→        \"\"\"\n   439→        Set the immutable \"identity\" of a variable (e.g. for identifying y_slices).\n   440→\n   441→        Hashing can be slow, so we set the id when we create the node, and hence only\n   442→        need to hash once.\n   443→        \"\"\"\n   444→        self._id = hash(\n   445→            (\n   446→                self.__class__,\n   447→                self.name,\n   448→                *tuple([child.id for child in self.children]),\n   449→                *tuple([(k, tuple(v)) for k, v in self.domains.items() if v != []]),\n   450→            )\n   451→        )\n   452→\n   453→    @property\n   454→    def scale(self):\n   455→        return self._scale\n   456→\n   457→    @property\n   458→    def reference(self):\n   459→        return self._reference\n   460→\n   461→    def __eq__(self, other):\n   462→        try:\n   463→            return self._id == other._id\n   464→        except AttributeError:\n   465→            if isinstance(other, numbers.Number):\n   466→                return self._id == pybamm.Scalar(other)._id\n   467→            else:\n   468→                return False\n   469→\n   470→    def __hash__(self):\n   471→        return self._id\n   472→\n   473→    @property\n   474→    def orphans(self):\n   475→        \"\"\"\n   476→        Returning new copies of the children, with parents removed to avoid corrupting\n   477→        the expression tree internal data\n   478→        \"\"\"\n   479→        return self._orphans\n   480→\n   481→    def render(self):  # pragma: no cover\n   482→        \"\"\"\n   483→        Print out a visual representation of the tree (this node and its children)\n   484→        \"\"\"\n   485→        anytree = import_optional_dependency(\"anytree\")\n   486→        for pre, _, node in anytree.RenderTree(self):\n   487→            if isinstance(node, pybamm.Scalar) and node.name != str(node.value):\n   488→                print(f\"{pre}{node.name} = {node.value}\")\n   489→            else:\n   490→                print(f\"{pre}{node.name}\")\n   491→\n   492→    def visualise(self, filename: str):\n   493→        \"\"\"\n   494→        Produces a .png file of the tree (this node and its children) with the\n   495→        name filename\n   496→\n   497→        Parameters\n   498→        ----------\n   499→\n   500→        filename : str\n   501→            filename to output, must end in \".png\"\n   502→        \"\"\"\n   503→\n   504→        DotExporter = import_optional_dependency(\"anytree.exporter\", \"DotExporter\")\n   505→        # check that filename ends in .png.\n   506→        if filename[-4:] != \".png\":\n   507→            raise ValueError(\"filename should end in .png\")\n   508→\n   509→        new_node, counter = self.relabel_tree(self, 0)\n   510→\n   511→        try:\n   512→            DotExporter(\n   513→                new_node, nodeattrfunc=lambda node: f'label=\"{node.label}\"'\n   514→            ).to_picture(filename)\n   515→        except FileNotFoundError:  # pragma: no cover\n   516→            # raise error but only through logger so that test passes\n   517→            pybamm.logger.error(\"Please install graphviz>=2.42.2 to use dot exporter\")\n   518→\n   519→    def relabel_tree(self, symbol: Symbol, counter: int):\n   520→        \"\"\"\n   521→        Finds all children of a symbol and assigns them a new id so that they can be\n   522→        visualised properly using the graphviz output\n   523→        \"\"\"\n   524        anytree = import_optional_dependency(\"anytree\")\n   525→        name = symbol.name\n   526→        if name == \"div\":\n   527→            name = \"&nabla;&sdot;\"\n   528→        elif name == \"grad\":\n   529→            name = \"&nabla;\"\n   530→        elif name == \"/\":\n   531→            name = \"&divide;\"\n   532→        elif name == \"*\":\n   533→            name = \"&times;\"\n   534→        elif name == \"-\":\n   535→            name = \"&minus;\"\n   536→        elif name == \"+\":\n   537→            name = \"&#43;\"\n   538→        elif name == \"**\":\n   539→            name = \"^\"\n   540→\n   541→        new_node = anytree.Node(str(counter), label=name)\n   542→        counter += 1\n   543→\n   544→        new_children = []\n   545→        for child in symbol.children:\n   546→            new_child, counter = self.relabel_tree(child, counter)\n   547→            new_children.append(new_child)\n   548→        new_node.children = new_children\n   549→\n   550→        return new_node, counter\n   551→\n   552→    def pre_order(self):\n   553→        \"\"\"\n   554→        returns an iterable that steps through the tree in pre-order fashion.\n   555→\n   556→        Examples\n   557→        --------\n   558→\n   559→        >>> a = pybamm.Symbol('a')\n   560→        >>> b = pybamm.Symbol('b')\n   561→        >>> for node in (a*b).pre_order():\n   562→        ...     print(node.name)\n   563→        *\n   564→        a\n   565→        b\n   566→        \"\"\"\n   567→        anytree = import_optional_dependency(\"anytree\")\n   568→        return anytree.PreOrderIter(self)\n   569→\n   570→    def __str__(self):\n   571→        \"\"\"return a string representation of the node and its children.\"\"\"\n   572→        return self._name\n   573→\n   574→    def __repr__(self):\n   575→        \"\"\"returns the string `__class__(id, name, children, domain)`\"\"\"\n   576→        return f\"{self.__class__.__name__!s}({hex(self.id)}, {self._name!s}, children={[str(child) for child in self.children]!s}, domains={({k: v for k, v in self.domains.items() if v != []})!s})\"\n   577→\n   578→    def __add__(self, other: ChildSymbol) -> pybamm.Addition:\n   579→        \"\"\"return an :class:`Addition` object.\"\"\"\n   580→        return pybamm.add(self, other)\n   581→\n   582→    def __radd__(self, other: ChildSymbol) -> pybamm.Addition:\n   583→        \"\"\"return an :class:`Addition` object.\"\"\"\n   584→        return pybamm.add(other, self)\n   585→\n   586→    def __sub__(self, other: ChildSymbol) -> pybamm.Subtraction:\n   587→        \"\"\"return a :class:`Subtraction` object.\"\"\"\n   588→        return pybamm.subtract(self, other)\n   589→\n   590→    def __rsub__(self, other: ChildSymbol) -> pybamm.Subtraction:\n   591→        \"\"\"return a :class:`Subtraction` object.\"\"\"\n   592→        return pybamm.subtract(other, self)\n   593→\n   594→    def __mul__(self, other: ChildSymbol) -> pybamm.Multiplication:\n   595→        \"\"\"return a :class:`Multiplication` object.\"\"\"\n   596→        return pybamm.multiply(self, other)\n   597→\n   598→    def __rmul__(self, other: ChildSymbol) -> pybamm.Multiplication:\n   599→        \"\"\"return a :class:`Multiplication` object.\"\"\"\n   600→        return pybamm.multiply(other, self)\n   601→\n   602→    def __matmul__(self, other: ChildSymbol) -> pybamm.MatrixMultiplication:\n   603→        \"\"\"return a :class:`MatrixMultiplication` object.\"\"\"\n   604→        return pybamm.matmul(self, other)\n   605→\n   606→    def __rmatmul__(self, other: ChildSymbol) -> pybamm.MatrixMultiplication:\n   607→        \"\"\"return a :class:`MatrixMultiplication` object.\"\"\"\n   608→        return pybamm.matmul(other, self)\n   609→\n   610→    def __truediv__(self, other: ChildSymbol) -> pybamm.Division:\n   611→        \"\"\"return a :class:`Division` object.\"\"\"\n   612→        return pybamm.divide(self, other)\n   613→\n   614→    def __rtruediv__(self, other: ChildSymbol) -> pybamm.Division:\n   615→        \"\"\"return a :class:`Division` object.\"\"\"\n   616→        return pybamm.divide(other, self)\n   617→\n   618→    def __pow__(self, other: ChildSymbol) -> pybamm.Power:\n   619→        \"\"\"return a :class:`Power` object.\"\"\"\n   620→        return pybamm.simplified_power(self, other)\n   621→\n   622→    def __rpow__(self, other: Symbol) -> pybamm.Power:\n   623→        \"\"\"return a :class:`Power` object.\"\"\"\n   624→        return pybamm.simplified_power(other, self)\n   625→\n   626→    def __lt__(self, other: Symbol | float) -> pybamm.NotEqualHeaviside:\n   627→        \"\"\"return a :class:`NotEqualHeaviside` object, or a smooth approximation.\"\"\"\n   628→        return pybamm.expression_tree.binary_operators._heaviside(self, other, False)\n   629→\n   630→    def __le__(self, other: Symbol) -> pybamm.Equal