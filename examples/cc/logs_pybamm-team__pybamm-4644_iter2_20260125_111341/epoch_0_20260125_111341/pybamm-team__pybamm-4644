s for the use of piecewise-linear triangular\n   161\u2192    finite elements.\n   162\u2192\n   163\u2192    Parameters\n   164\u2192    ----------\n   165\u2192    lims : dict\n   166\u2192        A dictionary that contains the limits of each\n   167\u2192        spatial variable\n   168\u2192    npts : dict\n   169\u2192        A dictionary that contains the number of points to be used on each\n   170\u2192        spatial variable\n   171\u2192    \"\"\"\n   172\u2192\n   173\u2192    def __init__(self, lims, npts):\n   174\u2192        spatial_vars, tabs = self.read_lims(lims)\n   175\u2192        coord_sys = spatial_vars[0].coord_sys\n   176\u2192\n   177\u2192        # compute edges\n   178\u2192        edges = {}\n   179\u2192        for var in spatial_vars:\n   180\u2192            if var.name not in [\"y\", \"z\"]:\n   181\u2192                raise pybamm.DomainError(\n   182\u2192                    f\"spatial variable must be y or z not {var.name}\"\n   183\u2192                )\n   184\u2192            else:\n   185\u2192                edges[var.name] = np.linspace(\n   186\u2192                    lims[var.name][\"min\"], lims[var.name][\"max\"], npts[var.name]\n   187\u2192                )\n   188\u2192\n   189\u2192        super().__init__(edges, coord_sys, tabs)\n   190\u2192\n   191\u2192    @classmethod\n   192\u2192    def _from_json(cls, snippet: dict):\n   193\u2192        instance = cls.__new__(cls)\n   194\u2192\n   195\u2192        edges = {k: np.array(v) for k, v in snippet[\"edges\"].items()}\n   196\u2192\n   197\u2192        super(ScikitUniform2DSubMesh, instance).__init__(\n   198\u2192            edges, snippet[\"coord_sys\"], snippet[\"tabs\"]\n   199\u2192        )\n   200\u2192\n   201\u2192        return instance\n   202\u2192\n   203\u2192\n   204\u2192class ScikitExponential2DSubMesh(ScikitSubMesh2D):\n   205\u2192    \"\"\"\n   206\u2192    Contains information about the 2D finite element mesh generated by taking the\n   207\u2192    tensor product of a uniformly spaced grid in the y direction, and a unequally\n   208\u2192    spaced grid in the z direction in which the points are clustered\n   209\u2192    close to the top boundary using an exponential formula on the interval [a,b].\n   210\u2192    The gridpoints in the z direction are given by\n   211\u2192\n   212\u2192    .. math::\n   213\u2192        z_{k} = (b-a) + \\\\frac{\\\\exp{-\\\\alpha k / N} - 1}{\\\\exp{-\\\\alpha} - 1} + a,\n   214\u2192\n   215\u2192    for k = 1, ..., N, where N is the number of nodes. Here alpha is\n   216\u2192    a stretching factor. As the number of gridpoints tends to infinity, the ratio\n   217\u2192    of the largest and smallest grid cells tends to exp(alpha).\n   218\u2192\n   219\u2192    Note: in the future this will be extended to allow points to be clustered near\n   220\u2192    any of the boundaries.\n   221\u2192\n   222\u2192    Parameters\n   223\u2192    ----------\n   224\u2192    lims : dict\n   225\u2192        A dictionary that contains the limits of each\n   226\u2192        spatial variable\n   227\u2192    npts : dict\n   228\u2192        A dictionary that contains the number of points to be used on each\n   229\u2192        spatial variable\n   230\u2192    side : str, optional\n   231\u2192        Whether the points are clustered near to a particular boundary. At present,\n   232\u2192        can only be \"top\". Default is \"top\".\n   233\u2192    stretch : float, optional\n   234\u2192        The factor (alpha) which appears in the exponential. Default is 2.3.\n   235\u2192    \"\"\"\n   236\u2192\n   237\u2192    def __init__(self, lims, npts, side=\"top\", stretch=2.3):\n   238\u2192        # check side is top\n   239\u2192        if side != \"top\":\n   240\u2192            raise pybamm.GeometryError(\n   241\u2192                f\"At present, side can only be 'top', but is set to {side}\"\n   242\u2192            )\n   243\u2192\n   244\u2192        spatial_vars, t