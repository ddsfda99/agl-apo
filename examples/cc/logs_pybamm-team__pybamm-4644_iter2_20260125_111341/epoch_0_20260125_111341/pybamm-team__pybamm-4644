:\n   359→                # discrete sum should be observed at the discrete times\n   360→                t = self.time_integral.discrete_times\n   361→            else:\n   362→                # assume we can do a sufficiently accurate trapezoidal integration at t_pts\n   363→                t = self.t_pts\n   364→\n   365→        observe_raw = (t is None) or (\n   366→            np.asarray(t).size == len(self.t_pts) and np.all(t == self.t_pts)\n   367→        )\n   368→\n   369→        if observe_raw:\n   370→            t_observe = self.t_pts\n   371→        elif not isinstance(t, np.ndarray):\n   372→            if not isinstance(t, list):\n   373→                t = [t]\n   374→            t_observe = np.array(t)\n   375→        else:\n   376→            t_observe = t\n   377→\n   378→        if t_observe[0] < self.t_pts[0]:\n   379→            raise ValueError(\n   380→                \"The interpolation points must be greater than or equal to the initial solution time\"\n   381→            )\n   382→\n   383→        return t_observe, observe_raw\n   384→\n   385→    @property\n   386→    def entries(self):\n   387→        \"\"\"\n   388→        Returns the raw data entries of the processed variable. If the processed\n   389→        variable has not been initialized (i.e. the entries have not been\n   390→        calculated), then the processed variable is initialized first.\n   391→        \"\"\"\n   392→        self.initialise()\n   393→        return self._entries_raw\n   394→\n   395→    @property\n   396→    def data(self):\n   397→        \"\"\"Same as entries, but different name\"\"\"\n   398→        return self.entries\n   399→\n   400→    @property\n   401→    def entries_raw_initialized(self):\n   402→        return self._entries_raw is not None\n   403→\n   404→    @property\n   405→    def xr_array_raw_initialized(self):\n   406→        return self._xr_array_raw is not None\n   407→\n   408→    @property\n   409→    def sensitivities(self):\n   410→        \"\"\"\n   411→        Returns a dictionary of sensitivities for each input parameter.\n   412→        The keys are the input parameters, and the value is a matrix of size\n   413→        (n_x * n_t, n_p), where n_x is the number of states, n_t is the number of time\n   414→        points, and n_p is the size of the input parameter\n   415→        \"\"\"\n   416→        # No sensitivities if there are no inputs\n   417→        if len(self.all_inputs[0]) == 0:\n   418→            return {}\n   419→        # Otherwise initialise and return sensitivities\n   420→        if self._sensitivities is None:\n   421→            if self.all_solution_sensitivities:\n   422→                self.initialise_sensitivity_explicit_forward()\n   423→            else:\n   424→                raise ValueError(\n   425→                    \"Cannot compute sensitivities. The 'calculate_sensitivities' \"\n   426→                    \"argument of the solver.solve should be changed from 'None' to \"\n   427→                    \"allow sensitivities calculations. Check solver documentation for \"\n   428→                    \"details.\"\n   429→                )\n   430→        return self._sensitivities\n   431→\n   432→    def initialise_sensitivity_explicit_forward(self):\n   433→        \"Set up the sensitivity dictionary\"\n   434→\n   435→        all_S_var = []\n   436→        for ts, ys, inputs_stacked, inputs, base_variable, dy_dp in zip(\n   437→            self.all_ts,\n   438→            self.all_ys,\n   439→            self.all_inputs_casadi,\n   440→            self.all_inputs,\n   441→            self.base_variables,\n   442→            self.all_solution_sensitivities[\"all\"],\n   443→        ):\n   444→            # Set up symbolic variables\n   445→            t_casadi = casadi.MX.sym(\"t\")\n   446→            y_casadi = casadi.MX.sym(\"y\", ys.shape[0])\n   447→            p_casadi = {\n   448→                name: casadi.MX.sym(name, value.shape[0])\n   449→                for name, value in inputs.items()\n   450→            }\n   451→\n   452→            p_casadi_stacked = casadi.vertcat(*[p for p in p_casadi.values()])\n   453→\n   454→            # Convert variable to casadi format for differentiating\n   455→            var_casadi = base_variable.to_casadi(t_casadi, y_casadi, inputs=p_casadi)\n   456→            dvar_dy = casadi.jacobian(var_casadi, y_casadi)\n   457→            dvar_dp = casadi.jacobian(var_casadi, p_casadi_stacked)\n   458→\n   459→            # Convert to functions and evaluate index-by-index\n   460→            dvar_dy_func = casadi.Function(\n   461→                \"dvar_dy\", [t_casadi, y_casadi, p_casadi_stacked], [dvar_dy]\n   462→            )\n   463→            dvar_dp_func = casadi.Function(\n   464→                \"dvar_dp\", [t_casadi, y_casadi, p_casadi_stacked], [dvar_dp]\n   465→            )\n   466→            for idx, t in enumerate(ts):\n   467→                u = ys[:, idx]\n   468→                next_dvar_dy_eval = dvar_dy_func(t, u, inputs_stacked)\n   469→                next_dvar_dp_eval = dvar_dp_func(t, u, inputs_stacked)\n   470→                if idx == 0:\n   471→                    dvar_dy_eval = next_dvar_dy_eval\n   472→                    dvar_dp_eval = next_dvar_dp_eval\n   473→                else:\n   474→                    dvar_dy_eval = casadi.diagcat(dvar_dy_eval, next_dvar_dy_eval)\n   475→                    dvar_dp_eval = casadi.vertcat(dvar_dp_eval, next_dvar_dp_eval)\n   476→\n   477→            # Compute sensitivity\n   478→            S_var = dvar_dy_eval @ dy_dp + dvar_dp_eval\n   479→            all_S_var.append(S_var)\n   480→\n   481→        S_var = casadi.vertcat(*all_S_var)\n   482→        sensitivities = {\"all\": S_var}\n   483→\n   484→        # Add the individual sensitivity\n   485→        start = 0\n   486→        for name, inp in self.all_inputs[0].items():\n   487→            end = start + inp.shape[0]\n   488→            sensitivities[name] = S_var[:, start:end]\n   489→            start = end\n   490→\n   491→        # Save attribute\n   492→        self._sensitivities = sensitivities\n   493→\n   494→    @property\n   495→    def hermite_interpolation(self):\n   496→        return self.all_yps is not None\n   497→\n   498→\n   499→class ProcessedVariable0D(ProcessedVariable):\n   500→    def __init__(\n   501→        self,\n   502→        base_variables,\n   503→        base_variables_casadi,\n   504→        solution,\n   505→        time_integral: Optional[pybamm.ProcessedVariableTimeIntegral] = None,\n   506→    ):\n   507→        self.dimensions = 0\n   508→        super().__init__(\n   509→            base_variables,\n   510→            base_variables_casadi,\n   511→            solution,\n   512→            time_integral=time_integral,\n   513→        )\n   514→\n   515→    def _observe_raw_python(self):\n   516→        pybamm.logger.debug(\"Observing the variable raw data in Python\")\n   517→        # initialise empty array of the correct size\n   518→        entries = np.empty(self._shape(self.t_pts))\n   519→        idx = 0\n   520→        # Evaluate the base_variable index-by-index\n   521→        for ts, ys, inputs, base_var_casadi in zip(\n   522→            self.all_ts, self.all_ys, self.all_inputs_casadi, self.base_variables_casadi\n   523→        ):\n   524→            for inner_idx, t in enumerate(ts):\n   525→                t = ts[inner_idx]\n   526→                y = ys[:, inner_idx]\n   527→                entries[idx] = float(base_var_casadi(t, y, inputs))\n   528→\n   529→                idx += 1\n   530→        return entries\n   531→\n   532→    def _observe_postfix(self, entries, t):\n   533→        if self.time_integral is None:\n   534→            return entries\n   535→        if self.time_integral.method == \"discrete\":\n   536→            return np.sum(entries, axis=0, initial=self.time_integral.initial_condition)\n   537→        elif self.time_integral.method == \"continuous\":\n   538→            return cumulative_trapezoid(\n   539→                entries, self.t_pts, initial=float(self.time_integral.initial_condition)\n   540→            )\n   541→        else:\n   542→            raise ValueError(\n   543→                \"time_integral method must be 'discrete' or 'continuous'\"\n   544→            )  # pragma: no cover\n   545→\n   546→    def _interp_setup(self, entries, t):\n   547→        # save attributes for interpolation\n   548→        entries_for_interp = entries\n   549→        coords_for_interp = {\"t\": t}\n   550→\n   551→        return entries_for_interp, coords_for_interp\n   552→\n   553→    def _shape(self, t):\n   554→        return [len(t)]\n   555→\n   556→\n   557→class ProcessedVariable1D(ProcessedVariable):\n   558→    \"\"\"\n   559→    An object that can be evaluated at arbitrary (scalars or vectors) t and x, and\n   560→    returns the (interpolated) value of the base variable at that t and x.\n   561→\n   562→    Parameters\n   563→    ----------\n   564→    base_variables : list of :class:`pybamm.Symbol`\n   565→        A list of base variables with a method `evaluate(t,y)`, each entry of which\n   566→        returns the value of that variable for that particular sub-solution.\n   567→        A Solution can be comprised of sub-solutions which are the solutions of\n   568→        different models.\n   569→        Note that this can be any kind of node in the expression tree, not\n   570→        just a :class:`pybamm.Variable`.\n   571→        When evaluated, returns an array of size (m,n)\n   572→    base_variables_casadi : list of :class:`casadi.Function`\n   573→        A list of casadi functions. When evaluated, returns the same thing as\n   574→        `base_Variable.evaluate` (but more efficiently).\n   575→    solution : :class:`pybamm.Solution`\n   576→        The solution object to be used to create the processed variables\n   577→    \"\"\"\n   578→\n   579→    def __init__(\n   580→        self,\n   581→        base_variables,\n   582→        base_variables_casadi,\n   583→        solution,\n   584→        time_integral: Optional[pybamm.ProcessedVariableTimeIntegral] = None,\n   585→    ):\n   586→        self.dimensions = 1\n   587→        super().__init__(\n   588→            base_variables,\n   589→            base_variables_casadi,\n   590→            solution,\n   591→            time_integral=time_integral,\n   592→        )\n   593→\n   594→    def _observe_raw_python(self):\n   595→        pybamm.logger.debug(\"Observing the variable raw data in Python\")\n   596→        entries = np.empty(self._shape(self.t_pts))\n   597→\n   598→        # Evaluate the base_variable index-by-index\n   599→        idx = 0\n   600→        for ts, ys, inputs, base_var_casadi in zip(\n   601→            self.all_ts, self.all_ys, self.all_inputs_casadi, self.base_variables_casadi\n   602→        ):\n   603→            for inner_idx, t in enumerate(ts):\n   604→                t = ts[inner_idx]\n   605→                y = ys[:, inner_idx]\n   606→                entries[:, idx] = base_var_casadi(t, y, inputs).full()[:, 0]\n   607→                idx += 1\n   608→        return entries\n   609→\n   610→    def _interp_setup(self, entries, t):\n   611→        # Get node and edge values\n   612→        nodes = self.mesh.nodes\n   613→        edges = self.mesh.edges\n   614→        if entries.shape[0] == len(nodes):\n   615→            space = nodes\n   616→        elif entries.shape[0] == len(edges):\n   617→            space = edges\n   618→\n   619→        # add points outside domain for extrapolation to boundaries\n   620→        extrap_space_left = np.array([2 * space[0] - space[1]])\n   621→        extrap_space_right = np.array([2 * space[-1] - space[-2]])\n   622→        space = np.concatenate([extrap_space_left, space, extrap_space_right])\n   623→        extrap_entries_left = 2 * entries[0] - entries[1]\n   624→        extrap_entries_right = 2 * entries[-1] - entries[-2]\n   625→        entries_for_interp = np.vstack(\n   626→            [extrap_entries_left, entries, extrap_entries_right]\n   627→        )\n   628→\n   629→        # assign attributes for reference (either x_sol or r_sol)\n   630→        self.spatial_variable_names = {\n   631→            k: self._process_spatial_variable_names(v)\n   632→            for k, v in self.spatial_variables.items()\n   633→        }\n   634→        self.first_dimension = self.spatial_variable_names[\"primary\"]\n   635→\n   636→        # assign attributes for reference\n   637→        pts_for_interp = space\n   638→        self.internal_boundaries = self.mesh.internal_boundaries\n   639→\n   640→        # Set first_dim_pts to edges for nicer plotting\n   641→        self.first_dim_pts = edges\n   642→\n   643→        # save attributes for interpolation\n   644→        coords_for_interp = {self.first_dimension: pts_for_interp, \"t\": t}\n   645→\n   646→        return entries_for_interp, coords_for_interp\n   647→\n   648→    def _shape(self, t):\n   649→        t_size = len(t)\n   650→        space_size = self.base_eval_shape[0]\n   651→        return [space_size, t_size]\n   652→\n   653→\n   654→class ProcessedVariable2D(ProcessedVariable):\n   655→    \"\"\"\n   656→    An object that can be evaluated at arbitrary (scalars or vectors) t and x, and\n   657→    returns the (interpolated) value of the base variable at that t and x.\n   658→\n   659→    Parameters\n   660→    ----------\n   661→    base_variables : list of :class:`pybamm.Symbol`\n   662→        A list of base variables with a method `evaluate(t,y)`, each entry of which\n   663→        returns the value of that variable for that particular sub-solution.\n   664→        A Solution can be comprised of sub-solutions which are the solutions of\n   665→        different models.\n   666→        Note that this can be any kind of node in the expression tree, not\n   667→        just a :class:`pybamm.Variable`.\