   705→        \"\"\"\n   706→        Differentiate a symbol with respect to a variable. For any symbol that can be\n   707→        differentiated, return `1` if differentiating with respect to yourself,\n   708→        `self._diff(variable)` if `variable` is in the expression tree of the symbol,\n   709→        and zero otherwise.\n   710→\n   711→        Parameters\n   712→        ----------\n   713→        variable : :class:`pybamm.Symbol`\n   714→            The variable with respect to which to differentiate\n   715→        \"\"\"\n   716→        if variable == self:\n   717→            return pybamm.Scalar(1)\n   718→        elif any(variable == x for x in self.pre_order()):\n   719→            return self._diff(variable)\n   720→        elif variable == pybamm.t and self.has_symbol_of_classes(\n   721→            (pybamm.VariableBase, pybamm.StateVectorBase)\n   722→        ):\n   723→            return self._diff(variable)\n   724→        else:\n   725→            return pybamm.Scalar(0)\n   726→\n   727→    def _diff(self, variable):\n   728→        \"\"\"\n   729→        Default behaviour for differentiation, overriden by Binary and Unary Operators\n   730→        \"\"\"\n   731→        raise NotImplementedError\n   732→\n   733→    def jac(\n   734→        self,\n   735→        variable: pybamm.Symbol,\n   736→        known_jacs: dict[pybamm.Symbol, pybamm.Symbol] | None = None,\n   737→        clear_domain=True,\n   738→    ):\n   739→        \"\"\"\n   740→        Differentiate a symbol with respect to a (slice of) a StateVector\n   741→        or StateVectorDot.\n   742→        See :class:`pybamm.Jacobian`.\n   743→        \"\"\"\n   744→        jac = pybamm.Jacobian(known_jacs, clear_domain=clear_domain)\n   745→        if not isinstance(variable, (pybamm.StateVector, pybamm.StateVectorDot)):\n   746→            raise TypeError(\n   747→                \"Jacobian can only be taken with respect to a 'StateVector' \"\n   748→                f\"or 'State