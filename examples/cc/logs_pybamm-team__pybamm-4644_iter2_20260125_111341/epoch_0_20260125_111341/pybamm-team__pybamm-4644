  885→    def evaluates_to_number(self):\n   886→        \"\"\"\n   887→        Returns True if evaluating the expression returns a number.\n   888→        Returns False otherwise, including if NotImplementedError or TyperError\n   889→        is raised.\n   890→        !Not to be confused with isinstance(self, pybamm.Scalar)!\n   891→\n   892→        See Also\n   893→        --------\n   894→        evaluate : evaluate the expression\n   895→        \"\"\"\n   896→        return self.shape_for_testing == ()\n   897→\n   898→    def evaluates_to_constant_number(self):\n   899→        return self.evaluates_to_number() and self.is_constant()\n   900→\n   901→    def evaluates_on_edges(self, dimension: str) -> bool:\n   902→        \"\"\"\n   903→        Returns True if a symbol evaluates on an edge, i.e. symbol contains a gradient\n   904→        operator, but not a divergence operator, and is not an IndefiniteIntegral.\n   905→        Caches the solution for faster results.\n   906→\n   907→        Parameters\n   908→        ----------\n   909→        dimension : str\n   910→            The dimension (primary, secondary, etc) in which to query evaluation on\n   911→            edges\n   912→\n   913→        Returns\n   914→        -------\n   915→        bool\n   916→            Whether the symbol evaluates on edges (in the finite volume discretisation\n   917→            sense)\n   918→        \"\"\"\n   919→        if dimension not in self._saved_evaluates_on_edges:\n   920→            self._saved_evaluates_on_edges[dimension] = self._evaluates_on_edges(\n   921→                dimension\n   922→            )\n   923→\n   924→        return self._saved_evaluates_on_edges[dimension]\n   925→\n   926→    def _evaluates_on_edges(self, dimension):\n   927→        # Default behaviour: return False\n   928→        return False\n   929→\n   930→    def has_symbol_of_classes(\n   931→        self, symbol_classes: tuple[type[Symbol], ...] | type[Symbol]\n   932→    ):\n   933→        \"\"\"\n   934→        Returns True if equation has a term of the class(es) `symbol_class`.\n   935→\n   936→        Parameters\n   937→        ----------\n   938→        symbol_classes : pybamm class or iterable of classes\n   939→            The classes to test the symbol against\n   940→        \"\"\"\n   941→        return any(isinstance(symbol, symbol_classes) for symbol in self.pre_order())\n   942→\n   943→    def to_casadi(\n   944→        self,\n   945→        t: casadi.MX | None = None,\n   946→        y: casadi.MX | None = None,\n   947→        y_dot: casadi.MX | None = None,\n   948→        inputs: dict | None = None,\n   949→        casadi_symbols: Symbol | None = None,\n   950→    ):\n   951→        \"\"\"\n   952→        Convert the expression tree to a CasADi expression tree.\n   953→        See :class:`pybamm.CasadiConverter`.\n   954→        \"\"\"\n   955→        return pybamm.CasadiConverter(casadi_symbols).convert(self, t, y, y_dot, inputs)\n   956→\n   957→    def _children_for_copying(self, children: list[Symbol] | None = None) -> Symbol:\n   958→        \"\"\"\n   959→        Gets existing children for a symbol being copied if they aren't provided.\n   960→        \"\"\"\n   961→        if children is None:\n   962→            children = [child.create_copy() for child in self.children]\n   963→        return children\n   964→\n   965→    def create_copy(\n   966→        self,\n   967→        new_children: list[pybamm.Symbol] | None = None,\n   968→        perform_simplifications: bool = True,\n   969→    ):\n   970→        \"\"\"\n   971→        Make a new copy of a symbol, to avoid Tree corruption errors while bypassing\n   972→        copy.deepcopy(), which is slow.\n   973→\n   974→        If new_children are provided, they are used instead of the existing children.\n   975→\n   976→        If `perform_simplifications` = True, some classes (e.g. `BinaryOperator`,\n   977→        `UnaryOperator`, `Concatenation`) will perform sim