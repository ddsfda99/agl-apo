,\n   783→            **kwargs)\n   784→\n   785→\n   786→def list_kube_config_contexts(config_file=None):\n   787→\n   788→    if config_file is None:\n   789→        config_file = KUBE_CONFIG_DEFAULT_LOCATION\n   790→\n   791→    loader = _get_kube_config_loader(filename=config_file)\n   792→    return loader.list_contexts(), loader.current_context\n   793→\n   794→\n   795→def load_kube_config(config_file=None, context=None,\n   796→                     client_configuration=None,\n   797→                     persist_config=True,\n   798→                     temp_file_path=None):\n   799→    \"\"\"Loads authentication and cluster information from kube-config file\n   800→    and stores them in kubernetes.client.configuration.\n   801→\n   802→    :param config_file: Name of the kube-config file.\n   803→    :param context: set the active context. If is set to None, current_context\n   804→        from config file will be used.\n   805→    :param client_configuration: The kubernetes.client.Configuration to\n   806→        set configs to.\n   807→    :param persist_config: If True, config file will be updated when changed\n   808→        (e.g GCP token refresh).\n   809→    :param temp_file_path: store temp files path.\n   810→    \"\"\"\n   811→\n   812→    if config_file is None:\n   813→        config_file = KUBE_CONFIG_DEFAULT_LOCATION\n   814→\n   815→    loader = _get_kube_config_loader(\n   816→        filename=config_file, active_context=context,\n   817→        persist_config=persist_config,\n   818→        temp_file_path=temp_file_path)\n   819→\n   820→    if client_configuration is None:\n   821→        config = type.__call__(Configuration)\n   822→        loader.load_and_set(config)\n   823→        Configuration.set_default(config)\n   824→    else:\n   825→        loader.load_and_set(client_configuration)\n   826→\n   827→\n   828→def load_kube_config_from_dict(config_dict, context=None,\n   829→                               client_configuration=None,\n   830→                               persist_config=True,\n   831→                               temp_file_path=None):\n   832→    \"\"\"Loads authentication and cluster information from config_dict file\n   833→    and stores them in kubernetes.client.configuration.\n   834→\n   835→    :param config_dict: Takes the config file as a dict.\n   836→    :param context: set the active context. If is set to None, current_context\n   837→        from config file will be used.\n   838→    :param client_configuration: The kubernetes.client.Configuration to\n   839→        set configs to.\n   840→    :param persist_config: If True, config file will be updated when changed\n   841→        (e.g GCP token refresh).\n   842→    :param temp_file_path: store temp files path.\n   843→    \"\"\"\n   844→    if config_dict is None:\n   845→        raise ConfigException(\n   846→            'Invalid kube-config dict. '\n   847→            'No configuration found.')\n   848→\n   849→    loader = _get_kube_config_loader(\n   850→        config_dict=config_dict, active_context=context,\n   851→        persist_config=persist_config,\n   852→        temp_file_path=temp_file_path)\n   853→\n   854→    if client_configuration is None:\n   855→        config = type.__call__(Configuration)\n   856→        loader.load_and_set(config)\n   857→        Configuration.set_default(config)\n   858→    else:\n   859→        loader.load_and_set(client_configuration)\n   860→\n   861→\n   862→def new_client_from_config(\n   863→        config_file=None,\n   864→        context=None,\n   865→        persist_config=True):\n   866→    \"\"\"\n   867→    Loads configuration the same as load_kube_config but returns an ApiClient\n   868→    to be used with any API object. This will allow the caller to concurrently\n   869→    talk with multiple clusters.\n   870→    \"\"\"\n   871→    client_config = type.__call__(Configuration)\n   872→    load_kube_config(config_file=config_file, context=context,\n   873