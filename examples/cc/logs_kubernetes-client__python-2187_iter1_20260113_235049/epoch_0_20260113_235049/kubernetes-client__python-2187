ey_name'] is not set or empty. Assumption is file content is\n    91\u2192     raw data and data field is base64 string. The assumption can be changed\n    92\u2192     with base64_file_content flag. If set to False, the content of the file\n    93\u2192     will assumed to be base64 and read as is. The default True value will\n    94\u2192     result in base64 encode of the file content after read.\"\"\"\n    95\u2192\n    96\u2192    def __init__(self, obj, file_key_name, data_key_name=None,\n    97\u2192                 file_base_path=\"\", base64_file_content=True,\n    98\u2192                 temp_file_path=None):\n    99\u2192        if not data_key_name:\n   100\u2192            data_key_name = file_key_name + \"-data\"\n   101\u2192        self._file = None\n   102\u2192        self._data = None\n   103\u2192        self._base64_file_content = base64_file_content\n   104\u2192        self._temp_file_path = temp_file_path\n   105\u2192        if not obj:\n   106\u2192            return\n   107\u2192        if data_key_name in obj:\n   108\u2192            self._data = obj[data_key_name]\n   109\u2192        elif file_key_name in obj:\n   110\u2192            self._file = os.path.normpath(\n   111\u2192                os.path.join(file_base_path, obj[file_key_name]))\n   112\u2192\n   113\u2192    def as_file(self):\n   114\u2192        \"\"\"If obj[%data_key_name] exists, return name of a file with base64\n   115\u2192        decoded obj[%data_key_name] content otherwise obj[%file_key_name].\"\"\"\n   116\u2192        use_data_if_no_file = not self._file and self._data\n   117\u2192        if use_data_if_no_file:\n   118\u2192            if self._base64_file_content:\n   119\u2192                if isinstance(self._data, str):\n   120\u2192                    content = self._data.encode()\n   121\u2192                else:\n   122\u2192                    content = self._data\n   123\u2192                self._file = _create_temp_file_with_content(\n   124\u2192                    base64.standard_b64decode(content), self._temp_file_path)\n   125\u2192            else:\n   126\u2192                self._file = _create_temp_file_with_content(\n   127\u2192                    self._data, self._temp_file_path)\n   128\u2192        if self._file and not os.path.isfile(self._file):\n   129\u2192            raise ConfigException(\"File does not exist: %s\" % self._file)\n   130\u2192        return self._file\n   131\u2192\n   132\u2192    def as_data(self):\n   133\u2192        \"\"\"If obj[%data_key_name] exists, Return obj[%data_key_name] otherwise\n   134\u2192        base64 encoded string of obj[%file_key_name] file content.\"\"\"\n   135\u2192        use_file_if_no_data = not self._data and self._file\n   136\u2192        if use_file_if_no_data:\n   137\u2192            with open(self._file) as f:\n   138\u2192                if self._base64_file_content:\n   139\u2192                    self._data = bytes.decode(\n   140\u2192                        base64.standard_b64encode(str.encode(f.read())))\n   141\u2192                else:\n   142\u2192                    self._data = f.read()\n   143\u2192        return self._data\n   144\u2192\n   145\u2192\n   146\u2192class CommandTokenSource(object):\n   147\u2192    def __init__(self, cmd, args, tokenKey, expiryKey):\n   148\u2192        self._cmd = cmd\n   149\u2192        self._args = args\n   150\u2192        if not tokenKey:\n   151\u2192            self._tokenKey = '{.access_token}'\n   152\u2192        else:\n   153\u2192            self._tokenKey = tokenKey\n   154\u2192        if not expiryKey:\n   155\u2192            self._expiryKey = '{.token_expiry}'\n   156\u2192        else:\n   157\u2192            self._expiryKey = expiryKey\n   158\u2192\n   159\u2192    def token(self):\n   160\u2192        fullCmd = self._cmd + (\" \") + \" \".join(self._args)\n   161\u2192        process = subprocess.Popen(\n   162\u2192            [self._cmd] + self._args,\n   163\u2192            stdout=subprocess.PIPE,\n   164\u2192            stderr=subprocess.PIPE,\n   165\u2192            universal_newlines=True)\n   166\u2192        (stdout, stderr) = process.communicate()\n   167\u2192        exit_code = process.wait()\n   168\u2192        if exit_code != 0:\n   169\u2192            msg = 'cmd-path: process returned %d' % exit_code\n   170\u2192            msg += \"\\nCmd: %s\" % fullCmd\n   171\u2192            stderr = stderr.strip()\n   172\u2192            if stderr:\n   173\u2192                msg += '\\nStderr: %s' % stderr\n   174\u2192            raise ConfigException(msg)\n   175\u2192        try:\n   176\u2192            data = json.loads(stdout)\n   177\u2192        except ValueError as de:\n   178\u2192            raise ConfigException(\n   179\u2192                'exec: failed to decode process output: %s' % de)\n   180\u2192        A = namedtuple('A', ['token', 'expiry'])\n   181\u2192        return A(\n   182\u2192            token=data['credential']['access_token'],\n   183\u2192            expiry=parse_rfc3339(data['credential']['token_expiry']))\n   184\u2192\n   185\u2192\n   186\u2192class KubeConfigLoader(object):\n   187\u2192\n   188\u2192    def __init__(self, config_dict, active_context=None,\n   189\u2192                 get_google_credentials=None,\n   190\u2192                 config_base_path=\"\",\n   191\u2192                 config_persister=None,\n   192\u2192                 temp_file_path=None):\n   193\u2192\n   194\u2192        if config_dict is None:\n   195\u2192            raise ConfigException(\n   196\u2192                'Invalid kube-config. '\n   197\u2192                'Expected config_dict to not be None.')\n   198\u2192        elif isinstance(config_dict, ConfigNode):\n   199\u2192            self._config = config_dict\n   200\u2192        else:\n   201\u2192            self._config = ConfigNode('kube-config', config_dict)\n   202\u2192\n   203\u2192        self._current_context = None\n   204\u2192        self._user = None\n   205\u2192        self._cluster = None\n   206\u2192        self.set_active_context(active_context)\n   207\u2192        self._config_base_path = config_base_path\n   208\u2192        self._config_persister = config_persister\n   209\u2192        self._temp_file_path = temp_file_path\n   210\u2192\n   211\u2192        def _refresh_credentials_with_cmd_path():\n   212\u2192            config = self._user['auth-provider']['config']\n   213\u2192            cmd = config['cmd-path']\n   214\u2192            if len(cmd) == 0:\n   215\u2192                raise ConfigException(\n   216\u2192                    'missing access token cmd '\n   217\u2192                    '(cmd-path is an empty string in your kubeconfig file)')\n   218\u2192            if 'scopes' in config and config['scopes'] != \"\":\n   219\u2192                raise ConfigException(\n   220\u2192                    'scopes can only be used '\n   221\u2192                    'when kubectl is using a gcp service account key')\n   222\u2192            args = []\n   223\u2192            if 'cmd-args' in config:\n   224\u2192                args = config['cmd-args'].split()\n   225\u2192            else:\n   226\u2192                fields = config['cmd-path'].split()\n   227\u2192                cmd = fields[0]\n   228\u2192                args = fields[1:]\n   229\u2192\n   230\u2192            commandTokenSource = CommandTokenSource(\n   231\u2192                cmd, args,\n   232\u2192                config.safe_get('token-key'),\n   233\u2192                config.safe_get('expiry-key'))\n   234\u2192            return commandTokenSource.token()\n   235\u2192\n   236\u2192        def _refresh_credentials():\n   237\u2192            # Refresh credentials using cmd-path\n   238\u2192            if ('auth-provider' in self._user and\n   239\u2192                'config' in self._user['auth-provider'] and\n   240\u2192                    'cmd-path' in self._user['auth-provider']['config']):\n   241\u2192                return _refresh_credentials_with_cmd_path()\n   242\u2192\n   243\u2192            credentials, project_id = google.auth.default(scopes=[\n   244\u2192                'https://www.googleapis.com/auth/cloud-platform',\n   245\u2192                'https://www.googleapis.com/auth/userinfo.email'\n   246\u2192            ])\n   247\u2192            request = google.auth.transport.requests.Request()\n   248\u2192            credentials.refresh(request)\n   249\u2192            return credentials\n   250\u2192\n   251\u2192        if get_google_credentials:\n   252\u2192            self._get_google_credentials = get_google_credentials\n   253\u2192        else:\n   254\u2192            self._get_google_credentials = _refresh_credentials\n   255\u2192\n   256\u2192    def set_active_context(self, context_name=None):\n   257\u2192        if context_name is None:\n   258\u2192            context_name = self._config['current-context']\n   259\u2192        self._current_context = self._config['contexts'].get_with_name(\n   260\u2192            context_name)\n   261\u2192        if (self._current_context['context'].safe_get('user') and\n   262\u2192                self._config.safe_get('users')):\n   263\u2192            user = self._config['users'].get_with_name(\n   264\u2192                self._current_context['context']['user'], safe=True)\n   265\u2192            if user:\n   266\u2192                self._user = user['user']\n   267\u2192            else:\n   268\u2192                self._user = None\n   269\u2192        else:\n   270\u2192            self._user = None\n   271\u2192        self._cluster = self._config['clusters'].get_with_name(\n   272\u2192            self._current_context['context']['cluster'])['cluster']\n   273\u2192\n   274\u2192    def _load_authentication(self):\n   275\u2192        \"\"\"Read authentication from kube-config user section if exists.\n   276\u2192\n   277\u2192        This function goes through various authentication methods in user\n   278\u2192        section of kube-config and stops if it finds a valid authentication\n   279\u2192        method. The order of authentication methods is:\n   280\u2192\n   281\u2192            1. auth-provider (gcp, azure, oidc)\n   282\u2192            2. token field (point to a token file)\n   283\u2192            3. exec provided plugin\n   284\u2192            4. username/password\n   285\u2192        \"\"\"\n   286\u2192        if not self._user:\n   287\u2192            return\n   288\u2192        if self._load_auth_provider_token():\n   289\u2192            return\n   290\u2192        if self._load_user_token():\n   291\u2192            return\n   292\u2192        if self._load_from_exec_plugin():\n   293\u2192            return\n   294\u2192        self._load_user_pass_token()\n   295\u2192\n   296\u2192    def _load_auth_provider_token(self):\n   297\u2192        if 'auth-provider' not in self._user:\n   298\u2192            return\n   299\u2192        provider = self._user['auth-provider']\n   300\u2192        if 'name' not in provider:\n   301\u2192            return\n   302\u2192        if provider['name'] == 'gcp':\n   303\u2192            return self._load_gcp_token(provider)\n   304\u2192        if provider['name'] == 'azure':\n   305\u2192            return self._load_azure_token(provider)\n   306\u2192        if provider['name'] == 'oidc':\n   307\u2192            return self._load_oid_token(provider)\n   308\u2192\n   309\u2192    def _azure_is_expired(self, provider):\n   310\u2192        expires_on = provider['config']['expires-on']\n   311\u2192        if expires_on.isdigit():\n   312\u2192            return int(expires_on) < time.time()\n   313\u2192        else:\n   314\u2192            exp_time = time.strptime(expires_on, '%Y-%m-%d %H:%M:%S.%f')\n   315\u2192            return exp_time < time.gmtime()\n   316\u2192\n   317\u2192    def _load_azure_token(self, provider):\n   318\u2192        if 'config' not in provider:\n   319\u2192            return\n   320\u2192        if 'access-token' not in provider['config']:\n   321\u2192            return\n   322\u2192        if 'expires-on' in provider['config']:\n   323\u2192            if self._azure_is_expired(provider):\n   324\u2192                self._refresh_azure_token(provider['config'])\n   325\u2192        self.token = 'Bearer %s' % provider['config']['access-token']\n   326\u2192        return self.token\n   327\u2192\n   328\u2192    def _refresh_azure_token(self, config):\n   329\u2192        if 'adal' not in globals():\n   330\u2192            raise ImportError('refresh token error, adal library not imported')\n   331\u2192\n   332\u2192        tenant = config['tenant-id']\n   333\u2192        authority = 'https://login.microsoftonline.com/{}'.format(tenant)\n   334\u2192        context = adal.AuthenticationContext(\n   335\u2192            authority, validate_authority=True, api_version='1.0'\n   336\u2192        )\n   337\u2192        refresh_token = config['refresh-token']\n   338\u2192        client_id = config['client-id']\n   339\u2192        apiserver_id = '00000002-0000-0000-c000-000000000000'\n   340\u2192        try:\n   341\u2192            apiserver_id = config['apiserver-id']\n   342\u2192        except ConfigException:\n   343\u2192            # We've already set a default above\n   344\u2192            pass\n   345\u2192        token_response = context.acquire_token_with_refresh_token(\n   346\u2192            refresh_token, client_id, apiserver_id)\n   347\u2192\n   348\u2192        provider = self._user['auth-provider']['config']\n   349\u2192        provider.value['access-token'] = token_response['accessToken']\n   350\u2192        provider.value['expires-on'] = token_response['expiresOn']\n   351\u2192        if self._config_persister:\n   352\u2192            self._config_persister()\n   353\u2192\n   354\u2192    def _load_gcp_token(self, provider):\n   355\u2192        if (('config' not in provider) or\n   356\u2192                ('access-token' not in provider['config']) or\n   357\u2192                ('expiry' in provider['config'] and\n   358\u2192                 _is_expired(provider['config']['expiry']))):\n   359\u2192            # token is not available or expired, refresh it\n   360\u2192            self._refresh_gcp_token()\n   361\u2192\n   362\u2192        self.token = \"Bearer %s\" % provider['config']['access-token']\n   363\u2192        if 'expiry' in provider['config']:\n   364\u2192            self.expiry = parse_rfc3339(provider['config']['expiry'])\n   365\u2192        return self.token\n   366\u2192\n   367\u2192    def _refresh_gcp_token(self):\n   368\u2192        if 'config' not in self._user['auth-provider']:\n   369\u2192            self._user['auth-provider'].value['config'] = {}\n   370\u2192        provider = self._user['auth-provider']['config']\n   371\u2192        credentials = self._get_google_credentials()\n   372\u2192        provider.value['access-token'] = credentials.token\n   373\u2192        provider.value['expiry'] = format_rfc3339(credentials.expiry)\n   374\u2192        if self._config_persister:\n   375\u2192            self._config_persister()\n   376\u2192\n   377\u2192    def _load_oid_token(self, provider):\n   378\u2192        if 'config' not in provider:\n   379\u2192            return\n   380\u2192\n   381\u2192        reserved_characters = frozenset([\"=\", \"+\", \"/\"])\n   382\u2192        token = provider['config']['id-token']\n   383\u2192\n   384\u2192        if any(char in token for char in reserved_characters):\n   385\u2192            # Invalid jwt, as it contains url-unsafe chars\n   386\u2192            return\n   387\u2192\n   388\u2192        parts = token.split('.')\n   389\u2192        if len(parts) != 3:  # Not a valid JWT\n   390\u2192            return\n   391\u2192\n   392\u2192        padding = (4 - len(parts[1]) % 4) * '='\n   393\u2192        if len(padding) == 3:\n   394\u2192            # According to spec, 3 padding characters cannot occur\n   395\u2192            # in a valid jwt\n   396\u2192            # https://tools.ietf.org/html/rfc7515#appendix-C\n   397\u2192            return\n   398\u2192\n   399\u2192        if PY3:\n   400\u2192            jwt_attributes = json.loads(\n   401\u2192                base64.urlsafe_b64decode(parts[1] + padding).decode('utf-8')\n   402\u2192            )\n   403\u2192        else:\n   404\u2192            jwt_attributes = json.loads(\n   405\u2192                base64.b64decode(parts[1] + padding)\n   406\u2192            )\n   407\u2192\n   408\u2192        expire = jwt_attributes.get('exp')\n   409\u2192\n   410\u2192        if ((expire is not None) and\n   411\u2192            (_is_expired(datetime.datetime.fromtimestamp(expire,\n   412\u2192                                                         tz=UTC)))):\n   413\u2192            self._refresh_oidc(provider)\n   414\u2192\n   415\u2192            if self._config_persister:\n   416\u2192                self._config_persister()\n   417\u2192\n   418\u2192        self.token = \"Bearer %s\" % provider['config']['id-token']\n   419\u2192\n   420\u2192        return self.token\n   421\u2192\n   422\u2192    def _refresh_oidc(self, provider):\n   423\u2192        config = Configuration()\n   424\u2192\n   425\u2192        if 'idp-certificate-authority-data' in provider['config']:\n   426\u2192            ca_cert = tempfile.NamedTemporaryFile(delete=True)\n   427\u2192\n   428\u2192            if PY3:\n   429\u2192                cert = base64.b64decode(\n   430\u2192                    provider['config']['idp-certificate-authority-data']\n   431\u2192                ).decode('utf-8')\n   432\u2192            else:\n   433\u2192                cert = base64.b64decode(\n   434\u2192                    provider['config']['idp-certificate-authority-data'] + \"==\"\n   435\u2192                )\n   436\u2192\n   437\u2192            with open(ca_cert.name, 'w') as fh:\n   438\u2192                fh.write(cert)\n   439\u2192\n   440\u2192            config.ssl_ca_cert = ca_cert.name\n   441\u2192\n   442\u2192        elif 'idp-certificate-authority' in provider['config']:\n   443\u2192            config.ssl_ca_cert = provider['config']['idp-certificate-authority']\n   444\u2192\n   445\u2192        else:\n   446\u2192            config.verify_ssl = False\n   447\u2192\n   448\u2192        client = ApiClient(configuration=config)\n   449\u2192\n   450\u2192        response = client.request(\n   451\u2192            method=\"GET\",\n   452\u2192            url=\"%s/.well-known/openid-configuration\"\n   453\u2192            % provider['config']['idp-issuer-url']\n   454\u2192        )\n   455\u2192\n   456\u2192        if response.status != 200:\n   457\u2192            return\n   458\u2192\n   459\u2192        response = json.loads(response.data)\n   460\u2192\n   461\u2192        request = OAuth2Session(\n   462\u2192            client_id=provider['config']['client-id'],\n   463\u2192            token=provider['config']['refresh-token'],\n   464\u2192            auto_refresh_kwargs={\n   465\u2192                'client_id': provider['config']['client-id'],\n   466\u2192                'client_secret': provider['config']['client-secret']\n   467\u2192            },\n   468\u2192            auto_refresh_url=response['token_endpoint']\n   469\u2192        )\n   470\u2192\n   471\u2192        try:\n   472\u2192            refresh = request.refresh_token(\n   473\u2192                token_url=response['token_endpoint'],\n   474\u2192                refresh_token=provider['config']['refresh-token'],\n   475\u2192                auth=(provider['config']['client-id'],\n   476\u2192                      provider['config']['client-secret']),\n   477\u2192                verify=config.ssl_ca_cert if config.verify_ssl else None\n   478\u2192            )\n   479\u2192        except oauthlib.oa