aise ConfigException(\n   663\u2192            'Invalid kube-config file. '\n   664\u2192            'Expected object with name %s in %s list' % (name, self.name))\n   665\u2192\n   666\u2192\n   667\u2192class KubeConfigMerger:\n   668\u2192\n   669\u2192    \"\"\"Reads and merges configuration from one or more kube-config's.\n   670\u2192    The property `config` can be passed to the KubeConfigLoader as config_dict.\n   671\u2192\n   672\u2192    It uses a path attribute from ConfigNode to store the path to kubeconfig.\n   673\u2192    This path is required to load certs from relative paths.\n   674\u2192\n   675\u2192    A method `save_changes` updates changed kubeconfig's (it compares current\n   676\u2192    state of dicts with).\n   677\u2192    \"\"\"\n   678\u2192\n   679\u2192    def __init__(self, paths):\n   680\u2192        self.paths = []\n   681\u2192        self.config_files = {}\n   682\u2192        self.config_merged = None\n   683\u2192        if hasattr(paths, 'read'):\n   684\u2192            self._load_config_from_file_like_object(paths)\n   685\u2192        else:\n   686\u2192            self._load_config_from_file_path(paths)\n   687\u2192\n   688\u2192    @property\n   689\u2192    def config(self):\n   690\u2192        return self.config_merged\n   691\u2192\n   692\u2192    def _load_config_from_file_like_object(self, string):\n   693\u2192        if hasattr(string, 'getvalue'):\n   694\u2192            config = yaml.safe_load(string.getvalue())\n   695\u2192        else:\n   696\u2192            config = yaml.safe_load(string.read())\n   697\u2192\n   698\u2192        if config is None:\n   699\u2192            raise ConfigException(\n   700\u2192                'Invalid kube-config.')\n   701\u2192        if self.config_merged is None:\n   702\u2192            self.config_merged = copy.deepcopy(config)\n   703\u2192        # doesn't need to do any further merging\n   704\u2192\n   705\u2192    def _load_config_from_file_path(self, string)