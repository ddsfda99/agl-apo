ments and no targetduration are available\"\n  1037→\n  1038→    def test_hls_playlist_reload_time_live_edge(self):\n  1039→        time = self.subject([Playlist(0, self.segments, end=True, targetduration=4)], reload_time=\"live-edge\")\n  1040→        assert time == 8, \"live-edge sets the reload time to the sum of the number of segments of the live-edge\"\n  1041→\n  1042→    def test_hls_playlist_reload_time_live_edge_no_segments(self):\n  1043→        time = self.subject([Playlist(0, [], end=True, targetduration=4)], reload_time=\"live-edge\")\n  1044→        assert time == 4, \"live-edge sets the reload time to the targetduration if no segments are available\"\n  1045→\n  1046→    def test_hls_playlist_reload_time_live_edge_no_segments_no_targetduration(self):\n  1047→        time = self.subject([Playlist(0, [], end=True, targetduration=0)], reload_time=\"live-edge\")\n  1048→        assert time == 6, \"sets reload time to 6 seconds when no segments and no targetduration are available\"\n  1049→\n  1050→    def test_hls_playlist_reload_time_number(self):\n  1051→        time = self.subject([Playlist(0, self.segments, end=True, targetduration=4)], reload_time=\"2\")\n  1052→        assert time == 2, \"number values override the reload time\"\n  1053→\n  1054→    def test_hls_playlist_reload_time_number_invalid(self):\n  1055→        time = self.subject([Playlist(0, self.segments, end=True, targetduration=4)], reload_time=\"0\")\n  1056→        assert time == 4, \"invalid number values set the reload time to the playlist's targetduration\"\n  1057→\n  1058→    def test_hls_playlist_reload_time_no_target_duration(self):\n  1059→        time = self.subject([Playlist(0, self.segments, end=True, targetduration=0)], reload_time=\"default\")\n  1060→        assert time == 8, \"uses the live-edge sum if the playlist is missing the targetduration data\"\n  1061→\n  1062→    def test_hls_playlist_reload_time_no_data(self):\n  1063→        time = self.subject([Playlist(0, 