0→            self.await_close(1)\n   341→\n   342→            assert mock_log.warning.call_args_list == [call(\"No new segments in playlist for more than 15.00s. Stopping...\")]\n   343→\n   344→    def test_segment_queue_timing_threshold_reached_ignored(self) -> None:\n   345→        segments = self.subject(\n   346→            start=False,\n   347→            options={\"hls-segment-queue-threshold\": 0},\n   348→            playlists=[\n   349→                # no EXT-X-ENDLIST, last mocked playlist response will be repreated forever\n   350→                Playlist(0, targetduration=5, segments=[Segment(0)]),\n   351→            ],\n   352→        )\n   353→        worker: EventedHLSStreamWorker = self.thread.reader.worker  # type: ignore[assignment]\n   354→        targetduration = ONE_SECOND * 5\n   355→\n   356→        with freezegun.freeze_time(EPOCH) as frozen_time:\n   357→            self.start()\n   358→\n   359→            assert worker.handshake_reload.wait_ready(1), \"Loads playlist for the first time\"\n   360→            assert worker.playlist_sequence == -1, \"Initial sequence number\"\n   361→            assert worker.playlist_sequence_last == EPOCH, \"Sets the initial last queue time\"\n   362→\n   363→            # first playlist reload has taken one second\n   364→            frozen_time.tick(ONE_SECOND)\n   365→            self.await_playlist_reload(1)\n   366→\n   367→            assert worker.handshake_wait.wait_ready(1), \"Arrives at first wait() call\"\n   368→            assert worker.playlist_sequence == 1, \"Updates the sequence number\"\n   369→            assert worker.playlist_sequence_last == EPOCH + ONE_SECOND, \"Updates the last queue time\"\n   370→            assert worker.playlist_targetduration == 5.0\n   371→            assert self.await_read() == self.content(segments)\n   372→\n   373→            # keep reloading a couple of times\n   374→            for num in range(10):\n   375→                frozen_time.tick(targetduration)\n   376→                self.await_playlist_wait(1)\n   377→                self.await_playlist_reload(1)\n   378→\n   379→                assert worker.handshake_wait.wait_ready(1), f\"Arrives at wait() #{num + 1}\"\n   380→                assert worker.playlist_sequence == 1, \"Sequence number is unchanged\"\n   381→                assert worker.playlist_sequence_last == EPOCH + ONE_SECOND, \"Last queue time is unchanged\"\n   382→\n   383→        assert self.thread.data == [], \"No new data\"\n   384→        assert worker.is_alive()\n   385→\n   386→        # make stream end gracefully to avoid any unnecessary thread blocking\n   387→        self.thread.reader.writer.put(None)\n   388→\n   389→    def test_segment_queue_timing_threshold_reached_min(self) -> None:\n   390→        self.subject(\n   391→            start=False,\n   392→            playlists=[\n   393→                # no EXT-X-ENDLIST, last mocked playlist response will be repreated forever\n   394→                Playlist(0, targetduration=1, segments=[Segment(0)]),\n   395→            ],\n   396→        )\n   397→        worker: EventedHLSStreamWorker = self.thread.reader.worker  # type: ignore[assignment]\n   398→        targetduration = ONE_SECOND\n   399→\n   400→        with (\n   401→            freezegun.freeze_time(EPOCH) as frozen_time,\n   402→            patch(\"streamlink.stream.hls.hls.log\") as mock_log,\n   403→        ):\n   404→            self.start()\n   405→\n   406→            assert worker.handshake_reload.wait_ready(1), \"Loads playlist for the first time\"\n   407→            assert worker.playlist_sequence == -1, \"Initial sequence number\"\n   408→            assert worker.playlist_sequence_last == EPOCH, \"Sets the initial last queue time\"\n   409→\n   410→            # first playlist reload has taken one second\n   411→            frozen_time.tick(ONE_SECOND)\n   412→            self.await_playlist_reload(1)\n   413→\n   414→            assert worker.handshake_wait.wait_ready(1), \"Arrives at wait() call #1\"\n   415→            assert worker.playlist_sequence == 1, \"Updates the sequence number\"\n   416→            assert worker.playlist_sequence_last == EPOCH + ONE_SECOND, \"Updates the last queue time\"\n   417→            assert worker.playlist_targetduration == 1.0\n   418→\n   419→            for num in range(2, 7):\n   420→                # trigger next reload when the target duration has passed\n   421→                frozen_time.tick(targetduration)\n   422→                self.await_playlist_wait(1)\n   423→                self.await_playlist_reload(1)\n   424→\n   425→                assert worker.handshake_wait.wait_ready(1), f\"Arrives at wait() call #{num}\"\n   426→                assert worker.playlist_sequence == 1, \"Sequence number is unchanged\"\n   427→                assert worker.playlist_sequence_last == EPOCH + ONE_SECOND, \"Last queue time is unchanged\"\n   428→                assert worker.playlist_targetduration == 1.0\n   429→\n   430→            assert mock_log.warning.call_args_list == []\n   431→\n   432→            # trigger next reload when the target duration has passed\n   433→            frozen_time.tick(targetduration)\n   434→            self.await_playlist_wait(1)\n   435→            self.await_playlist_reload(1)\n   436→\n   437→            assert mock_log.warning.call_args_list == [call(\"No new segments in playlist for more than 5.00s. Stopping...\")]\n   438→\n   439→    def test_playlist_reload_offset(self) -> None:\n   440→        segments = self.subject(\n   441→            start=False,\n   442→            playlists=[\n   443→                Playlist(0, targetduration=5, segments=[Segment(0)]),\n   444→                Playlist(1, targetduration=5, segments=[Segment(1)]),\n   445→                Playlist(2, targetduration=5, segments=[Segment(2)]),\n   446→                Playlist(3, targetduration=5, segments=[Segment(3)]),\n   447→                Playlist(4, targetduration=5, segments=[Segment(4)], end=True),\n   448→            ],\n   449→        )\n   450→        worker: EventedHLSStreamWorker = self.thread.reader.worker  # type: ignore[assignment]\n   451→        targetduration = ONE_SECOND * 5\n   452→\n   453→        with freezegun.freeze_time(EPOCH) as frozen_time:\n   454→            self.start()\n   455→\n   456→            assert worker.handshake_reload.wait_ready(1), \"Arrives at initial playlist reload\"\n   457→            assert worker.playlist_reload_last == EPOCH, \"Sets the initial value of the last reload time\"\n   458→\n   459→            # adjust clock and reload playlist: let it take one second\n   460→            frozen_time.move_to(worker.playlist_reload_last + ONE_SECOND)\n   461→            self.await_playlist_reload()\n   462→            assert worker.playlist_reload_time == 5.0, \"Uses the playlist's targetduration as reload time\"\n   463→\n   464→            # time_completed = 00:00:01; time_elapsed = 1s\n   465→            assert worker.handshake_wait.wait_ready(1), \"Arrives at first wait() call\"\n   466→            assert worker.playlist_sequence == 1, \"Has queued first segment\"\n   467→            assert worker.playlist_end is None, \"Stream hasn't ended yet\"\n   468→            assert worker.time_wait == 4.0, \"Waits for 4 seconds out of the 5 seconds reload time\"\n   469→            self.await_playlist_wait()\n   470→\n   471→            assert worker.handshake_reload.wait_ready(1), \"Arrives at second playlist reload\"\n   472→            assert worker.playlist_reload_last == EPOCH + targetduration, \\\n   473→                \"Last reload time is the sum of reload+wait time (=targetduration)\"  # fmt: skip\n   474→\n   475→            # adjust clock and reload playlist: let it exceed targetduration by two seconds\n   476→            frozen_time.move_to(worker.playlist_reload_last + targetduration + ONE_SECOND * 2)\n   477→            self.await_playlist_reload()\n   478→            assert worker.playlist_reload_time == 5.0, \"Uses the playlist's targetduration as reload time\"\n   479→\n   480→            # time_completed = 00:00:12; time_elapsed = 7s (exceeded 5s targetduration)\n   481→            assert worker.handshake_wait.wait_ready(1), \"Arrives at second wait() call\"\n   482→            assert worker.playlist_sequence == 2, \"Has queued second segment\"\n   483→            assert worker.playlist_end is None, \"Stream hasn't ended yet\"\n   484→            assert worker.time_wait == 0.0, \"Doesn't wait when reloading took too long\"\n   485→            self.await_playlist_wait()\n   486→\n   487→            assert worker.handshake_reload.wait_ready(1), \"Arrives at third playlist reload\"\n   488→            assert worker.playlist_reload_last == EPOCH + targetduration * 2 + ONE_SECOND * 2, \\\n   489→                \"Sets last reload time to current time when reloading took too long (changes the interval)\"  # fmt: skip\n   490→\n   491→            # adjust clock and reload playlist: let it take one second again\n   492→            frozen_time.move_to(worker.playlist_reload_last + ONE_SECOND)\n   493→            self.await_playlist_reload()\n   494→            assert worker.playlist_reload_time == 5.0, \"Uses the playlist's targetduration as reload time\"\n   495→\n   496→            # time_completed = 00:00:13; time_elapsed = 1s\n   497→            assert worker.handshake_wait.wait_ready(1), \"Arrives at third wait() call\"\n   498→            assert worker.playlist_sequence == 3, \"Has queued third segment\"\n   499→            assert worker.playlist_end is None, \"Stream hasn't ended yet\"\n   500→            assert worker.time_wait == 4.0, \"Waits for 4 seconds out of the 5 seconds reload time\"\n   501→            self.await_playlist_wait()\n   502→\n   503→            assert worker.handshake_reload.wait_ready(1), \"Arrives at fourth playlist reload\"\n   504→            assert worker.playlist_reload_last == EPOCH + targetduration * 3 + ONE_SECOND * 2, \\\n   505→                \"Last reload time is the sum of reload+wait time (=targetduration) of the changed interval\"  # fmt: skip\n   506→\n   507→            # adjust clock and reload playlist: simulate no fetch+processing delay\n   508→            frozen_time.move_to(worker.playlist_reload_last)\n   509→            self.await_playlist_reload()\n   510→            assert worker.playlist_reload_time == 5.0, \"Uses the playlist's targetduration as reload time\"\n   511→\n   512→            # time_completed = 00:00:17; time_elapsed = 0s\n   513→            assert worker.handshake_wait.wait_ready(1), \"Arrives at fourth wait() call\"\n   514→            assert worker.playlist_sequence == 4, \"Has queued fourth segment\"\n   515→            assert worker.playlist_end is None, \"Stream hasn't ended yet\"\n   516→            assert worker.time_wait == 5.0, \"Waits for the whole reload time\"\n   517→            self.await_playlist_wait()\n   518→\n   519→            assert worker.handshake_reload.wait_ready(1), \"Arrives at fifth playlist reload\"\n   520→            assert worker.playlist_reload_last == EPOCH + targetduration * 4 + ONE_SECOND * 2, \\\n   521→                \"Last reload time is the sum of reload+wait time (no delay)\"  # fmt: skip\n   522→\n   523→            # adjusting the clock is not needed anymore\n   524→            self.await_playlist_reload()\n   525→            assert self.await_read(read_all=True) == self.content(segments)\n   526→            self.await_close()\n   527→            assert worker.playlist_end == 4, \"Stream has ended\"\n   528→            assert not worker.handshake_wait.wait_ready(0), \"Doesn't wait once ended\"\n   529→            assert not worker.handshake_reload.wait_ready(0), \"Doesn't reload playlist once ended\"\n   530→\n   531→\n   532→@patch(\"streamlink.stream.hls.hls.HLSStreamWorker.wait\", Mock(return_value=True))\n   533→class TestHLSStreamByterange(TestMixinStreamHLS, unittest.TestCase):\n   534→    __stream__ = EventedWriterHLSStream\n   535→\n   536→    # The dummy segments in the error tests are required because the writer's run loop would otherwise continue forever\n   537→    # due to the segment's future result being None (no requests result), and we can't await the end of the stream\n   538→    # without waiting for the stream's timeout error. The dummy segments ensure that we can call await_write for these\n   539→    # successful segments, so we can close the stream afterward and safely make the test assertions.\n   540→    # The EventedHLSStreamWriter could also implement await_fetch, but this is unnecessarily more complex than it already is.\n   541→\n   542→    @patch(\"streamlink.stream.hls.hls.log\")\n   543→    def test_unknown_offset(self, mock_log: Mock):\n   544→        self.subject([\n   545→            Playlist(\n   546→                0,\n   547→                [\n   548→                    Tag(\"EXT-X-BYTERANGE\", \"3\"),\n   549→                    Segment(0),\n   550→                    Segment(1),\n   551→                ],\n   552→                end=True,\n   553→            ),\n   554→        ])\n   555→\n   556→        self.await_write(2 - 1)\n   557→        self.thread.close()\n   558→\n   559→        assert mock_log.error.call_args_list == [\n   560→            call(\"Failed to fetch segment 0: Missing BYTERANGE offset\"),\n   561→        ]\n   562→        assert not self.called(Segment(0))\n   563→\n   564→    @patch(\"streamlink.stream.hls.hls.log\")\n   565→    def test_unknown_offset_map(self, mock_log: Mock):\n   566→        map1 = TagMap(1, self.id(), {\"BYTERANGE\": '\"1234\"'})\n   567→        self.mock(\"GET\", self.url(map1), content=map1.content)\n   568→        self.subject([\n   569→            Playlist(\n   570→                0,\n   571→                [\n   572→                    Segment(0),\n   573→                    map1,\n   574→                    Segment(1),\n   575→                ],\n   576→                end=True,\n   577→            ),\n   578→        ])\n   579→\n   580→        self.await_write(3 - 1)\n   581→        self.thread.close()\n   582→\n   583→        assert mock_log.error.call_args_list == [\n   584→            call(\"Failed to fetch map for segment 1: Missing BYTERANGE offset\"),\n   585→        ]\n   586→        assert not self.called(map1)\n   587→\n   588→    @patch(\"streamlink.stream.hls.hls.log\")\n   589→    def test_invalid_offset_reference(self, mock_log: Mock):\n   590→        self.subject([\n   591→            Playlist(\n   592→                0,\n   593→                [\n   594→                    Tag(\"EXT-X-BYTERANGE\", \"3@0\"),\n   595→                    Segment(0),\n   596→                    Segment(1),\n   597→                    Tag(\"EXT-X-BYTERANGE\", \"5\"),\n   598→                    Segment(2),\n   599→                    Segment(3),\n   600→                ],\n   601→                end=True,\n   602→            ),\n   603→        ])\n   604→\n   605→        self.await_write(4 - 1)\n   606→        self.thread.close()\n   607→\n   608→        assert mock_log.error.call_args_list == [\n   609→            call(\"Failed to fetch segment 2: Missing BYTERANGE offset\"),\n   610→        ]\n   611→        assert self.mocks[self.url(Segment(0))].last_request._request.headers[\"Range\"] == \"bytes=0-2\"\n   612→        assert not self.called(Segment(2))\n   613→\n   614→    def test_offsets(self):\n   615→        map1 = TagMap(1, self.id(), {\"BYTERANGE\": '\"1234@0\"'})\n   616→        map2 = TagMap(2, self.id(), {\"BYTERANGE\": '\"42@1337\"'})\n   617→        self.mock(\"GET\", self.url(map1), content=map1.content)\n   618→        self.mock(\"GET\", self.url(map2), content=map2.content)\n   619→        s1, s2, s3, s4, s5 = Segment(0), Segment(1), Segment(2), Segment(3), Segment(4)\n   620→\n   621→        self.subject([\n   622→            Playlist(\n   623→                0,\n   624→                [\n   625→                    map1,\n   626→                    Tag(\"EXT-X-BYTERANGE\", \"5@3\"),\n   627→                    s1,\n   628→                    Tag(\"EXT-X-BYTERANGE\", \"7\"),\n   629→                    s2,\n   630→                    map2,\n   631→                    Tag(\"EXT-X-BYTERANGE\", \"11\"),\n   632→                    s3,\n   633→                    Tag(\"EXT-X-BYTERANGE\", \"17@13\"),\n   634→                    s4,\n   635→                    Tag(\"EXT-X-BYTERANGE\", \"19\"),\n   636→                    s5,\n   637→                ],\n   638→                end=True,\n   639→            ),\n   640→        ])\n   641→\n   642→        self.await_write(1 + 2 + 1 + 3)  # 1 map, 2 partial segments, 1 map, 3 partial segments\n   643→        self.await_read(read_all=True)\n   644→        assert self.mocks[self.url(map1)].last_request._request.headers[\"Range\"] == \"bytes=0-1233\"\n   645→        assert self.mocks[self.url(map2)].last_request._request.headers[\"Range\"] == \"bytes=1337-1378\"\n   646→        assert self.mocks[self.url(s1)].last_request._request.headers[\"Range\"] == \"bytes=3-7\"\n   647→        assert self.mocks[self.url(s2)].last_request._request.headers[\"Range\"] == \"bytes=8-14\"\n   648→        assert self.mocks[self.url(s3)].last_request._request.headers[\"Range\"] == \"bytes=15-25\"\n   649→        assert self.mocks[self.url(s4)].last_request._request.headers[\"Range\"] == \"bytes=13-29\"\n   650→        assert self.mocks[self.url(s5)].last_request._request.headers[\"Range\"] == \"bytes=30-48\"\n   651→\n   652→\n   653→@patch(\"streamlink.stream.hls.hls.HLSStreamWorker.wait\", Mock(return_value=True))\n   654→class TestHLSStreamEncrypted(TestMixinStreamHLS, unittest.TestCase):\n   655→    __stream__ = EventedWriterHLSStream\n   656→\n   657→    def get_session(self, options=None, *args, **kwargs):\n   658→        session = super().get_session(options)\n   659→        session.set_option(\"hls-live-edge\", 3)\n   660→        session.set_option(\"http-headers\", {\"X-FOO\": \"BAR\"})\n   661→\n   662→        return session\n   663→\n   664→    def gen_key(\n   665→        self,\n   666→        aes_key=None,\n   667→        aes_iv=None,\n   668→        method=\"AES-128\",\n   669→        uri=None,\n   670→        keyformat=\"identity\",\n   671→        keyformatversions=1,\n   672→        mock=None,\n   673→    ):\n   674→        aes_key = aes_key or os.urandom(16)\n   675→        aes_iv = aes_iv or os.urandom(16)\n   676→\n   677→        key = TagKey(method=method, uri=uri, iv=aes_iv, keyformat=keyformat, keyformatversions=keyformatversions)\n   678→        self.mock(\"GET\", key.url(self.id()), **(mock if mock else {\"content\": aes_key}))\n   679→\n   680→        return aes_key, aes_iv, key\n   681→\n   682→    @patch(\"streamlink.stream.hls.hls.log\")\n   683→    def test_hls_encrypted_invalid_method(self, mock_log: Mock):\n   684→        aesKey, aesIv, key = self.gen_key(method=\"INVALID\")\n   685→\n   686→        self.subject([\n   687→            Playlist(0, [key, SegmentEnc(1, aesKey, aesIv)], end=True),\n   688→        ])\n   689→        self.await_write()\n   690→\n   691→        self.thread.close()\n   692→        self.await_close()\n   693→\n   694→        assert b\"\".join(self.thread.data) == b\"\"\n   695→        assert mock_log.error.mock_calls == [\n   696→            call(\"Failed to create decryptor: Unable to decrypt cipher INVALID\"),\n   697→        ]\n   698→\n   699→    @patch(\"streamlink.stream.hls.hls.log\")\n   700→    def test_hls_encrypted_missing_uri(self, mock_log: Mock):\n   701→        aesKey, aesIv, key = self.gen_key(uri=False)\n   702→\n   703→        self.subject([\n   704→            Playlist(0, [key, SegmentEnc(1, aesKey, aesIv)], end=True),\n   705→        ])\n   706→        self.await_write()\n   707→\n   708→        self.thread.close()\n   709→        self.await_close()\n   710→\n   711→        assert b\"\".join(self.thread.data) == b\"\"\n   712→        assert mock_log.error.mock_calls == [\n   713→            call(\"Failed to create decryptor: Missing URI for decryption key\"),\n   714→        ]\n   715→\n   716→    @patch(\"streamlink.stream.hls.hls.log\")\n   717→    def test_hls_encrypted_missing_adapter(self, mock_log: Mock):\n   718→        aesKey, aesIv, key = self.gen_key(uri=\"foo://bar/baz\", mock={\"exc\": InvalidSchema})\n   719→\n   720→        self.subject([\n   721→            Playlist(0, [key, SegmentEnc(1, aesKey, aesIv)], end=True),\n   722→        ])\n   723→        self.await_write()\n   724→\n   725→        self.thread.close()\n   726→        self.await_close()\n   727→\n   728→        assert b\"\".join(self.thread.data) == b\"\"\n   729→        assert mock_log.error.mock_calls == [\n   730→            call(\"Failed to create decryptor: Unable to find connection adapter for key URI: foo://bar/baz\"),\n   731→        ]\n   732→\n   733→    def test_hls_encrypted_aes128(self):\n   734→        aesKey, aesIv, key = self.gen_key()\n   735→        long = b\"Test cipher block chaining mode by using a long bytes string\"\n   736→\n   737→        # noinspection PyTypeChecker\n   738→        segments = self.subject([\n   739→            Playlist(0, [key] + [SegmentEnc(num, aesKey, aesIv) for num in range(4)]),\n   740→            Playlist(4, [key] + [SegmentEnc(num, aesKey, aesIv, content=long) for num in range(4, 8)], end=True),\n   741→        ])\n   742→\n   743→        self.await_write(3 + 4)\n   744→        data = self.await_read(read_all=True)\n   745→        self.await_close()\n   746→\n   747→        expected = self.content(segments, prop=\"content_plain\", cond=lambda s: s.num >= 1)\n   748→        assert data == expected, \"Decrypts the AES-128 identity stream\"\n   749→        assert self.called(key, once=True), \"Downloads encryption key only once\"\n   750→        assert self.get_mock(key).last_request._request.headers.get(\"X-FOO\") == \"BAR\"\n   751→        assert not any(self.called(s) for s in segments.values() if s.num < 1), \"Skips first segment\"\n   752→        assert all(self.called(s) for s in segments.values() if s.num >= 1), \"Downloads all remaining segments\"\n   753→        assert self.get_mock(segments[1]).last_request._request.headers.get(\"X-FOO\") == \"BAR\"\n   754→\n   755→    def test_hls_encrypted_aes128_with_map(self):\n   756→        aesKey, aesIv, key = self.gen_key()\n   757→        map1 = TagMapEnc(1, namespace=self.id(), key=aesKey, iv=aesIv)\n   758→        map2 = TagMapEnc(2, namespace=self.id(), key=aesKey, iv=aesIv)\n   759→        self.mock(\"GET\", self.url(map1), content=map1.content)\n   760→        self.mock(\"GET\", self.url(map2), content=map2.content)\n   761→\n   762→        segments = self.subject([\n   763→            Playlist(0, [key, map1] + [SegmentEnc(num, aesKey, aesIv) for num in range(2)]),\n   764→            Playlist(2, [key, map2] + [SegmentEnc(num, aesKey, aesIv) for num in range(2, 4)], end=True),\n   765→        ])\n   766→\n   767→        self.await_write(1 + 2 + 1 + 2)  # 1 map, 2 segments, 1 map, 2 segments\n   768→        data = self.await_read(read_all=True)\n   769→        self.await_close()\n   770→\n   771→        assert data == self.content(\n   772→            [\n   773→                map1,\n   774→                segments[0],\n   775→                segments[1],\n   776→                map2,\n   777→                segments[2],\n   778→                segments[3],\n   779→            ],\n   780→            prop=\"content_plain\",\n   781→        )\n   782→\n   783→    def test_hls_encrypted_aes128_with_differently_encrypted_map(self):\n   784→        aesKey1, aesIv1, key1 = self.gen_key()  # init key\n   785→        aesKey2, aesIv2, key2 = self.gen_key()  # media key\n   786→        map1 = TagMapEnc(1, namespace=self.id(), key=aesKey1, iv=aesIv1)\n   787→        map2 = TagMapEnc(2, namespace=self.id(), key=aesKey1, iv=aesIv1)\n   788→        self.mock(\"GET\", self.url(map1), content=map1.content)\n   789→        self.mock(\"GET\", self.url(map2), content=map2.content)\n   790→\n   791→        segments = self.subject([\n   792→            Playlist(0, [key1, map1, key2] + [SegmentEnc(num, aesKey2, aesIv2) for num in range(2)]),\n   793→            Playlist(2, [key1, map2, key2] + [SegmentEnc(num, aesKey2, aesIv2) for num in range(2, 4)], end=True),\n   794→        ])\n   795→\n   796→        self.await_write(1 + 2 + 1 + 2)  # 1 map, 2 segments, 1 map, 2 segments\n   797→        data = self.await_read(read_all=True)\n   798→        self.await_close()\n   799→\n   800→        assert data == self.content(\n   801→            [\n   802→                map1,\n   803→                segments[0],\n   804→                segments[1],\n   805→                map2,\n   806→                segments[2],\n   807→                segments[3],\n   808→            ],\n   809→            prop=\"content_plain\",\n   810→        )\n   811→\n   812→    def test_hls_encrypted_aes128_with_plaintext_map(self):\n   813→        aesKey, aesIv, key = self.gen_key()\n   814→        map1 = TagMap(1, namespace=self.id())\n   815→        map2 = TagMap(2, namespace=self.id())\n   816→        self.mock(\"GET\", self.url(map1), content=map1.content)\n   817→        self.mock(\"GET\", self.url(map2), content=map2.content)\n   818→\n   819→        segments = self.subject([\n   820→            Playlist(0, [map1, key] + [SegmentEnc(num, aesKey, aesIv) for num in range(2)]),\n   821→            Playlist(2, [map2, key] + [SegmentEnc(num, aesKey, aesIv) for num in range(2, 4)], end=True),\n   822→        ])\n   823→\n   824→        self.await_write(1 + 2 + 1 + 2)  # 1 map, 2 segments, 1 map, 2 segments\n   825→        data = self.await_read(read_all=True)\n   826→        self.await_close()\n   827→\n   828→        assert data == (\n   829→            map1.content\n   830→            + segments[0].content_plain\n   831→            + segments[1].content_plain\n   832→            + map2.content\n   833→            + segments[2].content_plain\n   834→            + segments[3].content_plain\n   835→        )\n   836→\n   837→    def test_hls_encrypted_aes128_key_uri_override(self):\n   838→        aesKey, aesIv, key = self.gen_key(uri=\"http://real-mocked/{namespace}/encryption.key?foo=bar\")\n   839→        aesKeyInvalid = bytes(ord(aesKey[i : i + 1]) ^ 0xFF for i in range(16))\n   840→        _, __, key_invalid = self.gen_key(aesKeyInvalid, aesIv, uri=\"http://mocked/{namespace}/encryption.key?foo=bar\")\n   841→\n   842→        # noinspection PyTypeChecker\n   843→        segments = self.subject(\n   844→            [\n   845→                Playlist(0, [key_invalid] + [SegmentEnc(num, aesKey, aesIv) for num in range(4)]),\n   846→                Playlist(4, [key_invalid] + [SegmentEnc(num, aesKey, aesIv) for num in range(4, 8)], end=True),\n   847→            ],\n   848→            options={\"hls-segment-key-uri\": \"{scheme}://real-{netloc}{path}?{query}\"},\n   849→        )\n   850→\n   851→        self.await_write(3 + 4)\n   852→        data = self.await_read(read_all=True)\n   853→        self.await_close()\n   854→\n   855→        expected = self.content(segments, prop=\"content_plain\", cond=lambda s: s.num >= 1)\n   856→        assert data == expected, \"Decrypts stream from custom key\"\n   857→        assert not self.called(key_invalid), \"Skips encryption key\"\n   858→        assert self.called(key, once=True), \"Downloads custom encryption key\"\n   859→        assert self.get_mock(key).last_request._request.headers.get(\"X-FOO\") == \"BAR\"\n   860→\n   861→    @patch(\"streamlink.stream.hls.hls.log\")\n   862→    def test_hls_encrypted_aes128_incorrect_block_length(self, mock_log: Mock):\n   863→        aesKey, aesIv, key = self.gen_key()\n   864→\n   865→        segments = self.subject([\n   866→            Playlist(\n   867→                0,\n   868→                [\n   869→                    key,\n   870→                    SegmentEnc(0, aesKey, aesIv, append=b\"?\"),\n   871→                    SegmentEnc(1, aesKey, aesIv),\n   872→                ],\n   873→                end=True,\n   874→            ),\n   875→        ])\n   876→        self.await_write()\n   877→        assert self.thread.reader.writer.is_alive()\n   878→\n   879→        self.await_write()\n   880→        data = self.await_read(read_all=True)\n   881→        self.await_close()\n   882→\n   883→        assert data == self.content([segments[1]], prop=\"content_plain\")\n   884→        assert mock_log.error.mock_calls == [\n   885→            call(\"Error while decrypting segment 0: Data must be padded to 16 byte boundary in CBC mode\"),\n   886→        ]\n   887→\n   888→    @patch(\"streamlink.stream.hls.hls.log\")\n   889→    def test_hls_encrypted_aes128_incorrect_padding_length(self, mock_log: Mock):\n   890→        aesKey, aesIv, key = self.gen_key()\n   891→\n   892→        padding = b\"\\x00\" * (AES.block_size - len(b\"[0]\"))\n   893→        segments = self.subject([\n   894→            Playlist(\n   895→                0,\n   896→                [\n   897→                    key,\n   898→                    SegmentEnc(0, aesKey, aesIv, padding=padding),\n   899→                    SegmentEnc(1, aesKey, aesIv),\n   900→                ],\n   901→                end=True,\n   902→            ),\n   903→        ])\n   904→        self.await_write()\n   905→        assert self.thread.reader.writer.is_alive()\n   906→\n   907→        self.await_write()\n   908→        data = self.await_read(read_all=True)\n   909→        self.await_close()\n   910→\n   911→        assert data == self.content([segments[1]], prop=\"content_plain\")\n   912→        assert mock_log.error.mock_calls == [call(\"Error while decrypting segment 0: Padding is incorrect.\")]\n   913→\n   914→    @patch(\"streamlink.stream.hls.hls.log\")\n   915→    def test_hls_encrypted_aes128_incorrect_padding_content(self, mock_log: Mock):\n   916→        aesKey, aesIv, key = self.gen_key()\n   917→\n   918→        padding = (b\"\\x00\" * (AES.block_size - len(b\"[0]\") - 1)) + bytes([AES.block_size])\n   919→        segments = self.subject([\n   920→            Playlist(\n   921→                0,\n   922→                [\n   923→                    key,\n   924→                    SegmentEnc(0, aesKey, aesIv, padding=padding),\n   925→                    SegmentEnc(1, aesKey, aesIv),\n   926→                ],\n   927→                end=True,\n   928→            ),\n   929→        ])\n   930→        self.await_write()\n   931→        assert self.thread.reader.writer.is_alive()\n   932→\n   933→        self.await_write()\n   934→        data = self.await_read(read_all=True)\n   935→        self.await_close()\n   936→\n   937→        assert data == self.content([segments[1]], prop=\"content_plain\")\n   938→        assert mock_log.error.mock_calls == [call(\"Error while decrypting segment 0: PKCS#7 padding is incorrect.\")]\n   939→\n   940→    def test_hls_encrypted_switch_methods(self):\n   941→        aesKey1, aesIv1, key_aes128_1 = self.gen_key()\n   942→        aesKey2, aesIv2, key_aes128_2 = self.gen_key()\n   943→        key_none = Tag(\"EXT-X-KEY\", {\"METHOD\": \"NONE\"})\n   944→\n   945→        segments = self.subject([\n   946→            Playlist(\n   947→                0,\n   948→                [\n   949→                    key_aes128_1,\n   950→                    SegmentEnc(0, aesKey1, aesIv1),\n   951→                    SegmentEnc(1, aesKey1, aesIv1),\n   952→                    key_none,\n   953→                    Segment(2),\n   954→                    Segment(3),\n   955→                    key_aes128_2,\n   956→                    SegmentEnc(4, aesKey2, aesIv2),\n   957→                    SegmentEnc(5, aesKey2, aesIv2),\n   958→                ],\n   959→                end=True,\n   960→            ),\n   961→        ])\n   962→\n   963→        self.await_write(6)\n   964→        data = self.await_read(read_all=True)\n   965→        self.await_close()\n   966→\n   967→        expected = self.content(segments, prop=\"content_plain\", cond=lambda s: 0 <= s.num <= 1)\n   968→        expected += self.content(segments, cond=lambda s: 2 <= s.num <= 3)\n   969→        expected += self.content(segments, prop=\"content_plain\", cond=lambda s: 4 <= s.num <= 5)\n   970→        assert data == expected, \"Switches between encryption key methods\"\n   971→\n   972→\n   973→@patch(\"streamlink.stream.hls.hls.HLSStreamWorker.wait\", Mock(return_value=True))\n   974→class TestHlsPlaylistReloadTime(TestMixinStreamHLS, unittest.TestCase):\n   975→    segments = [\n   976→        Segment(0, duration=11),\n   977→        Segment(1, duration=7),\n   978→        Segment(2, duration=5),\n   979→        Segment(3, duration=3),\n   980→    ]\n   981→\n   982→    def get_session(self, options=None, reload_time=None, *args, **kwargs):\n   983→        return super().get_session(\n   984→            dict(\n   985→                options or {},\n   986→                **{\n   987→                    \"hls-live-edge\": 3,\n   988→                    \"hls-playlist-reload-time\": reload_time,\n   989→                },\n   990→            ),\n   991→        )\n   992→\n   993→    def subject(self, *args, **kwargs):\n   994→        super().subject(*args, start=False, **kwargs)\n   995→\n   996→        # mock the worker thread's _playlist_reload_time method, so that the main thread can wait on its call\n   997→        playlist_reload_time_called = Event()\n   998→        orig_playlist_reload_time = self.thread.reader.worker._playlist_reload_time\n   999→\n  1000→        def mocked_playlist_reload_time(*args, **kwargs):\n  1001→            playlist_reload_time_called.set()\n  1002→            return orig_playlist_reload_time(*args, **kwargs)\n  1003→\n  1004→        # immediately kill the writer thread as we don't need it and don't want to wait for its queue polling to end\n  1005→        def moc