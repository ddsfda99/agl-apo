→        else:\n   103→            p = urlparse(key.uri)\n   104→            formatter = Formatter({\n   105→                \"url\": lambda: key.uri,\n   106→                \"scheme\": lambda: p.scheme,\n   107→                \"netloc\": lambda: p.netloc,\n   108→                \"path\": lambda: p.path,\n   109→                \"query\": lambda: p.query,\n   110→            })\n   111→            key_uri = formatter.format(self.key_uri_override)\n   112→\n   113→        if key_uri and self.key_uri != key_uri:\n   114→            try:\n   115→                res = self.session.http.get(\n   116→                    key_uri,\n   117→                    exception=StreamError,\n   118→                    retries=self.retries,\n   119→                    **self.reader.request_params,\n   120→                )\n   121→            except StreamError as err:\n   122→                # FIXME: fix HTTPSession.request()\n   123→                original_error = getattr(err, \"err\", None)\n   124→                if isinstance(original_error, InvalidSchema):\n   125→                    raise StreamError(f\"Unable to find connection adapter for key URI: {key_uri}\") from original_error\n   126→                raise  # pragma: no cover\n   127→\n   128→            res.encoding = \"binary/octet-stream\"\n   129→            self.key_data = res.content\n   130→            self.key_uri = key_uri\n   131→\n   132→        iv = key.iv or self.num_to_iv(num)\n   133→\n   134→        # Pad IV if needed\n   135→        iv = b\"\\x00\" * (16 - len(iv)) + iv\n   136→\n   137→        return AES.new(self.key_data, AES.MODE_CBC, iv)\n   138→\n   139→    def create_request_params(self, num: int, segment: HLSSegment | Map, is_map: bool):\n   140→        request_params = dict(self.reader.request_params)\n   141→        headers = request_params.pop(\"headers\", {})\n   142→\n   143→        if segment.byterange:\n   144→            if is_map:\n   145→                bytes_start, bytes_end = self.byterange.uncached(segment.byterange)\n   146→            else:\n   147→                bytes_start, bytes_end = self.byterange.cached(num, segment.byterange)\n   148→            headers[\"Range\"] = f\"bytes={bytes_start}-{bytes_end}\"\n   149→\n   150→        request_params[\"headers\"] = headers\n   151→\n   152→        return request_params\n   153→\n   154→    def put(self, segment: HLSSegment | None):\n   155→        if self.closed:\n   156→            return\n   157→\n   158→        if segment is None:\n   159→            self.queue(None, None)\n   160→            return\n   161→\n   162→        # queue segment-map first\n   163→        if segment.map is not None:\n   164→            # get the cached segment-map, if available\n   165→            future = self.map_cache.get(segment.map.uri)\n   166→            if future and segment.discontinuity:\n   167→                # special case: queue the cached segment map if it's set on a discontinuity segment\n   168→                self.queue(segment, future, True)\n   169→            elif not future:\n   170→                # keep the segment-map in the cache, so we can check whether we've already queued it\n   171→                future = self.executor.submit(self.fetch_map, segment)\n   172→                self.map_cache.set(segment.map.uri, future)\n   173→                self.queue(segment, future, True)\n   174→\n   175→        # regular segment request\n   176→        future = self.executor.submit(self.fetch, segment)\n   177→        self.queue(segment, future, False)\n   178→\n   179→    def fetch(self, segment: HLSSegment) -> Response | None:\n   180→        try:\n   181→            return self._fetch(\n   182→                segment.uri,\n   183→                stream=self.stream_data,\n   184→                **self.create_request_params(segment.num, segment, False),\n   185→            )\n   186→        except StreamError as err:\n   187→            log.error(f\"Failed to fetch segment {segment.num}: {err}\")\n   188→\n   189→    def fetch_map(self, segment: HLSSegment) -> Response | None:\n   190→        segment_map: Map = segment.map  # type: ignore[assignment]  # map is not None\n   191→        try:\n   192→            return self._fetch(\n   193→                segment_map.uri,\n   194→                stream=False,\n   195→                **self.create_request_params(segment.num, segment_map, True),\n   196→            )\n   197→        except StreamError as err:\n   198→            log.error(f\"Failed to fetch map for segment {segment.num}: {err}\")\n   199→\n   200→    def _fetch(self, url: str, **request_params) -> Response | None:\n   201→        if self.closed or not self.retries:  # pragma: no cover\n   202→            return None\n   203→\n   204→        return self.session.http.get(\n   205→            url,\n   206→            timeout=self.timeout,\n   207→            retries=self.retries,\n   208→            exception=StreamError,\n   209→            **request_params,\n   210→        )\n   211→\n   212→    def should_filter_segment(self, segment: HLSSegment) -> bool:\n   213→        return self.ignore_names is not None and self.ignore_names.search(segment.uri) is not None\n   214→\n   215→    def write(self, segment: HLSSegment, result: Response, *data):\n   216→        if not self.should_filter_segment(segment):\n   217→            log.debug(f\"Writing segment {segment.num} to output\")\n   218→\n   219→            written_once = self.reader.buffer.written_once\n   220→            try:\n   221→                return self._write(segment, result, *data)\n   222→            finally:\n   223→                is_paused = self.reader.is_paused()\n   224→\n   225→                # Depending on the filtering implementation, the segment's discontinuity attribute can be missing.\n   226→                # Also check if the output will be resumed after data has already been written to the buffer before.\n   227→                if segment.discontinuity or is_paused and written_once:\n   228→                    log.warning(\n   229→                        \"Encountered a stream discontinuity. This is unsupported and will result in incoherent output data.\",\n   230→                    )\n   231→\n   232→                # unblock reader thread after writing data to the buffer\n   233→                if is_paused:\n   234→                    log.info(\"Resuming stream output\")\n   235→                    self.reader.resume()\n   236→\n   237→        else:\n   238→            log.debug(f\"Discarding segment {segment.num}\")\n   239→\n   240→            # Read and discard any remaining HTTP response data in the response connection.\n   241→            # Unread data in the HTTPResponse connection blocks the connection from being released back to the pool.\n   242→            result.raw.drain_conn()\n   243→\n   244→            # block reader thread if filtering out segments\n   245→            if not self.reader.is_paused():\n   246→                log.info(\"Filtering out segments and pausing stream output\")\n   247→                self.reader.pause()\n   248→\n   249→    def _write(self, segment: HLSSegment, result: Response, is_map: bool):\n   250→        # TODO: Rewrite HLSSegment, HLSStreamWriter and HLSStreamWorker based on independent initialization section segments,\n   251→        #       similar to the DASH implementation\n   252→        key = segment.map.key if is_map and segment.map else segment.key\n   253→        if key and key.method != \"NONE\":\n   254→            try:\n   255→                decryptor = self.create_decryptor(key, segment.num)\n   256→            except (StreamError, ValueError) as err:\n   257→                log.error(f\"Failed to create decryptor: {err}\")\n   258→                self.close()\n   259→                return\n   260→\n   261→            try:\n   262→                # Unlike plaintext segments, encrypted segments can't be written to the buffer in small chunks\n   263→                # because of the byte padding at the end of the decrypted data, which means that decrypting in\n   264→                # smaller chunks is unnecessary if the entire segment needs to be kept in memory anyway, unless\n   265→                # we defer the buffer writes by one read call and apply the unpad call only to the last read call.\n   266→                encrypted_chunk = result.content\n   267→                decrypted_chunk = decryptor.decrypt(encrypted_chunk)\n   268→                chunk = unpad(decrypted_chunk, AES.block_size, style=\"pkcs7\")\n   269→                self.reader.buffer.write(chunk)\n   270→            except (ChunkedEncodingError, ContentDecodingError, ConnectionError) as err:\n   271→                log.error(f\"Download of segment {segment.num} failed: {err}\")\n   272→                return\n   273→            except ValueError as err:\n   274→                log.error(f\"Error while decrypting segment {segment.num}: {err}\")\n   275→                return\n   276→\n   277→        else:\n   278→            try:\n   279→                for chunk in result.iter_content(self.WRITE_CHUNK_SIZE):\n   280→                    self.reader.buffer.write(chunk)\n   281→            except (ChunkedEncodingError, ContentDecodingError, ConnectionError) as err:\n   282→                log.error(f\"Download of segment {segment.num} failed: {err}\")\n   283→                return\n   284→\n   285→        if is_map:\n   286→            log.debug(f\"Segment initialization {segment.num} complete\")\n   287→        else:\n   288→            log.debug(f\"Segment {segment.num} complete\")\n   289→\n   290→\n   291→class HLSStreamWorker(SegmentedStreamWorker[HLSSegment, Response]):\n   292→    reader: HLSStreamReader\n   293→    writer: HLSStreamWriter\n   294→    stream: HLSStream\n   295→\n   296→    SEGMENT_QUEUE_TIMING_THRESHOLD_MIN = 5.0\n   297→\n   298→    def __init__(self, *args, **kwargs) -> None:\n   299→        super().__init__(*args, **kwargs)\n   300→\n   301→        self.playlist_changed = False\n   302→        self.playlist_end: int | None = None\n   303→        self.playlist_targetduration: float = 0\n   304→        self.playlist_sequence: int = -1\n   305→        self.playlist_sequence_last: datetime = now()\n   306→        self.playlist_segments: list[HLSSegment] = []\n   307→\n   308→        self.playlist_reload_last: datetime = now()\n   309→        self.playlist_reload_time: float = 6\n   310→        self.playlist_reload_time_override = self.session.options.get(\"hls-playlist-reload-time\")\n   311→        self.playlist_reload_retries = self.session.options.get(\"hls-playlist-reload-attempts\")\n   312→        self.segment_queue_timing_threshold_factor = self.session.options.get(\"hls-segment-queue-threshold\")\n   313→        self.live_edge = self.session.options.get(\"hls-live-edge\")\n   314→        self.duration_offset_start = int(self.stream.start_offset + (self.session.options.get(\"hls-start-offset\") or 0))\n   315→        self.duration_limit = self.stream.duration or (\n   316→            int(self.session.options.get(\"hls-duration\")) if self.session.options.get(\"hls-duration\") else None\n   317→        )\n   318→        self.hls_live_restart = self.stream.force_restart or self.session.options.get(\"hls-live-restart\")\n   319→\n   320→        if str(self.playlist_reload_time_override).isnumeric() and float(self.playlist_reload_time_override) >= 2:\n   321→            self.playlist_reload_time_override = float(self.playlist_reload_time_override)\n   322→        elif self.playlist_reload_time_override not in [\"segment\", \"live-edge\"]:\n   323→            self.playlist_reload_time_override = 0\n   324→\n   325→    def _fetch_playlist(self) -> Response:\n   326→        res = self.session.http.get(\n   327→            self.stream.url,\n   328→            exception=StreamError,\n   329→            retries=self.playlist_reload_retries,\n   330→            **self.reader.request_params,\n   331→        )\n   332→        res.encoding = \"utf-8\"\n   333→\n   334→        return res\n   335→\n   336→    def reload_playlist(self):\n   337→        if self.closed:  # pragma: no cover\n   338→            return\n   339→\n   340→        self.reader.buffer.wait_free()\n   341→\n   342→        log.debug(\"Reloading playlist\")\n   343→        res = self._fetch_playlist()\n   344→\n   345→        try:\n   346→            playlist = parse_m3u8(res, parser=self.stream.__parser__)\n   347→        except ValueError as err:\n   348→            raise StreamError(err) from err\n   349→\n   350→        if playlist.is_master:\n   351→            raise StreamError(f\"Attempted to play a variant playlist, use 'hls://{self.stream.url}' instead\")\n   352→\n   353→        if playlist.iframes_only:\n   354→            raise StreamError(\"Streams containing I-frames only are not playable\")\n   355→\n   356→        self.playlist_targetduration = playlist.targetduration or 0\n   357→        self.playlist_reload_time = self._playlist_reload_time(playlist)\n   358→\n   359→        if playlist.segments:\n   360→            self.process_segments(playlist)\n   361→\n   362→    def _playlist_reload_time(self, playlist: M3U8[HLSSegment, HLSPlaylist]) -> float:\n   363→        if self.playlist_reload_time_override == \"segment\" and playlist.segments:\n   364→            return playlist.segments[-1].duration\n   365→        if self.playlist_reload_time_override == \"live-edge\" and playlist.segments:\n   366→            return sum(s.duration for s in playlist.segments[-max(1, self.live_edge - 1) :])\n   367→        if type(self.playlist_reload_time_override) is float and self.playlist_reload_time_override > 0:\n   368→            return self.playlist_reload_time_override\n   369→        if playlist.targetduration:\n   370→            return playlist.targetduration\n   371→        if playlist.segments:\n   372→            return sum(s.duration for s in playlist.segments[-max(1, self.live_edge - 1) :])\n   373→\n   374→        return self.playlist_reload_time\n   375→\n   376→    def process_segments(self, playlist: M3U8[HLSSegment, HLSPlaylist]) -> None:\n   377→        segments = playlist.segments\n   378→        first_segment, last_segment = segments[0], segments[-1]\n   379→\n   380→        if first_segment.key and first_segment.key.method != \"NONE\":\n   381→            log.debug(\"Segments in this playlist are encrypted\")\n   382→\n   383→        self.playlist_changed = [s.num for s in self.playlist_segments] != [s.num for s in segments]\n   384→        self.playlist_segments = segments\n   385→\n   386→        if not self.playlist_changed:\n   387→            self.playlist_reload_time = max(self.playlist_reload_time / 2, 1)\n   388→\n   389→        if playlist.is_endlist:\n   390→            self.playlist_end = last_segment.num\n   391→\n   392→        if self.playlist_sequence < 0:\n   393→            if self.playlist_end is None and not self.hls_live_restart:\n   394→                edge_index = -(min(len(segments), max(int(self.live_edge), 1)))\n   395→                edge_segment = segments[edge_index]\n   396→                self.playlist_sequence = edge_segment.num\n   397→            else:\n   398→                self.playlist_sequence = first_segment.num\n   399→\n   400→    def valid_segment(self, segment: HLSSegment) -> bool:\n   401→        return segment.num >= self.playlist_sequence\n   402→\n   403→    def _segment_queue_timing_threshold_reached(self) -> bool:\n   404→        if self.segment_queue_timing_threshold_factor <= 0:\n   405→            return False\n   406→\n   407→        threshold = max(\n   408→            self.SEGMENT_QUEUE_TIMING_THRESHOLD_MIN,\n   409→            self.playlist_targetduration * self.segment_queue_timing_threshold_factor,\n   410→        )\n   411→        if now() <= self.playlist_sequence_last + timedelta(seconds=threshold):\n   412→            return False\n   413→\n   414→        log.warning(f\"No new segments in playlist for more than {threshold:.2f}s. Stopping...\")\n   415→        return True\n   416→\n   417→    @staticmethod\n   418→    def duration_to_sequence(duration: float, segments: list[HLSSegment]) -> int:\n   419→        d = 0.0\n   420→        default = -1\n   421→\n   422→        segments_order = segments if duration >= 0 else reversed(segments)\n   423→\n   424→        for segment in segments_order:\n   425→            if d >= abs(duration):\n   426→                return segment.num\n   427→            d += segment.duration\n   428→            default = segment.num\n   429→\n   430→        # could not skip far enough, so return the default\n   431→        return default\n   432→\n   433→    def iter_segments(self):\n   434→        self.playlist_reload_last \\\n   435→            = self.playlist_sequence_last \\\n   436→            = now()  # fmt: skip\n   437→\n   438→        try:\n   439→            self.reload_playlist()\n   440→        except StreamError as err:\n   441→            log.error(f\"{err}\")\n   442→            self.reader.close()\n   443→            return\n   444→\n   445→        if self.playlist_end is None:\n   446→            if self.duration_offset_start > 0:\n   447→                log.debug(f\"Time offsets negative for live streams, skipping back {self.duration_offset_start} seconds\")\n   448→            # live playlist, force offset durations back to None\n   449→            self.duration_offset_start = -self.duration_offset_start\n   450→\n   451→        if self.duration_offset_start != 0:\n   452→            self.playlist_sequence = self.duration_to_sequence(self.duration_offset_start, self.playlist_segments)\n   453→\n   454→        if self.playlist_segments:\n   455→            log.debug(\n   456→                \"; \".join([\n   457→                    f\"First Sequence: {self.playlist_segments[0].num}\",\n   458→                    f\"Last Sequence: {self.playlist_segments[-1].num}\",\n   459→               