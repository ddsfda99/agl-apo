est from {user_agent}\")\n   228→\n   229→        stream_fd = prebuffer = None\n   230→        while not stream_fd and (not player or player.running):\n   231→            try:\n   232→                if not initial_streams_used:\n   233→                    streams = initial_streams\n   234→                    initial_streams_used = True\n   235→                else:\n   236→                    streams = fetch_streams(plugin)\n   237→\n   238→                for stream_name in (resolve_stream_name(streams, s) for s in args.stream):\n   239→                    if stream_name in streams:\n   240→                        stream = streams[stream_name]\n   241→                        break\n   242→                else:\n   243→                    log.info(\"Stream not available, will re-fetch streams in 10 sec\")\n   244→                    sleep(10)\n   245→                    continue\n   246→            except PluginError as err:\n   247→                log.error(f\"Unable to fetch new streams: {err}\")\n   248→                continue\n   249→\n   250→            try:\n   251→                log.info(f\"Opening stream: {stream_name} ({type(stream).shortname()})\")\n   252→                stream_fd, prebuffer = open_stream(stream)\n   253→            except StreamError as err:\n   254→                log.error(err)\n   255→\n   256→        if stream_fd and prebuffer:\n   257→            log.debug(\"Writing stream to player\")\n   258→            stream_runner = StreamRunner(stream_fd, server)\n   259→            try:\n   260→                stream_runner.run(prebuffer)\n   261→            except OSError as err:\n   262→                # TODO: refactor all console.exit() calls\n   263→                console.exit(str(err))\n   264→\n   265→        if not continuous:\n   266→            break\n   267→\n   268→        server.close()\n   269→\n   270→    if player:\n   271→        player.close()\n   272→    server.shutdown()\n   273→\n   274→\n   275→def output_stream_passt