  330→        stream_fd.close()\n   331→        raise StreamError(\"No data returned from stream\")\n   332→\n   333→    return stream_fd, prebuffer\n   334→\n   335→\n   336→def output_stream(stream, formatter: Formatter):\n   337→    \"\"\"Open stream, create output and finally write the stream to output.\"\"\"\n   338→    global output\n   339→\n   340→    # create output before opening the stream, so file outputs can prompt on existing output\n   341→    output = create_output(formatter)\n   342→\n   343→    success_open = False\n   344→    for i in range(args.retry_open):\n   345→        try:\n   346→            stream_fd, prebuffer = open_stream(stream)\n   347→            success_open = True\n   348→            break\n   349→        except StreamError as err:\n   350→            log.error(f\"Try {i + 1}/{args.retry_open}: Could not open stream {stream} ({err})\")\n   351→\n   352→    if not success_open:\n   353→        return console.exit(f\"Could not open stream {stream}, tried {args.retry_open} times, exiting\")\n   354→\n   355→    try:\n   356→        output.open()\n   357→    except OSError as err:\n   358→        if isinstance(output, PlayerOutput):\n   359→            console.exit(f\"Failed to start player: {args.player} ({err})\")\n   360→        elif output.filename:\n   361→            console.exit(f\"Failed to open output: {output.filename} ({err})\")\n   362→        else:\n   363→            console.exit(f\"Failed to open output ({err}\")\n   364→        return\n   365→\n   366→    try:\n   367→        with closing(output):\n   368→            log.debug(\"Writing stream to output\")\n   369→            show_progress = args.progress == \"force\" or args.progress == \"yes\" and sys.stderr.isatty()\n   370→            if args.force_progress:\n   371→                show_progress = True\n   372→                warnings.warn(\n   373→                    \"The --force-progress option has been deprecated in favor of --progress=force\",\n   374→                    StreamlinkDeprecationWarning,\n   375→                    stacklevel=1,\n   376→                )\n   377→            # TODO: finally clean up the global variable mess and refactor the streamlink_cli package\n   378→            # noinspection PyUnboundLocalVariable\n   379→            stream_runner = StreamRunner(stream_fd, output, show_progress=show_progress)\n   380→            # noinspection PyUnboundLocalVariable\n   381→            stream_runner.run(prebuffer)\n   382→    except OSError as err:\n   383→        # TODO: refactor all console.exit() calls\n   384→        console.exit(str(err))\n   385→\n   386→    return True\n   387→\n   388→\n   389→def handle_stream(plugin: Plugin, streams: Dict[str, Stream], stream_name: str) -> None:\n   390→    \"\"\"Decides what to do with the selected stream.\n   391→\n   392→    Depending on arguments it can be one of these:\n   393→     - Output JSON represenation\n   394→     - Output the stream URL\n   395→     - Continuously output the stream over HTTP\n   396→     - Output stream data to selected output\n   397→\n   398→    \"\"\"\n   399→\n   400→    stream_name = resolve_stream_name(streams, stream_name)\n   401→    stream = streams[stream_name]\n   402→\n   403→    # Print JSON representation of the stream\n   404→    if args.json:\n   405→        console.msg_json(\n   406→            stream,\n   407→            metadata=plugin.get_metadata(),\n   408→        )\n   409→\n   410→    elif args.stream_url:\n   411→        try:\n   412→            console.msg(stream.to_url())\n   413→        except TypeError:\n   414→            console.exit(\"The stream specified cannot be translated to a URL\")\n   415→\n   416→    else:\n   417→        # Find any streams with a '_alt' suffix and attempt\n   418→        # to use these in case the main stream is not usable.\n   419→        alt_streams = list(filter(lambda k: f\"{stream_name}_alt\" in k, sorted(streams.keys())))\n   420→\n   421→        file_output = args.output or args.stdout\n   422→\n   423→        formatter = get_formatter(plugin)\n   424→\n   425→        for name in [stream_name, *alt_streams]:\n   426→            stream = streams[name]\n   427→            stream_type = type(stream).shortname()\n   428→\n   429→            if stream_type in args.player_passthrough and not file_output:\n   430→                log.info(f\"Opening stream: {name} ({stream_type})\")\n   431→                success = output_stream_passthrough(stream, formatter)\n   432→            elif args.player_external_http:\n   433→                return output_stream_http(\n   434→                    plugin,\n   435→                    streams,\n   436→                    formatter,\n   437→                    external=True,\n   438→                    continuous=args.player_external_http_continuous,\n   439→                    port=args.player_external_http_port,\n   440→                )\n   441→            elif args.player_continuous_http and not file_output:\n   442→                return output_stream_http(plugin, streams, formatter)\n   443→            else:\n   444→                log.info(f\"Opening stream: {name} ({stream_type})\")\n   445→                success = output_stream(stream, formatter)\n   446→\n   447→            if success:\n   448→                break\n   449→\n   450→\n   451→def fetch_streams(plugin: Plugin) -> Dict[str, Stream]:\n   452→    \"\"\"Fetches streams using correct parameters.\"\"\"\n   453→\n   454→    return plugin.streams(stream_types=args.stream_types,\n   455→                          sorting_excludes=args.stream_sorting_excludes)\n   456→\n   457→\n   458→def fetch_streams_with_retry(plugin: Plugin, interval: float, count: int) -> Optional[Dict[str, Stream]]:\n   459→    \"\"\"Attempts to fetch streams repeatedly\n   460→       until some are returned or limit hit.\"\"\"\n   461→\n   462→    try:\n   463→        streams = fetch_streams(plugin)\n   464→    except PluginError as err:\n   465→        log.error(err)\n   466→        streams = None\n   467→\n   468→    if not streams:\n   469→        log.info(f\"Waiting for streams, retrying every {interval} second(s)\")\n   470→    attempts = 0\n   471→\n   472→    while not streams:\n   473→        sleep(interval)\n   474→\n   475→        try:\n   476→            streams = fetch_streams(plugin)\n   477→        except FatalPluginError:\n   478→            raise\n   479→        except PluginError as err:\n   480→            log.error(err)\n   481→\n   482→        if count > 0:\n   483→            attempts += 1\n   484→            if attempts >= count:\n   485→                break\n   486→\n   487→    return streams\n   488→\n   489→\n   490→def resolve_stream_name(streams: Dict[str, Stream], stream_name: str) -> str:\n   491→    \"\"\"Returns the real stream name of a synonym.\"\"\"\n   492→\n   493→    if stream_name in STREAM_SYNONYMS and stream_name in streams:\n   494→        for name, stream in streams.items():\n   495→            if stream is streams[stream_name] and name not in STREAM_SYNONYMS:\n   496→                return name\n   497→\n   498→    return stream_name\n   499→\n   500→\n   501→def format_valid_streams(plugin: Plugin, streams: Dict[str, Stream]) -> str:\n   502→    \"\"\"Formats a dict of streams.\n   503→\n   504→    Filters out synonyms and displays them next to\n   505→    the stream they point to.\n   506→\n   507→    Streams are sorted according to their quality\n   508→    (based on plugin.stream_weight).\n   509→\n   510→    \"\"\"\n   511→\n   512→    delimiter = \", \"\n   513→    validstreams = []\n   514→\n   515→    for name, stream in sorted(streams.items(), key=lambda s: plugin.stream_weight(s[0])):\n   516→        if name in STREAM_SYNONYMS:\n   517→            continue\n   518→\n   519→        synonyms = [key for key, value in streams.items() if stream is value and key != name]\n   520→\n   521→        if synonyms:\n   522→            joined = delimiter.join(synonyms)\n   523→            name = f\"{name} ({joined})\"\n   524→\n   525→        validstreams.append(name)\n   526→\n   527→    return delimiter.join(validstreams)\n   528→\n   529→\n   530→def handle_url():\n   531→    \"\"\"The URL handler.\n   532→\n   533→    Attempts to resolve the URL to a plugin and then attempts\n   534→    to fetch a list of available streams.\n   535→\n   536→    Proceeds to handle stream if user specified a valid one,\n   537→    otherwise output list of valid streams.\n   538→\n   539→    \"\"\"\n   540→\n   541→    try:\n   542→        pluginname, pluginclass, resolved_url = streamlink.resolve_url(args.url)\n   543→        options = setup_plugin_options(pluginname, pluginclass)\n   544→        plugin = pluginclass(streamlink, resolved_url, options)\n   545→        log.info(f\"Found matching plugin {pluginname} for URL {args.url}\")\n   546→\n   547→        if args.retry_max or args.retry_streams:\n   548→            retry_streams = 1\n   549→            retry_max = 0\n   550→            if args.retry_streams:\n   551→                retry_streams = args.retry_streams\n   552→            if args.retry_max:\n   553→                retry_max = args.retry_max\n   554→            streams = fetch_streams_with_retry(plugin, retry_streams, retry_max)\n   555→        else:\n   556→            streams = fetch_streams(plugin)\n   557→    except NoPluginError:\n   558→        console.exit(f\"No plugin can handle URL: {args.url}\")\n   559→    except PluginError as err:\n   560→        console.exit(str(err))\n   561→\n   562→    if not streams:\n   563→        console.exit(f\"No playable streams found on this URL: {args.url}\")\n   564→\n   565→    if args.default_stream and not args.stream and not args.json:\n   566→        args.stream = args.default_stream\n   567→\n   568→    if args.stream:\n   569→        validstreams = format_valid_streams(plugin, streams)\n   570→        for stream_name in args.stream:\n   571→            if stream_name in streams:\n   572→                log.info(f\"Available streams: {validstreams}\")\n   573→                handle_stream(plugin, streams, stream_name)\n   574→                return\n   575→\n   576→        errmsg = f\"The specified stream(s) '{', '.join(args.stream)}' could not be found\"\n   577→        if args.json:\n   578→            console.msg_json(\n   579→                plugin=plugin.module,\n   580→                metadata=plugin.get_metadata(),\n   581→                streams=streams,\n   582→                error=errmsg,\n   583→            )\n   584→        else:\n   585→            console.exit(f\"{errmsg}.\\n       Available streams: {validstreams}\")\n   586→    elif args.json:\n   587→        console.msg_json(\n   588→            plugin=plugin.module,\n   589→            metadata=plugin.get_metadata(),\n   590→            streams=streams,\n   591→        )\n   592→    elif args.stream_url:\n   593→        try:\n   594→            console.msg(streams[list(streams)[-1]].to_manifest_url())\n   595→        except TypeError:\n   596→            console.exit(\"The stream specified cannot be translated to a URL\")\n   597→    else:\n   598→        validstreams = format_valid_streams(plugin, streams)\n   599→        console.msg(f\"Available streams: {validstreams}\")\n   600→\n   601→\n   602→def print_plugins():\n   603→    \"\"\"Outputs a list of all plugins Streamlink has loaded.\"\"\"\n   604→\n   605→    pluginlist = streamlink.plugins.get_names()\n   606→\n   607→    if args.json:\n   608→        console.msg_json(pluginlist)\n   609→    else:\n   610→        console.msg(f\"Available plugins: {', '.join(pluginlist)}\")\n   611→\n   612→\n   613→def load_plugins(dirs: List[Path], showwarning: bool = True):\n   614→    \"\"\"Attempts to load plugins from a list of directories.\"\"\"\n   615→    for directory in dirs:\n   616→        if directory.is_dir():\n   617→            success = streamlink.plugins.load_path(directory)\n   618→            if success and type(directory) is DeprecatedPath:\n   619→                warnings.warn(\n   620→                    f\"Loaded plugins from deprecated path, see CLI docs for how to migrate: {directory}\",\n   621→                    StreamlinkDeprecationWarning,\n   622→                    stacklevel=1,\n   623→                )\n   624→        elif showwarning:\n   625→            log.warning(f\"Plugin path {directory} does not exist or is not a directory!\")\n   626→\n   627→\n   628→def setup_args(\n   629→    parser: argparse.ArgumentParser,\n   630→    config_files: Optional[List[Path]] = None,\n   631→    ignore_unknown: bool = False,\n   632→):\n   633→    \"\"\"Parses arguments.\"\"\"\n   634→    global args\n   635→    arglist = sys.argv[1:]\n   636→\n   637→    # Load arguments from config files\n   638→    configs = [f\"@{config_file}\" for config_file in config_files or []]\n   639→\n   640→    args, unknown = parser.parse_known_args(configs + arglist)\n   641→    if unknown and not ignore_unknown:\n   642→        msg = gettext(\"unrecognized arguments: %s\")\n   643→        parser.error(msg % \" \".join(unknown))\n   644→\n   645→    # Force lowercase to allow case-insensitive lookup\n   646→    if args.stream:\n   647→        args.stream = [stream.lower() for stream in args.stream]\n   648→\n   649→    if not args.url and args.url_param:\n   650→        args.url = args.url_param\n   651→\n   652→\n   653→def setup_config_args(parser, ignore_unknown=False):\n   654→    if args.no_config:\n   655→        return\n   656→\n   657→    config_files = []\n   658→\n   659→    if args.config:\n   660→        # We want the config specified last to get the highest priority\n   661→        config_files.extend(\n   662→            config_file\n   663→            for config_file in [Path(path).expanduser() for path in reversed(args.config)]\n   664→            if config_file.is_file()\n   665→        )\n   666→\n   667→    else:\n   668→        # Only load first available default config\n   669→        for config_file in filter(lambda path: path.is_file(), CONFIG_FILES):  # pragma: no branch\n   670→            if type(config_file) is DeprecatedPath:\n   671→                warnings.warn(\n   672→                    f\"Loaded config from deprecated path, see CLI docs for how to migrate: {config_file}\",\n   673→                    StreamlinkDeprecationWarning,\n   674→                    stacklevel=1,\n   675→                )\n   676→            config_files.append(config_file)\n   677→            break\n   678→\n   679→    if streamlink and args.url:\n   680→        # Only load first available plugin config\n   681→        with suppress(NoPluginError):\n   682→            pluginname, _pluginclass, _resolved_url = streamlink.resolve_url(args.url)\n   683→            for config_file in CONFIG_FILES:  # pragma: no branch\n   684→                config_file = config_file.with_name(f\"{config_file.name}.{pluginname}\")\n   685→                if not config_file.is_file():\n   686→                    continue\n   687→                if type(config_file) is DeprecatedPath:\n   688→                    warnings.warn(\n   689→                        f\"Loaded plugin config from deprecated path, see CLI docs for how to migrate: {config_file}\",\n   690→                        StreamlinkDeprecationWarning,\n   691→                        stacklevel=1,\n   692→                    )\n   693→                config_files.append(config_file)\n   694→                break\n   695→\n   696→    if config_files:\n   697→        setup_args(parser, config_files, ignore_unknown=ignore_unknown)\n   698→\n   699→\n   700→def setup_signals():\n   701→    # restore default behavior of raising a KeyboardInterrupt on SIGINT (and SIGTERM)\n   702→    # so cleanup code can be run when the user stops execution\n   703→    signal.signal(signal.SIGINT, signal.default_int_handler)\n   704→    signal.signal(signal.SIGTERM, signal.default_int_handler)\n   705→\n   706→\n   707→def setup_plugins(extra_plugin_dir=None):\n   708→    \"\"\"Loads any additional plugins.\"\"\"\n   709→    load_plugins(PLUGIN_DIRS, showwarning=False)\n   710→\n   711→    if extra_plugin_dir:\n   712→        load_plugins([Path(path).expanduser() for path in extra_plugin_dir])\n   713→\n   714→\n   715→def setup_streamlink():\n   716→    \"\"\"Creates the Streamlink session.\"\"\"\n   717→    global streamlink\n   718→\n   719→    streamlink = Streamlink({\"user-input-requester\": ConsoleUserInputRequester(console)})\n   720→\n   721→\n   722→def setup_plugin_args(session: Streamlink, parser: ArgumentParser):\n   723→    \"\"\"Adds plugin argument data to the argument parser.\"\"\"\n   724→\n   725→    plugin_args = parser.add_argument_group(\"Plugin options\")\n   726→    for pname, arguments in session.plugins.iter_arguments():\n   727→        group = parser.add_argument_group(pname.capitalize(), parent=plugin_args)\n   728→\n   729→        for parg in arguments:\n   730→            group.add_argument(parg.argument_name(pname), **parg.options)\n   731→\n   732→\n   733→def setup_plugin_options(pluginname: str, pluginclass: Type[Plugin]) -> Options:\n   734→    \"\"\"Initializes plugin options from argument values.\"\"\"\n   735→\n   736→    if not pluginclass.arguments:\n   737→        return Options()\n   738→\n   739→    defaults = {}\n   740→    values = {}\n   741→    required = {}\n   742→\n   743→    for parg in pluginclass.arguments:\n   744→        defaults[parg.dest] = parg.default\n   745→\n   746→        if parg.help == argparse.SUPPRESS:\n   747→            continue\n   748→\n   749→        value = getattr(args, parg.namespace_dest(pluginname))\n   750→        values[parg.dest] = value\n   751→\n   752→        if parg.required:\n   753→            required[parg.name] = parg\n   754→        # if the value is set, check to see if any of the required arguments are not set\n   755→        if parg.required or value:\n   756→            try:\n   757→                for rparg in pluginclass.arguments.requires(parg.name):\n   758→                    required[rparg.name] = rparg\n   759→            except RuntimeError:  # pragma: no cover\n   760→                log.error(f\"{pluginname} plugin has a configuration error and the arguments cannot be parsed\")\n   761→                break\n   762→\n   763→    for req in required.values():\n   764→        if not values.get(req.dest):\n   765→            prompt = f\"{req.prompt or f'Enter {pluginname} {req.name}'}: \"\n   766→            value = console.askpass(prompt) if req.sensitive else console.ask(prompt)\n   767→            values[req.dest] = value\n   768→\n   769→    options = Options(defaults)\n   770→    options.update(values)\n   771→\n   772→    return options\n   773→\n   774→\n   775→def log_root_warning():\n   776→    if hasattr(os, \"geteuid\"):  # pragma: no branch\n   777→        if os.geteuid() == 0:\n   778→            log.info(\"streamlink is running as root! Be careful!\")\n   779→\n   780→\n   781→def log_current_versions():\n   782→    \"\"\"Show current installed versions\"\"\"\n   783→    if not logger.root.isEnabledFor(logging.DEBUG):\n   784→        return\n   785→\n   786→    # macOS\n   787→    if sys.platform == \"darwin\":\n   788→        os_version = f\"macOS {platform.mac_ver()[0]}\"\n   789→    # Windows\n   790→    elif sys.platform == \"win32\":\n   791→        os_version = f\"{platform.system()} {platform.release()}\"\n   792→    # Linux / other\n   793→    else:\n   794→        os_version = platform.platform()\n   795→\n   796→    log.debug(f\"OS:         {os_version}\")\n   797→    log.debug(f\"Python:     {platform.python_version()}\")\n   798→    log.debug(f\"OpenSSL:    {ssl.OPENSSL_VERSION}\")\n   799→    log.debug(f\"Streamlink: {streamlink_version}\")\n   800→\n   801→    # https://peps.python.org/pep-0508/#names\n   802→    re_name = re.compile(r\"[A-Z\\d](?:[A-Z\\d._-]*[A-Z\\d])?\", re.IGNORECASE)\n   803→    log.debug(\"Dependencies:\")\n   804→    for name in [\n   805→        match.group(0)\n   806→        for match in map(re_name.match, importlib.metadata.requires(\"streamlink\"))\n   807→        if match is not None\n   808→    ]:\n   809→        try:\n   810→            version = importlib.metadata.version(name)\n   811→        except importlib.metadata.PackageNotFoundError:\n   812→            continue\n   813→        log.debug(f\" {name}: {version}\")\n   814→\n   815→\n   816→def log_current_arguments(session: Streamlink, parser: argparse.ArgumentParser):\n   817→    if not logger.root.isEnabledFor(logging.DEBUG):\n   818→        return\n   819→\n   820→    sensitive = set()\n   821→    for pname, arguments in session.plugins.iter_arguments():\n   822→        for parg in arguments:\n   823→            if parg.sensitive:\n   824→                sensitive.add(parg.argument_name(pname))\n   825→\n   826→    log.debug(\"Arguments:\")\n   827→    for action in parser._actions:\n   828→        if not hasattr(args, action.dest):\n   829→            continue\n   830→        value = getattr(args, action.dest)\n   831→        if action.default != value:\n   832→            name = next(  # pragma: no branch\n   833→                (option for option in action.option_strings if option.startswith(\"--\")),\n   834→                action.option_strings[0],\n   835→            ) if action.option_strings else action.dest\n   836→            log.debug(f\" {name}={value if name not in sensitive else '*' * 8}\")\n   837→\n   838→\n   839→def setup_logger_and_console(stream=sys.stdout, filename=None, level=\"info\", json=False):\n   840→    global console\n   841→\n   842→    if filename == \"-\":\n   843→        filename = LOG_DIR / f\"{datetime.now(tz=LOCALTIMEZONE)}.log\"\n   844→    elif filename:\n   845→        filename = Path(filename).expanduser().resolve()\n   846→\n   847→    if filename:\n   848→        filename.parent.mkdir(parents=True, exist_ok=True)\n   849→\n   850→    verbose = level in (\"trace\", \"all\")\n   851→    streamhandler = logger.basicConfig(\n   852→        stream=stream,\n   853→        filename=filename,\n   854→        level=level,\n   855→        style=\"{\",\n   856→        format=f\"{'[{asctime}]' if verbose else ''}[{{name}}][{{levelname}}] {{message}}\",\n   857→        datefmt=f\"%H:%M:%S{'.%f' if verbose else ''}\",\n   858→        capture_warnings=True,\n   859→    )\n   860→\n   861→    console = ConsoleOutput(streamhandler.stream, json)\n   862→\n   863→\n   864→def main():\n   865→    error_code = 0\n   866→    parser = build_parser()\n   867→\n   868→    setup_args(parser, ignore_unknown=True)\n   869→    # call argument set up as early as possible to load args from config files\n   870→    setup_config_args(parser, ignore_unknown=True)\n   871→\n   872→    # Console output should be on stderr if we are outputting\n   873→    # a stream to stdout.\n   874→    if args.stdout or args.output == \"-\" or args.record == \"-\" or args.record_and_pipe:\n   875→        console_out = sys.stderr\n   876→    else:\n   877→        console_out = sys.stdout\n   878→\n   879→    # We don't want log output when we are printing JSON or a command-line.\n   880→    silent_log = any(getattr(args, attr) for attr in QUIET_OPTIONS)\n   881→    log_level = args.loglevel if not silent_log else \"none\"\n   882→    log_file = args.logfile if log_level != \"none\" else None\n   883→    setup_logger_and_console(console_out, log_file, log_level, args.json)\n   884→\n   885→    setup_streamlink()\n   886→    # load additional plugins\n   887→    setup_plugins(args.plugin_dirs)\n   888→    setup_plugin_args(streamlink, parser)\n   889→    # call setup args again once the plugin specific args have been added\n   890→    setup_args(parser)\n   891→    setup_config_args(parser)\n   892→\n   893→    # update the logging level if changed by a plugin specific config\n   894→    log_level = args.loglevel if not silent_log else \"none\"\n   895→    logger.root.setLe