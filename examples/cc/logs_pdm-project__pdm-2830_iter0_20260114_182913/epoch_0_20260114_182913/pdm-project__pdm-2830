1\u2192\n   482\u2192    sep = termui.Emoji.ARROW_SEPARATOR\n   483\u2192    assert json.loads(result.outputs) == {\n   484\u2192        \"_\": {\"name\": \"_\", \"help\": \"Shared options\", \"kind\": \"shared\", \"env_file\": \".env\"},\n   485\u2192        \"test_cmd\": {\"name\": \"test_cmd\", \"help\": \"flask db upgrade\", \"kind\": \"cmd\", \"args\": \"flask db upgrade\"},\n   486\u2192        \"test_composite\": {\n   487\u2192            \"name\": \"test_composite\",\n   488\u2192            \"help\": f\"test_cmd {sep} test_script {sep} test_shell\",\n   489\u2192            \"kind\": \"composite\",\n   490\u2192            \"args\": [\"test_cmd\", \"test_script\", \"test_shell\"],\n   491\u2192        },\n   492\u2192        \"test_multi\": {\n   493\u2192            \"name\": \"test_multi\",\n   494\u2192            \"help\": f\"I am a multilines{termui.Emoji.ELLIPSIS}\",\n   495\u2192            \"kind\": \"cmd\",\n   496\u2192            \"args\": \"            I am a multilines\\n            command\\n        \",\n   497\u2192        },\n   498\u2192        \"test_script\": {\n   499\u2192            \"name\": \"test_script\",\n   500\u2192            \"help\": \"call a python function\",\n   501\u2192            \"kind\": \"call\",\n   502\u2192            \"args\": \"test_script:main\",\n   503\u2192        },\n   504\u2192        \"test_shell\": {\"name\": \"test_shell\", \"help\": \"shell command\", \"kind\": \"shell\", \"args\": \"echo $FOO\"},\n   505\u2192        \"test_env\": {\"name\": \"test_env\", \"help\": \"true\", \"kind\": \"cmd\", \"args\": \"true\", \"env\": {\"TEST\": \"value\"}},\n   506\u2192        \"test_env_file\": {\"name\": \"test_env_file\", \"help\": \"true\", \"kind\": \"cmd\", \"args\": \"true\", \"env_file\": \".env\"},\n   507\u2192        \"test_override\": {\n   508\u2192            \"name\": \"test_override\",\n   509\u2192            \"help\": \"true\",\n   510\u2192            \"kind\": \"cmd\",\n   511\u2192            \"args\": \"true\",\n   512\u2192            \"env_file.override\": \".env\",\n   513\u2192        },\n   514\u2192        \"test_site_packages\": {\n   515\u2192            \"name\": \"test_site_packages\",\n   516\u2192            \"help\": \"true\",\n   517\u2192            \"kind\": \"cmd\",\n   518\u2192            \"args\": \"true\",\n   519\u2192            \"site_packages\": True,\n   520\u2192        },\n   521\u2192        \"_private\": {\n   522\u2192            \"name\": \"_private\",\n   523\u2192            \"help\": \"true\",\n   524\u2192            \"kind\": \"cmd\",\n   525\u2192            \"args\": \"true\",\n   526\u2192        },\n   527\u2192    }\n   528\u2192\n   529\u2192\n   530\u2192@pytest.mark.usefixtures(\"local_finder\")\n   531\u2192@pytest.mark.parametrize(\"explicit_python\", [True, False])\n   532\u2192def test_run_with_another_project_root(project, pdm, capfd, explicit_python):\n   533\u2192    project.pyproject.metadata[\"requires-python\"] = \">=3.6\"\n   534\u2192    project.pyproject.write()\n   535\u2192    pdm([\"add\", \"first\"], obj=project)\n   536\u2192    with TemporaryDirectory(prefix=\"pytest-run-\") as tmp_dir:\n   537\u2192        Path(tmp_dir).joinpath(\"main.py\").write_text(\"import first;print(first.first([0, False, 1, 2]))\\n\")\n   538\u2192        capfd.readouterr()\n   539\u2192        with cd(tmp_dir):\n   540\u2192            args = [\"run\", \"-p\", str(project.root), \"main.py\"]\n   541\u2192            if explicit_python:\n   542\u2192                args.insert(len(args) - 1, \"python\")\n   543\u2192            ret = pdm(args)\n   544\u2192            out, err = capfd.readouterr()\n   545\u2192            assert ret.exit_code == 0, err\n   546\u2192            assert out.strip() == \"1\"\n   547\u2192\n   548\u2192\n   549\u2192def test_import_another_sitecustomize(project, pdm, capfd):\n   550\u2192    project.pyproject.metadata[\"requires-python\"] = \">=2.7\"\n   551\u2192    project.pyproject.write()\n   552\u2192    # a script for checking another sitecustomize is imported\n   553\u2192    project.root.joinpath(\"foo.py\").write_text(\"import os;print(os.getenv('FOO'))\")\n   554\u2192    # ensure there have at least one sitecustomize can be imported\n   555\u2192    # there may have more than one sitecustomize.py in sys.path\n   556\u2192    project.root.joinpath(\"sitecustomize.py\").write_text(\"import os;os.environ['FOO'] = 'foo'\")\n   557\u2192    env = os.environ.copy()\n   558\u2192    paths = env.get(\"PYTHONPATH\")\n   559\u2192    this_path = str(project.root)\n   560\u2192    new_paths = [this_path] if not paths else [this_path, paths]\n   561\u2192    env[\"PYTHONPATH\"] = os.pathsep.join(new_paths)\n   562\u2192    project._environment = None\n   563\u2192    capfd.readouterr()\n   564\u2192    with cd(project.root):\n   565\u2192        result = pdm([\"run\", \"python\", \"foo.py\"], env=env)\n   566\u2192    assert result.exit_code == 0, result.stderr\n   567\u2192    out, _ = capfd.readouterr()\n   568\u2192    assert out.strip() == \"foo\"\n   569\u2192\n   570\u2192\n   571\u2192def test_run_with_patched_sysconfig(project, pdm, capfd):\n   572\u2192    project.root.joinpath(\"script.py\").write_text(\n   573\u2192        \"\"\"\\\n   574\u2192import sysconfig\n   575\u2192import json\n   576\u2192print(json.dumps(sysconfig.get_paths()))\n   577\u2192\"\"\"\n   578\u2192    )\n   579\u2192    capfd.readouterr()\n   580\u2192    with cd(project.root):\n   581\u2192        result = pdm([\"run\", \"python\", \"script.py\"], obj=project)\n   582\u2192    assert result.exit_code == 0\n   583\u2192    out = json.loads(capfd.readouterr()[0])\n   584\u2192    assert \"__pypackages__\" in out[\"purelib\"]\n   585\u2192\n   586\u2192\n   587\u2192def test_run_composite(project, pdm, capfd, _echo):\n   588\u2192    project.pyproject.settings[\"scripts\"] = {\n   589\u2192        \"first\": \"python echo.py First\",\n   590\u2192        \"secon