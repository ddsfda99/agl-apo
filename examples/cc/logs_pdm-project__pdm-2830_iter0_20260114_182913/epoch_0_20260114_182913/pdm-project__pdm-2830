      A short one line task description\n    95\u2192        \"\"\"\n    96\u2192        if self.kind == \"composite\":\n    97\u2192            fallback = f\" {termui.Emoji.ARROW_SEPARATOR} \".join(self.args)\n    98\u2192        else:\n    99\u2192            lines = [line.strip() for line in str(self.args).splitlines() if line.strip()]\n   100\u2192            fallback = f\"{lines[0]}{termui.Emoji.ELLIPSIS}\" if len(lines) > 1 else lines[0]\n   101\u2192        return self.options.get(\"help\", fallback)\n   102\u2192\n   103\u2192\n   104\u2192class TaskRunner:\n   105\u2192    \"\"\"The task runner for pdm project\"\"\"\n   106\u2192\n   107\u2192    TYPES = (\"cmd\", \"shell\", \"call\", \"composite\")\n   108\u2192    OPTIONS = (\"env\", \"env_file\", \"help\", \"keep_going\", \"working_dir\", \"site_packages\")\n   109\u2192\n   110\u2192    def __init__(self, project: Project, hooks: HookManager) -> None:\n   111\u2192        self.project = project\n   112\u2192        global_options = cast(\n   113\u2192            \"TaskOptions\",\n   114\u2192            self.project.scripts.get(\"_\", {}) if self.project.scripts else {},\n   115\u2192        )\n   116\u2192        self.global_options = global_options.copy()\n   117\u2192        self.hooks = hooks\n   118\u2192\n   119\u2192    def get_task(self, script_name: str) -> Task | None:\n   120\u2192        if script_name not in self.project.scripts:\n   121\u2192            return None\n   122\u2192        script = cast(\"str | Sequence[str] | Mapping[str,Any]\", self.project.scripts[script_name])\n   123\u2192        if not isinstance(script, Mapping):\n   124\u2192            # Regard as the same as {cmd = ... }\n   125\u2192            kind = \"cmd\"\n   126\u2192            value = script\n   127\u2192            options = {}\n   128\u2192        else:\n   129\u2192            script = dict(script)  # to remove the effect of tomlkit's container type.\n   130\u2192            for key in self.TYPES:\n   131\u2192                if key in script:\n   132\u2192                    kind = key\n   133\u2192                    value = cast(\"str | Sequence[str]\", script.pop(key))\n   134\u2192                    break\n   135\u2192            else:\n   136\u2192                raise PdmUsageError(f\"Script type must be one of ({', '.join(self.TYPES)})\")\n   137\u2192            options = script.copy()\n   138\u2192        unknown_options = set(options) - set(self.OPTIONS)\n   139\u2192        if unknown_options:\n   140\u2192            raise PdmUsageError(f\"Unknown options for task {script_name}: {', '.join(unknown_options)}\")\n   141\u2192        return Task(kind, script_name, value, cast(\"TaskOptions\", options))\n   142\u2192\n   143\u2192    def expand_command(self, command: str) -> str:\n   144\u2192        expanded_command = os.path.expanduser(command)\n   145\u2192        if expanded_command.replace(os.sep, \"/\").startswith((\"./\", \"../\")):\n   146\u2192            abspath = os.path.abspath(expanded_command)\n   147\u2192            if not os.path.isfile(abspath):\n   148\u2192                raise PdmUsageError(f\"Command [success]'{command}'[/] is not a valid executable.\")\n   149\u2192            return abspath\n   150\u2192        result = self.project.environment.which(command)\n   151\u2192        if not result:\n   152\u2192            raise PdmUsageError(f\"Command [success]'{command}'[/] is not found in your PATH.\")\n   153\u2192        return result\n   154\u2192\n   155\u2192    def _run_process(\n   156\u2192        self,\n   157\u2192        args: Sequence[str] | str,\n   158\u2192        chdir: bool = False,\n   159\u2192        shell: bool = False,\n   160\u2192        site_packages: bool = False,\n   161\u2192        env: Mapping[str, str] | None = None,\n   162\u2192        env_file: EnvFileOptions | str | None = None,\n   163\u2192        working_dir: str | None = None,\n   164\u2192    ) -> int:\n   165\u2192        \"\"\"Run command in a subprocess and return the exit code.\"\"\"\n   166\u2192        project = self.project\n   167\u2192        process_env = os.environ.copy()\n   168\u2192        if env_file is not None:\n   169\u2192            if isinstance(env_file, str):\n   170\u2192                path = env_file\n   171\u2192                override = False\n   172\u2192            else:\n   173\u2192                path = env_file[\"override\"]\n   174\u2192                override = True\n   175\u2192\n   176\u2192            import dotenv\n   177\u2192\n   178\u2192            project.core.ui.echo(\n   179\u2192                f\"Loading .env file: [success]{env_file}[/]\",\n   180\u2192                err=True,\n   181\u2192                verbosity=termui.Verbosity.DETAIL,\n   182\u2192            )\n   183\u2192            dotenv_env = dotenv.dotenv_values(project.root / path, encoding=\"utf-8\")\n   184\u2192            if override:\n   185\u2192                process_env = {**process_env, **dotenv_env}\n   186\u2192            else:\n   187\u2192                process_env = {**dotenv_env, **process_env}\n   188\u2192        project_env = project.environment\n   189\u2192        this_path = project_env.get_paths()[\"scripts\"]\n   190\u2192        process_env.update(project_env.process_env)\n   191\u2192        if env:\n   192\u2192            process_env.update(env)\n   193\u2192        if shell:\n   194\u2192            assert isinstance(args, str)\n   195\u2192            # environment variables will be expanded by shell\n   196\u2192            process_cmd: str | Sequence[str] = args\n   197\u2192        else:\n   198\u2192            assert isinstance(args, Sequence)\n   199\u2192            command, *args = (expand_env_vars(arg, env=process_env) for arg in args)\n   200\u2192            if command.endswith(\".py\"):\n   201\u2192                args = [command, *args]\n   202\u2192                command = str(project.environment.interpreter.executable)\n   203\u2192            expanded_command = self.expand_command(command)\n   204\u2192            real_command = os.path.realpath(expanded_command)\n   205\u2192            process_cmd = [expanded_command, *args]\n   206\u2192            if (\n   207\u2192                project_env.is_local\n   208\u2192                and not site_packages\n   209\u2192                and (\n   210\u2192                    os.path.basename(real_command).startswith(\"python\")\n   211\u2192                    or is_path_relative_to(expanded_command, this_path)\n   212\u2192                )\n   213\u2192            ):\n   214\u2192                # The executable belongs to the local packages directory.\n   215\u2192                # Don't load system site-packages\n   216\u2192                process_env[\"NO_SITE_PACKAGES\"] = \"1\"\n   217\u2192\n   218\u2192        cwd = (project.root / working_dir) if working_dir else project.root if chdir else None\n   219\u2192\n   220\u2192        def forward_signal(signum: int, frame: FrameType | None) -> None:\n   221\u2192            if sys.platform == \"win32\" and signum == signal.SIGINT:\n   222\u2192                signum = signal.SIGTERM\n   223\u2192            process.send_signal(signum)\n   224\u2192\n   225\u2192        handle_term = signal.signal(signal.SIGTERM, forward_signal)\n   226\u2192        handle_int = signal.signal(signal.SIGINT, forward_signal)\n   227\u2192        process = subprocess.Popen(process_cmd, cwd=cwd, env=process_env, shell=shell, bufsize=0)\n   228\u2192        process.wait()\n   229\u2192        signal.signal(signal.SIGTERM, handle_term)\n   230\u2192        signal.signal(signal.SIGINT, handle_int)\n   231\u2192        return process.returncode\n   232\u2192\n   233\u2192    def run_task(\n   234\u2192        self, task: Task, args: Sequence[str] = (), opts: TaskOptions | None = None, seen: set[str] | None = None\n   235\u2192    ) -> int:\n   236\u2192        kind, _, value, options = task\n   237\u2192        shell = False\n   238\u2192        if kind == \"cmd\":\n   239\u2192            if isinstance(value, str):\n   240\u2192                cmd, interpolated = interpolate(value, args)\n   241\u2192                value = shlex.split(cmd)\n   242\u2192            else:\n   243\u2192                agg = [interpolate(part, args) for part in value]\n   244\u2192                interpolated = any(row[1] for row in agg)\n   245\u2192                # In case of multiple default, we need to split the resulting string.\n   246\u2192                parts: Iterator[list[str]] = (\n   247\u2192                    shlex.split(part) if interpolated else [part] for part, interpolated in agg\n   248\u2192                )\n   249\u2192                # We flatten the nested list to obtain a list of arguments\n   250\u2192                value = list(itertools.chain(*parts))\n   251\u2192            args = value if interpolated else [*value, *args]\n   252\u2192        elif kind == \"shell\":\n   253\u2192            assert isinstance(value, str)\n   254\u2192            script, interpolated = interpolate(value, args)\n   255\u2192            args = script if interpolated else \" \".join([script, *args])\n   256\u2192            shell = True\n   257\u2192        elif kind == \"call\":\n   258\u2192            assert isinstance(value, str)\n   259\u2192            module, _, func = value.partition(\":\")\n   260\u2192            if not module or not func:\n   261\u2192                raise PdmUsageError(\"Python callable must be in the form <module_name>:<callable_name>\")\n   262\u2192            short_name = \"_1\"\n   263\u2192            if re.search(r\"\\(.*?\\)\", func) is None:\n   264\u2192                func += \"()\"\n   265\u2192            args = [\"python\", \"-c\", f\"import sys, {module} as {short_name};sys.exit({short_name}.{func})\", *list(args)]\n   266\u2192        elif kind == \"composite\":\n   267\u2192            assert isinstance(value, list)\n   268\u2192\n   269\u2192        self.project.core.ui.echo(\n   270\u2192            f\"Running {task}: [success]{args}[/]\",\n   271\u2192            err=True,\n   272\u2192            verbosity=termui.Verbosity.DETAIL,\n   273\u2192        )\n   274\u2192        if kind == \"composite\":\n   275\u2192            args = list(args)\n   276\u2192            should_interpolate = any(RE_ARGS_PLACEHOLDER.search(script) for script in value)\n   277\u2192            should_interpolate = should_interpolate or any(RE_PDM_PLACEHOLDER.search(script) for script in value)\n   278\u2192            composite_code = 0\n   279\u2192            keep_going = options.pop(\"keep_going\", False) if options else False\n   280\u2192            for script in value:\n   281\u2192                if should_interpolate:\n   282\u2192                    script, _ = interpolate(script, args)\n   283\u2192                split = shlex.split(script)\n   284\u2192                cmd = split[0]\n   285\u2192                subargs = split[1:] + ([] if should_interpolate else args)\n   286\u2192                code = self.run(cmd, subargs, options, chdir=True, seen=seen)\n   287\u2192                if code != 0:\n   288\u2192                    if not keep_going:\n   289\u2192                        return code\n   290\u2192                    composite_code = code\n   291\u2192            return composite_code\n   292\u2192        return self._run_process(args, chdir=True, shell=shell, **exec_opts(self.global_options, options, opts))\n   293\u2192\n   294\u2192    def run(\n   295\u2192        self,\n   296\u2192        command: str,\n   297\u2192        args: list[str],\n   298\u2192        opts: TaskOptions | None = None,\n   299\u2192        chdir: bool = False,\n   300\u2192        seen: set[str] | None = None,\n   301\u2192    ) -> int:\n   302\u2192        if command in self.hooks.skip:\n   303\u2192            return 0\n   304\u2192        if seen is None:\n   305\u2192            seen = set()\n   306\u2192        task = self.get_task(command)\n   307\u2192        if task is not None:\n   308\u2192            if task.kind == \"composite\":\n   309\u2192                if command in seen:\n   310\u2192                    raise PdmUsageError(f\"Script {command} is recursive.\")\n   311\u2192                seen.add(command)\n   312\u2192\n   313\u2192            self.hooks.try_emit(\"pre_script\", script=command, args=args)\n   314\u2192            pre_task = self.get_task(f\"pre_{command}\")\n   315\u2192            if pre_task is not None and self.hooks.should_run(pre_task.name):\n   316\u2192                code = self.run_task(pre_task, opts=opts)\n   317\u2192                if code != 0:\n   318\u2192                    return code\n   319\u2192            code = self.run_task(task, args, opts=opts, seen=seen)\n   320\u2192            if code != 0:\n   321\u2192                return code\n   322\u2192            post_task = self.get_task(f\"post_{command}\")\n   323\u2192            if post_task is not None and self.hooks.should_run(post_task.name):\n   324\u2192                code = self.run_task(post_task, opts=opts)\n   325\u2192            self.hooks.try_emit(\"post_script\", script=command, args=args)\n   326\u2192            return code\n   327\u2192        else:\n   328\u2192            return self._run_process([command, *args], chdir=chdir, **exec_opts(self.global_options, opts))\n   329\u2192\n   330\u2192    def show_list(self) -> None:\n   331\u2192        if not self.project.scripts:\n   332\u2192            return\n   333\u2192        columns = [\"Name\", \"Type\", \"Description\"]\n   334\u2192        result = []\n   335\u2192        for name in sorted(self.project.scripts):\n   336\u2192            if name.startswith(\"_\"):\n   337\u2192                continue\n   338\u2192            task = self.get_task(name)\n   339\u2192            assert task is not None\n   340\u2192            result.append(\n   341\u2192                (\n   342\u2192                    f\"[success]{name}[/]\",\n   343\u2192                    task.kind,\n   344\u2192                    task.short_description,\n   345\u2192                )\n   346\u2192            )\n   347\u2192        self.project.core.ui.display_columns(result, columns)\n   348\u2192\n   349\u2192    def as_json(self) -> dict[str, Any]:\n   350\u2192        out = {}\n   351\u2192        for name in sorted(self.project.scripts):\n   352\u2192            if name == \"_\":\n   353\u2192                data = out[\"_\"] = dict(name=\"_\", kind=\"shared\", help=\"Shared options\", **self.global_options)\n   354\u2192                _fix_env_file(data)\n   355\u2192                continue\n   356\u2192            task = self.get_task(name)\n   357\u2192            assert task is not None\n   358\u2192            data = out[name] = {\n   359\u2192                \"name\": name,\n   360\u2192                \"kind\": task.kind,\n   361\u2192                \"help\": task.short_description,\n   362\u2192                \"args\": task.args,  # type: ignore[dict-item]\n   363\u2192            }\n   364\u2192            data.update(**task.options)\n   365\u2192            _fix_env_file(data)\n   366\u2192        return out\n   367\u2192\n   368\u2192\n   369\u2192def _fix_env_file(data: dict[str, Any]) -> dict[str, Any]:\n   370\u2192    env_file = data.get(\"env_file\")\n   371\u2192    if isinstance(env_file, dict):\n   372\u2192        del data[\"env_file\"]\n   373\u2192        data[\"env_file.override\"] = env_file.get(\"override\")\n   374\u2192    return data\n   375\u2192\n   376\u2192\n   377\u2192class Command(BaseCommand):\n   378\u2192    \"\"\"Run commands or scripts with local packages loaded\"\"\"\n   379\u2192\n   380\u2192    runner_cls: type[TaskRunner] = TaskRunner\n   381\u2192    arguments = (*BaseCommand.arguments, skip_option, venv_option)\n   382\u2192\n   383\u2192    def add_arguments(self, parser: argparse.ArgumentParser) -> None:\n   384\u2192        action = parser.add_mutually_exclusive_group()\n   385\u2192        action.add_argument(\n   386\u2192            \"-l\",\n   387\u2192            \"--list\",\n   388\u2192            action=\"store_true\",\n   389\u2192            help=\"Show all available scripts defined in pyproject.toml\",\n   390\u2192        )\n   391\u2192        action.add_argument(\n   392\u2192            \"-j\",\n   393\u2192            \"--json\",\n   394\u2192            action=\"store_true\",\n   395\u2192            help=\"Output all scripts infos in JSON\",\n   396\u2192        )\n   397\u2192        exec = parser.add_argument_group(\"Execution parameters\")\n   398\u2192        exec.add_argument(\n   399\u2192            \"-s\",\n   400\u2192            \"--site-packages\",\n   401\u2192            action=\"store_true\",\n   402\u2192            help=\"Load site-packages from the selected interpreter\",\n   403\u2192        )\n   404\u2192        exec.add_argument(\"script\", nargs=\"?\", help=\"The command to run\")\n   405\u2192        exec.add_argument(\n   406\u2192            \"args\",\n   407\u2192            nargs=argparse.REMAINDER,\n   408\u2192            help=\"Arguments that will be passed to the command\",\n   409\u2192        )\n   410\u2192\n   411\u2192    def handle(self, project: Project, options: argparse.Namespace) -> None:\n   412\u2192        check_project_file(project)\n   413\u2192        hooks = HookManager(project, options.skip)\n   414\u2192        runner = self.runner_cls(project, hooks=hooks)\n   415\u2192        if options.list:\n   416\u2192            return runner.show_list()\n   417\u2192        if options.json:\n   418\u2192            return print_json(data=runner.as_json())\n   419\u2192        if options.site_packages:\n   420\u2192            runner.global_options.update({\"site_packages\": options.site_packages})\n   421\u2192        if not options.script:\n   422\u2192            project.core.ui.warn(\"No command is given, default to the Python REPL.\")\n   423\u2192            options.script = \"python\"\n   424\u2192        hooks.try_emit(\"pre_run\", script=options.script, args=options.args)\n   425\u2192        exit_code = runner.run(options.script, options.args)\n   426\u2192        hooks.try_emit(\"post_run\", script=options.script, args=options.args)\n   427\u2192        sys.exit(exit_code)\n   428\u2192\n   429\u2192\n   430\u2192def run_script_if_present(script_name: str) -> Callable:\n   431\u2192    \"\"\"Helper to create a signal handler to run specific script\"\"\"\n   432\u2192\n   433\u2192    def handler(sender: Project, hooks: HookManager, **kwargs: Any) -> None:\n   434\u2192        runner = TaskRunner(sender, hooks)\n   435\u2192        task = runner.get_task(script_name)\n   436\u2192        if task is None:\n   437\u2192            return\n   438\u2192        exit_code = runner.run_task(task)\n   439\u2192        if exit_code != 0:\n   440\u2192            sys.exit(exit_code)\n   441\u2192\n   442\u2192    return handler\n   443\u2192\n   444\u2192\n   445\u2192for hook in pdm_signals:\n   446\u2192    pdm_signals.signal(hook).connect(run_script_if_present(hook), weak=False)\n   447\u2192\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"
