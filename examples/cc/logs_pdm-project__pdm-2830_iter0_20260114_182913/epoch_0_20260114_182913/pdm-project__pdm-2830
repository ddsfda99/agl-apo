r.path = Path(os.path.normpath(r.path)).relative_to(os.path.normpath(project.root))\n   545→                    r.url = backend.relative_path_to_url(r.path.as_posix())\n   546→                except ValueError:\n   547→                    pass\n   548→            deps.append(r.as_line())\n   549→        if len(deps) > 0:\n   550→            base.add(\"dependencies\", make_array(sorted(deps), True))\n   551→        if v.hashes:\n   552→            collected = {}\n   553→            for item in v.hashes:\n   554→                if FLAG_STATIC_URLS in strategy:\n   555→                    row = {\"url\": item[\"url\"], \"hash\": item[\"hash\"]}\n   556→                else:\n   557→                    row = {\"file\": item[\"file\"], \"hash\": item[\"hash\"]}\n   558→                inline = make_inline_table(row)\n   559→                # deduplicate and sort\n   560→                collected[tuple(row.values())] = inline\n   561→            if collected:\n   562→                base.add(\"files\", make_array([collected[k] for k in sorted(collected)], True))\n   563→        packages.append(base)\n   564→    doc = tomlkit.document()\n   565→    metadata = tomlkit.table()\n   566→    if groups is None:\n   567→        groups = list(project.iter_groups())\n   568→    metadata.update(\n   569→        {\n   570→            \"groups\": sorted(groups, key=lambda k: k != \"default\"),\n   571→            \"strategy\": sorted(strategy),\n   572→        }\n   573→    )\n   574→    metadata.pop(FLAG_STATIC_URLS, None)\n   575→    metadata.pop(FLAG_CROSS_PLATFORM, None)\n   576→    doc.add(\"metadata\", metadata)\n   577→    doc.add(\"package\", packages)\n   578→    return cast(dict, doc)\n   579→\n   580→\n   581→def save_version_specifiers(\n   582→    requirements: dict[str, dict[str, Requirement]],\n   583→    resolved: dict[str, Candidate],\n   584→    save_strategy: str,\n   585→) -> None:\n   586→    \"\"\"Rewrite the version specifiers according to the resolved result an