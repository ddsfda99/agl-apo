 = True, **_kwds: Any) -> None:\n   503→        \"\"\"Write the lock file to disk.\"\"\"\n   504→        if _kwds:\n   505→            deprecation_warning(\"Extra arguments have been moved to `format_lockfile` function\", stacklevel=2)\n   506→        toml_data[\"metadata\"].update(self.get_lock_metadata())\n   507→        self.lockfile.set_data(toml_data)\n   508→\n   509→        if write and self.enable_write_lockfile:\n   510→            self.lockfile.write(show_message)\n   511→\n   512→    def make_self_candidate(self, editable: bool = True) -> Candidate:\n   513→        from unearth import Link\n   514→\n   515→        from pdm.models.candidates import Candidate\n   516→\n   517→        req = parse_requirement(path_to_url(self.root.as_posix()), editable)\n   518→        assert self.name\n   519→        req.name = self.name\n   520→        can = Candidate(req, name=self.name, link=Link.from_path(self.root))\n   521→        can.prepare(self.environment).metadata\n   522→        return can\n   523→\n   524→    def is_lockfile_hash_match(self) -> bool:\n   525→        hash_in_lockfile = str(self.lockfile.hash)\n   526→        if not hash_in_lockfile:\n   527→            return False\n   528→        algo, hash_value = hash_in_lockfile.split(\":\")\n   529→        content_hash = self.pyproject.content_hash(algo)\n   530→        return content_hash == hash_value\n   531→\n   532→    def use_pyproject_dependencies(\n   533→        self, group: str, dev: bool = False\n   534→    ) -> tuple[list[str], Callable[[list[str]], None]]:\n   535→        \"\"\"Get the dependencies array and setter in the pyproject.toml\n   536→        Return a tuple of two elements, the first is the dependencies array,\n   537→        and the second value is a callable to set the dependencies array back.\n   538→        \"\"\"\n   539→\n   540→        def update_dev_dependencies(deps: list[str]) -> None:\n   541→            from tomlkit.container import OutOfOrderTableProxy\n   542→\n   543→            settings.setdefault(\"dev-dependencies\", {})[group] = deps\n   544→            if isinstance(self.pyproject._data[\"tool\"], OutOfOrderTableProxy):\n   545→                # In case of a separate table, we have to remove and re-add it to make the write correct.\n   546→                # This may change the order of tables in the TOML file, but it's the best we can do.\n   547→                # see bug pdm-project/pdm#2056 for details\n   548→                del self.pyproject._data[\"tool\"][\"pdm\"]\n   549→                self.pyproject._data[\"tool\"][\"pdm\"] = settings\n   550→\n   551→        metadata, settings = self.pyproject.metadata, self.pyproject.settings\n   552→        if group == \"default\":\n   553→            return metadata.get(\"dependencies\", tomlkit.array()), lambda x: metadata.__setitem__(\"dependencies\", x)\n   554→        deps_setter = [\n   555→            (\n   556→                metadata.get(\"optional-dependencies\", {}),\n   557→                lambda x: metadata.setdefault(\"optional-dependencies\", {}).__setitem__(group, x),\n   558→            ),\n   559→            (settings.get(\"dev-dependencies\", {}), update_dev_dependencies),\n   560→        ]\n   561→        for deps, setter in deps_setter:\n   562→            if group in deps:\n   563→                return deps[group], setter\n   564→        # If not found, return an empty list and a setter to add the group\n   565→        return tomlkit.array(), deps_setter[int(dev)][1]\n   566→\n   567→    def add_dependencies(\n   568→        self,\n   569→        requirements: dict[str, Requirement],\n   570→        to_group: str = \"default\",\n   571→        dev: bool = False,\n   572→        show_message: bool = True,\n   573→    ) -> None:\n   574→        deps, setter = self.use_pyproject_dependencies(to_group, dev)\n   575→        for _, dep in requirements.items():\n   576→            matched_index = next(\n   577→                (i for i, r in enumerate(deps) if dep.m