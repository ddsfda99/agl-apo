  321→\n   322→    if package.name in visited:\n   323→        return\n   324→    parents: list[Package] = sorted(filter(None, graph.iter_parents(package)), key=lambda p: p.name)\n   325→    for parent in parents:\n   326→        requires = specifier_from_requirement(parent.requirements[package.name])\n   327→        add_package_to_reverse_tree(node, graph, parent, package, requires, visited=visited | {package.name})\n   328→    return\n   329→\n   330→\n   331→def package_is_project(package: Package, project: Project) -> bool:\n   332→    return project.is_distribution and package.name == normalize_name(project.name)\n   333→\n   334→\n   335→def _format_forward_dependency_graph(\n   336→    project: Project, graph: DirectedGraph[Package | None], patterns: list[str]\n   337→) -> Tree:\n   338→    \"\"\"Format dependency graph for output.\"\"\"\n   339→    root = Tree(\"Dependencies\", hide_root=True)\n   340→\n   341→    def find_package_to_add(package: Package) -> Package | None:\n   342→        if not patterns:\n   343→            return package\n   344→        to_check = [package]\n   345→        while to_check:\n   346→            package = to_check.pop(0)\n   347→            if package and package_match_patterns(package, patterns):\n   348→                return package\n   349→            to_check.extend(graph.iter_children(package))\n   350→        return None\n   351→\n   352→    all_dependencies = ChainMap(*project.all_dependencies.values())\n   353→    top_level_dependencies = {find_package_to_add(node) for node in graph.iter_children(None) if node}\n   354→    for package in sorted((node for node in top_level_dependencies if node), key=lambda p: p.name):\n   355→        required: set[str] = set()\n   356→        for parent in graph.iter_parents(package):\n   357→            if parent:\n   358→                r = specifier_from_requirement(parent.requirements[package.name])\n   359→            elif package.name in all_dependencies:\n   360→               