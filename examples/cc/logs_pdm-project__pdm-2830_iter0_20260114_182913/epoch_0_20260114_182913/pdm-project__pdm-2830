ache(self) -> CandidateInfoCache:\n   628→        from pdm.models.caches import CandidateInfoCache\n   629→\n   630→        python_hash = hashlib.sha1(str(self.environment.python_requires).encode()).hexdigest()\n   631→        file_name = f\"package_meta_{python_hash}.json\"\n   632→        return CandidateInfoCache(self.cache(\"metadata\") / file_name)\n   633→\n   634→    def make_hash_cache(self) -> HashCache:\n   635→        from pdm.models.caches import HashCache\n   636→\n   637→        return HashCache(directory=self.cache(\"hashes\"))\n   638→\n   639→    def iter_interpreters(\n   640→        self,\n   641→        python_spec: str | None = None,\n   642→        search_venv: bool | None = None,\n   643→        filter_func: Callable[[PythonInfo], bool] | None = None,\n   644→    ) -> Iterable[PythonInfo]:\n   645→        \"\"\"Iterate over all interpreters that matches the given specifier.\n   646→        And optionally install the interpreter if not found.\n   647→        \"\"\"\n   648→        from pbs_installer._versions import PYTHON_VERSIONS, PythonVersion\n   649→\n   650→        from pdm.cli.commands.python import InstallCommand\n   651→\n   652→        found = False\n   653→        for interpreter in self.find_interpreters(python_spec, search_venv):\n   654→            if filter_func is None or filter_func(interpreter):\n   655→                found = True\n   656→                yield interpreter\n   657→        if found or self.is_global:\n   658→            return\n   659→\n   660→        def get_version(version: PythonVersion) -> str:\n   661→            return f\"{version.major}.{version.minor}.{version.micro}\"\n   662→\n   663→        if not python_spec:  # handle both empty string and None\n   664→            # Get the best match meeting the requires-python\n   665→            best_match = next((v for v in PYTHON_VERSIONS if get_version(v) in self.python_requires), None)\n   666→            if best_match is None:\n   667→                return