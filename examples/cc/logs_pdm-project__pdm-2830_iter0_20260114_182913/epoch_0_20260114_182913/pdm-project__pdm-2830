e=False)\n   187→    requirements: dict[str, Requirement] = dc.field(compare=False)\n   188→\n   189→    def __repr__(self) -> str:\n   190→        return f\"<Package {self.name}=={self.version}>\"\n   191→\n   192→\n   193→def build_dependency_graph(\n   194→    working_set: Mapping[str, im.Distribution],\n   195→    marker_env: dict[str, str] | None = None,\n   196→    selected: set[str] | None = None,\n   197→    include_sub: bool = True,\n   198→) -> DirectedGraph:\n   199→    \"\"\"Build a dependency graph from locked result.\"\"\"\n   200→    graph: DirectedGraph[Package | None] = DirectedGraph()\n   201→    graph.add(None)  # sentinel parent of top nodes.\n   202→    node_with_extras: set[str] = set()\n   203→\n   204→    def add_package(key: str, dist: Distribution | None) -> Package:\n   205→        name, extras = strip_extras(key)\n   206→        extras = extras or ()\n   207→        reqs: dict[str, Requirement] = {}\n   208→        if dist:\n   209→            requirements = (\n   210→                parse_requirement(r)\n   211→                for r in filter_requirements_with_extras(dist.requires or [], extras, include_default=True)\n   212→            )\n   213→            for req in requirements:\n   214→                if not req.marker or req.marker.evaluate(marker_env):\n   215→                    reqs[req.identify()] = req\n   216→            version: str | None = dist.version\n   217→        else:\n   218→            version = None\n   219→\n   220→        node = Package(key, version, reqs)\n   221→        if node not in graph:\n   222→            if extras:\n   223→                node_with_extras.add(name)\n   224→            graph.add(node)\n   225→            if include_sub:\n   226→                for k in reqs:\n   227→                    child = add_package(k, working_set.get(strip_extras(k)[0]))\n   228→                    graph.connect(node, child)\n   229→\n   230→        return node\n   231→\n   232→    selected_map: dict[str, str] = {}\n   233→    for key in selected or ():\n   234→        name = key.split(\"[\")[0]\n   235→        if len(key) >= len(selected_map.get(name, \"\")):\n   236→            # Ensure key with extras remains\n   237→            selected_map[name] = key\n   238→    for k, dist in working_set.items():\n   239→        if selected is not None:\n   240→            name = k.split(\"[\")[0]\n   241→            if name not in selected_map:\n   242→                continue\n   243→            k = selected_map[name]\n   244→        add_package(k, dist)\n   245→    for node in list(graph):\n   246→        if node is not None and not list(graph.iter_parents(node)):\n   247→            # Top requirements\n   248→            if node.name in node_with_extras:\n   249→                # Already included in package[extra], no need to keep the top level\n   250→                # non-extra package.\n   251→                graph.remove(node)\n   252→            else:\n   253→                graph.connect(None, node)\n   254→    return graph\n   255→\n   256→\n   257→def specifier_from_requirement(requirement: Requirement) -> str:\n   258→    return str(requirement.specifier) or \"Any\"\n   259→\n   260→\n   261→def add_package_to_tree(\n   262→    root: Tree,\n   263→    graph: DirectedGraph,\n   264→    package: Package,\n   265→    required: list[str],\n   266→    visited: frozenset[str] = frozenset(),\n   267→) -> None:\n   268→    \"\"\"Format one package.\n   269→\n   270→    :param graph: the dependency graph\n   271→    :param package: the package instance\n   272→    :param required: the version required by its parent\n   273→    :param visited: the visited package collection\n   274→    \"\"\"\n   275→    version = (\n   276→        \"[error][ not installed ][/]\"\n   277→        if not package.version\n   278→        else f\"[error]{package.version}[/]\"\n   279→        if required\n   280→        and not any(s in (\"Any\", \"This project\") or SpecifierSet(s).contains(package.vers