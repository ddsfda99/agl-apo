 import pytest
 
 from checkov.kubernetes.parser.validatior import K8sValidator
+from checkov.kubernetes.parser.parser import parse
 
 
 @pytest.fixture
@@ -59,3 +60,58 @@ def test_k8s_template_has_required_fields(template_valid_fields):
 def test_k8s_template_is_name_valid(template_invalid_name):
     is_valid, reason = K8sValidator.is_valid_template(template_invalid_name)
     assert not is_valid
+
+
+def test_is_valid_name_allows_double_curly_braces_placeholders():
+    # The name contains a templating placeholder using double-curly braces
+    name_only_placeholder = "{{ .Release.Name }}"
+    ok, _ = K8sValidator.is_valid_name(name_only_placeholder)
+    assert ok, "Names with double-curly braces placeholders should be valid"
+
+    # The name combines a static prefix with a templated suffix (double-curly braces)
+    name_with_prefix = "my-app-{{ .Values.suffix }}"
+    ok, _ = K8sValidator.is_valid_name(name_with_prefix)
+    assert ok, "Names with a static prefix plus double-curly braces placeholder should be valid"
+
+    # Truly invalid names (not part of a double-curly braces templating block) are still rejected
+    bad_name = "my#app"
+    ok, _ = K8sValidator.is_valid_name(bad_name)
+    assert not ok, "Names with illegal characters outside of double-curly braces should be invalid"
+
+
+def test_is_valid_template_accepts_templated_name():
+    # Template with metadata.name using a double-curly braces placeholder
+    templated = {
+        "apiVersion": "v1",
+        "kind": "Pod",
+        "metadata": {"name": "my-app-{{ .Values.suffix }}"},  # double-curly braces placeholder
+        "spec": {"containers": [{"name": "nginx", "image": "nginx:1.14.2"}]},
+    }
+    ok, reason = K8sValidator.is_valid_template(templated)
+    assert ok, f"Template should be valid even with a double-curly braces placeholder in name: {reason}"
+
+
+def test_parser_parse_retains_template_with_templated_name(tmp_path):
+    # YAML manifest where metadata.name includes a double-curly braces templating placeholder
+    yaml_content = """
+apiVersion: v1
+kind: Pod
+metadata:
+  name: "my-app-{{ .Values.suffix }}"
+spec:
+  containers:
+  - name: nginx
+    image: nginx:1.14.2
+"""
+    d = tmp_path / "k8s"
+    d.mkdir(parents=True, exist_ok=True)
+    f = d / "templated.yaml"
+    f.write_text(yaml_content)
+
+    result = parse(str(f))
+    assert result is not None, "Parser should return a result for files with double-curly braces in names"
+    definitions, lines = result
+    assert isinstance(definitions, list)
+    assert len(definitions) == 1, "Parser should keep the template and not drop it"
+    assert definitions[0]["kind"] == "Pod"
+    assert definitions[0]["metadata"]["name"] == "my-app-{{ .Values.suffix }}"
