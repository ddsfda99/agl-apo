+    def is_valid_name(name: Any) -> Tuple[bool, str]:
+        """
+        Validate a Kubernetes name allowing templating placeholders with double-curly braces.
+        The validation keeps strict checks for non-templated content and only ignores braces when
+        they are part of a "{{ ... }}" block. All other disallowed characters remain invalid.
+        """
         if not isinstance(name, str) or len(name) > 253:
             return False, f'name {name} is invalid'
-        if K8sValidator.name_disallowed_chars.search(name):
+
+        # If the name contains templating blocks using double-curly braces, sanitize them first
+        # by replacing each block with a safe alphanumeric token. This ensures names like
+        # "my-app-{{ .Release.Name }}" are accepted, while stray braces or other illegal
+        # characters still cause rejection.
+        sanitized_name = name
+        if K8sValidator.templating_block_pattern.search(name):
+            sanitized_name = K8sValidator.templating_block_pattern.sub('x', name)
+
+        # If there are any remaining braces (i.e., not part of a double-curly block), or '#', reject
+        if K8sValidator.name_disallowed_chars.search(sanitized_name):
             return False, f'name {name} is invalid'
+
         return True, ''
+
