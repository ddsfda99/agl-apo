+def _contains_unquoted_double_curly(text: str) -> bool:
+    """Return True if '{{' appears outside of quotes in the given text.
+
+    This helps us skip Helm/Kustomize templates that won't parse as YAML,
+    while still allowing valid YAML files that include double-curly braces in quoted strings.
+    """
+    in_single = False
+    in_double = False
+    i = 0
+    n = len(text)
+    while i < n:
+        ch = text[i]
+        # handle double quotes with backslash escaping
+        if ch == '"' and not in_single:
+            if in_double:
+                # count preceding backslashes
+                bs = 0
+                j = i - 1
+                while j >= 0 and text[j] == '\\':
+                    bs += 1
+                    j -= 1
+                if bs % 2 == 0:
+                    in_double = False
+            else:
+                in_double = True
+            i += 1
+            continue
+        # handle single quotes with doubled single-quote escaping
+        if ch == "'" and not in_double:
+            if in_single:
+                # check for doubled single quote escape
+                if i + 1 < n and text[i + 1] == "'":
+                    i += 2
+                    continue
+                else:
+                    in_single = False
+            else:
+                in_single = True
+            i += 1
+            continue
+        # check for '{{' outside quotes
+        if not in_single and not in_double and ch == '{' and i + 1 < n and text[i + 1] == '{':
+            return True
+        i += 1
+    return False
+
+
