ate: StateUpdate\n   298→    ) -> StateUpdate:\n   299→        \"\"\"Postprocess the event.\n   300→\n   301→        This is where middleware can modify the delta after it is processed.\n   302→        Each middleware is called in the order it was added to the app.\n   303→\n   304→        Args:\n   305→            state: The state to postprocess.\n   306→            event: The event to postprocess.\n   307→            update: The current state update.\n   308→\n   309→        Returns:\n   310→            The state update to return.\n   311→        \"\"\"\n   312→        for middleware in self.middleware:\n   313→            if asyncio.iscoroutinefunction(middleware.postprocess):\n   314→                out = await middleware.postprocess(\n   315→                    app=self, state=state, event=event, update=update  # type: ignore\n   316→                )\n   317→            else:\n   318→                out = middleware.postprocess(\n   319→                    app=self, state=state, event=event, update=update  # type: ignore\n   320→                )\n   321→            if out is not None:\n   322→                return out  # type: ignore\n   323→        return update\n   324→\n   325→    def add_middleware(self, middleware: Middleware, index: int | None = None):\n   326→        \"\"\"Add middleware to the app.\n   327→\n   328→        Args:\n   329→            middleware: The middleware to add.\n   330→            index: The index to add the middleware at.\n   331→        \"\"\"\n   332→        if index is None:\n   333→            self.middleware.append(middleware)\n   334→        else:\n   335→            self.middleware.insert(index, middleware)\n   336→\n   337→    @staticmethod\n   338→    def _generate_component(component: Component | ComponentCallable) -> Component:\n   339→        \"\"\"Generate a component from a callable.\n   340→\n   341→        Args:\n   342→            component: The component function to call or Component to return as-is.\n   343→\n   344→        Returns:\n   345→            The generated component.\n   346→\n   347→        Raises:\n   348→            TypeError: When an invalid component function is passed.\n   349→            exceptions.MatchTypeError: If the return types of match cases in rx.match are different.\n   350→        \"\"\"\n   351→        try:\n   352→            return component if isinstance(component, Component) else component()\n   353→        except exceptions.MatchTypeError:\n   354→            raise\n   355→        except TypeError as e:\n   356→            message = str(e)\n   357→            if \"BaseVar\" in message or \"ComputedVar\" in message:\n   358→                raise TypeError(\n   359→                    \"You may be trying to use an invalid Python function on a state var. \"\n   360→                    \"When referencing a var inside your render code, only limited var operations are supported. \"\n   361→                    \"See the var operation docs here: https://reflex.dev/docs/state/vars/#var-operations\"\n   362→                ) from e\n   363→            raise e\n   364→\n   365→    def add_page(\n   366→        self,\n   367→        component: Component | ComponentCallable,\n   368→        route: str | None = None,\n   369→        title: str = constants.DefaultPage.TITLE,\n   370→        description: str = constants.DefaultPage.DESCRIPTION,\n   371→        image: str = constants.DefaultPage.IMAGE,\n   372→        on_load: EventHandler\n   373→        | EventSpec\n   374→        | list[EventHandler | EventSpec]\n   375→        | None = None,\n   376→        meta: list[dict[str, str]] = constants.DefaultPage.META_LIST,\n   377→        script_tags: list[Component] | None = None,\n   378→    ):\n   379→        \"\"\"Add a page to the app.\n   380→\n   381→        If the component is a callable, by default the route is the name of the\n   382→        function. Otherwise, a route must be provided.\n   383→\n   384→        Args:\n   385→            component: The component to display at the page.\n   386→            route: The route to display the component at.\n   387→            title: The title of the page.\n   388→            description: The description of the page.\n   389→            image: The image to display on the page.\n   390→            on_load: The event handler(s) that will be called each time the page load.\n   391→            meta: The metadata of the page.\n   392→            script_tags: List of script tags to be added to component\n   393→        \"\"\"\n   394→        # If the route is not set, get it from the callable.\n   395→        if route is None:\n   396→            assert isinstance(\n   397→                component, Callable\n   398→            ), \"Route must be set if component is not a callable.\"\n   399→            # Format the route.\n   400→            route = format.format_route(component.__name__)\n   401→        else:\n   402→            route = format.format_route(route, format_case=False)\n   403→\n   404→        # Check if the route given is valid\n   405→        verify_route_validity(route)\n   406→\n   407→        # Apply dynamic args to the route.\n   408→        if self.state:\n   409→            self.state.setup_dynamic_args(get_route_args(route))\n   410→\n   411→        # Generate the component if it is a callable.\n   412→        component = self._generate_component(component)\n   413→\n   414→        # Wrap the component in a fragment with optional overlay.\n   415→        if self.overlay_component is not None:\n   416→            component = Fragment.create(\n   417→                self._generate_component(self.overlay_component),\n   418→                component,\n   419→            )\n   420→        else:\n   421→            component = Fragment.create(component)\n   422→\n   423→        # Add meta information to the component.\n   424→        compiler_utils.add_meta(\n   425→            component,\n   426→            title=title,\n   427→            image=image,\n   428→            description=description,\n   429→            meta=meta,\n   430→        )\n   431→\n   432→        # Add script tags if given\n   433→        if script_tags:\n   434→            console.deprecate(\n   435→                feature_name=\"Passing script tags to add_page\",\n   436→                reason=\"Add script components as children to the page component instead\",\n   437→                deprecation_version=\"0.2.9\",\n   438→                removal_version=\"0.4.0\",\n   439→            )\n   440→            component.children.extend(script_tags)\n   441→\n   442→        # Add the page.\n   443→        self._check_routes_conflict(route)\n   444→        self.pages[route] = component\n   445→\n   446→        # Add the load events.\n   447→        if on_load:\n   448→            if not isinstance(on_load, list):\n   449→                on_load = [on_load]\n   450→            self.load_events[route] = on_load\n   451→\n   452→    def get_load_events(self, route: str) -> list[EventHandler | EventSpec]:\n   453→        \"\"\"Get the load events for a route.\n   454→\n   455→        Args:\n   456→            route: The route to get the load events for.\n   457→\n   458→        Returns:\n   459→            The load events for the route.\n   460→        \"\"\"\n   461→        route = route.lstrip(\"/\")\n   462→        if route == \"\":\n   463→            route = constants.PageNames.INDEX_ROUTE\n   464→        return self.load_events.get(route, [])\n   465→\n   466→    def _check_routes_conflict(self, new_route: str):\n   467→        \"\"\"Verify if there is any conflict between the new route and any existing route.\n   468→\n   469→        Based on conflicts that NextJS would throw if not intercepted.\n   470→\n   471→        Raises:\n   472→            ValueError: exception showing which conflict exist with the route to be added\n   473→\n   474→        Args:\n   475→            new_route: the route being newly added.\n   476→        \"\"\"\n   477→        newroute_catchall = catchall_in_route(new_route)\n   478→        if not newroute_catchall:\n   479→            return\n   480→\n   481→        for route in self.pages:\n   482→            route = \"\" if route == \"index\" else route\n   483→\n   484→            if new_route.startswith(f\"{route}/[[...\"):\n   485→                raise ValueError(\n   486→                    f\"You cannot define a route with the same specificity as a optional catch-all route ('{route}' and '{new_route}')\"\n   487→                )\n   488→\n   489→            route_catchall = catchall_in_route(route)\n   490→            if (\n   491→                route_catchall\n   492→                and newroute_catchall\n   493→                and catchall_prefix(route) == catchall_prefix(new_route)\n   494→            ):\n   495→                raise ValueError(\n   496→                    f\"You cannot use multiple catchall for the same dynamic route ({route} !== {new_route})\"\n   497→                )\n   498→\n   499→    def add_custom_404_page(\n   500→        self,\n   501→        component: Component | ComponentCallable | None = None,\n   502→        title: str = constants.Page404.TITLE,\n   503→        image: str = constants.Page404.IMAGE,\n   504→        description: str = constants.Page404.DESCRIPTION,\n   505→        on_load: EventHandler\n   506→        | EventSpec\n   507→        | list[EventHandler | EventSpec]\n   508→        | None = None,\n   509→        meta: list[dict[str, str]] = constants.DefaultPage.META_LIST,\n   510→    ):\n   511→        \"\"\"Define a custom 404 page for any url having no match.\n   512→\n   513→        If there is no page defined on 'index' route, add the 404 page to it.\n   514→        If there is no global catchall defined, add the 404 page with a catchall\n   515→\n   516→        Args:\n   517→            component: The component to display at the page.\n   518→            title: The title of the page.\n   519→            description: The description of the page.\n   520→            image: The image to display on the page.\n   521→            on_load: The event handler(s) that will be called each time the page load.\n   522→            meta: The metadata of the page.\n   523→        \"\"\"\n   524→        if component is None:\n   525→            component = Default404Page.create()\n   526→        self.add_page(\n   527→            component=wait_for_client_redirect(self._generate_component(component)),\n   528→            route=constants.Page404.SLUG,\n   529→            title=title or constants.Page404.TITLE,\n   530→            image=image or constants.Page404.IMAGE,\n   531→            description=description or constants.Page404.DESCRIPTION,\n   532→            on_load=on_load,\n   533→            meta=meta,\n   534→        )\n   535→\n   536→    def setup_admin_dash(self):\n   537→        \"\"\"Setup the admin dash.\"\"\"\n   538→        # Get the admin dash.\n   539→        admin_dash = self.admin_dash\n   540→\n   541→        if admin_dash and admin_dash.models:\n   542→            # Build the admin dashboard\n   543→            admin = (\n   544→                admin_dash.admin\n   545→                if admin_dash.admin\n   546→                else Admin(\n   547→                    engine=Model.get_db_engine(),\n   548→                    title=\"Reflex Admin Dashboard\",\n   549→                    logo_url=\"https://reflex.dev/Reflex.svg\",\n   550→                )\n   551→            )\n   552→\n   553→            for model in admin_dash.models:\n   554→                view = admin_dash.view_overrides.get(model, ModelView)\n   555→                admin.add_view(view(model))\n   556→\n   557→            admin.mount_to(self.api)\n   558→\n   559→    def get_frontend_packages(self, imports: Dict[str, set[ImportVar]]):\n   560→        \"\"\"Gets the frontend packages to be installed and filters out the unnecessary ones.\n   561→\n   562→        Args:\n   563→            imports: A dictionary containing the imports used in the current page.\n   564→\n   565→        Example:\n   566→            >>> get_frontend_packages({\"react\": \"16.14.0\", \"react-dom\": \"16.14.0\"})\n   567→        \"\"\"\n   568→        page_imports = {\n   569→            i\n   570→            for i, tags in imports.items()\n   571→            if i\n   572→            not in [\n   573→                *constants.PackageJson.DEPENDENCIES.keys(),\n   574→                *constants.PackageJson.DEV_DEPENDENCIES.keys(),\n   575→            ]\n   576→            and not any(i.startswith(prefix) for prefix in [\"/\", \".\", \"next/\"])\n   577→            and i != \"\"\n   578→            and any(tag.install for tag in tags)\n   579→        }\n   580→        frontend_packages = get_config().frontend_packages\n   581→        _frontend_packages = []\n   582→        for package in frontend_packages:\n   583→            if package in (get_config().tailwind or {}).get(\"plugins\", []):  # type: ignore\n   584→                console.warn(\n   585→                    f\"Tailwind packages are inferred from 'plugins', remove `{package}` from `frontend_packages`\"\n   586→                )\n   587→                continue\n   588→            if package in page_imports:\n   589→                console.warn(\n   590→                    f\"React packages and their dependencies are inferred from Component.library and Component.lib_dependencies, remove `{package}` from `frontend_packages`\"\n   591→                )\n   592→                continue\n   593→            _frontend_packages.append(package)\n   594→        page_imports.update(_frontend_packages)\n   595→        prerequisites.install_frontend_packages(page_imports, get_config())\n   596→\n   597→    def _app_root(self, app_wrappers: dict[tuple[int, str], Component]) -> Component:\n   598→        for component in tuple(app_wrappers.values()):\n   599→            app_wrappers.update(component.get_app_wrap_components())\n   600→        order = sorted(app_wrappers, key=lambda k: k[0], reverse=True)\n   601→        root = parent = copy.deepcopy(app_wrappers[order[0]])\n   602→        for key in order[1:]:\n   603→            child = copy.deepcopy(app_wrappers[key])\n   604→            parent.children.append(child)\n   605→            parent = child\n   606→        return root\n   607→\n   608→    def _should_compile(self) -> bool:\n   609→        \"\"\"Check if the app should be compiled.\n   610→\n   611→        Returns:\n   612→            Whether the app should be compiled.\n   613→        \"\"\"\n   614→        # Check the environment variable.\n   615→        if os.environ.get(constants.SKIP_COMPILE_ENV_VAR) == \"yes\":\n   616→            return False\n   617→\n   618→        # Check the nocompile file.\n   619→        if os.path.exists(constants.NOCOMPILE_FILE):\n   620→            # Delete the nocompile file\n   621→            os.remove(constants.NOCOMPILE_FILE)\n   622→            return False\n   623→\n   624→        # By default, compile the app.\n   625→        return True\n   626→\n   627→    def compile(self):\n   628→        \"\"\"compile_() is the new function for performing compilation.\n   629→        Reflex framework will call it automatically as needed.\n   630→        \"\"\"\n   631→        console.deprecate(\n   632→            feature_name=\"app.compile()\",\n   633→            reason=\"Explicit calls to app.compile() are not needed.\"\n   634→            \" Method will be removed in 0.4.0\",\n   635→            deprecation_version=\"0.3.8\",\n   636→            removal_version=\"0.4.0\",\n   637→        )\n   638→        return\n   639→\n   640→    def compile_(self):\n   641→        \"\"\"Compile the app and output it to the pages folder.\n   642→\n   643→        Raises:\n   644→            RuntimeError: When any page uses state, but no rx.State subclass is defined.\n   645→        \"\"\"\n   646→        # add the pages before the compile check so App know onload methods\n   647→        for render, kwargs in DECORATED_PAGES:\n   648→            self.add_page(render, **kwargs)\n   649→\n   650→        # Render a default 404 page if the user didn't supply one\n   651→        if constants.Page404.SLUG not in self.pages:\n   652→            self.add_custom_404_page()\n   653→\n   654→        if not self._should_compile():\n   655→            return\n   656→\n   657→        # Create a progress bar.\n   658→        progress = Progress(\n   659→            *Progress.get_default_columns()[:-1],\n   660→            MofNCompleteColumn(),\n   661→            TimeElapsedColumn(),\n   662→        )\n   663→\n   664→        # Get the env mode.\n   665→        config = get_config()\n   666→\n   667→        # Store the compile results.\n   668→        compile_results = []\n   669→\n   670→        # Compile the pages in parallel.\n   671→        custom_components = set()\n   672→        # TODO Anecdotally, processes=2 works 10% faster (cpu_count=12)\n   673→        all_imports = {}\n   674→        app_wrappers: Dict[tuple[int, str], Component] = {\n   675→            # Default app wrap component renders {children}\n   676→            (0, \"AppWrap\"): AppWrap.create()\n   677→        }\n   678→        if self.theme is not None:\n   679→            # If a theme component was provided, wrap the app with it\n   680→            app_wrappers[(20, \"Theme\")] = self.theme\n   681→\n   682→        with progress, concurrent.futures.ThreadPoolExecutor() as thread_pool:\n   683→            fixed_pages = 7\n   684→            task = progress.add_task(\"Compiling:\", total=len(self.pages) + fixed_pages)\n   685→\n   686→            def mark_complete(_=None):\n   687→                progress.advance(task)\n   688→\n   689→            for _route, component in self.pages.items():\n   690→                # Merge the component style with the app style.\n   691→                component.add_style(self.style)\n   692→\n   693→                component.apply_theme(self.theme)\n   694→\n   695→                # Add component.get_imports() to all_imports.\n   696→                all_imports.update(component.get_imports())\n   697→\n   698→                # Add the app wrappers from this component.\n   699→                app_wrappers.update(component.get_app_wrap_components())\n   700→\n   701→                # Add the custom components from the page to the set.\n   702→                custom_components |= component.get_custom_components()\n   703→\n   704→            # Perform auto-memoization of stateful components.\n   705→            (\n   706→                stateful_components_path,\n   707→                stateful_components_code,\n   708→                page_components,\n   709→            ) = compiler.compile_stateful_components(self.pages.values())\n   710→\n   711→            # Catch \"static\" apps (that do not define a rx.State subclass) which are trying to access rx.State.\n   712→            if (\n   713→                code_uses_state_contexts(stateful_components_code)\n   714→                and self.state is None\n   715→            ):\n   716→                raise RuntimeError(\n   717→                    \"To access rx.State in frontend components, at least one \"\n   718→                    \"subclass of rx.State must be defined in the app.\"\n   719→                )\n   720→            compile_results.append((stateful_components_path, stateful_components_code))\n   721→\n   722→            result_futures = []\n   723→\n   724→            def submit_work(fn, *args, **kwargs):\n   725→                \"\"\"Submit work to the thread pool and add a callback to mark the task as complete.\n   726→\n   727→                The Future will be added to the `result_futures` list.\n   728→\n   729→                Args:\n   730→                    fn: The function to submit.\n   731→                    *args: The args to submit.\n   732→                    **kwargs: The kwargs to submit.\n   733→                \"\"\"\n 