+        # Shutdown and close the underlying connection before closing the file-like object
+        # to interrupt any concurrent blocking read on another thread. Closing the file-like
+        # object first can hang if it attempts to drain remaining bytes. Preserve _fp for
+        # read_chunked generator semantics.
+        conn = self._connection
+        if conn is not None:
+            try:
+                sock = getattr(conn, "sock", None)
+                if sock is not None:
+                    try:
+                        sock.shutdown(socket.SHUT_RDWR)
+                    except OSError:
+                        pass
+            except Exception:
+                # Best-effort: suppress unexpected errors during shutdown
+                pass
+            try:
+                conn.close()
+            except Exception:
+                pass
 
-        if self._connection:
