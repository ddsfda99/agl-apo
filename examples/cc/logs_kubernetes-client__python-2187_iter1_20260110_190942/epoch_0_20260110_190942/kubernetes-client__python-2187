ider['name'] == 'azure':\n   305→            return self._load_azure_token(provider)\n   306→        if provider['name'] == 'oidc':\n   307→            return self._load_oid_token(provider)\n   308→\n   309→    def _azure_is_expired(self, provider):\n   310→        expires_on = provider['config']['expires-on']\n   311→        if expires_on.isdigit():\n   312→            return int(expires_on) < time.time()\n   313→        else:\n   314→            exp_time = time.strptime(expires_on, '%Y-%m-%d %H:%M:%S.%f')\n   315→            return exp_time < time.gmtime()\n   316→\n   317→    def _load_azure_token(self, provider):\n   318→        if 'config' not in provider:\n   319→            return\n   320→        if 'access-token' not in provider['config']:\n   321→            return\n   322→        if 'expires-on' in provider['config']:\n   323→            if self._azure_is_expired(provider):\n   324→                self._refresh_azure_token(provider['config'])\n   325→        self.token = 'Bearer %s' % provider['config']['access-token']\n   326→        return self.token\n   327→\n   328→    def _refresh_azure_token(self, config):\n   329→        if 'adal' not in globals():\n   330→            raise ImportError('refresh token error, adal library not imported')\n   331→\n   332→        tenant = config['tenant-id']\n   333→        authority = 'https://login.microsoftonline.com/{}'.format(tenant)\n   334→        context = adal.AuthenticationContext(\n   335→            authority, validate_authority=True, api_version='1.0'\n   336→        )\n   337→        refresh_token = config['refresh-token']\n   338→        client_id = config['client-id']\n   339→        apiserver_id = '00000002-0000-0000-c000-000000000000'\n   340→        try:\n   341→            apiserver_id = config['apiserver-id']\n   342→        except ConfigException:\n   343→            # We've already set a default above\n   344→            pass\n   345→        token_response = context.acquire_token_with_refresh_token(\n   346→            refresh_token, client_id, apiserver_id)\n   347→\n   348→        provider = self._user['auth-provider']['config']\n   349→        provider.value['access-token'] = token_response['accessToken']\n   350→        provider.value['expires-on'] = token_response['expiresOn']\n   351→        if self._config_persister:\n   352→            self._config_persister()\n   353→\n   354→    def _load_gcp_token(self, provider):\n   355→        if (('config' not in provider) or\n   356→                ('access-token' not in provider['config']) or\n   357→                ('expiry' in provider['config'] and\n   358→                 _is_expired(provider['config']['expiry']))):\n   359→            # token is not available or expired, refresh it\n   360→            self._refresh_gcp_token()\n   361→\n   362→        self.token = \"Bearer %s\" % provider['config']['access-token']\n   363→        if 'expiry' in provider['config']:\n   364→            self.expiry = parse_rfc3339(provider['config']['expiry'])\n   365→        return self.token\n   366→\n   367→    def _refresh_gcp_token(self):\n   368→        if 'config' not in self._user['auth-provider']:\n   369→            self._user['auth-provider'].value['config'] = {}\n   370→        provider = self._user['auth-provider']['config']\n   371→        credentials = self._get_google_credentials()\n   372→        provider.value['access-token'] = credentials.token\n   373→        provider.value['expiry'] = format_rfc3339(credentials.expiry)\n   374→        if self._config_persister:\n   375→            self._config_persister()\n   376→\n   377→    def _load_oid_token(self, provider):\n   378→        if 'config' not in provider:\n   379→            return\n   380→\n   381→        reserved_characters = frozenset([\"=\", \"+\", \"/\"])\n   382→        token = provider['config']['id-token']\n   383→\n   384→        if any(char in token for char in reserved_characters):\n   385→            # Invalid jwt, as it contains url-unsaf