  def config(self):\n   690→        return self.config_merged\n   691→\n   692→    def _load_config_from_file_like_object(self, string):\n   693→        if hasattr(string, 'getvalue'):\n   694→            config = yaml.safe_load(string.getvalue())\n   695→        else:\n   696→            config = yaml.safe_load(string.read())\n   697→\n   698→        if config is None:\n   699→            raise ConfigException(\n   700→                'Invalid kube-config.')\n   701→        if self.config_merged is None:\n   702→            self.config_merged = copy.deepcopy(config)\n   703→        # doesn't need to do any further merging\n   704→\n   705→    def _load_config_from_file_path(self, string):\n   706→        for path in string.split(ENV_KUBECONFIG_PATH_SEPARATOR):\n   707→            if path:\n   708→                path = os.path.expanduser(path)\n   709→                if os.path.exists(path):\n   710→                    self.paths.append(path)\n   711→                    self.load_config(path)\n   712→        self.config_saved = copy.deepcopy(self.config_files)\n   713→\n   714→    def load_config(self, path):\n   715→        with open(path) as f:\n   716→            config = yaml.safe_load(f)\n   717→\n   718→        if config is None:\n   719→            raise ConfigException(\n   720→                'Invalid kube-config. '\n   721→                '%s file is empty' % path)\n   722→\n   723→        if self.config_merged is None:\n   724→            config_merged = copy.deepcopy(config)\n   725→            for item in ('clusters', 'contexts', 'users'):\n   726→                config_merged[item] = []\n   727→            self.config_merged = ConfigNode(path, config_merged, path)\n   728→        for item in ('clusters', 'contexts', 'users'):\n   729→            self._merge(item, config.get(item, []) or [], path)\n   730→        self.config_files[path] = config\n   731→\n   732→    def _merge(self, item, add_cfg, path):\n   733→        for new_item in add_cfg:\n   734