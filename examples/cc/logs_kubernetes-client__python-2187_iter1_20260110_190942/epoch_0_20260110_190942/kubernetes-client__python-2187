→                )\n   436→\n   437→            with open(ca_cert.name, 'w') as fh:\n   438→                fh.write(cert)\n   439→\n   440→            config.ssl_ca_cert = ca_cert.name\n   441→\n   442→        elif 'idp-certificate-authority' in provider['config']:\n   443→            config.ssl_ca_cert = provider['config']['idp-certificate-authority']\n   444→\n   445→        else:\n   446→            config.verify_ssl = False\n   447→\n   448→        client = ApiClient(configuration=config)\n   449→\n   450→        response = client.request(\n   451→            method=\"GET\",\n   452→            url=\"%s/.well-known/openid-configuration\"\n   453→            % provider['config']['idp-issuer-url']\n   454→        )\n   455→\n   456→        if response.status != 200:\n   457→            return\n   458→\n   459→        response = json.loads(response.data)\n   460→\n   461→        request = OAuth2Session(\n   462→            client_id=provider['config']['client-id'],\n   463→            token=provider['config']['refresh-token'],\n   464→            auto_refresh_kwargs={\n   465→                'client_id': provider['config']['client-id'],\n   466→                'client_secret': provider['config']['client-secret']\n   467→            },\n   468→            auto_refresh_url=response['token_endpoint']\n   469→        )\n   470→\n   471→        try:\n   472→            refresh = request.refresh_token(\n   473→                token_url=response['token_endpoint'],\n   474→                refresh_token=provider['config']['refresh-token'],\n   475→                auth=(provider['config']['client-id'],\n   476→                      provider['config']['client-secret']),\n   477→                verify=config.ssl_ca_cert if config.verify_ssl else None\n   478→            )\n   479→        except oauthlib.oauth2.rfc6749.errors.InvalidClientIdError:\n   480→            return\n   481→\n   482→        provider['config'].value['id-token'] = refresh['id_token']\n   483→        provider['config'].value['refresh-token'] = refresh['refresh_token']\n   484→\n   485→    def _load_from_exec_plugin(self):\n   486→        if 'exec' not in self._user:\n   487→            return\n   488→        try:\n   489→            base_path = self._get_base_path(self._cluster.path)\n   490→            status = ExecProvider(self._user['exec'], base_path).run()\n   491→            if 'token' in status:\n   492→                self.token = \"Bearer %s\" % status['token']\n   493→            elif 'clientCertificateData' in status:\n   494→                # https://kubernetes.io/docs/reference/access-authn-authz/authentication/#input-and-output-formats\n   495→                # Plugin has provided certificates instead of a token.\n   496→                if 'clientKeyData' not in status:\n   497→                    logging.error('exec: missing clientKeyData field in '\n   498→                                  'plugin output')\n   499→                    return None\n   500→                self.cert_file = FileOrData(\n   501→                    status, None,\n   502→                    data_key_name='clientCertificateData',\n   503→                    file_base_path=base_path,\n   504→                    base64_file_content=False,\n   505→                    temp_file_path=self._temp_file_path).as_file()\n   506→                self.key_file = FileOrData(\n   507→                    status, None,\n   508→                    data_key_name='clientKeyData',\n   509→                    file_base_path=base_path,\n   510→                    base64_file_content=False,\n   511→                    temp_file_path=self._temp_file_path).as_file()\n   512→            else:\n   513→                logging.error('exec: missing token or clientCertificateData '\n   514→                              'field in plugin output')\n   515→                return None\n   516→            if 'expirationTimestamp' in status:\n   517→                self.expiry = parse_rfc3339(status['expirationTim