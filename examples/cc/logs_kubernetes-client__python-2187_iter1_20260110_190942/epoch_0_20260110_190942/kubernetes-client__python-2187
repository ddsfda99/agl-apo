       return self._file\n   131→\n   132→    def as_data(self):\n   133→        \"\"\"If obj[%data_key_name] exists, Return obj[%data_key_name] otherwise\n   134→        base64 encoded string of obj[%file_key_name] file content.\"\"\"\n   135→        use_file_if_no_data = not self._data and self._file\n   136→        if use_file_if_no_data:\n   137→            with open(self._file) as f:\n   138→                if self._base64_file_content:\n   139→                    self._data = bytes.decode(\n   140→                        base64.standard_b64encode(str.encode(f.read())))\n   141→                else:\n   142→                    self._data = f.read()\n   143→        return self._data\n   144→\n   145→\n   146→class CommandTokenSource(object):\n   147→    def __init__(self, cmd, args, tokenKey, expiryKey):\n   148→        self._cmd = cmd\n   149→        self._args = args\n   150→        if not tokenKey:\n   151→            self._tokenKey = '{.access_token}'\n   152→        else:\n   153→            self._tokenKey = tokenKey\n   154→        if not expiryKey:\n   155→            self._expiryKey = '{.token_expiry}'\n   156→        else:\n   157→            self._expiryKey = expiryKey\n   158→\n   159→    def token(self):\n   160→        fullCmd = self._cmd + (\" \") + \" \".join(self._args)\n   161→        process = subprocess.Popen(\n   162→            [self._cmd] + self._args,\n   163→            stdout=subprocess.PIPE,\n   164→            stderr=subprocess.PIPE,\n   165→            universal_newlines=True)\n   166→        (stdout, stderr) = process.communicate()\n   167→        exit_code = process.wait()\n   168→        if exit_code != 0:\n   169→            msg = 'cmd-path: process returned %d' % exit_code\n   170→            msg += \"\\nCmd: %s\" % fullCmd\n   171→            stderr = stderr.strip()\n   172→            if stderr:\n   173→                msg += '\\nStderr: %s' % stderr\n   174→            raise ConfigException(msg)\n   175→        try:\n   176→            data = json.loads(stdout)\n   177→        except ValueError as de:\n   178→            raise ConfigException(\n   179→                'exec: failed to decode process output: %s' % de)\n   180→        A = namedtuple('A', ['token', 'expiry'])\n   181→        return A(\n   182→            token=data['credential']['access_token'],\n   183→            expiry=parse_rfc3339(data['credential']['token_expiry']))\n   184→\n   185→\n   186→class KubeConfigLoader(object):\n   187→\n   188→    def __init__(self, config_dict, active_context=None,\n   189→                 get_google_credentials=None,\n   190→                 config_base_path=\"\",\n   191→                 config_persister=None,\n   192→                 temp_file_path=None):\n   193→\n   194→        if config_dict is None:\n   195→            raise ConfigException(\n   196→                'Invalid kube-config. '\n   197→                'Expected config_dict to not be None.')\n   198→        elif isinstance(config_dict, ConfigNode):\n   199→            self._config = config_dict\n   200→        else:\n   201→            self._config = ConfigNode('kube-config', config_dict)\n   202→\n   203→        self._current_context = None\n   204→        self._user = None\n   205→        self._cluster = None\n   206→        self.set_active_context(active_context)\n   207→        self._config_base_path = config_base_path\n   208→        self._config_persister = config_persister\n   209→        self._temp_file_path = temp_file_path\n   210→\n   211→        def _refresh_credentials_with_cmd_path():\n   212→            config = self._user['auth-provider']['config']\n   213→            cmd = config['cmd-path']\n   214→            if len(cmd) == 0:\n   215→                raise ConfigException(\n   216→                    'missing access token cmd '\n   217→                    '(cmd-path is an empty string in your kubeconfig file)')\n   218→            if 'scopes' in config and config['scopes'] != \"\":\n   219→             