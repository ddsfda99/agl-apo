+            _orig_set_cookie(self, name, value, *args, **kwargs)
+
+            # Explicit partitioned flag
+            if partitioned is True:
+                self._cookies[name]['partitioned'] = True
+            elif partitioned is False:
+                # Ensure not set
+                try:
+                    del self._cookies[name]['partitioned']
+                except KeyError:
+                    pass
+
+            # Auto-behavior for SameSite=None
+            if same_site and str(same_site).lower() == 'none':
+                # Ensure Secure is set regardless of default
