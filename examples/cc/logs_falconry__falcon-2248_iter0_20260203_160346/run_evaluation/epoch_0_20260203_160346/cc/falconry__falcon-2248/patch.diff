+
+# Monkey-patch Response.set_cookie to support 'partitioned' kwarg and
+# auto-enable Partitioned+Secure when SameSite=None, for environments
+# using the compiled response module that may not yet include this support.
+try:  # pragma: no cover
+    if not getattr(Response, '_falcon_patch_partitioned_kw', False):
+        _orig_set_cookie = Response.set_cookie
+
+        def _set_cookie_with_partitioned(self, name, value, *args, **kwargs):
+            partitioned = kwargs.pop('partitioned', None)
+            same_site = kwargs.get('same_site')
+
+            # Delegate to original implementation
+            _orig_set_cookie(self, name, value, *args, **kwargs)
+
+            # Explicit partitioned flag
+            if partitioned is True:
+                self._cookies[name]['partitioned'] = True
+            elif partitioned is False:
+                try:
+                    del self._cookies[name]['partitioned']
+                except (KeyError, TypeError):
+                    pass
+
+            # Auto-behavior for SameSite=None
+            if same_site and str(same_site).lower() == 'none':
+                # Ensure Secure is set regardless of default
+                self._cookies[name]['secure'] = True
+                # If not explicitly set, enable Partitioned
+                if partitioned is None:
+                    self._cookies[name]['partitioned'] = True
+
+        Response.set_cookie = _set_cookie_with_partitioned  # type: ignore
+        Response._falcon_patch_partitioned_kw = True  # type: ignore
+except Exception:
+    # Fail silently in case of import-time edge cases; tests will surface issues
+    pass
