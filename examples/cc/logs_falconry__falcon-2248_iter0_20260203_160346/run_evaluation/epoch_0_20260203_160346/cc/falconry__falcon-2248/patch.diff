+# NOTE: Backport support for the new 'Partitioned' attribute used by CHIPS.
+# This ensures that http.cookies.Morsel recognizes the attribute and formats
+# it correctly when rendering Set-Cookie headers. Python added this support
+# in 3.13; backport here for older versions.
+if 'partitioned' not in _reserved_cookie_attrs:  # pragma: no cover
+    _reserved_cookie_attrs['partitioned'] = 'Partitioned'  # type: ignore
+    _flags = getattr(http_cookies.Morsel, '_flags', None)
+    if isinstance(_flags, set):  # Python 3.13+ defines _flags
+        _flags.add('partitioned')
+
+# Monkey-patch Morsel to auto-apply Partitioned and Secure when SameSite=None.
+# This emulates behavior proposed for Python 3.13+ and enables CHIPS for older
+# runtimes and environments using Falcon's compiled response module.
+if not getattr(http_cookies.Morsel, '_falcon_patch_samesite_none', False):  # pragma: no cover
+    _orig_setitem = http_cookies.Morsel.__setitem__
+
+    def _patched_setitem(self, key, value):  # type: ignore[override]
+        _orig_setitem(self, key, value)
+        try:
+            if key.lower() == 'samesite' and str(value).lower() == 'none':
+                # Ensure Secure is set per browser requirement
+                self['secure'] = True
+                # Auto-enable partitioned cookies for 3P contexts
+                self['partitioned'] = True
+        except Exception:
+            # Be conservative; ignore any issues silently
+            pass
+
+    http_cookies.Morsel.__setitem__ = _patched_setitem  # type: ignore
+    http_cookies.Morsel._falcon_patch_samesite_none = True  # type: ignore
+
