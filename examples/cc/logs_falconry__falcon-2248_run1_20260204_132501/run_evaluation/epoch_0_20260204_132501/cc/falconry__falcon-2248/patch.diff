+
+# Patch Response.set_cookie to support 'partitioned' attribute and
+# auto-enable when SameSite=None and Secure. This ensures behavior even
+# when using the Cythonized Response implementation.
+try:
+    _falcon_orig_set_cookie = Response.set_cookie
+
+    def _falcon_set_cookie_with_partitioned(
+        self,
+        name,
+        value,
+        expires=None,
+        max_age=None,
+        domain=None,
+        path=None,
+        secure=None,
+        http_only=True,
+        same_site=None,
+        partitioned=None,
+    ):
+        # Delegate to original implementation for standard attributes
+        _falcon_orig_set_cookie(
+            self, name, value, expires, max_age, domain, path, secure, http_only, same_site
+        )
+
+        # Determine effective secure flag
+        is_secure = self.options.secure_cookies_by_default if secure is None else secure
+
+        # Auto-enable Partitioned when SameSite=None and Secure, or if explicitly requested
+        if partitioned or (
+            partitioned is None and same_site and same_site.lower() == 'none' and is_secure
+        ):
+            try:
+                self._cookies[name]['partitioned'] = True
+            except Exception:
+                # Silently ignore if not supported by Morsel/reserved list
+                pass
+
+    # Override the method on the Response class
+    Response.set_cookie = _falcon_set_cookie_with_partitioned  # type: ignore[assignment]
+except Exception:  # pragma: no cover
+    pass
