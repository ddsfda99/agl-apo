 User | AnonymousUser = None,\n   269→    ) -> str:\n   270→        rf = RequestFactory()\n   271→        request = rf.get(url)\n   272→        request.user = user or self.get_or_create_test_user()\n   273→        middleware = LinkdingMiddleware(lambda r: HttpResponse())\n   274→        middleware(request)\n   275→\n   276→        bookmark_list_context = context_type(request)\n   277→        context = RequestContext(request, {\"bookmark_list\": bookmark_list_context})\n   278→\n   279→        template = Template(\"{% include 'bookmarks/bookmark_list.html' %}\")\n   280→        return template.render(context)\n   281→\n   282→    def setup_date_format_test(\n   283→        self, date_display_setting: str, web_archive_url: str = \"\"\n   284→    ):\n   285→        bookmark = self.setup_bookmark()\n   286→        bookmark.date_added = timezone.now() - relativedelta(days=8)\n   287→        bookmark.web_archive_snapshot_url = web_archive_url\n   288→        bookmark.save()\n   289→        user = self.get_or_create_test_user()\n   290→        user.profile.bookmark_date_display = date_display_setting\n   291→        user.profile.save()\n   292→        return bookmark\n   293→\n   294→    def inline_bookmark_description_test(self, bookmark):\n   295→        html = self.render_template()\n   296→        soup = self.make_soup(html)\n   297→\n   298→        has_description = bool(bookmark.description)\n   299→        has_tags = len(bookmark.tags.all()) > 0\n   300→\n   301→        # inline description block exists\n   302→        description = soup.select_one(\".description.inline.truncate\")\n   303→        self.assertIsNotNone(description)\n   304→\n   305→        # separate description block does not exist\n   306→        separate_description = soup.select_one(\".description.separate\")\n   307→        self.assertIsNone(separate_description)\n   308→\n   309→        # one direct child element per description or tags\n   310→        children = description.find_all(recursive=False)\n   311→        expected_child_count = (\n   312→            0 + (1 if has_description else 0) + (1 if has_tags else 0)\n   313→        )\n   314→        self.assertEqual(len(children), expected_child_count)\n   315→\n   316→        # has separator between description and tags\n   317→        if has_description and has_tags:\n   318→            self.assertTrue(\"|\" in description.text)\n   319→\n   320→        # contains description text, without leading/trailing whitespace\n   321→        if has_description:\n   322→            description_text = description.find(\"span\", string=bookmark.description)\n   323→            self.assertIsNotNone(description_text)\n   324→\n   325→        if not has_tags:\n   326→            # no tags element\n   327→            tags = soup.select_one(\".tags\")\n   328→            self.assertIsNone(tags)\n   329→        else:\n   330→            # tags element exists\n   331→            tags = soup.select_one(\".tags\")\n   332→            self.assertIsNotNone(tags)\n   333→\n   334→            # one link for each tag\n   335→            tag_links = tags.find_all(\"a\")\n   336→            self.assertEqual(len(tag_links), len(bookmark.tags.all()))\n   337→\n   338→            for tag in bookmark.tags.all():\n   339→                tag_link = tags.find(\"a\", string=f\"#{tag.name}\")\n   340→                self.assertIsNotNone(tag_link)\n   341→                self.assertEqual(tag_link[\"href\"], f\"?q=%23{tag.name}\")\n   342→\n   343→    def test_inline_bookmark_description(self):\n   344→        profile = self.get_or_create_test_user().profile\n   345→        profile.bookmark_description_display = (\n   346→            UserProfile.BOOKMARK_DESCRIPTION_DISPLAY_INLINE\n   347→        )\n   348→        profile.save()\n   349→\n   350→        # no description, no tags\n   351→        bookmark = self.setup_bookmark(description=\"\")\n   352→        self.inline_bookmark_description_test(bookmark)\n   353→\n   354→        # with description, no tags\n   355→        bookmark = self.setup_bookmark(description=\"Test description\")\n   356→        self.inline_bookmark_description_test(bookmark)\n   357→\n   358→        # no description, with tags\n   359→        Bookmark.objects.all().delete()\n   360→        bookmark = self.setup_bookmark(\n   361→            description=\"\", tags=[self.setup_tag(), self.setup_tag(), self.setup_tag()]\n   362→        )\n   363→        self.inline_bookmark_description_test(bookmark)\n   364→\n   365→        # with description, with tags\n   366→        Bookmark.objects.all().delete()\n   367→        bookmark = self.setup_bookmark(\n   368→            description=\"Test description\",\n   369→            tags=[self.setup_tag(), self.setup_tag(), self.setup_tag()],\n   370→        )\n   371→        self.inline_bookmark_description_test(bookmark)\n   372→\n   373→    def separate_bookmark_description_test(self, bookmark):\n   374→        html = self.render_template()\n   375→        soup = self.make_soup(html)\n   376→\n   377→        has_description = bool(bookmark.description)\n   378→        has_tags = len(bookmark.tags.all()) > 0\n   379→\n   380→        # inline description block does not exist\n   381→        inline_description = soup.select_one(\".description.inline\")\n   382→        self.assertIsNone(inline_description)\n   383→\n   384→        if not has_description:\n   385→            # no description element\n   386→            description = soup.select_one(\".description\")\n   387→            self.assertIsNone(description)\n   388→        else:\n   389→            # contains description text, without leading/trailing whitespace\n   390→            description = soup.select_one(\".description.separate\")\n   391→            self.assertIsNotNone(description)\n   392→            self.assertEqual(description.text, bookmark.description)\n   393→\n   394→        if not has_tags:\n   395→            # no tags element\n   396→            tags = soup.select_one(\".tags\")\n   397→            self.assertIsNone(tags)\n   398→        else:\n   399→            # tags element exists\n   400→            tags = soup.select_one(\".tags\")\n   401→            self.assertIsNotNone(tags)\n   402→\n   403→            # one link for each tag\n   404→            tag_links = tags.find_all(\"a\")\n   405→            self.assertEqual(len(tag_links), len(bookmark.tags.all()))\n   406→\n   407→            for tag in bookmark.tags.all():\n   408→                tag_link = tags.find(\"a\", string=f\"#{tag.name}\")\n   409→                self.assertIsNotNone(tag_link)\n   410→                self.assertEqual(tag_link[\"href\"], f\"?q=%23{tag.name}\")\n   411→\n   412→    def test_separate_bookmark_description(self):\n   413→        profile = self.get_or_create_test_user().profile\n   414→        profile.bookmark_description_display = (\n   415→            UserProfile.BOOKMARK_DESCRIPTION_DISPLAY_SEPARATE\n   416→        )\n   417→        profile.save()\n   418→\n   419→        # no description, no tags\n   420→        bookmark = self.setup_bookmark(description=\"\")\n   421→        self.separate_bookmark_description_test(bookmark)\n   422→\n   423→        # with description, no tags\n   424→        bookmark = self.setup_bookmark(description=\"Test description\")\n   425→        self.separate_bookmark_description_test(bookmark)\n   426→\n   427→        # no description, with tags\n   428→        Bookmark.objects.all().delete()\n   429→        bookmark = self.setup_bookmark(\n   430→            description=\"\", tags=[self.setup_tag(), self.setup_tag(), self.setup_tag()]\n   431→        )\n   432→        self.separate_bookmark_description_test(bookmark)\n   433→\n   434→        # with description, with tags\n   435→        Bookmark.objects.all().delete()\n   436→        bookmark = self.setup_bookmark(\n   437→            description=\"Test description\",\n   438→            tags=[self.setup_tag(), self.setup_tag(), self.setup_tag()],\n   439→        )\n   440→        self.separate_bookmark_description_test(bookmark)\n   441→\n   442→    def test_bookmark_description_max_lines(self):\n   443→        self.setup_bookmark()\n   444→        html = self.render_template()\n   445→        soup = self.make_soup(html)\n   446→        bookmark_list = soup.select_one(\"ul.bookmark-list\")\n   447→        style = bookmark_list[\"style\"]\n   448→        self.assertIn(\"--ld-bookmark-description-max-lines:1;\", style)\n   449→\n   450→        profile = self.get_or_create_test_user().profile\n   451→        profile.bookmark_description_max_lines = 3\n   452→        profile.save()\n   453→\n   454→        html = self.render_template()\n   455→        soup = self.make_soup(html)\n   456→        bookmark_list = soup.select_one(\"ul.bookmark-list\")\n   457→        style = bookmark_list[\"style\"]\n   458→        self.assertIn(\"--ld-bookmark-description-max-lines:3;\", style)\n   459→\n   460→    def test_bookmark_tag_ordering(self):\n   461→        bookmark = self.setup_bookmark()\n   462→        tag3 = self.setup_tag(name=\"tag3\")\n   463→        tag1 = self.setup_tag(name=\"tag1\")\n   464→        tag2 = self.setup_tag(name=\"tag2\")\n   465→        bookmark.tags.add(tag3, tag1, tag2)\n   466→\n   467→        html = self.render_template()\n   468→        soup = self.make_soup(html)\n   469→        tags = soup.select_one(\".tags\")\n   470→        tag_links = tags.find_all(\"a\")\n   471→        self.assertEqual(len(tag_links), 3)\n   472→        self.assertEqual(tag_links[0].text, \"#tag1\")\n   473→        self.assertEqual(tag_links[1].text, \"#tag2\")\n   474→        self.assertEqual(tag_links[2].text, \"#tag3\")\n   475→\n   476→    def test_should_render_web_archive_link_with_absolute_date_setting(self):\n   477→        bookmark = self.setup_date_format_test(\n   478→            UserProfile.BOOKMARK_DATE_DISPLAY_ABSOLUTE,\n   479→            \"https://web.archive.org/web/20210811214511/https://wanikani.com/\",\n