eturn \"{}=!\".format(self._name)  # unset\n   170→        elif self._value_type is list and _ConfVarPlaceHolder in self._value:\n   171→            v = self._value[:]\n   172→            v.remove(_ConfVarPlaceHolder)\n   173→            return \"{}={}\".format(self._name, v)\n   174→        else:\n   175→            return \"{}={}\".format(self._name, self._value)\n   176→\n   177→    def serialize(self):\n   178→        if self._value is None:\n   179→            _value = \"!\"  # unset\n   180→        elif self._value_type is list and _ConfVarPlaceHolder in self._value:\n   181→            v = self._value[:]\n   182→            v.remove(_ConfVarPlaceHolder)\n   183→            _value = v\n   184→        else:\n   185→            _value = self._value\n   186→        return {self._name: _value}\n   187→\n   188→    def update(self, value):\n   189→        assert self._value_type is dict, \"Only dicts can be updated\"\n   190→        assert isinstance(value, dict), \"Only dicts can update\"\n   191→        self._value.update(value)\n   192→\n   193→    def remove(self, value):\n   194→        if self._value_type is list:\n   195→            self._value.remove(value)\n   196→        elif self._value_type is dict:\n   197→            self._value.pop(value, None)\n   198→\n   199→    def append(self, value):\n   200→        if self._value_type is not list:\n   201→            raise ConanException(\"Only list-like values can append other values.\")\n   202→\n   203→        if isinstance(value, list):\n   204→            self._value.extend(value)\n   205→        else:\n   206→            self._value.append(value)\n   207→\n   208→    def prepend(self, value):\n   209→        if self._value_type is not list:\n   210→            raise ConanException(\"Only list-like values can prepend other values.\")\n   211→\n   212→        if isinstance(value, list):\n   213→            self._value = value + self._value\n   214→        else:\n   215→            self._value.insert(0, value)\n   216→\n   217→    def compose_conf_value(self, other):\n   218→        \"\"\"\n   219→        self has precedence, the \"other\" will add/append if possible and not conflicting, but\n   220→        self mandates what to do. If self has define(), without placeholder, that will remain.\n   221→        :type other: _ConfValue\n   222→        \"\"\"\n   223→        v_type = self._value_type\n   224→        o_type = other._value_type\n   225→        if v_type is list and o_type is list:\n   226→            try:\n   227→                index = self._value.index(_ConfVarPlaceHolder)\n   228→            except ValueError:  # It doesn't have placeholder\n   229→                pass\n   230→            else:\n   231→                new_value = self._value[:]  # do a copy\n   232→                new_value[index:index + 1] = other._value  # replace the placeholder\n   233→                self._value = new_value\n   234→        elif v_type is dict and o_type is dict:\n   235→            if self._update:\n   236→                # only if the current one is marked as \"*=\" update, otherwise it remains\n   237→                # as this is a \"compose\" operation, self has priority, it is the one updating\n   238→                new_value = other._value.copy()\n   239→                new_value.update(self._value)\n   240→                self._value = new_value\n   241→        elif self._value is None or other._value is None:\n   242→            # It means any of those values were an \"unset\" so doing nothing because we don't\n   243→            # really know the original value type\n   244→            pass\n   245→        elif o_type != v_type:\n   246→            raise ConanException(\"It's not possible to compose {} values \"\n   247→                                 \"and {} ones.\".format(v_type.__name__, o_type.__name__))\n   248→        # TODO: In case of any other object types?\n   249→\n   250→    def set_relative_base_folder(self, folder):\n   251→        if not self._path:\n   252→            return\n   253→        if isinstance(self._value, list):\n   254→            self._value = [os.path.join(folder, v) if v != _ConfVarPlaceHolder else v\n   255→                           for v in self._value]\n   256→        if isinstance(self._value, dict):\n   257→            self._value = {k: os.path.join(folder, v) for k, v in self._value.items()}\n   258→        elif isinstance(self._value, str):\n   259→            self._value = os.path.join(folder, self._value)\n   260→\n   261→\n   262→class Conf:\n   263→    # Putting some default expressions to check that any value could be false\n   264→    boolean_false_expressions = (\"0\", '\"0\"', \"false\", '\"false\"', \"off\")\n   265→\n   266→    def __init__(self):\n   267→        # It being ordered allows for Windows case-insensitive composition\n   268→        self._values = OrderedDict()  # {var_name: [] of values, including separators}\n   269→\n   270→    def __bool__(self):\n   271→        return bool(self._values)\n   272→\n   273→    def __repr__(self):\n   274→        return \"Conf: \" + repr(self._values)\n   275→\n   276→    def __eq__(self, other):\n   277→        \"\"\"\n   278→        :type other: Conf\n   279→        \"\"\"\n   280→        return other._values == self._values\n   281→\n   282→    def clear(self):\n   283→        self._values.clear()\n   284→\n   285→    def validate(self):\n   286→        for conf in self._values:\n   287→            self._check_conf_name(conf)\n   288→\n   289→    def items(self):\n   290→        # FIXME: Keeping backward compatibility\n   291→        for k, v in self._values.items():\n   292→            yield k, v.value\n   293→\n   294→    def get(self, conf_name, default=None, check_type=None, choices=None):\n   295→        \"\"\"\n   296→        Get all the values of the given configuration name.\n   297→\n   298→        :param conf_name: Name of the configuration.\n   299→        :param default: Default value in case of conf does not have the conf_name key.\n   300→        :param check_type: Check the conf type(value) is the same as the given by this param.\n   301→                           There are two default smart conversions for bool and str types.\n   302→        :param choices: list of possible values this conf can have, if value not in it, errors.\n   303→        \"\"\"\n   304→        # Skipping this check only the user.* configurations\n   305→        self._check_conf_name(conf_name)\n   306→\n   307→        conf_value = self._values.get(conf_name)\n   308→        if conf_value:\n   309→            v = conf_value.value\n   310→            if choices is not None and v not in choices:\n   311→                raise ConanException(f\"Unknown value '{v}' for '{conf_name}'\")\n   312→            # Some smart conversions\n   313→            if check_type is bool and not isinstance(v, bool):\n   314→                # Perhaps, user has introduced a \"false\", \"0\" or even \"off\"\n   315→                return str(v).lower() not in Conf.boolean_false_expressions\n   316→            elif check_type is str and not isinstance(v, str):\n   317→                return str(v)\n   318→            elif v is None:  # value was unset\n   319→                return default\n   320→            elif (check_type is not None and not isinstance(v, check_type) or\n   321→                  check_type is int and isinstance(v, bool)):\n   322→                raise ConanException(f\"[conf] {conf_name} must be a \"\n   323→                                     f\"{check_type.__name__}-like object. The value '{v}' \"\n   324→                                     f\"introduced is a {type(v).__name__} object\")\n   325→            return v\n   326→        else:\n   327→            return default\n   328→\n   329→    def pop(self, conf_name, default=None):\n   330→        \"\"\"\n   331→        Remove the given configuration, returning its value.\n   332→\n   333→        :param conf_name: Name of the configuration.\n   334→        :param default: Default value to return in case the configuration doesn't exist.\n   335→        :return:\n   336→        \"\"\"\n   337→        value = self.get(conf_name, default=default)\n   338→        self._values.pop(conf_name, None)\n   339→        return value\n   340→\n   341→    def show(self, fnpattern, pattern=\"\"):\n   342→        return {key: self.get(key)\n   343→                for key in self._values.keys()\n   344→                if fnmatch.fnmatch(pattern + key, fnpattern)}\n   345→\n   346→    def copy(self):\n   347→        c = Conf()\n   348→        c._values = OrderedDict((k, v.copy()) for k, v in self._values.items())\n   349→        return c\n   350→\n   351→    def dumps(self):\n   352→        \"\"\"\n   353→        Returns a string with the format ``name=conf-value``\n   354→        \"\"\"\n   355→        return \"\\n\".join([v.dumps() for v in sorted(self._values.values(), key=lambda x: x._name)])\n   356→\n   357→    def serialize(self):\n   358→        \"\"\"\n   359→        Returns a dict-like object, e.g., ``{\"tools.xxxx\": \"value1\"}``\n   360→        \"\"\"\n   361→        ret = {}\n   362→        for v in self._values.values():\n   363→            ret.update(v.serialize())\n   364→        return ret\n   365→\n   366→    def define(self, name, value):\n   367→        \"\"\"\n   368→        Define a value for the given configuration name.\n   369→\n   370→        :param name: Name of the configuration.\n   371→        :param value: Value of the configuration.\n   372→        \"\"\"\n   373→        self._values[name] = _ConfValue(name, value)\n   374→\n   375→    def define_path(self, name, value):\n   376→        self._values[name] = _ConfValue(name, value, path=True)\n   377→\n   378→    def unset(self, name):\n   379→        \"\"\"\n   380→        Clears the variable, equivalent to a unset or set XXX=\n   381→\n   382→        :param name: Name of the configuration.\n   383→        \"\"\"\n   384→        self._values[name] = _ConfValue(name, None)\n   385→\n   386→    def update(self, name, value):\n   387→        \"\"\"\n   388→        Update the value to the given configuration name.\n   389\n   390→        :param name: Name of the configuration.\n   391→        :param value: Value of the configuration.\n   392→        \"\"\"\n   393→        # Placeholder trick is not good for dict update, so we need to explicitly update=True\n   394→        conf_value = _ConfValue(name, {}, update=True)\n   395→        self._values.setdefault(name, conf_value).update(value)\n   396→\n   397→    def update_path(self, name, value):\n   398→        conf_value = _ConfValue(name, {}, path=True, update=True)\n   399→        self._values.setdefault(name, conf_value).update(value)\n   400→\n   401→    def append(self, name, value):\n   402→        \"\"\"\n   403→        Append a value to the given configuration name.\n   404→\n   405→        :param name: Name of the configuration.\n   406→        :param value: Value to append.\n   407→        \"\"\"\n   408→        conf_value = _ConfValue(name, [_ConfVarPlaceHolder])\n   409→        self._values.setdefault(name, conf_value).append(value)\n   410→\n   411→    def append_path(self, name, value):\n   412→        conf_value = _ConfValue(name, [_ConfVarPlaceHolder], path=True)\n   413→        self._values.setdefault(name, conf_value).append(value)\n   414→\n   415→    def prepend(self, name, value):\n   416→        \"\"\"\n   417→        Prepend a value to the given configuration name.\n   418→\n   419→        :param name: Name of the configuration.\n   420→        :param value: Value to prepend.\n   421→        \"\"\"\n   422→        conf_value = _ConfValue(name, [_ConfVarPlaceHolder])\n   423→        self._values.setdefault(name, conf_value).prepend(value)\n   424→\n   425→    def prepend_path(self, name, value):\n   426→        conf_value = _ConfValue(name, [_ConfVarPlaceHolder], path=True)\n   427→        self._values.setdefault(name, conf_value).prepend(value)\n   428→\n   429→    def remove(self, name, value):\n   430→        \"\"\"\n   431→        Remove a value from the given configuration name.\n   432→\n   433→        :param name: Name of the configuration.\n   434→        :param value: Value to remove.\n   435→        \"\"\"\n   436→        conf_value = self._values.get(name)\n   437→        if conf_value:\n   438→            conf_value.remove(value)\n   439→        else:\n   440→            raise ConanException(\"Conf {} does not exist.\".format(name))\n   441→\n   442→    def compose_conf(self, other):\n   443→        \"\"\"\n   444→        :param other: other has less priority than current one\n   445→        :type other: Conf\n   446→        \"\"\"\n   447→        for k, v in other._values.items():\n   448→            existing = self._values.get(k)\n   449→            if existing is None:\n   450→                self._values[k] = v.copy()\n   451→            else:\n   452→                existing.compose_conf_value(v)\n   453→        return self\n   454→\n   455→    def filter_user_modules(self):\n   456→        result = Conf()\n   457→        for k, v in self._values.items():\n   458→            if _is_profile_module(k):\n   459→                result._values[k] = v\n   460→        return result\n   461→\n   462→    def copy_conaninfo_conf(self):\n   463→        \"\"\"\n   464→        Get a new `Conf()` object with all the configurations required by the consumer\n   465→        to be included in the final `ConanInfo().package_id()` computation. For instance, let's\n   466→        suppose that we have this Conan `profile`:\n   467→\n   468→        ```\n   469→        ...\n   470→        [conf]\n   471→        tools.info.package_id:confs=[\"tools.build:cxxflags\", \"tools.build:cflags\"]\n   472→        tools.build:cxxflags=[\"flag1xx\"]\n   473→        tools.build:cflags=[\"flag1\"]\n   474→        tools.build:defines=[\"DEF1\"]\n   475→        ...\n   476→\n   477→        Then, the resulting `Conf()` will have only these configuration lines:\n   478→\n   479→        tools.build:cxxflags=[\"flag1xx\"]\n   480→        tools.build:cflags=[\"flag1\"]\n   481→        ```\n   482→\n   483→        :return: a new `< Conf object >` with the configuration selected by `tools.info.package_id:confs`.\n   484→        \"\"\"\n   485→        result = Conf()\n   486→        # Reading the list of all the configurations selected by the user to use for the package_id\n   487→        package_id_confs = self.get(\"tools.info.package_id:confs\", default=[], check_type=list)\n   488→        for conf_name in package_id_confs:\n   489→            matching_confs = [c for c in self._values if re.match(conf_name, c)]\n   490→            for name in matching_confs:\n   491→                value = self.get(name)\n   492→                # Pruning any empty values, those should not affect package ID\n   493→                if value:\n   494→                    result.define(name, value)\n   495→        return result\n   496→\n   497→    def set_relative_base_folder(self, folder):\n   498→        for v in self._values.values():\n   499→            v.set_relative_base_folder(folder)\n   500→\n   501→    @staticmethod\n   502→    def _check_conf_name(conf):\n   503→        if USER_CONF_PATTERN.match(conf) is None and conf not in BUILT_IN_CONFS:\n   504→            raise ConanException(f\"[conf] Either '{conf}' does not exist in configuration list or \"\n   505→                                 f\"the conf format introduced is not valid. Run 'conan config list' \"\n   506→                                 f\"to see all the available confs.\")\n   507→\n   508→\n   509→class ConfDefinition:\n   510→    # Order is important, \"define\" must be latest\n   511→    actions = ((\"+=\", \"append\"), (\"=+\", \"prepend\"),\n   512→               (\"=!\", \"unset\"), (\"*=\", \"update\"), (\"=\", \"define\"))\n   513→\n   514→    def __init__(self):\n   515→        self._pattern_confs = OrderedDict()\n   516→\n   517→    def __repr__(self):\n   518→        return \"ConfDefinition: \" + repr(self._pattern_confs)\n   519→\n   520→    def __bool__(self):\n   521→        return bool(self._pattern_confs)\n   522→\n   523→    def get(self, conf_name, default=None, check_type=None, choices=None):\n   524→        \"\"\"\n   525→        Get the value of the conf name requested and convert it to the [type]-like passed.\n   526→        \"\"\"\n   527→        pattern, name = self._split_pattern_name(conf_name)\n   528→        return self._pattern_confs.get(pattern, Conf()).get(name, default=default,\n   529→                                                            check_type=check_type, choices=choices)\n   530→\n   531→    def show(self, fnpattern):\n   532→        \"\"\"\n   533→        Get the value of the confs that match the requested pattern\n   534→        \"\"\"\n   535→        result = {}\n   536→\n   537→        for patter_key, patter_conf in self._pattern_confs.items():\n   538→            if patter_key is None:\n   539→                patter_key = \"\"\n   540→            else:\n   541→                patter_key += \":\"\n   542→\n   543→            pattern_values = patter_conf.show(fnpattern, patter_key)\n   544→            result.update({patter_key + pattern_subkey: pattern_subvalue\n   545→                           for pattern_subkey, pattern_subvalue in pattern_values.items()})\n   546→\n   547→        return result\n   548→\n   549→    def pop(self, conf_name, default=None):\n   550→        \"\"\"\n   551→        Remove the conf name passed.\n   552→        \"\"\"\n   553→        pattern, name = self._split_pattern_name(conf_name)\n   554→        return self._pattern_confs.get(pattern, Conf()).pop(name, default=default)\n   555→\n   556→    @staticmethod\n   557→    def _split_pattern_name(pattern_name):\n   558→        if pattern_name.count(\":\") >= 2:\n   559→            pattern, name = pattern_name.split(\":\", 1)\n   560→        else:\n   561→            pattern, name = None, pattern_name\n   562→        return pattern, name\n   563→\n   564→    def get_conanfile_conf(self, ref, is_consumer=False):\n   565→        \"\"\" computes package-specific Conf\n   566→        it is only called when conanfile.buildenv is called\n   567→        the last one found in the profile file has top priority\n   568→        \"\"\"\n   569→        result = Conf()\n   570→        for pattern, conf in self._pattern_confs.items():\n   571→            if pattern is None or ref_matches(ref, pattern, is_consumer):\n   572→                # Latest declared has priority, copy() necessary to not destroy data\n   573→                result = conf.copy().compose_conf(result)\n   574→        return result\n   575→\n   576→    def update_conf_definition(self, other):\n   577→        \"\"\"\n   578→        :type other: ConfDefinition\n   579→        :param other: The argument profile has priority/precedence over the current one.\n   580→        \"\"\"\n   581→        for pattern, conf in other._pattern_confs.items():\n   582→            self._update_conf_definition(pattern, conf)\n   583→\n   584→    def _update_conf_definition(self, pattern, conf):\n   585→        existing = self._pattern_confs.get(pattern)\n   586→        if existing:\n   587→            self._pattern_confs[pattern] = conf.compose_conf(existing)\n   588→        else:\n   589→            self._pattern_confs[pattern] = conf\n   590→\n   591→    def rebase_conf_definition(self, other):\n   592→        \"\"\"\n   593→        for taking the new global.conf and composing with the profile [conf]\n   594→        :type other: ConfDefinition\n   595→        \"\"\"\n   596→        for pattern, conf in other._pattern_confs.items():\n   597→            new_conf = conf.filter_user_modules()  # Creates a copy, filtered\n   598→            existing = self._pattern_confs.get(pattern)\n   599→            if existing:\n   600→                existing.compose_conf(new_conf)\n   601→            else:\n   602→                self._pattern_confs[pattern] = new_conf\n   603→\n   604→    def update(self, key, value, profile=False, method=\"define\"):\n   605→        \"\"\"\n   606→        Define/append/prepend/unset any Conf line\n   607→        >> update(\"tools.build:verbosity\", \"verbose\")\n   608→        \"\"\"\n   609→        pattern, name = self._split_pattern_name(key)\n   610→\n   611→        if not _is_profile_module(name):\n   612→            if profile:\n   613→                raise ConanException(\"[conf] '{}' not allowed in profiles\".format(key))\n   614→            if pattern is not None:\n   615→                raise ConanException(\"Conf '{}' cannot have a package pattern\".format(key))\n   616→\n   617→        # strip whitespaces before/after =\n   618→        # values are not strip() unless they are a path, to preserve potential whitespaces\n   619→        name = name.strip()\n   620→\n   621→        # When loading from profile file, latest line has priority\n   622→        conf = Conf()\n   623→        if method == \"unset\":\n   624→            conf.unset(name)\n   625→        else:\n   626→            getattr(conf, method)(name, value)\n   627→        # Update\n   628→        self._update_conf_definition(pattern, conf)\n   629→\n   630→    def dumps(self):\n   631→        result = []\n   632→        for pattern, conf in self._pattern_confs.items():\n   633→            if pattern is None:\n   634→                result.append(conf.dumps())\n   635→            else:\n   636→                result.append(\"\\n\".join(\"{}:{}\".format(pattern, line) if line else \"\"\n   637→                                        for line in conf.dumps().splitlines()))\n   638→        if result:\n   639→            result.append(\"\")\n   640→        return \"\\n\".join(result)\n   641→\n   642→    def serialize(self):\n   643→        result = {}\n   644→        for pattern, conf in self._pattern_confs.items():\n   645            if pattern is None:\n   646→                result.update(conf.serialize())\n   647→            else:\n   648→                for k, v in conf.serialize():\n   649→                    result[f\"{pattern}:{k}\"] = v\n   650→        return result\n   651→\n   652→    @staticmethod\n   653→    def _get_evaluated_value(__v):\n   654→        \"\"\"\n   655→        Function to avoid eval() catching local variables\n   656→        \"\"\"\n   657→        try:\n   658→            # Isolated eval\n   659→            parsed_value = eval(__v)  # This destroys Windows path strings with backslash\n   660→            if isinstance(parsed_value, str):  # xxx:xxx = \"my string\"\n   661→                # If it is quoted string we respect it as-is\n   662→                parsed_value = __v.strip()\n   663→        except:\n   664→            # It means eval() failed because of a string without quotes\n   665→            parsed_value = __v.strip()\n   666→        return parsed_value\n   667→\n   668→    def loads(self, text, profile=False):\n   669→        self._pattern_confs = {}\n   670→\n   671→        for line in text.splitlines():\n   672→            line = line.strip()\n   673→            if not line or line.startswith(\"#\"):\n   674→                continue\n   675→            for op, method in ConfDefinition.actions:\n   676→                tokens = line.split(op, 1)\n   677→                if len(tokens) != 2:\n   678→                    continue\n   679→                pattern_name, value = tokens\n   680→                parsed_value = ConfDefinition._get_evaluated_value(value)\n   681→                self.update(pattern_name, parsed_value, profile=profile, method=method)\n   682→                break\n   683→            else:\n   684→                raise ConanException(\"Bad conf definition: {}\".format(line))\n   685→\n   686→    def validate(self):\n   687→        for conf in self._pattern_confs.values():\n   688→            conf.validate()\n   689→\n\n<system-reminder>\nWhenever you read a file, you s