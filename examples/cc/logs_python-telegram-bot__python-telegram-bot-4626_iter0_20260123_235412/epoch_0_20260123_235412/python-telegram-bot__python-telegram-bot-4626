ror, match=\"initialize\"):\n   412\u2192            async with app:\n   413\u2192                pass\n   414\u2192\n   415\u2192        assert self.test_flag == \"stop\"\n   416\u2192\n   417\u2192    @pytest.mark.parametrize(\"data\", [\"chat_data\", \"user_data\"])\n   418\u2192    def test_chat_user_data_read_only(self, app, data):\n   419\u2192        read_only_data = getattr(app, data)\n   420\u2192        writable_data = getattr(app, f\"_{data}\")\n   421\u2192        writable_data[123] = 321\n   422\u2192        assert read_only_data == writable_data\n   423\u2192        with pytest.raises(TypeError):\n   424\u2192            read_only_data[111] = 123\n   425\u2192\n   426\u2192    def test_builder(self, app):\n   427\u2192        builder_1 = app.builder()\n   428\u2192        builder_2 = app.builder()\n   429\u2192        assert isinstance(builder_1, ApplicationBuilder)\n   430\u2192        assert isinstance(builder_2, ApplicationBuilder)\n   431\u2192        assert builder_1 is not builder_2\n   432\u2192\n   433\u2192        # Make sure that setting a token doesn't raise an exception\n   434\u2192        # i.e. check that the builders are \"empty\"/new\n   435\u2192        builder_1.token(app.bot.token)\n   436\u2192        builder_2.token(app.bot.token)\n   437\u2192\n   438\u2192    @pytest.mark.parametrize(\"job_queue\", [True, False])\n   439\u2192    @pytest.mark.filterwarnings(\"ignore::telegram.warnings.PTBUserWarning\")\n   440\u2192    async def test_start_stop_processing_updates(self, one_time_bot, job_queue, monkeypatch):\n   441\u2192        # TODO: repeat a similar test for create_task, persistence processing and job queue\n   442\u2192        if job_queue:\n   443\u2192            app = ApplicationBuilder().bot(one_time_bot).build()\n   444\u2192        else:\n   445\u2192            app = ApplicationBuilder().bot(one_time_bot).job_queue(None).build()\n   446\u2192\n   447\u2192        async def callback(u, c):\n   448\u2192            self.received = u\n   449\u2192\n   450\u2192        monkeypatch.setattr(app.bot, \"get_updates\", empty_get_updates)\n   451\u2192        monkeypatch.setattr(app.bot, \"delete_webhook\", return_true)\n   452\u2192\n   453\u2192        assert not app.running\n   454\u2192        assert not app.updater.running\n   455\u2192        if job_queue:\n   456\u2192            assert not app.job_queue.scheduler.running\n   457\u2192        else:\n   458\u2192            assert app.job_queue is None\n   459\u2192        app.add_handler(TypeHandler(object, callback))\n   460\u2192\n   461\u2192        await app.update_queue.put(1)\n   462\u2192        await asyncio.sleep(0.05)\n   463\u2192        assert not app.update_queue.empty()\n   464\u2192        assert self.received is None\n   465\u2192\n   466\u2192        async with app:\n   467\u2192            await app.start()\n   468\u2192            assert app.running\n   469\u2192            tasks = asyncio.all_tasks()\n   470\u2192            assert any(\":update_fetcher\" in task.get_name() for task in tasks)\n   471\u2192            if job_queue:\n   472\u2192                assert app.job_queue.scheduler.running\n   473\u2192            else:\n   474\u2192                assert app.job_queue is None\n   475\u2192            # app.start() should not start the updater!\n   476\u2192            assert not app.updater.running\n   477\u2192            await asyncio.sleep(0.05)\n   478\u2192            assert app.update_queue.empty()\n   479\u2192            assert self.received == 1\n   480\u2192            try:  # just in case start_polling times out\n   481\u2192                await app.updater.start_polling()\n   482\u2192            except TelegramError:\n   483\u2192                pytest.xfail(\"start_polling timed out\")\n   484\u2192            else:\n   485\u2192                await app.stop()\n   486\u2192            assert not app.running\n   487\u2192            # app.stop() should not stop the updater!\n   488\u2192            assert app.updater.running\n   489\u2192            if job_queue:\n   490\u2192                assert not app.job_queue.scheduler.running\n   491\u2192            else:\n   492\u2192                assert app.job_queue is None\n   493\u2192            await app.update_queue.put(2)\n   494\u2192            await asyncio.sleep(0.05)\n   495\u2192            assert not app.update_queue.empty()\n   496\u2192            assert self.received != 2\n   497\u2192            assert self.received == 1\n   498\u2192\n   499\u2192            await app.updater.stop()\n   500\u2192\n   501\u2192    async def test_error_start_stop_twice(self, app):\n   502\u2192        async with app:\n   503\u2192            await app.start()\n   504\u2192            assert app.running\n   505\u2192            with pytest.raises(RuntimeError, match=\"already running\"):\n   506\u2192                await app.start()\n   507\u2192\n   508\u2192            await app.stop()\n   509\u2192            assert not app.running\n   510\u2192            with pytest.raises(RuntimeError, match=\"not running\"):\n   511\u2192                await app.stop()\n   512\u2192\n   513\u2192    async def test_one_context_per_update(self, app):\n   514\u2192        self.received = None\n   515\u2192\n   516\u2192        async def one(update, context):\n   517\u2192            self.received = context\n   518\u2192\n   519\u2192        async def two(update, context):\n   520\u2192            if update.message.text == \"test\":\n   521\u2192                if context is not self.received:\n   522\u2192                    pytest.fail(\"Expected same context object, got different\")\n   523\u2192            elif context is self.received:\n   524\u2192                pytest.fail(\"First handler was wrongly called\")\n   525\u2192\n   526\u2192        async with app:\n   527\u2192            app.add_handler(MessageHandler(filters.Regex(\"test\"), one), group=1)\n   528\u2192            app.add_handler(MessageHandler(filters.ALL, two), group=2)\n   529\u2192            u = make_message_update(message=\"test\")\n   530\u2192            await app.process_update(u)\n   531\u2192            self.received = None\n   532\u2192            u = make_message_update(message=\"something\")\n   533\u2192            await app.process_update(u)\n   534\u2192\n   535\u2192    def test_add_handler_errors(self, app):\n   536\u2192        handler = \"not a handler\"\n   537\u2192        with pytest.raises(TypeError, match=\"handler is not an instance of\"):\n   538\u2192            app.add_handler(handler)\n   539\u2192\n   540\u2192        handler = MessageHandler(filters.PHOTO, self.callback_set_count(1))\n   541\u2192        with pytest.raises(TypeError, match=\"group is not int\"):\n   542\u2192            app.add_handler(handler, \"one\")\n   543\u2192\n   544\u2192    @pytest.mark.parametrize(\"group_empty\", [True, False])\n   545\u2192    async def test_add_remove_handler(self, app, group_empty):\n   546\u2192        handler = MessageHandler(filters.ALL, self.callback_increase_count)\n   547\u2192        app.add_handler(handler)\n   548\u2192        if not group_empty:\n   549\u2192            app.add_handler(handler)\n   550\u2192\n   551\u2192        async with app:\n   552\u2192            await app.start()\n   553\u2192            await app.update_queue.put(self.message_update)\n   554\u2192            await asyncio.sleep(0.05)\n   555\u2192            assert self.count == 1\n   556\u2192            app.remove_handler(handler)\n   557\u2192            assert (0 in app.handlers) == (not group_empty)\n   558\u2192            await app.update_queue.put(self.message_update)\n   559\u2192            assert self.count == 1\n   560\u2192            await app.stop()\n   561\u2192\n   562\u2192    async def test_add_remove_handler_non_default_group(self, app):\n   563\u2192        handler = MessageHandler(filters.ALL, self.callback_increase_count)\n   564\u2192        app.add_handler(handler, group=2)\n   565\u2192        with pytest.raises(KeyError):\n   566\u2192            app.remove_handler(handler)\n   567\u2192        app.remove_handler(handler, group=2)\n   568\u2192\n   569\u2192    async def test_handler_order_in_group(self, app):\n   570\u2192        app.add_handler(MessageHandler(filters.PHOTO, self.callback_set_count(1)))\n   571\u2192        app.add_handler(MessageHandler(filters.ALL, self.callback_set_count(2)))\n   572\u2192        app.add_handler(MessageHandler(filters.TEXT, self.callback_set_count(3)))\n   573\u2192        async with app:\n   574\u2192            await app.start()\n   575\u2192            await app.update_queue.put(self.message_update)\n   576\u2192            await asyncio.sleep(0.05)\n   577\u2192            assert self.count == 2\n   578\u2192            await app.stop()\n   579\u2192\n   580\u2192    async def test_groups(self, app):\n   581\u2192        app.add_handler(MessageHandler(filters.ALL, self.callback_increase_count))\n   582\u2192        app.add_handler(MessageHandler(filters.ALL, self.callback_increase_count), group=2)\n   583\u2192        app.add_handler(MessageHandler(filters.ALL, self.callback_increase_count), group=-1)\n   584\u2192\n   585\u2192        async with app:\n   586\u2192            await app.start()\n   587\u2192            await app.update_queue.put(self.message_update)\n   588\u2192            await asyncio.sleep(0.05)\n   589\u2192            assert self.count == 3\n   590\u2192            await app.stop()\n   591\u2192\n   592\u2192    async def test_add_handlers(self, app):\n   593\u2192        \"\"\"Tests both add_handler & add_handlers together & confirms the correct insertion\n   594\u2192        order\"\"\"\n   595\u2192        msg_handler_set_count = MessageHandler(filters.TEXT, self.callback_set_count(1))\n   596\u2192        msg_handler_inc_count = MessageHandler(filters.PHOTO, self.callback_increase_count)\n   597\u2192\n   598\u2192        app.add_handler(msg_handler_set_count, 1)\n   599\u2192        app.add_handlers((msg_handler_inc_count, msg_handler_inc_count), 1)\n   600\u2192\n   601\u2192        photo_update = make_message_update(message=Message(2, None, None, photo=(True,)))\n   602\u2192\n   603\u2192        async with app:\n   604\u2192            await app.start()\n   605\u2192            # Putting updates in the queue calls the callback\n   606\u2192            await app.update_queue.put(self.message_update)\n   607\u2192            await app.update_queue.put(photo_update)\n   608\u2192            await asyncio.sleep(0.05)  # sleep is required otherwise there is random behaviour\n   609\u2192\n   610\u2192            # Test if handler was added to correct group with correct order-\n   611\u2192            assert self.count == 2\n   612\u2192            assert len(app.handlers[1]) == 3\n   613\u2192            assert app.handlers[1][0] is msg_handler_set_count\n   614\u2192\n   615\u2192            # Now lets test add_handlers when `handlers` is a dict-\n   616\u2192            voice_filter_handler_to_check = MessageHandler(\n   617\u2192                filters.VOICE, self.callback_increase_count\n   618\u2192            )\n   619\u2192            app.add_handlers(\n   620\u2192                handlers={\n   621\u2192                    1: [\n   622\u2192                        MessageHandler(filters.USER, self.callback_increase_count),\n   623\u2192                        voice_filter_handler_to_check,\n   624\u2192                    ],\n   625\u2192                    -1: [MessageHandler(filters.CAPTION, self.callback_set_count(2))],\n   626\u2192                }\n   627\u2192            )\n   628\u2192\n   629\u2192            user_update = make_message_update(\n   630\u2192                message=Message(3, None, None, from_user=User(1, \"s\", True))\n   631\u2192            )\n   632\u2192            voice_update = make_message_update(message=Message(4, None, None, voice=True))\n   633\u2192            await app.update_queue.put(user_update)\n   634\u2192            await app.update_queue.put(voice_update)\n   635\u2192            await asyncio.sleep(0.05)\n   636\u2192\n   637\u2192            assert self.count == 4\n   638\u2192            assert len(app.handlers[1]) == 5\n   639\u2192            assert app.handlers[1][-1] is voice_filter_handler_to_check\n   640\u2192\n   641\u2192            await app.update_queue.put(\n   642\u2192                make_message_update(message=Message(5, None, None, caption=\"cap\"))\n   643\u2192            )\n   644\u2192            await asyncio.sleep(0.05)\n   645\u2192\n   646\u2192            assert self.count == 2\n   647\u2192            assert len(app.handlers[-1]) == 1\n   648\u2192\n   649\u2192            # Now lets test the errors which can be produced-\n   650\u2192            with pytest.raises(TypeError, match=\"The `group` argument\"):\n   651\u2192                app.add_handlers({2: [msg_handler_set_count]}, group=0)\n   652\u2192            with pytest.raises(TypeError, match=\"Handlers for group 3\"):\n   653\u2192                app.add_handlers({3: msg_handler_set_count})\n   654\u2192            with pytest.raises(TypeError, match=\"The `handlers` argument must be a sequence\"):\n   655\u2192                app.add_handlers({msg_handler_set_count})\n   656\u2192\n   657\u2192            await app.stop()\n   658\u2192\n   659\u2192    async def test_check_update(self, app):\n   660\u2192        class TestHandler(BaseHandler):\n   661\u2192            def check_update(_, update: object):\n   662\u2192                self.received = object()\n   663\u2192\n   664\u2192            def handle_update(\n   665\u2192                _,\n   666\u2192                update,\n   667\u2192                application,\n   668\u2192                check_result,\n   669\u2192                context,\n   670\u2192            ):\n   671\u2192                assert application is app\n   672\u2192                assert check_result is not self.received\n   673\u2192\n   674\u2192        async with app:\n   675\u2192            app.add_handler(TestHandler(\"callback\"))\n   676\u2192            await app.start()\n   677\u2192            await app.update_queue.put(object())\n   678\u2192            await asyncio.sleep(0.05)\n   679\u2192            await app.stop()\n   680\u2192\n   681\u2192    async def test_flow_stop(self, app, one_time_bot):\n   682\u2192        passed = []\n   683\u2192\n   684\u2192        async def start1(b, u):\n   685\u2192            passed.append(\"start1\")\n   686\u2192            raise ApplicationHandlerStop\n   687\u2192\n   688\u2192        async def start2(b, u):\n   689\u2192            passed.append(\"start2\")\n   690\u2192\n   691\u2192        async def start3(b, u):\n   692\u2192            passed.append(\"start3\")\n   693\u2192\n   694\u2192        update = make_message_update(\n   695\u2192            message=Message(\n   696\u2192                1,\n   697\u2192                None,\n   698\u2192                None,\n   699\u2192                None,\n   700\u2192                text=\"/start\",\n   701\u2192                entities=[\n   702\u2192                    MessageEntity(type=MessageEntity.BOT_COMMAND, offset=0, length=len(\"/start\"))\n   703\u2192                ],\n   704\u2192            ),\n   705\u2192        )\n   706\u2192        await one_time_bot.initialize()\n   707\u2192        update.message.set_bot(one_time_bot)\n   708\u2192\n   709\u2192        async with app:\n   710\u2192            # If ApplicationHandlerStop raised handlers in other groups should not be called.\n   711\u2192            passed = []\n   712\u2192            app.add_handler(CommandHandler(\"start\", start1), 1)\n   713\u2192            app.add_handler(CommandHandler(\"start\", start3), 1)\n   714\u2192            app.add_handler(CommandHandler(\"start\", start2), 2)\n   715\u2192            await app.process_update(update)\n   716\u2192            assert passed == [\"start1\"]\n   717\u2192\n   718\u2192    async def test_flow_stop_by_error_handler(self, app):\n   719\u2192        passed = []\n   720\u2192        exception = Exception(\"General exception\")\n   721\u2192\n   722\u2192        async def start1(u, c):\n   723\u2192            passed.append(\"start1\")\n   724\u2192            raise exception\n   725\u2192\n   726\u2192        async def start2(u, c):\n   727\u2192            passed.append(\"start2\")\n   728\u2192\n   729\u2192        async def start3(u, c):\n   730\u2192            passed.append(\"start3\")\n   731\u2192\n   732\u2192        async def error(u, c):\n   733\u2192            passed.append(\"error\")\n   734\u2192            passed.append(c.error)\n   735\u2192            raise ApplicationHandlerStop\n   736\u2192\n   737\u2192        async with app:\n   738\u2192            # If ApplicationHandlerStop raised handlers in other groups should not be called.\n   739\u2192            passed = []\n   740\u2192            app.add_error_handler(error)\n   741\u2192            app.add_handler(TypeHandler(object, start1), 1)\n   742\u2192            app.add_handler(TypeHandler(object, start2), 1)\n   743\u2192            app.add_handler(TypeHandler(object, start3), 2)\n   744\u2192            await app.process_update(1)\n   745\u2192            assert passed == [\"start1\", \"error\", exception]\n   746\u2192\n   747\u2192    async def test_error_in_handler_part_1(self, app):\n   748\u2192        app.add_handler(\n   749\u2192            MessageHandler(\n   750\u2192                filters.ALL,\n   751\u2192                self.callback_raise_error(error_message=self.message_update.message.text),\n   752\u2192            )\n   753\u2192        )\n   754\u2192        app.add_handler(MessageHandler(filters.ALL, self.callback_set_count(42)), group=1)\n   755\u2192        app.add_error_handler(self.error_handler_context)\n   756\u2192\n   757\u2192        async with app:\n   758\u2192            await app.start()\n   759\u2192            await app.update_queue.put(self.message_update)\n   760\u2192            await asyncio.sleep(0.05)\n   761\u2192            await app.stop()\n   762\u2192\n   763\u2192        assert self.received == self.message_update.message.text\n   764\u2192        # Higher groups should still be called\n   765\u2192        assert self.count == 42\n   766\u2192\n   767\u2192    async def test_error_in_handler_part_2(self, app, one_time_bot):\n   768\u2192        passed = []\n   769\u2192        err = Exception(\"General exception\")\n   770\u2192\n   771\u2192        async def start1(u, c):\n   772\u2192            passed.append(\"start1\")\n   773\u2192            raise err\n   774\u2192\n   775\u2192        async def start2(u, c):\n   776\u2192            passed.append(\"start2\")\n   777\u2192\n   778\u2192        async def start3(u, c):\n   779\u2192            passed.append(\"start3\")\n   780\u2192\n   781\u2192        async def error(u, c):\n   782\u2192            passed.append(\"error\")\n   783\u2192            passed.append(c.error)\n   784\u2192\n   785\u2192        update = make_message_update(\n   786\u2192            message=Message(\n   787\u2192                1,\n   788\u2192                None,\n   789\u2192                None,\n   790\u2192                None,\n   791\u2192                text=\"/start\",\n   792\u2192                entities=[\n   793\u2192                    MessageEntity(type=MessageEntity.BOT_COMMAND, offset=0, length=len(\"/start\"))\n   794\u2192                ],\n   795\u2192            ),\n   796\u2192        )\n   797\u2192        await one_time_bot.initialize()\n   798\u2192        update.message.set_bot(one_time_bot)\n   799\u2192\n   800\u2192        async with app:\n   801\u2192            # If an unhandled exception was caught, no further handlers from the same group should\n   802\u2192            # be called. Also, the error handler should be called and receive the exception\n   803\u2192            passed = []\n   804\u2192            app.add_handler(CommandHandler(\"start\", start1), 1)\n   805\u2192            app.add_handler(CommandHandler(\"start\", start2), 1)\n   806\u2192            app.add_handler(CommandHandler(\"start\", start3), 2)\n   807\u2192            app.add_error_handler(error)\n   808\u2192            await app.process_update(update)\n   809\u2192            assert passed == [\"start1\", \"error\", err, \"start3\"]\n   810\u2192\n   811\u2192    @pytest.mark.parametrize(\"block\", [True, False])\n   812\u2192    async def test_error_handler(self, app, block):\n   813\u2192        app.add_error_handler(self.error_handler_context)\n   814\u2192        app.add_handler(TypeHandler(object, self.callback_raise_error(\"TestError\"), block=block))\n   815\u2192\n   816\u2192        async with app:\n   817\u2192            await app.start()\n   818\u2192            await app.update_queue.put(1)\n   819\u2192            await asyncio.sleep(0.05)\n   820\u2192            assert self.received == \"TestError\"\n   821\u2192\n   822\u2192            # Remove handler\n   823\u2192            app.remove_error_handler(self.error_handler_context)\n   824\u2192            self.reset()\n   825\u2192\n   826\u2192            await app.update_queue.put(1)\n   827\u2192            await asyncio.sleep(0.05)\n   828\u2192            assert self.received is None\n   829\u2192\n   830\u2192            await app.stop()\n   831\u2192\n   832\u2192    def test_double_add_error_handler(self, app, caplog):\n   833\u2192        app.add_error_handler(self.error_handler_context)\n   834\u2192        with caplog.at_level(logging.DEBUG):\n   835\u2192            app.add_error_handler(self.error_handler_context)\n   836\u2192            assert len(caplog.records) == 1\n   837\u2192            assert caplog.records[-1].name == \"telegram.ext.Application\"\n   838\u2192            assert caplog.records[-1].getMessage().startswith(\"The callback is already registered\")\n   839\u2192\n   840\u2192    async def test_error_handler_that_raises_errors(self, app, caplog):\n   841\u2192        \"\"\"Make sure that errors raised in error handlers don't break the main loop of the\n   842\u2192        application\n   843\u2192        \"\"\"\n   844\u2192        handler_raise_error = TypeHandler(\n   845\u2192            int, self.callback_raise_error(error_message=\"TestError\")\n   846\u2192        )\n   847\u2192        handler_increase_count = TypeHandler(str, self.callback_increase_count)\n   848\u2192\n   849\u2192        app.add_error_handler(self.error_handler_raise_error)\n   850\u2192        app.add_handler(handler_raise_error)\n   851\u2192        app.add_handler(handler_increase_count)\n   852\u2192\n   853\u2192        with caplog.at_level(logging.ERROR):\n   854\u2192            async with app:\n   855\u2192                await app.start()\n   856\u2192                await app.update_queue.put(1)\n   857\u2192                await asyncio.sleep(0.05)\n   858\u2192                assert self.count == 0\n   859\u2192                assert self.received is None\n   860\u2192                assert len(caplog.records) > 0\n   861\u2192                assert any(\n   862\u2192                    \"uncaught error was raised while handling the error with an error_handler\"\n   863\u2192                    in record.getMessage()\n   864\u2192                    and record.name == \"telegram.ext.Application\"\n   865\u2192                    for record in caplog.records\n   866\u2192                )\n   867\u2192\n   868\u2192                await app.update_queue.put(\"1\")\n   869\u2192                self.received = None\n   870\u2192                caplog.clear()\n   871\u2192                await asyncio.sleep(0.05)\n   872\u2192                assert self.count == 1\n   873\u2192                assert self.received is None\n   874\u2192                assert not caplog.records\n   875\u2192\n   876\u2192                await app.stop()\n   877\u2192\n   878\u2192    async def test_custom_context_error_handler(self, one_time_bot):\n   879\u2192        async def error_handler(_, context):\n   880\u2192            self.received = (\n   881\u2192                type(context),\n   882\u2192                type(context.user_data),\n   883\u2192                type(context.chat_data),\n   884\u2192                type(context.bot_data),\n   885\u2192            )\n   886\u2192\n   887\u2192        application = (\n   888\u2192            ApplicationBuilder()\n   889\u2192            .bot(one_time_bot)\n   890\u2192            .context_types(\n   891\u2192                ContextTypes(\n   892\u2192                    context=CustomContext, bot_data=int, user_data=float, chat_data=complex\n   893\u2192                )\n   894\u2192            )\n   895\u2192            .build()\n   896\u2192        )\n   897\u2192        application.add_error_handler(error_handler)\n   898\u2192        application.add_handler(\n   899\u2192            MessageHandler(filters.ALL, self.callback_raise_error(\"TestError\"))\n   900\u2192        )\n   901\u2192\n   902\u2192        async with application:\n   903\u2192            await application.process_update(self.message_update)\n   904\u2192            await asyncio.sleep(0.05)\n   905\u2192            assert self.received == (CustomContext, float, complex, int)\n   906\u2192\n   907\u2192    async def test_custom_context_handler_callback(self, one_time_bot):\n   908\u2192        async def callback(_, context):\n   909\u2192            self.received = (\n   910\u2192                type(context),\n   911\u2192                type(context.user_data),\n   912\u2192                type(context.chat_data),\n   913\u2192                type(context.bot_data),\n   914\u2192            )\n   915\u2192\n   916\u2192        application = (\n   917\u2192            ApplicationBuilder()\n   918\u2192            .bot(one_time_bot)\n   919\u2192            .context_types(\n   920\u2192                ContextTypes(\n   921\u2192                    context=CustomContext, bot_data=int, user_data=float, chat_data=complex\n   922\u2192                )\n   923\u2192            )\n   924\u2192            .build()\n   925\u2192        )\n   926\u2192        application.add_handler(MessageHandler(filters.ALL, callback))\n   927\u2192\n   928\u2192        async with application:\n   929\u2192            await application.process_update(self.message_update)\n   930\u2192            await asyncio.sleep(0.05)\n   931\u2192            assert self.received == (CustomContext, float, complex, int)\n   932\u2192\n   933\u2192    @pytest.mark.parametrize(\n   934\u2192        (\"check\", \"expected\"),\n   935\u2192        [(True, True), (None, False), (False, False), ({}, True), (\"\", True), (\"check\", True)],\n   936\u2192    )\n   937\u2192    async def test_check_update_handling(self, app, check, expected):\n   938\u2192        class MyHandler(BaseHandler):\n   939\u2192            def check_update(self, update: object):\n   940\u2192                return check\n   941\u2192\n   942\u2192            async def handle_update(\n   943\u2192                _,\n   944\u2192                update,\n   945\u2192                application,\n   946\u2192                check_result,\n   947\u2192                context,\n   948\u2192            ):\n   949\u2192                await super().handle_update(\n   950\u2192                    update=update,\n   951\u2192                    application=application,\n   952\u2192                    check_result=check_result,\n   953\u2192                    context=context,\n   954\u2192                )\n   955\u2192                self.received = check_result\n   956\u2192\n   957\u2192        async with app:\n   958\u2192            app.add_handler(MyHandler(self.callback_increase_count))\n   959\u2192            await app.process_update(1)\n   960\u2192            assert self.count == (1 if expected else 0)\n   961\u2192            if expected:\n   962\u2192                assert self.received == check\n   963\u2192            else:\n   964\u2192                assert self.received is None\n   965\u2192\n   966\u2192    async def test_non_blocking_handler(self, app):\n   967\u2192        event = asyncio.Event()\n   968\u2192\n   969\u2192        async def callback(update, context):\n   970\u2192            await event.wait()\n   971\u2192            self.count = 42\n   972\u2192\n   973\u2192        app.add_handler(TypeHandler(object, callback, block=False))\n   974\u2192        app.add_handler(TypeHandler(object, self.callback_increase_count), group=1)\n   975\u2192\n   976\u2192        async with app:\n   977\u2192            await app.start()\n   978\u2192            await app.update_queue.put(1)\n   979\u2192            task = asyncio.create_task(app.stop())\n   980\u2192            await asyncio.sleep(0.05)\n   981\u2192            tasks = asyncio.all_tasks()\n   982\u2192            assert any(\":process_update_non_blocking\" in t.get_name() for t in tasks)\n   983\u2192            assert self.count == 1\n   984\u2192            # Make sure that app stops only once all non blocking callbacks are done\n   985\u2192            assert not task.done()\n   986\u2192            event.set()\n   987\u2192            await asyncio.sleep(0.05)\n   988\u2192            assert self.count == 42\n   989\u2192            assert task.done()\n   990\u2192\n   991\u2192    async def test_non_blocking_handler_applicationhandlerstop(self, app, recwarn):\n   992\u2192        async def callback(update, context):\n   993\u2192            raise ApplicationHandlerStop\n   994\u2192\n   995\u2192        app.add_handler(TypeHandler(object, callback, block=False))\n   996\u2192\n   997\u2192        async with app:\n   998\u2192            await app.start()\n   999\u2192            await app.update_queue.put(1)\n  1000\u2192            await asyncio.sleep(0.05)\n  1001\u2192            await app.stop()\n  1002\u2192\n  1003\u2192        assert len(recwarn) == 1\n  1004\u2192        assert recwarn[0].category is PTBUserWarning\n  1005\u2192        assert (\n  1006\u2192            str(recwarn[0].message)\n  1007\u2192            == \"ApplicationHandlerStop is not supported with handlers running non-blocking.\"\n  1008\u2192        )\n  1009\u2192        assert (\n  1010\u2192            Path(recwarn[0].filename) == PROJECT_ROOT_PATH / \"telegram\" / \"ext\" / \"_application.py\"\n  1011\u2192        ), \"incorrect stacklevel!\"\n  1012\u2192\n  1013\u2192    async def test_non_blocking_no_error_handler(self, app, caplog):\n  1014\u2192        app.add_handler(TypeHandler(object, self.callback_raise_error(\"Test error\"), block=False))\n  1015\u2192\n  1016\u2192        with caplog.at_level(logging.ERROR):\n  1017\u2192            async with app:\n  1018\u2192                await app.start()\n  1019\u2192                await app.update_queue.put(1)\n  1020\u2192                await asyncio.sleep(0.05)\n  1021\u2192                assert len(caplog.records) == 1\n  1022\u2192                assert (\n  1023\u2192                    caplog.records[-1].getMessage().startswith(\"No error handlers are registered\")\n  1024\u2192                )\n  1025\u2192                assert caplog.records[-1].name == \"telegram.ext.Application\"\n  1026\u2192                await app.stop()\n  1027\u2192\n  1028\u2192    @pytest.mark.parametrize(\"handler_block\", [True, False])\n  1029\u2192    async def test_non_blocking_error_handler(self, app, handler_block):\n  1030\u2192        event = asyncio.Event()\n  1031\u2192\n  1032\u2192        async def async_error_handler(update, context):\n  1033\u2192            await event.wait()\n  1034\u2192            self.received = \"done\"\n  1035\u2192\n  1036\u2192        async def normal_error_handler(update, context):\n  1037\u2192            self.count = 42\n  1038\u2192\n  1039\u2192        app.add_error_handler(async_error_handler, block=False)\n  1040\u2192        app.add_error_handler(normal_error_handler)\n  1041\u2192        app.add_handler(TypeHandler(object, self.callback_raise_error(\"err\"), block=handler_block))\n  1042\u2192\n  1043\u2192        async with app:\n  1044\u2192            await app.start()\n  1045\u2192            await app.update_queue.put(self.message_update)\n  1046\u2192            task = asyncio.create_task(app.stop())\n  1047\u2192            await asyncio.sleep(0.05)\n  1048\u2192            tasks = asyncio.all_tasks()\n  1049\u2192            assert any(\":process_error:non_blocking\" in t.get_name() for t in tasks)\n  1050\u2192            assert self.count == 42\n  1051\u2192            assert self.received is None\n  1052\u2192            event.set()\n  1053\u2192            await asyncio.sleep(0.05)\n  1054\u2192            assert self.received == \"done\"\n  1055\u2192            assert task.done()\n  1056\u2192\n  1057\u2192    @pytest.mark.parametrize(\"handler_block\", [True, False])\n  1058\u2192    async def test_non_blocking_error_handler_applicationhandlerstop(\n  1059\u2192        self, app, recwarn, handler_block\n  1060\u2192    ):\n  1061\u2192        async def callback(update, context):\n  1062\u2192            raise RuntimeError\n  1063\u2192\n  1064\u2192        async def error_handler(update, context):\n  1065\u2192            raise ApplicationHandlerStop\n  1066\u2192\n  1067\u2192        app.add_handler(TypeHandler(object, callback, block=handler_block))\n  1068\u2192        app.add_error_handler(error_handler, block=False)\n  1069\u2192\n  1070\u2192        async with app:\n  1071\u2192            await app.start()\n  1072\u2192            await app.update_queue.put(1)\n  1073\u2192            await asyncio.sleep(0.05)\n  1074\u2192            await app.stop()\n  1075\u2192\n  1076\u2192        assert len(recwarn) == 1\n  1077\u2192        assert recwarn[0].category is PTBUserWarning\n  1078\u2192        assert (\n  1079\u2192            str(recwarn[0].message)\n  1080\u2192            == \"ApplicationHandlerStop is not supported with handlers running non-blocking.\"\n  1081\u2192        )\n  1082\u2192        assert (\n  1083\u2192            Path(recwarn[0].filename) == PROJECT_ROOT_PATH / \"telegram\" / \"ext\" / \"_application.py\"\n  1084\u2192        ), \"incorrect stacklevel!\"\n  1085\u2192\n  1086\u2192    @pytest.mark.parametrize((\"block\", \"expected_output\"), [(False, 0), (True, 5)])\n  1087\u2192    async def test_default_block_error_handler(self, bot_info, block, expected_output):\n  1088\u2192        async def error_handler(*args, **kwargs):\n  1089\u2192            await asyncio.sleep(0.1)\n  1090\u2192            self.count = 5\n  1091\u2192\n  1092\u2192        bot = make_bot(bot_info, defaults=Defaults(block=block))\n  1093\u2192        app = Application.builder().bot(bot).build()\n  1094\u2192        async with app:\n  1095\u2192            app.add_handler(TypeHandler(object, self.callback_raise_error(\"error\")))\n  1096\u2192            app.add_error_handler(error_handler)\n  1097\u2192            await app.process_update(1)\n  1098\u2192            await asyncio.sleep(0.05)\n  1099\u2192            assert self.count == expected_output\n  1100\u2192            await asyncio.sleep(0.1)\n  1101\u2192            assert self.count == 5\n  1102\u2192\n  1103\u2192    @pytest.mark.parametrize((\"block\", \"expected_output\"), [(False, 0), (True, 5)])\n  1104\u2192    async def test_default_block_handler(self, bot_info, block, expected_output):\n  1105\u2192        bot = make_bot(bot_info, defaults=Defaults(block=block))\n  1106\u2192        app = Application.builder().bot(bot).build()\n  1107\u2192        async with app:\n  1108\u2192            app.add_handler(TypeHandler(object, self.callback_set_count(5, sleep=0.1)))\n  1109\u2192            await app.process_update(1)\n  1110\u2192            await asyncio.sleep(0.05)\n  1111\u2192            assert self.count == expected_output\n  1112\u2192            await asyncio.sleep(0.15)\n  1113\u2192            assert self.count == 5\n  1114\u2192\n  1115\u2192    @pytest.mark.parametrize(\"handler_block\", [True, False])\n  1116\u2192    @pytest.mark.parametrize(\"error_handler_block\", [True, False])\n  1117\u2192    async def test_nonblocking_handler_raises_and_non_blocking_error_handler_raises(\n  1118\u2192        self, app, caplog, handler_block, error_handler_block\n  1119\u2192    ):\n  1120\u2192        handler = TypeHandler(object, self.callback_raise_error(\"error\"), block=handler_block)\n  1121\u2192        app.add_handler(handler)\n  1122\u2192        app.add_error_handler(self.error_handler_raise_error, block=error_handler_block)\n  1123\u2192\n  1124\u2192        async with app:\n  1125\u2192            await app.start()\n  1126\u2192            with caplog.at_level(logging.ERROR):\n  1127\u2192                await app.update_queue.put(1)\n  1128\u2192                await asyncio.sleep(0.05)\n  1129\u2192                assert len(caplog.records) == 1\n  1130\u2192                assert caplog.records[-1].name == \"telegram.ext.Application\"\n  1131\u2192                assert (\n  1132\u2192                    caplog.records[-1]\n  1133\u2192                    .getMessage()\n  1134\u2192                    .startswith(\"An error was raised and an uncaught\")\n  1135\u2192                )\n  1136\u2192\n  1137\u2192            # Make sure that the main loop still runs\n  1138\u2192            app.remove_handler(handler)\n  1139\u2192            app.add_handler(MessageHandler(filters.ALL, self.callback_increase_count, block=True))\n  1140\u2192            await app.update_queue.put(self.message_update)\n  1141\u2192            await asyncio.sleep(0.05)\n  1142\u2192            assert self.count == 1\n  1143\u2192\n  1144\u2192            await app.stop()\n  1145\u2192\n  1146\u2192    @pytest.mark.parametrize(\n  1147\u2192        \"message\",\n  1148\u2192        [\n  1149\u2192            Message(message_id=1, chat=Chat(id=2, type=None), migrate_from_chat_id=1, date=None),\n  1150\u2192            Message(message_id=1, chat=Chat(id=1, type=None), migrate_to_chat_id=2, date=None),\n  1151\u2192            Message(message_id=1, chat=Chat(id=1, type=None), date=None),\n  1152\u2192            None,\n  1153\u2192        ],\n  1154\u2192    )\n  1155\u2192    @pytest.mark.parametrize(\"old_chat_id\", [None, 1, \"1\"])\n  1156\u2192    @pytest.mark.parametrize(\"new_chat_id\", [None, 2, \"1\"])\n  1157\u2192    def test_migrate_chat_data(self, app, message: \"Message\", old_chat_id: int, new_chat_id: int):\n  1158\u2192        def call(match: str):\n  1159\u2192            with pytest.raises(ValueError, match=match):\n  1160\u2192                app.migrate_chat_data(\n  1161\u2192                    message=message, old_chat_id=old_chat_id, new_chat_id=new_chat_id\n  1162\u2192                )\n  1163\u2192\n  1164\u2192        if message and (old_chat_id or new_chat_id):\n  1165\u2192            call(r\"^Message and chat_id pair are mutually exclusive$\")\n  1166\u2192            return\n  1167\u2192\n  1168\u2192        if not any((message, old_chat_id, new_chat_id)):\n  1169\u2192            call(r\"^chat_id pair or message must be passed$\")\n  1170\u2192            return\n  1171\u2192\n  1172\u2192        if message:\n  1173\u2192            if message.migrate_from_chat_id is None and message.migrate_to_chat_id is None:\n  1174\u2192                call(r\"^Invalid message instance\")\n  1175\u2192                return\n  1176\u2192            effective_old_chat_id = message.migrate_from_chat_id or message.chat.id\n  1177\u2192            effective_new_chat_id = message.migrate_to_chat_id or message.chat.id\n  1178\u2192\n  1179\u2192        elif not (isinstance(old_chat_id, int) and isinstance(new_chat_id, int)):\n  1180\u2192            call(r\"^old_chat_id and new_chat_id must be integers$\")\n  1181\u2192            return\n  1182\u2192        else:\n  1183\u2192            effective_old_chat_id = old_chat_id\n  1184\u2192            effective_new_chat_id = new_chat_id\n  1185\u2192\n  1186\u2192        app.chat_data[effective_old_chat_id][\"key\"] = \"test\"\n  1187\u2192        app.migrate_chat_data(message=message, old_chat_id=old_chat_id, new_chat_id=new_chat_id)\n  1188\u2192        assert effective_old_chat_id not in app.chat_data\n  1189\u2192        assert app.chat_data[effective_new_chat_id][\"key\"] == \"test\"\n  1190\u2192\n  1191\u2192    @pytest.mark.parametrize(\n  1192\u2192        (\"c_id\", \"expected\"),\n  1193\u2192        [(321, {222: \"remove_me\"}), (111, {321: {\"not_empty\": \"no\"}, 222: \"remove_me\"})],\n  1194\u2192        ids=[\"test chat_id removal\", \"test no key in data (no error)\"],\n  1195\u2192    )\n  1196\u2192    def test_drop_chat_data(self, app, c_id, expected):\n  1197\u2192        app._chat_data.update({321: {\"not_empty\": \"no\"}, 222: \"remove_me\"})\n  1198\u2192        app.drop_chat_data(c_id)\n  1199\u2192        assert app.chat_data == expected\n  1200\u2192\n  1201\u2192    @pytest.mark.parametrize(\n  1202\u2192        (\"u_id\", \"expected\"),\n  1203\u2192        [(321, {222: \"remove_me\"}), (111, {321: {\"not_empty\": \"no\"}, 222: \"remove_me\"})],\n  1204\u2192        ids=[\"test user_id removal\", \"test no key in data (no error)\"],\n  1205\u2192    )\n  1206\u2192    def test_drop_user_data(self, app, u_id, expected):\n  1207\u2192        app._user_data.update({321: {\"not_empty\": \"no\"}, 222: \"remove_me\"})\n  1208\u2192        app.drop_user_data(u_id)\n  1209\u2192        assert app.user_data == expected\n  1210\u2192\n  1211\u2192    async def test_create_task_basic(self, app):\n  1212\u2192        async def callback():\n  1213\u2192            await asyncio.sleep(0.05)\n  1214\u2192            self.count = 42\n  1215\u2192            return 43\n  1216\u2192\n  1217\u2192        task = app.create_task(callback(), name=\"test_task\")\n  1218\u2192        assert task.get_name() == \"test_task\"\n  1219\u2192        await asyncio.sleep(0.01)\n  1220\u2192        assert not task.done()\n  1221\u2192        out = await task\n  1222\u2192        assert task.done()\n  1223\u2192        assert self.count == 42\n  1224\u2192        assert out == 43\n  1225\u2192\n  1226\u2192    @pytest.mark.parametrize(\"running\", [True, False])\n  1227\u2192    async def test_create_task_awaiting_warning(self, app, running, recwarn):\n  1228\u2192        async def callback():\n  1229\u2192            await asyncio.sleep(0.1)\n  1230\u2192            return 43\n  1231\u2192\n  1232\u2192        async with app:\n  1233\u2192            if running:\n  1234\u2192                await app.start()\n  1235\u2192\n  1236\u2192            task = app.create_task(callback())\n  1237\u2192\n  1238\u2192            if running:\n  1239\u2192                assert len(recwarn) == 0\n  1240\u2192                assert not task.done()\n  1241\u2192                await app.stop()\n  1242\u2192                assert task.done()\n  1243\u2192                assert task.result() == 43\n  1244\u2192            else:\n  1245\u2192                assert len(recwarn) == 1\n  1246\u2192                assert recwarn[0].category is PTBUserWarning\n  1247\u2192                assert \"won't be automatically awaited\" in str(recwarn[0].message)\n  1248\u2192                assert recwarn[0].filename == __file__, \"wrong stacklevel!\"\n  1249\u2192                assert not task.done()\n  1250\u2192                await task\n  1251\u2192\n  1252\u2192    @pytest.mark.parametrize(\"update\", [None, object()])\n  1253\u2192    async def test_create_task_error_handling(self, app, update):\n  1254\u2192        exception = RuntimeError(\"TestError\")\n  1255\u2192\n  1256\u2192        async def callback():\n  1257\u2192            raise exception\n  1258\u2192\n  1259\u2192        async def error(update_arg, context):\n  1260\u2192            self.received = update_arg, context.error\n  1261\u2192\n  1262\u2192        app.add_error_handler(error)\n  1263\u2192        if update:\n  1264\u2192            task = app.create_task(callback(), update=update)\n  1265\u2192        else:\n  1266\u2192            task = app.create_task(callback())\n  1267\u2192\n  1268\u2192        with pytest.raises(RuntimeError, match=\"TestError\"):\n  1269\u2192            await task\n  1270\u2192        assert task.exception() is exception\n  1271\u2192        assert isinstance(self.received, tuple)\n  1272\u2192        assert self.received[0] is update\n  1273\u2192        assert self.received[1] is exception\n  1274\u2192\n  1275\u2192    async def test_create_task_cancel_task(self, app):\n  1276\u2192        async def callback():\n  1277\u2192            await asyncio.sleep(5)\n  1278\u2192\n  1279\u2192        async def error(update_arg, context):\n  1280\u2192            self.received = update_arg, context.error\n  1281\u2192\n  1282\u2192        app.add_error_handler(error)\n  1283\u2192        async with app:\n  1284\u2192            await app.start()\n  1285\u2192            task = app.create_task(callback())\n  1286\u2192            await asyncio.sleep(0.05)\n  1287\u2192            task.cancel()\n  1288\u2192\n  1289\u2192            with pytest.raises(asyncio.CancelledError):\n  1290\u2192                await task\n  1291\u2192            with pytest.raises(asyncio.CancelledError):\n  1292\u2192                assert task.exception()\n  1293\u2192\n  1294\u2192            # Error handlers should not be called if task was cancelled\n  1295\u2192            assert self.received is None\n  1296\u2192\n  1297\u2192            # make sure that the cancelled task doesn't block the stopping of the app\n  1298\u2192            await app.stop()\n  1299\u2192\n  1300\u2192    async def test_await_create_task_tasks_on_stop(self, app):\n  1301\u2192        event_1 = asyncio.Event()\n  1302\u2192        event_2 = asy