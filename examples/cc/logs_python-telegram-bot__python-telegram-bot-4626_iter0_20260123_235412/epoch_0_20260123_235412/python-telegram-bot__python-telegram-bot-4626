raceful shutdown\n  2122→        assert called_callbacks == {\n  2123→            \"app_initialize\",\n  2124→            \"updater_initialize\",\n  2125→            \"app_shutdown\",\n  2126→            \"post_shutdown\",\n  2127→            \"updater_shutdown\",\n  2128→        }\n  2129→\n  2130→    @pytest.mark.parametrize(\"exception\", [SystemExit(\"PTBTest\"), KeyboardInterrupt(\"PTBTest\")])\n  2131→    @pytest.mark.parametrize(\"kind\", [\"handler\", \"error_handler\", \"job\"])\n  2132→    # @pytest.mark.parametrize(\"block\", [True, False])\n  2133→    # Testing with block=False would be nice but that doesn't work well with pytest for some reason\n  2134→    # in any case, block=False is the simpler behavior since it is roughly similar to what happens\n  2135→    # when you hit CTRL+C in the commandline.\n  2136→    def test_raise_system_exit_keyboard_jobs_handlers(\n  2137→        self, one_time_bot, monkeypatch, exception, kind, caplog\n  2138→    ):\n  2139→        async def queue_and_raise(application):\n  2140→            await application.update_queue.put(\"will_not_be_processed\")\n  2141→            raise exception\n  2142→\n  2143→        async def handler_callback(update, context):\n  2144→            if kind == \"handler\":\n  2145→                await queue_and_raise(context.application)\n  2146→            elif kind == \"error_handler\":\n  2147→                raise TelegramError(\"Triggering error callback\")\n  2148→\n  2149→        async def error_callback(update, context):\n  2150→            await queue_and_raise(context.application)\n  2151→\n  2152→        async def job_callback(context):\n  2153→            await queue_and_raise(context.application)\n  2154→\n  2155→        async def enqueue_update():\n  2156→            await asyncio.sleep(0.5)\n  2157→            await app.update_queue.put(1)\n  2158→\n  2159→        async def post_init(application):\n  2160→            if kind == \"job\":\n  2161→                application.job_queue.run_once(when=0.5, callback=job_callback)\n  2162→            else:\n  2163→                app.create_task(enqueue_update())\n  2164→\n  2165→        async def update_logger_callback(update, context):\n  2166→            context.bot_data.setdefault(\"processed_updates\", set()).add(update)\n  2167→\n  2168→        called_callbacks = set()\n  2169→\n  2170→        async def callback(*args, **kwargs):\n  2171→            called_callbacks.add(kwargs[\"name\"])\n  2172→\n  2173→        for cls, method, entry in [\n  2174→            (Application, \"initialize\", \"app_initialize\"),\n  2175→            (Application, \"start\", \"app_start\"),\n  2176→            (Application, \"stop\", \"app_stop\"),\n  2177→            (Application, \"shutdown\", \"app_shutdown\"),\n  2178→            (Updater, \"initialize\", \"updater_initialize\"),\n  2179→            (Updater, \"shutdown\", \"updater_shutdown\"),\n  2180→            (Updater, \"stop\", \"updater_stop\"),\n  2181→            (Updater, \"start_polling\", \"updater_start_polling\"),\n  2182→        ]:\n  2183→\n  2184→            def after(_, name):\n  2185→                called_callbacks.add(name)\n  2186→\n  2187→            monkeypatch.setattr(\n  2188→                cls,\n  2189→                method,\n  2190→                call_after(getattr(cls, method), functools.partial(after, name=entry)),\n  2191→            )\n  2192→\n  2193→        app = (\n  2194→            ApplicationBuilder()\n  2195→            .bot(one_time_bot)\n  2196→            .post_init(post_init)\n  2197→            .post_stop(functools.partial(callback, name=\"post_stop\"))\n  2198→            .post_shutdown(functools.partial(callback, name=\"post_shutdown\"))\n  2199→            .build()\n  2200→        )\n  2201→        monkeypatch.setattr(app.bot, \"get_updates\", empty_get_updates)\n  2202→        monkeypatch.setattr(app.bot, \"delete_webhook\", return_true)\n  2203→\n  2204→        app.add_handler(TypeHandler(object, update_logger_callback), group=-10)\n  2205→        app.add_handler(TypeHandler(object, handler_callback))\n  2206→        app.add_error_handler(error_callback)\n  2207→        with caplog.at_level(logging.DEBUG):\n  2208→            app.run_polling(close_loop=False)\n  2209→\n  2210→        # This checks that we have a clean shutdown even when the user raises SystemExit\n  2211→        # or KeyboardInterrupt in a handler/error handler/job callback\n  2212→        assert called_callbacks == {\n  2213→            \"app_initialize\",\n  2214→            \"app_shutdown\",\n  2215→            \"app_start\",\n  2216→            \"app_stop\",\n  2217→            \"post_shutdown\",\n  2218→            \"post_stop\",\n  2219→            \"updater_initialize\",\n  2220→            \"updater_shutdown\",\n  2221→            \"updater_start_polling\",\n  2222→            \"updater_stop\",\n  2223→        }\n  2224→\n  2225→        # These next checks make sure that the update queue is properly cleaned even if there are\n  2226→        # still pending updates in the queue\n  2227→        # Unfortunately this is apparently extremely hard to get right with jobs, so we're\n  2228→        # skipping that case for the sake of simplicity\n  2229→        if kind == \"job\":\n  2230→            return\n  2231→\n  2232→        found = False\n  2233→        for record in caplog.records:\n  2234→            if record.getMessage() != \"Dropping pending update: will_not_be_processed\":\n  2235→                continue\n  2236→            assert record.name == \"telegram.ext.Application\"\n  2237→            assert record.levelno == logging.DEBUG\n  2238→            found = True\n  2239→        assert found, \"`Dropping pending updates` message not found in logs!\"\n  2240→        assert \"will_not_be_processed\" not in app.bot_data.get(\"processed_updates\", set())\n  2241→\n  2242→    def test_run_without_updater(self, one_time_bot):\n  2243→        app = ApplicationBuilder().bot(one_time_bot).updater(None).build()\n  2244→\n  2245→        with pytest.raises(RuntimeError, match=\"only available if the application has an Updater\"):\n  2246→            app.run_webhook()\n  2247→\n  2248→        with pytest.raises(RuntimeError, match=\"only available if the application has an Updater\"):\n  2249→            app.run_polling()\n  2250→\n  2251→    @pytest.mark.parametrize(\"method\", [\"start\", \"initialize\"])\n  2252→    @pytest.mark.filterwarnings(\"ignore::telegram.warnings.PTBUserWarning\")\n  2253→    def test_run_error_in_application(self, one_time_bot, monkeypatch, method):\n  2254→        shutdowns = []\n  2255→\n  2256→        async def raise_method(*args, **kwargs):\n  2257→            raise RuntimeError(\"Test Exception\")\n  2258→\n  2259→        def after_shutdown(name):\n  2260→            def _after_shutdown(*args, **kwargs):\n  2261→                shutdowns.append(name)\n  2262→\n  2263→            return _after_shutdown\n  2264→\n  2265→        monkeypatch.setattr(Application, method, raise_method)\n  2266→        monkeypatch.setattr(\n  2267→            Application,\n  2268→            \"shutdown\",\n  2269→            call_after(Application.shutdown, after_shutdown(\"application\")),\n  2270→        )\n  2271→        monkeypatch.setattr(\n  2272→            Updater, \"shutdown\", call_after(Updater.shutdown, after_shutdown(\"updater\"))\n  2273→        )\n  2274→        app = ApplicationBuilder().bot(one_time_bot).build()\n  2275→        monkeypatch.setattr(app.bot, \"delete_webhook\", return_true)\n  2276→        monkeypatch.setattr(app.bot, \"get_updates\", empty_get_updates)\n  2277→\n  2278→        with pytest.raises(RuntimeError, match=\"Test Exception\"):\n  2279→            app.run_polling(close_loop=False)\n  2280→\n  2281→        assert not app.running\n  2282→        assert not app.updater.running\n  2283→        if method == \"initialize\":\n  2284→            # If App.initialize fails, then App.shutdown pretty much does nothing, especially\n  2285→            # doesn't call Updater.shutdown.\n  2286→            assert set(shutdowns) == {\"application\"}\n  2287→        else:\n  2288→            assert set(shutdowns) == {\"application\", \"updater\"}\n  2289→\n  2290→    @pytest.mark.parametrize(\"method\", [\"start_polling\", \"start_webhook\"])\n  2291→    @pytest.mark.filterwarnings(\"ignore::telegram.warnings.PTBUserWarning\")\n  2292→    def test_run_error_in_updater(self, one_time_bot, monkeypatch, method):\n  2293→        shutdowns = []\n  2294→\n  2295→        async def raise_method(*args, **kwargs):\n  2296→            raise RuntimeError(\"Test Exception\")\n  2297→\n  2298→        def after_shutdown(name):\n  2299→            def _after_shutdown(*args, **kwargs):\n  2300→                shutdowns.append(name)\n  2301→\n  2302→            return _after_shutdown\n  2303→\n  2304→        monkeypatch.setattr(Updater, method, raise_method)\n  2305→        monkeypatch.setattr(\n  2306→            Application,\n  2307→            \"shutdown\",\n  2308→            call_after(Application.shutdown, after_shutdown(\"application\")),\n  2309→        )\n  2310→        monkeypatch.setattr(\n  2311→            Updater, \"shutdown\", call_after(Updater.shutdown, after_shutdown(\"updater\"))\n  2312→        )\n  2313→        app = ApplicationBuilder().bot(one_time_bot).build()\n  2314→        with pytest.raises(RuntimeError, match=\"Test Exception\"):  # noqa: PT012\n  2315→            if \"polling\" in method:\n  2316→                app.run_polling(close_loop=False)\n  2317→            else:\n  2318→                app.run_webhook(close_loop=False)\n  2319→\n  2320→        assert not app.running\n  2321→        assert not app.updater.running\n  2322→        assert set(shutdowns) == {\"application\", \"updater\"}\n  2323→\n  2324→    @pytest.mark.skipif(\n  2325→        platform.system() != \"Windows\",\n  2326→        reason=\"Only really relevant on windows\",\n  2327→    )\n  2328→    @pytest.mark.parametrize(\"method\", [\"start_polling\", \"start_webhook\"])\n  2329→    def test_run_stop_signal_warning_windows(self, one_time_bot, method, recwarn, monkeypatch):\n  2330→        async def raise_method(*args, **kwargs):\n  2331→            raise RuntimeError(\"Prevent Actually Running\")\n  2332→\n  2333→        monkeypatch.setattr(Application, \"initialize\", raise_method)\n  2334→        app = ApplicationBuilder().bot(one_time_bot).build()\n  2335→\n  2336→        with pytest.raises(RuntimeError, match=\"Prevent Actually Running\"):  # noqa: PT012\n  2337→            if \"polling\" in method:\n  2338→                app.run_polling(close_loop=False, stop_signals=(signal.SIGINT,))\n  2339→            else:\n  2340→                app.run_webhook(close_loop=False, stop_signals=(signal.SIGTERM,))\n  2341→\n  2342→        assert len(recwarn) >= 1\n  2343→        found = False\n  2344→        for record in recwarn:\n  2345→            print(record)\n  2346→            if str(record.message).startswith(\"Could not add signal handlers for the stop\"):\n  2347→                assert record.category is PTBUserWarning\n  2348→                assert record.filename == __file__, \"stacklevel is incorrect!\"\n  2349→                found = True\n  2350→        assert found\n  2351→\n  2352→        recwarn.clear()\n  2353→        with pytest.raises(RuntimeError, match=\"Prevent Actually Running\"):  # noqa: PT012\n  2354→            if \"polling\" in method:\n  2355→                app.run_polling(close_loop=False, stop_signals=None)\n  2356→            else:\n  2357→                app.run_webhook(close_loop=False, stop_signals=None)\n  2358→\n  2359→        for record in recwarn:\n  2360→            assert not str(record.message).startswith(\"Could not add signal handlers for the stop\")\n  2361→\n  2362→    @pytest.mark.flaky(3, 1)  # loop.call_later will error the test when a flood error is received\n  2363→    def test_signal_handlers(self, app, monkeypatch):\n  2364→        # this test should make sure that signal handlers are set by default on Linux + Mac,\n  2365→        # and not on Windows.\n  2366→\n  2367→        received_signals = []\n  2368→\n  2369→        def signal_handler_test(*args, **kwargs):\n  2370→            # args[0] is the signal, [1] the callback\n  2371→            received_signals.append(args[0])\n  2372→\n  2373→        loop = asyncio.get_event_loop()\n  2374→\n  2375→        monkeypatch.setattr(loop, \"add_signal_handler\", signal_handler_test)\n  2376→        monkeypatch.setattr(app.bot, \"get_updates\", empty_get_updates)\n  2377→\n  2378→        def abort_app():\n  2379→            raise SystemExit\n  2380→\n  2381→        loop.call_later(0.6, abort_app)\n  2382→\n  2383        app.run_polling(close_loop=False)\n  2384→\n  2385→        if platform.system() == \"Windows\":\n  2386→            assert received_signals == []\n  2387→        else:\n  2388→            assert received_signals == [signal.SIGINT, signal.SIGTERM, signal.SIGABRT]\n  2389→\n  2390→        received_signals.clear()\n  2391→        loop.call_later(0.8, abort_app)\n  2392→        app.run_webhook(port=49152, webhook_url=\"example.com\", close_loop=False)\n  2393→\n  2394→        if platform.system() == \"Windows\":\n  2395→            assert received_signals == []\n  2396→        else:\n  2397→            assert received_signals == [signal.SIGINT, signal.SIGTERM, signal.SIGABRT]\n  2398→\n  2399→    def test_stop_running_not_running(self, app, caplog):\n  2400→        with caplog.at_level(logging.DEBUG):\n  2401→            app.stop_running()\n  2402→\n  2403→        assert len(caplog.records) == 1\n  2404→        assert caplog.records[-1].name == \"telegram.ext.Application\"\n  2405→        assert caplog.records[-1].getMessage().endswith(\"`stop_running()` likely has no effect.\")\n  2406→\n  2407→    def test_stop_running_post_init(self, app, monkeypatch, caplog, one_time_bot):\n  2408→        async def post_init(app):\n  2409→            app.stop_running()\n  2410→\n  2411→        called_callbacks = []\n  2412→\n  2413→        async def callback(*args, **kwargs):\n  2414→            called_callbacks.append(kwargs[\"name\"])\n  2415→\n  2416→        monkeypatch.setattr(Application, \"start\", functools.partial(callback, name=\"start\"))\n  2417→        monkeypatch.setattr(\n  2418→            Updater, \"start_polling\", functools.partialmethod(callback, name=\"start_polling\")\n  2419→        )\n  2420→\n  2421→        app = (\n  2422→            ApplicationBuilder()\n  2423→            .bot(one_time_bot)\n  2424→            .post_init(post_init)\n  2425→            .post_stop(functools.partial(callback, name=\"post_stop\"))\n  2426→            .post_shutdown(functools.partial(callback, name=\"post_shutdown\"))\n  2427→            .build()\n  2428→        )\n  2429→\n  2430→        with caplog.at_level(logging.INFO):\n  2431→            app.run_polling(close_loop=False)\n  2432→\n  2433→        # The important part here is that start(_polling) are *not* called!\n  2434→        # post_stop must not be called either, since we never called stop()\n  2435→        assert called_callbacks == [\"post_shutdown\"]\n  2436→\n  2437→        assert len(caplog.records) == 1\n  2438→        assert caplog.records[-1].name == \"telegram.ext.Application\"\n  2439→        assert (\n  2440→            \"Application received stop signal via `stop_running`\"\n  2441→            in caplog.records[-1].getMessage()\n  2442→        )\n  2443→\n  2444→    @pytest.mark.parametrize(\"method\", [\"polling\", \"webhook\"])\n  2445→    def test_stop_running(self, one_time_bot, monkeypatch, method):\n  2446→        # asyncio.Event() seems to be hard to use across different threads (awaiting in main\n  2447→        # thread, setting in another thread), so we use threading.Event() instead.\n  2448→        # This requires the use of run_in_executor, but that's fine.\n  2449→        put_update_event = threading.Event()\n  24