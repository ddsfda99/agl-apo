92    return MockProcessor(5)\n    41\u2192\n    42\u2192\n    43\u2192class TestSimpleUpdateProcessor:\n    44\u2192    def test_slot_behaviour(self):\n    45\u2192        inst = SimpleUpdateProcessor(1)\n    46\u2192        for attr in inst.__slots__:\n    47\u2192            assert getattr(inst, attr, \"err\") != \"err\", f\"got extra slot '{attr}'\"\n    48\u2192        assert len(mro_slots(inst)) == len(set(mro_slots(inst))), \"duplicate slot\"\n    49\u2192\n    50\u2192    @pytest.mark.asyncio\n    51\u2192    async def test_current_concurrent_updates_property(self, mock_processor):\n    52\u2192        # Initially, there should be no updates being processed\n    53\u2192        assert mock_processor.current_concurrent_updates == 0\n    54\u2192\n    55\u2192        block_event = asyncio.Event()\n    56\u2192\n    57\u2192        async def callback():\n    58\u2192            await block_event.wait()\n    59\u2192\n    60\u2192        # Start more updates than allowed concurrently\n    61\u2192        count = mock_processor.max_concurrent_updates + 3\n    62\u2192        tasks = [\n    63\u2192            asyncio.create_task(mock_processor.process_update(update=_, coroutine=callback()))\n    64\u2192            for _ in range(count)\n    65\u2192        ]\n    66\u2192\n    67\u2192        # Give the event loop a moment so that the first batch acquires the semaphore\n    68\u2192        await asyncio.sleep(0.1)\n    69\u2192\n    70\u2192        # We should be saturated at max_concurrent_updates\n    71\u2192        assert (\n    72\u2192            mock_processor.current_concurrent_updates == mock_processor.max_concurrent_updates\n    73\u2192        )\n    74\u2192\n    75\u2192        # Release all tasks\n    76\u2192        block_event.set()\n    77\u2192        await asyncio.gather(*tasks)\n    78\u2192\n    79\u2192        # After completion, no updates should be processed\n    80\u2192        assert mock_processor.current_concurrent_updates == 0\n    8