 632→\n   633→        except Exception:\n   634→            self._running = False\n   635→            raise\n   636→\n   637→    async def stop(self) -> None:\n   638→        \"\"\"Stops the process after processing any pending updates or tasks created by\n   639→        :meth:`create_task`. Also stops :attr:`job_queue`, if set.\n   640→        Finally, calls :meth:`update_persistence` and :meth:`BasePersistence.flush` on\n   641→        :attr:`persistence`, if set.\n   642→\n   643→        Warning:\n   644→            Once this method is called, no more updates will be fetched from :attr:`update_queue`,\n   645→            even if it's not empty.\n   646→\n   647→        .. seealso::\n   648→            :meth:`start`\n   649→\n   650→        Note:\n   651→            * This does *not* stop :attr:`updater`. You need to either manually call\n   652→              :meth:`telegram.ext.Updater.stop` or use one of :meth:`run_polling` or\n   653→              :meth:`run_webhook`.\n   654→            * Does *not* call :attr:`post_stop` - that is only done by\n   655→              :meth:`run_polling` and :meth:`run_webhook`.\n   656→\n   657→        Raises:\n   658→            :exc:`RuntimeError`: If the application is not running.\n   659→        \"\"\"\n   660→        if not self.running:\n   661→            raise RuntimeError(\"This Application is not running!\")\n   662→\n   663→        self._running = False\n   664→        self.__stop_running_marker.clear()\n   665→        _LOGGER.info(\"Application is stopping. This might take a moment.\")\n   666→\n   667→        # Stop listening for new updates and handle all pending ones\n   668→        if self.__update_fetcher_task:\n   669→            if self.__update_fetcher_task.done():\n   670→                try:\n   671→                    self.__update_fetcher_task.result()\n   672→                except BaseException as exc:\n   673→                    _LOGGER.critical(\n   674→                        \"Fetching updates was