2        self.chat_data: Mapping[int, CD] = MappingProxyType(self._chat_data)\n   330\u2192\n   331\u2192        self.persistence: Optional[BasePersistence[UD, CD, BD]] = None\n   332\u2192        if persistence and not isinstance(persistence, BasePersistence):\n   333\u2192            raise TypeError(\"persistence must be based on telegram.ext.BasePersistence\")\n   334\u2192        self.persistence = persistence\n   335\u2192\n   336\u2192        # Some bookkeeping for persistence logic\n   337\u2192        self._chat_ids_to_be_updated_in_persistence: set[int] = set()\n   338\u2192        self._user_ids_to_be_updated_in_persistence: set[int] = set()\n   339\u2192        self._chat_ids_to_be_deleted_in_persistence: set[int] = set()\n   340\u2192        self._user_ids_to_be_deleted_in_persistence: set[int] = set()\n   341\u2192\n   342\u2192        # This attribute will hold references to the conversation dicts of all conversation\n   343\u2192        # handlers so that we can extract the changed states during `update_persistence`\n   344\u2192        self._conversation_handler_conversations: dict[\n   345\u2192            str, TrackingDict[ConversationKey, object]\n   346\u2192        ] = {}\n   347\u2192\n   348\u2192        # A number of low-level helpers for the internal logic\n   349\u2192        self._initialized = False\n   350\u2192        self._running = False\n   351\u2192        self._job_queue: JQ = job_queue\n   352\u2192        self.__update_fetcher_task: Optional[asyncio.Task] = None\n   353\u2192        self.__update_persistence_task: Optional[asyncio.Task] = None\n   354\u2192        self.__update_persistence_event = asyncio.Event()\n   355\u2192        self.__update_persistence_lock = asyncio.Lock()\n   356\u2192        self.__create_task_tasks: set[asyncio.Task] = set()  # Used for awaiting tasks upon exit\n   357\u2192        self.__stop_running_marker = asyncio.Event()\n   358\u2192\n   359\u2192    async def __aenter__(self: _AppType) -> _AppType:  # noqa: PYI019\n   360\u2192        \"\"\"|async_context_manager| :meth:`initializes <initialize>` the App.\n   361\u2192\n   362\u2192        Returns:\n   363\u2192            The initialized App instance.\n   364\u2192\n   365\u2192        Raises:\n   366\u2192            :exc:`Exception`: If an exception is raised during initialization, :meth:`shutdown`\n   367\u2192                is called in this case.\n   368\u2192        \"\"\"\n   369\u2192        try:\n   370\u2192            await self.initialize()\n   371\u2192        except Exception:\n   372\u2192            await self.shutdown()\n   373\u2192            raise\n   374\u2192        return self\n   375\u2192\n   376\u2192    async def __aexit__(\n   377\u2192        self,\n   378\u2192        exc_type: Optional[type[BaseException]],\n   379\u2192        exc_val: Optional[BaseException],\n   380\u2192        exc_tb: Optional[TracebackType],\n   381\u2192    ) -> None:\n   382\u2192        \"\"\"|async_context_manager| :meth:`shuts down <shutdown>` the App.\"\"\"\n   383\u2192        # Make sure not to return `True` so that exceptions are not suppressed\n   384\u2192        # https://docs.python.org/3/reference/datamodel.html?#object.__aexit__\n   385\u2192        await self.shutdown()\n   386\u2192\n   387\u2192    def __repr__(self) -> str:\n   388\u2192        \"\"\"Give a string representation of the application in the form ``Application[bot=...]``.\n   389\u2192\n   390\u2192        As this class doesn't implement :meth:`object.__str__`, the default implementation\n   391\u2192        will be used, which is equivalent to :meth:`__repr__`.\n   392\u2192\n   393\u2192        Returns:\n   394\u2192            :obj:`str`\n   395\u2192        \"\"\"\n   396\u2192        return build_repr_with_selected_attrs(self, bot=self.bot)\n   397\u2192\n   398\u2192    @property\n   399\u2192    def running(self) -> bool:\n   400\u2192        \"\"\":obj:`bool`: Indicates if this application is running.\n   401\u2192\n   402\u2192        .. seealso::\n   403\u2192            :meth:`start`, :meth:`stop`\n   404\u2192        \"\"\"\n   405\u2192        return self._running\n   406\u2192\n   407\u2192    @property\n   408\u2192    def concurrent_updates(self) -> int:\n   409\u2192        \"\"\":obj:`int`: The number of concurrent updates that will be processed in parallel. A\n   410\u2192        value of ``0`` indicates updates are *not* being processed concurrently.\n   411\u2192\n   412\u2192        .. versionchanged:: 20.4\n   413\u2192            This is now just a shortcut to :attr:`update_processor.max_concurrent_updates\n   414\u2192            <telegram.ext.BaseUpdateProcessor.max_concurrent_updates>`.\n   415\u2192\n   416\u2192        .. seealso:: :wiki:`Concurrency`\n   417\u2192        \"\"\"\n   418\u2192        return self._update_processor.max_concurrent_updates\n   419\u2192\n   420\u2192    @property\n   421\u2192    def job_queue(self) -> Optional[\"JobQueue[CCT]\"]:\n   422\u2192        \"\"\"\n   423\u2192        :class:`telegram.ext.JobQueue`: The :class:`JobQueue` used by the\n   424\u2192            :class:`telegram.ext.Application`.\n   425\u2192\n   426\u2192        .. seealso:: :wiki:`Job Queue <Extensions---JobQueue>`\n   427\u2192        \"\"\"\n   428\u2192        if self._job_queue is None:\n   429\u2192            warn(\n   430\u2192                \"No `JobQueue` set up. To use `JobQueue`, you must install PTB via \"\n   431\u2192                '`pip install \"python-telegram-bot[job-queue]\"`.',\n   432\u2192                stacklevel=2,\n   433\u2192            )\n   434\u2192        return self._job_queue\n   435\u2192\n   436\u2192    @property\n   437\u2192    def update_processor(self) -> \"BaseUpdateProcessor\":\n   438\u2192        \"\"\":class:`telegram.ext.BaseUpdateProcessor`: The update processor used by this\n   439\u2192        application.\n   440\u2192\n   441\u2192        .. seealso:: :wiki:`Concurrency`\n   442\u2192\n   443\u2192        .. versionadded:: 20.4\n   444\u2192        \"\"\"\n   445\u2192        return self._update_processor\n   446\u2192\n   447\u2192    @staticmethod\n   448\u2192    def _raise_system_exit() -> NoReturn:\n   449\u2192        raise SystemExit\n   450\u2192\n   451\u2192    @staticmethod\n   452\u2192    def builder() -> \"InitApplicationBuilder\":\n   453\u2192        \"\"\"Convenience method. Returns a new :class:`telegram.ext.ApplicationBuilder`.\n   454\u2192\n   455\u2192        .. versionadded:: 20.0\n   456\u2192        \"\"\"\n   457\u2192        # Unfortunately this needs to be here due to cyclical imports\n   458\u2192        from telegram.ext import ApplicationBuilder  # pylint: disable=import-outside-toplevel\n   459\u2192\n   460\u2192        return ApplicationBuilder()\n   461\u2192\n   462\u2192    def _check_initialized(self) -> None:\n   463\u2192        if not self._initialized:\n   464\u2192            raise RuntimeError(\n   465\u2192                \"This Application was not initialized via `Application.initialize`!\"\n   466\u2192            )\n   467\u2192\n   468\u2192    async def initialize(self) -> None:\n   469\u2192        \"\"\"Initializes the Application by initializing:\n   470\u2192\n   471\u2192        * The :attr:`bot`, by calling :meth:`telegram.Bot.initialize`.\n   472\u2192        * The :attr:`updater`, by calling :meth:`telegram.ext.Updater.initialize`.\n   473\u2192        * The :attr:`persistence`, by loading persistent conversations and data.\n   474\u2192        * The :attr:`update_processor` by calling\n   475\u2192          :meth:`telegram.ext.BaseUpdateProcessor.initialize`.\n   476\u2192\n   477\u2192        Does *not* call :attr:`post_init` - that is only done by :meth:`run_polling` and\n   478\u2192        :meth:`run_webhook`.\n   479\u2192\n   480\u2192        .. seealso::\n   481\u2192            :meth:`shutdown`\n   482\u2192        \"\"\"\n   483\u2192        if self._initialized:\n   484\u2192            _LOGGER.debug(\"This Application is already initialized.\")\n   485\u2192            return\n   486\u2192\n   487\u2192        await self.bot.initialize()\n   488\u2192        await self._update_processor.initialize()\n   489\u2192\n   490\u2192        if self.updater:\n   491\u2192            await self.updater.initialize()\n   492\u2192\n   493\u2192        if not self.persistence:\n   494\u2192            self._initialized = True\n   495\u2192            return\n   496\u2192\n   497\u2192        await self._initialize_persistence()\n   498\u2192\n   499\u2192        # Unfortunately due to circular imports this has to be here\n   500\u2192        # pylint: disable=import-outside-toplevel\n   501\u2192        from telegram.ext._handlers.conversationhandler import ConversationHandler\n   502\u2192\n   503\u2192        # Initialize the persistent conversation handlers with the stored states\n   504\u2192        for handler in itertools.chain.from_iterable(self.handlers.values()):\n   505\u2192            if isinstance(handler, ConversationHandler) and handler.persistent and handler.name:\n   506\u2192                await self._add_ch_to_persistence(handler)\n   507\u2192\n   508\u2192        self._initialized = True\n   509\u2192        self.__stop_running_marker.clear()\n   510\u2192\n   511\u2192    async def _add_ch_to_persistence(self, handler: \"ConversationHandler\") -> None:\n   512\u2192        self._conversation_handler_conversations.update(\n   513\u2192            await handler._initialize_persistence(self)  # pylint: disable=protected-access\n   514\u2192        )\n   515\u2192\n   516\u2192    async def shutdown(self) -> None:\n   517\u2192        \"\"\"Shuts down the Application by shutting down:\n   518\u2192\n   519\u2192        * :attr:`bot` by calling :meth:`telegram.Bot.shutdown`\n   520\u2192        * :attr:`updater` by calling :meth:`telegram.ext.Updater.shutdown`\n   521\u2192        * :attr:`persistence` by calling :meth:`update_persistence` and\n   522\u2192          :meth:`BasePersistence.flush`\n   523\u2192        * :attr:`update_processor` by calling :meth:`telegram.ext.BaseUpdateProcessor.shutdown`\n   524\u2192\n   525\u2192        Does *not* call :attr:`post_shutdown` - that is only done by :meth:`run_polling` and\n   526\u2192        :meth:`run_webhook`.\n   527\u2192\n   528\u2192        .. seealso::\n   529\u2192            :meth:`initialize`\n   530\u2192\n   531\u2192        Raises:\n   532\u2192            :exc:`RuntimeError`: If the application is still :attr:`running`.\n   533\u2192        \"\"\"\n   534\u2192        if self.running:\n   535\u2192            raise RuntimeError(\"This Application is still running!\")\n   536\u2192\n   537\u2192        if not self._initialized:\n   538\u2192            _LOGGER.debug(\"This Application is already shut down. Returning.\")\n   539\u2192            return\n   540\u2192\n   541\u2192        await self.bot.shutdown()\n   542\u2192        await self._update_processor.shutdown()\n   543\u2192\n   544\u2192        if self.updater:\n   545\u2192            await self.updater.shutdown()\n   546\u2192\n   547\u2192        if self.persistence:\n   548\u2192            _LOGGER.debug(\"Updating & flushing persistence before shutdown\")\n   549\u2192            await self.update_persistence()\n   550\u2192            await self.persistence.flush()\n   551\u2192            _LOGGER.debug(\"Updated and flushed persistence\")\n   552\u2192\n   553\u2192        self._initialized = False\n   554\u2192\n   555\u2192    async def _initialize_persistence(self) -> None:\n   556\u2192        \"\"\"This method basically just loads all the data by awaiting the BP methods\"\"\"\n   557\u2192        if not self.persistence:\n   558\u2192            return\n   559\u2192\n   560\u2192        if self.persistence.store_data.user_data:\n   561\u2192            self._user_data.update(await self.persistence.get_user_data())\n   562\u2192        if self.persistence.store_data.cha