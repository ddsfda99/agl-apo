    loop.close()\n  1100→\n  1101→    def create_task(\n  1102→        self,\n  1103→        coroutine: _CoroType[RT],\n  1104→        update: Optional[object] = None,\n  1105→        *,\n  1106→        name: Optional[str] = None,\n  1107→    ) -> \"asyncio.Task[RT]\":\n  1108→        \"\"\"Thin wrapper around :func:`asyncio.create_task` that handles exceptions raised by\n  1109→        the :paramref:`coroutine` with :meth:`process_error`.\n  1110→\n  1111→        Note:\n  1112→            * If :paramref:`coroutine` raises an exception, it will be set on the task created by\n  1113→              this method even though it's handled by :meth:`process_error`.\n  1114→            * If the application is currently running, tasks created by this method will be\n  1115→              awaited with :meth:`stop`.\n  1116→\n  1117→        .. seealso:: :wiki:`Concurrency`\n  1118→\n  1119→        Args:\n  1120→            coroutine (:term:`awaitable`): The awaitable to run as task.\n  1121→\n  1122→                .. versionchanged:: 20.2\n  1123→                    Accepts :class:`asyncio.Future` and generator-based coroutine functions.\n  1124→                .. deprecated:: 20.4\n  1125→                    Since Python 3.12, generator-based coroutine functions are no longer accepted.\n  1126→            update (:obj:`object`, optional): If set, will be passed to :meth:`process_error`\n  1127→                as additional information for the error handlers. Moreover, the corresponding\n  1128→                :attr:`chat_data` and :attr:`user_data` entries will be updated in the next run of\n  1129→                :meth:`update_persistence` after the :paramref:`coroutine` is finished.\n  1130→\n  1131→        Keyword Args:\n  1132→            name (:obj:`str`, optional): The name of the task.\n  1133→\n  1134→                .. versionadded:: 20.4\n  1135→\n  1136→        Returns:\n  1137→            :class:`asyncio.Task`: The created task.\n  1138→        \"\"\"\n  1139→        return self.__create_task(coroutine=coroutine, update=update, name=name)\n  1140→\n  1141→    def __create_task(\n  1142→        self,\n  1143→        coroutine: _CoroType[RT],\n  1144→        update: Optional[object] = None,\n  1145→        is_error_handler: bool = False,\n  1146→        name: Optional[str] = None,\n  1147→    ) -> \"asyncio.Task[RT]\":\n  1148→        # Unfortunately, we can't know if `coroutine` runs one of the error handler functions\n  1149→        # but by passing `is_error_handler=True` from `process_error`, we can make sure that we\n  1150→        # get at most one recursion of the user calls `create_task` manually with an error handler\n  1151→        # function\n  1152→        task: asyncio.Task[RT] = asyncio.create_task(\n  1153→            self.__create_task_callback(\n  1154→                coroutine=coroutine, update=update, is_error_handler=is_error_handler\n  1155→            ),\n  1156→            name=name,\n  1157→        )\n  1158→\n  1159→        if self.running:\n  1160→            self.__create_task_tasks.add(task)\n  1161→            task.add_done_callback(self.__create_task_done_callback)\n  1162→        else:\n  1163→            warn(\n  1164→                \"Tasks created via `Application.create_task` while the application is not \"\n  1165→                \"running won't be automatically awaited!\",\n  1166→                stacklevel=3,\n  1167→            )\n  1168→\n  1169→        return task\n  1170→\n  1171→    def __create_task_done_callback(self, task: asyncio.Task) -> None:\n  1172→        self.__create_task_tasks.discard(task)  # Discard from our set since we are done with it\n  1173→        # We just retrieve the eventual exception so that asyncio doesn't complain in case\n  1174→        # it's not retrieved somewhere else\n  1175→        with contextlib.suppress(asyncio.CancelledError, asyncio.InvalidStateError):\n  1176→            task.exception()\n  1177→\n  1178→    async def __create_task_callback(\n  1179→        self,\n  1180→        coroutine: _CoroType[RT],\n  1181→        update: Optional[object] = None,\n  1182→        is_error_handler: bool = False,\n  1183→    ) -> RT:\n  1184→        try:\n  1185→            # Generator-based coroutines are not supported in Python 3.12+\n  1186→            if sys.version_info < (3, 12) and isinstance(coroutine, Generator):\n  1187→                warn(\n  1188→                    PTBDeprecationWarning(\n  1189→                        \"20.4\",\n  1190→                        \"Generator-based coroutines are deprecated in create_task and will not\"\n  1191→                        \" work in Python 3.12+\",\n  1192→                    ),\n  1193→                )\n  1194→                return await asyncio.create_task(coroutine)\n  1195→            # If user uses generator in python 3.12+, Exception will happen and we cannot do\n  1196→            # anything about it. (hence the type ignore if mypy is run on python 3.12-)\n  1197→            return await coroutine  # type: ignore[misc]\n  1198→        except Exception as exception:\n  1199→            if isinstance(exception, ApplicationHandlerStop):\n  1200→                warn(\n  1201→                    \"ApplicationHandlerStop is not supported with handlers running non-blocking.\",\n  1202→                    stacklevel=1,\n  1203→                )\n  1204→\n  1205→            # Avoid infinite recursion of error handlers.\n  1206→            elif is_error_handler:\n  1207→                _LOGGER.exception(\n  1208→                    \"An error was raised and an uncaught error was raised while \"\n  1209→                    \"handling the error with an error_handler.\",\n  1210→                    exc_info=exception,\n  1211→                )\n  1212→\n  1213→            else:\n  1214→                # If we arrive here, an exception happened in the task and was neither\n  1215→                # ApplicationHandlerStop nor raised by an error handler.\n  1216→                # So we can and must handle it\n  1217→                await self.process_error(update=update, error=exception, coroutine=coroutine)\n  1218→\n  1219→            # Raise exception so that it can be set on the task and retrieved by task.exception()\n  1220→            raise\n  1221→        finally:\n  1222→            self._mark_for_persistence_update(update=update)\n  1223→\n  1224→    async def __update_fetcher(self) -> None:\n  1225→        # Continuously fetch updates from the queue. Exit only once the signal object is found.\n  1226→        while True:\n  1227→            update = await self.update_queue.get()\n  1228→\n  1229→            if update is _STOP_SIGNAL:\n  1230→                # For the _STOP_SIGNAL\n  1231→                self.update_queue.task_done()\n  1232→                return\n  1233→\n  1234→            _LOGGER.debug(\"Processing update %s\", update)\n  1235→\n  1236→            if self._update_processor.max_concurrent_updates > 1:\n  1237→                # We don't await the below because it has to be run concurrently\n  1238→                self.create_task(\n  1239→                    self.__process_update_wrapper(update),\n  1240→                    update=update,\n  1241→                    name=f\"Application:{self.bot.id}:process_concurrent_update\",\n  1242→                )\n  1243→            else:\n  1244→                await self.__process_update_wrapper(update)\n  1245→\n  1246→    async def _update_fetcher(self) -> None:\n  1247→        try:\n  1248→            await self.__update_fetcher()\n  1249→        finally:\n  1250→            while not self.update_queue.empty():\n  1251→                _LOGGER.debug(\"Dropping pending update: %s\", self.update_queue.get_nowait())\n  1252→                with contextlib.suppress(ValueError):\n  1253→                    # Since we're shutting down here, it's not too bad if we call task_done\n  1254→                    # on an empty queue\n  1255→                    self.update_queue.task_done()\n  1256→\n  1257→    async def __process_update_wrapper(self, update: object) -> None:\n  1258→        try:\n  1259→            await self._update_processor.process_update(update, self.process_update(update))\n  1260→        finally:\n  1261→            self.update_queue.task_done()\n  1262→\n  1263→    async def process_update(self, update: object) -> None:\n  1264→        \"\"\"Processes a single update and marks the update to be updated by the persistence later.\n  1265→        Exceptions raised by handler callbacks will be processed by :meth:`process_error`.\n  1266→\n  1267→        .. seealso:: :wiki:`Concurrency`\n  1268→\n  1269→        .. versionchanged:: 20.0\n  1270→            Persistence is now updated in an interval set by\n  1271→            :attr:`telegram.ext.BasePersistence.update_interval`.\n  1272→\n  1273→        Args:\n  1274→            update (:class:`telegram.Update` | :obj:`object` | \\\n  1275→                :class:`telegram.error.TelegramError`): The update to process.\n  1276→\n  1277→        Raises:\n  1278→            :exc:`RuntimeError`: If the application was not initialized.\n  1279→        \"\"\"\n  1280→        # Processing updates before initialize() is a problem e.g. if persistence is used\n  1281→        self._check_initialized()\n  1282→\n  1283→        context = None\n  1284→        any_blocking = False  # Flag which is set to True if any handler specifies block=True\n  1285→\n  1286→        for handlers in self.handlers.values():\n  1287→            try:\n  1288→                for handler in handlers:\n  1289→                    check = handler.check_update(update)  # Should the handler handle this update?\n  1290→                    if check is None or check is False:\n  1291→                        continue\n  1292→\n  1293→                    if not context:  # build a context if not already built\n  1294→                        try:\n  1295→                            context = self.context_types.context.from_update(update, self)\n  1296→                        except Exception as exc:\n  1297→                            _LOGGER.critical(\n  1298→                                (\n  1299→                                    \"Error while building CallbackContext for update %s. \"\n  1300→                                    \"Update will not be processed.\"\n  1301→                                ),\n  1302→                                update,\n  1303→                                exc_info=exc,\n  1304→                            )\n  1305→                            return\n  1306→                        await context.refresh_data()\n  1307→                    coroutine: Coroutine = handler.handle_update(update, self, check, context)\n  1308→\n  1309→                    if not handler.block or (  # if handler is running with block=False,\n  1310→                        handler.block is DEFAULT_TRUE\n  1311→                        and isinstance(self.bot, ExtBot)\n  1312→                        and self.bot.defaults\n  1313→                        and not self.bot.defaults.block\n  1314→                    ):\n  1315→                        self.create_task(\n  1316→                            coroutine,\n  1317→                            update=update,\n  1318→                            name=(\n  1319→                                f\"Application:{self.bot.id}:process_update_non_blocking\"\n  1320→                                f\":{handler}\"\n  1321→                            ),\n  1322→                        )\n  1323→                    else:\n  1324→                        any_blocking = True\n  1325→                        await coroutine\n  1326→                    break  # Only a max of 1 handler per group is handled\n  1327→\n  1328→            # Stop processing with any other handler.\n  1329→            except ApplicationHandlerStop:\n  1330→                _LOGGER.debug(\"Stopping further handlers due to ApplicationHandlerStop\")\n  1331→                break\n  1332→\n  1333→            # Dispatch any error.\n  1334→            except Exception as exc:\n  1335→                if await self.process_error(update=update, error=exc):\n  1336→                    _LOGGER.debug(\"Error handler stopped further handlers.\")\n  1337→                    break\n  1338→\n  1339→        if any_blocking:\n  1340→            # Only need to mark the update for persistence if there was at least one\n  1341→            # blocking handler - the non-blocking handlers mark the update again when finished\n  1342→            # (in __create_task_callback)\n  1343→            self._mark_for_persistence_update(update=update)\n  1344→\n  1345→    def add_handler(self, handler: BaseHandler[Any, CCT, Any], group: int = DEFAULT_GROUP) -> None:\n  1346→        \"\"\"Register a handler.\n  1347→\n  1348→        TL;DR: Order and priority counts. 0 or 1 handlers per group will be used. End handling of\n  1349→        update with :class:`telegram.ext.ApplicationHandlerStop`.\n  1350→\n  1351→        A handler must be an instance of a subclass of :class:`telegram.ext.BaseHandler`. All\n  1352→        handlers\n  1353→        are organized in groups with a numeric value. The default group is 0. All groups will be\n  1354→        evaluated for handling an update, but only 0 or 1 handler per group will be used. If\n  1355→        :class:`telegram.ext.ApplicationHandlerStop` is raised from one of the handlers, no further\n  1356→        handlers (regardless of the group) will be called.\n  1357→\n  1358→        The priority/order of handlers is determined as follows:\n  1359→\n  1360→        * Priority of the group (lower group number == higher priority)\n  1361→        * The first handler in a group which can handle an update (see\n  1362→          :attr:`telegram.ext.BaseHandler.check_update`) will be used. Other handlers from the\n  1363→          group will not be used. The order in which handlers were added to the group defines the\n  1364→          priority.\n  1365→\n  1366→        Warning:\n  1367→            Adding persistent :class:`telegram.ext.ConversationHandler` after the application has\n  1368→            been initialized is discouraged. This is because the persisted conversation states need\n  1369→            to be loaded into memory while the application is already processing updates, which\n  1370→            might lead to race conditions and undesired behavior. In particular, current\n  1371→            conversation states may be overridden by the loaded data.\n  1372→\n  1373→        Args:\n  1374→            handler (:class:`telegram.ext.BaseHandler`): A BaseHandler instance.\n  1375→            group (:obj:`int`, optional): The group identifier. Default is ``0``.\n  1376→\n  1377→        \"\"\"\n  1378→        # Unfortunately due to circular imports this has to be here\n  1379→        # pylint: disable=import-outside-toplevel\n  1380→        from telegram.ext._handlers.conversationhandler import ConversationHandler\n  1381→\n  1382→        if not isinstance(handler, BaseHandler):\n  1383→            raise TypeError(f\"handler is not an instance of {BaseHandler.__name__}\")\n  1384→        if not isinstance(group, int):\n  1385→            raise TypeError(\"group is not int\")\n  1386→        if isinstance(handler, ConversationHandler) and handler.persistent and handler.name:\n  1387→            if not self.persistence:\n  1388→                raise ValueError(\n  1389→                    f\"ConversationHandler {handler.name} \"\n  1390→                    \"can not be persistent if application has no persistence\"\n  1391→                )\n  1392→            if self._initialized:\n  1393→                self.create_task(\n  1394→                    self._add_ch_to_persistence(handler),\n  1395→                    name=f\"Application:{self.bot.id}:add_handler:conversation_handler_after_init\",\n  1396→                )\n  1397→                warn(\n  1398→                    \"A persistent `ConversationHandler` was passed to `add_handler`, \"\n  1399→                    \"after `Application.initialize` was called. This is discouraged.\"\n  1400→                    \"See the docs of `Application.add_handler` for details.\",\n  1401→                    stacklevel=2,\n  1402→                )\n  1403→\n  1404→        if group not in self.handlers:\n  1405→            self.handlers[group] = []\n  1406→            self.handlers = dict(sorted(self.handlers.items()))  # lower -> higher groups\n  1407→\n  1408→        self.handlers[group].append(handler)\n  1409→\n  1410→    def add_handlers(\n  1411→        self,\n  1412→        handlers: Union[\n  1413→            Sequence[BaseHandler[Any, CCT, Any]],\n  1414→            dict[int, Sequence[BaseHandler[Any, CCT, Any]]],\n  1415→        ],\n  1416→        group: Union[int, DefaultValue[int]] = _DEFAULT_0,\n  1417→    ) -> None:\n  1418→        \"\"\"Registers multiple handlers at once. The order of the handlers in the passed\n  1419→        sequence(s) matters. See :meth:`add_handler` for details.\n  1420→\n  1421→        .. versionadded:: 20.0\n  1422→\n  1423→        Args:\n  1424→            handlers (Sequence[:class:`telegram.ext.BaseHandler`] | \\\n  1425→                dict[int, Sequence[:class:`telegram.ext.BaseHandler`]]):\n  1426→                Specify a sequence of handlers *or* a dictionary where the keys are groups and\n  1427→                values are handlers.\n  1428→\n  1429→                .. versionchanged:: 21.7\n  1430→                    Accepts any :class:`collections.abc.Sequence` as input instead of just a list\n  1431→                    or tuple.\n  1432→\n  1433→            group (:obj:`int`, optional): Specify which group the sequence of :paramref:`handlers`\n  1434→                should be added to. Defaults to ``0``.\n  1435→\n  1436→        Example::\n  1437→\n  1438→            app.add_handlers(handlers={\n  1439→                -1: [MessageHandler(...)],\n  1440→                1: [CallbackQueryHandler(...), CommandHandler(...)]\n  1441→            }\n  1442→\n  1443→        Raises:\n  1444→            :exc:`TypeError`: If the combination of arguments is invalid.\n  1445→        \"\"\"\n  1446→        if isinstance(handlers, dict) and not isinstance(group, DefaultValue):\n  1447→            raise TypeError(\"The `group` argument can only be used with a sequence of handlers.\")\n  1448→\n  1449→        if isinstance(handlers, dict):\n  1450→            for handler_group, grp_handlers in handlers.items():\n  1451→                if not isinstance(grp_handlers, Sequence):\n  1452→                    raise TypeError(\n  1453→                        f\"Handlers for group {handler_group} must be a sequence of handlers.\"\n  1454→                    )\n  1455→\n  1456→                for handler in grp_handlers:\n  1457→                    self.add_handler(handler, handler_group)\n  1458→\n  1459→        elif isinstance(handlers, Sequence):\n  1460→            for handler in handlers:\n  1461→                self.add_handler(handler, DefaultValue.get_value(group))\n  1462→\n  1463→        else:\n  1464→            raise TypeError(\n  1465→                \"The `handlers` argument must be a sequence of handlers or a \"\n  1466→                \"dictionary where the keys are groups and values are sequences of handlers.\"\n  1467→            )\n  1468→\n  1469→    def remove_handler(\n  1470→        self, handler: BaseHandler[Any, CCT, Any], group: int = DEFAULT_GROUP\n  1471→    ) -> None:\n  1472→        \"\"\"Remove a handler from the specified group.\n  1473→\n  1474→        Args:\n  1475→            handler (:class:`telegram.ext.BaseHandler`): A :class:`telegram.ext.BaseHandler`\n  1476→                instance.\n  1477→            group (:obj:`object`, optional): The group identifier. Default is ``0``.\n  1478→\n  1479→        \"\"\"\n  1480→        if handler in self.handlers[group]:\n  1481→            self.handlers[group].rem