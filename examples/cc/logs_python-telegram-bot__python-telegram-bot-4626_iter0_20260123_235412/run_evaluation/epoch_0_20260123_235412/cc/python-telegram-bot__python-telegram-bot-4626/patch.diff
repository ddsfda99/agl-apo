+    @pytest.mark.asyncio
+    async def test_current_concurrent_updates_property(self, mock_processor):
+        # Initially, there should be no updates being processed
+        assert mock_processor.current_concurrent_updates == 0
+
+        block_event = asyncio.Event()
+
+        async def callback():
+            await block_event.wait()
+
+        # Start more updates than allowed concurrently
+        count = mock_processor.max_concurrent_updates + 3
+        tasks = [
+            asyncio.create_task(mock_processor.process_update(update=_, coroutine=callback()))
+            for _ in range(count)
+        ]
+
+        # Give the event loop a moment so that the first batch acquires the semaphore
+        await asyncio.sleep(0.1)
+
+        # We should be saturated at max_concurrent_updates
+        assert (
+            mock_processor.current_concurrent_updates == mock_processor.max_concurrent_updates
+        )
+
+        # Release all tasks
+        block_event.set()
+        await asyncio.gather(*tasks)
+
+        # After completion, no updates should be processed
+        assert mock_processor.current_concurrent_updates == 0
+
