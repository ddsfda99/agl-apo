+    @property
+    def current_concurrent_updates(self) -> int:
+        """:obj:`int`: The number of updates currently being processed concurrently.
+        This is computed based on the internal semaphore's current value.
+
+        .. versionadded:: 21.x
+        """
+        # BoundedSemaphore initializes with "max_concurrent_updates" permits.
+        # Each ongoing update acquires one permit. So the number of currently
+        # processing updates is (max - current_value).
+        return self.max_concurrent_updates - self._semaphore._value  # type: ignore[attr-defined]
