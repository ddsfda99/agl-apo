                        "content": "     1\u2192\"\"\"The main Reflex app.\"\"\"\n     2\u2192\n     3\u2192from __future__ import annotations\n     4\u2192\n     5\u2192import asyncio\n     6\u2192import concurrent.futures\n     7\u2192import contextlib\n     8\u2192import copy\n     9\u2192import functools\n    10\u2192import io\n    11\u2192import multiprocessing\n    12\u2192import os\n    13\u2192import platform\n    14\u2192from typing import (\n    15\u2192    Any,\n    16\u2192    AsyncIterator,\n    17\u2192    Callable,\n    18\u2192    Coroutine,\n    19\u2192    Dict,\n    20\u2192    List,\n    21\u2192    Optional,\n    22\u2192    Set,\n    23\u2192    Type,\n    24\u2192    Union,\n    25\u2192    get_args,\n    26\u2192    get_type_hints,\n    27\u2192)\n    28\u2192\n    29\u2192from fastapi import FastAPI, HTTPException, Request, UploadFile\n    30\u2192from fastapi.middleware import cors\n    31\u2192from fastapi.responses import StreamingResponse\n    32\u2192from fastapi.staticfiles import StaticFiles\n    33\u2192from rich.progress import MofNCompleteColumn, Progress, TimeElapsedColumn\n    34\u2192from socketio import ASGIApp, AsyncNamespace, AsyncServer\n    35\u2192from starlette_admin.contrib.sqla.admin import Admin\n    36\u2192from starlette_admin.contrib.sqla.view import ModelView\n    37\u2192\n    38\u2192from reflex import constants\n    39\u2192from reflex.admin import AdminDash\n    40\u2192from reflex.base import Base\n    41\u2192from reflex.compiler import compiler\n    42\u2192from reflex.compiler import utils as compiler_utils\n    43\u2192from reflex.compiler.compiler import ExecutorSafeFunctions\n    44\u2192from reflex.components import connection_modal, connection_pulser\n    45\u2192from reflex.components.base.app_wrap import AppWrap\n    46\u2192from reflex.components.base.fragment import Fragment\n    47\u2192from reflex.components.component import (\n    48\u2192    Component,\n    49\u2192    ComponentStyle,\n    50\u2192    evaluate_style_namespaces,\n    51\u2192)\n    52\u2192from reflex.components.core.client_side_routing import (\n    53\u2192    Default404Page,\n    54\u2192    wait_for_client_redirect,\n    55\u2192)\n    56\u2192from reflex.components.core.upload import Upload, get_upload_dir\n    57\u2192from reflex.components.radix import themes\n    58\u2192from reflex.config import get_config\n    59\u2192from reflex.event import Event, EventHandler, EventSpec\n    60\u2192from reflex.middleware import HydrateMiddleware, Middleware\n    61\u2192from reflex.model import Model\n    62\u2192from reflex.page import (\n    63\u2192    DECORATED_PAGES,\n    64\u2192)\n    65\u2192from reflex.route import (\n    66\u2192    catchall_in_route,\n    67\u2192    catchall_prefix,\n    68\u2192    get_route_args,\n    69\u2192    verify_route_validity,\n    70\u2192)\n    71\u2192from reflex.state import (\n    72\u2192    BaseState,\n    73\u2192    RouterData,\n    74\u2192    State,\n    75\u2192    StateManager,\n    76\u2192    StateUpdate,\n    77\u2192    _substate_key,\n    78\u2192    code_uses_state_contexts,\n    79\u2192)\n    80\u2192from reflex.utils import console, exceptions, format, prerequisites, types\n    81\u2192from reflex.utils.exec import is_testing_env, should_skip_compile\n    82\u2192from reflex.utils.imports import ImportVar\n    83\u2192\n    84\u2192# Define custom types.\n    85\u2192ComponentCallable = Callable[[], Component]\n    86\u2192Reducer = Callable[[Event], Coroutine[Any, Any, StateUpdate]]\n    87\u2192\n    88\u2192\n    89\u2192def default_overlay_component() -> Component:\n    90\u2192    \"\"\"Default overlay_component attribute for App.\n    91\u2192\n    92\u2192    Returns:\n    93\u2192        The default overlay_component, which is a connection_modal.\n    94\u2192    \"\"\"\n    95\u2192    return Fragment.create(connection_pulser(), connection_modal())\n    96\u2192\n    97\u2192\n    98\u2192class OverlayFragment(Fragment):\n    99\u2192    \"\"\"Alias for Fragment, used to wrap the overlay_component.\"\"\"\n   100\u2192\n   101\u2192    pass\n   102\u2192\n   103\u2192\n   104\u2192class App(Base):\n   105\u2192    \"\"\"A Reflex application.\"\"\"\n   106\u2192\n   107\u2192    # A map from a page route to the component to render.\n   108\u2192    pages: Dict[str, Component] = {}\n   109\u2192\n   110\u2192    # A list of URLs to stylesheets to include in the app.\n   111\u2192    stylesheets: List[str] = []\n   112\u2192\n   113\u2192    # The backend API object.\n   114\u2192    api: FastAPI = None  # type: ignore\n   115\u2192\n   116\u2192    # The Socket.IO AsyncServer.\n   117\u2192    sio: Optional[AsyncServer] = None\n   118\u2192\n   119\u2192    # The socket app.\n   120\u2192    socket_app: Optional[ASGIApp] = None\n   121\u2192\n   122\u2192    # The state class to use for the app.\n   123\u2192    state: Optional[Type[BaseState]] = None\n   124\u2192\n   125\u2192    # Class to manage many client states.\n   126\u2192    _state_manager: Optional[StateManager] = None\n   127\u2192\n   128\u2192    # The styling to apply to each component.\n   129\u2192    style: ComponentStyle = {}\n   130\u2192\n   131\u2192    # Middleware to add to the app.\n   132\u2192    middleware: List[Middleware] = []\n   133\u2192\n   134\u2192    # List of event handlers to trigger when a page loads.\n   135\u2192    load_events: Dict[str, List[Union[EventHandler, EventSpec]]] = {}\n   136\u2192\n   137\u2192    # Admin dashboard\n   138\u2192    admin_dash: Optional[AdminDash] = None\n   139\u2192\n   140\u2192    # The async server name space\n   141\u2192    event_namespace: Optional[EventNamespace] = None\n   142\u2192\n   143\u2192    # Components to add to the head of every page.\n   144\u2192    head_components: List[Component] = []\n   145\u2192\n   146\u2192    # The language to add to the html root tag of every page.\n   147\u2192    html_lang: Optional[str] = None\n   148\u2192\n   149\u2192    # Attributes to add to the html root tag of every page.\n   150\u2192    html_custom_attrs: Optional[Dict[str, str]] = None\n   151\u2192\n   152\u2192    # A component that is present on every page.\n   153\u2192    overlay_component: Optional[\n   154\u2192        Union[Component, ComponentCallable]\n   155\u2192    ] = default_overlay_component\n   156\u2192\n   157\u2192    # Background tasks that are currently running\n   158\u2192    background_tasks: Set[asyncio.Task] = set()\n   159\u2192\n   160\u2192    # The radix theme for the entire app\n   161\u2192    theme: Optional[Component] = themes.theme(accent_color=\"blue\")\n   162\u2192\n   163\u2192    def __init__(self, *args, **kwargs):\n   164\u2192        \"\"\"Initialize the app.\n   165\u2192\n   166\u2192        Args:\n   167\u2192            *args: Args to initialize the app with.\n   168\u2192            **kwargs: Kwargs to initialize the app with.\n   169\u2192\n   170\u2192        Raises:\n   171\u2192            ValueError: If the event namespace is not provided in the config.\n   172\u2192                        Also, if there are multiple client subclasses of rx.BaseState(Subclasses of rx.BaseState should consist\n   173\u2192                        of the DefaultState and the client app state).\n   174\u2192        \"\"\"\n   175\u2192        if \"connect_error_component\" in kwargs:\n   176\u2192            raise ValueError(\n   177\u2192                \"`connect_error_component` is deprecated, use `overlay_component` instead\"\n   178\u2192            )\n   179\u2192        super().__init__(*args, **kwargs)\n   180\u2192        base_state_subclasses = BaseState.__subclasses__()\n   181\u2192\n   182\u2192        # Special case to allow test cases have multiple subclasses of rx.BaseState.\n   183\u2192        if not is_testing_env():\n   184\u2192            # Only one Base State class is allowed.\n   185\u2192            if len(base_state_subclasses) > 1:\n   186\u2192                raise ValueError(\n   187\u2192                    \"rx.BaseState cannot be subclassed multiple times. use rx.State instead\"\n   188\u2192                )\n   189\u2192\n   190\u2192            if \"state\" in kwargs:\n   191\u2192                console.deprecate(\n   192\u2192                    feature_name=\"`state` argument for App()\",\n   193\u2192                    reason=\"due to all `rx.State` subclasses being inferred.\",\n   194\u2192                    deprecation_version=\"0.3.5\",\n   195\u2192                    removal_version=\"0.5.0\",\n   196\u2192                )\n   197\u2192        # Add middleware.\n   198\u2192        self.middleware.append(HydrateMiddleware())\n   199\u2192\n   200\u2192        # Set up the API.\n   201\u2192        self.api = FastAPI()\n   202\u2192        self.add_cors()\n   203\u2192        self.add_default_endpoints()\n   204\u2192\n   205\u2192        self.setup_state()\n   206\u2192\n   207\u2192        # Set up the admin dash.\n   208\u2192        self.setup_admin_dash()\n   209\u2192\n   210\u2192    def enable_state(self) -> None:\n   211\u2192        \"\"\"Enable state for the app.\"\"\"\n   212\u2192        if not self.state:\n   213\u2192            self.state = State\n   214\u2192            self.setup_state()\n   215\u2192\n   216\u2192    def setup_state(self) -> None:\n   217\u2192        \"\"\"Set up the state for the app.\n   218\u2192\n   219\u2192        Raises:\n   220\u2192            ValueError: If the event namespace is not provided in the config.\n   221\u2192                        If the state has not been enabled.\n   222\u2192        \"\"\"\n   223\u2192        if not self.state:\n   224\u2192            return\n   225\u2192\n   226\u2192        config = get_config()\n   227\u2192\n   228\u2192        # Set up the state manager.\n   229\u2192        self._state_manager = StateManager.create(state=self.state)\n   230\u2192\n   231\u2192        # Set up the Socket.IO AsyncServer.\n   232\u2192        self.sio = AsyncServer(\n   233\u2192            async_mode=\"asgi\",\n   234\u2192            cors_allowed_origins=(\n   235\u2192                \"*\"\n   236\u2192                if config.cors_allowed_origins == [\"*\"]\n   237\u2192                else config.cors_allowed_origins\n   238\u2192            ),\n   239\u2192            cors_credentials=True,\n   240\u2192            max_http_buffer_size=constants.POLLING_MAX_HTTP_BUFFER_SIZE,\n   241\u2192            ping_interval=constants.Ping.INTERVAL,\n   242\u2192            ping_timeout=constants.Ping.TIMEOUT,\n   243\u2192        )\n   244\u2192\n   245\u2192        # Create the socket app. Note event endpoint constant replaces the default 'socket.io' path.\n   246\u2192        self.socket_app = ASGIApp(self.sio, socketio_path=\"\")\n   247\u2192        namespace = config.get_event_namespace()\n   248\u2192\n   249\u2192        if not namespace:\n   250\u2192            raise ValueError(\"event namespace must be provided in the config.\")\n   251\u2192\n   252\u2192        # Create the event namespace and attach the main app. Not related to any paths.\n   253\u2192        self.event_namespace = EventNamespace(namespace, self)\n   254\u2192\n   255\u2192        # Register the event namespace with the socket.\n   256\u2192        self.sio.register_namespace(self.event_namespace)\n   257\u2192        # Mount the socket app with the API.\n   258\u2192        self.api.mount(str(constants.Endpoint.EVENT), self.socket_app)\n   259\u2192\n   260\u2192    def __repr__(self) -> str:\n   261\u2192        \"\"\"Get the string representation of the app.\n   262\u2192\n   263\u2192        Returns:\n   264\u2192            The string representation of the app.\n   265\u2192        \"\"\"\n   266\u2192        return f\"<App state={self.state.__name__ if self.state else None}>\"\n   267\u2192\n   268\u2192    def __call__(self) -> FastAPI:\n   269\u2192        \"\"\"Run the backend api instance.\n   270\u2192\n   271\u2192        Returns:\n   272\u2192            The backend api.\n   273\u2192        \"\"\"\n   274\u2192        return self.api\n   275\u2192\n   276\u2192    def add_default_endpoints(self):\n   277\u2192        \"\"\"Add default api endpoints (ping).\"\"\"\n   278\u2192        # To test the server.\n   279\u2192        self.api.get(str(constants.Endpoint.PING))(ping)\n   280\u2192\n   281\u2192    def add_optional_endpoints(self):\n   282\u2192        \"\"\"Add optional api endpoints (_upload).\"\"\"\n   283\u2192        # To upload files.\n   284\u2192        if Upload.is_used:\n   285\u2192            self.api.post(str(constants.Endpoint.UPLOAD))(upload(self))\n   286\u2192\n   287\u2192            # To access uploaded files.\n   288\u2192            self.api.mount(\n   289\u2192                str(constants.Endpoint.UPLOAD),\n   290\u2192                StaticFiles(directory=get_upload_dir()),\n   291\u2192                name=\"uploaded_files\",\n   292\u2192            )\n   293\u2192\n   294\u2192    def add_cors(self):\n   295\u2192        \"\"\"Add CORS middleware to the app.\"\"\"\n   296\u2192        self.api.add_middleware(\n   297\u2192            cors.CORSMiddleware,\n   298\u2192            allow_credentials=True,\n   299\u2192            allow_methods=[\"*\"],\n   300\u2192            allow_headers=[\"*\"],\n   301\u2192            allow_origins=[\"*\"],\n   302\u2192        )\n   303\u2192\n   304\u2192    @property\n   305\u2192    def state_manager(self) -> StateManager:\n   306\u2192        \"\"\"Get the state manager.\n   307\u2192\n   308\u2192        Returns:\n   309\u2192            The initialized state manager.\n   310\u2192\n   311\u2192        Raises:\n   312\u2192            ValueError: if the state has not been initialized.\n   313\u2192        \"\"\"\n   314\u2192        if self._state_manager is None:\n   315\u2192            raise ValueError(\"The state manager has not been initialized.\")\n   316\u2192        return self._state_manager\n   317\u2192\n   318\u2192    async def preprocess(self, state: BaseState, event: Event) -> StateUpdate | None:\n   319\u2192        \"\"\"Preprocess the event.\n   320\u2192\n   321\u2192        This is where middleware can modify the event before it is processed.\n   322\u2192        Each middleware is called in the order it was added to the app.\n   323\u2192\n   324\u2192        If a middleware returns an update, the event is not processed and the\n   325\u2192        update is returned.\n   326\u2192\n   327\u2192        Args:\n   328\u2192            state: The state to preprocess.\n   329\u2192            event: The event to preprocess.\n   330\u2192\n   331\u2192        Returns:\n   332\u2192            An optional state to return.\n   333\u2192        \"\"\"\n   334\u2192        for middleware in self.middleware:\n   335\u2192            if asyncio.iscoroutinefunction(middleware.preprocess):\n   336\u2192                out = await middleware.preprocess(app=self, state=state, event=event)  # type: ignore\n   337\u2192            else:\n   338\u2192                out = middleware.preprocess(app=self, state=state, event=event)  # type: ignore\n   339\u2192            if out is not None:\n   340\u2192                return out  # type: ignore\n   341\u2192\n   342\u2192    async def postprocess(\n   343\u2192        self, state: BaseState, event: Event, update: StateUpdate\n   344\u2192    ) -> StateUpdate:\n   345\u2192        \"\"\"Postprocess the event.\n   346\u2192\n   347\u2192        This is where middleware can modify the delta after it is processed.\n   348\u2192        Each middleware is called in the order it was added to the app.\n   349\u2192\n   350\u2192        Args:\n   351\u2192            state: The state to postprocess.\n   352\u2192            event: The event to postprocess.\n   353\u2192            update: The current state update.\n   354\u2192\n   355\u2192        Returns:\n   356\u2192            The state update to return.\n   357\u2192        \"\"\"\n   358\u2192        for middleware in self.middleware:\n   359\u2192            if asyncio.iscoroutinefunction(middleware.postprocess):\n   360\u2192                out = await middleware.postprocess(\n   361\u2192                    app=self, state=state, event=event, update=update  # type: ignore\n   362\u2192                )\n   363\u2192            else:\n   364\u2192                out = middleware.postprocess(\n   365\u2192                    app=self, state=state, event=event, update=update  # type: ignore\n   366\u2192                )\n   367\u2192            if out is not None:\n   368\u2192                return out  # type: ignore\n   369\u2192        return update\n   370\u2192\n   371\u2192    def add_middleware(self, middleware: Middleware, index: int | None = None):\n   372\u2192        \"\"\"Add middleware to the app.\n   373\u2192\n   374\u2192        Args:\n   375\u2192            middleware: The middleware to add.\n   376\u2192            index: The index to add the middleware at.\n   377\u2192        \"\"\"\n   378\u2192        if index is None:\n   379\u2192            self.middleware.append(middleware)\n   380\u2192        else:\n   381\u2192            self.middleware.insert(index, middleware)\n   382\u2192\n   383\u2192    @staticmethod\n   384\u2192    def _generate_component(component: Component | ComponentCallable) -> Component:\n   385\u2192        \"\"\"Generate a component from a callable.\n   386\u2192\n   387\u2192        Args:\n   388\u2192            component: The component function to call or Component to return as-is.\n   389\u2192\n   390\u2192        Returns:\n   391\u2192            The generated component.\n   392\u2192\n   393\u2192        Raises:\n   394\u2192            TypeError: When an invalid component function is passed.\n   395\u2192            exceptions.MatchTypeError: If the return types of match cases in rx.match are different.\n   396\u2192        \"\"\"\n   397\u2192        try:\n   398\u2192            return component if isinstance(component, Component) else component()\n   399\u2192        except exceptions.MatchTypeError:\n   400\u2192            raise\n   401\u2192        except TypeError as e:\n   402\u2192            message = str(e)\n   403\u2192            if \"BaseVar\" in message or \"ComputedVar\" in message:\n   404\u2192                raise TypeError(\n   405\u2192                    \"You may be trying to use an invalid Python function on a state var. \"\n   406\u2192                    \"When referencing a var inside your render code, only limited var operations are supported. \"\n   407\u2192                    \"See the var operation docs here: https://reflex.dev/docs/vars/var-operations/\"\n   408\u2192                ) from e\n   409\u2192            raise e\n   410\u2192\n   411\u2192    def add_page(\n   412\u2192        self,\n   413\u2192        component: Component | ComponentCallable,\n   414\u2192        route: str | None = None,\n   415\u2192        title: str | None = None,\n   416\u2192        description: str | None = None,\n   417\u2192        image: str = constants.DefaultPage.IMAGE,\n   418\u2192        on_load: (\n   419\u2192            EventHandler | EventSpec | list[EventHandler | EventSpec] | None\n   420\u2192        ) = None,\n   421\u2192        meta: list[dict[str, str]] = constants.DefaultPage.META_LIST,\n   422\u2192        script_tags: list[Component] | None = None,\n   423\u2192    ):\n   424\u2192        \"\"\"Add a page to the app.\n   425\u2192\n   426\u2192        If the component is a callable, by default the route is the name of the\n   427\u2192        function. Otherwise, a route must be provided.\n   428\u2192\n   429\u2192        Args:\n   430\u2192            component: The component to display at the page.\n   431\u2192            route: The route to display the component at.\n   432\u2192            title: The title of the page.\n   433\u2192            description: The description of the page.\n   434\u2192            image: The image to display on the page.\n   435\u2192            on_load: The event handler(s) that will be called each time the page load.\n   436\u2192            meta: The metadata of the page.\n   437\u2192            script_tags: List of script tags to be added to component\n   438\u2192        \"\"\"\n   439\u2192        # If the route is not set, get it from the callable.\n   440\u2192        if route is None:\n   441\u2192            assert isinstance(\n   442\u2192                component, Callable\n   443\u2192            ), \"Route must be set if component is not a callable.\"\n   444\u2192            # Format the route.\n   445\u2192            route = format.format_route(component.__name__)\n   446\u2192        else:\n   447\u2192            route = format.format_route(route, format_case=False)\n   448\u2192\n   449\u2192        # Check if the route given is valid\n   450\u2192        verify_route_validity(route)\n   451\u2192\n   452\u2192        # Setup dynamic args for the route.\n   453\u2192        # this state assignment is only required for tests using the deprecated state kwarg for App\n   454\u2192        state = self.state if self.state else State\n   455\u2192        state.setup_dynamic_args(get_route_args(route))\n   456\u2192\n   457\u2192        # Generate the component if it is a callable.\n   458\u2192        component = self._generate_component(component)\n   459\u2192\n   460\u2192        # Ensure state is enabled if this page uses state.\n   461\u2192        if self.state is None:\n   462\u2192            if on_load or component._has_event_triggers():\n   463\u2192                self.enable_state()\n   464\u2192            else:\n   465\u2192                for var in component._get_vars(include_children=True):\n   466\u2192                    if not var._var_data:\n   467\u2192                        continue\n   468\u2192                    if not var._var_data.state:\n   469\u2192                        continue\n   470\u2192                    self.enable_state()\n   471\u2192                    break\n   472\u2192\n   473\u2192        component = OverlayFragment.create(component)\n   474\u2192\n   475\u2192        meta_args = {\n   476\u2192            \"title\": (\n   477\u2192                title\n   478\u2192                if title is not None\n   479\u2192                else format.make_default_page_title(get_config().app_name, route)\n   480\u2192            ),\n   481\u2192            \"image\": image,\n   482\u2192            \"meta\": meta,\n   483\u2192        }\n   484\u2192\n   485\u2192        if description is not None:\n   486\u2192            meta_args[\"description\"] = description\n   487\u2192\n   488\u2192        # Add meta information to the component.\n   489\u2192        compiler_utils.add_meta(\n   490\u2192            component,\n   491\u2192            **meta_args,\n   492\u2192        )\n   493\u2192\n   494\u2192        # Add script tags if given\n   495\u2192        if script_tags:\n   496\u2192            console.deprecate(\n   497\u2192                feature_name=\"Passing script tags to add_page\",\n   498\u2192                reason=\"Add script components as children to the page component instead\",\n   499\u2192                deprecation_version=\"0.2.9\",\n   500\u2192                removal_version=\"0.5.0\",\n   501\u2192            )\n   502\u2192            component.children.extend(script_tags)\n   503\u2192\n   504\u2192        # Add the page.\n   505\u2192        self._check_routes_conflict(route)\n   506\u2192        self.pages[route] = component\n   507\u2192\n   508\u2192        # Add the load events.\n   509\u2192        if on_load:\n   510\u2192            if not isinstance(on_load, list):\n   511\u2192                on_load = [on_load]\n   512\u2192            self.load_events[route] = on_load\n   513\u2192\n   514\u2192    def get_load_events(self, route: str) -> list[EventHandler | EventSpec]:\n   515\u2192        \"\"\"Get the load events for a route.\n   516\u2192\n   517\u2192        Args:\n   518\u2192            route: The route to get the load events for.\n   519\u2192\n   520\u2192        Returns:\n   521\u2192            The load events for the route.\n   522\u2192        \"\"\"\n   523\u2192        route = route.lstrip(\"/\")\n   524\u2192        if route == \"\":\n   525\u2192            route = constants.PageNames.INDEX_ROUTE\n   526\u2192        return self.load_events.get(route, [])\n   527\u2192\n   528\u2192    def _check_routes_conflict(self, new_route: str):\n   529\u2192        \"\"\"Verify if there is any conflict between the new route and any existing route.\n   530\u2192\n   531\u2192        Based on conflicts that NextJS would throw if not intercepted.\n   532\u2192\n   533\u2192        Raises:\n   534\u2192            ValueError: exception showing which conflict exist with the route to be added\n   535\u2192\n   536\u2192        Args:\n   537\u2192            new_route: the route being newly added.\n   538\u2192        \"\"\"\n   539\u2192        newroute_catchall = catchall_in_route(new_route)\n   540\u2192        if not newroute_catchall:\n   541\u2192            return\n   542\u2192\n   543\u2192        for route in self.pages:\n   544\u2192            route = \"\" if route == \"index\" else route\n   545\u2192\n   546\u2192            if new_route.startswith(f\"{route}/[[...\"):\n   547\u2192                raise ValueError(\n   548\u2192                    f\"You cannot define a route with the same specificity as a optional catch-all route ('{route}' and '{new_route}')\"\n   549\u2192                )\n   550\u2192\n   551\u2192            route_catchall = catchall_in_route(route)\n   552\u2192            if (\n   553\u2192                route_catchall\n   554\u2192                and newroute_catchall\n   555\u2192                and catchall_prefix(route) == catchall_prefix(new_route)\n   556\u2192            ):\n   557\u