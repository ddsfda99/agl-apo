     raise TypeError\n   311→\n   312→                    expected_type = fields[key].outer_type_.__args__[0]\n   313→                    # validate literal fields.\n   314→                    types.validate_literal(\n   315→                        key, value, expected_type, type(self).__name__\n   316→                    )\n   317→                    # Get the passed type and the var type.\n   318→                    passed_type = kwargs[key]._var_type\n   319→                    expected_type = (\n   320→                        type(expected_type.__args__[0])\n   321→                        if types.is_literal(expected_type)\n   322→                        else expected_type\n   323→                    )\n   324→                except TypeError:\n   325→                    # If it is not a valid var, check the base types.\n   326→                    passed_type = type(value)\n   327→                    expected_type = fields[key].outer_type_\n   328→                if not types._issubclass(passed_type, expected_type):\n   329→                    value_name = value._var_name if isinstance(value, Var) else value\n   330→                    raise TypeError(\n   331→                        f\"Invalid var passed for prop {key}, expected type {expected_type}, got value {value_name} of type {passed_type}.\"\n   332→                    )\n   333→\n   334→            # Check if the key is an event trigger.\n   335→            if key in triggers:\n   336→                # Temporarily disable full control for event triggers.\n   337→                kwargs[\"event_triggers\"][key] = self._create_event_chain(\n   338→                    value=value, args_spec=component_specific_triggers[key]\n   339→                )\n   340→\n   341→        # Remove any keys that were added as events.\n   342→        for key in kwargs[\"event_triggers\"]:\n   343→            del kwargs[key]\n   344→\n   345→        # Add style props to the component.\n   346→        style = kwargs.get(\"style