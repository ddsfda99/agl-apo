lf) -> dict[str, Any]:\n  2671→        \"\"\"Get the options for the storage.\n  2672→\n  2673→        Returns:\n  2674→            All set options for the storage (not None).\n  2675→        \"\"\"\n  2676→        return {\n  2677→            format.to_camel_case(k): v for k, v in vars(self).items() if v is not None\n  2678→        }\n  2679→\n  2680→\n  2681→class Cookie(ClientStorageBase, str):\n  2682→    \"\"\"Represents a state Var that is stored as a cookie in the browser.\"\"\"\n  2683→\n  2684→    name: str | None\n  2685→    path: str\n  2686→    max_age: int | None\n  2687→    domain: str | None\n  2688→    secure: bool | None\n  2689→    same_site: str\n  2690→\n  2691→    def __new__(\n  2692→        cls,\n  2693→        object: Any = \"\",\n  2694→        encoding: str | None = None,\n  2695→        errors: str | None = None,\n  2696→        /,\n  2697→        name: str | None = None,\n  2698→        path: str = \"/\",\n  2699→        max_age: int | None = None,\n  2700→        domain: str | None = None,\n  2701→        secure: bool | None = None,\n  2702→        same_site: str = \"lax\",\n  2703→    ):\n  2704→        \"\"\"Create a client-side Cookie (str).\n  2705→\n  2706→        Args:\n  2707→            object: The initial object.\n  2708→            encoding: The encoding to use.\n  2709→            errors: The error handling scheme to use.\n  2710→            name: The name of the cookie on the client side.\n  2711→            path: Cookie path. Use / as the path if the cookie should be accessible on all pages.\n  2712→            max_age: Relative max age of the cookie in seconds from when the client receives it.\n  2713→            domain: Domain for the cookie (sub.domain.com or .allsubdomains.com).\n  2714→            secure: Is the cookie only accessible through HTTPS?\n  2715→            same_site: Whether the cookie is sent with third party requests.\n  2716→                One of (true|false|none|lax|strict)\n  2717→\n  2718→        Ret