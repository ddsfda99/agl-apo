 \"\"\"Event for receiving front-end websocket events.\n  1253→\n  1254→        Args:\n  1255→            sid: The Socket.IO session id.\n  1256→            data: The event data.\n  1257→        \"\"\"\n  1258→        # Get the event.\n  1259→        event = Event.parse_raw(data)\n  1260→\n  1261→        # Get the event environment.\n  1262→        assert self.app.sio is not None\n  1263→        environ = self.app.sio.get_environ(sid, self.namespace)\n  1264→        assert environ is not None\n  1265→\n  1266→        # Get the client headers.\n  1267→        headers = {\n  1268→            k.decode(\"utf-8\"): v.decode(\"utf-8\")\n  1269→            for (k, v) in environ[\"asgi.scope\"][\"headers\"]\n  1270→        }\n  1271→\n  1272→        # Get the client IP\n  1273→        try:\n  1274→            client_ip = environ[\"asgi.scope\"][\"client\"][0]\n  1275→        except (KeyError, IndexError):\n  1276→            client_ip = environ.get(\"REMOTE_ADDR\", \"0.0.0.0\")\n  1277→\n  1278→        # Process the events.\n  1279→        async for update in process(self.app, event, sid, headers, client_ip):\n  1280→            # Emit the update from processing the event.\n  1281→            await self.emit_update(update=update, sid=sid)\n  1282→\n  1283→    async def on_ping(self, sid):\n  1284→        \"\"\"Event for testing the API endpoint.\n  1285→\n  1286→        Args:\n  1287→            sid: The Socket.IO session id.\n  1288→        \"\"\"\n  1289→        # Emit the test event.\n  1290→        await self.emit(str(constants.SocketEvent.PING), \"pong\", to=sid)\n  1291→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"e6b863b1-67e9-4