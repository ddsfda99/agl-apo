n   240\u2192    Args:\n   241\u2192        substate_key: The substate key.\n   242\u2192\n   243\u2192    Returns:\n   244\u2192        Tuple of token and state name.\n   245\u2192    \"\"\"\n   246\u2192    token, _, state_name = substate_key.partition(\"_\")\n   247\u2192    return token, state_name\n   248\u2192\n   249\u2192\n   250\u2192class BaseState(Base, ABC, extra=pydantic.Extra.allow):\n   251\u2192    \"\"\"The state of the app.\"\"\"\n   252\u2192\n   253\u2192    # A map from the var name to the var.\n   254\u2192    vars: ClassVar[Dict[str, Var]] = {}\n   255\u2192\n   256\u2192    # The base vars of the class.\n   257\u2192    base_vars: ClassVar[Dict[str, BaseVar]] = {}\n   258\u2192\n   259\u2192    # The computed vars of the class.\n   260\u2192    computed_vars: ClassVar[Dict[str, ComputedVar]] = {}\n   261\u2192\n   262\u2192    # Vars inherited by the parent state.\n   263\u2192    inherited_vars: ClassVar[Dict[str, Var]] = {}\n   264\u2192\n   265\u2192    # Backend vars that are never sent to the client.\n   266\u2192    backend_vars: ClassVar[Dict[str, Any]] = {}\n   267\u2192\n   268\u2192    # Backend vars inherited\n   269\u2192    inherited_backend_vars: ClassVar[Dict[str, Any]] = {}\n   270\u2192\n   271\u2192    # The event handlers.\n   272\u2192    event_handlers: ClassVar[Dict[str, EventHandler]] = {}\n   273\u2192\n   274\u2192    # A set of subclassses of this class.\n   275\u2192    class_subclasses: ClassVar[Set[Type[BaseState]]] = set()\n   276\u2192\n   277\u2192    # Mapping of var name to set of computed variables that depend on it\n   278\u2192    _computed_var_dependencies: ClassVar[Dict[str, Set[str]]] = {}\n   279\u2192\n   280\u2192    # Mapping of var name to set of substates that depend on it\n   281\u2192    _substate_var_dependencies: ClassVar[Dict[str, Set[str]]] = {}\n   282\u2192\n   283\u2192    # Set of vars which always need to be recomputed\n   284\u2192    _always_dirty_computed_vars: ClassVar[Set[str]] = set()\n   285\u2192\n   286\u2192    # Set of substates which always need to be recomputed\n   287\u2192    _always_dirty_substates: ClassVar[Set[str]] = set()\n   288\u2192\n   289\u2192    # The parent state.\n   290\u2192    parent_state: Optional[BaseState] = None\n   291\u2192\n   292\u2192    # The substates of the state.\n   293\u2192    substates: Dict[str, BaseState] = {}\n   294\u2192\n   295\u2192    # The set of dirty vars.\n   296\u2192    dirty_vars: Set[str] = set()\n   297\u2192\n   298\u2192    # The set of dirty substates.\n   299\u2192    dirty_substates: Set[str] = set()\n   300\u2192\n   301\u2192    # The routing path that triggered the state\n   302\u2192    router_data: Dict[str, Any] = {}\n   303\u2192\n   304\u2192    # Per-instance copy of backend variable values\n   305\u2192    _backend_vars: Dict[str, Any] = {}\n   306\u2192\n   307\u2192    # The router data for the current page\n   308\u2192    router: RouterData = RouterData()\n   309\u2192\n   310\u2192    # Whether the state has ever been touched since instantiation.\n   311\u2192    _was_touched: bool = False\n   312\u2192\n   313\u2192    def __init__(\n   314\u2192        self,\n   315\u2192        *args,\n   316\u2192        parent_state: BaseState | None = None,\n   317\u2192        init_substates: bool = True,\n   318\u2192        _reflex_internal_init: bool = False,\n   319\u2192        **kwargs,\n   320\u2192    ):\n   321\u2192        \"\"\"Initialize the state.\n   322\u2192\n   323\u2192        DO NOT INSTANTIATE STATE CLASSES DIRECTLY! Use StateManager.get_state() instead.\n   324\u2192\n   325\u2192        Args:\n   326\u2192            *args: The args to pass to the Pydantic init method.\n   327\u2192            parent_state: The parent state.\n   328\u2192            init_substates: Whether to initialize the substates in this instance.\n   329\u2192            _reflex_internal_init: A flag to indicate that the state is being initialized by the framework.\n   330\u2192            **kwargs: The kwargs to pass to the Pydantic init method.\n   331\u2192\n   332\u2192        Raises:\n   333\u2192            RuntimeError: If the state is instantiated directly by end user.\n   334\u2192        \"\"\"\n   335\u2192        if not _reflex_internal_init and not is_testing_env():\n   336\u2192            raise RuntimeError(\n   337\u2192                \"State classes should not be instantiated directly in a Reflex app. \"\n   338\u2192                \"See https://reflex.dev/docs/state/ for further information.\"\n   339\u2192            )\n   340\u2192        kwargs[\"parent_state\"] = parent_state\n   341\u2192        super().__init__(*args, **kwargs)\n   342\u2192\n   343\u2192        # Setup the substates (for memory state manager only).\n   344\u2192        if init_substates:\n   345\u2192            for substate in self.get_substates():\n   346\u2192                self.substates[substate.get_name()] = substate(\n   347\u2192                    parent_state=self,\n   348\u2192                    _reflex_internal_init=True,\n   349\u2192                )\n   350\u2192\n   351\u2192        # Create a fresh copy of the backend variables for this instance\n   352\u2192        self._backend_vars = copy.deepcopy(\n   353\u2192            {\n   354\u2192                name: item\n   355\u2192                for name, item in self.backend_vars.items()\n   356\u2192                if name not in self.computed_vars\n   357\u2192            }\n   358\u2192        )\n   359\u2192\n   360\u2192    def __repr__(self) -> str:\n   361\u2192        \"\"\"Get the string representation of the state.\n   362\u2192\n   363\u2192        Returns:\n   364\u2192            The string representation of the state.\n   365\u2192        \"\"\"\n   366\u2192        return f\"{self.__class__.__name__}({self.dict()})\"\n   367\u2192\n   368\u2192    @classmethod\n   369\u2192    def _get_computed_vars(cls) -> list[ComputedVar]:\n   370\u2192        \"\"\"Helper function to get all computed vars of a instance.\n   371\u2192\n   372\u2192        Returns:\n   373\u2192            A list of computed vars.\n   374\u2192        \"\"\"\n   375\u2192        return [\n   376\u2192            v\n   377\u2192            for mixin in cls.__mro__\n   378\u2192            if mixin is cls or not issubclass(mixin, (BaseState, ABC))\n   379\u2192            for v in mixin.__dict__.values()\n   380\u2192            if isinstance(v, ComputedVar)\n   381\u2192        ]\n   382\u2192\n   383\u2192    @classmethod\n   384\u2192    def __init_subclass__(cls, **kwargs):\n   385\u2192        \"\"\"Do some magic for the subclass initialization.\n   386\u2192\n   387\u2192        Args:\n   388\u2192            **kwargs: The kwargs to pass to the pydantic init_subclass method.\n   389\u2192\n   390\u2192        Raises:\n   391\u2192            ValueError: If a substate class shadows another.\n   392\u2192        \"\"\"\n   393\u2192        super().__init_subclass__(**kwargs)\n   394\u2192        # Event handlers should not shadow builtin state methods.\n   395\u2192        cls._check_overridden_methods()\n   396\u2192\n   397\u2192        # Reset subclass tracking for this class.\n   398\u2192        cls.class_subclasses = set()\n   399\u2192\n   400\u2192        # Reset dirty substate tracking for this class.\n   401\u2192        cls._always_dirty_substates = set()\n   402\u2192\n   403\u2192        # Get the parent vars.\n   404\u2192        parent_state = cls.get_parent_state()\n   405\u2192        if parent_state is not None:\n   406\u2192            cls.inherited_vars = parent_state.vars\n   407\u2192            cls.inherited_backend_vars = parent_state.backend_vars\n   408\u2192\n   409\u2192            # Check if another substate class with the same name has already been defined.\n   410\u2192            if cls.__name__ in set(c.__name__ for c in parent_state.class_subclasses):\n   411\u2192                if is_testing_env():\n   412\u2192                    # Clear existing subclass with same name when app is reloaded via\n   413\u2192                    # utils.prerequisites.get_app(reload=True)\n   414\u2192                    parent_state.class_subclasses = set(\n   415\u2192                        c\n   416\u2192                        for c in parent_state.class_subclasses\n   417\u2192                        if c.__name__ != cls.__name__\n   418\u2192                    )\n   419\u2192                else:\n   420\u2192                    # During normal operation, subclasses cannot have the same name, even if they are\n   421\u2192                    # defined in different modules.\n   422\u2192                    raise ValueError(\n   423\u2192                        f\"The substate class '{cls.__name__}' has been defined multiple times. \"\n   424\u2192                        \"Shadowing substate classes is not allowed.\"\n   425\u2192                    )\n   426\u2192            # Track this new subclass in the parent state's subclasses set.\n   427\u2192            parent_state.class_subclasses.add(cls)\n   428\u2192\n   429\u2192        # Get computed vars.\n   430\u2192        computed_vars = cls._get_computed_vars()\n   431\u2192\n   432\u2192        new_backend_vars = {\n   433\u2192            name: value\n   434\u2192            for name, value in cls.__dict__.items()\n   435\u2192            if types.is_backend_variable(name, cls)\n   436\u2192            and name not in RESERVED_BACKEND_VAR_NAMES\n   437\u2192            and name not in cls.inherited_backend_vars\n   438\u2192            and not isinstance(value, FunctionType)\n   439\u2192            and not isinstance(value, ComputedVar)\n   440\u2192        }\n   441\u2192\n   442\u2192        # Get backend computed vars\n   443\u2192        backend_computed_vars = {\n   444\u2192            v._var_name: v._var_set_state(cls)\n   445\u2192            for v in computed_vars\n   446\u2192            if types.is_backend_variable(v._var_name, cls)\n   447\u2192            and v._var_name not in cls.inherited_backend_vars\n   448\u2192        }\n   449\u2192\n   450\u2192        cls.backend_vars = {\n   451\u2192            **cls.inherited_backend_vars,\n   452\u2192            **new_backend_vars,\n   453\u2192            **backend_computed_vars,\n   454\u2192        }\n   455\u2192\n   456\u2192        # Set the base and computed vars.\n   457\u2192        cls.base_vars = {\n   458\u2192            f.name: BaseVar(_var_name=f.name, _var_type=f.outer_type_)._var_set_state(\n   459\u2192                cls\n   460\u2192            )\n   461\u2192            for f in cls.get_fields().values()\n   462\u2192            if f.name not in cls.get_skip_vars()\n   463\u2192        }\n   464\u2192        cls.computed_vars = {v._var_name: v._var_set_state(cls) for v in computed_vars}\n   465\u2192        cls.vars = {\n   466\u2192            **cls.inherited_vars,\n   467\u2192            **cls.base_vars,\n   468\u2192            **cls.computed_vars,\n   469\u2192        }\n   470\u2192        cls.event_handlers = {}\n   471\u2192\n   472\u2192        # Setup the base vars at the class level.\n   473\u2192        for prop in cls.base_vars.values():\n   474\u2192            cls._init_var(prop)\n   475\u2192\n   476\u2192        # Set up the event handlers.\n   477\u2192        events = {\n   478\u2192            name: fn\n   479\u2192            for name, fn in cls.__dict__.items()\n   480\u2192            if cls._item_is_event_handler(name, fn)\n   481\u2192        }\n   482\u2192\n   483\u2192        for mixin in cls._mixins():\n   484\u2192            for name, value in mixin.__dict__.items():\n   485\u2192                if isinstance(value, ComputedVar):\n   486\u2192                    fget = cls._copy_fn(value.fget)\n   487\u2192                    newcv = ComputedVar(fget=fget, _var_name=value._var_name)\n   488\u2192                    newcv._var_set_state(cls)\n   489\u2192                    setattr(cls, name, newcv)\n   490\u2192                    cls.computed_vars[newcv._var_name] = newcv\n   491\u2192                    cls.vars[newcv._var_name] = newcv\n   492\u2192                    continue\n   493\u2192                if events.get(name) is not None:\n   494\u2192                    continue\n   495\u2192                if not cls._item_is_event_handler(name, value):\n   496\u2192                    continue\n   497\u2192                if parent_state is not None and parent_state.event_handlers.get(name):\n   498\u2192                    continue\n   499\u2192                value = cls._copy_fn(value)\n   500\u2192                value.__qualname__ = f\"{cls.__name__}.{name}\"\n   501\u2192                events[name] = value\n   502\u2192\n   503\u2192        for name, fn in events.items():\n   504\u2192            handler = cls._create_event_handler(fn)\n   505\u2192            cls.event_handlers[name] = handler\n   506\u2192            setattr(cls, name, handler)\n   507\u2192\n   508\u2192        cls._init_var_dependency_dicts()\n   509\u2192\n   510\u2192    @staticmethod\n   511\u2192    def _copy_fn(fn: Callable) -> Callable:\n   512\u2192        \"\"\"Copy a function. Used to copy ComputedVars and EventHandlers from mixins.\n   513\u2192\n   514\u2192        Args:\n   515\u2192            fn: The function to copy.\n   516\u2192\n   517\u2192        Returns:\n   518\u2192            The copied function.\n   519\u2192        \"\"\"\n   520\u2192        newfn = FunctionType(\n   521\u2192            fn.__code__,\n   522\u2192            fn.__globals__,\n   523\u2192            name=fn.__name__,\n   524\u2192            argdefs=fn.__defaults__,\n   525\u2192            closure=fn.__closure__,\n   526\u2192        )\n   527\u2192        newfn.__annotations__ = fn.__annotations__\n   528\u2192        return newfn\n   529\u2192\n   530\u2192    @staticmethod\n   531\u2192    def _item_is_event_handler(name: str, value: Any) -> bool:\n   532\u2192        \"\"\"Check if the item is an event handler.\n   533\u2192\n   534\u2192        Args:\n   535\u2192            name: The name of the item.\n   536\u2192            value: The value of the item.\n   537\u2192\n   538\u2192        Returns:\n   539\u2192            Whether the item is an event handler.\n   540\u2192        \"\"\"\n   541\u2192        return (\n   542\u2192            not name.startswith(\"_\")\n   543\u2192            and isinstance(value, Callable)\n   544\u2192            and not isinstance(value, EventHandler)\n   545\u2192            and hasattr(value, \"__code__\")\n   546\u2192        )\n   547\u2192\n   548\u2192    @classmethod\n   549\u2192    def _mixins(cls) -> List[Type]:\n   550\u2192        \"\"\"Get the mixin classes of the state.\n   551\u2192\n   552\u2192        Returns:\n   553\u2192            The mixin classes of the state.\n   554\u2192        \"\"\"\n   555\u2192        return [\n   556\u2192            mixin\n   557\u2192            for mixin in cls.__mro__\n   558\u2192            if not issubclass(mixin, (BaseState, ABC))\n   559\u2192            and mixin not in [pydantic.BaseModel, Base]\n   560\u2192        ]\n   561\u2192\n   562\u2192    @classmethod\n   563\u2192    def _init_var_dependency_dicts(cls):\n   564\u2192        \"\"\"Initialize the var dependency tracking dicts.\n   565\u2192\n   566\u2192        Allows the state to know which vars each ComputedVar depends on and\n   567\u2192        whether a ComputedVar depends on a var in its parent state.\n   568\u2192\n   569\u2192        Additional updates tracking dicts for vars and substates that always\n   570\u2192        need to be recomputed.\n   571\u2192        \"\"\"\n   572\u2192        # Initialize per-class var dependency tracking.\n   573\u2192        cls._computed_var_dependencies = defaultdict(set)\n   574\u2192        cls._substate_var_dependencies = defaultdict(set)\n   575\u2192\n   576\u2192        inherited_vars = set(cls.inherited_vars).union(