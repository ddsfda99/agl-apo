663→\n  1664→    def _get_was_touched(self) -> bool:\n  1665→        \"\"\"Check current dirty_vars and flag to determine if state instance was modified.\n  1666→\n  1667→        If any dirty vars belong to this state, mark _was_touched.\n  1668→\n  1669→        This flag determines whether this state instance should be persisted to redis.\n  1670→\n  1671→        Returns:\n  1672→            Whether this state instance was ever modified.\n  1673→        \"\"\"\n  1674→        # Ensure the flag is up to date based on the current dirty_vars\n  1675→        self._update_was_touched()\n  1676→        return self._was_touched\n  1677→\n  1678→    def _clean(self):\n  1679→        \"\"\"Reset the dirty vars.\"\"\"\n  1680→        # Update touched status before cleaning dirty_vars.\n  1681→        self._update_was_touched()\n  1682→\n  1683→        # Recursively clean the substates.\n  1684→        for substate in self.dirty_substates:\n  1685→            if substate not in self.substates:\n  1686→                continue\n  1687→            self.substates[substate]._clean()\n  1688→\n  1689→        # Clean this state.\n  1690→        self.dirty_vars = set()\n  1691→        self.dirty_substates = set()\n  1692→\n  1693→    def get_value(self, key: str) -> Any:\n  1694→        \"\"\"Get the value of a field (without proxying).\n  1695→\n  1696→        The returned value will NOT track dirty state updates.\n  1697→\n  1698→        Args:\n  1699→            key: The key of the field.\n  1700→\n  1701→        Returns:\n  1702→            The value of the field.\n  1703→        \"\"\"\n  1704→        if isinstance(key, MutableProxy):\n  1705→            return super().get_value(key.__wrapped__)\n  1706→        return super().get_value(key)\n  1707\n  1708→    def dict(\n  1709→        self, include_computed: bool = True, initial: bool = False, **kwargs\n  1710→    ) -> dict[str, Any]:\n  1711→        \"\"\"Convert the object to a dictionary.\n  1712→\n  1713→        Args:\n  1714→            include_computed: Whether to include computed vars.\n  1715→            initial: Whether to get the initial value of computed vars.\n  1716→            **kwargs: Kwargs to pass to the pydantic dict method.\n  1717→\n  1718→        Returns:\n  1719→            The object as a dictionary.\n  1720→        \"\"\"\n  1721→        if include_computed:\n  1722→            # Apply dirty variables down into substates to allow never-cached ComputedVar to\n  1723→            # trigger recalculation of dependent vars\n  1724→            self.dirty_vars.update(self._always_dirty_computed_vars)\n  1725→            self._mark_dirty()\n  1726→\n  1727→        base_vars = {\n  1728→            prop_name: self.get_value(getattr(self, prop_name))\n  1729→            for prop_name in self.base_vars\n  1730→        }\n  1731→        if initial:\n  1732→            computed_vars = {\n  1733→                # Include initial computed vars.\n  1734→                prop_name: cv._initial_value\n  1735→                if isinstance(cv, ComputedVar)\n  1736→                and not isinstance(cv._initial_value, types.Unset)\n  1737→                else self.get_value(getattr(self, prop_name))\n  1738→                for prop_name, cv in self.computed_vars.items()\n  1739→            }\n  1740→        elif include_computed:\n  1741→            computed_vars = {\n  1742→                # Include the computed vars.\n  1743→                prop_name: self.get_value(getattr(self, prop_name))\n  1744→                for prop_name in self.computed_vars\n  1745→            }\n  1746→        else:\n  1747→            computed_vars = {}\n  1748→        variables = {**base_vars, **computed_vars}\n  1749→        d = {\n  1750→            self.get_full_name(): {k: variables[k] for k in sorted(variables)},\n  1751→        }\n  1752→        for substate_d in [\n  1753→            v.dict(include_computed=include_computed, initial=initial, **kwargs)\n  1754→            for v in self.substates.v