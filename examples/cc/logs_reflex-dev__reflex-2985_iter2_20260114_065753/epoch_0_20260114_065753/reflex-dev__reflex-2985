   self.add_optional_endpoints()\n   748\u2192\n   749\u2192        if not self._should_compile():\n   750\u2192            return\n   751\u2192\n   752\u2192        self._setup_overlay_component()\n   753\u2192\n   754\u2192        # Create a progress bar.\n   755\u2192        progress = Progress(\n   756\u2192            *Progress.get_default_columns()[:-1],\n   757\u2192            MofNCompleteColumn(),\n   758\u2192            TimeElapsedColumn(),\n   759\u2192        )\n   760\u2192\n   761\u2192        # try to be somewhat accurate - but still not 100%\n   762\u2192        adhoc_steps_without_executor = 6\n   763\u2192        fixed_pages_within_executor = 5\n   764\u2192        progress.start()\n   765\u2192        task = progress.add_task(\n   766\u2192            \"Compiling:\",\n   767\u2192            total=len(self.pages)\n   768\u2192            + fixed_pages_within_executor\n   769\u2192            + adhoc_steps_without_executor,\n   770\u2192        )\n   771\u2192\n   772\u2192        # Get the env mode.\n   773\u2192        config = get_config()\n   774\u2192\n   775\u2192        # Store the compile results.\n   776\u2192        compile_results = []\n   777\u2192\n   778\u2192        # Add the app wrappers.\n   779\u2192        app_wrappers: Dict[tuple[int, str], Component] = {\n   780\u2192            # Default app wrap component renders {children}\n   781\u2192            (0, \"AppWrap\"): AppWrap.create()\n   782\u2192        }\n   783\u2192        if self.theme is not None:\n   784\u2192            # If a theme component was provided, wrap the app with it\n   785\u2192            app_wrappers[(20, \"Theme\")] = self.theme\n   786\u2192\n   787\u2192        progress.advance(task)\n   788\u2192\n   789\u2192        # Fix up the style.\n   790\u2192        self.style = evaluate_style_namespaces(self.style)\n   791\u2192\n   792\u2192        # Track imports and custom components found.\n   793\u2192        all_imports = {}\n   794\u2192        custom