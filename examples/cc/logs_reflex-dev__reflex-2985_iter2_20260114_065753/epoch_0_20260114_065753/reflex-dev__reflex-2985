"\n   530→        return []\n   531→\n   532→    def _render(self, props: dict[str, Any] | None = None) -> Tag:\n   533→        \"\"\"Define how to render the component in React.\n   534→\n   535→        Args:\n   536→            props: The props to render (if None, then use get_props).\n   537→\n   538→        Returns:\n   539→            The tag to render.\n   540→        \"\"\"\n   541→        # Create the base tag.\n   542→        tag = Tag(\n   543→            name=self.tag if not self.alias else self.alias,\n   544→            special_props=self.special_props,\n   545→        )\n   546→\n   547→        if props is None:\n   548→            # Add component props to the tag.\n   549→            props = {\n   550→                attr[:-1] if attr.endswith(\"_\") else attr: getattr(self, attr)\n   551→                for attr in self.get_props()\n   552→            }\n   553→\n   554→            # Add ref to element if `id` is not None.\n   555→            ref = self.get_ref()\n   556→            if ref is not None:\n   557→                props[\"ref\"] = Var.create(ref, _var_is_local=False)\n   558→        else:\n   559→            props = props.copy()\n   560→\n   561→        props.update(\n   562→            **{\n   563→                trigger: handler\n   564→                for trigger, handler in self.event_triggers.items()\n   565→                if trigger not in {EventTriggers.ON_MOUNT, EventTriggers.ON_UNMOUNT}\n   566→            },\n   567→            key=self.key,\n   568→            id=self.id,\n   569→            class_name=self.class_name,\n   570→        )\n   571→        props.update(self._get_style())\n   572→        props.update(self.custom_attrs)\n   573→\n   574→        # remove excluded props from prop dict before adding to tag.\n   575→        for prop_to_exclude in self._exclude_props():\n   576→            props.pop(prop_to_exclude, None)\n   577→\n   578→        return tag.add_props(**props)\n   579→\n   580→    @classmethod\n   581→    @lru_cache(maxsize=None)\n   582→    def get_props(cls) -> Set[str]:\n   583→        \"\"\"Get the unique fields for the component.\n   584→\n   585→        Returns:\n   586→            The unique fields.\n   587→        \"\"\"\n   588→        return set(cls.get_fields()) - set(Component.get_fields())\n   589→\n   590→    @classmethod\n   591→    @lru_cache(maxsize=None)\n   592→    def get_initial_props(cls) -> Set[str]:\n   593→        \"\"\"Get the initial props to set for the component.\n   594→\n   595→        Returns:\n   596→            The initial props to set.\n   597→        \"\"\"\n   598→        return set()\n   599→\n   600→    @classmethod\n   601→    @lru_cache(maxsize=None)\n   602→    def get_component_props(cls) -> set[str]:\n   603→        \"\"\"Get the props that expected a component as value.\n   604→\n   605→        Returns:\n   606→            The components props.\n   607→        \"\"\"\n   608→        return {\n   609→            name\n   610→            for name, field in cls.get_fields().items()\n   611→            if name in cls.get_props()\n   612→            and types._issubclass(field.outer_type_, Component)\n   613→        }\n   614→\n   615→    @classmethod\n   616→    def create(cls, *children, **props) -> Component:\n   617→        \"\"\"Create the component.\n   618→\n   619→        Args:\n   620→            *children: The children of the component.\n   621→            **props: The props of the component.\n   622→\n   623→        Returns:\n   624→            The component.\n   625→\n   626→        Raises:\n   627→            TypeError: If an invalid child is passed.\n   628→        \"\"\"\n   629→        # Import here to avoid circular imports.\n   630→        from reflex.components.base.bare import Bare\n   631→\n   632→        # Translate deprecated props to new names.\n   633→        new_prop_names = [\n   634→            prop for prop in cls.get_props() if prop in [\"type\", \"min\", \"max\"]\n   635→        ]\n   636→        for prop in new_prop_names:\n   637→            under_prop = f\"{prop}_\"\n   638→            if under_prop in props:\n   639→                console.deprecate(\n   640→                    f\"Underscore suffix for prop `{under_prop}`\",\n   641→                    reason=f\"for consistency. Use `{prop}` instead.\",\n   642→                    deprecation_version=\"0.4.0\",\n   643→                    removal_version=\"0.5.0\",\n   644→                    dedupe=False,\n   645→                )\n   646→                props[prop] = props.pop(under_prop)\n   647→\n   648→        # Validate all the children.\n   649→        for child in children:\n   650→            # Make sure the child is a valid type.\n   651→            if not types._isinstance(child, ComponentChild):\n   652→                raise TypeError(\n   653→                    \"Children of Reflex components must be other components, \"\n   654→                    \"state vars, or primitive Python types. \"\n   655→                    f\"Got child {child} of type {type(child)}.\",\n   656→                )\n   657→\n   658→        children = [\n   659→            (\n   660→                child\n   661→                if isinstance(child, Component)\n   662→                else Bare.create(contents=Var.create(child, _var_is_string=True))\n   663→            )\n   664→            for child in children\n   665→        ]\n   666→\n   667→        return cls(children=children, **props)\n   668→\n   669→    def _add_style(self, style: dict):\n   670→        \"\"\"Add additional style to the component.\n   671→\n   672→        Args:\n   673→            style: A style dict to apply.\n   674→        \"\"\"\n   675→        self.style.update(style)\n   676→\n   677→    def add_style(self, style: ComponentStyle) -> Component:\n   678→        \"\"\"Add additional style to the component and its children.\n   679→\n   680→        Args:\n   681→            style: A dict from component to styling.\n   682→\n   683→       