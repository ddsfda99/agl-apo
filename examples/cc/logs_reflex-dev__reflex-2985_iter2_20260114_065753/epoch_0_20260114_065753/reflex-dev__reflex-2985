app. Not related to any paths.\n   253→        self.event_namespace = EventNamespace(namespace, self)\n   254→\n   255→        # Register the event namespace with the socket.\n   256→        self.sio.register_namespace(self.event_namespace)\n   257→        # Mount the socket app with the API.\n   258→        self.api.mount(str(constants.Endpoint.EVENT), self.socket_app)\n   259→\n   260→    def __repr__(self) -> str:\n   261→        \"\"\"Get the string representation of the app.\n   262→\n   263→        Returns:\n   264→            The string representation of the app.\n   265→        \"\"\"\n   266→        return f\"<App state={self.state.__name__ if self.state else None}>\"\n   267→\n   268→    def __call__(self) -> FastAPI:\n   269→        \"\"\"Run the backend api instance.\n   270→\n   271→        Returns:\n   272→            The backend api.\n   273→        \"\"\"\n   274→        return self.api\n   275→\n   276→    def add_default_endpoints(self):\n   277→        \"\"\"Add default api endpoints (ping).\"\"\"\n   278→        # To test the server.\n   279→        self.api.get(str(constants.Endpoint.PING))(ping)\n   280→\n   281→    def add_optional_endpoints(self):\n   282→        \"\"\"Add optional api endpoints (_upload).\"\"\"\n   283→        # To upload files.\n   284→        if Upload.is_used:\n   285→            self.api.post(str(constants.Endpoint.UPLOAD))(upload(self))\n   286→\n   287→            # To access uploaded files.\n   288→            self.api.mount(\n   289→                str(constants.Endpoint.UPLOAD),\n   290→                StaticFiles(directory=get_upload_dir()),\n   291→                name=\"uploaded_files\",\n   292→            )\n   293→\n   294→    def add_cors(self):\n   295→        \"\"\"Add CORS middleware to the app.\"\"\"\n   296→        self.api.add_middleware(\n   297→            cors.CORSMiddleware,\n   298→            allow_credentials=True,\n   299→            allow_methods=[\"*\"],\n   300→            allow_headers=[\"*\