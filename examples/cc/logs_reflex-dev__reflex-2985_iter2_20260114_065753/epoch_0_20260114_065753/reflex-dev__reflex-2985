 Optional[dict] = None):\n   136→        \"\"\"Initalize the SessionData object based on router_data.\n   137→\n   138→        Args:\n   139→            router_data: the router_data dict.\n   140→        \"\"\"\n   141→        super().__init__()\n   142→        if router_data:\n   143→            self.client_token = router_data.get(constants.RouteVar.CLIENT_TOKEN, \"\")\n   144→            self.client_ip = router_data.get(constants.RouteVar.CLIENT_IP, \"\")\n   145→            self.session_id = router_data.get(constants.RouteVar.SESSION_ID, \"\")\n   146→\n   147→\n   148→class RouterData(Base):\n   149→    \"\"\"An object containing RouterData.\"\"\"\n   150→\n   151→    session: SessionData = SessionData()\n   152→    headers: HeaderData = HeaderData()\n   153→    page: PageData = PageData()\n   154→\n   155→    def __init__(self, router_data: Optional[dict] = None):\n   156→        \"\"\"Initialize the RouterData object.\n   157→\n   158→        Args:\n   159→            router_data: the router_data dict.\n   160→        \"\"\"\n   161→        super().__init__()\n   162→        self.session = SessionData(router_data)\n   163→        self.headers = HeaderData(router_data)\n   164→        self.page = PageData(router_data)\n   165→\n   166→\n   167→def _no_chain_background_task(\n   168→    state_cls: Type[\"BaseState\"], name: str, fn: Callable\n   169→) -> Callable:\n   170→    \"\"\"Protect against directly chaining a background task from another event handler.\n   171→\n   172→    Args:\n   173→        state_cls: The state class that the event handler is in.\n   174→        name: The name of the background task.\n   175→        fn: The background task coroutine function / generator.\n   176→\n   177→    Returns:\n   178→        A compatible coroutine function / generator that raises a runtime error.\n   179→\n   180→    Raises:\n   181→        TypeError: If the background task is not async.\n   182→    \"\"\"\n   183→    call = f\"{state_cls.__name__}.{name}\"\n   184→    message = (\n   185→        f\"Cannot directly call background task {name!r}, use \"\n   186→        f\"`yield {call}` or `return {call}` instead.\"\n   187→    )\n   188→    if inspect.iscoroutinefunction(fn):\n   189→\n   190→        async def _no_chain_background_task_co(*args, **kwargs):\n   191→            raise RuntimeError(message)\n   192→\n   193→        return _no_chain_background_task_co\n   194→    if inspect.isasyncgenfunction(fn):\n   195→\n   196→        async def _no_chain_background_task_gen(*args, **kwargs):\n   197→            yield\n   198→            raise RuntimeError(message)\n   199→\n   200→        return _no_chain_background_task_gen\n   201→\n   202→    raise TypeError(f\"{fn} is marked as a background task, but is not async.\")\n   203→\n   204→\n   205→RESERVED_BACKEND_VAR_NAMES = {\n   206→    \"_backend_vars\",\n   207→    \"_computed_var_dependencies\",\n   208→    \"_substate_var_dependencies\",\n   209→    \"_always_dirty_computed_vars\",\n   210→    \"_always_dirty_substates\",\n   211→    \"_was_touched\",\n   212→}\n   213→\n   214→\n   215→def _substate_key(\n   216→    token: str,\n   217→    state_cls_or_name: BaseState | Type[BaseState] | str | list[str],\n   218→) -> str:\n   219→    \"\"\"Get the substate key.\n   220→\n   221→    Args:\n   222→        token: The token of the state.\n   223→        state_cls_or_name: The state class/instance or name or sequence of name parts.\n   224→\n   225→    Returns:\n   226→        The substate key.\n   227→    \"\"\"\n   228→    if isinstance(state_cls_or_name, BaseState) or (\n   229→        isinstance(state_cls_or_name, type) and issubclass(state_cls_or_name, BaseState)\n   230→    ):\n   231→        state_cls_or_name = state_cls_or_name.get_full_name()\n   232→    elif isinstance(state_cls_or_name, (list, tuple)):\n   233→        state_cls_or_name = \".\".join(state_cls_or_name)\n   234→    return f\"{token}_{state_cls_or_name}\"\n   235→\n   236→\n   237→def _split_substate_key(substate_key: str) -> tuple[str, str]:\n   238→    \"\"\"Split the substate key into token and state name.\n   239→\n   240→    Args:\n   241→        substate_key: The substate key.\n   242→\n   243→    Returns:\n   244→        Tuple of token and state name.\n   245→    \"\"\"\n   246→    token, _, state_name = substate_key.partition(\"_\")\n   247→    return token, state_name\n   248→\n   249→\n   250→class BaseState(Base, ABC, extra=pydantic.Extra.allow):\n   251→    \"\"\"The state of the app.\"\"\"\n   252→\n   253→    # A map from the var name to the var.\n   254→    vars: ClassVar[Dict[str, Var]] = {}\n   255→\n   256→    # The base vars of the class.\n   257→    base_vars: ClassVar[Dict[str, BaseVar]] = {}\n   258→\n   259→    # The computed vars of the class.\n   260→    computed_vars: ClassVar[Dict[str, ComputedVar]] = {}\n   261→\n   262→    # Vars inherited by the parent state.\n   263→    inherited_vars: ClassVar[Dict[str, Var]] = {}\n   264→\n   265→    # Backend vars that are never sent to the client.\n   266→    backend_vars: ClassVar[Dict[str, Any]] = {}\n   267→\n   268→    # Backend vars inherited\n   269→    inherited_backend_vars: ClassVar[Dict[str, Any]] = {}\n   270→\n   271→    # The event handlers.\n   272→    event_handlers: ClassVar[Dict[str, EventHandler]] = {}\n   273→\n   274→    # A set of subclassses of this class.\n   275→    class_subclasses: ClassVar[Set[Type[BaseState]]] = set()\n   276→\n   277→    # Mapping of var name to set of computed variables that depend on it\n   278→    _computed_var_dependencies: ClassVar[Dict[str, Set[str]]] = {}\n   279→\n   280→    # Mapping of var name to set of substates that depend on it\n   281→    _substate_var_dependencies: ClassVar[Dict[str, Set[str]]] = {}\n   282→\n   283→    # Set of vars which always need to be recomputed\n   284→    _always_dirty_computed_vars: ClassVar[Set[str]] = set()\n   285→\n   286→    # Set of substates which always need to be recomputed\n   287→    _always_dirty_substates: ClassVar[Set[str]] = set()\n   288→\n   289→    # The parent state.\n   290→    parent_state: Optional[BaseState] = None\n   291→\n   292→    # The substates of the state.\n   293→    substates: Dict[str, BaseState] = {}\n   294→\n   295→    # The set of dirty vars.\n   296→    dirty_vars: Set[str] = set()\n   297→\n   298→    # The set of dirty substates.\n   299→    dirty_substates: Set[str] = set()\n   300→\n   301→    # The routing path that triggered the state\n   302→    router_data: Dict[str, Any] = {}\n   303→\n   304→    # Per-instance copy of backend variable values\n   305→    _backend_vars: Dict[str, Any] = {}\n   306→\n   307→    # The router data for the current page\n   308→    router: RouterData = RouterData()\n   309→\n   310→    # Whether the state has ever been touched since instantiation.\n   311→    _was_touched: bool = False\n   312→\n   313→    def __init__(\n   314→        self,\n   315→        *args,\n   316→        parent_state: BaseState | None = None,\n   317→        init_substates: bool = True,\n   318→        _reflex_internal_init: bool = False,\n   319→        **kwargs,\n   320→    ):\n   321→        \"\"\"Initialize the state.\n   322→\n   323→        DO NOT INSTANTIATE STATE CLASSES DIRECTLY! Use StateManager.get_state() instead.\n   324→\n   325→        Args:\n   326→            *args: The args to pass to the Pydantic init method.\n   327→            parent_state: The parent state.\n   328→            init_substates: Whether to initialize the substates in this instance.\n   329→            _reflex_internal_init: A flag to indicate that the state is being initialized by the framework.\n   330→            **kwargs: The kwargs to pass to the Pydantic init method.\n   331→\n   332→        Raises:\n   333→            RuntimeError: If the state is instantiated directly by end user.\n   334→        \"\"\"\n   335→        if not _reflex_internal_init and not is_testing_env():\n   336→            raise RuntimeError(\n   337→                \"State classes should not be instantiated directly in a Reflex app. \"\n   338→                \"See https://reflex.dev/docs/state/ for further information.\"\n   339→            )\n   340→        kwargs[\"parent_state\"] = parent_state\n   341→        super().__init__(*args, **kwargs)\n   342→\n   343→        # Setup the substates (for memory state manager only).\n   344→        if init_substates:\n   345→            for substate in self.get_substates():\n   346→                self.substates[substate.get_name()] = substate(\n   347→                    parent_state=self,\n   348→                    _reflex_internal_init=True,\n   349→                )\n   350→\n   351→        # Create a fresh copy of the backend variables for this instance\n   352→        self._backend_vars = copy.deepcopy(\n   353→            {\n   354→                name: item\n   355→                for name, item in self.backend_vars.items()\n   356→                if name not in self.computed_vars\n   357→            }\n   358→        )\n   359→\n   360→    def __repr__(self) -> str:\n   361→        \"\"\"Get the string representation of the state.\n   362→\n   363→        Returns:\n   364→            The string representation of the state.\n   365→        \"\"\"\n   366→        return f\"{self.__class__.__name__}({self.dict()})\"\n   367→\n   368→    @classmethod\n   369→    def _get_computed_vars(cls) -> list[ComputedVar]:\n   370→        \"\"\"Helper function to get all computed vars of a instance.\n   371→\n   372→        Returns:\n   373→            A list of computed vars.\n   374→        \"\"\"\n   375→        return [\n   376→            v\n   377→            for mixin in cls.__mro__\n   378→            if mixin is cls or not issubclass(mixin, (BaseState, ABC))\n   379→            for v in mixin.__dict__.values()\n   380→            if isinstance(v, ComputedVar)\n   381→        ]\n   382→\n   383→    @classmethod\n   384→    def __init_subclass__(cls, **kwargs):\n   385→        \"\"\"Do some magic for the subclass initialization.\n   386→\n   387→        Args:\n   388→            **kwargs: The kwargs to pass to the pydantic init_subclass method.\n   389→\n   390→        Raises:\n   391→            ValueError: If a substate class shadows another.\n   392→        \"\"\"\n   393→        super().__init_subclass__(**kwargs)\n   394→        # Event handlers should not shadow builtin state methods.\n   395→        cls._check_overridden_methods()\n   396→\n   397→        # Reset subclass tracking for this class.\n   398→        cls.class_subclasses = set()\n   399→\n   400→        # Reset dirty substate tracking for this class.\n   401→        cls._always_dirty_substates = set()\n   402→\n   403→        # Get the parent vars.\n   404→        parent_state = cls.get_parent_state()\n   405→        if parent_state is not None:\n   406→            cls.inherited_vars = parent_state.vars\n   407→            cls.inherited_backend_vars = parent_state.backend_vars\n   408→\n   409→            # Check if another substate class with the same name has already been defined.\n   410→            if cls.__name__ in set(c.__name__ for c in parent_state.class_subclasses):\n   411→                if is_testing_env():\n   412→                    # Clear existing subclass with same name when app is reloaded via\n   413→                    # utils.prerequisites.get_app(reload=True)\n   414→                    parent_state.class_subclasses = set(\n   415→                        c\n   416→                        for c in parent_state.class_subclasses\n   417→                        if c.__name__ != cls.__name__\n   418→                    )\n   419→                else:\n   420→                    # During normal operation, subclasses cannot have the same name, even if they are\n   421→                    # defined in different modules.\n   422→                    raise ValueError(\n   423→                        f\"The substate class '{cls.__name__}' has been defined multiple times. \"\n   424→                        \"Shadowing substate classes is not allowed.\"\n   425→                    )\n   426→            # Track this new subclass in the parent state's subclasses set.\n   427→            parent_state.class_subclasses.add(cls)\n   428→\n   429→        # Get computed vars.\n   430→        computed_vars = cls._get_computed_vars()\n   431→\n   432→        new_backend_vars = {\n   433→            name: value\n   434→            for name, value in cls.__dict__.items()\n   435→            if types.is_backend_variable(name, cls)\n   436→            and name not in RESERVED_BACKEND_VAR_NAMES\n   437→            and name not in cls.inherited_backend_vars\n   438→            and not isinstance(value, FunctionType)\n   439→            and not isinstance(value, ComputedVar)\n   440→        }\n   441→\n   442→        # Get backend computed vars\n   443→        backend_computed_vars = {\n   444→            v._var_name: v._var_set_state(cls)\n   445→            for v in computed_vars\n   446→            if types.is_backend_variable(v._var_name, cls)\n   447→            and v._var_name not in cls.inherited_backend_vars\n   448→        }\n   449→\n   450→        cls.backend_vars = {\n   451→            **cls.inherited_backend_vars,\n   452→            **new_backend_vars,\n   453→            **backend_computed_vars,\n   454→        }\n   455→\n   456→        # Set the base and computed vars.\n   457→        cls.base_vars = {\n   458→            f.name: BaseVar(_var_name=f.name, _var_type=f.outer_type_)._var_set_state(\n   459→                cls\n   460→            )\n   461→            for f in cls.get_fields().values()\n   462→            if f.name not in cls.get_skip_vars()\n   463→        }\n   464→        cls.computed_vars = {v._var_name: v._var_set_state(cls) for v in computed_vars}\n   465→        cls.vars = {\n   466→            **cls.inherited_vars,\n   467→            **cls.base_vars,\n   468→            **cls.computed_vars,\n   469→        }\n   470→        cls.event_handlers = {}\n   471→\n   472→        # Setup the base vars at the class level.\n   473→        for prop in cls.base_vars.values():\n   474→            cls._init_var(prop)\n   475→\n   476→        # Set up the event handlers.\n   477→        events = {\n   478→            name: fn\n   479→            for name, fn in cls.__dict__.items()\n   480→            if cls._item_is_event_handler(name, fn)\n   481→        }\n   482→\n   483→        for mixin in cls._mixins():\n   484→            for name, value in mixin.__dict__.items():\n   485→                if isinstance(value, ComputedVar):\n   486→                    fget = cls._copy_fn(value.fget)\n   487→                    newcv = ComputedVar(fget=fget, _var_name=value._var_name)\n   488→                    newcv._var_set_state(cls)\n   489→                    setattr(cls, name, newcv)\n   490→                    cls.computed_vars[newcv._var_name] = newcv\n   491→                    cls.vars[newcv._var_name] = newcv\n   492→                    continue\n   493→                if events.get(name) is not None:\n   494→                    continue\n   495→                if not cls._item_is_event_handler(name, value):\n   496→                    continue\n   497→                if parent_state is not None and parent_state.event_handlers.get(name):\n   498→                    continue\n   499→                value = cls._copy_fn(value)\n   500→                value.__qualname__ = f\"{cls.__name__}.{name}\"\n   501→                events[name] = value\n   502→\n   503→        for name, fn in events.items():\n   504→            handler = cls._create_event_handler(fn)\n   505→            cls.event_handlers[name] = handler\n   506→            setattr(cls, name, handler)\n   507→\n   508→        cls._init_var_dependency_dicts()\n   509→\n   510→    @staticmethod\n   511→    def _copy_fn(fn: Callable) -> Callable:\n   512→        \"\"\"Copy a function. Used to copy ComputedVars and EventHandlers from mixins.\n   513→\n   514→        Args:\n   515→            fn: The function to copy.\n   516→\n   517→        Returns:\n   518→            The copied function.\n   519→        \"\"\"\n   520→        newfn = FunctionType(\n   521→            fn.__code__,\n   522→            fn.__globals__,\n   523→            name=fn.__name__,\n   524→            argdefs=fn.__defaults__,\n   525→            closure=fn.__closure__,\n   526→        )\n   527→        newfn.__annotations__ = fn.__annotations__\n   528→        return newfn\n   529→\n   530→    @staticmethod\n   531→    def _item_is_event_handler(name: str, value: Any) -> bool:\n   532→        \"\"\"Check if the item is an event handler.\n   533→\n   534→        Args:\n   535→            name: The name of the item.\n   536→            value: The value of the item.\n   537→\n   538→        Returns:\n   539→            Whether the item is an event handler.\n   540→        \"\"\"\n   541→        return (\n   542→            not name.startswith(\"_\")\n   543→            and isinstance(value, Callable)\n   544→            and not isinstance(value, EventHandler)\n   545→            and hasattr(value, \"__code__\")\n   546→        )\n   547→\n   548→    @classmethod\n   549→    def _mixins(cls) -> List[Type]:\n   550→        \"\"\"Get the mixin classes of the state.\n   551→\n   552→        Returns:\n   553→            The mixin classes of the state.\n   554→        \"\"\"\n   555→        return [\n   556→            mixin\n   557→            for mixin in cls.__mro__\n   558→            if not issubclass(mixin, (BaseState, ABC))\n   559→            and mixin not in [pydantic.BaseModel, Base]\n   560→        ]\n   561→\n   562→    @classmethod\n   563→    def _init_var_dependency_dicts(cls):\n   564→        \"\"\"Initialize the var dependency tracking dicts.\n   565→\n   566→        Allows the state to know which vars each ComputedVar depends on and\n   567→        whether a ComputedVar depends on a var in its parent state.\n   568→\n   569→        Additional updates tracking dicts for vars and substates that always\n   570→        need to be recomputed.\n   571→        \"\"\"\n   572→        # Initialize per-class var dependency tracking.\n   573→        cls._computed_var_dependencies = defaultdict(set)\n   574→        cls._substate_var_dependencies = defaultdict(set)\n   575→\n   576→        inherited_vars = set(cls.inherited_vars).union(\n   577→            set(cls.inherited_backend_vars),\n   578→        )\n   579→        for cvar_name, cvar in cls.computed_vars.items():\n   580→            # Add the dependencies.\n   581→            for var in cvar._deps(objclass=cls):\n   582→                cls._computed_var_dependencies[var].add(cvar_name)\n   583→                if var in inherited_vars:\n   584→                    # track that this substate depends on its parent for this var\n   585→                    state_name = cls.get_name()\n   586→                    parent_state = cls.get_parent_state()\n   587→                    while parent_state is not None and var in {\n   588→                        **parent_state.vars,\n   589→                        **parent_state.backend_vars,\n   590→                    }:\n   591→                        parent_state._substate_var_dependencies[var].add(state_name)\n   592→                        state_name, parent_state = (\n   593→                            parent_state.get_name(),\n   594→                            parent_state.get_parent_state(),\n   595→                        )\n   596→\n   597→        # ComputedVar with cache=False always need to be recomputed\n   598→        cls._always_dirty_computed_vars = set(\n   599→            cvar_name\n   600→            for cvar_name, cvar in cls.computed_vars.items()\n   601→            if not cvar._cache\n   602→        )\n   603→\n   604→        # Any substate containing a ComputedVar with cache=False always needs to be recomputed\n   605→        if cls._always_dirty_computed_vars:\n   606→            # Tell parent classes that this substate has always dirty computed vars\n   607→            state_name = cls.get_name()\n   608→            parent_state = cls.get_parent_state()\n   609→            while parent_state is not None:\n   610→                parent_state._always_dirty_substates.add(state_name)\n   611→                state_name, parent_state = (\n   612→                    parent_state.get_name(),\n   613→                    parent_state.get_parent_state(),\n   614→                )\n   615→\n   616→    @classmethod\n   617→    def _check_overridden_methods(cls):\n   618→        \"\"\"Check for shadow methods and raise error if any.\n   619→\n   620→        Raises:\n   621→            NameError: When an event handler shadows an inbuilt state method.\n   622→        \"\"\"\n   623→        overridden_methods = set()\n   624→        state_base_functions = cls._get_base_functions()\n   625→        for name, method in inspect.getmembers(cls, inspect.isfunction):\n   626→            # Check if the method is overridden and not a dunder method\n   627→            if (\n   628→                not name.startswith(\"__\")\n   629→                and method.__name__ in state_base_functions\n   630→                and state_base_functions[method.__name__] != method\n   631→            ):\n   632→                overridden_methods.add(method.__name__)\n   633→\n   634→        for method_name in overridden_methods:\n   635→            raise NameError(\n   636→                f\"The event handler name `{method_name}` shadows a builtin State method; use a different name instead\"\n   637→            )\n   638→\n   639→    @classmethod\n   640→    def get_skip_vars(cls) -> set[str]:\n   641→        \"\"\"Get the vars to skip when serializing.\n   642→\n   643→        Returns:\n   644→            The vars to skip when serializing.\n   645→        \"\"\"\n   646→        return (\n   647→            set(cls.inherited_vars)\n   648→            | {\n   649→                \"parent_state\",\n   650→                \"substates\",\n   651→                \"dirty_vars\",\n   652→                \"dirty_substates\",\n   653→                \"router_data\",\n   654→            }\n   655→            | RESERVED_BACKEND_VAR_NAMES\n   656→        )\n   657→\n   658→    @classmethod\n   659→    @functools.lru_cache()\n   660→    def get_parent_state(cls) -> Type[BaseState] | None:\n   661→        \"\"\"Get the parent state.\n   662→\n   663→        Returns:\n   664→            The parent state.\n   665→        \"\"\"\n   666→        parent_states = [\n   667→            base\n   668→            for base in cls.__bases__\n   669→            if types._issubclass(base, BaseState) and base is not BaseState\n   670→        ]\n   671→        assert len(parent_states) < 2, \"Only one parent state is allowed.\"\n   672→        return parent_states[0] if len(parent_states) == 1 else None  # type: ignore\n   673→\n   674→    @classmethod\n   675→    def get_substates(cls) -> set[Type[BaseState]]:\n   676→        \"\"\"Get the substates of the state.\n   677→\n   678→        Returns:\n   679→            The substates of the state.\n   680→        \"\"\"\n   681→        return cls.class_subclasses\n   682→\n   683→    @classmethod\n   684→    @functools.lru_cache()\n   685→    def get_name(cls) -> str:\n   686→        \"\"\"Get the name of the state.\n   687→\n   688→        Returns:\n   689→            The name of the state.\n   690→        \"\"\"\n   691→        return format.to_snake_case(cls.__name__)\n   692→\n   693→    @classmethod\n   694→    @functools.lru_cache()\n   695→    def get_full_name(cls) -> str:\n   696→        \"\"\"Get the full name of the state.\n   697→\n   698→        Returns:\n   699→            The full name of the state.\n   700→        \"\"\"\n   701→        name = cls.get_name()\n   702→        parent_state = cls.get_parent_state()\n   703→        if parent_state is not None:\n   704→            name = \".\".join((parent_state.get_full_name(), name))\n   705→        return name\n   706→\n   707→    @classmethod\n   708→    @functools.lru_cache()\n   709→    def get_class_substate(cls, path: Sequence[str] | str) -> Type[BaseState]:\n   710→        \"\"\"Get the class substate.\n   711→\n   712→        Args:\n   713→            path: The path to the substate.\n   714→\n   715→        Returns:\n   716→            The class substate.\n   717→\n   718→        Raises:\n   719→            ValueError: If the substate is not found.\n   720→        \"\"\"\n   721→        if isinstance(path, str):\n   722→            path = tuple(path.split(\".\"))\n   723→\n   724→        if len(path) == 0:\n   725→            return cls\n   726→        if path[0] == cls.get_name():\n   727→            if len(path) == 1:\n   728→                return cls\n   729→            path = path[1:]\n   730→        for substate in cls.get_substates():\n   731→            if path[0] == substate.get_name():\n   732→                return substate.get_class_substate(path[1:])\n   733→        raise ValueError(f\"Invalid path: {path}\")\n   734→\n   735→    @classmethod\n   736→    def get_class_var(cls, path: Sequence[str]) -> Any:\n   737→        \"\"\"Get the class var.\n   738→\n   739→        Args:\n   740→            path: The path to the var.\n   741→\n   742→        Returns:\n   743→            The class var.\n   744→\n   745→        Raises:\n   746→            ValueError: If the path is invalid.\n   747→        \"\"\"\n   748→        path, name = path[:-1], path[-1]\n   749→        substate = cls.get_class_substate(tuple(path))\n   750→        if not hasattr(substate, name):\n   751→            raise ValueError(f\"Invalid path: {path}\")\n   752→        return getattr(substate, name)\n   753→\n   754→    @classmethod\n   755→    def _init_var(cls, prop: BaseVar):\n   756→        \"\"\"Initialize a variable.\n   757→\n   758→        Args:\n   759→            prop: The variable to initialize\n   760→\n   761→        Raises:\n   762→            TypeError: if the variable has an incorrect type\n   763→        \"\"\"\n   764→        if not types.is_valid_var_type(prop._var_type):\n   765→            raise TypeError(\n   766→                \"State vars must be primitive Python types, \"\n   767→                \"Plotly figures, Pandas dataframes, \"\n   768→                \"or subclasses of rx.Base. \"\n   769→                f'Found var \"{prop._var_name}\" with type {prop._var_type}.'\n   770→            )\n   771→        cls._set_var(prop)\n   772→        cls._create_setter(prop)\n   773→        cls._set_default_value(prop)\n   774→\n   775→    @classmethod\n   776→    def add_var(cls, name: str, type_: Any, default_value: Any = None):\n   777→        \"\"\"Add dynamically a variable to the State.\n   778→\n   779→        The variable added this way can be used in the same way as a variable\n   780→        defined statically in the model.\n   781→\n   782→        Args:\n   783→            name: The name of the variable\n   784→            type_: The type of the variable\n   785→            default_value: The default value of the variable\n   786→\n   787→        Raises:\n   788→            NameError: if a variable of this name already exists\n   789→        \"\"\"\n   790→        if name in cls.__fields__:\n   791→            raise NameError(\n   792→                f\"The variable '{name}' already exist. Use a different name\"\n   793→            )\n   794→\n   795→        # create the variable based on name and type\n   796→        var = BaseVar(_var_name=name, _var_type=type_)\n   797→        var._var_set_state(cls)\n   798→\n   799→        # add the pydantic field dynamically (must be done before _init_var)\n   800→        cls.add_field(var, default_value)\n   801→\n   802→        cls._init_var(var)\n   803→\n   804→        # update the internal dicts so the new variable is correctly handled\n   805→        cls.base_vars.update({name: var})\n   806→        cls.vars.update({name: var})\n   807→\n   808→        # let substates know about the new variable\n   809→        for substate_class in cls.__subclasses__():\n   810→            substate_class.vars.setdefault(name, var)\n   811→\n   812→        # Reinitialize dependency tracking dicts.\n   813→        cls._init_var_dependency_dicts()\n   814→\n   815→    @classmethod\n   816→    def _set_var(cls, prop: BaseVar):\n   817→        \"\"\"Set the var as a class member.\n   818→\n   819→        Args:\n   820→            prop: The var instance to set.\n   821→        \"\"\"\n   822→        setattr(cls, prop._var_name, prop)\n   823→\n   824→    @classmethod\n   825→    def _create_event_handler(cls, fn):\n   826→        \"\"\"Create an event handler for the given function.\n   827→\n   828→        Args:\n   829→            fn: The function to create an event handler for.\n   830→\n   831→        Returns:\n   832→            The event handler.\n   833→        \"\"\"\n   834→        return EventHandler(fn=fn, state_full_name=cls.get_full_name())\n   835→\n   836→    @classmethod\n   837→    def _create_setter(cls, prop: BaseVar):\n   838→        \"\"\"Create a setter for the var.\n   839→\n   840→        Args:\n   841→            prop: The var to create a setter for.\n   842→        \"\"\"\n   843→        setter_name = prop.get_setter_name(include_state=False)\n   844→        if setter_name not in cls.__dict__:\n   845→            event_handler = cls._create_event_handler(prop.get_setter())\n   846→            cls.event_handlers[setter_name] = event_handler\n   847→            setattr(cls, setter_name, event_handler)\n   848→\n   849→    @classmethod\n   850→    def _set_default_value(cls, prop: BaseVar):\n   851→        \"\"\"Set the default value for the var.\n   852→\n   853→        Args:\n   854→            prop: The var to set the default value for.\n   855→        \"\"\"\n   856→        # Get the pydantic field for the var.\n   857→        field = cls.get_fields()[prop._var_name]\n   858→        if field.required:\n   859→            default_value = prop.get_default_value()\n   860→            if default_value is not None:\n   861→                field.required = False\n   862→                field.default = default_value\n   863→        if (\n   864→            not field.required\n   865→            and field.default is None\n   866→            and not types.is_optional(prop._var_type)\n   867→        ):\n   868→            # Ensure frontend uses null coalescing when accessing.\n   869→            prop._var_type = Optional[prop._var_type]\n   870→\n   871→    @staticmethod\n   872→    def _get_base_functions() -> dict[str, FunctionType]:\n   873→        \"\"\"Get all functions of the state class excluding dunder methods.\n   874→\n   875→        Returns:\n   876→            The functions of rx.State class as a dict.\n   877→        \"\"\"\n   878→        return {\n   879→            func[0]: func[1]\n   880→            for func in inspect.getmembers(BaseState, predicate=inspect.isfunction)\n   881→            if not func[0].startswith(\"__\")\n   882→        }\n   883→\n   884→    def get_token(self) -> str:\n   885→        \"\"\"Return the token of the client associated with this state.\n   886→\n   887→        Returns:\n   888→            The token of the client.\n   889→        \"\"\"\n   890→        console.deprecate(\n   891→            feature_name=\"get_token\",\n   892→            reason=\"replaced by `State.router.session.client_token`\",\n   893→            deprecation_version=\"0.3.0\",\n   894→            removal_version=\"0.5.0\",\n   895→        )\n   896→        return self.router_data.get(constants.RouteVar.CLIENT_TOKEN, \"\")\n   897→\n   898→    def get_sid(self) -> str:\n   899→        \"\"\"Return the session ID of the client associated with this state.\n   900→\n   901→        Returns:\n   902→            The session ID of the client.\n   903→        \"\"\"\n   904→        console.deprecate(\n   905→            feature_name=\"get_sid\",\n   906→            reason=\"replaced by `State.router.session.session_id`\",\n   907→            deprecation_version=\"0.3.0\",\n   908→            removal_version=\"0.5.0\",\n   909→        )\n   910→        return self.router_data.get(constants.RouteVar.SESSION_ID, \"\")\n   911→\n   912→    def get_headers(self) -> Dict:\n   913→        \"\"\"Return the headers of the client associated with this state.\n   914→\n   915→        Returns:\n   916→            The headers of the client.\n   917→        \"\"\"\n   918→        console.deprecate(\n   919→            feature_name=\"get_headers\",\n   920→            reason=\"replaced by `State.router.headers`\",\n   921→            deprecation_version=\"0.3.0\",\n   922→            removal_version=\"0.5.0\",\n   923→        )\n   924→        return self.router_data.get(constants.RouteVar.HEADERS, {})\n   925→\n   926→    def get_client_ip(self) -> str:\n   927→        \"\"\"Return the IP of the client associated with this state.\n   928→\n   929→        Returns:\n   930→            The IP of the client.\n   931→        \"\"\"\n   932→        console.deprecate(\n   933→            feature_name=\"get_client_ip\",\n   934→            reason=\"replaced by `State.router.session.client_ip`\",\n   935→            deprecation_version=\"0.3.0\",\n   936→            removal_version=\"0.5.0\",\n   937→        )\n   938→        return self.router_data.get(constants.RouteVar.CLIENT_IP, \"\")\n   939→\n   940→    def get_current_page(self, origin=False) -> str:\n   941→        \"\"\"Obtain the path of current page from the router data.\n   942→\n   943→        Args:\n   944→            origin: whether to return the base route as shown in browser\n   945→\n   946→        Returns:\n   947→            The current page.\n   948→        \"\"\"\n   949→        console.deprecate(\n   950→            feature_name=\"get_current_page\",\n   951→            reason=\"replaced by State.router.page / self.router.page\",\n   952→            deprecation_version=\"0.3.0\",\n   953→            removal_version=\"0.5.0\",\n   954→        )\n   955→\n   956→        return self.router.page.raw_path if origin else self.router.page.path\n   957→\n   958→    def get_query_params(self) -> dict[str, str]:\n   959→        \"\"\"Obtain the query parameters for the queried page.\n   960→\n   961→        The query object contains both the URI parameters and the GET parameters.\n   962→\n   963→        Returns:\n   964→            The dict of query parameters.\n   965→        \"\"\"\n   966→        console.deprecate(\n   967→            feature_name=\"get_query_params\",\n   968→            reason=\"replaced by `State.router.page.params`\",\n   969→            deprecation_version=\"0.3.0\",\n   970→            removal_version=\"0.5.0\",\n   971→        )\n   972→        return self.router_data.get(constants.RouteVar.QUERY, {})\n   973→\n   974→    def get_cookies(self) -> dict[str, str]:\n   975→        \"\"\"Obtain the cookies of the client stored in the browser.\n   976→\n   977→        Returns:\n   978→                The dict of cookies.\n   979→        \"\"\"\n   980→        console.deprecate(\n   981→            feature_name=f\"rx.get_cookies\",\n   982→            reason=\"and has been replaced by rx.Cookie, which can be used as a state var\",\n   983→            deprecation_version=\"0.3.0\",\n   984→            removal_version=\"0.5.0\",\n   985→        )\n   986→        cookie_dict = {}\n   987→        cookies = self.get_headers().get(constants.RouteVar.COOKIE, \"\").split(\";\")\n   988→\n   989→        cookie_pairs = [cookie.split(\"=\") for cookie in cookies if cookie]\n   990→\n   991→        for pair in cookie_pairs:\n   992→            key, value = pair[0].strip(), urllib.parse.unquote(pair[1].strip())\n   993→            try:\n   994→                # cast non-string values to the actual types.\n   995→                value = json.loads(value)\n   996→            except json.JSONDecodeError:\n   997→                pass\n   998→            finally:\n   999→                cookie_dict[key] = value\n  1000→        return cookie_dict\n  1001→\n  1002→    @classmethod\n  1003→    def setup_dynamic_args(cls, args: dict[str, str]):\n  1004→        \"\"\"Set up args for easy access in renderer.\n  1005→\n  1006→        Args:\n  1007→            args: a dict of args\n  1008→        \"\"\"\n  1009→\n  1010→        def argsingle_factory(param):\n  1011→            @ComputedVar\n  1012→            def inner_func(self) -> str:\n  1013→                return self.router.page.params.get(param, \"\")\n  1014→\n  1015→            return inner_func\n  1016→\n  1017→        def arglist_factory(param):\n  1018→            @ComputedVar\n  1019→            def inner_func(self) -> List:\n  1020→                return self.router.page.params.get(param, [])\n  1021→\n  1022→            return inner_func\n  1023→\n  1024→        for param, value in args.items():\n  1025→            if value == constants.RouteArgType.SINGLE:\n  1026→                func = argsingle_factory(param)\n  1027→            elif value == constants.RouteArgType.LIST:\n  1028→                func = arglist_factory(param)\n  1029→            else:\n  1030→                continue\n  1031→            # to allow passing as a prop\n  1032→            func._var_name = param\n  1033→            cls.vars[param] = cls.computed_vars[param] = func._var_set_state(cls)  # type: ignore\n  1034→            setattr(cls, param, func)\n  1035→\n  1036→            # Reinitialize dependency tracking dicts.\n  1037→            cls._init_var_dependency_dicts()\n  1038→\n  1039→    def __getattribute__(self, name: str) -> Any:\n  1040→        \"\"\"Get the state var.\n  1041→\n  1042→        If the var is inherited, get the var from the parent state.\n  1043→\n  1044→        Args:\n  1045→            name: The name of the var.\n  1046→\n  1047→        Returns:\n  1048→            The value of the var.\n  1049→        \"\"\"\n  1050→        # If the state hasn't been initialized yet, return the default value.\n  1051→        if not super().__getattribute__(\"__dict__\"):\n  1052→            return super().__getattribute__(name)\n  1053→\n  1054→        inherited_vars = {\n  1055→            **super().__getattribute__(\"inherited_vars\"),\n  1056→            **super().__getattribute__(\"inherited_backend_vars\"),\n  1057→        }\n  1058→\n  1059→        # For now, handle router_data updates as a special case.\n  1060→        if name in inherited_vars or name == constants.ROUTER_DATA:\n  1061→            parent_state = super().__getattribute__(\"parent_state\")\n  1062→            if parent_state is not None:\n  1063→                return getattr(parent_state, name)\n  1064→\n  1065→        # Allow event handlers to be called on the instance directly.\n  1066→        event_handlers = super().__getattribute__(\"event_handlers\")\n  1067→        if name in event_handlers:\n  1068→            handler = event_handlers[name]\n  1069→            if handler.is_background:\n  1070→                fn = _no_chain_background_task(type(self), name, handler.fn)\n  1071→            else:\n  1072→                fn = functools.partial(handler.fn, self)\n  1073→            fn.__module__ = handler.fn.__module__  # type: ignore\n  1074→            fn.__qualname__ = handler.fn.__qualname__  # type: ignore\n  1075→            return fn\n  1076→\n  1077→        backend_vars = super().__getattribute__(\"_backend_vars\")\n  1078→        if name in backend_vars:\n  1079→            value = backend_vars[name]\n  1080→        else:\n  1081→            value = super().__getattribute__(name)\n  1082→\n  1083→        if isinstance(value, EventHandler):\n  1084→            # The event handler is inherited from a parent, so let the parent convert\n  1085→            # it to a callable function.\n  1086→            parent_state = super().__getattribute__(\"parent_state\")\n  1087→            if parent_state is not None:\n  1088→                return getattr(parent_state, name)\n  1089→\n  1090→        if isinstance(value, MutableProxy.__mutable_types__) and (\n  1091→            name in super().__getattribute__(\"base_vars\") or name in backend_vars\n  1092→        ):\n  1093→            # track changes in mutable containers (list, dict, set, etc)\n  1094→            return MutableProxy(wrapped=value, state=self, field_name=name)\n  1095→\n  1096→        return value\n  1097→\n  1098→    def __setattr__(self, name: str, value: Any):\n  1099→        \"\"\"Set the attribute.\n  1100→\n  1101→        If the attribute is inherited, set the attribute on the parent state.\n  1102→\n  1103→        Args:\n  1104→            name: The name of the attribute.\n  1105→            value: The value of the attribute.\n  1106→        \"\"\"\n  1107→        if isinstance(value, MutableProxy):\n  1108→            # unwrap proxy objects when assigning back to the state\n  1109→            value = value.__wrapped__\n  1110→\n  1111→        # Set the var on the parent state.\n  1112→        inherited_vars = {**self.inherited_vars, **self.inherited_backend_vars}\n  1113→        if name in inherited_vars:\n  1114→            setattr(self.parent_state, name, value)\n  1115→            return\n  1116→\n  1117→        if (\n  1118→            types.is_backend_variable(name, self.__class__)\n  1119→            and name not in RESERVED_BACKEND_VAR_NAMES\n  1120→        ):\n  1121→            self._backend_vars.__setitem__(name, value)\n  1122→            self.dirty_vars.add(name)\n  1123→            self._mark_dirty()\n  1124→            return\n  1125→\n  1126→        # Set the attribute.\n  1127→        super().__setattr__(name, value)\n  1128→\n  1129→        # Add the var to the dirty list.\n  1130→        if name in self.vars or name in self._computed_var_dependencies:\n  1131→            self.dirty_vars.add(name)\n  1132→            self._mark_dirty()\n  1133→\n  1134→        # For now, handle router_data updates as a special case\n  1135→        if name == constants.ROUTER_DATA:\n  1136→            self.dirty_vars.add(name)\n  1137→            self._mark_dirty()\n  1138→\n  1139→    def reset(self):\n  1140→        \"\"\"Reset all the base vars to their default values.\"\"\"\n  1141→        # Reset the base vars.\n  1142→        fields = self.get_fields()\n  1143→        for prop_name in self.base_vars:\n  1144→            if prop_name == constants.ROUTER:\n  1145→                continue  # never reset the router data\n  1146→            field = fields[prop_name]\n  1147→            if default_factory := field.default_factory:\n  1148→                default = default_factory()\n  1149→            else:\n  1150→                default = copy.deepcopy(field.default)\n  1151→            setattr(self, prop_name, default)\n  1152→\n  1153→        # Recursively reset the substates.\n  1154→        for substate in self.substates.values():\n  1155→            substate.reset()\n  1156→\n  1157→    def _reset_client_storage(self):\n  1158→        \"\"\"Reset client storage base vars to their default values.\"\"\"\n  1159→        # Client-side storage is reset during hydrate so that clearing cookies\n  1160→        # on the browser also resets the values on the backend.\n  1161→        fields = self.get_fields()\n  1162→        for prop_name in self.base_vars:\n  1163→            field = fields[prop_name]\n  1164→            if isinstance(field.default, ClientStorageBase) or (\n  1165→                isinstance(field.type_, type)\n  1166→                and issubclass(field.type_, ClientStorageBase)\n  1167→            ):\n  1168→                setattr(self, prop_name, copy.deepcopy(field.default))\n  1169→\n  1170→        # Recursively reset the substate client storage.\n  1171→        for substate in self.substates.values():\n  1172→            substate._reset_client_storage()\n  1173→\n  1174→    def get_substate(self, path: Sequence[str]) -> BaseState:\n  1175→        \"\"\"Get the substate.\n  1176→\n  1177→        Args:\n  1178→            path: The path to the substate.\n  1179→\n  1180→        Returns:\n  1181→            The substate.\n  1182→\n  1183→        Raises:\n  1184→            ValueError: If the substate is not found.\n  1185→        \"\"\"\n  1186→        if len(path) == 0:\n  1187→            return self\n  1188→        if path[0] == self.get_name():\n  1189→            if len(path) == 1:\n  1190→                return self\n  1191→            path = path[1:]\n  1192→        if path[0] not in self.substates:\n  1193→            raise ValueError(f\"Invalid path: {path}\")\n  1194→        return self.substates[path[0]].get_substate(path[1:])\n  1195→\n  1196→    @classmethod\n  1197→    def _get_common_ancestor(cls, other: Type[BaseState]) -> str:\n  1198→        \"\"\"Find the name of the nearest common ancestor shared by this and the other state.\n  1199→\n  1200→        Args:\n  1201→            other: The other state.\n  1202→\n  1203→        Returns:\n  1204→            Full name of the nearest common ancestor.\n  1205→        \"\"\"\n  1206→        common_ancestor_parts = []\n  1207→        for part1, part2 in zip(\n  1208→            cls.get_full_name().split(\".\"),\n  1209→            other.get_full_name().split(\".\"),\n  1210→        ):\n  1211→            if part1 != part2:\n  1212→                break\n  1213→            common_ancestor_parts.append(part1)\n  1214→        return \".\".join(common_ancestor_parts)\n  1215→\n  1216→    @classmethod\n  1217→    def _determine_missing_parent_states(\n  1218→        cls, target_state_cls: Type[BaseState]\n  1219→    ) -> tuple[str, list[str]]:\n  1220→        \"\"\"Determine the missing parent states between the target_state_cls and common ancestor of this state.\n  1221→\n  1222→        Args:\n  1223→            target_state_cls: The class of the state to find missing parent states for.\n  1224→\n  1225→        Returns:\n  1226→            The name of the common ancestor and the list of missing parent states.\n  1227→        \"\"\"\n  1228→        common_ancestor_name = cls._get_common_ancestor(target_state_cls)\n  1229→        common_ancestor_parts = common_ancestor_name.split(\".\")\n  1230→        target_state_parts = tuple(target_state_cls.get_full_name().split(\".\"))\n  1231→        relative_target_state_parts = target_state_parts[len(common_ancestor_parts) :]\n  1232→\n  1233→        # Determine which parent states to fetch from the common ancestor down to the target_state_cls.\n  1234→        fetch_parent_states = [common_ancestor_name]\n  1235→        for relative_parent_state_name in relative_target_state_parts:\n  1236→            fetch_parent_states.append(\n  1237→                \".\".join((fetch_parent_states[-1], relative_parent_state_name))\n  1238→            )\n  1239→\n  1240→        return common_ancestor_name, fetch_parent_states[1:-1]\n  1241→\n  1242→    def _get_parent_states(self) -> list[tuple[str, BaseState]]:\n  1243→        \"\"\"Get all parent state instances up to the root of the state tree.\n  1244→\n  1245→        Returns:\n  1246→            A list of tuples containing the name and the instance of each parent state.\n  1247→        \"\"\"\n  1248→        parent_states_with_name = []\n  1249→        parent_state = self\n  1250→        while parent_state.parent_state is not None:\n  1251→            parent_state = parent_state.parent_state\n  1252→            parent_states_with_name.append((parent_state.get_full_name(), parent_state))\n  1253→        return parent_states_with_name\n  1254→\n  1255→    async def _populate_parent_states(self, target_state_cls: Type[BaseState]):\n  1256→        \"\"\"Populate substates in the tree between the target_state_cls and common ancestor of this state.\n  1257→\n  1258→        Args:\n  1259→            target_state_cls: The class of the state to populate parent states for.\n  1260→\n  1261→        Returns:\n  1262→            The parent state instance of target_state_cls.\n  1263→\n  1264→        Raises:\n  1265→            RuntimeError: If redis is not used in this backend process.\n  1266→        \"\"\"\n  1267→        state_manager = get_state_manager()\n  1268→        if not isinstance(state_manager, StateManagerRedis):\n  1269→            raise RuntimeError(\n  1270→                f\"Cannot populate parent states of {target_state_cls.get_full_name()} without redis. \"\n  1271→                \"(All states should already be available -- this is likely a bug).\",\n  1272→            )\n  1273→\n  1274→        # Find the missing parent states up to the common ancestor.\n  1275→        (\n  1276→            common_ancestor_name,\n  1277→            missing_parent_states,\n  1278→        ) = self._determine_missing_parent_states(target_state_cls)\n  1279→\n  1280→        # Fetch all missing parent states and link them up to the common ancestor.\n  1281→        parent_states_tuple = self._get_parent_states()\n  1282→        root_state = parent_states_tuple[-1][1]\n  1283→        parent_states_by_name = dict(parent_states_tuple)\n  1284→        parent_state = parent_states_by_name[common_ancestor_name]\n  1285→        for parent_state_name in missing_parent_states:\n  1286→            try:\n  1287→                parent_state = root_state.get_substate(parent_state_name.split(\".\"))\n  1288→                # The requested state is already cached, do NOT fetch it again.\n  1289→                continue\n  1290→            except ValueError:\n  1291→                # The requested state is missing, fetch from redis.\n  1292→                pass\n  1293→            parent_state = await state_manager.get_state(\n  1294→                token=_substate_key(\n  1295→                    self.router.session.client_token, parent_state_name\n  1296→                ),\n  1297→                top_level=False,\n  1298→                get_substates=False,\n  1299→                parent_state=parent_state,\n  1300→            )\n  1301→\n  1302→        # Return the direct parent of target_state_cls for subsequent linking.\n  1303→        return parent_state\n  1304→\n  1305→    def _get_state_from_cache(self, state_cls: Type[BaseState]) -> BaseState:\n  1306→        \"\"\"Get a state instance from the cache.\n  1307→\n  1308→        Args:\n  1309→            state_cls: The class of the state.\n  1310→\n  1311→        Returns:\n  1312→            The instance of state_cls associated with this state's client_token.\n  1313→        \"\"\"\n  1314→        if self.parent_state is None:\n  1315→            root_state = self\n  1316→        else:\n  1317→            root_state = self._get_parent_states()[-1][1]\n  1318→        return root_state.get_substate(state_cls.get_full_name().split(\".\"))\n  1319→\n  1320→    async def _get_state_from_redis(self, state_cls: Type[BaseState]) -> BaseState:\n  1321→        \"\"\"Get a state instance from redis.\n  1322→\n  1323→        Args:\n  1324→            state_cls: The class of the state.\n  1325→\n  1326→        Returns:\n  1327→            The instance of state_cls associated with this state's client_token.\n  1328→\n  1329→        Raises:\n  1330→            RuntimeError: If redis is not used in this backend process.\n  1331→        \"\"\"\n  1332→        # Fetch all missing parent states from redis.\n  1333→        parent_state_of_state_cls = await self._populate_parent_states(state_cls)\n  1334→\n  1335→        # Then get the target state and all its substates.\n  1336→        state_manager = get_state_manager()\n  1337→        if not isinstance(state_manager, StateManagerRedis):\n  1338→            raise RuntimeError(\n  1339→                f\"Requested state {state_cls.get_full_name()} is not cached and cannot be accessed without redis. \"\n  1340→                \"(All states should already be available -- this is likely a bug).\",\n  1341→            )\n  1342→        return await state_manager.get_state(\n  1343→            token=_substate_key(self.router.session.client_token, state_cls),\n  1344→            top_level=False,\n  1345→            get_substates=True,\n  1346→            parent_state=parent_state_of_state_cls,\n  1347→        )\n  1348→\n  1349→    async def get_state(self, state_cls: Type[BaseState]) -> BaseState:\n  1350→        \"\"\"Get an instance of the state associated with this token.\n  1351→\n  1352→        Allows for arbitrary access to sibling states from within an event handler.\n  1353→\n  1354→        Args:\n  1355→            state_cls: The class of the state.\n  1356→\n  1357→        Returns:\n  1358→            The instance of state_cls associated with this state's client_token.\n  1359→        \"\"\"\n  1360→        # Fast case - if this state instance is already cached, get_substate from root state.\n  1361→        try:\n  1362→            return self._get_state_from_cache(state_cls)\n  1363→        except ValueError:\n  1364→            pass\n  1365→\n  1366→        # Slow case - fetch missing parent states from redis.\n  1367→        return await self._get_state_from_redis(state_cls)\n  1368→\n  1369→    def _get_event_handler(\n  1370→        self, event: Event\n  1371→    ) -> tuple[BaseState | StateProxy, EventHandler]:\n  1372→        \"\"\"Get the event handler for the given event.\n  1373→\n  1374→        Args:\n  1375→            event: The event to get the handler for.\n  1376→\n  1377→\n  1378→        Returns:\n  1379→            The event handler.\n  1380→\n  1381→        Raises:\n  1382→            ValueError: If the event handler or substate is not found.\n  1383→        \"\"\"\n  1384→        # Get the event handler.\n  1385→        path = event.name.split(\".\")\n  1386→        path, name = path[:-1], path[-1]\n  1387→        substate = self.get_substate(path)\n  1388→        if not substate:\n  1389→            raise ValueError(\n  1390→                \"The value of state cannot be None when processing an event.\"\n  1391→            )\n  1392→        handler = substate.event_handlers[name]\n  1393→\n  1394→        # For background tasks, proxy the state\n  1395→        if handler.is_background:\n  1396→            substate = StateProxy(substate)\n  1397→\n  1398→        return substate, handler\n  1399→\n  1400→    async def _process(self, event: Event) -> AsyncIterator[StateUpdate]:\n  1401→        \"\"\"Obtain event info and process event.\n  1402→\n  1403→        Args:\n  1404→            event: The event to process.\n  1405→\n  1406→        Yields:\n  1407→            The state update after processing the event.\n  1408→        \"\"\"\n  1409→        # Get the event handler.\n  1410→        substate, handler = self._get_event_handler(event)\n  1411→\n  1412→        # Run the event generator and yield state updates.\n  1413→        async for update in self._process_event(\n  1414→            handler=handler,\n  1415→            state=substate,\n  1416→            payload=event.payload,\n  1417→        ):\n  1418→            yield update\n  1419→\n  1420→    def _check_valid(self, handler: EventHandler, events: Any) -> Any:\n  1421→        \"\"\"Check if the events yielded are valid. They must be EventHandlers or EventSpecs.\n  1422→\n  1423→        Args:\n  1424→            handler: EventHandler.\n  1425→            events: The events to be checked.\n  1426→\n  1427→        Raises:\n  1428→            TypeError: If any of the events are not valid.\n  1429→\n  1430→        Returns:\n  1431→            The events as they are if valid.\n  1432→        \"\"\"\n  1433→\n  1434→        def _is_valid_type(events: Any) -> bool:\n  1435→            return isinstance(events, (Event, EventHandler, EventSpec))\n  1436→\n  1437→        if events is None or _is_valid_type(events):\n  1438→            return events\n  1439→        try:\n  1440→            if all(_is_valid_type(e) for e in events):\n  1441→                return events\n  1442→        except TypeError:\n  1443→            pass\n  1444→\n  1445→        raise TypeError(\n  1446→            f\"Your handler {handler.fn.__qualname__} must only return/yield: None, Events or other EventHandlers referenced by their class (not using `self`)\"\n  1447→        )\n  1448→\n  1449→    def _as_state_update(\n  1450→        self,\n  1451→        handler: EventHandler,\n  1452→        events: EventSpec | list[EventSpec] | None,\n  1453→        final: bool,\n  1454→    ) -> StateUpdate:\n  1455→        \"\"\"Convert the events to a StateUpdate.\n  1456→\n  1457→        Fixes the events and checks for validity before converting.\n  1458→\n  1459→        Args:\n  1460→            handler: The handler where the events originated from.\n  1461→            events: The events to queue with the update.\n  1462→            final: Whether the handler is done processing.\n  1463→\n  1464→        Returns:\n  1465→            The valid StateUpdate containing the events and final flag.\n  1466→        \"\"\"\n  1467→        # get the delta from the root of the state tree\n  1468→        state = self\n  1469→        while state.parent_state is not None:\n  1470→            state = state.parent_state\n  1471→\n  1472→        token = self.router.session.client_token\n  1473→\n  1474→        # Convert valid EventHandler and EventSpec into Event\n  1475→        fixed_events = fix_events(self._check_valid(handler, events), token)\n  1476→\n  1477→        # Get the delta after processing the event.\n  1478→        delta = state.get_delta()\n  1479→        state._clean()\n  1480→\n  1481→        return StateUpdate(\n  1482→            delta=delta,\n  1483→            events=fixed_events,\n  1484→            final=final if not handler.is_background else True,\n  1485→        )\n  1486→\n  1487→    async def _process_event(\n  1488→        self, handler: EventHandler, state: BaseState | StateProxy, payload: Dict\n  1489→    ) -> AsyncIterator[StateUpdate]:\n  1490→        \"\"\"Process event.\n  1491→\n  1492→        Args:\n  1493→            handler: EventHandler to process.\n  1494→            state: State to process the handler.\n  1495→            payload: The event payload.\n  1496→\n  1497→        Yields:\n  1498→            StateUpdate object\n  1499→        \"\"\"\n  1500→        # Get the function to process the event.\n  1501→        fn = functools.partial(handler.fn, state)\n  1502→\n  1503→        # Wrap the function in a try/except block.\n  1504→        try:\n  1505→            # Handle async functions.\n  1506→            if asyncio.iscoroutinefunction(fn.func):\n  1507→                events = await fn(**payload)\n  1508→\n  1509→            # Handle regular functions.\n  1510→            else:\n  1511→                events = fn(**payload)\n  1512→            # Handle async generators.\n  1513→            if inspect.isasyncgen(events):\n  1514→                async for event in events:\n  1515→                    yield state._as_state_update(handler, event, final=False)\n  1516→                yield state._as_state_update(handler, events=None, final=True)\n  1517→\n  1518→            # Handle regular generators.\n  1519→            elif inspect.isgenerator(events):\n  1520→                try:\n  1521→                    while True:\n  1522→                        yield state._as_state_update(handler, next(events), final=False)\n  1523→                except StopIteration as si:\n  1524→                    # the \"return\" value of the generator is not available\n  1525→                    # in the loop, we must catch StopIteration to access it\n  1526→                    if si.value is not None:\n  1527→                        yield state._as_state_update(handler, si.value, final=False)\n  1528→                yield state._as_state_update(handler, events=None, final=True)\n  1529→\n  1530→            # Handle regular event chains.\n  1531→            else:\n  1532→                yield state._as_state_update(handler, events, final=True)\n  1533→\n  1534→        # If an error occurs, throw a window alert.\n  1535→        except Exception:\n  1536→            error = traceback.format_exc()\n  1537→            print(error)\n  1538→            yield state._as_state_update(\n  1539→                handler,\n  1540→                window_alert(\"An error occurred. See logs for details.\"),\n  1541→                final=True,\n  1542→            )\n  1543→\n  1544→    def _mark_dirty_computed_vars(self) -> None:\n  1545→        \"\"\"Mark ComputedVars that need to be recalculated based on dirty_vars.\"\"\"\n  1546→        dirty_vars = self.dirty_vars\n  1547→        while dirty_vars:\n  1548→            calc_vars, dirty_vars = dirty_vars, set()\n  1549→            for cvar in self._dirty_computed_vars(from_vars=calc_vars):\n  1550→                self.dirty_vars.add(cvar)\n  1551→                dirty_vars.add(cvar)\n  1552→                actual_var = self.computed_vars.get(cvar)\n  1553→                if actual_var is not None:\n  1554→                    actual_var.mark_dirty(instance=self)\n  1555→\n  1556→    def _dirty_computed_vars(self, from_vars: set[str] | None = None) -> set[str]:\n  1557→        \"\"\"Determine ComputedVars that need to be recalculated based on the given vars.\n  1558→\n  1559→        Args:\n  1560→            from_vars: find ComputedVar that depend on this set of vars. If unspecified, will use the dirty_vars.\n  1561→\n  1562→        Returns:\n  1563→            Set of computed vars to include in the delta.\n  1564→        \"\"\"\n  1565→        return set(\n  1566→            cvar\n  1567→            for dirty_var in from_vars or self.dirty_vars\n  1568→            for cvar in self._computed_var_dependencies[dirty_var]\n  1569→        )\n  1570→\n  1571→    @classmethod\n  1572→    def _potentially_dirty_substates(cls) -> set[Type[BaseState]]:\n  1573→        \"\"\"Determine substates which could be affected by dirty vars in this state.\n  1574→\n  1575→        Returns:\n  1576→            Set of State clas