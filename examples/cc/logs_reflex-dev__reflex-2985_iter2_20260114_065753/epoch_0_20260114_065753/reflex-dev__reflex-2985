        # Add args to the event specs if necessary.\n   434→        events = [e.with_args(get_handler_args(e)) for e in events]\n   435→\n   436→        # Collect event_actions from each spec\n   437→        event_actions = {}\n   438→        for e in events:\n   439→            event_actions.update(e.event_actions)\n   440→\n   441→        # Return the event chain.\n   442→        if isinstance(args_spec, Var):\n   443→            return EventChain(\n   444→                events=events,\n   445→                args_spec=None,\n   446→                event_actions=event_actions,\n   447→            )\n   448→        else:\n   449→            return EventChain(\n   450→                events=events,\n   451→                args_spec=args_spec,\n   452→                event_actions=event_actions,\n   453→            )\n   454→\n   455→    def get_event_triggers(self) -> Dict[str, Any]:\n   456→        \"\"\"Get the event triggers for the component.\n   457→\n   458→        Returns:\n   459→            The event triggers.\n   460→        \"\"\"\n   461→        default_triggers = {\n   462→            EventTriggers.ON_FOCUS: lambda: [],\n   463→            EventTriggers.ON_BLUR: lambda: [],\n   464→            EventTriggers.ON_CLICK: lambda: [],\n   465→            EventTriggers.ON_CONTEXT_MENU: lambda: [],\n   466→            EventTriggers.ON_DOUBLE_CLICK: lambda: [],\n   467→            EventTriggers.ON_MOUSE_DOWN: lambda: [],\n   468→            EventTriggers.ON_MOUSE_ENTER: lambda: [],\n   469→            EventTriggers.ON_MOUSE_LEAVE: lambda: [],\n   470→            EventTriggers.ON_MOUSE_MOVE: lambda: [],\n   471→            EventTriggers.ON_MOUSE_OUT: lambda: [],\n   472→            EventTriggers.ON_MOUSE_OVER: lambda: [],\n   473→            EventTriggers.ON_MOUSE_UP: lambda: [],\n   474→            EventTriggers.ON_SCROLL: lambda: [],\n   475→            EventTriggers.ON_MOUNT: lambda: [],\n   476→            EventTriggers.ON_UNMOUNT: lambda: [],\n   477→      