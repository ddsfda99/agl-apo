803→class State(BaseState):\n  1804→    \"\"\"The app Base State.\"\"\"\n  1805→\n  1806→    # The hydrated bool.\n  1807→    is_hydrated: bool = False\n  1808→\n  1809→\n  1810→class UpdateVarsInternalState(State):\n  1811→    \"\"\"Substate for handling internal state var updates.\"\"\"\n  1812→\n  1813→    async def update_vars_internal(self, vars: dict[str, Any]) -> None:\n  1814→        \"\"\"Apply updates to fully qualified state vars.\n  1815→\n  1816→        The keys in `vars` should be in the form of `{state.get_full_name()}.{var_name}`,\n  1817→        and each value will be set on the appropriate substate instance.\n  1818→\n  1819→        This function is primarily used to apply cookie and local storage\n  1820→        updates from the frontend to the appropriate substate.\n  1821→\n  1822→        Args:\n  1823→            vars: The fully qualified vars and values to update.\n  1824→        \"\"\"\n  1825→        for var, value in vars.items():\n  1826→            state_name, _, var_name = var.rpartition(\".\")\n  1827→            var_state_cls = State.get_class_substate(state_name)\n  1828→            var_state = await self.get_state(var_state_cls)\n  1829→            setattr(var_state, var_name, value)\n  1830→\n  1831→\n  1832→class OnLoadInternalState(State):\n  1833→    \"\"\"Substate for handling on_load event enumeration.\n  1834→\n  1835→    This is a separate substate to avoid deserializing the entire state tree for every page navigation.\n  1836→    \"\"\"\n  1837→\n  1838→    def on_load_internal(self) -> list[Event | EventSpec] | None:\n  1839→        \"\"\"Queue on_load handlers for the current page.\n  1840→\n  1841→        Returns:\n  1842→            The list of events to queue for on load handling.\n  1843→        \"\"\"\n  1844→        # Do not app.compile_()!  It should be already compiled by now.\n  1845→        app = getattr(prerequisites.get_app(), constants.CompileVars.APP)\n  1846→        load_events = app.get_load_events(self.router.page.path)\n  1847→        if not load_events:\n  1848→            self.is_hydrated = True\n  1849→            return  # Fast path for navigation with no on_load events defined.\n  1850→        self.is_hydrated = False\n  1851→        return [\n  1852→            *fix_events(\n  1853→                load_events,\n  1854→                self.router.session.client_token,\n  1855→                router_data=self.router_data,\n  1856→            ),\n  1857→            State.set_is_hydrated(True),  # type: ignore\n  1858→        ]\n  1859→\n  1860→\n  1861→class ComponentState(Base):\n  1862→    \"\"\"The base class for a State that is copied for each Component associated with it.\"\"\"\n  1863→\n  1864→    _per_component_state_instance_count: ClassVar[int] = 0\n  1865→\n  1866→    @classmethod\n  1867→    def get_component(cls, *children, **props) -> \"Component\":\n  1868→        \"\"\"Get the component instance.\n  1869→\n  1870→        Args:\n  1871→            children: The children of the component.\n  1872→            props: The props of the component.\n  1873→\n  1874→        Raises:\n  1875→            NotImplementedError: if the subclass does not override this method.\n  1876→        \"\"\"\n  1877→        raise NotImplementedError(\n  1878→            f\"{cls.__name__} must implement get_component to return the component instance.\"\n  1879→        )\n  1880→\n  1881→    @classmethod\n  1882→    def create(cls, *children, **props) -> \"Component\":\n  1883→        \"\"\"Create a new instance of the Component.\n  1884→\n  1885→        Args:\n  1886→            children: The children of the component.\n  1887→            props: The props of the component.\n  1888→\n  1889→        Returns:\n  1890→            A new instance of the Component with an independent copy of the State.\n  1891→        \"\"\"\n  1892→        cls._per_component_state_instance_count += 1\n  1893→        state_cls_name = f\"{cls.__name__}_n{cls._per_component_state_instance_count}\"\n  1894→        component_state = type(state_cls_name, (cls, State), {})\n  1895→        component = component_state.get_component(*children, **props)\n  1896→        component.State = component_state\n  1897→        return component\n  1898→\n  1899→\n  1900→class StateProxy(wrapt.ObjectProxy):\n  1901→    \"\"\"Proxy of a state instance to control mutability of vars for a background task.\n  1902→\n  1903→    Since a background task runs against a state instance without holding the\n  1904→    state_manager lock for the token, the reference may become stale if the same\n  1905→    state is modified by another event handler.\n  1906→\n  1907→    The proxy object ensures that writes to the state are blocked unless\n  1908→    explicitly entering a context which refreshes the state from state_manager\n  1909→    and holds the lock for the token until exiting the context. After exiting\n  1910→    the context, a StateUpdate may be emitted to the frontend to notify the\n  1911→    client of the state change.\n  1912→\n  1913→    A background task will be passed the `StateProxy` as `self`, so mutability\n  1914→    can be safely performed inside an `async with self` block.\n  1915→\n  1916→        class State(rx.State):\n  1917→            counter: int = 0\n  1918→\n  1919→            @rx.background\n  1920→            async def bg_increment(self):\n  1921→                await asyncio.sleep(1)\n  1922→                async with self:\n  1923→                    self.counter += 1\n  1924→    \"\"\"\n  1925→\n  1926→    def __init__(self, state_instance):\n  1927→        \"\"\"Create a proxy for a state instance.\n  1928→\n  1929→        Args:\n  1930→            state_instance: The state instance to proxy.\n  1931→        \"\"\"\n  1932→        super().__init__(state_instance)\n  1933→        # compile is not relevant to backend logic\n  1934→        self._self_app = getattr(prerequisites.get_app(), constants.CompileVars.APP)\n  1935→        self._self_substate_path = state_instance.get_full_name().split(\".\")\n  1936→        self._self_actx = None\n  1937→        self._self_mutable = False\n  1938→\n  1939→    async def __aenter__(self) -> StateProxy:\n  1940→        \"\"\"Enter the async context manager protocol.\n  1941→\n  1942→        Sets mutability to True and enters the `App.modify_state` async context,\n  1943→        which refreshes the state from state_manager and holds the lock for the\n  1944→        given state token until exiting the context.\n  1945→\n  1946→        Background tasks should avoid blocking calls while inside the context.\n  1947→\n  1948→        Returns:\n  1949→            This StateProxy instance in mutable mode.\n  1950→        \"\"\"\n  1951→        self._self_actx = self._self_app.modify_state(\n  1952→            token=_substate_key(\n  1953→                self.__wrapped__.router.session.client_token,\n  1954→                self._self_substate_path,\n  1955→            )\n  1956→        )\n  1957→        mutable_state = await self._self_actx.__aenter__()\n  1958→        super().__setattr__(\n  1959→            \"__wrapped__\", mutable_state.get_substate(self._self_substate_path)\n  1960→        )\n  1961→        self._self_mutable = True\n  1962→        return self\n  1963→\n  1964→    async def __aexit__(self, *exc_info: Any) -> None:\n  1965→        \"\"\"Exit the async context manager protocol.\n  1966→\n  1967→        Sets proxy mutability to False and persists any state changes.\n  1968→\n  1969→        Args:\n  1970→            exc_info: The exception info tuple.\n  1971→        \"\"\"\n  1972→        if self._self_actx is None:\n  1973→            return\n  1974→        self._self_mutable = False\n  1975→        await self._self_actx.__aexit__(*exc_info)\n  1976→        self._self_actx = None\n  1977→\n  1978→    def __enter__(self):\n  1979→        \"\"\"Enter the regular context manager protocol.\n  1980→\n  1981→        This is not supported for background tasks, and exists only to ra