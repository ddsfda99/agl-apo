ile\n   131→\n   132→    def as_data(self):\n   133→        \"\"\"If obj[%data_key_name] exists, Return obj[%data_key_name] otherwise\n   134→        base64 encoded string of obj[%file_key_name] file content.\"\"\"\n   135→        use_file_if_no_data = not self._data and self._file\n   136→        if use_file_if_no_data:\n   137→            with open(self._file) as f:\n   138→                if self._base64_file_content:\n   139→                    self._data = bytes.decode(\n   140→                        base64.standard_b64encode(str.encode(f.read())))\n   141→                else:\n   142→                    self._data = f.read()\n   143→        return self._data\n   144→\n   145→\n   146→class CommandTokenSource(object):\n   147→    def __init__(self, cmd, args, tokenKey, expiryKey):\n   148→        self._cmd = cmd\n   149→        self._args = args\n   150→        if not tokenKey:\n   151→            self._tokenKey = '{.access_token}'\n   152→        else:\n   153→            self._tokenKey = tokenKey\n   154→        if not expiryKey:\n   155→            self._expiryKey = '{.token_expiry}'\n   156→        else:\n   157→            self._expiryKey = expiryKey\n   158→\n   159→    def token(self):\n   160→        fullCmd = self._cmd + (\" \") + \" \".join(self._args)\n   161→        process = subprocess.Popen(\n   162→            [self._cmd] + self._args,\n   163→            stdout=subprocess.PIPE,\n   164→            stderr=subprocess.PIPE,\n   165→            universal_newlines=True)\n   166→        (stdout, stderr) = process.communicate()\n   167→        exit_code = process.wait()\n   168→        if exit_code != 0:\n   169→            msg = 'cmd-path: process returned %d' % exit_code\n   170→            msg += \"\\nCmd: %s\" % fullCmd\n   171→            stderr = stderr.strip()\n   172→            if stderr:\n   173→                msg += '\\nStderr: %s' % stderr\n   174→            raise ConfigException(msg)\n   175→        try:\n   176→            data = json