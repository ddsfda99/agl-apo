ee.get(\"displayName\", \"\") or assignee.get(\n   442→                \"name\", \"\"\n   443→            )\n   444→\n   445→        # Add epic information\n   446→        if epic_info[\"is_epic\"]:\n   447→            metadata[\"is_epic\"] = True\n   448→            metadata[\"epic_name\"] = epic_info[\"epic_name\"]\n   449→        elif epic_info[\"epic_key\"]:\n   450→            metadata[\"epic_key\"] = epic_info[\"epic_key\"]\n   451→            metadata[\"epic_name\"] = epic_info[\"epic_name\"]\n   452→            metadata[\"epic_summary\"] = epic_info[\"epic_summary\"]\n   453→\n   454→        # Add comment count\n   455→        metadata[\"comment_count\"] = len(comments)\n   456→\n   457→        return metadata\n   458→\n   459→    def create_issue(\n   460→        self,\n   461→        project_key: str,\n   462→        summary: str,\n   463→        issue_type: str,\n   464→        description: str = \"\",\n   465→        assignee: str | None = None,\n   466→        components: list[str] | None = None,\n   467→        **kwargs: Any,  # noqa: ANN401 - Dynamic field types are necessary for Jira API\n   468→    ) -> JiraIssue:\n   469→        \"\"\"\n   470→        Create a new Jira issue.\n   471→\n   472→        Args:\n   473→            project_key: The key of the project\n   474→            summary: The issue summary\n   475→            issue_type: The type of issue to create\n   476→            description: The issue description\n   477→            assignee: The username or account ID of the assignee\n   478→            components: List of component names to assign (e.g., [\"Frontend\", \"API\"])\n   479→            **kwargs: Additional fields to set on the issue\n   480→\n   481→        Returns:\n   482→            JiraIssue model representing the created issue\n   483→\n   484→        Raises:\n   485→            Exception: If there is an error creating the issue\n   486→        \"\"\"\n   487→        try:\n   488→            # Validate required fields\n   489→            if not project_key:\n   490→                raise ValueError(\"Project key is required\")\n   491→            if not summary:\n   492→                raise ValueError(\"Summary is required\")\n   493→            if not issue_type:\n   494→                raise ValueError(\"Issue type is required\")\n   495→\n   496→            # Prepare fields\n   497→            fields: dict[str, Any] = {\n   498→                \"project\": {\"key\": project_key},\n   499→                \"summary\": summary,\n   500→                \"issuetype\": {\"name\": issue_type},\n   501→            }\n   502→\n   503→            # Add description if provided\n   504→            if description:\n   505→                fields[\"description\"] = description\n   506→\n   507→            # Add assignee if provided\n   508→            if assignee:\n   509→                try:\n   510→                    # _get_account_id now returns the correct identifier (accountId for cloud, name for server)\n   511→                    assignee_identifier = self._get_account_id(assignee)\n   512→                    self._add_assignee_to_fields(fields, assignee_identifier)\n   513→                except ValueError as e:\n   514→                    logger.warning(f\"Could not assign issue: {str(e)}\")\n   515→\n   516→            # Add components if provided\n   517→            if components:\n   518→                if isinstance(components, list):\n   519→                    # Filter out any None or empty/whitespace-only strings\n   520→                    valid_components = [\n   521→                        comp_name.strip()\n   522→                        for comp_name in components\n   523→                        if isinstance(comp_name, str) and comp_name.strip()\n   524→                    ]\n   525→                    if valid_components:\n   526→                        # Format as list of {\"name\": ...} dicts for the API\n   527→                        fields[\"components\"] = [\n   528→                            {\"name\": comp_name} for comp_name in valid_components\n   529→                        ]\n   530→\n   531→            # Make a copy of kwargs to preserve original values for two-step Epic creation\n   532→            kwargs_copy = kwargs.copy()\n   533→\n   534→            # Prepare epic fields if this is an epic\n   535→            # This step now stores epic-specific fields in kwargs for post-creation update\n   536→            if issue_type.lower() == \"epic\":\n   537→                self._prepare_epic_fields(fields, summary, kwargs)\n   538→\n   539→            # Prepare parent field if this is a subtask\n   540→            if issue_type.lower() == \"subtask\" or issue_type.lower() == \"sub-task\":\n   541→                self._prepare_parent_fields(fields, kwargs)\n   542→            # Allow parent field for all issue types when explicitly provided\n   543→            elif \"parent\" in kwargs:\n   544→                self._prepare_parent_fields(fields, kwargs)\n   545→\n   546→            # Add custom fields\n   547→            self._add_custom_fields(fields, kwargs)\n   548→\n   549→            # Create the issue\n   550→            response = self.jira.create_issue(fields=fields)\n   551→\n   552→            # Get the created issue key\n   553→            issue_key = response.get(\"key\")\n   554→            if not issue_key:\n   555→                error_msg = \"No issue key in response\"\n   556→                raise ValueError(error_msg)\n   557\n   558→            # For Epics, perform the second step: update Epic-specific fields\n   559→            if issue_type.lower() == \"epic\":\n   560→                # Check if we have any stored Epic fields to update\n   561→                has_epic_fields = any(k.startswith(\"__epic_\") for k in kwargs)\n   562→                if has_epic_fields:\n   563→                    logger.info(\n   564→                        f\"Performing post-creation update for Epic {issue_key} with Epic-specific fields\"\n   565→                    )\n   566→                    try:\n   567→                        # Delegate to EpicsMixin.update_epic_fields\n   568→                        from mcp_atlassian.jira.epics import EpicsMixin\n   569→\n   570→                        return EpicsMixin.update_epic_fields(self, issue_key, kwargs)\n   571→                    except Exception as update_error:\n   572→                        logger.error(\n   573→                            f\"Error during post-creation update of Epic {issue_key}: {str(update_error)}\"\n   574→                        )\n   575→                        logger.info(\n   576→                            \"Continuing with the original Epic that was successfully created\"\n   577→                        )\n   578→\n   579→            # Get the full issue data and convert to JiraIssue model\n   580→            issue_data = self.jira.get_issue(issue_key)\n   581→            return JiraIssue.from_api_response(issue_data)\n   582→\n   583→        except Exception as e:\n   584→            self._handle_create_issue_error(e, issue_type)\n   585→            raise  # Re-raise after logging\n   586→\n   587→    def _prepare_epic_fields(\n   588→        self, fields: dict[str, Any], summary: str, kwargs: dict[str, Any]\n   589→    ) -> None:\n   590→        \"\"\"\n   591→        Prepare fields for epic creation.\n   592→\n   593→        This method delegates to the prepare_epic_fields method in EpicsMixin.\n   594→\n   595→        Args:\n   596→            fields: The fields dictionary to update\n   597→            summary: The epic summary\n   598→            kwargs: Additional fields from the user\n   599→        \"\"\"\n   600→        # Delegate to EpicsMixin.prepare_epic_fields\n   601→        # Since JiraFetcher inherits from both IssuesMixin and EpicsMixin,\n   602→        # this will correctly use the prepare_epic_fields method from EpicsMixin\n   603→        # which implements the two-step Epic creation approach\n   604→        from mcp_atlassian.jira.epics import EpicsMixin\n   605→\n   606→        EpicsMixin.prepare_epic_fields(self, fields, summary, kwargs)\n   607→\n   608→    def _prepare_parent_fields(\n   609→        self, fields: dict[str, Any], kwargs: dict[str, Any]\n   610→    ) -> None:\n   611→        \"\"\"\n   612→        Prepare fields for parent relationship.\n   613→\n   614→        Args:\n   615→            fields: The fields dictionary to update\n   616→            kwargs: Additional fields from the user\n   617→\n   618→        Raises:\n   619→            ValueError: If parent issue key is not specified for a subtask\n   620→        \"\"\"\n   621→        if \"parent\" in kwargs:\n   622→            parent_key = kwargs.get(\"parent\")\n   623→            if parent_key:\n   624→                fields[\"parent\"] = {\"key\": parent_key}\n   625→            # Remove parent from kwargs to avoid double processing\n   626→            kwargs.pop(\"parent\", None)\n   627→        elif \"issuetype\" in fields and fields[\"issuetype\"][\"name\"].lower() in (\n   628→            \"subtask\",\n   629→            \"sub-task\",\n   630→        ):\n   631→            # Only raise error if issue type is subtask and parent is missing\n   632→            raise ValueError(\n   633→                \"Issue type is a sub-task but parent issue key or id not specified. Please provide a 'parent' parameter with the parent issue key.\"\n   634→            )\n   635→\n   636→    def _add_assignee_to_fields(self, fields: dict[str, Any], assignee: str) -> None:\n   637→        \"\"\"\n   638→        Add assignee to issue fields.\n   639→\n   640→        Args:\n   641→            fields: The fields dictionary to update\n   642→            assignee: The assignee account ID\n   643→        \"\"\"\n   644→        # Cloud instance uses accountId\n   645→        if self.config.is_cloud:\n   646→            fields[\"assignee\"] = {\"accountId\": assignee}\n   647→        else:\n   648→            # Server/DC might use name instead of accountId\n   649→            fields[\"assignee\"] = {\"name\": assignee}\n   650→\n   651→    def _add_custom_fields(\n   652→        self, fields: dict[str, Any], kwargs: dict[str, Any]\n   653→    ) -> None:\n   654→        \"\"\"\n   655→        Add custom fields to issue.\n   656→\n   657→        Args:\n   658→            fields: The fields dictionary to update\n   659→            kwargs: Additional fields from the user\n   660→        \"\"\"\n   661→        field_ids = self.get_jira_field_ids()\n   662→\n   663→        # Process each kwarg\n   664→        for key, value in kwargs.items():\n   665→            # Handle fixVersions specifically as it's a standard field often required\n   666→            if key.lower() == \"fixversions\":\n   667→                fields[\"fixVersions\"] = value\n   668→                logger.debug(\"Added fixVersions from additional_fields: %s\", value)\n   669→                continue  # Handled fixVersions\n   670→\n   671→            # Explicitly handle components field\n   672→            if key.lower() == \"components\":\n   673→                # Assuming the value is already in the correct format e.g., [{'name': 'Vortex'}] or [{'id': '11004'}]\n   674→                # We need the actual field ID for components. Let's try the common one, but this might need adjustment.\n   675→                # If 'Components' field ID is known, use it directly. Otherwise, try a common default or log a warning.\n   676→                component_field_id = field_ids.get(\n   677→                    \"Components\", field_ids.get(\"components\")\n   678→                )  # Try both cases\n   679→                if component_field_id:\n   680→                    fields[component_field_id] = value\n   681→                    logger.debug(\n   682→                        f\"Explicitly added components using field ID: {component_field_id}\"\n   683→                    )\n   684→                else:\n   685→                    # Fallback or warning if component ID not found\n   686→                    logger.warning(\n   687→                        \"Could not find field ID for 'Components'. Components may not be set.\"\n   688→                    )\n   689→                continue  # Skip further processing for components\n   690→\n   691→            if key in (\"epic_name\", \"epic_link\", \"parent\"):\n   692→                continue  # Handled separately\n   693→\n   694→            # Check if this is a known field\n   695→            # Use case-insensitive check for field names if needed, but rely on field_ids map primarily\n   696→            if key in field_ids:\n   697→                fields[field_ids[key]] = value\n   698→            elif key.startswith(\"customfield_\"):\n   699→                # Direct custom field reference\n   700→                fields[key] = value\n   701→\n   702→    def _handle_create_issue_error(self, exception: Exception, issue_type: str) -> None:\n   703→        \"\"\"\n   704→        Handle errors when creating an issue.\n   705→\n   706→        Args:\n   707→            exception: The exception that occurred\n   708→            issue_type: The type of issue being created\n   709→        \"\"\"\n   710→        error_msg = str(exception)\n   711→\n   712→        # Check for specific error types\n   713→        if \"epic name\" in error_msg.lower() or \"epicname\" in error_msg.lower():\n   714→            logger.error(\n   715→                f\"Error creating {issue_type}: {error_msg}. \"\n   716→                \"Try specifying an epic_name in the additional fields\"\n   717→            )\n   718→        elif \"customfield\" in error_msg.lower():\n   719→            logger.error(\n   720→                f\"Error creating {issue_type}: {error_msg}. \"\n   721→                \"This may be due to a required custom field\"\n   722→            )\n   723→        else:\n   724→            logger.error(f\"Error creating {issue_type}: {error_msg}\")\n   725→\n   726→    def update_issue(\n   727→        self,\n   728→        issue_key: str,\n   729→        fields: dict[str, Any] | None = None,\n   730→        **kwargs: Any,  # noqa: ANN401 - Dynamic field types are necessary for Jira API\n   731→    ) -> JiraIssue:\n   732→        \"\"\"\n   733→        Update a Jira issue.\n   734→\n   735→        Args:\n   736→            issue_key: The key of the issue to update\n   737→            fields: Dictionary of fields to update\n   738→            **kwargs: Additional fields to update. Special fields include:\n   739→                - attachments: List of file paths to upload as attachments\n   740→                - status: New status for the issue (handled via transitions)\n   741→                - assignee: New assignee for the issue\n   742→\n   743→        Returns:\n   744→            JiraIssue model representing the updated issue\n   745→\n   746→        Raises:\n   747→            Exception: If there is an error updating the issue\n   748→        \"\"\"\n   749→        try:\n   750→            # Validate required fields\n   751→            if not issue_key:\n   752→                raise ValueError(\"Issue key is required\")\n   753→\n   754→            update_fields = fields or {}\n   755→            attachments_result = None\n   756→\n   757→            # Process kwargs\n   758→            for key, value in kwargs.items():\n   759→                if key == \"status\":\n   760→                    # Status changes are handled separately via transitions\n   761→                    # Add status to fields so _update_issue_with_status can find it\n   762→                    update_fields[\"status\"] = value\n   763→                    return self._update_issue_with_status(issue_key, update_fields)\n   764→\n   765→                elif key == \"attachments\":\n   766→                    # Handle attachments separately - they're not part of fields update\n   767→                    if (\n