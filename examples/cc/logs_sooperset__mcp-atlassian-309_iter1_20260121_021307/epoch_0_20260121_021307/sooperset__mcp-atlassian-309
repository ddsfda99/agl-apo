d\n   695\u2192            # Use case-insensitive check for field names if needed, but rely on field_ids map primarily\n   696\u2192            if key in field_ids:\n   697\u2192                fields[field_ids[key]] = value\n   698\u2192            elif key.startswith(\"customfield_\"):\n   699\u2192                # Direct custom field reference\n   700\u2192                fields[key] = value\n   701\u2192\n   702\u2192    def _handle_create_issue_error(self, exception: Exception, issue_type: str) -> None:\n   703\u2192        \"\"\"\n   704\u2192        Handle errors when creating an issue.\n   705\u2192\n   706\u2192        Args:\n   707\u2192            exception: The exception that occurred\n   708\u2192            issue_type: The type of issue being created\n   709\u2192        \"\"\"\n   710\u2192        error_msg = str(exception)\n   711\u2192\n   712\u2192        # Check for specific error types\n   713\u2192        if \"epic name\" in error_msg.lower() or \"epicname\" in error_msg.lower():\n   714\u2192            logger.error(\n   715\u2192                f\"Error creating {issue_type}: {error_msg}. \"\n   716\u2192                \"Try specifying an epic_name in the additional fields\"\n   717\u2192            )\n   718\u2192        elif \"customfield\" in error_msg.lower():\n   719\u2192            logger.error(\n   720\u2192                f\"Error creating {issue_type}: {error_msg}. \"\n   721\u2192                \"This may be due to a required custom field\"\n   722\u2192            )\n   723\u2192        else:\n   724\u2192            logger.error(f\"Error creating {issue_type}: {error_msg}\")\n   725\u2192\n   726\u2192    def update_issue(\n   727\u2192        self,\n   728\u2192        issue_key: str,\n   729\u2192        fields: dict[str, Any] | None = None,\n   730\u2192        **kwargs: Any,  # noqa: ANN401 - Dynamic field types are necessary for Jira API\n   731\u2192    ) -> JiraIssue:\n   732\u2192        \"\"\"\n   733\u2192        Upda