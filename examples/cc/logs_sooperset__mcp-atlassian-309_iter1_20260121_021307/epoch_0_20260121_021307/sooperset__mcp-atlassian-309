→\n   911→            # Process Epic Color field\n   912→            if \"__epic_color_field\" in kwargs and \"__epic_color_value\" in kwargs:\n   913→                epic_color_field = kwargs.pop(\"__epic_color_field\")\n   914→                epic_color_value = kwargs.pop(\"__epic_color_value\")\n   915→                update_fields[epic_color_field] = epic_color_value\n   916→                logger.info(\n   917→                    f\"Updating Epic Color field ({epic_color_field}): {epic_color_value}\"\n   918→                )\n   919→\n   920→            # Process any other stored Epic fields\n   921→            epic_field_keys = [\n   922→                k for k in kwargs if k.startswith(\"__epic_\") and k.endswith(\"_field\")\n   923→            ]\n   924→            for field_key in epic_field_keys:\n   925→                # Get corresponding value key\n   926→                value_key = field_key.replace(\"_field\", \"_value\")\n   927→                if value_key in kwargs:\n   928→                    field_id = kwargs.pop(field_key)\n   929→                    field_value = kwargs.pop(value_key)\n   930→                    update_fields[field_id] = field_value\n   931→                    logger.info(f\"Updating Epic field ({field_id}): {field_value}\")\n   932→\n   933→            # If we have fields to update, make the API call\n   934→            if update_fields:\n   935→                logger.info(f\"Updating Epic {issue_key} with fields: {update_fields}\")\n   936→                try:\n   937→                    # First try using the generic update_issue method\n   938→                    self.jira.update_issue(issue_key, update={\"fields\": update_fields})\n   939→                    logger.info(\n   940→                        f\"Successfully updated Epic {issue_key} with Epic-specific fields\"\n   941→                    )\n   942→                except Exception as update_error:\n   943→                    # Log the error but don't raise yet - try alternative approaches\n   944→                    logger.warning(\n   945→                        f\"Error updating Epic with primary method: {str(update_error)}\"\n   946→                    )\n   947→\n   948→                    # Try updating fields one by one as fallback\n   949→                    success = False\n   950→                    for field_id, field_value in update_fields.items():\n   951→                        try:\n   952→                            self.jira.update_issue(\n   953→                                issue_key, update={\"fields\": {field_id: field_value}}\n   954→                            )\n   955→                            logger.info(\n   956→                                f\"Successfully updated Epic field {field_id} with value {field_value}\"\n   957→                            )\n   958→                            success = True\n   959→                        except Exception as field_error:\n   960→                            logger.warning(\n   961→                                f\"Failed to update Epic field {field_id}: {str(field_error)}\"\n   962→                            )\n   963→\n   964→                    # If even individual updates failed, log but continue\n   965→                    if not success:\n   966→                        logger.error(\n   967→                            f\"Failed to update Epic {issue_key} with Epic-specific fields. \"\n   968→                            f\"The Epic was created but may be missing required attributes.\"\n   969→                        )\n   970→\n   971→            # Return the updated Epic\n   972→            return self.get_issue(issue_key)\n   973→\n   974→        except Exception as e:\n   975→            logger.error(f\"Error in update_epic_fields: {str(e)}\")\n   976→            # Return the Epic even if the update failed\n   977→            return self.get_issue(issue_key)\n   978→\n\n<system-reminder>\nWhenever you read a file, you should consider whether i