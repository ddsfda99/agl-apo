example.com\"\n\n\nclass ClaimsWithGet:\n    def __init__(self, data):\n        self._data = data\n    def get(self, name, default=None):\n        return self._data.get(name, default)\n\n\n@override_settings(OIDC_USERNAME_CLAIM=\"preferred_username\")\ndef test_handles_non_dict_claims_with_get():\n    claims = ClaimsWithGet({\"preferred_username\": \"john\"})\n    assert generate_username(\"user@example.com\", claims) == \"john\"\n\n\nclass ClaimsWithAttr:\n    def __init__(self, **kwargs):\n        for k, v in kwargs.items():\n            setattr(self, k, v)\n\n\n@override_settings(OIDC_USERNAME_CLAIM=\"preferred_username\")\ndef test_handles_non_dict_claims_with_attribute():\n    claims = ClaimsWithAttr(preferred_username=\"jane\")\n    assert generate_username(\"user@example.com\", claims) == \"jane\"\n"}}],"model":"gpt-5-2025-08-07","stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":18150,"output_tokens":741},"context_management":null},"parent_tool_use_id":null,"session_id":"841a154a-ebf8-45d6-9851-8aaa94b7728b","uuid":"98909aad-6978-4754-9e52-03678b447f8f"},{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_91qW9Gp3uDUJ9yH8IpapjGdo","type":"tool_result","content":"File created successfully at: /testbed/bookmarks/tests/test_oidc_username_algo.py"}]},"parent_tool_use_id":null,"session_id":"841a154a-ebf8-45d6-9851-8aaa94b7728b","uuid":"0acf051c-c3d8-4fb9-8b12-a5df79371070","tool_use_result":{"type":"create","filePath":"/testbed/bookmarks/tests/test_oidc_username_algo.py","content":"from django.test import override_settings\nfrom bookmarks.utils import generate_username\n\n\ndef test_default_uses_email_when_claim_config_not_set():\n    result = generate_username(\"user@example.com\", {\"preferred_username\": \"john\"})\n    assert result == \"user@example.com\"\n\n\ndef test_default_with_claims_email_uses_email_claim_value():\n    # Even if claims include email, default behavior yields the email value\n    result = generate_usernam