stry_schemas[schema.type_name] = schema\n    99\u2192\n   100\u2192    def get_resource_schemas_by_regions(\n   101\u2192        self, resource_type: str, regions: Sequence[str]\n   102\u2192    ) -> Iterator[tuple[list[str], Schema]]:\n   103\u2192        \"\"\"\n   104\u2192        Get unique schemas with their associated regions\n   105\u2192\n   106\u2192        Args:\n   107\u2192            resource_type (str): the :: version of the resource type\n   108\u2192            regions (Sequence[str]): the regions in which we want schems for\n   109\u2192        Returns:\n   110\u2192            Iterator[tuple[list[str], Schema]]: the unique schemas with\n   111\u2192              their associated regions\n   112\u2192        \"\"\"\n   113\u2192        cached_regions: list[str] = []\n   114\u2192        cached_schema: Schema | None = None\n   115\u2192        for region in regions:\n   116\u2192            try:\n   117\u2192                schema = self.get_resource_schema(region, resource_type)\n   118\u2192            except ResourceNotFoundError:\n   119\u2192                continue\n   120\u2192            if not schema.is_cached and region != REGION_PRIMARY:\n   121\u2192                yield [region], schema\n   122\u2192            else:\n   123\u2192                cached_regions.append(region)\n   124\u2192                cached_schema = schema\n   125\u2192\n   126\u2192        if cached_schema is not None:\n   127\u2192            yield cached_regions, cached_schema\n   128\u2192\n   129\u2192    def _normalize_resource_type(self, resource_type: str) -> str:\n   130\u2192        \"\"\"\n   131\u2192        Normalize the resource type to the correct format\n   132\u2192\n   133\u2192        Args:\n   134\u2192            resource_type (str): the :: version of the resource type\n   135\u2192        Returns:\n   136\u2192            str: the normalized resource type\n   137\u2192        \"\"\"\n   138\u2192        if resource_type.startswith(\"Custom::\"):\n   139\u2192            resource_type = \"AWS::CloudFormation::CustomResource\"\n   140\u2192        if resource_type.endswith(\"::MODULE\"):\n   141\u2192            resource_type = \"Module\"\n   142\u2192\n   143\u2192        return resource_type\n   144\u2192\n   145\u2192    @lru_cache(maxsize=None)\n   146\u2192    def get_resource_schema(self, region: str, resource_type: str) -> Schema:\n   147\u2192        \"\"\"Get the provider resource schema and cache it to speed up future lookups\n   148\u2192\n   149\u2192        Args:\n   150\u2192            region (str): the region in which do get the provider schema for\n   151\u2192            resource_type (str): the :: version of the resource type\n   152\u2192        Returns:\n   153\u2192            dict: returns the schema\n   154\u2192        \"\"\"\n   155\u2192        if resource_type not in self._registry_schemas:\n   156\u2192            resource_type = self._normalize_resource_type(resource_type)\n   157\u2192\n   158\u2192        if resource_type in self._removed_types:\n   159\u2192            raise ResourceNotFoundError(resource_type, region)\n   160\u2192\n   161\u2192        reg = ToPy(region)\n   162\u2192        rt = ToPy(resource_type)\n   163\u2192\n   164\u2192        schema = self._schemas[reg.name].get(rt.name)\n   165\u2192        if schema is not None:\n   166\u2192            return schema\n   167\u2192\n   168\u2192        # dynamically import the modules as needed\n   169\u2192        self._provider_schema_modules[reg.name] = __import__(\n   170\u2192            f\"{self._root.module}.{reg.py}\", fromlist=[\"\"]\n   171\u2192        )\n   172\u2192        # check cfn-lint provided schemas\n   173\u2192        if rt.name in self._registry_schemas:\n   174\u2192            self._schemas[reg.name][rt.name] = self._registry_schemas[rt.name]\n   175\u2192            return self._schemas[reg.name][rt.name]\n   176\u2192\n   177\u2192        # load the schema\n   178\u2192        if f\"{rt.provider}.json\" in self._provider_schema_modules[reg.name].cached:\n   179\u2192            schema_cached = copy(\n   180\u2192                self.get_resource_schema(\n   181\u2192                    region=self._region_primary.name,\n   182\u2192                    resource_type=rt.name,\n   183\u2192                )\n   184\u2192            )\n   185\u2192            schema_cached.is_cached = True\n   186\u2192            self._schemas[reg.name][rt.name] = schema_cached\n   187\u2192            return self._schemas[reg.name][rt.name]\n   188\u2192        try:\n   189\u2192            self._schemas[reg.name][rt.name] = Schema(\n   190\u2192                load_resource(\n   191\u2192                    self._provider_schema_modules[reg.name],\n   192\u2192                    filename=f\"{rt.provider}.json\",\n   193\u2192                )\n   194\u2192            )\n   195\u2192            return self._schemas[reg.name][rt.name]\n   196\u2192        except Exception as e:\n   197\u2192            raise ResourceNotFoundError(rt.name, region) from e\n   198\u2192\n   199\u2192    @lru_cache(maxsize=None)\n   200\u2192    def get_resource_types(self, region: str) -> list[str]:\n   201\u2192        \"\"\"Get the resource types for a region\n   202\u2192\n   203\u2192        Args:\n   204\u2192            region (str): the region in which to get the resource types for\n   205\u2192        Returns:\n   206\u2192            list[str]: returns a list of resource types\n   207\u2192        \"\"\"\n   208\u2192        reg = ToPy(region)\n   209\u2192\n   210\u2192        if self._region_primary.name not in self._provider_schema_modules:\n   211\u2192            self._provider_schema_modules[self._region_primary.name] = __import__(\n   212\u2192                f\"{self._root.module}.{self._region_primary.py}\", fromlist=[\"\"]\n   213\u2192            )\n   214\u2192        resource_types: list[str] = []\n   215\u2192        if reg.name not in self._provider_schema_modules:\n   216\u2192            self._provider_schema_modules[region] = __import__(\n   217\u2192                f\"{self._root.module}.{reg.py}\", fromlist=[\"\"]\n   218\u2192            )\n   219\u2192        resource_types.extend(\n   220\u2192            rt\n   221\u2192            for rt in self._provider_schema_modules[reg.name].types\n   222\u2192            if rt not in self._removed_types\n   223\u2192        )\n   224\u2192        resource_types.extend(list(self._registry_schemas.keys()))\n   225\u2192\n   226\u2192        return resource_types\n   227\u2192\n   228\u2192    def update(self, force: bool) -> None:\n   229\u2192        \"\"\"Update every regions provider schemas\n   230\u2192\n   231\u2192        Args:\n   232\u2192            force (bool): force the schemas to be downloaded\n   233\u2192        Returns:\n   234\u2192            None: returns when complete\n   235\u2192        \"\"\"\n   236\u2192        self._update_provider_schema(self._region_primary.name, force=force)\n   237\u2192        # pylint: disable=not-context-manager\n   238\u2192        with multiprocessing.Pool() as pool:\n   239\u2192            # Patch from registry schema\n   240\u2192            provider_pool_tuple = [\n   241\u2192                (k, force) for k in REGIONS if k != self._region_primary.name\n   242\u2192            ]\n   243\u2192            pool.starmap(self._update_provider_schema, provider_pool_tuple)\n   244\u2192\n   245\u2192    def _remove_descriptions(self, spec: Any) -> Any:\n   246\u2192        if isinstance(spec, dict):\n   247\u2192            r: dict[Any, Any] = {}\n   248\u2192            for k, v in spec.items():\n   249\u2192                if k != \"description\":\n   250\u2192                    r[k] = self._remove_descriptions(v)\n   251\u2192\n   252\u2192            return r\n   253\u2192        elif isinstance(spec, list):\n   254\u2192            m: list[Any] = []\n   255\u2192            for v in spec:\n   256\u2192                m.append(self._remove_descriptions(v))\n   257\u2192\n   258\u2192            return m\n   259\u2192        else:\n   260\u2192            return spec\n   261\u2192\n   262\u2192    def _update_provider_schema(self, region: str, force: bool = False) -> None:\n   263\u2192        \"\"\"Update the provider schemas from the AWS websites\n   264\u2192\n   265\u2192        Args:\n   266\u2192            region (str): the region in which do ge the provider schema for\n   267\u2192            force (bool): force the schemas to be downloaded\n   268\u2192        Returns:\n   269\u2192            None: returns when complete\n   270\u2192        \"\"\"\n   271\u2192        # China regions in .com.cn\n   272\u2192        suffix = \".cn\" if region in [\"cn-north-1\", \"cn-northwest-1\"] else \"\"\n   273\u2192        url = f\"https://schema.cloudformation.{region}.amazonaws.com{suffix}/CloudformationSchema.zip\"\n   274\u2192        reg = ToPy(region)\n   275\u2192        directory = os.path.join(f\"{self._root.path_relative}/{reg.py}/\")\n   276\u2192        directory_pr = os.path.join(\n   277\u2192            f\"{self._root.path_relative}/{self._region_primary.py}/\"\n   278\u2192        )\n   279\u2192\n   280\u2192        multiprocessing_logger = multiprocessing.log_to_stderr()\n   281\u2192\n   282\u2192        multiprocessing_logger.debug(\"Downloading template %s into %s\", url, directory)\n   283\u2192\n   284\u2192        # Check to see if we already have the latest version, and if so stop\n   285\u2192        if not (url_has_newer_version(url) or force):\n   286\u2192            return\n   287\u2192\n   288\u2192        if not os.path.exists(directory):\n   289\u2192            os.mkdir(directory)\n   290\u2192\n   291\u2192        try:\n   292\u2192            filehandle = get_url_retrieve(url, caching=True)\n   293\u2192            # clean folder\n   294\u2192            shutil.rmtree(directory)\n   295\u2192            with zipfile.ZipFile(filehandle, \"r\") as zip_ref:\n   296\u2192                zip_ref.extractall(directory)\n   297\u2192\n   298\u2192            filenames = [\n   299\u2192                f\n   300\u2192                for f in os.listdir(directory)\n   301\u2192                if os.path.isfile(os.path.join(directory, f)) and f != \"__init__.py\"\n   302\u2192            ]\n   303\u2192            # There is no schema for CDK but its an allowable type\n   304\u2192            all_types = [\"AWS::CDK::Metadata\", \"Module\"]\n   305\u2192            with open(f\"{directory}module.json\", \"w\", encoding=\"utf-8\") as fh:\n   306\u2192                json.dump(\n   307\u2192                    {\n   308\u2192                        \"additionalProperties\": True,\n   309\u2192                        \"type\": \"object\",\n   310\u2192                        \"typeName\": \"Module\",\n   311\u2192                    },\n   312\u2192                    fh,\n   313\u2192                    indent=1,\n   314\u2192                    separators=(\",\", \": \"),\n   315\u2192                    sort_keys=True,\n   316\u2192                )\n   317\u2192                fh.write(\"\\n\")\n   318\u2192            for filename in filenames:\n   319\u2192                with open(f\"{directory}{filename}\", \"r+\", encoding=\"utf-8\") as fh:\n   320\u2192                    spec = json.load(fh)\n   321\u2192                    all_types.append(spec[\"typeName\"])\n   322\u2192                    try:\n   323\u2192                        spec = self._remove_descriptions(spec)\n   324\u2192                        spec = self._patch_provider_schema(spec, filename, \"all\")\n   325\u2192                        spec = self._patch_provider_schema(\n   326\u2192                            spec, filename, region=reg.py\n   327\u2192                        )\n   328\u2192                    except Exception as e:  # pylint: disable=broad-except\n   329\u2192                        LOGGER.info(\n   330\u2192                            \"Issuing patching schema for %s in %s: %s\",\n   331\u2192                            filename,\n   332\u2192                            reg.name,\n   333\u2192                            e,\n   334\u2192                        )\n   335\u2192                    # Back to zero to write spec\n   336\u2192                    fh.seek(0)\n   337\u2192                    json.dump(\n   338\u2192                        spec,\n   339\u2192                        fh,\n   340\u2192                        indent=1,\n   341\u2192                        separators=(\",\", \": \"),\n   342\u2192                        sort_keys=True,\n   343\u2192                    )\n   344\u2192                    fh.write(\"\\n\")\n   345\u2192                    # Resize doc as needed\n   346\u2192                    fh.truncate()\n   347\u2192\n   348\u2192            # if the region is not us-east-1 compare the files to those in us-east-1\n   349\u2192            # symlink if the files are the same\n   350\u2192            if reg.name != self._region_primary.name:\n   351\u2192                cached = [\"Module\"]\n   352\u2192                for filename in os.listdir(directory):\n   353\u2192                    if filename != \"__init__.py\":\n   354\u2192                        try:\n   355\u2192                            if filecmp.cmp(\n   356\u2192                                f\"{directory}{filename}\",\n   357\u2192                                f\"{directory_pr}{filename}\",\n   358\u2192                            ):\n   359\u2192                                cached.append(filename)\n   360\u2192                                os.remove(f\"{directory}{filename}\")\n   361\u2192                        except FileNotFoundError:\n   362\u2192                            pass\n   363\u2192                        except Exception as e:  # pylint: disable=broad-except\n   364\u2192                            # Exceptions will typically be the file\n   365\u2192                            # doesn't exist in primary region\n   366\u2192                            LOGGER.info(\n   367\u2192                                \"Issuing comparing %s into %s: %s\",\n   368\u2192                                f\"{directory}{filename}\",\n   369\u2192                                f\"{directory_pr}{filename}\",\n   370\u2192                                e,\n   371\u2192                            )\n   372\u2192                with open(f\"{directory}__init__.py\", encoding=\"utf-8\", mode=\"w\") as f:\n   373\u2192                    f.write(\"from __future__ import annotations\\n\\n\")\n   374\u2192                    f.write(\"# pylint: disable=too-many-lines\\ntypes: list[str] = [\\n\")\n   375\u2192                    for rt in sorted(all_types):\n   376\u2192                        f.write(f'    \"{rt}\",\\n')\n   377\u2192                    f.write(\n   378\u2192                        \"]\\n\\n# pylint: disable=too-many-lines\\ncached: list[str] = [\\n\"\n   379\u2192                    )\n   380\u2192                    for cache_file in sorted(cached):\n   381\u2192                        f.write(f'    \"{cache_file}\",\\n')\n   382\u2192                    f.write(\"]\\n\")\n   383\u2192            else:\n   384\u2192                with open(f\"{directory}__init__.py\", encoding=\"utf-8\", mode=\"w\") as f:\n   385\u2192                    f.write(\"from __future__ import annotations\\n\\n\")\n   386\u2192                    f.write(\"# pylint: disable=too-many-lines\\ntypes: list[str] = [\\n\")\n   387\u2192                    for rt in sorted(all_types):\n   388\u2192                        f.write(f'    \"{rt}\",\\n')\n   389\u2192                    f.write(\"]\\ncached: list[str] = []\\n\")\n   390\u2192\n   391\u2192        except Exception as e:  # pylint: disable=broad-except\n   392\u2192            LOGGER.info(\"Issuing updating schemas for %s: %s\", region, e)\n   393\u2192\n   394\u2192    def _patch_provider_schema(\n   395\u2192        self, content: Dict, source_filename: str, region: str\n   396\u2192    ) -> Dict:\n   397\u2192        \"\"\"Provides the logic to patch a CloudFormation provider schema file.\n   398\u2192\n   399\u2192        Args:\n   400\u2192            content: A Dict representing the data that needs to be patched\n   401\u2192            source_filename: The source filename for the JSON patches\n   402\u2192            region: The region to apply the patch against\n   403\u2192        Returns:\n   404\u2192            Dict: returns the patched content\n   405\u2192        \"\"\"\n   406\u2192        for patch_type in [\"extensions\", \"providers\"]:\n   407\u2192            source_dir = source_filename.replace(\"-\", \"_\").replace(\".json\", \"\")\n   408\u2192            append_dir = os.path.join(\n   409\u2192                self._patches.path_relative, patch_type, region, source_dir\n   410\u2192            )\n   411\u2192            for dirpath, _, filenames in os.walk(append_dir):\n   412\u2192                filenames.sort()\n   413\u2192                for filename in fnmatch.filter(filenames, \"*.json\"):\n   414\u2192                    file_path = os.path.basename(filename)\n   415\u2192                    module = dirpath.replace(f\"{append_dir}\", f\"{region}\").replace(\n   416\u2192                        os.path.sep, \".\"\n   417\u2192                    )\n   418\u2192                    try:\n   419\u2192                        jsonpatch.JsonPatch(\n   420\u2192                            load_resource(\n   421\u2192                                f\"{self._patches.module}.{patch_type}.{module}.{source_dir}\",\n   422\u2192                                file_path,\n   423\u2192                            )\n   424\u2192                        ).apply(content, in_place=True)\n   425\u2192                    except jsonpatch.JsonPatchConflict as e:\n   426\u2192                        LOGGER.info(\n   427\u2192                            \"Patch already applied %s: %s\",\n   428\u2192                            os.path.join(append_dir, file_path),\n   429\u2192                            str(e),\n   430\u2192                        )\n   431\u2192                    except jsonpatch.JsonPatchException as e:\n   432\u2192                        LOGGER.info(\n   433\u2192                            \"Patch exception raised for %s: %s\",\n   434\u2192                            os.path.join(append_dir, file_path),\n   435\u2192                            str(e),\n   436\u2192                        )\n   437\u2192                    except Exception as e:  # pylint: disable=broad-exception-caught\n   438\u2192                        LOGGER.info(\n   439\u2192                            \"Unknown exception raised applying patch %s: %s\",\n   440\u2192                            os.path.join(append_dir, file_path),\n   441\u2192                            str(e),\n   442\u2192                        )\n   443\u2192\n   444\u2192        return content\n   445\u2192\n   446\u2192    def patch(self, filename: str, regions: Sequence[str]):\n   447\u2192        try:\n   448\u2192            with open(filename, encoding=\"utf-8\") as fp:\n   449\u2192                custom_spec_data = json.load(fp)\n   450\u2192                schema_patch = SchemaPatch.from_dict(custom_spec_data)\n   451\u2192                for region in regions:\n   452\u2192                    self._patch(schema_patch, region)\n   453\u2192        except IOError as e:\n   454\u2192            if e.errno == 2:\n   455\u2192                LOGGER.error(\"Override spec file not found: %s\", filename)\n   456\u2192                sys.exit(1)\n   457\u2192            elif e.errno == 21:\n   458\u2192                LOGGER.error(\n   459\u2192                    \"Override spec file references a directory, not a file: %s\",\n   460\u2192                    filename,\n   461\u2192                )\n   462\u2192                sys.exit(1)\n   46