lue)\n   671→                    return result\n   672→\n   673→        # return individual items\n   674→        if arg_name in self._manual_args:\n   675→            return self._manual_args[arg_name]\n   676→        if cli_value:\n   677→            return cli_value\n   678→        if template_value and is_template:\n   679→            return template_value\n   680→        if file_value and is_config_file:\n   681→            return file_value\n   682→        return cli_value\n   683→\n   684→    @property\n   685→    def ignore_checks(self):\n   686→        return self._get_argument_value(\"ignore_checks\", True, True)\n   687→\n   688→    @property\n   689→    def include_checks(self):\n   690→        results = self._get_argument_value(\"include_checks\", True, True)\n   691→        return [\"W\", \"E\"] + results\n   692→\n   693→    @property\n   694→    def mandatory_checks(self):\n   695→        return self._get_argument_value(\"mandatory_checks\", False, True)\n   696→\n   697→    @property\n   698→    def include_experimental(self):\n   699→        return self._get_argument_value(\"include_experimental\", True, True)\n   700→\n   701→    @property\n   702→    def regions(self):\n   703→        results = self._get_argument_value(\"regions\", True, True)\n   704→        if not results:\n   705→            default_region_env = os.environ.get(\"AWS_DEFAULT_REGION\", \"us-east-1\")\n   706→            return [os.environ.get(\"AWS_REGION\", default_region_env)]\n   707→        if \"ALL_REGIONS\" in results:\n   708→            return REGIONS\n   709→        return results\n   710→\n   711→    @property\n   712→    def ignore_bad_template(self):\n   713→        return self._get_argument_value(\"ignore_bad_template\", True, True)\n   714→\n   715→    @property\n   716→    def debug(self):\n   717→        return self._get_argument_value(\"debug\", False, False)\n   718→\n   719→    @property\n   720→    def info(self):\n   721→        return self._get_argument_value(\"info\", False, False)\n   722→\n   723→    @property\n   724→    def format(self):\n   725→        return self._get_argument_value(\"format\", False, True)\n   726→\n   727→    @property\n   728→    def templates(self):\n   729→        templates_args = self._get_argument_value(\"templates\", False, True)\n   730→        template_alt_args = self._get_argument_value(\"template_alt\", False, False)\n   731→        if template_alt_args:\n   732→            filenames = template_alt_args\n   733→        elif templates_args:\n   734→            filenames = templates_args\n   735→        else:\n   736→            return None\n   737→\n   738→        # if only one is specified convert it to array\n   739→        if isinstance(filenames, str):\n   740→            filenames = [filenames]\n   741→\n   742→        ignore_templates = self._ignore_templates()\n   743→        all_filenames = self._glob_filenames(filenames)\n   744→\n   745→        return [i for i in all_filenames if i not in ignore_templates]\n   746→\n   747→    def _ignore_templates(self):\n   748→        ignore_template_args = self._get_argument_value(\"ignore_templates\", False, True)\n   749→        if ignore_template_args:\n   750→            filenames = ignore_template_args\n   751→        else:\n   752→            return []\n   753→\n   754→        # if only one is specified convert it to array\n   755→        if isinstance(filenames, str):\n   756→            filenames = [filenames]\n   757→\n   758→        return self._glob_filenames(filenames)\n   759→\n   760→    def _glob_filenames(self, filenames: Sequence[str]) -> list[str]:\n   761→        # handle different shells and Config files\n   762→        # some shells don't expand * and configparser won't expand wildcards\n   763→        all_filenames = []\n   764→\n   765→        for filename in filenames:\n   766→            add_filenames = glob.glob(filename, recursive=True)\n   767→            # only way to know of the glob failed is to test it\n 