17→        allowed_values = self._parameters.copy()\n   118→        if allowed_values:\n   119→            # iteration 1 cleans up all the hash values\n   120→            # from allowed_values to know if we\n   121→            # used them all\n   122→            for _, equal_1 in equals.items():\n   123→                for param in equal_1.parameters:\n   124→                    if param.hash not in allowed_values:\n   125→                        continue\n   126→                    if isinstance(equal_1.left, str):\n   127→                        if get_hash(equal_1.left) in allowed_values[param.hash]:\n   128→                            allowed_values[param.hash].remove(get_hash(equal_1.left))\n   129→                        else:\n   130→                            equal_vars[equal_1.hash] = BooleanFalse()\n   131→                    if isinstance(equal_1.right, str):\n   132→                        if get_hash(equal_1.right) in allowed_values[param.hash]:\n   133→                            allowed_values[param.hash].remove(get_hash(equal_1.right))\n   134→                        else:\n   135→                            equal_vars[equal_1.hash] = BooleanFalse()\n   136→\n   137→            # iteration 2 builds the cnf formulas to make sure any empty lists\n   138→            # are now full not equals\n   139→            for allowed_hash, allowed_value in allowed_values.items():\n   140→                # means the list is empty and all allowed values are validated\n   141→                # so not all equals can be false\n   142→                if not allowed_value:\n   143→                    prop = None\n   144→                    for _, equal_1 in equals.items():\n   145→                        for param in equal_1.parameters:\n   146→                            if allowed_hash == param.hash:\n   147→                                if prop is None:\n   148→                                    prop = Not(equal_vars[equal_1.hash])\n   149→                        