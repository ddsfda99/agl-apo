resource is available\n   831\u2192        return results\n   832\u2192\n   833\u2192    def get_object_without_nested_conditions(\n   834\u2192        self, obj: dict | list, path: Path, region: str | None = None\n   835\u2192    ):\n   836\u2192        \"\"\"\n   837\u2192        Get a list of object values without conditions included.\n   838\u2192\n   839\u2192        Evaluates deep into the object removing any nested conditions as well.\n   840\u2192\n   841\u2192        Args:\n   842\u2192            obj (dict): The object to process.\n   843\u2192            path (list): The current path in the object.\n   844\u2192            region (str, optional): The AWS region to use for evaluating conditions. Defaults to None.\n   845\u2192\n   846\u2192        Returns:\n   847\u2192            list: A list of dictionaries, where each dictionary contains the following keys:\n   848\u2192                - \"Scenario\": The scenario for the object, or None if there are no conditions.\n   849\u2192                - \"Object\": The object with conditions removed.\n   850\u2192        \"\"\"\n   851\u2192        results = []\n   852\u2192        scenarios = self.get_condition_scenarios_below_path(path, False, region)\n   853\u2192        if not isinstance(obj, (dict, list)):\n   854\u2192            return results\n   855\u2192\n   856\u2192        def get_value(value, scenario):  # pylint: disable=R0911\n   857\u2192            \"\"\"Get the value based on the scenario resolving nesting\"\"\"\n   858\u2192            if isinstance(value, dict):\n   859\u2192                if len(value) == 1:\n   860\u2192                    if \"Fn::If\" in value:\n   861\u2192                        if_values = value.get(\"Fn::If\")\n   862\u2192                        if len(if_values) == 3:\n   863\u2192                            if_path = scenario.get(if_values[0], None)\n   864\u2192                            if if_path is not None:\n   865\u2192                                if if