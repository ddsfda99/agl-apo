   def __format__(self, spec):\n   409→        if not spec:\n   410→            spec = beets.config[self._format_config_key].as_str()\n   411→        assert isinstance(spec, str)\n   412→        return self.evaluate_template(spec)\n   413→\n   414→    def __str__(self):\n   415→        return format(self)\n   416→\n   417→    def __bytes__(self):\n   418→        return self.__str__().encode(\"utf-8\")\n   419→\n   420→\n   421→class FormattedItemMapping(dbcore.db.FormattedMapping):\n   422→    \"\"\"Add lookup for album-level fields.\n   423→\n   424→    Album-level fields take precedence if `for_path` is true.\n   425→    \"\"\"\n   426→\n   427→    ALL_KEYS = \"*\"\n   428→\n   429→    def __init__(self, item, included_keys=ALL_KEYS, for_path=False):\n   430→        # We treat album and item keys specially here,\n   431→        # so exclude transitive album keys from the model's keys.\n   432→        super().__init__(item, included_keys=[], for_path=for_path)\n   433→        self.included_keys = included_keys\n   434→        if included_keys == self.ALL_KEYS:\n   435→            # Performance note: this triggers a database query.\n   436→            self.model_keys = item.keys(computed=True, with_album=False)\n   437→        else:\n   438→            self.model_keys = included_keys\n   439→        self.item = item\n   440→\n   441→    @cached_property\n   442→    def all_keys(self):\n   443→        return set(self.model_keys).union(self.album_keys)\n   444→\n   445→    @cached_property\n   446→    def album_keys(self):\n   447→        album_keys = []\n   448→        if self.album:\n   449→            if self.included_keys == self.ALL_KEYS:\n   450→                # Performance note: this triggers a database query.\n   451→                for key in self.album.keys(computed=True):\n   452→                    if (\n   453→                        key in Album.item_keys\n   454→                        or key not in self.item._fields.keys()\n   455→                    ):\n   456→                        album_keys.append(key)\n   457→            else:\n   458→                album_keys = self.included_keys\n   459→        return album_keys\n   460→\n   461→    @property\n   462→    def album(self):\n   463→        return self.item._cached_album\n   464→\n   465→    def _get(self, key):\n   466→        \"\"\"Get the value for a key, either from the album or the item.\n   467→\n   468→        Raise a KeyError for invalid keys.\n   469→        \"\"\"\n   470→        if self.for_path and key in self.album_keys:\n   471→            return self._get_formatted(self.album, key)\n   472→        elif key in self.model_keys:\n   473→            return self._get_formatted(self.model, key)\n   474→        elif key in self.album_keys:\n   475→            return self._get_formatted(self.album, key)\n   476→        else:\n   477→            raise KeyError(key)\n   478→\n   479→    def __getitem__(self, key):\n   480→        \"\"\"Get the value for a key.\n   481→\n   482→        `artist` and `albumartist` are fallback values for each other\n   483→        when not set.\n   484→        \"\"\"\n   485→        value = self._get(key)\n   486→\n   487→        # `artist` and `albumartist` fields fall back to one another.\n   488→        # This is helpful in path formats when the album artist is unset\n   489→        # on as-is imports.\n   490→        try:\n   491→            if key == \"artist\" and not value:\n   492→                return self._get(\"albumartist\")\n   493→            elif key == \"albumartist\" and not value:\n   494→                return self._get(\"artist\")\n   495→        except KeyError:\n   496→            pass\n   497→\n   498→        return value\n   499→\n   500→    def __iter__(self):\n   501→        return iter(self.all_keys)\n   502→\n   503→    def __len__(self):\n   504→        return len(self.all_keys)\n   505→\n   506→\n   507→class Item(LibModel):\n   508→    \"\"\"Represent a song or track.\"\"\"\n   509→\n   510