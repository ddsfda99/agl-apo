t):\n   300→    \"\"\"Sort by artist (either album artist or track artist),\n   301→    prioritizing the sort field over the raw field.\n   302→    \"\"\"\n   303→\n   304→    def __init__(self, model_cls, ascending=True, case_insensitive=True):\n   305→        self.album = model_cls is Album\n   306→        self.ascending = ascending\n   307→        self.case_insensitive = case_insensitive\n   308→\n   309→    def order_clause(self):\n   310→        order = \"ASC\" if self.ascending else \"DESC\"\n   311→        field = \"albumartist\" if self.album else \"artist\"\n   312→        collate = \"COLLATE NOCASE\" if self.case_insensitive else \"\"\n   313→        return (\n   314→            \"(CASE {0}_sort WHEN NULL THEN {0} \"\n   315→            'WHEN \"\" THEN {0} '\n   316→            \"ELSE {0}_sort END) {1} {2}\"\n   317→        ).format(field, collate, order)\n   318→\n   319→    def sort(self, objs):\n   320→        if self.album:\n   321→\n   322→            def field(a):\n   323→                return a.albumartist_sort or a.albumartist\n   324→\n   325→        else:\n   326→\n   327→            def field(i):\n   328→                return i.artist_sort or i.artist\n   329→\n   330→        if self.case_insensitive:\n   331→\n   332→            def key(x):\n   333→                return field(x).lower()\n   334→\n   335→        else:\n   336→            key = field\n   337→        return sorted(objs, key=key, reverse=not self.ascending)\n   338→\n   339→\n   340→# Special path format key.\n   341→PF_KEY_DEFAULT = \"default\"\n   342→\n   343→\n   344→# Exceptions.\n   345→class FileOperationError(Exception):\n   346→    \"\"\"Indicate an error when interacting with a file on disk.\n   347→\n   348→    Possibilities include an unsupported media type, a permissions\n   349→    error, and an unhandled Mutagen exception.\n   350→    \"\"\"\n   351→\n   352→    def __init__(self, path, reason):\n   353→        \"\"\"Create an exception describing an operation on 