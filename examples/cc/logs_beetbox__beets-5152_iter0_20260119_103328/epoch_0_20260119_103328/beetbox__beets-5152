self._candidate(\n   628→                    url=item[\"link\"], match=Candidate.MATCH_EXACT\n   629→                )\n   630→\n   631→\n   632→class FanartTV(RemoteArtSource):\n   633→    \"\"\"Art from fanart.tv requested using their API\"\"\"\n   634→\n   635→    NAME = \"fanart.tv\"\n   636→    API_URL = \"https://webservice.fanart.tv/v3/\"\n   637→    API_ALBUMS = API_URL + \"music/albums/\"\n   638→    PROJECT_KEY = \"61a7d0ab4e67162b7a0c7c35915cd48e\"\n   639→\n   640→    def __init__(self, *args, **kwargs):\n   641→        super().__init__(*args, **kwargs)\n   642→        self.client_key = self._config[\"fanarttv_key\"].get()\n   643→\n   644→    @staticmethod\n   645→    def add_default_config(config):\n   646→        config.add(\n   647→            {\n   648→                \"fanarttv_key\": None,\n   649→            }\n   650→        )\n   651→        config[\"fanarttv_key\"].redact = True\n   652→\n   653→    def get(self, album, plugin, paths):\n   654→        if not album.mb_releasegroupid:\n   655→            return\n   656→\n   657→        try:\n   658→            response = self.request(\n   659→                self.API_ALBUMS + album.mb_releasegroupid,\n   660→                headers={\n   661→                    \"api-key\": self.PROJECT_KEY,\n   662→                    \"client-key\": self.client_key,\n   663→                },\n   664→            )\n   665→        except requests.RequestException:\n   666→            self._log.debug(\"fanart.tv: error receiving response\")\n   667→            return\n   668→\n   669→        try:\n   670→            data = response.json()\n   671→        except ValueError:\n   672→            self._log.debug(\n   673→                \"fanart.tv: error loading response: {}\", response.text\n   674→            )\n   675→            return\n   676→\n   677→        if \"status\" in data and data[\"status\"] == \"error\":\n   678→            if \"not found\" in data[\"error message\"].lower():\n   679→               