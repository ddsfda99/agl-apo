over art URL not found for {album}\")\n  1110→            return\n  1111→        if image_url:\n  1112→            yield self._candidate(url=image_url, match=Candidate.MATCH_EXACT)\n  1113→        else:\n  1114→            self._log.debug(f\"Cover art URL not found for {album}\")\n  1115→            return\n  1116→\n  1117→\n  1118→# Try each source in turn.\n  1119→\n  1120→# Note that SOURCES_ALL is redundant (and presently unused). However, we keep\n  1121→# it around nn order not break plugins that \"register\" (a.k.a. monkey-patch)\n  1122→# their own fetchart sources.\n  1123→SOURCES_ALL = [\n  1124→    \"filesystem\",\n  1125→    \"coverart\",\n  1126→    \"itunes\",\n  1127→    \"amazon\",\n  1128→    \"albumart\",\n  1129→    \"wikipedia\",\n  1130→    \"google\",\n  1131→    \"fanarttv\",\n  1132→    \"lastfm\",\n  1133→    \"spotify\",\n  1134→]\n  1135→\n  1136→ART_SOURCES = {\n  1137→    \"filesystem\": FileSystem,\n  1138→    \"coverart\": CoverArtArchive,\n  1139→    \"itunes\": ITunesStore,\n  1140→    \"albumart\": AlbumArtOrg,\n  1141→    \"amazon\": Amazon,\n  1142→    \"wikipedia\": Wikipedia,\n  1143→    \"google\": GoogleImages,\n  1144→    \"fanarttv\": FanartTV,\n  1145→    \"lastfm\": LastFM,\n  1146→    \"spotify\": Spotify,\n  1147→    \"cover_art_url\": CoverArtUrl,\n  1148→}\n  1149→SOURCE_NAMES = {v: k for k, v in ART_SOURCES.items()}\n  1150→\n  1151→# PLUGIN LOGIC ###############################################################\n  1152→\n  1153→\n  1154→class FetchArtPlugin(plugins.BeetsPlugin, RequestMixin):\n  1155→    PAT_PX = r\"(0|[1-9][0-9]*)px\"\n  1156→    PAT_PERCENT = r\"(100(\\.00?)?|[1-9]?[0-9](\\.[0-9]{1,2})?)%\"\n  1157→\n  1158→    def __init__(self):\n  1159→        super().__init__()\n  1160→\n  1161→        # Holds candidates corresponding to downloaded images between\n  1162→        # fetching them and placing them in the filesystem.\n  1163→        self.art_candidates = {}\n  1164→\n  1165→        self.config.add(\n