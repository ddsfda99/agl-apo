lf, album, paths, local_only=False):\n  1390\u2192        \"\"\"Given an Album object, returns a path to downloaded art for the\n  1391\u2192        album (or None if no art is found). If `maxwidth`, then images are\n  1392\u2192        resized to this maximum pixel size. If `quality` then resized images\n  1393\u2192        are saved at the specified quality level. If `local_only`, then only\n  1394\u2192        local image files from the filesystem are returned; no network\n  1395\u2192        requests are made.\n  1396\u2192        \"\"\"\n  1397\u2192        out = None\n  1398\u2192\n  1399\u2192        for source in self.sources:\n  1400\u2192            if source.IS_LOCAL or not local_only:\n  1401\u2192                self._log.debug(\n  1402\u2192                    \"trying source {0} for album {1.albumartist} - {1.album}\",\n  1403\u2192                    SOURCE_NAMES[type(source)],\n  1404\u2192                    album,\n  1405\u2192                )\n  1406\u2192                # URLs might be invalid at this point, or the image may not\n  1407\u2192                # fulfill the requirements\n  1408\u2192                for candidate in source.get(album, self, paths):\n  1409\u2192                    source.fetch_image(candidate, self)\n  1410\u2192                    if candidate.validate(self):\n  1411\u2192                        out = candidate\n  1412\u2192                        self._log.debug(\n  1413\u2192                            \"using {0.LOC_STR} image {1}\".format(\n  1414\u2192                                source, util.displayable_path(out.path)\n  1415\u2192                            )\n  1416\u2192                        )\n  1417\u2192                        break\n  1418\u2192                    # Remove temporary files for invalid candidates.\n  1419\u2192                    source.cleanup(candidate)\n  1420\u2192                if out:\n  1421\u2192                    break\n  1422\u2192\n  1423\u2192        if out:\n  1424\u2