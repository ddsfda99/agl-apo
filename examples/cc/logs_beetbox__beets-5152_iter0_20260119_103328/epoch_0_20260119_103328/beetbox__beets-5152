   else:\n   326\u2192\n   327\u2192            def field(i):\n   328\u2192                return i.artist_sort or i.artist\n   329\u2192\n   330\u2192        if self.case_insensitive:\n   331\u2192\n   332\u2192            def key(x):\n   333\u2192                return field(x).lower()\n   334\u2192\n   335\u2192        else:\n   336\u2192            key = field\n   337\u2192        return sorted(objs, key=key, reverse=not self.ascending)\n   338\u2192\n   339\u2192\n   340\u2192# Special path format key.\n   341\u2192PF_KEY_DEFAULT = \"default\"\n   342\u2192\n   343\u2192\n   344\u2192# Exceptions.\n   345\u2192class FileOperationError(Exception):\n   346\u2192    \"\"\"Indicate an error when interacting with a file on disk.\n   347\u2192\n   348\u2192    Possibilities include an unsupported media type, a permissions\n   349\u2192    error, and an unhandled Mutagen exception.\n   350\u2192    \"\"\"\n   351\u2192\n   352\u2192    def __init__(self, path, reason):\n   353\u2192        \"\"\"Create an exception describing an operation on the file at\n   354\u2192        `path` with the underlying (chained) exception `reason`.\n   355\u2192        \"\"\"\n   356\u2192        super().__init__(path, reason)\n   357\u2192        self.path = path\n   358\u2192        self.reason = reason\n   359\u2192\n   360\u2192    def __str__(self):\n   361\u2192        \"\"\"Get a string representing the error.\n   362\u2192\n   363\u2192        Describe both the underlying reason and the file path in question.\n   364\u2192        \"\"\"\n   365\u2192        return f\"{util.displayable_path(self.path)}: {self.reason}\"\n   366\u2192\n   367\u2192\n   368\u2192class ReadError(FileOperationError):\n   369\u2192    \"\"\"An error while reading a file (i.e. in `Item.read`).\"\"\"\n   370\u2192\n   371\u2192    def __str__(self):\n   372\u2192        return \"error reading \" + str(super())\n   373\u2192\n   374\u2192\n   375\u2192class WriteError(FileOperationError):\n   376\u2192    \"\"\"An error while writing a file (i.e. in `Item.write`).\"\"\"\n   377\u2192\n   378\u2192    def __str__(self):\n   379\u2192        return \"error writing \" + str(super())\n   380\u2192\n   381\u2192\n   382\u2192# Item and Album model classes.\n   383\u2192\n   384\u2192\n   385\u2192class LibModel(dbcore.Model):\n   386\u2192    \"\"\"Shared concrete functionality for Items and Albums.\"\"\"\n   387\u2192\n   388\u2192    # Config key that specifies how an instance should be formatted.\n   389\u2192    _format_config_key: str\n   390\u2192\n   391\u2192    def _template_funcs(self):\n   392\u2192        funcs = DefaultTemplateFunctions(self, self._db).functions()\n   393\u2192        funcs.update(plugins.template_funcs())\n   394\u2192        return funcs\n   395\u2192\n   396\u2192    def store(self, fields=None):\n   397\u2192        super().store(fields)\n   398\u2192        plugins.send(\"database_change\", lib=self._db, model=self)\n   399\u2192\n   400\u2192    def remove(self):\n   401\u2192        super().remove()\n   402\u2192        plugins.send(\"database_change\", lib=self._db, model=self)\n   403\u2192\n   404\u2192    def add(self, lib=None):\n   405\u2192        super().add(lib)\n   406\u2192        plugins.send(\"database_change\", lib=self._db, model=self)\n   407\u2192\n   408\u2192    def __format__(self, spec):\n   409\u2192        if not spec:\n   410\u2192            spec = beets.config[self._format_config_key].as_str()\n   411\u2192        assert isinstance(spec, str)\n   412\u2192        return self.evaluate_template(spec)\n   413\u2192\n   414\u2192    def __str__(self):\n   415\u2192        return format(self)\n   416\u2192\n   417\u2192    def __bytes__(self):\n   418\u2192        return self.__str__().encode(\"utf-8\")\n   419\u2192\n   420\u2192\n   421\u2192class FormattedItemMapping(dbcore.db.FormattedMapping):\n   422\u2192    \"\"\"Add lookup for album-level fields.\n   423\u2192\n   424\u2192    Album-level fields take precedence if `for_path` is true.\n   425\u2192    \"\"\"\n   426\u2192\n   427\u2192    ALL_KEYS = \"*\"\n   428\u2192\n   429\u2192    def __init__(self, item, included_keys=ALL_KEYS, for_path=False):\n   430\u2192        # We treat album and item keys specially here,\n   431\u2192        # so exclude transitive album keys from the model's keys.\n   432\u2192        super().__init__(item, included_keys=[], for_path=for_path)\n   433\u2192        self.included_keys = included_keys\n   434\u2192        if included_keys == self.ALL_KEYS:\n   435\u2192            # Performance note: this triggers a database query.\n   436\u2192            self.model_keys = item.keys(computed=True, with_album=False)\n   437\u2192        else:\n   438\u2192            self.model_keys = included_keys\n   439\u2192        self.item = item\n   440\u2192\n   441\u2192    @cached_property\n   442\u2192    def all_keys(self):\n   443\u2192        return set(self.model_keys).union(self.album_keys)\n   444\u2192\n   445\u2192    @cached_property\n   446\u2192    def album_keys(self):\n   447\u2192        album_keys = []\n   448\u2192        if self.album:\n   449\u2192            if self.included_keys == self.ALL_KEYS:\n   450\u2192                # Performance note: this triggers a database query.\n   451\u2192                for key in self.album.keys(computed=True):\n   452\u2192                    if (\n   453\u2192                        key in Album.item_keys\n   454\u2192                        or key not in self.item._fields.keys()\n   455\u2192                    ):\n   456\u2192                        album_keys.append(key)\n   457\u2192            else:\n   458\u2192                album_keys = self.included_keys\n   459\u2192        return album_keys\n   460\u2192\n   461\u2192    @property\n   462\u2192    def album(self):\n   463\u2192        return self.item._cached_album\n   464\u2192\n   465\u2192    def _get(self, key):\n   466\u2192        \"\"\"Get the value for a key, either from the album or the item.\n   467\u2192\n   468\u2192        Raise a KeyError for invalid keys.\n   469\u2192        \"\"\"\n   470\u2192        if self.for_path and key in self.album_keys:\n   471\u2192            return self._get_formatted(self.album, key)\n   472\u2192        elif key in self.model_keys:\n   473\u2192            return self._get_formatted(self.model, key)\n   474\u2192        elif key in self.album_keys:\n   475\u2192            return self._get_formatted(self.album, key)\n   476\u2192        else:\n   477\u2192            raise KeyError(key)\n   478\u2192\n   479\u2192    def __getitem__(self, key):\n   480\u2192        \"\"\"Get the value for a key.\n   481\u2192\n   482\u2192        `artist` and `albumartist` are fallback values for each other\n   483\u2192        when not set.\n   484\u2192        \"\"\"\n   485\u2192        value = self._get(key)\n   486\u2192\n   487\u2192        # `artist` and `albumartist` fields fall back to one another.\n   488\u2192        # This is helpful in path formats when the album artist is unset\n   489\u2192        # on as-is imports.\n   490\u2192        try:\n   491\u2192            if key == \"artist\" and not value:\n   492\u2192                return self._get(\"albumartist\")\n   493\u2192            elif key == \"albumartist\" and not value:\n   494\u2192                return self._get(\"artist\")\n   495\u2192        except KeyError:\n   496\u2192            pass\n   497\u2192\n   498\u2192        return value\n   499\u2192\n   500\u2192    def __iter__(self):\n   501\u2192        return iter(self.all_keys)\n   502\u2192\n   503\u2192    def __len__(self):\n   504\u2192        return len(self.all_keys)\n   505\u2192\n   506\u2192\n   507\u2192class Item(LibModel):\n   508\u2192    \"\"\"Represent a song or track.\"\"\"\n   509\u2192\n   510\u2192    _table = \"items\"\n   511\u2192    _flex_table = \"item_attributes\"\n   512\u2192    _fields = {\n   513\u2192        \"id\": types.PRIMARY_ID,\n   514\