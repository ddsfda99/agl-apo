4\u2192\n   435\u2192        try:\n   436\u2192            im = Image.open(syspath(path_in))\n   437\u2192            return im.size\n   438\u2192        except OSError as exc:\n   439\u2192            log.error(\n   440\u2192                \"PIL could not read file {}: {}\", displayable_path(path_in), exc\n   441\u2192            )\n   442\u2192            return None\n   443\u2192\n   444\u2192    def deinterlace(self, path_in, path_out=None):\n   445\u2192        path_out = path_out or temp_file_for(path_in)\n   446\u2192        from PIL import Image\n   447\u2192\n   448\u2192        try:\n   449\u2192            im = Image.open(syspath(path_in))\n   450\u2192            im.save(os.fsdecode(path_out), progressive=False)\n   451\u2192            return path_out\n   452\u2192        except OSError:\n   453\u2192            # FIXME: Should probably issue a warning?\n   454\u2192            return path_in\n   455\u2192\n   456\u2192    def get_format(self, filepath):\n   457\u2192        from PIL import Image, UnidentifiedImageError\n   458\u2192\n   459\u2192        try:\n   460\u2192            with Image.open(syspath(filepath)) as im:\n   461\u2192                return im.format\n   462\u2192        except (\n   463\u2192            ValueError,\n   464\u2192            TypeError,\n   465\u2192            UnidentifiedImageError,\n   466\u2192            FileNotFoundError,\n   467\u2192        ):\n   468\u2192            log.exception(\"failed to detect image format for {}\", filepath)\n   469\u2192            return None\n   470\u2192\n   471\u2192    def convert_format(self, source, target, deinterlaced):\n   472\u2192        from PIL import Image, UnidentifiedImageError\n   473\u2192\n   474\u2192        try:\n   475\u2192            with Image.open(syspath(source)) as im:\n   476\u2192                im.save(os.fsdecode(target), progressive=not deinterlaced)\n   477\u2192                return target\n   478\u2192        except (\n   479\u2192            ValueError,\n   480\u2192            TypeError,\n   481\u2192            UnidentifiedImageError,\n   482\u2192            FileNotFoundError,\n   483\u2192            OSError,\n   484\u2192        ):\n   485\u2192            log.exception(\"failed to convert image {} -> {}\", source, target)\n   486\u2192            return source\n   487\u2192\n   488\u2192    @property\n   489\u2192    def can_compare(self):\n   490\u2192        return False\n   491\u2192\n   492\u2192    def compare(self, im1, im2, compare_threshold):\n   493\u2192        # It is an error to call this when ArtResizer.can_compare is not True.\n   494\u2192        raise NotImplementedError()\n   495\u2192\n   496\u2192    @property\n   497\u2192    def can_write_metadata(self):\n   498\u2192        return True\n   499\u2192\n   500\u2192    def write_metadata(self, file, metadata):\n   501\u2192        from PIL import Image, PngImagePlugin\n   502\u2192\n   503\u2192        # FIXME: Detect and handle other file types (currently, the only user\n   504\u2192        # is the thumbnails plugin, which generates PNG images).\n   505\u2192        im = Image.open(syspath(file))\n   506\u2192        meta = PngImagePlugin.PngInfo()\n   507\u2192        for k, v in metadata.items():\n   508\u2192            meta.add_text(k, v, 0)\n   509\u2192        im.save(os.fsdecode(file), \"PNG\", pnginfo=meta)\n   510\u2192\n   511\u2192\n   512\u2192class Shareable(type):\n   513\u2192    \"\"\"A pseudo-singleton metaclass that allows both shared and\n   514\u2192    non-shared instances. The ``MyClass.shared`` property holds a\n   515\u2192    lazily-created shared instance of ``MyClass`` while calling\n   516\u2192    ``MyClass()`` to construct a new object works as usual.\n   517\u2192    \"\"\"\n   518\u2192\n   519\u2192    def __init__(cls, name, bases, dict):\n   520\u2192        super().__init__(name, bases, dict)\n   521\u2192        cls._instance = None\n   522\u2192\n   523\u2192    @property\n   524\u2192    def shared(cls):\n   525\u2192        if cls._instance is None:\n   526\u2192            cls._instance = cls()\n   527\u2192        return cls._instance\n   528\u2192\n   529\u2192\n   530\u2192BACKEND_CLASSES = [\n   531\u2192    IMBackend,\n   532\u2192    PILBackend,\n   533\u2192]\n   534\u2192\n   535\u2192\n   536\u2192class ArtResizer(metaclass=Shareable):\n   537\u2192    \"\"\"A singleton class that performs image resizes.\"\"\"\n   538\u2192\n   539\u2192    def __init__(self):\n   540\u2192        \"\"\"Create a resizer object with an inferred method.\"\"\"\n   541\u2192        # Check if a local backend is available, and store an instance of the\n   542\u2192        # backend class. Otherwise, fallback to the web proxy.\n   543\u2192        for backend_cls in BACKEND_CLASSES:\n   544\u2192            try:\n   545\u2192                self.local_method = backend_cls()\n   546\u2192                log.debug(f\"artresizer: method is {self.local_method.NAME}\")\n   547\u2192                break\n   548\u2192            except LocalBackendNotAvailableError:\n   549\u2192                continue\n   550\u2192        else:\n   551\u2192            log.debug(\"artresizer: method is WEBPROXY\")\n   552\u2192            self.local_method = None\n   553\u2192\n   554\u2192    @property\n   555\u2192    def method(self):\n   556\u2192        if self.local:\n   557\u2192            return self.local_method.NAME\n   558\u2192        else:\n   559\u2192            return \"WEBPROXY\"\n   560\u2192\n   561\u2192    def resize(\n   562\u2192        self, maxwidth, path_in, path_out=None, quality=0, max_filesize=0\n   563\u2192    ):\n   564\u2192        \"\"\"Manipulate an image file according to the method, returning a\n   565\u2192        new path. For PIL or IMAGEMAGIC methods, resizes the image to a\n   566\u2192        temporary file and encodes with the specified quality level.\n   567\u2192        For WEBPROXY, returns `path_in` unmodified.\n   568\u2192        \"\"\"\n   569\u2192        if self.local:\n   570\u2192            return self.local_method.resize(\n   571\u2192                maxwidth,\n   572\u2192                path_in,\n   573\u2192                path_out,\n   574\u2192                quality=quality,\n   575\u2192                max_filesize=max_filesize,\n   576\u2192            )\n   577\u2192        else:\n   578\u2192            # Handled by `proxy_url` already.\n   579\u2192            return path_in\n   580\u2192\n   581\u2192    def deinterlace(self, path_in, path_out=None):\n   582\u2192        \"\"\"Deinterlace an image.\n   583\u2192\n   584\u2192        Only available locally.\n   585\u2192        \"\"\"\n   586\u2192        if self.local:\n   587\u2192            return self.local_method.deinterlace(path_in, path_out)\n   588\u2192        else:\n   589\u2192            # FIXME: Should probably issue a warning?\n   590\u2192            return path_in\n   591\u2192\n   592\u2192    def proxy_url(self, maxwidth, url, quality=0):\n   593\u2192        \"\"\"Modifies an image URL according the method, returning a new\n   594\u2192        URL. For WEBPROXY, a URL on the proxy server is returned.\n   595\u2192        Otherwise, the URL is returned unmodified.\n   596\u2192        \"\"\"\n   597\u2192        if self.local:\n   598\u2192            # Going to be handled by `resize()`.\n   599\u2192            return url\n   600\u2192        else:\n   601\u2192            return resize_url(url, maxwidth, quality)\n   602\u2192\n   603\u2192    @property\n   604\u2192    def local(self):\n   605\u2192        \"\"\"A boolean indicating whether the resizing method is performed\n   606\u2192        locally (i.e., PIL or ImageMagick).\n   607\u2192        \"\"\"\n   608\u2192        return self.local_method is not None\n   609\u2192\n   610\u2192    def get_size(self, path_in):\n   611\u2192        \"\"\"Return the size of an image file as an int couple (width, height)\n   612\u2192        in pixels.\n   613\u2192\n   614\u2192        Only available locally.\n   615\u2192        \"\"\"\n   616\u2192        if self.local:\n   617\u2192            return self.local_method.get_size(path_in)\n   618\u2192        else:\n   619\u2192            # FIXME: Should probably issue a warning?\n   620\u2192            return path_in\n   621\u2192\n   622\u2192    def get_format(self, path_in):\n   623\u2192        \"\"\"Returns the format of the image as a string.\n   624\u2192\n   625\u2192        Only available locally.\n   626\u2192        \"\"\"\n   627\u2192        if self.local:\n   628\u2192            return self.local_method.get_format(path_in)\n   629\u2192        else:\n   630\u2192            # FIXME: Should probably issue a warning?\n   631\u2192            return None\n   632\u2192\n   633\u2192    def reformat(self, path_in, new_format, deinterlaced=True):\n   634\u2192        \"\"\"Converts image to desired format, updating its extension, but\n   635\u2192        keeping the same filename.\n   636\u2192\n   637\u2192        Only available locally.\n   638\u2192        \"\"\"\n   639\u2192        if not self.local:\n   640\u2192            # FIXME: Should probably issue a warning?\n   641\u2192            return path_in\n   642\u2192\n   643\u2192        new_format = new_format.lower()\n   644\u2192        # A nonexhaustive map of image \"types\" to extensions overrides\n   645\u2192        new_format = {\n   646\u2192            \"jpeg\": \"jpg\",\n   647\u2192        }.get(new_format, new_format)\n   648\u2192\n   649\u2192        fname, ext = os.path.splitext(path_in)\n   650\u2192        path_new = fname + b\".\" + new_format.encode(\"utf8\")\n   651\u2192\n   652\u2192        # allows the exception to propagate, while still making sure a changed\n   653\u2192        # file path was removed\n   654\u2192        result_path = path_in\n   655\u2192        try:\n   656\u2192            result_path = self.local_method.convert_format(\n   657\u2192                path_in, path_new, deinterlaced\n   658\u2192            )\n   659\u2192        finally:\n   660\u2192            if result_path != path_in:\n   661\u2192                os.unlink(path_in)\n   662\u2192        return result_path\n   663\u2192\n   664\u2192    @property\n   665\u2192    def can_compare(self):\n   666\u2192        \"\"\"A boolean indicating whether image comparison is available\"\"\"\n   667\u2192\n   668\u2192        if self.local:\n   669\u2192            return self.local_method.can_compare\n   670\u2192        else:\n   671\u2192            return False\n   672\u2192\n   673\u2192    def compare(self, im1, im2, compare_threshold):\n   674\u2192        \"\"\"Return a boolean indicating whether two images are similar.\n   675\u2192\n   676\u2192        Only available locally.\n   677\u2192        \"\"\"\n   678\u2192        if self.local:\n   679\u2192            return self.local_method.compare(im1, im2, compare_threshold)\n   680\u2192        else:\n   681\u2192            # FIXME: Should probably issue a warning?\n   682\u2192            return None\n   683\u2192\n   684\u2192    @property\n   685\u2192    def can_write_metadata(self):\n   686\u2192        \"\"\"A boolean indicating whether writing image metadata is supported.\"\"\"\n   687\u2192\n   688\u2192        if self.local:\n   689\u2192            return self.local_method.can_write_metadata\n   690\u2192        else:\n   691\u2192            return False\n   692\u2192\n   693\u2192    def write_metadata(self, file, metadata):\n   694\u2192        \"\"\"Write key-value metadata to the image file.\n   695\u2192\n   696\u2192        Only available locally. Currently, expects the image to be a PNG file.\n   697\u2192        \"\"\"\n   698\u2192        if self.local:\n   699\u2192            self.local_method.write_metadata(file, metadata)\n   700\u2192        else:\n   701\u2192            # FIXME: Should probably issue a warning?\n   702\u2192            pass\n   703\u2192\n\n<system-reminder>\nWhene