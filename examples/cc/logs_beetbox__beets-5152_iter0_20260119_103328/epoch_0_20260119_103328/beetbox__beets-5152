\n   447→                util.remove(path=candidate.path)\n   448→            except util.FilesystemError as exc:\n   449→                self._log.debug(\"error cleaning up tmp art: {}\", exc)\n   450→\n   451→\n   452→class CoverArtArchive(RemoteArtSource):\n   453→    NAME = \"Cover Art Archive\"\n   454→    VALID_MATCHING_CRITERIA = [\"release\", \"releasegroup\"]\n   455→    VALID_THUMBNAIL_SIZES = [250, 500, 1200]\n   456→\n   457→    URL = \"https://coverartarchive.org/release/{mbid}\"\n   458→    GROUP_URL = \"https://coverartarchive.org/release-group/{mbid}\"\n   459→\n   460→    def get(self, album, plugin, paths):\n   461→        \"\"\"Return the Cover Art Archive and Cover Art Archive release\n   462→        group URLs using album MusicBrainz release ID and release group\n   463→        ID.\n   464→        \"\"\"\n   465→\n   466→        def get_image_urls(url, preferred_width=None):\n   467→            try:\n   468→                response = self.request(url)\n   469→            except requests.RequestException:\n   470→                self._log.debug(\n   471→                    \"{}: error receiving response\".format(self.NAME)\n   472→                )\n   473→                return\n   474→\n   475→            try:\n   476→                data = response.json()\n   477→            except ValueError:\n   478→                self._log.debug(\n   479→                    \"{}: error loading response: {}\".format(\n   480→                        self.NAME, response.text\n   481→                    )\n   482→                )\n   483→                return\n   484→\n   485→            for item in data.get(\"images\", []):\n   486→                try:\n   487→                    if \"Front\" not in item[\"types\"]:\n   488→                        continue\n   489→\n   490→                    # If there is a pre-sized thumbnail of the desired size\n   491→                    # we select it. Otherwise, we return the raw image.\n   492→                    image_url: str = item[\"image\"]\n   493→                    if preferred_width is not None:\n   494→                        if isinstance(item.get(\"thumbnails\"), dict):\n   495→                            image_url = item[\"thumbnails\"].get(\n   496→                                preferred_width, image_url\n   497→                            )\n   498→                    yield image_url\n   499→                except KeyError:\n   500→                    pass\n   501→\n   502→        release_url = self.URL.format(mbid=album.mb_albumid)\n   503→        release_group_url = self.GROUP_URL.format(mbid=album.mb_releasegroupid)\n   504→\n   505→        # Cover Art Archive API offers pre-resized thumbnails at several sizes.\n   506→        # If the maxwidth config matches one of the already available sizes\n   507→        # fetch it directly instead of fetching the full sized image and\n   508→        # resizing it.\n   509→        preferred_width = None\n   510→        if plugin.maxwidth in self.VALID_THUMBNAIL_SIZES:\n   511→            preferred_width = str(plugin.maxwidth)\n   512→\n   513→        if \"release\" in self.match_by and album.mb_albumid:\n   514→            for url in get_image_urls(release_url, preferred_width):\n   515→                yield self._candidate(url=url, match=Candidate.MATCH_EXACT)\n   516→\n   517→        if \"releasegroup\" in self.match_by and album.mb_releasegroupid:\n   518→            for url in get_image_urls(release_group_url, preferred_width):\n   519→                yield self._candidate(url=url, match=Candidate.MATCH_FALLBACK)\n   520→\n   521→\n   522→class Amazon(RemoteArtSource):\n   523→    NAME = \"Amazon\"\n   524→    URL = \"https://images.amazon.com/images/P/%s.%02i.LZZZZZZZ.jpg\"\n   525→    INDICES = (1, 2)\n   526→\n   527→    def get(self, album, plugin, paths):\n   528→        \"\"\"Generate URLs using Amazon ID (ASIN) string.\"\"\"\n   529→        if album.asin:\n   530→            for index in self.INDICES:\n   531→                yield self._candidate(\n   532→                    url=self.URL % (album.asin, index),\n   533→                    match=Candidate.MATCH_EXACT,\n   534→                )\n   535→\n   536→\n   537→class AlbumArtOrg(RemoteArtSource):\n   538→    NAME = \"AlbumArt.org scraper\"\n   539→    URL = \"https://www.albumart.org/index_detail.php\"\n   540→    PAT = r'href\\s*=\\s*\"([^>\"]*)\"[^>]*title\\s*=\\s*\"View larger image\"'\n   541→\n   542→    def get(self, album, plugin, paths):\n   543→        \"\"\"Return art URL from AlbumArt.org using album ASIN.\"\"\"\n   544→        if not album.asin:\n   545→            return\n   546→        # Get the page from albumart.org.\n   547→        try:\n   548→            resp = self.request(self.URL, params={\"asin\": album.asin})\n   549→            self._log.debug(\"scraped art URL: {0}\", resp.url)\n   550→        except requests.RequestException:\n   551→            self._log.debug(\"error scraping art page\")\n   552→            return\n   553→\n   554→        # Search the page for the image URL.\n   555→        m = re.search(self.PAT, resp.text)\n   556→        if m:\n   557→            image_url = m.group(1)\n   558→            yield self._candidate(url=image_url, match=Candidate.MATCH_EXACT)\n   559→        else:\n   560→            self._log.debug(\"no image found on page\")\n   561→\n   562→\n   563→class GoogleImages(RemoteArtSource):\n   564→    NAME = \"Google Images\"\n   565→    URL = \"https://www.googleapis.com/customsearch/v1\"\n   566→\n   567→    def __init__(self, *args, **kwargs):\n   568→        super().__init__(*args, **kwargs)\n   569→        self.key = (self._config[\"google_key\"].get(),)\n   570→        self.cx = (self._config[\"google_engine\"].get(),)\n   571→\n   572→    @staticmethod\n   573→    def add_default_config(config):\n   574→        config.add(\n   575→            {\n   576→                \"google_key\": None,\n   577→                \"google_engine\": \"001442825323518