 kwargs:\n   247→        message = kwargs.pop(\"message\")\n   248→    else:\n   249→        message = \"getting URL\"\n   250→\n   251→    req = requests.Request(\"GET\", *args, **req_kwargs)\n   252→\n   253→    with requests.Session() as s:\n   254→        s.headers = {\"User-Agent\": \"beets\"}\n   255→        prepped = s.prepare_request(req)\n   256→        settings = s.merge_environment_settings(\n   257→            prepped.url, {}, None, None, None\n   258→        )\n   259→        send_kwargs.update(settings)\n   260→        log.debug(\"{}: {}\", message, prepped.url)\n   261→        return s.send(prepped, **send_kwargs)\n   262→\n   263→\n   264→class RequestMixin:\n   265→    \"\"\"Adds a Requests wrapper to the class that uses the logger, which\n   266→    must be named `self._log`.\n   267→    \"\"\"\n   268→\n   269→    def request(self, *args, **kwargs):\n   270→        \"\"\"Like `requests.get`, but uses the logger `self._log`.\n   271→\n   272→        See also `_logged_get`.\n   273→        \"\"\"\n   274→        return _logged_get(self._log, *args, **kwargs)\n   275→\n   276→\n   277→# ART SOURCES ################################################################\n   278→\n   279→\n   280→class ArtSource(RequestMixin):\n   281→    VALID_MATCHING_CRITERIA = [\"default\"]\n   282→\n   283→    def __init__(self, log, config, match_by=None):\n   284→        self._log = log\n   285→        self._config = config\n   286→        self.match_by = match_by or self.VALID_MATCHING_CRITERIA\n   287→\n   288→    @staticmethod\n   289→    def add_default_config(config):\n   290→        pass\n   291→\n   292→    @classmethod\n   293→    def available(cls, log, config):\n   294→        \"\"\"Return whether or not all dependencies are met and the art source is\n   295        in fact usable.\n   296→        \"\"\"\n   297→        return True\n   298→\n   299→    def get(self, album, plugin, paths):\n   300→        raise NotImplementedError()\n   301→\n   302→    def _candidate(self, **kwargs):\n   303→        return Candidate(source=self, log=self._log, **kwargs)\n   304→\n   305→    def fetch_image(self, candidate, plugin):\n   306→        raise NotImplementedError()\n   307→\n   308→    def cleanup(self, candidate):\n   309→        pass\n   310→\n   311→\n   312→class LocalArtSource(ArtSource):\n   313→    IS_LOCAL = True\n   314→    LOC_STR = \"local\"\n   315→\n   316→    def fetch_image(self, candidate, plugin):\n   317→        pass\n   318→\n   319→\n   320→class RemoteArtSource(ArtSource):\n   321→    IS_LOCAL = False\n   322→    LOC_STR = \"remote\"\n   323→\n   324→    def fetch_image(self, candidate, plugin):\n   325→        \"\"\"Downloads an image from a URL and checks whether it seems to\n   326→        actually be an image. If so, returns a path to the downloaded image.\n   327→        Otherwise, returns None.\n   328→        \"\"\"\n   329→        if plugin.maxwidth:\n   330→            candidate.url = ArtResizer.shared.proxy_url(\n   331→                plugin.maxwidth, candidate.url\n   332→            )\n   333→        try:\n   334→            with closing(\n   335→                self.request(\n   336→                    candidate.url, stream=True, message=\"downloading image\"\n   337→                )\n   338→            ) as resp:\n   339→                ct = resp.headers.get(\"Content-Type\", None)\n   340→\n   341→                # Download the image to a temporary file. As some servers\n   342→                # (notably fanart.tv) have proven to return wrong Content-Types\n   343→                # when images were uploaded with a bad file extension, do not\n   344→                # rely on it. Instead validate the type using the file magic\n   345→                # and only then determine the extension.\n   346→                data = resp.iter_content(chunk_size=1024)\n   347→                header = b\"\"\n   348→                for chunk in data:\n   349→                    header += chunk\n   350→                    if len(header) >= 32:\n   351→                        # The imghdr module will only read 32 bytes, and our\n   352→                        # own additions in mediafile even less.\n   353→                        break\n   354→                else:\n   355→                    # server didn't return enough data, i.e. corrupt image\n   356→                    return\n   357→\n   358→                real_ct = image_mime_type(header)\n   359→                if real_ct is None:\n   360→                    # detection by file magic failed, fall back to the\n   361→                    # server-supplied Content-Type\n   362→                    # Is our type detection failsafe enough to drop this?\n   363→                    real_ct = ct\n   364→\n   365→                if real_ct not in CONTENT_TYPES:\n   366→                    self._log.debug(\n   367→                        \"not a supported image: {}\",\n   368→                        real_ct or \"unknown content type\",\n   369→                    )\n   370→                    return\n   371→\n   372→                ext = b\".\" + CONTENT_TYPES[real_ct][0]\n   373→\n   374→                if real_ct != ct:\n   375→                    self._log.warning(\n   376→                        \"Server specified {}, but returned a \"\n   377→                        \"{} image. Correcting the extension \"\n   378→                        \"to {}\",\n   379→                        ct,\n   380→                        real_ct,\n   381→                        ext,\n   382→                    )\n   383→\n   384→                suffix = os.fsdecode(ext)\n   385→                with NamedTemporaryFile(suffix=suffix, delete=False) as fh:\n   386→                    # write the first already loaded part of the image\n   387→                    fh.write(header)\n   388→                    # download the remaining part of the image\n   389→                    for chunk in data:\n   390→                        fh.write(chunk)\n   391→                self._log.debug(\n   392→                    \"downloaded art to: {0}\", util.displayable_path(fh.name)\n   393→                )\n   394→                candidate.path = util.bytestring_path(fh.name)\n   395→                return\n   396→\n   397→        except (OSError, requests.RequestException, TypeError) as exc:\n   398→            # Handling TypeError works around a urllib3 bug:\n   399→            # https://github.com/shazow/urllib3/issues/556\n   400→            self._log.debug(\"error fetching art: {}\", exc)\n   401→            return\n   402→\n   403→    def cleanup(self, candidate):\n   404→        if candidate.path:\n   405→            try:\n   406→                util.remove(path=candidate.path)\n   407→            except util.FilesystemError as exc:\n   408→                self._log.debug(\"error cleaning up tmp art: {}\", exc)\n   409→\n   410→\n   411→class CoverArtArchive(RemoteArtSource):\n   412→    NAME = \"Cover Art Archive\"\n   413→    VALID_MATCHING_CRITERIA = [\"release\", \"releasegroup\"]\n   414→    VALID_THUMBNAIL_SIZES = [250, 500, 1200]\n   415→\n   416→    URL = \"https://coverartarchive.org/release/{mbid}\"\n   417→    GROUP_URL = \"https://coverartarchive.org/release-group/{mbid}\"\n   418→\n   419→    def get(self, album, plugin, paths):\n   420→        \"\"\"Return the Cover Art Archive and Cover Art Archive release\n   421→        group URLs using album MusicBrainz release ID and release group\n   422→        ID.\n   423→        \"\"\"\n   424→\n   425→        def get_image_urls(url, preferred_width=None):\n   426→            try:\n   427→                response = self.request(url)\n   428→            except requests.RequestException:\n   429→                self._log.debug(\n   430→                    \"{}: error receiving response\".format(self.NAME)\n   431→                )\n   432→                return\n   433→\n   434→            try:\n   435→                data = response.json()\n   436→            except ValueError:\n   437→                self._log.debug(\n   438→                    \"{}: error loading response: {}\".format(\n   439→                        self.NAME, response.text\n   440→                    )\n   441→                )\n   442→                return\n   443→\n   444→            for item in data.get(\"images\", []):\n   445→                try:\n   446→                    if \"Front\" not in item[\"types\"]:\n   447→                        continue\n   448→\n   449→                    # If there is a pre-sized thumbnail of the desired size\n   450→                    # we select it. Otherwise, we return the raw image.\n   451→                    image_url: str = item[\"image\"]\n   452→                    if preferred_width is not None:\n   453→                        if isinstance(item.get(\"thumbnails\"), dict):\n   454→                            image_url = item[\"thumbnails\"].get(\n   455→                                preferred_width, image_url\n   456→                            )\n   457→                    yield image_url\n   458→                except KeyError:\n   459→                    pass\n   460→\n   461→        release_url = self.URL.format(mbid=album.mb_albumid)\n   462→        release_group_url = self.GROUP_URL.format(mbid=album.mb_releasegroupid)\n   463→\n   464→        # Cover Art Archive API offers pre-resized thumbnails at several sizes.\n   465→        # If the maxwidth config matches one of the already available sizes\n   466→        # fetch it directly instead of fetching the full sized image and\n   467→        # resizing it.\n   468→        preferred_width = None\n   469→        if plugin.maxwidth in self.VALID_THUMBNAIL_SIZES:\n   470→            preferred_width = str(plugin.maxwidth)\n   471→\n   472→        if \"release\" in self.match_by and album.mb_albumid:\n   473→            for url in get_image_urls(release_url, preferred_width):\n   474→                yield self._candidate(url=url, match=Candidate.MATCH_EXACT)\n   475→\n   476→        if \"releasegroup\" in self.match_by and album.mb_releasegroupid:\n   477→            for url in get_image_urls(release_group_url, preferred_width):\n   478→                yield self._candidate(url=url, match=Candidate.MATCH_FALLBACK)\n   479→\n   480→\n   481→class Amazon(RemoteArtSource):\n   482→    NAME = \"Amazon\"\n   483→    URL = \"https://images.amazon.com/images/P/%s.%02i.LZZZZZZZ.jpg\"\n   484→    INDICES = (1, 2)\n   485→\n   486→    def get(self, album, plugin, paths):\n   487→        \"\"\"Generate URLs using Amazon ID (ASIN) string.\"\"\"\n   488→        if album.asin:\n   489→            for index in self.INDICES:\n   490→                yield self._candidate(\n   491→                    url=self.URL % (album.asin, index),\n   492→                    match=Candidate.MATCH_EXACT,\n   493→                )\n   494→\n   495→\n   496→class AlbumArtOrg(RemoteArtSource):\n   497→    NAME = \"AlbumArt.org scraper\"\n   498→    URL = \"https://www.albumart.org/index_detail.php\"\n   499→    PAT = r'href\\s*=\\s*\"([^>\"]*)\"[^>]*title\\s*=\\s*\"View larger image\"'\n   500→\n   501→    def get(self, album, plugin, paths):\n   502→        \"\"\"Return art URL from AlbumArt.org using album ASIN.\"\"\"\n   503→        if not album.asin:\n   504→            return\n   505→        # Get the page from albumart.org.\n   506→        try:\n   507→            resp = self.request(self.URL, params={\"asin\": album.asin})\n   508→            self._log.debug(\"scraped art URL: {0}\", resp.url)\n   509→        except requests.RequestException:\n   510→            self._log.debug(\"error scraping art page\")\n   511→            return\n   512→\n   513→        # Search the page for the image URL.\n   514→        m = re.search(self.PAT, resp.text)\n   515→        if m:\n   516→            image_url = m.group(1)\n   517→            yield self._candidate(url=image_url, match=Candidate.MATCH_EXACT)\n   518→        else:\n   519→            self._log.debug(\"no image found on page\")\n   520→\n   521→\n   522→class GoogleImages(RemoteArtSource):\n   523→    NAME = \"Google Images\"\n   524→    URL = \"https://www.googleapis.com/customsearch/v1\"\n   525→\n   526→    def __init__(self, *args, **kwargs):\n   527→        super().__init__(*args, **kwargs)\n   528→        self.key = (self._config[\"google_key\"].get(),)\n   529→        self.cx = (self._config[\"google_engine\"].get(),)\n   530→\n   531→    @staticmethod\n   532→    def add_default_config(config):\n   533→        config.add(\n   534→            {\n   535→                \"google_key\": None,\n   536→                \"google_engine\": \"001442825323518660753:hrh5ch1gjzm\",\n   537→            }\n   538→        )\n   539→        config[\"google_key\"].redact = True\n   540→\n   541→    @classmethod\n   542→    def available(cls, log, config):\n   543→        has_key = bool(config[\"google_key\"].get())\n   544→        if not has_key:\n   545→            log.debug(\"google: Disabling art source due to missing key\")\n   546→        return has_key\n   547→\n   548→    def get(self, album, plugin, paths):\n   549→        \"\"\"Return art URL from google custom search engine\n   550→        given an album title and interpreter.\n   551→        \"\"\"\n   552→        if not (album.albumartist and album.album):\n   553→            return\n   554→        search_string = (album.albumartist + \",\" + album.album).encode(\"utf-8\")\n   555→\n   556→        try:\n   557→            response = self.request(\n   558→                self.URL,\n   559→                params={\n   560→                    \"key\": self.key,\n   561→                    \"cx\": self.cx,\n   562→                    \"q\": search_string,\n   563→                    \"searchType\": \"image\",\n   564→                },\n   565→            )\n   566→        except requests.RequestException:\n   567→            self._log.debug(\"google: error receiving response\")\n   568→            return\n   569→\n   570→        # Get results using JSON.\n   571→        try:\n   572→            data = response.json()\n   573→        except ValueError:\n   574→            self._log.debug(\n   575→                \"google: error loading response: {}\".format(response.text)\n   576→            )\n   577→            return\n   578→\n   579→        if \"error\" in data:\n   580→            reason = data[\"error\"][\"errors\"][0][\"reason\"]\n   581→            self._log.debug(\"google fetchart error: {0}\", reason)\n   582→            return\n   583→\n   584→        if \"items\" in data.keys():\n   585→            for item in data[\"items\"]:\n   586→                yield self._candidate(\n   587→                    url=item[\"link\"], match=Candidate.MATCH_EXACT\n   588→                )\n   589→\n   590→\n   591→class FanartTV(RemoteArtSource):\n   592→    \"\"\"Art from fanart.tv requested using their API\"\"\"\n   593→\n   594→    NAME = \"fanart.tv\"\n   595→    API_URL = \"https://webservice.fanart.tv/v3/\"\n   596→    API_ALBUMS = API_URL + \"music/albums/\"\n   597→    PROJECT_KEY = \"61a7d0ab4e67162b7a0c7c35915cd48e\"\n   598→\n   599→    def __init__(self, *args, **kwargs):\n   600→        super().__init__(*args, **kwargs)\n   601→        self.client_key = self._config[\"fanarttv_key\"].get()\n   602→\n   603→    @staticmethod\n   604→    def add_default_config(config):\n   605→        config.add(\n   606→            {\n   607→                \"fanarttv_key\": None,\n   608→            }\n   609→        )\n   610→        config[\"fanarttv_key\"].redact = True\n   611→\n   612→    def get(self, album, plugin, paths):\n   613→        if not album.mb_releasegroupid:\n   614→            return\n   615→\n   616→        try:\n   617→            response = self.request(\n   618→                self.API_ALBUMS + album.mb_releasegroupid,\n   619→                headers={\n   620→                    \"api-key\": self.PROJECT_KEY,\n   621→                    \"client-key\": self.client_key,\n   622→                },\n   623→            )\n   624→        except requests.RequestException:\n   625→            self._log.debug(\"fanart.tv: error receiving response\")\n   626→            return\n   627→\n   628→        try:\n   629→            data = response.json()\n   630→        except ValueError:\n   631→            self._log.debug(\n   632→                \"fanart.tv: error loading response: {}\", response.text\n   633→            )\n   634→            return\n   635→\n   636→        if \"status\" in data and data[\"status\"] == \"error\":\n   637→            if \"not found\" in data[\"error message\"].lower():\n   638→                self._log.debug(\"fanart.tv: no image found\")\n   639→            elif \"api key\" in data[\"error message\"].lower():\n   640→                self._log.warning(\n   641→                    \"fanart.tv: Invalid API key given, please \"\n   642→                    \"enter a valid one in your config file.\"\n   643→                )\n   644→            else:\n   645→                self._log.debug(\n   646→                    \"fanart.tv: error on request: {}\", data[\"error message\"]\n   647→                )\n   648→            return\n   649→\n   650→        matches = []\n   651→        # can there be more than one releasegroupid per response?\n   652→        for mbid, art in data.get(\"albums\", {}).items():\n   653→            # there might be more art referenced, e.g. cdart, and an albumcover\n   654→            # might not be present, even if the request was successful\n   655→            if album.mb_releasegroupid == mbid and \"albumcover\" in art:\n   656→                matches.extend(art[\"albumcover\"])\n   657→            # can this actually occur?\n   658→            else:\n   659→                self._log.debug(\n   660→                    \"fanart.tv: unexpected mb_releasegroupid in \" \"response!\"\n   661→                )\n   662→\n   663→        matches.sort(key=lambda x: int(x[\"likes\"]), reverse=True)\n   664→        for item in matches:\n   665→            # fanart.tv has a strict size requirement for album art to be\n   666→            # uploaded\n   667→            yield self._candidate(\n   668→                url=item[\"url\"], match=Candidate.MATCH_EXACT, size=(1000, 1000)\n   669→            )\n   670→\n   671→\n   672→class ITunesStore(RemoteArtSource):\n   673→    NAME = \"iTunes Store\"\n   674→    API_URL = \"https://itunes.apple.com/search\"\n   675→\n   676→    def get(self, album, plugin, paths):\n   677→        \"\"\"Return art URL from iTunes Store given an album title.\"\"\"\n   678→        if not (album.albumartist and album.album):\n   679→            return\n   680→\n   681→        payload = {\n   682→            \"term\": album.albumartist + \" \" + album.album,\n   683→            \"entity\": \"album\",\n   684→            \"media\": \"music\",\n   685→            \"limit\": 200,\n   686→        }\n   687→        try:\n   688→            r = self.request(self.API_URL, params=payload)\n   689→            r.raise_for_status()\n   690→        except requests.RequestException as e:\n   691→            self._log.debug(\"iTunes search failed: {0}\", e)\n   692→            return\n   693→\n   694→        try:\n   695→            candidates = r.json()[\"results\"]\n   696→        except ValueError as e:\n   697→            self._log.debug(\"Could not decode json response: {0}\", e)\n   698→            return\n   699→        except KeyError as e:\n   700→            self._log.debug(\n   701→                \"{} not found in json. Fields are {} \", e, list(r.json().keys())\n   702→            )\n   703→            return\n   704→\n   705→        if not candidates:\n   706→            self._log.debug(\n   707→                \"iTunes search for {!r} got no results\", payload[\"term\"]\n   708→            )\n   709→            return\n   710→\n   711→        if self._config[\"high_resolution\"]:\n   712→            image_suffix = \"100000x100000-999\"\n   713→        else:\n   714→            image_suffix = \"1200x1200bb\"\n   715→\n   716→        for c in candidates:\n   717→            try:\n   718→                if (\n   719→                    c[\"artistName\"] == album.albumartist\n   720→                    and c[\"collectionName\"] == album.album\n   721→                ):\n   722→                    art_url = c[\"artworkUrl100\"]\n   723→                    art_url = art_url.replace(\"100x100bb\", image_suffix)\n   724→                    yield self._candidate(\n   725→                        url=art_url, match=Candidate.MATCH_EXACT\n   726→                    )\n   727→            except KeyError as e:\n   728→                self._log.debug(\n   729→                    \"Malformed itunes candidate: {} not found in {}\",  # NOQA E501\n   730→                    e,\n   731→                    list(c.keys()),\n   732→                )\n   733→\n   734→        try:\n   735→            fallback_art_url = candidates[0][\"artworkUrl100\"]\n   736→            fallback_art_url = fallback_art_url.replace(\n   737→                \"100x100bb\", image_suffix\n   738→            )\n   739→            yield self._candidate(\n   740→                url=fallback_art_url, match=Candidate.MATCH_FALLBACK\n   741→            )\n   742→        except KeyError as e:\n   743→            self._log.debug(\n   744→                \"Malformed itunes candidate: {} not found in {}\",\n   745→                e,\n   746→                list(c.keys()),\n   747→            )\n   748→\n   749→\n   750→class Wikipedia(RemoteArtSource):\n   751→    NAME = \"Wikipedia (queried through DBpedia)\"\n   752→    DBPEDIA_URL = \"https://dbpedia.org/sparql\"\n   753→    WIKIPEDIA_URL = \"https://en.wikipedia.org/w/api.php\"\n   754→    SPARQL_QUERY = \"\"\"PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>\n   755→                 PREFIX dbpprop: <http://dbpedia.org/property/>\n   756→                 PREFIX ow