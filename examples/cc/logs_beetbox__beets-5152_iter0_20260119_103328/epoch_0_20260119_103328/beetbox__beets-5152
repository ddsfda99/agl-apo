 [b\"jpg\", b\"jpeg\"], \"image/png\": [b\"png\"]}\n    41→IMAGE_EXTENSIONS = [ext for exts in CONTENT_TYPES.values() for ext in exts]\n    42→\n    43→\n    44→class Candidate:\n    45→    \"\"\"Holds information about a matching artwork, deals with validation of\n    46→    dimension restrictions and resizing.\n    47→    \"\"\"\n    48→\n    49→    CANDIDATE_BAD = 0\n    50→    CANDIDATE_EXACT = 1\n    51→    CANDIDATE_DOWNSCALE = 2\n    52→    CANDIDATE_DOWNSIZE = 3\n    53→    CANDIDATE_DEINTERLACE = 4\n    54→    CANDIDATE_REFORMAT = 5\n    55→\n    56→    MATCH_EXACT = 0\n    57→    MATCH_FALLBACK = 1\n    58→\n    59→    def __init__(\n    60→        self, log, path=None, url=None, source=\"\", match=None, size=None\n    61→    ):\n    62→        self._log = log\n    63→        self.path = path\n    64→        self.url = url\n    65→        self.source = source\n    66→        self.check = None\n    67→        self.match = match\n    68→        self.size = size\n    69→\n    70→    def _validate(self, plugin):\n    71→        \"\"\"Determine whether the candidate artwork is valid based on\n    72→        its dimensions (width and ratio).\n    73→\n    74→        Return `CANDIDATE_BAD` if the file is unusable.\n    75→        Return `CANDIDATE_EXACT` if the file is usable as-is.\n    76→        Return `CANDIDATE_DOWNSCALE` if the file must be rescaled.\n    77→        Return `CANDIDATE_DOWNSIZE` if the file must be resized, and possibly\n    78→            also rescaled.\n    79→        Return `CANDIDATE_DEINTERLACE` if the file must be deinterlaced.\n    80→        Return `CANDIDATE_REFORMAT` if the file has to be converted.\n    81→        \"\"\"\n    82→        if not self.path:\n    83→            return self.CANDIDATE_BAD\n    84→\n    85→        if not (\n    86→            plugin.enforce_ratio\n    87→            or plugin.minwidth\n    88→            or plugin.maxwidth\n    89→            or plugin.max_filesize\n    90→            or plugin.deinterlace\n    91→            or plugin.cover_format\n    92→        ):\n    93→            return self.CANDIDATE_EXACT\n    94→\n    95→        # get_size returns None if no local imaging backend is available\n    96→        if not self.size:\n    97→            self.size = ArtResizer.shared.get_size(self.path)\n    98→        self._log.debug(\"image size: {}\", self.size)\n    99→\n   100→        if not self.size:\n   101→            self._log.warning(\n   102→                \"Could not get size of image (please see \"\n   103→                \"documentation for dependencies). \"\n   104→                \"The configuration options `minwidth`, \"\n   105→                \"`enforce_ratio` and `max_filesize` \"\n   106→                \"may be violated.\"\n   107→            )\n   108→            return self.CANDIDATE_EXACT\n   109→\n   110→        short_edge = min(self.size)\n   111→        long_edge = max(self.size)\n   112→\n   113→        # Check minimum dimension.\n   114→        if plugin.minwidth and self.size[0] < plugin.minwidth:\n   115→            self._log.debug(\n   116→                \"image too small ({} < {})\", self.size[0], plugin.minwidth\n   117→            )\n   118→            return self.CANDIDATE_BAD\n   119→\n   120→        # Check aspect ratio.\n   121→        edge_diff = long_edge - short_edge\n   122→        if plugin.enforce_ratio:\n   123→            if plugin.margin_px:\n   124→                if edge_diff > plugin.margin_px:\n   125→                    self._log.debug(\n   126→                        \"image is not close enough to being \"\n   127→                        \"square, ({} - {} > {})\",\n   128→                        long_edge,\n   129→                        short_edge,\n   130→                        plugin.margin_px,\n   131→                    )\n   132→                    return self.CANDIDATE_BAD\n   133→            elif plugin.margin_percent:\n   134→                margin_px = plugin.margin_percent * long_edge\n   135→                if edge_diff > margin_px:\n   136→                    self._log.debug(\n   137→                        \"image is not close enough to being \"\n   138→                        \"square, ({} - {} > {})\",\n   139→                        long_edge,\n   140→                        short_edge,\n   141→                        margin_px,\n   142→                    )\n   143→                    return self.CANDIDATE_BAD\n   144→            elif edge_diff:\n   145→                # also reached for margin_px == 0 and margin_percent == 0.0\n   146→                self._log.debug(\n   147→                    \"image is not square ({} != {})\", self.size[0], self.size[1]\n   148→                )\n   149→                return self.CANDIDATE_BAD\n   150→\n   151→        # Check maximum dimension.\n   152→        downscale = False\n   153→        if plugin.maxwidth and self.size[0] > plugin.maxwidth:\n   154→            self._log.debug(\n   155→                \"image needs rescaling ({} > {})\", self.size[0], plugin.maxwidth\n   156→            )\n   157→            downscale = True\n   158→\n   159→        # Check filesize.\n   160→        downsize = False\n   161→        if plugin.max_filesize:\n   162→            filesize = os.stat(syspath(self.path)).st_size\n   163→            if filesize > plugin.max_filesize:\n   164→                self._log.debug(\n   165→                    \"image needs resizing ({}B > {}B)\",\n   166→                    filesize,\n   167→                    plugin.max_filesize,\n   168→                )\n   169→                downsize = True\n   170→\n   171→        # Check image format\n   172→        reformat = False\n   173→        if plugin.cover_format:\n   174→            fmt = ArtResizer.shared.get_format(self.path)\n   175→            reformat = fmt != plugin.cover_format\n   176→            if reformat:\n   177→                self._log.debug(\n   178→                    \"image needs reformatting: {} -> {}\",\n   179→                    fmt,\n   180→                    plugin.cover_format,\n   181→                )\n   182→\n   183→        if downscale:\n   184→            return self.CANDIDATE_DOWNSCALE\n   185→        elif downsize:\n   186→            return self.CANDIDATE_DOWNSIZE\n   187→        elif plugin.deinterlace:\n   188→            return self.CANDIDATE_DEINTERLACE\n   189→        elif reformat:\n   190→            return self.CANDIDATE_REFORMAT\n   191→        else:\n   192→            return self.CANDIDATE_EXACT\n   193→\n   194→    def validate(self, plugin):\n   195→        self.check = self._validate(plugin)\n   196→        return self.check\n   197→\n   198→    def resize(self, plugin):\n   199→        \"\"\"Apply all necessary transformations to satisfy plugin settings.\n   200→\n   201→        Historically, only a single operation indicated by `self.check` was\n   202→        performed. This caused issues when multiple operations were required\n   203→        (e.g., reformatting a PNG to JPEG and reducing filesize). Here, we\n   204→        determine and apply all applicable operations sequentially.\n   205→        \"\"\"\n   206→        # Ensure we have up-to-date size/format information.\n   207→        if not self.size:\n   208→            self.size = ArtResizer.shared.get_size(self.path)\n   209→        try:\n   210→            current_format = ArtResizer.shared.get_format(self.path)\n   211→        except Exception:\n   212→            current_format = None\n   213→\n   214→        # 1) Reformat first, if requested and needed.\n   215→        # Doing this first enables JPEG-specific downsizing to work.\n   216→        if plugin.cover_format:\n   217→            if current_format != plugin.cover_format:\n   218→                self.path = ArtResizer.shared.reformat(\n   219→                    self.path,\n   220→                    plugin.cover_format,\n   221→                    deinterlaced=plugin.deinterlace,\n   222→                )\n   223→                # Refresh size/format as they may have changed.\n   224→                self.size = ArtResizer.shared.get_size(self.path) or self.size\n   225→                current_format = ArtResizer.shared.get_format(self.path) or current_format\n   226→\n   227→        # 2) Deinterlace if requested and not already handled by reformat.\n   228→        # The reformat step above already respects `deinterlaced`, so only\n   229→        # deinterlace if we didn't reformat or format requires it separately.\n   230→        if plugin.deinterlace and self.check == self.CANDIDATE_DEINTERLACE:\n   231→            self.path = ArtResizer.shared.deinterlace(self.path)\n   232→            self.size = ArtResizer.shared.get_size(self.path) or self.size\n   233→\n   234→        # 3) Downscale and/or downsize as needed. Combine in a single resize\n   235→        # call when possible.\n   236→        downscale_needed = False\n   237→        if plugin.maxwidth and self.size and self.size[0] > plugin.maxwidth:\n   238→            downscale_needed = True\n   239→\n   240→        downsize_needed = False\n   241→        if plugin.max_filesize:\n   242→            try:\n   243→                filesize = os.stat(syspath(self.path)).st_size\n   244→                downsize_needed = filesize > plugin.max_filesize\n   245→            except Exception:\n   246→                downsize_needed = False\n   247→\n   248→        if downscale_needed or downsize_needed:\n   249→            # Use desired max width if downscaling, otherwise preserve dimensions\n   250→            # by using the current maximum edge.\n   251→            target_width = (\n   252→                plugin.maxwidth if downscale_needed else (max(self.size) if self.size else 0)\n   253→            )\n   254→            if target_width:\n   255→                self.path = ArtResizer.shared.resize(\n   256→                    target_width,\n   257→                    self.path,\n   258→                    quality=plugin.quality,\n   259→                    max_filesize=plugin.max_filesize,\n   260→                )\n   261→                # Refresh size after resize\n   262→                self.size = ArtResizer.shared.get_size(self.path) or self.size\n   263→\n   264→\n   265→def _logged_get(log, *args, **kwargs):\n   266→    \"\"\"Like `requests.get`, but logs the effective URL to the specified\n   267→    `log` at the `DEBUG` level.\n   268→\n   269→    Use the optional `message` parameter to specify what to log before\n   270→    the URL. By default, the string is \"getting URL\".\n   271→\n   272→    Also sets the User-Agent header to indicate beets.\n   273→    \"\"\"\n   274→    # Use some arguments with the `send` call but most with the\n   275→    # `Request` construction. This is a cheap, magic-filled way to\n   276→    # emulate `requests.get` or, more pertinently,\n   277→    # `requests.Session.request`.\n   278→    req_kwargs = kwargs\n   279→    send_kwargs = {}\n   280→    for arg in (\"stream\", \"verify\", \"proxies\", \"cert\", \"timeout\"):\n   281→        if arg in kwargs:\n   282→            send_kwargs[arg] = req_kwargs.pop(arg)\n   283→    if \"timeout\" not in send_kwargs:\n   284→        send_kwargs[\"timeout\"] = 10\n   285→\n   286→    # Our special logging message parameter.\n   287→    if \"message\" in kwargs:\n   288→        message = kwargs.pop(\"message\")\n   289→    else:\n   290→        message = \"getting URL\"\n   291→\n   292→    req = requests.Request(\"GET\", *args, **req_kwargs)\n   293→\n   294→    with requests.Session() as s:\n   295→        s.headers = {\"User-Agent\": \"beets\"}\n   296→        prepped = s.prepare_request(req)\n   297→        settings = s.merge_environment_settings(\n   298→            prepped.url, {}, None, None, None\n   299→        )\n   300→        send_kwargs.update(settings)\n   301→        log.debug(\"{}: {}\", message, prepped.url)\n   302→        return s.send(prepped, **send_kwargs)\n   303→\n   304→\n   305→class RequestMixin:\n   306→    \"\"\"Adds a Requests wrapper to the class that uses the logger, which\n   307→    must be named `self._log`.\n   308→    \"\"\"\n   309→\n   310→    def request(self, *args, **kwargs):\n   311→        \"\"\"Like `requests.get`, but uses the logger `self._log`.\n   312→\n   313→        See also `_logged_get`.\n   314→        \"\"\"\n   315→        return _logged_get(self._log, *args, **kwargs)\n   316→\n   317→\n   318→# ART SOURCES ################################################################\n   319→\n   320→\n   321→class ArtSource(RequestMixin):\n   322→    VALID_MATCHING_CRITERIA = [\"default\"]\n   323→\n   324→    def __init__(self, log, config, match_by=None):\n   325→        self._log = log\n   326→        self._config = config\n   327→        self.match_by = match_by or self.VALID_MATCHING_CRITERIA\n   328→\n   329→    @staticmethod\n   330→    def add_default_config(config):\n   331→        pass\n   332→\n   333→    @classmethod\n   334→    def available(cls, log, config):\n   335→        \"\"\"Return whether or not all dependencies are met and the art source is\n   336→        in fact usable.\n   337→        \"\"\"\n   338→        return True\n   339→\n   340→    def get(self, album, plugin, paths):\n   341→        raise NotImplementedError()\n   342→\n   343→    def _candidate(self, **kwargs):\n   344→        return Candidate(source=self, log=self._log, **kwargs)\n   345→\n   346→    def fetch_image(self, candidate, plugin):\n   347→        raise NotImplementedError()\n   348→\n   349→    def cleanup(self, candidate):\n   350→        pass\n   351→\n   352→\n   353→class LocalArtSource(ArtSource):\n   354→    IS_LOCAL = True\n   355→    LOC_STR = \"local\"\n   356→\n   357→    def fetch_image(self, candidate, plugin):\n   358→        pass\n   359→\n   360→\n   361→class RemoteArtSource(ArtSource):\n   362→    IS_LOCAL = False\n   363→    LOC_STR = \"remote\"\n   364→\n   365→    def fetch_image(self, candidate, plugin):\n   366→        \"\"\"Downloads an image from a URL and checks whether it seems to\n   367→        actually be an image. If so, returns a path to the downloaded image.\n   368→        Otherwise, returns None.\n   369→        \"\"\"\n   370→        if plugin.maxwidth:\n   371→            candidate.url = ArtResizer.shared.proxy_url(\n   372→                plugin.maxwidth, candidate.url\n   373→            )\n   374→        try:\n   375→            with closing(\n   376→                self.request(\n   377→                    candidate.url, stream=True, message=\"downloading image\"\n   378→                )\n   379→            ) as resp:\n   380→                ct = resp.headers.get(\"Content-Type\", None)\n   381→\n   382→                # Download the image to a temporary file. As some servers\n   383→                # (notably fanart.tv) have proven to return wrong Content-Types\n   384→                # when images were uploaded with a bad file extension, do not\n   385→                # rely on it. Instead validate the type using the file magic\n   386→                # and only then determine the extension.\n   387→                data = resp.iter_content(chunk_size=1024)\n   388→                header = b\"\"\n   389→                for chunk in data:\n   390→                    header += chunk\n   391→                    if len(header) >= 32:\n   392→                        # The imghdr module will only read 32 bytes, and our\n   393→                        # own additions in mediafile even less.\n   394→                        break\n   395→                else:\n   396→                    # server didn't return enough data, i.e. corrupt image\n   397→                    return\n   398→\n   399→                real_ct = image_mime_type(header)\n   400→                if real_ct is None:\n   401→                    # detection by file magic failed, fall back to the\n   402→                    # server-supplied Content-Type\n   403→                    # Is our type detection fa