   876→            )\n   877→        except requests.RequestException:\n   878→            self._log.debug(\"wikipedia: error receiving response\")\n   879→            return\n   880→\n   881→        try:\n   882→            data = wikipedia_response.json()\n   883→            results = data[\"query\"][\"pages\"]\n   884→            for _, result in results.items():\n   885→                image_url = result[\"imageinfo\"][0][\"url\"]\n   886→                yield self._candidate(\n   887→                    url=image_url, match=Candidate.MATCH_EXACT\n   888→                )\n   889→        except (ValueError, KeyError, IndexError):\n   890→            self._log.debug(\"wikipedia: error scraping imageinfo\")\n   891→            return\n   892→\n   893→\n   894→class FileSystem(LocalArtSource):\n   895→    NAME = \"Filesystem\"\n   896→\n   897→    @staticmethod\n   898→    def filename_priority(filename, cover_names):\n   899→        \"\"\"Sort order for image names.\n   900→\n   901→        Return indexes of cover names found in the image filename. This\n   902→        means that images with lower-numbered and more keywords will have\n   903→        higher priority.\n   904→        \"\"\"\n   905→        return [idx for (idx, x) in enumerate(cover_names) if x in filename]\n   906→\n   907→    def get(self, album, plugin, paths):\n   908→        \"\"\"Look for album art files in the specified directories.\"\"\"\n   909→        if not paths:\n   910→            return\n   911→        cover_names = list(map(util.bytestring_path, plugin.cover_names))\n   912→        cover_names_str = b\"|\".join(cover_names)\n   913→        cover_pat = rb\"\".join([rb\"(\\b|_)(\", cover_names_str, rb\")(\\b|_)\"])\n   914→\n   915→        for path in paths:\n   916→            if not os.path.isdir(syspath(path)):\n   917→                continue\n   918→\n   919→            # Find all files that look like images in the directory.\n   920→            images = []\n   921→            ign