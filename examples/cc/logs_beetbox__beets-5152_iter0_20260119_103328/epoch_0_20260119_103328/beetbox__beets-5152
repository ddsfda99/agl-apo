eturn Album\n   648→\n   649→    @cached_classproperty\n   650→    def relation_join(cls) -> str:\n   651→        \"\"\"Return the FROM clause which includes related albums.\n   652→\n   653→        We need to use a LEFT JOIN here, otherwise items that are not part of\n   654→        an album (e.g. singletons) would be left out.\n   655→        \"\"\"\n   656→        return (\n   657→            f\"LEFT JOIN {cls._relation._table} \"\n   658→            f\"ON {cls._table}.album_id = {cls._relation._table}.id\"\n   659→        )\n   660→\n   661→    @property\n   662→    def _cached_album(self):\n   663→        \"\"\"The Album object that this item belongs to, if any, or\n   664→        None if the item is a singleton or is not associated with a\n   665→        library.\n   666→        The instance is cached and refreshed on access.\n   667→\n   668→        DO NOT MODIFY!\n   669→        If you want a copy to modify, use :meth:`get_album`.\n   670→        \"\"\"\n   671→        if not self.__album and self._db:\n   672→            self.__album = self._db.get_album(self)\n   673→        elif self.__album:\n   674→            self.__album.load()\n   675→        return self.__album\n   676→\n   677→    @_cached_album.setter\n   678→    def _cached_album(self, album):\n   679→        self.__album = album\n   680→\n   681→    @classmethod\n   682→    def _getters(cls):\n   683→        getters = plugins.item_field_getters()\n   684→        getters[\"singleton\"] = lambda i: i.album_id is None\n   685→        getters[\"filesize\"] = Item.try_filesize  # In bytes.\n   686→        return getters\n   687→\n   688→    @classmethod\n   689→    def from_path(cls, path):\n   690→        \"\"\"Create a new item from the media file at the specified path.\"\"\"\n   691→        # Initiate with values that aren't read from files.\n   692→        i = cls(album_id=None)\n   693→        i.read(path)\n   694→        i.mtime = i.current_mtime()  # Initial mtime.\n   695→        return i\n   696→\n   697→    def __setitem__(self, key, value):\n   698→        \"\"\"Set the item's value for a standard field or a flexattr.\"\"\"\n   699→        # Encode unicode paths and read buffers.\n   700→        if key == \"path\":\n   701→            if isinstance(value, str):\n   702→                value = bytestring_path(value)\n   703→            elif isinstance(value, BLOB_TYPE):\n   704→                value = bytes(value)\n   705→        elif key == \"album_id\":\n   706→            self._cached_album = None\n   707→\n   708→        changed = super()._setitem(key, value)\n   709→\n   710→        if changed and key in MediaFile.fields():\n   711→            self.mtime = 0  # Reset mtime on dirty.\n   712→\n   713→    def __getitem__(self, key):\n   714→        \"\"\"Get the value for a field, falling back to the album if\n   715→        necessary.\n   716→\n   717→        Raise a KeyError if the field is not available.\n   718→        \"\"\"\n   719→        try:\n   720→            return super().__getitem__(key)\n   721→        except KeyError:\n   722→            if self._cached_album:\n   723→                return self._cached_album[key]\n   724→            raise\n   725→\n   726→    def __repr__(self):\n   727→        # This must not use `with_album=True`, because that might access\n   728→        # the database. When debugging, that is not guaranteed to succeed, and\n   729→        # can even deadlock due to the database lock.\n   730→        return \"{}({})\".format(\n   731→            type(self).__name__,\n   732→            \", \".join(\n   733→                \"{}={!r}\".format(k, self[k])\n   734→                for k in self.keys(with_album=False)\n   735→            ),\n   736→        )\n   737→\n   738→    def keys(self, computed=False, with_album=True):\n   739→        \"\"\"Get a list of available field names.\n   740→\n   741→        `with_album` controls whether the album's fields are included.\n   742→        \"\"\"\n   743→        keys = super().keys(computed=computed)\n   744→        if with_album and self._cached_album:\n   745→            keys = set(keys)\n   746→            keys.update(self._cached_album.keys(computed=computed))\n   747→            keys = list(keys)\n   748→        return keys\n   749→\n   750→    def get(self, key, default=None, with_album=True):\n   751→        \"\"\"Get the value for a given key or `default` if it does not\n   752→        exist.\n   753→\n   754→        Set `with_album` to false to skip album fallback.\n   755→        \"\"\"\n   756→        try:\n   757→            return self._get(key, default, raise_=with_album)\n   758→        except KeyError:\n   759→            if self._cached_album:\n   760→                return self._cached_album.get(key, default)\n   761→            return default\n   762→\n   763→    def update(self, values):\n   764→        \"\"\"Set all key/value pairs in the mapping.\n   765→\n   766→        If mtime is specified, it is not reset (as it might otherwise be).\n   767→        \"\"\"\n   768→        super().update(values)\n   769→        if self.mtime == 0 and \"mtime\" in values:\n   770→            self.mtime = values[\"mtime\"]\n   771→\n   772→    def clear(self):\n   773→        \"\"\"Set all key/value pairs to None.\"\"\"\n   774→        for key in self._media_tag_fields:\n   775→            setattr(self, key, None)\n   776→\n   777→    def get_album(self):\n   778→        \"\"\"Get the Album object that this item belongs to, if any, or\n   779→        None if the item is a singleton or is not associated with a\n   780→        library.\n   781→        \"\"\"\n   782→        if not self._db:\n   783→            return None\n   784→        return self._db.get_album(self)\n   785→\n   786→    # Interaction with file metadata.\n   787→\n   788→    def read(self, read_path=None):\n   789→        \"\"\"Read the metadata from the associated file.\n   790→\n   791→        If `read_path` is specified, read metadata from that file\n   792→        instead. Update all the properties in `_media_fields`\n   793→        from the media file.\n   794→\n   795→        Raise a `ReadError` if the file could not be read.\n   796→        \"\"\"\n   797→        if read_path is None:\n   798→            read_path = self.path\n   799→        else:\n   800→            read_path = normpath(read_path)\n   801→        try:\n   802→            mediafile = MediaFile(syspath(read_path))\n   803→        except UnreadableFileError as exc:\n   804→            raise ReadError(read_path, exc)\n   805→\n   806→        for key in self._media_fields:\n   807→            value = getattr(mediafile, key)\n   808→            if isinstance(value, int):\n   809→                if value.bit_length() > 63:\n   810→                    value = 0\n   811→            self[key] = value\n   812→\n   813→        # Database's mtime should now reflect the on-disk value.\n   814→        if read_path == self.path:\n   815→            self.mtime = self.current_mtime()\n   816→\n   817→        self.path = read_path\n   818→\n   819→    def write(self, path=None, tags=None, id3v23=None):\n   820→        \"\"\"Write the item's metadata to a media file.\n   821→\n   822→        All fields in `_media_fields` are written to disk according to\n   823→        the values on this object.\n   824→\n   825→        `path` is the path of the mediafile to write the data to. It\n   826→        defaults to the item's path.\n   827→\n   828→        `tags` is a dictionary of additional metadata the should be\n   829→        written to the file. (These tags need not be in `_media_fields`.)\n   830→\n   831→        `id3v23` will override the global `id3v23` config option if it is\n   832→        set to something other than `None`.\n   833→\n   834→        Can raise either a `ReadError` or a `WriteError`.\n   835→        \"\"\"\n   836→        if path is None:\n   837→            path = self.path\n   838→        else:\n   839→            path = normpath(path)\n   840→\n   841→        if id3v23 is None:\n   842→            id3v23 = beets.config[\"id3v23\"].get(bool)\n   843→\n   844→        # Get the data to write to the file.\n   845→        item_tags = dict(self)\n   846→        item_tags = {\n   847→            k: v for k, v in item_tags.items() if k in self._media_fields\n   848→        }  # Only write media fields.\n   849→        if tags is not None:\n   850→            item_tags.update(tags)\n   851→        plugins.send(\"write\", item=self, path=path, tags=item_tags)\n   852→\n   853→        # Open the file.\n   854→        try:\n   855→            mediafile = MediaFile(syspath(path), id3v23=id3v23)\n   856→        except UnreadableFileError as exc:\n   857→            raise ReadError(path, exc)\n   858→\n   859→        # Write the tags to the file.\n   860→        mediafile.update(item_tags)\n   861→        try:\n   862→            mediafile.save()\n   863→        except UnreadableFileError as exc:\n   864→            raise WriteError(self.path, exc)\n   865→\n   866→        # The file has a new mtime.\n   867→        if path == self.path:\n   868→            self.mtime = self.current_mtime()\n   869→        plugins.send(\"after_write\", item=self, path=path)\n   870→\n   871→    def try_write(self, *args, **kwargs):\n   872→        \"\"\"Call `write()` but catch and log `FileOperationError`\n   873→        exceptions.\n   874→\n   875→        Return `False` an exception was caught and `True` otherwise.\n   876→        \"\"\"\n   877→        try:\n   878→            self.write(*args, **kwargs)\n   879→            return True\n   880→        except FileOperationError as exc:\n   881→            log.error(\"{0}\", exc)\n   882→            return False\n   883→\n   884→    def try_sync(self, write, move, with_album=True):\n   885→        \"\"\"Synchronize the item with the database and, possibly, update its\n   886→        tags on disk and its path (by moving the file).\n   887→\n   888→        `write` indicates whether to write new tags into the file. Similarly,\n   889→        `move` controls whether the path should be updated. In the\n   890→        latter case, files are *only* moved when they are inside their\n   891→        library's directory (if any).\n   892→\n   893→        Similar to calling :meth:`write`, :meth:`move`, and :meth:`store`\n   894→        (conditionally).\n   895→        \"\"\"\n   896→        if write:\n   897→            self.try_write()\n   898→        if move:\n   899→            # Check whether this file is inside the library directory.\n   900→            if self._db and self._db.directory in util.ancestry(self.path):\n   901→                log.debug(\n   902→                    \"moving {0} to synchronize path\",\n   903→                    util.displayable_path(self.path),\n   904→                )\n   905→                self.move(with_album=with_album)\n   906→        self.store()\n   907→\n   908→    # Files themselves.\n   909→\n   910→    def move_file(self, dest, operation=MoveOperation.MOVE):\n   911→        \"\"\"Move, copy, link or hardlink the item depending on `operation`,\n   912→        updating the path value if the move succeeds.\n   913→\n   914→        If a file exists at `dest`, then it is slightly modified to be unique.\n   915→\n   916→        `operation` should be an instance of `util.MoveOperation`.\n   917→        \"\"\"\n   918→        if not util.samefile(self.path, dest):\n   919→            dest = util.unique_path(dest)\n   920→        if operation == MoveOperation.MOVE:\n   921→            plugins.send(\n   922→                \"before_item_moved\",\n   923→                item=self,\n   924→                source=self.path,\n   925→                destination=dest,\n   926→            )\n   927→            util.move(self.path, dest)\n   928→            plugins.send(\n   929→                \"item_moved\", item=self, source=self.path, destination=dest\n   930→            )\n   931→        elif operation == MoveOperation.COPY:\n   932→            util.copy(self.path, dest)\n   933→            plugins.send(\n   934→                \"item_copied\", item=self, source=self.path, destination=dest\n   935→            )\n   936→        elif operation == MoveOperation.LINK:\n   937→            util.link(self.path, dest)\n   938→            plugins.send(\n   939→                \"item_linked\", item=self, source=self.path, destination=dest\n   940→            )\n   941→        elif operation == MoveOperation.HARDLINK:\n   942→            util.hardlink(self.path, dest)\n   943→            plugins.send(\n   944→                \"item_hardlinked\", item=self, source=self.path, destination=dest\n   945→            )\n   946→        elif operation == MoveOperation.REFLINK:\n   947→            util.reflink(self.path, dest, fallback=False)\n   948→            plugins.send(\n   949→                \"item_reflinked\", item=self, source=self.path, destination=dest\n   950→            )\n   951→        elif operation == MoveOperation.REFLINK_AUTO:\n   952→            util.reflink(self.path, dest, fallback=True)\n   953→            plugins.send(\n   954→                \"item_reflinked\", item=self, source=self.path, destination=dest\n   955→            )\n   956→        else:\n   957→            assert False, \"unknown MoveOperation\"\n   958→\n   959→        # Either copying or moving succeeded, so update the stored path.\n   960→        self.path = dest\n   961→\n   962→    def current_mtime(self):\n   963→        \"\"\"Return the current mtime of the file, rounded to the nearest\n   964→        integer.\n   965→        \"\"\"\n   966→        return int(os.path.getmtime(syspath(self.path)))\n   967→\n   968→    def try_filesize(self):\n   969→        \"\"\"Get the size of the underlying file in bytes.\n   970→\n   971→        If the file is missing, return 0 (and log a warning).\n   972→        \"\"\"\n   973→        try:\n   974→            return os.path.getsize(syspath(self.path))\n   975→        except (OSError, Exception) as exc:\n   976→            log.warning(\"could not get filesize: {0}\", exc)\n   977→            return 0\n   978→\n   979→    # Model methods.\n   980→\n   981→    def remove(self, delete=False, with_album=True):\n   982→        \"\"\"Remove the item.\n   983→\n   984→        If `delete`, then the associated file is removed from disk.\n   985→\n   986→        If `with_album`, then the item's album (if any) is removed\n   987→        if the item was the last in the album.\n   988→        \"\"\"\n   989→        super().remove()\n   990→\n   991→        # Remove the album if it is empty.\n   992→        if with_album:\n   993→            album = self.get_album()\n   994→            if album and not album.items():\n   995→                album.remove(delete, False)\n   996→\n   997→        # Send a 'item_removed' signal to plugins\n   998→        plugins.send(\"item_removed\", item=self)\n   999→\n  1000→        # Delete the associated file.\n  1001→        if delete:\n  1002→            util.remove(self.path)\n  1003→            util.prune_dirs(os.path.dirname(self.path), self._db.directory)\n  1004→\n  1005→        self._db._memotable = {}\n  1006→\n  1007→    def move(\n  1008→        self,\n  1009→        operation=MoveOperation.MOVE,\n  1010→        basedir=None,\n  1011→        with_album=True,\n  1012→        store=True,\n  1013→    ):\n  1014→        \"\"\"Move the item to its designated location within the library\n  1015→        directory (provided by destination()).\n  1016→\n  1017→        Subdirectories are created as needed. If the operation succeeds,\n  1018→        the item's path field is updated to reflect the new location.\n  1019→\n  1020→        Instead of moving the item it can also be copied, linked or hardlinked\n  1021→        depending on `operation` which should be an instance of\n  1022→        `util.MoveOperation`.\n  1023→\n  1024→        `basedir` overrides the library base directory for the destination.\n  1025→\n  1026→        If the item is in an album and `with_album` is `True`, the album is\n  1027→        given an opportunity to move its art.\n  1028→\n  1029→        By default, the item is stored to the database if it is in the\n  1030→        database, so any dirty fields prior to the move() call will be written\n  1031→        as a side effect.\n  1032→        If `store` is `False` however, the item won't be stored and it will\n  1033→        have to be manually stored after invoking this method.\n  1034→        \"\"\"\n  1035→        self._check_db()\n  1036→        dest = self.destination(basedir=basedir)\n  1037→\n  1038→        # Create necessary ancestry for the move.\n  1039→        util.mkdirall(dest)\n  1040→\n  1041→        # Perform the move and store the change.\n  1042→        old_path = self.path\n  1043→        self.move_file(dest, operation)\n  1044→        if store:\n  1045→            self.store()\n  1046→\n  1047→        # If this item is in an album, move its art.\n  1048→        if with_album:\n  1049→            album = self.get_album()\n  1050→            if album:\n  1051→                album.move_art(operation)\n  1052→                if store:\n  1053→                    album.store()\n  1054→\n  1055→        # Prune vacated directory.\n  1056→        if operation == MoveOperation.MOVE:\n  1057→            util.prune_dirs(os.path.dirname(old_path), self._db.directory)\n  1058→\n  1059→    # Templating.\n  1060→\n  1061→    def destination(\n  1062→        self,\n  1063→        fragment=False,\n  1064→        basedir=None,\n  1065→        platform=None,\n  1066→        path_formats=None,\n  1067→        replacements=None,\n  1068→    ):\n  1069→        \"\"\"Return the path in the library directory designated for the\n  1070→        item (i.e., where the file ought to be).\n  1071→\n  1072→        fragment makes this method return just the path fragment underneath\n  1073→        the root library directory; the path is also returned as Unicode\n  1074→        instead of encoded as a bytestring. basedir can override the library's\n  1075→        base directory for the destination.\n  1076→        \"\"\"\n  1077→        self._check_db()\n  1078→        platform = platform or sys.platform\n  1079→        basedir = basedir or self._db.directory\n  1080→        path_formats = path_formats or self._db.path_formats\n  1081→        if replacements is None:\n  1082→            replacements = self._db.replacements\n  1083→\n  1084→        # Use a path format based on a query, falling back on the\n  1085→        # default.\n  1086→        for query, path_format in path_formats:\n  1087→            if query == PF_KEY_DEFAULT:\n  1088→                continue\n  1089→            query, _ = parse_query_string(query, type(self))\n  1090→            if query.match(self):\n  1091→                # The query matches the item! Use the corresponding path\n  1092→                # format.\n  1093→                break\n  1094→        else:\n  1095→            # No query matched; fall back to default.\n  1096→            for query, path_format in path_formats:\n  1097→                if query == PF_KEY_DEFAULT:\n  1098→                    break\n  1099→            else:\n  1100→                assert False, \"no default path format\"\n  1101→        if isinstance(path_format, Template):\n  1102→            subpath_tmpl = path_format\n  1103→        else:\n  1104→            subpath_tmpl = template(path_format)\n  1105→\n  1106→        # Evaluate the selected template.\n  1107→        subpath = self.evaluate_template(subpath_tmpl, True)\n  1108→\n  1109→        # Prepare path for output: normalize Unicode characters.\n  1110→        if platform == \"darwin\":\n  1111→            subpath = unicodedata.normalize(\"NFD\", subpath)\n  1112→        else:\n  1113→            subpath = unicodedata.normalize(\"NFC\", subpath)\n  1114→\n  1115→        if beets.config[\"asciify_paths\"]:\n  1116→            subpath = util.asciify_path(\n  1117→                subpath, beets.config[\"path_sep_replace\"].as_str()\n  1118→            )\n  1119→\n  1120→        maxlen = beets.config[\"max_filename_length\"].get(int)\n  1121→        if not maxlen:\n  1122→            # When zero, try to determine from filesystem.\n  1123→            maxlen = util.max_filename_length(self._db.directory)\n  1124→\n  1125→        subpath, fellback = util.legalize_path(\n  1126→            subpath,\n  1127→            replacements,\n  1128→            maxlen,\n  1129→            os.path.splitext(self.path)[1],\n  1130→            fragment,\n  1131→        )\n  1132→        if fellback:\n  1133→            # Print an error message if legalization fell back to\n  1134→            # default replacements because of the maximum length.\n  1135→            log.warning(\n  1136→                \"Fell back to default replacements when naming \"\n  1137→                \"file {}. Configure replacements to avoid lengthening \"\n  1138→                \"the filename.\",\n  1139→                subpath,\n  1140→            )\n  1141→\n  1142→        if fragment:\n  1143→            return util.as_string(subpath)\n  1144→        else:\n  1145→            return normpath(os.path.join(basedir, subpath))\n  1146→\n  1147→\n  1148→class Album(LibModel):\n  1149→    \"\"\"Provide access to information about albums stored in a\n  1150→    library.\n  1151→\n  1152→    Reflects the library's \"albums\" table, including album art.\n  1153→    \"\"\"\n  1154→\n  1155→    _table = \"albums\"\n  1156→    _flex_table = \"album_attributes\"\n  1157→    _always_dirty = True\n  1158→    _fields = {\n  1159→        \"id\": types.PRIMARY_ID,\n  1160→        \"artpath\": PathType(True),\n  1161→        \"added\": DateType(),\n  1162→        \"albumartist\": types.STRING,\n  1163→        \"albumartist_sort\": types.STRING,\n  1164→        \"albumartist_credit\": types.STRING,\n  1165→        \"albumartists\": types.MULTI_VALUE_DSV,\n  1166→        \"albumartists_sort\": types.MULTI_VALUE_DSV,\n  1167→        \"albumartists_credit\": types.MULTI_VALUE_DSV,\n  1168→        \"album\": types.STRING,\n  1169→        \"genre\": types.STRING,\n  1170→        \"style\": types.STRING,\n  1171→        \"discogs_albumid\": types.INTEGER,\n  1172→        \"discogs_artistid\": types.INTEGER,\n  1173→        \"discogs_labelid\": types.INTEGER,\n  1174→        \"year\": types.PaddedInt(4),\n  1175→        \"month\": types.PaddedInt(2),\n  1176→        \"day\": types.PaddedInt(2),\n  1177→        \"disctotal\": types.PaddedInt(2),\n  1178→        \"comp\": types.BOOLEAN,\n  1179→        \"mb_albumid\": types.STRING,\n  1180→        \"mb_albumartistid\": types.STRING,\n  1181→        \"albumtype\": types.STRING,\n  1182→        \"albumtypes\": types.SEMICOLON_SPACE_DSV,\n  1183→        \"label\": types.STRING,\n  1184→        \"barcode\": types.STRING,\n  1185→        \"mb_releasegroupid\": types.STRING,\n  1186→        \"release_group_title\": types.STRING,\n  1187→        \"asin\": types.STRING,\n  1188→        \"catalognum\": types.STRING,\n  1189→        \"script\": types.STRING,\n  1190→        \"language\": types.STRING,\n  1191→        \"country\": types.STRING,\n  1192→        \"albumstatus\": types.STRING,\n  1193→        \"albumdisambig\": types.STRING,\n  1194→        \"releasegroupdisambig\": types.STRING,\n  1195→        \"rg_album_gain\": types.NULL_FLOAT,\n  1196→        \"rg_album_peak\": types.NULL_FLOAT,\n  1197→        \"r128_album_gain\": types.NULL_FLOAT,\n  1198→        \"original_year\": types.PaddedInt(4),\n  1199→        \"original_month\": types.PaddedInt(2),\n  1200→        \"original_day\": types.PaddedInt(2),\n  1201→    }\n  1202→\n  1203→    _search_fields = (\"album\", \"albumartist\", \"genre\")\n  1204→\n  1205→    _types = {\n  1206→        \"path\": PathType(),\n  1207→        \"data_source\": types.STRING,\n  1208→    }\n  1209→\n  1210→    _sorts = {\n  1211→        \"albumartist\": SmartArtistSort,\n  1212→        \"artist\": SmartArtistSort,\n  1213→    }\n  1214→\n  1215→    # List of keys that are set on an album's items.\n  1216→    item_keys = [\n  1217→        \"added\",\n  1218→        \"albumartist\",\n  1219→        \"albumartists\",\n  1220→        \"albumartist_sort\",\n  1221→        \"albumartists_sort\",\n  1222→        \"albumartist_credit\",\n  1223→        \"albumartists_credit\",\n  1224→        \"album\",\n  1225→        \"genre\",\n  1226→        \"style\",\n  1227→        \"discogs_albumid\",\n  1228→        \"discogs_artistid\",\n  1229→        \"discogs_labelid\",\n  1230→        \"year\",\n  1231→        \"month\",\n  1232→        \"day\",\n  1233→        \"disctotal\",\n  1234→        \"comp\",\n  1235→        \"mb_albumid\",\n  1236→        \"mb_albumartistid\",\n  1237→        \"albumtype\",\n  1238→        \"albumtypes\",\n  1239→        \"label\",\n  1240→        \"barcode\",\n  1241→        \"mb_releasegroupid\",\n  1242→        \"asin\",\n  1243→        \"catalognum\",\n  1244→        \"script\",\n  1245→        \"language\",\n  1246→        \"country\",\n  1247→        \"albumstatus\",\n  1248→        \"albumdisambig\",\n  1249→        \"releasegroupdisambig\",\n  1250→        \"release_group_title\",\n  1251→        \"rg_album_gain\",\n  1252→        \"rg_album_peak\",\n  1253→        \"r128_album_gain\",\n  1254→        \"original_year\",\n  1255→        \"original_month\",\n  1256→        \"original_day\",\n  1257→    ]\n  1258→\n  1259→    _format_config_key = \"format_album\"\n  1260→\n  1261→    @cached_classproperty\n  1262→    def _relation(cls) -> type[Item]:\n  1263→        return Item\n  1264→\n  1265→    @cached_classproperty\n  1266→    def relation_join(cls) -> str:\n  1267→        \"\"\"Return FROM clause which joins on related album items.\n  1268→\n  1269→        Use LEFT join to select all albums, including those that do not have\n  1270→        any items.\n  1271→        \"\"\"\n  1272→        return (\n  1273→            f\"LEFT JOIN {cls._relation._table} \"\n  1274→            f\"ON {cls._table}.id = {cls._relation._table}.album_id\"\n  1275→        )\n  1276→\n  1277→    @classmethod\n  1278→    def _getters(cls):\n  1279→        # In addition to plugin-provided computed fields, also expose\n  1280→        # the album's directory as `path`.\n  1281→        getters = plugins.album_field_getters()\n  1282→        getters[\"path\"] = Album.item_dir\n  1283→        getters[\"albumtotal\"] = Album._albumtotal\n  1284→        return getters\n  1285→\n  1286→    def items(self):\n  1287→        \"\"\"Return an iterable over the items associated with this\n  1288→        album.\n  1289→\n  1290→        This method conflicts with :meth:`LibModel.items`, which is\n  1291→        inherited from :meth:`beets.dbcore.Model.items`.\n  1292→        Since :meth:`Album.items` predates these methods, and is\n  1293→        likely to be used by plugins, we keep this interface as-is.\n  1294→        \"\"\"\n  1295→        return self._db.items(dbcore.MatchQuery(\"album_id\", self.id))\n  1296→\n  1297→    def remove(self, delete=False, with_items=True):\n  1298→        \"\"\"Remove this album and all its associated items from the\n  1299→        library.\n  1300→\n  1301→        If delete, then the items' files are also deleted from disk,\n  1302→        along with any album art. The directories containing the album are\n  1303→        also removed (recursively) if empty.\n  1304→\n  1305→        Set with_items to False to avoid removing the album's items.\n  1306→        \"\"\"\n  1307→        super().remove()\n  1308→\n  1309→        # Send a 'album_removed' signal to plugins\n  1310→        plugins.send(\"album_removed\", album=self)\n  1311→\n  1312→        # Delete art file.\n  1313→        if delete:\n  1314→            artpath = self.artpath\n  1315→            if artpath:\n  1316→                util.remove(artpath)\n  1317→\n  1318→        # Remove (and possibly delete) the constituent items.\n  1319→        if with_items:\n  1320→            for item in self.items():\n  1321→                item.remove(delete, False)\n  1322→\n  1323→    def move_art(self, operation=MoveOperation.MOVE):\n  1324→        \"\"\"Move, copy, link or hardlink (depending on `operation`) any\n  1325→        existing album art so that it remains in the same directory as\n  1326→        the items.\n  1327→\n  1328→        `operation` should be an instance of `util.MoveOperation`.\n  1329→        \"\"\"\n  1330→        old_art = self.artpath\n  1331→        if not old_art:\n  1332→            return\n  1333→\n  1334→        if not os.path.exists(syspath(old_art)):\n  1335→            log.error(\n  1336→                \"removing reference to missing album art file {}\",\n  1337→                util.displayable_path(old_art),\n  1338→            )\n  1339→            self.artpath = None\n  1340→            return\n  1341→\n  1342→        new_art = self.art_destination(old_art)\n  1343→        if new_art == old_art:\n  1344→            return\n  1345→\n  1346→        new_art = util.unique_path(new_art)\n  1347→        log.debug(\n  1348→            \"moving album art {0} to {1}\",\n  1349→            util.displayable_path(old_art),\n  1350→            util.displayable_path(new_art),\n  1351→        )\n  1352→        if operation == MoveOperation.MOVE:\n  1353→            util.move(old_art, new_art)\n  1354→            util.prune_dirs(os.path.dirname(old_art), self._db.directory)\n  1355→        elif operation == MoveOperation.COPY:\n  1356→            util.copy(old_art, new_art)\n  1357→        elif operation == MoveOperation.LINK:\n  1358→            util.link(old_art, new_art)\n  1359→        elif operation == MoveOperation.HARDLINK:\n  1360→            util.hardlink(old_art, new_art)\n  1361→        elif operation == MoveOperation.REFLINK:\n  1362→            util.reflink(old_art, new_art, fallback=False)\n  1363→        elif operation == MoveOperation.REFLINK_AUTO:\n  1364→            util.reflink(old_art, new_art, fallback=True)\n  1365→        else:\n  1366→            assert False, \"unknown MoveOperation\"\n  1367→        self.artpath = new_art\n  1368→\n  1369→    def move(self, operation=MoveOperation.MOVE, basedir=None, store=True):\n  1370→        \"\"\"Move, copy, link or hardlink (depending on `operation`)\n  1371→        all items to their destination. Any album art moves along with them.\n  1372→\n  1373→        `basedir` overrides the library base directory for the destination.\n  1374→\n  1375→        `operation` should be an instance of `util.MoveOperation`.\n  1376→\n  1377→        By default, the album is stored to the database, persisting any\n  1378→        modifications to its metadata. If `store` is `False` however,\n  1379→        the album is not stored automatically, and it will have to be manually\n  1380→        stored after invoking this method.\n  1381→        \"\"\"\n  1382→        basedir = basedir or self._db.directory\n  1383→\n  1384→        # Ensure new metadata is available to items for destination\n  1385→        # computation.\n  1386→        if store:\n  1387→            self.store()\n  1388→\n  1389→        # Move items.\n  1390→        items = list(self.items())\n  1391→        for item in items:\n  1392→            item.move(operation, basedir=basedir, with_album=False, store=store)\n  1393→\n  1394→        # Move art.\n  1395→        self.move_art(operation)\n  1396→        if store:\n  1397→            self.store()\n  1398→\n  1399→    def item_dir(self):\n  1400→        \"\"\"Return the directory containing the album's first item,\n  1401→        provided that such an item exists.\n  1402→        \"\"\"\n  1403→        item = self.items().get()\n  1404→        if not item:\n  1405→            raise ValueError(\"empty album for album id %d\" % self.id)\n  1406→        return os.path.dirname(item.path)\n  1407→\n  1408→    def _albumtotal(self):\n  1409→        \"\"\"Return the total number of tracks on all discs on the album.\"\"\"\n  1410→        if self.disctotal == 1 or not beets.config[\"per_disc_numbering\"]:\n  1411→            return self.items()[0].tracktotal\n  1412→\n  1413→        counted = []\n  1414→        total = 0\n  1415→\n  1416→        for item in self.items():\n  1417→            if item.disc in counted:\n  1418→                continue\n  1419→\n  1420→            total += item.tracktotal\n  1421→            counted.append(item.disc)\n  1422→\n  1423→            if len(counted) == self.disctotal:\n  1424→                break\n  1425→\n  1426→        return total\n  1427→\n  1428→    def art_destination(self, image, item_dir=None):\n  1429→        \"\"\"Return a path to the destination for the album art image\n  1430→        for the album.\n  1431→\n  1432→        `image` is the path of the image that will be\n  1433→        moved there (used for its extension).\n  1434→\n  1435→        The path construction uses the existing path of the album's\n  1436→        items, so the album must contain at least one item or\n  1437→        item_dir must be provided.\n  1438→        \"\"\"\n  1439→        image = bytestring_path(image)\n  1440→        item_dir = item_dir or self.item_dir()\n  1441→\n  1442→        filename_tmpl = template(beets.config[\"art_filename\"].as_str())\n  1443→        subpath = self.evaluate_template(filename_tmpl, True)\n  1444→        if beets.config[\"asciify_paths\"]:\n  1445→            subpath = util.asciify_path(\n  1446→                subpath, beets.config[\"path_sep_replace\"].as_str()\n  1447→            )\n  1448→        subpath = util.sanitize_path(\n  1449→            subpath, replacements=self._db.replacements\n  1450→        )\n  1451→        subpath = bytestring_path(subpath)\n  1452→\n  1453→        _, ext = os.path.splitext(image)\n  1454→        dest = os.path.join(item_dir, subpath + ext)\n  1455→\n  1456→        return bytestring_path(dest)\n  1457→\n  1458→    def set_art(self, path, copy=True):\n  1459→        \"\"\"Set the album's cover art to the image at the given path.\n  1460→\n  1461→        The image is copied (or moved) into place, replacing any\n  1462→        existing art.\n  1463→\n  1464→        Send an 'art_set' event with `self` as the sole argument.\n  1465→        \"\"\"\n  1466→        path = bytestring_path(path)\n  1467→        oldart = self.artpath\n  1468→        artdest = self.art_destination(path)\n  1469→\n  1470→        if oldart and samefile(path, oldart):\n  1471→            # Art already set.\n  1472→            return\n  1473→        elif samefile(path, artdest):\n  1474→            # Art already in place.\n  1475→            self.artpath = path\n  1476→            return\n  1477→\n  1478→        # Normal operation.\n  1479→        if oldart == artdest:\n  1480→            util.remove(oldart)\n  1481→        artdest = util.unique_path(artdest)\n  1482→        if copy:\n  1483→            util.copy(path, artdest)\n  1484→        else:\n  1485→            util.move(path, artdest)\n  1486→        self.artpath = artdest\n  1487→\n  1488→        plugins.send(\"art_set\", album=self)\n  1489→\n  1490→    def store(self, fields=None, inherit=True):\n  1491→        \"\"\"Update the database with the album information.\n  1492→\n  1493→        `fields` represents the fields to be stored. If not specified,\n  1494→        all fields will be.\n  1495→\n  1496→        The album's tracks are also updated when the `inherit` flag is enabled.\n  1497→        This applies to fixed attributes as well as flexible ones. The `id`\n  1498→        attribute of the album will never be inherited.\n  1499→        \"\"\"\n  1500→        # Get modified track fields.\n  1501→        track_updates = {}\n  1502→        track_deletes = set()\n  1503→        for key in self._dirty:\n  1504→            if inherit:\n  1505→                if key in self.item_keys:  # is a fixed attribute\n  1506→                    track_updates[key] = self[key]\n  1507→                elif key not in self:  # is a fixed or a flexible attribute\n  1508→                    track_deletes.add(key)\n  1509→                elif key != \"id\":  # is a flexible attribute\n  1510→                    track_updates[key] = self[key]\n  1511→\n  1512→        with self._db.transaction():\n  1513→            super().store(fields)\n  1514→            if track_updates:\n  1515→                for item in self.items():\n  1516→                    for key, value in track_updates.items():\n  1517→                        item[key] = value\n  1518→                    item.store()\n  1519→            if track_deletes:\n  1520→                for item in self.items():\n  1521→                    for key in track_deletes:\n  1522→                        if key in item:\n  1523→                            del item[key]\n  1524→                    item.store()\n  1525→\n  1526→    def try_sync(self, write, move, inherit=True):\n  1527→        \"\"\"Synchronize the album and its items with the database.\n  1528→        Optionally, also write any new tags into the files and update\n  1529→        their paths.\n  1530→\n  1531→        `write` indicates whether to write tags to the item files, and\n  1532→        `move` controls whether files (both audio and album art) are\n  1533→        moved.\n  1534→        \"\"\"\n  1535→        self.store(inherit=inherit)\n  1536→        for item in self.items():\n  1537→            item.try_sync(write, move)\n  1538→\n  1539→\n  1540→# Query construction helpers.\n  1541→\n  1542→\n  1543→def parse_query_parts(parts, model_cls):\n  1544→    \"\"\"Given a beets query string as a list of components, return the\n  1545→    `Query` and `Sort` they represent.\n  1546→\n  1547→    Like `dbcore.parse_sorted_query`, with beets query prefixes and\n  1548→    ensuring that implicit path queries are made explicit with 'path::<query>'\n  1549→    \"\"\"\n  1550→    # Get query types and their prefix characters.\n  1551→    prefixes = {\n  1552→        \":\": dbcore.query.RegexpQuery,\n  1553→        \"=~\": dbcore.query.StringQuery,\n  1554→        \"=\": dbcore.query.MatchQuery,\n  1555→    }\n  1556→    prefixes.update(plugins.queries())\n  1557→\n  1558→    # Special-case path-like queries, which are non-field queries\n  1559→    # containing path separators (/).\n  1560→    parts = [f\"path:{s}\" if PathQuery.is_path_query(s) else s for s in parts]\n  1561→\n  1562→    case_insensitive = beets.config[\"sort_case_insensitive\"].get(bool)\n  1563→\n  1564→    query, sort = dbcore.parse_sorted_query(\n  1565→        model_cls, parts, prefixes, case_insensitive\n  1566→    )\n  1567→    log.debug(\"Parsed query: {!r}\", query)\n  1568→    log.debug(\"Parsed sort: {!r}\", sort)\n  1569→    return query, sort\n  1570→\n  1571→\n  1572→def parse_query_string(s, model_cls):\n  1573→    \"\"\"Given a beets query string, return the `Query` and `Sort` they\n  1574→    represent.\n  1575→\n  1576→    The string is split into components using shell-like syntax.\n  1577→    \"\"\"\n  1578→    message = f\"Query is not unicode: {s!r}\"\n  1579→    assert isinstance(s, str), message\n  1580→    try:\n  1581→        parts = shlex.split(s)\n  1582→    except ValueError as exc:\n  1583→        raise dbcore.InvalidQueryError(s, exc)\n  1584→    return parse_query_parts(parts, model_cls)\n  1585→\n  1586→\n  1587→# The Library: interface to the database.\n  1588→\n  1589→\n  1590→class Library(dbcore.Database):\n  1591→    \"\"\"A database of music containing songs and albums.\"\"\"\n  1592→\n  1593→    _models = (Item, Album)\n  1594→\n  1595→    def __init__(\n  1596→        self,\n  1597→        path=\"library.blb\",\n  1598→        directory=\"~/Music\",\n  1599→        path_formats=((PF_KEY_DEFAULT, \"$artist/$album/$track $title\"),),\n  1600→        replacements=None,\n  1601→    ):\n  1602→        timeout = beets.config[\"timeout\"].as_number()\n  1603→        super().__init__(path, timeout=timeout)\n  1604→\n  1605→        self.directory = bytestring_path(normpath(directory))\n  1606→        self.path_formats = path_formats\n  1607→        self.replacements = replacements\n  1608→\n  1609→        self._memotable = {}  # Used for template substitution performance.\n  1610→\n  1611→    # Adding objects to the database.\n  1612→\n  1613→    def add(self, obj):\n  1614→        \"\"\"Add the :class:`Item` or :class:`Album` object to the library\n  1615→        database.\n  1616→\n  1617→        Return the object's new id.\n  1618→        \"\"\"\n  1619→        obj.add(self)\n  1620→        self._memotable = {}\n  1621→        return obj.id\n  1622→\n  1623→    def add_album(self, items):\n  1624→        \"\"\"Create a new album consisting of a list of items.\n  1625→\n  1626→        The items are added to the database if they don't yet have an\n  1627→        ID. Return a new :class:`Album` object. The list items must not\n  1628→        be empty.\n  1629→        \"\"\"\n  1630→        if not items:\n  1631→            raise ValueError(\"need at least one item\")\n  1632→\n  1633→        # Create the album structure using metadata from the first item.\n  1634→        values = {key: items[0][key] for key in Album.item_keys}\n  1635→        album = Album(self, **values)\n  1636→\n  1637→        # Add the album structure and set the items' album_id fields.\n  1638→        # Store or add the items.\n  1639→        with self.transaction():\n  1640→            album.add(self)\n  1641→            for item in items:\n  1642→                item.album_id = album.id\n  1643→                if item.id is None:\n  1644→                    item.add(self)\n  1645→                else:\n  1646→                    item.store()\n  1647→\n  1648→        return album\n  1649→\n  1650→    # Querying.\n  1651→\n  1652→    def _fetch(self, model_cls, query, sort=None):\n  1653→        \"\"\"Parse a query and fetch.\n  1654→\n  1655→        If an order specification is present in the query string\n  1656→        the `sort` argument is ignored.\n  1657→        \"\"\"\n  1658→        # Parse the query, if necessary.\n  1659→        try:\n  1660→            parsed_sort = None\n  1661→            if isinstance(query, str):\n  1662→                query, parsed_sort = parse_query_string(query, model_cls)\n  1663→            elif isinstance(query, (list, tuple)):\n  1664→                query, parsed_sort = parse_query_parts(query, model_cls)\n  1665→        except dbcore.query.InvalidQueryArgumentValueError as exc:\n  1666→            raise dbcore.InvalidQueryError(query, exc)\n  1667→\n  1668→        # Any non-null sort specified by the parsed query overrides the\n  1669→        # provided sort.\n  1670→        if parsed_sort and not isinstance(parsed_sort, dbcore.query.NullSort):\n  1671→            sort = parsed_sort\n  1672→\n  1673→        return super()._fetch(model_cls, query, sort)\n  1674→\n  1675→    @staticmethod\n  1676→    def get_default_album_sort():\n  1677→        \"\"\"Get a :class:`Sort` object for albums from the config option.\"\"\"\n  1678→        return dbcore.sort_from_strings(\n  1679→            Album, beets.config[\"sort_album\"].as_str_seq()\n  1680→        )\n  1681→\n  1682→    @staticmethod\n  1683→    def get_default_item_sort():\n  1684→        \"\"\"Get a :class:`Sort` object for items from the config option.\"\"\"\n  1685→        return dbcore.sort_from_strings(\n  1686→            Item, beets.config[\"sort_item\"].as_str_seq()\n  1687→        )\n  1688→\n  1689→    def albums(self, query=None, sort=None) -> Results[Album]:\n  1690→        \"\"\"Get :class:`Album` objects matching the query.\"\"\"\n  1691→        return self._fetch(Album, query, sort or self.get_default_album_sort())\n  1692→\n  1693→    def items(self, query=None, sort=None) -> Results[Item]:\n  1694→        \"\"\"Get :class:`Item` objects matching the query.\"\"\"\n  1695→        return self._fetch(Item, query, sort or self.get_default_item_sort())\n  1696→\n  1697→    # Convenience accessors.\n  1698→\n  1699→    def get_item(self, id):\n  1700→        \"\"\"Fetch a :class:`Item` by its ID.\n  1701→\n  1702→        Return `None` if no match is found.\n  1703→        \"\"\"\n  1704→        return self._get(Item, id)\n  1705→\n  1706→    def get_album(self, item_or_id):\n  1707→        \"\"\"Given an album ID or an item associated with an album, return\n  1708→        a :class:`Album` object for the album.\n  1709→\n  1710→        If no such album exists, return `None`.\n  1711→        \"\"\"\n  1712→        if isinstance(item_or_id, int):\n  1713→            album_id = item_or_id\n  1714→        else:\n  1715→            album_id = item_or_id.album_id\n  1716→        if album_id is None:\n  1717→            return None\n  1718→        return self._get(Album, album_id)\n  1719→\n  1720→\n  1721→# Default path template resources.\n  1722→\n  1723→\n  1724→def _int_arg(s):\n  1725→    \"\"\"Convert a string argument to an integer for use in a template\n  1726→    function.\n  1727→\n  1728→    May raise a ValueError.\n  1729→    \"\"\"\n  1730→    return int(s.strip())\n  1731→\n  1732→\n  1733→class DefaultTemplateFunctions:\n  1734→    \"\"\"A container class for the default functions provided to path\n  1735→    templates.\n  1736→\n  1737→    These functions are contained in an object to provide\n  1738→    additional context to the functions -- specifically, the Item being\n  1739→    evaluated.\n  1740→    \"\"\"\n  1741→\n  1742→    _prefix = \"tmpl_\"\n  1743→\n  1744→    def __init__(self, item=None, lib=None):\n  1745→        \"\"\"Parametrize the functions.\n  1746→\n  1747→        If `item` or `lib` is None, then some functions (namely, ``aunique``)\n  1748→        will always evaluate to the empty string.\n  1749→        \"\"\"\n  1750→        self.item = item\n  1751→        self.lib = lib\n  1752→\n  1753→    def functions(self):\n  1754→        \"\"\"Return a dictionary containing the fun