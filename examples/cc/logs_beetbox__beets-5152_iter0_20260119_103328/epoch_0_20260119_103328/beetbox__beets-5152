92                    )\n   132\u2192                    return self.CANDIDATE_BAD\n   133\u2192            elif plugin.margin_percent:\n   134\u2192                margin_px = plugin.margin_percent * long_edge\n   135\u2192                if edge_diff > margin_px:\n   136\u2192                    self._log.debug(\n   137\u2192                        \"image is not close enough to being \"\n   138\u2192                        \"square, ({} - {} > {})\",\n   139\u2192                        long_edge,\n   140\u2192                        short_edge,\n   141\u2192                        margin_px,\n   142\u2192                    )\n   143\u2192                    return self.CANDIDATE_BAD\n   144\u2192            elif edge_diff:\n   145\u2192                # also reached for margin_px == 0 and margin_percent == 0.0\n   146\u2192                self._log.debug(\n   147\u2192                    \"image is not square ({} != {})\", self.size[0], self.size[1]\n   148\u2192                )\n   149\u2192                return self.CANDIDATE_BAD\n   150\u2192\n   151\u2192        # Check maximum dimension.\n   152\u2192        downscale = False\n   153\u2192        if plugin.maxwidth and self.size[0] > plugin.maxwidth:\n   154\u2192            self._log.debug(\n   155\u2192                \"image needs rescaling ({} > {})\", self.size[0], plugin.maxwidth\n   156\u2192            )\n   157\u2192            downscale = True\n   158\u2192\n   159\u2192        # Check filesize.\n   160\u2192        downsize = False\n   161\u2192        if plugin.max_filesize:\n   162\u2192            filesize = os.stat(syspath(self.path)).st_size\n   163\u2192            if filesize > plugin.max_filesize:\n   164\u2192                self._log.debug(\n   165\u2192                    \"image needs resizing ({}B > {}B)\",\n   166\u2192                    filesize,\n   167\u2192                    plugin.max_filesize,\n   168\u2192                )\n   169\u2192                downsize = True\n   170\u2192\n   171\u2192        # Check image format\n   172\u2192        reformat = False\n   173\u2192        if plugin.cover_format:\n   174\u2192            fmt = ArtResizer.shared.get_format(self.path)\n   175\u2192            reformat = fmt != plugin.cover_format\n   176\u2192            if reformat:\n   177\u2192                self._log.debug(\n   178\u2192                    \"image needs reformatting: {} -> {}\",\n   179\u2192                    fmt,\n   180\u2192                    plugin.cover_format,\n   181\u2192                )\n   182\u2192\n   183\u2192        if downscale:\n   184\u2192            return self.CANDIDATE_DOWNSCALE\n   185\u2192        elif downsize:\n   186\u2192            return self.CANDIDATE_DOWNSIZE\n   187\u2192        elif plugin.deinterlace:\n   188\u2192            return self.CANDIDATE_DEINTERLACE\n   189\u2192        elif reformat:\n   190\u2192            return self.CANDIDATE_REFORMAT\n   191\u2192        else:\n   192\u2192            return self.CANDIDATE_EXACT\n   193\u2192\n   194\u2192    def validate(self, plugin):\n   195\u2192        self.check = self._validate(plugin)\n   196\u2192        return self.check\n   197\u2192\n   198\u2192    def resize(self, plugin):\n   199\u2192        \"\"\"Apply all necessary transformations to satisfy plugin settings.\n   200\u2192\n   201\u2192        Historically, only a single operation indicated by `self.check` was\n   202\u2192        performed. This caused issues when multiple operations were required\n   203\u2192        (e.g., reformatting a PNG to JPEG and reducing filesize). Here, we\n   204\u2192        determine and apply all applicable operations sequentially.\n   205\u2192        \"\"\"\n   206\u2192        # Ensure we have up-to-date size/format information.\n   207\u2192        if not self.size:\n   208\u2192            self.size = ArtResizer.shared.get_size(self.path)\n   209\u2192        try:\n   210\u2192            current_format = ArtResizer.shared.get_format(self.path)\n   211\u2192        except Exception:\n   212\u2192            current_format = None\n   213\u2192\n   214\u2192        # 1) Reformat first, if requested and needed.\n   215\u2192        # Doing this first enables JPEG-specific downsizing to work.\n   216\u2192        if plugin.cover_format:\n   217\u2192            if current_format != plugin.cover_format:\n   218\u2192                self.path = ArtResizer.shared.reformat(\n   219\u2192                    self.path,\n   220\u2192                    plugin.cover_format,\n   221\u2192                    deinterlaced=plugin.deinterlace,\n   222\u2192                )\n   223\u2192                # Refresh size/format as they may have changed.\n   224\u2192                self.size = ArtResizer.shared.get_size(self.path) or self.size\n   225\u2192                current_format = ArtResizer.shared.get_format(self.path) or current_format\n   226\u2192\n   227\u2192        # 2) Deinterlace if requested and not already handled by reformat.\n   228\u2192        # The reformat step above already respects `deinterlaced`, so only\n   229\u2192        # deinterlace if we didn't reformat or format requires it separately.\n   230\u2192        if plugin.deinterlace and self.check == self.CANDIDATE_DEINTERLACE:\n   231\u2192            self.path = ArtResizer.shared.deinterlace(self.path)\n   232\u2192            self.size = ArtResizer.shared.get_size(self.path) or self.size\n   233\u2192\n   234\u2192        # 3) Downscale and/or downsize as needed. Combine in a single resize\n   235\u2192        # call when possible.\n   236\u2192        downscale_needed = False\n   237\u2192        if plugin.maxwidth and self.size and self.size[0] > plugin.maxwidth:\n   238\u2192            downscale_needed = True\n   239\u2192\n   240\u2192        downsize_needed = False\n   241\u2192        if plugin.max_filesize:\n   242\u2192            try:\n   243\u2192                filesize = os.stat(syspath(self.path)).st_size\n   244\u2192                downsize_needed = filesize > plugin.max_filesize\n   245\u2192            except Exception:\n   246\u2192                downsize_needed = False\n   247\u2192\n   248\u2192        if downscale_needed or downsize_needed:\n   249\u2192            # Use desired max width if downscaling, otherwise preserve dimensions\n   250\u2192            # by using the current maximum edge.\n   251\u2192            target_width = (\n   252\u2192                plugin.maxwidth if downscale_needed else (max(self.size) if self.size else 0)\n   253\u2192            )\n   254\u2192            if target_width:\n   255\u2192                self.path = ArtResizer.shared.resize(\n   256\u2192                    target_width,\n   257\u2192                    self.path,\n   258\u2192                    quality=plugin.quality,\n   259\u2192                    max_filesize=plugin.max_filesize,\n   260\u2192                )\n   261\u2192                # Refresh size after resize\n   262\u2192                self.size = ArtResizer.shared.get_size(self.path) or self.size\n   263\u2192\n   264\u2192\n   265\u2192def _logged_get(log, *args, **kwargs):\n   266\u2192    \"\"\"Like `requests.get`, but logs the effective URL to the specified\n   267\u2192    `log` at the `DEBUG` level.\n   268\u2192\n   269\u2192    Use the optional `message` parameter to specify what to log before\n   270\u2192    the URL. By default, the string is \"getting URL\".\n   271\u2192\n   272\u2192    Also sets the User-Agent header to indicate beets.\n   273\u2192    \"\"\"\n   274\u2192    # Use some arguments with the `send` call but most with the\n   275\u2192    # `Request` construction. This is a cheap, magic-filled way to\n   276\u2192    # emulate `requests.get` or, more pertinently,\n   277\u2192    # `requests.Session.request`.\n   278\u2192    req_kwargs = kwargs\n   279\u2192    send_kwargs = {}\n   280\u2192    for arg in (\"stream\", \"verify\", \"proxies\", \"cert\", \"timeout\"):\n   281\u2192        if arg in kwargs:\n   282\u2192            send_kwargs[arg] = req_kwargs.pop(arg)\n   283\u2192    if \"timeout\" not in send_kwargs:\n   284\u2192        send_kwargs[\"timeout\"] = 10\n   285\u2192\n   286\u2192    # Our special logging message parameter.\n   287\u2192    if \"message\" in kwargs:\n   288\u2192        message = kwargs.pop(\"message\")\n   289\u2192    else:\n   290\u2192        message = \"getting URL\"\n   291\u2192\n   292\u2192    req = requests.Request(\"GET\", *args, **req_kwargs)\n   293\u2192\n   294\u2192    with requests.Session() as s:\n   295\u2192        s.headers = {\"User-Agent\": \"beets\"}\n   296\u2192        prepped = s.prepare_request(req)\n   297\u2192        settings = s.merge_environment_settings(\n   298\u2192            prepped.url, {}, None, None, None\n   299\u2192        )\n   300\u2192        send_kwargs.update(settings)\n   301\u2192        log.debug(\"{}: {}\", message, prepped.url)\n   302\u2192        return s.send(prepped, **send_kwargs)\n   303\u2192\n   304\u2192\n   305\u2192class RequestMixin:\n   306\u2192    \"\"\"Adds a Requests wrapper to the class that uses the logger, which\n   307\u2192    must be named `self._log`.\n   308\u2192    \"\"\"\n   309\u2192\n   310\u2192    def request(self, *args, **kwargs):\n   311\u2192        \"\"\"Like `requests.get`, but uses the logger `self._log`.\n   312\u2192\n   313\u2192        See also `_logged_get`.\n   314\u2192        \"\"\"\n   315\u2192        return _logged_get(self._log, *args, **kwargs)\n   316\u2192\n   317\u2192\n   318\u2192# ART SOURCES ################################################################\n   319\u2192\n   320\u2192\n   321\u2192class ArtSource(RequestMixin):\n   322\u2192    VALID_MATCHING_CRITERIA = [\"default\"]\n   323\u2192\n   324\u2192    def __init__(self, log, config, match_by=None):\n   325\u2192        self._log = log\n   326\u2192        self._config = config\n   327\u2192        self.match_by = match_by or self.VALID_MATCHING_CRITERIA\n   328\u2192\n   329\u2192    @staticmethod\n   330\u2192    def add_default_config(config):\n   331\u2192        pass\n   332\u2192\n   333\u2192    @classmethod\n   334\u2192    def available(cls, log, config):\n   335\u2192        \"\"\"Return whether or not all dependencies are met and the art source is\n   336\u2192        in fact usable.\n   337\u2192        \"\"\"\n   338\u2192        return True\n   339\u2192\n   340\u2192    def get(self, album, plugin, paths):\n   341\u2192        raise NotImplementedError()\n   342\u2192\n   343\u2192    def _candidate(self, **kwargs):\n   344\u2192        return Candidate(source=self, log=self._log, **kwargs)\n   345\u2192\n   346\u2192    def fetch_image(self, candidate, plugin):\n   347\u2192        raise NotImplementedError()\n   348\u2192\n   349\u2192    def cleanup(self, candidate):\n   350\u2192        pass\n   351\u2192\n   352\u2192\n   353\u2192class LocalArtSource(ArtSource):\n   354\u2192    IS_LOCAL = True\n   355\u2192    LOC_STR = \"local\"\n   356\u2192\n   357\u2192    def fetch_image(self, candidate, plugin):\n   358\u2192        pass\n   359\u2192\n   360\u2192\n   361\u2192class RemoteArtSource(ArtSource):\n   362\u2192    IS_LOCAL = False\n   363\u2192    LOC_STR = \"remote\"\n   364\u2192\n   365\u2192    def fetch_image(self, candidate, plugin):\n   366\u2192        \"\"\"Downloads an image from a URL and checks whether it seems to\n   367\u2192        actually be an image. If so, returns a path to the downloaded image.\n   368\u2192        Otherwise, returns None.\n   369\u2192        \"\"\"\n   370\u2192        if plugin.maxwidth:\n   371\u2192            candidate.url = ArtResizer.shared.proxy_url(\n   372\u2192                plugin.maxwidth, candidate.url\n   373\u2192            )\n   374\u2192        try:\n   375\u2192            with closing(\n   376\u2192                self.request(\n   377\u2192                    candidate.url, stream=True, message=\"downloading image\"\n   378\u2192                )\n   379\u2192            ) as resp:\n   380\u2192                ct = resp.headers.get(\"Content-Type\", None)\n   381\u2192\n   382\u2192                # Download the image to a temporary file. As some servers\n   383\u2192                # (notably fanart.tv) have proven to return wrong Content-Types\n   384\u2192                # when images were uploaded with a bad file extension, do not\n   385\u2192                # rely on it. Instead validate the type using the file magic\n   386\u2192                # and only then determine the extension.\n   387\u2192                data = resp.iter_content(chunk_size=1024)\n   388\u2192                header = b\"\"\n   389\u2192                for chunk in data:\n   390\u2192                    header += chunk\n   391\u2192                    if len(header) >= 32:\n   392\u2192                        # The imghdr module will only read 32 bytes, and our\n   393\u2192                        # own additions in mediafile even less.\n   394\u2192                        break\n   395\u2192                else:\n   396\u2192                    # server didn't return enough data, i.e. corrupt image\n   397\u2192                    return\n   398\u2192\n   399\u2192                real_ct = image_mime_type(header)\n   400\u2192                if real_ct is None:\n   401\u2192                    # detection by file magic failed, fall back to the\n   402\u2192                    # server-supplied Content-Type\n   403\u2192                    # Is our type detection failsafe enough to drop this?\n   404\u2192                    real_ct = ct\n   405\u2192\n   406\u2192                if real_ct not in CONTENT_TYPES:\n   407\u2192                    self._log.debug(\n   408\u2192                        \"not a supported image: {}\",\n   409\u2192                        real_ct or \"unknown content type\",\n   410\u2192                    )\n   411\u2192                    return\n   412\u2192\n   413\u2192                ext = b\".\" + CONTENT_TYPES[real_ct][0]\n   414\u2192\n   415\u2192                if real_ct != ct:\n   416\u2192                    self._log.warning(\n   417\u2192                        \"Server specified {}, but returned a \"\n   418\u2192                        \"{} image. Correcting the extension \"\n   419\u2192                        \"to {}\",\n   420\u2192                        ct,\n   421\u2192                        real_ct,\n   422\u2192                        ext,\n   423\u2192                    )\n   424\u2192\n   425\u2192                suffix = os.fsdecode(ext)\n   426\u2192                with NamedTemporaryFile(suffix=suffix, delete=False) as fh:\n   427\u2192                    # write the first already loaded part of the image\n   428\u2192                    fh.write(header)\n   429\u2192                    # download the remaining part of the image\n   430\u2192                    for chunk in data:\n   431\u2192                        fh.write(chunk)\n   432\u2192                self._log.debug(\n   433\u2192                    \"downloaded art to: {0}\", util.displayable_path(fh.name)\n   434\u2192                )\n   435\u2192                candidate.path = util.bytestring_path(fh.name)\n   436\u2192                return\n   437\u2192\n   438\u2192        except (OSError, requests.RequestException, TypeError) as exc:\n   439\u2192            # Handling TypeError works around a urllib3 bug:\n   440\u2192            # https://github.com/shazow/urllib3/issues/556\n   441\u2192            self._log.debug(\"error fetching art: {}\", exc)\n   442\u2192            return\n   443\u2192\n   444\u2192    def cleanup(self, candidate):\n   445\u2192        if candidate.path:\n   446\u2192            try:\n   447\u2192                util.remove(path=candidate.path)\n   448\u2192            except util.FilesystemError as exc:\n   449\u2192                self._log.debug(\"error cleaning up tmp art: {}\", exc)\n   450\u2192\n   451\u2192\n   452\u2192class CoverArtArchive(RemoteArtSource):\n   453\u2192    NAME = \"Cover Art Archive\"\n   454\u2192    VALID_MATCHING_CRITERIA = [\"release\", \"releasegroup\"]\n   455\u2192    VALID_THUMBNAIL_SIZES = [250, 500, 1200]\n   456\u2192\n   457\u2192    URL = \"https://coverartarchive.org/release/{mbid}\"\n   458\u2192    GROUP_URL = \"https://coverartarchive.org/release-group/{mbid}\"\n   459\u2192\n   460\u2192    def get(self, album, plugin, paths):\n   461\u2192        \"\"\"Return the Cover Art Archive and Cover Art Archive release\n   462\u2192        group URLs using album MusicBrainz release ID and release group\n   463\u2192        ID.\n   464\u2192        \"\"\"\n   465\u2192\n   466\u2192        def get_image_urls(url, preferred_width=None):\n   467\u2192            try:\n   468\u2192                response = self.request(url)\n   469\u2192            except requests.RequestException:\n   470\u2192                self._log.debug(\n   471\u2192                    \"{}: error receiving response\".format(self.NAME)\n   472\u2192                )\n   473\u2192                return\n   474\u2192\n   475\u2192            try:\n   476\u2192                data = response.json()\n   477\u2192            except ValueError:\n   478\u2192                self._log.debug(\n   479\u2192                    \"{}: error loading response: {}\".format(\n   480\u2192                        self.NAME, response.text\n   481\u2192                    )\n   482\u2192                )\n   483\u2192                return\n   484\u2192\n   485\u2192            for item in data.get(\"images\", []):\n   486\u2192                try:\n   487\u2192                    if \"Front\" not in item[\"types\"]:\n   488\u2192                        continue\n   489\u2192\n   490\u2192                    # If there is a pre-sized thumbnail of the desired size\n   491\u2192                    # we select it. Otherwise, we return the raw image.\n   492\u2192                    image_url: str = item[\"image\"]\n   493\u2192                    if preferred_width is not None:\n   494\u2192                        if isinstance(item.get(\"thumbnails\"), dict):\n   495\u2192                            image_url = item[\"thumbnails\"].get(\n   496\u2192                                preferred_width, image_url\n   497\u2192                            )\n   498\u2192                    yield image_url\n   499\u2192                except KeyError:\n   500\u2192                    pass\n   501\u2192\n   502\u2192        release_url = self.URL.format(mbid=album.mb_albumid)\n   503\u2192        release_group_url = self.GROUP_URL.format(mbid=album.mb_releasegroupid)\n   504\u2192\n   505\u2192        # Cover Art Archive API offers pre-resized thumbnails at several sizes.\n   506\u2192        # If the maxwidth config matches one of the already available sizes\n   507\u2192        # fetch it directly instead of fetching the full sized image and\n   508\u2192        # resizing it.\n   509\u2192        preferred_width = None\n   510\u2192        if plugin.maxwidth in self.VALID_THUMBNAIL_SIZES:\n   511\u2192            preferred_width = str(plugin.maxwidth)\n   512\u2192\n   513\u2192        if \"release\" in self.match_by and album.mb_albumid:\n   514\u2192            for url in get_image_urls(release_url, preferred_width):\n   515\u2192                yield self._candidate(url=url, match=Candidate.MATCH_EXACT)\n   516\u2192\n   517\u2192        if \"releasegroup\" in self.match_by and album.mb_releasegroupid:\n   518\u2192            for url in get_image_urls(release_group_url, preferred_width):\n   519\u2192                yield self._candidate(url=url, match=Candidate.MATCH_FALLBACK)\n   520\u2192\n   521\u2192\n   522\u2192class Amazon(RemoteArtSource):\n   523\u2192    NAME = \"Amazon\"\n   524\u2192    URL = \"https://images.amazon.com/images/P/%s.%02i.LZZZZZZZ.jpg\"\n   525\u2192    INDICES = (1, 2)\n   526\u2192\n   527\u2192    def get(self, album, plugin, paths):\n   528\u2192        \"\"\"Generate URLs using Amazon ID (ASIN) string.\"\"\"\n   529\u2192        if album.asin:\n   530\u2192            for index in self.INDICES:\n   531\u2192                yield self._candidate(\n   532\u2192                    url=self.URL % (album.asin, index),\n   533\u2192                    match=Candidate.MATCH_EXACT,\n   534\u2192                )\n   535\u2192\n   536\u2192\n   537\u2192class AlbumArtOrg(RemoteArtSource):\n   538\u2192    NAME = \"AlbumArt.org scraper\"\n   539\u2192    URL = \"https://www.albumart.org/index_detail.php\"\n   540\u2192    PAT = r'href\\s*=\\s*\"([^>\"]*)\"[^>]*title\\s*=\\s*\"View larger image\"'\n   541\u2192\n   542\u2192    def get(self, album, plugin, paths):\n   543\u2192        \"\"\"Return art URL from AlbumArt.org using album ASIN.\"\"\"\n   544\u2192        if not album.asin:\n   545\u2192            return\n   546\u2192        # Get the page from albumart.org.\n   547\u2192        try:\n   548\u2192            resp = self.request(self.URL, params={\"asin\": album.asin})\n   549\u2192            self._log.debug(\"scraped art URL: {0}\", resp.url)\n   550\u2192        except requests.RequestException:\n   551\u2192            self._log.debug(\"error scraping art page\")\n   552\u2192            return\n   553\u2192\n   554\u2192        # Search the page for the image URL.\n   555\u2192        m = re.search(self.PAT, resp.text)\n   556\u2192        if m:\n   557\u2192            image_url = m.group(1)\n   558\u2192            yield self._candidate(url=image_url, match=Candidate.MATCH_EXACT)\n   559\u2192        else:\n   560\u2192            self._log.debug(\"no image found on page\")\n   561\u2192\n   562\u2192\n   563\u2192class GoogleImages(RemoteArtSource):\n   564\u2192    NAME = \"Google Images\"\n   565\u2192    URL = \"https://www.googleapis.com/customsearch/v1\"\n   566\u2192\n   567\u2192    def __init__(self, *args, **kwargs):\n   568\u2192        super().__init__(*args, **kwargs)\n   569\u2192        self.key = (self._config[\"google_key\"].get(),)\n   570\u2192        self.cx = (self._config[\"google_engine\"].get(),)\n   571\u2192\n   572\u2192    @staticmethod\n   573\u2192    def add_default_config(config):\n   574\u2192        config.add(\n   575\u2192            {\n   576\u2192                \"google_key\": None,\n   577\u2192                \"google_engine\": \"001442825323518660753:hrh5ch1gjzm\",\n   578\u2192            }\n   579\u2192        )\n   580\u2192        config[\"google_key\"].redact = True\n   581\u2192\n   582\u2192    @classmethod\n   583\u2192    def available(cls, log, config):\n   584\u2192        has_key = bool(config[\"google_key\"].get())\n   585\u2192        if not has_key:\n   586\u2192            log.debug(\"google: Disabling art source due to missing key\")\n   587\u2192        return has_key\n   588\u2192\n   589\u2192    def get(self, album, plugin, paths):\n   590\u2192        \"\"\"Return art URL from google custom search engine\n   591\u2192        given an album title and interpreter.\n   592\u2192        \"\"\"\n   593\u2192        if not (album.albumartist and album.album):\n   594\u2192            return\n   595\u2192        search_string = (album.albumartist + \",\" + album.album).encode(\"utf-8\")\n   596\u2192\n   597\u2192        try:\n   598\u2192            response = self.request(\n   599\u2192                self.URL,\n   600\u2192                params={\n   601\u2192                    \"key\": self.key,\n   602\u2192                    \"cx\": self.cx,\n   603\u2192                    \"q\": search_string,\n   604\u2192                    \"searchType\": \"image\",\n   605\u2192                },\n   606\u2192            )\n   607\u2192        except requests.RequestException:\n   608\u2192            self._log.debug(\"google: error receiving response\")\n   609\u2192            return\n   610\u2192\n   611\u2192        # Get results using JSON.\n   612\u2192        try:\n   613\u2192            data = response.json()\n   614\u2192        except ValueError:\n   615\u2192            self._log.debug(\n   616\u2192                \"google: error loading response: {}\".format(response.text)\n   617\u2192            )\n   618\u2192            return\n   619\u2192\n   620\u2192        if \"error\" in data:\n   621\u2192            reason = data[\"error\"][\"errors\"][0][\"reason\"]\n   622\u2192            self._log.debug(\"google fetchart error: {0}\", reason)\n   623\u2192            return\n   624\u2192\n   625\u2192        if \"items\" in data.keys():\n   626\u2192            for item in data[\"items\"]:\n   627\u2192                yield self._candidate(\n   628\u2192                    url=item[\"link\"], match=Candidate.MATCH_EXACT\n   629\u2192                )\n   630\u2192\n   631\u2192\n   632\u2192class FanartTV(RemoteArtSource):\n   633\u2192    \"\"\"Art from fanart.tv requested using their API\"\"\"\n   634\u2192\n   635\u2192    NAME = \"fanart.tv\"\n   636\u2192    API_URL = \"https://webservice.fanart.tv/v3/\"\n   637\u2192    API_ALBUMS = API_URL + \"music/albums/\"\n   638\u2192    PROJECT_KEY = \"61a7d0ab4e67162b7a0c7c35915cd48e\"\n   639\u2192\n   640\u2192    def __init__(self, *args, **kwargs):\n   641\u2192        super().__init__(*args, **kwargs)\n   642\u2192        self.client_key = self._config[\"fanarttv_key\"].get()\n   643\u2192\n   644\u2192    @staticmethod\n   645\u2192    def add_default_config(config):\n   646\u2192        config.add(\n   647\u2192            {\n   648\u2192                \"fanarttv_key\": None,\n   649\u2192            }\n   650\u2192        )\n   651\u2192        config[\"fanarttv_key\"].redact = True\n   652\u2192\n   653\u2192    def get(self, album, plugin, paths):\n   654\u2192        if not album.mb_releasegroupid:\n   655\u2192            return\n   656\u2192\n   657\u2192        try:\n   658\u2192            response = self.request(\n   659\u2192                self.API_ALBUMS + album.mb_releasegroupid,\n   660\u2192                headers={\n   661\u2192                    \"api-key\": self.PROJECT_KEY,\n   662\u2192                    \"client-key\": self.client_key,\n   663\u2192                },\n   664\u2192            )\n   665\u2192        except requests.RequestException:\n   666\u2192            self._log.debug(\"fanart.tv: error receiving response\")\n   667\u2192            return\n   668\u2192\n   669\u2192        try:\n   670\u2192            data = response.json()\n   671\u2192        except ValueError:\n   672\u2192            self._log.debug(\n   673\u2192                \"fanart.tv: error loading response: {}\", response.text\n   674\u2192            )\n   675\u2192            return\n   676\u2192\n   677\u2192        if \"status\" in data and data[\"status\"] == \"error\":\n   678\u2192            if \"not found\" in data[\"error message\"].lower():\n   679\u2192                self._log.debug(\"fanart.tv: no image found\")\n   680\u2192            elif \"api key\" in data[\"error message\"].lower():\n   681\u2192                self._log.warning(\n   682\u2192                    \"fanart.tv: Invalid API key given, please \"\n   683\u2192                    \"enter a valid one in your config file.\"\n   684\u2192                )\n   685\u2192            else:\n   686\u2192                self._log.debug(\n   687\u2192                    \"fanart.tv: error on request: {}\", data[\"error message\"]\n   688\u2192                )\n   689\u2192            return\n   690\u2192\n   691\u2192        matches = []\n   692\u2192        # can there be more than one releasegroupid per response?\n   693\u2192        for mbid, art in data.get(\"albums\", {}).items():\n   694\u2192            # there might be more art referenced, e.g. cdart, and an albumcover\n   695\u2192            # might not be present, even if the request was successful\n   696\u2192            if album.mb_releasegroupid == mbid and \"albumcover\" in art:\n   697\u2192                matches.extend(art[\"albumcover\"])\n   698\u2192            # can this actually occur?\n   699\u2192            else:\n   700\u2192                self._log.debug(\n   701\u2192                    \"fanart.tv: unexpected mb_releasegroupid in \" \"response!\"\n   702\u2192                )\n   703\u2192\n   704\u2192        matches.sort(key=lambda x: int(x[\"likes\"]), reverse=True)\n   705\u2192        for item in matches:\n   706\u2192            # fanart.tv has a strict size requirement for album art to be\n   707\u2192            # uploaded\n   708\u2192            yield self._candidate(\n   709\u2192                url=item[\"url\"], match=Candidate.MATCH_EXACT, size=(1000, 1000)\n   710\u2192            )\n   711\u2192\n   712\u2192\n   713\u2192class ITunesStore(RemoteArtSource):\n   714\u2192    NAME = \"iTunes Store\"\n   715\u2192    API_URL = \"https://itunes.apple.com/search\"\n   716\u2192\n   717\u2192    def get(self, album, plugin, paths):\n   718\u2192        \"\"\"Return art URL from iTunes Store given an album title.\"\"\"\n   719\u2192        if not (album.albumartist and album.album):\n   720\u2192            return\n   721\u2192\n   722\u2192        payload = {\n   723\u2192            \"term\": album.albumartist + \" \" + album.album,\n   724\u2192            \"entity\": \"album\",\n   725\u2192            \"media\": \"music\",\n   726\u2192            \"limit\": 200,\n   727\u2192        }\n   728\u2192        try:\n   729\u2192            r = self.request(self.API_URL, params=payload)\n   730\u2192            r.raise_for_status()\n   731\u2192        except requests.RequestException as e:\n   732\u2192            self._log.debug(\"iTunes search failed: {0}\", e)\n   733\u2192            return\n   734\u2192\n   735\u2192        try:\n   736\u2192            candidates = r.json()[\"results\"]\n   737\u2192        except ValueError as e:\n   738\u2192            self._log.debug(\"Could not decode json response: {0}\", e)\n   739\u2192            return\n   740\u2192        except KeyError as e:\n   741\u2192            self._log.debug(\n   742\u2192                \"{} not found in json. Fields are {} \", e, list(r.json().keys())\n   743\u2192            )\n   744\u2192            return\n   745\u2192\n   746\u2192        if not candidates:\n   747\u2192            self._log.debug(\n   748\u2192                \"iTunes search for {!r} got no results\", payload[\"term\"]\n   749\u2192            )\n   750\u2192            return\n   751\u2192\n   752\u2192        if self._config[\"high_resolution\"]:\n   753\u2192            image_suffix = \"100000x100000-999\"\n   754\u2192        else:\n   755\u2192            image_suffix = \"1200x1200bb\"\n   756\u2192\n   757\u2192        for c in candidates:\n   758\u2192            try:\n   759\u2192                if (\n   760\u2192                    c[\"artistName\"] == album.albumartist\n   761\u2192                    and c[\"collectionName\"] == album.album\n   762\u2192                ):\n   763\u2192                    art_url = c[\"artworkUrl100\"]\n   764\u2192                    art_url = art_url.replace(\"100x100bb\", image_suffix)\n   765\u2192                    yield self._candidate(\n   766\u2192                        url=art_url, match=Candidate.MATCH_EXACT\n   767\u2192                    )\n   768\u2192            except KeyError as e:\n   769\u2192                self._log.debug(\n   770\u2192                    \"Malformed itunes candidate: {} not found in {}\",  # NOQA E501\n   771\u2192                    e,\n   772\u2192                    list(c.keys()),\n   773\u2192                )\n   774\u2192\n   775\u2192        try:\n   776\u2192            fallback_art_url = candidates[0][\"artworkUrl100\"]\n   777\u2192            fallback_art_url = fallback_art_url.replace(\n   778\u2192                \"100x100bb\", image_suffix\n   779\u2192            )\n   780\u2192            yield self._candidate(\n   781\u2192                url=fallback_art_url, match=Candidate.MATCH_FALLBACK\n   782\u2192            )\n   783\u2192        except KeyError as e:\n   784\u2192            self._log.debug(\n   785\u2192                \"Malformed itunes candidate: {} not found in {}\",\n   786\u2192                e,\n   787\u2192                list(c.keys()),\n   788\u2192            )\n   789\u2192\n   790\u2192\n   791\u2192class Wikipedia(RemoteArtSource):\n   792\u2192    NAME = \"Wikipedia (queried through DBpedia)\"\n   793\u2192    DBPEDIA_URL = \"https://dbpedia.org/sparql\"\n   794\u2192    WIKIPEDIA_URL = \"https://en.wikipedia.org/w/api.php\"\n   795\u2192    SPARQL_QUERY = \"\"\"PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>\n   796\u2192                 PREFIX dbpprop: <http://dbpedia.org/property/>\n   797\u2192                 PREFIX owl: <http://dbpedia.org/ontology/>\n   798\u2192                 PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>\n   799\u2192                 PREFIX foaf: <http://xmlns.com/foaf/0.1/>\n   800\u2192\n   801\u2192                 SELECT DISTINCT ?pageId ?coverFilename WHERE {{\n   802\u2192                   ?subject owl:wikiPageID ?pageId .\n   803\u2192                   ?subject dbpprop:name ?name .\n   804\u2192                   ?subject rdfs:label ?label .\n   805\u2192                   {{ ?subject dbpprop:artist ?artist }}\n   806\u2192                     UNION\n   807\u2192                   {{ ?subject owl:artist ?artist }}\n   808\u2192                   {{ ?artist foaf:name \"{artist}\"@en }}\n   809\u2192                     UNION\n   810\u2192                   {{ ?artist dbpprop:name \"{artist}\"@en }}\n   811\u2192                   ?subject rdf:type <http://dbpedia.org/ontology/Album> .\n   812\u2192                   ?subject dbpprop:cover ?coverFilename .\n   813\u2192                   FILTER ( regex(?name, \"{album}\", \"i\") )\n   814\u2192                  }}\n   815\u2192                 Limit 1\"\"\"\n   816\u2192\n   817\u2192    def get(self, album, plugin, paths):\n   818\u2192        if not (album.albumartist and album.album):\n   819\u2192            return\n   820\u2192\n   821\u2192        # Find the name of the cover art filename on DBpedia\n   822\u2192        cover_filename, page_id = None, None\n   823\u2192\n   824\u2192        try:\n   825\u2192            dbpedia_response = self.request(\n   826\u2192                self.DBPEDIA_URL,\n   827\u2192                params={\n   828\u2192                    \"format\": \"application/sparql-results+json\",\n   829\u2192                    \"timeout\": 2500,\n   830\u2192                    \"query\": self.SPARQL_QUERY.format(\n   831\u2192                        artist=album.albumartist.title(), album=album.album\n   832\u2192                    ),\n   833\u2192                },\n   834\u2192                headers={\"content-type\": \"application/json\"},\n   835\u2192            )\n   836\u2192        except requests.RequestException:\n   837\u2192            self._log.debug(\"dbpedia: error receiving response\")\n   838\u2192            return\n   839\u2192\n   840\u2192        try:\n   841\u2192            data = dbpedia_response.json()\n   842\u2192            results = data[\"results\"][\"bindings\"]\n   843\u2192            if results:\n   844\u2192                cover_filename = \"File:\" + results[0][\"coverFilename\"][\"value\"]\n   845\u2192                page_id = results[0][\"pageId\"][\"value\"]\n   846\u2192            else:\n   847\u2192                self._log.debug(\"wikipedia: album not found on dbpedia\")\n   848\u2192        except (ValueError, KeyError, IndexError):\n   849\u2192            self._log.debug(\n   850\u2192                \"wikipedia: error scraping dbpedia response: {}\",\n   851\u2192                dbpedia_response.text,\n   852\u2192            )\n   853\u2192\n   854\u2192        # Ensure we have a filename before attempting to query wikipedia\n   855\u2192        if not (cover_filename and page_id):\n   856\u2192            return\n   857\u2192\n   858\u2192        # DBPedia sometimes provides an incomplete cover_filename, indicated\n   859\u2192        # by the filename having a space before the extension, e.g., 'foo .bar'\n   860\u2192        # An additional Wikipedia call can help to find the real filename.\n   861\u2192        # This may be removed once the DBPedia issue is resolved, see:\n   862\u2192        # https://github.com/dbpedia/extraction-framework/issues/396\n   863\u2192        if \" .\" in cover_filename and \".\" not in cover_filename.split(\" .\")[-1]:\n   864\u2192            self._log.debug(\n   865\u2192                \"wikipedia: dbpedia provided incomplete cover_filename\"\n   866\u2192            )\n   867\u2192            lpart, rpart = cover_filename.rsplit(\" .\", 1)\n   868\u2192\n   869\u2192            # Query all the images in the page\n   870\u2192            try:\n   871\u2192                wikipedia_response = self.request(\n   872\u2192                    self.WIKIPEDIA_URL,\n   873\u2192                    params={\n   874\u2192                        \"format\": \"json\",\n   875\u2192                        \"action\": \"query\",\n   876\u2192                        \"continue\": \"\",\n   877\u2192                        \"prop\": \"images\",\n   878\u2192                        \"pageids\": page_id,\n   879\u2192                    },\n   880\u2192                    headers={\"content-type\": \"application/json\"},\n   881\u2192                )\n   882\u2192            except requests.RequestException:\n   883\u2192                self._log.debug(\"wikipedia: error receiving response\")\n   884\u2192                return\n   885\u2192\n   886\u2192            # Try to see if one of the images on the pages matches our\n   887\u2192            # incomplete cover_filename\n   888\u2192            try:\n   889\u2192                data = wikipedia_response.json()\n   890\u2192