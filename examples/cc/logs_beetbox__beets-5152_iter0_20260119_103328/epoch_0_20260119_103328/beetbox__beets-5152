          UNION\n   810→                   {{ ?artist dbpprop:name \"{artist}\"@en }}\n   811→                   ?subject rdf:type <http://dbpedia.org/ontology/Album> .\n   812→                   ?subject dbpprop:cover ?coverFilename .\n   813→                   FILTER ( regex(?name, \"{album}\", \"i\") )\n   814→                  }}\n   815→                 Limit 1\"\"\"\n   816→\n   817→    def get(self, album, plugin, paths):\n   818→        if not (album.albumartist and album.album):\n   819→            return\n   820→\n   821→        # Find the name of the cover art filename on DBpedia\n   822→        cover_filename, page_id = None, None\n   823→\n   824→        try:\n   825→            dbpedia_response = self.request(\n   826→                self.DBPEDIA_URL,\n   827→                params={\n   828→                    \"format\": \"application/sparql-results+json\",\n   829→                    \"timeout\": 2500,\n   830→                    \"query\": self.SPARQL_QUERY.format(\n   831→                        artist=album.albumartist.title(), album=album.album\n   832→                    ),\n   833→                },\n   834→                headers={\"content-type\": \"application/json\"},\n   835→            )\n   836→        except requests.RequestException:\n   837→            self._log.debug(\"dbpedia: error receiving response\")\n   838→            return\n   839→\n   840→        try:\n   841→            data = dbpedia_response.json()\n   842→            results = data[\"results\"][\"bindings\"]\n   843→            if results:\n   844→                cover_filename = \"File:\" + results[0][\"coverFilename\"][\"value\"]\n   845→                page_id = results[0][\"pageId\"][\"value\"]\n   846→            else:\n   847→                self._log.debug(\"wikipedia: album not found on dbpedia\")\n   848→        except (ValueError, KeyError, IndexError):\n   849→            self._log.debug(\n   850→                \"wikipedia: error scraping dbpedia response: {}\",\n   851→                dbpedia_response.text,\n   852→            )\n   853→\n   854→        # Ensure we have a filename before attempting to query wikipedia\n   855→        if not (cover_filename and page_id):\n   856→            return\n   857→\n   858→        # DBPedia sometimes provides an incomplete cover_filename, indicated\n   859→        # by the filename having a space before the extension, e.g., 'foo .bar'\n   860→        # An additional Wikipedia call can help to find the real filename.\n   861→        # This may be removed once the DBPedia issue is resolved, see:\n   862→        # https://github.com/dbpedia/extraction-framework/issues/396\n   863→        if \" .\" in cover_filename and \".\" not in cover_filename.split(\" .\")[-1]:\n   864→            self._log.debug(\n   865→                \"wikipedia: dbpedia provided incomplete cover_filename\"\n   866→            )\n   867→            lpart, rpart = cover_filename.rsplit(\" .\", 1)\n   868→\n   869→            # Query all the images in the page\n   870→            try:\n   871→                wikipedia_response = self.request(\n   872→                    self.WIKIPEDIA_URL,\n   873→                    params={\n   874→                        \"format\": \"json\",\n   875→                        \"action\": \"query\",\n   876→                        \"continue\": \"\",\n   877→                        \"prop\": \"images\",\n   878→                        \"pageids\": page_id,\n   879→                    },\n   880→                    headers={\"content-type\": \"application/json\"},\n   881→                )\n   882→            except requests.RequestException:\n   883→                self._log.debug(\"wikipedia: error receiving response\")\n   884→                return\n   885→\n   886→            # Try to see if one of the images on the pages matches our\n   887→            # incomplete cover_filename\n   888→            try:\n   889→                data = wikipedia_response.json()\n   890→ 