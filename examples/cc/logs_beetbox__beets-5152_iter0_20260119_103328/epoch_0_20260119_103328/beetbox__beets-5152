       elif isinstance(value, BLOB_TYPE):\n   227\u2192            # We unwrap buffers to bytes.\n   228\u2192            return bytes(value)\n   229\u2192\n   230\u2192        else:\n   231\u2192            return value\n   232\u2192\n   233\u2192    def from_sql(self, sql_value):\n   234\u2192        return self.normalize(sql_value)\n   235\u2192\n   236\u2192    def to_sql(self, value):\n   237\u2192        if isinstance(value, bytes):\n   238\u2192            value = BLOB_TYPE(value)\n   239\u2192        return value\n   240\u2192\n   241\u2192\n   242\u2192class MusicalKey(types.String):\n   243\u2192    \"\"\"String representing the musical key of a song.\n   244\u2192\n   245\u2192    The standard format is C, Cm, C#, C#m, etc.\n   246\u2192    \"\"\"\n   247\u2192\n   248\u2192    ENHARMONIC = {\n   249\u2192        r\"db\": \"c#\",\n   250\u2192        r\"eb\": \"d#\",\n   251\u2192        r\"gb\": \"f#\",\n   252\u2192        r\"ab\": \"g#\",\n   253\u2192        r\"bb\": \"a#\",\n   254\u2192    }\n   255\u2192\n   256\u2192    null = None\n   257\u2192\n   258\u2192    def parse(self, key):\n   259\u2192        key = key.lower()\n   260\u2192        for flat, sharp in self.ENHARMONIC.items():\n   261\u2192            key = re.sub(flat, sharp, key)\n   262\u2192        key = re.sub(r\"[\\W\\s]+minor\", \"m\", key)\n   263\u2192        key = re.sub(r\"[\\W\\s]+major\", \"\", key)\n   264\u2192        return key.capitalize()\n   265\u2192\n   266\u2192    def normalize(self, key):\n   267\u2192        if key is None:\n   268\u2192            return None\n   269\u2192        else:\n   270\u2192            return self.parse(key)\n   271\u2192\n   272\u2192\n   273\u2192class DurationType(types.Float):\n   274\u2192    \"\"\"Human-friendly (M:SS) representation of a time interval.\"\"\"\n   275\u2192\n   276\u2192    query = dbcore.query.DurationQuery\n   277\u2192\n   278\u2192    def format(self, value):\n   279\u2192        if not beets.config[\"format_raw_