a.keys():\n   585\u2192            for item in data[\"items\"]:\n   586\u2192                yield self._candidate(\n   587\u2192                    url=item[\"link\"], match=Candidate.MATCH_EXACT\n   588\u2192                )\n   589\u2192\n   590\u2192\n   591\u2192class FanartTV(RemoteArtSource):\n   592\u2192    \"\"\"Art from fanart.tv requested using their API\"\"\"\n   593\u2192\n   594\u2192    NAME = \"fanart.tv\"\n   595\u2192    API_URL = \"https://webservice.fanart.tv/v3/\"\n   596\u2192    API_ALBUMS = API_URL + \"music/albums/\"\n   597\u2192    PROJECT_KEY = \"61a7d0ab4e67162b7a0c7c35915cd48e\"\n   598\u2192\n   599\u2192    def __init__(self, *args, **kwargs):\n   600\u2192        super().__init__(*args, **kwargs)\n   601\u2192        self.client_key = self._config[\"fanarttv_key\"].get()\n   602\u2192\n   603\u2192    @staticmethod\n   604\u2192    def add_default_config(config):\n   605\u2192        config.add(\n   606\u2192            {\n   607\u2192                \"fanarttv_key\": None,\n   608\u2192            }\n   609\u2192        )\n   610\u2192        config[\"fanarttv_key\"].redact = True\n   611\u2192\n   612\u2192    def get(self, album, plugin, paths):\n   613\u2192        if not album.mb_releasegroupid:\n   614\u2192            return\n   615\u2192\n   616\u2192        try:\n   617\u2192            response = self.request(\n   618\u2192                self.API_ALBUMS + album.mb_releasegroupid,\n   619\u2192                headers={\n   620\u2192                    \"api-key\": self.PROJECT_KEY,\n   621\u2192                    \"client-key\": self.client_key,\n   622\u2192                },\n   623\u2192            )\n   624\u2192        except requests.RequestException:\n   625\u2192            self._log.debug(\"fanart.tv: error receiving response\")\n   626\u2192            return\n   627\u2192\n   628\u2192        try:\n   629\u2192            data = response.json()\n   630\u2192        except ValueError:\n   631\u2192            s