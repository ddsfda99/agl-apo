self.src_removed:\n  1316\u2192                task.prune(candidate.path)\n  1317\u2192\n  1318\u2192    # Manual album art fetching.\n  1319\u2192    def commands(self):\n  1320\u2192        cmd = ui.Subcommand(\"fetchart\", help=\"download album art\")\n  1321\u2192        cmd.parser.add_option(\n  1322\u2192            \"-f\",\n  1323\u2192            \"--force\",\n  1324\u2192            dest=\"force\",\n  1325\u2192            action=\"store_true\",\n  1326\u2192            default=False,\n  1327\u2192            help=\"re-download art when already present\",\n  1328\u2192        )\n  1329\u2192        cmd.parser.add_option(\n  1330\u2192            \"-q\",\n  1331\u2192            \"--quiet\",\n  1332\u2192            dest=\"quiet\",\n  1333\u2192            action=\"store_true\",\n  1334\u2192            default=False,\n  1335\u2192            help=\"quiet mode: do not output albums that already have artwork\",\n  1336\u2192        )\n  1337\u2192\n  1338\u2192        def func(lib, opts, args):\n  1339\u2192            self.batch_fetch_art(\n  1340\u2192                lib, lib.albums(ui.decargs(args)), opts.force, opts.quiet\n  1341\u2192            )\n  1342\u2192\n  1343\u2192        cmd.func = func\n  1344\u2192        return [cmd]\n  1345\u2192\n  1346\u2192    # Utilities converted from functions to methods on logging overhaul\n  1347\u2192\n  1348\u2192    def art_for_album(self, album, paths, local_only=False):\n  1349\u2192        \"\"\"Given an Album object, returns a path to downloaded art for the\n  1350\u2192        album (or None if no art is found). If `maxwidth`, then images are\n  1351\u2192        resized to this maximum pixel size. If `quality` then resized images\n  1352\u2192        are saved at the specified quality level. If `local_only`, then only\n  1353\u2192        local image files from the filesystem are returned; no network\n  1354\u2192        requests are made.\n  1355\u2192        \"\"\"\n  1356\u2192        out = None\n  1357\u2192\n  1358\u2192        for source in self.sources:\n  1359\u2192            if source.IS_LOCAL or not local_only:\n  1360\u2192                self._log.debug(\n  1361\u2192                    \"trying source {0} for album {1.albumartist} - {1.album}\",\n  1362\u2192                    SOURCE_NAMES[type(source)],\n  1363\u2192                    album,\n  1364\u2192                )\n  1365\u2192                # URLs might be invalid at this point, or the image may not\n  1366\u2192                # fulfill the requirements\n  1367\u2192                for candidate in source.get(album, self, paths):\n  1368\u2192                    source.fetch_image(candidate, self)\n  1369\u2192                    if candidate.validate(self):\n  1370\u2192                        out = candidate\n  1371\u2192                        self._log.debug(\n  1372\u2192                            \"using {0.LOC_STR} image {1}\".format(\n  1373\u2192                                source, util.displayable_path(out.path)\n  1374\u2192                            )\n  1375\u2192                        )\n  1376\u2192                        break\n  1377\u2192                    # Remove temporary files for invalid candidates.\n  1378\u2192                    source.cleanup(candidate)\n  1379\u2192                if out:\n  1380\u2192                    break\n  1381\u2192\n  1382\u2192        if out:\n  1383\u2192            out.resize(self)\n  1384\u2192\n  1385\u2192        return out\n  1386\u2192\n  1387\u2192    def batch_fetch_art(self, lib, albums, force, quiet):\n  1388\u2192        \"\"\"Fetch album art for each of the albums. This implements the manual\n  1389\u2192        fetchart CLI command.\n  1390\u2192        \"\"\"\n  1391\u2192        for album in albums:\n  1392\u2192            if (\n  1393\u2192                album.artpath\n  1394\u2192                and not force\n  1395\u2192                and os.path.isfile(syspath(album.artpath))\n  1396\u2192            ):\n