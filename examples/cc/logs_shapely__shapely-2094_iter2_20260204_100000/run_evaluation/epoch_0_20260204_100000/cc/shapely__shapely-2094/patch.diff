@@ -131,6 +131,17 @@ GEOJSON_COLLECTION_EXPECTED = [
 
 
 def test_from_wkt():
+    # new: invalid polygon ring default strict
+    bad = "POLYGON ((0 0, 1 0, 1 1, 0 1))"
+    with pytest.raises(shapely.GEOSException):
+        shapely.from_wkt(bad)
+    # with fix_structure True loads and closes ring
+    g = shapely.from_wkt(bad, fix_structure=True)
+    assert g.exterior.coords[0] == g.exterior.coords[-1]
+    import shapely.wkt as wkt
+    g2 = wkt.loads(bad, fix_structure=True)
+    assert g2.exterior.coords[0] == g2.exterior.coords[-1]
+
     expected = shapely.points(1, 1)
     actual = shapely.from_wkt("POINT (1 1)")
     assert_geometries_equal(actual, expected)
