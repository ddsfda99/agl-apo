         self.save_config(path)\n   745\u2192        self.config_saved = copy.deepcopy(self.config_files)\n   746\u2192\n   747\u2192    def save_config(self, path):\n   748\u2192        with open(path, 'w') as f:\n   749\u2192            yaml.safe_dump(self.config_files[path], f,\n   750\u2192                           default_flow_style=False)\n   751\u2192\n   752\u2192\n   753\u2192def _get_kube_config_loader_for_yaml_file(\n   754\u2192        filename, persist_config=False, **kwargs):\n   755\u2192    return _get_kube_config_loader(\n   756\u2192        filename=filename,\n   757\u2192        persist_config=persist_config,\n   758\u2192        **kwargs)\n   759\u2192\n   760\u2192\n   761\u2192def _get_kube_config_loader(\n   762\u2192        filename=None,\n   763\u2192        config_dict=None,\n   764\u2192        persist_config=False,\n   765\u2192        **kwargs):\n   766\u2192    if config_dict is None:\n   767\u2192        kcfg = KubeConfigMerger(filename)\n   768\u2192        if persist_config and 'config_persister' not in kwargs:\n   769\u2192            kwargs['config_persister'] = kcfg.save_changes\n   770\u2192\n   771\u2192        if kcfg.config is None:\n   772\u2192            raise ConfigException(\n   773\u2192                'Invalid kube-config file. '\n   774\u2192                'No configuration found.')\n   775\u2192        return KubeConfigLoader(\n   776\u2192            config_dict=kcfg.config,\n   777\u2192            config_base_path=None,\n   778\u2192            **kwargs)\n   779\u2192    else:\n   780\u2192        return KubeConfigLoader(\n   781\u2192            config_dict=config_dict,\n   782\u2192            config_base_path=None,\n   783\u2192            **kwargs)\n   784\u2192\n   785\u2192\n   786\u2192def list_kube_config_contexts(config_file=None):\n   787\u2192\n   788\u2192    if config_file is None:\n   789\u2192        config_file = KUBE_CONFIG_DEFAULT_LOCATION\n   790\u2192\n   791\u2192    loader = _get_kube_config