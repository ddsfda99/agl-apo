\n   827→\n   828→def load_kube_config_from_dict(config_dict, context=None,\n   829→                               client_configuration=None,\n   830→                               persist_config=True,\n   831→                               temp_file_path=None):\n   832→    \"\"\"Loads authentication and cluster information from config_dict file\n   833→    and stores them in kubernetes.client.configuration.\n   834→\n   835→    :param config_dict: Takes the config file as a dict.\n   836→    :param context: set the active context. If is set to None, current_context\n   837→        from config file will be used.\n   838→    :param client_configuration: The kubernetes.client.Configuration to\n   839→        set configs to.\n   840→    :param persist_config: If True, config file will be updated when changed\n   841→        (e.g GCP token refresh).\n   842→    :param temp_file_path: store temp files path.\n   843→    \"\"\"\n   844→    if config_dict is None:\n   845→        raise ConfigException(\n   846→            'Invalid kube-config dict. '\n   847→            'No configuration found.')\n   848→\n   849→    loader = _get_kube_config_loader(\n   850→        config_dict=config_dict, active_context=context,\n   851→        persist_config=persist_config,\n   852→        temp_file_path=temp_file_path)\n   853→\n   854→    if client_configuration is None:\n   855→        config = type.__call__(Configuration)\n   856→        loader.load_and_set(config)\n   857→        Configuration.set_default(config)\n   858→    else:\n   859→        loader.load_and_set(client_configuration)\n   860→\n   861→\n   862→def new_client_from_config(\n   863→        config_file=None,\n   864→        context=None,\n   865→        persist_config=True):\n   866→    \"\"\"\n   867→    Loads configuration the same as load_kube_config but returns an ApiClient\n   868→    to be used with any API object. This will allow the caller to concurrently\n   869→    talk with multiple clusters.\n   870→    \"\"\"\n   871→    client_config = type.__call__(Configuration)\n   872→    load_kube_config(config_file=config_file, context=context,\n   873→                     client_configuration=client_config,\n   874→                     persist_config=persist_config)\n   875→    return ApiClient(configuration=client_config)\n   876→\n   877→\n   878→def new_client_from_config_dict(\n   879→        config_dict=None,\n   880→        context=None,\n   881→        persist_config=True,\n   882→        temp_file_path=None):\n   883→    \"\"\"\n   884→    Loads configuration the same as load_kube_config_from_dict but returns an ApiClient\n   885→    to be used with any API object. This will allow the caller to concurrently\n   886→    talk with multiple clusters.\n   887→    \"\"\"\n   888→    client_config = type.__call__(Configuration)\n   889→    load_kube_config_from_dict(config_dict=config_dict, context=context,\n   890→                               client_configuration=client_config,\n   891→                               persist_config=persist_config,\n   892→                               temp_file_path=temp_file_path)\n   893→    return ApiClient(configuration=client_config)\n   894→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"8e204636-f58e-4aaf-882a-ddea260a8d83","uuid":"6762881a-4474-4dd6-8cda-33a206044092","tool_use_result":{"type":"text","file":{"filePath":"/testbed/kubernetes/config/kube_config.py","content":"# Copyright 2018 The Kubernetes Authors.\n#\n# Licensed under the Apache License, Version 2.0 (the \"License\");\n# you may not use this file except in compliance with the License.\n# You may obtain a copy of the License at