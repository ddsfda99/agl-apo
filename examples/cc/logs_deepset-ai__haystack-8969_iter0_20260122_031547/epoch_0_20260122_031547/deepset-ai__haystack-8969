101\u2192        \"\"\"\n   102\u2192        This method is reimplemented to make the changes to the `ChatMessage` dataclass more visible.\n   103\u2192        \"\"\"\n   104\u2192\n   105\u2192        general_msg = (\n   106\u2192            \"Use the `from_assistant`, `from_user`, `from_system`, and `from_tool` class methods to create a \"\n   107\u2192            \"ChatMessage. For more information about the new API and how to migrate, see the documentation:\"\n   108\u2192            \" https://docs.haystack.deepset.ai/docs/chatmessage\"\n   109\u2192        )\n   110\u2192\n   111\u2192        if any(param in kwargs for param in LEGACY_INIT_PARAMETERS):\n   112\u2192            raise TypeError(\n   113\u2192                \"The `role`, `content`, `meta`, and `name` init parameters of `ChatMessage` have been removed. \"\n   114\u2192                f\"{general_msg}\"\n   115\u2192            )\n   116\u2192\n   117\u2192        allowed_content_types = (TextContent, ToolCall, ToolCallResult)\n   118\u2192        if len(args) > 1 and not isinstance(args[1], allowed_content_types):\n   119\u2192            raise TypeError(\n   120\u2192                \"The `_content` parameter of `ChatMessage` must be one of the following types: \"\n   121\u2192                f\"{', '.join(t.__name__ for t in allowed_content_types)}. \"\n   122\u2192                f\"{general_msg}\"\n   123\u2192            )\n   124\u2192\n   125\u2192        return super(ChatMessage, cls).__new__(cls)\n   126\u2192\n   127\u2192    def __getattribute__(self, name):\n   128\u2192        \"\"\"\n   129\u2192        This method is reimplemented to make the `content` attribute removal more visible.\n   130\u2192        \"\"\"\n   131\u2192\n   132\u2192        if name == \"content\":\n   133\u2192            msg = (\n   134\u2192                \"The `content` attribute of `ChatMessage` has been removed. \"\n   135\u2192                \"Use the `text` property to access the textual value. \"\n   136\u2192                \"For more information about the new API and how to migrate, see the documentation: \"\n   137\u2192                \"https://docs.haystack.deepset.ai/docs/chatmessage\"\n   138\u2192            )\n   139\u2192            raise AttributeError(msg)\n   140\u2192        return object.__getattribute__(self, name)\n   141\u2192\n   142\u2192    def __len__(self):\n   143\u2192        return len(self._content)\n   144\u2192\n   145\u2192    @property\n   146\u2192    def role(self) -> ChatRole:\n   147\u2192        \"\"\"\n   148\u2192        Returns the role of the entity sending the message.\n   149\u2192        \"\"\"\n   150\u2192        return self._role\n   151\u2192\n   152\u2192    @property\n   153\u2192    def meta(self) -> Dict[str, Any]:\n   154\u2192        \"\"\"\n   155\u2192        Returns the metadata associated with the message.\n   156\u2192        \"\"\"\n   157\u2192        return self._meta\n   158\u2192\n   159\u2192    @property\n   160\u2192    def name(self) -> Optional[str]:\n   161\u2192        \"\"\"\n   162\u2192        Returns the name associated with the message.\n   163\u2192        \"\"\"\n   164\u2192        return self._name\n   165\u2192\n   166\u2192    @property\n   167\u2192    def texts(self) -> List[str]:\n   168\u2192        \"\"\"\n   169\u2192        Returns the list of all texts contained in the message.\n   170\u2192        \"\"\"\n   171\u2192        return [content.text for content in self._content if isinstance(content, TextContent)]\n   172\u2192\n   173\u2192    @property\n   174\u2192    def text(self) -> Optional[str]:\n   175\u2192        \"\"\"\n   176\u2192        Returns the first text contained in the message.\n   177\u2192        \"\"\"\n   178\u2192        if texts := self.texts:\n   179\u2192            return texts[0]\n   180\u2192        return None\n   181\u2192\n   182\u2192    @property\n   183\u2192    def tool_calls(self) -> List[ToolCall]:\n   184\u2192        \"\"\"\n   185\u2192        Returns the list of all Tool calls contained in the message.\n   186\u2192        \"\"\"\n   187\u2192        return [content for content in self._content if isinstance(content, ToolCall)]\n   188\u2192\n   189\u2192    @property\n   190\u2192    def tool_call(self) -> Optional[ToolCall]:\n   191\u2192        \"\"\"\n   192\u2192        Returns the first Tool call contained in the message.\n   193\u2192        \"\"\"\n   194\u2192        if tool_calls := self.tool_calls:\n   195\u2192            return tool_calls[0]\n   196\u2192        return None\n   197\u2192\n   198\u2192    @property\n   199\u2192    def tool_call_results(self) -> List[ToolCallResult]:\n   200\u2192        \"\"\"\n   201\u2192        Returns the list of all Tool call results contained in the message.\n   202\u2192        \"\"\"\n   203\u2192        return [content for content in self._content if isinstance(content, ToolCallResult)]\n   204\u2192\n   205\u2192    @property\n   206\u2192    def tool_call_result(self) -> Optional[ToolCallResult]:\n   207\u2192        \"\"\"\n   208\u2192        Returns the first Tool call result contained in the message.\n   209\u2192        \"\"\"\n   210\u2192        if tool_call_results := self.tool_call_results:\n   211\u2192            return tool_call_results[0]\n   212\u2192        return None\n   213\u2192\n   214\u2192    def is_from(self, role: Union[ChatRole, str]) -> bool:\n   215\u2192        \"\"\"\n   216\u2192        Check if the message is from a specific role.\n   217\u2192\n   218\u2192        :param role: The role to check against.\n   219\u2192        :returns: True if the message is from the specified role, False otherwise.\n   220\u2192        \"\"\"\n   221\u2192        if isinstance(role, str):\n   222\u2192            role = ChatRole.from_str(role)\n   223\u2192        return self._role == role\n   224\u2192\n   225\u2192    @classmethod\n   226\u2192    def from_user(cls, text: str, meta: Optional[Dict[str, Any]] = None, name: Optional[str] = None) -> \"ChatMessage\":\n   227\u2192        \"\"\"\n   228\u2192        Create a message from the user.\n   229\u2192\n   230\u2192        :param text: The text content of the message.\n   231\u2192        :param meta: Additional metadata associated with the message.\n   232\u2192        :param name: An optional name for the participant. This field is only supported by OpenAI.\n   233\u2192        :returns: A new ChatMessage instance.\n   234\u2192        \"\"\"\n   235\u2192        return cls(_role=ChatRole.USER, _content=[TextContent(text=text)], _meta=meta or {}, _name=name)\n   236\u2192\n   237\u2192    @classmethod\n   238\u2192    def from_system(cls, text: str, meta: Optional[Dict[str, Any]] = None, name: Optional[str] = None) -> \"ChatMessage\":\n   239\u2192        \"\"\"\n   240\u2192        Create a message from the system.\n   241\u2192\n   242\u2192        :param text: The text content of the message.\n   243\u2192        :param meta: Additional metadata associated with the message.\n   244\u2192        :param name: An optional name for the participant. This field is only supported by OpenAI.\n   245\u2192        :returns: A new ChatMessage instance.\n   246\u2192        \"\"\"\n   247\u2192        return cls(_role=ChatRole.SYSTEM, _content=[TextContent(text=text)], _meta=meta or {}, _name=name)\n   248\u2192\n   249\u2192    @classmethod\n   250\u2192    def from_assistant(\n   251\u2192        cls,\n   252\u2192        text: Optional[str] = None,\n   253\u2192        meta: Optional[Dict[str, Any]] = None,\n   254\u2192        name: Optional[str] = None,\n   255\u2192        tool_calls: Optional[List[ToolCall]] = None,\n   256\u2192    ) -> \"ChatMessage\":\n   257\u2192        \"\"\"\n   258\u2192        Create a message from the assistant.\n   259\u2192\n   260\u2192        :param text: The text content of the message.\n   261\u2192        :param meta: Additional metadata associated with the message.\n   262\u2192        :param tool_calls: The Tool calls to include in the message.\n   263\u2192        :param name: An optional name for the participant. This field is only supported by OpenAI.\n   264\u2192        :returns: A new ChatMessage instance.\n   265\u2192        \"\"\"\n   266\u2192        content: List[ChatMessageContentT] = []\n   267\u2192        if text is not None:\n   268\u2192            content.append(TextContent(text=text))\n   269\u2192        if tool_calls:\n   270\u2192            content.extend(tool_calls)\n   271\u2192\n   272\u2192        return cls(_role=ChatRole.ASSISTANT, _content=content, _meta=meta or {}, _name=name)\n   273\u2192\n   274\u2192    @classmethod\n   275\u2192    def from_tool(\n   276\u2192        cls, tool_result: str, origin: ToolCall, error: bool = False, meta: Optional[Dict[str, Any]] = None\n   277\u2192    ) -> \"ChatMessage\":\n   278\u2192        \"\"\"\n   279\u2192        Create a message from a Tool.\n   280\u2192\n   281\u2192        :param tool_result: The result of the Tool invocation.\n   282\u2192        :param origin: The Tool call that produced this result.\n   283\u2192        :param error: Whether the Tool invocation resulted in an error.\n   284\u2192        :param meta: Additional metadata associated with the message.\n   285\u2192        :returns: A new ChatMessage instance.\n   286\u2192        \"\"\"\n   287\u2192        return cls(\n   288\u2192            _role=ChatRole.TOOL,\n   289\u2192            _content=[ToolCallResult(result=tool_result, origin=origin, error=error)],\n   290\u2192            _meta=meta or {},\n   291\u2192        )\n   292\u2192\n   293\u2192    def to_dict(self) -> Dict[str, Any]:\n   294\u2192        \"\"\"\n   295\u2192        Converts ChatMessage into a dictionary.\n   296\u2192\n   297\u2192        :returns:\n   298\u2192            Serialized version of the object.\n   299\u2192        \"\"\"\n   300\u2192        serialized: Dict[str, Any] = {}\n   301\u2192        serialized[\"_role\"] = self._role.value\n   302\u2192        serialized[\"_meta\"] = self._meta\n   303\u2192        serialized[\"_name\"] = self._name\n   304\u2192        content: List[Dict[str, Any]] = []\n   305\u2192        for part in self._content:\n   306\u2192            if isinstance(part, TextContent):\n   307\u2192                content.append({\"text\": part.text})\n   308\u2192            elif isinstance(part, ToolCall):\n   309\u2192                content.append({\"tool_call\": asdict(part)})\n   310\u2192            elif isinstance(part, ToolCallResult):\n   311\u2192                content.append({\"tool_call_result\": asdict(part)})\n   312\u2192            else:\n   313\u2192                raise TypeError(f\"Unsupported type in ChatMessage content: `{type(part).__name__}` for `{part}`.\")\n   314\u2192\n   315\u2192        serialized[\"_content\"] = content\n   316\u2192        return serialized\n   317\u2192\n   318    @classmethod\n   319\u2192    def from_dict(cls, data: Dict[str, Any]) -> \"ChatMessage\":\n   320\u2192        \"\"\"\n   321\u2192        Creates a new ChatMessage object from a dictionary.\n   322\u2192\n   323\u2192        :param data:\n   324\u2192            The dictionary to build the ChatMessage object.\n   325\u2192        :returns:\n   326\u2192            The created object.\n   327\u2192        \"\"\"\n   328\u2192        if any(param in data for param in LEGACY_INIT_PARAMETERS):\n   329\u2192            raise TypeError(\n   330\u2192                \"The `role`, `content`, `meta`, and `name` init parameters of `ChatMessage` have been removed. \"\n   331\u2192                \"For more information about the new API and how to migrate, see the documentation: \"\n   332\u2192                \"https://docs.haystack.deepset.ai/docs/chatmessage\"\n   333\u2192            )\n   334\u2192\n   335\u2192        data[\"_role\"] = ChatRole(data[\"_role\"])\n   336\u2192\n   337\u2192        content: List[ChatMessageContentT] = []\n   338\u2192\n   339\u2192        for part in data[\"_content\"]:\n   340\u2192            if \"text\" in part:\n   341\u2192                content.append(TextContent(text=part[\"text\"]))\n   342\u2192            elif \"tool_call\" in part:\n   343\u2192                content.append(ToolCall(**part[\"tool_call\"]))\n   344\u2192            elif \"tool_call_result\" in part:\n   345\u2192                result = part[\"tool_call_result\"][\"result\"]\n   346\u2192                origin = ToolCall(**part[\"tool_call_result\"][\"origin\"])\n   347\u2192                error = part[\"tool_call_result\"][\"error\"]\n   348\u2192                tcr = ToolCallResult(result=result, origin=origin, error=error)\n   349\u2192                content.append(tcr)\n   350\u2192            else:\n   351\u2192                raise ValueError(f\"Unsupported content in serialized ChatMessage: `{part}`\")\n   352\u2192\n   353\u2192        data[\"_content\"] = content\n   354\u2192\n   355\u2192        return cls(**data)\n   356\u2192\n   357\u2192    def to_openai_dict_format(self) -> Dict[str, Any]:\n   358\u2192        \"\"\"\n   359\u2192        Convert a ChatMessage to the dictionary format expected by OpenAI's Chat API.\n   360\u2192        \"\"\"\n   361\u2192        text_contents = self.texts\n   362\u2192        tool_calls = self.tool_calls\n   363\u2192        tool_call_results = self.tool_call_results\n   364\u2192\n   365\u2192        if not text_contents and not tool_calls and not tool_call_results:\n   366\u2192            raise ValueError(\n   367\u2192                \"A `ChatMessage` must contain at least one `TextContent`, `ToolCall`, or `ToolCallResult`.\"\n   368\u2192            )\n   369\u2192        if len(text_contents) + len(tool_call_results) > 1:\n   370\u2192            raise ValueError(\"A `ChatMessage` can only contain one `TextContent` or one `ToolCallResult`.\")\n   371\u2192\n   372\u2192        openai_msg: Dict[str, Any] = {\"role\": self._role.value}\n   373\u2192\n   374\u2192        if tool_call_results:\n   375\u2192            result = tool_call_results[0]\n   376\u2192            if result.origin.id is None:\n   377\u2192                raise ValueError(\"`ToolCall` must have a non-null `id` attribute to be used with OpenAI.\")\n   378\u2192            openai_msg[\"content\"] = result.result\n   379\u2192            openai_msg[\"tool_call_id\"] = result.origin.id\n   380\u2192            # OpenAI does not provide a way to communicate errors in tool invocations, so we ignore the error field\n   381\u2192            return openai_msg\n   382\u2192\n   383\u2192        if text_contents:\n   384\u2192            openai_msg[\"content\"] = text_contents[0]\n   385\u2192        if tool_calls:\n   386\u2192            openai_tool_calls = []\n   387\u2192            for tc in tool_calls:\n   388\u2192                if tc.id is None:\n   389\u2192                    raise ValueError(\"`ToolCall` must have a non-null `id` attribute to be used with OpenAI.\")\n   390\u2192                openai_tool_calls.append(\n   391\u2192                    {\n   392\u2192                        \"id\": tc.id,\n   393\u2192                        \"type\": \"function\",\n   394\u2192                        # We disable ensure_ascii so special chars like emojis are not converted\n   395\u2192                        \"function\": {\"name\": tc.tool_name, \"arguments\": json.dumps(tc.arguments, ensure_ascii=False)},\n   396\u2192                    }\n   397\u2192                )\n   398\u2192            openai_msg[\"tool_calls\"] = openai_tool_calls\n   399\u2192        return openai_msg\n   400\u2192\n   401\u2192    @staticmethod\n   402\u2192    def _validate_openai_message(message: Dict[str, Any]) -> None:\n   403\u2192        \"\"\"\n   404\u2192        Validate that a message dictionary follows OpenAI's Chat API format.\n   405\u2192\n   406\u2192        :param message: The message dictionary to validate\n   407\u2192        :raises ValueError: If the message format is invalid\n   408\u2192        \"\"\"\n   409\u2192        if \"role\" not in message:\n   410\u2192            raise ValueError(\"The `role` field is required in the message dictionary.\")\n   411\u2192\n   412\u2192        role = message[\"role\"]\n   413\u2192        content = message.get(\"content\")\n   414\u2192        tool_calls = message.get(\"tool_calls\")\n   415\u2192\n   416\u2192        if role not in [\"assistant\", \"user\", \"system\", \"developer\", \"tool\"]:\n   417\u2192            raise ValueError(f\"Unsupported role: {role}\")\n   418\u2192\n   419\u2192        if role == \"assistant\":\n   420\u2192            if not content and not tool_calls:\n   421\u2192                raise ValueError(\"For assistant messages, either `content` or `tool_calls` must be present.\")\n   422\u2192            if tool_calls:\n   423\u2192                for tc in tool_calls:\n   424\u2192                    if \"function\" not in tc:\n   425\u2192                        raise ValueError(\"Tool calls must contain the `function` field\")\n   426\u2192        elif not content:\n   427\u2192            raise ValueError(f\"The `content` field is required for {role} messages.\")\n   428\u2192\n   429\u2192    @classmethod\n   430\u2192    def from_openai_dict_format(cls, message: Dict[str, Any]) -> \"ChatMessage\":\n   431\u2192        \"\"\"\n   432\u2192        Create a ChatMessage from a dictionary in the format expected by OpenAI's Chat API.\n   433\u2192\n   434\u2192        NOTE: While OpenAI's API requires `tool_call_id` in both tool calls and tool messages, this method\n   435\u2192        accepts messages without it to support shallow OpenAI-compatible APIs.\n   436\u2192        If you plan to use the resulting ChatMessage with OpenAI, you must include `tool_call_id` or you'll\n   437\u2192        encounter validation errors.\n   438\u2192\n   439\u2192        :param message:\n   440\u2192            The OpenAI dictionary to build the ChatMessage object.\n   441\u2192        :returns:\n   442\u2192            The created ChatMessage object.\n   443\u2192\n   444\u2192        :raises ValueError:\n   445\u2192            If the message dictionary is missing required fields.\n   446\u2192        \"\"\"\n   447\u2192        cls._validate_openai_message(message)\n   448\u2192\n   449\u2192        role = message[\"role\"]\n   450\u2192        content = message.get(\"content\")\n   451\u2192        name = message.get(\"name\")\n   452\u2192        tool_calls = message.get(\"tool_calls\")\n   453\u2192        tool_call_id = message.get(\"tool_call_id\")\n   454\u2192\n   455\u2192        if role == \"assistant\":\n   456\u2192            haystack_tool_calls = None\n   457\u2192            if tool_calls:\n   458\u2192                haystack_tool_calls = []\n   459\u2192                for tc in tool_calls:\n   460\u2192                    haystack_tc = ToolCall(\n   461\u2192                        id=tc.get(\"id\"),\n   462\u2192                        tool_name=tc[\"function\"][\"name\"],\n   463\u2192                        arguments=json.loads(tc[\"function\"][\"arguments\"]),\n   464\u2192                    )\n   465\u2192                    haystack_tool_calls.append(haystack_tc)\n   466\u2192            return cls.from_assistant(text=content, name=name, tool_calls=haystack_tool_calls)\n   467\u2192\n   468\u2192        assert content is not None  # ensured by _validate_openai_message, but we need to make mypy happy\n   469\u2192\n   470\u2192        if role == \"user\":\n   471\u2192            return cls.from_user(text=content, name=name)\n   472\u2192        if role in [\"system\", \"developer\"]:\n   473\u2192            return cls.from_system(text=content, name=name)\n   474\u2192\n   475\u2192        return cls.from_tool(\n   476\u2192            tool_result=content, origin=ToolCall(id=tool_call_id, tool_name=\"\", arguments={}), error=False\n   477\u2192        )\n   478\u2192\n\n<system-r