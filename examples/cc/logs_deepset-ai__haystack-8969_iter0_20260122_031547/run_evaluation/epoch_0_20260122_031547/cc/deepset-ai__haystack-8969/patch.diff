+def test_to_openai_dict_format_includes_name_for_supported_roles():
+    # user message with name
+    message = ChatMessage.from_user("Hello", name="John")
+    assert message.to_openai_dict_format() == {"role": "user", "content": "Hello", "name": "John"}
+
+    # system message with name
+    message = ChatMessage.from_system("Sys", name="Config")
+    assert message.to_openai_dict_format() == {"role": "system", "content": "Sys", "name": "Config"}
+
+    # assistant message with name and content
+    message = ChatMessage.from_assistant(text="Answer", name="Bot")
+    assert message.to_openai_dict_format() == {"role": "assistant", "content": "Answer", "name": "Bot"}
+
+    # assistant message with name and tool_calls
+    message = ChatMessage.from_assistant(
+        name="Bot",
+        tool_calls=[ToolCall(id="123", tool_name="weather", arguments={"city": "Paris"})],
+    )
+    assert message.to_openai_dict_format() == {
+        "role": "assistant",
+        "name": "Bot",
+        "tool_calls": [
+            {"id": "123", "type": "function", "function": {"name": "weather", "arguments": '{"city": "Paris"}'}}
+        ],
+    }
+
+
