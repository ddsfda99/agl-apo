n   206\u2192                    # The cache file is corrupted; ignore it and recompute.\n   207\u2192                    logging.error(\"Cache file is corrupted: %s; recomputing.\", exc)\n   208\u2192                    result = None\n   209\u2192\n   210\u2192                else:\n   211\u2192                    # Check that the latest timestamp has not been written after the\n   212\u2192                    # cache file.\n   213\u2192                    entries, errors, options_map = result\n   214\u2192                    if not needs_refresh(options_map):\n   215\u2192                        # All timestamps are legit; cache hit.\n   216\u2192                        return result\n   217\u2192\n   218\u2192        # We failed; recompute the value.\n   219\u2192        if exists:\n   220\u2192            try:\n   221\u2192                os.remove(cache_filename)\n   222\u2192            except OSError as exc:\n   223\u2192                # Warn for errors on read-only filesystems.\n   224\u2192                logging.warning(\"Could not remove picklecache file %s: %s\",\n   225\u2192                                cache_filename, exc)\n   226\u2192\n   227\u2192        time_before = time.time()\n   228\u2192        result = function(toplevel_filename, *args, **kw)\n   229\u2192        time_after = time.time()\n   230\u2192\n   231\u2192        # Overwrite the cache file if the time it takes to compute it\n   232\u2192        # justifies it.\n   233\u2192        if time_after - time_before > time_threshold:\n   234\u2192            try:\n   235\u2192                with open(cache_filename, 'wb') as file:\n   236\u2192                    pickle.dump(result, file)\n   237\u2192            except Exception as exc:\n   238\u2192                logging.warning(\"Could not write to picklecache file %s: %s\",\n   239\u2192                                cache_filename, exc)\n   240\u2192\n   241\u2192        return result\n   242\u2192    return wrapped\n   243\u2192\n   244\u2192\n   245\u2192def delete_cache_function(cache_getter, function):\n   246\u2192    \"\"\"A wrapper that removes the cached filename.\n   247\u2192\n   248\u2192    Args:\n   249\u2192      cache_getter: A function of one argument, the top-level filename, which\n   250\u2192        will return the name of the corresponding cache file.\n   251\u2192      function: A function object to decorate for caching.\n   252\u2192    Returns:\n   253\u2192      A decorated function which will delete the cached filename, if it exists.\n   254\u2192    \"\"\"\n   255\u2192    @functools.wraps(function)\n   256\u2192    def wrapped(toplevel_filename, *args, **kw):\n   257\u2192        # Delete the cache.\n   258\u2192        cache_filename = cache_getter(toplevel_filename)\n   259\u2192        if path.exists(cache_filename):\n   260\u2192            os.remove(cache_filename)\n   261\u2192\n   262\u2192        # Invoke the original function.\n   263\u2192        return function(toplevel_filename, *args, **kw)\n   264\u2192    return wrapped\n   265\u2192\n   266\u2192\n   267\u2192def _uncached_load_file(filename, *args, **kw):\n   268\u2192    \"\"\"Delegate to _load. Note: This gets conditionally advised by caching below.\"\"\"\n   269\u2192    return _load([(filename, True)], *args, **kw)\n   270\u2192\n   271\u2192\n   272\u2192def needs_refresh(options_map):\n   273\u2192    \"\"\"Predicate that returns true if at least one of the input files may have changed.\n   274\u2192\n   275\u2192    Args:\n   276\u2192      options_map: An options dict as per the parser.\n   277\u2192      mtime: A modified time, to check if it covers the include files in the options_map.\n   278\u2192    Returns:\n   279\u2192      A boolean, true if the input is obsoleted by changes in the input files.\n   280\u2192    \"\"\"\n   281\u2192    if options_map is None:\n   282\u2192        return True\n   283\u2192    input_hash = compute_input_hash(options_map['include'])\n   284\u2192    return 'input_hash' not in options_map or input_hash != options_map['input_hash']\n   285\u2192\n   286\u2192\n   287\u2192def compute_input_hash(filenames):\n   288\u2192    \"\"\"Compute a hash of the input data.\n   289\u2192\n   290\u2192    Args:\n   291\u2192      filenames: A list of input files. Order is not relevant.\n   292\u2192    \"\"\"\n   293\u2192    md5 = hashlib.md5()\n   294\u2192    for filename in sorted(filenames):\n   295\u2192        md5.update(filename.encode('utf8'))\n   296\u2192        if not path.exists(filename):\n   297\u2192            continue\n   298\u2192        stat = os.stat(filename)\n   299\u2192        md5.update(struct.pack('dd', stat.st_mtime_ns, stat.st_size))\n   300\u2192    return md5.hexdigest()\n   301\u2192\n   302\u2192\n   303\u2192def load_string(string, log_timings=None, log_errors=None, extra_validations=None,\n   304\u2192                dedent=False, encoding=None):\n   305\u2192\n   306\u2192    \"\"\"Open a Beancount input string, parse it, run transformations and validate.\n   307\u2192\n   308\u2192    Args:\n   309\u2192      string: A Beancount input string.\n   310\u2192      log_timings: A file object or function to write timings to,\n   311\u2192        or None, if it should remain quiet.\n   312\u2192      log_errors: A file object or function to write errors to,\n   313\u2192        or None, if it should remain quiet.\n   314\u2192      extra_validations: A list of extra validation functions to run after loading\n   315\u2192        this list of entries.\n   316\u2192      dedent: A boolean, if set, remove the whitespace in front of the lines.\n   317\u2192      encoding: A string or None, the encoding to decode the input string with.\n   318\u2192    Returns:\n   319\u2192      A triple of (entries, errors, option_map) where \"entries\" is a date-sorted\n   320\u2192      list of entries from the string, \"errors\" a list of error objects\n   321\u2192      generated while parsing and validating the string, and \"options_map\", a\n   322\u2192      dict of the options parsed from the string.\n   323\u2192    \"\"\"\n   324\u2192    if dedent:\n   325\u2192        string = textwrap.dedent(string)\n   326\u2192    entries, errors, options_map = _load([(string, False)], log_timings,\n   327\u2192                                         extra_validations, encoding)\n   328\u2192    _log_errors(errors, log_errors)\n   329\u2192    return entries, errors, options_map\n   330\u2192\n   331\u2192\n   332\u2192def _parse_recursive(sources, log_timings, encoding=None):\n   333\u2192    \"\"\"Parse Beancount input, run its transformations and validate it.\n   334\u2192\n   335\u2192    Recursively parse a list of files or strings and their include files and\n   336\u2192    return an aggregate of parsed directives, errors, and the top-level\n   337\u2192    options-map. If the same file is being parsed twice, ignore it and issue an\n   338\u2192    error.\n   339\u2192\n   340\u2192    Args:\n   341\u2192      sources: A list of (filename-or-string, is-filename) where the first\n   342\u2192        element is a string, with either a filename or a string to be parsed directly,\n   343\u2192        and the second argument is a boolean that is true if the first is a filename.\n   344\u2192        You may provide a list of such arguments to be parsed. Filenames must be absolute\n   345\u2192        paths.\n   346\u2192      log_timings: A function to write timings to, or None, if it should remain quiet.\n   347\u2192      encoding: A string or None, the encoding to decode the input filename with.\n   348\u2192    Returns:\n   349\u2192      A tuple of (entries, parse_errors, options_map).\n   350\u2192    \"\"\"\n   351\u2192    assert isinstance(sources, list) and all(isinstance(el, tuple) for el in sources)\n   352\u2192\n   353\u2192    # Current parse state.\n   354\u2192    entries, parse_errors = [], []\n   355\u2192    options_map = None\n   356\u2192    other_options_