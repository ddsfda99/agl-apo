                        "content": "     1\u2192\"\"\"Realization of specific lists of account postings into reports.\n     2\u2192\n     3\u2192This code converts a list of entries into a tree of RealAccount nodes (which\n     4\u2192stands for \"realized accounts\"). The RealAccount objects contain lists of\n     5\u2192Posting instances instead of Transactions, or other entry types that are\n     6\u2192attached to an account, such as a Balance or Note entry.\n     7\u2192\n     8\u2192The interface of RealAccount corresponds to that of a regular Python dict, where\n     9\u2192the keys are the names of the individual components of an account's name, and\n    10\u2192the values are always other RealAccount instances. If you want to get an account\n    11\u2192by long account name, there are helper functions in this module for this purpose\n    12\u2192(see realization.get(), for instance). RealAccount instances also contain the\n    13\u2192final balance of that account, resulting from its list of postings.\n    14\u2192\n    15\u2192You should not build RealAccount trees yourself; instead, you should filter the\n    16\u2192list of desired directives to display and call the realize() function with them.\n    17\u2192\"\"\"\n    18\u2192__copyright__ = \"Copyright (C) 2013-2016  Martin Blais\"\n    19\u2192__license__ = \"GNU GPLv2\"\n    20\u2192\n    21\u2192import collections\n    22\u2192import copy\n    23\u2192import functools\n    24\u2192import io\n    25\u2192import operator\n    26\u2192\n    27\u2192from beancount.core.data import Transaction\n    28\u2192from beancount.core.data import Posting\n    29\u2192from beancount.core.data import TxnPosting\n    30\u2192from beancount.core.data import Balance\n    31\u2192from beancount.core.data import Open\n    32\u2192from beancount.core.data import Close\n    33\u2192from beancount.core.data import Pad\n    34\u2192from beancount.core.data import Note\n    35\u2192from beancount.core.data import Document\n    36\u2192from beancount.core.data import Custom\n    37\u2192from beancount.core import inventory\n    38\u2192from beancount.core import amount\n    39\u2192from beancount.core import data\n    40\u2192from beancount.core import account\n    41\u2192from beancount.core import convert\n    42\u2192\n    43\u2192\n    44\u2192class RealAccount(dict):\n    45\u2192    \"\"\"A realized account, inserted in a tree, that contains the list of realized entries.\n    46\u2192\n    47\u2192    Attributes:\n    48\u2192      account: A string, the full name of the corresponding account.\n    49\u2192      postings: A list of postings associated with this accounting (does not\n    50\u2192        include the postings of children accounts).\n    51\u2192      balance: The final balance of the list of postings associated with this account.\n    52\u2192    \"\"\"\n    53\u2192    __slots__ = ('account', 'txn_postings', 'balance')\n    54\u2192\n    55\u2192    def __init__(self, account_name, *args, **kwargs):\n    56\u2192        \"\"\"Create a RealAccount instance.\n    57\u2192\n    58\u2192        Args:\n    59\u2192          account_name: a string, the name of the account. Maybe not be None.\n    60\u2192        \"\"\"\n    61\u2192        super().__init__(*args, **kwargs)\n    62\u2192        assert isinstance(account_name, str)\n    63\u2192        self.account = account_name\n    64\u2192        self.txn_postings = []\n    65\u2192        self.balance = inventory.Inventory()\n    66\u2192\n    67\u2192    def __setitem__(self, key, value):\n    68\u2192        \"\"\"Prevent the setting of non-string or non-empty keys on this dict.\n    69\u2192\n    70\u2192        Args:\n    71\u2192          key: The dictionary key. Must be a string.\n    72\u2192          value: The value, must be a RealAccount instance.\n    73\u2192        Raises:\n    74\u2192          KeyError: If the key is not a string, or is invalid.\n    75\u2192          ValueError: If the value is not a RealAccount instance.\n    76\u2192        \"\"\"\n    77\u2192        if not isinstance(key, str) or not key:\n    78\u2192            raise KeyError(\"Invalid RealAccount key: '{}'\".format(key))\n    79\u2192        if not isinstance(value, RealAccount):\n    80\u2192            raise ValueError(\"Invalid RealAccount value: '{}'\".format(value))\n    81\u2192        if not value.account.endswith(key):\n    82\u2192            raise ValueError(\"RealAccount name '{}' inconsistent with key: '{}'\".format(\n    83\u2192                value.account, key))\n    84\u2192        return super().__setitem__(key, value)\n    85\u2192\n    86\u2192    def copy(self):\n    87\u2192        \"\"\"Override dict.copy() to clone a RealAccount.\n    88\u2192\n    89\u2192        This is only necessary to correctly implement the copy method.\n    90\u2192        Otherwise, calling .copy() on a RealAccount instance invokes the base\n    91\u2192        class' method, which return just a dict.\n    92\u2192\n    93\u2192        Returns:\n    94\u2192          A cloned instance of RealAccount, with all members shallow-copied.\n    95\u2192        \"\"\"\n    96\u2192        return copy.copy(self)\n    97\u2192\n    98\u2192    def __eq__(self, other):\n    99\u2192        \"\"\"Equality predicate. All attributes are compared.\n   100\u2192\n   101\u2192        Args:\n   102\u2192          other: Another instance of RealAccount.\n   103\u2192        Returns:\n   104\u2192          A boolean, True if the two real accounts are equal.\n   105\u2192        \"\"\"\n   106\u2192        return (dict.__eq__(self, other) and\n   107\u2192                self.account == other.account and\n   108\u2192                self.balance == other.balance and\n   109\u2192                self.txn_postings == other.txn_postings)\n   110\u2192\n   111\u2192    def __ne__(self, other):\n   112\u2192        \"\"\"Not-equality predicate. See __eq__.\n   113\u2192\n   114\u2192        Args:\n   115\u2192          other: Another instance of RealAccount.\n   116\u2192        Returns:\n   117\u2192          A boolean, True if the two real accounts are not equal.\n   118\u2192        \"\"\"\n   119\u2192        return not self.__eq__(other)\n   120\u2192\n   121\u2192\n   122\u2192def iter_children(real_account, leaf_only=False):\n   123\u2192    \"\"\"Iterate this account node and all its children, depth-first.\n   124\u2192\n   125\u2192    Args:\n   126\u2192      real_account: An instance of RealAccount.\n   127\u2192      leaf_only: A boolean flag, true if we should yield only leaves.\n   128\u2192    Yields:\n   129\u2192      Instances of RealAccount, beginning with this account. The order is\n   130\u2192      undetermined.\n   131\u2192    \"\"\"\n   132\u2192    if leaf_only:\n   133\u2192        if len(real_account) == 0:\n   134\u2192            yield real_account\n   135\u2192        else:\n   136\u2192            for key, real_child in sorted(real_account.items()):\n   137\u2192                for real_subchild in iter_children(real_child, leaf_only):\n   138\u2192                    yield real_subchild\n   139\u2192    else:\n   140\u2192        yield real_account\n   141\u2192        for key, real_child in sorted(real_account.items()):\n   142\u2192            for real_subchild in iter_children(real_child):\n   143\u2192                yield real_subchild\n   144\u2192\n   145\u2192\n   146\u2192def get(real_account, account_name, default=None):\n   147\u2192    \"\"\"Fetch the subaccount name from the real_account node.\n   148\u2192\n   149\u2192    Args:\n   150\u2192      real_account: An instance of RealAccount, the parent node to look for\n   151\u2192        children of.\n   152\u2192      account_name: A string, the name of a possibly indirect child leaf\n   153\u2192        found down the tree of 'real_account' nodes.\n   154\u2192      default: The default value that should be returned if the child\n   155\u2192        subaccount is not found.\n   156\u2192    Returns:\n   157\u2192      A RealAccount instance for the child, or the default value, if the child\n   158\u2192      is not found.\n   159\u2192    \"\"\"\n   160\u2192    if not isinstance(account_name, str):\n   161\u2192        raise ValueError\n   162\u2192    components = account.split(account_name)\n   163\u2192    for component in components:\n   164\u2192        real_child = real_account.get(component, default)\n   165\u2192        if real_child is default:\n   166\u2192            return default\n   167\u2192        real_account = real_child\n   168\u2192    return real_account\n   169\u2192\n   170\u2192\n   171\u2192def get_or_create(real_account, account_name):\n   172\u2192    \"\"\"Fetch the subaccount name from the real_account node.\n   173\u2192\n   174\u2192    Args:\n   175\u2192      real_account: An instance of RealAccount, the parent node to look for\n   176\u2192        children of, or create under.\n   177\u2192      account_name: A string, the name of the direct or indirect child leaf\n   178\u2192        to get or create.\n   179\u2192    Returns:\n   180\u2192      A RealAccount instance for the child, or the default value, if the child\n   181\u2192      is not found.\n   182\u2192    \"\"\"\n   183\u2192    if not isinstance(account_name, str):\n   184\u2192        raise ValueError\n   185\u2192    components = account.split(account_name)\n   186\u2192    path = []\n   187\u2192    for component in components:\n   188\u2192        path.append(component)\n   189\u2192        real_child = real_account.get(component, None)\n   190\u2192        if real_child is None:\n   191\u2192            real_child = RealAccount(account.join(*path))\n   192\u2192            real_account[component] = real_child\n   193\u2192        real_account = real_child\n   194\u2192    return real_account\n   195\u2192\n   196\u2192\n   197\u2192def contains(real_account, account_name):\n   198\u2192    \"\"\"True if the given account node contains the subaccount name.\n   199\u2192\n   200\u2192    Args:\n   201\u2192      account_name: A string, the name of a direct or indirect subaccount of\n   202\u2192        this node.\n   203\u2192    Returns:\n   204\u2192      A boolean, true the name is a child of this node.\n   205\u2192    \"\"\"\n   206\u2192    return get(real_account, account_name) is not None\n   207\u2192\n   208\u2192\n   209\u2192# TODO(blais): Reconcile this with balance_by_account() {2196104406ab}.\n   210\u2192def realize(entries, min_accounts=None, compute_balance=True):\n   211\u2192    r\"\"\"Group entries by account, into a \"tree\" of realized accounts. RealAccount's\n   212\u2192    are essentially containers for lists of postings and the final balance of\n   213\u2192    each account, and may be non-leaf accounts (used strictly for organizing\n   214\u2192    accounts into a hierarchy). This is then used to issue reports.\n   215\u2192\n   216\u2192    The lists of postings in each account my be any of the entry types, except\n   217\u2192    for Transaction, whereby Transaction entries are replaced by the specific\n   218\u2192    Posting legs that belong to the account. Here's a simple diagram that\n   219\u2192    summarizes this seemingly complex, but rather simple data structure:\n   220\u2192\n   221\u2192       +-------------+ postings  +------+\n   222\u2192       | RealAccount |---------->| Open |\n   223\u2192       +-------------+           +------+\n   224\u2192                                     |\n   225\u2192                                     v\n   226\u2192                              +------------+     +-------------+\n   227\u2192                              | TxnPosting |---->| Transaction |\n   228\u2192                              +------------+     +-------------+\n   229\u2192                                     |      \\                 \\\\\\\n   230\u2192                                     v       `\\.__          +---------+\n   231\u2192                                  +-----+         `-------->| Posting |\n   232\u2192                                  | Pad |                   +---------+\n   233\u2192                                  +-----+\n   234\u2192                                     |\n   235\u2192                                     v\n   236\u2192                                +---------+\n   237\u2192                                | Balance |\n   238\u2192                                +---------+\n   239\u2192                                     |\n   240\u2192                                     v\n   241\u2192                                 +-------+\n   242\u2192                                 | Close |\n   243\u2192                                 +-------+\n   244\u2192                                     |\n   245\u2192                                     .\n   246\u2192\n   247\u2192    Args:\n   248\u2192      entries: A list of directives.\n   249\u2192      min_accounts: A list of strings, account names to ensure we create,\n   250\u2192        regardless of whether there are postings on those accounts or not.\n   251\u2192        This can be used to ensure the root accounts all exist.\n   252\u2192      compute_balance: A boolean, true if we should compute the final\n   253\u2192        balance on the realization.\n   254\u2192    Returns:\n   255\u2192      The root RealAccount instance.\n   256\u2192    \"\"\"\n   257\u2192    # Create lists of the entries by account.\n   258\u2192    txn_postings_map = postings_by_account(entries)\n   259\u2192\n   260\u2192    # Create a RealAccount tree and compute the balance for each.\n   261\u2192    real_root = RealAccount('')\n   262\u2192    for account_name, txn_postings in txn_postings_map.items():\n   263\u2192        real_account = get_or_create(real_root, account_name)\n   264\u2192        real_account.txn_postings = txn_postings\n   265\u2192        if compute_balance:\n   266\u2192            real_account.balance = compute_postings_balance(txn_postings)\n   267\u2192\n   268\u2192    # Ensure a minimum set of accounts that should exist. This is typically\n   269\u2192    # called with an instance of AccountTypes to make sure that those exist.\n   270\u2192    if min_accounts:\n   271\u2192        for account_name in min_accounts:\n   272\u2192            get_or_create(real_root, account_name)\n   273\u2192\n   274\u2192    return real_root\n   275\u2192\n   276\u2192\n   277\u2192def postings_by_account(entries):\n   278\u2192    \"\"\"Create lists of postings and balances by account.\n   279\u2192\n   280\u2192    This routine aggregates postings and entries grouping them by account name.\n   281\u2192    The resulting lists contain postings in-lieu of Transaction directives, but\n   282\u2192    the other directives are stored as entries. This yields a list of postings\n   283\u2192    or other entries by account. All references to accounts are taken into\n   284\u2192    account.\n   285\u2192\n   286\u2192    Args:\n   287\u2192      entries: A list of directives.\n   288\u2192    Returns:\n   289\u2192       A mapping of account name to list of TxnPosting instances or\n   290\u2192       non-Transaction directives, sorted in the same order as the entries.\n   291\u2192    \"\"\"\n   292\u2192    txn_postings_map = collections.defaultdict(list)\n   293\u2192    for entry in entries:\n   294\u2192\n   295\u2192        if isinstance(entry, Transaction):\n   296\u2192            # Insert an entry for each of the postings.\n   297\u2192            for posting in entry.postings:\n   298\u2192                txn_postings_map[posting.account].append(\n   299\u2192                    TxnPosting(entry, posting))\n   300\u2192\n   301\u2192        elif isinstance(entry, (Open, Close, Balance, Note, Document)):\n   302\u2192            # Append some other entries in the realized list.\n   303\u2192            txn_postings_map[entry.account].append(entry)\n   304\u2192\n   305\u2192        elif isinstance(entry, Pad):\n   306\u2192            # Insert the pad entry in both realized accounts.\n   307\u2192            txn_postings_map[entry.account].append(entry)\n   308\u2192            txn_postings_map[entry.source_account].append(entry)\n   309\u2192\n   310\u2192        elif isinstance(entry, Custom):\n   311\u2192            # Insert custom entry for each account in its values.\n   312\u2192            for custom_value in entry.values:\n   313\u2192                if custom_value.dtype == account.TYPE:\n   314\u2192                    txn_postings_map[custom_value.value].append(entry)\n   315\u2192\n   316\u2192    return txn_postings_map\n   317\u2192\n   318\u2192\n   319\u2192# TODO(blais): Invert this in v3, so it's isomorphic to functools.filter().\n   320\u2192def filter(real_account, predicate):\n   321\u2192    \"\"\"Filter a RealAccount tree of nodes by the predicate.\n   322\u2192\n   323\u2192    This function visits the tree and applies the predicate on each node. It\n   324\u2192    returns a partial clone of RealAccount whereby on each node\n   325\u2192    - either the predicate is true, or\n   326\u2192    - for at least one child of the node the predicate is true.\n   327\u2192    All the leaves have the predicate be true.\n   328\u2192\n   329\u2192    Args:\n   330\u2192      real_account: An instance of RealAccount.\n   331\u2192      predicate: A callable/function which accepts a RealAccount and returns\n   332\u2192        a boolean. If the function returns True, the node is kept.\n   333\u2192    Returns:\n   334\u2192      A shallow clone of RealAccount is always returned.\n   335\u2192    \"\"\"\n   336\u2192    assert isinstance(real_account, RealAccount)\n   337\u2192\n   338\u2192    real_copy = RealAccount(real_account.account)\n   339\u2192    real_copy.balance = real_account.balance\n   340\u2192    real_copy.txn_postings = real_account.txn_postings\n   341\u2192\n   342\u2192    for child_name, real_child in real_account.items():\n   343\u2192        real_child_copy = filter(real_child, predicate)\n   344\u2192        if real_child_copy is not None:\n   345\u2192            real_copy[child_name] = real_child_copy\n   346\u2192\n   347\u2192    if len(real_copy) > 0 or predicate(real_account):\n   348\u2192        return real_copy\n   349\u2192\n   350\u2192\n   351\u2192def get_postings(real_account):\n   352\u2192    \"\"\"Return a sorted list a RealAccount's postings and children.\n   353\u2192\n   354\u2192    Args:\n   355\u2192      real_account: An instance of RealAccount.\n   356\u2192    Returns:\n   357\u2192      A list of Posting or directories.\n   358\u2192    \"\"\"\n   359\u2192    # We accumulate all the postings at once here instead of incrementally\n   360\u2192    # because we need to return them sorted.\n   361\u2192    accumulator = []\n   362\u2192    for real_child in iter_children(real_account):\n   363\u2192        accumulator.extend(real_child.txn_postings)\n   364\u2192    accumulator.sort(key=data.posting_sortkey)\n   365\u2192    return accumulator\n   366\u2192\n   367\u2192\n   368\u2192def iterate_with_balance(txn_postings):\n   369\u2192    \"\"\"Iterate over the entries, accumulating the running balance.\n   370\u2192\n   371\u2192    For each entry, this yields tuples of the form:\n   372\u2192\n   373\u2192      (entry, postings, change, balance)\n   374\u2192\n   375\u2192    entry: This is the directive for this line. If the list contained Posting\n   376\u2192      instance, this yields the corresponding Transaction object.\n   377\u2192    postings: A list of postings on this entry that affect the balance. Only the\n   378\u2192      postings encountered in the input list are included; only those affect the\n   379\u2192      balance. If 'entry' is not a Transaction directive, this should always be\n   380\u2192      an empty list. We preserve the original ordering of the postings as they\n   381\u2192      appear in the input list.\n   382\u2192    change: An Inventory object that reflects the total change due to the\n   383\u2192      postings from this entry that appear in the list. For example, if a\n   384\u2192      Transaction has three postings and two are in the input list, the sum of\n   385\u2192      the two postings will be in the 'change' Inventory object. However, the\n   386\u2192      position for the transactions' third posting--the one not included in the\n   387\u2192      input list--will not be in this inventory.\n   388\u2192    balance: An Inventory object that reflects the balance *after* adding the\n   389\u2192      'change' inventory due to this entry's transaction. The 'balance' yielded\n   390\u2192      is never None, even for entries that do not affect the balance, that is,\n   391\u2192      with an empty 'change' inventory. It's up to the caller, the one rendering\n   392\u2192      the entry, to decide whether to render this entry's change for a\n   393\u2192      particular entry type.\n   394\u2192\n   395\u2192    Note that if the input list of postings-or-entries is not in sorted date\n   396\u2192    order, two postings for the same entry appearing twice with a different date\n   397\u2192    in between will cause the entry appear twice. This is correct behavior, and\n   398\u2192    it is expected that in practice this should never happen anyway, because the\n   399\u2192    list of postings or entries should always be sorted. This method attempts to\n   400\u2192    detect this and raises an assertion if this is seen.\n   401\u2192\n   402\u2192    Args:\n   403\u2192      txn_postings: A list of postings or directive instances.\n   404\u2192        Postings affect the balance; other entries do not.\n   405\u2192    Yields:\n   406\u2192      Tuples of (entry, postings, change, balance) as described above.\n   407\u2192    \"\"\"\n   408\u2192\n   409\u2192    # The running balance.\n   410\u2192    running_balance = inventory.Inventory()\n   411\u2192\n   412\u2192    # Previous date.\n   413\u2192    prev_date = None\n   414\u2192\n   415\u2192    # A list of entries at the current date.\n   416\u2192    date_entries = []\n   417\u2192\n   418\u2192    first = lambda pair: pair[0]\n   419\u2192    for txn_posting in txn_postings:\n   420\u2192\n   421\u2192        # Get the posting if we are dealing with one.\n   422\u2192        assert not isinstance(txn_posting, Posting)\n   423\u2192        if isinstance(txn_posting, TxnPosting):\n   424\u2192            posting = txn_posting.posting\n   425\u2192            entry = txn_posting.txn\n   426\u2192        else:\n   427\u2192            posting = None\n   428\u2192            entry = txn_posting\n   429\u2192\n   430\u2192        if entry.date != prev_date:\n   431\u2192            assert prev_date is None or entry.date > prev_date, (\n   432\u2192                \"Invalid date order for postings: {} > {}\".format(prev_date, entry.date))\n   433\u2192            prev_date = entry.date\n   434\u2192\n   435\u2192            # Flush the dated entries.\n   436\u2192            for date_entry, date_postings in date_entries:\n   437\u2192                change = inventory.Inventory()\n   438\u2192                if date_postings:\n   439\u2192                    # Compute the change due to this transaction and update the\n   440\u2192                    # total balance at the same time.\n   441\u2192                    for date_posting in date_postings:\n   442\u2192                        change.add_position(date_posting)\n   443\u2192                        running_balance.add_position(date_posting)\n   444\u2192                yield date_entry, date_postings, change, running_balance\n   445\u2192\n   446\u2192            date_entries.clear()\n   447\u2192            assert not date_entries\n   448\u2192\n   449\u2192        if posting is not None:\n   450\u2192            # De-dup multiple postings on the same transaction entry by\n   451\u2192            # grouping their positions together.\n   452\u2192            index = index_key(date_entries, entry, first, operator.is_)\n   453\u2192            if index is None:\n   454\u2192                date_entries.append((entry, [posting]))\n   455\u2192            else:\n   456\u2192                # We are indeed de-duping!\n   457\u2192                postings = date_entries[index][1]\n   458\u2192                postings.append(posting)\n   459\u2192        else:\n   460\u2192            # This is a regular entry; nothing to add/remove.\n   461\u2192            date_entries.append((entry, []))\n   462\u2192\n   463\u2192    # Flush the final dated entries if any, same as above.\n   464\u2192    for date_entry, date_postings in date_entries:\n   465\u2192        change = inventory.Inventory()\n   466\u2192        if date_postings:\n   467\u2192            for date_posting in date_postings:\n   468\u2192                change.add_position(date_posting)\n   469\u2192                running_balance.add_position(date_posting)\n   470\u2192        yield date_entry, date_postings, change, running_balance\n   471\u2192    date_entries.clear()\n   472\u2192\n   473\u2192\n   474\u2192def compute_balance(real_account, leaf_only=False):\n   475\u2192    \"\"\"Compute the total balance of this account and all its subaccounts.\n   476\u2192\n   477\u2192    Args:\n   478\u2192      real_account: A RealAccount instance.\n   479\u2192      leaf_only: A boolean flag, true if we should yield only leaves.\n   480\u2192    Returns:\n   481\u2192      An Inventory.\n   482\u2192    \"\"\"\n   483\u2192    return functools.reduce(operator.add, [\n   484\u2192        ra.balance for ra in iter_children(real_account, leaf_only)])\n   485\u2192\n   486\u2192\n   487\u2192def find_last_active_posting(txn_postings):\n   488\u2192    \"\"\"Look at the end of the list of postings, and find the last\n   489\u2192    posting or entry that is not an automatically added directive.\n   490\u2192    Note that if the account is