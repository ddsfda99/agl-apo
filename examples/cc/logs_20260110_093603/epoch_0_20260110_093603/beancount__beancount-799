ect\n   116\u2192import textwrap\n   117\u2192import io\n   118\u2192import sys\n   119\u2192\n   120\u2192from beancount.parser import _parser\n   121\u2192from beancount.parser import grammar\n   122\u2192from beancount.parser import printer\n   123\u2192from beancount.parser import hashsrc\n   124\u2192from beancount.core import data\n   125\u2192from beancount.core.number import MISSING\n   126\u2192\n   127\u2192# pylint: disable=unused-import\n   128\u2192from beancount.parser.grammar import ParserError\n   129\u2192from beancount.parser.grammar import ParserSyntaxError\n   130\u2192from beancount.parser.grammar import DeprecatedError\n   131\u2192\n   132\u2192\n   133\u2192# When importing the module, always check that the compiled source matched the\n   134\u2192# installed source.\n   135\u2192hashsrc.check_parser_source_files(_parser)\n   136\u2192\n   137\u2192\n   138\u2192def is_posting_incomplete(posting):\n   139\u2192    \"\"\"Detect the presence of any elided amounts in a Posting.\n   140\u2192\n   141\u2192    If any of the possible amounts are missing, this returns True.\n   142\u2192\n   143\u2192    Args:\n   144\u2192      entries: A directive.\n   145\u2192    Returns:\n   146\u2192      A boolean, true if there are some missing portions of any postings found.\n   147\u2192    \"\"\"\n   148\u2192    units = posting.units\n   149\u2192    if (units is MISSING or\n   150\u2192        units.number is MISSING or\n   151\u2192        units.currency is MISSING):\n   152\u2192        return True\n   153\u2192    price = posting.price\n   154\u2192    if (price is MISSING or\n   155\u2192        price is not None and (price.number is MISSING or\n   156\u2192                               price.currency is MISSING)):\n   157\u2192        return True\n   158\u2192    cost = posting.cost\n   159\u2192    if cost is not None and (cost.number_per is MISSING or\n   160\u2192                             cost.number_total is MISSING or\n   161\u2192                             cost.currency is MISSING):\n   162\u2192        return True\n   163\u2192    return False\n   164\u2192\n   165\u2192\n   166\u2192def is_entry_incomplete(entry):\n   167\u2192    \"\"\"Detect the presence of elided amounts in Transactions.\n   168\u2192\n   169\u2192    Args:\n   170\u2192      entries: A directive.\n   171\u2192    Returns:\n   172\u2192      A boolean, true if there are some missing portions of any postings found.\n   173\u2192    \"\"\"\n   174\u2192    if isinstance(entry, data.Transaction):\n   175\u2192        if any(is_posting_incomplete(posting) for posting in entry.postings):\n   176\u2192            return True\n   177\u2192    return False\n   178\u2192\n   179\u2192\n   180\u2192def parse_file(file, report_filename=None, report_firstline=1,\n   181\u2192               encoding=None, debug=False, **kw):\n   182\u2192    \"\"\"Parse a beancount input file and return Ledger with the list of\n   183\u2192    transactions and tree of accounts.\n   184\u2192\n   185\u2192    Args:\n   186\u2192      file: file object or path to the file to be parsed.\n   187\u2192      kw: a dict of keywords to be applied to the C parser.\n   188\u2192    Returns:\n   189\u2192      A tuple of (\n   190\u2192        list of entries parsed in the file,\n   191\u2192        list of errors that were encountered during parsing, and\n   192\u2192        a dict of the option values that were parsed from the file.)\n   193\u2192    \"\"\"\n   194\u2192    if encoding is not None and codecs.lookup(encoding).name != 'utf-8':\n   195\u2192        raise ValueError('Only UTF-8 encoded files are supported.')\n   196\u2192    with contextlib.ExitStack() as ctx:\n   197\u2192        if file == '-':\n   198\u2192            file = sys.stdin.buffer\n   199\u2192        # It would be more appropriate here to check for io.RawIOBase but\n   200\u2192        # that does not work for io.BytesIO despite it implementing the\n   201\u2192        # readinto() method.\n   202\u2192        elif not isinstance(file, io.IOBase):\n   203\u2192            file = ctx.enter_context(open(file, 'rb'))\n   204\u2192        builder = grammar.Builder()\n   205\u2192        parser = _parser.Parser(builder, debug=debug)\n   206\u2192        parser.parse(file, filename=report_filename, lineno=report_firstline, **kw)\n   207\u2192    return builder.finalize()\n   208\u2192\n   209\u2192\n   210\u2192def parse_string(string, report_filename=None, dedent=False, **kw):\n   211\u2192    \"\"\"Parse a beancount input file and return Ledger with the list of\n   212\u2192    transactions and tree of accounts.\n   213\u2192\n   214\u2192    Args:\n   215\u2192      string: A string, the contents to be parsed instead of a file's.\n   216\u2192      report_filename: A string, the source filename from which this string\n   217\u2192        has been extracted, if any. This is stored in the metadata of the\n   218\u2192        parsed entries.\n   219\u2192      dedent: Whether to run textwrap.dedent() on the string before parsing.\n   220\u2192      **kw: See parse.c.\n   221\u2192    Return:\n   222\u2192      Same as the output of parse_file().\n   223\u2192    \"\"\"\n   224\u2192    if dedent:\n   225\u2192        string = textwrap.dedent(string)\n   226\u2192    if isinstance(string, str):\n   227\u2192        string = string.encode('utf8')\n   228\u2192    if report_filename is None:\n   229\u2192        report_filename = '<string>'\n   230\u2192    file = io.BytesIO(string)\n   231\u2192    return parse_file(file, report_filename=report_filename, **kw)\n   232\u2192\n   233\u2192\n   234\u2192def parse_doc(expect_errors=False, allow_incomplete=False):\n   235\u2192    \"\"\"Factory of decorators that parse the function's docstring as an argument.\n   236\u2192\n   237\u2192    Note that the decorators thus generated only run the parser on the tests,\n   238\u2192    not the loader, so is no validation, balance checks, nor plugins applied to\n   239\u2192    the parsed text.\n   240\u2192\n   241\u2192    Args:\n   242\u2192      expect_errors: A boolean or None, with the following semantics,\n   243\u2192        True: Expect errors and fail if there are none.\n   244\u2192        False: Expect no errors and fail if there are some.\n   245\u2192        None: Do nothing, no check.\n   246\u2192      allow_incomplete: A boolean, if true, allow incomplete input. Otherwise\n   247\u2192        barf if the input would require interpolation. The default value is set\n   248\u2192        not to allow it because we want to minimize the features tests depend on.\n   249\u2192    Returns:\n   250\u2192      A decorator for test functions.\n   251\u2192    \"\"\"\n   252\u2192    def decorator(fun):\n   253\u2192        \"\"\"A decorator that parses the function's docstring as an argument.\n   254\u2192\n   255\u2192        Args:\n   256\u2192          fun: the function object to be decorated.\n   257\u2192        Returns:\n   258\u2192          A decorated test function.\n   259\u2192        \"\"\"\n   260\u2192        filename = inspect.getfile(fun)\n   261\u2192        lines, lineno = inspect.getsourcelines(fun)\n   262\u2192\n   263\u2192        # Skip over decorator invocation and function definition. This\n   264\u2192        # is imperfect as it assumes that each consumes exactly one\n   265\u2192        # line, but this is by far the most common case, and this is\n   266\u2192        # mainly used in test, thus it is good enough.\n   267\u2192        lineno += 2\n   268\u2192\n   269\u2192        @functools.wraps(fun)\n   270\u2192        def wrapper(self):\n   271\u2192            assert fun.__doc__ is not None, (\n   272\u2192                \"You need to insert a docstring on {}\".format(fun.__name__))\n   273\u2192            entries, errors, options_map = parse_string(fun.__doc__,\n   274\u2192                                                        report_filename=filename,\n   275\u2192                                                        report_firstline=lineno,\n   276\u2192                                                        dedent=True)\n   277\u2192\n   278\u2192            if not allow_incomplete and any(is_entry_incomplete(entry)\n   279\u2192                                            for entry in entries):\n   280\u2192                self.fail(\"parse_doc() may not use interpolation.\")\n   281\u2192\n   282\u2192            if expect_errors is not None:\n   283\u2192                if expect_errors is False and errors:\n   284\u2192                    oss = io.StringIO()\n   285\u2192                    printer.print_errors(errors, file=oss)\n   286\u2192                    self.fail(\"Unexpected errors found:\\n{}\".format(oss.getvalue()))\n   287\u2192                elif expect_errors is True and not errors:\n   288\u2192                    self.fail(\"Expected errors, none found:\")\n   289\u2192\n   290\u2192            return fun(self, entries, errors, options_map)\n   291\u2192\n   292\u2192        return wrapper\n   293\u2192\n   294\u2192    return decorator\n   295\u2192\n   296\u2192\n   297\u2192def parse_many(string, level=0):\n   298\u2192    \"\"\"Parse a string with a snippet of Beancount input and replace vars from caller.\n   299\u2192\n   300\u2192    Args:\n   301\u2192      string: A string with some Beancount input.\n   302\u2192      level: The number of extra stacks to ignore.\n   303\u2192    Returns:\n   304\u2192      A list of entries.\n   305\u2192    Raises:\n   306\u2192      AssertionError: If there are any errors.\n   307\u2192    \"\"\"\n   308\u2192    # Get the locals in the stack for the callers and produce the final text.\n   309\u2192    frame = inspect.stack()[level+1]\n   310\u2192    varkwds = frame[0].f_locals\n   311\u2192    input_string = textwrap.dedent(string.format(**varkwds))\n   312\u2192\n   313\u2192    # Parse entries and check there are no errors.\n   314\u2192    entries, errors, __ = parse_string(input_string)\n   315\u2192    assert not errors\n   316\u2192\n   317\u2192    return entries\n   318\u2192\n   319\u2192\n   320\u2192def parse_one(string):\n   321\u2192    \"\"\"Parse a string with single Beancount directive and replace vars from caller.\n   322\u2192\n   323\u2192    Args:\n   324\u2192      string: A string with some Beancount input.\n   325\u2192      level: The number of extra stacks to ignore.\n   326\u2192    Returns:\n   327\u2192      A list of entries.\n   328\u2192    Raises:\n   329\u2192      AssertionError: If there are any errors.\n   330\u2192    \"\"\"\n   331\u2192    entries = parse_many(string, level=1)\n   332\u2192    assert len(entries) == 1\n   333\u2192    return entries[0]\n   334\u2192\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"
