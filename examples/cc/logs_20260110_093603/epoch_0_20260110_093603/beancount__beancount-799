2192    \"\"\"A factory of decorators that loads the docstring and calls the function with entries.\n   679\u2192\n   680\u2192    This is an incredibly convenient tool to write lots of tests. Write a\n   681\u2192    unittest using the standard TestCase class and put the input entries in the\n   682\u2192    function's docstring.\n   683\u2192\n   684\u2192    Args:\n   685\u2192      expect_errors: A boolean or None, with the following semantics,\n   686\u2192        True: Expect errors and fail if there are none.\n   687\u2192        False: Expect no errors and fail if there are some.\n   688\u2192        None: Do nothing, no check.\n   689\u2192    Returns:\n   690\u2192      A wrapped method that accepts a single 'self' argument.\n   691\u2192    \"\"\"\n   692\u2192    def decorator(fun):\n   693\u2192        \"\"\"A decorator that parses the function's docstring as an argument.\n   694\u2192\n   695\u2192        Args:\n   696\u2192          fun: A callable method, that accepts the three return arguments that\n   697\u2192              load() returns.\n   698\u2192        Returns:\n   699\u2192          A decorated test function.\n   700\u2192        \"\"\"\n   701\u2192        @functools.wraps(fun)\n   702\u2192        def wrapper(self):\n   703\u2192            entries, errors, options_map = load_string(fun.__doc__, dedent=True)\n   704\u2192\n   705\u2192            if expect_errors is not None:\n   706\u2192                if expect_errors is False and errors:\n   707\u2192                    oss = io.StringIO()\n   708\u2192                    printer.print_errors(errors, file=oss)\n   709\u2192                    self.fail(\"Unexpected errors found:\\n{}\".format(oss.getvalue()))\n   710\u2192                elif expect_errors is True and not errors:\n   711\u2192                    self.fail(\"Expected errors, none found:\")\n   712\u2192\n   713\u2192            # Note: Even if we expected no errors, we call this function with an\n   714\u2192         