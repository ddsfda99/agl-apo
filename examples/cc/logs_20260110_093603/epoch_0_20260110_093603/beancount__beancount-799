                        "content": "     1\u2192\"\"\"Automatic padding of gaps between entries.\n     2\u2192\"\"\"\n     3\u2192__copyright__ = \"Copyright (C) 2013-2016  Martin Blais\"\n     4\u2192__license__ = \"GNU GPLv2\"\n     5\u2192\n     6\u2192import collections\n     7\u2192\n     8\u2192from beancount.core.number import ONE\n     9\u2192from beancount.core.number import ZERO\n    10\u2192from beancount.core.data import Transaction\n    11\u2192from beancount.core.data import Balance\n    12\u2192from beancount.core import amount\n    13\u2192from beancount.core import account\n    14\u2192from beancount.core import realization\n    15\u2192from beancount.core import getters\n    16\u2192\n    17\u2192__plugins__ = ('check',)\n    18\u2192\n    19\u2192\n    20\u2192BalanceError = collections.namedtuple('BalanceError', 'source message entry')\n    21\u2192\n    22\u2192\n    23\u2192def get_balance_tolerance(balance_entry, options_map):\n    24\u2192    \"\"\"Get the tolerance amount for a single entry.\n    25\u2192\n    26\u2192    Args:\n    27\u2192      balance_entry: An instance of data.Balance\n    28\u2192      options_map: An options dict, as per the parser.\n    29\u2192    Returns:\n    30\u2192      A Decimal, the amount of tolerance implied by the directive.\n    31\u2192    \"\"\"\n    32\u2192    if balance_entry.tolerance is not None:\n    33\u2192        # Use the balance-specific tolerance override if it is provided.\n    34\u2192        tolerance = balance_entry.tolerance\n    35\u2192\n    36\u2192    else:\n    37\u2192        expo = balance_entry.amount.number.as_tuple().exponent\n    38\u2192        if expo < 0:\n    39\u2192            # Be generous and always allow twice the multiplier on Balance and\n    40\u2192            # Pad because the user creates these and the rounding of those\n    41\u2192            # balances may often be further off than those used within a single\n    42\u2192            # transaction.\n    43\u2192            tolerance = options_map[\"inferred_tolerance_multiplier\"] * 2\n    44\u2192            tolerance = ONE.scaleb(expo) * tolerance\n    45\u2192        else:\n    46\u2192            tolerance = ZERO\n    47\u2192\n    48\u2192    return tolerance\n    49\u2192\n    50\u2192\n    51\u2192def check(entries, options_map):\n    52\u2192    \"\"\"Process the balance assertion directives.\n    53\u2192\n    54\u2192    For each Balance directive, check that their expected balance corresponds to\n    55\u2192    the actual balance computed at that time and replace failing ones by new\n    56\u2192    ones with a flag that indicates failure.\n    57\u2192\n    58\u2192    Args:\n    59\u2192      entries: A list of directives.\n    60\u2192      options_map: A dict of options, parsed from the input file.\n    61\u2192    Returns:\n    62\u2192      A pair of a list of directives and a list of balance check errors.\n    63\u2192    \"\"\"\n    64\u2192    new_entries = []\n    65\u2192    check_errors = []\n    66\u2192\n    67\u2192    # This is similar to realization, but performed in a different order, and\n    68\u2192    # where we only accumulate inventories for accounts that have balance\n    69\u2192    # assertions in them (this saves on time). Here we process the entries one\n    70\u2192    # by one along with the balance checks. We use a temporary realization in\n    71\u2192    # order to hold the incremental tree of balances, so that we can easily get\n    72\u2192    # the amounts of an account's subaccounts for making checks on parent\n    73\u2192    # accounts.\n    74\u2192    real_root = realization.RealAccount('')\n    75\u2192\n    76\u2192    # Figure out the set of accounts for which we need to compute a running\n    77\u2192    # inventory balance.\n    78\u2192    asserted_accounts = {entry.account\n    79\u2192                         for entry in entries\n    80\u2192                         if isinstance(entry, Balance)}\n    81\u219