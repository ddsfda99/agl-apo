→    \"\"\"\n    92→    filename = path.expandvars(path.expanduser(filename))\n    93→    if not path.isabs(filename):\n    94→        filename = path.normpath(path.join(os.getcwd(), filename))\n    95→\n    96→    if encryption.is_encrypted_file(filename):\n    97→        # Note: Caching is not supported for encrypted files.\n    98→        entries, errors, options_map = load_encrypted_file(\n    99→            filename,\n   100→            log_timings, log_errors,\n   101→            extra_validations, False, encoding)\n   102→    else:\n   103→        entries, errors, options_map = _load_file(\n   104→            filename, log_timings,\n   105→            extra_validations, encoding)\n   106→        _log_errors(errors, log_errors)\n   107→    return entries, errors, options_map\n   108→\n   109→\n   110→def load_encrypted_file(filename, log_timings=None, log_errors=None, extra_validations=None,\n   111→                        dedent=False, encoding=None):\n   112→    \"\"\"Load an encrypted Beancount input file.\n   113→\n   114→    Args:\n   115→      filename: The name of an encrypted file to be parsed.\n   116→      log_timings: See load_string().\n   117→      log_errors: See load_string().\n   118→      extra_validations: See load_string().\n   119→      dedent: See load_string().\n   120→      encoding: See load_string().\n   121→    Returns:\n   122→      A triple of (entries, errors, option_map) where \"entries\" is a date-sorted\n   123→      list of entries from the file, \"errors\" a list of error objects generated\n   124→      while parsing and validating the file, and \"options_map\", a dict of the\n   125→      options parsed from the file.\n   126→    \"\"\"\n   127→    contents = encryption.read_encrypted_file(filename)\n   128→    return load_string(contents,\n   129→                       log_timings=log_timings,\n   130→                       log_errors=log_errors,\n   131→                       extra_validations=extra_validations,\n   132→                       encoding=encoding)\n   133→\n   134→\n   135→def _log_errors(errors, log_errors):\n   136→    \"\"\"Log errors, if 'log_errors' is set.\n   137→\n   138→    Args:\n   139→      log_errors: A file object or function to write errors to,\n   140→        or None, if it should remain quiet.\n   141→    \"\"\"\n   142→    if log_errors and errors:\n   143→        if hasattr(log_errors, 'write'):\n   144→            printer.print_errors(errors, file=log_errors)\n   145→        else:\n   146→            error_io = io.StringIO()\n   147→            printer.print_errors(errors, file=error_io)\n   148→            log_errors(error_io.getvalue())\n   149→\n   150→\n   151→def get_cache_filename(pattern: str, filename: str) -> str:\n   152→    \"\"\"Compute the cache filename from a given pattern and the top-level filename.\n   153→\n   154→    Args:\n   155→      pattern: A cache filename or pattern. If the pattern contains '{filename}' this\n   156→        will get replaced by the top-level filename. This may be absolute or relative.\n   157→      filename: The top-level filename.\n   158→    Returns:\n   159→      The resolved cache filename.\n   160→    \"\"\"\n   161→    abs_filename = path.abspath(filename)\n   162→    if path.isabs(pattern):\n   163→        abs_pattern = pattern\n   164→    else:\n   165→        abs_pattern = path.join(path.dirname(abs_filename), pattern)\n   166→    return abs_pattern.format(filename=path.basename(filename))\n   167→\n   168→\n   169→def pickle_cache_function(cache_getter, time_threshold, function):\n   170→    \"\"\"Decorate a loader function to make it loads its result from a pickle cache.\n   171→\n   172→    This considers the first argument as a top-level filename and assumes the\n   173→    function to be cached returns an (entries, errors, options_map) triple. We\n   174→    use the 'include' option value in order to check whether any of the included\n   175→    files has changed. It's essentially a special case for an on-disk memoizer.\n   176→    If any of the included files are more recent than the cache, the function is\n   177→    recomputed and the cache refreshed.\n   178→\n   179→    Args:\n   180→      cache_getter: A function of one argument, the top-level filename, which\n   181→        will return the name of the corresponding cache file.\n   182→      time_threshold: A float, the number of seconds below which we don't bother\n   183→        caching.\n   184→      function: A function object to decorate for caching.\n   185→    Returns:\n   186→      A decorated function which will pull its result from a cache file if\n   187→      it is available.\n   188→    \"\"\"\n   189→    @functools.wraps(function)\n   190→    def wrapped(toplevel_filename, *args, **kw):\n   191→        cache_filename = cache_getter(toplevel_filename)\n   192→\n   193→        # Read the cache if it exists in order to get the list of files whose\n   194→        # timestamps to check.\n   195→        exists = path.exists(cache_filename)\n   196→        if exists:\n   197→            with open(cache_filename, 'rb') as file:\n   198→                try:\n   199→                    result = pickle.load(file)\n   200→                except Exception as exc:\n   201→                    # Note: Not a big fan of doing this, but here we handle all\n   202→                    # possible exceptions because unpickling of an old or\n   203→                    # corrupted pickle file manifests as a variety of different\n   204→                    # exception types.\n   205→\n   206→                    # The cache file is corrupted; ignore it and recompute.\n   207→                    logging.error(\"Cache file is corrupted: %s; recomputing.\", exc)\n   208→                    result = None\n   209→\n   210→                else:\n   211→                    # Check that the latest timestamp has not been written after the\n   212→                    # cache file.\n   213→                    entries, errors, options_map = result\n   214→                    if not needs_refresh(options_map):\n   215→                        # All timestamps are legit; cache hit.\n   216→                        return result\n   217→\n   218→        # We failed; recompute the value.\n   219→        if exists:\n   220→            try:\n   221→                os.remove(cache_filename)\n   222→            except OSError as exc:\n   223→                # Warn for errors on read-only filesystems.\n   224→                logging.warning(\"Could not remove picklecache file %s: %s\",\n   225→                                cache_filename, exc)\n   226→\n   227→        time_before = time.time()\n   228→        result = function(toplevel_filename, *args, **kw)\n   229→        time_after = time.time()\n   230→\n   231→        # Overwrite the cache file if the time it takes to compute it\n   232→        # justifies it.\n   233→        if time_after - time_before > time_threshold:\n   234→            try:\n   235→                with open(cache_filename, 'wb') as file:\n   236→                    pickle.dump(result, file)\n   237→            except Exception as exc:\n   238→                logging.warning(\"Could not write to picklecache file %s: %s\",\n   239→                                cache_filename, exc)\n   240→\n   241→        return result\n   242→    return wrapped\n   243→\n   244→\n   245→def delete_cache_function(cache_getter, function):\n   246→    \"\"\"A wrapper that removes the cached filename.\n   247→\n   248→    Args:\n   249→      cache_getter: A function of one argument, the top-level filename, which\n   250→        will return the name of the corresponding cache file.\n   251→      function: A function object to decorate for caching.\n   252→    Returns:\n   253→      A decorated function which will delete the cached filename, if it exists.\n   254→    \"\"\"\n   255→    @functools.wraps(function)\n   256→    def wrapped(toplevel_filename, *args, **kw):\n   257→        # Delete the cache.\n   258→        cache_filename = cache_getter(toplevel_filename)\n   259→        if path.exists(cache_filename):\n   260→            os.remove(cache_filename)\n   261→\n   262→        # Invoke the original function.\n   263→        return function(toplevel_filename, *args, **kw)\n   264→    return wrapped\n   265→\n   266→\n   267→def _uncached_load_file(filename, *args, **kw):\n   268→    \"\"\"Delegate to _load. Note: This gets conditionally advised by caching below.\"\"\"\n   269→    return _load([(filename, True)], *args, **kw)\n   270→\n   271→\n   272→def needs_refresh(options_map):\n   273→    \"\"\"Predicate that returns true if at least one of the input files may have changed.\n   274→\n   275→    Args:\n   276→      options_map: An options dict as per the parser.\n   277→      mtime: A modified time, to check if it covers the include files in the options_map.\n   278→    Returns:\n   279→      A boolean, true if the input is obsoleted by changes in the input files.\n   280→    \"\"\"\n   281→    if options_map is None:\n   282→        return True\n   283→    input_hash = compute_input_hash(options_map['include'])\n   284→    return 'input_hash' not in options_map or input_hash != options_map['input_hash']\n   285→\n   286→\n   287→def compute_input_hash(filenames):\n   288→    \"\"\"Compute a hash of the input data.\n   289→\n   290→    Args:\n   291→      filenames: A list of input files. Order is not relevant.\n   292→    \"\"\"\n   293→    md5 = hashlib.md5()\n   294→    for filename in sorted(filenames):\n   295→        md5.update(filename.encode('utf8'))\n   296→        if not path.exists(filename):\n   297→            continue\n   298→        stat = os.stat(filename)\n   299→        md5.update(struct.pack('dd', stat.st_mtime_ns, stat.st_size))\n   300→    return md5.hexdigest()\n   301→\n   302→\n   303→def load_string(string, log_timings=None, log_errors=None, extra_validations=None,\n   304→                dedent=False, encoding=None):\n   305→\n   306→    \"\"\"Open a Beancount input string, parse it, run transformations and validate.\n   307→\n   308→    Args:\n   309→      string: A Beancount input string.\n   310→      log_timings: A file object or function to write timings to,\n   311→        or None, if it should remain quiet.\n   312→      log_errors: A file object or function to write errors to,\n   313→        or None, if it should remain quiet.\n   314→      extra_validations: A list of extra validation functions to run after loading\n   315→        this list of entries.\n   316→      dedent: A boolean, if set, remove the whitespace in front of the lines.\n   317→      encoding: A string or None, the encoding to decode the input string with.\n   318→    Returns:\n   319→      A triple of (entries, errors, option_map) where \"entries\" is a date-sorted\n   320→      list of entries from the string, \"errors\" a list of error objects\n   321→      generated while parsing and validating the string, and \"options_map\", a\n   322→      dict of the options parsed from the string.\n   323→    \"\"\"\n   324→    if dedent:\n   325→        string = textwrap.dedent(string)\n   326→    entries, errors, options_map = _load([(string, False)], log_timings,\n   327→                                         extra_validations, encoding)\n   328→    _log_errors(errors, log_errors)\n   329→    return entries, errors, options_map\n   330→\n   331→\n   332→def _parse_recursive(sources, log_timings, encoding=None):\n   333→    \"\"\"Parse Beancount input, run its transformations and validate it.\n   334→\n   335→    Recursively parse a list of files or strings and their include files and\n   336→    return an aggregate of parsed directives, errors, and the top-level\n   337→    options-map. If the same file is being parsed twice, ignore it and issue an\n   338→    error.\n   339→\n   340→    Args:\n   341→      sources: A list of (filename-or-string, is-filename) where the first\n   342→        element is a string, with either a filename or a string to be parsed directly,\n   343→        and the second argument is a boolean that is true if the first is a filename.\n   344→        You may provide a list of such arguments to be parsed. Filenames must be absolute\n   345→        paths.\n   346→      log_timings: A function to write timings to, or None, if it should remain quiet.\n   347→      encoding: A string or None, the encoding to decode the input filename with.\n   348→    Returns:\n   349→      A tuple of (entries, parse_errors, options_map).\n   350→    \"\"\"\n   351→    assert isinstance(sources, list) and all(isinstance(el, tuple) for el in sources)\n   352→\n   353→    # Current parse state.\n   354→    entries, parse_errors = [], []\n   355→    options_map = None\n   356→    other_options_map = []\n   357→\n   358→    # A stack of sources to be parsed.\n   359→    source_stack = list(sources)\n   360→\n   361→    # A list of absolute filenames that have been parsed in the past, used to\n   362→    # detect and avoid duplicates (cycles).\n   363→    filenames_seen = set()\n   364→\n   365→    with misc_utils.log_time('beancount.parser.parser', log_timings, indent=1):\n   366→        while source_stack:\n   367→            source, is_file = source_stack.pop(0)\n   368→            is_top_level = options_map is None\n   369→\n   370→            # If the file is encrypted, read it in and process it as a string.\n   371→            if is_file:\n   372→                cwd = path.dirname(source)\n   373→                source_filename = source\n   374→                if encryption.is_encrypted_file(source):\n   375→                    source = encryption.read_encrypted_file(source)\n   376→                    is_file = False\n   377→            else:\n   378→                # If we're parsing a string, the CWD is the current process\n   379→                # working directory.\n   380→                cwd = os.getcwd()\n   381→                source_filename = None\n   382→\n   383→            if is_file:\n   384→                # All filenames here must be absolute.\n   385→                assert path.isabs(source)\n   386→                filename = path.normpath(source)\n   387→\n   388→                # Check for file previously parsed... detect duplicates.\n   389→                if filename in filenames_seen:\n   390→                    parse_errors.append(\n   391→                        LoadError(data.new_metadata(\"<load>\", 0),\n   392→                                  'Duplicate filename parsed: \"{}\"'.format(filename),\n   393→                                  None))\n   394→                    continue\n   395→\n   396→                # Check for a file that does not exist.\n   397→                if not path.exists(filename):\n   398→                    parse_errors.append(\n   399→                        LoadError(data.new_metadata(\"<load>\", 0),\n   400→                                  'File \"{}\" does not exist'.format(filename), None))\n   401→                    continue\n   402→\n   403→                # Parse a file from disk directly.\n   404→                filenames_seen.add(filename)\n   405→                with misc_utils.log_time('beancount.parser.parser.parse_file',\n   406→                                         log_timings, indent=2):\n   407→                    (src_entries,\n   408→                     src_errors,\n   409→                     src_options_map) = parser.parse_file(filename, encoding=encoding)\n   410→\n   411→                cwd = path.dirname(filename)\n   412→            else:\n   413→                # Encode the contents if necessary.\n   414→                if encoding:\n   415→                    if isinstance(source, bytes):\n   416→                        source = source.decode(encoding)\n   417→                    source = source.encode('ascii', 'replace')\n   418→\n   419→                # Parse a string buffer from memory.\n   420→                with misc_utils.log_time('beancount.parser.parser.parse_string',\n   421→                                         log_timings, indent=2):\n   422→                    (src_entries,\n   423→                     src_errors,\n   424→                     src_options_map) = parser.parse_string(source, source_filename)\n   425→\n   426→            # Merge the entries resulting from the parsed file.\n   427→            entries.extend(src_entries)\n   428→            parse_errors.extend(src_errors)\n   429→\n   430→            # We need the options from the very top file only (the very\n   431→            # first file being processed). No merging of options should\n   432→            # occur.\n   433→            if is_top_level:\n   434→                options_map = src_options_map\n   435→            else:\n   436→                other_options_map.append(src_options_map)\n   437→\n   438→            # Add includes to the list of sources to process. chdir() for glob,\n   439→            # which uses it indirectly.\n   440→            include_expanded = []\n   441→            with file_utils.chdir(cwd):\n   442→                for include_filename in src_options_map['include']:\n   443→                    matched_filenames = glob.glob(include_filename, recursive=True)\n   444→                    if matched_filenames:\n   445→                        include_expanded.extend(matched_filenames)\n   446→                    else:\n   447→                        parse_errors.append(\n   448→                            LoadError(data.new_metadata(\"<load>\", 0),\n   449→                                      'File glob \"{}\" does not match any files'.format(\n   450→                                          include_filename), None))\n   451→            for include_filename in include_expanded:\n   452→                if not path.isabs(include_filename):\n   453→                    include_filename = path.join(cwd, include_filename)\n   454→                include_filename = path.normpath(include_filename)\n   455→\n   456→                # Add the include filenames to be processed later.\n   457→                source_stack.append((include_filename, True))\n   458→\n   459→    # Make sure we have at least a dict of valid options.\n   460→    if options_map is None:\n   461→        options_map = options.OPTIONS_DEFAULTS.copy()\n   462→\n   463→    # Save the set of parsed filenames in options_map.\n   464→    options_map['include'] = sorted(filenames_seen)\n   465→\n   466→    options_map = aggregate_options_map(options_map, other_options_map)\n   467→\n   468→    return entries, parse_errors, options_map\n   469→\n   470→\n   471→def aggregate_options_map(options_map, other_options_map):\n   472→    \"\"\"Aggregate some of the attributes of options map.\n   473→\n   474→    Args:\n   475→      options_map: The target map in which we want to aggregate attributes.\n   476→        Note: This value is mutated in-place.\n   477→      other_options_map: A list of other options maps, some of whose values\n   478→        we'd like to see aggregated.\n   479→    \"\"\"\n   480→    options_map = copy.copy(options_map)\n   481→\n   482→    currencies = list(options_map[\"operating_currency\"])\n   483→    for omap in other_options_map:\n   484→        currencies.extend(omap[\"operating_currency\"])\n   485→        options_map[\"dcontext\"].update_from(omap[\"dcontext\"])\n   486→    options_map[\"operating_currency\"] = list(misc_utils.uniquify(currencies))\n   487→\n   488→\n   489→    # Produce a 'pythonpath' value for transformers.\n   490→    pythonpath = set()\n   491→    for omap in itertools.chain((options_map,), other_options_map):\n   492→        if omap.get(\"insert_pythonpath\", False):\n   493→            pythonpath.add(path.dirname(omap[\"filename\"]))\n   494→    options_map[\"pythonpath\"] = sorted(pythonpath)\n   495→\n   496→    return options_map\n   497→\n   498→\n   499→def _load(sources, log_timings, extra_validations, encoding):\n   500→    \"\"\"Parse Beancount input, run its transformations and validate it.\n   501→\n   502→    (This is an internal method.)\n   503→    This routine does all that is necessary to obtain a list of entries ready\n   504→    for realization and working with them. This is the principal call for of the\n   505→    scripts that load a ledger. It returns a list of entries transformed and\n   506→    ready for reporting, a list of errors, and parser's options dict.\n   507→\n   508→    Args:\n   509→      sources: A list of (filename-or-string, is-filename) where the first\n   510→        element is a string, with either a filename or a string to be parsed directly,\n   511→        and the second argument is a boolean that is true if the first is a filename.\n   512→        You may provide a list of such arguments to be parsed. Filenames must be absolute\n   513→        paths.\n   514→      log_timings: A file object or function to write timings to,\n   515→        or None, if it should remain quiet.\n   516→      extra_validations: A list of extra validation functions to run after loading\n   517→        this list of entries.\n   518→      encoding: A string or None, the encoding to decode the input filename with.\n   519→    Returns:\n   520→      See load() or load_string().\n   521→    \"\"\"\n   522→    assert isinstance(sources, list) and all(isinstance(el, tuple) for el in sources)\n   523→\n   524→    if hasattr(log_timings, 'write'):\n   525→        log_timings = log_timings.write\n   526→\n   527→    # Parse all the files recursively. Ensure that the entries are sorted before\n   528→    # running any processes on them.\n   529→    with misc_utils.log_time('parse', log_timings, indent=1):\n   530→        entries, parse_errors, options_map = _parse_recursive(\n   531→            sources, log_timings, encoding)\n   532→        entries.sort(key=data.entry_sortkey)\n   533→\n   534→    # Run interpolation on incomplete entries.\n   535→    with misc_utils.log_time('booking', log_timings, indent=1):\n   536→        entries, balance_errors = booking.book(entries, options_map)\n   537→        parse_errors.extend(balance_errors)\n   538→\n   539→    # Transform the entries.\n   540→    with misc_utils.log_time('run_transformations', log_timings, indent=1):\n   541→\n   542→        # Insert the user PYTHONPATH entries before processing the plugins.\n   543→        saved_pythonpath = list(sys.path)\n   544→        try:\n   545→            if \"pythonpath\" in options_map:\n   546→                sys.path[0:0] = options_map[\"pythonpath\"]\n   547→            entries, errors = run_transformations(entries, parse_errors, options_map,\n   548→                                                  log_timings)\n   549→        finally:\n   550→            sys.path[:] = saved_pythonpath\n   551→\n   552→    # Validate the list of entries.\n   553→    with misc_utils.log_time('beancount.ops.validate', log_timings, indent=1):\n   554→        valid_errors = validation.validate(entries, options_map, log_timings,\n   555→                                           extra_validations)\n   556→        errors.extend(valid_errors)\n   557→\n   558→        # Note: We could go hardcore here and further verify that the entries\n   559→        # haven't been modified by user-provided validation routines, by\n   560→        # comparing hashes before and after. Not needed for now.\n   561→\n   562→    # Compute the input hash.\n   563→    options_map['input_hash'] = compute_input_hash(options_map['include'])\n   564→\n   565→    return entries, errors, options_map\n   566→\n   567→\n   568→def run_transformations(entries, parse_errors, options_map, log_timings):\n   569→    \"\"\"Run the various transformations on the entries.\n   570→\n   571→    This is where entries are being synthesized, checked, plugins are run, etc.\n   572→\n   573→    Args:\n   574→      entries: A list of directives as read from the parser.\n   575→      parse_errors: A list of errors so far.\n   576→      options_map: An options dict as read from the parser.\n   577→      log_timings: A function to write timing log entries to, or None, if it\n   578→        should be quiet.\n   579→    Returns:\n   580→      A list of modified entries, and a list of errors, also possibly modified.\n   581→    \"\"\"\n   582→    # A list of errors to extend (make a copy to avoid modifying the input).\n   583→    errors = list(parse_errors)\n   584→\n   585→    # Process the plugins.\n   586→    if options_map['plugin_processing_mode'] == 'raw':\n   587→        plugins_iter = options_map[\"plugin\"]\n   588→    elif options_map['plugin_processing_mode'] == 'default':\n   589→        plugins_iter = itertools.chain(PLUGINS_PRE,\n   590→                                       options_map[\"plugin\"],\n   591→                                       PLUGINS_AUTO,\n   592→                                       PLUGINS_POST)\n   593→    else:\n   594→        assert \"Invalid value for plugin_processing_mode: {}\".format(\n   595→            options_map['plugin_processing_mode'])\n   596→\n   597→    for plugin_name, plugin_config in plugins_iter:\n   598→\n   599→        # Issue a warning on a renamed module.\n   600→        renamed_name = RENAMED_MODULES.get(plugin_name, None)\n   601→        if renamed_name:\n   602→            warnings.warn(\"Deprecation notice: Module '{}' has been renamed to '{}'; \"\n   603→                          \"please adjust your plugin directive.\".format(\n   604→                              plugin_name, renamed_name))\n   605→            plugin_name = renamed_name\n   606→\n   607→        # Try to import the module.\n   608→        #\n   609→        # Note: We intercept import errors and continue but let other plugin\n   610→        # import time exceptions fail a run, by choice.\n   611→        try:\n   612→            module = importlib.import_module(plugin_name)\n   613→            if not hasattr(module, '__plugins__'):\n   614→                continue\n   615→        except ImportError:\n   616→            # Upon failure, just issue an error.\n   617→            formatted_traceback = traceback.format_exc().replace(\"\\n\", \"\\n  \")\n   618→            errors.append(LoadError(data.new_metadata(\"<load>\", 0),\n   619→                                    'Error importing \"{}\": {}'.format(\n   620→                                        plugin_name, formatted_traceback), None))\n   621→            continue\n   622→\n   623→        # Apply it.\n   624→        with misc_utils.log_time(plugin_name, log_timings, indent=2):\n   625→            # Run each transformer function in the plugin.\n   626→            for function_name in module.__plugins__:\n   627→                if isinstance(function_name, str):\n   628→                    # Support plugin functions provided by name.\n   629→                    callback = getattr(module, function_name)\n   630→                else:\n   631→                    # Support function types directly, not just names.\n   632→                    callback = function_name\n   633→\n   634→                # Provide arguments if config is provided.\n   635→                # TODO(blais): Make this consistent in v3, not conditional.\n   636→                args = () if plugin_config is None else (plugin_config,)\n   637→\n   638→                # Catch all exceptions raised in running the plugin, except exits.\n   639→                try:\n   640→                    entries, plugin_errors = callback(entries, options_map, *args)\n   641→                    errors.extend(plugin_errors)\n   642→                except Exception as exc:\n   643→                    # Allow the user to exit in a plugin.\n   644→                    if isinstance(exc, SystemExit):\n   645→                        raise\n   646→\n   647→                    # Upon failure, just issue an error.\n   648→                    formatted_traceback = traceback.format_exc().replace(\"\\n\", \"\\n  \")\n   649→                    errors.append(LoadError(data.new_metadata(\"<load>\", 0),\n   650→                                            'Error applying plugin \"{}\": {}'.format(\n   651→                                                plugin_name, formatted_traceback), None))\n   652→                    continue\n   653→\n   654→            # Ensure that the entries are sorted. Don't trust the plugins\n   655→            # themselves.\n   656→            entries.sort(key=data.entry_sortkey)\n   657→\n   658→    return entries, errors\n   659→\n   660→\n   661→def combine_plugins(*plugin_modules):\n   662→    \"\"\"Combine the plugins from the given plugin modules.\n   663→\n   664→    This is used to create plugins of plugins.\n   665→    Args:\n   666→      *plugins_modules: A sequence of module objects.\n   667→    Returns:\n   668→      A list that can be assigned to the new module's __plugins__ attribute.\n   669→    \"\"\"\n   670→    modules = []\n   671→    for module in plugin_modules:\n   672→        modules.extend([getattr(module, name)\n   673→                        for name in module.__plugins__])\n   674→    return modules\n   675→\n   676→\n   677→def load_doc(expect_errors=False):\n   678→    \"\"\"A factory of decorators that loads the docstring and calls the function with entries.\n   679→\n   680→    This is an incredibly convenient tool to write lots of tests. Write a\n   681→    unittest using the standard TestCase class and put the input entries in the\n   682→    function's docstring.\n   683→\n   684→    Args:\n   685→      expect_errors: A boolean or None, with the following semantics,\n   686→        True: Expect errors and fail if there are none.\n   687→        False: Expect no errors and fail if there are some.\n   688→        None: Do nothing, no check.\n   689→    Returns:\n   690→      A wrapped method that accepts a single 'self' argument.\n   691→    \"\"\"\n   692→    def decorator(fun):\n   693→        \"\"\"A decorator that parses the function's docstring as an argument.\n   694→\n   695→        Args:\n   696→          fun: A callable method, that accepts the three return arguments that\n   697→              load() returns.\n   698→        Returns:\n   699→          A decorated test function.\n   700→        \"\"\"\n   701→        @functools.wraps(fun)\n   702→        def wrapper(self):\n   703→            entries, errors, options_map = load_string(fun.__doc__, dedent=True)\n   704→\n   705→            if expect_errors is not None:\n   706→                if expect_errors is False and errors:\n   707→                    oss = io.StringIO()\n   708→                    printer.print_errors(errors, file=oss)\n   709→                    self.fail(\"Unexpected errors found:\\n{}\".format(oss.getvalue()))\n   710→                elif expect_errors is True and not errors:\n   711→                    self.fail(\"Expected errors, none found:\")\n   712→\n   713→            # Note: Even if we expected no errors, we call this function with an\n   714→            # empty 'errors' list. This is so that the interface does not change\n   715→            # based on the arguments to the decorator, which would be somewhat\n   716→            # ugly and which would require explanation.\n   717→            return fun(self, entries, errors, options_map)\n   718→\n   719→        wrapper.__input__ = wrapper.__doc__\n   720→        wrapper.__doc__ = None\n   721→        return wrapper\n   722→\n   723→    return decorator\n   724→\n   725→\n   726→def initialize(use_cache: bool, cache_filename: Optional[str] = None):\n   727→    \"\"\"Initialize the loader.\"\"\"\n   728→\n   729→    # Unless an environment variable disables it, use the pickle load cache\n   730→    # automatically. Note that this works across all Python programs running the\n   731→    # loader which is why it's located here.\n   732→    # pylint: disable=invalid-name\n   733→    global _load_file\n   734→\n   735→    # Make a function to compute the cache filename.\n   736→    cache_pattern = (cache_filename or\n   737→                     os.getenv('BEANCOUNT_LOAD_CACHE_FILENAME') or\n   738→                     PICKLE_CACHE_FILENAME)\n   739→    cache_getter = functools.partial(get_cache_filename, cache_pattern)\n   740→\n   741→    if use_cache:\n   742→        _load_file = pickle_cache_function(cache_getter, PICKLE_CACHE_THRESHOLD,\n   743→                                           _uncached_load_file)\n   744→    else:\n   745→        if cache_filename is not None:\n   746→            logging.warning(\"Cache disabled; \"\n   747→                            \"Explicitly overridden cache filename %s will be ignored.\",\n   748→                            cache_filename)\n   749→        _load_file = delete_cache_function(cache_getter,\n   750→                                           _uncached_load_file)\n   751→\n   752→\n   753→# Default is to use the cache every time.\n   754→initialize(os.getenv('BEANCOUNT_DISABLE_LOAD_CACHE') is None)\n   755→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"c3ea1442-2b5b-4478-a9ab-5f19eef39795","uuid":"e1e21652-e803-4262-a1ee-2f1dc7d372ed","tool_use_result":{"type":"text","file":{"filePath":"/testbed/beancount/loader.py","content":"\"\"\"Loader code. This is the main entry point to load up a file.\n\"\"\"\n__copyright__ = \"Copyright (C) 2013-2016  Martin Blais\"\n__license__ = \"GNU GPLv2\"\n\nfrom os import path\nfrom typing import Any, Optional\nimport collections\nimport copy\nimport functools\nimport glob\nimport hashlib\nimport importlib\nimport io\nimport itertools\nimport logging\nimport os\nimport pickle\nimport struct\nimport sys\nimport textwrap\nimport time\nimport traceback\nimport warnings\n\nfrom beancount.utils import misc_utils\nfrom beancount.core import data\nfrom beancount.parser import parser\nfrom beancount.parser import booking\nfrom beancount.parser import options\nfrom beancount.parser import printer\nfrom beancount.ops import validation\nfrom beancount.utils import encryption\nfrom beancount.utils import file_utils\n\n\nOptionsMap = Any\n\n\nLoadError = collections.namedtuple('LoadError', 'source message entry')\n\n\n# List of default plugins to run.\nPLUGINS_PRE = [\n    (\"beancount.ops.pad\", None),\n    (\"beancount.ops.documents\", None),\n    ]\n\n# List of plugins that get enabled by --auto, and list of plugins actually\n# inserted in the list. See {4ec6a3205b6c}.\nDEFAULT_PLUGINS_AUTO = [\n    (\"beancount.plugins.auto\", None),\n    ]\nPLUGINS_AUTO = []\n\nPLUGINS_POST = [\n    (\"beancount.ops.balance\", None),\n    ]\n\n# A mapping of modules to warn about, to their renamed names.\nRENAMED_MODULES = {}\n\n\n# Filename pattern for the pickle-cache.\nPICKLE_CACHE_FILENAME = '.{filename}.picklecache'\n\n# The runtime threshold below which we don't bother creating a cache file, in\n# seconds.\nPICKLE_CACHE_THRESHOLD = 1.0\n\n\ndef load_file(filename, log_timings=None, log_errors=None, extra_validations=None,\n              encoding=None):\n    \"\"\"Open a Beancount input file, parse it, run transformations and validate.\n\n    Args:\n      filename: The name of the file to be parsed.\n      log_timings: A file object or function to write timings to,\n        or None, if it should remain quiet. (Note that this is intended to use\n        the logging methods and does not insert a newline.)\n      log_errors: A file object or function to write errors to,\n        or None, if it should remain quiet.\n      extra_validations: A list of extra validation functions to run after loading\n        this list of entries.\n      encoding: A string or None, the encoding to decode the input filename with.\n    Returns:\n      A triple of (entries, errors, option_map) where \"entries\" is a date-sorted\n      list of entries from the file, \"errors\" a list of error objects generated\n      while parsing and validating the file, and \"options_map\", a dict of the\n      options parsed from the file.\n    \"\"\"\n    filename = path.expandvars(path.expanduser(filename))\n    if not path.isabs(filename):\n        filename = path.normpath(path.join(os.getcwd(), filename))\n\n    if encryption.is_encrypted_file(filename):\n        # Note: Caching is not supported for encrypted files.\n        entries, errors, options_map = load_encrypted_file(\n            filename,\n            log_timings, log_errors,\n            extra_validations, False, encoding)\n    else:\n        entries, errors, options_map = _load_file(\n            filename, log_timings,\n            extra_validations, encoding)\n        _log_errors(errors, log_errors)\n    return entries, errors, options_map\n\n\ndef load_encrypted_file(filename, log_timings=None, log_errors=None, extra_validations=None,\n                        dedent=False, encoding=None):\n    \"\"\"Load an encrypted Beancount input file.\n\n    Args:\n      filename: The name of an encrypted file to be parsed.\n      log_timings: See load_string().\n      log_errors: See load_string().\n      extra_validations: See load_string().\n      dedent: See load_string().\n      encoding: See load_string().\n    Returns:\n      A triple of (entries, errors, option_map) where \"entries\" is a date-sorted\n      list of entries from the file, \"errors\" a list of error objects generated\n      while parsing and validating the file, and \"options_map\", a dict of the\n      options parsed from the file.\n    \"\"\"\n    contents = encryption.read_encrypted_file(filename)\n    return load_string(contents,\n                       log_timings=log_timings,\n                       log_errors=log_errors,\n                       extra_validations=extra_validations,\n                       encoding=encoding)\n\n\ndef _log_errors(errors, log_errors):\n    \"\"\"Log errors, if 'log_errors' is set.\n\n    Args:\n      log_errors: A file object or function to write errors to,\n        or None, if it should remain quiet.\n    \"\"\"\n    if log_errors and errors:\n        if hasattr(log_errors, 'write'):\n            printer.print_errors(errors, file=log_errors)\n        else:\n            error_io = io.StringIO()\n            printer.print_errors(errors, file=error_io)\n            log_errors(error_io.getvalue())\n\n\ndef get_cache_filename(pattern: str, filename: str) -> str:\n    \"\"\"Compute the cache filename from a given pattern and the top-level filename.\n\n    Args:\n      pattern: A cache filename or pattern. If the pattern contains '{filename}' this\n        will get replaced by the top-level filename. This may be absolute or relative.\n      filename: The top-level filename.\n    Returns:\n      The resolved cache filename.\n    \"\"\"\n    abs_filename = path.abspath(filename)\n    if path.isabs(pattern):\n        abs_pattern = pattern\n    else:\n        abs_pattern = path.join(path.dirname(abs_filename), pattern)\n    return abs_pattern.format(filename=path.basename(filename))\n\n\ndef pickle_cache_function(cache_getter, time_threshold, function):\n    \"\"\"Decorate a loader function to make it loads its result from a pickle cache.\n\n    This considers the first argument as a top-level filename and assumes the\n    function to be cached returns an (entries, errors, options_map) triple. We\n    use the 'include' option value in order to check whether any of the included\n    files has changed. It's essentially a special case for an on-disk memoizer.\n    If any of the included files are more recent than the cache, the function is\n    recomputed and the cache refreshed.\n\n    Args:\n      cache_getter: A function of one argument, the top-level filename, which\n        will return the name of the corresponding cache file.\n      time_threshold: A float, the number of seconds below which we don't bother\n        caching.\n      function: A function object to decorate for caching.\n    Returns:\n      A decorated function which will pull its result from a cache file if\n      it is available.\n    \"\"\"\n    @functools.wraps(function)\n    def wrapped(toplevel_filename, *args, **kw):\n        cache_filename = cache_getter(toplevel_filename)\n\n        # Read the cache if it exists in order to get the list of files whose\n        # timestamps to check.\n        exists = path.exists(cache_filename)\n        if exists:\n            with open(cache_filename, 'rb') as file:\n                try:\n                    result = pickle.load(file)\n                except Exception as exc:\n                    # Note: Not a big fan of doing this, but here we handle all\n                    # possible exceptions because unpickling of an old or\n                    # corrupted pickle file manifests as a variety of different\n                    # exception types.\n\n                    # The cache file is corrupted; ignore it and recompute.\n                    logging.error(\"Cache file is corrupted: %s; recomputing.\", exc)\n                    result = None\n\n                else:\n                    # Check that the latest timestamp has not been written after the\n                    # cache file.\n                    entries, errors, options_map = result\n                    if not needs_refresh(options_map):\n                        # All timestamps are legit; cache hit.\n                        return result\n\n        # We failed; recompute the value.\n        if exists:\n            try:\n                os.remove(cache_filename)\n            except OSError as exc:\n                # Warn for errors on read-only filesystems.\n                logging.warning(\"Could not remove picklecache file %s: %s\",\n                                cache_filename, exc)\n\n        time_before = time.time()\n        result = function(toplevel_filename, *args, **kw)\n        time_after = time.time()\n\n        # Overwrite the cache file if the time it takes to compute it\n        # justifies it.\n        if time_after - time_before > time_threshold:\n            try:\n                with open(cache_filename, 'wb') as file:\n                    pickle.dump(result, file)\n            except Exception as exc:\n                logging.warning(\"Could not write to picklecache file %s: %s\",\n                                cache_filename, exc)\n\n        return result\n    return wrapped\n\n\ndef delete_cache_function(cache_getter, function):\n    \"\"\"A wrapper that removes the cached filename.\n\n    Args:\n      cache_getter: A function of one argument, the top-level filename, which\n        will return the name of the corresponding cache file.\n      function: A function object to decorate for caching.\n    Returns:\n      A decorated function which will delete the cached filename, if it exists.\n    \"\"\"\n    @functools.wraps(function)\n    def wrapped(toplevel_filename, *args, **kw):\n        # Delete the cache.\n        cache_filename = cache_getter(toplevel_filename)\n        if path.exists(cache_filename):\n            os.remove(cache_filename)\n\n        # Invoke the original function.\n        return function(toplevel_filename, *args, **kw)\n    return wrapped\n\n\ndef _uncached_load_file(filename, *args, **kw):\n    \"\"\"Delegate to _load. Note: This gets conditionally advised by caching below.\"\"\"\n    return _load([(filename, True)], *args, **kw)\n\n\ndef needs_refresh(options_map):\n    \"\"\"Predicate that returns true if at least one of the input files may have changed.\n\n    Args:\n      options_map: An options dict as per the parser.\n      mtime: A modified time, to check if it covers the include files in the options_map.\n    Returns:\n      A boolean, true if the input is obsoleted by changes in the input files.\n    \"\"\"\n    if options_map is None:\n        return True\n    input_hash = compute_input_hash(options_map['include'])\n    return 'input_hash' not in options_map or input_hash != options_map['input_hash']\n\n\ndef compute_input_hash(filenames):\n    \"\"\"Compute a hash of the input data.\n\n    Args:\n      filenames: A list of input files. Order is not relevant.\n    \"\"\"\n    md5 = hashlib.md5()\n    for filename in sorted(filenames):\n        md5.update(filename.encode('utf8'))\n        if not path.exists(filename):\n            continue\n        stat = os.stat(filename)\n        md5.update(struct.pack('dd', stat.st_mtime_ns, stat.st_size))\n    return md5.hexdigest()\n\n\ndef load_string(string, log_timings=None, log_errors=None, extra_validations=None,\n                dedent=False, encoding=None):\n\n    \"\"\"Open a Beancount input string, parse it, run transformations and validate.\n\n    Args:\n      string: A Beancount input string.\n      log_timings: A file object or function to write timings to,\n        or None, if it should remain quiet.\n      log_errors: A file object or function to write errors to,\n        or None, if it should remain quiet.\n      extra_validations: A list of extra validation functions to run after loading\n        this list of entries.\n      dedent: A boolean, if set, remove the whitespace in front of the lines.\n      encoding: A string or None, the encoding to decode the input string with.\n    Returns:\n      A triple of (entries, errors, option_map) where \"entries\" is a date-sorted\n      list of entries from the string, \"errors\" a list of error objects\n      generated while parsing and validating the string, and \"options_map\", a\n      dict of the options parsed from the string.\n    \"\"\"\n    if dedent:\n        string = textwrap.dedent(string)\n    entries, errors, options_map = _load([(string, False)], log_timings,\n                                         extra_validations, encoding)\n    _log_errors(errors, log_errors)\n    return entries, errors, options_map\n\n\ndef _parse_recursive(sources, log_timings, encoding=None):\n    \"\"\"Parse Beancount input, run its transformations and validate it.\n\n    Recursively parse a list of files or strings and their include files and\n    return an aggregate of parsed directives, errors, and the top-level\n    options-map. If the same file is being parsed twice, ignore it and issue an\n    error.\n\n    Args:\n      sources: A list of (filename-or-string, is-filename) where the first\n        element is a string, with either a filename or a string to be parsed directly,\n        and the second argument is a boolean that is true if the first is a filename.\n        You may provide a list of such arguments to be parsed. Filenames must be absolute\n        paths.\n      log_timings: A function to write timings to, or None, if it should remain quiet.\n      encoding: A string or None, the encoding to decode the input filename with.\n    Returns:\n      A tuple of (entries, parse_errors, options_map).\n    \"\"\"\n    assert isinstance(sources, list) and all(isinstance(el, tuple) for el in sources)\n\n    # Current parse state.\n    entries, parse_errors = [], []\n    options_map = None\n    other_options_map = []\n\n    # A stack of sources to be parsed.\n    source_stack = list(sources)\n\n    # A list of absolute filenames that have been parsed in the past, used to\n    # detect and avoid duplicates (cycles).\n    filenames_seen = set()\n\n    with misc_utils.log_time('beancount.parser.parser', log_timings, indent=1):\n        while source_stack:\n            source, is_file = source_stack.pop(0)\n            is_top_level = options_map is None\n\n            # If the file is encrypted, read it in and process it as a string.\n            if is_file:\n                cwd = path.dirname(source)\n                source_filename = source\n                if encryption.is_encrypted_file(source):\n                    source = encryption.read_encrypted_file(source)\n                    is_file = False\n            else:\n                # If we're parsing a string, the CWD is the current process\n                # working directory.\n                cwd = os.getcwd()\n                source_filename = None\n\n            if is_file:\n                # All filenames here must be absolute.\n                assert path.isabs(source)\n                filename = path.normpath(source)\n\n                # Check for file previously parsed... detect duplicates.\n                if filename in filenames_seen:\n                    parse_errors.append(\n                        LoadError(data.new_metadata(\"<load>\", 0),\n                                  'Duplicate filename parsed: \"{}\"'.format(filename),\n                                  None))\n                    continue\n\n                # Check for a file that does not exist.\n                if not path.exists(filename):\n                    parse_errors.append(\n                        LoadError(data.new_metadata(\"<load>\", 0),\n                                  'File \"{}\" does not exist'.format(filename), None))\n                    continue\n\n                # Parse a file from disk directly.\n                filenames_seen.add(filename)\n                with misc_utils.log_time('beancount.parser.parser.parse_file',\n                                         log_timings, indent=2):\n                    (src_entries,\n                     src_errors,\n                     src_options_map) = parser.parse_file(filename, encoding=encoding)\n\n                cwd = path.dirname(filename)\n            else:\n                # Encode the contents if necessary.\n                if encoding:\n                    if isinstance(source, bytes):\n                        source = source.decode(encoding)\n                    source = source.encode('ascii', 'replace')\n\n                # Parse a string buffer from memory.\n                with misc_ut