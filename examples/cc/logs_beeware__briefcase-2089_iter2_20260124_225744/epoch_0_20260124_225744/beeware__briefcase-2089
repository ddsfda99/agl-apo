            help=\"Save a detailed log to file. By default, this log file is only created for critical errors\",\n   820→        )\n   821→\n   822→    def _add_update_options(\n   823→        self,\n   824→        parser,\n   825→        context_label=\"\",\n   826→        update=True,\n   827→    ):\n   828→        \"\"\"Internal utility method for adding common update options.\n   829→\n   830→        :param parser: The parser to which options should be added.\n   831→        :param context_label: Label text that will be added to the end of the help text\n   832→            to describe when the update will be applied (e.g., \"before building\")\n   833→        :param update: Should the --update and --no-update options be exposed?\n   834→        \"\"\"\n   835→        if update:\n   836→            parser.add_argument(\n   837→                \"-u\",\n   838→                \"--update\",\n   839→                action=\"store_true\",\n   840→                help=f\"Update the app{context_label}\",\n   841→            )\n   842→\n   843→        parser.add_argument(\n   844→            \"-r\",\n   845→            \"--update-requirements\",\n   846→            action=\"store_true\",\n   847→            help=f\"Update requirements for the app{context_label}\",\n   848→        )\n   849→\n   850→        parser.add_argument(\n   851→            \"--update-support\",\n   852→            action=\"store_true\",\n   853→            help=f\"Update support package for the app{context_label}\",\n   854→        )\n   855→\n   856→        parser.add_argument(\n   857→            \"--update-stub\",\n   858→            action=\"store_true\",\n   859→            help=f\"Update stub binary for the app{context_label}\",\n   860→        )\n   861→\n   862→        parser.add_argument(\n   863→            \"--update-resources\",\n   864→            action=\"store_true\",\n   865→            help=f\"Update app resources (icons, splash screens, etc){context_label}\",\n   866→        )\n 