"_\")\n   159→        if stripped:\n   160→            return stripped.lower()\n   161→        else:\n   162→            # If stripping removes all the content,\n   163→            # use a dummy app name as the suggestion.\n   164→            return \"myapp\"\n   165→\n   166→    def validate_formal_name(self, candidate):\n   167→        \"\"\"Determine if the formal name is valid.\n   168→\n   169→        A formal name is valid if it contains at least one identifier character.\n   170→\n   171→        :param candidate: The candidate name\n   172→        :returns: True the formal name is valid.\n   173→        :raises: ValueError if the name is not a valid formal name.\n   174→        \"\"\"\n   175→        if not make_class_name(candidate):  # Check whether a class name may be derived\n   176→            raise ValueError(\n   177→                self.input.textwrap(\n   178→                    f\"{candidate!r} is not a valid formal name.\\n\"\n   179→                    \"\\n\"\n   180→                    \"Formal names must include at least one valid Python identifier character.\"\n   181→                )\n   182→            )\n   183→\n   184→        return True\n   185→\n   186→    def _validate_existing_app_name(self, candidate):\n   187→        \"\"\"Perform internal validation preventing the use of pre-existing app names.\n   188→\n   189→        Invoked by validate_app_name; subclasses may override this behavior.\n   190→        \"\"\"\n   191→        if (self.base_path / candidate).exists():\n   192→            raise ValueError(\n   193→                self.input.textwrap(\n   194→                    f\"A {candidate!r} directory already exists.\\n\"\n   195→                    f\"\\n\"\n   196→                    f\"Select a different name, move to a different parent directory, or \"\n   197→                    f\"delete the existing folder.\"\n   198→                )\n   199→            )\n   200→\n   201→    def validate_app_name(self, candidate):\n   2