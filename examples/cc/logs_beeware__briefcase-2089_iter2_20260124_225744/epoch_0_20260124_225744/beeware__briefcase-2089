92        :return: The full path where the support package should be unpacked.\n   473\u2192        \"\"\"\n   474\u2192        return self.bundle_path(app) / self.path_index(app, \"support_path\")\n   475\u2192\n   476\u2192    def support_revision(self, app: AppConfig) -> str:\n   477\u2192        \"\"\"Obtain the support package revision that the template requires.\n   478\u2192\n   479\u2192        :param app: The config object for the app\n   480\u2192        :return: The support revision required by the template.\n   481\u2192        \"\"\"\n   482\u2192        return self.path_index(app, \"support_revision\")\n   483\u2192\n   484\u2192    def cleanup_paths(self, app: AppConfig) -> list[str]:\n   485\u2192        \"\"\"Obtain the paths generated by the app template that should be cleaned up\n   486\u2192        prior to release.\n   487\u2192\n   488\u2192        :param app: The config object for the app\n   489\u2192        :return: The list of path globs inside the app template that should be cleaned\n   490\u2192            up.\n   491\u2192        \"\"\"\n   492\u2192        return self.path_index(app, \"cleanup_paths\")\n   493\u2192\n   494\u2192    def app_requirements_path(self, app: AppConfig) -> Path:\n   495\u2192        \"\"\"Obtain the path into which a requirements.txt file should be written.\n   496\u2192\n   497\u2192        :param app: The config object for the app\n   498\u2192        :return: The full path where the requirements.txt file should be written\n   499\u2192        \"\"\"\n   500\u2192        return self.bundle_path(app) / self.path_index(app, \"app_requirements_path\")\n   501\u2192\n   502\u2192    def app_requirement_installer_args_path(self, app: AppConfig) -> Path:\n   503\u2192        \"\"\"Obtain the path into which a newline delimited requirement installer args\n   504\u2192        file should be written.\n   505\u2192\n   506\u2192        :param app: The config object for the app\n   507\u2192        :return: The full path where the file should be written\n   508\u2192        \"\"\"\n   509\u2192        return self.bundle_path(app) / self.path_index(\n   510\u2192            app, \"app_requirement_installer_args_path\"\n   511\u2192        )\n   512\u2192\n   513\u2192    def app_packages_path(self, app: AppConfig) -> Path:\n   514\u2192        \"\"\"Obtain the path into which requirements should be installed.\n   515\u2192\n   516\u2192        :param app: The config object for the app\n   517\u2192        :return: The full path where application requirements should be installed.\n   518\u2192        \"\"\"\n   519\u2192        return self.bundle_path(app) / self.path_index(app, \"app_packages_path\")\n   520\u2192\n   521\u2192    def app_path(self, app: AppConfig) -> Path:\n   522\u2192        \"\"\"Obtain the path into which the application should be installed.\n   523\u2192\n   524\u2192        :param app: The config object for the app\n   525\u2192        :return: The full path where application code should be installed.\n   526\u2192        \"\"\"\n   527\u2192        return self.bundle_path(app) / self.path_index(app, \"app_path\")\n   528\u2192\n   529\u2192    def app_module_path(self, app: AppConfig) -> Path:\n   530\u2192        \"\"\"Find the path for the application module for an app.\n   531\u2192\n   532\u2192        :param app: The config object for the app\n   533\u2192        :returns: The Path to the dist-info folder.\n   534\u2192        \"\"\"\n   535\u2192        app_home = [\n   536\u2192            path.split(\"/\")\n   537\u2192            for path in app.sources\n   538\u2192            if path.rsplit(\"/\", 1)[-1] == app.module_name\n   539\u2192        ]\n   540\u2192\n   541\u2192        if len(app_home) == 0:\n   542\u2192            raise BriefcaseCommandError(\n   543\u2192                f\"Unable to find code for application {app.app_name!r}\"\n   544\u2192            )\n   545\u2192        elif len(app_home) == 1:\n   546\u2192            path = Path(str(self.base_path), *app_home[0])\n   547\u2192        else:\n   548\u2192            raise BriefcaseCommandError(\n   549\u2192                f\"Multiple paths in sources found for application {app.app_name!r}\"\n   550\u2192            )\n   551\u2192\n   552\u2192        return path\n   553\u2192\n   554\u2192    @property\n   555\u2192    def briefcase_required_python_version(self):\n   556\u2192        \"\"\"The major.minor of the minimum Python version required by Briefcase itself.\n   557\u2192\n   558\u2192        This is extracted from packaging metadata.\n   559\u2192        \"\"\"\n   560\u2192        # Native format is \">=3.8\"\n   561\u2192        return tuple(\n   562\u2192            int(v)\n   563\u2192            for v in importlib.metadata.metadata(\"briefcase\")[\"Requires-Python\"]\n   564\u2192            .split(\"=\")[1]\n   565\u2192            .strip()\n   566\u2192            .split(\".\")\n   567\u2192        )\n   568\u2192\n   569\u2192    @property\n   570\u2192    def python_version_tag(self):\n   571\u2192        \"\"\"The major.minor of the Python version in use, as a string.\n   572\u2192\n   573\u2192        This is used as a repository label/tag to identify the appropriate templates,\n   574\u2192        etc. to use.\n   575\u2192        \"\"\"\n   576\u2192        return (\n   577\u2192            f\"{self.tools.sys.version_info.major}.{self.tools.sys.version_info.minor}\"\n   578\u2192        )\n   579\u2192\n   580\u2192    def verify_host(self):\n   581\u2192        \"\"\"Verify the host OS is supported by the Command.\"\"\"\n   582\u2192        if self.tools.host_os not in self.supported_host_os:\n   583\u2192            raise UnsupportedHostError(self.supported_host_os_reason)\n   584\u2192\n   585\u2192    def verify_tools(self):\n   586\u2192        \"\"\"Verify that the tools needed to run this Command exist.\n   587\u2192\n   588\u2192        Raises MissingToolException if a required system tool is missing.\n   589\u2192        \"\"\"\n   590\u2192\n   591\u2192    def finalize_app_config(self, app: AppConfig):\n   592\u2192        \"\"\"Finalize the application config.\n   593\u2192\n   594\u2192        Some app configurations (notably, Linux system packages like .deb) have\n   595\u2192        configurations that are deeper than other platforms, because they need to\n   596\u2192        include components that are dependent on command-line arguments. They may also\n   597\u2192        require the existence of system tools to complete configuration.\n   598\u2192\n   599\u2192        The final app configuration merges those \"deep\" properties into the app\n   600\u2192        configuration, and performs any other app-specific platform configuration and\n   601\u2192        verification that is required as a result of command-line arguments.\n   602\u2192\n   603\u2192        :param app: The app configuration to finalize.\n   604\u2192        \"\"\"\n   605\u2192\n   606\u2192    def finalize(self, app: AppConfig | None = None):\n   607\u2192        \"\"\"Finalize Briefcase configuration.\n   608\u2192\n   609\u2192        This will:\n   610\u2192\n   611\u2192        1. Ensure that the host has been verified\n   612\u2192        2. Ensure that the platform tools have been verified\n   613\u2192        3. Ensure that app configurations have been finalized.\n   614\u2192\n   615\u2192        App finalization will only occur once per invocation.\n   616\u2192\n   617\u2192        :param app: If provided, the specific app configuration\n   618\u2192            to finalize. By default, all apps will be finalized.\n   619\u2192        \"\"\"\n   620\u2192        self.verify_host()\n   621\u2192        self.verify_tools()\n   622\u2192\n   623\u2192        if app is None:\n   624\u2192            for app in self.apps.values():\n   625\u2192                if hasattr(app, \"__draft__\"):\n   626\u2192                    self.finalize_app_config(app)\n   627\u2192                    delattr(app, \"__draft__\")\n   628\u2192        else:\n   629\u2192            if hasattr(app, \"__draft__\"):\n   630\u2192                self.finalize_app_config(app)\n   631\u2192                delattr(app, \"__draft__\")\n   632\u2192\n   633\u2192    def verify_app(self, app: AppConfig):\n   634\u2192        \"\"\"Verify the app is compatible and the app tools are available.\n   635\u2192\n   636\u2192        This is the last step of verification for a Command before running the Command's\n   637\u2192        business logic. It runs _after_ pre-requisite Commands have been verified and\n   638\u2192        run.\n   639\u2192\n   640\u2192        :param app: app configuration\n   641\u2192        \"\"\"\n   642\u2192        self.verify_app_template(app)\n   643\u2192        self.verify_app_tools(app)\n   644\u2192        self.verify_required_python(app)\n   645\u2192\n   646\u2192    def verify_app_tools(self, app: AppConfig):\n   647\u2192        \"\"\"Verify that tools needed to run the command for this app exist.\"\"\"\n   648\u2192\n   649\u2192    def verify_app_template(self, app: AppConfig):\n   650\u2192        \"\"\"Verify the template targets the same Briefcase version as the Command.\n   651\u2192\n   652\u2192        :param app: app configuration\n   653\u2192        \"\"\"\n   654\u2192\n   655\u2192        # Skip this check if the template isn't rolled out\n   656\u2192        # or if the command doesn't support templates\n   657\u2192        try:\n   658\u2192            template_target_version = self.template_target_version(app)\n   659\u2192        except (MissingAppMetadata, NotImplementedError):\n   660\u2192            return\n   661\u2192\n   662\u2192        if self.platform_target_version != template_target_version:\n   663\u2192            raise BriefcaseCommandError(\n   664\u2192                f\"\"\"\\\n   665\u2192The app template used to generate this app is not compatible with this version\n   666\u2192of Briefcase.\n   667\u2192\n   668\u2192If the app was generated with an earlier version of Briefcase using the default\n   669\u2192Briefcase template, you can run:\n   670\u2192\n   671\u2192     $ briefcase create {self.platform} {self.output_format}\n   672\u2192\n   673\u2192to re-generate your app with a compatible version of the template.\n   674\u2192\n   675\u2192If you are using a custom template, you'll need to update the template to correct\n   676\u2192any compatibility problems, and then add the compatibility declaration.\n   677\u2192\"\"\"\n   678\u2192            )\n   679\u2192\n   680\u2192    def verify_required_python(self, app: AppConfig):\n   681\u2192        \"\"\"Verify that the running version of Python meets the project's specifications.\"\"\"\n   682\u2192\n   683\u2192        requires_python = getattr(self.global_config, \"requires_python\", None)\n   684\u2192        if not requires_python:\n   685\u2192            return\n   686\u2192\n   687\u2192        try:\n   688\u2192            spec = Specifier(requires_python)\n   689\u2192        except InvalidSpecifier as e:\n   690\u2192            raise BriefcaseConfigError(\n   691\u2192                f\"Invalid requires-python in pyproject.toml: {e}\"\n   692\u2192            ) from e\n   693\u2192\n   694\u2192        running_version = platform.python_version()\n   695\u2192\n   696\u2192        if not spec.contains(running_version, prereleases=True):\n   697\u2192            raise UnsupportedPythonVersion(\n   698\u2192                version_specifier=requires_python, running_version=running_version\n   699\u2192            )\n   700\u2192\n   701\u2192    def parse_options(self, extra):\n   702\u2192        \"\"\"Parse the command line arguments for the Command.\n   703\u2192\n   704\u2192        After the initial ArgumentParser runs to choose the Command for the selected\n   705\u2192        platform and format, a new ArgumentParser is created here to parse the remaining\n   706\u2192        command line arguments specific to the Command. Additionally, the default\n   707\u2192        options for disabling input, log verbosity, and log saving are parsed out and\n   708\u2192        saved to the Command.\n   709\u2192\n   710\u2192        :param extra: the remaining command line arguments after the initial\n   711\u2192            ArgumentParser runs over the command line.\n   712\u2192        :return: dictionary of parsed arguments for Command, and a dictionary of parsed\n   713\u2192            configuration overrides.\n   714\u2192        \"\"\"\n   715\u2192        default_format = getattr(\n   716\u2192            get_platforms().get(self.platform), \"DEFAULT_OUTPUT_FORMAT\", None\n   717\u2192        )\n   718\u2192        # only show supported formats for Commands that support formats\n   719\u2192        if default_format is not None and self.command not in {\"new\", \"dev\", \"upgrade\"}:\n   720\u2192            formats = list(get_output_formats(self.platform).keys())\n   721\u2192            formats[formats.index(default_format)] = f\"{default_format} (default)\"\n   722\u2192            supported_formats_helptext = (\n   723\u2192                f\"Supported formats:\\n  {', '.join(sorted(formats, key=str.lower))}\"\n   724\u2192            )\n   725\u2192        else:\n   726\u2192            supported_formats_helptext = \"\"\n   727\u2192\n   728\u2192        parser = argparse.ArgumentParser(\n   729\u2192            prog=self.cmd_line.format(\n   730\u2192                command=self.command,\n   731\u2192                platform=self.platform,\n   732\u2192                output_format=self.output_format,\n   733\u2192            ),\n   734\u2192            description=self.input.textwrap(\n   735\u2192                f\"{self.description}\\n\\n{supported_formats_helptext}\"\n   736\u2192            ),\n   737\u2192            formatter_class=(\n   738\u2192                lambda prog: RawDescriptionHelpFormatter(prog, width=MAX_TEXT_WIDTH)\n   739\u21