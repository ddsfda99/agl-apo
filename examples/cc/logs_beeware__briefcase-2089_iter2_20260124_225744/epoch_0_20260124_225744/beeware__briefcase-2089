s with spaces (use chr(10) since '\\n' isn't allowed in f-strings...)\n   464→            f\"Python version:  {sys.version.replace(chr(10), ' ')}\\n\"\n   465→            # sys.real_prefix was used in older versions of virtualenv.\n   466→            # sys.base_prefix is always the python exe's original site-specific directory (e.g. /usr/local).\n   467→            # sys.prefix is updated (from base_prefix's value) to the virtual env's site-specific directory.\n   468→            f\"Virtual env:     {hasattr(sys, 'real_prefix') or sys.base_prefix != sys.prefix}\\n\"\n   469→            # for conda, prefix and base_prefix are likely the same but contain a conda-meta dir.\n   470→            f\"Conda env:       {(Path(sys.prefix) / 'conda-meta').exists()}\\n\"\n   471→            \"\\n\"\n   472→            f\"Briefcase:       {__version__}\\n\"\n   473→            f\"Target platform: {command.platform}\\n\"\n   474→            f\"Target format:   {command.output_format}\\n\"\n   475→            \"\\n\"\n   476→            \"Environment Variables:\\n\"\n   477→            f\"{sanitized_env_vars}\\n\"\n   478→            \"\\n\"\n   479→            \"pyproject.toml:\\n\"\n   480→            f\"{pyproject_toml}\\n\"\n   481→            \"\\n\"\n   482→            \"Briefcase Log:\\n\"\n   483→            f\"{self.print.export_log()}\"\n   484→        )\n   485→\n   486→\n   487→class NotDeadYet:\n   488→    # I’m getting better! No you’re not, you’ll be stone dead in a minute.\n   489→\n   490→    def __init__(self, printer: Printer):\n   491→        \"\"\"A keep-alive spinner for long-running processes without console output.\n   492→\n   493→        Returned by the Wait Bar's context manager but can be used independently. Use in\n   494→        a loop that calls update() each iteration. A keep-alive message will be printed\n   495→        every 10 seconds.\n   496→        \"\"\"\n   497→        self.printer: Printer = printer\n   498→        self.interval_sec: int = 10\n   499→        self.message: str = \"... still waiting\"\n   500→        self.ready_time: float = 0.0\n   501→\n   502→        self.reset()  # initialize\n   503→\n   504→    def update(self):\n   505→        \"\"\"Write keep-alive message if the periodic interval has elapsed.\"\"\"\n   506→        if self.ready_time < time.time():\n   507→            self.printer(self.message)\n   508→            self.reset()\n   509→\n   510→    def reset(self):\n   511→        \"\"\"Initialize periodic interval to now; next message prints after interval.\"\"\"\n   512→        self.ready_time = time.time() + self.interval_sec\n   513→\n   514→\n   515→class Console:\n   516→    def __init__(self, printer: Printer | None = None, enabled: bool = True):\n   517→        self.enabled = enabled\n   518→        self.print = Printer() if printer is None else printer\n   519→        # Use Rich's input() to read from user\n   520→        self.input = self.print.console.input\n   521→        self._wait_bar: Progress | None = None\n   522→        # Signal that Rich is dynamically controlling the console output. Therefore,\n   523→        # all output must be printed to the screen by Rich to prevent corruption of\n   524→        # dynamic elements like the Wait Bar.\n   525→        self.is_console_controlled = False\n   526→\n   527→    @property\n   528→    def is_interactive(self):\n   529→        \"\"\"Returns interactivity mode based on the presence of a tty for stdout.\n   530→\n   531→        In a non-interactive session, Rich's dynamic elements like progress bars should\n   532→        be disabled. By default, Rich will not render dynamic elements if a tty is not\n   533→        available. However, environment variables like FORCE_COLOR can override this\n   534→        behavior in Rich to not only show ANSI color and style but also dynamic\n   535→        elements. In a CI environment with this configuration, a long-lived progress bar\n   536→        can dramatically compromise the 