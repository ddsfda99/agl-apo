e.\n   456→        \"\"\"\n   457→        formal_name = self.input_text(\n   458→            intro=(\n   459→                \"First, we need a formal name for your application.\\n\"\n   460→                \"\\n\"\n   461→                \"This is the name that will be displayed to humans whenever the name \"\n   462→                \"of the application is displayed. It can have spaces and punctuation \"\n   463→                \"if you like, and any capitalization will be used as you type it.\"\n   464→            ),\n   465→            variable=\"formal name\",\n   466→            default=\"Hello World\",\n   467→            validator=self.validate_formal_name,\n   468→            override_value=project_overrides.pop(\"formal_name\", None),\n   469→        )\n   470→\n   471→        # The class name can be completely derived from the formal name.\n   472→        class_name = make_class_name(formal_name)\n   473→\n   474→        default_app_name = self.make_app_name(formal_name)\n   475→        app_name = self.input_text(\n   476→            intro=(\n   477→                \"Next, we need a name that can serve as a machine-readable Python \"\n   478→                \"package name for your application.\\n\"\n   479→                \"\\n\"\n   480→                \"This name must be PEP508-compliant - that means the name may only \"\n   481→                \"contain letters, numbers, hyphens and underscores; it can't contain \"\n   482→                \"spaces or punctuation, and it can't start with a hyphen or \"\n   483→                \"underscore.\\n\"\n   484→                \"\\n\"\n   485→                \"Based on your formal name, we suggest an app name of \"\n   486→                f\"{default_app_name!r}, but you can use another name if you want.\"\n   487→            ),\n   488→            variable=\"app name\",\n   489→            default=default_app_name,\n   490→            validator=self.validate_app_name,\n   491→            override_value=project_o