\"\"\n   735→        )\n   736→\n   737→    def validate_pyproject_file(self) -> None:\n   738→        \"\"\"Cannot setup new app if it already has briefcase settings in pyproject.\"\"\"\n   739→        if not (self.base_path / \"pyproject.toml\").exists():\n   740→            raise BriefcaseCommandError(\n   741→                \"Cannot automatically set up Briefcase for a project without a \"\n   742→                \"'pyproject.toml' file.\"\n   743→            )\n   744→\n   745→        with open(self.base_path / \"pyproject.toml\", \"rb\") as file:\n   746→            pyproject = tomllib.load(file)\n   747→\n   748→        if \"tool\" in pyproject and \"briefcase\" in pyproject[\"tool\"]:\n   749→            raise BriefcaseCommandError(\n   750→                \"Your 'pyproject.toml' file already contains a Briefcase configuration.\"\n   751→            )\n   752→\n   753→    def __call__(\n   754→        self,\n   755→        template: str | None = None,\n   756→        template_branch: str | None = None,\n   757→        project_overrides: list[str] = None,\n   758→        **options,\n   759→    ):\n   760→        # Confirm host compatibility, and that all required tools are available.\n   761→        # There are no apps, so finalize() will be a no op on app configurations.\n   762→        self.finalize()\n   763→\n   764→        self.validate_pyproject_file()\n   765→\n   766→        # Setup the app for briefcase\n   767→        with TemporaryDirectory() as tmp_path:\n   768→            tmp_path = Path(tmp_path)\n   769→            self.convert_app(\n   770→                tmp_path=tmp_path,\n   771→                template=template,\n   772→                template_branch=template_branch,\n   773→                project_overrides=parse_project_overrides(project_overrides),\n   774→                **options,\n   775→            )\n   776→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SH