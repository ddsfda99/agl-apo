      )\n   284\u2192\n   285\u2192    def verbose(self, message=\"\", *, prefix=\"\", markup=False):\n   286\u2192        \"\"\"Log message at verbose level; included if verbosity >= 1.\"\"\"\n   287\u2192        self._log(prefix=prefix, message=message, show=self.is_verbose, markup=markup)\n   288\u2192\n   289\u2192    def info(self, message=\"\", *, prefix=\"\", markup=False):\n   290\u2192        \"\"\"Log message at info level; always included in output.\"\"\"\n   291\u2192        self._log(prefix=prefix, message=message, markup=markup)\n   292\u2192\n   293\u2192    def warning(self, message=\"\", *, prefix=\"\", markup=False):\n   294\u2192        \"\"\"Log message at warning level; always included in output.\"\"\"\n   295\u2192        self._log(prefix=prefix, message=message, markup=markup, style=\"bold yellow\")\n   296\u2192\n   297\u2192    def error(self, message=\"\", *, prefix=\"\", markup=False):\n   298\u2192        \"\"\"Log message at error level; always included in output.\"\"\"\n   299\u2192        self._log(prefix=prefix, message=message, markup=markup, style=\"bold red\")\n   300\u2192\n   301\u2192    @property\n   302\u2192    def verbosity(self) -> LogLevel:\n   303\u2192        return self._verbosity\n   304\u2192\n   305\u2192    @verbosity.setter\n   306\u2192    def verbosity(self, value: int | LogLevel):\n   307\u2192        \"\"\"Clamp verbosity between valid log levels.\"\"\"\n   308\u2192        self._verbosity = LogLevel(max(min(LogLevel), min(value, max(LogLevel))))\n   309\u2192\n   310\u2192    @property\n   311\u2192    def is_verbose(self):\n   312\u2192        \"\"\"Is verbose logging enabled via the -v flag?\n   313\u2192\n   314\u2192        This includes Briefcase logging that isn't relevant during normal operation.\n   315\u2192        \"\"\"\n   316\u2192        return self.verbosity >= LogLevel.VERBOSE\n   317\u2192\n   318\u2192    @property\n   319\u2192    def is_debug(self):\n   320\u2192        \"\"\"Is debug logging enabled via the -vv flag?\n   321\u2192\n   322\u2192        This includes debug logging from third party tools.\n   323\u2192        \"\"\"\n   324\u2192        return self.verbosity >= LogLevel.DEBUG\n   325\u2192\n   326\u2192    @property\n   327\u2192    def is_deep_debug(self):\n   328\u2192        \"\"\"Is deep debug logging enabled via the -vvv flag?\n   329\u2192\n   330\u2192        This includes debug logging from third party tools.\n   331\u2192        \"\"\"\n   332\u2192        return self.verbosity >= LogLevel.DEEP_DEBUG\n   333\u2192\n   334\u2192    def configure_stdlib_logging(self, logger_name: str):\n   335\u2192        \"\"\"Configure stdlib logging for a third party tool to log through Rich.\n   336\u2192\n   337\u2192        When a third party tool written in Python uses the stdlib logging for their\n   338\u2192        logging, it may provide an abstraction to enable the logging in the console or\n   339\u2192        may require a handler to be added externally. Either way, the default handler\n   340\u2192        to write to the console, i.e. logging.StreamHandler, will bypass Rich logging\n   341\u2192        and therefore not be included in the logfile. To avoid this issue, this will\n   342\u2192        add a handler that specifically writes to the console through Rich.\n   343\u2192\n   344\u2192        :param logger_name: Name of the logger the third party tool uses. Typically,\n   345\u2192            this is the package name or path to a submodule for the package. Since\n   346\u2192            logging uses namespaces for logging, enabling DEBUG logging for `git` will\n   347\u2192            also enable it for others like `git.cmd`, `git.remote`, `git.config`, etc.\n   348\u2192        \"\"\"\n   349\u2192        if not self.is_deep_debug:\n   350\u2192            return\n   351\u2192\n   352\u2192        logger = logging.getLogger(logger_name)\n   353\u2192\n   354\u2192        # do not add another rich handler if one already exists\n   355\u2192        if not any(isinstance(h, RichLoggingHandler) for h in logger.handlers):\n   356\u2192            logger.addHandler(RichLoggingHandler(stream=RichLoggingStream(logger=self)))\n   357\u2192            logger.setLevel(logging.DEBUG)\n   358\u2192\n   359\u2192    def capture_stacktrace(self, label=\"Main thread\"):\n   360\u2192        \"\"\"Preserve Rich stacktrace from exception while in except block.\n   361\u2192\n   362\u2192        :param label: An identifying label for the thread that has raised the\n   363\u2192            stacktrace. Defaults to the main thread.\n   364\u2192        \"\"\"\n   365\u2192        exc_info = sys.exc_info()\n   366\u2192        try:\n   367\u2192            self.skip_log = exc_info[1].skip_logfile\n   368\u2192        except AttributeError:\n   369\u2192            pass\n   370\u2192\n   371\u2192        self.stacktraces.append((label, Traceback.extract(*exc_info, show_locals=True)))\n   372\u2192\n   373\u2192    def add_log_file_extra(self, func: Callable[[], object]):\n   374\u2192        \"\"\"Register a function to be called in the event that a log file is written.\n   375\u2192\n   376\u2192        This can be used to provide additional debugging information which is too\n   377\u2192        expensive to gather pre-emptively.\n   378\u2192        \"\"\"\n   379\u2192        self.log_file_extras.append(func)\n   380\u2192\n   381\u2192    def save_log_to_file(self, command):\n   382\u2192        \"\"\"Save the current application log to file.\"\"\"\n   383\u2192        # A log file is always written if a Command ran and `--log` was provided.\n   384\u2192        # If `--log` was not provided, then the log is written when an exception\n   385\u2192        # occurred and the exception was not explicitly configured to skip the log.\n   386\u2192        if not (\n   387\u2192            command and (self.save_log or (self.stacktraces and not self.skip_log))\n   388\u2192        ):\n   389\u2192            return\n   390\u2192\n   391\u2192        with command.input.wait_bar(\"Saving log...\", transient=True):\n   392\u2192            self.print.to_console()\n   393\u2192            log_filename = f\"briefcase.{datetime.now().strftime('%Y_%m_%d-%H_%M_%S')}.{command.command}.log\"\n   394\u2192            log_filepath = command.base_path / self.LOG_DIR / log_filename\n   395\u2192            try:\n   396\u2192                log_filepath.parent.mkdir(parents=True, exist_ok=True)\n   397\u2192                with open(\n   398\u2192                    log_filepath, \"w\", encoding=\"utf-8\", errors=\"backslashreplace\"\n   399\u2192                ) as log_file:\n   400\u2192                    log_file.write(self._build_log(command))\n   401\u2192            except OSError as e:\n   402\u2192                self.error(f\"Failed to save log to {log_filepath}: {e}\")\n   403\u2192            else:\n   404\u2192                self.warning(f\"Log saved to {log_filepath}\")\n   405\u2192            self.print.to_console()\n   406\u2192\n   407\u2192    def _build_log(self, command) -> str:\n   408\u2192        \"\"\"Accumulate all information to include in the log file.\"\"\"\n   409\u2192        # Add the exception stacktraces to end of log if any were captured\n   410\u2192        if self.stacktraces:\n   411\u2192            # using print.log.print() instead of print.to_log() to avoid\n   412\u2192            # timestamp and code location inclusion for the stacktrace box.\n   413\u2192            for thread, stacktrace in self.stacktraces:\n   414\u2192                self.print.log.print(\n   415\u2192                    f\"{thread} traceback:\",\n   416\u2192                    Traceback(\n   417\u2192                        trace=stacktrace,\n   418\u2192                        width=self.print.log_width,\n   419\u2192                        show_locals=True,\n   420\u2192                    ),\n   421\u2192                    new_line_start=True,\n   422\u2192                )\n   423\u2192\n   424\u2192        # Retrieve additional logging added by the Command\n   425\u2192        if self.log_file_extras:\n   426\u2192            with command.input.wait_bar(\n   427\u2192                \"Collecting extra information for log...\",\n   428\u2192                transient=True,\n   429\u2192            ):\n   430\u2192                self.debug()\n   431\u2192                self.debug(\"Extra information:\")\n   432\u2192                for func in self.log_file_extras:\n   433\u2192                    try:\n   434\u2192                        func()\n   435\u2192                    except Exception:\n   436\u2192                        self.error(traceback.format_exc())\n   437\u2192\n   438\u2192        # Capture env vars removing any potentially sensitive information\n   439\u2192        sanitized_env_vars = \"\\n\".join(\n   440\u2192            f\"\\t{env_var}={value if not SENSITIVE_SETTING_RE.search(env_var) else '********************'}\"\n   441\u2192            for env_var, value in sorted(command.tools.os.environ.items())\n   442\u2192        )\n   443\u2192\n   444\u2192        # Capture pyproject.toml if one exists in the current directory\n   445\u2192        try:\n   446\u2192            with open(Path.cwd() / \"pyproject.toml\", encoding=\"utf-8\") as f:\n   447\u2192                pyproject_toml = f.read().strip()\n   448\u2192        except OSError as e:\n   449\u2192            pyproject_toml = str(e)\n   450\u2192\n   451\u2192        # Build log with buffered log from Rich\n   452\u2192        uname = platform.uname()\n   453\u2192        return (\n   454\u2192            f\"Date/Time:       {datetime.now().strftime('%Y-%m-%d %H:%M:%S %Z')}\\n\"\n   455\u2192            f\"Command line:    {' '.join(sys.argv)}\\n\"\n   456\u2192            \"\\n\"\n   457\u2192            f\"OS Release:      {uname.system} {uname.release}\\n\"\n   458\u2192            f\"OS Version:      {uname.version}\\n\"\n   459\u2192            f\"Architecture:    {uname.machine}\\n\"\n   460\u2192            f\"Platform:        {platform.platform(aliased=True)}\\n\"\n   461\u2192            \"\\n\"\n   462\u2192            f\"Python exe:      {sys.executable}\\n\"\n   463\u2192            # replace line breaks with spaces (use chr(10) since '\\n' isn't allowed in f-strings...)\n   464\u2192            f\"Python version:  {sys.version.replace(chr(10), ' ')}\\n\"\n   465\u2192            # sys.real_prefix was used in older versions of virtualenv.\n   466\u2192            # sys.base_prefix is always the python exe's original site-specific directory (e.g. /usr/local).\n   467\u2192            # sys.prefix is updated (from base_prefix's value) to the virtual env's site-specific directory.\n   468\u2192            f\"Virtual env:     {hasattr(sys, 'real_prefix') or sys.base_prefix != sys.prefix}\\n\"\n   469\u2192            # for conda, prefix and base_prefix are likely the same but contain a conda-meta dir.\n   470\u2192            f\"Conda env:       {(Path(sys.prefix) / 'conda-meta').exists()}\\n\"\n   471\u2192            \"\\n\"\n   472\u2192            f\"Briefcase:       {__version__}\\n\"\n   473\u2192            f\"Target platform: {command.platform}\\n\"\n   474\u2192            f\"Target format:   {command.output_format}\\n\"\n   475\u2192            \"\\n\"\n   476\u2192            \"Environment Variables:\\n\"\n   477\u2192            f\"{sanitized_env_vars}\\n\"\n   478\u2192            \"\\n\"\n   479\u2192            \"pyproject.toml:\\n\"\n   480\u2192            f\"{pyproject_toml}\\n\"\n   481\u2192            \"\\n\"\n   482\u2192            \"Briefcase Log:\\n\"\n   483\u2192            f\"{self.print.export_log()}\"\n   484\u2192        )\n   485\u2192\n   486\u2192\n   487\u2192class NotDeadYet:\n   488\u2192    # I\u2019m getting better! No you\u2019re not, you\u2019ll be stone dead in a minute.\n   489\u2192\n   490\u2192    def __init__(self, printer: Printer):\n   491\u2192        \"\"\"A keep-alive spinner for long-running processes without console output.\n   492\u2192\n   493\u2192        Returned by the Wait Bar's context manager but can be used independently. Use in\n   494\u2192        a loop that calls update() each iteration. A keep-alive message will be printed\n   495\u2192        every 10 seconds.\n   496\u2192        \"\"\"\n   497\u2192        self.printer: Printer = printer\n   498\u2192        self.interval_sec: int = 10\n   499\u2192        self.message: str = \"... still waiting\"\n   500\u2192        self.ready_time: float = 0.0\n   501\u2192\n   502\u2192        self.reset()  # initialize\n   503\u2192\n   504\u2192    def update(self):\n   505\u2192        \"\"\"Write keep-alive message if the periodic interval has elapsed.\"\"\"\n   506\u2192        if self.ready_time < time.time():\n   507\u2192            self.printer(self.message)\n   508\u2192            self.reset()\n   509\u2192\n   510\u2192    def reset(self):\n   511\u2192        \"\"\"Initialize periodic interval to now; next message prints after interval.\"\"\"\n   512\u2192        self.ready_time = time.time() + self.interval_sec\n   513\u2192\n   514\u2192\n   515\u2192class Console:\n   516\u2192    def __init__(self, printer: Printer | None = None, enabled: bool = True):\n   517\u2192        self.enabled = enabled\n   518\u2192        self.print = Printer() if printer is None else printer\n   519\u2192        # Use Rich's input() to read from user\n   520\u2192        self.input = self.print.console.input\n   521\u2192        self._wait_bar: Progress | None = None\n   522\u2192        # Signal that Rich is dynamically controlling the console output. Therefore,\n   523\u2192        # all output must be printed to the screen by Rich to prevent corruption of\n   524\u2192        # dynamic elements like the Wait Bar.\n   525\u2192        self.is_console_controlled = False\n   526\u2192\n   527\u2192    @property\n   528\u2192    def is_interactive(self):\n   529\u2192        \"\"\"Returns interactivity mode based on the presence of a tty for stdout.\n   530\u2192\n   531\u2192        In a non-interactive session, Rich's dynamic elements like progress bars should\n   532\u2192        be disabled. By default, Rich will not render dynamic elements if a tty is not\n   533\u2192        available. However, environment variables like FORCE_COLOR can override this\n   534\u2192        behavior in Rich to not only show ANSI color and style but also dynamic\n   535\u2192        elements. In a CI environment with this configuration, a long-lived progress bar\n   536\u2192        can dramatically compromise the quality of logged output. So, dynamic elements\n   537\u2192        should be specifically disabled in non-interactive sessions.\n   538\u2192        \"\"\"\n   539\u2192        # `sys.__stdout__` is used because Rich captures and redirects `sys.stdout`\n   540\u2192        return os.isatty(sys.__stdout__.fileno())\n   541\u2192\n   542\u2192    @property\n   543\u2192    def is_color_enabled(self):\n   544\u2192        \"\"\"Is the underlying Rich console using color?\n   545\u2192\n   546\u2192        Rich can be explicitly configured to not use color at Console initialization or\n   547\u2192        the NO_COLOR environment variable; alternatively, the derived color system for\n   548\u2192        the terminal is influenced by attributes of the platform as well as FORCE_COLOR.\n   549\u2192        \"\"\"\n   550\u2192        # no_color has precedence since color_system can be set even if color is disabled\n   551\u2192        if self.print.console.no_color:\n   552\u2192            return False\n   553\u2192        else:\n   554\u2192            return self.print.console.color_system is not None\n   555\u2192\n   556\u2192    def progress_bar(self):\n   557\u2192        \"\"\"Returns a progress bar as a context manager.\"\"\"\n   558\u2192        return Progress(\n   559\u2192            TextColumn(\"  \"),\n   560\