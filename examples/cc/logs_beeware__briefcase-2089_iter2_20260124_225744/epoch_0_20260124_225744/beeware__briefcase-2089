plication\",\n   528→            override_value=project_overrides.pop(\"description\", None),\n   529→        )\n   530→\n   531→        author = self.input_text(\n   532→            intro=(\n   533→                \"Who do you want to be credited as the author of this application?\\n\"\n   534→                \"\\n\"\n   535→                \"This could be your own name, or the name of your company you work for.\"\n   536→            ),\n   537→            variable=\"author\",\n   538→            default=\"Jane Developer\",\n   539→            override_value=project_overrides.pop(\"author\", None),\n   540→        )\n   541→\n   542→        author_email = self.input_text(\n   543→            intro=(\n   544→                \"What email address should people use to contact the developers of \"\n   545→                \"this application?\\n\"\n   546→                \"\\n\"\n   547→                \"This might be your own email address, or a generic contact address \"\n   548→                \"you set up specifically for this application.\"\n   549→            ),\n   550→            variable=\"author's email\",\n   551→            default=self.make_author_email(author, bundle),\n   552→            validator=self.validate_email,\n   553→            override_value=project_overrides.pop(\"author_email\", None),\n   554→        )\n   555→\n   556→        url = self.input_text(\n   557→            intro=(\n   558→                \"What is the website URL for this application?\\n\"\n   559→                \"\\n\"\n   560→                \"If you don't have a website set up yet, you can put in a dummy URL.\"\n   561→            ),\n   562→            variable=\"application URL\",\n   563→            default=self.make_project_url(bundle, app_name),\n   564→            validator=validate_url,\n   565→            override_value=project_overrides.pop(\"url\", None),\n   566→        )\n   567→        project_license = self.input_license(\n   568→            override_value=projec