to_console(self, *messages, **kwargs):\n   140→        \"\"\"Write only to the console and skip writing to the log.\"\"\"\n   141→        self.console.print(*messages, **kwargs)\n   142→\n   143→    def to_log(self, *messages, stack_offset=5, **kwargs):\n   144→        \"\"\"Write only to the log and skip writing to the console.\"\"\"\n   145→        self.log.log(\n   146→            *map(sanitize_text, messages), _stack_offset=stack_offset, **kwargs\n   147→        )\n   148→\n   149→    def export_log(self):\n   150→        \"\"\"Export the text of the entire log; the log is also cleared.\"\"\"\n   151→        return self.log.export_text()\n   152→\n   153→\n   154→class RichLoggingStream:\n   155→    \"\"\"Stream for logging.StreamHandler that prints to console via debug logging.\"\"\"\n   156→\n   157→    def __init__(self, logger: Log):\n   158→        self.logger = logger\n   159→\n   160→    def write(self, msg: str) -> None:\n   161→        self.logger.debug(msg)\n   162→\n   163→\n   164→class RichLoggingHandler(logging.StreamHandler):\n   165    \"\"\"A debug handler for third party tools using stdlib logging.\"\"\"\n   166→\n   167→    def __init__(self, stream: RichLoggingStream):\n   168→        super().__init__(stream=stream)\n   169→        self.setLevel(logging.DEBUG)\n   170→        self.setFormatter(logging.Formatter(\"%(levelname)s %(name)s: %(message)s\"))\n   171→\n   172→\n   173→class LogLevel(IntEnum):\n   174→    INFO = 0\n   175→    VERBOSE = 1\n   176→    DEBUG = 2\n   177→    DEEP_DEBUG = 3\n   178→\n   179→\n   180→class Log:\n   181→    \"\"\"Manage logging output driven by verbosity flags.\"\"\"\n   182→\n   183→    # subdirectory of command.base_path to store log files\n   184→    LOG_DIR = \"logs\"\n   185→\n   186→    def __init__(\n   187→        self,\n   188→        printer: Printer | None = None,\n   189→        verbosity: LogLevel = LogLevel.INFO,\n   190→    ):\n   191→        self.print = Printer() if printer is None else printer\n   192→        # --verbosity flag: see LogLevel for valid values\n   193→        self.verbosity = verbosity\n   194→        # --log flag to force logfile creation\n   195→        self.save_log = False\n   196→        # flag set by exceptions to skip writing the log; save_log takes precedence.\n   197→        self.skip_log = False\n   198→        # Rich stacktraces of exceptions for logging to file.\n   199→        # A list of tuples containing a label for the thread context, and the Trace object\n   200→        self.stacktraces: list[tuple[str, Trace]] = []\n   201→        # functions to run for additional logging if creating a logfile\n   202→        self.log_file_extras: list[Callable[[], object]] = []\n   203→        # The current context for the log\n   204→        self._context = \"\"\n   205→\n   206→    @contextmanager\n   207→    def context(self, context: str):\n   208→        \"\"\"Wrap a collection of output in a logging context.\n   209→\n   210→        A logging context is a prefix on every logging line. It is used when a set of\n   211→        commands (and output) is being run in a very specific way that needs to be\n   212→        highlighted, such as running a command in a Docker container.\n   213→\n   214→        :param context: The name of the context to enter. This *must* be simple text,\n   215→            with no markup or other special characters.\n   216→        \"\"\"\n   217→        self.info()\n   218→        self.info(f\"Entering {context} context...\")\n   219→        old_context = self._context\n   220→        self._context = f\"{context}| \"\n   221→        self.info(\"-\" * (72 - len(context)))\n   222→        try:\n   223→            yield\n   224→        finally:\n   225→            self.info(\"-\" * (72 - len(context)))\n   226→            self._context = old_context\n   227→            self.info(f\"Leaving {context} context.\")\n   228→            self.info()\n   229→\n   230→    def _log(\n   231→        self,\n   232→        preface=\"\",\n   233→        prefix=\"\",\n   234→        message=\"\",\n   235→        show=True,\n   236→        markup=False,\n   237→        style=None,\n   238→    ):\n   239→        \"\"\"Funnel to log all messages.\n   240→\n   241→        :param preface: value to be printed on the far left of the message and symbolic\n   242→            of the type of message being printed.\n   243→        :param prefix: text prepended to the message wrapped in brackets and will be\n   244→            presented as dimmer compared to the styling of the message text.\n   245→        :param message: text to log; can contain Rich tags if markup=True.\n   246→        :param show: True to print message to console; False to not print it. This is to\n   247→            allow logs to be saved to a file without printing them.\n   248→        :param markup: whether to interpret Rich markup in the prefix, preface, and\n   249→            message; if True, all text must already be escaped; defaults False.\n   250→        :param style: Rich style to apply to everything printed for message.\n   251→        \"\"\"\n   252→        if not message:\n   253→            # When a message is not provided, only output the context;\n   254→            # This type of call is just clearing some vertical space.\n   255→            self.print(self._context, show=show)\n   256→        else:\n   257→            if prefix:\n   258→                # insert vertical space before for all messages with a prefix\n   259→                self.print(self._context, show=show)\n   260→                if not markup:\n   261→                    preface, prefix, message = (\n   262→                        escape(text) for text in (preface, prefix, message)\n   263→                    )\n   264→                prefix = f\"[dim]\\\\[{prefix}][/dim] \"\n   265→                markup = True\n   266→            for line in message.splitlines():\n   267→                self.print(\n   268→                    f\"{self._context}{preface}{prefix}{line}\",\n   269→                    show=show,\n   270→                    markup=markup,\n   271→                    style=style,\n   272→                )\n   273→\n   274→    def debug(self, message=\"\", *, preface=\"\", prefix=\"\", markup=False):\n   275→        \"\"\"Log messages at debug level; included if verbosity >= 2.\"\"\"\n   276→        self._log(\n   277→            preface=preface,\n   278→            prefix=prefix,\n   279→            message=message,\n   280→            show=self.is_debug,\n   281→            markup=markup,\n   282→            style=\"dim\",\n   283→        )\n   284→\n   285→    def verbose(self, message=\"\", *, prefix=\"\", markup=False):\n   286→        \"\"\"Log message at verbose level; included if verbosity >= 1.\"\"\"\n   287→        self._log(prefix=prefix, message=message, show=self.is_verbose, markup=markup)\n   288→\n   289→    def info(self, message=\"\", *, prefix=\"\", markup=False):\n   290→        \"\"\"Log message at info level; always included in output.\"\"\"\n   291→        self._log(prefix=prefix, message=message, markup=markup)\n   292→\n   293→    def warning(self, message=\"\", *, prefix=\"\", markup=False):\n   294→        \"\"\"Log message at warning level; always included in output.\"\"\"\n   295→        self._log(prefix=prefix, message=message, markup=markup, style=\"bold yellow\")\n   296→\n   297→    def error(self, message=\"\", *, prefix=\"\", markup=False):\n   298→        \"\"\"Log message at error level; always included in output.\"\"\"\n   299→        self._log(prefix=prefix, message=message, markup=markup, style=\"bold red\")\n   300→\n   301→    @property\n   302→    def verbosity(self) -> LogLevel:\n   303→        return self._verbosity\n   304→\n   305→    @verbosity.setter\n   306→    def verbosity(self, value: int | LogLevel):\n   307→        \"\"\"Clamp verbosity between valid log levels.\"\"\"\n   308→        self._verbosity = LogLevel(max(min(LogLevel), min(value, max(LogLevel))))\n   309→\n   310→    @property\n   311→    def is_verbose(self):\n   312→        \"\"\"Is verbose logging enabled via the -v flag?\n   313→\n   314→        This includes Briefcase logging that isn't relevant during normal operation.\n   315→        \"\"\"\n   316→        return self.verbosity >= LogLevel.VERBOSE\n   317→\n   318→    @property\n   319→    def is_debug(self):\n   320→        \"\"\"Is debug logging enabled via the -vv flag?\n   321→\n   322→        This includes debug logging from third party tools.\n   323→        \"\"\"\n   324→        return self.verbosity >= LogLevel.DEBUG\n   325→\n   326→    @property\n   327→    def is_deep_debug(self):\n   328→        \"\"\"Is deep debug logging enabled via the -vvv flag?\n   329→\n   330→        This includes debug logging from third party tools.\n   331→        \"\"\"\n   332→        return self.verbosity >= LogLevel.DEEP_DEBUG\n   333→\n   334→    def configure_stdlib_logging(self, logger_name: str):\n   335→        \"\"\"Configure stdlib logging for a third party tool to log through Rich.\n   336→\n   337→        When a third party tool written in Python uses the stdlib logging for their\n   338→        logging, it may provide an abstraction to enable the logging in the console or\n   339→        may require a handler to be added externally. Either way, the default handler\n   340→        to write to the console, i.e. logging.StreamHandler, will bypass Rich logging\n   341→        and therefore not be included in the logfile. To avoid this issue, this will\n   342→        add a handler that specifically writes to the console through Rich.\n   343→\n   344→        :param logger_name: Name of the logger the third party tool uses. Typically,\n   345→            this is the package name or path to a submodule for the package. Since\n   346→            logging uses namespaces for logging, enabling DEBUG logging for `git` will\n   347→            also enable it for others like `git.cmd`, `git.remote`, `git.config`, etc.\n   348→        \"\"\"\n   349→        if not self.is_deep_debug:\n   350→            return\n   351→\n   352→        logger = logging.getLogger(logger_name)\n   353→\n   354→        # do not add another rich handler if one already exists\n   355→        if not any(isinstance(h, RichLoggingHandler) for h in logger.handlers):\n   356→            logger.addHandler(RichLoggingHandler(stream=RichLoggingStream(logger=self)))\n   357→            logger.setLevel(logging.DEBUG)\n   358→\n   359→    def capture_stacktrace(self, label=\"Main thread\"):\n   360→        \"\"\"Preserve Rich stacktrace from exception while in except block.\n   361→\n   362→        :param label: An identifying label for the thread that has raised the\n   363→            stacktrace. Defaults to the main thread.\n   364→        \"\"\"\n   365→        exc_info = sys.exc_info()\n   366→        try:\n   367→            self.skip_log = exc_info[1].skip_logfile\n   368→        except AttributeError:\n   369→            pass\n   370→\n   371→        self.stacktraces.append((label, Traceback.extract(*exc_info, show_locals=True)))\n   372→\n   373→    def add_log_file_extra(self, func: Callable[[], object]):\n   374→        \"\"\"Register a function to be called in the event that a log file is written.\n   375→\n   376→        This can be used to provide additional debugging information which is too\n   377→        expensive to gather pre-emptively.\n   378→        \"\"\"\n   379→        self.log_file_extras.append(func)\n   380→\n   381→    def save_log_to_file(self, command):\n   382→        \"\"\"Save the current application log to file.\"\"\"\n   383→        # A log file is always written if a Command ran and `--log` was provided.\n   384→        # If `--log` was not provided, then the log is written when an exception\n   385→        # occurred and the exception was not explicitly configured to skip the log.\n   386→        if not (\n   387→            command and (self.save_log or (self.stacktraces and not self.skip_log))\n   388→        ):\n   389→            return\n   390→\n   391→        with command.input.wait_bar(\"Saving log...\", transient=True):\n   392→            self.print.to_console()\n   393→            log_filename = f\"briefcase.{datetime.now().strftime('%Y_%m_%d-%H_%M_%S')}.{command.command}.log\"\n   394→            log_filepath = command.base_path / self.LOG_DIR / log_filename\n   395→            try:\n   396→                log_filepath.parent.mkdir(parents=True, exist_ok=True)\n   397→                with open(\n   398→                    log_filepath, \"w\", encoding=\"utf-8\", errors=\"backslashreplace\"\n   399→                ) as log_file:\n   400→                    log_file.write(self._build_log(command))\n   401→            except OSError as e:\n   402→                self.error(f\"Failed to save log to {log_filepath}: {e}\")\n   403→            else:\n   404→                self.warning(f\"Log saved to {log_filepath}\")\n   405→            self.print.to_console()\n   406→\n   407→    def _build_log(self, command) -> str:\n   408→        \"\"\"Accumulate all information to include in the log file.\"\"\"\n   409→        # Add the exception stacktraces to end of log if any were captured\n   410→        if self.stacktraces:\n   411→            # using print.log.print() instead of print.to_log() to avoid\n   412→            # timestamp and code location inclusion for the stacktrace box.\n   413→            for thread, stacktrace in self.stacktraces:\n   414→                self.print.log.print(\n   415→                    f\"{thread} traceback:\",\n   416→                    Traceback(\n   417→                        trace=stacktrace,\n   418→                        width=self.print.log_width,\n   419→                        show_locals=True,\n   420→                    ),\n   421→                    new_line_start=True,\n   422→                )\n   423→\n   424→        # Retrieve additional logging added by