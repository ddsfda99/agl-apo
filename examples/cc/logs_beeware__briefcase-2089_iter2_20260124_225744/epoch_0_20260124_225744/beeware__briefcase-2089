 # Sort the options alphabetically first\n   645→        ordered = OrderedDict(sorted(bootstraps.items()))\n   646→\n   647→        # Ensure the first 5 options are: Toga, PySide6, Pygame\n   648→        ordered.move_to_end(\"Pygame\", last=False)\n   649→        ordered.move_to_end(\"PySide6\", last=False)\n   650→        ordered.move_to_end(\"Toga\", last=False)\n   651→\n   652→        # Option None should always be last\n   653→        ordered[\"None\"] = None\n   654→        ordered.move_to_end(\"None\")\n   655→\n   656→        # Construct the bootstrap options as they should be presented to users.\n   657→        # The name of the bootstrap is its registered entry point name. Along with the\n   658→        # bootstrap's name, a short message important to a user's choice can be shown\n   659→        # also; for instance, several show \"does not support iOS/Android deployment\".\n   660→        bootstrap_choices = {}\n   661→        max_len = max(map(len, ordered))\n   662→        for name, klass in ordered.items():\n   663→            if annotation := getattr(klass, \"display_name_annotation\", \"\"):\n   664→                annotation = f\"{' ' * (max_len - len(name))} ({annotation})\"\n   665→            bootstrap_choices[f\"{name}{annotation or ''}\"] = klass\n   666→\n   667→        return bootstrap_choices\n   668→\n   669→    def warn_unused_overrides(self, project_overrides: dict[str, str] | None):\n   670→        \"\"\"Inform user of project configuration overrides that were not used.\"\"\"\n   671→        if project_overrides:\n   672→            unused_overrides = \"\\n    \".join(\n   673→                f\"{key} = {value}\" for key, value in project_overrides.items()\n   674→            )\n   675→            self.logger.warning()\n   676→            self.logger.warning(\n   677→                \"WARNING: These project configuration overrides were not used:\\n\\n\"\n   678→                f\"    {unused_overrides}\"\n   679→            )\n   680→\n 