93\u2192        \"\"\"\n   694\u2192        self.input.prompt()\n   695\u2192        self.input.prompt(\"Let's setup an existing project as a Briefcase app!\")\n   696\u2192        context = self.build_context(project_overrides)\n   697\u2192        self.prompt_divider()  # close the prompting section of output\n   698\u2192\n   699\u2192        self.warn_unused_overrides(project_overrides)\n   700\u2192\n   701\u2192        self.logger.info()\n   702\u2192        self.logger.info(\n   703\u2192            f\"Generating required files to set up '{context['formal_name']}' with Briefcase\",\n   704\u2192            prefix=context[\"app_name\"],\n   705\u2192        )\n   706\u2192\n   707\u2192        # Create the project files\n   708\u2192        self.generate_template(\n   709\u2192            template=(\n   710\u2192                template\n   711\u2192                if template\n   712\u2192                else \"https://github.com/beeware/briefcase-template\"\n   713\u2192            ),\n   714\u2192            branch=template_branch,\n   715\u2192            output_path=tmp_path,\n   716\u2192            extra_context=context,\n   717\u2192        )\n   718\u2192\n   719\u2192        project_dir = tmp_path / context[\"app_name\"]\n   720\u2192        self.migrate_necessary_files(\n   721\u2192            project_dir, context[\"test_source_dir\"], context[\"module_name\"]\n   722\u2192        )\n   723\u2192\n   724\u2192        self.logger.info(\n   725\u2192            f\"Converted existing application '{context['formal_name']}'\",\n   726\u2192            prefix=context[\"app_name\"],\n   727\u2192        )\n   728\u2192        self.logger.info(\n   729\u2192            \"\"\"\n   730\u2192To run your application, type:\n   731\u2192\n   732\u2192    $ briefcase dev\n   733\u2192\n   734\u2192\"\"\"\n   735\u2192        )\n   736\u2192\n   737\u2192    def validate_pyproject_file(self) -> None:\n   738\u2192        \"\"\"Cannot setup new app if it already h