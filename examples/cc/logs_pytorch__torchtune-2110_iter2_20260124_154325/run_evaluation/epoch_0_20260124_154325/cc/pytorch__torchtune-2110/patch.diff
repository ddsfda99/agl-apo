+def _resolve_image_location(image_dir: Optional[Path], image_path: Union[str, Path]) -> Union[Path, str]:
+    s = str(image_path)
+    parsed = urlparse(s)
+    if parsed.scheme:
+        # Remote URL or other scheme; return string as-is
+        return s
+    p = Path(s)
+    if p.is_absolute():
+        # Always normalize absolute local paths to Path
+        return p
+    if image_dir is not None:
+        # Join relative with provided image_dir
+        return image_dir / s
+    # No image_dir: preserve provided type for relative local paths
+    if isinstance(image_path, str):
+        return s
+    else:
+        return p
+
