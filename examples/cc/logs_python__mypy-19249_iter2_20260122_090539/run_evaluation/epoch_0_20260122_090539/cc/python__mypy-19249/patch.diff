+def is_bool_like_type(t: Type) -> bool:
+    tp = get_proper_type(t)
+    if isinstance(tp, UnionType):
+        return any(is_bool_like_type(item) for item in tp.items)
+    if isinstance(tp, Instance):
+        return tp.type.fullname == "builtins.bool"
+    if isinstance(tp, LiteralType):
+        fb = get_proper_type(tp.fallback)
+        return isinstance(fb, Instance) and fb.type.fullname == "builtins.bool"
+    return False
+
 class TooManyUnions(Exception):
