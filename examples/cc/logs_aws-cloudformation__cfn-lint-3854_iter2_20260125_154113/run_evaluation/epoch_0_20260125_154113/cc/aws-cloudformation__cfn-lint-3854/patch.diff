+class TestNestedForEachDependsOnOuter(TestCase):
+    def setUp(self) -> None:
+        # Template where inner collection depends on outer identifier via Ref
+        self.template_obj = convert_dict(
+            {
+                "Transform": ["AWS::LanguageExtensions"],
+                "Mappings": {
+                    "GroupToIds": {
+                        "Group1": {"Items": ["1", "2"]},
+                        "Group2": {"Items": ["3"]},
+                    }
+                },
+                "Conditions": {
+                    "ShouldCreateBucket3": {"Fn::Equals": ["3", "3"]}
+                },
+                "Resources": {
+                    "Fn::ForEach::Groups": [
+                        "Group",
+                        ["Group1", "Group2"],
+                        {
+                            "Fn::ForEach::Buckets": [
+                                "BucketId",
+                                {
+                                    "Fn::FindInMap": [
+                                        "GroupToIds",
+                                        {"Ref": "Group"},
+                                        "Items",
+                                    ]
+                                },
+                                {
+                                    "BucketGroup${Group}Bucket${BucketId}": {
+                                        "Type": "AWS::S3::Bucket",
+                                        "Condition": "ShouldCreateBucket3",
+                                        "Properties": {
+                                            "BucketName": {
+                                                "Fn::Sub": "bucket-${Group}-${BucketId}-${AWS::Region}"
+                                            }
+                                        },
+                                    }
+                                },
+                            ]
+                        },
+                    ]
+                },
+            }
+        )
+
+    def test_transform_nested_depends_on_outer(self):
+        cfn = Template(filename="", template=self.template_obj, regions=["us-east-2"])
+        matches, template = language_extension(cfn)
+        self.assertListEqual(matches, [])
+        resources = template.get("Resources", {})
+        self.assertIn("BucketGroupGroup2Bucket3", resources)
+        self.assertEqual(
+            resources["BucketGroupGroup2Bucket3"].get("Condition"),
+            "ShouldCreateBucket3",
+        )
