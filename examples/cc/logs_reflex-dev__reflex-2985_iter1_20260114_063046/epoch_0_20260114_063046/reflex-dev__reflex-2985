2    Args:\n   744\u2192        value: The JSON string to unwrap.\n   745\u2192\n   746\u2192    Returns:\n   747\u2192        The unwrapped JSON string.\n   748\u2192    \"\"\"\n   749\u2192\n   750\u2192    def unescape_double_quotes_in_var(m: re.Match) -> str:\n   751\u2192        prefix = m.group(1) or \"\"\n   752\u2192        # Since the outer quotes are removed, the inner escaped quotes must be unescaped.\n   753\u2192        return prefix + re.sub('\\\\\\\\\"', '\"', m.group(2))\n   754\u2192\n   755\u2192    # This substitution is necessary to unwrap var values.\n   756\u2192    return (\n   757\u2192        re.sub(\n   758\u2192            pattern=r\"\"\"\n   759\u2192            (?<!\\\\)      # must NOT start with a backslash\n   760\u2192            \"            # match opening double quote of JSON value\n   761\u2192            (<reflex.Var>.*?</reflex.Var>)?  # Optional encoded VarData (non-greedy)\n   762\u2192            {(.*?)}      # extract the value between curly braces (non-greedy)\n   763\u2192            \"            # match must end with an unescaped double quote\n   764\u2192        \"\"\",\n   765\u2192            repl=unescape_double_quotes_in_var,\n   766\u2192            string=value,\n   767\u2192            flags=re.VERBOSE,\n   768\u2192        )\n   769\u2192        .replace('\"`', \"`\")\n   770\u2192        .replace('`\"', \"`\")\n   771\u2192    )\n   772\u2192\n   773\u2192\n   774\u2192def collect_form_dict_names(form_dict: dict[str, Any]) -> dict[str, Any]:\n   775\u2192    \"\"\"Collapse keys with consecutive suffixes into a single list value.\n   776\u2192\n   777\u2192    Separators dash and underscore are removed, unless this would overwrite an existing key.\n   778\u2192\n   779\u2192    Args:\n   780\u2192        form_dict: The dict to collapse.\n   781\u2192\n   782\u2192    Returns:\n   783\u2192        The collapsed dict.\n   784\u2192    \"\"\"\n   785\u2192    ending_digit_regex = re.compile(r\"^(.*?)[_-]?(\\d+)$\")\n   786\u2192    collapsed = {}\n   787\u2192    for k in sorted(form_dict):\n   788\u2192        m = ending_digit_regex.match(k)\n   789\u2192        if m:\n   790\u2192            collapsed.setdefault(m.group(1), []).append(form_dict[k])\n   791\u2192    # collapsing never overwrites valid data from the form_dict\n   792\u2192    collapsed.update(form_dict)\n   793\u2192    return collapsed\n   794\u2192\n   795\u2192\n   796\u2192def format_data_editor_column(col: str | dict):\n   797\u2192    \"\"\"Format a given column into the proper format.\n   798\u2192\n   799\u2192    Args:\n   800\u2192        col: The column.\n   801\u2192\n   802\u2192    Raises:\n   803\u2192        ValueError: invalid type provided for column.\n   804\u2192\n   805\u2192    Returns:\n   806\u2192        The formatted column.\n   807\u2192    \"\"\"\n   808\u2192    if isinstance(col, str):\n   809\u2192        return {\"title\": col, \"id\": col.lower(), \"type\": \"str\"}\n   810\u2192\n   811\u2192    if isinstance(col, (dict,)):\n   812\u2192        if \"id\" not in col:\n   813\u2192            col[\"id\"] = col[\"title\"].lower()\n   814\u2192        if \"type\" not in col:\n   815\u2192            col[\"type\"] = \"str\"\n   816\u2192        if \"overlayIcon\" not in col:\n   817\u2192            col[\"overlayIcon\"] = None\n   818\u2192        return col\n   819\u2192\n   820\u2192    if isinstance(col, BaseVar):\n   821\u2192        return col\n   822\u2192\n   823\u2192    raise ValueError(\n   824\u2192        f\"unexpected type ({(type(col).__name__)}: {col}) for column header in data_editor\"\n   825\u2192    )\n   826\u2192\n   827\u2192\n   828\u2192def format_data_editor_cell(cell: Any):\n   829\u2192    \"\"\"Format a given data into a renderable cell for data_editor.\n   830\u2192\n   831\u2192    Args:\n   832\u2192        cell: The data to format.\n   833\u2192\n   834\u2192    Returns:\n   835\u2192        The formatted cell.\n   836\u2192    \"\"\"\n   837\u219