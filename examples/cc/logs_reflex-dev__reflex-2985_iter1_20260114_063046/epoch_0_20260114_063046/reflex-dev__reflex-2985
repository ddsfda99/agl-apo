, {format_var(event_arg)}\" if event_arg else \"\",\n   588\u2192            \")\",\n   589\u2192        ]\n   590\u2192    )\n   591\u2192\n   592\u2192\n   593\u2192def format_query_params(router_data: dict[str, Any]) -> dict[str, str]:\n   594\u2192    \"\"\"Convert back query params name to python-friendly case.\n   595\u2192\n   596\u2192    Args:\n   597\u2192        router_data: the router_data dict containing the query params\n   598\u2192\n   599\u2192    Returns:\n   600\u2192        The reformatted query params\n   601\u2192    \"\"\"\n   602\u2192    params = router_data[constants.RouteVar.QUERY]\n   603\u2192    return {k.replace(\"-\", \"_\"): v for k, v in params.items()}\n   604\u2192\n   605\u2192\n   606\u2192def format_state(value: Any, key: Optional[str] = None) -> Any:\n   607\u2192    \"\"\"Recursively format values in the given state.\n   608\u2192\n   609\u2192    Args:\n   610\u2192        value: The state to format.\n   611\u2192        key: The key associated with the value (optional).\n   612\u2192\n   613\u2192    Returns:\n   614\u2192        The formatted state.\n   615\u2192\n   616\u2192    Raises:\n   617\u2192        TypeError: If the given value is not a valid state.\n   618\u2192    \"\"\"\n   619\u2192    # Handle dicts.\n   620\u2192    if isinstance(value, dict):\n   621\u2192        return {k: format_state(v, k) for k, v in value.items()}\n   622\u2192\n   623\u2192    # Handle lists, sets, typles.\n   624\u2192    if isinstance(value, types.StateIterBases):\n   625\u2192        return [format_state(v) for v in value]\n   626\u2192\n   627\u2192    # Return state vars as is.\n   628\u2192    if isinstance(value, types.StateBases):\n   629\u2192        return value\n   630\u2192\n   631\u2192    # Serialize the value.\n   632\u2192    serialized = serialize(value)\n   633\u2192    if serialized is not None:\n   634\u2192        return serialized\n   635\u2192\n   636\u2192    if key is None:\n   637\u2192        raise TypeErro