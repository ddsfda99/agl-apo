+def test_tuple_indexing_infers_element_type_and_allows_comparison():
+    """Tuple indexing should infer the correct element type so comparisons work.
+
+    This reproduces a bug where indexing into a Tuple[str, int, int] always
+    inferred the first element type (str), causing comparisons with ints to fail.
+    """
+    t = BaseVar(_var_name="word", _var_type=Tuple[str, int, int])
+
+    # Verify type inference for different indices
+    assert t[0]._var_type == str
+    assert t[1]._var_type == int
+    assert t[2]._var_type == int
+
+    # Should not raise TypeError: comparing int (tuple element) with int is valid
+    left = t[2]
+    right = BaseVar(_var_name="end", _var_type=int)
+    # Execute the operation; it should succeed without raising
+    result = left <= right
+    # Sanity check on the rendered expression
+    assert str(result) == "{(word.at(2) <= end)}"
+
+
