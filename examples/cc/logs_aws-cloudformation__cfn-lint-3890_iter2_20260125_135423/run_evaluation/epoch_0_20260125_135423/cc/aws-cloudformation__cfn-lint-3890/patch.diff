@@ -94,12 +94,24 @@ class SnapStartSupported(CfnLintKeyword):
             if not isinstance(runtime, str):
                 continue
 
-            if (
-                runtime
-                and (not runtime.startswith("java"))
-                and runtime not in ["java8.al2", "java8"]
