+                    version_num = "".join(ch for ch in version_part if ch.isdigit())
+                    if version_num:
+                        allowed = int(version_num) >= 11
+                except Exception:
+                    allowed = False
+            elif runtime == "python3.12":
+                allowed = True
+
+            if not allowed:
                 yield ValidationError(
