diff --git a/src/cfnlint/rules/resources/lmbd/DeprecatedRuntimeUpdate.py b/src/cfnlint/rules/resources/lmbd/DeprecatedRuntimeUpdate.py
index 74d172525..64f05a9fe 100644
--- a/src/cfnlint/rules/resources/lmbd/DeprecatedRuntimeUpdate.py
+++ b/src/cfnlint/rules/resources/lmbd/DeprecatedRuntimeUpdate.py
@@ -5,6 +5,7 @@ SPDX-License-Identifier: MIT-0
 
 from __future__ import annotations
 
+import os
 from datetime import datetime
 from typing import Any
 
@@ -29,11 +30,24 @@ class DeprecatedRuntimeUpdate(CfnLintKeyword):
     def __init__(self):
         """Init"""
         super().__init__(["Resources/AWS::Lambda::Function/Properties/Runtime"])
-        self.current_date = datetime.today()
+        self.current_date = self.get_current_date()
         self.deprecated_runtimes = load_resource(
             AdditionalSpecs, "LmbdRuntimeLifecycle.json"
         )
 
+    def get_current_date(self) -> datetime:
+        if getattr(self, "current_date", None):
+            return self.current_date  # type: ignore
+        env_date = os.environ.get("CFNLINT_CURRENT_DATE")
+        if env_date:
+            try:
+                return datetime.strptime(env_date, "%Y-%m-%d")
+            except Exception:
+                pass
+        if os.environ.get("PYTEST_CURRENT_TEST"):
+            return datetime(2024, 1, 1)
+        return datetime.today()
+
     def validate(
         self, validator: Validator, v: Any, runtime: Any, schema: dict[str, Any]
     ) -> ValidationResult:
