ML or CSV formats. This is\n   531\u2192    intended as a convenient little function for dumping trees of data for\n   532\u2192    debugging purposes.\n   533\u2192\n   534\u2192    Args:\n   535\u2192      root_account: A RealAccount instance.\n   536\u2192    Returns:\n   537\u2192      A list of tuples of (first_line, continuation_line, real_account) where\n   538\u2192        first_line: A string, the first line to render, which includes the\n   539\u2192          account name.\n   540\u2192        continuation_line: A string, further line to render if necessary.\n   541\u2192        real_account: The RealAccount instance which corresponds to this\n   542\u2192          line.\n   543\u2192    \"\"\"\n   544\u2192    # Compute all the lines ahead of time in order to calculate the width.\n   545\u2192    lines = []\n   546\u2192\n   547\u2192    # Start with the root node. We push the constant prefix before this node,\n   548\u2192    # the account name, and the RealAccount instance. We will maintain a stack\n   549\u2192    # of children nodes to render.\n   550\u2192    stack = [('', root_account.account, root_account, True)]\n   551\u2192    while stack:\n   552\u2192        prefix, name, real_account, is_last = stack.pop(-1)\n   553\u2192\n   554\u2192        if real_account is root_account:\n   555\u2192            # For the root node, we don't want to render any prefix.\n   556\u2192            first = cont = ''\n   557\u2192        else:\n   558\u2192            # Compute the string that precedes the name directly and the one below\n   559\u2192            # that for the continuation lines.\n   560\u2192            #  |\n   561\u2192            #  @@@ Bank1    <----------------\n   562\u2192            #  @@@ |\n   563\u2192            #  |   |-- Checking\n   564\u2192            if is_last:\n   565\u2192                first = prefix + PREFIX_LEAF_1\n   566\u2192                cont = prefix + PREFIX_LEAF_C\n   567\u2192            else:\n   568\u2192                first = prefix + PREFIX_CHILD_1\n   569\u2192                cont = prefix + PREFIX_CHILD_C\n   570\u2192\n   571\u2192        # Compute the name to render for continuation lines.\n   572\u2192        #  |\n   573\u2192        #  |-- Bank1\n   574\u2192        #  |   @@@       <----------------\n   575\u2192        #  |   |-- Checking\n   576\u2192        if len(real_account) > 0:\n   577\u2192            cont_name = PREFIX_CHILD_C\n   578\u2192        else:\n   579\u2192            cont_name = PREFIX_LEAF_C\n   580\u2192\n   581\u2192        # Add a line for this account.\n   582\u2192        if not (real_account is root_account and not name):\n   583\u2192            lines.append((first + name,\n   584\u2192                          cont + cont_name,\n   585\u2192                          real_account))\n   586\u2192\n   587\u2192        # Push the children onto the stack, being careful with ordering and\n   588\u2192        # marking the last node as such.\n   589\u2192        child_items = sorted(real_account.items(), reverse=True)\n   590\u2192        if child_items:\n   591\u2192            child_iter = iter(child_items)\n   592\u2192            child_name, child_account = next(child_iter)\n   593\u2192            stack.append((cont, child_name, child_account, True))\n   594\u2192            for child_name, child_account in child_iter:\n   595\u2192                stack.append((cont, child_name, child_account, False))\n   596\u2192\n   597\u2192    if not lines:\n   598\u2192        return lines\n   599\u2192\n   600\u2192    # Compute the maximum width of the lines and convert all of them to the same\n   601\u2192    # maximal width. This makes it easy on the client.\n   602\u2192    max_width = max(len(first_line) for first_line, _, __ in lines)\n   603\u2192    line_format = '{{:{width}}}'.format(width=max_width)\n   604\u2192    return [(line_format.format(first_line),\n   605\u2192             line_format.format(cont_line),\n   606\u2192             real_node)\n   607\u2192            for (first_line, cont_line, real_node) in lines]\n   608\u2192\n   609\u2192\n   610\u2192PREFIX_CHILD_1 = '|-- '\n   611\u2192PREFIX_CHILD_C = '|   '\n   612\u2192PREFIX_LEAF_1 = '`-- '\n   613\u2192PREFIX_LEAF_C = '    '\n   614\u2192\n   615\u2192\n   616\u2192def dump_balances(real_root, dformat, at_cost=False, fullnames=False, file=None):\n   617\u2192    \"\"\"Dump a realization tree with balances.\n   618\u2192\n   619\u2192    Args:\n   620\u2192      real_root: An instance of RealAccount.\n   621\u2192      dformat: An instance of DisplayFormatter to format the numbers with.\n   622\u2192      at_cost: A boolean, if true, render the values at cost.\n   623\u2192      fullnames: A boolean, if true, don't render a tree of accounts and\n   624\u2192        render the full account names.\n   625\u2192      file: A file object to dump the output to. If not specified, we\n   626\u2192        return the output as a string.\n   627\u2192    Returns:\n   628\u2192      A string, the rendered tree, or nothing, if 'file' was provided.\n   629\u2192    \"\"\"\n   630\u2192    if fullnames:\n   631\u2192        # Compute the maximum account name length;\n   632\u2192        maxlen = max(len(real_child.account)\n   633\u2192                     for real_child in iter_children(real_root, leaf_only=True))\n   634\u2192        line_format = '{{:{width}}} {{}}\\n'.format(width=maxlen)\n   635\u2192    else:\n   636\u2192        line_format = '{}       {}\\n'\n   637\u2192\n   638\u2192    output = file or io.StringIO()\n   639\u2192    for first_line, cont_line, real_account in dump(real_root):\n   640\u2192        if not real_account.balance.is_empty():\n   641\u2192            if at_cost:\n   642\u2192                rinv = real_account.balance.reduce(convert.get_cost)\n   643\u2192            else:\n   644\u2192                rinv = real_account.balance.reduce(convert.get_units)\n   645\u2192            amounts = [position.units for position in rinv.get_positions()]\n   646\u2192            positions = [amount_.to_string(dformat)\n   647\u2192                         for amount_ in sorted(amounts, key=amount.sortkey)]\n   648\u2192        else:\n   649\u2192            positions = ['']\n   650\u2192\n   651\u2192        if fullnames:\n   652\u2192            for position in positions:\n   653\u2192                if not position and len(real_account) > 0:\n   654\u2192                    continue  # Skip parent accounts with no position to render.\n   655\u2192                output.write(line_format.format(real_account.account, position))\n   656\u2192        else:\n   657\u2192            line = first_line\n   658\u2192            for position in positions:\n   659\u2192                output.write(line_format.format(line, position))\n   660\u2192                line = cont_line\n   661\u2192\n   662\u2192    if file is None:\n   663\u2192        return output.getvalue()\n   664\u2192\n   665\u2192\n   666\u2192def compute_postings_balance(txn_postings):\n   667\u2192    \"\"\"Compute the balance of a list of Postings's or TxnPosting's positions.\n   668\u2192\n   669\u2192    Args:\n   670\u2192      postings: A list of Posting instances and other directives (which are\n   671\u2192        skipped).\n   672\u2192    Returns:\n   673\u2192      An Inventory.\n   674\u2192    \"\"\"\n   675\u2192    final_balance = inventory.Inventory()\n   676\u2192    for txn_posting in txn_postings:\n   677\u2192        if isinstance(txn_posting, Posting):\n   678\u2192            final_balance.add_position(txn_posting)\n   679\u2192        elif isinstance(txn_posting, TxnPosting):\n   680\u2192            final_balance.add_position(txn_posting.posting)\n   681\u2192    return final_balance\n   682\u2192\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"
