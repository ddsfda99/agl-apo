                    {
                        "tool_use_id": "call_vbVqeBySdhYGp4lb9KboGRMk",
                        "type": "tool_result",
                        "content": "     1\u2192\"\"\"A container for an inventory of positions.\n     2\u2192\n     3\u2192This module provides a container class that can hold positions. An inventory is\n     4\u2192a mapping of positions, where each position is keyed by\n     5\u2192\n     6\u2192  (currency: str, cost: Cost) -> position: Position\n     7\u2192\n     8\u2192where\n     9\u2192\n    10\u2192  'currency': The commodity under consideration, USD, CAD, or stock units such\n    11\u2192     as HOOL, MSFT, AAPL, etc.;\n    12\u2192\n    13\u2192  'cost': None or a Cost instance existing of cost currency, number, date, and\n    14\u2192     label;\n    15\u2192\n    16\u2192  'position': A Position object, whose 'units' attribute is guaranteed to have\n    17\u2192    the same currency as 'currency' and whose 'cost' attribute is equal to the\n    18\u2192    'cost' key. It basically stores the number of units.\n    19\u2192\n    20\u2192This is meant to accommodate both booked and non-booked amounts. The clever\n    21\u2192trick that we pull to do this is that for positions which aren't booked, we\n    22\u2192simply leave the 'cost' as None. This is the case for most of the transactions.\n    23\u2192\n    24\u2192= Conversions =\n    25\u2192\n    26\u2192If it often desired to convert this inventory into an equivalent position for\n    27\u2192its cost, or to just flatten all the positions with the same currency and count\n    28\u2192the number of units, or to compute the market value for the inventory at a\n    29\u2192specific date. You do these conversions using the reduce() method:\n    30\u2192\n    31\u2192  inventory.reduce(convert.get_cost)\n    32\u2192  inventory.reduce(convert.get_units)\n    33\u2192  inventory.reduce(convert.get_value, price_map, date)\n    34\u2192\n    35\u2192\"\"\"\n    36\u2192__copyright__ = \"Copyright (C) 2013-2017  Martin Blais\"\n    37\u2192__license__ = \"GNU GPLv2\"\n    38\u2192\n    39\u2192import collections\n    40\u2192from collections.abc import Iterable\n    41\u2192from decimal import Decimal\n    42\u2192import enum\n    43\u2192import re\n    44\u2192\n    45\u2192from beancount.core.number import ZERO\n    46\u2192from beancount.core.number import same_sign\n    47\u2192from beancount.core.amount import Amount\n    48\u2192from beancount.core.position import Cost\n    49\u2192from beancount.core.position import Position\n    50\u2192from beancount.core.position import from_string as position_from_string\n    51\u2192from beancount.core import convert\n    52\u2192from beancount.core.display_context import DEFAULT_FORMATTER\n    53\u2192\n    54\u2192\n    55\u2192# Enable this in tests to assert types being passed to Inventory.\n    56\u2192ASSERTS_TYPES = False\n    57\u2192\n    58\u2192\n    59\u2192class MatchResult(enum.Enum):\n    60\u2192    \"\"\"Result of booking a new lot to an existing inventory.\"\"\"\n    61\u2192    # A new lot was created.\n    62\u2192    CREATED = 1\n    63\u2192    # An existing lot was reduced.\n    64\u2192    REDUCED = 2\n    65\u2192    # An existing lot was augmented.\n    66\u2192    AUGMENTED = 3\n    67\u2192    # No change was applied.\n    68\u2192    IGNORED = 4\n    69\u2192\n    70\u2192\n    71\u2192# FIXME: You should disallow __getitem__, __delitem__ and __setitem__.\n    72\u2192# Move the dict inside the container.\n    73\u2192class Inventory(dict):\n    74\u2192    \"\"\"An Inventory is a set of positions, indexed for efficiency.\n    75\u2192    \"\"\"\n    76\u2192\n    77\u2192    def __init__(self, positions=None):\n    78\u2192        \"\"\"Create a new inventory using a list of existing positions.\n    79\u2192\n    80\u2192        Args:\n    81\u2192          positions: A list of Position instances or an existing dict or\n    82\u2192            Inventory instance.\n    83\u2192        \"\"\"\n    84\u2192        if isinstance(positions, (dict, Inventory)):\n    85\u2192            dict.__init__(self, positions)\n    86\u2192        else:\n    87\u2192            dict.__init__(self)\n    88\u2192            if positions:\n    89\u2192                assert isinstance(positions, Iterable)\n    90\u2192                for position in positions:\n    91\u2192                    self.add_position(position)\n    92\u2192\n    93\u2192    def __iter__(self):\n    94\u2192        \"\"\"Iterate over the positions. Note that there is no guaranteed order.\"\"\"\n    95\u2192        return iter(self.values())\n    96\u2192\n    97\u2192    def __lt__(self, other):\n    98\u2192        \"\"\"Inequality comparison operator.\"\"\"\n    99\u2192        return sorted(self) < sorted(other)\n   100\u2192\n   101\u2192    # TODO(blais): In v3, remove 'parens' and never render parens. (What a\n   102\u2192    # stupid idea this was.)\n   103\u2192    def to_string(self, dformat=DEFAULT_FORMATTER, parens=True):\n   104\u2192        \"\"\"Convert an Inventory instance to a printable string.\n   105\u2192\n   106\u2192        Args:\n   107\u2192          dformat: An instance of DisplayFormatter.\n   108\u2192          parents: A boolean, true if we should surround the results by parentheses.\n   109\u2192        Returns:\n   110\u2192          A formatted string of the quantized amount and symbol.\n   111\u2192        \"\"\"\n   112\u2192        fmt = '({})' if parens else '{}'\n   113\u2192        return fmt.format(\n   114\u2192            ', '.join(pos.to_string(dformat) for pos in sorted(self)))\n   115\u2192\n   116\u2192    def __str__(self):\n   117\u2192        \"\"\"Render as a human-readable string.\n   118\u2192\n   119\u2192        Returns:\n   120\u2192          A string, for human consumption.\n   121\u2192        \"\"\"\n   122\u2192        return self.to_string()\n   123\u2192\n   124\u2192    __repr__ = __str__\n   125\u2192\n   126\u2192    def is_empty(self):\n   127\u2192        \"\"\"Return true if the inventory is empty, that is, has no positions.\n   128\u2192\n   129\u2192        Returns:\n   130\u2192          A boolean.\n   131\u2192        \"\"\"\n   132\u2192        return len(self) == 0\n   133\u2192\n   134\u2192    def __bool__(self):\n   135\u2192        # Don't define this, be explicit by using is_empty() instead.\n   136\u2192        raise NotImplementedError(\"Use explicit is_empty() method instead.\")\n   137\u2192\n   138\u2192    def __copy__(self):\n   139\u2192        \"\"\"A shallow copy of this inventory object.\n   140\u2192\n   141\u2192        Returns:\n   142\u2192          An instance of Inventory, equal to this one.\n   143\u2192        \"\"\"\n   144\u2192        return Inventory(self)\n   145\u2192\n   146\u2192    def is_small(self, tolerances):\n   147\u2192        \"\"\"Return true if all the positions in the inventory are small.\n   148\u2192\n   149\u2192        Args:\n   150\u2192          tolerances: A Decimal, the small number of units under which a position\n   151\u2192            is considered small, or a dict of currency to such epsilon precision.\n   152\u2192        Returns:\n   153\u2192          A boolean.\n   154\u2192        \"\"\"\n   155\u2192        if isinstance(tolerances, dict):\n   156\u2192            for position in self:\n   157\u2192                tolerance = tolerances.get(position.units.currency, ZERO)\n   158\u2192                if abs(position.units.number) > tolerance:\n   159\u2192                    return False\n   160\u2192            small = True\n   161\u2192        else:\n   162\u2192            small = not any(abs(position.units.number) > tolerances\n   163\u2192                            for position in self)\n   164\u2192        return small\n   165\u2192\n   166\u2192    def is_mixed(self):\n   167\u2192        \"\"\"Return true if the inventory contains a mix of positive and negative lots for\n   168\u2192        at least one instrument.\n   169\u2192\n   170\u2192        Returns:\n   171\u2192          A boolean.\n   172\u2192        \"\"\"\n   173\u2192        signs_map = {}\n   174\u2192        for position in self:\n   175\u2192            sign = position.units.number >= 0\n   176\u2192            prev_sign = signs_map.setdefault(position.units.currency, sign)\n   177\u2192            if sign != prev_sign:\n   178\u2192                return True\n   179\u2192        return False\n   180\u2192\n   181\u2192    def is_reduced_by(self, ramount):\n   182\u2192        \"\"\"Return true if the amount could reduce this inventory.\n   183\u2192\n   184\u2192        Args:\n   185\u2192          ramount: An instance of Amount.\n   186\u2192        Returns:\n   187\u2192          A boolean.\n   188\u2192        \"\"\"\n   189\u2192        if ramount.number == ZERO:\n   190\u2192            return False\n   191\u2192        for position in self:\n   192\u2192            units = position.units\n   193\u2192            if (ramount.currency == units.currency and\n   194\u2192                not same_sign(ramount.number, units.number)):\n   195\u2192                return True\n   196\u2192        return False\n   197\u2192\n   198\u2192    def __neg__(self):\n   199\u2192        \"\"\"Return an inventory with the negative of values of this one.\n   200\u2192\n   201\u2192        Returns:\n   202\u2192          An instance of Inventory.\n   203\u2192        \"\"\"\n   204\u2192        return Inventory({key: -pos for key, pos in self.items()})\n   205\u2192\n   206\u2192    def __abs__(self):\n   207\u2192        \"\"\"Return an inventory with the absolute value of each position.\n   208\u2192\n   209\u2192        Returns:\n   210\u2192          An instance of Inventory.\n   211\u2192        \"\"\"\n   212\u2192        return Inventory({key: abs(pos) for key, pos in self.items()})\n   213\u2192\n   214\u2192    def __mul__(self, scalar):\n   215\u2192        \"\"\"Scale/multiply the contents of the inventory.\n   216\u2192\n   217\u2192        Args:\n   218\u2192          scalar: A Decimal.\n   219\u2192        Returns:\n   220\u2192          An instance of Inventory.\n   221\u2192        \"\"\"\n   222\u2192        return Inventory({key: pos * scalar for key, pos in self.items()})\n   223\u2192\n   224\u2192    #\n   225\u2192    # Methods to access portions of an inventory.\n   226\u2192    #\n   227\u2192\n   228\u2192    def currencies(self):\n   229\u2192        \"\"\"Return the list of unit currencies held in this inventory.\n   230\u2192\n   231\u2192        Returns:\n   232\u2192          A list of currency strings.\n   233\u2192        \"\"\"\n   234\u2192        return set(currency for currency, _ in self.keys())\n   235\u2192\n   236\u2192    def cost_currencies(self):\n   237\u2192        \"\"\"Return the list of unit currencies held in this inventory.\n   238\u2192\n   239\u2192        Returns:\n   240\u2192          A set of currency strings.\n   241\u2192        \"\"\"\n   242\u2192        return set(cost.currency\n   243\u2192                   for _, cost in self.keys()\n   244\u2192                   if cost is not None)\n   245\u2192\n   246\u2192    def currency_pairs(self):\n   247\u2192        \"\"\"Return the commodities held in this inventory.\n   248\u2192\n   249\u2192        Returns:\n   250\u2192          A set of currency strings.\n   251\u2192        \"\"\"\n   252\u2192        return set(position.currency_pair() for position in self)\n   253\u2192\n   254\u2192    def get_positions(self):\n   255\u2192        \"\"\"Return the positions in this inventory.\n   256\u2192\n   257\u2192        Returns:\n   258\u2192          A shallow copy of the list of positions.\n   259\u2192        \"\"\"\n   260\u2192        return list(iter(self))\n   261\u2192\n   262\u2192    def get_only_position(self):\n   263\u2192        \"\"\"Return the first position and assert there are no more.\n   264\u2192        If the inventory is empty, return None.\n   265\u2192        \"\"\"\n   266\u2192        if len(self) > 0:\n   267\u2192            if len(self) > 1:\n   268\u2192                raise AssertionError(\"Inventory has more than one expected \"\n   269\u2192                                     \"position: {}\".format(self))\n   270\u2192            return next(iter(self))\n   271\u2192\n   272\u2192    def get_currency_units(self, currency):\n   273\u2192        \"\"\"Fetch the total amount across all the position in the given currency.\n   274\u2192        This may sum multiple lots in the same currency denomination.\n   275\u2192\n   276\u2192        Args:\n   277\u2192          currency: A string, the currency to filter the positions with.\n   278\u2192        Returns:\n   279\u2192          An instance of Amount, with the given currency.\n   280\u2192        \"\"\"\n   281\u2192        total_units = ZERO\n   282\u2192        for position in self:\n   283\u2192            if position.units.currency == currency:\n   284\u2192                total_units += position.units.number\n   285\u2192        return Amount(total_units, currency)\n   286\u2192\n   287\u2192    # TODO(blais): Remove this, use split() below instead when needed.\n   288\u2192    # TODO(blais): Rename this method to something more explicitly clear.\n   289\u2192    def segregate_units(self, currencies):\n   290\u2192        \"\"\"Split up the list of positions to the given currencies.\n   291\u2192\n   292\u2192        Args:\n   293\u2192          currencies: A list of currency strings, the currencies to isolate.\n   294\u2192        Returns:\n   295\u2192          A dict of currency to Inventory instances.\n   296\u2192        \"\"\"\n   297\u2192        per_currency_dict = {currency: Inventory()\n   298\u2192                             for currency in currencies}\n   299\u2192        per_currency_dict[None] = Inventory()\n   300\u2192        for position in self:\n   301\u2192            currency = position.units.currency\n   302\u2192            key = (currency if currency in currencies else None)\n   303\u2192            per_currency_dict[key].add_position(position)\n   304\u2192        return per_currency_dict\n   305\u2192\n   306\u2192    def split(self):\n   307\u2192        \"\"\"Split up the list of positions to their corresponding currencies.\n   308\u2192\n   309\u2192        Returns:\n   310\u2192          A dict of currency to Inventory instances.\n   311\u2192        \"\"\"\n   312\u2192        per_currency_dict = collections.defaultdict(Inventory)\n   313\u2192        for position in self:\n   314\u2192            per_currency_dict[position.units.currency].add_position(position)\n   315\u2192        return dict(per_currency_dict)\n   316\u2192\n   317\u2192    # TODO(blais): We could use a new method that computes the aggregated units\n   318\u2192    # and cost for each currency.\n   319\u2192\n   320\u2192    #\n   321\u2192    # Methods to convert an Inventory into another.\n   322\u2192    #\n   323\u2192\n   324\u2192    # TODO(blais): An improved design would allow conversions to market value to\n   325\u2192    # return the difference between the weight and the inserted value, so it can\n   326\u2192    # get inserted elsewhere on the balance sheet (e.g. to an unrealized gains\n   327\u2192    # account). This should be a natural by-product of conversions and operators\n   328\u2192    # should be modified to make this obvious or even difficult to ignore.\n   329\u2192    #\n   330\u2192    # TODO(blais): This returns another Inventory instance; rename this function\n   331\u2192    # to \"map()\" and create a proper \"reduce()\" in the new API.\n   332\u2192    def reduce(self, reducer, *args):\n   333\u2192        \"\"\"Reduce an inventory using one of the conversion functions.\n   334\u2192\n   335\u2192        See functions in beancount.core.convert.\n   336\u2192\n   337\u2192        Returns:\n   338\u2192          An instance of Inventory.\n   339\u2192        \"\"\"\n   340\u2192        inventory = Inventory()\n   341\u2192        for position in self:\n   342\u2192            inventory.add_amount(reducer(position, *args))\n   343\u2192        return inventory\n   344\u2192\n   345\u2192    def average(self):\n   346\u2192        \"\"\"Average all lots of the same currency together.\n   347\u2192\n   348\u2192        Use the minimum date from each aggregated set of lots.\n   349\u2192\n   350\u2192        Returns:\n   351\u2192          An instance of Inventory.\n   352\u2192        \"\"\"\n   353\u2192        groups = collections.defaultdict(list)\n   354\u2192        for position in self:\n   355\u2192            key = (position.units.currency,\n   356\u2192                   position.cost.currency if position.cost else None)\n   357\u2192            groups[key].append(position)\n   358\u2192\n   359\u2192        average_inventory = Inventory()\n   360\u2192        for (currency, cost_currency), positions in groups.items():\n   361\u2192            total_units = sum(position.units.number\n   362\u2192                              for position in positions)\n   363\u2192            # Explicitly skip aggregates when resulting in zero units.\n   364\u2192            if total_units == ZERO:\n   365\u2192                continue\n   366\u2192            units_amount = Amount(total_units, currency)\n   367\u2192\n   368\u2192            if cost_currency:\n   369\u2192                total_cost = sum(convert.get_cost(position).number\n   370\u2192                                 for position in positions)\n   371\u2192                cost_number = (Decimal('Infinity')\n   372\u2192                               if total_units == ZERO\n   373\u2192                               else (total_cost / total_units))\n   374\u2192                min_date = None\n   375\u2192                for pos in positions:\n   376\u2192                    pos_date = pos.cost.date if pos.cost else None\n   377\u2192                    if pos_date is not None:\n   378\u2192                        min_date = (pos_date\n   379\u2192                                    if min_date is None\n   380\u2192                                    else min(min_date, pos_date))\n   381\u2192                cost = Cost(cost_number, cost_currency, min_date, None)\n   382\u2192            else:\n   383\u2192                cost = None\n   384\u2192\n   385\u2192            average_inventory.add_amount(units_amount, cost)\n   386\u2192\n   387\u2192        return average_inventory\n   388\u2192\n   389\u2192\n   390\u2192    #\n   391\u2192    # Methods to build an Inventory instance.\n   392\u2192    #\n   393\u2192\n   394\u2192    def add_amount(self, units, cost=None):\n   395\u2192        \"\"\"Add to this inventory using amount and cost. This adds with strict lot\n   396\u2192        matching, that is, no partial matches are done on the arguments to the\n   397\u2192        keys of the inventory.\n   398\u2192\n   399\u2192        Args:\n   400\u2192          units: An Amount instance to add.\n   401\u2192          cost: An instance of Cost or None, as a key to the inventory.\n   402\u2192        Returns:\n   403\u2192          A pair of (position, matched) where 'position' is the position that\n   404\u2192          that was modified BEFORE it was modified, and where 'matched' is a\n   405\u2192          MatchResult enum that hints at how the lot was booked to this inventory.\n   406\u2192          Position may be None if there is no corresponding Position object,\n   407\u2192          e.g. the position was deleted.\n   408\u2192        \"\"\"\n   409\u2192        if ASSERTS_TYPES:\n   410\u2192            assert isinstance(units, Amount), (\n   411\u2192                \"Internal error: {!r} (type: {})\".format(units, type(units).__name__))\n   412\u2192            assert cost is None or isinstance(cost, Cost), (\n   413\u2192                \"Internal error: {!r} (type: {})\".format(cost, type(cost).__name__))\n   414\u2192\n   415\u2192        # Find the position.\n   416\u2192        key = (units.currency, cost)\n   417\u2192        pos = self.get(key, None)\n   418\u2192\n   419\u2192        if pos is not None:\n   420\u2192            # Note: In order to augment or reduce, all the fields have to match.\n   421\u2192\n   422\u2192            # Check if reducing.\n   423\u2192            booking = (MatchResult.REDUCED\n   424\u2192                       if not same_sign(pos.units.number, units.number)\n   425\u2192                       else MatchResult.AUGMENTED)\n   426\u2192\n   427\u2192            # Compute the new number of units.\n   428\u2192            number = pos.units.number + units.number\n   429\u2192            if number == ZERO:\n   430\u2192                # If empty, delete the position.\n   431\u2192                del self[key]\n   432\u2192            else:\n   433\u2192                # Otherwise update it.\n   434\u2192                self[key] = Position(Amount(number, units.currency), cost)\n   435\u2192        else:\n   436\u2192            # If not found, create a new one.\n   437\u2192            if units.number == ZERO:\n   438\u2192                booking = MatchResult.IGNORED\n   439\u2192            else:\n   440\u2192                self[key] = Position(units, cost)\n   441\u2192                booking = MatchResult.CREATED\n   442\u2192\n   443\u2192        return pos, booking\n   444\u2192\n   445\u2192    def add_position(self, position):\n   446\u2192        \"\"\"Add using a position (with strict lot matching).\n   447\u2192        Return True if this position was booked against and reduced another.\n   448\u2192\n   449\u2192        Args:\n   450\u2192          position: The Posting or Position to add to this inventory.\n   451\u2192        Returns:\n   452\u2192          A pair of (position, booking) where 'position' is the position that\n   453\u2192          that was modified, and where 'matched' is a MatchResult enum that\n   454\u2192          hints at how the lot was booked to this inventory.\n   455\u2192        \"\"\"\n   456\u2192        if ASSERTS_TYPES:\n   457\u2192            assert hasattr(position, 'units') and hasattr(position, 'cost'), (\n   458\u2192                \"Invalid type for position: {}\".format(position))\n   459\u2192            assert isinstance(position.cost, (type(None), Cost)), (\n   460\u2192                \"Invalid type for cost: {}\".format(position.cost))\n   461\u2192        return self.add_amount(position.units, position.cost)\n   462\u2192\n   463\u2192    def add_inventory(self, other):\n   464\u2192        \"\"\"Add all the positions of another Inventory instance to this one.\n   465\u2192\n   466\u2192        Args:\n   467\u2192          other: An instance of Inventory to add to this one.\n   468\u2192        Returns:\n   469\u2192          This inventory, modified.\n   470\u2192        \"\"\"\n   471\u2192        if self.is_empty():\n   472\u2192            # Optimization for empty inventories; if the current one is empty,\n   473\u2192            # adopt all of the other inventory's positions without running\n   474\u2192            # through the full aggregation checks. This should be very cheap. We\n   475\u2192            # can do this because the positions are immutable.\n   476\u2192            self.update(other)\n   477\u2192        else:\n   478\u2192            for position in other.get_positions():\n   479\u2192                self.add_position(position)\n   480\u2192        return self\n   481\u2192\n   482\u2192    def __add__(self, other):\n   483\u2192        \"\"\"Add another inventory to this one. This inventory is not modified.\n   484\u2192\n   485\u2192        Args:\n   486\u2192          other: An instance of Inventory.\n   487\u2192        Returns:\n   488\u2192          A new instance of Inventory.\n   489\u2192        \"\"\"\n   490\u2192        new_inventory = self.__copy__()\n   491\u2192        new_inventory.add_inventory(other)\n   492\u2192        return new_inventory\n   493\u2192\n   494\u2192    __iadd__ = add_inventory\n   495\u2192\n   496\u2192 