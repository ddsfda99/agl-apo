 errors produced.\n    43\u2192    \"\"\"\n    44\u2192    pad_errors = []\n    45\u2192\n    46\u2192    # Find all the pad entries and group them by account.\n    47\u2192    pads = list(misc_utils.filter_type(entries, data.Pad))\n    48\u2192    pad_dict = misc_utils.groupby(lambda x: x.account, pads)\n    49\u2192\n    50\u2192    # Partially realize the postings, so we can iterate them by account.\n    51\u2192    by_account = realization.postings_by_account(entries)\n    52\u2192\n    53\u2192    # A dict of pad -> list of entries to be inserted.\n    54\u2192    new_entries = {id(pad): [] for pad in pads}\n    55\u2192\n    56\u2192    # Process each account that has a padding group.\n    57\u2192    for account_, pad_list in sorted(pad_dict.items()):\n    58\u2192\n    59\u2192        # Last encountered / currency active pad entry.\n    60\u2192        active_pad = None\n    61\u2192\n    62\u2192        # Gather all the postings for the account and its children.\n    63\u2192        postings = []\n    64\u2192        is_child = account.parent_matcher(account_)\n    65\u2192        for item_account, item_postings in by_account.items():\n    66\u2192            if is_child(item_account):\n    67\u2192                postings.extend(item_postings)\n    68\u2192        postings.sort(key=data.posting_sortkey)\n    69\u2192\n    70\u2192        # A set of currencies already padded so far in this account.\n    71\u2192        padded_lots = set()\n    72\u2192\n    73\u2192        pad_balance = inventory.Inventory()\n    74\u2192        for entry in postings:\n    75\u2192\n    76\u2192            assert not isinstance(entry, data.Posting)\n    77\u2192            if isinstance(entry, data.TxnPosting):\n    78\u2192                # This is a transaction; update the running balance for this\n    79\u2192                # account.\n    80\u2192                pad_balance.add_position(entry.posting)\n    81\u2192\n    82\u2192            elif isinstance(entry, data.P