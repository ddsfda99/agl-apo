"\"\n  1067→        # Make sure we have an updated cookiecutter template,\n  1068→        # checked out to the right branch\n  1069→        cached_template = self.update_cookiecutter_cache(\n  1070→            template=template,\n  1071→            branch=branch,\n  1072→        )\n  1073→\n  1074→        self.logger.configure_stdlib_logging(\"cookiecutter\")\n  1075→        try:\n  1076→            # Unroll the template.\n  1077→            self.tools.cookiecutter(\n  1078→                str(cached_template),\n  1079→                no_input=True,\n  1080→                output_dir=str(output_path),\n  1081→                checkout=branch,\n  1082→                # Use a copy to prevent changes propagating among tests while test suite is running\n  1083→                extra_context=extra_context.copy(),\n  1084→                # Store replay data in the Briefcase template cache instead of ~/.cookiecutter_replay\n  1085→                default_config={\"replay_dir\": str(self.template_cache_path(\".replay\"))},\n  1086→            )\n  1087→        except subprocess.CalledProcessError as e:\n  1088→            # Computer is offline\n  1089→            # status code == 128 - certificate validation error.\n  1090→            raise NetworkFailure(\"clone template repository\") from e\n  1091→        except cookiecutter_exceptions.RepositoryNotFound as e:\n  1092→            # Either the template path is invalid,\n  1093→            # or it isn't a cookiecutter template (i.e., no cookiecutter.json)\n  1094→            raise InvalidTemplateRepository(template) from e\n  1095→        except cookiecutter_exceptions.RepositoryCloneFailed as e:\n  1096→            # Branch does not exist.\n  1097→            raise InvalidTemplateBranch(template, branch) from e\n  1098→        except cookiecutter_exceptions.UndefinedVariableInTemplate as e:\n  1099→            raise BriefcaseConfigError(e.message) from e\n  1100→\n  1101→    def generate_template(\n  1102→        self,\n  1103→        template: str | None,\n  1104→        branch: str | None,\n  1105→        output_path: str | Path,\n  1106→        extra_context: dict[str, str],\n  1107→    ) -> None:\n  1108→        # If a branch wasn't supplied through the --template-branch argument,\n  1109→        # use the branch derived from the Briefcase version\n  1110→        version = Version(briefcase.__version__)\n  1111→        if branch is None:\n  1112→            template_branch = f\"v{version.base_version}\"\n  1113→        else:\n  1114→            template_branch = branch\n  1115→\n  1116→        extra_context = extra_context.copy()\n  1117→        # Additional context that can be used for the Briefcase template pyproject.toml\n  1118→        # header to include the version of Briefcase as well as the source of the template.\n  1119→        extra_context.update(\n  1120→            {\n  1121→                \"template_source\": template,\n  1122→                \"template_branch\": template_branch,\n  1123→                \"briefcase_version\": str(version),\n  1124→            }\n  1125→        )\n  1126→\n  1127→        try:\n  1128→            self.logger.info(\n  1129→                f\"Using app template: {template}, branch {template_branch}\"\n  1130→            )\n  1131→            # Unroll the new app template\n  1132→            self._generate_template(\n  1133→                template=template,\n  1134→                branch=template_branch,\n  1135→                output_path=output_path,\n  1136→                extra_context=extra_context,\n  1137→            )\n  1138→        except InvalidTemplateBranch:\n  1139→            # Only use the main template if we're on a development branch of briefcase\n  1140→            # and the user didn't explicitly specify which branch to use.\n  1141→            if version.dev is None or branch is not None:\n  1142→                raise\n  1143→\n  1144→            # Development branches can use the main template.\n  1145→           