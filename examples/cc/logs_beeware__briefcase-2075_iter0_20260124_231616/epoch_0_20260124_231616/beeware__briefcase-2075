update: Should the --update and --no-update options be exposed?\n   823\u2192        \"\"\"\n   824\u2192        if update:\n   825\u2192            parser.add_argument(\n   826\u2192                \"-u\",\n   827\u2192                \"--update\",\n   828\u2192                action=\"store_true\",\n   829\u2192                help=f\"Update the app{context_label}\",\n   830\u2192            )\n   831\u2192\n   832\u2192        parser.add_argument(\n   833\u2192            \"-r\",\n   834\u2192            \"--update-requirements\",\n   835\u2192            action=\"store_true\",\n   836\u2192            help=f\"Update requirements for the app{context_label}\",\n   837\u2192        )\n   838\u2192\n   839\u2192        parser.add_argument(\n   840\u2192            \"--update-support\",\n   841\u2192            action=\"store_true\",\n   842\u2192            help=f\"Update support package for the app{context_label}\",\n   843\u2192        )\n   844\u2192\n   845\u2192        parser.add_argument(\n   846\u2192            \"--update-stub\",\n   847\u2192            action=\"store_true\",\n   848\u2192            help=f\"Update stub binary for the app{context_label}\",\n   849\u2192        )\n   850\u2192\n   851\u2192        parser.add_argument(\n   852\u2192            \"--update-resources\",\n   853\u2192            action=\"store_true\",\n   854\u2192            help=f\"Update app resources (icons, splash screens, etc){context_label}\",\n   855\u2192        )\n   856\u2192\n   857\u2192        if update:\n   858\u2192            parser.add_argument(\n   859\u2192                \"--no-update\",\n   860\u2192                action=\"store_true\",\n   861\u2192                help=f\"Prevent any automated update{context_label}\",\n   862\u2192            )\n   863\u2192\n   864\u2192    def _add_test_options(self, parser, context_label):\n   865\u2192        \"\"\"Internal utility method for adding common test-related options.\n   866\u2192\n   867\u2192        :param parser: The parser to which options should be added.\n   868\u2192        :param context_label: Label text for commands; the capitalized action being\n   869\u2192            performed (e.g., \"Build\", \"Run\",...)\n   870\u2192        \"\"\"\n   871\u2192        parser.add_argument(\n   872\u2192            \"--test\",\n   873\u2192            dest=\"test_mode\",\n   874\u2192            action=\"store_true\",\n   875\u2192            help=f\"{context_label} the app in test mode\",\n   876\u2192        )\n   877\u2192\n   878\u2192    def add_options(self, parser):\n   879\u2192        \"\"\"Add any options that this command needs to parse from the command line.\n   880\u2192\n   881\u2192        :param parser: a stub argparse parser for the command.\n   882\u2192        \"\"\"\n   883\u2192\n   884\u2192    def parse_config(self, filename, overrides):\n   885\u2192        try:\n   886\u2192            with open(filename, \"rb\") as config_file:\n   887\u2192                # Parse the content of the pyproject.toml file, extracting\n   888\u2192                # any platform and output format configuration for each app,\n   889\u2192                # creating a single set of configuration options.\n   890\u2192                global_config, app_configs = parse_config(\n   891\u2192                    config_file,\n   892\u2192                    platform=self.platform,\n   893\u2192                    output_format=self.output_format,\n   894\u2192                    logger=self.logger,\n   895\u2192                )\n   896\u2192\n   897\u2192                # Create the global config\n   898\u2192                global_config.update(overrides)\n   899\u2192                self.global_config = create_config(\n   900\u2192                    klass=GlobalConfig,\n   901\u2192                    config=global_config,\n   902\u2192                    msg=\"Global configuration\",\n   903\u2192                )\n   904\u2192\n   905\u2192                for app_name, app_config in app_configs.items():\n   906\u2192                    # Construct an AppConfig object with the final set of\n   907\u2192                    # configuration options for the app.\n   908\u2192                    app_config.update(overrides)\n   909\u2192                    self.apps[app_name] = create_config(\n   910\u2192                        klass=AppConfig,\n   911\u2192                        config=app_config,\n   912\u2192                        msg=f\"Configuration for '{app_name}'\",\n   913\u2192                    )\n   914\u2192\n   915\u2192        except OSError as e:\n   916\u2192            raise BriefcaseConfigError(\n   917\u2192                f\"\"\"\\\n   918\u2192Configuration file not found.\n   919\u2192\n   920\u2192Did you run Briefcase in a project directory that contains {filename.name!r}?\"\"\"\n   921\u2192            ) from e\n   922\u2192\n   923\u2192    def update_cookiecutter_cache(self, template: str, branch=\"master\"):\n   924\u2192        \"\"\"Ensure that we have a current checkout of a template path.\n   925\u2192\n   926\u2192        If the path is a local path, use the path as is.\n   927\u2192\n   928\u2192        If the path is a URL, look for a local cache; if one exists, update it,\n   929\u2192        including checking out the required branch.\n   930\u2192\n   931\u2192        :param template: The template URL or path.\n   932\u2192        :param branch: The template branch to use. Default: ``master``\n   933\u2192        :return: The path to the cached template. This may be the originally\n   934\u2192            provided path if the template was a file path.\n   935\u2192        \"\"\"\n   936\u2192        if is_repo_url(template):\n   937\u2192            # The app template is a repository URL.\n   938\u2192            #\n   939\u2192            # Look for a Briefcase cache of the template.\n   940\u2192            cached_template = self.template_cache_path(template)\n   941\u2192\n   942\u2192            if cached_template.exists():\n   943\u2192                # There is a pre-existing cache of the template. Attempt to update it;\n   944\u2192                # if the fetch fails, use the existing state of the cache. Any other\n   945\u2192                # failure is surfaced to the user.\n   946\u2192                try:\n   947\u2192                    repo = self.tools.git.Repo(cached_template)\n   948\u2192                except self.tools.git.exc.GitError:\n   949\u2192                    # Template repository is in a weird state. Delete it\n   950\u2192                    self.logger.warning(\n   951\u2192                        \"Template cache is in a weird state. Getting a clean clone.\"\n   952\u2192                    )\n   953\u2192                    self.tools.shutil.rmtree(cached_template)\n   954\u2192\n   955\u2192            if not cached_template.exists():\n   956\u2192                # There's no pre-existing template. It's either the first time seeing\n   957\u2192                # the template, or the template was in a weird state. Perform a blobless\n   958\u2192                # clone.\n   959\u2192                try:\n   960\u2192                    self.logger.info(f\"Cloning template {template!r}...\")\n   961\u2192                    cached_template.mkdir(exist_ok=True, parents=True)\n   962\u2192                    repo = self.tools.git.Repo.clone_from(\n   963\u2192                        url=template,\n   964\u2192                        to_path=cached_template,\n   965\u2192                        filter=[\"blob:none\"],\n   966\u2192                        no_checkout=True,\n   967\u2192                    )\n   968\u2192                except KeyboardInterrupt:\n   969\u2192                    # The user has aborted the initial clone. Git is fairly resilient to\n   970\u2192                    # being interrupted, but if the *initial* clone fails, it's very\n   971\u2192                    # hard to recover. To avoid proble