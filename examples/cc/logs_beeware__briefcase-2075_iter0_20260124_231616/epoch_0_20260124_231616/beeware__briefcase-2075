92                required=False,\n   742\u2192                help=\"Arguments to pass to the app\",\n   743\u2192            )\n   744\u2192            args, passthrough = split_passthrough(extra)\n   745\u2192        else:\n   746\u2192            args = extra\n   747\u2192\n   748\u2192        # Parse the full set of command line options from the content\n   749\u2192        # remaining after the basic command/platform/output format\n   750\u2192        # has been extracted.\n   751\u2192        options = vars(parser.parse_args(args))\n   752\u2192\n   753\u2192        if self.allows_passthrough:\n   754\u2192            options[\"passthrough\"] = passthrough\n   755\u2192\n   756\u2192        # Extract the base default options onto the command\n   757\u2192        self.input.enabled = options.pop(\"input_enabled\")\n   758\u2192        self.logger.verbosity = options.pop(\"verbosity\")\n   759\u2192        self.logger.save_log = options.pop(\"save_log\")\n   760\u2192\n   761\u2192        # Parse the configuration overrides\n   762\u2192        overrides = parse_config_overrides(options.pop(\"config_overrides\"))\n   763\u2192\n   764\u2192        return options, overrides\n   765\u2192\n   766\u2192    def clone_options(self, command):\n   767\u2192        \"\"\"Clone options from one command to this one.\n   768\u2192\n   769\u2192        :param command: The command whose options are to be cloned\n   770\u2192        \"\"\"\n   771\u2192\n   772\u2192    def add_default_options(self, parser):\n   773\u2192        \"\"\"Add the default options that exist on *all* commands.\n   774\u2192\n   775\u2192        :param parser: a stub argparse parser for the command.\n   776\u2192        \"\"\"\n   777\u2192        parser.add_argument(\n   778\u2192            \"-C\",\n   779\u2192            \"--config\",\n   780\u2192            dest=\"config_overrides\",\n   781\u2192            action=\"append\",\n   782\u2192            metavar=\"KEY=VALUE\",\n   783\u2192     