G: Default system encoding is not supported                   **\n   282\u2192*************************************************************************\n   283\u2192\n   284\u2192    Briefcase and the third-party tools it uses only support UTF-8.\n   285\u2192\n   286\u2192    The detected default system encoding is {self.tools.system_encoding}.\n   287\u2192\n   288\u2192    Briefcase will proceed but some console output could be corrupted and\n   289\u2192    created files or artefacts may contain corrupted text.\n   290\u2192\n   291\u2192    Update your system's encoding to UTF-8 to avoid issues.\n   292\u2192\n   293\u2192*************************************************************************\n   294\u2192\"\"\"\n   295\u2192            )\n   296\u2192\n   297\u2192    def _command_factory(self, command_name: str):\n   298\u2192        \"\"\"Command factory for the current platform and format.\n   299\u2192\n   300\u2192        :param command_name: name of Command (e.g. 'create', 'build', 'run', etc.)\n   301\u2192        :return: instantiated Command\n   302\u2192        \"\"\"\n   303\u2192        format_module = importlib.import_module(self.__module__)\n   304\u2192        command = getattr(format_module, command_name)(\n   305\u2192            base_path=self.base_path,\n   306\u2192            apps=self.apps,\n   307\u2192            logger=self.logger,\n   308\u2192            console=self.input,\n   309\u2192            tools=self.tools,\n   310\u2192            is_clone=True,\n   311\u2192        )\n   312\u2192        command.clone_options(self)\n   313\u2192        return command\n   314\u2192\n   315\u2192    @property\n   316\u2192    def create_command(self):\n   317\u2192        \"\"\"Create Command factory for the same platform and format.\"\"\"\n   318\u2192        return self._command_factory(\"create\")\n   319\u2192\n   320\u2192    @property\n   321\u2192    def update_command(self):\n   322\u2192        \"\"\"Update Command factory for the same platform and format.\"\"\"\n   323\u2192        return self._command_factory(\"update\")\n   324\u2192\n   325\u2192    @property\n   326\u2192    def build_command(self):\n   327\u2192        \"\"\"Build Command factory for the same platform and format.\"\"\"\n   328\u2192        return self._command_factory(\"build\")\n   329\u2192\n   330\u2192    @property\n   331\u2192    def run_command(self):\n   332\u2192        \"\"\"Run Command factory for the same platform and format.\"\"\"\n   333\u2192        return self._command_factory(\"run\")\n   334\u2192\n   335\u2192    @property\n   336\u2192    def package_command(self):\n   337\u2192        \"\"\"Package Command factory for the same platform and format.\"\"\"\n   338\u2192        return self._command_factory(\"package\")\n   339\u2192\n   340\u2192    @property\n   341\u2192    def publish_command(self):\n   342\u2192        \"\"\"Publish Command factory for the same platform and format.\"\"\"\n   343\u2192        return self._command_factory(\"publish\")\n   344\u2192\n   345\u2192    def template_cache_path(self, template) -> Path:\n   346\u2192        \"\"\"The path where Briefcase keeps template checkouts.\n   347\u2192\n   348\u2192        :param template: The URL for the template that will be cached locally.\n   349\u2192        \"\"\"\n   350\u2192        template = template.rstrip(\"/\")\n   351\u2192        tail = template.split(\"/\")[-1]\n   352\u2192        cache_name = tail.rsplit(\".git\")[0]\n   353\u2192        return self.data_path / \"templates\" / cache_name\n   354\u2192\n   355\u2192    def build_path(self, app) -> Path:\n   356\u2192        \"\"\"The path in which all platform artefacts for the app will be built.\n   357\u2192\n   358\u2192        :param app: The app config\n   359\u2192        \"\"\"\n   360\u2192        return self.base_path / \"build\" / app.app_name / self.platform.lower()\n   361\u2192\n   362\u2192    @property\n   363\u2192    def dist_path(self) -> Path:\n   364\u2192        \"\"\"The path for all applications for this command's platform.\"\"\"\n   365\u2192        return self.base_path / \"dist\"\n   366\u2192\n   367\u2192    def bundle_path(self, app) -> Path:\n   368\u2192        \"\"\"The path to the bundle for the app in the output format.\n   369\u2192\n   370\u2192        The bundle is the template-generated source form of the app. The path will\n   371\u2192        usually be a directory, the existence of which is indicative that the template\n   372\u2192        has been rolled out for an app. The leaf of this path is the base of the content\n   373\u2192        generated from template.\n   374\u2192\n   375\u2192        :param app: The app config\n   376\u2192        \"\"\"\n   377\u2192        return self.build_path(app) / self.output_format.lower()\n   378\u2192\n   379\u2192    @abstractmethod\n   380\u2192    def binary_path(self, app) -> Path:\n   381\u2192        \"\"\"The path to the executable artefact for the app in the output format.\n   382\u2192\n   383\u2192        This may be a binary file produced by compilation; however, if the output format\n   384\u2192        doesn't require compilation, it may be the same as the bundle path (assuming the\n   385\u2192        bundle path is inherently \"executable\"), or a path that reasonably represents\n   386\u2192        the thing that can be executed.\n   387\u2192\n   388\u2192        :param app: The app config\n   389\u2192        \"\"\"\n   390\u2192\n   391\u2192    def binary_executable_path(self, app) -> Path:\n   392\u2192        \"\"\"The path to the actual binary object for the app in the output format.\n   393\u2192\n   394\u2192        For most platforms, this will be the same as the binary path. However, for\n   395\u2192        platforms that use an \"executable bundle\" (e.g., macOS), this will be actual\n   396\u2192        binary that is embedded in the bundle.\n   397\u2192\n   398\u2192        :param app: The app config\n   399\u2192        \"\"\"\n   400\u2192        return self.binary_path(app)\n   401\u2192\n   402\u2192    def unbuilt_executable_path(self, app) -> Path:\n   403\u2192        \"\"\"The path to the unbuilt form of the binary object for the app.\n   404\u2192\n   405\u2192        The pre-built stub binary may need to undergo some manipulation before it can be\n   406\u2192        used; to mark that this manipulation is required, the \"unbuilt\" binary has a\n   407\u2192        \"raw\" name that doesn't involve any app details. The build step moves the binary\n   408\u2192        to the final name.\n   409\u2192\n   410\u2192        :param app: The app config\n   411\u2192        \"\"\"\n   412\u2192        return self.binary_executable_path(app).parent / (\n   413\u2192            \"Stub\" + self.binary_executable_path(app).suffix\n   414\u2192        )\n   415\u2192\n   416\u2192    def briefcase_toml(self, app: AppConfig) -> dict[str, ...]:\n   417\u2192        \"\"\"Load the ``briefcase.toml`` file provided by the app template.\n   418\u2192\n   419\u2192        :param app: The config object for the app\n   420\u2192        :return: The contents of ``briefcase.toml``\n   421\u2192        \"\"\"\n   422\u2192        try:\n   423\u2192            return self._briefcase_toml[app]\n   424\u2192        except KeyError:\n   425\u2192            try:\n   426\u2192                with (self.bundle_path(app) / \"briefcase.toml\").open(\"rb\") as f:\n   427\u2192                    self._briefcase_toml[app] = tomllib.load(f)\n   428\u2192            except OSError as e:\n   429\u2192                raise MissingAppMetadata(self.bundle_path(app)) from e\n   430\u2192            else:\n   431\u2192                return self._briefcase_toml[app]\n   432\u2192\n   433\u2192    def path_index(self, app: AppConfig, path_name: str) -> str | dict | list:\n   434\u2192        \"\"\"Return a path from the path index provided by the app template.\n   435\u2192\n   436\u2192        Raises KeyError if ``path_name`` is not defined in the index.\n   437\u2192\n   438\u2192        :param app: The config object for the app\n   439\u2192        :param path_name: Name of the filepath to retrieve\n   440\u2192        :return: filepath for requested path\n   441\u2192        \"\"\"\n   442\u2192        return self.briefcase_toml(app)[\"paths\"][path_name]\n   443\u2192\n   444\u2192    def template_target_version(self, app: AppConfig) -> str | None:\n   445\u2192        \"\"\"The target version of Briefcase for the app from ``briefcase.toml``.\n   446\u2192\n   447\u2192        This value represents a version epoch specific to the platform. An epoch begins\n   448\u2192        when a breaking change is introduced. Therefore, this value would remain the\n   449\u2192        version of Briefcase that introduced a breaking change for a template until\n   450\u2192        another such change requires a new epoch.\n   451\u2192\n   452\u2192        :param app: The config object for the app\n   453\u2192        :return: target version or None if one isn't specified\n   454\u2192        \"\"\"\n   455\u2192        try:\n   456\u2192            return self.briefcase_toml(app)[\"briefcase\"][\"target_version\"]\n   457\u2192        except KeyError:\n   458\u2192            return None\n   459\u2192\n   460\u2192    def stub_binary_revision(self, app: AppConfig) -> str:\n   461\u2192        \"\"\"Obtain the stub binary revision that the template requires.\n   462\u2192\n   463\u2192        :param app: The config object for the app\n   464\u2192        :return: The stub binary revision required by the template.\n   465\u2192        \"\"\"\n   466\u2192        return self.path_index(app, \"stub_binary_revision\")\n   467\u2192\n   468\u2192    def support_path(self, app: AppConfig) -> Path:\n   469\u2192        \"\"\"Obtain the path into which the support package should be unpacked.\n   470\u2192\n   471\u2192        :param app: The config object for the app\n   472\u2192        :return: The full path where the support package should be unpacked.\n   473\u2192        \"\"\"\n   474\u2192        return self.bundle_path(app) / self.path_index(app, \"support_path\")\n   475\u2192\n   476\u2192    def support_revision(self, app: AppConfig) -> str:\n   477\u2192        \"\"\"Obtain the support package revision that the template requires.\n   478\u2192\n   479\u2192        :param app: The config object for the app\n   480\u2192        :return: The support revision required by the template.\n   481\u2192        \"\"\"\n   482\u2192        return self.path_index(app, \"support_revision\")\n   483\u2192\n   484\u2192    def cleanup_paths(self, app: AppConfig) -> list[str]:\n   485\u2192        \"\"\"Obtain the paths generated by the app template that should be cleaned up\n   486\u2192        prior to release.\n   487\u2192\n   488\u2192        :param app: The config object for the app\n   489\u2192        :return: The list of path globs inside the app template that should be cleaned\n   490\u2192            up.\n   491\u2192        \"\"\"\n   492\u2192        return self.path_index(app, \"cleanup_paths\")\n   493\u2192\n   494\u2192    def app_requirements_path(self, app: AppConfig) -> Path:\n   495\u2192        \"\"\"Obtain the path into which a requirements.txt file should be written.\n   496\u2192\n   497\u2192        :param app: The config object for the app\n   498\u2192        :return: The full path where the requirements.txt file should be written\n   499\u2192        \"\"\"\n   500\u2192        return self.bundle_path(app) / self.path_index(app, \"app_requirements_path\")\n   501\u2192\n   502\u2192    def app_packages_path(self, app: AppConfig) -> Path:\n   503\u2192        \"\"\"Obtain the path into which requirements should be installed.\n   504\u2192\n   505\u2192        :param app: The config object for the app\n   506\u2192        :return: The full path where application requirements should be installed.\n   507\u2192        \"\"\"\n   508\u2192        return self.bundle_path(app) / self.path_index(app, \"app_packages_path\")\n   509\u2192\n   510\u2192    def app_path(self, app: AppConfig) -> Path:\n   511\u2192        \"\"\"Obtain the path into which the application should be installed.\n   512\u2192\n   513\u2192        :param app: The config object for the app\n   514\u2192        :return: The full path where application code should be installed.\n   515\u2192        \"\"\"\n   516\u2192        return self.bundle_path(app) / self.path_index(app, \"app_path\")\n   517\u2192\n   518\u2192    def app_module_path(self, app: AppConfig) -> Path:\n   519\u2192        \"\"\"Find the path for the application module for an app.\n   520\u2192\n   521\u2192        :param app: The config object for the app\n   522\u2192        :returns: The Path to the dist-info folder.\n   523\u2192        \"\"\"\n   524\u2192        app_home = [\n   525\u2192            path.split(\"/\")\n   526\u2192            for path in app.sources\n   527\u2192            if path.rsplit(\"/\", 1)[-1] == app.module_name\n   528\u2192        ]\n   529\u2192\n   530\u2192        if len(app_home) == 0:\n   531\u2192            raise BriefcaseCommandError(\n   532\u2192                f\"Unable to find code for application {app.app_name!r}\"\n   533\u2192            )\n   534\u2192        elif len(app_home) == 1:\n   535\u2192            path = Path(str(self.base_path), *app_home[0])\n   536\u2192        else:\n   537\u2192            raise BriefcaseCommandError(\n   538\u2192                f\"Multiple paths in sources found for application {app.app_name!r}\"\n   539\u2192            )\n   540\u2192\n   541\u2192        return path\n   542\u2192\n   543\u2192    @property\n   544\u2192    def briefcase_required_python_version(self):\n   545\u2192        \"\"\"The major.minor of the minimum Python version required by Briefcase itself.\n   546\u2192\n   547\u2192        This is extracted from packaging metadata.\n   548\u2192        \"\"\"\n   549\u2192        # Native format is \">=3.8\"\n   550\u2192        return tuple(\n   551\u2192            int(v)\n   552\u2192            for v in importlib.metadata.metadata(\"briefcase\")[\"Requires-Python\"]\n   553\u2192            .split(\"=\")[1]\n   554\u2192            .strip()\n   555\u2192            .split(\".\")\n   556\u2192        )\n   557\u2192\n   558\u2192    @property\n   559\u2192    def python_version_tag(self):\n   560\u2192        \"\"\"The major.minor of the Python version in use, as a string.\n   561\u2192\n   562\u2192        This is used as a repository label/tag to identify the appropriate templates,\n   563\u2192        etc. to use.\n   564\u2192        \"\"\"\n   565\u2192        return (\n   566\u2192            f\"{self.tools.sys.version_info.major}.{self.tools.sys.version_info.minor}\"\n   567\u2192        )\n   568\u2192\n   569\u2192    def verify_host(self):\n   570\u2192        \"\"\"Verify the host OS is supported by the Command.\"\"\"\n   571\u2192        if self.tools.host_os not in self.supported_host_os:\n   572\u2192            raise UnsupportedHostError(self.supported_host_os_reason)\n   573\u2192\n   574\u2192    def verify_tools(self):\n   575\u2192        \"\"\"Verify that the tools needed to run this Command exist.\n   576\u2192\n   577\u2192        Raises MissingToolException if a required system tool is missing.\n   578\u2192        \"\"\"\n   579\u2192\n   580\u2192    def finalize_app_config(self, app: AppConfig):\n   581\u2192        \"\"\"Finalize the application config.\n   582\u2192\n   583\u2192        Some app configurations (notably, Linux system packages like .deb) have\n   584\u2192        configurations that are deeper than other platforms, because they need to\n   585\u2192        include components that are dependent on command-line arguments. They may also\n   586\u2192        require the existence of system tools to complete configuration.\n   587\u2192\n   588\u2192        The final app configuration merges those \"deep\" properties into the app\n   589\u2192        configuration, and performs any other app-specific platform configuration and\n   590\u2192        verification that is required as a result of command-line arguments.\n   591\u2192\n   592\u2192        :param app: The app configuration to finalize.\n   593\u2192        \"\"\"\n   594\u2192\n   595\u2192    def finalize(self, app: AppConfig | None = None):\n   596\u2192        \"\"\"Finalize Briefcase configuration.\n   597\u2192\n   598\u2192        This will:\n   599\u2192\n   600\u2192        1. Ensure that the host has been verified\n   601\u2192        2. Ensure that the platform tools have been verified\n   602\u2192        3. Ensure that app configurations have been finalized.\n   603\u2192\n   604\u2192        App finalization will only occur once per invocation.\n   605\u2192\n   606\u2192        :param app: If provided, the specific app configuration\n   607\u2192            to finalize. By default, all apps will be finalized.\n   608\u2192        \"\"\"\n   609\u2192        self.verify_host()\n   610\u2192        self.verify_tools()\n   611\u2192\n   612\u2192        if app is None:\n   613\u2192            for app in self.apps.values():\n   614\u2192                if hasattr(app, \"__draft__\"):\n   615\u2192                    self.finalize_app_config(app)\n   616\u2192                    delattr(app, \"__draft__\")\n   617\u2192        else:\n   618\u2192            if hasattr(app, \"__draft__\"):\n   619\u2192                self.finalize_app_config(app)\n   620\u2192                delattr(app, \"__draft__\")\n   621\u2192\n   622\u2192    def verify_app(self, app: AppConfig):\n   623\u2192        \"\"\"Verify the app is compatible and the app tools are available.\n   624\u2192\n   625\u2192        This is the last step of verification for a Command before running the Command's\n   626\u2192        business logic. It runs _after_ pre-requisite Commands have been verified and\n   627\u2192        run.\n   628\u2192\n   629\u2192        :param app: app configuration\n   630\u2192        \"\"\"\n   631\u2192        self.verify_app_template(app)\n   632\u2192        self.verify_app_tools(app)\n   633\u2192        self.verify_required_python(app)\n   634\u2192\n   635\u2192    def verify_app_tools(self, app: AppConfig):\n   636\u2192        \"\"\"Verify that tools needed to run the command for this app exist.\"\"\"\n   637\u2192\n   638\u2192    def verify_app_template(self, app: AppConfig):\n   639\u2192        \"\"\"Verify the template targets the same Briefcase version as the Command.\n   640\u2192\n   641\u2192        :param app: app configuration\n   642\u2192        \"\"\"\n   643\u2192\n   644\u2192        # Skip this check if the template isn't rolled out\n   645\u2192        # or if the command doesn't support templates\n   646\u2192        try:\n   647\u2192            template_target_version = self.template_target_version(app)\n   648\u2192        except (MissingAppMetadata, NotImplementedError):\n   649\u2192            return\n   650\u2192\n   651\u2192        if self.platform_target_version != template_target_version:\n   652\u2192            raise BriefcaseCommandError(\n   653\u2192                f\"\"\"\\\n   654\u2192The app template used to generate this app is not compatible with this version\n   655\u2192of Briefcase.\n   656\u2192\n   657\u2192If the app was generated with an earlier version of Briefcase using the default\n   658\u2192Briefcase template, you can run:\n   659\u2192\n   660\u2192     $ briefcase create {self.platform} {self.output_format}\n   661\u2192\n   662\u2192to re-generate your app with a compatible version of the template.\n   663\u2192\n   664\u2192If you are using a custom template, you'll need to update the template to correct\n   665\u2192any compatibility problems, and then add the compatibility declaration.\n   666\u2192\"\"\"\n   667\u2192            )\n   668\u2192\n   669\u2192    def verify_required_python(self, app: AppConfig):\n   670\u2192        \"\"\"Verify that the running version of Python meets the project's specifications.\"\"\"\n   671\u2192\n   672\u2192        requires_python = getattr(self.global_config, \"requires_python\", None)\n   673\u2192        if not requires_python:\n   674\u2192            return\n   675\u2192\n   676\u2192        try:\n   677\u2192            spec = Specifier(requires_python)\n   678\u2192        except InvalidSpecifier as e:\n   679\u2192            raise BriefcaseConfigError(\n   680\u2192                f\"Invalid requires-python in pyproject.toml: {e}\"\n   681\u2192            ) from e\n   682\u2192\n   683\u2192        running_version = platform.python_version()\n   684\u2192\n   685\u2192        if not spec.contains(running_version, prereleases=True):\n   686\u2192            raise UnsupportedPythonVersion(\n   687\u2192                version_specifier=requires_python, running_version=running_version\n   688\u2192            )\n   689\u2192\n   690\u2192    def parse_options(self, extra):\n   691\u2192        \"\"\"Parse the command line arguments for the Command.\n   692\u2192\n   693\u2192        After the initial ArgumentParser runs to choose the Command for the selected\n   694\u2192        platform and format, a new ArgumentParser is created here to parse the remaining\n   695\u2192        command line arguments specific to the Command. Additionally, the default\n   696\u2192        options for disabling input, log verbosity, and log saving are parsed out and\n   697\u2192        saved to the Command.\n   698\u2192\n   699\u2192        :param extra: the remaining command line arguments after the initial\n   700\u2192            ArgumentParser runs over the command line.\n   701\u2192        :return: dictionary of parsed arguments for Command, and a dictionary of parsed\n   702\u2192            configuration overrides.\n   703\u2192        \"\"\"\n   704\u2192        default_format = getattr