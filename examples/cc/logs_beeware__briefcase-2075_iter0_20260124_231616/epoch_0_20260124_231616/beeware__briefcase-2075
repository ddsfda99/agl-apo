      f\"Multiple paths in sources found for application {app.app_name!r}\"\n   539→            )\n   540→\n   541→        return path\n   542→\n   543→    @property\n   544→    def briefcase_required_python_version(self):\n   545→        \"\"\"The major.minor of the minimum Python version required by Briefcase itself.\n   546→\n   547→        This is extracted from packaging metadata.\n   548→        \"\"\"\n   549→        # Native format is \">=3.8\"\n   550→        return tuple(\n   551→            int(v)\n   552→            for v in importlib.metadata.metadata(\"briefcase\")[\"Requires-Python\"]\n   553→            .split(\"=\")[1]\n   554→            .strip()\n   555→            .split(\".\")\n   556→        )\n   557→\n   558→    @property\n   559→    def python_version_tag(self):\n   560→        \"\"\"The major.minor of the Python version in use, as a string.\n   561→\n   562→        This is used as a repository label/tag to identify the appropriate templates,\n   563→        etc. to use.\n   564→        \"\"\"\n   565→        return (\n   566→            f\"{self.tools.sys.version_info.major}.{self.tools.sys.version_info.minor}\"\n   567→        )\n   568→\n   569→    def verify_host(self):\n   570→        \"\"\"Verify the host OS is supported by the Command.\"\"\"\n   571→        if self.tools.host_os not in self.supported_host_os:\n   572→            raise UnsupportedHostError(self.supported_host_os_reason)\n   573→\n   574→    def verify_tools(self):\n   575→        \"\"\"Verify that the tools needed to run this Command exist.\n   576→\n   577→        Raises MissingToolException if a required system tool is missing.\n   578→        \"\"\"\n   579→\n   580→    def finalize_app_config(self, app: AppConfig):\n   581→        \"\"\"Finalize the application config.\n   582→\n   583→        Some app configurations (notably, Linux system packages like .deb) have\n   584→        configurations that are deeper than other platforms, because they need to\n   585→        include components that are dependent on command-line arguments. They may also\n   586→        require the existence of system tools to complete configuration.\n   587→\n   588→        The final app configuration merges those \"deep\" properties into the app\n   589→        configuration, and performs any other app-specific platform configuration and\n   590→        verification that is required as a result of command-line arguments.\n   591→\n   592→        :param app: The app configuration to finalize.\n   593→        \"\"\"\n   594→\n   595→    def finalize(self, app: AppConfig | None = None):\n   596→        \"\"\"Finalize Briefcase configuration.\n   597→\n   598→        This will:\n   599→\n   600→        1. Ensure that the host has been verified\n   601→        2. Ensure that the platform tools have been verified\n   602→        3. Ensure that app configurations have been finalized.\n   603→\n   604→        App finalization will only occur once per invocation.\n   605→\n   606→        :param app: If provided, the specific app configuration\n   607→            to finalize. By default, all apps will be finalized.\n   608→        \"\"\"\n   609→        self.verify_host()\n   610→        self.verify_tools()\n   611→\n   612→        if app is None:\n   613→            for app in self.apps.values():\n   614→                if hasattr(app, \"__draft__\"):\n   615→                    self.finalize_app_config(app)\n   616→                    delattr(app, \"__draft__\")\n   617→        else:\n   618→            if hasattr(app, \"__draft__\"):\n   619→                self.finalize_app_config(app)\n   620→                delattr(app, \"__draft__\")\n   621→\n   622→    def verify_app(self, app: AppConfig):\n   623→        \"\"\"Verify the app is compatible and the app tools are available.\n   624→\n   625→        This is the last step of verification for a Command before running the Command's\n   626→        business logic. It runs _after_ pre-requisite Commands have been verified and\n   627→        run.\n   628→\n   629→        :param app: app configuration\n   630→        \"\"\"\n   631→        self.verify_app_template(app)\n   632→        self.verify_app_tools(app)\n   633→        self.verify_required_python(app)\n   634→\n   635→    def verify_app_tools(self, app: AppConfig):\n   636→        \"\"\"Verify that tools needed to run the command for this app exist.\"\"\"\n   637→\n   638→    def verify_app_template(self, app: AppConfig):\n   639→        \"\"\"Verify the template targets the same Briefcase version as the Command.\n   640→\n   641→        :param app: app configuration\n   642→        \"\"\"\n   643→\n   644→        # Skip this check if the template isn't rolled out\n   645→        # or if the command doesn't support templates\n   646→        try:\n   647→            template_target_version = self.template_target_version(app)\n   648→        except (MissingAppMetadata, NotImplementedError):\n   649→            return\n   650→\n   651→        if self.platform_target_version != template_target_version:\n   652→            raise BriefcaseCommandError(\n   653→                f\"\"\"\\\n   654→The app template used to generate this app is not compatible with this version\n   655→of Briefcase.\n   656→\n   657→If the app was generated with an earlier version of Briefcase using the default\n   658→Briefcase template, you can run:\n   659→\n   660→     $ briefcase create {self.platform} {self.output_format}\n   661→\n   662→to re-generate your app with a compatible version of the template.\n   663→\n   664→If you are using a custom template, you'll need to update the template to correct\n   665→any compatibility problems, and then add the compatibility declaration.\n   666→\"\"\"\n   667→            )\n   668→\n   669→    def verify_required_python(self, app: AppConfig):\n   670→        \"\"\"Verify that the running version of Python meets the project's specifications.\"\"\"\n   671→\n   672→        requires_python = getattr(self.global_config, \"requires_python\", None)\n   673→        if not requires_python:\n   674→            return\n   675→\n   676→        try:\n   677→            spec = Specifier(requires_python)\n   678→        except InvalidSpecifier as e:\n   679→            raise BriefcaseConfigError(\n   680→                f\"Invalid requires-python in pyproject.toml: {e}\"\n   681→            ) from e\n   682→\n   683→        running_version = platform.python_version()\n   684→\n   685→        if not spec.contains(running_version, prereleases=True):\n   686→            raise UnsupportedPythonVersion(\n   687→                version_specifier=requires_python, running_version=running_version\n   688→            )\n   689→\n   690→    def parse_options(self, extra):\n   691→        \"\"\"Parse the command line arguments for the Command.\n   692→\n   693→        After the initial ArgumentParser runs to choose the Command for the selected\n   694→        platform and format, a new ArgumentParser is created here to parse the remaining\n   695→        command line arguments specific to the Command. Additionally, the default\n   696→        options for disabling input, log verbosity, and log saving are parsed out and\n   697→        saved to the Command.\n   698→\n   699→        :param extra: the remaining command line arguments after the initial\n   700→            ArgumentParser runs over the command line.\n   701→        :return: dictionary of parsed arguments for Command, and a dictionary of parsed\n   702→            configuration overrides.\n   703→        \"\"\"\n   704→        default_format = getattr(\n   705→            get_platforms().get(self.platform), \"DEFAULT_OUTPUT_FORMAT\", None\n   706→        )\n   707→        # only show supported formats for Commands that support formats\n   708→        if default_format is not None and self.command not in {\"new\", \"dev\", \"upgrade\"}:\n   709→            formats = list(get_output_formats(self.platform).keys())\n   710→            formats[formats.index(default_format)] = f\"{default_format} (default)\"\n   711→            supported_formats_helptext = (\n   712→                f\"Supported formats:\\n  {', '.join(sorted(formats, key=str.lower))}\"\n   713→            )\n   714→        else:\n   715→            supported_formats_helptext = \"\"\n   716→\n   717→        parser = argparse.ArgumentParser(\n   718→            prog=self.cmd_line.format(\n   719→                command=self.command,\n   720→                platform=self.platform,\n   721→                output_format=self.output_format,\n   722→            ),\n   723→            description=self.input.textwrap(\n   724→                f\"{self.description}\\n\\n{supported_formats_helptext}\"\n   725→            ),\n   726→            formatter_class=(\n   727→                lambda prog: RawDescriptionHelpFormatter(prog, width=MAX_TEXT_WIDTH)\n   728→            ),\n   729→        )\n   730→\n   731→        self.add_default_options(parser)\n   732→        self.add_options(parser)\n   733→\n   734→        # If the command allows passthrough arguments, add an option for the help,\n   735→        # then process the argument list to strip out the passthrough args.\n   736→        if self.allows_passthrough:\n   737→            parser.add_argument(\n   738→                \"--\",\n   739→                dest=\"passthrough\",\n   740→                metavar=\"ARGS ...\",\n   741→                required=False,\n   742→                help=\"Arguments to pass to the app\",\n   743→            )\n   744→            args, passthrough = split_passthrough(extra)\n   745→        else:\n   746→            args = extra\n   747→\n   748→        # Parse the full set of command line options from the content\n   749→        # remaining after the basic command/platform/output format\n   750→        # has been extracted.\n   751→        options = vars(parser.parse_args(args))\n   752→\n   753→        if self.allows_passthrough:\n   754→            options[\"passthrough\"] = passthrough\n   755→\n   756→        # Extract the base default options onto the command\n   757→        self.input.enabled = options.pop(\"input_enabled\")\n   758→        self.logger.verbosity = options.pop(\"verbosity\")\n   759→        self.logger.save_log = options.pop(\"save_log\")\n   760→\n   761→        # Parse the configuration overrides\n   762→        overrides = parse_config_overrides(options.pop(\"config_overrides\"))\n   763→\n   764→        return options, overrides\n   765→\n   766→    def clone_options(self, command):\n   767→        \"\"\"Clone options from one command to this one.\n   768→\n   769→        :param command: The command whose options are to be cloned\n   770→        \"\"\"\n   771→\n   772→    def add_default_options(self, parser):\n   773→        \"\"\"Add the default options that exist on *all* commands.\n   774→\n   775→        :param parser: a stub argparse parser for the command.\n   776→        \"\"\"\n   777→        parser.add_argument(\n   778→            \"-C\",\n   779→            \"--config\",\n   780→            dest=\"config_overrides\",\n   781→            action=\"append\",\n   782→            metavar=\"KEY=VALUE\",\n   783→            help=\"Override the value of the app configuration item KEY with VALUE\",\n   784→        )\n   785→        parser.add_argument(\n   786→            \"-v\",\n   787→            \"--verbosity\",\n   788→            action=\"count\",\n   789→            default=0,\n   790→            help=\"Enable verbose logging. Use -vv and -vvv to increase logging verbosity\",\n   791→        )\n   792→        parser.add_argument(\"-V\", \"--version\", action=\"version\", version=__version__)\n   793→        parser.add_argument(\n   794→            \"--no-input\",\n   795→            action=\"store_false\",\n   796→            default=True,\n   797→            dest=\"input_enabled\",\n   798→            help=(\n   799→                \"Don't ask for user input. If any action would be destructive, \"\n   800→                \"an error will be raised; otherwise, default answers will be \"\n   801→                \"assumed\"\n   802→            ),\n   803→        )\n   804→        parser.add_argument(\n   805→            \"--log\",\n   806→            action=\"store_true\",\n   807→            dest=\"save_log\",\n   808→            help=\"Save a detailed log to file. By default, this log file is only created for critical errors\",\n   809→        )\n   810→\n   811→    def _add_update_options(\n   812→        self,\n   813→        parser,\n   814→        context_label=\"\",\n   815→        update=True,\n   816→    ):\n   817→        \"\"\"Internal utility method for adding common update options.\n   818→\n   819→        :param parser: The parser to which options should be added.\n   820→        :param context_label: Label text that will be added to the end of the help text\n   821→            to describe when the update will be applied (e.g., \"before building\")\n   822→        :param update: Should the --update and --no-update options be exposed?\n   823→        \"\"\"\n   824→        if update:\n   825→            parser.add_argument(\n   826→                \"-u\",\n   827→                \"--update\",\n   828→                action=\"store_true\",\n   829→                help=f\"Update the app{context_label}\",\n   830→            )\n   831→\n   832→        parser.add_argument(\n   833→            \"-r\",\n   834→            \"--update-requirements\",\n   835→            action=\"store_true\",\n   836→            help=f\"Update requirements for the app{context_label}\",\n   837→        )\n   838→\n   839→        parser.add_argument(\n   840→            \"--update-support\",\n   841→            action=\"store_true\",\n   842→            help=f\"Update support package for the app{context_label}\",\n   843→        )\n   844→\n   845→        parser.add_argument(\n   846→            \"--update-stub\",\n   847→            action=\"store_true\",\n   848→            help=f\"Update stub binary for the app{context_label}\",\n   849→        )\n   850→\n   851→        parser.add_argument(\n   852→            \"--update-resources\",\n   853→            action=\"store_true\",\n   854→            help=f\"Update app resources (icons, splash screens, etc){context_label}\",\n   855→        )\n   856→\n   857→        if update:\n   858→            parser.add_argument(\n   859→                \"--no-update\",\n   860→                action=\"store_true\",\n   861→                help=f\"Prevent any automated update{context_label}\",\n   862→            )\n   863→\n   864→    def _add_test_options(self, parser, context_label):\n   865→        \"\"\"Internal utility method for adding common test-related options.\n   866→\n   867→        :param parser: The parser to which options should be added.\n   868→        :param context_label: Label text for commands; the capitalized action being\n   869→            performed (e.g., \"Build\", \"Run\",...)\n   870→        \"\"\"\n   871→        parser.add_argument(\n   872→            \"--test\",\n   873→            dest=\"test_mode\",\n   874→            action=\"store_true\",\n   875→            help=f\"{context_label} the app in test mode\",\n   876→        )\n   877→\n   878→    def add_options(self, parser):\n   879→        \"\"\"Add any options that this command needs to parse from the command line.\n   880→\n   881→        :param parser: a stub argparse parser for the command.\n   882→        \"\"\"\n   883→\n   884→    def parse_config(self, filename, overrides):\n   885→        try:\n   886→            with open(filename, \"rb\") as config_file:\n   887→                # Parse the content of the pyproject.toml file, extracting\n   888→                # any platform and output format configuration for each app,\n   889→                # creating a single set of configuration options.\n   890→                global_config, app_configs = parse_config(\n   891→                    config_file,\n   892→                    platform=self.platform,\n   893→                    output_format=self.output_format,\n   894→                    logger=self.logger,\n   895→                )\n   896→\n   897→                # Create the global config\n   898→                global_config.update(overrides)\n   899→                self.global_config = create_config(\n   900→                    klass=GlobalConfig,\n   901→                    config=global_config,\n   902→                    msg=\"Global configuration\",\n   903→                )\n   904→\n   905→                for app_name, app_config in app_configs.items():\n   906→                    # Construct an AppConfig object with the final set of\n   907→                    # configuration options for the app.\n   908→                    app_config.update(overrides)\n   909→                    self.apps[app_name] = create_config(\n   910→                        klass=AppConfig,\n   911→                        config=app_config,\n   912→                        msg=f\"Configuration for '{app_name}'\",\n   913→                    )\n   914→\n   915→        except OSError as e:\n   916→            raise BriefcaseConfigError(\n   917→                f\"\"\"\\\n   918→Configuration file not found.\n   919→\n   920→Did you run Briefcase in a project directory that contains {filename.name!r}?\"\"\"\n   921→            ) from e\n   922→\n   923→    def update_cookiecutter_cache(self, template: str, branch=\"master\"):\n   924→        \"\"\"Ensure that we have a current checkout of a template path.\n   925→\n   926→        If the path is a local path, use the path as is.\n   927→\n   928→        If the path is a URL, look for a local cache; if one exists, update it,\n   929→        including checking out the required branch.\n   930→\n   931→        :param template: The template URL or path.\n   932→        :param branch: The template branch to use. Default: ``master``\n   933→        :return: The path to the cached template. This may be the originally\n   934→            provided path if the template was a file path.\n   935→        \"\"\"\n   936→        if is_repo_url(template):\n   937→            # The app template is a repository URL.\n   938→            #\n   939→            # Look for a Briefcase cache of the template.\n   940→            cached_template = self.template_cache_path(template)\n   941→\n   942→            if cached_template.exists():\n   943→                # There is a pre-existing cache of the template. Attempt to update it;\n   944→                # if the fetch fails, use the existing state of the cache. Any other\n   945→                # failure is surfaced to the user.\n   946→                try:\n   947→                    repo = self.tools.git.Repo(cached_template)\n   948→                except self.tools.git.exc.GitError:\n   949→                    # Template repository is in a weird state. Delete it\n   950→                    self.logger.warning(\n   951→                        \"Template cache is in a weird state. Getting a clean clone.\"\n   952→                    )\n   953→                    self.tools.shutil.rmtree(cached_template)\n   954→\n   955→            if not cached_template.exists():\n   956→                # There's no pre-existing template. It's either the first time seeing\n   957→                # the template, or the template was in a weird state. Perform a blobless\n   958→                # clone.\n   959→                try:\n   960→                    self.logger.info(f\"Cloning template {template!r}...\")\n   961→                    cached_template.mkdir(exist_ok=True, parents=True)\n   962→                    repo = self.tools.git.Repo.clone_from(\n   963→                        url=template,\n   964→                        to_path=cached_template,\n   965→                        filter=[\"blob:none\"],\n   966→                        no_checkout=True,\n   967→                    )\n   968→                except KeyboardInterrupt:\n   969→                    # The user has aborted the initial clone. Git is fairly resilient to\n   970→                    # being interrupted, but if the *initial* clone fails, it's very\n   971→                    # hard to recover. To avoid problems on the next run, remove the\n   972→                    # partial repo clone.\n   973→                    if cached_template.exists():\n   974→                        self.tools.shutil.rmtree(cached_template)\n   975→                    raise\n   976→                except self.tools.git.exc.GitError as e:\n   977→                    # The clone failed; to make sure the repo is in a clean state, clean up\n   978→                    # any partial remnants of this initial clone.\n   979→                    # If we're getting a GitError, we know the directory must exist.\n   980→                    self.tools.shutil.rmtree(cached_template)\n   981→                    git_fatal_message = re.findall(r\"(?<=fatal: ).*?$\", e.stderr, re.S)\n   982→                    if git_fatal_message:\n   983→                        # GitError captures stderr with single quotes. Because the regex above\n   984→                        # takes everything after git's \"fatal\" message, we need to strip that final single quote.\n   985→                        hint = git_fatal_message[0].rstrip(\"'\").strip()\n   986→\n   987→                        # git is inconsistent with capitalisation of the first word of the message\n   988→                        # and about periods at the end of the message.\n   989→                        hint = f\"{hint[0].upper()}{hint[1:]}{'' if hint[-1] == '.' else '.'}\"\n   990→                    else:\n   991→                        hint = (\n   992→                            \"This may be because your computer is offline, or \"\n   993→                            \"because the repository URL is incorrect.\"\n   994→                        )\n   995→\n   996→                    raise BriefcaseCommandError(\n   997→                        f\"Unable to clone repository {template!r}.\\n\\n{hint}\"\n   998→                    ) from e\n   999→\n  1000→            try:\n  1001→                # Raises ValueError if \"origin\" isn't a valid remote\n  1002→                remote = repo.remote(name=\"origin\")\n  1003→                # Ensure the existing repo's origin URL points to the location\n  1004→                # being requested. A difference can occur, for instance, if a\n  1005→                # fork of the template is used.\n  1006→                remote.set_url(new_url=template, old_url=remote.url)\n  1007→                try:\n  1008→                    # Attempt to update the repository\n  1009→                    remote.fetch()\n  1010→                except self.tools.git.exc.GitCommandError as e:\n  1011→                    # We are offline, or otherwise unable to contact the origin git\n  1012→                    # repo. It's OK to continue; but capture the error in the log and\n  1013→                    # warn the user that the template may be stale.\n  1014→                    self.logger.debug(str(e))\n  1015→                    self.logger.warning(\n  1016→                        \"\"\"\n  1017→*************************************************************************\n  1018→** WARNING: Unable to update template                                  **\n  1019→*************************************************************************\n  1020→\n  1021→    Briefcase is unable the update the application template. This\n  1022→    may be because your computer is currently offline. Briefcase will\n  1023→    use existing template without updating.\n  1024→\n  1025→*************************************************************************\n  1026→\"\"\"\n  1027→                    )\n  1028→\n  1029→                try:\n  1030→                    # Check out the branch for the required version tag.\n  1031→                   