                        "content": "     1\u2192\"\"\"Loader code. This is the main entry point to load up a file.\n     2\u2192\"\"\"\n     3\u2192__copyright__ = \"Copyright (C) 2013-2016  Martin Blais\"\n     4\u2192__license__ = \"GNU GPLv2\"\n     5\u2192\n     6\u2192from os import path\n     7\u2192from typing import Any, Optional\n     8\u2192import collections\n     9\u2192import copy\n    10\u2192import functools\n    11\u2192import glob\n    12\u2192import hashlib\n    13\u2192import importlib\n    14\u2192import io\n    15\u2192import itertools\n    16\u2192import logging\n    17\u2192import os\n    18\u2192import pickle\n    19\u2192import struct\n    20\u2192import sys\n    21\u2192import textwrap\n    22\u2192import time\n    23\u2192import traceback\n    24\u2192import warnings\n    25\u2192\n    26\u2192from beancount.utils import misc_utils\n    27\u2192from beancount.core import data\n    28\u2192from beancount.parser import parser\n    29\u2192from beancount.parser import booking\n    30\u2192from beancount.parser import options\n    31\u2192from beancount.parser import printer\n    32\u2192from beancount.ops import validation\n    33\u2192from beancount.utils import encryption\n    34\u2192from beancount.utils import file_utils\n    35\u2192\n    36\u2192\n    37\u2192OptionsMap = Any\n    38\u2192\n    39\u2192\n    40\u2192LoadError = collections.namedtuple('LoadError', 'source message entry')\n    41\u2192\n    42\u2192\n    43\u2192# List of default plugins to run.\n    44\u2192PLUGINS_PRE = [\n    45\u2192    (\"beancount.ops.pad\", None),\n    46\u2192    (\"beancount.ops.documents\", None),\n    47\u2192    ]\n    48\u2192\n    49\u2192# List of plugins that get enabled by --auto, and list of plugins actually\n    50\u2192# inserted in the list. See {4ec6a3205b6c}.\n    51\u2192DEFAULT_PLUGINS_AUTO = [\n    52\u2192    (\"beancount.plugins.auto\", None),\n    53\u2192    ]\n    54\u2192PLUGINS_AUTO = []\n    55\u2192\n    56\u2192PLUGINS_POST = [\n    57\u2192    (\"beancount.ops.balance\", None),\n    58\u2192    ]\n    59\u2192\n    60\u2192# A mapping of modules to warn about, to their renamed names.\n    61\u2192RENAMED_MODULES = {}\n    62\u2192\n    63\u2192\n    64\u2192# Filename pattern for the pickle-cache.\n    65\u2192PICKLE_CACHE_FILENAME = '.{filename}.picklecache'\n    66\u2192\n    67\u2192# The runtime threshold below which we don't bother creating a cache file, in\n    68\u2192# seconds.\n    69\u2192PICKLE_CACHE_THRESHOLD = 1.0\n    70\u2192\n    71\u2192\n    72\u2192def load_file(filename, log_timings=None, log_errors=None, extra_validations=None,\n    73\u2192              encoding=None):\n    74\u2192    \"\"\"Open a Beancount input file, parse it, run transformations and validate.\n    75\u2192\n    76\u2192    Args:\n    77\u2192      filename: The name of the file to be parsed.\n    78\u2192      log_timings: A file object or function to write timings to,\n    79\u2192        or None, if it should remain quiet. (Note that this is intended to use\n    80\u2192        the logging methods and does not insert a newline.)\n    81\u2192      log_errors: A file object or function to write errors to,\n    82\u2192        or None, if it should remain quiet.\n    83\u2192      extra_validations: A list of extra validation functions to run after loading\n    84\u2192        this list of entries.\n    85\u2192      encoding: A string or None, the encoding to decode the input filename with.\n    86\u2192    Returns:\n    87\u2192      A triple of (entries, errors, option_map) where \"entries\" is a date-sorted\n    88\u2192      list of entries from the file, \"errors\" a list of error objects generated\n    89\u2192      while parsing and validating the file, and \"options_map\", a dict of the\n    90\u2192      options parsed from the file.\n    91\u2192    \"\"\"\n    92\u2192    filename = path.expandvars(path.expanduser(filename))\n    93\u2192    if not path.isabs(filename):\n    94\u2192        filename = path.normpath(path.join(os.getcwd(), filename))\n    95\u2192\n    96\u2192    if encryption.is_encrypted_file(filename):\n    97\u2192        # Note: Caching is not supported for encrypted files.\n    98\u2192        entries, errors, options_map = load_encrypted_file(\n    99\u2192            filename,\n   100\u2192            log_timings, log_errors,\n   101\u2192            extra_validations, False, encoding)\n   102\u2192    else:\n   103\u2192        entries, errors, options_map = _load_file(\n   104\u2192            filename, log_timings,\n   105\u2192            extra_validations, encoding)\n   106\u2192        _log_errors(errors, log_errors)\n   107\u2192    return entries, errors, options_map\n   108\u2192\n   109\u2192\n   110\u2192def load_encrypted_file(filename, log_timings=None, log_errors=None, extra_validations=None,\n   111\u2192                        dedent=False, encoding=None):\n   112\u2192    \"\"\"Load an encrypted Beancount input file.\n   113\u2192\n   114\u2192    Args:\n   115\u2192      filename: The name of an encrypted file to be parsed.\n   116\u2192      log_timings: See load_string().\n   117\u2192      log_errors: See load_string().\n   118\u2192      extra_validations: See load_string().\n   119\u2192      dedent: See load_string().\n   120\u2192      encoding: See load_string().\n   121\u2192    Returns:\n   122\u2192      A triple of (entries, errors, option_map) where \"entries\" is a date-sorted\n   123\u2192      list of entries from the file, \"errors\" a list of error objects generated\n   124\u2192      while parsing and validating the file, and \"options_map\", a dict of the\n   125\u2192      options parsed from the file.\n   126\u2192    \"\"\"\n   127\u2192    contents = encryption.read_encrypted_file(filename)\n   128\u2192    return load_string(contents,\n   129\u2192                       log_timings=log_timings,\n   130\u2192                       log_errors=log_errors,\n   131\u2192                       extra_validations=extra_validations,\n   132\u2192                       encoding=encoding)\n   133\u2192\n   134\u2192\n   135\u2192def _log_errors(errors, log_errors):\n   136\u2192    \"\"\"Log errors, if 'log_errors' is set.\n   137\u2192\n   138\u2192    Args:\n   139\u2192      log_errors: A file object or function to write errors to,\n   140\u2192        or None, if it should remain quiet.\n   141\u2192    \"\"\"\n   142    if log_errors and errors:\n   143\u2192        if hasattr(log_errors, 'write'):\n   144\u2192            printer.print_errors(errors, file=log_errors)\n   145\u2192        else:\n   146\u2192            error_io = io.StringIO()\n   147\u2192            printer.print_errors(errors, file=error_io)\n   148\u2192            log_errors(error_io.getvalue())\n   149\u2192\n   150\u2192\n   151\u2192def get_cache_filename(pattern: str, filename: str) -> str:\n   152\u2192    \"\"\"Compute the cache filename from a given pattern and the top-level filename.\n   153\u2192\n   154\u2192    Args:\n   155\u2192      pattern: A cache filename or pattern. If the pattern contains '{filename}' this\n   156\u2192        will get replaced by the top-level filename. This may be absolute or relative.\n   157\u2192      filename: The top-level filename.\n   158\u2192    Returns:\n   159\u2192      The resolved cache filename.\n   160\u2192    \"\"\"\n   161\u2192    abs_filename = path.abspath(filename)\n   162\u2192    if path.isabs(pattern):\n   163\u2192        abs_pattern = pattern\n   164\u2192    else:\n   165\u2192        abs_pattern = path.join(path.dirname(abs_filename), pattern)\n   166\u2192    return abs_pattern.format(filename=path.basename(filename))\n   167\u2192\n   168\u2192\n   169\u2192def pickle_cache_function(cache_getter, time_threshold, function):\n   170\u2192    \"\"\"Decorate a loader function to make it loads its result from a pickle cache.\n   171\u2192\n   172\u2192    This considers the first argument as a top-level filename and assumes the\n   173\u2192    function to be cached returns an (entries, errors, options_map) triple. We\n   174\u2192    use the 'include' option value in order to check whether any of the included\n   175\u2192    files has changed. It's essentially a special case for an on-disk memoizer.\n   176\u2192    If any of the included files are more recent than the cache, the function is\n   177\u2192    recomputed and the cache refreshed.\n   178\u2192\n   179\u2192    Args:\n   180\u2192      cache_getter: A function of one argument, the top-level filename, which\n   181\u2192        will return the name of the corresponding cache file.\n   182\u2192      time_threshold: A float, the number of seconds below which we don't bother\n   183\u2192        caching.\n   184\u2192      function: A function object to decorate for caching.\n   185\u2192    Returns:\n   186\u2192      A decorated function which will pull its result from a cache file if\n   187\u2192      it is available.\n   188\u2192    \"\"\"\n   189\u2192    @functools.wraps(function)\n   190\u2192    def wrapped(toplevel_filename, *args, **kw):\n   191\u2192        cache_filename = cache_getter(toplevel_filename)\n   192\u2192\n   193\u2192        # Read the cache if it exists in order to get the list of files whose\n   194\u2192        # timestamps to check.\n   195\u2192        exists = path.exists(cache_filename)\n   196\u2192        if exists:\n   197\u2192            with open(cache_filename, 'rb') as file:\n   198\u2192                try:\n   199\u2192                    result = pickle.load(file)\n   200\u2192                except Exception as exc:\n   201\u2192                    # Note: Not a big fan of doing this, but here we handle all\n   202\u2192                    # possible exceptions because unpickling of an old or\n   203\u2192                    # corrupted pickle file manifests as a variety of different\n   204\u2192                    # exception types.\n   205\u2192\n   206\u2192                    # The cache file is corrupted; ignore it and recompute.\n   207\u2192                    logging.error(\"Cache file is corrupted: %s; recomputing.\", exc)\n   208\u2192                    result = None\n   209\u2192\n   210\u2192                else:\n   211\u2192                    # Check that the latest timestamp has not been written after the\n   212\u2192                    # cache file.\n   213\u2192                    entries, errors, options_map = result\n   214\u2192                    if not needs_refresh(options_map):\n   215\u2192                        # All timestamps are legit; cache hit.\n   216\u2192                        return result\n   217\u2192\n   218\u2192        # We failed; recompute the value.\n   219\u2192        if exists:\n   220\u2192            try:\n   221\u2192                os.remove(cache_filename)\n   222\u2192            except OSError as exc:\n   223\u2192                # Warn for errors on read-only filesystems.\n   224\u2192                logging.warning(\"Could not remove picklecache file %s: %s\",\n   225\u2192                                cache_filename, exc)\n   226\u2192\n   227\u2192        time_before = time.time()\n   228\u2192        result = function(toplevel_filename, *args, **kw)\n   229\u2192        time_after = time.time()\n   230\u2192\n   231\u2192        # Overwrite the cache file if the time it takes to compute it\n   232\u2192        # justifies it.\n   233\u2192        if time_after - time_before > time_threshold:\n   234\u2192            try:\n   235\u2192                with open(cache_filename, 'wb') as file:\n   236\u2192                    pickle.dump(result, file)\n   237\u2192            except Exception as exc:\n   238\u2192                logging.warning(\"Could not write to picklecache file %s: %s\",\n   239\u2192                                cache_filename, exc)\n   240\u2192\n   241\u2192        return result\n   242\u2192    return wrapped\n   243\u2192\n   244\u2192\n   245\u2192def delete_cache_function(cache_getter, function):\n   246\u2192    \"\"\"A wrapper that removes the cached filename.\n   247\u2192\n   248\u2192    Args:\n   249\u2192      cache_getter: A function of one argument, the top-level filename, which\n   250\u2192        will return the name of the corresponding cache file.\n   251\u2192      function: A function object to decorate for caching.\n   252\u2192    Returns:\n   253\u2192      A decorated function which will delete the cached filename, if it exists.\n   254\u2192    \"\"\"\n   255\u2192    @functools.wraps(function)\n   256\u2192    def wrapped(toplevel_filename, *args, **kw):\n   257\u2192        # Delete the cache.\n   258\u2192        cache_filename = cache_getter(toplevel_filename)\n   259\u2192        if path.exists(cache_filename):\n   260\u2192            os.remove(cache_filename)\n   261\u2192\n   262\u2192        # Invoke the original function.\n   263\u2192        return function(toplevel_filename, *args, **kw)\n   264\u2192    return wrapped\n   265\u2192\n   266\u2192\n   267\u2192def _uncached_load_file(filename, *args, **kw):\n   268\u2192    \"\"\"Delegate to _load. Note: This gets conditionally advised by caching below.\"\"\"\n   269\u2192    return _load([(filename, True)], *args, **kw)\n   270\u2192\n   271\u2192\n   272\u2192def needs_refresh(options_map):\n   273\u2192    \"\"\"Predicate that returns true if at least one of the input files may have changed.\n   274\u2192\n   275\u2192    Args:\n   276\u2192      options_map: An options dict as per the parser.\n   277\u2192      mtime: A modified time, to check if it covers the include files in the options_map.\n   278\u2192    Returns:\n   279\u2192      A boolean, true if the input is obsoleted by changes in the input files.\n   280\u2192    \"\"\"\n   281\u2192    if options_map is None:\n   282\u2192        return True\n   283\u2192    input_hash = compute_input_hash(options_map['include'])\n   284\u2192    return 'input_hash' not in options_map or input_hash != options_map['input_hash']\n   285\u2192\n   286\u2192\n   287\u2192def compute_input_hash(filenames):\n   288\u2192    \"\"\"Compute a hash of the input data.\n   289\u2192\n   290\u2192    Args:\n   291\u2192      filenames: A list of input files. Order is not relevant.\n   292\u2192    \"\"\"\n   293\u2192    md5 = hashlib.md5()\n   294\u2192    for filename in sorted(filenames):\n   295\u2192        md5.update(filename.encode('utf8'))\n   296\u2192        if not path.exists(filename):\n   297\u2192            continue\n   298\u2192        stat = os.stat(filename)\n   299\u2192        md5.update(struct.pack('dd', stat.st_mtime_ns, stat.st_size))\n   300\u2192    return md5.hexdigest()\n   301\u2192\n   302\u2192\n   303\u2192def load_string(string, log_timings=None, log_errors=None, extra_validations=None,\n   304\u2192                dedent=False, encoding=None):\n   305\u2192\n   306\u2192    \"\"\"Open a Beancount input string, parse it, run transformations and validate.\n   307\u2192\n   308\u2192    Args:\n   309\u2192      string: A Beancount input string.\n   310\u2192      log_timings: A file object or function to write timings to,\n   311\u2192        or None, if it should remain quiet.\n   312\u2192      log_errors: A file object or function to write errors to,\n   313\u2192        or None, if it should remain quiet.\n   314\u2192      extra_validations: A list of extra validation functions to run after loading\n   315\u2192        this list of entries.\n   316\u2192      dedent: A boolean, if set, remove the whitespace in front of the lines.\n   317\u2192      encoding: A string or None, the encoding to decode the input string with.\n   318\u2192    Returns:\n   319\u2192      A triple of (entries, errors, option_map) where \"entries\" is a date-sorted\n   320\u2192      list of entries from the string, \"errors\" a list of error objects\n   321\u2192      generated while parsing and validating the string, and \"options_map\", a\n   322\u2192      dict of the options parsed from the string.\n   323\u2192    \"\"\"\n   324\u2192    if dedent:\n   325\u2192        string = textwrap.dedent(string)\n   326\u2192    entries, errors, options_map = _load([(string, False)], log_timings,\n   327\u2192                                         extra_validations, encoding)\n   328\u2192    _log_errors(errors, log_errors)\n   329\u2192    return entries, errors, options_map\n   330\u2192\n   331\u2192\n   332\u2192def _parse_recursive(sources, log_timings, encoding=None):\n   333\u2192    \"\"\"Parse Beancount input, run its transformations and validate it.\n   334\u2192\n   335\u2192    Recursively parse a list of files or strings and their include files and\n   336\u2192    return an aggregate of parsed directives, errors, and the top-level\n   337\u2192    options-map. If the same file is being parsed twice, ignore it and issue an\n   338\u2192    error.\n   339\u2192\n   340\u2192    Args:\n   341\u2192      sources: A list of (filename-or-string, is-filename) where the first\n   342\u2192        element is a string, with either a filename or a string to be parsed directly,\n   343\u2192        and the second argument is a boolean that is true if the first is a filename.\n   344\u2192        You may provide a list of such arguments to be parsed. Filenames must be absolute\n   345\u2192        paths.\n   346\u2192      log_timings: A function to write timings to, or None, if it should remain quiet.\n   347\u2192      encoding: A string or None, the encoding to decode the input filename with.\n   348\u2192    Returns:\n   349\u2192      A tuple of (entries, parse_errors, options_map).\n   350\u2192    \"\"\"\n   351\u2192    assert isinstance(sources, list) and all(isinstance(el, tuple) for el in sources)\n   352\u2192\n   353\u2192    # Current parse state.\n   354\u2192    entries, parse_errors = [], []\n   355\u2192    options_map = None\n   356\u2192    other_options_map = []\n   357\u2192\n   358\u2192    # A stack of sources to be parsed.\n   359\u2192    source_stack = list(sources)\n   360\u2192\n   361\u2192    # A list of absolute filenames that have been parsed in the past, used to\n   362\u2192    # detect and avoid duplicates (cycles).\n   363\u2192    filenames_seen = set()\n   364\u2192\n   365\u2192    with misc_utils.log_time('beancount.parser.parser', log_timings, indent=1):\n   366\u2192        while source_stack:\n   367\u2192            source, is_file = source_stack.pop(0)\n   368\u2192            is_top_level = options_map is None\n   369\u2192\n   370\u2192            # If the file is encrypted, read it in and process it as a string.\n   371\u2192            if is_file:\n   372\u2192                cwd = path.dirname(source)\n   373\u2192                source_filename = source\n   374\u2192                if encryption.is_encrypted_file(source):\n   375\u2192                    source = encryption.read_encrypted_file(source)\n   376\u2192                    is_file = False\n   377\u2192            else:\n   378\u2192                # If we're parsing a string, the CWD is the current process\n   379\u2192                # working directory.\n   380\u2192                cwd = os.getcwd()\n   381\u2192                source_filename = None\n   382\u2192\n   383\u2192            if is_file:\n   384\u2192                # All filenames here must be absolute.\n   385\u2192                assert path.isabs(source)\n   386\u2192                filename = path.normpath(source)\n   387\u2192\n   388\u2192                # Check for file previously parsed... detect duplicates.\n   389\u2192                if filename in filenames_seen:\n   390\u2192                    parse_errors.append(\n   391\u2192                        LoadError(data.new_metadata(\"<load>\", 0),\n   392\u2192                                  'Duplicate filename parsed: \"{}\"'.format(filename),\n   393\u2192                                  None))\n   394\u2192                    continue\n   395\u2192\n   396\u2192                # Check for a file that does not exist.\n   397\u2192                if not path.exists(filename):\n   398\u2192                    parse_errors.append(\n   399\u2192                        LoadError(data.new_metadata(\"<load>\", 0),\n   400\u2192                                  'File \"{}\" does not exist'.format(filename), None))\n   401\u2192                    continue\n   402\u2192\n   403\u2192                # Parse a file from disk directly.\n   404\u2192                filenames_seen.add(filename)\n   405\u2192                with misc_utils.log_time('beancount.parser.parser.parse_file',\n   406\u2192                                         log_timings, indent=2):\n   407\u2192                    (src_entries,\n   408\u2192                     src_errors,\n   409\u2192                     src_options_map) = parser.parse_file(filename, encoding=encoding)\n   410\u2192\n   411\u2192                cwd = path.dirname(filename)\n   412\u2192            else:\n   413\u2192                # Encode the contents if necessary.\n   414\u2192                if encoding:\n   415\u2192                    if isinstance(source, bytes):\n   416\u2192                        source = source.decode(encoding)\n   417\u2192                    source = source.encode('ascii', 'replace')\n   418\u2192\n   419\u2192                # Parse a string buffer from memory.\n   420\u2192                with misc_utils.log_time('beancount.parser.parser.parse_string',\n   421\u2192                                         log_timings, indent=2):\n   422\u2192                    (src_entries,\n   423\u2192                     src_errors,\n   424\u2192                     src_options_map) = parser.parse_string(source, source_filename)\n   425\u2192\n   426\u2192            # Merge the entries resulting from the parsed file.\n   427\u2192            entries.extend(src_entries)\n   428\u2192            parse_errors.extend(src_errors)\n   429\u2192\n   430\u2192            # We need the options from the very top file only (the very\n   431\u2192            # first file being processed). No merging of options should\n   432\u2192            # occur.\n   433\u2192            if is_top_level:\n   434\u2192                options_map = src_options_map\n   435\u2192            else:\n   436\u2192                other_options_map.append(src_options_map)\n   437\u2192\n   438\u2192            # Add includes to the list of sources to process. chdir() for glob,\n   439\u2192            # which uses it indirectly.\n   440\u2192            include_expanded = []\n   441\u2192            with file_utils.chdir(cwd):\n   442\u2192                for include_filename in src_options_map['include']:\n   443\u2192                    matched_filenames = glob.glob(include_filename, recursive=True)\n   444\u2192                    if matched_filenames:\n   445\u2192                        include_expanded.extend(matched_filenames)\n   446\u2192                    else:\n   447\u2192                        parse_errors.append(\n   448\u2192                            LoadError(data.new_metadata(\"<load>\", 0),\n   449\u2192                                      'File glob \"{}\" does not match any files'.format(\n   450\u2192                                          include_filename), None))\n   451\u2192            for include_filename in include_expanded:\n   452\u2192                if not path.isabs(include_filename):\n   453\u2192                    include_filename = path.join(cwd, include_filename)\n   454\u2192                include_filename = path.normpath(include_filename)\n   455\u2192\n   456\u2192                # Add the include filenames to be processed later.\n   457\u2192                source_stack.append((include_filename, True))\n   458\u2192\n   459\u2192    # Make sure we have at least a dict of valid options.\n   460\u2192    if options_map is None:\n   461\u2192        option