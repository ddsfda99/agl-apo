unt(self, html: str, bookmark: Bookmark, count=1):\n   126\u2192        # Shared by link\n   127\u2192        self.assertInHTML(\n   128\u2192            f\"\"\"\n   129\u2192            <span>Shared by \n   130\u2192                <a href=\"?user={bookmark.owner.username}\">{bookmark.owner.username}</a>\n   131\u2192            </span>\n   132\u2192        \"\"\",\n   133\u2192            html,\n   134\u2192            count=count,\n   135\u2192        )\n   136\u2192\n   137\u2192    def assertFaviconVisible(self, html: str, bookmark: Bookmark):\n   138\u2192        self.assertFavicon(html, bookmark, True)\n   139\u2192\n   140\u2192    def assertFaviconHidden(self, html: str, bookmark: Bookmark):\n   141\u2192        self.assertFavicon(html, bookmark, False)\n   142\u2192\n   143\u2192    def assertFavicon(self, html: str, bookmark: Bookmark, visible=True):\n   144\u2192        soup = self.make_soup(html)\n   145\u2192\n   146\u2192        favicon = soup.select_one(\".favicon\")\n   147\u2192\n   148\u2192        if not visible:\n   149\u2192            self.assertIsNone(favicon)\n   150\u2192            return\n   151\u2192\n   152\u2192        url = f\"/static/{bookmark.favicon_file}\"\n   153\u2192        self.assertIsNotNone(favicon)\n   154\u2192        self.assertEqual(favicon[\"src\"], url)\n   155\u2192\n   156\u2192    def assertPreviewImageVisible(self, html: str, bookmark: Bookmark):\n   157\u2192        self.assertPreviewImage(html, bookmark, True)\n   158\u2192\n   159\u2192    def assertPreviewImageHidden(self, html: str, bookmark: Bookmark):\n   160\u2192        self.assertPreviewImage(html, bookmark, False)\n   161\u2192\n   162\u2192    def assertPreviewImage(self, html: str, bookmark: Bookmark, visible=True):\n   163\u2192        soup = self.make_soup(html)\n   164\u2192        preview_image = soup.select_one(\".preview-image\")\n   165\u2192\n   166\u2192        if not visible:\n   167\u2192            self.assertIsNone(preview_image)\n   168\u2192            return\n   169\u2192\n   170\u2192        url = f\"/static/{bookmark.preview_image_file}\"\n   171\u2192        self.assertIsNotNone(preview_image)\n   172\u2192        self.assertEqual(preview_image[\"src\"], url)\n   173\u2192\n   174\u2192    def assertPreviewImagePlaceholder(self, html: str):\n   175\u2192        soup = self.make_soup(html)\n   176\u2192        placeholder = soup.select_one(\".preview-image.placeholder\")\n   177\u2192        self.assertIsNotNone(placeholder)\n   178\u2192\n   179\u2192    def assertBookmarkURLCount(\n   180\u2192        self, html: str, bookmark: Bookmark, link_target: str = \"_blank\", count=0\n   181\u2192    ):\n   182\u2192        self.assertInHTML(\n   183\u2192            f\"\"\"\n   184\u2192        <div class=\"url-path truncate\">\n   185\u2192          <a href=\"{bookmark.url}\" target=\"{link_target}\" rel=\"noopener\" \n   186\u2192          class=\"url-display\">\n   187\u2192            {bookmark.url}\n   188\u2192          </a>\n   189\u2192        </div>\n   190\u2192        \"\"\",\n   191\u2192            html,\n   192\u2192            count,\n   193\u2192        )\n   194\u2192\n   195\u2192    def assertBookmarkURLVisible(self, html: str, bookmark: Bookmark):\n   196\u2192        self.assertBookmarkURLCount(html, bookmark, count=1)\n   197\u2192\n   198\u2192    def assertBookmarkURLHidden(\n   199\u2192        self, html: str, bookmark: Bookmark, link_target: str = \"_blank\"\n   200\u2192    ):\n   201\u2192        self.assertBookmarkURLCount(html, bookmark, count=0)\n   202\u2192\n   203\u2192    def assertNotes(self, html: str, notes_html: str, count=1):\n   204\u2192        self.assertInHTML(\n   205\u2192            f\"\"\"\n   206\u2192        <div class=\"notes\">\n   207\u2192          <div class=\"markdown\">\n   208\u2192            {notes_html}\n   209\u2192          </div>\n   210\u2192        </div>\n   211\u2192        \"\"\",\n   212\u2192            html,\n   213\u2192            count=count,\n   214\u2192        )\n   215\u2192\n   216\u2192    def assertNotesToggle(self, html: str, count=1):\n   217\u2192        self.assertInHTML(\n   218\u2192            \"\"\"\n   219\u2192        <button type=\"button\" class=\"btn btn-link btn-sm btn-icon toggle-notes\">\n   220\u2192          <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\">\n   221\u2192            <use xlink:href=\"#ld-icon-note\"></use>\n   222\u2192          </svg>\n   223\u2192          Notes\n   224\u2192        </button>      \n   225\u2192          \"\"\",\n   226\u2192            html,\n   227\u2192            count=count,\n   228\u2192        )\n   229\u2192\n   230\u2192    def assertUnshareButton(self, html: str, bookmark: Bookmark, count=1):\n   231\u2192        self.assertInHTML(\n   232\u2192            f\"\"\"\n   233\u2192        <button type=\"submit\" name=\"unshare\" value=\"{bookmark.id}\"\n   234\u2192                class=\"btn btn-link btn-sm btn-icon\"\n   235\u2192                ld-confirm-button ld-confirm-icon=\"ld-icon-unshare\" ld-confirm-question=\"Unshare?\">\n   236\u2192          <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\">\n   237\u2192            <use xlink:href=\"#ld-icon-share\"></use>\n   238\u2192          </svg>\n   239\u2192          Shared\n   240\u2192        </button>    \n   241\u2192          \"\"\",\n   242\u2192            html,\n   243\u2192            count=count,\n   244\u2192        )\n   245\u2192\n   246\u2192    def assertMarkAsReadButton(self, html: str, bookmark: Bookmark, count=1):\n   247\u2192        self.assertInHTML(\n   248\u2192            f\"\"\"\n   249\u2192        <button type=\"submit\" name=\"mark_as_read\" value=\"{bookmark.id}\"\n   250\u2192                class=\"btn btn-link btn-sm btn-icon\"\n   251\u2192                ld-confirm-button ld-confirm-icon=\"ld-icon-read\" ld-confirm-question=\"Mark as read?\">\n   252\u2192          <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\">\n   253\u2192            <use xlink:href=\"#ld-icon-unread\"></use>\n   254\u2192          </svg>\n   255\u2192          Unread\n   256\u2192        </button>   \n   257\u2192          \"\"\",\n   258\u2192            html,\n   259\u2192            count=count,\n   260\u2192        )\n   261\u2192\n   262\u2192    def render_template(\n   263\u2192        self,\n   264\u2192        url=\"/bookmarks\",\n   265\u2192        context_type: Type[\n   266\u2192            contexts.BookmarkListContext\n   267\u2192        ] = contexts.ActiveBookmarkListContext,\n   268\u2192        user: User | AnonymousUser = None,\n   269\u2192    ) -> str:\n   270\u2192        rf = RequestFactory()\n   271\u2192        request = rf.get(url)\n   272\u2192        request.user = user or self.get_or_create_test_user()\n   273\u2192        middleware = LinkdingMiddleware(lambda r: HttpResponse())\n   274\u2192        middleware(request)\n   275\u2192\n   276\u2192        bookmark_list_context = context_type(request)\n   277\u2192        context = RequestContext(request, {\"bookmark_list\": bookmark_list_context})\n   278\u2192\n   279\u2192        template = Template(\"{% include 'bookmarks/bookmark_list.html' %}\")\n   280\u2192        return template.render(context)\n   281\u2192\n   282\u2192    def setup_date_format_test(\n   283\u2192        self, date_display_setting: str, web_archive_url: str = \"\"\n   284\u2192    ):\n   285\u2192        bookmark = self.setup_bookmark()\n   286\u2192        bookmark.date_added = timezone.now() - relativedelta(days=8)\n   287\u2192        bookmark.web_archive_snapshot_url = web_archive_url\n   288\u2192        bookmark.save()\n   289\u2192        user = self.get_or_create_test_user()\n   290\u2192        user.profile.bookmark_date_display = date_display_setting\n   291\u2192        user.profile.save()\n   292\u2192        return bookmark\n   293\u2192\n   294\u2192    def inline_bookmark_description_test(self, bookmark):\n   295\u2192        html = self.render_template()\n   296\u2192        soup = self.make_soup(html)\n   297\u2192\n   298\u2192        has_description = bool(bookmark.description)\n   299\u2192        has_tags = len(bookmark.tags.all()) > 0\n   300\u2192\n   301\u2192        # inline description block exists\n   302\u2192        description = soup.select_one(\".description.inline.truncate\")\n   303\u2192        self.assertIsNotNone(description)\n   304\u2192\n   305\u2192        # separate description block does not exist\n   306\u2192        separate_description = soup.select_one(\".description.separate\")\n   307\u2192        self.assertIsNone(separate_description)\n   308\u2192\n   309\u2192        # one direct child element per description or tags\n   310\u2192        children = description.find_all(recursive=False)\n   311\u2192        expected_child_count = (\n   312\u2192            0 + (1 if has_description else 0) + (1 if has_tags else 0)\n   313\u2192        )\n   314\u2192        self.assertEqual(len(children), expected_child_count)\n   315\u2192\n   316\u2192        # has separator between description and tags\n   317\u2192        if has_description and has_tags:\n   318\u2192            self.assertTrue(\"|\" in description.text)\n   319\u2192\n   320\u2192        # contains description text, without leading/trailing whitespace\n   321\u2192        if has_description:\n   322\u2192            description_text = description.find(\"span\", string=bookmark.description)\n   323\u2192            self.assertIsNotNone(description_text)\n   324\u2192\n   325\u2192        if not has_tags:\n   326\u2192            # no tags element\n   327\u2192            tags = soup.select_one(\".tags\")\n   328\u2192            self.assertIsNone(tags)\n   329\u2192        else:\n   330\u2192            # tags element exists\n   331\u2192            tags = soup.select_one(\".tags\")\n   332\u2192            self.assertIsNotNone(tags)\n   333\u2192\n   334\u2192            # one link for each tag\n   335\u2192            tag_links = tags.find_all(\"a\")\n   336\u2192            self.assertEqual(len(tag_links), len(bookmark.tags.all()))\n   337\u2192\n   338\u2192            for tag in bookmark.tags.all():\n   339\u2192                tag_link = tags.find(\"a\", string=f\"#{tag.name}\")\n   340\u2192                self.assertIsNotNone(tag_link)\n   341\u2192                self.assertEqual(tag_link[\"href\"], f\"?q=%23{tag.name}\")\n   342\u2192\n   343\u2192    def test_inline_bookmark_description(self):\n   344\u2192        profile = self.get_or_create_test_user().profile\n   345\u2192        profile.bookmark_description_display = (\n   346\u2192            UserProfile.BOOKMARK_DESCRIPTION_DISPLAY_INLINE\n   347\u2192        )\n   348\u2192        profile.save()\n   349\u2192\n   350\u2192        # no description, no tags\n   351\u2192        bookmark = self.setup_bookmark(description=\"\")\n   352\u2192        self.inline_bookmark_description_test(bookmark)\n   353\u2192\n   354\u2192        # with description, no tags\n   355\u2192        bookmark = self.setup_bookmark(description=\"Test description\")\n   356\u2192        self.inline_bookmark_description_test(bookmark)\n   357\u2192\n   358\u2192        # no description, with tags\n   359\u2192        Bookmark.objects.all().delete()\n   360\u2192        bookmark = self.setup_bookmark(\n   361\u2192            description=\"\", tags=[self.setup_tag(), self.setup_tag(), self.setup_tag()]\n   362\u2192        )\n   363\u2192        self.inline_bookmark_description_test(bookmark)\n   364\u2192\n   365\u2192        # with description, with tags\n   366\u2192        Bookmark.objects.all().delete()\n   367\u2192        bookmark = self.setup_bookmark(\n   368\u2192            description=\"Test description\",\n   369\u2192            tags=[self.setup_tag(), self.setup_tag(), self.setup_tag()],\n   370\u2192        )\n   371\u2192        self.inline_bookmark_description_test(bookmark)\n   372\u2192\n   373\u2192    def separate_bookmark_description_test(self, bookmark):\n   374\u2192        html = self.render_template()\n   375\u2192        soup = self.make_soup(html)\n   376\u2192\n   377\u2192        has_description = bool(bookmark.description)\n   378\u2192        has_tags = len(bookmark.tags.all()) > 0\n   379\u2192\n   380\u2192        # inline description block does not exist\n   381\u2192        inline_description = soup.select_one(\".description.inline\")\n   382\u2192        self.assertIsNone(inline_description)\n   383\u2192\n   384\u2192        if not has_description:\n   385\u2192            # no description element\n   386\u2192            description = soup.select_one(\".description\")\n   387\u2192            self.assertIsNone(description)\n   388\u2192        else:\n   389\u2192            # contains description text, without leading/trailing whitespace\n   390\u2192            description = soup.select_one(\".description.separate\")\n   391\u2192            self.assertIsNotNone(description)\n   392\u2192            self.assertEqual(description.text, bookmark.description)\n   393\u2192\n   394\u2192        if not has_tags:\n   395\u2192            # no tags element\n   396\u2192            tags = soup.select_one(\".tags\")\n   397\u2192            self.assertIsNone(tags)\n   398\u2192        else:\n   399\u2192            # tags element exists\n   400\u2192            tags = soup.select_one(\".tags\")\n   401\u2192            self.assertIsNotNone(tags)\n   402\u2192\n   403\u2192            # one link for each tag\n   404\u2192            tag_links = tags.find_all(\"a\")\n   405\u2192            self.assertEqual(len(tag_links), len(bookmark.tags.all()))\n   406\u2192\n   407\u2192            for tag in bookmark.tags.all():\n   408\u2192                tag_link = tags.find(\"a\", string=f\"#{tag.name}\")\n   409\u2192                self.assertIsNotNone(tag_link)\n   410\u2192                self.assertEqual(tag_link[\"href\"], f\"?q=%23{tag.name}\")\n   411\u2192\n   412\u2192    def test_separate_bookmark_description(self):\n   413\u2192        profile = self.get_or_create_test_user().profile\n   414\u2192        profile.bookmark_description_display = (\n   415\u2192            UserProfile.BOOKMARK_DESCRIPTION_DISPLAY_SEPARATE\n   416\u2192        )\n   417\u2192        profile.save()\n   418\u2192\n   419\u2192        # no description, no tags\n   420\u2192        bookmark = self.setup_bookmark(description=\"\")\n   421\u2192        self.separate_bookmark_description_test(bookmark)\n   422\u2192\n   423\u2192        # with description, no tags\n   424\u2192        bookmark = self.setup_bookmark(description=\"Test description\")\n   425\u2192        self.separate_bookmark_description_test(bookmark)\n   426\u2192\n   427\u2192        # no description, with tags\n   428\u2192        Bookmark.objects.all().delete()\n   429\u2192        bookmark = self.setup_bookmark(\n   430\u2192            description=\"\", tags=[self.setup_tag(), self.setup_tag(), self.setup_tag()]\n   431\u2192        )\n   432\u2192        self.separate_bookmark_description_test(bookmark)\n   433\u2192\n   434\u2192        # with description, with tags\n   435\u2192        Bookmark.objects.all().delete()\n   436\u2192        bookmark = self.setup_bookmark(\n   437\u2192            description=\"Test description\",\n   438\u2192            tags=[self.setup_tag(), self.setup_tag(), self.setup_tag()],\n   439\u2192        )\n   440\u2192        self.separate_bookmark_description_test(bookmark)\n   441\u2192\n   442\u2192    def test_bookmark_description_max_lines(self):\n   443\u2192        self.setup_bookmark()\n   444\u2192        html = self.render_template()\n   445\u2192        soup = self.make_soup(html)\n   446\u2192        bookmark_list = soup.select_one(\"ul.bookmark-list\")\n   447\u2192        style = bookmark_list[\"style\"]\n   448\u2192        self.assertIn(\"--ld-bookmark-description-max-lines:1;\", styl