     as_html = renderer.convert(markdown_text)
-    sanitized_html = bleach.clean(as_html, markdown_tags, markdown_attrs)
+
+    # Linkify plain URLs in the rendered HTML while sanitizing
+    try:
+        from functools import partial
+        from bleach.linkifier import LinkifyFilter
+        filters = [partial(LinkifyFilter, callbacks=[])]
+    except Exception:
+        # If linkify is not available, fall back to standard cleaning
+        filters = None
+
+    if filters is not None:
+        cleaner = bleach.Cleaner(
+            tags=markdown_tags,
+            attributes=markdown_attrs,
+            filters=filters,
+        )
+        sanitized_html = cleaner.clean(as_html)
+    else:
+        sanitized_html = bleach.clean(as_html, markdown_tags, markdown_attrs)
 
     return mark_safe(sanitized_html)
