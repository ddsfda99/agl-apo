address environment variables are set\n    49→    * world size is >1\n    50→    * rank environment variable is set\n    51→\n    52→    Returns:\n    53→        bool: True if all of the above conditions hold, False otherwise.\n    54→    \"\"\"\n    55→    port = os.environ.get(\"MASTER_PORT\", \"\")\n    56→    addr = os.environ.get(\"MASTER_ADDR\", \"\")\n    57→    size = int(os.environ.get(\"WORLD_SIZE\", 1))\n    58→    rank = int(os.environ.get(\"RANK\", -1))\n    59→    avlb = dist.is_available()\n    60→    return bool(port and addr and size >= 1 and rank >= 0 and avlb)\n    61→\n    62→\n    63→def _broadcast_tensor(tensor: torch.Tensor, src: int = 0) -> torch.Tensor:\n    64→    \"\"\"Broadcasts a tensor from a source to all other processes.\n    65→\n    66→    Args:\n    67→        tensor (torch.Tensor): torch.Tensor to broadcast.\n    68→        src (int, optional): Source rank. Defaults to 0.\n    69→\n    70→    Returns:\n    71→        torch.Tensor: Broadcasted tensor.\n    72→    \"\"\"\n    73→    if dist.is_available() and dist.is_initialized():\n    74→        device = tensor.device\n    75→        if dist.get_backend() == \"nccl\":\n    76→            tensor = tensor.to(get_device(\"cuda\"))\n    77→        dist.broadcast(tensor, src=src, group=None)\n    78→        return tensor.to(device)\n    79→    else:\n    80→        return tensor\n    81→\n    82→\n    83→def init_distributed(**kwargs: Dict[str, Any]) -> bool:\n    84→    \"\"\"Initialize process group required for ``torch.distributed``.\n    85→\n    86→    Args:\n    87→        **kwargs (Dict[str, Any]): Additional arguments to pass to torch.distributed.init_process_group.\n    88→\n    89→    Returns:\n    90→        bool: True if torch.distributed is initialized.\n    91→\n    92→    Raises:\n    93→        RuntimeError: If torch.distributed is already initialized.\n    94→    \"\"\"\n    95→    if is_distributed():\n    96→        if dist.is_initialized():\n    97→            raise RuntimeError(\"torch.distributed already initialized.\")\n    98→        dist.init_process_group(**kwargs)\n    99→        return True\n   100→    else:\n   101→        return False\n   102→\n   103→\n   104→def set_torch_num_threads() -> None:\n   105→    \"\"\"\n   106→    Sets the number of threads used by torch to utilize all physical CPU\n   107→    cores for intra-op parallelism. Currently, this function sets num_threads\n   108→    to be the number of physical CPU cores divided by the number of GPUs as we\n   109→    use one process per GPU, and this avoids CPU oversubscription. Note that this is\n   110→    currently a rough approximation, and doesn't take into account environments where\n   111→    things like CPU affinity is set.\n   112→    \"\"\"\n   113→    num_threads = os.cpu_count() // (\n   114→        torch.distributed.get_world_size() if torch.distributed.is_initialized() else 1\n   115→    )\n   116→    torch.set_num_threads(num_threads)\n   117→    _log.info(f\"Set intra op parallelism no. of threads to {num_threads}\")\n   118→\n   119→\n   120→def get_world_size_and_rank() -> Tuple[int, int]:\n   121→    \"\"\"Function that gets the current world size (aka total number\n   122→    of ranks) and rank number of the current process in the default process group.\n   123→\n   124→    Returns:\n   125→        Tuple[int, int]: world size, rank\n   126→    \"\"\"\n   127→    if dist.is_available() and dist.is_initialized():\n   128→        return torch.distributed.get_world_size(), torch.distributed.get_rank()\n   129→    else:\n   130→        return 1, 0\n   131→\n   132→\n   133→def validate_no_params_on_meta_device(model: nn.Module) -> None:\n   134→    \"\"\"\n   135→    Utility to validate that model has no params or buffers on meta device.\n   136→    If a meta param or buffer is found, an error indicating the param name will\n   137→    be raised.\n   138→\n   139→    Args:\n   140→        model (nn.Module): model to check for meta params\n   141→\n   142→    Raises:\n   143→        RuntimeError: If meta params or buffers exist in model\n   144→    \"\"\"\n   145→    for n, p in chain(model.named_parameters(), model.named_buffers()):\n   146→        if p.is_meta:\n   147→            raise RuntimeError(f\"Unexpected param or buffer {n} on meta device.\")\n   148→\n   149→\n   150→def load_from_full_model_state_dict(\n   151→    model: \"FSDPModule\",  # noqa\n   152→    full_sd: Dict[str, Any],\n   153→    device: torch.device,\n   154→    is_rank_zero: bool,\n   155→    strict: bool = False,\n   156→    cpu_offload: bool = False,\n   157→):\n   158→    \"\"\"\n   159→    Converting full state dict into a sharded state dict\n   160→    and loading it into FSDP model\n   161→    - 'full' means plain tensor\n   162→    - 'sharded' means `DTensor` where reach rank has a shard of the plain tensor\n   163→    - `is_rank_zero` matters if only rank 0 pass in non-empty `full_sd` and\n   164→       we need to broadcast from rank 0\n   165→    \"\"\"\n   166→    meta_sharded_sd = model.state_dict()\n   167→    sharded_sd = {}\n   168→    for param_name, full_tensor in full_sd.items():\n   169→        sharded_meta_param = meta_sharded_sd.get(param_name)\n   170→        full_tensor = full_tensor.to(sharded_meta_param.dtype).to(device)\n   171→        if hasattr(sharded_meta_param, \"_local_tensor\") and isinstance(\n   172→            sharded_meta_param._local_tensor, NF4Tensor\n   173→        ):\n   174→            block_size = sharded_meta_param._local_tensor.block_size\n   175→            scaler_block_size = sharded_meta_param._local_tensor.scaler_block_size\n   176→            full_tensor = to_nf4(\n   177→                full_tensor, block_size=block_size, scaler_block_size=scaler_block_size\n   178→            )\n   179→            # replicating logic from `_fsdp_param.py`` `_init_sharded_param`\n   180→            # otherwise `distribute_tensor(DTensor(local=NF4))`\n   181→            # requires dispatching `c10d.scatter_``\n   182→            # long-term solution is `swap_tensor`\n   183→            mesh = sharded_meta_param.device_mesh\n   184→            if mesh.ndim > 1:\n   185→                raise NotImplementedError(f\"only support 1D FSDP but got {mesh.ndim=}\")\n   186→            shard_mesh_dim = 0\n   187→            shard_world_size = mesh.size(shard_mesh_dim)\n   188→            shard_rank = cast(\n   189→                torch.distributed.ProcessGroup, mesh.get_group(shard_mesh_dim)\n   190→            ).rank()\n   191→            chunk = list(torch.chunk(full_tensor, shard_world_size, dim=0))[shard_rank]\n   192→            sharded_param = full_tensor.new_zeros(chunk.size())\n   193→            sharded_param[: chunk.size(0)].copy_(chunk)\n   194→\n   195→            # TODO: change to from_local API (need to add view support for NF4)\n   196→            sharded_tensor = DTensor(\n   197→                local_tensor=sharded_param,\n   198→                spec=DTensorSpec(\n   199→                    mesh=sharded_meta_param.device_mesh,\n   200→                    placements=sharded_meta_param.placements,\n   201→                    tensor_meta=TensorMeta(\n   202→                        shape=sharded_meta_param.size(),\n   203→                        dtype=sharded_meta_param.dtype,\n   204→                        stride=sharded_meta_param.stride(),\n   205→                    ),\n   206→                ),\n   207→                requires_grad=sharded_meta_param.requires_grad,\n   208→            )\n   209→\n   210→        elif not hasattr(sharded_meta_param, \"device_mesh\"):\n   211→            # In cases where parts of the model aren't sharded, some parameters will be plain tensors\n   212→            sharded_tensor = full_tensor\n   213→        else:\n   214→            sharded_tensor = distribute_tensor(\n   215→                full_tensor,\n   216→                sharded_meta_param.device_mesh,\n   217→                sharded_meta_param.placements,\n   218→            )\n   219→        if cpu_offload:\n   220→            sharded_tensor = sharded_tensor.cpu()\n   221→        sharded_sd[param_name] = nn.Parameter(sharded_tensor)\n   222→    # choose `assign=True` since we cannot call `copy_` on meta tensor\n   223→    return model.load_state_dict(sharded_sd, strict=strict, assign=True)\n   224→\n   225→\n   226→def _gather_nf4_tensor(sharded_param: nn.Parameter) -> nn.Parameter:\n   227→    \"\"\"\n   228→    Manually gather NF4Tensor parameter since it does not support all_gather\n   229→    \"\"\"\n   230→    mesh = sharded_param.device_mesh\n   231→    nf4_tensor = sharded_param._local_tensor\n   232→    quant_params, metadata = nf4_tensor.fsdp_pre_all_gather(mesh)\n   233→    full_quant_params = []\n   234→    for quant_param in quant_params:\n   235→        d0, *dn = quant_param.shape\n   236→        shape = (d0 * mesh.get_group().size(), *dn)\n   237→        full_quant_param = torch.empty(\n   238→            shape, device=quant_param.device, dtype=quant_param.dtype\n   239→        )\n   240→        dist.all_gather_into_tensor(\n   241→            full_quant_param, quant_param, mesh.get_group(), async_op=False\n   242→        )\n   243→        full_quant_params.append(full_quant_param)\n   244→    full_param, _ = nf4_tensor.fsdp_post_all_gather(\n   245→        full_quant_params, metadata, nf4_tensor.dtype\n   246→    )\n   247→    return full_param\n   248→\n   249→\n   250→def gather_cpu_state_dict(\n   251→    sharded_sd: Dict[str, DTensor],  # noqa\n   252→    is_rank_zero: bool,\n   253→    device: Optional[torch.device] = None,\n   254→) -> Dict[str, Any]:\n   255→    \"\"\"\n   256→    Converting sharded state dict into a full state dict on CPU\n   257→    Returning non-empty result only on rank0 to avoid peaking CPU memory\n   258→\n   259→    Args:\n   260→        sharded_sd (Dict[str, DTensor]): Sharded state dict of DTensors\n   261→        is_rank_zero (bool): flag to check if the process is on rank 0\n   262→        device (Optional[torch.device]): device to use for sharded tensors. Default: None\n   263→\n   264→    Returns:\n   265→        Dict[str, Any]: State dict on CPU\n   266→    \"\"\"\n   267→    cpu_state_dict = {}\n   268→    for param_name, param in sharded_sd.items():\n   269→        if param.is_cpu:\n   270→            # Move back to device if offloaded to CPU\n   271→            param = param.to(device)\n   272→        if hasattr(param, \"_local_tensor\"):\n   273→            if isinstance(param._local_tensor, NF4Tensor):\n   274→                param = _gather_nf4_tensor(param)\n   275→            else:\n   276→                # Gather DTensor\n   277→                param = param.full_tensor()\n   278→        if isinstance(param, NF4Tensor):\n   279→            # upcasting NF4 to original dtype\n   280→            param = param.to(param.dtype)\n   281→        if is_rank_zero:\n   282→            cpu_state_dict[param_name] = param.cpu()\n   283→        torch.distributed.barrier()\n   284→    return cpu_state_dict\n   285→\n   286→\n   287→def get_full_optimizer_state_dict(\n   288→    opt: Optimizer,\n   289→    is_rank_zero: bool,\n   290→    device: Optional[torch.device] = None,\n   291→) -> Dict[str, Any]:\n   292→    \"\"\"\n   293→    Converting optimizer state from sharded to full\n   294→    For example, \"exp_avg\" in AdamW is `DTensor`,\n   295→    \"exp_avg.full_tensor()\" converts it to plain tensor on rank 0\n   296→    Returning non-empty cpu state dict on rank 0\n   297→    \"\"\"\n   298→    sharded_sd = opt.state_dict()\n   299→    sharded_state = sharded_sd[\"state\"]\n   300→    full_state = {}\n   301→    for group_id, sharded_group in sharded_state.items():\n   302→        group_state = {}\n   303→        for attr, sharded_tensor in sharded_group.items():\n   304→            # without this, it may hang forever for +70B models.\n   305→            torch.distributed.barrier()\n   306→            # \"exp_avg\" in AdamW is `D