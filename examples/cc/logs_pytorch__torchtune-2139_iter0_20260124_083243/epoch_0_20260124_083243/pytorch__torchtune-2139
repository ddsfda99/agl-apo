                        "content": "     1\u2192# Copyright (c) Meta Platforms, Inc. and affiliates.\n     2\u2192# All rights reserved.\n     3\u2192#\n     4\u2192# This source code is licensed under the BSD-style license found in the\n     5\u2192# LICENSE file in the root directory of this source tree.\n     6\u2192\n     7\u2192from functools import partial\n     8\u2192\n     9\u2192import pytest\n    10\u2192\n    11\u2192import torch\n    12\u2192from tests.test_utils import fixed_init_model\n    13\u2192from torch import nn\n    14\u2192from torchao.dtypes.nf4tensor import NF4Tensor, to_nf4\n    15\u2192from torchtune import training\n    16\u2192from torchtune.modules.common_utils import reparametrize_as_dtype_state_dict_post_hook\n    17\u2192from torchtune.modules.peft import DoRALinear\n    18\u2192from torchtune.training.seed import set_seed\n    19\u2192\n    20\u2192RANK = 4\n    21\u2192ALPHA = 1.0\n    22\u2192BSZ = 2\n    23\u2192SEQ_LEN = 32\n    24\u2192EXPECTED_VAL = 0.05201\n    25\u2192\n    26\u2192\n    27\u2192@pytest.fixture(autouse=True)\n    28\u2192def random():\n    29\u2192    set_seed(16)\n    30\u2192\n    31\u2192\n    32\u2192class TestDoRALinear:\n    33\u2192    \"\"\"\n    34\u2192    Class for testing our DoRALinear implementation. Expected values are computed\n    35\u2192    from the reference implementation and calculated in scripts/compare_lora.py.\n    36\u2192    \"\"\"\n    37\u2192\n    38\u2192    @pytest.fixture\n    39\u2192    def in_dim(self) -> int:\n    40\u2192        return 64\n    41\u2192\n    42\u2192    @pytest.fixture\n    43\u2192    def out_dim(self) -> int:\n    44\u2192        return 128\n    45\u2192\n    46\u2192    @pytest.fixture\n    47\u2192    def inputs(self, in_dim) -> torch.Tensor:\n    48\u2192        inputs = torch.randn(BSZ, SEQ_LEN, in_dim)\n    49\u2192        return inputs\n    50\u2192\n    51\u2192    @pytest.fixture\n    52\u2192    def dora_linear(self, in_dim, out_dim):\n    53\u2192        def create_dora_linear(use_bias, dtype, in_dim=in_dim, out_dim=out_dim):\n    54\u2192            with training.set_default_dtype(dtype):\n    55\u2192                dora_linear = DoRALinear(\n    56\u2192                    in_dim=in_dim,\n    57\u2192                    out_dim=out_dim,\n    58\u2192                    rank=RANK,\n    59\u2192                    alpha=ALPHA,\n    60\u2192                    use_bias=use_bias,\n    61\u2192                )\n    62\u2192\n    63\u2192                fixed_init_model(dora_linear)\n    64\u2192            return dora_linear\n    65\u2192\n    66\u2192        return create_dora_linear\n    67\u2192\n    68\u2192    @pytest.fixture\n    69\u2192    def qdora_linear(self):\n    70\u2192        def create_qdora_linear(\n    71\u2192            use_bias=False,\n    72\u2192            dtype=torch.bfloat16,\n    73\u2192            in_dim=512,\n    74\u2192            out_dim=512,\n    75\u2192            quantize_base=True,\n    76\u2192            **quantization_kwargs,\n    77\u2192        ):\n    78\u2192            with training.set_default_dtype(dtype):\n    79\u2192                qdora_linear = DoRALinear(\n    80\u2192                    in_dim=in_dim,\n    81\u2192                    out_dim=out_dim,\n    82\u2192                    rank=RANK,\n    83\u2192                    alpha=ALPHA,\n    84\u2192                    use_bias=use_bias,\n    85\u2192                    quantize_base=quantize_base,\n    86\u2192                    **quantization_kwargs,\n    87\u2192                )\n    88\u2192                fixed_init_model(qdora_linear)\n    89\u2192            return qdora_linear\n    90\u2192\n    91\u2192        return create_qdora_linear\n    92\u2192\n    93\u2192    def test_forward(self, inputs, dora_linear, out_dim) -> None:\n    94\u2192        dora_linear = dora_linear(use_bias=False, dtype=torch.float32)\n    95\u2192        expected = torch.tensor(EXPECTED_VAL)\n    96\u2192        actual = dora_linear(inputs)\n    97\u2192        assert actual.shape == (BSZ, SEQ_LEN, out_dim)\n    98\u2192        torch.testing.assert_close(actual.mean(), expected, atol=1e-4, rtol=1e-6)\n    99\u2192\n   100\u2192    @pytest.mark.parametrize(\"use_bias\", [True, False])\n   101\u2192    def test_dora_weight_nf4_when_quantized(self, use_bias, qdora_linear):\n   102\u2192        qdora_linear = qdora_linear(use_bias=use_bias, dtype=torch.bfloat16)\n   103\u2192        assert isinstance(qdora_linear.weight, NF4Tensor)\n   104\u2192        if use_bias:\n   105\u2192            assert not isinstance(qdora_linear.bias, NF4Tensor)\n   106\u2192            assert qdora_linear.bias.dtype == torch.bfloat16\n   107\u2192\n   108\u2192    def test_dora_weight_nf4_when_quantized_with_quantization_kwargs(\n   109\u2192        self, qdora_linear\n   110\u2192    ):\n   111\u2192        qdora_linear = qdora_linear(\n   112\u2192            use_bias=True, dtype=torch.bfloat16, block_size=8, scaler_block_size=4\n   113\u2192        )\n   114\u2192        assert isinstance(qdora_linear.weight, NF4Tensor)\n   115\u2192        assert qdora_linear.weight.block_size == 8\n   116\u2192        assert qdora_linear.weight.scaler_block_size == 4\n   117\u2192        assert not isinstance(qdora_linear.bias, NF4Tensor)\n   118\u2192\n   119\u2192    def test_dora_weight_nf4_when_quantized_raises_value_error_with_bad_args(\n   120\u2192        self, qdora_linear\n   121\u2192    ):\n   122\u2192        \"\"\"Ensure that if quantize_base is False, but we pass in quantization kwargs,\n   123\u2192        we raise a ValueError.\"\"\"\n   124\u2192        with pytest.raises(\n   125\u2192            ValueError,\n   126\u2192            match=\"``quantize_base`` is False, but received the following quantization arguments\",\n   127\u2192        ):\n   128\u2192            qdora_linear(\n   129\u2192                use_bias=True,\n   130\u2192                dtype=torch.bfloat16,\n   131\u2192  