                        "content": "     1\u2192# Copyright (c) Meta Platforms, Inc. and affiliates.\n     2\u2192# All rights reserved.\n     3\u2192#\n     4\u2192# This source code is licensed under the BSD-style license found in the\n     5\u2192# LICENSE file in the root directory of this source tree.\n     6\u2192\n     7\u2192\n     8\u2192import logging\n     9\u2192import os\n    10\u2192from itertools import chain\n    11\u2192from typing import Any, Callable, cast, Dict, List, Optional, Tuple\n    12\u2192\n    13\u2192import torch\n    14\u2192import torch.distributed as dist\n    15\u2192from torch import nn\n    16\u2192\n    17\u2192from torch.distributed._composable.fsdp import CPUOffloadPolicy, fully_shard\n    18\u2192from torch.distributed._tensor import distribute_tensor, DTensor\n    19\u2192from torch.distributed._tensor.placement_types import DTensorSpec, TensorMeta\n    20\u2192from torch.distributed.checkpoint.state_dict import _init_optim_state\n    21\u2192from torch.distributed.fsdp import ShardingStrategy\n    22\u2192from torch.optim import Optimizer\n    23\u2192from torchao.dtypes.nf4tensor import NF4Tensor, to_nf4\n    24\u2192from torchtune.modules import TransformerDecoder\n    25\u2192from torchtune.utils import get_logger\n    26\u2192\n    27\u2192from torchtune.utils._device import get_device\n    28\u2192\n    29\u2192_log: logging.Logger = get_logger()\n    30\u2192\n    31\u2192\n    32\u2192_valid_distributed_single_node_nnodes = [\"1:1\", \"1\"]\n    33\u2192\n    34\u2192\n    35\u2192def _get_sharding_strategy(strategy: str) -> ShardingStrategy:\n    36\u2192    \"\"\"Helper function to convert sharding strategy strings to ShardingStrategy enum.\"\"\"\n    37\u2192    return getattr(ShardingStrategy, strategy)\n    38\u2192\n    39\u2192\n    40\u2192def is_distributed() -> bool:\n    41\u2192    \"\"\"Check if all environment variables required to initialize torch.distributed are set\n    42\u2192    and distributed is properly installed. This indicates a distributed run.\n    43\u2192    https://pytorch.org/docs/stable/distributed.html#environment-variable-initialization\n    44\u2192\n    45\u2192    Checks the following conditions:\n    46\u2192\n    47\u2192    * torch.distributed is available\n    48\u2192    * master port and master address environment variables are set\n    49\u2192    * world size is >1\n    50\u2192    * rank environment variable is set\n    51\u2192\n    52\u2192    Returns:\n    53\u2192        bool: True if all of the above conditions hold, False otherwise.\n    54\u2192    \"\"\"\n    55\u2192    port = os.environ.get(\"MASTER_PORT\", \"\")\n    56\u2192    addr = os.environ.get(\"MASTER_ADDR\", \"\")\n    57\u2192    size = int(os.environ.get(\"WORLD_SIZE\", 1))\n    58\u2192    rank = int(os.environ.get(\"RANK\", -1))\n    59\u2192    avlb = dist.is_available()\n    60\u2192    return bool(port and addr and size >= 1 and rank >= 0 and avlb)\n    61\u2192\n    62\u2192\n    63\u2192def _broadcast_tensor(tensor: torch.Tensor, src: int = 0) -> torch.Tensor:\n    64\u2192    \"\"\"Broadcasts a tensor from a source to all other processes.\n    65\u2192\n    66\u2192    Args:\n    67\u2192        tensor (torch.Tensor): torch.Tensor to broadcast.\n    68\u2192        src (int, optional): Source rank. Defaults to 0.\n    69\u2192\n    70\u2192    Returns:\n    71\u2192        torch.Tensor: Broadcasted tensor.\n    72\u2192    \"\"\"\n    73\u2192    if dist.is_available() and dist.is_initialized():\n    74\u2192        device = tensor.device\n    75\u2192        if dist.get_backend() == \"nccl\":\n    76\u2192            tensor = tensor.to(get_device(\"cuda\"))\n    77\u2192        dist.broadcast(tensor, src=src, group=None)\n    78\u2192        return tensor.to(device)\n    79\u2192    else:\n    80\u2192        return tensor\n    81\u2192\n    82\u2192\n    83\u2192def init_distributed(**kwargs: Dict[str, Any]) -> bool:\n    84\u2192    \"\"\"Initialize process group required for ``torch.distributed``.\n    85\u2192\n    86\u2192    Args:\n    87\u2192        **kwargs (Dict[str, Any]): Additional arguments to pass to torch.distributed.init_process_group.\n    88\u2192\n    89\u2192    Returns:\n    90\u2192        bool: True if torch.distributed is initialized.\n    91\u2192\n    92\u2192    Raises:\n    93\u2192        RuntimeError: If torch.distributed is already initialized.\n    94\u2192    \"\"\"\n    95\u2192    if is_distributed():\n    96\u2192        if dist.is_initialized():\n    97\u2192            raise RuntimeError(\"torch.distributed already initialized.\")\n    98\u2192        dist.init_process_group(**kwargs)\n    99\u2192        return True\n   100\u2192    else:\n   101\u2192        return False\n   102\u2192\n   103\u2192\n   104\u2192def set_torch_num_threads() -> None:\n   105\u2192    \"\"\"\n   106\u2192    Sets the number of threads used by torch to utilize all physical CPU\n   107\u2192    cores for intra-op parallelism. Currently, this function sets num_threads\n   108\u2192    to be the number of physical CPU cores divided by the number of GPUs as we\n   109\u2192    use one process per GPU, and this avoids CPU oversubscription. Note that this is\n   110\u2192    currently a rough approximation, and doesn't take into account environments where\n   111\u2192    things like CPU affinity is set.\n   112\u2192    \"\"\"\n   113\u2192    num_threads = os.cpu_count() // (\n   114\u2192        torch.distributed.get_world_size() if torch.distributed.is_initialized() else 1\n   115\u2192    )\n   116\u2192    torch.set_num_threads(num_threads)\n   117\u2192    _log.info(f\"Set intra op parallelism no. of threads to {num_threads}\")\n   118\u2192\n   119\u2192\n   120\u2192def get_world_size_and_rank() -> Tuple[int, int]:\n   121\u2192    \"\"\"Function that gets the current world size (aka total number\n   122\u2192    of ranks) and rank number of the current process in the default process group.\n