                        "content": "     1\u2192# Copyright (c) Meta Platforms, Inc. and affiliates.\n     2\u2192# All rights reserved.\n     3\u2192#\n     4\u2192# This source code is licensed under the BSD-style license found in the\n     5\u2192# LICENSE file in the root directory of this source tree.\n     6\u2192\n     7\u2192import sys\n     8\u2192import time\n     9\u2192\n    10\u2192from functools import partial\n    11\u2192from typing import Any, Dict, Optional, Tuple, Union\n    12\u2192from warnings import warn\n    13\u2192\n    14\u2192import torch\n    15\u2192import torchtune.modules.common_utils as common_utils\n    16\u2192from omegaconf import DictConfig, ListConfig\n    17\u2192\n    18\u2192from torch import nn\n    19\u2192from torch.optim import Optimizer\n    20\u2192from torch.utils.data import DataLoader, DistributedSampler\n    21\u2192from torchtune import config, modules, training, utils\n    22\u2192from torchtune.config._utils import _get_component_from_path\n    23\u2192from torchtune.data import padded_collate_packed\n    24\u2192from torchtune.datasets import ConcatDataset\n    25\u2192from torchtune.modules.peft import (\n    26\u2192    get_adapter_params,\n    27\u2192    get_adapter_state_dict,\n    28\u2192    get_lora_module_names,\n    29\u2192    get_merged_lora_ckpt,\n    30\u2192    load_dora_magnitudes,\n    31\u2192    set_trainable_params,\n    32\u2192    validate_missing_and_unexpected_for_lora,\n    33\u2192)\n    34\u2192from torchtune.recipe_interfaces import FTRecipeInterface\n    35\u2192from torchtune.training import DummyProfiler, PROFILER_KEY\n    36\u2192\n    37\u2192from tqdm import tqdm\n    38\u2192\n    39\u2192log = utils.get_logger(\"DEBUG\")\n    40\u2192\n    41\u2192\n    42\u2192class LoRAFinetuneRecipeSingleDevice(FTRecipeInterface):\n    43\u2192    \"\"\"\n    44\u2192    LoRA finetuning recipe for dense transformer-based LLMs such as Llama2. This recipe is optimized\n    45\u2192    for single GPU training. Training on CPU is not supported.\n    46\u2192\n    47\u2192    Features:\n    48\u2192        - Activation Checkpointing. This can be controlled using the ``enable_activation_checkpointing``\n    49\u2192            flag. Activation checkpointing helps reduce the memory footprint since we no longer keep\n    50\u2192            activations in memory and instead recompute them during the backward pass. This is especially\n    51\u2192            helpful for larger batch sizes when you're memory constrained. But these savings in memory\n    52\u2192            come at the cost of training performance. In most cases training can slow-down quite a bit as\n    53\u2192            a result of this activation recomputation.\n    54\u2192\n    55\u2192        - Activation Offloading. This can be controlled using the ``enable_activation_offloading``\n    56\u2192            flag. Activation offloading is a technique similar to activations checkpointing that helps\n    57\u2192            reduce the memory footprint to prevent OOMs on CUDA and enable bigger batches. Where activations\n    58\u2192            checkpointing drops the activation in the forward to recompute it later in the backward,\n    59\u2192            activations offloading will drop the activation in the forward to the CPU and bring it\n    60\u2192            back during the backward pass. As always, there is a tradeoff--these savings in memory can\n    61\u2192            come at the cost of training performance and CPU resources. To recover some runtime cost,\n    62\u2192            we've added an option to enable offloading on a different stream to permit overlapping with\n    63\u2192            the computation. This option is currently only available on PyTorch 2.5 or later and will\n    64\u2192            be enabled by default if an acceptable torch version is found. Activation offloading can be\n    65\u2192            used in conjunction with activation checkpointing.\n    66\u2192\n    67\u2192        - Precision. Full fp32 and bf16 training are supported. Precision is controlled using the ``dtype``\n    68\u2192            flag. When ``dtype=bf16``, all activations, gradients and optimizer states are in bfloat16. In\n    69\u2192            most cases this should halve the memory footprint of full precision (fp32) training, without\n    70\u2192            loss in model quality (will depend on the model, training data and other settings). For\n    71\u2192            GPUs which do not support bfloat16, we fall back to fp32. Mixed precision training and fp16\n    72\u2192            precision are currently not supported.\n    73\u2192\n    74\u2192        - Gradient Accumulation. You can simulate larger batch sizes by accumulating gradients. This is\n    75\u2192            controlled using the ``gradient_accumulation_steps`` flag.\n    76\u2192\n    77\u2192                Total Batch Size = batch_size * gradient accumulation steps.\n    78\u2192\n    79\u2192            For example: with batch_size=1 and gradient_accumulation_steps=32 we get a total batch size of 32.\n    80\u2192\n    81\u2192            Gradient accumulation is especially useful when you are memory constrained. In this case,\n    82\u2192            accumulating gradients might give you better training speed than enabling activation\n    83\u2192            checkpointing.\n    84\u2192\n    85\u2192        - Lower precision optimizers. This recipe supports lower-precision optimizers from the bitsandbytes\n    86\u2192            library (https://huggingface.co/docs/bitsandbytes/main/en/index). We've tested the recipe with\n    87\u2192            8-bit AdamW and Paged AdamW.\n    88\u2192\n    89\u2192        - Checkpointing. Model weights are checkpointed both at the end of each epoch and at the end of\n    90\u2192            training. Currently we checkpoint both the adapter weights (trainable params only) and the\n    91\u2192            complete merged weights (adapter weights added back to the base model). For more details\n    92\u2192            please take a look at our LoRA tutorial\n    93\u2192            (https://pytorch.org/torchtune/main/tutorials/lora_finetune.html).\n    94\u2192\n    95\u2192            Optimizer State and recipe state (seed, total_epochs, number of epochs run etc) are\n    96\u2192            only saved at the end of a given epoch and used in case of resuming training. Resuming\n    97\u2192            training is controlled by the ``resume_from_checkpoint`` flag. Mid-epoch checkpointing is\n    98\u2192            currently not supported.\n    99\u2192\n   100\u2192            For more details on the checkpointer, please take a look at\n   101\u2192            our checkpointer deepdive (https://pytorch.org/torchtune/main/tutorials/checkpointer.html).\n   102\u2192\n   103\u2192        - Logging. Terminal, Disk, WandB and TensorBoard are all supported.\n   104\u2192\n   105\u2192        - Gradient Clipping. Gradient clipping is supported using the ``clip_grad_norm`` flag. By default,\n   106\u2192            ``clip_grad_norm`` is set to ``None``. If you only want to log the grad norm, you can set\n   107\u2192            ``clip_grad_norm='inf'``.\n   108\u2192\n   109\u2192    For a full list of example configs for this recipe, run ``tune ls`` on the command line. Each config\n   110\u2192    has example commands for how to kick-off training.\n   111\u2192\n   112\u2192    Args:\n   113\u2192        cfg (DictConfig): OmegaConf object parsed from yaml file\n   114\u2192\n   115\u2192    Raises:\n   116\u2192        ValueError: If ``dtype`` is set to fp16.\n   117\u2192        RuntimeError: If ``dtype`` is set to bf16 and the hardware does not support bf16.\n   118\u2192        RuntimeError: If ``enable_activation_offloading`` is True and device is not CUDA.\n   119\u2192        RuntimeError: If ``enable_activation_offloading`` is True and ``enable_activation_checkpointing`` is False.\n   120\u2192        RuntimeError: If ``left_pad_sequence`` is set as the data collator\n   121\u2192\n   122\u2192    \"\"\"\n   123\u2192\n   124\u2192    def __init__(self, cfg: DictConfig) -> None:\n   125\u2192        self._device = utils.get_device(device=cfg.device)\n   126\u2192        # Reduced precision logic\n   127\u2192        self._dtype = training.get_dtype(cfg.dtype, device=self._device)\n   128\u2192        # fp16 precision is explicitly disabled as it is not supported in this\n   129\u2192        # recipe (for example, no gradient scaling).\n   130\u2192        if self._dtype == torch.float16:\n   131\u2192            raise ValueError(\n   132\u2192                \"fp16 precision is not supported in this recipe. Please use fp32 or bf16.\"\n   133\u2192            )\n   134\u2192\n   135\u2192        # logging attributes\n   136\u2192        self._output_dir = cfg.output_dir\n   137\u2192        self._log_every_n_steps = cfg.get(\"log_every_n_steps\", 1)\n   138\u2192        self._log_peak_memory_stats = cfg.get(\"log_peak_memory_stats\", False)\n   139\u2192\n   140\u2192        if self._log_peak_memory_stats and self._device.type != \"cuda\":\n   141\u2192            log.info(\n   142\u2192                \"log_peak_memory_stats was set to True, however, training does not use cuda. Setting log_peak_memory_stats=False.\"\n   143\u2192            )\n   144\u2192            self._log_peak_memory_stats = False\n   145\u2192\n   146\u2192        # These are public properties which are updated by the checkpoint loader\n   147\u2192        # when ``resume_from_checkpoint`` is `True` or validated in tests\n   148\u2192        self.seed = training.set_seed(seed=cfg.seed)\n   149\u2192        self.epochs_run = 0\n   150\u2192        self.total_epochs = cfg.epochs\n   151\u2192        self.max_steps_per_epoch = cfg.max_steps_per_epoch\n   152\u2192        self.global_step = 0\n   153\u2192        self._resume_from_checkpoint = cfg.resume_from_checkpoint\n   154\u2192        self._save_adapter_weights_only = cfg.get(\"save_adapter_weights_only\", False)\n   155\u2192        self._gradient_accumulation_steps = cfg.gradient_accumulation_steps\n   156\u2192        self._clip_grad_norm = cfg.get(\"clip_grad_norm\", None)\n   157\u2192\n   158\u2192        # activation checkpointing/offloading\n   159\u2192        self._enable_activation_checkpointing = cfg.get(\n   160\u2192            \"enable_activation_checkpointing\", False\n   161\u2192        )\n   162\u2192        self._enable_activation_offloading = cfg.get(\n   163\u2192            \"enable_activation_offloading\", False\n   164\u2192        )\n   165\u2192        if self._enable_activation_offloading:\n   166\u2192            if self._device.type != \"cuda\":\n   167\u2192                raise RuntimeError(\n   168\u2192                    \"enable_activation_offloading should only be True when training on CUDA\"\n   169\u2192                )\n   170\u2192            if not self._enable_activation_checkpointing:\n   171\u2192                raise RuntimeError(\n   172\u2192                    \"enable_activation_offloading should only be True when enable_activation_checkpointing is True\"\n   173\u2192                )\n   174\u2192        elif (\n   175\u2192            self._enable_activation_checkpointing\n   176\u2192            and cfg.checkpointer.model_type != \"LLAMA3_VISION\"\n   177\u2192        ):\n   178\u2192            utils.log_rank_zero(\n   179\u2192                log,\n   180\u2192                \"Hint: enable_activation_checkpointing is True, but enable_activation_offloading isn't. \"\n   181\u2192                \"Enabling activation offloading should reduce memory further.\",\n   182\u2192            )\n   183\u2192\n   184\u2192    def load_checkpoint(self, cfg_checkpointer: DictConfig) -> Dict[str, Any]:\n   185\u2192        \"\"\"\n   186\u2192        Extract the checkpoint state from file and validate. This includes the\n   187\u2192        base model weights. If resume_from_checkpoint is True, this also includes\n   188\u2192        the adapter weights and recipe state\n   189\u2192        \"\"\"\n   190\u2192        self._checkpointer = config.instantiate(\n   191\u2192            cfg_checkpointer,\n   192\u2192            resume_from_checkpoint=self._resume_from_checkpoint,\n   193\u2192        )\n   194\u2192        checkpoint_dict = self._checkpointer.load_checkpoint()\n   195\u2192\n   196\u2192        if self._resume_from_checkpoint:\n   197\u2192            if training.ADAPTER_KEY not in checkpoint_dict:\n   198\u2192                raise ValueError(\n   199\u2192                    \"Adapter weights not found. Please ensure a valid adapter checkpoint is provided.\"\n   200\u2192                )\n   201\u2192            # _update_recipe_state will throw an exception if the recipe state is not corrctly loaded\n   202\u2192            # no need to check here\n   203\u2192            self._update_recipe_state(checkpoint_dict)\n   204\u2192        return checkpoint_dict\n   205\u2192\n   206\u2192    def _update_recipe_state(self, ckpt_dict: Dict[str, Any]) -> None:\n   207\u2192        \"\"\"\n   208\u2192        Updates the recipe state from checkpoint.\n   209\u2192        \"\"\"\n   210\u2192        try:\n   211\u2192            self.epochs_run = ckpt_dict[training.EPOCHS_KEY]\n   212\u2192\n   213\u2192            # on mismatch, warn the user and prevent the override\n   214\u2192            if self.seed != ckpt_dict[training.SEED_KEY]:\n   215\u2192                warn(\n   216\u2192                    message=(\n   217\u2192                        \"Config value for seed does not match the checkpoint value, \"\n   218\u2192                        f\"using the checkpoint value: {ckpt_dict[training.SEED_KEY]}\"\n   219\u2192                    )\n   220\u2192                )\n   221\u2192                self.seed = ckpt_dict[training.SEED_KEY]\n   222\u2192            if self.max_steps_per_epoch != ckpt_dict[training.MAX_STEPS_KEY]:\n   223\u2192                warn(\n   224\u2192                    message=(\n   225\u2192                        \"Config value for max_steps_per_epoch does not match the checkpoint value, \"\n   226\u2192                        f\"using the checkpoint value: {ckpt_dict[training.MAX_STEPS_KEY]}\"\n   227\u2192                    )\n   228\u2192                )\n   229\u2192                self.max_steps_per_epoch = ckpt_dict[training.MAX_STEPS_KEY]\n   230\u2192\n   231\u2192            # on mismatch, warn the user but allow the override\n   232\u2192            if self.total_epochs != ckpt_dict[training.TOTAL_EPOCHS_KEY]:\n   233\u2192                warn(\n   234\u2192                    message=(\n   235\u2192                        \"Config value for total_epochs does not match the checkpoint value, \"\n   236\u2192                        f\"using the config value: {self.total_epochs}\"\n   237\u2192                    )\n   238\u2192                )\n   239\u2192\n   240\u2192        except KeyError as e:\n   241\u2192            raise KeyError(\n   242\u2192                \"Checkpoint does not contain the required keys needed for updating recipe state. \"\n   243\u2192                \"Are you sure you passed in the right recipe checkpoint?\"\n   244\u2192            ) from e\n   245\u2192\n   246\u2192    def setup(self, cfg: DictConfig) -> None:\n   247\u2192        \"\"\"\n   248\u2192        Setup the recipe state. This includes recipe state (if resume_from_checkpoint is True),\n   249\u2192        model, tokenizer, loss, optimizer, learning rate scheduler, sampler, and dataloader.\n   250\u2192        \"\"\"\n   251\u2192        self._metric_logger = config.instantiate(cfg.metric_logger)\n   252\u2192\n   253\u2192        # log config with parameter override\n   254\u2192        self._metric_logger.log_config(cfg)\n   255\u2192\n   256\u2192        self._compile = cfg.compile\n   257\u2192        if cfg.device == \"npu\" and cfg.compile:\n   258\u2192            raise ValueError(\n   259\u2192                \"NPU does not support model compilation. Please set `compile: False` in the config.\"\n   260\u2192            )\n   261\u2192        checkpoint_dict = self.load_checkpoint(cfg_checkpointer=cfg.checkpointer)\n   262\u2192\n   263\u2192        # hack to toggle to the low cpu ram version of the reparametrize_as_dtype\n   264\u2192        # hook based on the config.\n   265\u2192        common_utils._use_low_cpu_ram = cfg.get(\"low_cpu_ram\", False)\n   266\u2192\n   267\u2192        # set up model\n   268\u2192        self._model = self._setup_model(\n   269\u2192            cfg_model=cfg.model,\n   270\u2192            enable_activation_checkpointing=self._enable_activation_checkpointing,\n   271\u2192            enable_activation_offloading=self._enable_activation_offloading,\n   272\u2192            compile_model=cfg.compile,\n   273\u2192            base_model_state_dict=checkpoint_dict[training.MODEL_KEY],\n   274\u2192            lora_weights_state_dict=(\n   275\u2192                checkpoint_dict[training.ADAPTER_KEY]\n   276\u2192                if self._resume_from_checkpoint\n   277\u2192                else None\n   278\u2192            ),\n   279\u2192        )\n   280\u2192\n   281\u2192        self._tokenizer = config.instantiate(cfg.tokenizer)\n   282\u2192        log.info(\"Tokenizer is initialized from file.\")\n   283\u2192\n   284\u2192        self._optimizer = self._setup_optimizer(\n   285\u2192            cfg_optimizer=cfg.optimizer,\n   286\u2192            opt_state_dict=(\n   287\u2192                checkpoint_dict[training.OPT_KEY]\n   288\u2192                if self._resume_from_checkpoint\n   289\u2192                else None\n   290\u2192            ),\n   291\u2192        )\n   292\u2192\n   293\u2192        # initialize loss\n   294\u2192        self._loss_fn = config.instantiate(cfg.loss)\n   295\u2192        if self._compile:\n   296\u2192            self._loss_fn = training.compile_loss(self._loss_fn)\n   297\u2192\n   298\u2192        if self._loss_fn.__class__.__name__ == \"CEWithChunkedOutputLoss\":\n   299\u2192            # set num_output_chunks for model\n   300\u2192            self._model.set_num_output_chunks(self._loss_fn.num_output_chunks)\n   301\u2192\n   302\u2192        log.info(\"Loss is initialized.\")\n   303\u2192\n   304\u2192        # Dataloader depends on the tokenizer and loss_fn and should be\n   305\u2192        # setup after all of these are setup\n   306\u2192        collate_name = cfg.get(\"collate_fn\", \"torchtune.data.padded_collate_sft\")\n   307\u2192        self._sampler, self._dataloader = self._setup_data(\n   308\u2192            cfg_dataset=cfg.dataset,\n   309\u2192            shuffle=cfg.shuffle,\n   310\u2192            batch_size=cfg.batch_size,\n   311\u2192            collate_fn=collate_name,\n   312\u2192        )\n   313\u2192\n   314        # Finally update the recipe state which can only be correctly set after all of the\n   315\u2192        # other components have been initialized and updated.\n   316\u2192\n   317\u2192        # Number of training steps in each epoch depends on the number of batches produced\n   318\u2192        # by the dataloader and the max_steps_per_epoch param set by the user and is used\n   319\u2192        # for logging and tracking training state. This should be computed after the dataloader\n   320\u2192        # has been setup\n   321\u2192        self._steps_per_epoch = (\n   322\u2192            len(self._dataloader) // self._gradient_accumulation_steps\n   323\u2192        )\n   324\u2192        if (\n   325\u2192            self.max_steps_per_epoch is not None\n   326\u2192            and self.max_steps_per_epoch < self._steps_per_epoch\n   327\u2192        ):\n   328\u2192            self._steps_per_epoch = self.max_steps_per_epoch\n   329\u2192            self.global_step = self.epochs_run * self._steps_per_epoch\n   330\u2192\n   331\u2192        # Learning rate scheduler can only be set up after number of steps\n   332\u2192        # has been computed\n   333\u2192        self._lr_scheduler = self._setup_lr_scheduler(\n   334\u2192            cfg_lr_scheduler=cfg.lr_scheduler,\n   335\u2192            num_training_steps=self.total_epochs * self._steps_per_epoch,\n   336\u2192            last_epoch=self.global_step - 1,\n   337\u2192        )\n   338\u2192\n   339\u2192        # Set up profiler, returns DummyProfiler (nullcontext object with no-op `step` method)\n   340\u2192        # if cfg is missing profiler key or if `cfg.profiler.enabled = False\n   341\u2192        self._profiler = self._setup_profiler(cfg.get(PROFILER_KEY, None))\n   342\u2192\n   343\u2192        # Used to ignore labels for loss computation\n   344\u2192        self.ignore_labels_cache = torch.full(\n   345\u2192            (cfg.batch_size, 1), self._loss_fn.ignore_index, device=self._device\n   346\u2192        )\n   347\u2192\n   348\u2192    def _setup_profiler(\n   349\u2192        self, cfg_profiler: Optional[DictConfig] = None\n   350\u2192    ) -> Union[torch.profiler.profile, DummyProfiler]:\n   351\u2192        \"\"\"\n   352\u2192        Parses the `profiler` section of top-level `cfg` and sets up profiler\n   353\u2192\n   354\u2192        Args:\n   355\u2192            cfg_profiler (Optional[DictConfig]): ``profiler`` section of the top-level ``cfg`` (the main config passed to\n   356\u2192                `recipe.main`). Default None.\n   357\u2192\n   358\u2192        Returns:\n   359\u2192            profiler: Union[torch.profiler.profile, DummyProfiler] - DummyProfiler is a nullcontext with no-op methods\n   360\u2192            for `start`, `stop`, and `step` that can be used in place of `torch.profiler.profile` if profiler is not enabled such\n   361\u2192            that the instrumented training loop does not need to be changed profiling is disabled.\n   362\u2192\n   363\u2192        The profiler config can be provided in configs under the `profiler` key with the following layout:\n   364\u2192\n   365\u2192        .. code-block:: yaml\n   366\u2192            profiler:\n   367\u2192                enabled: bool\n   368\u2192\n   369\u2192                #Output directory of trace artifacts\n   370\u2192                output_dir: str\n   371\u2192\n   372\u2192            #`torch.profiler.ProfilerActivity` types to trace\n   373\u2192            cpu: bool\n   374\u2192            cuda: bool\n   375\u2192\n   376\u2192                #Trace options\n   377\u2192                profile_memory: bool\n   378\u2192                with_stack: bool\n   379\u2192                record_shapes: bool\n   380\u2192                with_flops: bool\n   381\u2192\n   382\u2192            # `torch.profiler.schedule` options:\n   383\u2192            # wait_steps -> wait, warmup_steps -> warmup, active_steps -> active, num_cycles -> repeat\n   384\u2192            wait_steps: int\n   385\u2192            warmup_steps: int\n   386\u2192            active_steps: int\n   387\u2192            num_cycles: int\n   388\u2192        \"\"\"\n   389\u2192\n   390\u2192        # Missing profiler section in config, assume disabled\n   391\u2192        if cfg_profiler is None:\n   392\u2192            cfg_profiler = DictConfig({\"enabled\": False})\n   393\u2192\n   394\u2192        # Check that component is included and set correctly\n   395\u2192        if cfg_profiler.get(\"_component_\", None) is None:\n   396\u2192            cfg_profiler[\"_component_\"] = \"torchtune.training.setup_torch_profiler\"\n   397\u2192        else:\n   398\u2192            assert (\n   399\u2192                cfg_profiler.get(\"_component_\")\n   400\u2192                == \"torchtune.training.setup_torch_profiler\"\n   401\u2192            ), \"Only torch profiler supported currently: component must be `torchtune.training.setup_torch_profiler`\"\n   402\u2192\n   403\u2192        profiler, profiler_cfg = config.instantiate(cfg_profiler)\n   404\u2192\n   405\u2192        log.info(f\" Profiler config after instantiation: {profiler_cfg}\")\n   406\u2192\n   407\u2192        self.profiler_profile_memory = profiler_cfg.get(\"profile_memory\", False)\n   408\u2192        if profiler_cfg[\"enabled\"]:\n   409\u2192            self.profiler_wait_steps = profiler_cfg[\"wait_steps\"]\n   410\u2192            self.profiler_warmup_steps = profiler_cfg[\"warmup_steps\"]\n   411\u2192            self.profiler_active_steps = profiler_cfg[\"active_steps\"]\n   412\u2192\n   413\u2192        return profiler\n   414\u2192\n   415\u2192    def _setup_model(\n   416\u2192        self,\n   417\u2192        cfg_model: DictConfig,\n   418\u2192        enable_activation_checkpointing: bool,\n   419\u2192        enable_activation_offloading: bool,\n   420\u2192        compile_model: bool,\n   421\u2192        base_model_state_dict: Dict[str, Any],\n   422\u2192        lora_weights_state_dict: Optional[Dict[str, Any]] = None,\n   423\u2192    ) -> nn.Module:\n   424\u2192        with training.set_default_dtype(self._dtype), self._device:\n   425\u2192            model = config.instantiate(cfg_model)\n   426\u2192\n   427\u2192        self._lora_rank = cfg_model.lora_rank\n   428\u2192        self._lora_alpha = cfg_model.lora_alpha\n   429\u2192        self._lora_attn_modules = list(cfg_model.lora_attn_modules)\n   430\u2192        self._apply_lora_to_mlp = cfg_model.apply_lora_to_mlp\n   431\u2192        self._apply_lora_to_output = getattr(cfg_model, \"apply_lora_to_output\", False)\n   432\u2192        self.adapter_params = get_adapter_params(model)\n   433\u2192        self._is_dora = any([\"magnitude\" in k for k in self.adapter_params.keys()])\n   434\u2192        set_trainable_params(model, self.adapter_params)\n   435\u2192\n   436\u2192        if compile_model:\n   437\u2192            training.compile_model(model)\n   438\u2192\n   439\u2192        if enable_activation_checkpointing:\n   440\u2192            training.set_activation_checkpointing(\n   441\u2192                model, auto_wrap_policy={modules.TransformerSelfAttentionLayer}\n   442\u2192            )\n   443\u2192\n   444\u2192        base_missing, base_unexpected = model.load_state_dict(\n   445\u2192            base_model_state_dict, strict=False\n   446\u2192        )\n   447\u2192        # This is for any adapters that need to be initialized after base weights\n   448\u2192        # have been loaded (e.g. DoRA).\n   449\u2192        if self._is_dora:\n   450\u2192            for m in model.modules():\n   451\u2192                if hasattr(m, \"initialize_dora_magnitude\"):\n   452\u2192                    m.initialize_dora_magnitude()\n   453\u2192            load_dora_magnitudes(model)\n   454\u2192        if lora_weights_state_dict:\n   455\u2192            lora_missing, lora_unexpected = model.load_state_dict(\n   456\u2192                lora_weights_state_dict, strict=False\n   457\u2192            )\n   458\u2192        else:\n   459\u2192            lora_missing, lora_unexpected = None, None\n   460\u2192\n   461\u2192        validate_missing_and_unexpected_for_lora(\n   462\u2192            lora_attn_modules=self._lora_attn_modules,\n   463\u2192            apply_lora_to_mlp=self._apply_lora_to_mlp,\n   464\u2192            apply_lora_to_output=self._apply_lora_to_output,\n   465\u2192            base_missing=base_missing,\n   466\u2192            base_unexpected=base_unexpected,\n   467\u2192            lora_missing=lora_missing,\n   468\u2192            lora_unexpected=lora_unexpected,\n   469\u2192        )\n   470\u2192        # Validate model adapter params were loaded in with the expected dtype\n   471\u2192        # TODO (rohan-varma): Further validation to ensure the appropriate base params\n   472\u2192        # are NF4 vs bf16 based on the quantization config.\n   473\u2192        training.validate_expected_param_dtype(\n   474\u2192            self.adapter_params.items(), dtype=self._dtype\n   475\u2192        )\n   476\u2192\n   477\u2192        # activation offloading\n   478\u2192        self.activations_handling_ctx = training.get_act_offloading_ctx_manager(\n   479\u2192            model, enable_activation_offloading\n   480\u2192        )\n   481\u2192\n   482\u2192        log.info(f\"Model is initialized with precision {self._dtype}.\")\n   483\u2192\n   484\u2192        if self._device.type != \"cpu\":\n   485\u2192            memory_stats = training.get_memory_stats(device=self._device)\n   486\u2192            training.log_memory_stats(memory_stats)\n   487\u2192        return model\n   488\u2192\n   489\u2192    def _setup_optimizer(\n   490\u2192        self, cfg_optimizer: DictConfig, opt_state_dict: Optional[Dict[str, Any]] = None\n   491\u2192    ) -> Optimizer:\n   492\u2192        optimizer = config.instantiate(cfg_optimizer, self._model.parameters())\n   493\u2192        if opt_state_dict:\n   494\u2192            optimizer.load_state_dict(opt_state_dict)\n   495\u2192\n   496\u2192        log.info(\"Optimizer and loss are initialized.\")\n   497\u2192        return optimizer\n   498\u2192\n   499\u2192    def _setup_lr_scheduler(\n   500\u2192        self,\n   501\u2192        cfg_lr_scheduler: DictConfig,\n   502\u2192        num_training_steps: int,\n   503\u2192        last_epoch: int,\n   504\u2192    ) -> Optimizer:\n   505\u2192        lr_scheduler = config.instantiate(\n   506\u2192            cfg_lr_scheduler,\n   507\u2192            self._optimizer,\n   508\u2192            num_training_steps=num_training_steps,\n   509\u2192            last_epoch=last_epoch,\n   510\u2192        )\n   511\u2192\n   512\u2192        log.info(\"Learning rate scheduler is initialized.\")\n   513\u2192        return lr_scheduler\n   514\u2192\n   515\u2192    def _setup_data(\n   516\u2192        self,\n   517\u2192        cfg_dataset: DictConfig,\n   518\u2192        shuffle: bool,\n   519\u2192        batch_size: int,\n   520\u2192        collate_fn: str,\n   521\u2192    ) -> Tuple[DistributedSampler, DataLoader]:\n   522\u2192        \"\"\"\n   523\u2192        All data related setup happens here. Currently this recipe only supports\n   524\u2192        Map-style Datasets which fit into memory and an option for random shuffling.\n   525\u2192        Samplers, iterable datasets, and streaming datasets are not supported.\n   526\u2192        \"\"\"\n   527\u2192        if isinstance(cfg_dataset, ListConfig):\n   528\u2192            datasets = [\n   529\u2192                config.instantiate(single_cfg_dataset, self._tokenizer)\n   530\u2192                for single_cfg_dataset in cfg_dataset\n   531\u2192            ]\n   532\u2192            ds = ConcatDataset(datasets=datasets)\n   533\u2192            packed = False\n   534\u2192        else:\n   535\u2192            ds = config.instantiate(cfg_dataset, self._tokenizer)\n   536\u2192            packed = cfg_dataset.get(\"packed\", False)\n   537\u2192\n   538\u2192        # Instantiate collate_fn\n   539\u2192        if \"left_pad_sequence\" in collate_fn:\n   540\u2192            raise RuntimeError(\"left_pad_sequence collator is only for inference.\")\n   541\u2192        collate_fn = _get_component_from_path(collate_fn)\n   542\u2192\n   543\u2192        sampler = DistributedSampler(\n   544\u2192            ds,\n   545\u2192            num_replicas=1,\n   546\u2192            rank=0,\n   547\u2192            shuffle=shuffle,\n   548\u2192            seed=0,\n   549\u2192        )\n   550\u2192        dataloader = DataLoader(\n   551\u2192            dataset=ds,\n   552\u2192            sampler=sampler,\n   553\u2192            batch_size=batch_size,\n   554\u2192            # dropping last avoids shape issues with compile + flex attention\n   555\u2192            drop_last=True,\n   556\u2192            collate_fn=(\n   557\u2192                partial(\n   558                    collate_fn,\n   559\u2192                    padding_idx=self._tokenizer.pad_id,\n   560\u2192                    ignore_idx=self._loss_fn.ignore_index,\n   561\u2192                )\n   562\u2192                if not packed\n   563\u2192                else padded_collate_packed\n   564\u2192            ),\n   565\u2192        )\n   566\u2192\n   567\u2192        log.info(\"Dataset and Sampler are initialized.\")\n   568\u2192\n   569\u2192        return sampler, dataloader\n   570\u2192\n   571\u2192    def save_checkpoint(self, epoch: int) -> None:\n   572\u2192        \"\"\"\n   573\u2192        Checkpoint the state of the recipe. The constructed checkpoint state dict\n   574\u2192        contains the following information:\n   575\u2192        - Merged weights with key MODEL_KEY\n   576\u2192        - Adapter weights with key ADAPTER_KEY\n   577\u2192        - Relevant recipe state if training is not complete\n   578\u2192        - If the `self._save_adapter_weights_only` option is True, the checkpointer will save only the adapter weights\n   579\u2192\n   580\u2192        To correctly resume from training, the adapter weights and recipe state must be provided along with the base model weights.\n   581\u2192        \"\"\"\n   582\u2192        ckpt_dict = {}\n   583\u2192\n   584\u2192        intermediate_checkpoint = epoch + 1 < self.total_epochs\n   585\u2192        # if training is in-progress, checkpoint the optimizer state as well\n   586\u2192        if intermediate_checkpoint:\n   587\u2192            ckpt_dict.update(\n   588\u2192                {\n   589\u2192                    training.OPT_KEY: self._optimizer.state_dict(),\n   590\u2192                    training.SEED_KEY: self.seed,\n   591\u2192                    training.EPOCHS_KEY: self.epochs_run,\n   592\u2192                    training.TOTAL_EPOCHS_KEY: self.total_epochs,\n   593\u2192                    training.MAX_STEPS_KEY: self.max_steps_per_epoch,\n   594\u2192                }\n   595\u2192            )\n   596\u2192\n   597\u2192        adapter_state_dict = get_adapter_state_dict(self._model.state_dict())\n   598\u2192        ckpt_dict.update({training.ADAPTER_KEY: adapter_state_dict})\n   599\u2192\n   600\u2192        if not self._save_adapter_weights_only:\n   601\u2192            # Construct the full state dict with LoRA weights merged into base LLM weights\n   602\u2192\n   603\u2192            # Move to CPU to avoid a copy on GPU\n   604\u2192            state_dict = {k: v.cpu() for k, v in self._model.state_dict().items()}\n   605\u2192\n   606\u2192            merged_state_dict = get_merged_lora_ckpt(\n   607\u2192                state_dict,\n   608\u2192                rank=self._lora_rank,\n   609\u2192                alpha=self._lora_alpha,\n   610\u2192            )\n   611\u2192\n   612\u2192            ckpt_dict.update({training.MODEL_KEY: merged_state_dict})\n   613\u2192\n   614\u2192        adapter_config = {\n   615\u2192            \"r\": self._lora_rank,\n   616\u2192            \"lora_alpha\": self._lora_alpha,\n   617\u2192            \"target_modules\": get_lora_module_names(\n   618\u2192                self._lora_attn_modules,\n   619\u2192                self._apply_lora_to_mlp,\n   620\u2192                self._apply_lora_to_output,\n   621\u2192            ),\n   622\u2192            \"peft_type\": \"LORA\",\n   623\u2192        }\n   624\u2192        ckpt_dict.update({training.ADAPTER_CONFIG: adapter_config})\n   625\u2192\n   626\u2192        self._checkpointer.save_checkpoint(\n   627\u2192            ckpt_dict,\n   628\u2192            epoch=epoch,\n   629\u2192            intermediate_checkpoint=intermediate_checkpoint,\n   630\u2192            adapter_only=self._save_adapter_weights_only,\n   631\u2192        )\n   632\u2192\n   633\u2192    def _loss_step(self, batch: Dict[str, torch.Tensor]) -> torch.Tensor:\n   634\u2192        # Shape [b, s], needed for the loss not the model\n   635\u2192        labels = batch.pop(\"labels\")\n   636\u2192        # run model\n   637\u2192        with self.activations_handling_ctx:\n   638\u2192            logits = self._model(**batch)\n   639\u2192\n   640\u2192        # Shift labels to compute loss\n   641\u2192        # equivalent to doing labels[..., 1:] and logits[..., :-1, :]\n   642\u2192        # But this way we dont need to slice the logits. We just add an ignore index to labels.\n   643\u2192        labels = torch.hstack(\n   644\u2192            (labels[..., 1:], self.ignore_labels_cache[: labels.shape[0]])\n   645\u2192        )\n   646\u2192        if not isinstance(logits, list):\n   647\u2192            labels = labels.reshape(-1)\n   648\u2192            logits = logits.reshape(-1, logits.size(-1))\n   649\u2192\n   650\u2192        loss = self._loss_fn(logits, labels)\n   651\u2192\n   652\u2192        # free logits otherwise it peaks backward memory\n   653\u2192        del logits\n   654\u2192\n   655\u2192        return loss\n   656\u2192\n   657\u2192    def train(self) -> None:\n   658\u2192        \"\"\"\n   659\u2192        The core training loop.\n   660\u2192        \"\"\"\n   661\u2192\n   662\u2192        if self._compile:\n   663\u2192            log.info(\n   664\u2192                \"NOTE: torch.compile is enabled and model is compiled in first forward. Expect a relatively slow first iteration.\"\n   665\u2192            )\n   666\u2192\n   667\u2192        # Initialize tokens count and running loss (for grad accumulation)\n   668\u2192        t0 = time.perf_counter()\n   669\u2192        running_loss = 0\n   670\u2192        num_tokens = 0\n   671\u2192\n   672\u2192        with self._profiler as prof:\n   673\u2192            # self.epochs_run should be non-zero when we're resuming from a checkpoint\n   674\u2192            for curr_epoch in range(self.epochs_run, self.total_epochs):\n   675\u2192                # Update the sampler to ensure data is correctly shuffled across epochs\n   676\u2192                # in case shuffle is True\n   677\u2192                self._sampler.set_epoch(curr_epoch)\n   678\u2192\n   679\u2192                pbar = tqdm(total=self._steps_per_epoch)\n   680\u2192                for idx, batch in enumerate(self._dataloader):\n   681\u2192                    if (\n   682\u2192                        self.max_steps_per_epoch is not None\n   683\u2192                        and (idx // self._gradient_accumulation_steps)\n   684\u2192                        == self.max_steps_per_epoch\n   685\u2192                    ):\n   686\u2192                        break\n   687\u2192\n   688\u2192                    # Start tracking CUDA memory for active steps for just the first epoch\n   689\u2192                    if (\n   690\u2192                        curr_epoch == 0\n   691\u2192                        and self.profiler_profile_memory\n   692\u2192                        and idx == self.profiler_wait_steps + self.profiler_warmup_steps\n   693\u2192                    ):\n   694\u2192                        torch.cuda.memory._record_memory_history()\n   695\u2192\n   696\u2192                    utils.batch_to_device(batch, self._device)\n   697\u2192\n   698\u2192                    # Calculate the number of unmasked tokens in the current batch\n   699\u2192                    # and increment the total number of tokens seen in the step\n   700\u2192                    current_num_tokens = (\n   701\u2192                        batch[\"labels\"] != self._loss_fn.ignore_index\n   702\u2192                    ).sum()\n   703\u2192                    num_tokens += current_num_tokens\n   704\u2192\n   705\u2192                    # Loss is normalized by default so we multiply by the number of tokens\n   706\u2192                    # This way we can normalize by the total number of tokens if we're accumulating gradients\n   707\u2192                    current_loss = self._loss_step(batch) * current_num_tokens\n   708\u2192                    running_loss += current_loss\n   709\u2192                    current_loss.backward()\n   710\u2192\n   711\u2192                    # Step with optimizer\n   712\u2192                    if (idx + 1) % self._gradient_accumulation_steps == 0:\n   713\u2192                        training.scale_grads(self._model, 1 / num_tokens)\n   714\u2192                        if self._clip_grad_norm is not None:\n   715\u2192                            grad_norm = torch.nn.utils.clip_grad_norm_(\n   716\u2192                                self._model.parameters(),\n   717\u2192                                max_norm=float(self._clip_grad_norm),\n   718\u2192                            )\n   719\u2192                        self._optimizer.step()\n   720\u2192                        self._optimizer.zero_grad(set_to_none=True)\n   721\u2192                        self._lr_scheduler.step()\n   722\u2192                        # Update the number of steps when the weights are updated\n   723\u2192                        self.global_step += 1\n   724\u2192\n   725\u2192                        loss_to_log = running_loss.item() / num_tokens\n   726\u2192                        pbar.update(1)\n   727\u2192                        pbar.set_description(\n   728\u2192                            f\"{curr_epoch + 1}|{self.global_step}|Loss: {loss_to_log}\"\n   729\u2192                        )\n   730\u2192\n   731\u2192                        # Log per-step metrics\n   732\u2192                        if self.global_step % self._log_every_n_steps == 0:\n   733\u2192                            time_per_step = time.perf_counter() - t0\n   734\u2192                            log_dict = {\n   735\u2192                                \"loss\": loss_to_log,\n   736\u2192                                \"lr\": self._optimizer.param_groups[0][\"lr\"],\n   737\u2192                                \"tokens_per_second_per_gpu\": num_tokens / time_per_step,\n   738\u2192                            }\n   739\u2192                            if (\n   740\u2192                                self._device.type == \"cuda\"\n   741\u2192                                and self._log_peak_memory_stats\n   742\u2192                            ):\n   743\u2192                                log_dict.update(\n   744\u2192                                    training.get_memory_stats(device=self._device)\n   745\u2192                                )\n   746\u2192                            if self._clip_grad_norm is not None:\n   747\u2192                                log_dict.update({\"grad_norm\": grad_norm})\n   748\u2192                            self._metric_logger.log_dict(\n   749\u2192                                log_dict,\n   750\u2192                                step=self.global_step,\n   751\u2192                            )\n   752\u2192\n   753\u2192                        # Reset running stats for the next step\n   754\u2192                        running_loss = 0\n   755\u2192                        num_tokens = 0\n   756\u2192                        t0 = time.perf_counter()\n   757\u2192\n   758\u2192                    # Stop tracking CUDA memory now that active steps are complete\n   759\u2192                    if (\n   760\u2192                        curr_epoch == 0\n   761\u2192                        and self.profiler_profile_memory\n   762\u2192                        and idx\n   763\u2192                        == self.profiler_wait_steps\n   764\u2192                        + self.profiler_warmup_steps\n   765\u2192                        + self.profiler_active_steps\n   766\u2192                    ):\n   767\u2192                        torch.cuda.memory._record_memory_history(enabled=None)\n   768\u2192\n   769\u2192                    # Step the profiler\n   770\u2192                    # Note we are stepping each batch, which might not include optimizer step in the trace\n   771\u2192                    # if the schedule cycle doesn't align with gradient accumulation.\n   772\u2192                    prof.step()\n   773\u2192\n   774\u2192                self.epochs_run += 1\n   775\u2192                start_save_checkpoint = time.perf_counter()\n   776\u2192                log.info(\"Starting checkpoint save...\")\n   777\u2192                self.save_checkpoint(epoch=curr_epoch)\n   778\u2192                log.info(\n   779\u2192                    \"Checkpoint saved in {:.2f} seconds.\".format(\n   780\u2192                        time.perf_counter() - start_save_checkpoint\n   781\u2192                    )\n   782\u2192                )\n   783\u2192\n   784\u2192    def cleanup(self) -> None:\n   785\u2192        self._metric_logger.close()\n   786\u2192\n   787\u2192\n   788\u2192@config.parse\n   789\u2192def recipe_main(cfg: DictConfig) -> None:\n   790\u2192    \"\"\"\n   791\u2192    Entry point for the recipe.\n   792\u2192\n   793\u2192    Configurable parameters are read in the following order:\n   794\u2192        - Parameters specified in config (see available configs through ``tune ls``)\n   795\u2192        - Overwritten by arguments from the command-line\n   796\u2192    \"\"\"\n   797\u2192    config.log_config(recipe_name=\"LoRAFinetuneRecipeSingleDevice\", cfg=cfg)\n   798\u2192    recipe = LoRAFinetuneRecipeSingleDevice(cfg=cfg)\n   799\u2192    recipe.setup(cfg=cfg)\n   800\u2192    recipe.train()\n   801\u2192    recipe.cleanup()\n   802\u2192\n   803\u2192\n   804\u2192if __name__ == \"__main__\":\n   805\u2192    sys.exit(recipe_main())\n   806\u2192\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"
