 bool]]:\n   163→        \"\"\"Given a list of condition names this function will\n   164→        yield scenarios that represent those conditions and\n   165→        there result (True/False)\n   166→\n   167→        Args:\n   168→            condition_names (list[str]): A list of condition names\n   169→\n   170→        Returns:\n   171→            Iterator[dict[str, bool]]: yield dict objects of {ConditionName: True/False}\n   172→        \"\"\"\n   173→        # nothing to yield if there are no conditions\n   174→        if len(conditions) == 0:\n   175→            return\n   176→\n   177→        c_cnf = self._cnf.copy()\n   178→        condition_names = []\n   179→        conditions_set = {}\n   180→        for condition_name, values in conditions.items():\n   181→            if condition_name in self._conditions:\n   182→                if values == {True}:\n   183→                    c_cnf.add_prop(\n   184→                        self._conditions[condition_name].build_true_cnf(\n   185→                            self._solver_params\n   186→                        )\n   187→                    )\n   188→                    conditions_set[condition_name] = True\n   189→                    continue\n   190→                if values == {False}:\n   191→                    c_cnf.add_prop(\n   192→                        self._conditions[condition_name].build_false_cnf(\n   193→                            self._solver_params\n   194→                        )\n   195→                    )\n   196→                    conditions_set[condition_name] = False\n   197→                    continue\n   198→            condition_names.append(condition_name)\n   199→\n   200→        try:\n   201→            # build a large matric of True/False options\n   202→            # based on the provided conditions\n   203→            scenarios_attempted = 0\n   204→            if region:\n   205→                products = itertools.starmap(\n   206→                    self.build_scenerios_on_region,\n   207→                    itertools.product(condition_names, [region]),\n   208→                )\n   209→            else:\n   210→                products = itertools.product([True, False], repeat=len(condition_names))  # type: ignore\n   211→\n   212→            for p in products:\n   213→                cnf = c_cnf.copy()\n   214→                params = dict(zip(condition_names, p))\n   215→                for condition_name, opt in params.items():\n   216→                    if opt:\n   217→                        cnf.add_prop(\n   218→                            self._conditions[condition_name].build_true_cnf(\n   219→                                self._solver_params\n   220→                            )\n   221→                        )\n   222→                    else:\n   223→                        cnf.add_prop(\n   224→                            self._conditions[condition_name].build_false_cnf(\n   225→                                self._solver_params\n   226→                            )\n   227→                        )\n   228→\n   229→                # if the scenario can be satisfied then return it\n   230→                if satisfiable(cnf):\n   231→                    yield {**params, **conditions_set}\n   232→\n   233→                scenarios_attempted += 1\n   234→                # On occassions people will use a lot of non-related conditions\n   235→                # this is fail safe to limit the maximum number of responses\n   236→                if scenarios_attempted >= self._max_scenarios:\n   237→                    return\n   238→        except KeyError:\n   239→            # KeyError is because the listed condition doesn't exist because of bad\n   240→            #  formatting or just the wrong condition name\n   241→            return\n   242→\n   243→    def check_implies(self, scenarios: dict[str, bool], implies: str) -> bool:\n   244→        \"\"\"Based on a bunch of scenario conditions and their Truth/False value\n   245→        determine if implies condition is True any time the scenarios are satisfied\n   246→        solver, solver_params = self._build_solver(list(scenarios.keys()) + [implies])\n   247→\n   248→        Args:\n   249→            scenarios (dict[str, bool]): A list of condition names\n   250→            and if they are True or False implies: the condition name that\n   251→            we are implying will also be True\n   252→\n   253→        Returns:\n   254→            bool: if the implied condition will be True if the scenario is True\n   255→        \"\"\"\n   256→        try:\n   257→            cnf = self._cnf.copy()\n   258→            # if the implies condition has to be false in the scenarios we\n   259→            # know it can never be true\n   260→            if not scenarios.get(implies, True):\n   261→                return False\n   262→\n   263→            conditions = []\n   264→            for condition_name, opt in scenarios.items():\n   265→                if opt:\n   266→                    conditions.append(\n   267→                        self._conditions[condition_name].build_true_cnf(\n   268→                            self._solver_params\n   269→                        )\n   270→                    )\n   271→                else:\n   272→                    conditions.append(\n   273→                        self._conditions[condition_name].build_false_cnf(\n   274→                            self._solver_params\n   275→                        )\n   276→                    )\n   277→\n   278→            implies_condition = self._conditions[implies].build_true_cnf(\n   279→                self._solver_params\n   280→            )\n   281→\n   282→            and_condition = And(*conditions)\n   283→            cnf.add_prop(and_condition)\n   284→\n   285→            # if the implies condition has to be true already then we don't\n   286→            # need to imply it\n   287→            if not scenarios.get(implies):\n   288→                cnf.add_prop(Not(Implies(and_condition, implies_condition)))\n   289→            if satisfiable(cnf):\n   290→                return True\n   291→\n   292→            return False\n   293→        except KeyError:\n   294→            # KeyError is because the listed condition doesn't exist because of bad\n   295→            #  formatting or just the wrong condition name\n   296→            return True\n   297→\n   298→    @lru_cache()\n   299→    def build_scenerios_on_region(\n   300→        self, condition_name: str, region: str\n   301→    ) -> Iterator[bool]:\n   302→        \"\"\"Based on a region validate if the condition_name could be true\n   303→\n   304→        Args:\n   305→            condition_name (str): The name of the condition we are validating against\n   306→            region (str): the name of the region\n   307→\n   308→        Returns:\n   309→            Generator[bool]: Returns True, False, or True and False depending on if the\n   310→               condition could be True, False or both based on the region parameter\n   311→        \"\"\"\n   312→        if not isinstance(condition_name, str):\n   313→            return\n   314→        cnf_region = self._cnf.copy()\n   315→        found_region = False\n   316→\n   317→        # validate the condition name exists\n   318→        # return True/False if it doesn't\n   319→        if condition_name not in self._conditions:\n   320→            yield True\n   321→            yield False\n   322→            return\n   323→\n   324→        for eql in self._conditions[condition_name].equals:\n   325→            is_region, equal_region = eql.is_region\n   326→            if is_region:\n   327→                found_region = True\n   328→                if equal_region == region:\n   329→                    cnf_region.add_prop(And(self._solver_params[eql.hash]))\n   330→                else:\n   331→                    cnf_region.add_prop(Not(self._solver_params[eql.hash]))\n   332→\n   