Tuple\n    13→\n    14→from sympy import And, Implies, Not, Symbol\n    15→from sympy.assumptions.cnf import EncodedCNF\n    16→from sympy.logic.boolalg import BooleanFalse, BooleanTrue\n    17→from sympy.logic.inference import satisfiable\n    18→\n    19→from cfnlint.conditions._condition import ConditionNamed\n    20→from cfnlint.conditions._equals import Equal, EqualParameter\n    21→from cfnlint.conditions._errors import UnknownSatisfisfaction\n    22→from cfnlint.conditions._utils import get_hash\n    23→\n    24→LOGGER = logging.getLogger(__name__)\n    25→\n    26→\n    27→class Conditions:\n    28→    \"\"\"Conditions provides the logic for relating individual condition together\"\"\"\n    29→\n    30→    _max_scenarios: int = 128  # equivalent to 2^7\n    31→\n    32→    def __init__(self, cfn) -> None:\n    33→        self._conditions: dict[str, ConditionNamed] = {}\n    34→        self._parameters: dict[str, list[str]] = {}\n    35→        self._init_conditions(cfn=cfn)\n    36→        self._init_parameters(cfn=cfn)\n    37→        self._cnf, self._solver_params = self._build_cnf(list(self._conditions.keys()))\n    38→\n    39→    def _init_conditions(self, cfn):\n    40→        conditions = cfn.template.get(\"Conditions\")\n    41→        if isinstance(conditions, dict):\n    42→            for k, _ in conditions.items():\n    43→                try:\n    44→                    self._conditions[k] = ConditionNamed(k, conditions)\n    45→                except ValueError as e:\n    46→                    LOGGER.debug(\n    47→                        \"Captured error while building condition %s: %s\", k, str(e)\n    48→                    )\n    49→                except Exception as e:  # pylint: disable=broad-exception-caught\n    50→                    if LOGGER.getEffectiveLevel() == logging.DEBUG:\n    51→                        error_message = traceback.format_exc()\n    52→                    else:\n    53→                        error_message = str(e)\n    54→                    LOGGER.debug(\n    55→                        \"Captured unknown error while building condition %s: %s\",\n    56→                        k,\n    57→                        error_message,\n    58→                    )\n    59→\n    60→    def _init_parameters(self, cfn: Any) -> None:\n    61→        parameters = cfn.template.get(\"Parameters\")\n    62→        if not isinstance(parameters, dict):\n    63→            return\n    64→        for parameter_name, parameter in parameters.items():\n    65→            if not isinstance(parameter, dict):\n    66→                continue\n    67→            allowed_values = parameter.get(\"AllowedValues\")\n    68→            if not allowed_values or not isinstance(allowed_values, list):\n    69→                continue\n    70→\n    71→            param_hash = get_hash({\"Ref\": parameter_name})\n    72→            self._parameters[param_hash] = []\n    73→            for allowed_value in allowed_values:\n    74→                if isinstance(allowed_value, (str, int, float, bool)):\n    75→                    self._parameters[param_hash].append(get_hash(str(allowed_value)))\n    76→\n    77→    def get(self, name: str, default: Any = None) -> ConditionNamed:\n    78→        \"\"\"Return the conditions\"\"\"\n    79→        return self._conditions.get(name, default)\n    80→\n    81→    def _build_cnf(\n    82→        self, condition_names: list[str]\n    83→    ) -> Tuple[EncodedCNF, dict[str, Any]]:\n    84→        cnf = EncodedCNF()\n    85→\n    86→        # build parameters and equals into solver\n    87→        equal_vars: dict[str, Symbol] = {}\n    88→\n    89→        equals: dict[str, Equal] = {}\n    90→        for condition_name in condition_names:\n    91→            c_equals = self._conditions[condition_name].equals\n    92→            for c_equal in c_equals:\n    93→                # check to see if equals already matches another one\n    94→                if c_equal.hash in equal_vars:\n    95→                    continue\n    96→\n    97→                if c_equal.is_static is not None:\n    98→                    if c_equal.is_static:\n    99→                        equal_vars[c_equal.hash] = BooleanTrue()\n   100→                    else:\n   101→                        equal_vars[c_equal.hash] = BooleanFalse()\n   102→                else:\n   103→                    equal_vars[c_equal.hash] = Symbol(c_equal.hash)\n   104→                    # See if parameter in this equals is the same as another equals\n   105→                    for param in c_equal.parameters:\n   106→                        for e_hash, e_equals in equals.items():\n   107→                            if param in e_equals.parameters:\n   108→                                # equivalent to NAND logic. We want to make\n   109→                                # sure that both equals are not both True\n   110→                                # at the same time\n   111→                                cnf.add_prop(\n   112→                                    ~(equal_vars[c_equal.hash] & equal_vars[e_hash])\n   113→                                )\n   114→                equals[c_equal.hash] = c_equal\n   115→\n   116→        # Determine if a set of conditions can never be all false\n   117→        allowed_values = self._parameters.copy()\n   118→        if allowed_values:\n   119→            # iteration 1 cleans up all the hash values\n   120→            # from allowed_values to know if we\n   121→            # used them all\n   122→            for _, equal_1 in equals.items():\n   123→                for param in equal_1.parameters:\n   124→                    if param.hash not in allowed_values:\n   125→                        continue\n   126→                    if isinstance(equal_1.left, str):\n   127→                        if get_hash(equal_1.left) in allowed_values[param.hash]:\n   128→                            allowed_values[param.hash].remove(get_hash(equal_1.