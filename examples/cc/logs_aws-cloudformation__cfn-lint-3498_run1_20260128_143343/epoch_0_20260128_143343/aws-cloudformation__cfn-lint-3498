 153→        Returns:\n   154→            bool: True if the AWS::Serverless-2016-10-31 transform is declared, False otherwise.\n   155→        \"\"\"\n   156→        lang_extensions_transform = \"AWS::Serverless-2016-10-31\"\n   157→        transform_declaration = self.transform_pre[\"Transform\"]\n   158→        transform_type = (\n   159→            transform_declaration\n   160→            if isinstance(transform_declaration, list)\n   161→            else [transform_declaration]\n   162→        )\n   163→        return bool(lang_extensions_transform in transform_type)\n   164→\n   165→    def is_cdk_template(self) -> bool:\n   166→        \"\"\"Check if the template was created by the AWS Cloud Development Kit (CDK).\n   167→\n   168→        Returns:\n   169→            bool: True if the template was created by CDK, False otherwise.\n   170→        \"\"\"\n   171→        resources = self.template.get(\"Resources\")\n   172→        if not isinstance(resources, dict):\n   173→            return False\n   174→\n   175→        for _, properties in resources.items():\n   176→            if not isinstance(properties, dict):\n   177→                continue\n   178→            resource_type = properties.get(\"Type\")\n   179→            if not isinstance(resource_type, str):\n   180→                continue\n   181→            if resource_type == \"AWS::CDK::Metadata\":\n   182→                return True\n   183→\n   184→        return False\n   185→\n   186→    def get_resources(\n   187→        self, resource_type: list[str] | str = []\n   188→    ) -> dict[str, dict[str, Any]]:\n   189→        \"\"\"Get the resources in the template.\n   190→\n   191→        Args:\n   192→            resource_type (list[str] | str): An optional list or string of resource types to filter by.\n   193→\n   194→        Returns:\n   195→            dict[str, dict[str, Any]]: A dictionary containing the resources, where the keys are resource names\n   196→                and the values are the resource dictionaries.\n   197→        \"\"\"\n   198→        resources = self.template.get(\"Resources\", {})\n   199→        if not isinstance(resources, dict):\n   200→            return {}\n   201→        if isinstance(resource_type, str):\n   202→            resource_type = [resource_type]\n   203→\n   204→        results = {}\n   205→        for k, v in resources.items():\n   206→            if isinstance(v, dict):\n   207→                if (v.get(\"Type\", None) in resource_type) or (\n   208→                    not resource_type and v.get(\"Type\") is not None\n   209→                ):\n   210→                    results[k] = v\n   211→\n   212→        return results\n   213→\n   214→    def get_resource_children(\n   215→        self, resource_name: str, types: list[str] | None = None\n   216→    ) -> Iterator[str]:\n   217→        \"\"\"Get the resource children for a given resource name.\n   218→\n   219→        Args:\n   220→            resource_name (str): The name of the resource.\n   221→            types (list[str] | None): An optional list of resource types to filter by.\n   222→\n   223→        Yields:\n   224→            str: The name of each resource child.\n   225→        \"\"\"\n   226→        types = types or []\n   227→\n   228→        if self.graph:\n   229→            for node_name in self.graph.graph.predecessors(resource_name):\n   230→                node = self.graph.graph.nodes[node_name]\n   231→                if node[\"type\"] != \"Resource\":\n   232→                    continue\n   233→\n   234→                if types:\n   235→                    if node[\"resource_type\"] in types:\n   236→                        yield node_name\n   237→                else:\n   238→                    yield node_name\n   239→\n   240→    def get_parameters_valid(self) -> dict[str, dict[str, Any]]:\n   241→        \"\"\"Get the valid parameters in the template.\n   242→\n   243→        Returns:\n   244→            dict[str, dict[str, Any]]: A dictionary containing the valid parameters, where the keys are parameter names\n   245→                and the values are the parameter dictionaries.\n   246→        \"\"\"\n   247→        result = {}\n   248→        if isinstance(self.template.get(\"Parameters\"), dict):\n   249→            parameters = self.template.get(\"Parameters\", {})\n   250→            for parameter_name, parameter_value in parameters.items():\n   251→                if isinstance(parameter_value, dict):\n   252→                    if isinstance(parameter_value.get(\"Type\"), str):\n   253→                        result[parameter_name] = parameter_value\n   254→\n   255→        return result\n   256→\n   257→    def get_modules(self) -> dict[str, dict[str, Any]]:\n   258→        \"\"\"Get the modules in the template.\n   259→\n   260→        Returns:\n   261→            dict[str, dict[str, Any]]: A dictionary containing the modules, where the keys are module names\n   262→                and the values are the module dictionaries.\n   263→        \"\"\"\n   264→        resources = self.template.get(\"Resources\", {})\n   265→        if not resources:\n   266→            return {}\n   267→\n   268→        results = {}\n   269→        for k, v in resources.items():\n   270→            if isinstance(v, dict):\n   271→                if v.get(\"Type\") is not None and str(v.get(\"Type\")).endswith(\n   272→                    \"::MODULE\"\n   273→                ):\n   274→                    results[k] = v\n   275→\n   276→        return results\n   277→\n   278→    def get_valid_refs(self) -> cfnlint.helpers.RegexDict:\n   279→        \"\"\"Get a dictionary of valid references in the template.\n   280→\n   281→        Returns:\n   282→            cfnlint.helpers.RegexDict: A dictionary containing valid references, where the keys are reference names\n   283→                and the values are dictionaries with information about the reference type and source.\n   284→        \"\"\"\n   285→        results = cfnlint.helpers.RegexDict()\n   286→        parameters = self.template.get(\"Parameters\", {})\n   287→        if parameters:\n   288→            for name, value in parameters.items():\n   289→                if isinstance(value, dict):\n   290→                    if \"Type\" in value:\n   291→                        element = {}\n   292→                        element[\"Type\"] = value[\"Type\"]\n   293→                        element[\"From\"] = \"Parameters\"\n   294→                        results[name] = element\n   295→        resources = self.template.get(\"Resources\", {})\n   296→        if resources:\n   297→            for name, value in resources.items():\n   298→                resource_type = value.get(\"Type\", \"\")\n   299→                if not isinstance(resource_type, str):\n   300→                    continue\n   301→                if resource_type.endswith(\"::MODULE\"):\n   302→                    element = {}\n   303→                    element[\"Type\"] = \"MODULE\"\n   304→                    element[\"From\"] = \"Resources\"\n   305→                    results[f\"{name}.*\"] = element\n   306→                elif resource_type:\n   307→                    element = {}\n   308→                    element[\"Type\"] = resource_type\n   309→                    element[\"From\"] = \"Resources\"\n   310→                    results[name] = element\n   311→\n   312→        for pseudoparam in cfnlint.helpers.PSEUDOPARAMS:\n   313→            element = {}\n   314→            element[\"Type\"] = \"Pseudo\"\n   315→            element[\"From\"] = \"Pseudo\"\n   316→            results[pseudoparam] = element\n   317→        return results\n   318→\n   319→    def get_valid_getatts(self) -> GetAtts:\n   320→        \"\"\"Get an instance of GetAtts containing valid GetAtt references in the template.\n   321→\n   322→        Returns:\n   323→            GetAtts: An instance of GetAtts containing valid GetAtt references.\n   324→        \"\"\"\n   325→        results = GetAtts(self.regions)\n   326→\n   327→        for name, value in self.context.resources.items():\n   328→            results.add(name, value.type)\n   329→\n   330→        return results\n   331→\n   332→    def get_directives(self) -> dict[str, list[str]]:\n   333→        \"\"\"Get the directives (ignore_checks) in the template.\n   334→\n   335→        Returns:\n   336→            dict[str, list[str]]: A dictionary containing directives, where the keys are directive names\n   337→                and the values are lists of resource names associated with the directive.\n   338→        \"\"\"\n   339→        results: dict[str, list[str]] = {}\n   340→        resources = self.get_resources()\n   341→        if resources:\n   342→            for resource_name, resource_values in resources.items():\n   343→                if isinstance(resource_values, dict):\n   344→                    ignore_rule_ids = (\n   345→                        resource_values.get(\"Metadata\", {})\n   346→                        .get(\"cfn-lint\", {})\n   347→                        .get(\"config\", {})\n   348→                        .get(\"ignore_checks\", [])\n   349→                    )\n   350→                    for ignore_rule_id in ignore_rule_ids:\n   351→                        if ignore_rule_id not in results:\n   352→                            results[ignore_rule_id] = []\n   353→                        results[ignore_rule_id].append(resource_name)\n   354→        return results\n   355→\n   356→    # pylint: disable=dangerous-default-value\n   357→    def _search_deep_keys(self, searchText: str | re.Pattern, cfndict, path: Path):\n   358→        \"\"\"Search deep for keys and get their values.\n   359→\n   360→        Args:\n   361→            searchText (str | re.Pattern): The text or regular expression pattern to search for.\n   362→            cfndict (Any): The dictionary or list to search in.\n   363→            path (list[Any]): The current path in the dictionary or list.\n   364→\n   365→        Returns:\n   366→            list[list[Any]]: A list of paths where the searchText was found.\n   367→        \"\"\"\n   368→        keys = []\n   369→        if isinstance(cfndict, dict):\n   370→            for key in cfndict:\n   371→                pathprop: Path = path[:]\n   372→                pathprop.append(key)\n   373→                if isinstance(searchText, str):\n   374→                    if key == searchText:\n   375→                        pathprop.append(cfndict[key])\n   376→                        keys.append(pathprop)\n   377→                        # pop the last element off for nesting of found elements for\n   378→                        # dict and list checks\n   379→                        pathprop = pathprop[:-1]\n   380→                elif isinstance(searchText, re.Pattern):\n   381→                    if isinstance(key, str):\n   382→                        if re.match(searchText, key):\n   383→                            pathprop.append(cfndict[key])\n   384→                            keys.append(pathprop)\n   385→                            # pop the last element off for nesting of found elements for\n   386→                            # dict and list checks\n   387→                            pathprop = pathprop[:-1]\n   388→                if isinstance(cfndict[key], dict):\n   389→                    keys.extend(\n   390→                        self._search_deep_keys(searchText, cfndict[key], pathprop)\n   391→                    )\n   392→                elif isinstance(cfndict[key], list):\n   393→                    for index, item in enumerate(cfndict[key]):\n   394→                        pathproparr = pathprop[:]\n   395→                        pathproparr.append(index)\n   396→                        keys.extend(\n   397→                            self._search_deep_keys(searchText, item, pathproparr)\n   398→                        )\n   399→        elif isinstance(cfndict, list):\n   400→            for index, item in enumerate(cfndict):\n   401→                pathprop = path[:]\n   402→                pathprop.append(index)\n   403→                keys.extend(self._search_deep_keys(searchText, item, pathprop))\n   404→\n   405→        return keys\n   406→\n   407→    def search_deep_keys(\n   408→        self, searchText: str | re.Pattern, includeGlobals: bool = True\n   409→    ):\n   410→        \"\"\"Search for a key in all parts of the template.\n   411→\n   412→        Args:\n   413→            searchText (str | re.Pattern): The text or regular expression pattern to search for.\n   414→            includeGlobals (bool): Whether to include globals in the search.\n   415→\n   416→        Returns:\n   417→            liist[[Any]]: A list of paths where the searchText was found.\n   418→\n   419→        Example:\n   420→            If searchText is \"Ref\", the return value could be something like\n   421→            ['Resources', 'myInstance', 'Properties', 'ImageId', 'Ref', 'Ec2ImageId']\n   422→        \"\"\"\n   423→        results = []\n   424→        results.extend(self._search_deep_keys(searchText, self.template, []))\n   425→        # Globals are removed during a transform.  They need to be checked manually\n   426→        if includeGlobals:\n   427→            pre_results = self._search_deep_keys(\n   428→                searchText, self.transform_pre.get(\"Globals\"), []\n   429→            )\n   430→            for pre_result in pre_results:\n   431→                results.append([\"Globals\"] + pre_result)\n   432→        return results\n   433→\n   434→    def get_condition_values(self, template, path: Path | None) -> list[dict[str, Any]]:\n   435→        \"\"\"\n   436→        Evaluates conditions in the provided CloudFormation template and returns the values.\n   437→\n   438→        Args:\n   439→            template (list): The CloudFormation template to evaluate.\n   440→            path (list, optional): The current path in the template. Defaults to an empty list.\n   441→\n   442→        Returns:\n   443→            list: A list of dictionaries, where each dictionary contains the following keys:\n   444→                - \"Path\": The path to the condition value in the template.\n   445→                - \"Value\": The value of the condition.\n   446→        \"\"\"\n   447→        path = path or []\n   448→        matches: list[dict[str, Any]] = []\n   449→        if not isinstance(template, list):\n   450→            return matches\n   451→        if not len(template) == 3:\n   452→            return matches\n   453→\n   454→        for index, item in enumerate(template[1:]):\n   455→            result: dict[str, Any] = {}\n   456→            result[\"Path\"] = path[:] + [index + 1]\n   457→            if not isinstance(item, (dict, list)):\n   458→                # Just straight values and pass them through\n   459→                result[\"Value\"] = item\n   460→                matches.append(result)\n   461→            elif len(item) == 1:\n   462→                # Checking for conditions inside of conditions\n   463→                if isinstance(item, dict):\n   464→                    for sub_key, sub_value in item.items():\n   465→                        if sub_key in cfnlint.helpers.CONDITION_FUNCTIONS:\n   466→                            results = self.get_condition_values(\n   467→                                sub_value, result[\"Path\"] + [sub_key]\n   468→                            )\n   469→                            if isinstance(results, list):\n   470→                                matches.extend(results)\n   471→                        elif sub_key == \"Ref\":\n   472→                            if sub_value != \"AWS::NoValue\":\n   473→                                result[\"Value\"] = item\n   474→                                matches.append(result)\n   475→                        else:\n   476→                            # Return entire Item\n   477→                            result[\"Value\"] = item\n   478→                            matches.append(result)\n   479→                else:\n   480→                    # Return entire Item\n   481→                    result[\"Value\"] = item\n   482→                    matches.append(result)\n   483→            else:\n   484→                # Length longer than 1 means a list or object that\n   485→                # should be fully returned\n   486→                result[\"Value\"] = item\n   487→                matches.append(result)\n   488→\n   489→        return matches\n   490→\n   491→    def get_values(self, obj, key, path: Path | None = None):\n   492→        \"\"\"\n   493→        Logic for getting the value of a key in the provided object.\n   494→\n   495→        Args:\n   496→            obj (dict): The object to search for the key.\n   497→            key (str): The key to search for in the object.\n   498→            path (list, optional): The current path in the object. Defaults to an empty list.\n   499→\n   500→        Returns:\n   501→            list: A list of dictionaries, where each dictionary contains the following keys:\n   502→            - \"Path\": The path to the value in the object.\n   503→            - \"Value\": The value found for the key.\n   504→\n   505→            Types of return values\n   506→            - Returns None if the item isn't found\n   507→            - Returns empty list if the item is found but Ref or GetAtt\n   508→            - Returns all the values as a list if condition\n   509→            - Returns the value if its just a string, int, boolean, etc.\n   510→        \"\"\"\n   511→        path = path or []\n   512→        matches = []\n   513→\n   514→        if not isinstance(obj, dict):\n   515→            return None\n   516→        value = obj.get(key)\n   517→        if value is None:\n   518→            return None\n   519→        if isinstance(value, (dict)):\n   520→            if len(value) == 1:\n   521→                is_condition = False\n   522→                is_no_value = False\n   523→                for obj_key, obj_value in value.items():\n   524→                    if obj_key in cfnlint.helpers.CONDITION_FUNCTIONS:\n   525→                        is_condition = True\n   526→                        results = self.get_condition_values(\n   527→                            obj_value, path[:] + [obj_key]\n   528→                        )\n   529→                        if isinstance(results, list):\n   530→                            for result in results:\n   531→                                check_obj = obj.copy()\n   532→                                check_obj[key] = result[\"Value\"]\n   533→                                matches.extend(\n   534→                                    self.get_values(check_obj, key, result[\"Path\"])\n   535→                                )\n   536→                    elif obj_key == \"Ref\" and obj_value == \"AWS::NoValue\":\n   537→                        is_no_value = True\n   538→                if not is_condition and not is_no_value:\n   539→                    result = {}\n   540→                    result[\"Path\"] = path[:]\n   541→                    result[\"Value\"] = value\n   542→                    matches.append(result)\n   543→            else:\n   544→                result = {}\n   545→                result[\"Path\"] = path[:]\n   546→                result[\"Value\"] = value\n   547→                matches.append(result)\n   548→        elif isinstance(value, (list)):\n   549→            for list_index, list_value in enumerate(value):\n   550→                if isinstance(list_value, dict):\n   551→                    if len(list_value) == 1:\n   552→                        is_condition = False\n   553→                        is_no_value = False\n   554→                        for obj_key, obj_value in list_value.items():\n   555→                            if obj_key in cfnlint.helpers.CONDITION_FUNCTIONS:\n   556→                                is_condition = True\n   557→                                results = self.get_condition_values(\n   558→                                    obj_value, path[:] + [list_index, obj_key]\n   559→                                )\n   560→                                if isinstance(results, list):\n   561→                                    matches.extend(results)\n   562→                            elif obj_key == \"Ref\" and obj_value == \"AWS::NoValue\":\n   563→                                is_no_value = True\n   564→                        if not is_condition and not is_no_value:\n   565→                            result = {}\n   566→                            result[\"Path\"] = path[:] + [list_index]\n   567→                            result[\"Value\"] = list_value\n   568→                            matches.append(result)\n   569→                    else:\n   570→                        result = {}\n   571→                        result[\"Path\"] = path[:] + [list_index]\n   572→                        result[\"Value\"] = list_value\n   573→                        matches.append(result)\n   574→                else:\n   575→                    result = {}\n   576→                    result[\"Path\"] = path[:] + [list_index]\n   577→                    result[\"Value\"] = list_value\n   578→                    matches.append(result)\n   579→        else:\n   580→            result = {}\n   581→            result[\"Path\"] = path[:]\n   582→            result[\"Value\"] = value\n   583→            matches.append(result)\n   584→\n   585→        return matches\n   586→\n   587→    def _loc(self, obj: Any) -> tuple[int, int, int, int]:\n   588→        \"\"\"Return location of object\"\"\"\n   589→        return (\n   590→            obj.start_mark.line,\n   591→            obj.start_mark.column,\n   592→            obj.end_mark.line,\n   593→            obj.end_mark.column,\n   594→        )\n   595→\n   596→    def get_sub_parameters(self, sub_string):\n   597→        \"\"\"\n   598→        Gets the parameters out of a Sub String.\n   599→\n   600→        Args:\n   601→            sub_string (str): The Sub string to extract parameters from.\n   602→\n   603→        Returns:\n   604→            list: A list of the parameter names found in the Sub string.\n   605→        \"\"\"\n   606→        results = []\n   607→        if not isinstance(sub_string, str):\n   608→            return results\n   609→        regex = re.compile(r\"\\${[^!].*?}\")\n   610→        string_params = regex.findall(sub_string)\n   611→\n   612→        for string_param in string_params:\n   613→            results.append(string_param[2:-1].strip())\n   614→\n   615→        return results\n   616→\n   617→    def get_location_yaml(self, text: Any, path: Path):\n   618→        \"\"\"\n   619→        Get the location information for the given YAML text and path.\n   620→\n   621→        Args:\n   622→            text (str): The YAML text to search.\n   623→            path (list): The path to the location within the YAML text.\n   624→\n   625→        Returns:\n   626→            dict or None: A dictionary containing the location information, or None if the location could not be found.\n   627→            The dictionary has the following keys:\n   628→                - \"start_mark\": A dictionary with \"line\" and \"column\" keys indicating the start of the location.\n   629→                - \"end_mark\": A dictionary with \"line\" and \"column\" keys indicating the end of the location.\n   630→        \"\"\"\n   631→        result = None\n   632→        if not path:\n   633→            result = self._loc(text)\n   634→        elif len(path) > 1:\n   635→            try:\n   636→                result = self.get_location_yaml(text[path[0]], path[1:])\n   637→            except KeyError:\n   638→                pass\n   639→            # TypeError will help catch string indices must be integers for when\n   640→            # we parse JSON string and get a path inside that json string\n   641→            except TypeError:\n   642→                pass\n   643→            if not result:\n   644→                try:\n   645→                    for key in text:\n   646→                        if key == path[0]:\n   647→                            result = self._loc(key)\n   648→                except AttributeError as err:\n   649→                    LOGGER.debug(err)\n   650→        else:\n   651→            # If the last item of the path is an integer, and the vaue is an array,\n   652→            # Get the location of the item in the array\n   653→            if isinstance(text, list) and isinstance(path[0], int):\n   654→                try:\n   655→                    result = self._loc(text[path[0]])\n   656→                except AttributeError as err:\n   657→                    LOGGER.debug(err)\n   658→            else:\n   659→                try:\n   660→                    for key in text:\n   661→                        if key == path[0]:\n   662→                            result = self._loc(key)\n   663→                except AttributeError as err:\n   664→                    LOGGER.debug(err)\n   665→\n   666→        return result\n   667→\n   668→    # pylint: disable=W0613,too-many-locals\n   669→    def check_value(\n   670→        self,\n   671→        obj: dict[str, Any],\n   672→        key: str,\n   673→        path: Path,\n   674→        check_value: CheckValueFn | None = None,\n   675→        check_ref: CheckValueFn | None = None,\n   676→        check_get_att: CheckValueFn | None = None,\n   677→        check_find_in_map: CheckValueFn | None = None,\n   678→        check_split: CheckValueFn | None = None,\n   679→        check_join: CheckValueFn | None = None,\n   680→        check_import_value: CheckValueFn | None = None,\n   681→        check_sub: CheckValueFn | None = None,\n   682→        pass_if_null: bool = False,\n   683→        **kwargs: dict[str, Any],\n   684→    ) -> list[RuleMatch]:\n   685→        \"\"\"\n   686→        Check the value of a key in the provided object.\n   687→\n   688→        Args:\n   689→            obj (dict): The object to check the value of.\n   690→            key (str): The key to check the value of.\n   691→            path (list): The path to the current location in the object.\n   692→            check_value (callable, optional): A function to check the value of the key.\n   693→            check_ref (callable, optional): A function to check the \"Ref\" function.\n   694→            check_get_att (callable, optional): A function to check the \"Fn::GetAtt\" function.\n   695→            check_find_in_map (callable, optional): A function to check the \"Fn::FindInMap\" function.\n   696→            check_split (callable, optional): A function to check the \"Fn::Split\" function.\n   697→            check_join (callable, optional): A function to check the \"Fn::Join\" function.\n   698→            check_import_value (callable, optional): A function to check the \"Fn::ImportValue\" function.\n   699→            check_sub (callable, optional): A function to check the \"Fn::Sub\" function.\n   700→            pass_if_null (bool, optional): Whether to pass if the value is null. Defaults to False.\n   701→            **kwargs (dict): Additional keyword arguments to pass to the check functions.\n   702→\n   703→        Returns:\n   704→            list[RuleMatch]: A list of matches found during the check.\n   705→        \"\"\"\n   706→        matches = []\n   707→        values_obj = self.get_values(obj=obj, key=key)\n   708→        new_path = path[:] + [key]\n   709→        if values_obj is None and pass_if_null:\n   710→            if check_value:\n   711→                matches.extend(\n   712→                    check_value(value=values_obj, path=new_path[:], **kwargs)\n   713→                )\n   714→        elif not values_obj:\n   715→            return matches\n   716→        else:\n   717→            for value_obj in values_obj:\n   718→                value = value_obj[\"Value\"]\n   719→                child_path = value_obj[\"Path\"]\n   720→                if not isinstance(value, dict):\n   721→                    if check_value:\n   722→                        matches.extend(\n   723→                            check_value(\n   724→                                value=value, path=new_path[:] + child_path, **kwargs\n   725→                            )\n   726→                        )\n   727→                else:\n   728→                    if len(value) == 1:\n   729→                        for dict_name, _ in value.items():\n   730→                            # If this is a function we shouldn't fall\n   731→                            # back to a check_value check\n   732→                            if dict_name in cfnlint.helpers.FUNCTIONS:\n   733→                                # convert the function name from camel case\n   734→                                # to underscore\n   735→                                # Example: Fn::FindInMap becomes\n   736→                                # check_find_in_map\n   737→                                # ruff: noqa: E501\n   738→                                function_name = f'check_{camel_to_snake(dict_name.replace(\"Fn::\", \"\"))}'\n   739→                                if function_name == \"check_ref\":\n   740→                                    if check_ref:\n   741→                                        matches.extend(\n   742→                                            check_ref(\n   743→                                                value=value.get(\"Ref\"),\n   744→                                                path=new_path[:] + child_path + [\"Ref\"],\n   745→                                                parameters=self.template.get(\n   746→                                                    \"Parameters\", {}\n   747→                                                ),\n   748→                                                resources=self.get_resources(),\n   749→                                                **kwargs,\n   750→                                            )\n   751→                                        )\n   752→                                else:\n   753→                                    if locals().get(function_name):\n   754→                                        matches.extend(\n   755→                                            locals()[function_name](\n   756→                                                value=value.get(dict_name),\n   757→                                                path=new_path[:]\n   758→                                                + child_path\n   759→                                                + [dict_name],\n   760→                                                **kwargs,\n   761→                                            )\n   762→                                        )\n   763→                            else:\n   764→                                if check_value:\n   765→                                    matches.extend(\n   766→                                        check_value(\n   767→                                            value=value,\n   768→                                            path=new_path[:] + child_path,\n   769→                                            **kwargs,\n   770→                                        )\n   771→                                    )\n   772→                    else:\n   773→                        if check_value:\n   774→                            matches.extend(\n   775→                                check_value(\n   776→                                    value=value, path=new_path[:] + child_path, **kwargs\n   777→                                )\n   778→                            )\n   779→\n   780→        return matches\n   781→\n   782→    def is_resource_available(self, path: Path, resource: str) -> list[dict[str, bool]]:\n   783→        \"\"\"\n   784→        Compares a path to a resource to see if it is available.\n   785→\n   786→        This function returns scenarios that may result in the resource not existing.\n   787→\n   788→        Args:\n   789→            path (list): An array that is a path to the object being checked.\n   790→            resource (str): The resource being compared.\n   791→\n   792→        Returns:\n   793→            list: If the resource is available, the result is an empty list [].\n   794→                If the resource is not available, the function returns a list of dictionaries,\n   795→                where each dictionary represents a scenario where the resource is not available.\n   796→                The dictionary keys are the condition names, and the values indicate whether\n   797→                the condition is True or False.\n   798→        \"\"\"\n   799→        results: list[dict[str, bool]] = []\n   800→        path_conditions = self.get_conditions_from_path(self.template, path)\n   801→        resource_condition = (\n   802→            self.template.get(\"Resources\", {}).get(resource, {}).get(\"Condition\")\n   803→        )\n   804→        if isinstance(resource_condition, str):\n   805→            # if path conditions are empty that means its always true\n   806→            if not path_conditions:\n   807→                return [{resource_condition: False}]\n   808→\n   809→            # resource conditions are always true.  If the same resource condition\n   810→            # exists in the path with the True then nothing else matters\n   811→            if True in path_conditions.get(resource_condition, {False}):\n   812→                return []\n   813→\n   814→            # resource conditions are always true.  If the same resource condition\n   815→            # exists in the path with the False then nothing else matters\n   816→            if False in path_conditions.get(resource_condition, {True}):\n   817→                return [{resource_condition: False}]\n   818→\n   819→            # if any condition paths loop back on themselves with the opposite\n   820→            # then its unreachable code\n   821→            scenario = {}\n   822→            for condition_name, condition_bool in path_conditions.items():\n   823→                if len(condition_bool) > 1:\n   824→                    return results\n   825                scenario[condition_name] = list(condition_bool)[0]\n   826→\n   827→            if self.conditions.check_implies(scenario, resource_condition):\n   828→                return [{**{resource_condition: False}, **scenario}]\n   829→\n   830→        # if resource condition isn't available then the resource is available\n   831→        return results\n   832→\n   833→    def get_object_without_nested_conditions(\n   834→        self, obj: dict | list, path: Path, region: str | None = None\n   835→    ):\n   836→        \"\"\"\n   837→        Get a list of object values without conditions included.\n   838→\n   839→        Evaluates deep into the object removing any nested conditions as well.\n   840→\n   841→        Args:\n   842→            obj (dict): The object to process.\n   843→            path (list): The current path in the object.\n   844→            region (str, optional): The AWS region to use for evaluating conditions. Defaults to None.\n   845→\n   846→        Returns:\n   847→            list: A list of dictionaries, where each dictionary contains the following keys:\n   848→                - \"Scenario\": The scenario for the object, or None if there are no conditions.\n   849→                - \"Object\": The object with conditions removed.\n   850→        \"\"\"\n   851→        results = []\n   852→        scenarios = self.get_condition_scenarios_below_path(path, False, region)\n   853→        if not isinstance(obj, (dict, list)):\n   854→            return results\n   855→\n   856→        def get_value(value, scenario):  # pylint: disable=R0911\n   857→            \"\"\"Get the value based on the scenario resolving nesting\"\"\"\n   858→            if isinstance(value, dict):\n   859→                if len(value) == 1:\n   860→                    if \"Fn::If\" in value:\n   861→                        if_values = value.get(\"Fn::If\")\n   862→                        if len(if_values) == 3:\n   863→                            if_path = scenario.get(if_values[0], None)\n   864→                            if if_path is not None:\n   865→                                if if_path:\n   866→                                    return get_value(if_values[1], scenario)\n   867→                                return get_value(if_values[2], scenario)\n   868→                    elif value.get(\"Ref\") == \"AWS::NoValue\":\n   869→                        return None\n   870→\n   871→                new_object = {}\n   872→                for k, v in value.items():\n   873→                    new_v = get_value(v, scenario)\n   874→                    if new_v is not None:\n   875→                        new_object[k] = get_value(v, scenario)\n   876→                return new_object\n   877→            if isinstance(value, list):\n   878→                new_list = []\n   879→                for item in value:\n   880→                    new_value = get_value(item, scenario)\n   881→                    if new_value is not None:\n   882→                        new_list.append(get_value(item, scenario))\n   883→\n   884→                return new_list\n   885→\n   886→            return value\n   887→\n   888→        if not scenarios:\n   889→            if isinstance(obj, dict):\n   890→                if len(obj) == 1:\n   891→                    if obj.get(\"Ref\") == \"AWS::NoValue\":\n   892→                        return [{\"Scenario\": None, \"Object\": {}}]\n   893→            return [{\"Scenario\": None, \"Object\": get_value(obj, {})}]\n   894→\n   895→        for scenario in scenarios:\n   896→            results.append({\"Scenario\": scenario, \"Object\": get_value(obj, scenario)})\n   897→\n   898→        return results\n   899→\n   900→    def get_value_from_scenario(self, obj, scenario):\n   901→        \"\"\"\n   902→        Get object values from a provided scenario.\n   903→\n   904→        This function recursively processes the provided object, resolving any\n   905→        conditional logic (such as Fn::If) based on the given scenario.\n   906→\n   907→        Args:\n   908→            obj (dict): The object to process.\n   909→            scenario (dict): The scenario to use when resolving conditional logic.\n   910→\n   911→        Returns:\n   912→            dict or list or any: The processed object, with conditional logic resolved.\n   913→            The return type can be a dictionary, list, or any other data type,\n   914→            depending on the structure of the input object.\n   915→        \"\"\"\n   916→\n   917→        def get_value(value, scenario):  # pylint: disable=R0911\n   918→            \"\"\"Get the value based on the scenario resolving nesting\"\"\"\n   919→            if isinstance(value, dict):\n   920→                if len(value) == 1:\n   921→                    if \"Fn::If\" in value:\n   922→                        if_values = value.get(\"Fn::If\")\n   923→                        if len(if_values) == 3:\n   924→                            if_path = scenario.get(if_values[0], None)\n   925→                            if if_path is not None:\n   926→                                if if_path:\n   927→                                    return get_value(if_values[1], scenario)\n   928→                                return get_value(if_values[2], scenario)\n   929→                    elif value.get(\"Ref\") == \"AWS::NoValue\":\n   930→                        return None\n   931→                    else:\n   932→                        return value\n   933→\n   934→                return value\n   935→            if isinstance(value, list):\n   936→                new_list = []\n   937→                for item in value:\n   938→                    new_value = get_value(item, scenario)\n   939→                    if new_value is not None:\n   940→                        new_list.append(get_value(item, scenario))\n   941→\n   942→                return new_list\n   943→\n   944→            return value\n   945→\n   946→        if isinstance(obj, dict):\n   947→            result = dict_node({}, obj.start_mark, obj.end_mark)\n   948→            if len(obj) == 1:\n   949→                if obj.get(\"Fn::If\"):\n   950→                    new_value = get_value(obj, scenario)\n   951→                    if new_value is not None:\n   952→                        result = new_value\n   953→                else:\n   954→                    for key, value in obj.items():\n   955→                        new_value = get_value(value, scenario)\n   956→                        if new_value is not None:\n   957→                            result[key] = new_value\n   958→            else:\n   959→                for key, value in obj.items():\n   960→                    new_value = get_value(value, scenario)\n   961→                    if new_value is not None:\n   962→                        result[key] = new_value\n   963→            return result\n   964→        if isinstance(obj, list):\n   965→            result = list_node({}, obj.start_mark, obj.end_mark)\n   966→            for item in obj:\n   967→                element = get_value(item, scenario)\n   968→                if element is not None:\n   969→                    result.append(element)\n   970→\n   971→            return result\n   972→\n   973→        return obj\n   974→\n   975→    def get_object_without_conditions(self, obj, property_names=None, region=None):\n   976→        \"\"\"\n   977→        Gets a list of object values without conditions included\n   978→        Input:\n   979→            obj: The object/dict that makes up a set of properties\n   980→            Example:\n   981→                {\n   982→                    \"DBSnapshotIdentifier\" : {\n   983→                        \"Fn::If\" : [\n   984→                            \"UseDBSnapshot\",\n   985→                            {\"Ref\" : \"DBSnapshotName\"},\n   986→                            {\"Ref\" : \"AWS::NoValue\"}\n   987→                        ]\n   988→                    }\n   989→                }\n   990→        Output:\n   991→            A list of objects with scenarios for the conditions played out.\n   992→            If Ref to AWS::NoValue remove the property\n   993→            Example: [\n   994→                {\n   995→                    Object: {\n   996→                        \"DBSnapshotIdentifier\" : {\"Ref\" : \"DBSnapshotName\"}\n   997→                    },\n   998→                    Scenario: {UseDBSnapshot: True}\n   999→                }, {\n  1000→                    Object: {\n  1001→                    },\n  1002→                    Scenario: {UseDBSnapshot: False}\n  1003→                }\n  1004→            ]\n  1005→        \"\"\"\n  1006→        if not isinstance(obj, (dict, list)):\n  1007→            return [{\"Scenario\": None, \"Object\": obj}]\n  1008→        property_names = [] if property_names is None else property_names\n  1009→        if getattr(obj, \"start_mark\", None):\n  1010→            start_mark = obj.start_mark\n  1011→            end_mark = obj.end_mark\n  1012→        else:\n  1013→            start_mark = (0, 0)\n  1014→            end_mark = (0, 0)\n  1015→        if isinstance(obj, list):\n  1016→            o = list_node(deepcopy(obj), start_mark=start_mark, end_mark=end_mark)\n  1017→        else:\n  1018→            if property_names:\n  1019→                o = dict_node({}, start_mark=start_mark, end_mark=end_mark)\n  1020→                for property_name in property_names:\n  1021→                    o[property_name] = deepcopy(obj.get(property_name))\n  1022→            else:\n  1023→                o = dict_node(deepcopy(obj), start_mark=start_mark, end_mark=end_mark)\n  1024→\n  1025→        results = []\n  1026→\n  1027→        scenarios = self.get_conditions_scenarios_from_object(o, region)\n  1028→\n  1029→        if isinstance(obj, list):\n  1030→            if not scenarios:\n  1031→                return [\n  1032→                    {\"Scenario\": None, \"Object\": self.get_value_from_scenario(o, {})}\n  1033→                ]\n  1034→            for scenario in scenarios:\n  1035→                result_list = []\n  1036→                for o in obj:\n  1037→                    result_obj = self.get_value_from_scenario(o, scenario)\n  1038→                    if result_obj:\n  1039→                        result_list.append(result_obj)\n  1040→                results.append({\"Scenario\": scenario, \"Object\": result_list})\n  1041→        if isinstance(obj, dict):\n  1042→            if not scenarios:\n  1043→                if len(obj) == 1:\n  1044→                    if obj.get(\"Ref\") == \"AWS::NoValue\":\n  1045→                        return []\n  1046→                return [\n  1047→                    {\"Scenario\": None, \"Object\": self.get_value_from_scenario(o, {})}\n  1048→                ]\n  1049→\n  1050→            for scenario in scenarios:\n  1051→                result_obj = self.get_value_from_scenario(o, scenario)\n  1052→                if result_obj:\n  1053→                    results.append({\"Scenario\": scenario, \"Object\": result_obj})\n  1054→\n  1055→        return results\n  1056→\n  1057→    def get_condition_scenarios_below_path(\n  1058→        self,\n  1059→        path: Path,\n  1060→        include_if_in_function: bool = False,\n  1061→        region: str | None = None,\n  1062→    ) -> list[dict[str, bool]]:\n  1063→        \"\"\"\n  1064→        Get all possible scenarios for the conditions in the provided object.\n  1065→\n  1066→        This function recursively processes the object, identifying any conditional\n  1067→        logic (such as Fn::If) and generating all possible scenarios based on the\n  1068→        conditions.\n  1069→\n  1070→        Args:\n  1071→            obj (dict): The object to process.\n  1072→            region (str, optional): The AWS region to use for evaluating conditions. Defaults to None.\n  1073→\n  1074→        Returns:\n  1075→            list: A list of dictionaries, where each dictionary represents a possible\n  1076→            scenario. The keys in the dictionary are the condition names, and the\n  1077→            values are boolean values indicating whether the condition is True or False.\n  1078→        \"\"\"\n  1079→        fn_ifs = self.search_deep_keys(\"Fn::If\")\n  1080→        results: dict[str, set] = {}\n  1081→        for fn_if in fn_ifs:\n  1082→            if len(fn_if) >= len(path):\n  1083→                if path == fn_if[0 : len(path)]:\n  1084→                    # This needs to handle items only below the Path\n  1085→                    result = self.get_conditions_from_path(\n  1086→                        self.template, fn_if[0:-1], True, include_if_in_function\n  1087→                    )\n  1088→                    for condition_name, condition_values in result.items():\n  1089→                        if condition_name in results:\n  1090→                            results[condition_name].union(condition_values)\n  1091→                        else:\n  1092→                            results[condition_name] = condition_values\n  1093→\n  1094→        return list(self.conditions.build_scenarios(results, region))\n  1095→\n  1096→    def get_conditions_scenarios_from_object(self, objs, region=None):\n  1097→        \"\"\"\n  1098→        Get the conditions that are applicable for the given path in the template.\n  1099→\n  1100→        This function recursively traverses the template, following the provided path,\n  1101→        and collects all the conditions that are relevant for the given path.\n  1102→\n  1103→        Args:\n  1104→            template (dict): The CloudFormation template to analyze.\n  1105→            path (list): The path within the template to analyze.\n  1106→\n  1107→        Returns:\n  1108→            dict: A dictionary where the keys are the condition names, and the values\n  1109→            are sets of boolean values (True or False) indicating the possible\n  1110→            outcomes for that condition.\n  1111→        \"\"\"\n  1112→\n  1113→        def get_conditions_from_property(value):\n  1114→            \"\"\"Recursively get conditions\"\"\"\n  1115→            results = set()\n  1116→            if isinstance(value, dict):\n  1117→                if len(value) == 1:\n  1118→                    for k, v in value.items():\n  1119→                        if k == \"Fn::If\":\n  1120→                            if isinstance(v, list) and len(v) == 3:\n  1121→                                if isinstance(v[0], str):\n  1122→                                    results.add(v[0])\n  1123→                                    results = results.union(\n  1124→                                        get_conditions_from_property(v[1])\n  1125→                                    )\n  1126→                                    results = results.union(\n  1127→                                        get_conditions_from_property(v[2])\n  1128→                                    )\n  1129→            elif isinstance(value, list):\n  1130→                for v in value:\n  1131→                    results = results.union(get_conditions_from_property(v))\n  1132→\n  1133→            return results\n  1134→\n  1135→        con = set()\n  1136→\n  1137→        if isinstance(objs, dict):\n  1138→            objs = [objs]\n  1139→\n  1140→        for obj in objs:\n  1141→            if isinstance(obj, dict):\n  1142→                for k, v in obj.items():\n  1143→                    # handle conditions directly under the object\n  1144→                    if len(obj) == 1 and k == \"Fn::If\" and len(v) == 3:\n  1145→                        con.add(v[0])\n  1146→                        for r_c in v[1:]:\n  1147→                            if isinstance(r_c, dict):\n  1148→                                for s_k, s_v in r_c.items():\n  1149→                                    if s_k == \"Fn::If\":\n  1150→                                        con = con.union(\n  1151→                                            get_conditions_from_property({s_k: s_v})\n  1152→                                        )\n  1153→                    else:\n  1154→                        con = con.union(get_conditions_from_property(v))\n  1155→\n  1156→        return list(self.conditions.build_scenarios(dict.fromkeys(list(con)), region))\n  1157→\n  1158→    def get_conditions_from_path(\n  1159→        self,\n  1160→        text: Any,\n  1161→        path: Path,\n  1162→        include_resource_conditions: bool = True,\n  1163→        include_if_in_function: bool = True,\n  1164→        only_last: bool = False,\n  1165→    ) -> dict[str, set[bool]]:\n  1166→        \"\"\"\n  1167→        Parent function to handle resources with conditions.\n  1168→\n  1169→        This function recursively processes the provided text and path to identify\n  1170→        the conditions that are relevant for the given path.\n  1171→\n  1172→        Args:\n  1173→            text (dict): The object to start processing through the path.\n  1174→            path (list): The path to recursively look for conditions.\n  1175→            include_resource_conditions (bool, optional): Whether to include conditions\n  1176→                from the resource itself. Defaults to True.\n  1177→            include_if_in_function (bool, optional): Whether to include conditions\n  1178→                from Fn::If functions. Defaults to True.\n  1179→            only_last (bool, optional): Whether to only return the conditions for the\n  1180→                last element in the path. Defaults to False.\n  1181→\n  1182→        Returns:\n  1183→            dict: A dictionary where the keys are the condition names, and the values\n  1184→            are sets of boolean values (True or False) indicating the possible\n  1185→            outcomes for that condition.\n  1186→        \"\"\"\n  1187→\n  1188→        results = self._get_conditions_from_path(\n  1189→            text, path, include_if_in_function, only_last\n  1190→        )\n  1191→        if include_resource_conditions:\n  1192→            if len(path) >= 2:\n  1193→                if path[0] in [\"Resources\", \"Outputs\"]:\n  1194→                    condition = text.get(path[0], {}).get(path[1], {}).get(\"Condition\")\n  1195→                    if isinstance(condition, str):\n  1196→                        if not results.get(condition):\n  1197→                            results[condition] = set()\n  1198→                        results[condition].add(True)\n  1199→\n  1200→        return results\n  1201→\n  1202→    def _get_conditions_from_path(\n  1203→        self,\n  1204→        text: Any,\n  1205→        path: Path,\n  1206→        include_if_in_function: bool = True,\n  1207→        only_last: bool = False,\n  1208→    ) -> dict[str, set[bool]]:\n  1209→        \"\"\"\n  1210→        Get the conditions and their True/False value for the path provided\n  1211→        Input:\n  1212→            text: The object to start processing through the Path\n  1213→            path: The path to recursively look for\n  1214→        Output:\n  1215→            An Object with keys being the Condition Names and the values are what\n  1216→                if its in the True or False part of the path.\n  1217→                {'condition': {True}}\n  1218→        \"\"\"\n  1219→        results: dict[str, set[bool]] = {}\n  1220→\n  1221→        def get_condition_name(value, num=None):\n  1222→            \"\"\"Test conditions for validity before providing the name\"\"\"\n  1223→            con_path = set()\n  1224→            if num == 1:\n  1225→                con_path.add(True)\n  1226→            elif num == 2:\n  1227→                con_path.add(False)\n  1228→            else:\n  1229→                con_path = con_path.union((True, False))\n  1230→\n  1231→            if value:\n  1232→                if isinstance(value, list):\n  1233→                    if len(value) == 3:\n  1234→                        if not results.get(value[0]):\n  1235→                            results[value[0]] = set()\n  1236→                        results[value[0]] = results[value[0]].union(con_path)\n  1237→\n  1238→        try:\n  1239→            # Found a condition at the root of the Path\n  1240→            if path[0] == \"Fn::If\" and (\n  1241→                (len(path) == 1 and only_last) or not only_last\n  1242→            ):\n  1243→                condition = text.get(\"Fn::If\")\n  1244→                if len(path) > 1:\n  1245→                    if path[1] in [1, 2]:\n  1246→                        get_condition_name(condition, path[1])\n  1247→                else:\n  1248→                    get_condition_name(condition)\n  1249→            # Iterate if the Path has more than one value\n  1250→            if len(path) > 1:\n  1251→                if (\n  1252→                    path[0] in cfnlint.helpers.FUNCTIONS and path[0] != \"Fn::If\"\n  1253→                ) and not include_if_in_function:\n  1254→                    return results\n  1255→                child_results = self._get_conditions_from_path(\n  1256→                    text[path[0]], path[1:], include_if_in_function, only_last\n  1257→                )\n  1258→                for c_r_k, c_r_v in child_results.items():\n  1259→                    if not results.get(c_r_k):\n  1260→                        results[c_r_k] = set()\n  1261→                    results[c_r_k] = results[c_r_k].union(c_r_v)\n  1262→\n  1263→        except KeyError:\n  1264→            pass\n  1265→\n  1266→        return results\n  1267→\n  1268→\n  1269→def camel_to_snake(s):\n  1270→    \"\"\"\n  1271→    Is it ironic that this function is written in camel case, yet it\n  1272→    converts to snake case? hmm..\n  1273→    \"\"\"\n  1274→    _underscorer1 = re.compile(r\"(.)([A-Z][a-z]+)\")\n  1275→    _underscorer2 = re.compile(\"([a-z0-9])([A-Z])\")\n  1276→    subbed = _underscorer1.sub(r\"\\1_\\2\", s)\n  1277→    return _underscorer2.sub(r\"\\1_\\2\", subbed).lower()\n  1278→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"6d83506c-fc60-44cf-913b-d77f71cb8bca","uuid":"7f134951-42d5-4945-b71a-0fc54b91447e","tool_use_result":{"type":"text","file":{"filePath":"/testbed/src/cfnlint/template/template.py","content":"\"\"\"\nCopyright 2019 Amazon.com, Inc. or its affiliates. All Rights Reserved.\nSPDX-License-Identifier: MIT-0\n\"\"\"\n\nfrom __future__ import annotations\n\nimport functools\nimport logging\nfrom copy import deepcopy\nfrom typing import TYPE_CHECKING, Any, Iterator\n\nimport regex as re\n\nimport cfnlint.conditions\nimport cfnlint.helpers\nfrom cfnlint._typing import CheckValueFn, Path\nfrom cfnlint.context import create_context_for_template\nfrom cfnlint.decode.node import dict_node, list_node\nfrom cfnlint.graph import Graph\nfrom cfnlint.match import Match\nfrom cfnlint.template.getatts import GetAtts\nfrom cfnlint.template.transforms import Transform\n\nif TYPE_CHECKING:\n    from cfnlint.rules import RuleMatch\n\nLOGGER = logging.getLogger(__name__)\n\n\nclass Template:  # pylint: disable=R0904,too-many-lines,too-many-instance-attributes\n    \"\"\"\n    Class representing a CloudFormation template.\n\n    This class provides methods to access and manipulate various parts of the template,\n    such as resources, parameters, conditions, and transformations. It also includes\n    utility methods for checking conditions, resolving references, and more.\n\n    Attributes:\n        regions (list[str]): A list of AWS regions associated with the template.\n        filename (str | None): The filename of the template file, if available.\n        template (dict[str, Any]): The dictionary representing the CloudFormation template.\n        sections (list[str]): A list of CloudFormation template sections.\n        transform_pre (dict[str, Any]): A dictionary containing pre-processed transformation data.\n        conditions (Conditions): An instance of the Conditions class used for managing conditions.\n        graph (Graph): An instance of the Graph class used for representing the template structure.\n    \"\"\"\n\n    def __init__(\n        self,\n        filename: str | None,\n        template: dict[str, Any],\n        regions: list[str] | None = None,\n    ):\n        \"\"\"Initialize a Template instance.\n\n        Args:\n            filename (str | None): The filename of the template file, if available.\n            template (dict[str, Any]): The dictionary representing the CloudFormation template.\n            regions (list[str] | None): A list of AWS regions associated with the template.\n        \"\"\"\n        if regions is None:\n            self.regions = [cfnlint.helpers.REGION_PRIMARY]\n        else:\n            self.regions = regions\n        self.filename = filename\n        self.template = template\n        self.transform_pre: dict[str, Any] = {}\n        self.transform_pre[\"Globals\"] = {}\n        self.transform_pre[\"Ref\"] = self.search_deep_keys(\"Ref\")\n        self.transform_pre[\"Fn::Sub\"] = self.search_deep_keys(\"Fn::Sub\")\n        self.transform_pre[\"Fn::FindInMap\"] = self.search_deep_keys(\"Fn::FindInMap\")\n        self.transform_pre[\"Transform\"] = self.template.get(\"Transform\", [])\n        self.transform_pre[\"Fn::ForEach\"] = self.search_deep_keys(\n            cfnlint.helpers.FUNCTION_FOR_EACH\n        )\n\n        self.conditions = cfnlint.conditions.Conditions(self)\n        self.graph = None\n        try:\n            self.graph = Graph(self)\n        except KeyError as err:\n            LOGGER.debug(\n                \"Encountered KeyError error while building graph. Ignored as this \"\n                \"should be caught by other rules and is more than likely a template \"\n                \"formatting error: %s\",\n                err,\n            )\n        except Exception as err:  # pylint: disable=broad-except\n            LOGGER.info(\"Encountered unknown error while building graph: %s\", err)\n\n        self.context = create_context_for_template(self)\n        self.search_deep_keys = functools.lru_cache()(self.search_deep_keys)  # type: ignore\n\n    def __deepcopy__(self, memo):\n        cls = self.__class__\n        result = cls.__new__(cls)\n        memo[id(self)] = result\n        for k, v in self.__dict__.items():\n            setattr(result, k, deepcopy(v, memo))\n        return result\n\n    def _cache_clear(self):\n        self.search_deep_keys.cache_clear()\n\n    def transform(self) -> list[Match]:\n        \"\"\"\n        Transform the template.\n\n        Returns:\n            list[Match]: A list of Match objects representing the transformed template.\n        \"\"\"\n        transform = Transform()\n        results = transform.transform(self)\n        self._cache_clear()\n        return results\n\n    def build_graph(self) -> None:\n        \"\"\"Generates a DOT representation of the template\"\"\"\n        filename = self.filename or \"cfn-lint\"\n        path = filename + \".dot\"\n        if not self.graph:\n            return\n        try:\n            self.graph.to_dot(path)\n            LOGGER.info(\"DOT representation of the graph written to %s\", path)\n        except ImportError:\n            LOGGER.error(\n                (\n                    \"Could not write the graph in DOT format. \"\n                    \"Please install either `pygraphviz` or `pydot` modules.\"\n                )\n            )\n\n    def has_language_extensions_transform(self) -> bool:\n        \"\"\"Check if the template has the AWS::LanguageExtensions transform declared.\n\n        Returns:\n            bool: True if the AWS::LanguageExtensions transform is declared, False otherwise.\n        \"\"\"\n        lang_extensions_transform = \"AWS::LanguageExtensions\"\n        transform_declaration = self.transform_pre[\"Transform\"]\n        transform_type = (\n            transform_declaration\n            if isinstance(transform_declaration, list)\n            else [transform_declaration]\n        )\n        return bool(lang_extensions_transform in transform_type)\n\n    def has_serverless_transform(self) -> bool:\n        \"\"\"Check if the template has the AWS::Serverless-2016-10-31 transform declared.\n\n        Returns:\n            bool: True if the AWS::Serverless-2016-10-31 transform is declared, False otherwise.\n        \"\"\"\n        lang_extensions_transform = \"AWS::Serverless-2016-10-31\"\n        transform_declaration = self.transform_pre[\"Transform\"]\n        transform_type = (\n            transform_declaration\n            if isinstance(transform_declaration, list)\n            else [transform_declaration]\n        )\n        return bool(lang_extensions_transform in transform_type)\n\n    def is_cdk_template(self) -> bool:\n        \"\"\"Check if the template was created by the AWS Cloud Development Kit (CDK).\n\n        Returns:\n            bool: True if the template was created by CDK, False otherwise.\n        \"\"\"\n        resources = self.template.get(\"Resources\")\n        if not isinstance(resources, dict):\n            return False\n\n        for _, properties in resources.items():\n            if not isinstance(properties, dict):\n                continue\n            resource_type = properties.get(\"Type\")\n            if not isinstance(resource_type, str):\n                continue\n            if resource_type == \"AWS::CDK::Metadata\":\n                return True\n\n        return False\n\n    def get_resources(\n        self, resource_type: list[str] | str = []\n    ) -> dict[str, dict[str, Any]]:\n        \"\"\"Get the resources in the template.\n\n        Args:\n            resource_type (list[str] | str): An optional list or string of resource types to filter by.\n\n        Returns:\n            dict[str, dict[str, Any]]: A dictionary containing the resources, where the keys are resource names\n                and the values are the resource dictionaries.\n        \"\"\"\n        resources = self.template.get(\"Resources\", {})\n        if not isinstance(resources, dict):\n            return {}\n        if isinstance(resource_type, str):\n            resource_type = [resource_type]\n\n        results = {}\n        for k, v in resources.items():\n            if isinstance(v, dict):\n                if (v.get(\"Type\", None) in resource_type) or (\n                    not resource_type and v.get(\"Type\") is not None\n                ):\n                    results[k] = v\n\n        return results\n\n    def get_resource_children(\n        self, resource_name: str, types: list[str] | None = None\n    ) -> Iterator[str]:\n        \"\"\"Get the resource children for a given resource name.\n\n        Args:\n            resource_name (str): The name of the resource.\n            types (list[str] | None): An optional list of resource types to filter by.\n\n        Yields:\n            str: The name of each resource child.\n        \"\"\"\n        types = types or []\n\n        if self.graph:\n            for node_name in self.graph.graph.predecessors(resource_name):\n                node = self.graph.graph.nodes[node_name]\n                if node[\"type\"] != \"Resource\":\n                    continue\n\n                if types:\n                    if node[\"resource_type\"] in types:\n                        yield node_name\n                else:\n                    yield node_name\n\n    def get_parameters_valid(self) -> dict[str, dict[str, Any]]:\n        \"\"\"Get the valid parameters in the template.\n\n        Returns:\n            dict[str, dict[str, Any]]: A dictionary containing the valid parameters, where the keys are parameter names\n                and the values are the parameter dictionaries.\n        \"\"\"\n        result = {}\n        if isinstance(self.template.get(\"Parameters\"), dict):\n            parameters = self.template.get(\"Parameters\", {})\n            for parameter_name, parameter_value in parameters.items():\n                if isinstance(parameter_value, dict):\n                    if isinstance(parameter_value.get(\"Type\"), str):\n                        result[parameter_name] = parameter_value\n\n        return result\n\n    def get_modules(self) -> dict[str, dict[str, Any]]:\n        \"\"\"Get the modules in the template.\n\n        Returns:\n            dict[str, dict[str, Any]]: A dictionary containing the modules, where the keys are module names\n                and the values are the module dictionaries.\n        \"\"\"\n        resources = self.template.get(\"Resources\", {})\n        if not resources:\n            return {}\n\n        results = {}\n        for k, v in resources.items():\n            if isinstance(v, dict):\n                if v.get(\"Type\") is not None and str(v.get(\"Type\")).endswith(\n                    \"::MODULE\"\n                ):\n                    results[k] = v\n\n        return results\n\n    def get_valid_refs(self) -> cfnlint.helpers.RegexDict:\n        \"\"\"Get a dictionary of valid references in the template.\n\n        Returns:\n            cfnlint.helpers.RegexDict: A dictionary containing valid references, where the keys are reference names\n                and the values are dictionaries with information about the reference type and source.\n        \"\"\"\n        results = cfnlint.helpers.RegexDict()\n        parameters = self.template.get(\"Parameters\", {})\n        if parameters:\n            for name, value in parameters.items():\n                if isinstance(value, dict):\n                    if \"Type\" in value:\n                        element = {}\n                        element[\"Type\"] = value[\"Type\"]\n                        element[\"From\"] = \"Parameters\"\n                        results[name] = element\n        resources = self.template.get(\"Resources\", {})\n        if resources:\n            for name, value in resources.items():\n                resource_type = value.get(\"Type\", \"\")\n                if not isinstance(resource_type, str):\n                    continue\n                if resource_type.endswith(\"::MODULE\"):\n                    element = {}\n                    element[\"Type\"] = \"MODULE\"\n                    element[\"From\"] = \"Resources\"\n                    results[f\"{name}.*\"] = element\n                elif resource_type:\n                    element = {}\n                    element[\"Type\"] = resource_type\n                    element[\"From\"] = \"Resources\"\n                    results[name] = element\n\n        for pseudoparam in cfnlint.helpers.PSEUDOPARAMS:\n            element = {}\n            element[\"Type\"] = \"Pseudo\"\n            element[\"From\"] = \"Pseudo\"\n            results[pseudoparam] = element\n        return results\n\n    def get_valid_getatts(self) -> GetAtts:\n        \"\"\"Get an instance of GetAtts containing valid GetAtt references in the template.\n\n        Returns:\n            GetAtts: An instance of GetAtts containing valid GetAtt references.\n        \"\"\"\n        results = GetAtts(self.regions)\n\n        for name, value in self.context.resources.items():\n            results.add(name, value.type)\n\n        return results\n\n    def get_directives(self) -> dict[str, list[str]]:\n        \"\"\"Get the directives (ignore_checks) in the template.\n\n        Returns:\n            dict[str, list[str]]: A dictionary containing directives, where the keys are directive names\n                and the values are lists of resource names associated with the directive.\n        \"\"\"\n        results: dict[str, list[str]] = {}\n        resources = self.get_resources()\n        if resources:\n            for resource_name, resource_values in resources.items():\n                if isinstance(resource_values, dict):\n                    ignore_rule_ids = (\n                        resource_values.get(\"Metadata\", {})\n                        .get(\"cfn-lint\", {})\n                        .get(\"config\", {})\n                        .get(\"ignore_checks\", [])\n                    )\n                    for ignore_rule_id in ignore_rule_ids:\n                        if ignore_rule_id not in results:\n                            results[ignore_rule_id] = []\n                        results[ignore_rule_id].append(resource_name)\n        return results\n\n    # pylint: disable=dangerous-default-value\n    def _search_deep_keys(self, searchText: str | re.Pattern, cfndict, path: Path):\n        \"\"\"Search deep for keys and get their values.\n\n        Args:\n            searchText (str | re.Pattern): The text or regular expression pattern to search for.\n            cfndict (Any): The dictionary or list to search in.\n            path (list[Any]): The current path in the dictionary or list.\n\n        Returns:\n            list[list[Any]]: A list of paths where the searchText was found.\n        \"\"\"\n        keys = []\n        if isinstance(cfndict, dict):\n            for key in cfndict:\n                pathprop: Path = path[:]\n                pathprop.append(key)\n                if isinstance(searchText, str):\n                    if key == searchText:\n                        pathprop.append(cfndict[key])\n                        keys.append(pathprop)\n                        # pop the last element off for nesting of found elements for\n                        # dict and list checks\n                        pathprop = pathprop[:-1]\n                elif isinstance(searchText, re.Pattern):\n                    if isinstance(key, str):\n                        if re.match(searchText, key):\n                            pathprop.append(cfndict[key])\n                            keys.append(pathprop)\n                            # pop the last element off for nesting of found elements for\n                            # dict and list checks\n                            pathprop = pathprop[:-1]\n                if isinstance(cfndict[key], dict):\n                    keys.extend(\n                        self._search_deep_keys(searchText, cfndict[key], pathprop)\n                    )\n                elif isinstance(cfndict[key], list):\n                    for index, item in enumerate(cfndict[key]):\n                        pathproparr = pathprop[:]\n                        pathproparr.append(index)\n                        keys.extend(\n                            self._search_deep_keys(searchText, item, pathproparr)\n                        )\n        elif isinstance(cfndict, list):\n            for index, item in enumerate(cfndict):\n                pathprop = path[:]\n                pathprop.append(index)\n                keys.extend(self._search_deep_keys(searchText, item, pathprop))\n\n        return keys\n\n    def search_deep_keys(\n        self, searchText: str | re.Pattern, includeGlobals: bool = True\n    ):\n        \"\"\"Search for a key in all parts of the template.\n\n        Args:\n            searchText (str | re.Pattern): The text or regular expression pattern to search for.\n            includeGlobals (bool): Whether to include globals in the search.\n\n        Returns:\n            liist[[Any]]: A list of paths where the searchText was found.\n\n        Example:\n            If searchText is \"Ref\", the return value could be something like\n            ['Resources', 'myInstance', 'Properties', 'ImageId', 'Ref', 'Ec2ImageId']\n        \"\"\"\n        results = []\n        results.extend(self._search_deep_keys(searchText, self.template, []))\n        # Globals are removed during a transform.  They need to be checked manually\n        if includeGlobals:\n            pre_results = self._search_deep_keys(\n                searchText, self.transform_pre.get(\"Globals\"), []\n            )\n            for pre_result in pre_results:\n                results.append([\"Globals\"] + pre_result)\n        return results\n\n    def get_condition_values(self, template, path: Path | None) -> list[dict[str, Any]]:\n        \"\"\"\n        Evaluates conditions in the provided CloudFormation template and returns the values.\n\n        Args:\n            template (list): The CloudFormation template to evaluate.\n            path (list, optional): The current path in the template. Defaults to an empty list.\n\n        Returns:\n            list: A list of dictionaries, where each dictionary contains the following keys:\n                - \"Path\": The path to the condition value in the template.\n                - \"Value\": The value of the condition.\n        \"\"\"\n        path = path or []\n        matches: list[dict[str, Any]] = []\n        if not isinstance(template, list):\n            return matches\n        if not len(template) == 3:\n            return matches\n\n        for index, item in enumerate(template[1:]):\n            result: dict[str, Any] = {}\n            result[\"Path\"] = path[:] + [index + 1]\n            if not isinstance(item, (dict, list)):\n                # Just straight values and pass them through\n                result[\"Value\"] = item\n                matches.append(result)\n            elif len(item) == 1:\n                # Checking for conditions inside of conditions\n                if isinstance(item, dict):\n                    for sub_key, sub_value in item.items():\n                        if sub_key in cfnlint.helpers.CONDITION_FUNCTIONS:\n                            results = self.get_condition_values(\n                                sub_value, result[\"Path\"] + [sub_key]\n                            )\n                            if isinstance(results, list):\n                                matches.extend(results)\n                        elif sub_key == \"Ref\":\n                            if sub_value != \"AWS::NoValue\":\n                                result[\"Value\"] = item\n                                matches.append(result)\n                        else:\n                            # Return entire Item\n                            result[\"Value\"] = item\n                            matches.append(result)\n                else:\n                    # Return entire Item\n                    result[\"Value\"] = item\n                    matches.append(result)\n            else:\n                # Length longer than 1 means a list or object that\n                # should be fully returned\n                result[\"Value\"] = item\n                matches.append(result)\n\n        return matches\n\n    def get_values(self, obj, key, path: Path | None = None):\n        \"\"\"\n        Logic for getting the value of a key in the provided object.\n\n        Args:\n            obj (dict): The object to search for the key.\n            key (str): The key to search for in the object.\n            path (list, optional): The current path in the object. Defaults to an empty list.\n\n        Returns:\n            list: A list of dictionaries, where each dictionary contains the following keys:\n            - \"Path\": The path to the value in the object.\n            - \"Value\": The value found for the key.\n\n            Types of return values\n            - Returns None if the item isn't found\n            - Returns empty list if the item is found but Ref or GetAtt\n            - Returns all the values as a list if condition\n            - Returns the value if its just a string, int, boolean, etc.\n        \"\"\"\n        path = path or []\n        matches = []\n\n        if not isinstance(obj, dict):\n            return None\n        value = obj.get(key)\n        if value is None:\n            return None\n        if isinstance(value, (dict)):\n            if len(value) == 1:\n                is_condition = False\n                is_no_value = False\n                for obj_key, obj_value in value.items():\n                    if obj_key in cfnlint.helpers.CONDITION_FUNCTIONS:\n                        is_condition = True\n                        results = self.get_condition_values(\n                            obj_value, path[:] + [obj_key]\n                        )\n                        if isinstance(results, list):\n                            for result in results:\n                                check_obj = obj.copy()\n                                check_obj[key] = result[\"Value\"]\n                                matches.extend(\n                                    self.get_values(check_obj, key, result[\"Path\"])\n                                )\n                    elif obj_key == \"Ref\" and obj_value == \"AWS::NoValue\":\n                        is_no_value = True\n                if not is_condition and not is_no_value:\n                    result = {}\n                    result[\"Path\"] = path[:]\n                    result[\"Value\"] = value\n                    matches.append(result)\n            else:\n                result = {}\n                result[\"Path\"] = path[:]\n                result[\"Value\"] = value\n                matches.append(result)\n        elif isinstance(value, (list)):\n            for list_index, list_value in enumerate(value):\n                if isinstance(list_value, dict):\n                    if len(list_value) == 1:\n                        is_condition = False\n                        is_no_value = False\n                        for obj_key, obj_value in list_value.items():\n                            if obj_key in cfnlint.helpers.CONDITION_FUNCTIONS:\n                                is_condition = True\n                                results = self.get_condition_values(\n                                    obj_value, path[:] + [list_index, obj_key]\n                                )\n                                if isinstance(results, list):\n                                    matches.extend(results)\n                            elif obj_key == \"Ref\" and obj_value == \"AWS::NoValue\":\n                                is_no_value = True\n                        if not is_condition and not is_no_value:\n                            result = {}\n                            result[\"Path\"] = path[:] + [list_index]\n                            result[\"Value\"] = list_value\n                            matches.append(result)\n                    else:\n                        result = {}\n                        result[\"Path\"] = path[:] + [list_index]\n                        result[\"Value\"] = list_value\n                        matches.append(result)\n                else:\n                    result = {}\n                    result[\"Path\"] = path[:] + [list_index]\n                    result[\"Value\"] = list_value\n                    matches.append(result)\n        else:\n            result = {}\n            result[\"Path\"] = path[:]\n            result[\"Value\"] = value\n            matches.append(result)\n\n        return matches\n\n    def _loc(self, obj: Any) -> tuple[int, int, int, int]:\n        \"\"\"Return location of object\"\"\"\n        return (\n            obj.start_mark.line,\n            obj.start_mark.column,\n            obj.end_mark.line,\n            obj.end_mark.column,\n        )\n\n    def get_sub_parameters(self, sub_string):\n        \"\"\"\n        Gets the parameters out of a Sub String.\n\n        Args:\n            sub_string (str): The Sub string to extract parameters from.\n\n        Returns:\n            list: A list of the parameter names found in the Sub string.\n        \"\"\"\n        results = []\n        if not isinstance(sub_string, str):\n            return results\n        regex = re.compile(r\"\\${[^!].*?}\")\n        string_params = regex.findall(sub_string)\n\n        for string_param in string_params:\n            results.append(string_param[2:-1].strip())\n\n        return results\n\n    def get_location_yaml(self, text: Any, path: Path):\n        \"\"\"\n        Get the location information for the given YAML text and path.\n\n        Args:\n            text (str): The YAML text to search.\n            path (list): The path to the location within the YAML text.\n\n        Returns:\n            dict or None: A dictionary containing the location information, or None if the location could not be found.\n            The dictionary has the following keys:\n                - \"start_mark\": A dictionary with \"line\" and \"column\" keys indicating the start of the location.\n                - \"end_mark\": A dictionary with \"line\" and \"column\" keys indicating the end of the location.\n        \"\"\"\n        result = None\n        if not path:\n            result = self._loc(text)\n        elif len(path) > 1:\n            try:\n                result = self.get_location_yaml(text[path[0]], path[1:])\n            except KeyError:\n                pass\n            # TypeError will help catch string indices must be integers for when\n            # we parse JSON string and get a path inside that json string\n            except TypeError:\n                pass\n            if not result:\n                try:\n                    for key in text:\n                        if key == path[0]:\n                            result = self._loc(key)\n                except AttributeError as err:\n                    LOGGER.debug(err)\n        else:\n            # If the last item of the path is an integer, and the vaue is an array,\n            # Get the location of the item in the array\n            if isinstance(text, list) and isinstance(path[0], int):\n                try:\n                    result = self._loc(text[path[0]])\n                except AttributeError as err:\n                    LOGGER.debug(err)\n            else:\n                try:\n                    for key in text:\n                        if key == path[0]:\n                            result = self._loc(key)\n                except AttributeError as err:\n                    LOGGER.debug(err)\n\n        return result\n\n    # pylint: disable=W0613,too-many-locals\n    def check_value(\n        self,\n        obj: dict[str, Any],\n        key: str,\n        path: Path,\n        check_value: CheckValueFn | None = None,\n        check_ref: CheckValueFn | None = None,\n        check_get_att: CheckValueFn | None = None,\n        check_find_in_map: CheckValueFn | None = None,\n        check_split: CheckValueFn | None = None,\n        check_join: CheckValueFn | None = None,\n        check_import_value: CheckValueFn | None = None,\n        check_sub: CheckValueFn | None = None,\n        pass_if_null: bool = False,\n        **kwargs: dict[str, Any],\n    ) -> list[RuleMatch]:\n        \"\"\"\n        Check the value of a key in the provided object.\n\n        Args:\n            obj (dict): The object to check the value of.\n            key (str): The key to check the value of.\n            path (list): The path to the current location in the object.\n            check_value (callable, optional): A function to check the value of the key.\n            check_ref (callable, optional): A function to check the \"Ref\" function.\n            check_get_att (callable, optional): A function to check the \"Fn::GetAtt\" function.\n            check_find_in_map (callable, optional): A function to check the \"Fn::FindInMap\" function.\n            check_split (callable, optional): A function to check the \"Fn::Split\" function.\n            check_join (callable, optional): A function to check the \"Fn::Join\" function.\n            check_import_value (callable, optional): A function to check the \"Fn::ImportValue\" function.\n            check_sub (callable, optional): A function to check the \"Fn::Sub\" function.\n            pass_if_null (bool, optional): Whether to pass if the value is null. Defaults to False.\n            **kwargs (dict): Additional keyword arguments to pass to the check functions.\n\n        Returns:\n            list[RuleMatch]: A list of matches found during the check.\n        \"\"\"\n        matches = []\n        values_obj = self.get_values(obj=obj, key=key)\n        new_path = path[:] + [key]\n        if values_obj is None and pass_if_null:\n            if check_value:\n                matches.extend(\n                    check_value(value=values_obj, path=new_path[:], **kwargs)\n                )\n        elif not values_obj:\n            return matches\n        else:\n            for value_obj in values_obj:\n                value = value_obj[\"Value\"]\n                child_path = value_obj[\"Path\"]\n                if not isinstance(value, dict):\n                    if check_value:\n                        matches.extend(\n                            check_value(\n                                value=value, path=new_path[:] + child_path, **kwargs\n                            )\n                        )\n                else:\n                    if len(value) == 1:\n                        for dict_name, _ in value.items():\n                            # If this is a function we shouldn't fall\n                            # back to a check_value check\n                            if dict_name in cfnlint.helpers.FUNCTIONS:\n                                # convert the function name from camel case\n                                # to underscore\n                                # Example: Fn::FindInMap becomes\n                                # check_find_in_map\n                                # ruff: noqa: E501\n                                function_name = f'check_{camel_to_snake(dict_name.replace(\"Fn::\", \"\"))}'\n                                if function_name == \"check_ref\":\n                                    if check_ref:\n                                        matches.extend(\n                                            check_ref(\n                                                value=value.get(\"Ref\"),\n                                                path=new_path[:] + child_path + [\"Ref\"],\n                                                parameters=self.template.get(\n                                                    \"Parameters\", {}\n                                                ),\n                                                resources=self.get_resources(),\n                                                **kwargs,\n                                            )\n                                        )\n                                else:\n                                    if locals().get(function_name):\n                                        matches.extend(\n                                            locals()[function_name](\n                                                value=value.get(dict_name),\n                                                path=new_path[:]\n                                                + child_path\n                                                + [dict_name],\n                                                **kwargs,\n                                            )\n                                        )\n                            else:\n                                if check_value:\n                                    matches.extend(\n                                        check_value(\n                                            value=value,\n                                            path=new_path[:] + child_path,\n                                            **kwargs,\n                                        )\n                                    )\n                    else:\n                        if check_value:\n                            matches.extend(\n                                check_value(\n                                    value=value, path=new_path[:] + child_path, **kwargs\n                                )\n                            )\n\n        return matches\n\n    def is_resource_available(self, path: Path, resource: str) -> list[dict[str, bool]]:\n        \"\"\"\n        Compares a path to a resource to see if it is available.\n\n        This function returns scenarios that may result in the resource not existing.\n\n        Args:\n            path (list): An array that is a path to the object being checked.\n            resource (str): The resource being compared.\n\n        Returns:\n            list: If the resource is available, the result is an empty list [].\n                If the resource is not available, the function returns a list of dictionaries,\n                where each dictionary represents a scenario where the resource is not available.\n                The dictionary keys are the condition names, and the values indicate whether\n                the condition is True or False.\n        \"\"\"\n        results: list[dict[str, bool]] = []\n        path_conditions = self.get_conditions_from_path(self.template, path)\n        resource_condition = (\n            self.template.get(\"Resources\", {}).get(resource, {}).get(\"Condition\")\n        )\n        if isinstance(resource_condition, str):\n            # if path conditions are empty that means its always true\n            if not path_conditions:\n                return [{resource_condition: False}]\n\n            # resource conditions are always true.  If the same resource condition\n            # exists in the path with the True then nothing else matters\n            if True in path_conditions.get(resource_condition, {False}):\n                return []\n\n            # resource conditions are always true.  If the same resource condition\n            # exists in the path with the False then nothing else matters\n            if False in path_conditions.get(resource_condition, {True}):\n                return [{resource_condition: False}]\n\n            # if any condition paths loop back on themselves with the opposite\n            # then its unreachable code\n            scenario = {}\n            for condition_name, condition_bool in path_conditions.items():\n                if len(condition_bool) > 1:\n                    return results\n                scenario[condition_name] = list(condition_bool)[0]\n\n            if self.conditions.check_implies(scenario, resource_condition):\n                return [{**{resource_condition: False}, **scenario}]\n\n        # if resource condition isn't available then the resource is available\n        return results\n\n    def get_object_without_nested_conditions(\n        self, obj: dict | list, path: Path, region: str | None = None\n    ):\n        \"\"\"\n        Get a list of object values without conditions included.\n\n        Evaluates deep into the object removing any nested conditions as well.\n\n        Args:\n            obj (dict): The object to process.\n            path (list): The current path in the object.\n            region (str, optional): The AWS region to use for evaluating conditions. Defaults to None.\n\n        Returns:\n            list: A list of dictionaries, where each dictionary contains the following keys:\n                - \"Scenario\": The scenario for the object, or None if there are no conditions.\n                - \"Object\": The object with conditions removed.\n        \"\"\"\n        results = []\n        scenarios = self.get_condition_scenarios_below_path(path, False, region)\n        if not isinstance(obj, (dict, list)):\n            return results\n\n        def get_value(value, scenario):  # pylint: disable=R0911\n            \"\"\"Get the value based on the scenario resolving nesting\"\"\"\n            if isinstance(value, dict):\n                if len(value) == 1:\n                    if \"Fn::If\" in value:\n                        if_values = value.get(\"Fn::If\")\n                        if len(if_values) == 3:\n                            if_path = scenario.get(if_values[0], None)\n                            if if_path is not None:\n                                if if_path:\n                                    return get_value(if_values[1], scenario)\n                                return get_value(if_values[2], scenario)\n                    elif value.get(\"Ref\") == \"AWS::NoValue\":\n                        return None\n\n                new_object = {}\n                for k, v in value.items():\n                    new_v = get_value(v, scenario)\n                    if new_v is not None:\n                        new_object[k] = get_value(v, scenario)\n                return new_object\n            if isinstance(value, list):\n                new_list = []\n                for item in value:\n                    new_value = get_value(item, scenario)\n                    if new_value is not None:\n                        new_list.append(get_value(item, scenario))\n\n                return new_list\n\n            return value\n\n        if not scenarios:\n            if isinstance(obj, dict):\n                if len(obj) == 1:\n                    if obj.get(\"Ref\") == \"AWS::NoValue\":\n                        return [{\"Scenario\": None, \"Object\": {}}]\n            return [{\"Scenario\": None, \"Object\": get_value(obj, {})}]\n\n        for scenario in scenarios:\n            results.append({\"Scenario\": scenario, \"Object\": get_value(obj, scenario)})\n\n        return results\n\n    def get_value_from_scenario(self, obj, scenario):\n        \"\"\"\n        Get object values from a provided scenario.\n\n        This function recursively processes the provided object, resolving any\n        conditional logic (such as Fn::If) based on the given scenario.\n\n        Args:\n            obj (dict): The object to process.\n            scenario (dict): The scenario to use when resolving conditional logic.\n\n        Returns:\n            dict or list or any: The processed object, with conditional logic resolved.\n            The return type can be a dictionary, list, or any other data type,\n            depending on the structure of the input object.\n        \"\"\"\n\n        def get_value(value, scenario):  # pylint: disable=R0911\n            \"\"\"Get the value based on the scenario resolving nesting\"\"\"\n            if isinstance(value, dict):\n                if len(value) == 1:\n                    if \"Fn::If\" in value:\n                        if_values = value.get(\"Fn::If\")\n                        if len(if_values) == 3:\n                            if_path = scenario.get(if_values[0], None)\n                            if if_path is not None:\n                                if if_path:\n                                    return get_value(if_values[1], scenario)\n                                return get_value(if_values[2], scenario)\n                    elif value.get(\"Ref\") == \"AWS::NoValue\":\n                        return None\n                    else:\n                        return value\n\n                return value\n            if isinstance(value, list):\n                new_list = []\n                for item in value:\n                    new_value = get_value(item, scenario)\n                    if new_value is not None:\n                        new_list.append(get_value(item, scenario))\n\n                return new_list\n\n            return value\n\n        if isinstance(obj, dict):\n            result = dict_node({}, obj.start_mark, obj.end_mark)\n            if len(obj) == 1:\n                if obj.get(\"Fn::If\"):\n                    new_value = get_value(obj, scenario)\n                    if new_value is not None:\n                        result = new_value\n                else:\n                    for key, value in obj.items():\n                        new_value = get_value(value, scenario)\n                        if new_value is not None:\n                            result[key] = new_value\n            else:\n                for key, value in obj.items():\n                    new_value = get_value(value, scenario)\n                    if new_value is not None:\n                        result[key] = new_value\n            return result\n        if isinstance(obj, list):\n            result = list_node({}, obj.start_mark, obj.end_mark)\n            for item in obj:\n                element = get_value(item, scenario)\n                if element is not None:\n                    result.append(element)\n\n            return result\n\n        return obj\n\n    def get_object_without_conditions(self, obj, property_names=None, region=None):\n        \"\"\"\n        Gets a list of object values without conditions included\n        Input:\n            obj: The object/dict that makes up a set of properties\n            Example:\n                {\n                    \"DBSnapshotIdentifier\" : {\n                        \"Fn::If\" : [\n                            \"UseDBSnapshot\",\n                            {\"Ref\" : \"DBSnapshotName\"},\n                            {\"Ref\" : \"AWS::NoValue\"}\n                        ]\n                    }\n                }\n        Output:\n            A list of objects with scenarios for the conditions played out.\n            If Ref to AWS::NoValue remove the property\n            Example: [\n                {\n                    Object: {\n                        \"DBSnapshotIdentifier\" : {\"Ref\" : \"DBSnapshotName\"}\n                    },\n                    Scenario: {UseDBSnapshot: True}\n                }, {\n                    Object: {\n                    },\n                    Scenario: {UseDBSnapshot: False}\n                }\n            ]\n        \"\"\"\n        if not isinstance(obj, (dict, list)):\n            return [{\"Scenario\": None, \"Object\": obj}]\n        property_names = [] if property_names is None else property_names\n        if getattr(obj, \"start_mark\", None):\n            start_mark = obj.start_mark\n            end_mark = obj.end_mark\n        else:\n            start_mark = (0, 0)\n            end_mark = (0, 0)\n        if isinstance(obj, list):\n            o = list_node(deepcopy(obj), start_mark=start_mark, end_mark=end_mark)\n        else:\n            if property_names:\n                o = dict_node({}, start_mark=start_mark, end_mark=end_mark)\n                for property_name in property_names:\n                    o[property_name] = deepcopy(obj.get(property_name))\n            else:\n                o = dict_node(deepcopy(obj), start_mark=start_mark, end_mark=end_mark)\n\n        results = []\n\n        scenarios = self.get_conditions_scenarios_from_object(o, region)\n\n        if isinstance(obj, list):\n            if not scenarios:\n                return [\n                    {\"Scenario\": None, \"Object\": self.get_value_from_scenario(o, {})}\n                ]\n            for scenario in scenarios:\n                result_list = []\n                for o in obj:\n                    result_obj = self.get_value_from_scenario(o, scenario)\n                    if result_obj:\n                        result_list.append(result_obj)\n                results.append({\"Scenario\": scenario, \"Object\": result_list})\n        if isinstance(obj, dict):\n            if not scenarios:\n                if len(obj) == 1:\n                    if obj.get(\"Ref\") == \"AWS::NoValue\":\n                        return []\n                return [\n                    {\"Scenario\": None, \"Object\": self.get_value_from_scenario(o, {})}\n                ]\n\n            for scenario in scenarios:\n                result_obj = self.get_value_from_scenario(o, scenario)\n                if result_obj:\n                    results.append({\"Scenario\": scenario, \"Object\": result_obj})\n\n        return results\n\n    def get_condition_scenarios_below_path(\n        self,\n        path: Path,\n        include_if_in_function: bool = False,\n        region: str | None = None,\n    ) -> list[dict[str, bool]]:\n        \"\"\"\n        Get all possible scenarios for the conditions in the provided object.\n\n        This function recursively processes the object, identifying any conditional\n        logic (such as Fn::If) and generating all possible scenarios based on the\n        conditions.\n\n        Args:\n            obj (dict): The object to process.\n            region (str, optional): The AWS region to use for evaluating conditions. Defaults to None.\n\n        Returns:\n            list: A list of dictionaries, where each dictionary represents a possible\n            scenario. The keys in the dictionary are the condition names, and the\n            values are boolean values indicating whether the condition is True or False.\n        \"\"\"\n        fn_ifs = self.search_deep_keys(\"Fn::If\")\n        results: dict[str, set] = {}\n        for fn_if in fn_ifs:\n            if len(fn_if) >= len(path):\n                if path == fn_if[0 : len(path)]:\n                    # This needs to handle items only below the Path\n                    result = self.get_conditions_from_path(\n                        self.template, fn_if[0:-1], True, include_if_in_function\n                    )\n                    for condition_name, condition_values in result.items():\n                        if condition_name in results:\n                            results[condition_name].union(condition_values)\n                        else:\n                            results[condition_name] = condition_values\n\n        return list(self.conditions.build_scenarios(results, region))\n\n    def get_conditions_scenarios_from_object(self, objs, region=None):\n        \"\"\"\n        Get the conditions that are applicable for the given path in the template.\n\n        This function recursively traverses the template, following the provided path,\n        and collects all the conditions that are relevant for the given path.\n\n        Args:\n            template (dict): The CloudFormation template to analyze.\n            path (list): The path within the template to analyze.\n\n        Returns:\n            dict: A dictionary where the keys are the condition names, and the values\n            are sets of boolean values (True or False) indicating the possible\n            outcomes for that condition.\n        \"\"\"\n\n        def get_conditions_from_property(value):\n            \"\"\"Recursively get conditions\"\"\"\n            results = set()\n            if isinstance(value, dict):\n                if len(value) == 1:\n                    for k, v in value.items():\n                        if k == \"Fn::If\":\n                            if isinstance(v, list) and len(v) == 3:\n                                if isinstance(v[0], str):\n                                    results.add(v[0])\n                                    results = results.union(\n                                        get_conditions_from_property(v[1])\n                                    )\n                                    results = results.union(\n                                        get_conditions_from_property(v[2])\n                                    )\n            elif isinstance(value, list):\n                for v in value:\n                    results = results.union(get_conditions_from_property(v))\n\n            return results\n\n        con = set()\n\n        if isinstance(objs, dict):\n            objs = [objs]\n\n        for obj in objs:\n            if isinstance(obj, dict):\n                for k, v in obj.items():\n                    # handle conditions directly under the object\n                    if len(obj) == 1 and k == \"Fn::If\" and len(v) == 3:\n                        con.add(v[0])\n                        for r_c in v[1:]:\n                            if isinstance(r_c, dict):\n                                for s_k, s_v in r_c.items():\n                                    if s_k == \"Fn::If\":\n                                        con = con.union(\n                                            get_conditions_from_property({s_k: s_v})\n                                        )\n                    else:\n                        con = con.union(get_conditions_from_property(v))\n\n        return list(self.conditions.build_scenarios(dict.fromkeys(list(con)), region))\n\n    def get_conditions_from_path(\n        self,\n        text: Any,\n        path: Path,\n        include_resource_conditions: bool = True,\n        include_if_in_function: bool = True,\n        only_last: bool = False,\n    ) -> dict[str, set[bool]]:\n        \"\"\"\n        Parent function to handle resources with conditions.\n\n        This function recursively processes the provided text and path to identify\n        the conditions that are relevant for the given path.\n\n        Args:\n            text (dict): The object to start processing through the path.\n            path (list): The path to recursively look for conditions.\n            include_resource_conditions (bool, optional): Whether to include conditions\n                from the resource itself. Defaults to True.\n            include_if_in_function (bool, optional): Whether to include conditions\n                from Fn::If functions. Defaults to True.\n            only_last (bool, optional): Whether to only return the conditions for the\n                last element in the path. Defaults to False.\n\n        Returns:\n            dict: A dictionary where the keys are the condition names, and the values\n            are sets of boolean values (True or False) indicating the possible\n            outcomes for that condition.\n        \"\"\"\n\n        results = self._get_conditions_from_path(\n            text, path, include_if_in_function, only_last\n        )\n        if include_resource_conditions:\n            if len(path) >= 2:\n                if path[0] in [\"Resources\", \"Outputs\"]:\n                    condition = text.get(path[0], {}).get(path[1], {}).get(\"Condition\")\n                    if isinstance(condition, str):\n                        if not results.get(condition):\n                            results[condition] = set()\n                        results[condition].add(True)\n\n        return results\n\n    def _get_conditions_from_path(\n        self,\n        text: Any,\n        path: Path,\n        include_if_in_function: bool = True,\n        only_last: bool = False,\n    ) -> dict[str, set[bool]]:\n        \"\"\"\n        Get the conditions and their True/False value for the path provided\n        Input:\n            text: The object to start processing through the Path\n            path: The path to recursively look for\n        Output:\n            An Object with keys being the Condition Names and the values are what\n                if its in the True or False part of the path.\n                {'condition': {True}}\n        \"\"\"\n        results: dict[str, set[bool]] = {}\n\n        def get_condition_name(value, num=None):\n            \"\"\"Test conditions for validity before providing the name\"\"\"\n            con_path = set()\n            if num == 1:\n                con_path.add(True)\n            elif num == 2:\n                con_path.add(False)\n            else:\n                con_path = con_path.union((Tr