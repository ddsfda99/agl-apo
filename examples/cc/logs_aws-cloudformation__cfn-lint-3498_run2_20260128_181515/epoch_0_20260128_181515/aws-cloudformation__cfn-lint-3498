   try:\n   241\u2192                            for err in validator(self, v, _instance, _schema) or ():\n   242\u2192                                msg = custom_msg(k, _schema) or err.message\n   243\u2192                                if msg is not None:\n   244\u2192                                    err.message = msg\n   245\u2192                                # set details if not already set by the called fn\n   246\u2192                                err._set(\n   247\u2192                                    validator=k,\n   248\u2192                                    validator_value=v,\n   249\u2192                                    instance=_instance,\n   250\u2192                                    schema=_schema,\n   251\u2192                                    type_checker=self._type_checker,\n   252\u2192                                )\n   253\u2192                                if k not in {\"if\", \"$ref\"}:\n   254\u2192                                    err.schema_path.appendleft(k)\n   255\u2192                                yield err\n   256\u2192                        except Exception as err:\n   257\u2192                            LOGGER.debug(err, exc_info=True)\n   258\u2192                            yield ValidationError(\n   259\u2192                                f\"Exception {str(err)!r} raised while validating {k!r}\",\n   260\u2192                                validator=k,\n   261\u2192                                validator_value=v,\n   262\u2192                                instance=instance,\n   263\u2192                                schema=self.schema,\n   264\u2192                                schema_path=deque([k]),\n   265\u2192                            )\n   266\u2192            finally:\n   267\u2192                if scope:\n   268\u2192                    self.resolver.pop_scope()\n   269\u2192\n   270\u2192        def validate(self, instance: Any) -> None:\n   271\u2192            \"\"\"\n   272\u2192            Check if the instance is valid under the current `schema`.\n   273\u2192\n   274\u2192            Raises:\n   275\u2192\n   276\u2192                `cfnlint.jsonschema.exceptions.ValidationError`:\n   277\u2192\n   278\u2192                    if the instance is invalid\n   279\u2192\n   280\u2192            >>> schema = {\"maxItems\" : 2}\n   281\u2192            >>> StandardValidator(schema).validate([2, 3, 4])\n   282\u2192            Traceback (most recent call last):\n   283\u2192                ...\n   284\u2192            ValidationError: [2, 3, 4] is too long\n   285\u2192            \"\"\"\n   286\u2192            for error in self.iter_errors(instance):\n   287\u2192                raise error\n   288\u2192\n   289\u2192        def descend(\n   290\u2192            self,\n   291\u2192            instance: Any,\n   292\u2192            schema: Any,\n   293\u2192            path: str | int | None = None,\n   294\u2192            schema_path: str | int | None = None,\n   295\u2192            property_path: str | None = None,\n   296\u2192        ) -> ValidationResult:\n   297\u2192            for error in self.evolve(\n   298\u2192                schema=schema,\n   299\u2192                context=self.context.evolve(\n   300\u2192                    path=self.context.path.descend(\n   301\u2192                        path=path,\n   302\u2192                        cfn_path=property_path,\n   303\u2192                    ),\n   304\u2192                ),\n   305\u2192            ).iter_errors(instance):\n   306\u2192                if path is not None:\n   307\u2192                    error.path.appendleft(path)\n   308\u2192                if schema_path is not None:\n   309\u2192                    error.schema_path.appendleft(schema_path)\n   310\u2192                yield error\n   311\u2192\n   312\u2192        def evolve(self, **kwargs) -> \"Validator\":\n   313\u2192            \"\"\"\n   314\u2192            Create a new validator like this one, but with given changes.\n   315\u2192\n   316\u2192            Preserves all other attributes, so can be used to e.g. create a\n   317\u2192            validator with a different schema but with the same :kw:`$ref`\n   318\u2192            resolution behavior.\n   319\u2192\n   320\u2192            >>> validator = StandardValidator({})\n   321\u2192            >>> validator.evolve(schema={\"type\": \"number\"})\n   322\u2192            StandardValidator(schema={'type': 'number'}, format_checker=None)\n   323\u2192            \"\"\"\n   324\u2192            cls = self.__class__\n   325\u2192            for f in fields(Validator):\n   326\u2192                if f.init:\n   327\u2192                    kwargs.setdefault(f.name, getattr(self, f.name))\n   328\u2192\n   329\u2192            return cls(**kwargs)\n   330\u2192\n   331\u2192        def extend(\n   332\u2192            self,\n   333\u2192            validators: dict[str, V] | None = None,\n   334\u2192            function_filter: FunctionFilter | None = None,\n   335\u2192            fn_resolvers: Mapping[str, Callable[[\"Validator\", Any], Any]] | None = None,\n   336\u2192        ) -> \"Validator\":\n   337\u2192            \"\"\"\n   338\u2192            Extends the current validator.\n   339\u2192\n   340\u2192            Updates validator in the current instance with the validators provided.\n   341\u2192\n   342\u2192            >>> validator = StandardValidator({}).extend(validators={\"type\": type})\n   343\u2192            \"\"\"\n   344\u2192            all_validators = dict(self.validators)\n   345\u2192            if validators is not None:\n   346\u2192                all_validators.update(validators)\n   347\u2192\n   348\u2192            if function_filter is None:\n   349\u2192                function_filter = self.function_filter\n   350\u2192\n   351\u2192            all_fn_resolvers = dict(self.fn_resolvers)\n   352\u2192            if fn_resolvers is not None:\n   353\u2192  