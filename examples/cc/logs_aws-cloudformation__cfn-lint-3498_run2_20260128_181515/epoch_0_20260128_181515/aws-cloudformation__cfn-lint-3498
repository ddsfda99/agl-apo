   235→                else:\n   236→                    self.rules.update(Rules.create_from_module(rules_path))\n   237→\n   238→            self.rules.update(\n   239→                Rules.create_from_custom_rules_file(self.config.custom_rules)\n   240→            )\n   241→        except (OSError, ImportError) as e:\n   242→            raise UnexpectedRuleException(\n   243→                f\"Tried to append rules but got an error: {str(e)}\", 1\n   244→            ) from e\n   245→\n   246→    def _validate_filenames(self, filenames: Sequence[str | None]) -> Iterator[Match]:\n   247→        \"\"\"\n   248→        Validate the specified filenames and yield any matches found.\n   249→\n   250→        This function processes each filename in the provided sequence, decoding the\n   251→        template and validating it against the configured rules. Any matches found\n   252→        are yielded as an iterator.\n   253→\n   254→        Args:\n   255→            filenames (Sequence[str | None]): The sequence of filenames to be validated.\n   256→\n   257→        Yields:\n   258→            Match: The matches found during the validation process.\n   259→\n   260→        Raises:\n   261→            None: This function does not raise any exceptions.\n   262→        \"\"\"\n   263→        ignore_bad_template: bool = False\n   264→        if self.config.ignore_bad_template:\n   265→            ignore_bad_template = True\n   266→        else:\n   267→            # There is no collection at this point so we need to handle this\n   268→            # check directly\n   269→            if not ParseError().is_enabled(\n   270→                include_experimental=False,\n   271→                ignore_rules=self.config.ignore_checks,\n   272→                include_rules=self.config.include_checks,\n   273→                mandatory_rules=self.config.mandatory_checks,\n   274→            ):\n   275→                ignore_bad_template = True\n   276→        for filename in filenames