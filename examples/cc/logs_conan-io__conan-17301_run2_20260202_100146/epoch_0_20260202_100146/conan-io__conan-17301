"install . -pr=profile2\")\n    84\u2192    assert \"tools.build:verbosity$quiet\" in client.out\n    85\u2192    assert \"tools.microsoft.msbuild:vs_version$Slow\" in client.out\n    86\u2192    assert \"tools.microsoft.msbuild:max_cpu_count$High\" in client.out\n    87\u2192    assert \"tools.cmake.cmaketoolchain:generator$Extra\" in client.out\n    88\u2192    assert \"tools.meson.mesontoolchain:backend$Super\" in client.out\n    89\u2192\n    90\u2192\n    91\u2192def test_composition_conan_conf(client):\n    92\u2192    conf = textwrap.dedent(\"\"\"\\\n    93\u2192        tools.build:verbosity=quiet\n    94\u2192        tools.microsoft.msbuild:vs_version=Slow\n    95\u2192        tools.cmake.cmaketoolchain:generator=Extra\n    96\u2192        \"\"\")\n    97\u2192    save(client.cache.new_config_path, conf)\n    98\u2192    profile = textwrap.dedent(\"\"\"\\\n    99\u2192        [conf]\n   100\u2192        tools.build:verbosity=quiet\n   101\u2192        tools.microsoft.msbuild:max_cpu_count=High\n   102\u2192        tools.meson.mesontoolchain:backend=Super\n   103\u2192        \"\"\")\n   104\u2192    client.save({\"profile\": profile})\n   105\u2192    client.run(\"install . -pr=profile\")\n   106\u2192    assert \"tools.build:verbosity$quiet\" in client.out\n   107\u2192    assert \"tools.microsoft.msbuild:vs_version$Slow\" in client.out\n   108\u2192    assert \"tools.microsoft.msbuild:max_cpu_count$High\" in client.out\n   109\u2192    assert \"tools.cmake.cmaketoolchain:generator$Extra\" in client.out\n   110\u2192    assert \"tools.meson.mesontoolchain:backend$Super\" in client.out\n   111\u2192\n   112\u2192\n   113\u2192def test_new_config_file(client):\n   114\u2192    conf = textwrap.dedent(\"\"\"\\\n   115\u2192        tools.build:verbosity=quiet\n   116\u2192        user.mycompany.myhelper:myconfig=myvalue\n   117\u2192        *:tools.cmake.cmaketoolchain:generator=X\n   118\u2192        \"\"\")\n   119\u2192    save(client.cache.new_config_path, conf)\n   120\u2192    client.run(\"install .\")\n   121\u2192    assert \"tools.build:verbosity$quiet\" in client.out\n   122\u2192    assert \"user.mycompany.myhelper:myconfig$myvalue\" in client.out\n   123\u2192    assert \"tools.cmake.cmaketoolchain:generator$X\" in client.out\n   124\u2192    assert \"read_only\" not in client.out\n   125\u2192\n   126\u2192    conf = textwrap.dedent(\"\"\"\\\n   127\u2192            tools.build:verbosity=notice\n   128\u2192            user.mycompany.myhelper:myconfig=myvalue\n   129\u2192            *:tools.cmake.cmaketoolchain:generator=X\n   130\u2192            cache:read_only=True\n   131\u2192            \"\"\")\n   132\u2192    save(client.cache.new_config_path, conf)\n   133\u2192    client.run(\"install .\", assert_error=True)\n   134\u2192    assert \"[conf] Either 'cache:read_only' does not exist in configuration list\" in client.out\n   135\u2192\n   136\u2192\n   137\u2192@patch(\"conan.__version__\", \"1.26.0\")\n   138\u2192def test_new_config_file_required_version():\n   139\u2192    client = TestClient()\n   140\u2192    conf = textwrap.dedent(\"\"\"\\\n   141\u2192        core:required_conan_version=>=2.0\n   142\u2192        \"\"\")\n   143\u2192    save(client.cache.new_config_path, conf)\n   144\u2192    client.run(\"install .\", assert_error=True)\n   145\u2192    assert (\"Current Conan version (1.26.0) does not satisfy the defined one (>=2.0)\"\n   146\u2192            in client.out)\n   147\u2192\n   148\u2192\n   149\u2192def test_composition_conan_conf_overwritten_by_cli_arg(client):\n   150\u2192    conf = textwrap.dedent(\"\"\"\\\n   151\u2192        tools.build:verbosity=quiet\n   152\u2192        tools.microsoft.msbuild:max_cpu_count=Slow\n   153\u2192        \"\"\")\n   154\u2192    save(client.cache.new_config_path, conf)\n   155\u2192    profile = textwrap.dedent(\"\"\"\\\n   156\u2192        [conf]\n   157\u2192        tools.build:verbosity=quiet\n   158\u2192        tools.microsoft.msbuild:vs_version=High\n   159\u2192        \"\"\")\n   160\u2192    client.save({\"profile\": profile})\n   161\u2192    client.run(\"install . -pr=profile -c tools.build:verbosity=verbose \"\n   162\u2192               \"-c tools.meson.mesontoolchain:backend=Super\")\n   163\u2192    assert \"tools.build:verbosity$verbose\" in client.out\n   164\u2192    assert \"tools.microsoft.msbuild:max_cpu_count$Slow\" in client.out\n   165\u2192    assert \"tools.microsoft.msbuild:vs_version$High\" in client.out\n   166\u2192    assert \"tools.meson.mesontoolchain:backend$Super\" in client.out\n   167\u2192\n   168\u2192\n   169\u2192def test_composition_conan_conf_different_data_types_by_cli_arg(client):\n   170\u2192    \"\"\"\n   171\u2192    Testing if you want to introduce a list/dict via cli\n   172\u2192\n   173\u2192    >> conan install . -c \"tools.build.flags:ccflags+=['-Werror']\"\n   174\u2192    >> conan install . -c \"tools.microsoft.msbuildtoolchain:compile_options={'ExceptionHandling': 'Async'}\"\n   175\u2192\n   176\u2192    \"\"\"\n   177\u2192    conf = textwrap.dedent(\"\"\"\\\n   178\u2192        tools.build:cflags=[\"-Wall\"]\n   179\u2192        \"\"\")\n   180\u2192    save(client.cache.new_config_path, conf)\n   181\u2192    client.run('install . -c \"tools.build:cflags+=[\\'-Werror\\']\" '\n   182\u2192               '-c \"tools.microsoft.msbuildtoolchain:compile_options={\\'ExceptionHandling\\': \\'Async\\'}\"')\n   183\u2192\n   184\u2192    assert \"tools.build:cflags$['-Wall', '-Werror']\" in client.out\n   185\u2192    assert \"tools.microsoft.msbuildtoolchain:compile_options${'ExceptionHandling': 'Async'}\" in client.out\n   186\u2192\n   187\u2192\n   188\u2192def test_jinja_global_conf(client):\n   189\u2192    save(client.cache.new_config_path, \"user.mycompany:parallel = {{os.cpu_count()/2}}\\n\"\n   190\u2192                                       \"user.mycompany:other = {{platform.system()}}\\n\"\n   191\u2192                                       \"user.mycompany:dist = {{distro.id() if distro else '42'}}\\n\"\n   192\u2192                                       \"user.conan:version = {{conan_version}}-{{conan_version>0.1}}\")\n   193\u2192    client.run(\"install .\")\n   194\u2192    assert \"user.mycompany:parallel={}\".format(os.cpu_count()/2) in client.out\n   195\u2192    assert \"user.mycompany:other={}\".format(platform.system()) in client.out\n   196\u2192    assert f\"user.conan:version={conan_version}-True\" in client.out\n   197\u2192    if platform.system() == \"Linux\":\n   198\u2192        import distro\n   199\u2192        assert \"user.mycompany:dist={}\".format(distro.id()) in client.out\n   200\u2192    else:\n   201\u2192        assert \"user.mycompany:dist=42\" in client.out\n   202\u2192\n   203\u2192\n   204\u2192def test_jinja_global_conf_include(client):\n   205\u2192    global_conf = textwrap.dedent(\"\"\"\\\n   206\u2192        {% include \"user_global.conf\" %}\n   207\u2192        {% import \"user_global.conf\" as vars %}\n   208\u2192        user.mycompany:dist = {{vars.myvar*2}}\n   209\u2192        \"\"\")\n   210\u2192    user_global_conf = textwrap.dedent(\"\"\"\\\n   211\u2192        {% set myvar = 42 %}\n   212\u2192        user.mycompany:parallel = {{myvar}}\n   213\u2192        \"\"\")\n   214\u2192    save(client.cache.new_config_path, global_conf)\n   215\u2192    save(os.path.join(client.cache_folder, \"user_global.conf\"), user_global_conf)\n   216\u2192    client.run(\"install .\")\n   217\u2192    assert \"user.mycompany:parallel=42\" in client.out\n   218\u2192    assert \"user.mycompany:dist=84\" in client.out\n   219\u2192\n   220\u2192\n   221\u2192def test_jinja_global_conf_paths():\n   222\u2192    c = TestClient()\n   223\u2192    global_conf = 'user.mycompany:myfile = {{os.path.join(conan_home_folder, \"myfile\")}}'\n   224\u2192    save(c.cache.new_config_path, global_conf)\n   225\u2192    c.run(\"config show *\")\n   226\u2192    cache_folder = c.cache_folder.replace(\"\\\\\", \"/\")\n   227\u2192    assert f\"user.mycompany:myfile: {os.path.join(cache_folder, 'myfile')}\" in c.out\n   228\u2192\n   229\u2192\n   230\u2192def test_profile_detect_os_arch():\n   231\u2192    \"\"\" testing OS & ARCH just to test that detect_api is injected\n   232\u2192    \"\"\"\n   233\u2192    c = TestClient()\n   234\u2192    global_conf = textwrap.dedent(\"\"\"\n   235\u2192        user.myteam:myconf1={{detect_api.detect_os()}}\n   236\u2192        user.myteam:myconf2={{detect_api.detect_arch()}}\n   237\u2192        \"\"\")\n   238\u2192\n   239\u2192    save(c.cache.new_config_path, global_conf)\n   240\u2192    c.run(\"config show *\")\n   241\u2192    _os = detect_api.detect_os()\n   242\u2192    _arch = detect_api.detect_arch()\n   243\u2192    assert f\"user.myteam:myconf1: {_os}\" in c.out\n   244\u2192    assert f\"user.myteam:myconf2: {_arch}\" in c.out\n   245\u2192\n   246\u2192\n   247\u2192def test_empty_conf_valid():\n   248\u2192    tc = TestClient()\n   249\u2192    profile = textwrap.dedent(r\"\"\"\n   250\u2192    [conf]\n   251\u2192    user:unset=\n   252\u2192    \"\"\")\n   253\u2192    conanfile = textwrap.dedent(r\"\"\"\n   254\u2192    from conan import ConanFile\n   255\u2192\n   256\u2192    class BasicConanfile(ConanFile):\n   257\u2192        name = \"pkg\"\n   258\u2192        version = \"1.0\"\n   259\u2192\n   260\u2192        def generate(self):\n   261\u2192            self.output.warning(f'My unset conf variable is: \"{self.conf.get(\"user:unset\")}\"')\n   262\u2192            self.output.warning(f'My unset conf is {\"NOT\" if self.conf.get(\"user:unset\") == None else \"\"} set')\n   263\u2192    \"\"\")\n   264\u2192    tc.save({\"conanfile.py\": conanfile, \"profile\": profile})\n   265\u2192\n   266\u2192    tc.run(\"create .\")\n   267\u2192    assert 'pkg/1.0: WARN: My unset conf is NOT set' in tc.out\n   268\u2192\n   269\u2192    tc.run(\"create . -pr=profile\")\n   270\u2192    assert 'pkg/1.0: WARN: My unset conf variable is: \"\"' in tc.out\n   271\u2192    assert 'pkg/1.0: WARN: My unset conf is  set' in tc.out\n   272\u2192\n   273\u2192    tc.run(\"create . -c user:unset=\")\n   274\u2192    assert 'pkg/1.0: WARN: My unset conf variable is: \"\"' in tc.out\n   275\u2192    assert 'pkg/1.0: WARN: My unset conf is  set' in tc.out\n   276\u2192\n   277\u2192    tc.run('create . -c user:unset=\"\"')\n   278\u2192    assert 'pkg/1.0: WARN: My unset conf variable is: \"\"' in tc.out\n   279\u2192    assert 'pkg/1.0: WARN: My unset conf is  set' in tc.out\n   280\u2192\n   281\u2192    # And ensure this actually works for the normal case, just in case\n   282\u2192    tc.run(\"create . -c user:unset=Hello\")\n   283\u2192    assert 'pkg/1.0: WARN: My unset conf variable is: \"Hello\"' in tc.out\n   284\u2192    assert 'pkg/1.0: WARN: My unset conf is  set' in tc.out\n   285\u2192\n   286\u2192\n   287\u2192def test_nonexisting_conf():\n   288\u2192    c = TestClient()\n   289\u2192    c.save({\"conanfile.txt\": \"\"})\n   290\u2192    c.run(\"install . -c tools.unknown:conf=value\", assert_error=True)\n   291\u2192    assert \"ERROR: [conf] Either 'tools.unknown:conf' does not exist in configuration\" in c.out\n   292\u2192    c.run(\"install . -c user.some:var=value\")  # This doesn't fail\n   293\u2192    c.run(\"install . -c tool.build:verbosity=v\", assert_error=True)\n   294\u2192    assert \"ERROR: [conf] Either 'tool.build:verbosity' does not exist in configuration\" in c.out\n   295\u2192\n   296\u2192\n   297\u2192def test_nonexisting_conf_global_conf():\n   298\u2192    c = TestClient()\n   299\u2192    save(c.cache.new_config_path, \"tools.unknown:conf=value\")\n   300\u2192    c.save({\"conanfile.txt\": \"\"})\n   301\u2192    c.run(\"install . \", assert_error=True)\n   302\u2192    assert \"ERROR: [conf] Either 'tools.unknown:conf' does not exist in configuration\" in c.out\n   303\u2192\n   304\u2192\n   305\u2192def test_global_