+def test_visual_studio_maxcpus_true():
+    # When max_cpu_count is True, expect '/m' without a value
+    c = ConfDefinition()
+    c.loads(textwrap.dedent("""\
+        tools.build:jobs=10
+        tools.microsoft.msbuild:max_cpu_count=True
+    """))
+    conanfile = ConanFileMock()
+    conanfile.conf = c.get_conanfile_conf(None)
+    args = _cmake_cmd_line_args(conanfile, 'Visual Studio 16 2019')
+    assert ["/m"] == args
