+    def _collect_refs_and_subs_from_obj(self, obj: Any) -> tuple[list[str], list[str]]:
+        """Recursively collect Ref and Fn::Sub parameter usages from a parsed object.
+
+        Returns a tuple of (refs, subs) containing parameter names referenced.
+        """
+        refs: list[str] = []
+        subs: list[str] = []
+
+        def walk(v: Any) -> None:
+            nonlocal refs, subs
+            if isinstance(v, dict):
+                # handle single-key function dicts first
+                if len(v) == 1:
+                    for k, val in v.items():
+                        if k == "Ref" and isinstance(val, str):
+                            refs.append(val)
+                        elif k == "Fn::Sub":
+                            # list form
+                            if isinstance(val, list):
+                                if val and isinstance(val[0], str):
+                                    subs.extend(self._extract_sub_params(val[0]))
+                            # string form
+                            elif isinstance(val, str):
+                                subs.extend(self._extract_sub_params(val))
+                        else:
+                            walk(val)
+                else:
+                    for k, val in v.items():
+                        # also catch nested refs/subs even if mixed with other keys
+                        if k == "Ref" and isinstance(val, str):
+                            refs.append(val)
+                        elif k == "Fn::Sub":
+                            if isinstance(val, list):
+                                if val and isinstance(val[0], str):
+                                    subs.extend(self._extract_sub_params(val[0]))
+                            elif isinstance(val, str):
+                                subs.extend(self._extract_sub_params(val))
+                        else:
+                            walk(val)
+            elif isinstance(v, list):
+                for item in v:
+                    walk(item)
+
+        walk(obj)
+        return refs, subs
+
+    def _extract_sub_params(self, s: str) -> list[str]:
+        """Extract parameter names from Fn::Sub strings.
+
+        Supports both standard ${Param} and double-brace ${{Param}} syntax seen in
+        some included OpenAPI specifications.
+        """
+        params: list[str] = []
+        if not isinstance(s, str):
+            return params
+        # standard ${Param}
+        for m in re.findall(r"\${([^!].*?)}", s):
+            params.append(m.strip())
+        # double-brace ${{Param}}
+        for m in re.findall(r"\$\{\{([^!].*?)\}\}", s):
+            params.append(m.strip())
+        return params
+
+    def _collect_from_includes(self, cfn: Template) -> tuple[list[str], list[str]]:
+        """Locate AWS::Include transforms and collect parameter usages from included files."""
+        include_refs: list[str] = []
