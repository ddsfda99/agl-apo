+            params = transform_val.get("Parameters")
+            if not isinstance(params, dict):
+                continue
+            location = params.get("Location")
+            if not isinstance(location, str):
+                continue
+            # skip remote locations
+            if location.startswith("s3://") or location.startswith("http://") or location.startswith("https://"):
+                continue
+            # resolve path relative to main template file
+            try:
+                base = os.path.dirname(cfn.filename) if cfn.filename else ""
+                include_path = os.path.normpath(os.path.join(base, location))
+            except Exception:
+                continue
+            # load included file
+            try:
+                included_obj = cfn_yaml.load(include_path)
+            except Exception:
+                continue
+            if not isinstance(included_obj, dict):
+                continue
+            refs, subs = self._collect_refs_and_subs_from_obj(included_obj)
+            include_refs.extend(refs)
+            include_subs.extend(subs)
+
