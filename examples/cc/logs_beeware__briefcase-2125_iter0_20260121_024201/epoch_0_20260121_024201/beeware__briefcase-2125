pp config\n   391→        \"\"\"\n   392→        return self.binary_path(app)\n   393→\n   394→    def unbuilt_executable_path(self, app) -> Path:\n   395→        \"\"\"The path to the unbuilt form of the binary object for the app.\n   396→\n   397→        The pre-built stub binary may need to undergo some manipulation before it can be\n   398→        used; to mark that this manipulation is required, the \"unbuilt\" binary has a\n   399→        \"raw\" name that doesn't involve any app details. The build step moves the binary\n   400→        to the final name.\n   401→\n   402→        :param app: The app config\n   403→        \"\"\"\n   404→        return self.binary_executable_path(app).parent / (\n   405→            \"Stub\" + self.binary_executable_path(app).suffix\n   406→        )\n   407→\n   408→    def briefcase_toml(self, app: AppConfig) -> dict[str, ...]:\n   409→        \"\"\"Load the ``briefcase.toml`` file provided by the app template.\n   410→\n   411→        :param app: The config object for the app\n   412→        :return: The contents of ``briefcase.toml``\n   413→        \"\"\"\n   414→        try:\n   415→            return self._briefcase_toml[app]\n   416→        except KeyError:\n   417→            try:\n   418→                with (self.bundle_path(app) / \"briefcase.toml\").open(\"rb\") as f:\n   419→                    self._briefcase_toml[app] = tomllib.load(f)\n   420→            except OSError as e:\n   421→                raise MissingAppMetadata(self.bundle_path(app)) from e\n   422→            else:\n   423→                return self._briefcase_toml[app]\n   424→\n   425→    def path_index(self, app: AppConfig, path_name: str) -> str | dict | list:\n   426→        \"\"\"Return a path from the path index provided by the app template.\n   427→\n   428→        Raises KeyError if ``path_name`` is not defined in the index.\n   429→\n   430→        :param app: The config object for the app\n   431→        :param path_name: Name of the filepath to retrieve\n   432→        :return: filepath for requested path\n   433→        \"\"\"\n   434→        return self.briefcase_toml(app)[\"paths\"][path_name]\n   435→\n   436→    def template_target_version(self, app: AppConfig) -> str | None:\n   437→        \"\"\"The target version of Briefcase for the app from ``briefcase.toml``.\n   438→\n   439→        This value represents a version epoch specific to the platform. An epoch begins\n   440→        when a breaking change is introduced. Therefore, this value would remain the\n   441→        version of Briefcase that introduced a breaking change for a template until\n   442→        another such change requires a new epoch.\n   443→\n   444→        :param app: The config object for the app\n   445→        :return: target version or None if one isn't specified\n   446→        \"\"\"\n   447→        try:\n   448→            return self.briefcase_toml(app)[\"briefcase\"][\"target_version\"]\n   449→        except KeyError:\n   450→            return None\n   451→\n   452→    def stub_binary_revision(self, app: AppConfig) -> str:\n   453→        \"\"\"Obtain the stub binary revision that the template requires.\n   454→\n   455→        :param app: The config object for the app\n   456→        :return: The stub binary revision required by the template.\n   457→        \"\"\"\n   458→        return self.path_index(app, \"stub_binary_revision\")\n   459→\n   460→    def support_path(self, app: AppConfig) -> Path:\n   461→        \"\"\"Obtain the path into which the support package should be unpacked.\n   462→\n   463→        :param app: The config object for the app\n   464→        :return: The full path where the support package should be unpacked.\n   465→        \"\"\"\n   466→        return self.bundle_path(app) / self.path_index(app, \"support_path\")\n   467→\n   468→    def support_revision(self, app: AppConfig) -> str:\n   469→        \"\"\"Obtain the support package revision that the template requires.\n   470→\n   471→        :param app: The config object for the app\n   472→        :return: The support revision required by the template.\n   473→        \"\"\"\n   474→        return self.path_index(app, \"support_revision\")\n   475→\n   476→    def cleanup_paths(self, app: AppConfig) -> list[str]:\n   477→        \"\"\"Obtain the paths generated by the app template that should be cleaned up\n   478→        prior to release.\n   479→\n   480→        :param app: The config object for the app\n   481→        :return: The list of path globs inside the app template that should be cleaned\n   482→            up.\n   483→        \"\"\"\n   484→        return self.path_index(app, \"cleanup_paths\")\n   485→\n   486→    def app_requirements_path(self, app: AppConfig) -> Path:\n   487→        \"\"\"Obtain the path into which a requirements.txt file should be written.\n   488→\n   489→        :param app: The config object for the app\n   490→        :return: The full path where the requirements.txt file should be written\n   491→        \"\"\"\n   492→        return self.bundle_path(app) / self.path_index(app, \"app_requirements_path\")\n   493→\n   494→    def app_requirement_installer_args_path(self, app: AppConfig) -> Path:\n   495→        \"\"\"Obtain the path into which a newline delimited requirement installer args\n   496→        file should be written.\n   497→\n   498→        :param app: The config object for the app\n   499→        :return: The full path where the file should be written\n   500→        \"\"\"\n   501→        return self.bundle_path(app) / self.path_index(\n   502→            app, \"app_requirement_installer_args_path\"\n   503→        )\n   504→\n   505→    def app_packages_path(self, app: AppConfig) -> Path:\n   506→        \"\"\"Obtain the path into which requirements should be installed.\n   507→\n   508→        :param app: The config object for the app\n   509→        :return: The full path where application requirements should be installed.\n   510→        \"\"\"\n   511→        return self.bundle_path(app) / self.path_index(app, \"app_packages_path\")\n   512→\n   513→    def app_path(self, app: AppConfig) -> Path:\n   514→        \"\"\"Obtain the path into which the application should be installed.\n   515→\n   516→        :param app: The config object for the app\n   517→        :return: The full path where application code should be installed.\n   518→        \"\"\"\n   519→        return self.bundle_path(app) / self.path_index(app, \"app_path\")\n   520→\n   521→    def app_module_path(self, app: AppConfig) -> Path:\n   522→        \"\"\"Find the path for the application module for an app.\n   523→\n   524→        :param app: The config object for the app\n   525→        :returns: The Path to the dist-info folder.\n   526→        \"\"\"\n   527→        app_home = [\n   528→            path.split(\"/\")\n   529→            for path in app.sources\n   530→            if path.rsplit(\"/\", 1)[-1] == app.module_name\n   531→        ]\n   532→\n   533→        if len(app_home) == 0:\n   534→            raise BriefcaseCommandError(\n   535→                f\"Unable to find code for application {app.app_name!r}\"\n   536→            )\n   537→        elif len(app_home) == 1:\n   538→            path = Path(str(self.base_path), *app_home[0])\n   539→        else:\n   540→            raise BriefcaseCommandError(\n   541→                f\"Multiple paths in sources found for application {app.app_name!r}\"\n   542→            )\n   543→\n   544→        return path\n   545→\n   546→    @property\n   547→    def briefcase_required_python_version(self):\n   548→        \"\"\"The major.minor of the minimum Python version required by Briefcase itself.\n   549→\n   550→        This is extracted from packaging metadata.\n   551→        \"\"\"\n   552→        # Native format is \">=3.8\"\n   553→        return tuple(\n   554→            int(v)\n   555→            for v in importlib.metadata.metadata(\"briefcase\")[\"Requires-Python\"]\n   556→            .split(\"=\")[1]\n   557→            .strip()\n   558→            .split(\".\")\n   559→        )\n   560→\n   561→    @property\n   562→    def python_version_tag(self):\n   563→        \"\"\"The major.minor of the Python version in use, as a string.\n   564→\n   565→        This is used as a repository label/tag to identify the appropriate templates,\n   566→        etc. to use.\n   567→        \"\"\"\n   568→        return (\n   569→            f\"{self.tools.sys.version_info.major}.{self.tools.sys.version_info.minor}\"\n   570→        )\n   571→\n   572→    def verify_host(self):\n   573→        \"\"\"Verify the host OS is supported by the Command.\"\"\"\n   574→        if self.tools.host_os not in self.supported_host_os:\n   575→            raise UnsupportedHostError(self.supported_host_os_reason)\n   576→\n   577→    def verify_tools(self):\n   578→        \"\"\"Verify that the tools needed to run this Command exist.\n   579→\n   580→        Raises MissingToolException if a required system tool is missing.\n   581→        \"\"\"\n   582→\n   583→    def finalize_app_config(self, app: AppConfig):\n   584→        \"\"\"Finalize the application config.\n   585→\n   586→        Some app configurations (notably, Linux system packages like .deb) have\n   587→        configurations that are deeper than other platforms, because they need to\n   588→        include components that are dependent on command-line arguments. They may also\n   589→        require the existence of system tools to complete configuration.\n   590→\n   591→        The final app configuration merges those \"deep\" properties into the app\n   592→        configuration, and performs any other app-specific platform configuration and\n   593→        verification that is required as a result of command-line arguments.\n   594→\n   595→        :param app: The app configuration to finalize.\n   596→        \"\"\"\n   597→\n   598→    def finalize(self, app: AppConfig | None = None):\n   599→        \"\"\"Finalize Briefcase configuration.\n   600→\n   601→        This will:\n   602→\n   603→        1. Ensure that the host has been verified\n   604→        2. Ensure that the platform tools have been verified\n   605→        3. Ensure that app configurations have been finalized.\n   606→\n   607→        App finalization will only occur once per invocation.\n   608→\n   609→        :param app: If provided, the specific app configuration\n   610→            to finalize. By default, all apps will be finalized.\n   611→        \"\"\"\n   612→        self.verify_host()\n   613→        self.verify_tools()\n   614→\n   615→        if app is None:\n   616→            for app in self.apps.values():\n   617→                if hasattr(app, \"__draft__\"):\n   618→                    self.finalize_app_config(app)\n   619→                    delattr(app, \"__draft__\")\n   620→        else:\n   621→            if hasattr(app, \"__draft__\"):\n   622→                self.finalize_app_config(app)\n   623→                delattr(app, \"__draft__\")\n   624→\n   625→    def verify_app(self, app: AppConfig):\n   626→        \"\"\"Verify the app is compatible and the app tools are available.\n   627→\n   628→        This is the last step of verification for a Command before running the Command's\n   629→        business logic. It runs _after_ pre-requisite Commands have been verified and\n   630→        run.\n   631→\n   632→        :param app: app configuration\n   633→        \"\"\"\n   634→        self.verify_app_template(app)\n   635→        self.verify_app_tools(app)\n   636→        self.verify_required_python(app)\n   637→\n   638→    def verify_app_tools(self, app: AppConfig):\n   639→        \"\"\"Verify that tools needed to run the command for this app exist.\"\"\"\n   640→\n   641→    def verify_app_template(self, app: AppConfig):\n   642→        \"\"\"Verify the template targets the same Briefcase version as the Command.\n   643→\n   644→        :param app: app configuration\n   645→        \"\"\"\n   646→\n   647→        # Skip this check if the template isn't rolled out\n   648→        # or if the command doesn't support templates\n   649→        try:\n   650→            template_target_version = self.template_target_version(app)\n   651→        except (MissingAppMetadata, NotImplementedError):\n   652→            return\n   653→\n   654→        if self.platform_target_version != template_target_version:\n   655→            raise BriefcaseCommandError(\n   656→                f\"\"\"\\\n   657→The app template used to generate this app is not compatible with this version\n   658→of Briefcase.\n   659→\n   660→If the app was generated with an earlier version of Briefcase using the default\n   661→Briefcase template, you can run:\n   662→\n   663→     $ briefcase create {self.platform} {self.output_format}\n   664→\n   665→to re-generate your app with a compatible version of the template.\n   666→\n   667→If you are using a custom template, you'll need to update the template to correct\n   668→any compatibility problems, and then add the compatibility declaration.\n   669→\"\"\"\n   670→            )\n   671→\n   672→    def verify_required_python(self, app: AppConfig):\n   673→        \"\"\"Verify that the running version of Python meets the project's specifications.\"\"\"\n   674→\n   675→        requires_python = getattr(self.global_config, \"requires_python\", None)\n   676→        if not requires_python:\n   677→            return\n   678→\n   679→        try:\n   680→            spec = Specifier(requires_python)\n   681→        except InvalidSpecifier as e:\n   682→            raise BriefcaseConfigError(\n   683→                f\"Invalid requires-python in pyproject.toml: {e}\"\n   684→            ) from e\n   685→\n   686→        running_version = platform.python_version()\n   687→\n   688→        if not spec.contains(running_version, prereleases=True):\n   689→            raise UnsupportedPythonVersion(\n   690→                version_specifier=requires_python, running_version=running_version\n   691→            )\n   692→\n   693→    def parse_options(self, extra):\n   694→        \"\"\"Parse the command line arguments for the Command.\n   695→\n   696→        After the initial ArgumentParser runs to choose the Command for the selected\n   697→        platform and format, a new ArgumentParser is created here to parse the remaining\n   698→        command line arguments specific to the Command. Additionally, the default\n   699→        options for disabling input, log verbosity, and log saving are parsed out and\n   700→        saved to the Command.\n   701→\n   702→        :param extra: the remaining command line arguments after the initial\n   703→            ArgumentParser runs over the command line.\n   704→        :return: dictionary of parsed arguments for Command, and a dictionary of parsed\n   705→            configuration overrides.\n   706→        \"\"\"\n   707→        default_format = getattr(\n   708→            get_platforms().get(self.platform), \"DEFAULT_OUTPUT_FORMAT\", None\n   709→        )\n   710→        # only show supported formats for Commands that support formats\n   711→        if default_format is not None and self.command not in {\"new\", \"dev\", \"upgrade\"}:\n   712→            formats = list(get_output_formats(self.platform).keys())\n   713→            formats[formats.index(default_format)] = f\"{default_format} (default)\"\n   714→            supported_formats_helptext = (\n   715→                f\"Supported formats:\\n  {', '.join(sorted(formats, key=str.lower))}\"\n   716→            )\n   717→        else:\n   718→            supported_formats_helptext = \"\"\n   719→\n   720→        parser = argparse.ArgumentParser(\n   721→            prog=self.cmd_line.format(\n   722→                command=self.command,\n   723→                platform=self.platform,\n   724→                output_format=self.output_format,\n   725→            ),\n   726→            description=self.console.textwrap(\n   727→                f\"{self.description}\\n\\n{supported_formats_helptext}\"\n   728→            ),\n   729→            formatter_class=(\n   730→                lambda prog: RawDescriptionHelpFormatter(prog, width=MAX_TEXT_WIDTH)\n   731→            ),\n   732→        )\n   733→\n   734→        self.add_default_options(parser)\n   735→        self.add_options(parser)\n   736→\n   737→        # If the command allows passthrough arguments, add an option for the help,\n   738→        # then process the argument list to strip out the passthrough args.\n   739→        if self.allows_passthrough:\n   740→            parser.add_argument(\n   741→                \"--\",\n   742→                dest=\"passthrough\",\n   743→                metavar=\"ARGS ...\",\n   744→                required=False,\n   745→                help=\"Arguments to pass to the app\",\n   746→            )\n   747→            args, passthrough = split_passthrough(extra)\n   748→        else:\n   749→            args = extra\n   750→\n   751→        # Parse the full set of command line options from the content\n   752→        # remaining after the basic command/platform/output format\n   753→        # has been extracted.\n   754→        options = vars(parser.parse_args(args))\n   755→\n   756→        if self.allows_passthrough:\n   757→            options[\"passthrough\"] = passthrough\n   758→\n   759→        # Extract the base default options onto the command\n   760→        self.console.input_enabled = options.pop(\"input_enabled\")\n   761→        self.console.verbosity = options.pop(\"verbosity\")\n   762→        self.console.save_log = options.pop(\"save_log\")\n   763→\n   764→        # Parse the configuration overrides\n   765→        overrides = parse_config_overrides(options.pop(\"config_overrides\"))\n   766→\n   767→        return options, overrides\n   768→\n   769→    def clone_options(self, command):\n   77