                remote.set_url(new_url=template)\n  1010→                try:\n  1011→                    # Attempt to update the repository\n  1012→                    remote.fetch()\n  1013→                except self.tools.git.exc.GitCommandError as e:\n  1014→                    # We are offline, or otherwise unable to contact the origin git\n  1015→                    # repo. It's OK to continue; but capture the error in the log and\n  1016→                    # warn the user that the template may be stale.\n  1017→                    self.console.debug(str(e))\n  1018→                    self.console.warning(\n  1019→                        \"\"\"\n  1020→*************************************************************************\n  1021→** WARNING: Unable to update template                                  **\n  1022→*************************************************************************\n  1023→\n  1024→    Briefcase is unable the update the application template. This\n  1025→    may be because your computer is currently offline. Briefcase will\n  1026→    use existing template without updating.\n  1027→\n  1028→*************************************************************************\n  1029→\"\"\"\n  1030→                    )\n  1031→\n  1032→                try:\n  1033→                    # Check out the branch for the required version tag.\n  1034→                    head = remote.refs[branch]\n  1035→\n  1036→                    self.console.info(\n  1037→                        f\"Using existing template (sha {head.commit.hexsha}, \"\n  1038→                        f\"updated {head.commit.committed_datetime.strftime('%c')})\"\n  1039→                    )\n  1040→                    head.checkout()\n  1041→                except IndexError as e:\n  1042→                    # No branch exists for the requested version.\n  1043→                    raise InvalidTemplateBranch(template, branch) from e\n  1044→            except (ValueError, self.tools.git.exc.GitError) as e:\n  1045→                raise BriefcaseCommandError(\n  1046→                    \"Unable to check out template branch.\\n\"\n  1047→                    \"\\n\"\n  1048→                    \"This may be because your computer is offline, or because the template repository\\n\"\n  1049→                    \"is in a weird state. If you have a stable network connection, try deleting:\\n\"\n  1050→                    \"\\n\"\n  1051→                    f\"    {cached_template}\\n\"\n  1052→                    \"\\n\"\n  1053→                    \"and retrying your command.\"\n  1054→                ) from e\n  1055→        else:\n  1056→            # If this isn't a repository URL, treat it as a local directory\n  1057→            cached_template = template\n  1058→\n  1059→        return cached_template\n  1060→\n  1061→    def _generate_template(self, template, branch, output_path, extra_context):\n  1062→        \"\"\"Ensure the named template is up-to-date for the given branch, and roll out\n  1063→        that template.\n  1064→\n  1065→        :param template: The template URL or path to generate\n  1066→        :param branch: The branch of the template to use\n  1067→        :param output_path: The filesystem path where the template will be generated.\n  1068→        :param extra_context: Extra context to pass to the cookiecutter template\n  1069→        \"\"\"\n  1070→        # Make sure we have an updated cookiecutter template,\n  1071→        # checked out to the right branch\n  1072→        cached_template = self.update_cookiecutter_cache(\n  1073→            template=template,\n  1074→            branch=branch,\n  1075→        )\n  1076→\n  1077→        self.console.configure_stdlib_logging(\"cookiecutter\")\n  1078→        try:\n  1079→            # Unroll the template.\n  1080→            self.tools.cookiecutter(\n  1081→                str(cached_template),\n  1082→                no_input=True,\n  1083→                output_dir=str(