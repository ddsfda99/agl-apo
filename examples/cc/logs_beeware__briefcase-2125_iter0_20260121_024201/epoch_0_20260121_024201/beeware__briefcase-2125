s not killed at the end of the test\n   310\u2192    run_command.tools.mock_adb.kill.assert_not_called()\n   311\u2192\n   312\u2192\n   313\u2192def test_run_slow_start(run_command, first_app_config, monkeypatch):\n   314\u2192    \"\"\"If the app is slow to start, multiple calls to pidof will be made.\"\"\"\n   315\u2192    run_command.tools.android_sdk.select_target_device = mock.MagicMock(\n   316\u2192        return_value=(\"exampleDevice\", \"ExampleDevice\", None)\n   317\u2192    )\n   318\u2192\n   319\u2192    # Set up the log streamer to return a known stream\n   320\u2192    log_popen = mock.MagicMock()\n   321\u2192    run_command.tools.mock_adb.logcat.return_value = log_popen\n   322\u2192\n   323\u2192    # Mock the pidof call taking 3 attempts to return\n   324\u2192    run_command.tools.mock_adb.pidof.side_effect = [None, None, \"888\"]\n   325\u2192    monkeypatch.setattr(time, \"sleep\", mock.MagicMock())\n   326\u2192\n   327\u2192    run_command.run_app(\n   328\u2192        first_app_config,\n   329\u2192        device_or_avd=\"exampleDevice\",\n   330\u2192        test_mode=False,\n   331\u2192        passthrough=[],\n   332\u2192    )\n   333\u2192\n   334\u2192    assert (\n   335\u2192        run_command.tools.mock_adb.pidof.mock_calls\n   336\u2192        == [mock.call(\"com.example.first_app\", quiet=True)] * 3\n   337\u2192    )\n   338\u2192    assert time.sleep.mock_calls == [mock.call(0.01)] * 2\n   339\u2192    run_command.tools.mock_adb.logcat.assert_called_once_with(pid=\"888\")\n   340\u2192\n   341\u2192    run_command._stream_app_logs.assert_called_once_with(\n   342\u2192        first_app_config,\n   343\u2192        popen=log_popen,\n   344\u2192        test_mode=False,\n   345\u2192        clean_filter=android_log_clean_filter,\n   346\u2192        clean_output=False,\n   347\u2192        stop_func=mock.ANY,\n   348\u2192        log_stream=True,\n   349\u2192    )\n   350\u2192\n   351\u2192\n   352\u2192def test_run_crash_at_start(run_command, first_app_config, monkeypatch):\n   353\u2192    \"\"\"If the app crashes before a PID can be read, a log dump is shown.\"\"\"\n   354\u2192    run_command.tools.android_sdk.select_target_device = mock.MagicMock(\n   355\u2192        return_value=(\"exampleDevice\", \"ExampleDevice\", None)\n   356\u2192    )\n   357\u2192\n   358\u2192    # Mock the pidof call failing multiple times before a timeout.\n   359\u2192    run_command.tools.mock_adb.pidof.side_effect = [None] * 5\n   360\u2192    monkeypatch.setattr(time, \"sleep\", mock.MagicMock())\n   361\u2192\n   362\u2192    # It's the eternal september...\n   363\u2192    device_start_datetime = datetime.datetime(2022, 9, 9, 7, 6, 42)\n   364\u2192    pid_lookup_start_datetime = datetime.datetime(2022, 9, 8, 7, 6, 42)\n   365\u2192\n   366\u2192    # Mock time progression so PID lookup loops 5 times\n   367\u2192    mock_datetime = mock.MagicMock(spec=datetime.datetime)\n   368\u2192    # Mock datetime.now() at +0s, +0.5s, +1.5s,... +5.5s\n   369\u2192    mock_datetime.now.side_effect = [\n   370\u2192        pid_lookup_start_datetime + datetime.timedelta(seconds=delay)\n   371\u2192        for delay in [0] + [x + 0.5 for x in range(0, 6)]\n   372\u2192    ]\n   373\u2192    monkeypatch.setattr(datetime, \"datetime\", mock_datetime)\n   374\u2192\n   375\u2192    # Mock the device start datetime\n   376\u2192    run_command.tools.mock_adb.datetime.return_value = device_start_datetime\n   377\u2192\n   378\u2192    with pytest.raises(\n   379\u2192        BriefcaseCommandError, match=r\"Problem starting app 'first-app'\"\n   380\u2192    ):\n   381\u2192        run_command.run_app(\n   382\u2192            first_app_config,\n   383\u2192            device_or_avd=\"exampleDevice\",\n   384\u2192            test_mode=False,\n   385\u2192            passthrough=[],\n   386\u2192        )\n   387\u2192\n   388\u2192    assert (\n   389\u2192        run_command.tools.mock_adb.pidof.mock_calls\n   390\u2192        == [mock.call(\"com.example.first_app\", quiet=True)] * 5\n   391\u2192    )\n   392\u2192    assert time.sleep.mock_calls == [mock.call(0.01)] * 5\n   393\u2192\n   394\u2192    # The PID was never found, so logs can't be streamed\n   395\u2192    run_command.tools.mock_adb.logcat.assert_not_called()\n   396\u2192\n   397\u2192    # But we will get a log dump from logcat_tail\n   398\u2192    run_command.tools.mock_adb.logcat_tail.assert_called_once_with(\n   399\u2192        since=device_start_datetime\n   400\u2192    )\n   401\u2192\n   402\u2192\n   403\u2192def test_run_created_emulator(run_command, first_app_config):\n   404\u2192    \"\"\"The user can choose to run on a newly created emulator.\"\"\"\n   405\u2192    # Set up device selection to return a completely new emulator\n   406\u2192    run_command.tools.android_sdk.select_target_device = mock.MagicMock(\n   407\u2192        return_value=(None, None, None)\n   408\u2192    )\n   409\u2192    run_command.tools.android_sdk.create_emulator = mock.MagicMock(\n   410\u2192        return_value=\"newDevice\"\n   411\u2192    )\n   412\u2192    run_command.tools.android_sdk.verify_avd = mock.MagicMock()\n   413\u2192    run_command.tools.android_sdk.start_emulator = mock.MagicMock(\n   414\u2192        return_value=(\"emulator-3742\", \"New Device\")\n   415\u2192    )\n   416\u2192\n   417\u2192    # Set up the log streamer to return a known stream\n   418\u2192    log_popen = mock.MagicMock()\n   419\u2192    run_command.tools.mock_adb.logcat.return_value = log_popen\n   420\u2192\n   421\u2192    # Invoke run_app\n   422\u2192    run_command.run_app(first_app_config, test_mode=False, passthrough=[])\n   423\u2192\n   424\u2192    # A new emulator was created\n   425\u2192    run_command.tools.android_sdk.create_emulator.assert_called_once_with()\n   426\u2192\n   427\u2192    # No attempt was made to verify the AVD (it is pre-verified through\n   428\u2192    # the creation process)\n   429\u2192    run_command.tools.android_sdk.verify_avd.assert_not_called()\n   430\u2192\n   431\u2192    # The emulator was started\n   432\u2192    run_command.tools.android_sdk.start_emulator.assert_called_once_with(\n   433\u2192        \"newDevice\", None\n   434\u2192    )\n   435\u2192\n   436\u2192    # The ADB wrapper is created\n   437\u2192    run_command.tools.android_sdk.adb.assert_called_once_with(device=\"emulator-3742\")\n   438\u2192\n   439\u2192    # The adb wrapper is invoked with the expected arguments\n   440\u2192    run_command.tools.mock_adb.install_apk.assert_called_once_with(\n   441\u2192        run_command.binary_path(first_app_config)\n   442\u2192    )\n   443\u2192    run_command.tools.mock_adb.force_stop_app.assert_called_once_with(\n   444\u2192        f\"{first_app_config.package_name}.{first_app_config.module_name}\",\n   445\u2192    )\n   446\u2192\n   447\u2192    run_command.tools.mock_adb.start_app.assert_called_once_with(\n   448\u2192        f\"{first_app_config.package_name}.{first_app_config.module_name}\",\n   449\u2192        \"org.beeware.android.MainActivity\",\n   450\u2192        [],\n   451\u2192    )\n   452\u2192\n   453\u2192    run_command.tools.mock_adb.logcat.assert_called_once_with(pid=\"777\")\n   454\u2192\n   455\u2192    run_command._stream_app_logs.assert_called_once_with(\n   456\u2192        first_app_config,\n   457\u2192        popen=log_popen,\n   458\u2192        test_mode=False,\n   459\u2192        clean_filter=android_log_clean_filter,\n   460\u2192        clean_output=False,\n   461\u2192        stop_func=mock.ANY,\n   462\u2192        log_stream=True,\n   463\u2192    )\n   464\u2192\n   465\u2192\n   466\u2192def test_run_idle_device(run_command, first_app_config):\n   467\u2192    \"\"\"The user can choose to run on an idle device.\"\"\"\n   468\u2192    # Set up device selection to return a new device that has an AVD,\n   469\u2192    # but not a device ID.\n   470\u2192    run_command.tools.android_sdk.select_target_device = mock.MagicMock(\n   471\u2192        return_value=(None, \"Idle Device\", \"idleDevice\")\n   472\u2192    )\n   473\u2192\n   474\u2192    run_command.tools.android_sdk.create_emulator = mock.MagicMock()\n   475\u2192    run_command.tools.android_sdk.verify_avd = mock.MagicMock()\n   476\u2192    run_command.tools.android_sdk.start_emulator = mock.MagicMock(\n   477\u2192        return_value=(\"emulator-3742\", \"Idle Device\")\n   478\u2192    )\n   479\u2192\n   480\u2192    # Set up the log streamer to return a known stream\n   481\u2192    log_popen = mock.MagicMock()\n   482\u2192    run_command.tools.mock_adb.logcat.return_value = log_popen\n   483\u2192\n   484\u2192    # Invoke run_app\n   485\u2192    run_command.run_app(first_app_config, test_mode=False, passthrough=[])\n   486\u2192\n   487\u2192    # No attempt was made to create a new emulator\n   488\u2192    run_command.tools.android_sdk.create_emulator.assert_not_called()\n   489\u2192\n   490\u2192    # The AVD has been verified\n   491\u2192    run_command.tools.android_sdk.verify_avd.assert_called_with(\"idleDevice\")\n   492\u2192\n   493\u2192    # The emulator was started\n   494\u2192    run_command.tools.android_sdk.start_emulator.assert_called_once_with(\n   495\u2192        \"idleDevice\", None\n   496\u2192    )\n   497\u2192\n   498\u2192    # The ADB wrapper is created\n   499\u2192    run_command.tools.android_sdk.adb.assert_called_once_with(device=\"emulator-3742\")\n   500\u2192\n   501\u2192    # The adb wrapper is invoked with the expected arguments\n   502\u2192    run_command.tools.mock_adb.install_apk.assert_called_once_with(\n   503\u2192        run_command.binary_path(first_app_config)\n   504\u2192    )\n   505\u2192    run_command.tools.mock_adb.force_stop_app.assert_called_once_with(\n   506\u2192        f\"{first_app_config.package_name}.{first_app_config.module_name}\",\n   507\u2192    )\n   508\u2192\n   509\u2192    run_command.tools.mock_adb.start_app.assert_called_once_with(\n   510\u2192        f\"{first_app_config.package_name}.{first_app_config.module_name}\",\n   511\u2192        \"org.beeware.android.MainActivity\",\n   512\u2192        [],\n   513\u2192    )\n   514\u2192\n   515\u2192    run_command.tools.mock_adb.logcat.assert_called_once_with(pid=\"777\")\n   516\u2192\n   517\u2192    run_command._stream_app_logs.assert_called_once_with(\n   518\u2192        first_app_config,\n   519\u2192        popen=log_popen,\n   520\u2192        test_mode=False,\n   521\u2192        clean_filter=android_log_clean_filter,\n   522\u2192        clean_output=False,\n   523\u2192        stop_func=mock.ANY,\n   524\u2192        log_stream=True,\n   525\u2192    )\n   526\u2192\n   527\u2192\n   528\u2192def test_log_file_extra(run_command, monkeypatch):\n   529\u2192    \"\"\"Android commands register a log file extra to list SDK packages.\"\"\"\n   530\u2192    mock_android_sdk_verify = mock.MagicMock(return_value=run_command.tools.android_sdk)\n   531\u2192    monkeypatch.setattr(AndroidSDK, \"verify\", mock_android_sdk_verify)\n   532\u2192    monkeypatch.setattr(AndroidSDK, \"verify_emulator\", mock.MagicMock())\n   533\u2192\n   534\u2192    # Even if one command triggers another, the sdkmanager should only be run once.\n   535\u2192    run_command.update_command.verify_tools()\n   536\u2192    run_command.verify_tools()\n   537\u2192\n   538\u2192    # Android SDK tool was verified\n   539\u2192    mock_android_sdk_verify.assert_has_calls([mock.call(tools=run_command.tools)] * 2)\n   540\u2192    assert isinstance(run_command.tools.android_sdk, AndroidSDK)\n   541\u2192\n   542\u2192    # list_packages() was not called\n   543\u2192    run_command.tools.subprocess.check_output.assert_not_called()\n   544\u2192\n   545\u2192    # list_packages() is called when saving the log\n   546\u2192    run_command.tools.console.save_log = True\n   547\u2192    run_command.tools.console.save_log_to_file(run_command)\n   548\u2192\n   549\u2192    sdk_manager = Path(\n   550\u2192        f\"/path/to/android_sdk/cmdline-tools/{AndroidSDK.SDK_MANAGER_VER}\"\n   551\u2192        f\"/bin/sdkmanager{'.bat' if platform.system() == 'Windows' else ''}\"\n   552\u2192    )\n   553\u2192    run_command.tools.subprocess.check_output.assert_called_once_with(\n   554\u2192        [sdk_manager, \"--list_installed\"],\n   555\u2192        env={\n   556\u2192            \"ANDROID_HOME\": str(run_command.tools.android_sdk.root_path),\n   557\u2192            \"ANDROID_SDK_ROOT\": str(run_command.tools.android_sdk.root_path),\n   558\u2192            \"JAVA_HOME\": str(run_command.tools.java.java_home),\n   559\u2192        },\n   560\u2192    )\n   561\u2192\n   562\u2192\n   563\u2192def test_run_test_mode(run_command, first_app_config):\n   564\u2192    \"\"\"An app can be run in test mode.\"\"\"\n   565\u2192    # Set up device selection to return a running physical device.\n   566\u2192    run_command.tools.android_sdk.select_target_device = mock.MagicMock(\n   567\u2192        return_value=(\"exampleDevice\", \"ExampleDevice\", None)\n   568\u2192    )\n   569\u2192\n   570\u2192    # Set up the log streamer to return a known stream\n   571\u2192    log_popen = mock.MagicMock()\n   572\u2192    run_command.tools.mock_adb.logcat.return_value = log_popen\n   573\u2192\n   574\u2192    # To satisfy coverage, the stop function must be invoked at least once\n   575\u2192    # when invoking stream_output.\n   576\u2192    def mock_stream_output(app, stop_func, **kwargs):\n   577\u2192        stop_func()\n   578\u2192\n   579\u2192    run_command._stream_app_logs.side_effect = mock_stream_output\n   580\u2192\n   581\u2192    # Set up app config to have a `-` in the `bundle`, to ensure it gets\n   582\u2192    # normalized into a `_` via `package_name`.\n   583\u2192    first_app_config.bundle = \"com.ex-ample\"\n   584\u2192\n   585\u2192    # Invoke run_app\n   586\u2192    run_command.run