f x_permissions[\"microphone\"]:\n   256→            permissions[\"android.permission.RECORD_AUDIO\"] = True\n   257→\n   258→        if x_permissions[\"fine_location\"]:\n   259→            permissions[\"android.permission.ACCESS_FINE_LOCATION\"] = True\n   260→            features[\"android.hardware.location.network\"] = False\n   261→            features[\"android.hardware.location.gps\"] = False\n   262→\n   263→        if x_permissions[\"coarse_location\"]:\n   264→            permissions[\"android.permission.ACCESS_COARSE_LOCATION\"] = True\n   265→            features[\"android.hardware.location.network\"] = False\n   266→            features[\"android.hardware.location.gps\"] = False\n   267→\n   268→        if x_permissions[\"background_location\"]:\n   269→            permissions[\"android.permission.ACCESS_BACKGROUND_LOCATION\"] = True\n   270→            features[\"android.hardware.location.network\"] = False\n   271→            features[\"android.hardware.location.gps\"] = False\n   272→\n   273→        if x_permissions[\"photo_library\"]:\n   274→            permissions[\"android.permission.READ_MEDIA_VISUAL_USER_SELECTED\"] = True\n   275→\n   276→        # Override any permission and entitlement definitions with the platform specific definitions\n   277→        permissions.update(app.permission)\n   278→        features.update(getattr(app, \"feature\", {}))\n   279→\n   280→        return {\n   281→            \"permissions\": permissions,\n   282→            \"features\": features,\n   283→        }\n   284→\n   285→\n   286→class GradleUpdateCommand(GradleCreateCommand, UpdateCommand):\n   287→    description = \"Update an existing Android Gradle project.\"\n   288→\n   289→\n   290→class GradleOpenCommand(GradleMixin, OpenCommand):\n   291→    description = \"Open the folder for an existing Android Gradle project.\"\n   292→\n   293→\n   294→class GradleBuildCommand(GradleMixin, BuildCommand):\n   295→    description = \"Build an Android debug APK