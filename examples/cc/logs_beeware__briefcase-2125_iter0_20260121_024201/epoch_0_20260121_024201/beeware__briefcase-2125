text = extra_context.copy()\n  1120→        # Additional context that can be used for the Briefcase template pyproject.toml\n  1121→        # header to include the version of Briefcase as well as the source of the template.\n  1122→        extra_context.update(\n  1123→            {\n  1124→                \"template_source\": template,\n  1125→                \"template_branch\": template_branch,\n  1126→                \"briefcase_version\": str(version),\n  1127→            }\n  1128→        )\n  1129→\n  1130→        try:\n  1131→            self.console.info(\n  1132→                f\"Using app template: {template}, branch {template_branch}\"\n  1133→            )\n  1134→            # Unroll the new app template\n  1135→            self._generate_template(\n  1136→                template=template,\n  1137→                branch=template_branch,\n  1138→                output_path=output_path,\n  1139→                extra_context=extra_context,\n  1140→            )\n  1141→        except InvalidTemplateBranch:\n  1142→            # Only use the main template if we're on a development branch of briefcase\n  1143→            # and the user didn't explicitly specify which branch to use.\n  1144→            if version.dev is None or branch is not None:\n  1145→                raise\n  1146→\n  1147→            # Development branches can use the main template.\n  1148→            self.console.info(\n  1149→                f\"Template branch {template_branch} not found; falling back to development template\"\n  1150→            )\n  1151→\n  1152→            extra_context[\"template_branch\"] = \"main\"\n  1153→            self._generate_template(\n  1154→                template=template,\n  1155→                branch=\"main\",\n  1156→                output_path=output_path,\n  1157→                extra_context=extra_context,\n  1158→            )\n  1159→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malwa