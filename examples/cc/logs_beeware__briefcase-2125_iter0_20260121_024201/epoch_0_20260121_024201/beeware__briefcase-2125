eper than other platforms, because they need to\n   588\u2192        include components that are dependent on command-line arguments. They may also\n   589\u2192        require the existence of system tools to complete configuration.\n   590\u2192\n   591\u2192        The final app configuration merges those \"deep\" properties into the app\n   592\u2192        configuration, and performs any other app-specific platform configuration and\n   593\u2192        verification that is required as a result of command-line arguments.\n   594\u2192\n   595\u2192        :param app: The app configuration to finalize.\n   596\u2192        \"\"\"\n   597\u2192\n   598\u2192    def finalize(self, app: AppConfig | None = None):\n   599\u2192        \"\"\"Finalize Briefcase configuration.\n   600\u2192\n   601\u2192        This will:\n   602\u2192\n   603\u2192        1. Ensure that the host has been verified\n   604\u2192        2. Ensure that the platform tools have been verified\n   605\u2192        3. Ensure that app configurations have been finalized.\n   606\u2192\n   607\u2192        App finalization will only occur once per invocation.\n   608\u2192\n   609\u2192        :param app: If provided, the specific app configuration\n   610\u2192            to finalize. By default, all apps will be finalized.\n   611\u2192        \"\"\"\n   612\u2192        self.verify_host()\n   613\u2192        self.verify_tools()\n   614\u2192\n   615\u2192        if app is None:\n   616\u2192            for app in self.apps.values():\n   617\u2192                if hasattr(app, \"__draft__\"):\n   618\u2192                    self.finalize_app_config(app)\n   619\u2192                    delattr(app, \"__draft__\")\n   620\u2192        else:\n   621\u2192            if hasattr(app, \"__draft__\"):\n   622\u2192                self.finalize_app_config(app)\n   623\u2192                delattr(app, \"__draft__\")\n   624\u2192\n   625\u2192    def verify_app(self, app: AppConfig):\n   626\u2192        \"\"\"Verify the app is compatible and the app tools are available.\n   627\u2192\n   628\u2192        This is the last step of verification for a Command before running the Command's\n   629\u2192        business logic. It runs _after_ pre-requisite Commands have been verified and\n   630\u2192        run.\n   631\u2192\n   632\u2192        :param app: app configuration\n   633\u2192        \"\"\"\n   634\u2192        self.verify_app_template(app)\n   635\u2192        self.verify_app_tools(app)\n   636\u2192        self.verify_required_python(app)\n   637\u2192\n   638\u2192    def verify_app_tools(self, app: AppConfig):\n   639\u2192        \"\"\"Verify that tools needed to run the command for this app exist.\"\"\"\n   640\u2192\n   641\u2192    def verify_app_template(self, app: AppConfig):\n   642\u2192        \"\"\"Verify the template targets the same Briefcase version as the Command.\n   643\u2192\n   644\u2192        :param app: app configuration\n   645\u2192        \"\"\"\n   646\u2192\n   647\u2192        # Skip this check if the template isn't rolled out\n   648\u2192        # or if the command doesn't support templates\n   649\u2192        try:\n   650\u2192            template_target_version = self.template_target_version(app)\n   651\u2192        except (MissingAppMetadata, NotImplementedError):\n   652\u2192            return\n   653\u2192\n   654\u2192        if self.platform_target_version != template_target_version:\n   655\u2192            raise BriefcaseCommandError(\n   656\u2192                f\"\"\"\\\n   657\u2192The app template used to generate this app is not compatible with this version\n   658\u2192of Briefcase.\n   659\u2192\n   660\u2192If the app was generated with an earlier version of Briefcase using the default\n   661\u2192Briefcase template, you can run:\n   662\u2192\n   663\u2192     $ briefcase create {self.platform} {self.output_format}\n   664\u2192\n   665\u2192to re-generate your app with a compatible version of the template.\n   666\u2192\n   667\u2192If you are using a custom template, you'll need to update the template to correct\n   668\u2192any compatibility problems, and then add the compatibility declaration.\n   669\u2192\"\"\"\n   670\u2192            )\n   671\u2192\n   672\u2192    def verify_required_python(self, app: AppConfig):\n   673\u2192        \"\"\"Verify that the running version of Python meets the project's specifications.\"\"\"\n   674\u2192\n   675\u2192        requires_python = getattr(self.global_config, \"requires_python\", None)\n   676\u2192        if not requires_python:\n   677\u2192            return\n   678\u2192\n   679\u2192        try:\n   680\u2192            spec = Specifier(requires_python)\n   681\u2192        except InvalidSpecifier as e:\n   682\u2192            raise BriefcaseConfigError(\n   683\u2192                f\"Invalid requires-python in pyproject.toml: {e}\"\n   684\u2192            ) from e\n   685\u2192\n   686\u2192        running_version = platform.python_version()\n   687\u2192\n   688\u2192        if not spec.contains(running_version, prereleases=True):\n   689\u2192            raise UnsupportedPythonVersion(\n   690\u2192                version_specifier=requires_python, running_version=running_version\n   691\u2192            )\n   692\u2192\n   693\u2192    def parse_options(self, extra):\n   694\u2192        \"\"\"Parse the command line arguments for the Command.\n   695\u2192\n   696\u2192        After the initial ArgumentParser runs to choose the Command for the selected\n   697\u2192        platform and format, a new ArgumentParser is created here to parse the remaining\n   698\u2192        command line arguments specific to the Command. Additionally, the default\n   699\u2192        options for disabling input, log verbosity, and log saving are parsed out and\n   700\u2192        saved to the Command.\n   701\u2192\n   702\u2192        :param extra: the remaining command line arguments after the initial\n   703\u2192            ArgumentParser runs over the command line.\n   704\u2192        :return: dictionary of parsed arguments for Command, and a dictionary of parsed\n   705\u2192            configuration overrides.\n   706\u2192        \"\"\"\n   707\u2192        default_format = getattr(\n   708\u2192            get_platforms().get(self.platform), \"DEFAULT_OUTPUT_FORMAT\", None\n   709\u2192        )\n   710\u2192        # only show supported formats for Commands that support formats\n   711\u2192        if default_format is not None and self.command not in {\"new\", \"dev\", \"upgrade\"}:\n   712\u2192            formats = list(get_output_formats(self.platform).keys())\n   713\u2192            formats[formats.index(default_format)] = f\"{default_format} (default)\"\n   714\u2192            supported_formats_helptext = (\n   715\u2192                f\"Supported formats:\\n  {', '.join(sorted(formats, key=str.lower))}\"\n   716\u2192            )\n   717\u2192        else:\n   718\u2192            supported_formats_helptext = \"\"\n   719\u2192\n   720\u2192        parser = argparse.ArgumentParser(\n   721\u2192            prog=self.cmd_line.format(\n   722\u2192                command=self.command,\n   723\u2192                platform=self.platform,\n   724\u2192                output_format=self.output_format,\n   725\u2192            ),\n   726\u2192            description=self.console.textwrap(\n   727\u2192                f\"{self.description}\\n\\n{supported_formats_helptext}\"\n   728\u2192            ),\n   729\u2192            formatter_class=(\n   730\u2192                lambda prog: RawDescriptionHelpFormatter(prog, width=MAX_TEXT_WIDTH)\n   731\u2192            ),\n   732\u2192        )\n   733\u2192\n   734\u2192        self.add_default_options(parser)\n   735\u2192        self.add_options(parser)\n   736\u2192\n   737\u2192        # If the command allows passthrough arguments, add an option for the help,\n   738\u2192        # then process the argument list to strip out the passthrough args.\n   739\u2192        if self.allows_passthrough:\n   740\u2192            parser.add_argument(\n   741\u2192                \"--\",\n   742\u2192                dest=\"passthrough\",\n   743\u2192                metavar=\"ARGS ...\",\n   744\u2192                required=False,\n   745\u2192                help=\"Arguments to pass to the app\",\n   746\u2192            )\n   747\u2192            args, passthrough = split_passthrough(extra)\n   748\u2192        else:\n   749\u2192            args = extra\n   750\u2192\n   751\u2192        # Parse the full set of command line options from the content\n   752\u2192        # remaining after the basic command/platform/output format\n   753\u2192        # has been extracted.\n   754\u2192        options = vars(parser.parse_args(args))\n   755\u2192\n   756\u2192        if self.allows_passthrough:\n   757\u2192            options[\"passthrough\"] = passthrough\n   758\u2192\n   759\u2192        # Extract the base default options onto the command\n   760\u2192        self.console.input_enabled = options.pop(\"input_enabled\")\n   761\u2192        self.console.verbosity = options.pop(\"verbosity\")\n   762\u2192        self.console.save_log = options.pop(\"save_log\")\n   763\u2192\n   764\u2192        # Parse the configuration overrides\n   765\u2192        overrides = parse_config_overrides(options.pop(\"config_overrides\"))\n   766\u2192\n   767\u2192        return options, overrides\n   768\u2192\n   769\u2192    def clone_options(self, command):\n   770\u2192        \"\"\"Clone options from one command to this one.\n   771\u2192\n   772\u2192        :param command: The command whose options are to be cloned\n   773\u2192        \"\"\"\n   774\u2192\n   775\u2192    def add_default_options(self, parser):\n   776\u2192        \"\"\"Add the default options that exist on *all* commands.\n   777\u2192\n   778\u2192        :param parser: a stub argparse parser for the command.\n   779\u2192        \"\"\"\n   780\u2192        parser.add_argument(\n   781\u2192            \"-C\",\n   782\u2192            \"--config\",\n   783\u2192            dest=\"config_overrides\",\n   784\u2192            action=\"append\",\n   785\u2192            metavar=\"KEY=VALUE\",\n   786\u2192            help=\"Override the value of the app configuration item KEY with VALUE\",\n   787\u2192        )\n   788\u2192        parser.add_argument(\n   789\u2192            \"-v\",\n   790\u2192            \"--verbosity\",\n   791\u2192            action=\"count\",\n   792\u2192            default=0,\n   793\u2192            help=\"Enable verbose logging. Use -vv and -vvv to increase logging verbosity\",\n   794\u2192        )\n   795\u2192        parser.add_argument(\"-V\", \"--version\", action=\"version\", version=__version__)\n   796\u2192        parser.add_argument(\n   797\u2192            \"--no-input\",\n   798\u2192            action=\"store_false\",\n   799\u2192            default=True,\n   800\u2192            dest=\"input_enabled\",\n   801\u2192            help=(\n   802\u2192                \"Don't ask for user input. If any action would be destructive, \"\n   803\u2192                \"an error will be raised; otherwise, default answers will be \"\n   804\u2192                \"assumed\"\n   805\u2192            ),\n   806\u2192        )\n   807\u2192        parser.add_argument(\n   808\u2192            \"--log\",\n   809\u2192            action=\"store_true\",\n   810\u2192            dest=\"save_log\",\n   811\u2192            help=\"Save a detailed log to file. By default, this log file is only created for critical errors\",\n   812\u2192        )\n   813\u2192\n   814\u2192    def _add_update_options(\n   815\u2192        self,\n   816\u2192        parser,\n   817\u2192        context_label=\"\",\n   818\u2192        update=True,\n   819\u2192    ):\n   820\u2192        \"\"\"Internal utility method for adding common update options.\n   821\u2192\n   822\u2192        :param parser: The parser to which options should be added.\n   823\u2192        :param context_label: Label text that will be added to the end of the help text\n   824\u2192            to describe when the update will be applied (e.g., \"before building\")\n   825\u2192        :param update: Should the --update and --no-update options be exposed?\n   826\u2192        \"\"\"\n   827\u2192        if update:\n   828\u2192            parser.add_argument(\n   829\u2192                \"-u\",\n   830\u2192                \"--update\",\n   831\u2192                action=\"store_true\",\n   832\u2192                help=f\"Update the app{context_label}\",\n   833\u2192            )\n   834\u2192\n   835\u2192        parser.add_argument(\n   836\u2192            \"-r\",\n   837\u2192            \"--update-requirements\",\n   838\u2192            action=\"store_true\",\n   839\u2192            help=f\"Update requirements for the app{context_label}\",\n   840\u2192        )\n   841\u2192\n   842\u2192        parser.add_argument(\n   843\u2192            \"--update-support\",\n   844\u2192            action=\"store_true\",\n   845\u2192            help=f\"Update support package for the app{context_label}\",\n   846\u2192        )\n   847\u2192\n   848\u2192        parser.add_argument(\n   849\u2192            \"--update-stub\",\n   850\u2192            action=\"store_true\",\n   851\u2192            help=f\"Update stub binary for the app{context_label}\",\n   852\u2192        )\n   853\u2192\n   854\u2192        parser.add_argument(\n   855\u2192            \"--update-resources\",\n   856\u2192            action=\"store_true\",\n   857\u2192            help=f\"Update app resources (icons, splash screens, etc){context_label}\",\n   858\u2192        )\n   859\u2192\n   860\u2192        if update:\n   861\u2192            parser.add_argument(\n   862\u2192                \"--no-update\",\n   863\u2192                action=\"store_true\",\n   864\u2192                help=f\"Prevent any automated update{context_label}\",\n   865\u2192            )\n   866\u2192\n   867\u2192    def _add_test_options(self, parser, context_label):\n   868\u2192        \"\"\"Internal utility method for adding common test-related options.\n   869\u2192\n   870\u2192        :param parser: The parser to which options should be added.\n   871\u2192        :param context_label: Label text for commands; the capitalized action being\n   872\u2192            performed (e.g., \"Build\", \"Run\",...)\n   873\u2192        \"\"\"\n   874\u2192        parser.add_argument(\n   875\u2192            \"--test\",\n   876\u2192            dest=\"test_mode\",\n   877\u2192            action=\"store_true\",\n   878\u2192            help=f\"{context_label} the app in test mode\",\n   879\u2192        )\n   880\u2192\n   881\u2192    def add_options(self, parser):\n   882\u2192        \"\"\"Add any options that this command needs to parse from the command line.\n   883\u2192\n   884\u2192        :param parser: a stub argparse parser for the command.\n   885\u2192        \"\"\"\n   886\u2192\n   887\u2192    def parse_config(self, filename, overrides):\n   888\u2192        try:\n   889\u2192            with open(filename, \"rb\") as config_file:\n   890\u2192                # Parse the content of the pyproject.toml file, extracting\n   891\u2192                # any platform and output format configuration for each app,\n   892\u2192                # creating a single set of configuration options.\n   893\u2192                global_config, app_configs = parse_config(\n   894\u2192                    config_file,\n   895\u2192                    platform=self.platform,\n   896\u2192                    output_format=self.output_format,\n   897\u2192                    console=self.console,\n   898\u2192                )\n   899\u2192\n   900\u2192                # Create the global config\n   901\u2192                global_config.update(overrides)\n   902\u2192                self.global_config = create_config(\n   903\u2192                    klass=GlobalConfig,\n   904\u2192                    config=global_config,\n   905\u2192                    msg=\"Global configuration\",\n   906\u2192                )\n   907\u2192\n   908\u2192                for app_name, app_config in app_configs.items():\n   909\u2192                    # Construct an AppConfig object with the final set of\n   910\u2192                    # configuration options for the app.\n   911\u2192                    app_config.update(overrides)\n   912\u2192                    self.apps[app_name] = create_config(\n   913\u2192                        klass=AppConfig,\n   914\u2192                        config=app_config,\n   915\u2192                        msg=f\"Configuration for '{app_name}'\",\n   916\u2192                    )\n   917\u2192\n   918\u2192        except OSError as e:\n   919\u2192            raise BriefcaseConfigError(\n   920\u2192                f\"\"\"\\\n   921\u2192Configuration file not found.\n   922\u2192\n   923\u2192Did you run Briefcase in a project directory that contains {filename.name!r}?\"\"\"\n   924\u2192            ) from e\n   925\u2192\n   926\u2192    def update_cookiecutter_cache(self, template: str, branch=\"master\"):\n   927\u2192        \"\"\"Ensure that we have a current checkout of a template path.\n   928\u2192\n   929\u2192        If the path is a local path, use the path as is.\n   930\u2192\n   931\u2192        If the path is a URL, look for a local cache; if one exists, update it,\n   932\u2192        including checking out the required branch.\n   933\u2192\n   934\u2192        :param template: The template URL or path.\n   935\u2192        :param branch: The template branch to use. Default: ``master``\n   936\u2192        :return: The path to the cached template. This may be the originally\n   937\u2192            provided path if the template was a file path.\n   938\u2192        \"\"\"\n   939\u2192        if is_repo_url(template):\n   940\u2192            # The app template is a repository URL.\n   941\u2192            #\n   942\u2192            # Look for a Briefcase cache of the template.\n   943\u2192            cached_template = self.template_cache_path(template)\n   944\u2192\n   945\u2192            if cached_template.exists():\n   946\u2192                # There is a pre-existing cache of the template. Attempt to update it;\n   947\u2192                # if the fetch fails, use the existing state of the cache. Any other\n   948\u2192                # failure is surfaced to the user.\n   949\u2192                try:\n   950\u2192                    repo = self.tools.git.Repo(cached_template)\n   951\u2192                except self.tools.git.exc.GitError:\n   952\u2192                    # Template repository is in a weird state. Delete it\n   953\u2192                    self.console.warning(\n   954\u2192                        \"Template cache is in a weird state. Getting a clean clone.\"\n   955\u2192                    )\n   956\u2192                    self.tools.shutil.rmtree(cached_template)\n   957\u2192\n   958\u2192            if not cached_template.exists():\n   959\u2192                # There's no pre-existing template. It's either the first time seeing\n   960\u2192                # the template, or the template was in a weird state. Perform a blobless\n   961\u2192                # clone.\n   962\u2192                try:\n   963\u2192                    self.console.info(f\"Cloning template {template!r}...\")\n   964\u2192                    cached_template.mkdir(exist_ok=True, parents=True)\n   965\u2192                    repo = self.tools.git.Repo.clone_from(\n   966\u2192                        url=template,\n   967\u2192                        to_path=cached_template,\n   968\u2192                        filter=[\"blob:none\"],\n   969\u2192                        no_checkout=True,\n   970\u2192                    )\n   971\u2192                except KeyboardInterrupt:\n   972\u2192                    # The user has aborted the initial clone. Git is fairly resilient to\n   973\u2192                    # being interrupted, but if the *initial* clone fails, it's very\n   974\u2192                    # hard to recover. To avoid problems on the next run, remove the\n   975\u2192                    # partial repo clone.\n   976\u2192                    if cached_template.exists():\n   977\u2192                        self.tools.shutil.rmtree(cached_template)\n   978\u2192                    raise\n   979\u2192                except self.tools.git.exc.GitError as e:\n   980\u2192                    # The clone failed; to make sure the repo is in a clean state, clean up\n   981\u2192                    # any partial remnants of this initial clone.\n   982\u2192                    # If we're getting a GitError, we know the directory must exist.\n   983\u2192                    self.tools.shutil.rmtree(cached_template)\n   984\u2192                    git_fatal_message = re.findall(r\"(?<=fatal: ).*?$\", e.stderr, re.S)\n   985\u2192                    if git_fatal_message:\n   986\u2192                        # GitError captures stderr with single quotes. Because the regex above\n   987\u2192                        # takes everything after git's \"fatal\" message, we need to strip that final single quote.\n   988\u2192                        hint = git_fatal_message[0].rstrip(\"'\").strip()\n   989\u2192\n   990\u2192                        # git is inconsistent with capitalisation of the first word of the message\n   991\u2192                        # and about periods at the end of the message.\n   992\u2192                        hint = f\"{hint[0].upper()}{hint[1:]}{'' if hint[-1] == '.' else '.'}\"\n   993\u2192                    else:\n   994\u2192                        hint = (\n   995\u2192                            \"This may be because your computer is offline, or \"\n   996\u2192            