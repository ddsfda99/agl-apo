(self) -> str:\n   226\u2192        \"\"\"Read a line of output from the process while blocking.\n   227\u2192\n   228\u2192        Calling readline() for stdout always returns at least a newline, i.e. \"\\n\",\n   229\u2192        UNLESS the process is exiting or already exited; in that case, an empty string\n   230\u2192        is returned.\n   231\u2192\n   232\u2192        :returns: one line of output or \"\" if nothing more can be read from stdout\n   233\u2192        \"\"\"\n   234\u2192        try:\n   235\u2192            return ensure_str(self.popen_process.stdout.readline())\n   236\u2192        except ValueError as e:\n   237\u2192            # Catch ValueError if stdout is unexpectedly closed; this can\n   238\u2192            # happen, for instance, if the user starts spamming CTRL+C.\n   239\u2192            if \"I/O operation on closed file\" in str(e):\n   240\u2192                self.console.warning(\n   241\u2192                    \"WARNING: stdout was unexpectedly closed while streaming output\"\n   242\u2192                )\n   243\u2192                return \"\"\n   244\u2192            else:\n   245\u2192                raise\n   246\u2192\n   247\u2192    def _filter(self, line: str) -> tuple[list[str], bool]:\n   248\u2192        \"\"\"Run filter function over output from process.\"\"\"\n   249\u2192        filtered_output = []\n   250\u2192        stop_streaming = False\n   251\u2192\n   252\u2192        if self.filter_func is not None:\n   253\u2192            try:\n   254\u2192                for filtered_line in self.filter_func(line.strip(\"\\n\")):\n   255\u2192                    filtered_output.append(filtered_line)\n   256\u2192            except StopStreaming:\n   257\u2192                stop_streaming = True\n   258\u2192        else:\n   259\u2192            filtered_output.append(line)\n   260\u2192\n   261\u2192        return filtered_output, stop_streaming\n   262\u2192\n   263\u2192\n   264\u2192class NativeAppContext(Tool):\n   265\u2192    \"\"\"A wrapper around subprocess for use as an app-bound tool.\"\"\"\n   266\u2192\n   267\u2192    name = \"app_context_subprocess\"\n   268\u2192\n   269\u2192    @classmethod\n   270\u2192    def verify_install(cls, tools: ToolCache, app: AppConfig, **kwargs) -> Subprocess:\n   271\u2192        \"\"\"Make subprocess available as app-bound tool.\"\"\"\n   272\u2192        # short circuit since already verified and available\n   273\u2192        if hasattr(tools[app], \"app_context\"):\n   274\u2192            return tools[app].app_context\n   275\u2192\n   276\u2192        tools[app].app_context = tools.subprocess\n   277\u2192        return tools[app].app_context\n   278\u2192\n   279\u2192\n   280\u2192class Subprocess(Tool):\n   281\u2192    \"\"\"A wrapper around subprocess that can be used as a logging point for commands that\n   282\u2192    are executed.\"\"\"\n   283\u2192\n   284\u2192    name = \"subprocess\"\n   285\u2192    full_name = \"Subprocess\"\n   286\u2192\n   287\u2192    def __init__(self, tools: ToolCache):\n   288\u2192        super().__init__(tools=tools)\n   289\u2192        self._subprocess = subprocess\n   290\u2192\n   291\u2192    def prepare(self):\n   292\u2192        \"\"\"Perform any environment preparation required to execute processes.\"\"\"\n   293\u2192        # This is a no-op; the native subprocess environment is ready-to-use.\n   294\u2192        pass\n   295\u2192\n   296\u2192    @contextlib.contextmanager\n   297\u2192    def run_app_context(self, subprocess_kwargs: dict[str, ...]) -> dict[str, ...]:\n   298\u2192        \"\"\"A manager to wrap subprocess calls to run a Briefcase project app.\n   299\u2192\n   300\u2192        :param subprocess_kwargs: initialized keyword arguments for subprocess calls\n   301\u2192        \"\"\"\n   302\u2192        # This is a no-op; the native subprocess environment is ready-to-use.\n   303\u2192        yield subprocess_kwargs\n   304\u2192\n   305\u2192    def full_env(self, overrides: dict[str, str | None] | None) -> dict[str, str]:\n   306\u2192        \"\"\"Generate the full environment in which the command will run.\n   307\u2192\n   308\u2192        If an env var in `overrides` is set to `None`, then that env var\n   309\u2192        will be altogether absent in the returned environment.\n   310\u2192\n   311\u2192        :param overrides: The environment passed to the subprocess call;\n   312\u2192            can be `None` if there are no explicit environment changes.\n   313\u2192        \"\"\"\n   314\u2192        env = self.tools.os.environ.copy()\n   315\u2192        if overrides:\n   316\u2192            env.update(overrides)\n   317\u2192            env = {k: v for k, v in env.items() if v is not None}\n   318\u2192        return env\n   319\u2192\n   320\u2192    def final_kwargs(self, **kwargs) -> dict[str, str]:\n   321\u2192        \"\"\"Convert subprocess keyword arguments into their final form.\n   322\u2192\n   323\u2192        This involves:\n   324\u2192         * Converting any environment overrides into a full environment\n   325\u2192         * Converting the `cwd` into a string\n   326\u2192         * Default `text` to True so all outputs are strings\n   327\u2192         * Convert start_new_session=True to creationflags on Windows\n   328\u2192        \"\"\"\n   329\u2192        # If `env` has been provided, inject a full copy of the local\n   330\u2192        # environment, with the values in `env` overriding the local\n   331\u2192        # environment.\n   332\u2192        try:\n   333\u2192            overrides = kwargs.pop(\"env\")\n   334\u2192            kwargs[\"env\"] = self.full_env(overrides)\n   335\u2192        except KeyError:\n   336\u2192            # No explicit environment provided.\n   337\u2192            pass\n   338\u2192\n   339\u2192        # If `cwd` has been provided, ensure it is in string form.\n   340\u2192        try:\n   341\u2192            cwd = kwargs.pop(\"cwd\")\n   342\u2192            kwargs[\"cwd\"] = str(cwd)\n   343\u2192        except KeyError:\n   344\u2192            pass\n   345\u2192\n   346\u2192        # Default to running subprocess in \"text\" mode so all output is returned as\n   347\u2192        # strings instead of bytes. The legacy setting of `universal_newlines` is\n   348\u2192        # converted to `text` for calling subprocess.\n   349\u2192        kwargs[\"text\"] = kwargs.pop(\"universal_newlines\", kwargs.get(\"text\", True))\n   350\u2192\n   351\u2192        # Enable text mode if an `encoding` or `errors` is specified; this aligns with\n   352\u2192        # the default behavior of subprocess.\n   353\u2192        kwargs[\"text\"] |= any(kwargs.get(kw) for kw in [\"encoding\", \"errors\"])\n   354\u2192\n   355\u2192        # Configure subprocess for text mode\n   356\u2192        if kwargs[\"text\"]:\n   357\u2192            # Ensure an appropriate encoding is specified.\n   358\u2192            # If an encoding isn't provided, default to the encoding that Python is\n   359\u2192            # using for stdout. This is for the benefit of Windows which uses cp437 for\n   360\u2192            # console output when the system encoding is cp1252.\n   361\u2192            # `sys.__stdout__` is used because Rich captures and redirects `sys.stdout`.\n   362\u2192            # The fallback to \"UTF-8\" is needed to catch the case where stdout is\n   363\u2192            # redirected to a non-tty (e.g. during pytest conditions).\n   364\u2192            kwargs.setdefault(\n   365\u2192                \"encoding\", os.device_encoding(sys.__stdout__.fileno()) or \"UTF-8\"\n   366\u2192            )\n   367\u2192\n   368\u2192            # Use relaxed output decoding by default.\n   369\u2192            # subprocess defaults to \"strict\" handling for errors arising from decoding\n   370\u2192            # output to Unicode. To avoid Unicode exceptions from misbehaving commands,\n   371\u2192            # set `errors` so output that cannot be decoded for the specified encoding\n   372\u2192            # are replaced with hex of the raw bytes.\n   373\u2192            kwargs.setdefault(\"errors\", \"backslashreplace\")\n   374\u2192\n   375\u2192        # For Windows, convert start_new_session=True to creation flags\n   376\u2192        if self.tools.host_os == \"Windows\":\n   377\u2192            try:\n   378\u2192                if kwargs.pop(\"start_new_session\") is True:\n   379\u2192                    if \"creationflags\" in kwargs:\n   380\u2192                        raise AssertionError(\n   381\u2192                            \"Subprocess called with creationflags set and \"\n   382\u2192                            \"start_new_session=True.\\nThis will result in \"\n   383\u2192                            \"CREATE_NEW_PROCESS_GROUP and CREATE_NO_WINDOW \"\n   384\u2192                            \"being merged in to the creationflags.\\n\\nEnsure \"\n   385\u2192                            \"this is desired configuration or don't set \"\n   386\u2192                            \"start_new_session=True.\"\n   387\u2192                        )\n   388\u2192                    # CREATE_NEW_PROCESS_GROUP: Promotes the new process to the root\n   389\u2192                    #    process of a new process group. This also disables CTRL+C\n   390\u2192                    #    signal handlers for all processes of the new process group.\n   391\u2192                    # CREATE_NO_WINDOW: Creates a new console for the process but\n   392\u2192                    #    does not open a visible window for that console. This flag\n   393\u2192                    #    is used instead of DETACHED_PROCESS since the new process\n   394\u2192                    #    can spawn a new console itself (in the absence of one being\n   395\u2192                    #    available) but that console creation will also spawn a\n   396\u2192                    #    visible console window.\n   397\u2192                    new_session_flags = (\n   398\u2192                        self._subprocess.CREATE_NEW_PROCESS_GROUP\n   399\u2192                        | self._subprocess.CREATE_NO_WINDOW\n   400\u2192                    )\n   401\u2192                    # merge these flags in to any existing flags already provided\n   402\u2192                    kwargs[\"creationflags\"] = (\n   403\u2192                        kwargs.get(\"creationflags\", 0) | new_session_flags\n   404\u2192                    )\n   405\u2192            except KeyError:\n   406\u2192                pass\n   407\u2192\n   408\u2192        return kwargs\n   409\u2192\n   410\u2192    @classmethod\n   411\u2192    def verify_install(cls, tools: ToolCache, **kwargs) -> Subprocess:\n   412\u2192        \"\"\"Make subprocess available in tool cache.\"\"\"\n   413\u2192        # short circuit since already verified and available\n   414\u2192        if hasattr(tools, \"subprocess\"):\n   415\u2192            return tools.subprocess\n   416\u2192\n   417\u2192        tools.subprocess = Subprocess(tools=tools)\n   418\u2192        return tools.subprocess\n   419\u2192\n   420\u2192    @ensure_console_is_safe\n   421\u2192    def run(\n   422\u2192        self,\n   423\u2192        args: SubprocessArgsT,\n   424\u2192        stream_output: bool = True,\n   425\u2192        filter_func: Callable[[str], Iterator[str]] | None = None,\n   426\u2192        **kwargs,\n   427\u2192    ) -> CompletedProcess:\n   428\u2192        \"\"\"A wrapper for subprocess.run().\n   429\u2192\n   430\u2192        This method implements the behavior of subprocess.run() with some notable\n   431\u2192        differences:\n   432\u2192\n   433\u2192          - The command's output is streamed if ``stream_output=True`` or if dynamic\n   434\u2192            console content such as the Wait Bar is active and I/O is not redirected.\n   435\u2192          - If dynamic content is not active, ``stream_output=False`` will disable\n   436\u2192            streaming.\n   437\u2192          - If the ``env`` argument is provided, the current system environment will be\n   438\u2192            copied, and the contents of env overwritten into that environment.\n   439\u2192          - The ``text`` argument is defaulted to True so all output is returned as\n   440\u2192            strings instead of bytes.\n   441\u2192\n   442\u2192        Output Streaming Primer\n   443\u2192        ~~~~~~~~~~~~~~~~~~~~~~~\n   444\u2192\n   445\u2192        What is output streaming?\n   446\u2192        -------------------------\n   447\u2192\n   448\u2192        When a command is invoked via ``subprocess.run()``, by default, its stdout and\n   449\u2192        stderr are connected directly to the console and the output is presented to the\n   450\u2192        user as though the command was invoked natively. When output streaming is\n   451\u2192        active, Briefcase reads the command's output and prints it in to the console on\n   452\u2192        behalf of the command.\n   453\u2192\n   454\u2192        Why is output streaming necessary?\n   455\u2192        ----------------------------------\n   456\u2192\n   457\u2192        Allowing commands to print directly to the console can provide superior UX since\n   458\u2192        it allows tools to provide their native experience to users.\n   459\u2192\n   460\u2192        However, a primary mechanism for providing support for Briefcase is asking users\n   461\u2192        to provide the log file when errors occur. Often, these errors are raised by\n   462\u2192        invoked commands; streaming the output of commands allows Briefcase to capture\n   463\u2192        that output and include it in the log file as well as the console.\n   464\u2192\n   465\u2192        Additionally, the content of the console can become corrupted if other processes\n   466\u2192        print to the console while Rich's dynamic console elements such as a Progress\n   467\u2192        Bar are active. Streaming such output allows Rich to maintain integrity of all\n   468\u2192        the console content.\n   469\u2192\n   470\u2192        How does output streaming work?\n   471\u2192        -------------------------------\n   472\u2192\n   473\u2192        Streaming is activated when:\n   474\u2192\n   475\u2192          1. dynamic content such as the Wait Bar is active and I/O is not redirected\n   476\u2192\n   477\u2192          2. the ``stream_output`` argument is ``True`` (as it is by default)\n   478\u2192\n   479\u2192        I/O is considered redirected when both ``stdout`` and ``stderr`` are specified\n   480\u2192        (e.g., when ``stdout`` and ``stderr`` are set to``subprocess.PIPE`` so the\n   481\u2192        output is available to the caller).\n   482\u2192\n   483\u2192        To facilitate streaming the output, ``stdout`` is set to ``subprocess.PIPE``. If\n   484\u2192        ``stderr`` is not specified by calling code, then it is set to\n   485\u2192        ``subprocess.STDOUT`` so it is interlaced with stdout output.\n   486\u2192\n   487\u2192        The process is created for the command with ``Popen``, and a separate thread is\n   488\u2192        started for continuously reading and printing the stdout to the console from the\n   489\u2192        command process. It is necessary to read from stdout in a thread because the\n   490\u2192        read is uninterruptible; so, a user may not be able to abort with CTRL-C.\n   491\u2192\n   492\u2192        When the process ends (or the user sends CTRL-C), a call is made to ensure the\n   493\u2192        command process terminates; this, in turn, ensures the thread for streaming can\n   494\u2192        properly exit its otherwise infinite loop. The calling code is either returned a\n   495\u2192        ``CompletedProcess`` object or ``CalledProcessError`` could be raised.\n   496\u2192\n   497\u2192        Output streaming ultimately strives to simulate calling ``subprocess.run()``\n   498\u2192        while proxying the command's output to the console.\n   499\u2192\n   500\u2192        When *not* to use output streaming?\n   501\u2192        -----------------------------------\n   502\u2192\n   503\u2192        When streaming is disabled, the command's output **WILL NOT** be included the\n   504\u2192        Briefcase log file. This makes troubleshooting difficult and should be avoided.\n   505\u2192        However, there are some situations where disabling streaming is unavoidable.\n   506\u2192\n   507\u2192        Some commands use their own dynamic console content such as progress bars,\n   508\u2192        spinners, and other animations. When such output is streamed, its quality can be\n   509\u2192        significantly compromised and look terrible in the console for users. If it is\n   510\u2192        not possible to disable such output with e.g. a flag for the command, then\n   511\u2192        disabling streaming may be necessary. As an example, the ``flatpak install``\n   512\u2192        command uses many animations.\n   513\u2192\n   514\u2192        If a command requires user input, do not use output streaming. The output\n   515\u2192        streaming implementation doesn't provide any facilities to send input to the\n   516\u2192        process and doesn't provide any special handling of stdin. Additionally, when\n   517\u2192        the command process prompts the user for input, that doesn't always trigger\n   518\u2192        ``readline()`` to return; so, the console may actually end up waiting for user\n   519\u2192        input before displaying a prompt to the user. As an example, accepting Android\n   520\u2192        SDK licenses requires user input.\n   521\u2192\n   522\u2192        :param args: args for ``subprocess.run()``\n   523\u2192        :param stream_output: simulate ``run()`` while streaming the output to the\n   524\u2192            console. Set to False if the command requires user interaction.\n   525\u2192        :param filter_func: If output streaming is enabled, a callable that will be\n   526\u2192            invoked on every line of output that is streamed. The function accepts the\n   527\u2192            \"raw\" line of input (stripped of any trailing newline); it returns a\n   528\u2192            generator that yields the filtered output that should be displayed to the\n   529\u2192            user. Can raise StopStreaming to terminate the output stream.\n   530\u2192        :param kwargs: keyword args for ``subprocess.run()``\n   531\u2192        :raises ValueError: if a filter function is provided when in non-streaming mode.\n   532\u2192        :returns: ``CompletedProcess`` for invoked process\n   533\u2192        \"\"\"\n   534\u2192\n   535\u2192        # Stream the output unless the caller explicitly disables it. When a\n   536\u2192        # caller sets stream_output=False, then ensure_console_is_safe() will\n   537\u2192        # disable any dynamic console elements while the command runs.\n   538\u2192        if stream_output:\n   539\u2192            return self._run_and_stream_output(args, filter_func=filter_func, **kwargs)\n   540\u2192\n   541\u2192        # Can't filter non-streamed output.\n   542\u2192        if filter_func:\n   543\u2192            raise ValueError(\"Cannot apply a filter to non-streamed output.\")\n   544\u2192\n   545\u2192        # Otherwise, invoke run() normally.\n   546\u2192        self._log_command(args)\n   547\u2192        self._log_cwd(kwargs.get(\"cwd\"))\n   548\u2192        self._log_environment(kwargs.get(\"env\"))\n   549\u2192\n   550\u2192        try:\n   551\u2192            command_result = self._subprocess.run(\n   552\u2192                [str(arg) for arg in args], **self.final_kwargs(**kwargs)\n   553\u2192            )\n   554\u2192        except subprocess.CalledProcessError as e:\n   555\u2192            self._log_return_code(e.returncode)\n   556\u2192            raise\n   557\u2192        self._log_return_code(command_result.returncode)\n   558\u2192\n   559\u2192        return command_result\n   560\u2192\n   561\u2192    def _run_and_stream_output(\n   562\u2192        self,\n   563\u2192        args: SubprocessArgsT,\n   564\u2192        check: bool = False,\n   565\u2192        filter_func: Callable[[str], Iterator[str]] | None = None,\n   566\u2192        **kwargs,\n   567\u2192    ) -> CompletedProcess:\n   568\u2192        \"\"\"Simulate subprocess.run() while streaming output to the console.\n   569\u2192\n   570\u2192        This is useful when dynamic screen content is active or output should\n   571\u2192        be captured for logging.\n   572\u2192\n   573\u2192        When dynamic screen content like a Wait Bar is active, output can\n   574\u2192        only be printed to the screen via Console to avoid interfering\n   575\u2192        with and likely corrupting the updates to the dynamic screen elements.\n   576\u2192\n   577\u2192        stdout will always be piped so it can be printed to the screen;\n   578\u2192        however, stderr can be piped by the caller so it is available\n   579\u2192        to the caller in the return value...as with subprocess.run().\n   580\u2192\n   581\u2192        Note: the 'timeout' and 'input' arguments are not supported.\n   582\u2192        \"\"\"\n   583\u2192        if kwargs.get(\"stdout\") and not kwargs.get(\"stderr\"):\n   584\u2192            # This is an unsupported configuration, as it's not clear where stderr\n   585\u2192            # output would be displayed. Either:\n   586\u2192            # * Redirect stderr in addition to stdout; or\n   587\u2192            # * Use check_output() instead of run() to capture console output\n   588\u2192            #   without streaming.\n   589\u2192            raise AssertionError(\n   590\u2192                \"Subprocess.run() was invoked while dynamic Rich content is active (or via \"\n   591\u2192                \"`stream_output`) with stdout redirected while stderr was not redirected.\"\n   592\u2192            )\n   593\u2192        for arg in [arg for arg in [\"timeout\", \"input\"] if arg in kwargs]:\n   594\u2192            raise AssertionError(\n   595\u2192                f\"The Subprocess.run() '{arg}' argument is not supported \"\n   596\u2192                f\"with `stream_output` or while dynamic Rich content is active.\"\n   597\u2192            )\n   598\u2192\n   599\u2192        # stdout must be piped so the output streamer can print it.\n   600\u2192        kwargs[\"stdout\"] = subprocess.PIPE\n   601\u2192        # if stderr isn't explicitly redirected, then send it to stdout.\n   602\u2192        kwargs.setdefault(\"stderr\", subprocess.STDOUT)\n   603\u2192        # use line-buffered output by default\n   604\u2192        kwargs.setdefault(\"bufsize\", 1)\n   605\u2192\n   606\u2192        stderr = None\n   607\u2192        with self.Popen(args, **kwargs) as process:\n   608\u2192            self.stream_output(args[0], process, filter_func=filter_func)\n   609\u2192            if process.stderr and kwargs[\"stderr\"] != subprocess.STDOUT:\n   610\u2192                stderr = process.stderr.read()\n   611\u2192        return_code = process.poll()\n   612\u2192        self._log_return_code(return_code)\n   613\u2192\n   614\u2192        if check and return_code:\n   615\u2192            raise subprocess.CalledProcessError(return_code, args, stderr=stderr)\n   616\u2192\n   617\u2192        return subprocess.CompletedProcess(args, return_code, stderr=stderr)\n   618\u2192\n   619\u2192    @ensure_console_is_safe\n   620\u2192    def check_output(self, args: SubprocessArgsT, quiet: bool = False, **kwargs) -> str:\n   621\u2192        \"\"\"A wrapper for subprocess.check_output()\n   622\u2192\n   623\u2192        The behavior of this method is identical to\n   624\u2192        subprocess.check_output(), except for:\n   625\u2192         - If the `env` is argument provided, the current system environment\n   626\u2192           will be copied, and the contents of env overwritten into that\n   627\u2192           environment.\n   628\u2192         - The `text` argument is defaulted to True so all output\n   629\u2192           is returned as strings instead of bytes.\n   630\u2192         - The `stderr` argument is defaulted to `stdout` so _all_ output is\n   631\u2192           returned and `stderr` isn't unexpectedly printed to the console.\n   632\u2192\n   633\u2192        :param args: commands and its arguments to run via subprocess\n   634\u2192        :param quiet: Should the invocation of this command be silent, and\n   635\u2192            *not* appear in the logs? This should almost always be False;\n   636\u2192            however, for some calls (most notably, calls that are called\n   637\u2192            frequently to evaluate the status of another process), logging can\n   638\u2192            be turned off so that log output isn't corrupted by thousands of\n   639\u2192            polling calls.\n   640\u2192        \"\"\"\n   641\u2192        # if stderr isn't explicitly redirected, then send it to stdout.\n   642\u2192        kwargs.setdefault(\"stderr\", subprocess.STDOUT)\n   643\u2192\n   644\u2192        if not quiet:\n   645\u2192            self._log_command(args)\n   646\u2192            self._log_cwd(kwargs.get(\"cwd\"))\n   647\u2192            self._log_environment(kwargs.get(\"env\"))\n   648\u2192\n   649\u2192        try:\n   650\u2192            cmd_output = self._subprocess.check_output(\n   651\u2192                [str(arg) for arg in args], **self.final_kwargs(**kwargs)\n   652\u2192            )\n   653\u2192        except subprocess.CalledProcessError as e:\n   654\u2192            if not quiet:\n   655\u2192                self._log_output(e.output, e.stderr)\n   656\u2192                self._log_return_code(e.returncode)\n   657\u2192            raise\n   658\u2192\n   659\u2192        if not quiet:\n   660\u2192            self._log_output(cmd_output)\n   661\u2192            self._log_return_code(0)\n   662\u2192        return cmd_output\n   663\u2192\n   664\u2192    def parse_output(\n   665\u2192        self,\n   666\u2192        output_parser: Callable[[str], ParserOutputT],\n   667\u2192        args: SubprocessArgsT,\n   668\u2192        **kwargs,\n   669\u2192    ) -> ParserOutputT:\n   670\u2192        \"\"\"A wrapper for check_output() where the command output is processed through\n   671\u2192        the supplied parser function.\n   672\u2192\n   673\u2192        If the parser fails, CommandOutputParseError is raised. The parsing function\n   674\u2192        should take one string argument and should raise ParseError for failure modes.\n   675\u2192\n   676\u2192        :param output_parser: a function that takes str input and returns parsed\n   677\u2192            content, or raises ParseError in the case of a parsing problem.\n   678\u2192        :param args: The arguments to pass to the subprocess\n   679\u2192        :param kwargs: The keyword arguments to pass to the subprocess\n   680\u2192        :returns: Parsed data read from the subprocess output; the exact structure of\n   681\u2192            that data is dependent on the output parser used.\n   682\u2192        \"\"\"\n   683\u2192        cmd_output = self.check_output(args, **kwargs)\n   684\u2192\n   685\u2192        try:\n   686\u2192            return output_parser(cmd_output)\n   687\u2192        except ParseError as e:\n   688\u2192            error_reason = (\n   689\u2192                str(e)\n   690\u2192                or f\"Failed to parse command output using '{output_parser.__name__}'\"\n   691\u2192            )\n   692\u2192            self.tools.console.error()\n   693\u2192            self.tools.console.error(\"Command Output Parsing Error:\")\n   694\u2192            self.tools.console.error(f\"    {error_reason}\")\n   695\u2192            self.tools.console.error(\"Command:\")\n   696\u2192            self.tools.console.error(\n   697\u2192                f\"    {' '.join(shlex.quote(str(arg)) for arg in args)}\"\n   698\u2192            )\n   699\u2192            self.tools.console.error(\"Command Output:\")\n   700\u2192            for line in ensure_str(cmd_output).splitlines():\n   701\u2192                self.tools.console.error(f\"    {line}\")\n   702\u2192            raise CommandOutputParseError(error_reason) from e\n   703\u2192\n   704\u2192    def Popen(self, args: SubprocessArgsT, **kwargs) -> subprocess.Popen:\n   705\u2192        \"\"\"A wrapper for subprocess.Popen()\n   706\u2192\n   707\u2192        The behavior of this method is identical to\n   708\u2192        subprocess.check_output(), except for:\n   709\u2192         - If the `env` argument is provided, the current system environment\n   710\u2192           will be copied, and the contents of env overwritten into that\n   711\u2192           environment.\n   712\u2192         - The `text` argument is defaulted to True so all output\n   713\u2192           is returned as strings instead of bytes.\n   714\u2192        \"\"\"\n   715\u2192        self._log_command(args)\n   716\u2192        self._log_cwd(kwargs.get(\"cwd\"))\n   717\u2192        self._log_environment(kwargs.get(\"env\"))\n   718\u2192\n   719\u2192        return self._subprocess.Popen(\n   720\u2192            [str(arg) for arg in args], **self.final_kwargs(**kwargs)\n   721\u2192        )\n   722\u2192\n   723\u2192    def stream_output(\n   724\u2192        self,\n   725\u2192        label: str,\n   726\u2192        popen_process: subprocess.Popen,\n   727\u2192        stop_func: Callable[[], bool] = lambda: False,\n   728\u2192        filter_func: Callable[[str], Iterator[str]] | None = None,\n   729\u2192    ):\n   730\u2192        \"\"\"Stream the output of a Popen process until the process exits. If the user\n   731\u2192        sends CTRL+C, the process will be terminated.\n   732\u2192\n   733\u2192        This is useful for starting a process via Popen such as tailing a log file, then\n   734\u2192        initiating a non-blocking process that populates that log, and finally streaming\n   735\u2192        the original process's output here.\n   736\u2192\n   737\u2192        :param label: A description of the content being streamed; used for to provide\n   738\u2192            context in logging messages.\n   739\u2192        :param popen_process: a running Popen process with output to print\n   740\u2192        :param stop_func: A Callable that returns True when output streaming should stop\n   741\u2192            and the popen_process should be terminated.\n   742\u2192        :param filter_func: A callable that will be invoked on every line of output that\n   743\u2192            is streamed. The function accepts the \"raw\" line of input (stripped of any\n   744\u2192            trailing newline); it returns a generator that yields the filtered output\n   745\u2192            that should be displayed to the user. Can raise StopStreaming to terminate\n   746\u2192            the output stream.\n   747\u2192        \"\"\"\n   748\u2192        output_streamer = PopenOutputStreamer(\n   749\u2192            label=label,\n   750\u2192            popen_process=popen_process,\n   751\u2192            console=self.tools.console,\n   752\u2192            filter_func=filter_func,\n   753\u2192        )\n   754\u2192        try:\n   755\u2192            output_streamer.start()\n   756\u2192            # joining the thread is avoided due to demonstrated\n   757\u2192            # instability of thread interruption via CTRL+C (#809)\n   758\u2192            while not stop_func() and output_streamer.is_alive():\n   759\u2192                time.sleep(0.1)\n   760\u2192        except KeyboardInterrupt:\n   761\u2192            self.tools.console.info(\"Stopping...\")\n   762\u2192            # allow time for CTRL+C to propagate to the