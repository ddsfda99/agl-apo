                        "content": "     1\u2192from __future__ import annotations\n     2\u2192\n     3\u2192import contextlib\n     4\u2192import json\n     5\u2192import operator\n     6\u2192import os\n     7\u2192import queue\n     8\u2192import shlex\n     9\u2192import subprocess\n    10\u2192import sys\n    11\u2192import threading\n    12\u2192import time\n    13\u2192from collections.abc import Callable, Iterator, Mapping, Sequence\n    14\u2192from functools import wraps\n    15\u2192from pathlib import Path\n    16\u2192from subprocess import CompletedProcess\n    17\u2192from typing import TypeVar, Union\n    18\u2192\n    19\u2192import psutil\n    20\u2192\n    21\u2192from briefcase.config import AppConfig\n    22\u2192from briefcase.console import Console\n    23\u2192from briefcase.exceptions import CommandOutputParseError, ParseError\n    24\u2192from briefcase.integrations.base import Tool, ToolCache\n    25\u2192\n    26\u2192SubprocessArgT = Union[str, Path]\n    27\u2192SubprocessArgsT = Sequence[SubprocessArgT]\n    28\u2192JsonT = Union[Mapping[str, \"JsonT\"], Sequence[\"JsonT\"], str, int, float, bool, None]\n    29\u2192ParserOutputT = TypeVar(\"ParserOutputT\")\n    30\u2192\n    31\u2192\n    32\u2192class StopStreaming(Exception):\n    33\u2192    \"\"\"Raised by streaming filters to terminate the stream.\"\"\"\n    34\u2192\n    35\u2192\n    36\u2192def ensure_str(text: str | bytes) -> str:\n    37\u2192    \"\"\"Returns input text as a string.\"\"\"\n    38\u2192    return text.decode() if isinstance(text, bytes) else str(text)\n    39\u2192\n    40\u2192\n    41\u2192def json_parser(json_output: str) -> JsonT:\n    42\u2192    \"\"\"Wrapper to parse command output as JSON via parse_output.\n    43\u2192\n    44\u2192    :param json_output: command output to parse as JSON\n    45\u2192    \"\"\"\n    46\u2192    try:\n    47\u2192        return json.loads(json_output)\n    48\u2192    except json.JSONDecodeError as e:\n    49\u2192        raise ParseError(f\"Failed to parse output as JSON: {e}\") from e\n    50\u2192\n    51\u2192\n    52\u2192def is_process_dead(pid: int) -> bool:\n    53\u2192    \"\"\"Returns True if a PID is not assigned to a process.\n    54\u2192\n    55\u2192    Checking if a PID exists is only a semi-safe proxy to determine if a process is dead\n    56\u2192    since PIDs can be re-used. Therefore, this function should only be used via constant\n    57\u2192    monitoring of a PID to identify when the process goes from existing to not existing.\n    58\u2192\n    59\u2192    :param pid: integer value to be checked if assigned as a PID.\n    60\u2192    :returns: True if PID does not exist; False otherwise.\n    61\u2192    \"\"\"\n    62\u2192    return not psutil.pid_exists(pid)\n    63\u2192\n    64\u2192\n    65\u2192def get_process_id_by_command(\n    66\u2192    command_list: list[str] | None = None,\n    67\u2192    command: str = \"\",\n    68\u2192    console: Console | None = None,\n    69\u2192) -> int | None:\n    70\u2192    \"\"\"Find a Process ID (PID) a by its command. If multiple processes are found, then\n    71\u2192    the most recently created process ID is returned.\n    72\u2192\n    73\u2192    :param command_list: list of a command's fully qualified path and its arguments.\n    74\u2192    :param command: a partial or complete fully-qualified filepath to a command.\n    75\u2192        This is primarily intended for use on macOS where the `open` command\n    76\u2192        takes a filepath to a directory for an application; therefore, the actual\n    77\u2192        running process will be running a command within that directory.\n    78\u2192    :param console: optional console to show messages about process matching to users\n    79\u2192    :returns: PID if found else None\n    80\u2192    \"\"\"\n    81\u2192    matching_procs = []\n    82\u2192    # retrieve command line, creation time, and ID for all running processes.\n    83\u2192    # note: psutil returns None for a process attribute if it is unavailable;\n    84\u2192    #   this is most likely to happen for restricted or zombie processes.\n    85\u2192    for proc in psutil.process_iter([\"cmdline\", \"create_time\", \"pid\"]):\n    86\u2192        proc_cmdline: list[str] = proc.info[\"cmdline\"]\n    87\u2192        if command_list and proc_cmdline == command_list:\n    88\u2192            matching_procs.append(proc.info)\n    89\u2192        if command and proc_cmdline and proc_cmdline[0].startswith(command):\n    90\u2192            matching_procs.append(proc.info)\n    91\u2192\n    92\u2192    if len(matching_procs) == 1:\n    93\u2192        return matching_procs[0][\"pid\"]\n    94\u2192    elif len(matching_procs) > 1:\n    95\u2192        # return the ID of the most recently created matching process\n    96\u2192        pid = sorted(matching_procs, key=operator.itemgetter(\"create_time\"))[-1][\"pid\"]\n    97\u2192        if console:\n    98\u2192            console.info(\n    99\u2192                f\"Multiple running instances of app found. Using most recently created app process {pid}.\"\n   100\u2192            )\n   101\u2192        return pid\n   102\u2192\n   103\u2192    return None\n   104\u2192\n   105\u2192\n   106\u2192def ensure_console_is_safe(sub_method):\n   107\u2192    \"\"\"Decorator for Subprocess methods to conditionally remove dynamic console elements\n   108\u2192    such as the Wait Bar prior to running the subprocess command.\n   109\u2192\n   110\u2192    :param sub_method: wrapped Subprocess method\n   111\u2192    \"\"\"\n   112\u2192\n   113\u2192    @wraps(sub_method)\n   114\u2192    def inner(sub: Subprocess, args: SubprocessArgsT, *wrapped_args, **wrapped_kwargs):\n   115\u2192        \"\"\"Evaluate whether conditions are met to remove any dynamic elements in the\n   116\u2192        console before returning control to Subprocess.\n   117\u2192\n   118\u2192        :param sub: Bound Subprocess object\n   119\u2192        :param args: command line to run in subprocess\n   120\u2192        :returns: the return value for the Subprocess method\n   121\u2192        \"\"\"\n   122\u2192        # Just run the command if no dynamic elements are active\n   123\u2192        if not sub.tools.console.is_console_controlled:\n   124\u2192            return sub_method(sub, args, *wrapped_args, **wrapped_kwargs)\n   125\u2192\n   126\u2192        remove_dynamic_elements = False\n   127\u2192\n   128\u2192        # Batch (.bat) scripts on Windows.\n   129\u2192        # If cmd.exe is interrupted with CTRL+C while running a bat script,\n   130\u2192        # it may prompt the user to abort the script and dynamic elements\n   131\u2192        # such as the Wait Bar can hide this message from the user.\n   132\u2192        if sub.tools.host_os == \"Windows\":\n   133\u2192            executable = str(args[0]).strip() if args else \"\"\n   134\u2192            remove_dynamic_elements |= executable.lower().endswith(\".bat\")\n   135\u2192\n   136\u2192        # Release control for commands that cannot be streamed.\n   137\u2192        remove_dynamic_elements |= wrapped_kwargs.get(\"stream_output\") is False\n   138\u2192\n   139\u2192        # Run subprocess command with or without console control\n   140\u2192        if remove_dynamic_elements:\n   141\u2192            with sub.tools.console.release_console_control():\n   142\u2192                return sub_method(sub, args, *wrapped_args, **wrapped_kwargs)\n   143\u2192        else:\n   144\u2192            return sub_method(sub, args, *wrapped_args, **wrapped_kwargs)\n   145\u2192\n   146\u2192    return inner\n   147\u2192\n   148\u2192\n   149\u2192class PopenOutputStreamer(threading.Thread):\n   150\u2192    def __init__(\n   151\u2192        self,\n   152\u2192        label: str,\n   153\u2192        popen_process: subprocess.Popen,\n   154\u2192        console: Console,\n   155\u2192        capture_output: bool = False,\n   156\u2192        filter_func: Callable[[str], Iterator[str]] | None = None,\n   157\u2192    ):\n   158\u2192        \"\"\"Thread for streaming stdout for a Popen process.\n   159\u2192\n   160\u2192        :param label: Descriptive name for process being streamed\n   161\u2192        :param popen_process: Popen process with stdout to stream\n   162\u2192        :param console: console for printing to console\n   163\u2192        :param capture_output: Retain process output in ``output_queue`` via a\n   164\u2192            ``queue.Queue`` instead of printing to console\n   165\u2192        :param filter_func: a callable that will be invoked on every line of output\n   166\u2192            that is streamed; see ``Subprocess.stream_output`` for details\n   167\u2192        \"\"\"\n   168\u2192        super().__init__(name=f\"{label} output streamer\", daemon=True)\n   169\u2192\n   170\u2192        self.popen_process = popen_process\n   171\u2192        self.console = console\n   172\u2192        self.capture_output = capture_output\n   173\u2192        self.filter_func = filter_func\n   174\u2192\n   175\u2192        # arbitrarily large maxsize to prevent unbounded memory use if things go south\n   176\u2192        self.output_queue = queue.Queue(maxsize=10_000_000)\n   177\u2192        self.stop_flag = threading.Event()\n   178\u2192\n   179\u2192    def run(self):\n   180\u2192        \"\"\"Stream output for a Popen process.\"\"\"\n   181\u2192        try:\n   182\u2192            while output_line := self._readline():\n   183\u2192                # The stop_flag is intentionally checked both at the top and bottom of\n   184\u2192                # this loop; if the flag was set during the call to readline(), then\n   185\u2192                # processing the output is skipped altogether. And if the flag is set\n   186\u2192                # as a consequence of filter_func(), the streamer still exits before\n   187\u2192                # calling readline() again and