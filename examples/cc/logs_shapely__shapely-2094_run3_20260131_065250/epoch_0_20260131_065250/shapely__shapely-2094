   131→\n   132→\n   133→def test_from_wkt():\n   134→    expected = shapely.points(1, 1)\n   135→    actual = shapely.from_wkt(\"POINT (1 1)\")\n   136→    assert_geometries_equal(actual, expected)\n   137→    # also accept bytes\n   138→    actual = shapely.from_wkt(b\"POINT (1 1)\")\n   139→    assert_geometries_equal(actual, expected)\n   140→\n   141→\n   142→def test_from_wkt_none():\n   143→    # None propagates\n   144→    assert shapely.from_wkt(None) is None\n   145→\n   146→\n   147→def test_from_wkt_exceptions():\n   148→    with pytest.raises(TypeError, match=\"Expected bytes or string, got int\"):\n   149→        shapely.from_wkt(1)\n   150→\n   151→    with pytest.raises(\n   152→        shapely.GEOSException, match=\"Expected word but encountered end of stream\"\n   153→    ):\n   154→        shapely.from_wkt(\"\")\n   155→\n   156→    with pytest.raises(shapely.GEOSException, match=\"Unknown type: 'NOT'\"):\n   157→        shapely.from_wkt(\"NOT A WKT STRING\")\n   158→\n   159→\n   160→def test_from_wkt_warn_on_invalid():\n   161→    with pytest.warns(Warning, match=\"Invalid WKT\"):\n   162→        shapely.from_wkt(\"\", on_invalid=\"warn\")\n   163→\n   164→    with pytest.warns(Warning, match=\"Invalid WKT\"):\n   165→        shapely.from_wkt(\"NOT A WKT STRING\", on_invalid=\"warn\")\n   166→\n   167→\n   168→def test_from_wkb_ignore_on_invalid():\n   169→    with warnings.catch_warnings():\n   170→        warnings.simplefilter(\"error\")\n   171→        shapely.from_wkt(\"\", on_invalid=\"ignore\")\n   172→\n   173→    with warnings.catch_warnings():\n   174→        warnings.simplefilter(\"error\")\n   175→        shapely.from_wkt(\"NOT A WKT STRING\", on_invalid=\"ignore\")\n   176→\n   177→\n   178→def test_from_wkt_on_invalid_unsupported_option():\n   179→    with pytest.raises(ValueError, match=\"not a valid option\"):\n   180→        shapely.from_wkt(\"NOT A WKT STRING\", on_invalid=\"unsupported_option\")\n   181→\n   182→\n   183→@pytest.mark.parametrize(\"geom\", all_types)\n   184→def test_from_wkt_all_types(geom):\n   185→    wkt = shapely.to_wkt(geom)\n   186→    actual = shapely.from_wkt(wkt)\n   187→\n   188→    if equal_geometries_abnormally_yield_unequal(geom):\n   189→        # check abnormal test\n   190→        with pytest.raises(AssertionError):\n   191→            assert_geometries_equal(actual, geom)\n   192→    else:\n   193→        # normal test\n   194→        assert_geometries_equal(actual, geom)\n   195→\n   196→\n   197→@pytest.mark.parametrize(\n   198→    \"wkt\",\n   199→    (\"POINT EMPTY\", \"LINESTRING EMPTY\", \"POLYGON EMPTY\", \"GEOMETRYCOLLECTION EMPTY\"),\n   200→)\n   201→def test_from_wkt_empty(wkt):\n   202→    geom = shapely.from_wkt(wkt)\n   203→    assert shapely.is_geometry(geom).all()\n   204→    assert shapely.is_empty(geom).all()\n   205→    assert shapely.to_wkt(geom) == wkt\n   206→\n   207→\n   208→def test_from_wkb():\n   209→    expected = shapely.points(1, 1)\n   210→    actual = shapely.from_wkb(POINT11_WKB)\n   211→    assert_geometries_equal(actual, expected)\n   212→\n   213→\n   214→def test_from_wkb_hex():\n   215→    # HEX form\n   216→    expected = shapely.points(1, 1)\n   217→    actual = shapely.from_wkb(\"0101000000000000000000F03F000000000000F03F\")\n   218→    assert_geometries_equal(actual, expected)\n   219→    actual = shapely.from_wkb(b\"0101000000000000000000F03F000000000000F03F\")\n   220→    assert_geometries_equal(actual, expected)\n   221→\n   222→\n   223→def test_from_wkb_none():\n   224→    # None propagates\n   225→    assert shapely.from_wkb(None) is None\n   226→\n   227→\n   228→def test_from_wkb_exceptions():\n   229→    with pytest.raises(TypeError, match=\"Expected bytes or string, got int\"):\n   230→        shapely.from_wkb(1)\n   231→\n   232→    # invalid WKB\n   233→    with pytest.raises(\n   234→        shapely.GEOSException,\n   235→        match=(\n   236→            \"Unexpected EOF parsing WKB|\"\n   237→            \"ParseException: Input buffer is smaller than requested object size\"\n   238→        ),\n   239→    ):\n   240→        result = shapely.from_wkb(b\"\\x01\\x01\\x00\\x00\\x00\\x00\")\n   241→        assert result is None\n   242→\n   243→    # invalid ring in WKB\n   244→    with pytest.raises(\n   245→        shapely.GEOSException,\n   246→        match=\"Points of LinearRing do not form a closed linestring\",\n   247→    ):\n   248→        result = shapely.from_wkb(INVALID_WKB)\n   249→        assert result is None\n   250→\n   251→\n   252→def test_from_wkb_warn_on_invalid_warn():\n   253→    # invalid WKB\n   254→    with pytest.warns(Warning, match=\"Invalid WKB\"):\n   255→        result = shapely.from_wkb(b\"\\x01\\x01\\x00\\x00\\x00\\x00\", on_invalid=\"warn\")\n   256→        assert result is None\n   257→\n   258→    # invalid ring in WKB\n   259→    with pytest.warns(Warning, match=\"Invalid WKB\"):\n   260→        result = shapely.from_wkb(INVALID_WKB, on_invalid=\"warn\")\n   261→        assert result is None\n   262→\n   263→\n   264→def test_from_wkb_ignore_on_invalid_ignore():\n   265→    # invalid WKB\n   266→    with warnings.catch_warnings():\n   267→        warnings.simplefilter(\"error\")  # no warning\n   268→        result = shapely.from_wkb(b\"\\x01\\x01\\x00\\x00\\x00\\x00\", on_invalid=\"ignore\")\n   269→        assert result is None\n   270→\n   271→    # invalid ring in WKB\n   272→    with warnings.catch_warnings():\n   273→        warnings.simplefilter(\"error\")  # no warning\n   274→        result = shapely.from_wkb(INVALID_WKB, on_invalid=\"ignore\")\n   275→        assert result is None\n   276→\n   277→\n   278→def test_from_wkb_on_invalid_unsupported_option():\n   279→    with pytest.raises(ValueError, match=\"not a valid option\"):\n   280→        shapely.from_wkb(b\"\\x01\\x01\\x00\\x00\\x00\\x00\", on_invalid=\"unsupported_option\")\n   281→\n   282→\n   283→@pytest.mark.parametrize(\"geom\", all_types)\n   284→@pytest.mark.parametrize(\"use_hex\", [False, True])\n   285→@pytest.mark.parametrize(\"byte_order\", [0, 1])\n   286→def test_from_wkb_all_types(geom, use_hex, byte_order):\n   287→    if shapely.get_type_id(geom) == shapely.GeometryType.LINEARRING:\n   288→        pytest.skip(\"Linearrings are not preserved in WKB\")\n   289→    wkb = shapely.to_wkb(geom, hex=use_hex, byte_order=byte_order)\n   290→    actual = shapely.from_wkb(wkb)\n   291→    assert_geometries_equal(actual, geom)\n   292→\n   293→\n   294→@pytest.mark.parametrize(\"geom\", all_types_z)\n   295→@pytest.mark.parametrize(\"use_hex\", [False, True])\n   296→@pytest.mark.parametrize(\"byte_order\", [0, 1])\n   297→def test_from_wkb_all_types_z(geom, use_hex, byte_order):\n   298→    if shapely.get_type_id(geom) == shapely.GeometryType.LINEARRING:\n   299→        pytest.skip(\"Linearrings are not preserved in WKB\")\n   300→    wkb = shapely.to_wkb(geom, hex=use_hex, byte_order=byte_order)\n   301→    actual = shapely.from_wkb(wkb)\n   302→    assert_geometries_equal(actual, geom)\n   303→\n   304→\n   305→@pytest.mark.skipif(\n   306→    shapely.geos_version < (3, 12, 0),\n   307→    reason=\"M coordinates not supported with GEOS < 3.12\",\n   308→)\n   309→@pytest.mark.parametrize(\"geom\", all_types_m)\n   310→@pytest.mark.parametrize(\"use_hex\", [False, True])\n   311→@pytest.mark.parametrize(\"byte_order\", [0, 1])\n   312→def test_from_wkb_all_types_m(geom, use_hex, byte_order):\n   313→    if shapely.get_type_id(geom) == shapely.GeometryType.LINEARRING:\n   314→        pytest.skip(\"Linearrings are not preserved in WKB\")\n   315→    wkb = shapely.to_wkb(geom, hex=use_hex, byte_order=byte_order)\n   316→    actual = shapely.from_wkb(wkb)\n   317→    assert_geometries_equal(actual, geom)\n   318→\n   319→\n   320→@pytest.mark.skipif(\n   321→    shapely.geos_version < (3, 12, 0),\n   322→    reason=\"M coordinates not supported with GEOS < 3.12\",\n   323→)\n   324→@pytest.mark.parametrize(\"geom\", all_types_zm)\n   325→@pytest.mark.parametrize(\"use_hex\", [False, True])\n   326→@pytest.mark.parametrize(\"byte_order\", [0, 1])\n   327→def test_from_wkb_all_types_zm(geom, use_hex, byte_order):\n   328→    if shapely.get_type_id(geom) == shapely.GeometryType.LINEARRING:\n   329→        pytest.skip(\"Linearrings are not preserved in WKB\")\n   330→    wkb = shapely.to_wkb(geom, hex=use_hex, byte_order=byte_order)\n   331→    actual = shapely.from_wkb(wkb)\n   332→    assert_geometries_equal(actual, geom)\n   333→\n   334→\n   335→@pytest.mark.parametrize(\n   336→    \"geom\",\n   337→    (Point(), LineString(), Polygon(), GeometryCollection()),\n   338→)\n   339→def test_from_wkb_empty(geom):\n   340→    wkb = shapely.to_wkb(geom)\n   341→    geom = shapely.from_wkb(wkb)\n   342→    assert shapely.is_geometry(geom).all()\n   343→    assert shapely.is_empty(geom).all()\n   344→    assert shapely.to_wkb(geom) == wkb\n   345→\n   346→\n   347→def test_to_wkt():\n   348→    point = shapely.points(1, 1)\n   349→    actual = shapely.to_wkt(point)\n   350→    assert actual == \"POINT (1 1)\"\n   351→\n   352→    actual = shapely.to_wkt(point, trim=False)\n   353→    assert actual == \"POINT (1.000000 1.000000)\"\n   354→\n   355→    actual = shapely.to_wkt(point, rounding_precision=3, trim=False)\n   356→    assert actual == \"POINT (1.000 1.000)\"\n   357→\n   358→\n   359→def test_to_wkt_z():\n   360→    point = shapely.points(1, 2, 3)\n   361→\n   362→    assert shapely.to_wkt(point) == \"POINT Z (1 2 3)\"\n   363→    assert shapely.to_wkt(point, output_dimension=2) == \"POINT (1 2)\"\n   364→    assert shapely.to_wkt(point, output_dimension=3) == \"POINT Z (1 2 3)\"\n   365→    assert shapely.to_wkt(point, old_3d=True) == \"POINT (1 2 3)\"\n   366→\n   367→    if shapely.geos_version >= (3, 12, 0):\n   368→        assert shapely.to_wkt(point, output_dimension=4) == \"POINT Z (1 2 3)\"\n   369→\n   370→\n   371→def test_to_wkt_m():\n   372→    point = shapely.from_wkt(\"POINT M (1 2 4)\")\n   373→\n   374→    assert shapely.to_wkt(point, output_dimension=2) == \"POINT (1 2)\"\n   375→\n   376→    if shapely.geos_version < (3, 12, 0):\n   377→        # previous behavior was to incorrectly parse M as Z\n   378→        assert shapely.to_wkt(point) == \"POINT Z (1 2 4)\"\n   379→        assert shapely.to_wkt(point, output_dimension=3) == \"POINT Z (1 2 4)\"\n   380→        assert shapely.to_wkt(point, old_3d=True) == \"POINT (1 2 4)\"\n   381→    else:\n   382→        assert shapely.to_wkt(point) == \"POINT M (1 2 4)\"\n   383→        assert shapely.to_wkt(point, output_dimension=3) == \"POINT M (1 2 4)\"\n   384→        assert shapely.to_wkt(point, output_dimension=4) == \"POINT M (1 2 4)\"\n   385→        assert shapely.to_wkt(point, old_3d=True) == \"POINT M (1 2 4)\"\n   386→\n   387→\n   388→def test_to_wkt_zm():\n   389→    point = shapely.from_wkt(\"POINT ZM (1 2 3 4)\")\n   390→\n   391→    assert shapely.to_wkt(point, output_dimension=2) == \"POINT (1 2)\"\n   392→    assert shapely.to_wkt(point, output_dimension=3) == \"POINT Z (1 2 3)\"\n   393→\n   394→    if shapely.geos_version < (3, 12, 0):\n   395→        # previous behavior was to parse and ignore M\n   396→        assert shapely.to_wkt(point) == \"POINT Z (1 2 3)\"\n   397→        assert shapely.to_wkt(point, old_3d=True) == \"POINT (1 2 3)\"\n   398→    else:\n   399→        assert shapely.to_wkt(point) == \"POINT ZM (1 2 3 4)\"\n   400→        assert shapely.to_wkt(point, output_dimension=4) == \"POINT ZM (1 2 3 4)\"\n   401→        assert shapely.to_wkt(point, old_3d=True) == \"POINT (1 2 3 4)\"\n   402→\n   403→\n   404→def test_to_wkt_none():\n   405→    # None propagates\n   406→    assert shapely.to_wkt(None) is None\n   407→\n   408→\n   409→def test_to_wkt_array_with_empty_z():\n   410→    # See GH-2004\n   411→    empty_wkt = [\"POINT Z EMPTY\", None, \"POLYGON Z EMPTY\"]\n   412→    empty_geoms = shapely.from_wkt(empty_wkt)\n   413→    assert list(shapely.to_wkt(empty_geoms)) == empty_wkt\n   414→\n   415→\n   416→def test_to_wkt_exceptions():\n   417→    with pytest.raises(TypeError):\n   418→        shapely.to_wkt(1)\n   419→\n   420→    with pytest.raises(shapely.GEOSException):\n   421→        shapely.to_wkt(point, output_dimension=5)\n   422→\n   423→\n   424→def test_to_wkt_point_empty():\n   425→    assert shapely.to_wkt(empty_point) == \"POINT EMPTY\"\n   426→\n   427→\n   428→@pytest.mark.parametrize(\n   429→    \"wkt\",\n   430→    [\n   431→        \"POINT Z EMPTY\",\n   432→        \"LINESTRING Z EMPTY\",\n   433→        \"LINEARRING Z EMPTY\",\n   434→        \"POLYGON Z EMPTY\",\n   435→    ],\n   436→)\n   437→def test_to_wkt_empty_z(wkt):\n   438→    assert shapely.to_wkt(shapely.from_wkt(wkt)) == wkt\n   439→\n   440→\n   441→def test_to_wkt_geometrycollection_with_point_empty():\n   442→    collection = shapely.geometrycollections([empty_point, point])\n   443→    # do not check the full value as some GEOS versions give\n   444→    # GEOMETRYCOLLECTION Z (...) and others give GEOMETRYCOLLECTION (...)\n   445→    assert shapely.to_wkt(collection).endswith(\"(POINT EMPTY, POINT (2 3))\")\n   446→\n   447→\n   448→def test_to_wkt_multipoint_with_point_empty():\n   449→    geom = shapely.multipoints([empty_point, point])\n   450→    if shapely.geos_version >= (3, 12, 0):\n   451→        expected = \"MULTIPOINT (EMPTY, (2 3))\"\n   452→    else:\n   453→        # invalid WKT form\n   454→        expected = \"MULTIPOINT (EMPTY, 2 3)\"\n   455→    assert shapely.to_wkt(geom) == expected\n   456→\n   457→\n   458→@pytest.mark.parametrize(\"geom\", [Point(1e100, 0), Point(0, 1e100)])\n   459→def test_to_wkt_large_float_ok(geom):\n   460→    # https://github.com/shapely/shapely/issues/1903\n   461→    shapely.to_wkt(geom)\n   462→    assert \"Exception in WKT writer\" not in repr(geom)\n   463→\n   464→\n   465→@pytest.mark.parametrize(\"geom\", [Point(1e101, 0), Point(0, 1e101)])\n   466→def test_to_wkt_large_float(geom):\n   467→    if shapely.geos_version >= (3, 13, 0):\n   468→        # round-trip WKT\n   469→        assert geom.equals(shapely.from_wkt(shapely.to_wkt(geom)))\n   470→    else:\n   471→        # https://github.com/shapely/shapely/issues/1903\n   472→        with pytest.raises(\n   473→            ValueError, match=\"WKT output of coordinates greater than.*\"\n   474→        ):\n   475→            shapely.to_wkt(geom)\n   476→        assert \"Exception in WKT writer\" in repr(geom)\n   477→\n   478→\n   479→@pytest.mark.parametrize(\n   480→    \"geom\",\n   481→    [\n   482→        # We implemented our own \"GetZMax\", so go through all geometry types:\n   483→        Point(0, 0, 1e101),\n   484→        LineString([(0, 0, 0), (0, 0, 1e101)]),\n   485→        LinearRing([(0, 0, 0), (0, 1, 0), (1, 0, 1e101), (0, 0, 0)]),\n   486→        Polygon([(0, 0, 0), (0, 1, 0), (1, 0, 1e101), (0, 0, 0)]),\n   487→        Polygon(\n   488→            [(0, 0, 0), (0, 10, 0), (10, 0, 0), (0, 0, 0)],\n   489→            [[(0, 0, 0), (0, 1, 0), (1, 0, 1e101), (0, 0, 0)]],\n   490→        ),\n   491→        MultiPoint([(0, 0, 0), (0, 0, 1e101)]),\n   492→        MultiLineString(\n   493→            [LineString([(0, 0, 0), (0, 1, 0)]), LineString([(0, 0, 0), (0, 1, 1e101)])]\n   494→        ),\n   495→        MultiPolygon(\n   496→            [polygon_z, Polygon([(0, 0, 0), (0, 1, 0), (1, 0, 1e101), (0, 0, 0)])]\n   497→        ),\n   498→        GeometryCollection([point_z, Point(0, 0, 1e101)]),\n   499→        GeometryCollection([GeometryCollection([Point(0, 0, 1e101)])]),\n   500→        LineString([(0, 0, np.nan), (0, 0, 1e101)]),\n   501→        Polygon([(0, 0, np.nan), (0, 1, 0), (1, 0, 1e101), (0, 0, 0)]),\n   502→        GeometryCollection([Point(0, 0), Point(0, 0, 1e101)]),\n   503→    ],\n   504→)\n   505→def test_to_wkt_large_float_3d_no_crash(geom):\n   506→    # https://github.com/shapely/shapely/issues/1903\n   507→    # just test if there is a crash (detailed behaviour differs per GEOS version)\n   508→    try:\n   509→        shapely.to_wkt(geom)\n   510→    except ValueError as e:\n   511→        assert str(e).startswith(\"WKT output of coordinates greater than\")\n   512→    repr(geom)\n   513→\n   514→\n   515→def test_to_wkt_large_float_skip_z():\n   516→    # https://github.com/shapely/shapely/issues/1903\n   517→    assert shapely.to_wkt(Point(0, 0, 1e101), output_dimension=2) == \"POINT (0 0)\"\n   518→\n   519→\n   520→def test_to_wkt_large_float_no_trim():\n   521→    # https://github.com/shapely/shapely/issues/1903\n   522→    # don't test the exact number, it is ridiculously large and probably platform\n   523→    # dependent\n   524→    assert shapely.to_wkt(Point(1e101, 0), trim=False).startswith(\"POINT (\")\n   525→\n   526→\n   527→def test_repr():\n   528→    assert repr(point) == \"<POINT (2 3)>\"\n   529→    assert repr(point_z) == \"<POINT Z (2 3 4)>\"\n   530→\n   531→\n   532→@pytest.mark.skipif(\n   533→    shapely.geos_version < (3, 12, 0),\n   534→    reason=\"M coordinates not supported with GEOS < 3.12\",\n   535→)\n   536→def test_repr_m():\n   537→    assert repr(point_m) == \"<POINT M (2 3 5)>\"\n   538→    assert repr(point_zm) == \"<POINT ZM (2 3 4 5)>\"\n   539→\n   540→\n   541→def test_repr_max_length():\n   542→    # the repr is limited to 80 characters\n   543→    geom = shapely.linestrings(np.arange(1000), np.arange(1000))\n   544→    representation = repr(geom)\n   545→    assert len(representation) == 80\n   546→    assert representation.endswith(\"...>\")\n   547→\n   548→\n   549→def test_repr_point_z_empty():\n   550→    assert repr(empty_point_z) == \"<POINT Z EMPTY>\"\n   551→\n   552→\n   553→@pytest.mark.skipif(\n   554→    shapely.geos_version < (3, 12, 0),\n   555→    reason=\"M coordinates not supported with GEOS < 3.12\",\n   556→)\n   557→def test_repr_point_m_empty():\n   558→    assert repr(empty_point_m) == \"<POINT M EMPTY>\"\n   559→    assert repr(empty_point_zm) == \"<POINT ZM EMPTY>\"\n   560→\n   561→\n   562→def test_to_wkb():\n   563→    point = shapely.points(1, 1)\n   564→    actual = shapely.to_wkb(point, byte_order=1)\n   565→    assert actual == POINT11_WKB\n   566→\n   567→\n   568→def test_to_wkb_hex():\n   569→    point = shapely.points(1, 1)\n   570→    actual = shapely.to_wkb(point, hex=True, byte_order=1)\n   571→    le = \"01\"\n   572→    point_type = \"01000000\"\n   573→    coord = \"000000000000F03F\"  # 1.0 as double (LE)\n   574→    assert actual == le + point_type + 2 * coord\n   575→\n   576→\n   577→def test_to_wkb_z():\n   578→    point = shapely.points(1, 2, 3)\n   579→\n   580→    expected_wkb = struct.pack(\"<BI2d\", 1, 1, 1.0, 2.0)\n   581→    expected_wkb_z = struct.pack(\"<BI3d\", 1, 1 | EWKBZ, 1.0, 2.0, 3.0)\n   582→\n   583→    assert shapely.to_wkb(point, byte_order=1) == expected_wkb_z\n   584→    assert shapely.to_wkb(point, output_dimension=2, byte_order=1) == expected_wkb\n   585→    assert shapely.to_wkb(point, output_dimension=3, byte_order=1) == expected_wkb_z\n   586→    if shapely.geos_version >= (3, 12, 0):\n   587→        assert shapely.to_wkb(point, output_dimension=4, byte_order=1) == expected_wkb_z\n   588→\n   589→\n   590→def test_to_wkb_m():\n   591→    # POINT M (1 2 4)\n   592→    point = shapely.from_wkb(struct.pack(\"<BI3d\", 1, 1 | EWKBM, 1.0, 2.0, 4.0))\n   593→\n   594→    expected_wkb = struct.pack(\"<BI2d\", 1, 1, 1.0, 2.0)\n   595→    expected_wkb_m = struct.pack(\"<BI3d\", 1, 1 | EWKBM, 1.0, 2.0, 4.0)\n   596→    if shapely.geos_version < (3, 12, 0):\n   597→        # previous behavior was to ignore M, treat as 2D\n   598→        expected_wkb_m = expected_wkb\n   599→\n   600→    assert shapely.to_wkb(point, byte_order=1) == expected_wkb_m\n   601→    assert shapely.to_wkb(point, output_dimension=2, byte_order=1) == expected_wkb\n   602→    assert shapely.to_wkb(point, output_dimension=3, byte_order=1) == expected_wkb_m\n   603→    if shapely.geos_version >= (3, 12, 0):\n   604→        assert shapely.to_wkb(point, output_dimension=4, byte_order=1) == expected_wkb_m\n   605→\n   606→\n   607→def test_to_wkb_zm():\n   608→    # POINT ZM (1 2 3 4)\n   609→    point = shapely.from_wkb(struct.pack(\"<BI4d\", 1, 1 | EWKBZM, 1.0, 2.0, 3.0, 4.0))\n   610→\n   611→    expected_wkb = struct.pack(\"<BI2d\", 1, 1, 1.0, 2.0)\n   612→    expected_wkb_z = struct.pack(\"<BI3d\", 1, 1 | EWKBZ, 1.0, 2.0, 3.0)\n   613→    expected_wkb_zm = struct.pack(\"<BI4d\", 1, 1 | EWKBZM, 1.0, 2.0, 3.0, 4.0)\n   614→    if shapely.geos_version < (3, 12, 0):\n   615→        # previous behavior was to ignore M, treat as XYZ\n   616→        expected_wkb_zm = expected_wkb_z\n   617→\n   618→    assert shapely.to_wkb(point, byte_order=1) == expected_wkb_zm\n   619→    assert shapely.to_wkb(point, output_dimension=2, byte_order=1) == expected_wkb\n   620→    assert shapely.to_wkb(point, output_dimension=3, byte_order=1) == expected_wkb_z\n   621→    if shapely.geos_version >= (3, 12, 0):\n   622→        assert (\n   623→            shapely.to_wkb(point, output_dimension=4, byte_order=1) == expected_wkb_zm\n   624→        )\n   625→\n   626→\n   627→def test_to_wkb_none():\n   628→    # None propagates\n   629→    assert shapely.to_wkb(None) is None\n   630→\n   631→\n   632→def test_to_wkb_exceptions():\n   633→    with pytest.raises(TypeError):\n   634→        shapely.to_wkb(1)\n   635→\n   636→    with pytest.raises(shapely.GEOSException):\n   637→        shapely.to_wkb(point, output_dimension=5)\n   638→\n   639→    with pytest.raises(ValueError):\n   640→        shapely.to_wkb(point, flavor=\"other\")\n   641→\n   642→\n   643→def test_to_wkb_byte_order():\n   644→    point = shapely.points(1.0, 1.0)\n   645→    be = b\"\\x00\"\n   646→    le = b\"\\x01\"\n   647→    point_type = b\"\\x01\\x00\\x00\\x00\"  # 1 as 32-bit uint (LE)\n   648→    coord = b\"\\x00\\x00\\x00\\x00\\x00\\x00\\xf0?\"  # 1.0 as double (LE)\n   649→\n   650→    assert shapely.to_wkb(point, byte_order=1) == le + point_type + 2 * coord\n   651→    assert (\n   652→        shapely.to_wkb(point, byte_order=0) == be + point_type[::-1] + 2 * coord[::-1]\n   653→    )\n   654→\n   655→\n   656→def test_to_wkb_srid():\n   657→    # hex representation of POINT (0 0) with SRID=4\n   658→    ewkb = \"01010000200400000000000000000000000000000000000000\"\n   659→    wkb = \"010100000000000000000000000000000000000000\"\n   660→\n   661→    actual = shapely.from_wkb(ewkb)\n   662→    assert shapely.to_wkt(actual, trim=True) == \"POINT (0 0)\"\n   663→\n   664→    assert shapely.to_wkb(actual, hex=True, byte_order=1) == wkb\n   665→    assert shapely.to_wkb(actual, hex=True, include_srid=True, byte_order=1) == ewkb\n   666→\n   667→    point = shapely.points(1, 1)\n   668→    point_with_srid = shapely.set_srid(point, np.int32(4326))\n   669→    result = shapely.to_wkb(point_with_srid, include_srid=True, byte_order=1)\n   670→    assert np.frombuffer(result[5:9], \"<u4\").item() == 4326\n   671→\n   672→\n   673→@pytest.mark.skipif(shapely.geos_version < (3, 10, 0), reason=\"GEOS < 3.10.0\")\n   674→def test_to_wkb_flavor():\n   675→    # http://libgeos.org/specifications/wkb/#extended-wkb\n   676→    actual = shapely.to_wkb(point_z, byte_order=1)  # default \"extended\"\n   677→    assert actual.hex()[2:10] == struct.pack(\"<I\", 1 | EWKBZ).hex()\n   678→    actual = shapely.to_wkb(point_z, byte_order=1, flavor=\"extended\")\n   679→    assert actual.hex()[2:10] == struct.pack(\"<I\", 1 | EWKBZ).hex()\n   680→    actual = shapely.to_wkb(point_z, byte_order=1, flavor=\"iso\")\n   681→    assert actual.hex()[2:10] == struct.pack(\"<I\", 1 | ISOWKBZ).hex()\n   682→\n   683→\n   684→@pytest.mark.skipif(\n   685→    shapely.geos_version < (3, 12, 0),\n   686→    reason=\"M coordinates not supported with GEOS < 3.12\",\n   687→)\n   688→def test_to_wkb_m_flavor():\n   689→    # XYM\n   690→    actual = shapely.to_wkb(point_m, byte_order=1)  # default \"extended\"\n   691→    assert actual.hex()[2:10] == struct.pack(\"<I\", 1 | EWKBM).hex()\n   692→    actual = shapely.to_wkb(point_m, byte_order=1, flavor=\"iso\")\n   693→    assert actual.hex()[2:10] == struct.pack(\"<I\", 1 | ISOWKBM).hex()\n   694→\n   695→    # XYZM\n   696→    actual = shapely.to_wkb(point_zm, byte_order=1)  # default \"extended\"\n   697→    assert actual.hex()[2:10] == struct.pack(\"<I\", 1 | EWKBZM).hex()\n   698→    actual = shapely.to_wkb(point_zm, byte_order=1, flavor=\"iso\")\n   699→    assert actual.hex()[2:10] == struct.pack(\"<I\", 1 | ISOWKBZM).hex()\n   700→\n   701→\n   702→@pytest.mark.skipif(shapely.geos_version < (3, 10, 0), reason=\"GEOS < 3.10.0\")\n   703→def test_to_wkb_flavor_srid():\n   704→    with pytest.raises(ValueError, match=\"cannot be used together\"):\n   705→        shapely.to_wkb(point_z, include_srid=True, flavor=\"iso\")\n   706→\n   707→\n   708→@pytest.mark.skipif(shapely.geos_version >= (3, 10, 0), reason=\"GEOS < 3.10.0\")\n   709→def test_to_wkb_flavor_unsupported_geos():\n   710→    with pytest.raises(UnsupportedGEOSVersionError):\n   711→        shapely.to_wkb(point_z, flavor=\"iso\")\n   712→\n   713→\n   714→@pytest.mark.parametrize(\n   715→    \"geom,expected\",\n   716→    [\n   717→        pytest.param(empty_point, POINT_NAN_WKB, id=\"POINT EMPTY\"),\n   718→        pytest.param(empty_point_z, POINT_NAN_WKB, id=\"POINT Z EMPTY\"),\n   719→        pytest.param(empty_point_m, POINT_NAN_WKB, id=\"POINT M EMPTY\"),\n   720→        pytest.param(empty_point_zm, POINT_NAN_WKB, id=\"POINT ZM EMPTY\"),\n   721→        pytest.param(\n   722→            multi_point_empty,\n   723→            MULTIPOINT_NAN_WKB,\n   724→            id=\"MULTIPOINT EMPTY\",\n   725→        ),\n   726→        pytest.param(\n   727→            multi_point_empty_z,\n   728→            MULTIPOINT_NAN_WKB,\n   729→            id=\"MULTIPOINT Z EMPTY\",\n   730→        ),\n   731→        pytest.param(\n   732→            multi_point_empty_m,\n   733→            MULTIPOINT_NAN_WKB,\n   734→            id=\"MULTIPOINT M EMPTY\",\n   735→        ),\n   736→        pytest.param(\n   737→            multi_point_empty_zm,\n   738→            MULTIPOINT_NAN_WKB,\n   739→            id=\"MULTIPOINT ZM EMPTY\",\n   740→        ),\n   741→        pytest.param(\n   742→            shapely.geometrycollections([empty_point]),\n   743→            GEOMETRYCOLLECTION_NAN_WKB,\n   744→            id=\"GEOMETRYCOLLECTION (POINT EMPTY)\",\n   745→        ),\n   746→        pytest.param(\n   747→            shapely.geometrycollections([empty_point_z]),\n   748→            GEOMETRYCOLLECTION_NAN_WKB,\n   749→            id=\"GEOMETRYCOLLECTION (POINT Z EMPTY)\",\n   750→        ),\n   751→        pytest.param(\n   752→            shapely.geometrycollections([empty_point_m]),\n   753→            GEOMETRYCOLLECTION_NAN_WKB,\n   754→            id=\"GEOMETRYCOLLECTION (POINT M EMPTY)\",\n   755→        ),\n   756→        pytest.param(\n   757→            shapely.geometrycollections([empty_point_zm]),\n   758→            GEOMETRYCOLLECTION_NAN_WKB,\n   759→            id=\"GEOMETRYCOLLECTION (POINT ZM EMPTY)\",\n   760→        ),\n   761→        pytest.param(\n   762→            shapely.geometrycollections([multi_point_empty]),\n   763→            NESTED_COLLECTION_NAN_WKB,\n   764→            id=\"GEOMETRYCOLLECTION (MULTIPOINT EMPTY)\",\n   765→        ),\n   766→        pytest.param(\n   767→            shapely.geometrycollections([multi_point_empty_z]),\n   768→            NESTED_COLLECTION_NAN_WKB,\n   769→            id=\"GEOMETRYCOLLECTION (MULTIPOINT Z EMPTY)\",\n   770→        ),\n   771→        pytest.param(\n   772→            shapely.geometrycollections([multi_point_empty_m]),\n   773→            NESTED_COLLECTION_NAN_WKB,\n   774→            id=\"GEOMETRYCOLLECTION (MULTIPOINT M EMPTY)\",\n   775→        ),\n   776→        pytest.param(\n   777→            shapely.geometrycollections([multi_point_empty_zm]),\n   778→            NESTED_COLLECTION_NAN_WKB,\n   779→            id=\"GEOMETRYCOLLECTION (MULTIPOINT ZM EMPTY)\",\n   780→        ),\n   781→    ],\n   782→)\n   783→def test_to_wkb_point_empty_2d(geom, expected):\n   784→    actual = shapely.to_wkb(geom, output_dimension=2, byte_order=1)\n   785→    # Split 'actual' into header and coordinates\n   786→    coordinate_length = 16\n   787→    header_length = len(expected) - coordinate_length\n   788→    # Check the total length (this checks the correct dimensionality)\n   789→    assert len(actual) == header_length + coordinate_length\n   790→    # Check the header\n   791→    assert actual[:header_length] == expected[:header_length]\n   792→    # Check the coordinates (using numpy.isnan; there are many byte representations for\n   793→    # NaN)\n   794→    assert np.isnan(struct.unpack(\"<2d\", actual[header_length:])).all()\n   795→\n   796→\n   797→@pytest.mark.parametrize(\n   798→    \"geom,expected\",\n   799→    [\n   800→        pytest.param(empty_point_z, POINTZ_NAN_WKB, id=\"POINT Z EMPTY\"),\n   801→        pytest.param(empty_point_zm, POINTZ_NAN_WKB, id=\"POINT ZM EMPTY\"),\n   802→        pytest.param(\n   803→            multi_point_empty_z,\n   804→            MULTIPOINTZ_NAN_WKB,\n   805→            id=\"MULTIPOINT Z EMPTY\",\n   806→        ),\n   807→        pytest.param(\n   808→            multi_point_empty_zm,\n   809→            MULTIPOINTZ_NAN_WKB,\n   810→            id=\"MULTIPOINT ZM EMPTY\",\n   811→        ),\n   812→        pytest.param(\n   813→            shapely.geometrycollections([empty_point_z]),\n   814→            GEOMETRYCOLLECTIONZ_NAN_WKB,\n   815→            id=\"GEOMETRYCOLLECTION (POINT Z EMPTY)\",\n   816→        ),\n   817→        pytest.param(\n   818→            shapely.geometrycollections([empty_point_zm]),\n   819→            GEOMETRYCOLLECTIONZ_NAN_WKB,\n   820→            id=\"GEOMETRYCOLLECTION (POINT ZM EMPTY)\",\n   821→        ),\n   822→        pytest.param(\n   823→            shapely.geometrycollections([multi_point_empty_z]),\n   824→            NESTED_COLLECTIONZ_NAN_WKB,\n   825→            id=\"GEOMETRYCOLLECTION (MULTIPOINT Z EMPTY)\",\n   826→        ),\n   827→        pytest.param(\n   828→            shapely.geometrycollections([multi_point_empty_zm]),\n   829→            NESTED_COLLECTIONZ_NAN_WKB,\n   830→            id=\"GEOMETRYCOLLECTION (MULTIPOINT ZM EMPTY)\",\n   831→        ),\n   832→    ],\n   833→)\n   834→def test_to_wkb_point_empty_z(geom, expected):\n   835→    actual = shapely.to_wkb(geom, output_dimension=3, byte_order=1)\n   836→    # Split 'actual' into header and coordinates\n   837→    coordinate_length = 8 * 3\n   838→    header_length = len(expected) - coordinate_length\n   839→    # Check the total length (this checks the correct dimensionality)\n   840→    assert len(actual) == header_length + coordinate_length\n   841→    # Check the header\n   842→    assert actual[:header_length] == expected[:header_length]\n   843→    # Check the coordinates (using numpy.isnan; there are many byte representations for\n   844→    # NaN)\n   845→    assert np.isnan(struct.unpack(\"<3d\", actual[header_length:])).all()\n   846→\n   847→\n   848→@pytest.mark.skipif(\n   849→    shapely.geos_version < (3, 12, 0),\n   850→    reason=\"M coordinates not supported with GEOS < 3.12\",\n   851→)\n   852→@pytest.mark.parametrize(\n   853→    \"geom,expected\",\n   854→    [\n   855→        pytest.param(empty_point_m, POINTM_NAN_WKB, id=\"POINT M EMPTY\"),\n   856→        pytest.param(\n   857→            multi_point_empty_m,\n   858→            MULTIPOINTM_NAN_WKB,\n   859→            id=\"MULTIPOINT M EMPTY\",\n   860→        ),\n   861→        pytest.param(\n   862→            shapely.geometrycollections([empty_point_m]),\n   863→            GEOMETRYCOLLECTIONM_NAN_WKB,\n   864→            id=\"GEOMETRYCOLLECTION (POINT M EMPTY)\",\n   865→        ),\n   866→        pytest.param(\n   867→            sh