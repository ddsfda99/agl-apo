int, byte_order=1)\n    b'\\x01\\x01\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\xf0?\\x00\\x00\\x00\\x00\\x00\\x00\\xf0?'\n    >>> to_wkb(point, hex=True, byte_order=1)\n    '0101000000000000000000F03F000000000000F03F'\n\n    \"\"\"\n    if not np.isscalar(hex):\n        raise TypeError(\"hex only accepts scalar values\")\n    if output_dimension is None:\n        output_dimension = 3 if geos_version < (3, 12, 0) else 4\n    elif not np.isscalar(output_dimension):\n        raise TypeError(\"output_dimension only accepts scalar values\")\n    if not np.isscalar(byte_order):\n        raise TypeError(\"byte_order only accepts scalar values\")\n    if not np.isscalar(include_srid):\n        raise TypeError(\"include_srid only accepts scalar values\")\n    if not np.isscalar(flavor):\n        raise TypeError(\"flavor only accepts scalar values\")\n    if lib.geos_version < (3, 10, 0) and flavor == \"iso\":\n        raise UnsupportedGEOSVersionError(\n            'The \"iso\" option requires at least GEOS 3.10.0'\n        )\n    if flavor == \"iso\" and include_srid:\n        raise ValueError('flavor=\"iso\" and include_srid=True cannot be used together')\n    flavor = WKBFlavorOptions.get_value(flavor)\n\n    return lib.to_wkb(\n        geometry,\n        np.bool_(hex),\n        np.intc(output_dimension),\n        np.intc(byte_order),\n        np.bool_(include_srid),\n        np.intc(flavor),\n        **kwargs,\n    )\n\n\n@requires_geos(\"3.10.0\")\ndef to_geojson(geometry, indent=None, **kwargs):\n    \"\"\"Convert to the GeoJSON representation of a Geometry.\n\n    The GeoJSON format is defined in the `RFC 7946 <https://geojson.org/>`__.\n    NaN (not-a-number) coordinates will be written as 'null'.\n\n    The following are currently unsupported:\n\n    - Geometries of type LINEARRING: these are output as 'null'.\n    - Three-dimensional geometries: the third dimension is ignored.\n\n    Parameters\n    ----------\n    geometry : str, bytes or array_like\n        Geometry or geometries to convert to GeoJSON.\n    indent : int, optional\n        If indent is a non-negative integer, then GeoJSON will be formatted.\n        An indent level of 0 will only insert newlines. None (the default)\n        selects the most compact representation.\n    **kwargs\n        See :ref:`NumPy ufunc docs <ufuncs.kwargs>` for other keyword arguments.\n\n    Examples\n    --------\n    >>> from shapely import Point\n    >>> point = Point(1, 1)\n    >>> to_geojson(point)\n    '{\"type\":\"Point\",\"coordinates\":[1.0,1.0]}'\n    >>> print(to_geojson(point, indent=2))\n    {\n      \"type\": \"Point\",\n      \"coordinates\": [\n          1.0,\n          1.0\n      ]\n    }\n\n    \"\"\"\n    # GEOS Tickets:\n    # - handle linearrings: https://trac.osgeo.org/geos/ticket/1140\n    # - support 3D: https://trac.osgeo.org/geos/ticket/1141\n    if indent is None:\n        indent = -1\n    elif not np.isscalar(indent):\n        raise TypeError(\"indent only accepts scalar values\")\n    elif indent < 0:\n        raise ValueError(\"indent cannot be negative\")\n\n    return lib.to_geojson(geometry, np.intc(indent), **kwargs)\n\n\ndef _normalize_coord_string(s: str) -> str:\n    # collapse internal whitespace for coordinate comparison\n    return \" \".join(s.strip().split())\n\n\ndef _find_matching(s: str, start: int) -> int:\n    depth = 0\n    for i in range(start, len(s)):\n        if s[i] == \"(\":\n            depth += 1\n        elif s[i] == \")\":\n            depth -= 1\n            if depth == 0:\n                return i\n    return len(s) - 1\n\n\ndef _fix_polygon_rings(poly_coords: str) -> str:\n    # poly_coords includes outer parentheses, eg: \"((...),(...))\"\n    if not poly_coords or poly_coords[0] != \"(\":\n        return poly_coords\n    outer_end = _find_matching(poly_coords, 0)\n    inside = poly_coords[1:outer_end]\n    out_rings = []\n    i = 0\n    n = len(inside)\n    while i < n:\n        # skip whitespace and commas\n        while i < n and (inside[i].isspace() or inside[i] == \",\"):\n            i += 1\n        if i >= n:\n            break\n        if inside[i] == \"(\":\n            ring_end = _find_matching(inside, i)\n            ring_content = inside[i + 1 : ring_end]\n            parts = [p.strip() for p in ring_content.split(\",\") if p.strip()]\n            if len(parts) >= 2:\n                first = parts[0]\n                last = parts[-1]\n                if _normalize_coord_string(first) != _normalize_coord_string(last):\n                    ring_content = \", \".join(parts + [first])\n                else:\n                    ring_content = \", \".join(parts)\n            else:\n                ring_content = \", \".join(parts)\n            out_rings.append(f\"({ring_content})\")\n            i = ring_end + 1\n        else:\n            # unexpected token, copy and continue\n            i += 1\n    fixed = \"(\" + \", \".join(out_rings) + \")\"\n    # append any trailing content after outer_end\n    return fixed + poly_coords[outer_end + 1 :]\n\n\ndef _fix_wkt_structure_scalar(wkt: str) -> str:\n    # Only attempt simple structural fixes: close polygon rings\n    s = wkt\n    i = 0\n    n = len(s)\n    out = []\n    while i < n:\n        if s.startswith(\"POLYGON\", i):\n            out.append(\"POLYGON\")\n            i += len(\"POLYGON\")\n            # consume optional dimension tokens and whitespace\n            while i < n and s[i].isspace():\n                out.append(s[i]); i += 1\n            # possible dimension token Z/M/ZM\n            if i < n and s[i] in (\"Z\", \"M\"):\n                # could be Z or M or ZM\n                out.append(s[i]); i += 1\n                if i < n and s[i] == \"M\":\n                    out.append(\"M\"); i += 1\n                # consume whitespace after dimension\n                while i < n and s[i].isspace():\n                    out.append(s[i]); i += 1\n            # check for EMPTY\n            if s.startswith(\"EMPTY\",