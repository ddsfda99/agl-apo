skipif(\n   996→    shapely.geos_version < (3, 12, 0),\n   997→    reason=\"M coordinates not supported with GEOS < 3.12\",\n   998→)\n   999→@pytest.mark.parametrize(\n  1000→    \"wkb,expected_type\",\n  1001→    [\n  1002→        pytest.param(POINTZM_NAN_WKB, 0, id=\"POINTZM_NAN_WKB\"),\n  1003→        pytest.param(MULTIPOINTZM_NAN_WKB, 4, id=\"MULTIPOINTZM_NAN_WKB\"),\n  1004→        pytest.param(\n  1005→            GEOMETRYCOLLECTIONZM_NAN_WKB, 7, id=\"GEOMETRYCOLLECTIONZM_NAN_WKB\"\n  1006→        ),\n  1007→        pytest.param(NESTED_COLLECTIONZM_NAN_WKB, 7, id=\"NESTED_COLLECTIONZM_NAN_WKB\"),\n  1008→    ],\n  1009→)\n  1010→def test_from_wkb_point_empty_zm(wkb, expected_type):\n  1011→    geom = shapely.from_wkb(wkb)\n  1012→\n  1013→    assert shapely.is_empty(geom)\n  1014→    assert shapely.get_type_id(geom) == expected_type\n  1015→    assert shapely.get_coordinate_dimension(geom) == 4\n  1016→    assert shapely.has_z(geom)\n  1017→    assert shapely.has_m(geom)\n  1018→\n  1019→\n  1020→def test_to_wkb_point_empty_srid():\n  1021→    expected = shapely.set_srid(empty_point, 4236)\n  1022→    wkb = shapely.to_wkb(expected, include_srid=True)\n  1023→    actual = shapely.from_wkb(wkb)\n  1024→    assert shapely.get_srid(actual) == 4236\n  1025→\n  1026→\n  1027→@pytest.mark.parametrize(\"geom\", all_types + (point_z, empty_point))\n  1028→def test_pickle(geom):\n  1029→    pickled = pickle.dumps(geom)\n  1030→    assert_geometries_equal(pickle.loads(pickled), geom, tolerance=0)\n  1031→\n  1032→\n  1033→@pytest.mark.parametrize(\"geom\", all_types_z)\n  1034→def test_pickle_z(geom):\n  1035→    if shapely.get_type_id(geom) == shapely.GeometryType.LINEARRING:\n  1036→        # https://github.com/shapely/shapely/pull/1808#discussion_r1182174077\n  1037→        pytest.xfail(\"TODO: Z gets dropped for LinearRing\")\n  1038→    pickled = pickle.dumps(geom)\n  1039→    actual = pickle.loads(pickled)\n  1040→    assert_geometries_equal(actual, geom, tolerance=0)\n  1041→    if not actual.is_empty:  # GEOSHasZ with EMPTY geometries is inconsistent\n  1042→        assert actual.has_z\n  1043→    if shapely.geos_version >= (3, 12, 0):\n  1044→        assert not actual.has_m\n  1045→\n  1046→\n  1047→@pytest.mark.skipif(\n  1048→    shapely.geos_version < (3, 12, 0),\n  1049→    reason=\"M coordinates not supported with GEOS < 3.12\",\n  1050→)\n  1051→@pytest.mark.parametrize(\"geom\", all_types_m)\n  1052→def test_pickle_m(geom):\n  1053→    if shapely.get_type_id(geom) == shapely.GeometryType.LINEARRING:\n  1054→        pytest.xfail(\"TODO: M gets dropped for LinearRing types; see GH-2005\")\n  1055→    pickled = pickle.dumps(geom)\n  1056→    actual = pickle.loads(pickled)\n  1057→    assert_geometries_equal(actual, geom, tolerance=0)\n  1058→    assert not actual.has_z\n  1059→    if not actual.is_empty:  # GEOSHasM with EMPTY geometries is inconsistent\n  1060→        assert actual.has_m\n  1061→\n  1062→\n  1063→@pytest.mark.skipif(\n  1064→    shapely.geos_version < (3, 12, 0),\n  1065→    reason=\"M coordinates not supported with GEOS < 3.12\",\n  1066→)\n  1067→@pytest.mark.parametrize(\"geom\", all_types_zm)\n  1068→def test_pickle_zm(geom):\n  1069→    if shapely.get_type_id(geom) == shapely.GeometryType.LINEARRING:\n  1070→        pytest.xfail(\"TODO: ZM gets dropped for LinearRing types; see GH-2005\")\n  1071→    pickled = pickle.dumps(geom)\n  1072→    actual = pickle.loads(pickled)\n  1073→    assert_geometries_equal(actual, geom, tolerance=0)\n  1074→    if not actual.is_empty:  # GEOSHasZ with EMPTY geometries is inconsistent\n  1075→        assert actual.has_z\n  1076→        assert actual.has_m\n  1077→\n  1078→\n  1079→@pytest.mark.parametrize(\"geom\", all_types + (point_z, empty_point))\n  1080→def test_pickle_with_srid(geom):\n  1081→    geom = shapely.set_srid(geom, 4326)\n  1082→    pickled = pickle.dumps(geom)\n  1083→    assert shapely.get_srid(pickle.loads(pickled)) == 4326\n  1084→\n  1085→\n  1086→@pytest.mark.skipif(shapely.geos_version < (3, 10, 1), reason=\"GEOS < 3.10.1\")\n  1087→@pytest.mark.parametrize(\n  1088→    \"geojson,expected\",\n  1089→    [\n  1090→        pytest.param(\n  1091→            GEOJSON_GEOMETRY, GEOJSON_GEOMETRY_EXPECTED, id=\"GEOJSON_GEOMETRY\"\n  1092→        ),\n  1093→        pytest.param(GEOJSON_FEATURE, GEOJSON_GEOMETRY_EXPECTED, id=\"GEOJSON_FEATURE\"),\n  1094→        pytest.param(\n  1095→            GEOJSON_FEATURECOLECTION,\n  1096→            shapely.geometrycollections(GEOJSON_COLLECTION_EXPECTED),\n  1097→            id=\"GEOJSON_FEATURECOLECTION\",\n  1098→        ),\n  1099→        pytest.param(\n  1100→            [GEOJSON_GEOMETRY] * 2,\n  1101→            [GEOJSON_GEOMETRY_EXPECTED] * 2,\n  1102→            id=\"GEOJSON_GEOMETRYx2\",\n  1103→        ),\n  1104→        pytest.param(None, None, id=\"None\"),\n  1105→        pytest.param(\n  1106→            [GEOJSON_GEOMETRY, None],\n  1107→            [GEOJSON_GEOMETRY_EXPECTED, None],\n  1108→            id=\"GEOJSON_GEOMETRY_None\",\n  1109→        ),\n  1110→    ],\n  1111→)\n  1112→def test_from_geojson(geojson, expected):\n  1113→    actual = shapely.from_geojson(geojson)\n  1114→    assert_geometries_equal(actual, expected)\n  1115→\n  1116→\n  1117→@pytest.mark.skipif(shapely.geos_version < (3, 10, 1), reason=\"GEOS < 3.10.1\")\n  1118→def test_from_geojson_exceptions():\n  1119→    with pytest.raises(TypeError, match=\"Expected bytes or string, got int\"):\n  1120→        shapely.from_geojson(1)\n  1121→\n  1122→    with pytest.raises(shapely.GEOSException, match=\"Error parsing JSON\"):\n  1123→        shapely.from_geojson(\"\")\n  1124→\n  1125→    with pytest.raises(shapely.GEOSException, match=\"Unknown geometry type\"):\n  1126→        shapely.from_geojson('{\"type\": \"NoGeometry\", \"coordinates\": []}')\n  1127→\n  1128→    with pytest.raises(shapely.GEOSException, match=\"type must be array, but is null\"):\n  1129→        shapely.from_geo