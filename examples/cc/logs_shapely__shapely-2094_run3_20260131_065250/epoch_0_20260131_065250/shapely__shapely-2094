on purpose\n     9→from shapely._ragged_array import from_ragged_array, to_ragged_array\n    10→from shapely.decorators import requires_geos\n    11→from shapely.errors import UnsupportedGEOSVersionError\n    12→\n    13→__all__ = [\n    14→    \"from_geojson\",\n    15→    \"from_ragged_array\",\n    16→    \"from_wkb\",\n    17→    \"from_wkt\",\n    18→    \"to_geojson\",\n    19→    \"to_ragged_array\",\n    20→    \"to_wkb\",\n    21→    \"to_wkt\",\n    22→]\n    23→\n    24→\n    25→# Allowed options for handling WKB/WKT decoding errors\n    26→# Note: cannot use standard constructor since \"raise\" is a keyword\n    27→DecodingErrorOptions = ParamEnum(\n    28→    \"DecodingErrorOptions\", {\"ignore\": 0, \"warn\": 1, \"raise\": 2}\n    29→)\n    30→\n    31→WKBFlavorOptions = ParamEnum(\"WKBFlavorOptions\", {\"extended\": 1, \"iso\": 2})\n    32→\n    33→\n    34→def to_wkt(\n    35→    geometry,\n    36→    rounding_precision=6,\n    37→    trim=True,\n    38→    output_dimension=None,\n    39→    old_3d=False,\n    40→    **kwargs,\n    41→):\n    42→    \"\"\"Convert to the Well-Known Text (WKT) representation of a Geometry.\n    43→\n    44→    The Well-known Text format is defined in the `OGC Simple Features\n    45→    Specification for SQL <https://www.opengeospatial.org/standards/sfs>`__.\n    46→\n    47→    The following limitations apply to WKT serialization:\n    48→\n    49→    - only simple empty geometries can be 3D, empty collections are always 2D\n    50→\n    51→    Parameters\n    52→    ----------\n    53→    geometry : Geometry or array_like\n    54→        Geometry or geometries to convert to WKT.\n    55→    rounding_precision : int, default 6\n    56→        The rounding precision when writing the WKT string. Set to a value of\n    57→        -1 to indicate the full precision.\n    58→    trim : bool, default True\n    59→        If True, trim unnecessary decimals (trailing zeros).\n    60→    output_dimension : int, default None\n    61→        The output dimension for the WKT string. Supported values are 2, 3 and\n    62→        4 for GEOS 3.12+. Default None will automatically choose 3 or 4,\n    63→        depending on the version of GEOS.\n    64→        Specifying 3 means that up to 3 dimensions will be written but 2D\n    65→        geometries will still be represented as 2D in the WKT string.\n    66→    old_3d : bool, default False\n    67→        Enable old style 3D/4D WKT generation. By default, new style 3D/4D WKT\n    68→        (ie. \"POINT Z (10 20 30)\") is returned, but with ``old_3d=True``\n    69→        the WKT will be formatted in the style \"POINT (10 20 30)\".\n    70→    **kwargs\n    71→        See :ref:`NumPy ufunc docs <ufuncs.kwargs>` for other keyword arguments.\n    72→\n    73→    Examples\n    74→    --------\n    75→    >>> from shapely import Point\n    76→    >>> to_wkt(Point(0, 0))\n    77→    'POINT (0 0)'\n    78→    >>> to_wkt(Point(0, 0), rounding_precision=3, trim=False)\n    79→    'POINT (0.000 0.000)'\n    80→    >>> to_wkt(Point(0, 0), rounding_precision=-1, trim=False)\n    81→    'POINT (0.0000000000000000 0.0000000000000000)'\n    82→    >>> to_wkt(Point(1, 2, 3), trim=True)\n    83→    'POINT Z (1 2 3)'\n    84→    >>> to_wkt(Point(1, 2, 3), trim=True, output_dimension=2)\n    85→    'POINT (1 2)'\n    86→    >>> to_wkt(Point(1, 2, 3), trim=True, old_3d=True)\n    87→    'POINT (1 2 3)'\n    88→\n    89→    Notes\n    90→    -----\n    91→    The defaults differ from the default of the GEOS library. To mimic this,\n    92→    use::\n    93→\n    94→        to_wkt(geometry, rounding_precision=-1, trim=False, output_dimension=2)\n    95→\n    96→    \"\"\"\n    97→    if not np.isscalar(rounding_precision):\n    98→        raise TypeError(\"rounding_precision only accepts scalar values\")\n    99→    if not np.isscalar(trim):\n   100→        raise TypeError(\"trim only accepts scalar values\")\n   101→    if output_dimension is None:\n   102→        output_dimension = 3 if geos_version < (3, 12, 0) else 4\n   103→    elif not np.isscalar(output_dimension):\n   104→        raise TypeError(\"output_dimension only accepts scalar values\")\n   105→    if not np.isscalar(old_3d):\n   106→        raise TypeError(\"old_3d only accepts scalar values\")\n   107→\n   108→    return lib.to_wkt(\n   109→        geometry,\n   110→        np.intc(rounding_precision),\n   111→        np.bool_(trim),\n   112→        np.intc(output_dimension),\n   113→        np.bool_(old_3d),\n   114→        **kwargs,\n   115→    )\n   116→\n   117→\n   118→def to_wkb(\n   119→    geometry,\n   120→    hex=False,\n   121→    output_dimension=None,\n   122→    byte_order=-1,\n   123→    include_srid=False,\n   124→    flavor=\"extended\",\n   125→    **kwargs,\n   126→):\n   127→    r\"\"\"Convert to the Well-Known Binary (WKB) representation of a Geometry.\n   128→\n   129→    The Well-Known Binary format is defined in the `OGC Simple Features\n   130→    Specification for SQL <https://www.opengeospatial.org/standards/sfs>`__.\n   131→\n   132→    The following limitations apply to WKB serialization:\n   133→\n   134→    - linearrings will be converted to linestrings\n   135→    - a point with only NaN coordinates is converted to an empty point\n   136→\n   137→    Parameters\n   138→    ----------\n   139→    geometry : Geometry or array_like\n   140→        Geometry or geometries to convert to WKB.\n   141→    hex : bool, default False\n   142→        If true, export the WKB as a hexadecimal string. The default is to\n   143→        return a binary bytes object.\n   144→    output_dimension : int, default None\n   145→        The output dimension for the WKB. Supported values are 2, 3 and 4 for\n   146→        GEOS 3.12+. Default None will automatically choose 3 or 4, depending on\n   147→        the version of GEOS.\n   148→        Specifying 3 means that up to 3 dimensions will be written but 2D\n   149→        geometries will still be represented as 2D in the WKB representation.\n   150→    byte_order : int, default -1\n   151→        Defaults to native machine byte order (-1). Use 0 to force big endian\n   152→        and 1 for little endian.\n   153→    include_srid : bool, default False\n   154→        If True, the SRID is be included in WKB (this is an extension\n   155→        to the OGC WKB specification). Not allowed when flavor is \"iso\".\n   156→    flavor : {\"iso\", \"extended\"}, default \"extended\"\n   157→        Which flavor of WKB will be returned. The flavor determines how\n   158→        extra dimensionality is encoded with the type number, and whether\n   159→        SRID can be included in the WKB. ISO flavor is \"more standard\" for\n   160→        3D output, and does not support SRID embedding.\n   161→        Both flavors are equivalent when ``output_dimension=2`` (or with 2D\n   162→        geometries) and ``include_srid=False``.\n   163→        The `from_wkb` function can read both flavors.\n   164→    **kwargs\n   165→        See :ref:`NumPy ufunc docs <ufuncs.kwargs>` for other keyword arguments.\n   166→\n   167→    Examples\n   168→    --------\n   169→    >>> from shapely import Point\n   170→    >>> point = Point(1, 1)\n   171→    >>> to_wkb(point, byte_order=1)\n   172→    b'\\x01\\x01\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\xf0?\\x00\\x00\\x00\\x00\\x00\\x00\\xf0?'\n   173→    >>> to_wkb(point, hex=True, byte_order=1)\n   174→    '0101000000000000000000F03F000000000000F03F'\n   175→\n   176→    \"\"\"\n   177→    if not np.isscalar(hex):\n   178→        raise TypeError(\"hex only accepts scalar values\")\n   179→    if output_dimension is None:\n   180→        output_dimension = 3 if geos_version < (3, 12, 0) else 4\n   181→    elif not np.isscalar(output_dimension):\n   182→        raise TypeError(\"output_dimension only accepts scalar values\")\n   183→    if not np.isscalar(byte_order):\n   184→        raise TypeError(\"byte_order only accepts scalar val