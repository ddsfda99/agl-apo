pected) - coordinate_length\n   913\u2192    assert len(actual) == header_length + coordinate_length\n   914\u2192    assert actual[:header_length] == expected[:header_length]\n   915\u2192    assert np.isnan(struct.unpack(\"<4d\", actual[header_length:])).all()\n   916\u2192\n   917\u2192\n   918\u2192@pytest.mark.parametrize(\n   919\u2192    \"geom,expected\",\n   920\u2192    [\n   921\u2192        pytest.param(empty_point, POINT_NAN_WKB, id=\"POINT EMPTY\"),\n   922\u2192        pytest.param(multi_point_empty, MULTIPOINT_NAN_WKB, id=\"MULTIPOINT EMPTY\"),\n   923\u2192        pytest.param(\n   924\u2192            shapely.geometrycollections([empty_point]),\n   925\u2192            GEOMETRYCOLLECTION_NAN_WKB,\n   926\u2192            id=\"GEOMETRYCOLLECTION (POINT EMPTY)\",\n   927\u2192        ),\n   928\u2192        pytest.param(\n   929\u2192            shapely.geometrycollections([multi_point_empty]),\n   930\u2192            NESTED_COLLECTION_NAN_WKB,\n   931\u2192            id=\"GEOMETRYCOLLECTION (MULTIPOINT EMPTY)\",\n   932\u2192        ),\n   933\u2192    ],\n   934\u2192)\n   935\u2192def test_to_wkb_point_empty_2d_output_dim_3(geom, expected):\n   936\u2192    actual = shapely.to_wkb(geom, output_dimension=3, byte_order=1)\n   937\u2192    # Split 'actual' into header and coordinates\n   938\u2192    coordinate_length = 16\n   939\u2192    header_length = len(expected) - coordinate_length\n   940\u2192    # Check the total length (this checks the correct dimensionality)\n   941\u2192    assert len(actual) == header_length + coordinate_length\n   942\u2192    # Check the header\n   943\u2192    assert actual[:header_length] == expected[:header_length]\n   944\u2192    # Check the coordinates (using numpy.isnan; there are many byte representations for\n   945\u2192    # NaN)\n   946\u2192    assert np.isnan(struct.unpack(\"<2d\", actual[header_length:])).all()\n   947\u2192\n   948\u2192\n   949\u2192@pytest.mark.parametrize(\n   950\u2192    \"wkb,e