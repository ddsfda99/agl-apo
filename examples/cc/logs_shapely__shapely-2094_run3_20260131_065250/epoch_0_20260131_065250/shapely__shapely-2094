                        "content": "     1\u2192import warnings\n     2\u2192from enum import IntEnum\n     3\u2192\n     4\u2192import numpy as np\n     5\u2192\n     6\u2192from shapely import _geometry_helpers, geos_version, lib\n     7\u2192from shapely._enum import ParamEnum\n     8\u2192from shapely.decorators import multithreading_enabled, requires_geos\n     9\u2192\n    10\u2192__all__ = [\n    11\u2192    \"GeometryType\",\n    12\u2192    \"get_type_id\",\n    13\u2192    \"get_dimensions\",\n    14\u2192    \"get_coordinate_dimension\",\n    15\u2192    \"get_num_coordinates\",\n    16\u2192    \"get_srid\",\n    17\u2192    \"set_srid\",\n    18\u2192    \"get_x\",\n    19\u2192    \"get_y\",\n    20\u2192    \"get_z\",\n    21\u2192    \"get_m\",\n    22\u2192    \"get_exterior_ring\",\n    23\u2192    \"get_num_points\",\n    24\u2192    \"get_num_interior_rings\",\n    25\u2192    \"get_num_geometries\",\n    26\u2192    \"get_point\",\n    27\u2192    \"get_interior_ring\",\n    28\u2192    \"get_geometry\",\n    29\u2192    \"get_parts\",\n    30\u2192    \"get_rings\",\n    31\u2192    \"get_precision\",\n    32\u2192    \"set_precision\",\n    33\u2192    \"force_2d\",\n    34\u2192    \"force_3d\",\n    35\u2192]\n    36\u2192\n    37\u2192\n    38\u2192class GeometryType(IntEnum):\n    39\u2192    \"\"\"The enumeration of GEOS geometry types.\"\"\"\n    40\u2192\n    41\u2192    MISSING = -1\n    42\u2192    POINT = 0\n    43\u2192    LINESTRING = 1\n    44\u2192    LINEARRING = 2\n    45\u2192    POLYGON = 3\n    46\u2192    MULTIPOINT = 4\n    47\u2192    MULTILINESTRING = 5\n    48\u2192    MULTIPOLYGON = 6\n    49\u2192    GEOMETRYCOLLECTION = 7\n    50\u2192\n    51\u2192\n    52\u2192# generic\n    53\u2192\n    54\u2192\n    55\u2192@multithreading_enabled\n    56\u2192def get_type_id(geometry, **kwargs):\n    57\u2192    \"\"\"Return the type ID of a geometry.\n    58\u2192\n    59\u2192    Possible values are:\n    60\u2192\n    61\u2192    - None (missing) is -1\n    62\u2192    - POINT is 0\n    63\u2192    - LINESTRING is 1\n    64\u2192    - LINEARRING is 2\n    65\u2192    - POLYGON is 3\n    66\u2192    - MULTIPOINT is 4\n    67\u2192    - MULTILINESTRING is 5\n    68\u2192    - MULTIPOLYGON is 6\n    69\u2192    - GEOMETRYCOLLECTION is 7\n    70\u2192\n    71\u2192    Parameters\n    72\u2192    ----------\n    73\u2192    geometry : Geometry or array_like\n    74\u2192        Geometry or geometries to get the type ID of.\n    75\u2192    **kwargs\n    76\u2192        See :ref:`NumPy ufunc docs <ufuncs.kwargs>` for other keyword arguments.\n    77\u2192\n    78\u2192    See Also\n    79\u2192    --------\n    80\u2192    GeometryType\n    81\u2192\n    82\u2192    Examples\n    83\u2192    --------\n    84\u2192    >>> from shapely import LineString, Point\n    85\u2192    >>> get_type_id(LineString([(0, 0), (1, 1), (2, 2), (3, 3)]))\n    86\u2192    1\n    87\u2192    >>> get_type_id([Point(1, 2), Point(2, 3)]).tolist()\n    88\u2192    [0, 0]\n    89\u2192\n    90\u2192    \"\"\"\n    91\u2192    return lib.get_type_id(geometry, **kwargs)\n    92\u2192\n    93\u2192\n    94\u2192@multithreading_enabled\n    95\u2192def get_dimensions(geometry, **kwargs):\n    96\u2192    \"\"\"Return the inherent dimensionality of a geometry.\n    97\u2192\n    98\u2192    The inherent dimension is 0 for points, 1 for linestrings and linearrings,\n    99\u2192    and 2 for polygons. For geometrycollections it is the max of the containing\n   100\u2192    elements. Empty collections and None values return -1.\n   101\u2192\n   102\u2192    Parameters\n   103\u2192    ----------\n   104\u2192    geometry : Geometry or array_like\n   105\u2192        Geometry or geometries to get the dimensionality of.\n   106\u2192    **kwargs\n   107\u2192        See :ref:`NumPy ufunc docs <ufuncs.kwargs>` for other keyword arguments.\n   108\u2192\n   109\u2192    Examples\n   110\u2192    --------\n   111\u2192    >>> from shapely import GeometryCollection, Point, Polygon\n   112\u2192    >>> point = Point(0, 0)\n   113\u2192    >>> get_dimensions(point)\n   114\u2192    0\n   115\u2192    >>> polygon = Polygon([(0, 0), (0, 10), (10, 10), (10, 0), (0, 0)])\n   116\u2192    >>> get_dimensions(polygon)\n   117\u2192    2\n   118\u2192    >>> get_dimensions(GeometryCollection([point, polygon]))\n   119\u2192    2\n   120\u2192    >>> get_dimensions(GeometryCollection([]))\n   121\u2192    -1\n   122\u2192    >>> get_dimensions(None)\n   123\u2192    -1\n   124\u2192\n   125\u2192    \"\"\"\n   126\u2192    return lib.get_dimensions(geometry, **kwargs)\n   127\u2192\n   128\u2192\n   129\u2192@multithreading_enabled\n   130\u2192def get_coordinate_dimension(geometry, **kwargs):\n   131\u2192    \"\"\"Return the dimensionality of the coordinates in a geometry (2, 3 or 4).\n   132\u2192\n   133\u2192    The return value can be one of the following:\n   134\u2192\n   135\u2192    * Return 2 for geometries with XY coordinate types,\n   136\u2192    * Return 3 for XYZ or XYM coordinate types\n   137\u2192      (distinguished by :meth:`has_z` or :meth:`has_m`),\n   138\u2192    * Return 4 for XYZM coordinate types,\n   139\u2192    * Return -1 for missing geometries (``None`` values).\n   140\u2192\n   141\u2192    Note that with GEOS < 3.12, if the first Z coordinate equals ``nan``, this function\n   142\u2192    will return ``2``. Geometries with M coordinates are supported with GEOS >= 3.12.\n   143\u2192\n   144\u2192    Parameters\n   145\u2192    ----------\n   146\u2192    geometry : Geometry or array_like\n   147\u2192        Geometry or geometries to get the coordinate dimension of.\n   148\u2192    **kwargs\n   149\u2192        See :ref:`NumPy ufunc docs <ufuncs.kwargs>` for other keyword arguments.\n   150\u2192\n   151\u2192    Examples\n   152\u2192    --------\n   153\u2192    >>> from shapely import Point\n   154\u2192    >>> get_coordinate_dimension(Point(0, 0))\n   155\u2192    2\n   156\u2192    >>> get_coordinate_dimension(Point(0, 0, 1))\n   157\u2192    3\n   158\u2192    >>> get_coordinate_dimension(None)\n   159\u2192    -1\n   160\u2192\n   161\u2192    \"\"\"\n   162\u2192    return lib.get_coordinate_dimension(geometry, **kwargs)\n   163\u2192\n   164\u2192\n   165\u2192@multithreading_enabled\n   166\u2192def get_num_coordinates(geometry, **kwargs):\n   167\u2192    \"\"\"Return the total number of coordinates in a geometry.\n   168\u2192\n   169\u2192    Returns 0 for not-a-geometry values.\n   170\u2192\n   171\u2192    Parameters\n   172\u2192    ----------\n   173\u2192    geometry : Geometry or array_like\n   174\u2192        Geometry or geometries to get the number of coordinates of.\n   175\u2192    **kwargs\n   176\u2192        See :ref:`NumPy ufunc docs <ufuncs.kwargs>` for other keyword arguments.\n   177\u2192\n   178\u2192    Examples\n   179\u2192    --------\n   180\u2192    >>> from shapely import GeometryCollection, LineString, Point\n   181\u2192    >>> point = Point(0, 0)\n   182\u2192    >>> get_num_coordinates(point)\n   183\u2192    1\n   184\u2192    >>> get_num_coordinates(Point(0, 0, 0))\n   185\u2192    1\n   186\u2192    >>> line = LineString([(0, 0), (1, 1)])\n   187\u2192    >>> get_num_coordinates(line)\n   188\u2192    2\n   189\u2192    >>> get_num_coordinates(GeometryCollection([point, line]))\n   190\u2192    3\n   191\u2192    >>> get_num_coordinates(None)\n   192\u2192    0\n   193\u2192\n   194\u2192    \"\"\"\n   195\u2192    return lib.get_num_coordinates(geometry, **kwargs)\n   196\u2192\n   197\u2192\n   198\u2192@multithreading_enabled\n   199\u2192def get_srid(geometry, **kwargs):\n   200\u2192    \"\"\"Return the SRID of a geometry.\n   201\u2192\n   202\u2192    Returns -1 for not-a-geometry values.\n   203\u2192\n   204\u2192    Parameters\n   205\u2192    ----------\n   206\u2192    geometry : Geometry or array_like\n   207\u2192        Geometry or geometries to get the SRID of.\n   208\u2192    **kwargs\n   209\u2192        See :ref:`NumPy ufunc docs <ufuncs.kwargs>` for other keyword arguments.\n   210\u2192\n   211\u2192    See Also\n   212\u2192    --------\n   213\u2192    set_srid\n   214\u2192\n   215\u2192    Examples\n   216\u2192    --------\n   217\u2192    >>> from shapely import Point\n   218\u2192    >>> point = Point(0, 0)\n   219\u2192    >>> get_srid(point)\n   220\u2192    0\n   221\u2192    >>> with_srid = set_srid(point, 4326)\n   222\u2192    >>> get_srid(with_srid)\n   223\u2192    4326\n   224\u2192\n   225\u2192    \"\"\"\n   226\u2192    return lib.get_srid(geometry, **kwargs)\n   227\u2192\n   228\u2192\n   229\u2192@multithreading_enabled\n   230\u2192def set_srid(geometry, srid, **kwargs):\n   231\u2192    \"\"\"Return a geometry with its SRID set.\n   232\u2192\n   233\u2192    Parameters\n   234\u2192    ----------\n   235\u2192    geometry : Geometry or array_like\n   236\u2192        Geometry or geometries to set the SRID of.\n   237\u2192    srid : int\n   238\u2192        The SRID to set on the geometry.\n   239\u2192    **kwargs\n   240\u2192        See :ref:`NumPy ufunc docs <ufuncs.kwargs>` for other keyword arguments.\n   241\u2192\n   242\u2192    See Also\n   243\u2192    --------\n   244\u2192    get_srid\n   245\u2192\n   246\u2192    Examples\n   247\u2192    --------\n   248\u2192    >>> from shapely import Point\n   249\u2192    >>> point = Point(0, 0)\n   250\u2192    >>> get_srid(point)\n   251\u2192    0\n   252\u2192    >>> with_srid = set_srid(point, 4326)\n   253\u2192    >>> get_srid(with_srid)\n   254\u2192    4326\n   255\u2192\n   256\u2192    \"\"\"\n   257\u2192    return lib.set_srid(geometry, np.intc(srid), **kwargs)\n   258\u2192\n   259\u2192\n   260\u2192# points\n   261\u2192\n   262\u2192\n   263\u2192@multithreading_enabled\n   264\u2192def get_x(point, **kwargs):\n   265\u2192    \"\"\"Return the x-coordinate of a point.\n   266\u2192\n   267\u2192    Parameters\n   268\u2192    ----------\n   269\u2192    point : Geometry or array_like\n   270\u2192        Non-point geometries will result in NaN being returned.\n   271\u2192    **kwargs\n   272\u2192        See :ref:`NumPy ufunc docs <ufuncs.kwargs>` for other keyword arguments.\n   273\u2192\n   274\u2192    See Also\n   275\u2192    --------\n   276\u2192    get_y, get_z, get_m\n   277\u2192\n   278\u2192    Examples\n   279\u2192    --------\n   280\u2192    >>> from shapely import MultiPoint, Point\n   281\u2192    >>> get_x(Point(1, 2))\n   282\u2192    1.0\n   283\u2192    >>> get_x(MultiPoint([(1, 1), (1, 2)]))\n   284\u2192    nan\n   285\u2192\n   286\u2192    \"\"\"\n   287\u2192    return lib.get_x(point, **kwargs)\n   288\u2192\n   289\u2192\n   290\u2192@multithreading_enabled\n   291\u2192def get_y(point, **kwargs):\n   292\u2192    \"\"\"Return the y-coordinate of a point.\n   293\u2192\n   294\u2192    Parameters\n   295\u2192    ----------\n   296\u2192    point : Geometry or array_like\n   297\u2192        Non-point geometries will result in NaN being returned.\n   298\u2192    **kwargs\n   299\u2192        See :ref:`NumPy ufunc docs <ufuncs.kwargs>` for other keyword arguments.\n   300\u2192\n   301\u2192    See Also\n   302\u2192    --------\n   303\u2192    get_x, get_z, get_m\n   304\u2192\n   305\u2192    Examples\n   306\u2192    --------\n   307\u2192    >>> from shapely import MultiPoint, Point\n   308\u2192    >>> get_y(Point(1, 2))\n   309\u2192    2.0\n   310\u2192    >>> get_y(MultiPoint([(1, 1), (1, 2)]))\n   311\u2192    nan\n   312\u2192\n   313\u2192    \"\"\"\n   314\u2192    return lib.get_y(point, **kwargs)\n   315\u2192\n   316\u2192\n   317\u2192@multithreading_enabled\n   318\u2192def get_z(point, **kwargs):\n   319\u2192    \"\"\"Return the z-coordinate of a point.\n   320\u2192\n   321\u2192    Parameters\n   322\u2192    ----------\n   323\u2192    point : Geometry or array_like\n   324\u2192        Non-point geometries or geometries without Z dimension will result\n   325\u2192        in NaN being returned.\n   326\u2192    **kwargs\n   327\u2192        See :ref:`NumPy ufunc docs <ufuncs.kwargs>` for other keyword arguments.\n   328\u2192\n   329\u2192    See Also\n   330\u2192    --------\n   331\u2192    get_x, get_y, get_m\n   332\u2192\n   333\u2192    Examples\n   334\u2192    --------\n   335\u2192    >>> from shapely import MultiPoint, Point\n   336\u2192    >>> get_z(Point(1, 2, 3))\n   337\u2192    3.0\n   338\u2192    >>> get_z(Point(1, 2))\n   339\u2192    nan\n   340\u2192    >>> get_z(MultiPoint([(1, 1, 1), (2, 2, 2)]))\n   341\u2192    nan\n   342\u2192\n   343\u2192    \"\"\"\n   344\u2192    return lib.get_z(point, **kwargs)\n   345\u2192\n   346\u2192\n   347\u2192@multithreading_enabled\n   348\u2192@requires_geos(\"3.12.0\")\n   349\u2192def get_m(point, **kwargs):\n   350\u2192    \"\"\"Return the m-coordinate of a point.\n   351\u2192\n   352\u2192    .. versionadded:: 2.1.0\n   353\u2192\n   354\u2192    Parameters\n   355\u2192    ----------\n   356\u2192    point : Geometry or array_like\n   357\u2192        Non-point geometries or geometries without M dimension will result\n   358\u2192        in NaN being returned.\n   359\u2192    **kwargs\n   360\u2192        See :ref:`NumPy ufunc docs <ufuncs.kwargs>` for other keyword arguments.\n   361\u2192\n   362\u2192    See Also\n   363\u2192    --------\n   364\u2192    get_x, get_y, get_z\n   365\u2192\n   366\u2192    Examples\n   367\u2192    --------\n   368\u2192    >>> from shapely import Point, from_wkt\n   369\u2192    >>> get_m(from_wkt(\"POINT ZM (1 2 3 4)\"))\n   370\u2192    4.0\n   371\u2192    >>> get_m(from_wkt(\"POINT M (1 2 4)\"))\n   372\u2192    4.0\n   373\u2192    >>> get_m(Point(1, 2, 3))\n   374\u2192    nan\n   375\u2192    >>> get_m(from_wkt(\"MULTIPOINT M ((1 1 1), (2 2 2))\"))\n   376\u2192    nan\n   377\u2192\n   378\u2192    \"\"\"\n   379\u2192    return lib.get_m(point, **kwargs)\n   380\u2192\n   381\u2192\n   382\u2192# linestrings\n   383\u2192\n   384\u2192\n   385\u2192@multithreading_enabled\n   386\u2192def get_point(geometry, index, **kwargs):\n   387\u2192    \"\"\"Return the nth point of a linestring or linearring.\n   388\u2192\n   389\u2192    Parameters\n   390\u2192    ----------\n   391\u2192    geometry : Geometry or array_like\n   392\u2192        Geometry or geometries to get the point of.\n   393\u2192    index : int or array_like\n   394\u2192        Negative values count from the end of the linestring backwards.\n   395\u2192    **kwargs\n   396\u2192        See :ref:`NumPy ufunc docs <ufuncs.kwargs>` for other keyword arguments.\n   397\u2192\n   398\u2192    See Also\n   399\u2192    --------\n   400\u2192    get_num_points\n   401\u2192\n   402\u2192    Examples\n   403\u2192    --------\n   404\u2192    >>> from shapely import LinearRing, LineString, MultiPoint, Point\n   405\u2192    >>> line = LineString([(0, 0), (1, 1), (2, 2), (3, 3)])\n   406\u2192    >>> get_point(line, 1)\n   407\u2192    <POINT (1 1)>\n   408\u2192    >>> get_point(line, -2)\n   409\u2192    <POINT (2 2)>\n   410\u2192    >>> get_point(line, [0, 3]).tolist()\n   411\u2192    [<POINT (0 0)>, <POINT (3 3)>]\n   412\u2192\n   413\u2192    The function works the same for LinearRing input:\n   414\u2192\n   415\u2192    >>> get_point(LinearRing([(0, 0), (1, 1), (2, 2), (0, 0)]), 1)\n   416\u2192    <POINT (1 1)>\n   417\u2192\n   418\u2192    For non-linear geometries it returns None:\n   419\u2192\n   420\u2192    >>> get_point(MultiPoint([(0, 0), (1, 1), (2, 2), (3, 3)]), 1) is None\n   421\u2192    True\n   422\u2192    >>> get_point(Point(1, 1), 0) is None\n   423\u2192    True\n   424\u2192\n   425\u2192    \"\"\"\n   426\u2192    return lib.get_point(geometry, np.intc(index), **kwargs)\n   427\u2192\n   428\u2192\n   429\u2192@multithreading_enabled\n   430\u2192def get_num_points(geometry, **kwargs):\n   431\u2192    \"\"\"Return the number of points in a linestring or linearring.\n   432\u2192\n   433\u2192    Returns 0 for not-a-geometry values. The number of points in geometries\n   434\u2192    other than linestring or linearring equals zero.\n   435\u2192\n   436\u2192    Parameters\n   437\u2192    ----------\n   438\u2192    geometry : Geometry or array_like\n   439\u2192        Geometry or geometries to get the number of points of.\n   440\u2192    **kwargs\n   441\u2192        See :ref:`NumPy ufunc docs <ufuncs.kwargs>` for other keyword arguments.\n   442\u2192\n   443\u2192    See Also\n   444\u2192    --------\n   445\u2192    get_point\n   446\u2192    get_num_geometries\n   447\u2192\n   448\u2192    Examples\n   449\u2192    --------\n   450\u2192    >>> from shapely import LineString, MultiPoint\n   451\u2192    >>> get_num_points(LineString([(0, 0), (1, 1), (2, 2), (3, 3)]))\n   452\u2192    4\n   453\u2192    >>> get_num_points(MultiPoint([(0, 0), (1, 1), (2, 2), (3, 3)]))\n   454\u2192    0\n   455\u2192    >>> get_num_points(None)\n   456\u2192    0\n   457\u2192\n   458\u2192    \"\"\"\n   459\u2192    return lib.get_num_points(geometry, **kwargs)\n   460\u2192\n   461\u2192\n   462\u2192# polygons\n   463\u2192\n   464\u2192\n   465\u2192@multithreading_enabled\n   466\u2192def get_exterior_ring(geometry, **kwargs):\n   467\u2192    \"\"\"Return the exterior ring of a polygon.\n   468\u2192\n   469\u2192    Parameters\n   470\u2192    ----------\n   471\u2192    geometry : Geometry or array_like\n   472\u2192        Geometry or geometries to get the exterior ring of.\n   473\u2192    **kwargs\n   474\u2192        See :ref:`NumPy ufunc docs <ufuncs.kwargs>` for other keyword arguments.\n   475\u2192\n   476\u2192    See Also\n   477\u2192    --------\n   478\u2192    get_interior_ring\n   479\u2192\n   480\u2192    Examples\n   481\u2192    --------\n   482\u2192    >>> from shapely import Point, Polygon\n   483\u2192    >>> get_exterior_ring(Polygon([(0, 0), (0, 10), (10, 10), (10, 0), (0, 0)]))\n   484\u2192    <LINEARRING (0 0, 0 10, 10 10, 10 0, 0 0)>\n   485\u2192    >>> get_exterior_ring(Point(1, 1)) is None\n   486\u2192    True\n   487\u2192\n   488\u2192    \"\"\"\n   489\u2192    return lib.get_exterior_ring(geometry, **kwargs)\n   490\u2192\n   491\u2192\n   492\u2192@multithreading_enabled\n   493\u2192def get_interior_ring(geometry, index, **kwargs):\n   494\u2192    \"\"\"Return the nth interior ring of a polygon.\n   495\u2192\n   496\u2192    The number of interior rings in non-polygons equals zero.\n   497\u2192\n   498\u2192    Parameters\n   499\u2192    ----------\n   500\u2192    geometry : Geometry or array_like\n   501\u2192        Geometry or geometries to get the interior ring of.\n   502\u2192    index : int or array_like\n   503\u2192        Negative values count from the end of the interior rings backwards.\n   504\u2192    **kwargs\n   505\u2192        See :ref:`NumPy ufunc docs <ufuncs.kwargs>` for other keyword arguments.\n   506\u2192\n   507\u2192    See Also\n   508\u2192    --------\n   509\u2192    get_exterior_ring\n   510\u2192    get_num_interior_rings\n   511\u2192\n   512\u2192    Examples\n   513\u2192    --------\n   514\u2192    >>> from shapely import Point, Polygon\n   515\u2192    >>> polygon_with_hole = Polygon(\n   516\u2192    ...     [(0, 0), (0, 10), (10, 10), (10, 0), (0, 0)],\n   517\u2192    ...     holes=[[(2, 2), (2, 4), (4, 4), (4, 2), (2, 2)]]\n   518\u2192    ... )\n   519\u2192    >>> get_interior_ring(polygon_with_hole, 0)\n   520\u2192    <LINEARRING (2 2, 2 4, 4 4, 4 2, 2 2)>\n   521\u2192    >>> get_interior_ring(polygon_with_hole, 1) is None\n   522\u2192    True\n   523\u2192    >>> polygon = Polygon([(0, 0), (0, 10), (10, 10), (10, 0), (0, 0)])\n   524\u2192    >>> get_interior_ring(polygon, 0) is None\n   525\u2192    True\n   526\u2192    >>> get_interior_ring(Point(0, 0), 0) is None\n   527\u2192    True\n   528\u2192\n   529\u2192    \"\"\"\n   530\u2192    return lib.get_interior_ring(geometry, np.intc(index), **kwargs)\n   531\u2192\n   532\u2192\n   533\u2192@multithreading_enabled\n   534\u2192def get_num_interior_rings(geometry, **kwargs):\n   535\u2192    \"\"\"Return number of internal rings in a polygon.\n   536\u2192\n   537\u2192    Returns 0 for not-a-geometry values.\n   538\u2192\n   539\u2192    Parameters\n   540\u2192    ----------\n   541\u2192    geometry : Geometry or array_like\n   542\u2192        Geometry or geometries to get the number of interior rings of.\n   543\u2192    **kwargs\n   544\u2192        See :ref:`NumPy ufunc docs <ufuncs.kwargs>` for other keyword arguments.\n   545\u2192\n   546\u2192    See Also\n   547\u2192    --------\n   548\u2192    get_exterior_ring\n   549\u2192    get_interior_ring\n   550\u2192\n   551\u2192    Examples\n   552\u2192    --------\n   553\u2192    >>> from shapely import Point, Polygon\n   554\u2192    >>> polygon = Polygon([(0, 0), (0, 10), (10, 10), (10, 0), (0, 0)])\n   555\u2192    >>> get_num_interior_rings(polygon)\n   556\u2192    0\n   557\u2192    >>> polygon_with_hole = Polygon(\n   558\u2192    ...     [(0, 0), (0, 10), (10, 10), (10, 0), (0, 0)],\n   559\u2192    ...     holes=[[(2, 2), (2, 4), (4, 4), (4, 2), (2, 2)]]\n   560\u2192    ... )\n   561\u2192    >>> get_num_interior_rings(polygon_with_hole)\n   562\u2192    1\n   563\u2192    >>> get_num_interior_rings(Point(0, 0))\n   564\u2192    0\n   565\u2192    >>> get_num_interior_rings(None)\n   566\u2192    0\n   567\u2192\n   568\u2192    \"\"\"\n   569\u2192    return lib.get_num_interior_rings(geometry, **kwargs)\n   570\u2192\n   571\u2192\n   572\u2192# collections\n   573\u2192\n   574\u2192\n   575\u2192@multithreading_enabled\n   576\u2192def get_geometry(geometry, index, **kwargs):\n   577\u2192    \"\"\"Return the nth geometry from a collection of geometries.\n   578\u2192\n   579\u2192    Parameters\n   580\u2192    ----------\n   581\u2192    geometry : Geometry or array_like\n   582\u2192        Geometry or geometries to get the nth geometry of.\n   583\u2192    index : int or array_like\n   584\u2192        Negative values count from the end of the collection backwards.\n   585\u2192    **kwargs\n   586\u2192        See :ref:`NumPy ufunc docs <ufuncs.kwargs>` for other keyword arguments.\n   587\u2192\n   588\u2192    Notes\n   589\u2192    -----\n   590\u2192    - simple geometries act as length-1 collections\n   591\u2192    - out-of-range values return None\n   592\u2192\n   593\u2192    See Also\n   594\u2192    --------\n   595\u2192    get_num_geometries, get_parts\n   596\u2192\n   597\u2192    Examples\n   598\u2192    --------\n   599\u2192    >>> from shapely import Point, MultiPoint\n   600\u2192    >>> multipoint = MultiPoint([(0, 0), (1, 1), (2, 2), (3, 3)])\n   601\u2192    >>> get_geometry(multipoint, 1)\n   602\u2192    <POINT (1 1)>\n   603\u2192    >>> get_geometry(multipoint, -1)\n   604\u2192    <POINT (3 3)>\n   605\u2192    >>> get_geometry(multipoint, 5) is None\n   606\u2192    True\n   607\u2192    >>> get_geometry(Point(1, 1), 0)\n   608\u2192    <POINT (1 1)>\n   609\u2192    >>> get_geometry(Point(1, 1), 1) is None\n   610\u2192    True\n   611\u2192\n   612\u2192    \"\"\"\n   613\u2192    return lib.get_geometry(geometry, np.intc(index), **kwargs)\n   614\u2192\n   615\u2192\n   616\u2192def get_parts(geometry, return_index=False):\n   617\u2192    \"\"\"Get parts of each GeometryCollection or Multi* geometry object.\n   618\u2192\n   619\u2192    A copy of each geometry in the GeometryCollection or Multi* geometry object\n   620\u2192    is returned.\n   621\u2192\n   622\u2192    Note: This does not return the individual parts of Multi* geometry objects\n   623\u2192    in a GeometryCollection. You may need to call this function multiple times\n   624\u2192    to return individual parts of Multi* geometry objects in a\n   625\u2192    GeometryCollection.\n   626\u2192\n   627\u2192    Parameters\n   628\u2192    ----------\n   629\u2192    geometry : Geometry or array_like\n   630\u2192        Geometry or geometries to get the parts of.\n   631\u2192    return_index : bool, default False\n   632\u2192        If True, will return a tuple of ndarrays of (parts, indexes), where\n   633\u2192        indexes are the indexes of the original geometries in the source array.\n   634\u2192\n   635\u2192    Returns\n   636\u2192    -------\n   637\u2192    ndarray of parts or tuple of (parts, indexes)\n   638\u2192\n   639\u2192    See Also\n   640\u2192    --------\n   641\u2192    get_geometry, get_rings\n   642\u2192\n   643\u2192    Examples\n   644\u2192    --------\n   645\u2192    >>> from shapely import MultiPoint\n   646\u2192    >>> get_parts(MultiPoint([(0, 1), (2, 3)])).tolist()\n   647\u2192    [<POINT (0 1)>, <POINT (2 3)>]\n   648\u2192    >>> parts, index = get_parts([MultiPoint([(0, 1)]), MultiPoint([(4, 5), (6, 7)])], \\\n   649\u2192return_index=True)\n   650\u2192    >>> parts.tolist()\n   651\u2192    [<POINT (0 1)>, <POINT (4 5)>, <POINT (6 7)>]\n   652\u2192    >>> index.tolist()\n   653\u2192    [0, 1, 1]\n   654\u2192\n   655\u2192    \"\"\"\n   656\u2192    geometry = np.asarray(geometry, dtype=np.object_)\n   657\u2192    geometry = np.atleast_1d(geometry)\n   658\u2192\n   659\u2192    if geometry.ndim != 1:\n   660\u2192        raise ValueError(\"Array should be one dimensional\")\n   661\u2192\n   662\u2192    if return_index:\n   663\u2192        return _geometry_helpers.get_parts(geometry)\n   664\u2192\n   665\u2192    return _geometry_helpers.get_parts(geometry)[0]\n   666\u2192\n   667\u2192\n   668\u2192def get_rings(geometry, return_index=False):\n   669\u2192    \"\"\"Get rings of Polygon geometry object.\n   670\u2192\n   671\u2192    For each Polygon, the first returned ring is always the exterior ring\n   672\u2192    and potential subsequent rings are interior rings.\n   673\u2192\n   674\u2192    If the geometry is not a Polygon, nothing is returned (empty array for\n   675\u2192    scalar geometry input or no element in output array for array input).\n   676\u2192\n   677\u2192    Parameters\n   678\u2192    ----------\n   679\u2192    geometry : Geometry or array_like\n   680\u2192        Geometry or geometries to get the rings of.\n   681\u2192    return_index : bool, default False\n   682\u2192        If True, will return a tuple of ndarrays of (rings, indexes), where\n   683\u2192        indexes are the indexes of the original geometries in the source array.\n   684\u2192\n   685\u2192    Returns\n   686\u2192    -------\n   687\u2192    ndarray of rings or tuple of (rings, indexes)\n   688\u2192\n   689\u2192    See Also\n   690\u2192    --------\n   691\u2192    get_exterior_ring, get_interior_ring, get_parts\n   692\u2192\n   693\u2192    Examples\n   694\u2192    --------\n   695\u2192    >>> from shapely import Polygon\n   696\u2192    >>> polygon_with_hole = Polygon(\n   697\u2192    ...     [(0, 0), (0, 10), (10, 10), (10, 0), (0, 0)],\n   698\u2192    ...     holes=[[(2, 2), (2, 4), (4, 4), (4, 2), (2, 2)]]\n   699\u2192    ... )\n   700\u2192    >>> get_rings(polygon_with_hole).tolist()\n   701\u2192    [<LINEARRING (0 0, 0 10, 10 10, 10 0, 0 0)>,\n   702\u2192     <LINEARRING (2 2, 2 4, 4 4, 4 2, 2 2)>]\n   703\u2192\n   704\u2192    With ``return_index=True``:\n   705\u2192\n   706\u2192    >>> polygon = Polygon([(0, 0), (2, 0), (2, 2), (0, 2), (0, 0)])\n   707\u2192    >>> rings, index = get_rings([polygon, polygon_with_hole], return_index=True)\n   708\u2192    >>> rings.tolist()\n   709\u2192    [<LINEARRING (0 0, 2 0, 2 2, 0 2, 0 0)>,\n   710\u2192     <LINEARRING (0 0, 0 10, 10 10, 10 0, 0 0)>,\n   711\u2192     <LINEARRING (2 2, 2 4, 4 4, 4 2, 2 2)>]\n   712\u2192    >>> index.tolist()\n   713\u2192    [0, 1, 1]\n   714\u2192\n   715\u2192    \"\"\"\n   716\u2192    geometry = np.asarray(geometry, dtype=np.object_)\n   717\u2192    geometry = np.atleast_1d(geometry)\n   718\u2192\n   719\u2192    if geometry.ndim != 1:\n   720\u2192        raise ValueError(\"Array should be one dimensional\")\n   721\u2192\n   722\u2192    if return_index:\n   723\u2192        return _geometry_helpers.get_parts(geometry, extract_rings=True)\n   724\u2192\n   725\u2192    return _geometry_helpers.get_parts(geometry, extract_rings=True)[0]\n   726\u2192\n   727\u2192\n   728\u2192@multithreading_enabled\n   729\u2192def get_num_geometries(geometry, **kwargs):\n   730\u2192    \"\"\"Return number of geometries in a collection.\n   731\u2192\n   732\u2192    Returns 0 for not-a-geometry values. The number of geometries in points,\n   733\u2192    linestrings, linearrings and polygons equals one.\n   734\u2192\n   735\u2192    Parameters\n   736\u2192    ----------\n   737\u2192    geometry : Geometry or array_like\n   738\u2192        Geometry or geometries to get the number of geometries of.\n   739\u2192    **kwargs\n   740\u2192        See :ref:`NumPy ufunc docs <ufuncs.kwargs>` for other keyword arguments.\n   741\u2192\n   742\u2192    See Also\n   743\u2192    --------\n   744\u2192    get_num_points\n   745\u2192    get_geometry\n   746\u2192\n   747\u2192    Examples\n   748\u2192    --------\n   749\u2192    >>> from shapely import MultiPoint, Point\n   750\u2192    >>> get_num_geometries(MultiPoint([(0, 0), (1, 1), (2, 2), (3, 3)]))\n   751\u2192    4\n   752\u2192    >>> get_num_geometries(Point(1, 1))\n   753\u2192    1\n   754\u2192    >>> get_num_geometries(None)\n   755\u2192    0\n   756\u2192\n   757\u2192    \"\"\"\n   758\u2192    return lib.get_num_geometries(geometry, **kwargs)\n   759\u2192\n   760\u2192\n   761\u2192@multithreading_enabled\n   762\u2192def get_precision(geometry, **kwargs):\n   763\u2192    \"\"\"Get the precision of a geometry.\n   764\u2192\n   765\u2192    If a precision has not been previously set, it will be 0 (double\n   766\u2192    precision). Otherwise, it will return the precision grid size that was\n   767\u2192    set on a geometry.\n   768\u2192\n   769\u2192    Returns NaN for not-a-geometry values.\n   770\u2192\n   771\u2192    Parameters\n   772\u2192    ----------\n   773\u2192    geometry : Geometry or array_like\n   774\u2192        Geometry or geometries to get the precision of.\n   775\u2192    **kwargs\n   776\u2192        See :ref:`NumPy ufunc docs <ufuncs.kwargs>` for other keyword arguments.\n   777\u2192\n   778\u2192    See Also\n   779\u2192    --------\n   780\u2192    set_precision\n   781\u2192\n   782\u2192    Examples\n   783\u2192    --------\n   784\u2192    >>> from shapely import Point\n   785\u2192    >>> point = Point(1, 1)\n   786\u2192    >>> get_precision(point)\n   787\u2192    0.0\n   788\u2192    >>> geometry = set_precision(point, 1.0)\n   789\u2192    >>> get_precision(geometry)\n   790\u2192    1.0\n   791\u2192    >>> get_precision(None)\n   792\u2192    nan\n   793\u2192\n   794\u2192    \"\"\"\n   795\u2192    return lib.get_precision(geometry, **kwargs)\n   796\u2192\n   797\u2192\n   798\u2192class SetPrecisionMode(ParamEnum):\n   799\u2192    valid_output = 0\n   800\u2192    pointwise = 1\n   801\u2192    keep_collapsed = 2\n   802\u2192\n   803\u2192\n   804\u2192@multithreading_enabled\n   805\u2192def set_precision(geometry, grid_size, mode=\"valid_output\", **kwargs):\n   806\u2192    \"\"\"Return geometry with the precision set to a precision grid size.\n   807\u2192\n   808\u2192    By default, geometries use double precision coordinates (grid_size = 0).\n   809\u2192\n   810\u2192    Coordinates will be rounded if the precision grid specified is less precise\n   811\u2192    than the input geometry. Duplicated vertices will be dropped from lines and\n   812\u2192    polygons for grid sizes greater than 0. Line and polygon geometries may\n   813\u2192    collapse to empty geometries if all vertices are closer together than\n   814\u2192    ``grid_size`` or if a polygon becomes significantly narrower than\n   815\u2192    ``grid_size``. Spikes or sections in polygons narrower than ``grid_size``\n   816\u2192    after rounding the vertices will be removed, which can lead to multipolygons\n   817\u2192    or empty geometries. Z values, if present, will not be modified.\n   818\u2192\n   819\u2192    Notes\n   820\u2192    -----\n   821\u2192    * subsequent operations will always be performed in the precision of the\n   822\u2192      geometry with higher precision (smaller \"grid_size\"). That same precision\n   823\u2192      will be attached to the operation outputs.\n   824\u2192    * input geometries should be geometrically valid; unexpected results may\n   825\u2192      occur if input geometries are not.\n   826\u2192    * the geometry returned will be in\n   827\u2192      :ref:`mild canonical form <canonical-form>`, and the order of vertices can\n   828\u2192      change and should not be relied upon.\n   829\u2192    * returns None if geometry is None.\n   830\u2192\n   831\u2192    Parameters\n   832\u2192    ----------\n   833\u2192    geometry : Geometry or array_like\n   834\u2192        Geometry or geometries to set the precision of.\n   835\u2192    grid_size : float\n   836\u2192        Precision grid size. If 0, will use double precision (will not modify\n   837\u2192        geometry if precision grid size was not previously set). If this\n   838\u2192        value is more precise than input geometry, the input geometry will\n   839\u2192        not be modified.\n   840\u2192    mode : {'valid_output', 'pointwise', 'keep_collapsed'}, default 'valid_output'\n   841\u2192        This parameter determines the way a precision reduction is applied on\n   842\u2192        the geometry. There are three modes:\n   843\u2192\n   844\u2192        1. `'valid_output'` (default):  The output is always valid. Collapsed\n   845\u2192           geometry elements (including both polygons and lines) are removed.\n   846\u2192           Duplicate vertices are removed.\n   847\u2192        2. `'pointwise'`: Precision reduction is performed pointwise. Output\n   848\u2192           geometry may be invalid due to collapse or self-intersection.\n   849\u2192           Duplicate vertices are not removed. In GEOS this option is called\n   850\u2192           NO_TOPO.\n   851\u2192\n   852\u2192           .. note::\n   853\u2192\n   854\u2192             'pointwise' mode requires at least GEOS 3.10. It is accepted in\n   855\u2192             earlier versions, but the results may be unexpected.\n   856\u2192        3. `'keep_collapsed'`: Like the default mode, except that collapsed\n   857\u2192           linear geometry elements are preserved. Collapsed polygonal input\n   858\u2192           elements are removed. Duplicate vertices are removed.\n   859\u2192    **kwargs\n   860\u2192        See :ref:`NumPy ufunc docs <ufuncs.kwargs>` for other keyword arguments.\n   861\u2192\n   862\u2192    See Also\n   863\u2192    --------\n   864\u2192    get_precision\n   865\u2192\n   866\u2192    Examples\n   867\u2192    --------\n   868\u2192    >>> from shapely import LineString, Point\n   869\u2192    >>> set_precision(Point(0.9, 0.9), 1.0)\n   870\u2192    <POINT (1 1)>\n   871\u2192    >>> set_precision(Point(0.9, 0.9, 0.9), 1.0)\n   872\u2192    <POINT Z (1 1 0.9)>\n   873\u2192    >>> set_precision(LineString([(0, 0), (0, 0.1), (0, 1), (1, 1)]), 1.0)\n   874\u2192    <LINESTRING (0 0, 0 1, 1 1)>\n   875\u2192    >>> set_precision(LineString([(0, 0), (0, 0.1), (0.1, 0.1)]), 1.0, mode=\"valid_output\")\n   876\u2192    <LINESTRING EMPTY>\n   877\u2192    >>> set_precision(LineString([(0, 0), (0, 0.1), (0.1, 0.1)]), 1.0, mode=\"pointwise\")\n   878\u2192    <LINESTRING (0 0, 0 0, 0 0)>\n   879\u2192    >>> set_precision(LineString([(0, 0), (0, 0.1), (0.1, 0.1)]), 1.0, mode=\"keep_collapsed\")\n   880\u2192    <LINESTRING (0 0, 0 0)>\n   881\u2192    >>> set_precision(None, 1.0) is None\n   882\u2192    True\n   883\u2192\n   884\u2192    \"\"\"  # noqa: E501\n   885\u2192    if isin