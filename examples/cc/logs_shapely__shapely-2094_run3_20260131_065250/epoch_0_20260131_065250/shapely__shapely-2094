 133→    The return value can be one of the following:\n   134→\n   135→    * Return 2 for geometries with XY coordinate types,\n   136→    * Return 3 for XYZ or XYM coordinate types\n   137→      (distinguished by :meth:`has_z` or :meth:`has_m`),\n   138→    * Return 4 for XYZM coordinate types,\n   139→    * Return -1 for missing geometries (``None`` values).\n   140→\n   141→    Note that with GEOS < 3.12, if the first Z coordinate equals ``nan``, this function\n   142→    will return ``2``. Geometries with M coordinates are supported with GEOS >= 3.12.\n   143→\n   144→    Parameters\n   145→    ----------\n   146→    geometry : Geometry or array_like\n   147→        Geometry or geometries to get the coordinate dimension of.\n   148→    **kwargs\n   149→        See :ref:`NumPy ufunc docs <ufuncs.kwargs>` for other keyword arguments.\n   150→\n   151→    Examples\n   152→    --------\n   153→    >>> from shapely import Point\n   154→    >>> get_coordinate_dimension(Point(0, 0))\n   155→    2\n   156→    >>> get_coordinate_dimension(Point(0, 0, 1))\n   157→    3\n   158→    >>> get_coordinate_dimension(None)\n   159→    -1\n   160→\n   161→    \"\"\"\n   162→    return lib.get_coordinate_dimension(geometry, **kwargs)\n   163→\n   164→\n   165→@multithreading_enabled\n   166→def get_num_coordinates(geometry, **kwargs):\n   167→    \"\"\"Return the total number of coordinates in a geometry.\n   168→\n   169→    Returns 0 for not-a-geometry values.\n   170→\n   171→    Parameters\n   172→    ----------\n   173→    geometry : Geometry or array_like\n   174→        Geometry or geometries to get the number of coordinates of.\n   175→    **kwargs\n   176→        See :ref:`NumPy ufunc docs <ufuncs.kwargs>` for other keyword arguments.\n   177→\n   178→    Examples\n   179→    --------\n   180→    >>> from shapely import GeometryCollection, LineString, Point\n   181→    >>> point = Point(0, 0)\n   182→    >>> get_num_coordinates(point)\n   183→    1\n   184→    >>> get_num_coordinates(Point(0, 0, 0))\n   185→    1\n   186→    >>> line = LineString([(0, 0), (1, 1)])\n   187→    >>> get_num_coordinates(line)\n   188→    2\n   189→    >>> get_num_coordinates(GeometryCollection([point, line]))\n   190→    3\n   191→    >>> get_num_coordinates(None)\n   192→    0\n   193→\n   194→    \"\"\"\n   195→    return lib.get_num_coordinates(geometry, **kwargs)\n   196→\n   197→\n   198→@multithreading_enabled\n   199→def get_srid(geometry, **kwargs):\n   200→    \"\"\"Return the SRID of a geometry.\n   201→\n   202→    Returns -1 for not-a-geometry values.\n   203→\n   204→    Parameters\n   205→    ----------\n   206→    geometry : Geometry or array_like\n   207→        Geometry or geometries to get the SRID of.\n   208→    **kwargs\n   209→        See :ref:`NumPy ufunc docs <ufuncs.kwargs>` for other keyword arguments.\n   210→\n   211→    See Also\n   212→    --------\n   213→    set_srid\n   214→\n   215→    Examples\n   216→    --------\n   217→    >>> from shapely import Point\n   218→    >>> point = Point(0, 0)\n   219→    >>> get_srid(point)\n   220→    0\n   221→    >>> with_srid = set_srid(point, 4326)\n   222→    >>> get_srid(with_srid)\n   223→    4326\n   224→\n   225→    \"\"\"\n   226→    return lib.get_srid(geometry, **kwargs)\n   227→\n   228→\n   229→@multithreading_enabled\n   230→def set_srid(geometry, srid, **kwargs):\n   231→    \"\"\"Return a geometry with its SRID set.\n   232→\n   233→    Parameters\n   234→    ----------\n   235→    geometry : Geometry or array_like\n   236→        Geometry or geometries to set the SRID of.\n   237→    srid : int\n   238→        The SRID to set on the geometry.\n   239→    **kwargs\n   240→        See :ref:`NumPy ufunc docs <ufuncs.kwargs>` for other keyword arguments.\n   241→\n   242→    See Also\n   243→    --------\n   244→    get_srid\n   245→\n   246→    Examples\n   247→    --------\n   248→    >>> from shapely import Point\n   249→    >>> point = Point(0, 0)\n   250→    >>> get_srid(point)\n   251→    0\n   252→    >>> with_srid = set_srid(point, 4326)\n   253→    >>> get_srid(with_srid)\n   254→    4326\n   255→\n   256→    \"\"\"\n   257→    return lib.set_srid(geometry, np.intc(srid), **kwargs)\n   258→\n   259→\n   260→# points\n   261→\n   262→\n   263→@multithreading_enabled\n   264→def get_x(point, **kwargs):\n   265→    \"\"\"Return the x-coordinate of a point.\n   266→\n   267→    Parameters\n   268→    ----------\n   269→    point : Geometry or array_like\n   270→        Non-point geometries will result in NaN being returned.\n   271→    **kwargs\n   272→        See :ref:`NumPy ufunc docs <ufuncs.kwargs>` for other keyword arguments.\n   273→\n   274→    See Also\n   275→    --------\n   276→    get_y, get_z, get_m\n   277→\n   278→    Examples\n   279→    --------\n   280→    >>> from shapely import MultiPoint, Point\n   281→    >>> get_x(Point(1, 2))\n   282→    1.0\n   283→    >>> get_x(MultiPoint([(1, 1), (1, 2)]))\n   284→    nan\n   285→\n   286→    \"\"\"\n   287→    return lib.get_x(point, **kwargs)\n   288→\n   289→\n   290→@multithreading_enabled\n   291→def get_y(point, **kwargs):\n   292→    \"\"\"Return the y-coordinate of a point.\n   293→\n   294→    Parameters\n   295→    ----------\n   296→    point : Geometry or array_like\n   297→        Non-point geometries will result in NaN being returned.\n   298→    **kwargs\n   299→        See :ref:`NumPy ufunc docs <ufuncs.kwargs>` for other keyword arguments.\n   300→\n   301→    See Also\n   302→    --------\n   303→    get_x, get_z, get_m\n   304→\n   305→    Examples\n   306→    --------\n   307→    >>> from shapely import MultiPoint, Point\n   308→    >>> get_y(Point(1, 2))\n   309→    2.0\n   310→    >>> get_y(MultiPoint([(1, 1), (1, 2)]))\n   311→    nan\n   312→\n   313→    \"\"\"\n   314→    return lib.get_y(point, **kwargs)\n   315→\n   316→\n   317→@multithreading_enabled\n   318→def get_z(point, **kwargs):\n   319→    \"\"\"Return the z-coordinate of a point.\n   320→\n   321→    Parameters\n   322→    ----------\n   323→    point : Geometry or array_like\n   324→        Non-point geometries or geometries without Z dimension will result\n   325→        in NaN being returned.\n   326→    **kwargs\n   327→        See :ref:`NumPy ufunc docs <ufuncs.kwargs>` for other keyword arguments.\n   328→\n   329→    See Also\n   330→    --------\n   331→    get_x, get_y, get_m\n   332→\n   333→    Examples\n   334→    --------\n   335→    >>> from shapely import MultiPoint, Point\n   336→    >>> get_z(Point(1, 2, 3))\n   337→    3.0\n   338→    >>> get_z(Point(1, 2))\n   339→    nan\n   340→    >>> get_z(MultiPoint([(1, 1, 1), (2, 2, 2)]))\n   341→    nan\n   342→\n   343→    \"\"\"\n   344→    return lib.get_z(point, **kwargs)\n   345→\n   346→\n   347→@multithreading_enabled\n   348→@requires_geos(\"3.12.0\")\n   349→def get_m(point, **kwargs):\n   350→    \"\"\"Return the m-coordinate of a point.\n   351→\n   352→    .. versionadded:: 2.1.0\n   353→\n   354→    Parameters\n   355→    ----------\n   356→    point : Geometry or array_like\n   357→        Non-point geometries or geometries without M dimension will result\n   358→        in NaN being returned.\n   359→    **kwargs\n   360→        See :ref:`NumPy ufunc docs <ufuncs.kwargs>` for other keyword arguments.\n   361→\n   362→    See Also\n   363→    --------\n   364→    get_x, get_y, get_z\n   365→\n   366→    Examples\n   367→    --------\n   368→    >>> from shapely import Point, from_wkt\n   369→    >>> get_m(from_wkt(\"POINT ZM (1 2 3 4)\"))\n   370→    4.0\n   371→    >>> get_m(from_wkt(\"POINT M (1 2 4)\"))\n   372→    4.0\n   373→    >>> get_m(Point(1, 2, 3))\n   374→    nan\n   375→    >>> get_m(from_wkt(\"MULTIPOINT M ((1 1 1), (2 2 2))\"))\n   376→    nan\n   377→\n   378→    \"\"\"\n   379→    return lib.get_m(point, **kwargs)\n   380→\n   381→\n   382→# linestrings\n   383→\n   384→\n   385→@multithreading_enabled\n   386→def get_point(geometry, index, **kwargs):\n   387→    \"\"\"Return the nth point of a linestring or linearring.\n   388→\n   389→    Parameters\n   390→    ----------\n   391→    geometry : Geometry or array_like\n   392→        Geometry or geometries to get the point of.\n   393→    index : int or array_like\n   394→        Negative values count from the end of the linestring backwards.\n   395→    **kwargs\n   396→        See :ref:`NumPy ufunc docs <ufuncs.kwargs>` for other keyword arguments.\n   397→\n   398→    See Also\n   399→    --------\n   400→    get_num_points\n   401→\n   402→    Examples\n   403→    --------\n   404→    >>> from shapely import LinearRing, LineString, MultiPoint, Point\n   405→    >>> line = LineString([(0, 0), (1, 1), (2, 2), (3, 3)])\n   406→    >>> get_point(line, 1)\n   407→    <POINT (1 1)>\n   408→    >>> get_point(line, -2)\n   409→    <POINT (2 2)>\n   410→    >>> get_point(line, [0, 3]).tolist()\n   411→    [<POINT (0 0)>, <POINT (3 3)>]\n   412→\n   413→    The function works the same for LinearRing input:\n   414→\n   415→    >>> get_point(LinearRing([(0, 0), (1, 1), (2, 2), (0, 0)]), 1)\n   416→    <POINT (1 1)>\n   417→\n   418→    For non-linear geometries it returns None:\n   419→\n   420→    >>> get_point(MultiPoint([(0, 0), (1, 1), (2, 2), (3, 3)]), 1) is None\n   421→    True\n   422→    >>> get_point(Point(1, 1), 0) is None\n   423→    True\n   424→\n   425→    \"\"\"\n   426→    return lib.get_point(geometry, np.intc(index), **kwargs)\n   427→\n   428→\n   429→@multithreading_enabled\n   430→def get_num_points(geometry, **kwargs):\n   431→    \"\"\"Return the number of points in a linestring or linearring.\n   432→\n   433→    Returns 0 for not-a-geometry values. The number of points in geometries\n   434→    other than linestring or linearring equals zero.\n   435→\n   436→    Parameters\n   437→    ----------\n   438→    geometry : Geometry or array_like\n   439→        Geometry or geometries to get the number of points of.\n   440→    **kwargs\n   441→        See :ref:`NumPy ufunc docs <ufuncs.kwargs>` for other keyword arguments.\n   442→\n   443→    See Also\n   444→    --------\n   445→    get_point\n   446→    get_num_geometries\n   447→\n   448→    Examples\n   449→    --------\n   450→    >>> from shapely import LineString, MultiPoint\n   451→    >>> get_num_points(LineString([(0, 0), (1, 1), (2, 2), (3, 3)]))\n   452→    4\n   453→    >>> get_num_points(MultiPoint([(0, 0), (1, 1), (2, 2), (3, 3)]))\n   454→    0\n   455→    >>> get_num_points(None)\n   456→    0\n   457→\n   458→    \"\"\"\n   459→    return lib.get_num_points(geometry, **kwargs)\n   460→\n   461→\n   462→# polygons\n   463→\n   464→\n   465→@multithreading_enabled\n   466→def get_exterior_ring(geometry, **kwargs):\n   467→    \"\"\"Return the exterior ring of a polygon.\n   468→\n   469→    Parameters\n   470→    ----------\n   471→    geometry : Geometry or array_like\n   472→        Geometry or geometries to get the exterior ring of.\n   473→    **kwargs\n   474→        See :ref:`NumPy ufunc docs <ufuncs.kwargs>` for other keyword arguments.\n   475→\n   476→    See Also\n   477→    --------\n   478→    get_interior_ring\n   479→\n   480→    Examples\n   481→    --------\n   482→    >>> from shapely import Point, Polygon\n   483→    >>> get_exterior_ring(Polygon([(0, 0), (0, 10), (10, 10), (10, 0), (0, 0)]))\n   484→    <LINEARRING (0 0, 0 10, 10 10, 10 0, 0 0)>\n   485→    >>> get_exterior_ring(Point(1, 1)) is None\n   486→    True\n   487→\n   488→    \"\"\"\n   489→    return lib.get_exterior_ring(geometry, **kwargs)\n   490→\n   491→\n   492→@multithreading_enabled\n   493→def get_interior_ring(geometry, index, **kwargs):\n   494→    \"\"\"Return the nth interior ring of a polygon.\n   495→\n   496→    The number of interior rings in non-polygons equals zero.\n   497→\n   498→    Parameters\n   499→    ----------\n   500→    geometry : Geometry or array_like\n   501→        Geometry or geometries to get the interior ring of.\n   502→    index : int or array_like\n   503→        Negative values count from the end of the interior rings backwards.\n   504→    **kwargs\n   505→        See :ref:`NumPy ufunc docs <ufuncs.kwargs>` for other keyword arguments.\n   506→\n   507→    See Also\n   508→    --------\n   509→    get_exterior_ring\n   510→    get_num_interior_rings\n   511→\n   512→    Examples\n   513→    --------\n   514→    >>> from shapely import Point, Polygon\n   515→    >>> polygon_with_hole = Polygon(\n   516→    ...     [(0, 0), (0, 10), (10, 10), (10, 0), (0, 0)],\n   517→    ...     holes=[[(2, 2), (2, 4), (4, 4), (4, 2), (2, 2)]]\n   518→    ... )\n   519→    >>> get_interior_ring(polygon_with_hole, 0)\n   520→    <LINEARRING (2 2, 2 4, 4 4, 4 2, 2 2)>\n   521→    >>> get_interior_ring(polygon_with_hole, 1) is None\n   522→    True\n   523→    >>> polygon = Polygon([(0, 0), (0, 10), (10, 10), (10, 0), (0, 0)])\n   524→    >>> get_interior_ring(polygon, 0) is None\n   525→    True\n   526→    >>> get_interior_ring(Point(0, 0), 0) is None\n   527→    True\n   528→\n   529→    \"\"\"\n   530→    return lib.get_interior_ring(geometry, np.intc(index), **kwargs)\n   531→\n   532→\n   533→@multithreading_enabled\n   534→def get_num_interior_rings(geometry, **kwargs):\n   535→    \"\"\"Return number of internal rings in a polygon.\n   536→\n   537→    Returns 0 for not-a-geometry values.\n   538→\n   539→    Parameters\n   540→    ----------\n   541→    geometry : Geometry or array_like\n   542→        Geometry or geometries to get the number of interior rings of.\n   543→    **kwargs\n   544→        See :ref:`NumPy ufunc docs <ufuncs.kwargs>` for other keyword arguments.\n   545→\n   546→    See Also\n   547→    --------\n   548→    get_exterior_ring\n   549→    get_interior_ring\n   550→\n   551→    Examples\n   552→    --------\n   553→    >>> from shapely import Point, Polygon\n   554→    >>> polygon = Polygon([(0, 0), (0, 10), (10, 10), (10, 0), (0, 0)])\n   555→    >>> get_num_interio