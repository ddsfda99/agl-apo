+def test_tuple_indexing_infers_element_type():
+    """Test that tuple indexing infers correct element types and supports comparisons."""
+    tuple_var = BaseVar(_var_name="word", _var_type=Tuple[str, int, int])
+
+    # Index 0 should be str
+    idx0 = tuple_var[0]
+    assert isinstance(idx0, Var)
+    assert idx0._var_type == str
+
+    # Index 2 should be int and allow comparisons with int vars
+    idx2 = tuple_var[2]
+    assert isinstance(idx2, Var)
+    assert idx2._var_type == int
+
+    end_time = BaseVar(_var_name="end", _var_type=int)
+    # Should not raise TypeError
+    comp = idx2 <= end_time
+    assert isinstance(comp, Var)
+
+    # Negative indexing should also infer correctly
+    idx_neg1 = tuple_var[-1]
+    assert idx_neg1._var_type == int
+
+    # Homogeneous tuple with ellipsis
+    homo_tuple = BaseVar(_var_name="t", _var_type=Tuple[int, ...])
+    assert homo_tuple[0]._var_type == int
+
+
