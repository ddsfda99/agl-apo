   return self.consumers[message_type_str][consumer_id]\n   250\u2192\n   251\u2192    async def _publish(self, message: QueueMessage, topic: str) -> Any:\n   252\u2192        \"\"\"Publish message to a queue.\"\"\"\n   253\u2192        message_type_str = message.type\n   254\u2192\n   255\u2192        if message_type_str not in self.consumers:\n   256\u2192            logger.debug(\n   257\u2192                f\"Failed to publish message. No registered consumer '{message_type_str}'.\"\n   258\u2192            )\n   259\u2192            raise ValueError(\n   260\u2192                f\"No consumer for '{message_type_str}' has been registered.\"\n   261\u2192            )\n   262\u2192\n   263\u2192        if message_type_str not in self.queues:\n   264\u2192            self.queues[message_type_str] = deque()\n   265\u2192\n   266\u2192        self.queues[message_type_str].append(message)\n   267\u2192\n   268\u2192    async def _publish_to_consumer(self, message: QueueMessage, **kwargs: Any) -> Any:\n   269\u2192        \"\"\"Publish message to a consumer.\"\"\"\n   270\u2192        consumer = self._select_consumer(message)\n   271\u2192        try:\n   272\u2192            await consumer.process_message(message, **kwargs)\n   273\u2192            logger.info(f\"Successfully published message '{message.type}' to consumer.\")\n   274\u2192        except Exception as e:\n   275\u2192            logger.debug(\n   276\u2192                f\"Failed to publish message of type '{message.type}' to consumer. Message: {str(e)}\"\n   277\u2192            )\n   278\u2192            raise\n   279\u2192\n   280\u2192    async def register_consumer(\n   281\u2192        self, consumer: BaseMessageQueueConsumer, topic: str | None = None\n   282\u2192    ) -> StartConsumingCallable:\n   283\u2192        \"\"\"Register a new consumer.\"\"\"\n   284\u2192        message_type_str = consumer.message_type\n   285\u2192\n   286\u2192        if message_type_str not in self.consumers:\n   287\u2192            self.consumers[message_type_str] = {consumer.id_: consumer}\n   288\u2192            logger.info(\n   289\u2192                f\"Consumer {consumer.id_}: {message_type_str} has been registered.\"\n   290\u2192            )\n   291\u2192        else:\n   292\u2192            if consumer.id_ in self.consumers[message_type_str]:\n   293\u2192                raise HTTPException(\n   294\u2192                    status_code=status.HTTP_409_CONFLICT,\n   295\u2192                    detail=\"Consumer with the same id_ has already been previously added.\",\n   296\u2192                )\n   297\u2192            self.consumers[message_type_str][consumer.id_] = consumer\n   298\u2192            logger.info(\n   299\u2192                f\"Consumer {consumer.id_}: {message_type_str} has been registered.\"\n   300\u2192            )\n   301\u2192\n   302\u2192        if message_type_str not in self.queues:\n   303\u2192            self.queues[message_type_str] = deque()\n   304\u2192        return default_start_consuming_callable\n   305\u2192\n   306\u2192    async def register_remote_consumer(\n   307\u2192        self, consumer_def: RemoteMessageConsumerDef\n   308\u2192    ) -> Dict[str, str]:\n   309\u2192        \"\"\"API endpoint to register a consumer based on a consumer definition.\"\"\"\n   310\u2192        consumer = RemoteMessageConsumer(**consumer_def.model_dump())\n   311\u2192        message_type = consumer.message_type\n   312\u2192\n   313\u2192        # check if consumer with same url already exists\n   314\u2192        if message_type in self.consumers:\n   315\u2192\n   316\u2192            def consumer_with_same_url(\n   317\u2192                c: RemoteMessageConsumer,\n   318\u2192            ) -> bool:\n   319\u2192                return c.url == consumer.url\n   320\u2192\n   321\u2192            try:\n   322\u2192                next(\n   323\u2192                    filter(\n   324\u2192                        consumer_with_same_url,\n   325\u2192                        [\n   326\u2192                            c\n   327\u2192                            for c in self.consumers[message_type].values()\n   328\u2192                            if isinstance(c, RemoteMessageConsumer)\n   329\u2192                        ],\n   330\u2192                    )\n   331\u2192                )\n   332\u2192                raise HTTPException(\n   333\u2192                    status_code=status.HTTP_409_CONFLICT,\n   334\u2192                    detail=\"A consumer with the same url has previously been registered.\",\n   335\u2192                )\n   336\u2192            except StopIteration:\n   337\u2192                pass\n   338\u2192\n   339\u2192        await self.register_consumer(consumer)\n   340\u2192        return {\"consumer\": consumer.id_}\n   341\u2192\n   342\u2192    async def deregister_consumer(self, consumer: BaseMessageQueueConsumer) -> None:\n   343\u2192        \"\"\"Deregister a consumer.\"\"\"\n   344\u2192        message_type_str = consumer.message_type\n   345\u2192        if consumer.id_ not in self.consumers.get(message_type_str, {}):\n   346\u2192            raise HTTPException(\n   347\u2192                detail=f\"No consumer found for associated message type. {consumer.id_}: {message_type_str}\",\n   348\u2192                status_code=status.HTTP_404_NOT_FOUND,\n   349\u2192            )\n   350\u2192\n   351\u2192        del self.consumers[message_type_str][consumer.id_]\n   352\u2192        if len(self.consumers[message_type_str]) == 0:\n   353\u2192            del self.consumers[message_type_str]\n   354\u2192\n   355\u2192    async def deregister_remote_consumer(\n   356\u2192        self, consumer_def: RemoteMessageConsumerDef\n   357\u2192    ) -> None:\n   358\u2192        \"\"\"API endpoint to deregister a consumer based on a consumer definition.\"\"\"\n   359\u2192        consumer = RemoteMessageConsumer(**consumer_def.model_dump())\n   360\u2192        await self.deregister_consumer(consumer)\n   361\u2192\n   362\u2192    async def get_consumers(self, message_type: str) -> List[BaseMessageQueueConsumer]:\n   363\u2192        \"\"\"Get all consumersm for a given type.\"\"\"\n   364\u2192        if message_type not in self.consumers:\n   365\u2192            return []\n   366\u2192\n   367\u2192        return list(self.consumers[message_type].values())\n   368\u2192\n   369\u2192    async def get_consumer_defs(\n   370\u2192        self, message_type: str\n   371\u2192    ) -> List[RemoteMessageConsumerDef]:\n   372\u2192        \"\"\"Get all consumer definitions for a given type.\"\"\"\n   373\u2192        if message_type not in self.consumers:\n   374\u2192            return []\n   375\u2192\n   376\u2192        return [\n   377\u2192            RemoteMessageConsumerDef(**c.model_dump())\n   378\u2192            for c in self.consumers[message_type].values()\n   379\u2192        ]\n   380\u2192\n   381\u2192    async def processing_loop(self) -> None:\n   382\u2192        \"\"\"A loop for getting messages from queues and sending to consumer.\"\"\"\n   383\u2192        while self.running:\n   384\u2192            for queue in self.queues.values():\n   385\u2192                if queue:\n   386\u2192                    message: QueueMessage = queue.popleft()\n   387\u2192                    message.stats.process_start_time = message.stats.timestamp_str()\n   388\u2192                    await self._publish_to_consumer(message)\n   389\u2192                    message.stats.process_end_time = (\n   390\u2192                        message.stats.timestamp_str()\n   391\u2192                    )  # TODO dedicated ack\n   392\u2192            await asyncio.sleep(0.1)\n   393\u2192\n   394\u2192    async def launch_local(self) -> asyncio.Task:\n   395\u2192        \"\"\"Launch the message queue locally, in-process.\"\"\"\n   396\u2192        logger.info(\"Launching message queue locally\")\n   397\u2192        return asyncio.create_task(self.processing_loop())\n   398\u2192\n   399\u2192    async def launch_server(self) -> None:\n   400\u2192        \"\"\"Launch the message queue as a FastAPI server.\"\"\"\n   401\u2192        host = self.internal_host or self.host\n   402\u2192        port = self.internal_port or self.port\n   403\u2192        logger.info(f\"Launching message queue server at {host}:{port}\")\n   404\u2192\n   405\u2192        # uvicorn.run(self._app, host=self.host, port=self.port)\n   406\u2192        class CustomServer(uvicorn.Server):\n   407\u2192            def install_signal_handlers(self) -> None:\n   408\u2192                pass\n   409\u2192\n   410\u2192        cfg = uvicorn.Config(self._app, host=host, port=port)\n   411\u2192        server = CustomServer(cfg)\n   412\u2192        pl_task = asyncio.create_task(self.processing_loop())\n   413\u2192\n   414\u2192        try:\n   415\u2192            await server.serve()\n   416\u2192        except asyncio.CancelledError:\n   417\u2192            self.running = False\n   418\u2192            await asyncio.gather(server.shutdown(), pl_task, return_exceptions=True)\n   419\u2192\n   420\u2192    async def home(self) -> Dict[str, str]:\n   421\u2192        return {\n   422\u2192            \"service_name\": \"message_queue\",\n   423\u2192            \"description\": \"Message queue for multi-agent system\",\n   424\u2192        }\n   425\u2192\n   426\u2192    async def cleanup_local(\n   427\u2192        self, message_types: List[str], *args: Any, **kwargs: Dict[str, Any]\n   428\u2192    ) -> None:\n   429\u2192        pass\n   430\u2192\n   431\u2192    def as_config(self) -> BaseModel:\n   432\u2192        return SimpleMessageQueueConfig(\n   433\u2192            host=self.host,\n   434\u2192            port=self.port,\n   435\u2192            internal_host=self.internal_host,\n   436\u2192            internal_port=self.internal_port,\n   437\u2192        )\n   438\u2192\n   439\u2192\n   440\u2192i