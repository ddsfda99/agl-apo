","type":"tool_result","content":"     1→import platform\n     2→from os import chdir\n     3→\n     4→import pytest\n     5→\n     6→from conan.tools.build import load_toolchain_args\n     7→from conan.tools.gnu import AutotoolsToolchain\n     8→from conans.errors import ConanException\n     9→from conans.model.conf import Conf\n    10→from conans.test.utils.mocks import ConanFileMock, MockSettings, MockOptions\n    11→from conans.test.utils.test_files import temp_folder\n    12→\n    13→\n    14→def test_modify_environment():\n    15→    \"\"\"We can alter the environment generated by the toolchain passing the env to the generate\"\"\"\n    16→    f = temp_folder()\n    17→    chdir(f)\n    18→    conanfile = ConanFileMock()\n    19→    conanfile.settings = MockSettings({\"os\": \"Linux\", \"arch\": \"x86_64\"})\n    20→    conanfile.settings_build = MockSettings({\"os\": \"Solaris\", \"arch\": \"x86\"})\n    21→    be = AutotoolsToolchain(conanfile)\n    22→    env = be.environment()\n    23→    env.define(\"foo\", \"var\")\n    24→    # We can pass the env to the generate once we adjusted or injected anything\n    25→    be.generate(env)\n    26→\n    27→    with open(\"conanautotoolstoolchain.sh\") as f:\n    28→        content = f.read()\n    29→        assert \"foo\" in content\n    30→\n    31→\n    32→def test_target_triple():\n    33→    f = temp_folder()\n    34→    chdir(f)\n    35→    conanfile = ConanFileMock()\n    36→    conanfile.settings = MockSettings({\"os\": \"Linux\", \"arch\": \"x86_64\"})\n    37→    conanfile.settings_build = MockSettings({\"os\": \"Solaris\", \"arch\": \"x86\"})\n    38→    conanfile.conf = Conf()\n    39→    conanfile.conf.define(\"tools.gnu:make_program\", \"my_make\")\n    40→    conanfile.conf.define(\"tools.gnu.make:jobs\", \"23\")\n    41→\n    42→    be = AutotoolsToolchain(conanfile)\n    43→    be.make_args = [\"foo\", \"var\"]\n    44→    be.generate_args()\n    45→    obj = load_toolchain_args()\n    46→    assert \"--host=x86_64-linux-gnu\" in obj[\"configure_args\"]\n    47→    assert \"--build=i686-solaris\" in obj[\"configure_args\"]\n    48→    assert obj[\"make_args\"].replace(\"'\", \"\") == \"foo var\"\n    49→\n    50→\n    51→def test_invalid_target_triple():\n    52→    conanfile = ConanFileMock()\n    53→    conanfile.settings = MockSettings({\"os\": \"Linux\", \"arch\": \"UNKNOWN_ARCH\"})\n    54→    conanfile.settings_build = MockSettings({\"os\": \"Solaris\", \"arch\": \"x86\"})\n    55→    with pytest.raises(ConanException) as excinfo:\n    56→        AutotoolsToolchain(conanfile)\n    57→    assert \"Unknown 'UNKNOWN_ARCH' machine, Conan doesn't know how \" \\\n    58→           \"to translate it to the GNU triplet,\" in str(excinfo)\n    59→\n    60→def test_custom_host_triple():\n    61→    conanfile = ConanFileMock()\n    62→    conanfile.settings = MockSettings({\"os\": \"Linux\", \"arch\": \"x86\"})\n    63→    conanfile.settings_build = MockSettings({\"os\": \"Linux\", \"arch\": \"x86_64\"})\n    64→    conanfile.conf.define(\"tools.gnu:host_triplet\", \"i686-pc-linux-gnu\")\n    65→    tc = AutotoolsToolchain(conanfile)\n    66→    tc.generate_args()\n    67→    obj = load_toolchain_args()\n    68→    assert \"--host=i686-pc-linux-gnu\" in obj[\"configure_args\"]\n    69→\n    70→def test_cppstd():\n    71→    # Using \"cppstd\" is discarded\n    72→    conanfile = ConanFileMock()\n    73→    conanfile.settings = MockSettings(\n    74→        {\"build_type\": \"Release\",\n    75→         \"arch\": \"x86\",\n    76→         \"compiler\": \"gcc\",\n    77→         \"compiler.libcxx\": \"libstdc++11\",\n    78→         \"compiler.version\": \"7.1\",\n    79→         \"cppstd\": \"17\"})\n    80→    conanfile.settings_build = MockSettings({\"os\": \"Linux\", \"arch\": \"x86\"})\n    81→    be = AutotoolsToolchain(conanfile)\n    82→    env = be.vars()\n    83→    assert \"-std=c++17\" not in env[\"CXXFLAGS\"]\n    84→\n    85→    # Using \"compiler.cppstd\" works\n    86→    conanfile.settings = MockSettings(\n    87→        {\"build_type\": \"Release\",\n    88→         \"arch\": \"x86\",\n    89→         \"compiler\": \"gcc\",\n    90→         \"compiler.libcxx\": \"libstdc++11\",\n    91→         \"compiler.version\": \"7.1\",\n    92→         \"compiler.cppstd\": \"17\"})\n    93→    be = AutotoolsToolchain(conanfile)\n    94→    env = be.vars()\n    95→    assert \"-std=c++17\" in env[\"CXXFLAGS\"]\n    96→\n    97→    # With visual\n    98→    conanfile.settings = MockSettings(\n    99→        {\"build_type\": \"Release\",\n   100→         \"arch\": \"x86\",\n   101→         \"compiler\": \"msvc\",\n   102→         \"compiler.version\": \"190\",\n   103→         \"compiler.cppstd\": \"17\"})\n   104→    be = AutotoolsToolchain(conanfile)\n   105→    env = be.vars()\n   106→    assert \"/std:c++latest\" in env[\"CXXFLAGS\"]\n   107→\n   108→    # With MSVC\n   109→    conanfile.settings = MockSettings(\n   110→        {\"build_type\": \"Release\",\n   111→         \"arch\": \"x86\",\n   112→         \"compiler\": \"msvc\",\n   113→         \"compiler.version\": \"193\",\n   114→         \"compiler.cppstd\": \"17\"})\n   115→    be = AutotoolsToolchain(conanfile)\n   116→    env = be.vars()\n   117→    assert \"/std:c++17\" in env[\"CXXFLAGS\"]\n   118→\n   119→\n   120→def test_fpic():\n   121→    conanfile = ConanFileMock()\n   122→    conanfile.settings = MockSettings({\"os\": \"Linux\"})\n   123→    conanfile.settings_build = MockSettings({\"os\": \"Linux\"})\n   124→    conanfile.options = MockOptions({\"fPIC\": True})\n   125→    be = AutotoolsToolchain(conanfile)\n   126→    be.vars()\n   127→    assert be.fpic is True\n   128→    assert \"-fPIC\" in be.cxxflags\n   129→\n   130→    conanfile.options = MockOptions({\"fPIC\": False})\n   131→    be = AutotoolsToolchain(conanfile)\n   132→    be.vars()\n   133→    assert be.fpic is False\n   134→    assert \"-fPIC\" not in be.cxxflags\n   135→\n   136→    conanfile.options = MockOptions({\"shared\": False})\n   137→    be = AutotoolsToolchain(conanfile)\n   138→    be.vars()\n   139→    assert be.fpic is None\n   140→    assert \"-fPIC\" not in be.cxxflags\n   141→\n   142→\n   143→def test_ndebug():\n   144→    conanfile = ConanFileMock()\n   145→    for bt in ['Release', 'RelWithDebInfo', 'MinSizeRel']:\n   146→        conanfile.settings = MockSettings({\"build_type\": bt})\n   147→        conanfile.settings_build = MockSettings({\"os\": \"Linux\", \"arch\": \"x86_64\"})\n   148→        be = AutotoolsToolchain(conanfile)\n   149→        assert be.ndebug == \"NDEBUG\"\n   150→        env = be.vars()\n   151→        assert \"-DNDEBUG\" in env[\"CPPFLAGS\"]\n   152→    for bt in ['Debug', 'DebWithDebInfo']:\n   153→        conanfile.settings = MockSettings({\"build_type\": bt})\n   154→        be = AutotoolsToolchain(conanfile)\n   155→        assert be.ndebug is None\n   156→        env = be.vars()\n   157→        assert \"-DNDEBUG\" not in env[\"CPPFLAGS\"]\n   158→\n   159→\n   160→@pytest.mark.parametrize(\"config\", [\n   161→    (\"gcc\", 'libstdc++', None),\n   162→    (\"clang\", 'libstdc++', '-stdlib=libstdc++'),\n   163→    (\"clang\", 'libstdc++11', '-stdlib=libstdc++'),\n   164→    (\"clang\", 'libc++', '-stdlib=libc++'),\n   165→    (\"apple-clang\", 'libstdc++', '-stdlib=libstdc++'),\n   166→    (\"apple-clang\", 'libc++', '-stdlib=libc++'),\n   167→    (\"sun-cc\", 'libCstd', '-library=Cstd'),\n   168→    (\"sun-cc\", 'libstdcxx', '-library=stdcxx4'),\n   169→    (\"sun-cc\", 'libstlport', '-library=stlport4'),\n   170→    (\"sun-cc\", 'libstdc++', '-library=stdcpp'),\n   171→    (\"qcc\", 'libCstd', '-Y _libCstd'),\n   172→    (\"qcc\", 'libstdcxx', '-Y _libstdcxx'),\n   173→    (\"qcc\", 'libstlport', '-Y _libstlport'),\n   174→    (\"qcc\", 'libstdc++', '-Y _libstdc++'),\n   175→    ])\n   176→def test_libcxx(config):\n   177→    compiler, libcxx, expected_flag = config\n   178→    conanfile = ConanFileMock()\n   179→    the_os = \"Linux\" if compiler != \"apple-clang\" else \"Macos\"\n   180→    conanfile.settings = MockSettings(\n   181→        {\"os\": the_os,\n   182→         \"build_type\": \"Release\",\n   183→         \"arch\": \"x86\",\n   184→         \"compiler\": compiler,\n   185→         \"compiler.libcxx\": libcxx,\n   186→         \"compiler.version\": \"7.1\",\n   187→         \"compiler.cppstd\": \"17\"})\n   188→    conanfile.settings_build = conanfile.settings\n   189→    be = AutotoolsToolchain(conanfile)\n   190→    assert be.libcxx == expected_flag\n   191→    env = be.vars()\n   192→    if expected_flag:\n   193→        assert expected_flag in env[\"CXXFLAGS\"]\n   194→\n   195→\n   196→def test_cxx11_abi_define():\n   197→    conanfile = ConanFileMock()\n   198→    conanfile.settings = MockSettings(\n   199→        {\"os\": \"Linux\",\n   200→         \"build_type\": \"Release\",\n   201→         \"arch\": \"x86\",\n   202→         \"compiler\": \"gcc\",\n   203→         \"compiler.libcxx\": \"libstdc++\",\n   204→         \"compiler.version\": \"7.1\",\n   205→         \"compiler.cppstd\": \"17\"})\n   206→    conanfile.settings_build = conanfile.settings\n   207→    be = AutotoolsToolchain(conanfile)\n   208→    assert be.gcc_cxx11_abi == \"_GLIBCXX_USE_CXX11_ABI=0\"\n   209→    env = be.vars()\n   210→    assert \"-D_GLIBCXX_USE_CXX11_ABI=0\" in env[\"CPPFLAGS\"]\n   211→\n   212→    conanfile.settings = MockSettings(\n   213→        {\"os\": \"Linux\",\n   214→         \"build_type\": \"Release\",\n   215→         \"arch\": \"x86\",\n   216→         \"compiler\": \"gcc\",\n   217→         \"compiler.libcxx\": \"libstdc++11\",\n   218→         \"compiler.version\": \"7.1\",\n   219→         \"compiler.cppstd\": \"17\"})\n   220→    be = AutotoolsToolchain(conanfile)\n   221→    env = be.vars()\n   222→    assert be.gcc_cxx11_abi is None\n   223→    assert \"GLIBCXX_USE_CXX11_ABI\" not in env[\"CPPFLAGS\"]\n   224→\n   225→    # Force the GLIBCXX_USE_CXX11_ABI=1 for old distros is direct def f ``gcc_cxx11_abi``\n   226→    be.gcc_cxx11_abi = \"_GLIBCXX_USE_CXX11_ABI=1\"\n   227→    env = be.vars()\n   228→    assert \"-D_GLIBCXX_USE_CXX11_ABI=1\" in env[\"CPPFLAGS\"]\n   229→\n   230→    # Also conf is possible\n   231→    conanfile.conf.define(\"tools.gnu:define_libcxx11_abi\", True)\n   232→    be = AutotoolsToolchain(conanfile)\n   233→    env = be.vars()\n   234→    assert \"-D_GLIBCXX_USE_CXX11_ABI=1\" in env[\"CPPFLAGS\"]\n   235→\n   236→\n   237→@pytest.mark.parametrize(\"config\", [\n   238→    ('x86_64', \"-m64\"),\n   239→    ('x86', \"-m32\")])\n   240→def test_architecture_flag(config):\n   241→    \"\"\"Architecture flag is set in CXXFLAGS, CFLAGS and LDFLAGS\"\"\"\n   242→    arch, expected = config\n   243→    conanfile = ConanFileMock()\n   244→    conanfile.settings = MockSettings(\n   245→        {\"build_type\": \"Release\",\n   246→         \"os\": \"Macos\",\n   247→         \"compiler\": \"gcc\",\n   248→         \"arch\": arch})\n   249→    conanfile.settings_build = conanfile.settings\n   250→    be = AutotoolsToolchain(conanfile)\n   251→    assert be.arch_flag == expected\n   252→    env = be.vars()\n   253→    assert expected in env[\"CXXFLAGS\"]\n   254→    assert expected in env[\"CFLAGS\"]\n   255→    assert expected in env[\"LDFLAGS\"]\n   256→    assert \"-debug\" not in env[\"LDFLAGS\"]\n   257→\n   258→\n   259→@pytest.mark.parametrize(\"compiler\", ['msvc'])\n   260→def test_build_type_flag(compiler):\n   261→    \"\"\"Architecture flag is set in CXXFLAGS, CFLAGS and LDFLAGS\"\"\"\n   262→    conanfile = ConanFileMock()\n   263→    conanfile.settings = MockSettings(\n   264→        {\"build_type\": \"Debug\",\n   265→         \"os\": \"Windows\",\n   266→         \"compiler\": compiler,\n   267→         \"arch\": \"x86_64\"})\n   268→    conanfile.settings_build = conanfile.settings\n   269→    be = AutotoolsToolchain(conanfile)\n   270→    assert be.build_typ