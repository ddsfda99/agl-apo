,\n   163\u2192    (\"clang\", 'libstdc++11', '-stdlib=libstdc++'),\n   164\u2192    (\"clang\", 'libc++', '-stdlib=libc++'),\n   165\u2192    (\"apple-clang\", 'libstdc++', '-stdlib=libstdc++'),\n   166\u2192    (\"apple-clang\", 'libc++', '-stdlib=libc++'),\n   167\u2192    (\"sun-cc\", 'libCstd', '-library=Cstd'),\n   168\u2192    (\"sun-cc\", 'libstdcxx', '-library=stdcxx4'),\n   169\u2192    (\"sun-cc\", 'libstlport', '-library=stlport4'),\n   170\u2192    (\"sun-cc\", 'libstdc++', '-library=stdcpp'),\n   171\u2192    (\"qcc\", 'libCstd', '-Y _libCstd'),\n   172\u2192    (\"qcc\", 'libstdcxx', '-Y _libstdcxx'),\n   173\u2192    (\"qcc\", 'libstlport', '-Y _libstlport'),\n   174\u2192    (\"qcc\", 'libstdc++', '-Y _libstdc++'),\n   175\u2192    ])\n   176\u2192def test_libcxx(config):\n   177\u2192    compiler, libcxx, expected_flag = config\n   178\u2192    conanfile = ConanFileMock()\n   179\u2192    the_os = \"Linux\" if compiler != \"apple-clang\" else \"Macos\"\n   180\u2192    conanfile.settings = MockSettings(\n   181\u2192        {\"os\": the_os,\n   182\u2192         \"build_type\": \"Release\",\n   183\u2192         \"arch\": \"x86\",\n   184\u2192         \"compiler\": compiler,\n   185\u2192         \"compiler.libcxx\": libcxx,\n   186\u2192         \"compiler.version\": \"7.1\",\n   187\u2192         \"compiler.cppstd\": \"17\"})\n   188\u2192    conanfile.settings_build = conanfile.settings\n   189\u2192    be = AutotoolsToolchain(conanfile)\n   190\u2192    assert be.libcxx == expected_flag\n   191\u2192    env = be.vars()\n   192\u2192    if expected_flag:\n   193\u2192        assert expected_flag in env[\"CXXFLAGS\"]\n   194\u2192\n   195\u2192\n   196\u2192def test_cxx11_abi_define():\n   197\u2192    conanfile = ConanFileMock()\n   198\u2192    conanfile.settings = MockSettings(\n   199\u2192        {\"os\": \"Linux\",\n   200\u2192         \"build_type\": \"Release\",\n   201\u2192         \"arch\": \"x86\",\n   202\u2192         \"compiler\": \"gcc\",\n   203\u2192         \"compiler.libcxx\": \"libstdc++\",\n   204\u2192         \"compiler.version\": \"7.1\",\n   205\u2192         \"compiler.cppstd\": \"17\"})\n   206\u2192    conanfile.settings_build = conanfile.settings\n   207\u2192    be = AutotoolsToolchain(conanfile)\n   208\u2192    assert be.gcc_cxx11_abi == \"_GLIBCXX_USE_CXX11_ABI=0\"\n   209\u2192    env = be.vars()\n   210\u2192    assert \"-D_GLIBCXX_USE_CXX11_ABI=0\" in env[\"CPPFLAGS\"]\n   211\u2192\n   212\u2192    conanfile.settings = MockSettings(\n   213\u2192        {\"os\": \"Linux\",\n   214\u2192         \"build_type\": \"Release\",\n   215\u2192         \"arch\": \"x86\",\n   216\u2192         \"compiler\": \"gcc\",\n   217\u2192         \"compiler.libcxx\": \"libstdc++11\",\n   218\u2192         \"compiler.version\": \"7.1\",\n   219\u2192         \"compiler.cppstd\": \"17\"})\n   220\u2192    be = AutotoolsToolchain(conanfile)\n   221\u2192    env = be.vars()\n   222\u2192    assert be.gcc_cxx11_abi is None\n   223\u2192    assert \"GLIBCXX_USE_CXX11_ABI\" not in env[\"CPPFLAGS\"]\n   224\u2192\n   225\u2192    # Force the GLIBCXX_USE_CXX11_ABI=1 for old distros is direct def f ``gcc_cxx11_abi``\n   226\u2192    be.gcc_cxx11_abi = \"_GLIBCXX_USE_CXX11_ABI=1\"\n   227\u2192    env = be.vars()\n   228\u2192    assert \"-D_GLIBCXX_USE_CXX11_ABI=1\" in env[\"CPPFLAGS\"]\n   229\u2192\n   230\u2192    # Also conf is possible\n   231\u2192    conanfile.conf.define(\"tools.gnu:define_libcxx11_abi\", True)\n   232\u2192    be = AutotoolsToolchain(conanfile)\n   233\u2192    env = be.vars()\n   234\u2192    assert \"-D_GLIBCXX_USE_CXX11_ABI=1\" in env[\"CPPFLAGS\"]\n   235\u2192\n   236\u2192\n   237\u2192@pytest.mark.parametrize(\"config\", [\n   238\u2192    ('x86_64', \"-m64\"),\n   239\u2192    ('x86', \"-m32\")])\n   240\u2192def test_architecture_flag(config):\n   241\u2192    \"\"\"Architecture flag is set in CXXFLAGS, CFLAGS and LDFLAGS\"\"\"\n   242\u2192    arch, expected = config\n   243\u2192    conanfile = ConanFileMock()\n   244\u2192    conanfile.settings = MockSettings(\n   245\u2192        {\"build_type\": \"Release\",\n   246\u2192         \"os\": \"Macos\",\n   247\u2192         \"compiler\": \"gcc\",\n   248\u2192         \"arch\": arch})\n   249\u2192    conanfile.settings_build = conanfile.settings\n   250\u2192    be = AutotoolsToolchain(conanfile)\n   251\u2192    assert be.arch_flag == expected\n   252\u2192    env = be.vars()\n   253\u2192    assert expected in env[\"CXXFLAGS\"]\n   254\u2192    assert expected in env[\"CFLAGS\"]\n   255\u2192    assert expected in env[\"LDFLAGS\"]\n   256\u2192    assert \"-debug\" not in env[\"LDFLAGS\"]\n   257\u2192\n   258\u2192\n   259\u2192@pytest.mark.parametrize(\"compiler\", ['msvc'])\n   260\u2192def test_build_type_flag(compiler):\n   261\u2192    \"\"\"Architecture flag is set in CXXFLAGS, CFLAGS and LDFLAGS\"\"\"\n   262\u2192    conanfile = ConanFileMock()\n   263\u2192    conanfile.settings = MockSettings(\n   264\u2192        {\"build_type\": \"Debug\",\n   265\u2192         \"os\": \"Windows\",\n   266\u2192         \"compiler\": compiler,\n   267\u2192         \"arch\": \"x86_64\"})\n   268\u2192    conanfile.settings_build = conanfile.settings\n   269\u2192    be = AutotoolsToolchain(conanfile)\n   270\u2192    assert be.build_type_flags == [\"-Zi\", \"-Ob0\", \"-Od\"]\n   271\u2192    env = be.vars()\n   272\u2192    assert \"-Zi -Ob0 -Od\" in env[\"CXXFLAGS\"]\n   273\u2192    assert \"-Zi -Ob0 -Od\" in env[\"CFLAGS\"]\n   274\u2192    assert \"-Zi -Ob0 -Od\" not in env[\"LDFLAGS\"]\n   275\u2192    assert \"-debug\" in env[\"LDFLAGS\"]\n   276\u2192\n   277\u2192\n   278\u2192def test_apple_arch_flag():\n   279\u2192    conanfile = ConanFileMock()\n   280\u2192    conanfile.conf.define(\"tools.apple:sdk_path\", \"/path/to/sdk\")\n   281\u2192    conanfile.settings_build = MockSettings(\n   282\u2192        {\"build_type\": \"Debug\",\n   283\u2192         \"os\": \"Macos\",\n   284\u2192         \"arch\": \"x86_64\"})\n   285\u2192    conanfile.settings = MockSettings(\n   286\u2192        {\"build_type\": \"Debug\",\n   287\u2192         \"os\": \"iOS\",\n   288\u2192         \"os.version\": \"14\",\n   289\u2192         \"os.sdk\": \"iphoneos\",\n   290\u2192         \"arch\": \"armv8\"})\n   291\u2192    be = AutotoolsToolchain(conanfile)\n   292\u2192    expected = \"-arch arm64\"\n   293\u2192    assert be.apple_arch_flag == expected\n   294\u2192    env = be.vars()\n   295\u2192    assert expected in env[\"CXXFLAGS\"]\n   296\u2192    assert expected in env[\"CFLAGS\"]\n   297\u2192    assert expected in env[\"LDFLAGS\"]\n   298\u2192\n   299\u2192    # Only set when crossbuilding\n   300\u2192    conanfile = ConanFileMock()\n   301\u2192    conanfile.conf.define(\"tools.apple:sdk_path\", \"/path/to/sdk\")\n   302\u2192    conanfile.settings = MockSettings(\n   303\u2192        {\"build_type\": \"Debug\",\n   304\u2192         \"os\": \"Macos\",\n   305\u2192         \"os.version\": \"14\",\n   306\u2192         \"arch\": \"x86_64\"})\n   307\u2192    conanfile.settings_build = MockSettings({\"os\": \"Macos\", \"arch\": \"x86_64\"})\n   308\u2192    be = AutotoolsToolchain(conanfile)\n   309\u2192    assert be.apple_arch_flag is None\n   310\u2192\n   311\u2192\n   312\u2192def test_apple_min_os_flag():\n   313\u2192    \"\"\"Even when no cross building it is adjusted because it could target a Mac version\"\"\"\n   314\u2192    conanfile = ConanFileMock()\n   315\u2192    conanfile.conf.define(\"tools.apple:sdk_path\", \"/path/to/sdk\")\n   316\u2192    conanfile.settings = MockSettings(\n   317\u2192        {\"build_type\": \"Debug\",\n   318\u2192         \"os\": \"Macos\",\n   319\u2192         \"os.version\": \"14\",\n   320\u2192         \"arch\": \"armv8\"})\n   321\u2192    conanfile.settings_build = MockSettings({\"os\": \"Macos\", \"arch\": \"armv8\"})\n   322\u2192    be = AutotoolsToolchain(conanfile)\n   323\u2192    expected = \"-mmacosx-version-min=14\"\n   324\u2192    assert be.apple_min_version_flag == expected\n   325\u2192    env = be.vars()\n   326\u2192    assert expected in env[\"CXXFLAGS\"]\n   327\u2192    assert expected in env[\"CFLAGS\"]\n   328\u2192    assert expected in env[\"LDFLAGS\"]\n   329\u2192\n   330\u2192\n   331\u2192def test_crossbuild_from_macos_to_non_apple_os():\n   332\u2192    \"\"\"Check we are not adding Apple-specific flags\n   333\u2192        when the os_build is Macos, but we are targetting\n   334\u2192        a non-Apple OS (e.g. Linux, Android, QNX)\"\"\"\n   335\u2192    conanfile = ConanFileMock()\n   336\u2192    conanfile.settings = MockSettings({\"os\": \"Android\", \"arch\": \"armv8\"})\n   337\u2192    conanfile.settings_build = MockSettings({\"os\": \"Macos\", \"arch\": \"armv8\"})\n   338\u2192    be = AutotoolsToolchain(conanfile)\n   339\u2192    assert be.apple_min_version_flag == ''\n   340\u2192    assert be.apple_arch_flag is None\n   341\u2192    assert be.apple_isysroot_flag is None\n   342\u2192\n   343\u2192\n   344\u2192def test_apple_isysrootflag():\n   345\u2192    \"\"\"Even when no cross building it is adjusted because it could target a Mac version\"\"\"\n   346\u2192    conanfile = ConanFileMock()\n   347\u2192    conanfile.conf.define(\"tools.apple:sdk_path\", \"/path/to/sdk\")\n   348\u2192    conanfile.settings_build = MockSettings(\n   349\u2192        {\"build_type\": \"Debug\",\n   350\u2192         \"os\": \"Macos\",\n   351\u2192         \"arch\": \"x86_64\"})\n   352\u2192    conanfile.settings = MockSettings(\n   353\u2192        {\"build_type\": \"Debug\",\n   354\u2192         \"os\": \"iOS\",\n   355\u2192         \"os.sdk\": \"iphoneos\",\n   356\u2192         \"os.version\": \"14\",\n   357\u2192         \"arch\": \"armv8\"})\n   358\u2192    be = AutotoolsToolchain(conanfile)\n   359\u2192    expected = \"-isysroot /path/to/sdk\"\n   360\u2192    assert be.apple_isysroot_flag == expected\n   361\u2192    env = be.vars()\n   362\u2192    assert expected in env[\"CXXFLAGS\"]\n   363\u2192    assert expected in env[\"CFLAGS\"]\n   364\u2192    assert expected in env[\"LDFLAGS\"]\n   365\u2192\n   366\u2192    # Only set when crossbuilding\n   367\u2192    conanfile = ConanFileMock()\n   368\u2192    conanfile.conf.define(\"tools.apple:sdk_path\", \"/path/to/sdk\")\n   369\u2192    conanfile.settings = MockSettings(\n   370\u2192        {\"build_type\": \"Debug\",\n   371\u2192         \"os\": \"Macos\",\n   372\u2192         \"os.version\": \"14\",\n   373\u2192         \"arch\": \"armv8\"})\n   374\u2192    conanfile.settings_build = MockSettings(\n   375\u2192        {\"build_type\": \"Debug\",\n   376\u2192         \"os\": \"Macos\",\n   377\u2192         \"os.version\": \"14\",\n   378\u2192         \"arch\": \"armv8\"})\n   379\u2192    be = AutotoolsToolchain(conanfile)\n   380\u2192    assert be.apple_isysroot_flag is None\n   381\u2192\n   382\u2192\n   383\u2192def test_sysrootflag():\n   384\u2192    \"\"\"Even when no cross building it is adjusted because it could target a Mac version\"\"\"\n   385\u2192    conanfile = ConanFileMock()\n   386\u2192    conanfile.conf.define(\"tools.build:sysroot\", \"/path/to/sysroot\")\n   387\u2192    conanfile.settings = MockSettings(\n   388\u2192        {\"build_type\": \"Debug\",\n   389\u2192         \"os\": {\"Darwin\": \"Macos\"}.get(platform.system(), platform.system()),\n   390\u2192         \"arch\": \"x86_64\"})\n   391\u2192    conanfile.settings_build = conanfile.settings\n   392\u2192    be = AutotoolsToolchain(conanfile)\n   393\u2192    expected = \"--sysroot /path/to/sysroot\"\n   394\u2192    assert be.sysroot_flag == expected\n   395\u2192    env = be.vars()\n   396\u2192    assert expected in env[\"CXXFLAGS\"]\n   397\u2192    assert expected in env[\"CFLAGS\"]\n   398\u2192    assert expected in env[\"LDFLAGS\"]\n   399\u2192\n   400\u2192\n   401\u2192def test_custom_defines():\n  