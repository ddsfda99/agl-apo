me == \"epic colour\"\n   106\u2192                    or \"epic color\" in field_name\n   107\u2192                    or \"epic colour\" in field_name\n   108\u2192                    or field_custom == \"com.pyxis.greenhopper.jira:gh-epic-color\"\n   109\u2192                ):\n   110\u2192                    field_ids[\"epic_color\"] = field_id\n   111\u2192                    logger.debug(\n   112\u2192                        f\"Found Epic Color field: {field_id} ({original_name})\"\n   113\u2192                    )\n   114\u2192\n   115\u2192                # Parent field - sometimes used instead of Epic Link\n   116\u2192                elif (\n   117\u2192                    field_name == \"parent\"\n   118\u2192                    or field_name == \"parent issue\"\n   119\u2192                    or \"parent issue\" in field_name\n   120\u2192                ):\n   121\u2192                    field_ids[\"parent\"] = field_id\n   122\u2192                    logger.debug(f\"Found Parent field: {field_id} ({original_name})\")\n   123\u2192\n   124\u2192                # Try to detect any other fields that might be related to Epics\n   125\u2192                elif \"epic\" in field_name and field_id.startswith(\"customfield_\"):\n   126\u2192                    key = f\"epic_{field_name.replace(' ', '_').replace('-', '_')}\"\n   127\u2192                    field_ids[key] = field_id\n   128\u2192                    logger.debug(\n   129\u2192                        f\"Found potential Epic-related field: {field_id} ({original_name})\"\n   130\u2192                    )\n   131\u2192\n   132\u2192            # Cache the results for future use\n   133\u2192            self._field_ids_cache = field_ids\n   134\u2192\n   135\u2192            # If we couldn't find certain key fields, try alternative approaches\n   136\u2192            if \"epic_name\" not in field_ids or \"epic_link\" not in field_ids:\n   137\u2192                logger.debug(\n   138\u2192                    \"Standard field search didn't find all Epic fields, trying alternative approaches\"\n   139\u2192                )\n   140\u2192                self._try_discover_fields_from_existing_epic(field_ids)\n   141\u2192\n   142\u2192            logger.debug(f\"Discovered field IDs: {field_ids}\")\n   143\u2192\n   144\u2192            return field_ids\n   145\u2192\n   146\u2192        except Exception as e:\n   147\u2192            logger.error(f\"Error discovering Jira field IDs: {str(e)}\")\n   148\u2192            # Return an empty dict as fallback\n   149\u2192            return {}\n   150\u2192\n   151\u2192    def _try_discover_fields_from_existing_epic(\n   152\u2192        self, field_ids: dict[str, str]\n   153\u2192    ) -> None:\n   154\u2192        \"\"\"\n   155\u2192        Try to discover Epic fields from existing epics in the Jira instance.\n   156\u2192\n   157\u2192        This is a fallback method used when standard field discovery doesn't find\n   158\u2192        all the necessary Epic-related fields. It searches for an existing Epic and\n   159\u2192        analyzes its field structure to identify Epic fields dynamically.\n   160\u2192\n   161\u2192        Args:\n   162\u2192            field_ids: Dictionary of field IDs to update with discovered fields\n   163\u2192        \"\"\"\n   164\u2192        try:\n   165\u2192            # If we already have both epic fields, no need to search\n   166\u2192            if all(field in field_ids for field in [\"epic_name\", \"epic_link\"]):\n   167\u2192                return\n   168\u2192\n   169\u2192            # Find an Epic in the system\n   170\u2192            epics_jql = \"issuetype = Epic ORDER BY created DESC\"\n   171\u2192            results = self.jira.jql(epics_jql, fields=\"*all\", limit=1)\n   172\u2192\n   173\u2192            # If no epics found, we can't use this method\n   174\u2192            if not results or not results.get(\"issues\"):\n   175\u2192                logger.warning(\"No existing Epics found to analyze field structure\")\n   176\u2192                return\n   177\u2192\n   178\u2192            # Get the most recent Epic\n   179\u2192            epic = results[\"issues\"][0]\n   180\u2192            fields = epic.get(\"fields\", {})\n   181\u2192            logger.debug(f\"Found existing Epic {epic.get('key')} to analyze\")\n   182\u2192\n   183\u2192            # Look for Epic Name and other Epic fields\n   184\u2192            for field_id, value in fields.items():\n   185\u2192                if not field_id.startswith(\"customfield_\"):\n   186\u2192                    continue\n   187\u2192\n   188\u2192                # Analyze the field value to determine what it might be\n   189\u2192                if isinstance(value, str) and field_id not in field_ids.values():\n   190\u2192                    # Epic Name is typically a string value\n   191\u2192                    if \"epic_name\" not in field_ids and 3 <= len(value) <= 255:\n   192\u2192                        field_ids[\"epic_name\"] = field_id\n   193\u2192                        logger.debug(\n   194\u2192                            f\"Discovered possible Epic Name field from existing Epic: {field_id}\"\n   195\u2192                        )\n   196\u2192\n   197\u2192                # Look for color-related values (typically a string like \"green\", \"blue\", etc.)\n   198\u2192                elif isinstance(value, str) and value.lower() in [\n   199\u2192                    \"green\",\n   200\u2192                    \"blue\",\n   201\u2192                    \"red\",\n   202\u2192                    \"yellow\",\n   203\u2192                    \"orange\",\n   204\u2192                    \"purple\",\n   205\u2192                ]:\n   206\u2192                    if \"epic_color\" not in field_ids:\n   207\u2192                        field_ids[\"epic_color\"] = field_id\n   208\u2192                        logger.debug(\n   209\u2192                            f\"Discovered possible Epic Color field from existing Epic: {field_id}\"\n   210\u2192                        )\n   211\u2192                # Look for fields that might be used for Epic Link\n   212\u2192                elif value is not None and \"epic_link\" not in field_ids:\n   213\u2192                    # Epic Link typically references another issue key or ID\n   214\u2192                    try:\n   215\u2192                        # Sometimes the value itself is a string containing a key\n   216\u2192                        if isinstance(value, str) and \"-\" in value and len(value) < 20:\n   217\u2192                            field_ids[\"epic_link\"] = field_id\n   218\u2192                            logger.debug(\n   219\u2192                                f\"Discovered possible Epic Link field from existing Epic: {field_id}\"\n   220\u2192                            )\n   221\u2192                    except Exception as e:\n   222\u2192                        logger.debug(\n   223\u2192                            f\"Error analyzing potential Epic Link field: {str(e)}\"\n   224\u2192                        )\n   225\u2192\n   226\u2192            logger.debug(\n   227\u2192                f\"Updated field IDs after analyzing existing Epic: {field_ids}\"\n   228\u2192            )\n   229\u2192\n   230\u2192        except Exception as e:\n   231\u2192            logger.error(f\"Error discovering fields from existing Epic: {str(e)}\")\n   232\u2192\n   233\u2192    def prepare_epic_fields(\n   234\u2192        self, fields: dict[str, Any], summary: str, kwargs: dict[str, Any]\n   235\u2192    ) -> None:\n   236\u2192        \"\"\"\n   237\u2192        Prepare epic-specific fields for issue creation.\n   238\u2192\n   239\u2192        Args:\n   240\u2192            fields: The fields dictionary to update\n   241\u2192            summary: The issue summary that can be used as a default epic name\n   242\u2192            kwargs: Additional