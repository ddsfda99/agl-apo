xisting Epics found to analyze field structure\")\n   176→                return\n   177→\n   178→            # Get the most recent Epic\n   179→            epic = results[\"issues\"][0]\n   180→            fields = epic.get(\"fields\", {})\n   181→            logger.debug(f\"Found existing Epic {epic.get('key')} to analyze\")\n   182→\n   183→            # Look for Epic Name and other Epic fields\n   184→            for field_id, value in fields.items():\n   185→                if not field_id.startswith(\"customfield_\"):\n   186→                    continue\n   187→\n   188→                # Analyze the field value to determine what it might be\n   189→                if isinstance(value, str) and field_id not in field_ids.values():\n   190→                    # Epic Name is typically a string value\n   191→                    if \"epic_name\" not in field_ids and 3 <= len(value) <= 255:\n   192→                        field_ids[\"epic_name\"] = field_id\n   193→                        logger.debug(\n   194→                            f\"Discovered possible Epic Name field from existing Epic: {field_id}\"\n   195→                        )\n   196→\n   197→                # Look for color-related values (typically a string like \"green\", \"blue\", etc.)\n   198→                elif isinstance(value, str) and value.lower() in [\n   199→                    \"green\",\n   200→                    \"blue\",\n   201→                    \"red\",\n   202→                    \"yellow\",\n   203→                    \"orange\",\n   204→                    \"purple\",\n   205→                ]:\n   206→                    if \"epic_color\" not in field_ids:\n   207→                        field_ids[\"epic_color\"] = field_id\n   208→                        logger.debug(\n   209→                            f\"Discovered possible Epic Color field from existing Epic: {field_id}\"\n   210→                        )\n   211→                # Look for fields that might be used for 