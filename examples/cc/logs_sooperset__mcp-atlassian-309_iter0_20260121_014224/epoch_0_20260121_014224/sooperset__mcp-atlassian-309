                 or kwargs.pop(\"epic_colour\", None)\n   276\u2192                    or \"green\"  # Default color\n   277\u2192                )\n   278\u2192\n   279\u2192                # Store for post-creation update\n   280\u2192                kwargs[\"__epic_color_field\"] = epic_color_field\n   281\u2192                kwargs[\"__epic_color_value\"] = epic_color\n   282\u2192                logger.info(\n   283\u2192                    f\"Storing Epic Color ({epic_color_field}: {epic_color}) for post-creation update\"\n   284\u2192                )\n   285\u2192\n   286\u2192            # Store any other epic-related fields for later update\n   287\u2192            for key, value in list(kwargs.items()):\n   288\u2192                if key.startswith(\"epic_\") and key in field_ids:\n   289\u2192                    field_key = key.replace(\"epic_\", \"\")\n   290\u2192                    # Store for post-creation update\n   291\u2192                    kwargs[f\"__epic_{field_key}_field\"] = field_ids[key]\n   292\u2192                    kwargs[f\"__epic_{field_key}_value\"] = value\n   293\u2192                    logger.info(\n   294\u2192                        f\"Storing Epic field ({field_ids[key]} from {key}: {value}) for post-creation update\"\n   295\u2192                    )\n   296\u2192                    kwargs.pop(key)  # Remove from kwargs to avoid duplicate processing\n   297\u2192\n   298\u2192            # Warn if epic_name field is required but wasn't discovered\n   299\u2192            if not epic_name_field:\n   300\u2192                logger.warning(\n   301\u2192                    \"Could not find Epic Name field ID. Epic creation may fail. \"\n   302\u2192                    \"Consider setting it explicitly in your kwargs.\"\n   303\u2192                )\n   304\u2192\n   305\u2192        except Exception as e:\n   306\u2192            logger.error(f\"Error preparing Epic-specific fields: {str(e)}\")\n   307\u2192\n   308\u2192    def _get_epic_name_field_id(self, field_ids: dict[str, str]) -> str | None:\n   309\u2192        \"\"\"\n   310\u2192        Get the field ID for Epic Name, using multiple strategies.\n   311\u2192\n   312\u2192        Args:\n   313\u2192            field_ids: Dictionary of field IDs\n   314\u2192\n   315\u2192        Returns:\n   316\u2192            The field ID for Epic Name if found, None otherwise\n   317\u2192        \"\"\"\n   318\u2192        # Strategy 1: Check if already discovered by get_jira_field_ids\n   319\u2192        if \"epic_name\" in field_ids:\n   320\u2192            return field_ids[\"epic_name\"]\n   321\u2192        if \"Epic Name\" in field_ids:\n   322\u2192            return field_ids[\"Epic Name\"]\n   323\u2192\n   324\u2192        # Strategy 2: Check common field IDs used across different Jira instances\n   325\u2192        common_ids = [\"customfield_10011\", \"customfield_10005\", \"customfield_10004\"]\n   326\u2192        for field_id in common_ids:\n   327\u2192            if field_id in field_ids.values():\n   328\u2192                logger.debug(f\"Using common Epic Name field ID: {field_id}\")\n   329\u2192                return field_id\n   330\u2192\n   331\u2192        # Strategy 3: Try to find by dynamic name pattern in available fields\n   332\u2192        for key, value in field_ids.items():\n   333\u2192            if (\n   334\u2192                \"epic\" in key.lower() and \"name\" in key.lower()\n   335\u2192            ) or \"epicname\" in key.lower():\n   336\u2192                logger.debug(f\"Found potential Epic Name field by pattern: {value}\")\n   337\u2192                return value\n   338\u2192\n   339\u2192        logger.debug(\"Could not determine Epic Name field ID\")\n   340\u2192        return None\n   341\u2192\n   342\u2192    def _get_epic_color_field_id(self, field_ids: dict[str, str]) -> str | None:\n   343\u2192        \"\"\"\n   344\u2192        Get the field ID for Epic Color, using multiple strategies.\n   345\u2192\n   346\u2192        Args:\n   347\u2192            field_ids: Dictionary of field IDs\n   348\u2192\n   349\u2192        Returns:\n   350\u2192            The field ID for Epic Color if found, None otherwise\n   351\u2192        \"\"\"\n   352\u2192        # Strategy 1: Check if already discovered by get_jira_field_ids\n   353\u2192        if \"epic_color\" in field_ids:\n   354\u2192            return field_ids[\"epic_color\"]\n   355\u2192        if \"epic_colour\" in field_ids:\n   356\u2192            return field_ids[\"epic_colour\"]\n   357\u2192\n   358\u2192        # Strategy 2: Check common field IDs\n   359\u2192        common_ids = [\"customfield_10012\", \"customfield_10013\"]\n   360\u2192        for field_id in common_ids:\n   361\u2192            if field_id in field_ids.values():\n   362\u2192                logger.debug(f\"Using common Epic Color field ID: {field_id}\")\n   363\u2192                return field_id\n   364\u2192\n   365\u2192        # Strategy 3: Find by dynamic name pattern\n   366\u2192        for key, value in field_ids.items():\n   367\u2192            if \"epic\" in key.lower() and (\n   368\u2192                \"color\" in key.lower() or \"colour\" in key.lower()\n   369\u2192            ):\n   370\u2192                logger.debug(f\"Found potential Epic Color field by pattern: {value}\")\n   371\u2192                return value\n   372\u2192\n   373\u2192        logger.debug(\"Could not determine Epic Color field ID\")\n   374\u2192        return None\n   375\u2192\n   376\u2192    def link_issue_to_epic(self, issue_key: str, epic_key: str) -> JiraIssue:\n   377\u2192        \"\"\"\n   378\u2192        Link an existing issue to an epic.\n   379\u2192\n   380\u2192        Args:\n   381\u2192            issue_key: The key of the issue to link (e.g. 'PROJ-123')\n   382\u2192            epic_key: The key of the epic to link to (e.g. 'PROJ-456')\n   383\u2192\n   384\u2192        Returns:\n   385\