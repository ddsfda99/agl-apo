26→        \"\"\"\n    27→        Dynamically discover Jira field IDs relevant to Epic linking.\n    28→        This method queries the Jira API to find the correct custom field IDs\n    29→        for Epic-related fields, which can vary between different Jira instances.\n    30→\n    31→        Returns:\n    32→            Dictionary mapping field names to their IDs\n    33→            (e.g., {'epic_link': 'customfield_10014', 'epic_name': 'customfield_10011'})\n    34→        \"\"\"\n    35→        try:\n    36→            # Check if we've already cached the field IDs\n    37→            if hasattr(self, \"_field_ids_cache\") and self._field_ids_cache:\n    38→                return self._field_ids_cache\n    39→\n    40→            # Fetch all fields from Jira API\n    41→            fields = self.jira.get_all_fields()\n    42→            field_ids = {}\n    43→\n    44→            # Log the complete list of fields for debugging\n    45→            all_field_names = [field.get(\"name\", \"\").lower() for field in fields]\n    46→            logger.debug(f\"All field names: {all_field_names}\")\n    47→\n    48→            # Enhanced logging for debugging\n    49→            custom_fields = {\n    50→                field.get(\"id\", \"\"): field.get(\"name\", \"\")\n    51→                for field in fields\n    52→                if field.get(\"id\", \"\").startswith(\"customfield_\")\n    53→            }\n    54→            logger.debug(f\"Custom fields: {custom_fields}\")\n    55→\n    56→            # Look for Epic-related fields - use multiple strategies to identify them\n    57→            for field in fields:\n    58→                field_name = field.get(\"name\", \"\").lower()\n    59→                original_name = field.get(\"name\", \"\")\n    60→                field_id = field.get(\"id\", \"\")\n    61→                field_schema = field.get(\"schema\", {})\n    62→                field_type = field_schema.get(\"type\", \"\")\n    63→                field_custom = field_schema.get(\"custom\", \"\")\n    64→\n    65→                # Epic Link field - used to link issues to epics\n    66→                if (\n    67→                    field_name == \"epic link\"\n    68→                    or field_name == \"epic\"\n    69→                    or \"epic link\" in field_name\n    70→                    or field_custom == \"com.pyxis.greenhopper.jira:gh-epic-link\"\n    71→                    or field_id == \"customfield_10014\"\n    72→                ):  # Common in Jira Cloud\n    73→                    field_ids[\"epic_link\"] = field_id\n    74→                    # For backward compatibility\n    75→                    field_ids[\"Epic Link\"] = field_id\n    76→                    logger.debug(f\"Found Epic Link field: {field_id} ({original_name})\")\n    77→\n    78→                # Epic Name field - used when creating epics\n    79→                elif (\n    80→                    field_name == \"epic name\"\n    81→                    or field_name == \"epic title\"\n    82→                    or \"epic name\" in field_name\n    83→                    or field_custom == \"com.pyxis.greenhopper.jira:gh-epic-label\"\n    84→                    or field_id == \"customfield_10011\"\n    85→                ):  # Common in Jira Cloud\n    86→                    field_ids[\"epic_name\"] = field_id\n    87→                    # For backward compatibility\n    88→                    field_ids[\"Epic Name\"] = field_id\n    89→                    logger.debug(f\"Found Epic Name field: {field_id} ({original_name})\")\n    90→\n    91→                # Epic Status field\n    92→                elif (\n    93→                    field_name == \"epic status\"\n    94→                    or \"epic status\" in field_name\n    95→                    or field_custom == \"com.pyxis.greenhopper.jira:gh-epic-status\"\n    96→                ):\n    97→                    field_ids[\"epic_status\"] = field_id\n    98→                    logger.debug(\n    99→                        f\"Found Epic Status field: {field_id} ({original_name})\"\n   100→                    )\n   101→\n   102→                # Epic Color field\n   103→                elif (\n   104→                    field_name == \"epic color\"\n   105→                    or field_name == \"epic colour\"\n   106→                    or \"epic color\" in field_name\n   107→                    or \"epic colour\" in field_name\n   108→                    or field_custom == \"com.pyxis.greenhopper.jira:gh-epic-color\"\n   109→                ):\n   110→                    field_ids[\"epic_color\"] = field_id\n   111→                    logger.debug(\n   112→                        f\"Found Epic Color field: {field_id} ({original_name})\"\n   113→                    )\n   114→\n   115→                # Parent field - sometimes used instead of Epic Link\n   116→                elif (\n   117→                    field_name == \"parent\"\n   118→                    or field_name == \"parent issue\"\n   119→                    or \"parent issue\" in field_name\n   120→                ):\n   121→                    field_ids[\"parent\"] = field_id\n   122→                    logger.debug(f\"Found Parent field: {field_id} ({original_name})\")\n   123→\n   124→                # Try to detect any other fields that might be related to Epics\n   125→                elif \"epic\" in field_name and field_id.startswith(\"customfield_\"):\n   126→                    key = f\"epic_{field_name.replace(' ', '_').replace('-', '_')}\"\n   127→                    field_ids[key] = field_id\n   128→                    logger.debug(\n   129→                        f\"Found potential Epic-related field: {field_id} ({original_name})\"\n   130→                    )\n   131→\n   132→            # Cache the results for future use\n   133→            self._field_ids_cache = field_ids\n   134→\n   135→            # If we couldn't find certain key fields,