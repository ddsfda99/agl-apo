        name = name or callback.__name__\n   599\u2192        job = Job(callback=callback, data=data, name=name, chat_id=chat_id, user_id=user_id)\n   600\u2192\n   601\u2192        j = self.scheduler.add_job(\n   602\u2192            self.job_callback,\n   603\u2192            name=name,\n   604\u2192            args=(self, job),\n   605\u2192            trigger=\"cron\",\n   606\u2192            day_of_week=\",\".join([self._CRON_MAPPING[d] for d in days]),\n   607\u2192            hour=time.hour,\n   608\u2192            minute=time.minute,\n   609\u2192            second=time.second,\n   610\u2192            timezone=time.tzinfo or self.scheduler.timezone,\n   611\u2192            **job_kwargs,\n   612\u2192        )\n   613\u2192\n   614\u2192        job._job = j  # pylint: disable=protected-access\n   615\u2192        return job\n   616\u2192\n   617\u2192    def run_custom(\n   618\u2192        self,\n   619\u2192        callback: JobCallback[CCT],\n   620\u2192        job_kwargs: JSONDict,\n   621\u2192        data: Optional[object] = None,\n   622\u2192        name: Optional[str] = None,\n   623\u2192        chat_id: Optional[int] = None,\n   624\u2192        user_id: Optional[int] = None,\n   625\u2192    ) -> \"Job[CCT]\":\n   626\u2192        \"\"\"Creates a new custom defined :class:`Job`.\n   627\u2192\n   628\u2192        Args:\n   629\u2192            callback (:term:`coroutine function`): The callback function that should be executed by\n   630                the new job. Callback signature::\n   631\u2192\n   632\u2192                    async def callback(context: CallbackContext)\n   633\u2192\n   634\u2192            job_kwargs (:obj:`dict`): Arbitrary keyword arguments. Used as arguments for\n   635\u2192                :meth:`apscheduler.schedulers.base.BaseScheduler.add_job`.\n   636\u2192            data (:obj:`object`, optional): Additional data needed for the callback function.\n   637\u2192                Can be accessed through :attr:`Job.data` in the callback. Defaults to\n   638\u2192                :obj:`None`.\n   639\u2192\n   640\u2192                .. versionchanged:: 20.0\n   641\u2192                    Renamed the parameter ``context`` to :paramref:`data`.\n   642\u2192            name (:obj:`str`, optional): The name of the new job. Defaults to\n   643\u2192                :external:attr:`callback.__name__ <definition.__name__>`.\n   644\u2192            chat_id (:obj:`int`, optional): Chat id of the chat associated with this job. If\n   645\u2192                passed, the corresponding :attr:`~telegram.ext.CallbackContext.chat_data` will\n   646\u2192                be available in the callback.\n   647\u2192\n   648\u2192                .. versionadded:: 20.0\n   649\u2192\n   650\u2192            user_id (:obj:`int`, optional): User id of the user associated with this job. If\n   651\u2192                passed, the corresponding :attr:`~telegram.ext.CallbackContext.user_data` will\n   652\u2192                be available in the callback.\n   653\u2192\n   654\u2192                .. versionadded:: 20.0\n   655\u2192\n   656\u2192        Returns:\n   657\u2192            :class:`telegram.ext.Job`: The new :class:`Job` instance that has been added to the job\n   658\u2192            queue.\n   659\u2192\n   660\u2192        \"\"\"\n   661\u2192        name = name or callback.__name__\n   662\u2192        job = Job(callback=callback, data=data, name=name, chat_id=chat_id, user_id=user_id)\n   663\u2192\n   664\u2192        j = self.scheduler.add_job(self.job_callback, args=(self, job), name=name, **job_kwargs)\n   665\u2192\n   666\u2192        job._job = j  # pylint: disable=protected-access\n   667\u2192        return job\n   668\u2192\n   669\u2192    async def start(self) -> None:\n   670\u2192        # this method async just in case future versions need that\n   671\u2192        \"\"\"Starts the :class:`~telegram.ext.JobQueue`.\"\"\"\n   672\u2192        if not self.scheduler.running:\n   673\u2192            self.scheduler.start()\n   674\u2192\n   675\u2192    async def stop(self, wait: bool = True) -> None:\n   676\u2192        \"\"\"Shuts down the :class:`~telegram.ext.JobQueue`.\n   677\u2192\n   678\u2192        Args:\n   679\u2192            wait (:obj:`bool`, optional): Whether to wait until all currently running jobs\n   680\u2192                have finished. Defaults to :obj:`True`.\n   681\u2192\n   682\u2192        \"\"\"\n   683\u2192        # the interface methods of AsyncIOExecutor are currently not really asyncio-compatible\n   684\u2192        # so we apply some small tweaks here to try and smoothen the integration into PTB\n   685\u2192        # TODO: When APS 4.0 hits, we should be able to remove the tweaks\n   686\u2192        if wait:\n   687\u2192            # Unfortunately AsyncIOExecutor just cancels them all ...\n   688\u2192            await asyncio.gather(\n   689\u2192                *self._executor._pending_futures,  # pylint: disable=protected-access\n   690\u2192                return_exceptions=True,\n   691\u2192            )\n   692\u2192        if self.scheduler.running:\n   693\u2192            self.scheduler.shutdown(wait=wait)\n   694\u2192            # scheduler.shutdown schedules a task in the event loop but immediately returns\n   695\u2192            # so give it a tiny bit of time to actually shut down.\n   696\u2192            await asyncio.sleep(0.01)\n   697\u2192\n   698\u2192    def jobs(self) -> tuple[\"Job[CCT]\", ...]:\n   699\u2192        \"\"\"Returns a tuple of all *scheduled* jobs that are currently in the :class:`JobQueue`.\n   700\u2192\n   701\u2192        Returns:\n   702\u2192            tuple[:class:`Job`]: Tuple of all *scheduled* jobs.\n   703\u2192        \"\"\"\n   704\u2192        return tuple(Job.from_aps_job(job) for job in self.scheduler.get_jobs())\n   705\u2192\n   706\u2192    def get_jobs_by_name(self, name: str, use_regex: bool = False) -> tuple[\"Job[CCT]\", ...]:\n   707\u2192        \"\"\"Returns a tuple of all *pending/scheduled* jobs with the given name that are currently\n   708\u2192        in the :class:`JobQueue`.\n   709\u2192\n   710\u2192        If ``use_regex`` is set to :obj:`True`, the :func:`re.search` function is used to look for\n   711\u2192        a match with the provided ``name`` as pattern on ``job.name``.\n   712\u2192\n   713\u2192        Args:\n   714\u2192            name (:obj:`str`): The name or regex pattern to match against job names.\n   715\u2192            use_regex (:obj:`bool`, optional): Whether to treat ``name`` as a regex pattern.\n   716\u2192                Defaults to :obj:`False`.\n   717\u2192\n   718\u2192        Returns:\n   719\u2192            tuple[:class:`Job`]: Tuple of all *pending* or *scheduled* jobs matching the name.\n   720\u2192        \"\"\"\n   721\u2192        if use_regex:\n   722\u2192            from re import compile as _re_compile\n   723\u2192\n   724\u2192            pattern = _re_compile(str(name))\n   725\u2192            return tuple(job for job in self.jobs() if job.name and pattern.search(job.name))\n   726\u2192\n   727\u2192        return tuple(job for job in self.jobs() if job.name == name)\n   728\u2192\n   729\u2192\n   730\u2192class Job(Generic[CCT]):\n   731\u2192    \"\"\"This class is a convenience wrapper for the jobs held in a :class:`telegram.ext.JobQueue`.\n   732\u2192    With the current backend APScheduler, :attr:`job` holds a :class:`apscheduler.job.Job`\n   733\u2192    instance.\n   734\u2192\n   735\u2192    Objects of this class are comparable in terms of equality. Two objects of this class are\n   736\u2192    considered equal, if their :class:`id <apscheduler.job.Job>` is equal.\n   737\u2192\n   738\u2192    This class is a :class:`~typing.Generic` class and accepts one type variable that specifies\n   739\u2192    the type of the argument ``context`` of :paramref:`callback`.\n   740\u2192\n   741\u2192    Important:\n   742\u2192