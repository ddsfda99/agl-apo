_repeating_last_timezone(self, job_queue, timezone):\n   219→        \"\"\"Test correct scheduling of job when passing a timezone-aware datetime as ``last``\"\"\"\n   220→        job_queue.run_repeating(\n   221→            self.job_run_once, 0.25, last=dtm.datetime.now(timezone) + dtm.timedelta(seconds=0.4)\n   222→        )\n   223→        await asyncio.sleep(0.3)\n   224→        assert self.result == 1\n   225→        await asyncio.sleep(0.4)\n   226→        assert self.result == 1\n   227→\n   228→    async def test_run_repeating_last_before_first(self, job_queue):\n   229→        with pytest.raises(ValueError, match=\"'last' must not be before 'first'!\"):\n   230→            job_queue.run_repeating(self.job_run_once, 0.5, first=1, last=0.5)\n   231→\n   232→    async def test_run_repeating_timedelta(self, job_queue):\n   233→        job_queue.run_repeating(self.job_run_once, dtm.timedelta(seconds=0.1))\n   234→        await asyncio.sleep(0.25)\n   235→        assert self.result == 2\n   236→\n   237→    async def test_run_custom(self, job_queue):\n   238→        job_queue.run_custom(self.job_run_once, {\"trigger\": \"interval\", \"seconds\": 0.2})\n   239→        await asyncio.sleep(0.5)\n   240→        assert self.result == 2\n   241→\n   242→    async def test_multiple(self, job_queue):\n   243→        job_queue.run_once(self.job_run_once, 0.1)\n   244→        job_queue.run_once(self.job_run_once, 0.2)\n   245→        job_queue.run_repeating(self.job_run_once, 0.2)\n   246→        await asyncio.sleep(0.55)\n   247→        assert self.result == 4\n   248→\n   249→    async def test_disabled(self, job_queue):\n   250→        j1 = job_queue.run_once(self.job_run_once, 0.1)\n   251→        j2 = job_queue.run_repeating(self.job_run_once, 0.5)\n   252→\n   253→        j1.enabled = False\n   254→        j2.enabled = False\n   255→\n   256→        await asyncio.sleep(0.6)\n   257→\n   258→        assert self.result == 0\n   259→\n   260→        j1.enabled = True\n   261→\n   262→        await asyncio.sleep(0.6)\n   263→\n   264→        assert self.result == 1\n   265→\n   266→    async def test_schedule_removal(self, job_queue):\n   267→        j1 = job_queue.run_once(self.job_run_once, 0.3)\n   268→        j2 = job_queue.run_repeating(self.job_run_once, 0.2)\n   269→\n   270→        await asyncio.sleep(0.25)\n   271→        assert self.result == 1\n   272→\n   273→        j1.schedule_removal()\n   274→        j2.schedule_removal()\n   275→\n   276→        await asyncio.sleep(0.4)\n   277→\n   278→        assert self.result == 1\n   279→\n   280→    async def test_schedule_removal_from_within(self, job_queue):\n   281→        job_queue.run_repeating(self.job_remove_self, 0.1)\n   282→\n   283→        await asyncio.sleep(0.5)\n   284→\n   285→        assert self.result == 1\n   286→\n   287→    async def test_longer_first(self, job_queue):\n   288→        job_queue.run_once(self.job_run_once, 0.2)\n   289→        job_queue.run_once(self.job_run_once, 0.1)\n   290→\n   291→        await asyncio.sleep(0.15)\n   292→\n   293→        assert self.result == 1\n   294→\n   295→    async def test_error(self, job_queue):\n   296→        job_queue.run_repeating(self.job_with_exception, 0.1)\n   297→        job_queue.run_repeating(self.job_run_once, 0.2)\n   298→        await asyncio.sleep(0.3)\n   299→        assert self.result == 1\n   300→\n   301→    async def test_in_application(self, bot_info):\n   302→        app = ApplicationBuilder().bot(make_bot(bot_info)).build()\n   303→        async with app:\n   304→            assert not app.job_queue.scheduler.running\n   305→            await app.start()\n   306→            assert app.job_queue.scheduler.running\n   307→\n   308→            app.job_queue.run_repeating(self.job_run_once, 0.2)\n   309→            await asyncio.sleep(0.3)\n   310→            assert self.result == 1\n   311→            await app.stop()\n   312→            assert not app.job_queue.scheduler.running\n   313→            await asyncio.sleep(1)\n   314→            assert self.result == 1\n   315→\n   316→    async def test_time_unit_int(self, job_queue):\n   317→        # Testing seconds in int\n   318→        delta = 0.5\n   319→        expected_time = time.time() + delta\n   320→\n   321→        job_queue.run_once(self.job_datetime_tests, delta)\n   322→        await asyncio.sleep(0.6)\n   323→        assert pytest.approx(self.job_time) == expected_time\n   324→\n   325→    async def test_time_unit_dt_timedelta(self, job_queue):\n   326→        # Testing seconds, minutes and hours as datetime.timedelta object\n   327→        # This is sufficient to test that it actually works.\n   328→        interval = dtm.timedelta(seconds=0.5)\n   329→        expected_time = time.time() + interval.total_seconds()\n   330→\n   331→        job_queue.run_once(self.job_datetime_tests, interval)\n   332→        await asyncio.sleep(0.6)\n   333→        assert pytest.approx(self.job_time) == expected_time\n   334→\n   335→    async def test_time_unit_dt_datetime(self, job_queue):\n   336→        # Testing running at a specific datetime\n   337→        delta, now = dtm.timedelta(seconds=0.5), dtm.datetime.now(UTC)\n   338→        when = now + delta\n   339→        expected_time = when.timestamp()\n   340→\n   341→        job_queue.run_once(self.job_datetime_tests, when)\n   342→        await asyncio.sleep(0.6)\n   343→        assert self.job_time == pytest.approx(expected_time)\n   344→\n   345→    async def test_time_unit_dt_time_today(self, job_queue):\n   346→        # Testing running at a specific time today\n   347→        delta, now = 0.5, dtm.datetime.now(UTC)\n   348→        expected_time = now + dtm.timedelta(seconds=delta)\n   349→        when = expected_time.time()\n   350→        expected_time = expected_time.timestamp()\n   351→\n   352→        job_queue.run_once(self.job_datetime_tests, when)\n   353→        await asyncio.sleep(0.6)\n   354→        assert self.job_time == pytest.approx(expected_time)\n   355→\n   356→    async def test_time_unit_dt_time_tomorrow(self, job_queue):\n   357→        # Testing running at a specific time that has passed today. Since we can't wait a day, we\n   358→        # test if the job's next scheduled execution time has been calculated correctly\n   359→        delta, now = -2, dtm.datetime.now(UTC)\n   360→        when = (now + dtm.timedelta(seconds=delta)).time()\n   361→        expected_time = (now + dtm.timedelta(seconds=delta, days=1)).timestamp()\n   362→\n   363→        job_queue.run_once(self.job_datetime_tests, when)\n   364→        scheduled_time = job_queue.jobs()[0].next_t.timestamp()\n   365→        assert scheduled_time == pytest.approx(expected_time)\n   366→\n   367→    async def test_time_unit_dt_aware_time(self, job_queue, timezone):\n   368→        # Testing running at a specific tz-aware time today\n   369→        delta, now = 0.5, dtm.datetime.now(timezone)\n   370→        expected_time = now + dtm.timedelta(seconds=delta)\n   371→        when = expected_time.timetz()\n   372→        expected_time = expected_time.timestamp()\n   373→\n   374→        job_queue.run_once(self.job_datetime_tests, when)\n   375→        await asyncio.sleep(0.6)\n   376→        assert self.job_time == pytest.approx(expected_time)\n   377→\n   378→    async def test_run_daily(self, job_queue):\n   379→        delta, now = 1, dtm.datetime.now(UTC)\n   380→        time_of_day = (now + dtm.timedelta(seconds=delta)).time()\n   381→        expected_reschedule_time = (now + dtm.timedelta(seconds=delta, days=1)).timestamp()\n   382→\n   383→        job_queue.run_daily(self.job_run_once, time_of_day)\n   384→        await asyncio.sleep(delta + 0.1)\n   385→        assert self.result == 1\n   386→        scheduled_time = job_queue.jobs()[0].next_t.timestamp()\n   387→        assert scheduled_time == pytest.approx(expected_reschedule_time)\n   388→\n   389→    @pytest.mark.parametrize(\"weekday\", [0, 1, 2, 3, 4, 5, 6])\n   390→    async def test_run_daily_days_of_week(self, job_queue, weekday):\n   391→        delta, now = 1, dtm.datetime.now(UTC)\n   392→        time_of_day = (now + dtm.timedelta(seconds=delta)).time()\n   393→        # offset in days until next weekday\n   394→        offset = (weekday + 6 - now.weekday()) % 7\n   395→        offset = offset if offset > 0 else 7\n   396→        expected_reschedule_time = (now + dtm.timedelta(seconds=delta, days=offset)).timestamp()\n   397→\n   398→        job_queue.run_daily(self.job_run_once, time_of_day, days=[weekday])\n   399→        await asyncio.sleep(delta + 0.1)\n   400→        scheduled_time = job_queue.jobs()[0].next_t.timestamp()\n   401→        assert scheduled_time == pytest.approx(expected_reschedule_time)\n   402→\n   403→    async def test_run_monthly(self, job_queue, timezone):\n   404→        delta, now = 1, dtm.datetime.now(timezone)\n   405→        expected_reschedule_time = now + dtm.timedelta(seconds=delta)\n   406→        time_of_day = expected_reschedule_time.time().replace(tzinfo=timezone)\n   407→\n   408→        day = now.day\n   409→        this_months_days = calendar.monthrange(now.year, now.month)[1]\n   410→        if now.month == 12:\n   411→            next_months_days = calendar.monthrange(now.year + 1, 1)[1]\n   412→        else:\n   413→            next_months_days = calendar.monthrange(now.year, now.month + 1)[1]\n   414→\n   415→        expected_reschedule_time += dtm.timedelta(this_months_days)\n   416→        if day > next_months_days:\n   417→            expected_reschedule_time += dtm.timedelta(next_months_days)\n   418→\n   419→        expected_reschedule_time = self.normalize(expected_reschedule_time, timezone)\n   420→        # Adjust the hour for the special case that between now and next month a DST switch happens\n   421→        expected_reschedule_time += dtm.timedelta(\n   422→            hours=time_of_day.hour - expected_reschedule_time.hour\n   423→        )\n   424→        expected_reschedule_time = expected_reschedule_time.timestamp()\n   425→\n   426→        job_queue.run_monthly(self.job_run_once, time_of_day, day)\n   427→        await asyncio.sleep(delta + 0.1)\n   428→        assert self.result == 1\n   429→        scheduled_time = job_queue.jobs()[0].next_t.timestamp()\n   430→        assert scheduled_time == pytest.approx(expected_reschedule_time, rel=1e-3)\n   431→\n   432→    async def test_run_monthly_non_strict_day(self, job_queue, timezone):\n   433→        delta, now = 1, dtm.datetime.now(timezone)\n   434→        expected_reschedule_time = now + dtm.timedelta(seconds=delta)\n   435→        time_of_day = expected_reschedule_time.time().replace(tzinfo=timezone)\n   436→\n   437→        expected_reschedule_time += dtm.timedelta(\n   438→            calendar.monthrange(now.year, now.month)[1]\n   439→        ) - dtm.timedelta(days=now.day)\n   440→        # Adjust the hour for the special case that between now & end of month a DST switch happens\n   441→        expected_reschedule_time = self.normalize(expected_reschedule_time, timezone)\n   442→        expected_reschedule_time += dtm.timedelta(\n   443→            hours=time_of_day.hour - expected_reschedule_time.hour\n   444→        )\n   445→        expected_reschedule_time = expected_reschedule_time.timestamp()\n   446→\n   447→        job_queue.run_monthly(self.job_run_once, time_of_day, -1)\n   448→        scheduled_time = job_queue.jobs()[0].next_t.timestamp()\n   449→        assert scheduled_time == pytest.approx(expected_reschedule_time)\n   450→\n   451→    async def test_default_tzinfo(self, tz_bot):\n   452→        # we're parametrizing this with two different UTC offsets to exclude the possibility\n   453→        # of an xpass when the test is run in a timezone with the same UTC offset\n   454→        app = ApplicationBuilder().bot(tz_bot).build()\n   455→        jq = app.job_queue\n   456→        await jq.start()\n   457→\n   458→        when = dtm.datetime.now(tz_bot.defaults.tzinfo) + dtm.timedelta(seconds=0.1)\n   459→        jq.run_once(self.job_run_once, when.time())\n   460→        await asyncio.sleep(0.15)\n   461→        assert self.result == 1\n   462→\n   463→        await jq.stop()\n   464→\n   465→    async def test_get_jobs(self, job_queue):\n   466→        callback = self.job_run_once\n   467→\n   468→        job1 = job_queue.run_once(callback, 10, name=\"name1\")\n   469→        await asyncio.sleep(0.03)  # To stablize tests on windows\n   470→        job2 = job_queue.run_once(callback, 10, name=\"name1\")\n   471→        await asyncio.sleep(0.03)\n   472→        job3 = job_queue.run_once(callback, 10, name=\"name2\")\n   473→        await asyncio.sleep(0.03)\n   474→\n   475→        assert job_queue.jobs() == (job1, job2, job3)\n   476→        assert job_queue.get_jobs_by_name(\"name1\") == (job1, job2)\n   477→        assert job_queue.get_jobs_by_name(\"name2\") == (job3,)\n   478→\n   479→    async def test_job_run(self, app):\n   480→        job = app.job_queue.run_repeating(self.job_run_once, 0.02)\n   481→        await asyncio.sleep(0.05)  # the job queue has not started yet\n   482→        assert self.result == 0  # so the job will not run\n   483→        await job.run(app)  # but this will force it to run\n   484→        assert self.result == 1\n   485→\n   486→    async def test_enable_disable_job(self, job_queue):\n   487→        job = job_queue.run_repeating(self.job_run_once, 0.2)\n   488→        await asyncio.sleep(0.5)\n   489→        assert self.result == 2\n   490→        job.enabled = False\n   491→        assert not job.enabled\n   492→        await asyncio.sleep(0.5)\n   493→        assert self.result == 2\n   494→        job.enabled = True\n   495→        assert job.enabled\n   496→        await asyncio.sleep(0.5)\n   497→        assert self.result == 4\n   498→\n   499→    async def test_remove_job(self, job_queue):\n   500→        job = job_queue.run_repeating(self.job_run_once, 0.2)\n   501→        await asyncio.sleep(0.5)\n   502→        assert self.result == 2\n   503→        assert not job.removed\n   504→        job.schedule_removal()\n   505→        assert job.removed\n   506→        await asyncio.sleep(0.5)\n   507→        assert self.result == 2\n   508→\n   509→    async def test_equality(self, job_queue):\n   510→        job = job_queue.run_repeating(self.job_run_once, 0.2)\n   511→        job_2 = job_queue.run_repeating(self.job_run_once, 0.2)\n   512→        job_3 = Job(self.job_run_once, 0.2)\n   513→        job_3._job = job.job\n   514→        assert job == job  # noqa: PLR0124\n   515→        assert job != job_queue\n   516→        assert job != job_2\n   517→        assert job == job_3\n   518→\n   519→        assert hash(job) == hash(job)\n   520→        assert hash(job) != hash(job_queue)\n   521→        assert hash(job) != hash(job_2)\n   522→        assert hash(job) == hash(job_3)\n   523→\n   524→    async def test_process_error_context(self, job_queue, app):\n   525→        app.add_error_handler(self.error_handler_context)\n   526→\n   527→        job = job_queue.run_once(self.job_with_exception, 0.1, chat_id=42, user_id=43)\n   528→        await asyncio.sleep(0.15)\n   529→        assert self.received_error[0] == \"Test Error\"\n   530→        assert self.received_error[1] is job\n   531→        self.received_error = None\n   532→        await job.run(app)\n   533→        assert self.received_error[0] == \"Test Error\"\n   534→        assert self.received_error[1] is job\n   535→        assert self.received_error[2] is app.user_data[43]\n   536→        assert self.received_error[3] is app.chat_data[42]\n   537→\n   538→        # Remove handler\n   539→        app.remove_error_handler(self.error_handler_context)\n   540→        self.received_error = None\n   541→\n   542→        job = job_queue.run_once(self.job_with_exception, 0.1)\n   543→        await asyncio.sleep(0.15)\n   544→        assert self.received_error is None\n   545→        await job.run(app)\n   546→        assert self.received_error is None\n   547→\n   548→    async def test_process_error_that_raises_errors(self, job_queue, app, caplog):\n   549→        app.add_error_handler(self.error_handler_raise_error)\n   550→\n   551→        with caplog.at_level(logging.ERROR):\n   552→            job = job_queue.run_once(self.job_with_exception, 0.1)\n   553→        await asyncio.sleep(0.15)\n   554→        assert len(caplog.records) == 1\n   555→        rec = caplog.records[-1]\n   556→        assert \"An error was raised and an uncaught\" in rec.getMessage()\n   557→        caplog.clear()\n   558→\n   559→        with caplog.at_level(logging.ERROR):\n   560→            await job.run(app)\n   561→        assert len(caplog.records) == 1\n   562→        rec = caplog.records[-1]\n   563→        assert \"uncaught error was raised while handling\" in rec.getMessage()\n   564→        caplog.clear()\n   565→\n   566→        # Remove handler\n   567→        app.remove_error_handler(self.error_handler_raise_error)\n   568→        self.received_error = None\n   569→\n   570→        with caplog.at_level(logging.ERROR):\n   571→            job = job_queue.run_once(self.job_with_exception, 0.1)\n   572→        await asyncio.sleep(0.15)\n   573→        assert len(caplog.records) == 1\n   574→        rec = caplog.records[-1]\n   575→        assert \"No error handlers are registered\" in rec.getMessage()\n   576→        caplog.clear()\n   577→\n   578→        with caplog.at_level(logging.ERROR):\n   579→            await job.run(app)\n   580→        assert len(caplog.records) == 1\n   581→        rec = caplog.records[-1]\n   582→        assert rec.name == \"telegram.ext.Application\"\n   583→        assert \"No error handlers are registered\" in rec.getMessage()\n   584→\n   585→    async def test_custom_context(self, bot):\n   586→        application = (\n   587→            ApplicationBuilder()\n   588→            .token(bot.token)\n   589→            .context_types(\n   590→                ContextTypes(\n   591→                    context=CustomContext, bot_data=int, user_data=float, chat_data=complex\n   592→                )\n   593→            )\n   594→            .build()\n   595→        )\n   596→        job_queue = JobQueue()\n   597→        job_queue.set_application(application)\n   598→\n   599→        async def callback(context):\n   600→            self.result = (\n   601→                type(context),\n   602→                context.user_data,\n   603→                context.chat_data,\n   604→                type(context.bot_data),\n   605→            )\n   606→\n   607→        await job_queue.start()\n   608→        job_queue.run_once(callback, 0.1)\n   609→        await asyncio.sleep(0.15)\n   610→        assert self.result == (CustomContext, None, None, int)\n   611→        await job_queue.stop()\n   612→\n   613→    async def test_attribute_error(self):\n   614→        job = Job(self.job_run_once)\n   615→        with pytest.raises(\n   616→            AttributeError, match=\"nor 'apscheduler.job.Job' has attribute 'error'\"\n   617→        ):\n   618→            job.error\n   619→\n   620→    @pytest.mark.parametrize(\"wait\", [True, False])\n   621→    async def test_wait_on_shut_down(self, job_queue, wait):\n   622→        ready_event = asyncio.Event()\n   623→\n   624→        async def callback(_):\n   625→            await ready_event.wait()\n   626→\n   627→        await job_queue.start()\n   628→        job_queue.run_once(callback, when=0.1)\n   629→        await asyncio.sleep(0.15)\n   630→\n   631→        task = asyncio.create_task(job_queue.stop(wait=wait))\n   632→        if wait:\n   633→            assert not task.done()\n   634→            ready_event.set()\n   635→            await asyncio.sleep(0.1)  # no CancelledError (see source of JobQueue.stop for details)\n   636→            assert task.done()\n   637→        else:\n   638→            await asyncio.sleep(0.1)  # unfortunately we will get a CancelledError here\n   639→            assert task.done()\n   640→\n   641→    async def test_from_aps_job(self, job_queue):\n   642→        job = job_queue.run_once(self.job_run_once, 0.1, name=\"test_job\")\n   643→        aps_job = job_queue.scheduler.get_job(job.id)\n   644→\n   645→        tg_job = Job.from_aps_job(aps_job)\n   646→        assert tg_job is job\n   647→        assert tg_job.job is aps_job\n   648→\n   649→    async def test_from_aps_job_missing_reference(self, job_queue):\n   650→        \"\"\"We manually create a ext.Job and an aps job such that the former has no reference to the\n   651→        latter. Then we test that Job.from_aps_job() still sets the reference correctly.\n   652→        \"\"\"\n   653→        job = Job(self.job_run_once)\n   654→        aps_job = job_queue.scheduler.add_job(\n   655→            func=job_queue.job_callback,\n   656→            args=(job_queue, job),\n   657→            trigger=\"interval\",\n   658→            seconds=2,\n   659→            id=\"test_id\",\n   660→        )\n   661→\n   662→        assert job.job is None\n   663→        tg_job = Job.from_aps_job(aps_job)\n   664→        assert tg_job is job\n   665→        assert tg_job.job is aps_job\n   666→\n   667→    async def test_run_job_exception_in_building_context(\n   668→        self, monkeypatch, job_queue, caplog, app\n   669→    ):\n   670→        # Makes sure that exceptions in building the context don't stop the application\n   671→        exception = ValueError(\"TestException\")\n   672→        original_from_job = CallbackContext.from_job\n   673→\n   674→        def raise_exception(job, application):\n   675→            if job.data == 1:\n   676→                raise exception\n   677→            return original_from_job(job, application)\n   678→\n   679→        monkeypatch.setattr(CallbackContext, \"from_job\", raise_exception)\n   680→\n   681→        received_jobs = set()\n   682→\n   683→        async def job_callback(context):\n   684→            received_jobs.add(context.job.data)\n   685→\n   686→        with caplog.at_level(logging.CRITICAL):\n   687→            job_queue.run_once(job_callback, 0.1, data=1)\n   688→            await asyncio.sleep(0.2)\n   689→\n   690→        assert received_jobs == set()\n   691→        assert len(caplog.records) == 1\n   692→        record = caplog.records[0]\n   693→        assert record.name == \"telegram.ext.JobQueue\"\n   694→        assert record.getMessage().startswith(\n   695→            \"Error while building CallbackContext for job job_callback\"\n   696→        )\n   697→        assert record.levelno == logging.CRITICAL\n   698→\n   699→        # Let's also check that no critical log is produced when the exception is not raised\n   700→        caplog.clear()\n   701→        with caplog.at_level(logging.CRITICAL):\n   702→            job_queue.run_once(job_callback, 0.1, data=2)\n   703→            await asyncio.sleep(0.2)\n   704→\n   705→        assert received_jobs == {2}\n   706→        assert len(caplog.records) == 0\n   707→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"296fb417-03fb-4cb7-9929-05630059db4a","uuid":"3361d15b-ed4c-45c6-818a-0d877060143a","tool_use_result":{"type":"text","file":{"filePath":"/testbed/tests/ext/test_jobqueue.py","content":"#!/usr/bin/env python\n#\n# A library that provides a Python interface to the Telegram Bot API\n# Copyright (C) 2015-2025\n# Leandro Toledo de Souza <devs@python-telegram-bot.org>\n#\n# This program is free software: you can redistribute it and/or modify\n# it under the terms of the GNU Lesser Public License as published by\n# the Free Software Foundation, either version 3 of the License, or\n# (at your option) any later version.\n#\n# This program is distributed in the hope that it will be useful,\n# but WITHOUT ANY WARRANTY; without even the implied warranty of\n# MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the\n# GNU Lesser Public License for more details.\n#\n# You should have received a copy of the GNU Lesser Public License\n# along with this program.  If not, see [http://www.gnu.org/licenses/].\nimport asyncio\nimport calendar\nimport contextlib\nimport datetime as dtm\nimport logging\nimport platform\nimport time\n\nimport pytest\n\nfrom telegram.ext import ApplicationBuilder, CallbackContext, ContextTypes, Defaults, Job, JobQueue\nfrom tests.auxil.envvars import GITHUB_ACTIONS, TEST_WITH_OPT_DEPS\nfrom tests.auxil.pytest_classes import make_bot\nfrom tests.auxil.slots import mro_slots\n\nif TEST_WITH_OPT_DEPS:\n    import pytz\n\n    UTC = pytz.utc\nelse:\n    UTC = dtm.timezone.utc\n\n\nclass CustomContext(CallbackContext):\n    pass\n\n\n@pytest.fixture\nasync def job_queue(app):\n    jq = JobQueue()\n    jq.set_application(app)\n    await jq.start()\n    yield jq\n    await jq.stop()\n\n\n@pytest.mark.skipif(\n    TEST_WITH_OPT_DEPS, reason=\"Only relevant if the optional dependency is not installed\"\n)\nclass TestNoJobQueue:\n    def test_init_job_queue(self):\n        with pytest.raises(RuntimeError, match=r\"python-telegram-bot\\[job-queue\\]\"):\n            JobQueue()\n\n    def test_init_job(self):\n        with pytest.raises(RuntimeError, match=r\"python-telegram-bot\\[job-queue\\]\"):\n            Job(None)\n\n\n@pytest.mark.skipif(\n    not TEST_WITH_OPT_DEPS, reason=\"Only relevant if the optional dependency is installed\"\n)\n@pytest.mark.skipif(\n    GITHUB_ACTIONS and platform.system() in [\"Windows\", \"Darwin\"],\n    reason=\"On Windows & MacOS precise timings are not accurate.\",\n)\n@pytest.mark.flaky(10, 1)  # Timings aren't quite perfect\nclass TestJobQueue:\n    result = 0\n    job_time = 0\n    received_error = None\n\n    @staticmethod\n    def normalize(datetime: dtm.datetime, timezone: dtm.tzinfo) -> dtm.datetime:\n        with contextlib.suppress(AttributeError):\n            return timezone.normalize(datetime)\n\n        return datetime\n\n    async def test_repr(self, app):\n        jq = JobQueue()\n        jq.set_application(app)\n        assert repr(jq) == f\"JobQueue[application={app!r}]\"\n\n        when = dtm.datetime.utcnow() + dtm.timedelta(days=1)\n        callback = self.job_run_once\n        job = jq.run_once(callback, when, name=\"name2\")\n        assert repr(job) == (\n            f\"Job[id={job.job.id}, name={job.name}, callback=job_run_once, \"\n            f\"trigger=date[\"\n            f\"{when.strftime('%Y-%m-%d %H:%M:%S UTC')}\"\n            f\"]]\"\n        )\n\n    @pytest.fixture(autouse=True)\n    def _reset(self):\n        self.result = 0\n        self.job_time = 0\n        self.received_error = None\n\n    def test_scheduler_configuration(self, job_queue, timezone, bot):\n        # Unfortunately, we can't really test the executor setting explicitly without relying\n        # on protected attributes. However, this should be tested enough implicitly via all the\n        # other tests in here\n        assert job_queue.scheduler_configuration[\"timezone\"] is dtm.timezone.utc\n\n        tz_app = ApplicationBuilder().defaults(Defaults(tzinfo=timezone)).token(bot.token).build()\n        assert tz_app.job_queue.scheduler_configuration[\"timezone\"] is timezone\n\n    async def job_run_once(self, context):\n        if (\n            isinstance(context, CallbackContext)\n            and isinstance(context.job, Job)\n            and isinstance(context.update_queue, asyncio.Queue)\n            and context.job.data is None\n            and context.chat_data is None\n            and context.user_data is None\n            and isinstance(context.bot_data, dict)\n        ):\n            self.result += 1\n\n    async def job_with_exception(self, context):\n        raise Exception(\"Test Error\")\n\n    async def job_remove_self(self, context):\n        self.result += 1\n        context.job.schedule_removal()\n\n    async def job_run_once_with_data(self, context):\n        self.result += context.job.data\n\n    async def job_datetime_tests(self, context):\n        self.job_time = time.time()\n\n    async def error_handler_context(self, update, context):\n        self.received_error = (\n            str(context.error),\n            context.job,\n            context.user_data,\n            context.chat_data,\n        )\n\n    async def error_handler_raise_error(self, *args):\n        raise Exception(\"Failing bigly\")\n\n    def test_slot_behaviour(self, job_queue):\n        for attr in job_queue.__slots__:\n            assert getattr(job_queue, attr, \"err\") != \"err\", f\"got extra slot '{attr}'\"\n        assert len(mro_slots(job_queue)) == len(set(mro_slots(job_queue))), \"duplicate slot\"\n\n    def test_application_weakref(self, bot):\n        jq = JobQueue()\n        application = ApplicationBuilder().token(bot.token).job_queue(None).build()\n        with pytest.raises(RuntimeError, match=\"No application was set\"):\n            jq.application\n        jq.set_application(application)\n        assert jq.application is application\n        del application\n        with pytest.raises(RuntimeError, match=\"no longer alive\"):\n            jq.application\n\n    async def test_run_once(self, job_queue):\n        job_queue.run_once(self.job_run_once, 0.1)\n        await asyncio.sleep(0.2)\n        assert self.result == 1\n\n    async def test_run_once_timezone(self, job_queue, timezone):\n        \"\"\"Test the correct handling of aware datetimes\"\"\"\n        # we're parametrizing this with two different UTC offsets to exclude the possibility\n        # of an xpass when the test is run in a timezone with the same UTC offset\n        when = dtm.datetime.now(timezone)\n        job_queue.run_once(self.job_run_once, when)\n        await asyncio.sleep(0.1)\n        assert self.result == 1\n\n    async def test_job_with_data(self, job_queue):\n        job_queue.run_once(self.job_run_once_with_data, 0.1, data=5)\n        await asyncio.sleep(0.2)\n        assert self.result == 5\n\n    async def test_run_repeating(self, job_queue):\n        job_queue.run_repeating(self.job_run_once, 0.1)\n        await asyncio.sleep(0.25)\n        assert self.result == 2\n\n    async def test_run_repeating_first(self, job_queue):\n        job_queue.run_repeating(self.job_run_once, 0.5, first=0.2)\n        await asyncio.sleep(0.15)\n        assert self.result == 0\n        await asyncio.sleep(0.1)\n        assert self.result == 1\n\n    async def test_run_repeating_first_timezone(self, job_queue, timezone):\n        \"\"\"Test correct scheduling of job when passing a timezone-aware datetime as ``first``\"\"\"\n        job_queue.run_repeating(\n            self.job_run_once, 0.5, first=dtm.datetime.now(timezone) + dtm.timedelta(seconds=0.2)\n        )\n        await asyncio.sleep(0.05)\n        assert self.result == 0\n        await asyncio.sleep(0.25)\n        assert self.result == 1\n\n    async def test_run_repeating_last(self, job_queue):\n        job_queue.run_repeating(self.job_run_once, 0.25, last=0.4)\n        await asyncio.sleep(0.3)\n        assert self.result == 1\n        await asyncio.sleep(0.4)\n        assert self.result == 1\n\n    async def test_run_repeating_last_timezone(self, job_queue, timezone):\n        \"\"\"Test correct scheduling of job when passing a timezone-aware datetime as ``last``\"\"\"\n        job_queue.run_repeating(\n            self.job_run_once, 0.25, last=dtm.datetime.now(timezone) + dtm.timedelta(seconds=0.4)\n        )\n        await asyncio.sleep(0.3)\n        assert self.result == 1\n        await asyncio.sleep(0.4)\n        assert self.result == 1\n\n    async def test_run_repeating_last_before_first(self, job_queue):\n        with pytest.raises(ValueError, match=\"'last' must not be before 'first'!\"):\n            job_queue.run_repeating(self.job_run_once, 0.5, first=1, last=0.5)\n\n    async def test_run_repeating_timedelta(self, job_queue):\n        job_queue.run_repeating(self.job_run_once, dtm.timedelta(seconds=0.1))\n        await asyncio.sleep(0.25)\n        assert self.result == 2\n\n    async def test_run_custom(self, job_queue):\n        job_queue.run_custom(self.job_run_once, {\"trigger\": \"interval\", \"seconds\": 0.2})\n        await asyncio.sleep(0.5)\n        assert self.result == 2\n\n    async def test_multiple(self, job_queue):\n        job_queue.run_once(self.job_run_once, 0.1)\n        job_queue.run_once(self.job_run_once, 0.2)\n        job_queue.run_repeating(self.job_run_once, 0.2)\n        await asyncio.sleep(0.55)\n        assert self.result == 4\n\n    async def test_disabled(self, job_queue):\n        j1 = job_queue.run_once(self.job_run_once, 0.1)\n        j2 = job_queue.run_repeating(self.job_run_once, 0.5)\n\n        j1.enabled = False\n        j2.enabled = False\n\n        await asyncio.sleep(0.6)\n\n        assert self.result == 0\n\n        j1.enabled = True\n\n        await asyncio.sleep(0.6)\n\n        assert self.result == 1\n\n    async def test_schedule_removal(self, job_queue):\n        j1 = job_queue.run_once(self.job_run_once, 0.3)\n        j2 = job_queue.run_repeating(self.job_run_once, 0.2)\n\n        await asyncio.sleep(0.25)\n        assert self.result == 1\n\n        j1.schedule_removal()\n        j2.schedule_removal()\n\n        await asyncio.sleep(0.4)\n\n        assert self.result == 1\n\n    async def test_schedule_removal_from_within(self, job_queue):\n        job_queue.run_repeating(self.job_remove_self, 0.1)\n\n        await asyncio.sleep(0.5)\n\n        assert self.result == 1\n\n    async def test_longer_first(self, job_queue):\n        job_queue.run_once(self.job_run_once, 0.2)\n        job_queue.run_once(self.job_run_once, 0.1)\n\n        await asyncio.sleep(0.15)\n\n        assert self.result == 1\n\n    async def test_error(self, job_queue):\n        job_queue.run_repeating(self.job_with_exception, 0.1)\n        job_queue.run_repeating(self.job_run_once, 0.2)\n        await asyncio.sleep(0.3)\n        assert self.result == 1\n\n    async def test_in_application(self, bot_info):\n        app = ApplicationBuilder().bot(make_bot(bot_info)).build()\n        async with app:\n            assert not app.job_queue.scheduler.running\n            await app.start()\n            assert app.job_queue.scheduler.running\n\n            app.job_queue.run_repeating(self.job_run_once, 0.2)\n            await asyncio.sleep(0.3)\n            assert self.result == 1\n            await app.stop()\n            assert not app.job_queue.scheduler.running\n            await asyncio.sleep(1)\n            assert self.result == 1\n\n    async def test_time_unit_int(self, job_queue):\n        # Testing seconds in int\n        delta = 0.5\n        expected_time = time.time() + delta\n\n        job_queue.run_once(self.job_datetime_tests, delta)\n        await asyncio.sleep(0.6)\n        assert pytest.approx(self.job_time) == expected_time\n\n    async def test_time_unit_dt_timedelta(self, job_queue):\n        # Testing seconds, minutes and hours as datetime.timedelta object\n        # This is sufficient to test that it actually works.\n        interval = dtm.timedelta(seconds=0.5)\n        expected_time = time.time() + interval.total_seconds()\n\n        job_queue.run_once(self.job_datetime_tests, interval)\n        await asyncio.sleep(0.6)\n        assert pytest.approx(self.job_time) == expected_time\n\n    async def test_time_unit_dt_datetime(self, job_queue):\n        # Testing running at a specific datetime\n        delta, now = dtm.timedelta(seconds=0.5), dtm.datetime.now(UTC)\n        when = now + delta\n        expected_time = when.timestamp()\n\n        job_queue.run_once(self.job_datetime_tests, when)\n        await asyncio.sleep(0.6)\n        assert self.job_time == pytest.approx(expected_time)\n\n    async def test_time_unit_dt_time_today(self, job_queue):\n        # Testing running at a specific time today\n        delta, now = 0.5, dtm.datetime.now(UTC)\n        expected_time = now + dtm.timedelta(seconds=delta)\n        when = expected_time.time()\n        expected_time = expected_time.timestamp()\n\n        job_queue.run_once(self.job_datetime_tests, when)\n        await asyncio.sleep(0.6)\n        assert self.job_time == pytest.approx(expected_time)\n\n    async def test_time_unit_dt_time_tomorrow(self, job_queue):\n        # Testing running at a specific time that has passed today. Since we can't wait a day, we\n        # test if the job's next scheduled execution time has been calculated correctly\n        delta, now = -2, dtm.datetime.now(UTC)\n        when = (now + dtm.timedelta(seconds=delta)).time()\n        expected_time = (now + dtm.timedelta(seconds=delta, days=1)).timestamp()\n\n        job_queue.run_once(self.job_datetime_tests, when)\n        scheduled_time = job_queue.jobs()[0].next_t.timestamp()\n        assert scheduled_time == pytest.approx(expected_time)\n\n    async def test_time_unit_dt_aware_time(self, job_queue, timezone):\n        # Testing running at a specific tz-aware time today\n        delta, now = 0.5, dtm.datetime.now(timezone)\n        expected_time = now + dtm.timedelta(seconds=delta)\n        when = expected_time.timetz()\n        expected_time = expected_time.timestamp()\n\n        job_queue.run_once(self.job_datetime_tests, when)\n        await asyncio.sleep(0.6)\n        assert self.job_time == pytest.approx(expected_time)\n\n    async def test_run_daily(self, job_queue):\n        delta, now = 1, dtm.datetime.now(UTC)\n        time_of_day = (now + dtm.timedelta(seconds=delta)).time()\n        expected_reschedule_time = (now + dtm.timedelta(seconds=delta, days=1)).timestamp()\n\n        job_queue.run_daily(self.job_run_once, time_of_day)\n        await asyncio.sleep(delta + 0.1)\n        assert self.result == 1\n        scheduled_time = job_queue.jobs()[0].next_t.timestamp()\n        assert scheduled_time == pytest.approx(expected_reschedule_time)\n\n    @pytest.mark.parametrize(\"weekday\", [0, 1, 2, 3, 4, 5, 6])\n    async def test_run_daily_days_of_week(self, job_queue, weekday):\n        delta, now = 1, dtm.datetime.now(UTC)\n        time_of_day = (now + dtm.timedelta(seconds=delta)).time()\n        # offset in days until next weekday\n        offset = (weekday + 6 - now.weekday()) % 7\n        offset = offset if offset > 0 else 7\n        expected_reschedule_time = (now + dtm.timedelta(seconds=delta, days=offset)).timestamp()\n\n        job_queue.run_daily(self.job_run_once, time_of_day, days=[weekday])\n        await asyncio.sleep(delta + 0.1)\n        scheduled_time = job_queue.jobs()[0].next_t.timestamp()\n        assert scheduled_time == pytest.approx(expected_reschedule_time)\n\n    async def test_run_monthly(self, job_queue, timezone):\n        delta, now = 1, dtm.datetime.now(timezone)\n        expected_reschedule_time = now + dtm.timedelta(seconds=delta)\n        time_of_day = expected_reschedule_time.time().replace(tzinfo=timezone)\n\n        day = now.day\n        this_months_days = calendar.monthrange(now.year, now.month)[1]\n        if now.month == 12:\n            next_months_days = calendar.monthrange(now.year + 1, 1)[1]\n        else:\n            next_months_days = calendar.monthrange(now.year, now.month + 1)[1]\n\n        expected_reschedule_time += dtm.timedelta(this_months_days)\n        if day > next_months_days:\n            expected_reschedule_time += dtm.timedelta(next_months_days)\n\n        expected_reschedule_time = self.normalize(expected_reschedule_time, timezone)\n        # Adjust the hour for the special case that between now and next month a DST switch happens\n        expected_reschedule_time += dtm.timedelta(\n            hours=time_of_day.hour - expected_reschedule_time.hour\n        )\n        expected_reschedule_time = expected_reschedule_time.timestamp()\n\n        job_queue.run_monthly(self.job_run_once, time_of_day, day)\n        await asyncio.sleep(delta + 0.1)\n        assert self.result == 1\n        scheduled_time = job_queue.jobs()[0].next_t.timestamp()\n        assert scheduled_time == pytest.approx(expected_reschedule_time, rel=1e-3)\n\n    async def test_run_monthly_non_strict_day(self, job_queue, timezone):\n        delta, now = 1, dtm.datetime.now(timezone)\n        expected_reschedule_time = now + dtm.timedelta(seconds=delta)\n        time_of_day = expected_reschedule_time.time().replace(tzinfo=timezone)\n\n        expected_reschedule_time += dtm.timedelta(\n            calendar.monthrange(now.year, now.month)[1]\n        ) - dtm.timedelta(days=now.day)\n        # Adjust the hour for the special case that between now & end of month a DST switch happens\n        expected_reschedule_time = self.normalize(expected_reschedule_time, timezone)\n        expected_reschedule_time += dtm.timedelta(\n            hours=time_of_day.hour - expected_reschedule_time.hour\n        )\n        expected_reschedule_time = expected_reschedule_time.timestamp()\n\n        job_queue.run_monthly(self.job_run_once, time_of_day, -1)\n        scheduled_time = job_queue.jobs()[0].next_t.timestamp()\n        assert scheduled_time == pytest.approx(expected_reschedule_time)\n\n    async def test_default_tzinfo(self, tz_bot):\n        # we're parametrizing this with two different UTC offsets to exclude the possibility\n        # of an xpass when the test is run in a timezone with the same UTC offset\n        app = ApplicationBuilder().bot(tz_bot).build()\n        jq = app.job_queue\n        await jq.start()\n\n        when = dtm.datetime.now(tz_bot.defaults.tzinfo) + dtm.timedelta(seconds=0.1)\n        jq.run_once(self.job_run_once, when.time())\n        await asyncio.sleep(0.15)\n        assert self.result == 1\n\n        await jq.stop()\n\n    async def test_get_jobs(self, job_queue):\n        callback = self.job_run_once\n\n        job1 = job_queue.run_once(callback, 10, name=\"name1\")\n        await asyncio.sleep(0.03)  # To stablize tests on windows\n        job2 = job_queue.run_once(callback, 10, name=\"name1\")\n        await asyncio.sleep(0.03)\n        job3 = job_queue.run_once(callback, 10, name=\"name2\")\n        await asyncio.sleep(0.03)\n\n        assert job_queue.jobs() == (job1, job2, job3)\n        assert job_queue.get_jobs_by_name(\"name1\") == (job1, job2)\n        assert job_queue.get_jobs_by_name(\"name2\") == (job3,)\n\n    async def test_job_run(self, app):\n        job = app.job_queue.run_repeating(self.job_run_once, 0.02)\n        await asyncio.sleep(0.05)  # the job queue has not started yet\n        assert self.result == 0  # so the job will not run\n        await job.run(app)  # but this will force it to run\n        assert self.result == 1\n\n    async def test_enable_disable_job(self, job_queue):\n        job = job_queue.run_repeating(self.job_run_once, 0.2)\n        await asyncio.sleep(0.5)\n        assert self.result == 2\n        job.enabled = False\n        assert not job.enabled\n        await asyncio.sleep(0.5)\n        assert self.result == 2\n        job.enabled = True\n        assert job.enabled\n        await asyncio.sleep(0.5)\n        assert self.result == 4\n\n    async def test_remove_job(self, job_queue):\n        job = job_queue.run_repeating(self.job_run_once, 0.2)\n        await asyncio.sleep(0.5)\n        assert self.result == 2\n        assert not job.removed\n        job.schedule_removal()\n        assert job.removed\n        await asyncio.sleep(0.5)\n        assert self.result == 2\n\n    async def test_equality(self, job_queue):\n        job = job_queue.run_repeating(self.job_run_once, 0.2)\n        job_2 = job_queue.run_repeating(self.job_run_once, 0.2)\n        job_3 = Job(self.job_run_once, 0.2)\n        job_3._job = job.job\n        assert job == job  # noqa: PLR0124\n        assert job != job_queue\n        assert job != job_2\n        assert job == job_3\n\n        assert hash(job) == hash(job)\n        assert hash(job) != hash(job_queue)\n        assert hash(job) != hash(job_2)\n        assert hash(job) == hash(job_3)\n\n    async def test_process_error_context(self, job_queue, app):\n        app.add_error_handler(self.error_handler_context)\n\n        job = job_queue.run_once(self.job_with_exception, 0.1, chat_id=42, user_id=43)\n        await asyncio.sleep(0.15)\n        assert self.received_error[0] == \"Test Error\"\n        assert self.received_error[1] is job\n        self.received_error = None\n        await job.run(app)\n        assert self.received_error[0] == \"Test Error\"\n        assert self.received_error[1] is job\n        assert self.received_error[2] is app.user_data[43]\n        assert self.received_error[3] is app.chat_data[42]\n\n        # Remove handler\n        app.remove_error_handler(self.error_handler_context)\n        self.received_error = None\n\n        job = job_queue.run_once(self.job_with_exception, 0.1)\n        await asyncio.sleep(0.15)\n        assert self.received_error is None\n        await job.run(app)\n        assert self.received_error is None\n\n    async def test_process_error_that_raises_errors(self, job_queue, app, caplog):\n        app.add_error_handler(self.error_handler_raise_error)\n\n        with caplog.at_level(logging.ERROR):\n            job = job_queue.run_once(self.job_with_exception, 0.1)\n        await asyncio.sleep(0.15)\n        assert len(caplog.records) == 1\n        rec = caplog.records[-1]\n        assert \"An error was raised and an uncaught\" in rec.getMessage()\n        caplog.clear()\n\n        with caplog.at_level(logging.ERROR):\n            await job.run(app)\n        assert len(caplog.records) == 1\n        rec = caplog.records[-1]\n        assert \"uncaught error was raised while handling\" in