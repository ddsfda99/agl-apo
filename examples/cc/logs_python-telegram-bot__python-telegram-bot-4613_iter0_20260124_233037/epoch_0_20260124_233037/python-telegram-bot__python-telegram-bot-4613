\")\n    98→    _CRON_MAPPING = (\"sun\", \"mon\", \"tue\", \"wed\", \"thu\", \"fri\", \"sat\")\n    99→\n   100→    def __init__(self) -> None:\n   101→        if not APS_AVAILABLE:\n   102→            raise RuntimeError(\n   103→                \"To use `JobQueue`, PTB must be installed via `pip install \"\n   104→                '\"python-telegram-bot[job-queue]\"`.'\n   105→            )\n   106→\n   107→        self._application: Optional[weakref.ReferenceType[Application]] = None\n   108→        self._executor = AsyncIOExecutor()\n   109→        self.scheduler: \"AsyncIOScheduler\" = AsyncIOScheduler(  # noqa: UP037\n   110→            **self.scheduler_configuration\n   111→        )\n   112→\n   113→    def __repr__(self) -> str:\n   114→        \"\"\"Give a string representation of the JobQueue in the form ``JobQueue[application=...]``.\n   115→\n   116→        As this class doesn't implement :meth:`object.__str__`, the default implementation\n   117→        will be used, which is equivalent to :meth:`__repr__`.\n   118→\n   119→        Returns:\n   120→            :obj:`str`\n   121→        \"\"\"\n   122→        return build_repr_with_selected_attrs(self, application=self.application)\n   123→\n   124→    @property\n   125→    def application(self) -> \"Application[Any, CCT, Any, Any, Any, JobQueue[CCT]]\":\n   126→        \"\"\"The application this JobQueue is associated with.\"\"\"\n   127→        if self._application is None:\n   128→            raise RuntimeError(\"No application was set for this JobQueue.\")\n   129→        application = self._application()\n   130→        if application is not None:\n   131→            return application\n   132→        raise RuntimeError(\"The application instance is no longer alive.\")\n   133→\n   134→    @property\n   135→    def scheduler_configuration(self) -> JSONDict:\n   136→        \"\"\"Provides configuration values that are used by :class:`JobQueue` for :attr:`scheduler`.\n   137→\n   138→        Tip:\n   139→            Since calling\n   140→            :meth:`scheduler.configure() <apscheduler.schedulers.base.BaseScheduler.configure>`\n   141→            deletes any previous setting, please make sure to pass these values to the method call\n   142→            in addition to your custom values:\n   143→\n   144→            .. code-block:: python\n   145→\n   146→                scheduler.configure(..., **job_queue.scheduler_configuration)\n   147→\n   148→            Alternatively, you can also use methods like\n   149→            :meth:`~apscheduler.schedulers.base.BaseScheduler.add_jobstore` to avoid using\n   150→            :meth:`~apscheduler.schedulers.base.BaseScheduler.configure` altogether.\n   151→\n   152→        .. versionadded:: 20.7\n   153→\n   154→        Returns:\n   155→            dict[:obj:`str`, :obj:`object`]: The configuration values as dictionary.\n   156→\n   157→        \"\"\"\n   158→        timezone: dtm.tzinfo = UTC\n   159→        if (\n   160→            self._application\n   161→            and isinstance(self.application.bot, ExtBot)\n   162→            and self.application.bot.defaults\n   163→        ):\n   164→            timezone = self.application.bot.defaults.tzinfo or UTC\n   165→\n   166→        return {\n   167→            \"timezone\": timezone,\n   168→            \"executors\": {\"default\": self._executor},\n   169→        }\n   170→\n   171→    def _tz_now(self) -> dtm.datetime:\n   172→        return dtm.datetime.now(self.scheduler.timezone)\n   173→\n   174→    @overload\n   175→    def _parse_time_input(self, time: None, shift_day: bool = False) -> None: ...\n   176→\n   177→    @overload\n   178→    def _parse_time_input(\n   179→        self,\n   180→        time: Union[float, dtm.timedelta, dtm.datetime, dtm.time],\n   181→        shift_day: bool = False,\n   182→    ) -> dtm.datetime: ...\n   183→\n   184→    def _parse_time_input(\n   185→        self,\n   186→        time: Union[float, dtm.timedelta, dtm.datetime, dtm.time, None],\n   187→        shift_day: bool = False,\n   188→    ) -> Optional[dtm.datetime]:\n   189→        if time is None:\n   190→            return None\n   191→        if isinstance(time, (int, float)):\n   192→            return self._tz_now() + dtm.timedelta(seconds=time)\n   193→        if isinstance(time, dtm.timedelta):\n   194→            return self._tz_now() + time\n   195→        if isinstance(time, dtm.time):\n   196→            date_time = dtm.datetime.combine(\n   197→                dtm.datetime.now(tz=time.tzinfo or self.scheduler.timezone).date(), time\n   198→            )\n   199→            if date_time.tzinfo is None:\n   200→                # dtm.combine uses the tzinfo of `time`, which might be None, so we still have\n   201→                # to localize it\n   202→                date_time = localize(date_time, self.scheduler.timezone)\n   203→            if shift_day and date_time <= dtm.datetime.now(UTC):\n   204→                date_time += dtm.timedelta(days=1)\n   205→            return date_time\n   206→        return time\n   207→\n   208→    def set_application(\n   209→        self, application: \"Application[Any, CCT, Any, Any, Any, JobQueue[CCT]]\"\n   210→    ) -> None:\n   211→        \"\"\"Set the application to be used by this JobQueue.\n   212→\n   213→        Args:\n   214→            application (:class:`telegram.ext.Application`): The application.\n   215→\n   216→        \"\"\"\n   217→        self._application = weakref.ref(application)\n   218→        self.scheduler.configure(**self.scheduler_configuration)\n   219→\n   220→    @staticmethod\n   221→    async def job_callback(job_queue: \"JobQueue[CCT]\", job: \"Job[CCT]\") -> None:\n   222→        \"\"\"This method is used as a callback for the APScheduler jobs.\n   223→\n   224→        More precisely, the ``func`` argument of :class:`apscheduler.job.Job` is set to this method\n   225→        and the ``arg`` argument (representing positional arguments to ``func``) is set to a tuple\n   226→        containing the :class:`JobQueue` itself and the :class:`~telegram.ext.Job` instance.\n   227→\n   228→        Tip:\n   229→            This method is a static method rather than a bound method. This makes the arguments\n   230→            more transparent and allows for easier handling of PTBs integration of APScheduler\n   231→            when utilizing advanced features of APScheduler.\n   232→\n   233→        Hint:\n   234→            This method is effectively a wrapper for :meth:`telegram.ext.Job.run`.\n   235→\n   236→        .. versionadded:: 20.4\n   237→\n   238→        Args:\n   239→            job_queue (:class:`JobQueue`): The job queue that created the job.\n   240→            job (:class:`~telegram.ext.Job`): The job to run.\n   241→        \"\"\"\n   242→        await job.run(job_queue.application)\n   243→\n   244→    def run_once(\n   245→        self,\n   246→        callback: JobCallback[CCT],\n   247→        when: Union[float, dtm.timedelta, dtm.datetime, dtm.time],\n   248→        data: Optional[object] = None,\n   249→        name: Optional[str] = None,\n   250→        chat_id: Optional[int] = None,\n   251→        user_id: Optional[int] = None,\n   252→        job_kwargs: Optional[JSONDict] = None,\n   253→    ) -> \"Job[CCT]\":\n   254→        \"\"\"Creates a new :class:`Job` instance that runs once and adds it to the queue.\n   255→\n   256→        Args:\n   257→            callback (:term:`coroutine function`): The callback function that should be executed by\n   258→                the new job. Callback signature::\n   259→\n   260→                    async def callback(context: CallbackContext)\n   261→\n   262→            when (:obj:`int` | :obj:`float` | :obj:`datetime.timedelta` |                         \\\n   263→                  :obj:`datetime.datetime` | :obj:`datetime.time`):\n   264→                Time in or at which the job should run. This parameter will be interpreted\n   265→                depending on its type.\n   266→\n   267→                * :obj:`int` or :obj:`float` will be interpreted as \"seconds from now\" in which the\n   268→                  job should run.\n   269→                * :obj:`datetime.timedelta` will be interpreted as \"time from now\" in which the\n   270→                  job should run.\n   271→                * :obj:`datetime.datetime` will be interpreted as a specific date and time at\n   272→                  which the job should run. If the timezone (:attr:`datetime.datetime.tzinfo`) is\n   273→                  :obj:`None`, the default timezone of the bot will be used, which is UTC unless\n   274→                  :attr:`telegram.ext.Defaults.tzinfo` is used.\n   275→                * :obj:`datetime.time` will be interpreted as a specific time of day at which the\n   276→                  job should run. This could be either today or, if the time has already passed,\n   277→                  tomorrow. If the timezone (:attr:`datetime.time.tzinfo`) is :obj:`None`, the\n   278→                  default timezone of the bot will be used, which is UTC unless\n   279→                  :attr:`telegram.ext.Defaults.tzinfo` is used.\n   280→\n   281→            chat_id (:obj:`int`, optional): Chat id of the chat associated with this job. If\n   282→                passed, the corresponding :attr:`~telegram.ext.CallbackContext.chat_data` will\n   283→                be available in the callback.\n   284→\n   285→                .. versionadded:: 20.0\n   286→\n   287→            user_id (:obj:`int`, optional): User id of the user associated with this job. If\n   288→                passed, the corresponding :attr:`~telegram.ext.CallbackContext.user_data` will\n   289→                be available in the callback.\n   290→\n   291→                .. versionadded:: 20.0\n   292→            data (:obj:`object`, optional): Additional data needed for the callback function.\n   293→                Can be accessed through :attr:`Job.data` in the callback. Defaults to\n   294→                :obj:`None`.\n   295→\n   296→                .. versionchanged:: 20.0\n   297→                    Renamed the parameter ``context`` to :paramref:`data`.\n   298→            name (:obj:`str`, optional): The name of the new job. Defaults to\n   299→                :external:attr:`callback.__name__ <definition.__name__>`.\n   300→            job_kwargs (:obj:`dict`, optional): Arbitrary keyword arguments to pass to the\n   301→                :meth:`apscheduler.schedulers.base.BaseScheduler.add_job()`.\n   302→\n   303→        Returns:\n   304→            :class:`telegram.ext.Job`: The new :class:`Job` instance that has been added to the job\n   305→            queue.\n   306→\n   307→        \"\"\"\n   308→        if not job_kwargs:\n   309→            job_kwargs = {}\n   310→\n   311→        name = name or callback.__name__\n   312→        job = Job(callback=callback, data=data, name=name, chat_id=chat_id, user_id=user_id)\n   313→        date_time = self._parse_time_input(when, shift_day=True)\n   314→\n   315→        j = self.scheduler.add_job(\n   316→            self.job_callback,\n   317→            name=name,\n   318→            trigger=\"date\",\n   319→            run_date=date_time,\n   320→            args=(self, job),\n   321→            timezone=date_time.tzinfo or self.scheduler.timezone,\n   322→            **job_kwargs,\n   323→        )\n   324→\n   325→        job._job = j  # pylint: disable=protected-access\n   326→        return job\n   327→\n   328→    def run_repeating(\n   329→        self,\n   330→        callback: JobCallback[CCT],\n   331→        interval: Union[float, dtm.timedelta],\n   332→        first: Optional[Union[float, dtm.timedelta, dtm.datetime, dtm.time]] = None,\n   333→        last: Optional[Union[float, dtm.timedelta, dtm.datetime, dtm.time]] = None,\n   334→        data: Optional[object] = None,\n   335→        name: Optional[str] = None,\n   336→        chat_id: Optional[int] = None,\n   337→        user_id: Optional[int] = None,\n   338→        job_kwargs: Optional[JSONDict] = None,\n   339→    ) -> \"Job[CCT]\":\n   340→        \"\"\"Creates a new :class:`Job` instance that runs at specified intervals and adds it to the\n   341→        queue.\n   342→\n   343→        Note:\n   344→            For a note about DST, please see the documentation of `APScheduler`_.\n   345→\n   346→        .. _`APScheduler`: https://apscheduler.readthedocs.io/en/stable/modules/triggers/cron.html\n   347→                           #daylight-saving-time-behavior\n   348→\n   349→        Args:\n   350→            callback (:term:`coroutine function`): The callback function that should be executed by\n   351→                the new job. Callback signature::\n   352→\n   353→                    async def callback(context: CallbackContext)\n   354→\n   355→            interval (:obj:`int` | :obj:`float` | :obj:`datetime.timedelta`): The interval in which\n   356→                the job will run. If it is an :obj:`int` or a :obj:`float`, it will be interpreted\n   357→                as seconds.\n   358→            first (:obj:`int` | :obj:`float` | :obj:`datetime.timedelta` |                        \\\n   359→                   :obj:`datetime.datetime` | :obj:`datetime.time`, optional):\n   360→                Time in or at which the job should run. This parameter will be interpreted\n   361→                depending on its type.\n   362→\n   363→                * :obj:`int` or :obj:`float` will be interpreted as \"seconds from now\" in which the\n   364→                  job should run.\n   365→                * :obj:`datetime.timedelta` will be interpreted as \"time from now\" in which the\n   366→                  job should run.\n   367→                * :obj:`datetime.datetime` will be interpreted as a specific date and time at\n   368→                  which the job should run. If the timezone (:attr:`datetime.datetime.tzinfo`) is\n   369→                  :obj:`None`, the default timezone of the bot will be used.\n   370→                * :obj:`datetime.time` will be interpreted as a specific time of day at which the\n   371→                  job should run. This could be either today or, if the time has already passed,\n   372→                  tomorrow. If the timezone (:attr:`datetime.time.tzinfo`) is :obj:`None`, the\n   373→                  default timezone of the bot will be used, which is UTC unless\n   374→                  :attr:`telegram.ext.Defaults.tzinfo` is used.\n   375→\n   376→                Defaults to :paramref:`interval`\n   377→\n   378→                Note:\n   379→                    Setting :paramref:`first` to ``0``, ``datetime.datetime.now()`` or another\n   380→                    value that indicates that the job should run immediately will not work due\n   381→                    to how the APScheduler library works. If you want to run a job immediately,\n   382→                    we recommend to use an approach along the lines of::\n   383→\n   384→                        job = context.job_queue.run_repeating(callback, interval=5)\n   385→                        await job.run(context.application)\n   386→\n   387→                    .. seealso:: :meth:`telegram.ext.Job.run`\n   388→\n   389→            last (:obj:`int` | :obj:`float` | :obj:`datetime.timedelta` |                        \\\n   390→                   :obj:`datetime.datetime` | :obj:`datetime.time`, optional):\n   391→                Latest possible time for the job to run. This parameter will be interpreted\n   392→                depending on its type. See :paramref:`first` for details.\n   393→\n   394→                If :paramref:`last` is :obj:`datetime.datetime` or :obj:`datetime.time` type\n   395→                and ``last.tzinfo`` is :obj:`None`, the default timezone of the bot will be\n   396→                assumed, which is UTC unless :attr:`telegram.ext.Defaults.tzinfo` is used.\n   397→\n   398→                Defaults to :obj:`None`.\n   399→            data (:obj:`object`, optional): Additional data needed for the callback function.\n   400→                Can be accessed through :attr:`Job.data` in the callback. Defaults to\n   401→                :obj:`None`.\n   402→\n   403→                .. versionchanged:: 20.0\n   404→                    Renamed the parameter ``context`` to :paramref:`data`.\n   405→            name (:obj:`str`, optional): The name of the new job. Defaults to\n   406→                :external:attr:`callback.__name__ <definition.__name__>`.\n   407→            chat_id (:obj:`int`, optional): Chat id of the chat associated with this job. If\n   408→                passed, the corresponding :attr:`~telegram.ext.CallbackContext.chat_data` will\n   409→                be available in the callback.\n   410→\n   411→                .. versionadded:: 20.0\n   412→\n   413→            user_id (:obj:`int`, optional): User id of the user associated with this job. If\n   414→                passed, the corresponding :attr:`~telegram.ext.CallbackContext.user_data` will\n   415→                be available in the callback.\n   416→\n   417→                .. versionadded:: 20.0\n   418→            job_kwargs (:obj:`dict`, optional): Arbitrary keyword arguments to pass to the\n   419→                :meth:`apscheduler.schedulers.base.BaseScheduler.add_job()`.\n   420→\n   421→        Returns:\n   422→            :class:`telegram.ext.Job`: The new :class:`Job` instance that has been added to the job\n   423→            queue.\n   424→\n   425→        \"\"\"\n   426→        if not job_kwargs:\n   427→            job_kwargs = {}\n   428→\n   429→        name = name or callback.__name__\n   430→        job = Job(callback=callback, data=data, name=name, chat_id=chat_id, user_id=user_id)\n   431→\n   432→        dt_first = self._parse_time_input(first)\n   433→        dt_last = self._parse_time_input(last)\n   434→\n   435→        if dt_last and dt_first and dt_last < dt_first:\n   436→            raise ValueError(\"'last' must not be before 'first'!\")\n   437→\n   438→        if isinstance(interval, dtm.timedelta):\n   439→            interval = interval.total_seconds()\n   440→\n   441→        j = self.scheduler.add_job(\n   442→            self.job_callback,\n   443→            trigger=\"interval\",\n   444→            args=(self, job),\n   445→            start_date=dt_first,\n   446→            end_date=dt_last,\n   447→            seconds=interval,\n   448→            name=name,\n   449→            **job_kwargs,\n   450→        )\n   451→\n   452→        job._job = j  # pylint: disable=protected-access\n   453→        return job\n   454→\n   455→    def run_monthly(\n   456→        self,\n   457→        callback: JobCallback[CCT],\n   458→        when: dtm.time,\n   459→        day: int,\n   460→        data: Optional[object] = None,\n   461→        name: Optional[str] = None,\n   462→        chat_id: Optional[int] = None,\n   463→        user_id: Optional[int] = None,\n   464→        job_kwargs: Optional[JSONDict] = None,\n   465→    ) -> \"Job[CCT]\":\n   466→        \"\"\"Creates a new :class:`Job` that runs on a monthly basis and adds it to the queue.\n   467→\n   468→        .. versionchanged:: 20.0\n   469→            The ``day_is_strict`` argument was removed. Instead one can now pass ``-1`` to the\n   470→            :paramref:`day` parameter to have the job run on the last day of the month.\n   471→\n   472→        Args:\n   473→            callback (:term:`coroutine function`): The callback function that should be executed by\n   474→                the new job. Callback signature::\n   475→\n   476→                    async def callback(context: CallbackContext)\n   477→\n   478→            when (:obj:`datetime.time`): Time of day at which the job should run. If the timezone\n   479→                (``when.tzinfo``) is :obj:`None`, the default timezone of the bot will be used,\n   480→                which is UTC unless :attr:`telegram.ext.Defaults.tzinfo` is used.\n   481→            day (:obj:`int`): Defines the day of the month whereby the job would run. It should\n   482→                be within the range of ``1`` and ``31``, inclusive. If a month has fewer days than\n   483→                this number, the job will not run in this month. Passing ``-1`` leads to the job\n   484→                running on the last day of the month.\n   485→            data (:obj:`object`, optional): Additional data needed for the callback function.\n   486→                Can be accessed through :attr:`Job.data` in the callback. Defaults to\n   487→                :obj:`None`.\n   488→\n   489→                .. versionchanged:: 20.0\n   490→                    Renamed the parameter ``context`` to :paramref:`data`.\n   491→            name (:obj:`str`, optional): The name of the new job. Defaults to\n   492→                :external:attr:`callback.__name__ <definition.__name__>`.\n   493→            chat_id (:obj:`int`, optional): Chat id of the chat associated with this job. If\n   494→                passed, the corresponding :attr:`~telegram.ext.CallbackContext.chat_data` will\n   495→                be available in the callback.\n   496→\n   497→                .. versionadded:: 20.0\n   498→\n   499→            user_id (:obj:`int`, optional): User id of the user associated with this job. If\n   500→                passed, the corresponding :attr:`~telegram.ext.CallbackContext.user_data` will\n   501→                be available in the callback.\n   502→\n   503→                .. versionadded:: 20.0\n   504→            job_kwargs (:obj:`dict`, optional): Arbitrary keyword arguments to pass to the\n   505→                :meth:`apscheduler.schedulers.base.BaseScheduler.add_job()`.\n   506→\n   507→        Returns:\n   508→            :class:`telegram.ext.Job`: The new :class:`Job` instance that has been added to the job\n   509→            queue.\n   510→\n   511→        \"\"\"\n   512→        if not job_kwargs:\n   513→            job_kwargs = {}\n   514→\n   515→        name = name or callback.__name__\n   516→        job = Job(callback=callback, data=data, name=name, chat_id=chat_id, user_id=user_id)\n   517→\n   518→        j = self.scheduler.add_job(\n   519→            self.job_callback,\n   520→            trigger=\"cron\",\n   521→            args=(self, job),\n   522→            name=name,\n   523→            day=\"last\" if day == -1 else day,\n   524→            hour=when.hour,\n   525→            minute=when.minute,\n   526→            second=when.second,\n   527→            timezone=when.tzinfo or self.scheduler.timezone,\n   528→            **job_kwargs,\n   529→        )\n   530→        job._job = j  # pylint: disable=protected-access\n   531→        return job\n   532→\n   533→    def run_daily(\n   534→        self,\n   535→        callback: JobCallback[CCT],\n   536→        time: dtm.time,\n   537→        days: tuple[int, ...] = _ALL_DAYS,\n   538→        data: Optional[object] = None,\n   539→        name: Optional[str] = None,\n   540→        chat_id: Optional[int] = None,\n   541→        user_id: Optional[int] = None,\n   542→        job_kwargs: Optional[JSONDict] = None,\n   543→    ) -> \"Job[CCT]\":\n   544→        \"\"\"Creates a new :class:`Job` that runs on a daily basis and adds it to the queue.\n   545→\n   546→        Note:\n   547→            For a note about DST, please see the documentation of `APScheduler`_.\n   548→\n   549→        .. _`APScheduler`: https://apscheduler.readthedocs.io/en/stable/modules/triggers/cron.html\n   550→                           #daylight-saving-time-behavior\n   551→\n   552→        Args:\n   553→            callback (:term:`coroutine function`): The callback function that should be executed by\n   554→                the new job. Callback signature::\n   555→\n   556→                    async def callback(context: CallbackContext)\n   557→\n   558→            time (:obj:`datetime.time`): Time of day at which the job should run. If the timezone\n   559→                (:obj:`datetime.time.tzinfo`) is :obj:`None`, the default timezone of the bot will\n   560→                be used, which is UTC unless :attr:`telegram.ext.Defaults.tzinfo` is used.\n   561→            days (tuple[:obj:`int`], optional): Defines on which days of the week the job should\n   562→                run (where ``0-6`` correspond to sunday - saturday). By default, the job will run\n   563→                every day.\n   564→\n   565→                .. versionchanged:: 20.0\n   566→                    Changed day of the week mapping of 0-6 from monday-sunday to sunday-saturday.\n   567→\n   568→            data (:obj:`object`, optional): Additional data needed for the callback function.\n   569→                Can be accessed through :attr:`Job.data` in the callback. Defaults to\n   570→                :obj:`None`.\n   571→\n   572→                .. versionchanged:: 20.0\n   573→                    Renamed the parameter ``context`` to :paramref:`data`.\n   574→            name (:obj:`str`, optional): The name of the new job. Defaults to\n   575→                :external:attr:`callback.__name__ <definition.__name__>`.\n   576→            chat_id (:obj:`int`, optional): Chat id of the chat associated with this job. If\n   577→                passed, the corresponding :attr:`~telegram.ext.CallbackContext.chat_data` will\n   578→                be available in the callback.\n   579→\n   580→                .. versionadded:: 20.0\n   581→\n   582→            user_id (:obj:`int`, optional): User id of the user associated with this job. If\n   583→                passed, the corresponding :attr:`~telegram.ext.CallbackContext.user_data` will\n   584→                be available in the callback.\n   585→\n   586→                .. versionadded:: 20.0\n   587→            job_kwargs (:obj:`dict`, optional): Arbitrary keyword arguments to pass to the\n   588→                :meth:`apscheduler.schedulers.base.BaseScheduler.add_job()`.\n   589→\n   590→        Returns:\n   591→            :class:`telegram.ext.Job`: The new :class:`Job` instance that has been added to the job\n   592→            queue.\n   593→\n   594→        \"\"\"\n   595→        if not job_kwargs:\n   596→            job_kwargs = {}\n   597→\n   598→        name = name or callback.__name__\n   599→        job = Job(callback=callback, data=data, name=name, chat_id=chat_id, user_id=user_id)\n   600→\n   601→        j = self.scheduler.add_job(\n   602→            self.job_callback,\n   603→            name=name,\n   604→            args=(self, job),\n   605→            trigger=\"cron\",\n   606→            day_of_week=\",\".join([self._CRON_MAPPING[d] for d in days]),\n   607→            hour=time.hour,\n   608→            minute=time.minute,\n   609→            second=time.second,\n   610→            timezone=time.tzinfo or self.scheduler.timezone,\n   611→            **job_kwargs,\n   612→        )\n   613→\n   614→        job._job = j  # pylint: disable=protected-access\n   615→        return job\n   616→\n   617→    def run_custom(\n   618→        self,\n   619→        callback: JobCallback[CCT],\n   620→        job_kwargs: JSONDict,\n   621→        data: Optional[object] = None,\n   622→        name: Optional[str] = None,\n   623→        chat_id: Optional[int] = None,\n   624→        user_id: Optional[int] = None,\n   625→    ) -> \"Job[CCT]\":\n   626→        \"\"\"Creates a new custom defined :class:`Job`.\n   627→\n   628→        Args:\n   629→            callback (:term:`coroutine function`): The callback function that should be executed by\n   630                the new job. Callback signature::\n   631→\n   632→                    async def callback(context: CallbackContext)\n   633→\n   634→            job_kwargs (:obj:`dict`): Arbitrary keyword arguments. Used as arguments for\n   635→                :meth:`apscheduler.schedulers.base.BaseScheduler.add_job`.\n   636→            data (:obj:`object`, optional): Additional data needed for the callback function.\n   637→                Can be accessed through :attr:`Job.data` in the callback. Defaults to\n   638→                :obj:`None`.\n   639→\n   640→                .. versionchanged:: 20.0\n   641→                    Renamed the parameter ``context`` to :paramref:`data`.\n   642→            name (:obj:`str`, optional): The name of the new job. Defaults to\n   643→                :external:attr:`callback.__name__ <definition.__name__>`.\n   644→            chat_id (:obj:`int`, optional): Chat id of the chat associated with this job. If\n   645→                passed, the corresponding :attr:`~telegram.ext.CallbackContext.chat_data` will\n   646→                be available in the callback.\n   647→\n   648→                .. versionadded:: 20.0\n   649→\n   650→            user_id (:obj:`int`, optional): User id of the user associated with this job. If\n   651→                passed, the corresponding :attr:`~telegram.ext.CallbackContext.user_data` will\n   652→                be available in the callback.\n   653→\n   654→                .. versionadded:: 20.0\n   655→\n   656→        Returns:\n   657→            :class:`telegram.ext.Job`: The new :class:`Job` instance that has been added to the job\n   658→            queue.\n   659→\n   660→        \"\"\"\n   661→        name = name or callback.__name__\n   662→        job = Job(callback=callback, data=data, name=name, chat_id=chat_id, user_id=user_id)\n   663→\n   664→        j = self.scheduler.add_job(self.job_callback, args=(self, job), name=name, **job_kwargs)\n   665→\n   666→        job._job = j  # pylint: disable=protected-access\n   667→        return job\n   668→\n   669→    async def start(self) -> None:\n   670→        # this method async just in case future versions need that\n   671→        \"\"\"Starts the :class:`~telegram.ext.JobQueue`.\"\"\"\n   672→        if not self.scheduler.running:\n   673→            self.scheduler.start()\n   674→\n   675→    async def stop(self, wait: bool = True) -> None:\n   676→        \"\"\"Shuts down the :class:`~telegram.ext.JobQueue`.\n   677→\n   678→        Args:\n   679→            wait (:obj:`bool`, optional): Whether to wait until all currently running jobs\n   680→                have finished. Defaults to :obj:`True`.\n   681→\n   682→        \"\"\"\n   683→        # the interface methods of AsyncIOExecutor are currently not really asyncio-compatible\n   684→        # so we apply some small tweaks here to try and smoothen the integration into PTB\n   685→        # TODO: When APS 4.0 hits, we should be able to remove the tweaks\n   686→        if wait:\n   687→            # Unfortunately AsyncIOExecutor just cancels them all ...\n   688→            await asyncio.gather(\n   689→                *self._executor._pending_futures,  # pylint: disable=protected-access\n   690→                return_exceptions=True,\n   691→            )\n   692→        if self.scheduler.running:\n   693→            self.scheduler.shutdown(wait=wait)\n   694→            # scheduler.shutdown schedules a task in the event loop but immediately returns\n   695→            # so give it a tiny bit of time to actually shut down.\n   696→            await asyncio.sleep(0.01)\n   697→\n   698→    def jobs(self) -> tuple[\"Job[CCT]\", ...]:\n   699→        \"\"\"Returns a tuple of all *scheduled* jobs that are currently in the :class:`JobQueue`.\n   700→\n   701→        Returns:\n   702→            tuple[:class:`Job`]: Tuple of all *scheduled* jobs.\n   703→        \"\"\"\n   704→        return tuple(Job.from_aps_job(job) for job in self.scheduler.get_jobs())\n   705→\n   706→    def get_jobs_by_name(self, name: str, use_regex: bool = False) -> tuple[\"Job[CCT]\", ...]:\n   707→        \"\"\"Returns a tuple of all *pending/scheduled* jobs with the given name that are currently\n   708→        in the :class:`JobQueue`.\n   709→\n   710→        If ``use_regex`` is set to :obj:`True`, the :func:`re.search` function is used to look for\n   711→        a match with the provided ``name`` as pattern on ``job.name``.\n   712→\n   713→        Args:\n   714→            name (:obj:`str`): The name or regex pattern to match against job names.\n   715→            use_regex (:obj:`bool`, optional): Whether to treat ``name`` as a regex pattern.\n   716→                Defaults to :obj:`False`.\n   717→\n   718→        Returns:\n   719→            tuple[:class:`Job`]: Tuple of all *pending* or *scheduled* jobs matching the name.\n   720→        \"\"\"\n   721→        if use_regex:\n   722→            from re import compile as _re_compile\n   723→\n   724→            pattern = _re_compile(str(name))\n   725→            return tuple(job for job in self.jobs() if job.name and pattern.search(job.name))\n   726→\n   727→        return tuple(job for job in self.jobs() if job.name == name)\n   728→\n   729→\n   730→class Job(Generic[CCT]):\n   731→    \"\"\"This class is a convenience wrapper for the jobs held in a :class:`telegram.ext.JobQueue`.\n   732→    With the current backend APScheduler, :attr:`job` holds a :class:`apscheduler.job.Job`\n   733→    instance.\n   734→\n   735→    Objects of this class are comparable in terms of equality. Two objects of this class are\n   736→    considered equal, if their :class:`id <apscheduler.job.Job>` is equal.\n   737→\n   738→    This class is a :class:`~typing.Generic` class and accepts one type variable that specifies\n   739→    the type of the argument ``context`` of :paramref:`callback`.\n   740→\n   741→    Important:\n   742→        If you want to use this class, you must install PTB with the optional requirement\n   743→        ``job-queue``, i.e.\n   744→\n   745→        .. code-block:: bash\n   746→\n   747→           pip install \"python-telegram-bot[job-queue]\"\n   748→\n   749→    Note:\n   750→        All attributes and instance methods of :attr:`job` are also directly available as\n   751→        attributes/methods of the corresponding :class:`telegram.ext.Job` object.\n   752→\n   753→    Warning:\n   754→        This class should not be instantiated manually.\n   755→        Use the methods of :class:`telegram.ext.JobQueue` to schedule jobs.\n   756→\n   757→    .. seealso:: :wiki:`Job Queue <Extensions---JobQueue>`\n   758→\n   759→    .. versionchanged:: 20.0\n   760→\n   761→       * Removed argument and attribute ``job_queue``.\n   762→       * Renamed ``Job.context`` to :attr:`Job.data`.\n   763→       * Removed argument ``job``\n   764→       * To use this class, PTB must be installed via\n   765→         ``pip install \"python-telegram-bot[job-queue]\"``.\n   766→\n   767→    Args:\n   768→        callback (:term:`coroutine function`): The callback function that should be executed by the\n   769→            new job. Callback signature::\n   770→\n   771→                async def callback(context: CallbackContext)\n   772→\n   773→        data (:obj:`object`, optional): Additional data needed for the :paramref:`callback`\n   774→            function. Can be accessed through :attr:`Job.data` in the callback. Defaults to\n   775→            :obj:`None`.\n   776→        name (:obj:`str`, optional): The name of the new job. Defaults to\n   777→            :external:obj:`callback.__name__ <definition.__name__>`.\n   778→        chat_id (:obj:`int`, optional): Chat id of the chat that this job is associated with.\n   779→\n   780→            .. versionadded:: 20.0\n   781→        user_id (:obj:`int`, optional): User id of the user that this job is associated with.\n   782→\n   783→            .. versionadded:: 20.0\n   784→    Attributes:\n   785→        callback (:term:`coroutine function`): The callback function that should be executed by the\n   786→            new job.\n   787→        data (:obj:`object`): Optional. Additional data needed for the :attr:`callback` function.\n   788→        name (:obj:`str`): Optional. The name of the new job.\n   789→        chat_id (:obj:`int`): Optional. Chat id of the chat that this job is associated with.\n   790→\n   791→            .. versionadded:: 20.0\n   792→        user_id (:obj:`int`): Optional. User id of the user that this job is associated with.\n   793→\n   794→            .. versionadded:: 20.0\n   795→    \"\"\"\n   796→\n   797→    __slots__ = (\n   798→        \"_enabled\",\n   799→        \"_job\",\n   800→        \"_removed\",\n   801→        \"callback\",\n   802→        \"chat_id\",\n   803→        \"data\",\n   804→        \"name\",\n   805→        \"user_id\",\n   806→    )\n   807→\n   808→    def __init__(\n   809→        self,\n   810→        callback: JobCallback[CCT],\n   811→        data: Optional[object] = None,\n   812→        name: Optional[str] = None,\n   813→        chat_id: Optional[int] = None,\n   814→        user_id: Optional[int] = None,\n   815→    ):\n   816→        if not APS_AVAILABLE:\n   817→            raise RuntimeError(\n   818→                \"To use `Job`, PTB must be installed via `pip install \"\n   819→                '\"python-telegram-bot[job-queue]\"`.'\n   820→            )\n   821→\n   822→        self.callback: JobCallback[CCT] = callback\n   823→        self.data: Optional[object] = data\n   824→        self.name: Optional[str] = name or callback.__name__\n   825→        self.chat_id: Optional[int] = chat_id\n   826→        self.user_id: Optional[int] = user_id\n   827→\n   828→        self._removed = False\n   829→        self._enabled = False\n   830→\n   831→        self._job = cast(\"APSJob\", None)\n   832→\n   833→    def __getattr__(self, item: str) -> object:\n   834→        \"\"\"Overrides :py:meth:`object.__getattr__` to get specific attribute of the\n   835→        :class:`telegram.ext.Job` object or of its attribute :class:`apscheduler.job.Job`,\n   836→        if exists.\n   837→\n   838→        Args:\n   839→           item (:obj:`str`): The name of the attribute.\n   840→\n   841→        Returns:\n   842→            :object: The value of the attribute.\n   843→\n   844→        Raises:\n   845→            :exc:`AttributeError`: If the attribute does not exist in both\n   846→                :class:`telegram.ext.Job` and :class:`apscheduler.job.Job` objects.\n   847→        \"\"\"\n   848→        try:\n   849→            return getattr(self.job, item)\n   850→        except AttributeError as exc:\n   851→            raise AttributeError(\n   852→                f\"Neither 'telegram.ext.Job' nor 'apscheduler.job.Job' has attribute '{item}'\"\n   853→            ) from exc\n   854→\n   855→    def __eq__(self, other: object) -> bool:\n   856→        \"\"\"Defines equality condition for the :class:`telegram.ext.Job` object.\n   857→        Two objects of this class are considered to be equal if their\n   858→        :class:`id <apscheduler.job.Job>` are equal.\n   859→\n   860→        Returns:\n   861→            :obj:`True` if both objects have :paramref:`id` parameters identical.\n   862→            :obj:`False` otherwise.\n   863→        \"\"\"\n   864→        if isinstance(other, self.__class__):\n   865→            return self.id == other.id\n   866→        return False\n   867→\n   868→    def __hash__(self) -> int:\n   869→        \"\"\"Builds a hash value for this object such that the hash of two objects is\n   870→        equal if and only if the objects are equal in terms of :meth:`__eq__`.\n   871→\n   872→        Returns:\n   873→            :obj:`int`: The hash value of the object.\n   874→        \"\"\"\n   875→        return hash(self.id)\n   876→\n   877→    def __repr__(self) -> str:\n   878→        \"\"\"Give a string representation of the job in the form\n   879→        ``Job[id=..., name=..., callback=..., trigger=...]``.\n   880→\n   881→        As this class doesn't implement :meth:`object.__str__`, the default implementation\n   882→        will be used, which is equivalent to :meth:`__repr__`.\n   883→\n   884→        Returns:\n   885→            :obj:`str`\n   886→        \"\"\"\n   887→        return build_repr_with_selected_attrs(\n   888→            self,\n   889→            id=self.job.id,\n   890→            name=self.name,\n   891→            callback=self.callback.__name__,\n   892→            trigger=self.job.trigger,\n   893→        )\n   894→\n   895→    @property\n   896→    def job(self) -> \"APSJob\":\n   897→        \"\"\":class:`apscheduler.job.Job`: The APS Job this job is a wrapper for.\n   898→\n   899→        .. versionchanged:: 20.0\n   900→            This property is now read-only.\n   901→        \"\"\"\n   902→        return self._job\n   903→\n   904→    @property\n   905→    def removed(self) -> bool:\n   906→        \"\"\":obj:`bool`: Whether this job is due to be removed.\"\"\"\n   907→        return self._removed\n   908→\n   909→    @property\n   910→    def enabled(self) -> bool:\n   911→        \"\"\":obj:`bool`: Whether this job is enabled.\"\"\"\n   912→        return self._enabled\n   913→\n   914→    @enabled.setter\n   915→    def enabled(self, status: bool) -> None:\n   916→        if status:\n   917→            self.job.resume()\n   918→        else:\n   919→            self.job.pause()\n   920→        self._enabled = status\n   921→\n   922→    @property\n   923→    def next_t(self) -> Optional[dtm.datetime]:\n   924→        \"\"\"\n   925→        :class:`datetime.datetime`: Datetime for the next job execution.\n   926→        Datetime is localized according to :attr:`datetime.datetime.tzinfo`.\n   927→        If job is removed or already ran it equals to :obj:`None`.\n   928→\n   929→        Warning:\n   930→            This attribute is only available, if the :class:`telegram.ext.JobQueue` this job\n   931→            belongs to is already started. Otherwise APScheduler raises an :exc:`AttributeError`.\n   932→        \"\"\"\n   933→        return self.job.next_run_time\n   934→\n   935→    @classmethod\n   936→    def from_aps_job(cls, aps_job: \"APSJob\") -> \"Job[CCT]\":\n   937→        \"\"\"Provides the :class:`telegram.ext.Job` that is associated with the given APScheduler\n   938→        job.\n   939→\n   940→        Tip:\n   941→            This method can be useful when using advanced APScheduler features along with\n   942→            :class:`telegram.ext.JobQueue`.\n   943→\n   944→        .. versionadded:: 20.4\n   945→\n   946→        Args:\n   947→            aps_job (:class:`apscheduler.job.Job`): The APScheduler job\n   948→\n   949→        Returns:\n   950→            :class:`telegram.ext.Job`\n   951→        \"\"\"\n   952→        ext_job = aps_job.args[1]\n   953→        ext_job._job = aps_job  # pylint: disable=protected-access\n   954→        return ext_job\n   955→\n   956→    async def run(\n   957→        self, application: \"Application[Any, CCT, Any, Any, Any, JobQueue[CCT]]\"\n   958→    ) -> None:\n   959→        \"\"\"Executes the callback function independently of the jobs schedule. Also calls\n   960→        :meth:`telegram.ext.Application.update_persistence`.\n   961→\n   962→        .. versionchanged:: 20.0\n   963→            Calls :meth:`telegram.ext.Application.update_persistence`.\n   964→\n   965→        Args:\n   966→            application (:class:`telegram.ext.Application`): The application this job is associated\n   967→                with.\n   968→        \"\"\"\n   969→        # We shield the task such that the job isn't cancelled mid-run\n   970→        await asyncio.shield(self._run(application))\n   971→\n   972→    async def _run(\n   973→        self, application: \"Application[Any, CCT, Any, Any, Any, JobQueue[CCT]]\"\n   974→    ) -> None:\n   975→        try:\n   976→            try:\n   977→                context = application.context_types.context.from_job(self, application)\n   978→            except Exception as exc:\n   979→                _LOGGER.critical(\n   980→                    \"Error while building CallbackContext for job %s. Job will not be run.\",\n   981→                    self._job,\n   982→                    exc_info=exc,\n   983→                )\n   984→                return\n   985→\n   986→            await context.refresh_data()\n   987→            await self.callback(context)\n   988→        except Exception as exc:\n   989→            await application.create_task(\n   990→                application.process_error(None, exc, job=self),\n   991→                name=f\"Job:{self.id}:run:process_error\",\n   992→            )\n   993→        finally:\n   994→            # This is internal logic of application - let's keep it private for now\n   995→            application._mark_for_persistence_update(job=self)  # pylint: disable=protected-access\n   996→\n   997→    def schedule_removal(self) -> None:\n   998→        \"\"\"\n   999→        Schedules this job for removal from the :class:`JobQueue`. It will be removed without\n  1000→        executing its callback function again.\n  1001→        \"\"\"\n  1002→        self.job.remove()\n  1003→        self._removed = True\n  1004→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"296fb417-03fb-4cb7-9929-05630059db4a","uuid":"533862cc-a024-403e-90c6-2fb44da31602","tool_use_result":{"type":"text","file":{"filePath":"/testbed/telegram/ext/_jobqueue.py","content":"#!/usr/bin/env python\n#\n# A library that provides a Python interface to the Telegram Bot API\n# Copyright (C) 2015-2025\n# Leandro Toledo de Souza <devs@python-telegram-bot.org>\n#\n# This program is free software: you can redistribute it and/or modify\n# it under the terms of the GNU Lesser Public License as published by\n# the Free Software Foundation, either version 3 of the License, or\n# (at your option) any later version.\n#\n# This program is distributed in the hope that it will be useful,\n# but WITHOUT ANY WARRANTY; without even the implied warranty of\n# MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the\n# GNU Lesser Public License for more details.\n#\n# You should have received a copy of the GNU Lesser Public License\n# along with this program.  If not, see [http://www.gnu.org/licenses/].\n\"\"\"This module contains the classes JobQueue and Job.\"\"\"\nimport asyncio\nimport datetime as dtm\nimport weakref\nfrom typing import TYPE_CHECKING, Any, Generic, Optional, Union, cast, overload\n\ntry:\n    from apscheduler.executors.asyncio import AsyncIOExecutor\n    from apscheduler.schedulers.asyncio import AsyncIOScheduler\n\n    APS_AVAILABLE = True\nexcept ImportError:\n    APS_AVAILABLE = False\n\nfrom telegram._utils.datetime import UTC, localize\nfrom telegram._utils.logging import get_logger\nfrom telegram._utils.repr import build_repr_with_selected_attrs\nfrom telegram._utils.types import JSONDict\nfrom telegram.ext._extbot import ExtBot\nfrom telegram.ext._utils.types import CCT, JobCallback\n\nif TYPE_CHECKING:\n    if APS_AVAILABLE:\n        from apscheduler.job import Job as APSJob\n\n    from telegram.ext import Application\n\n\n_ALL_DAYS = tuple(range(7))\n_LOGGER = get_logger(__name__, class_name=\"JobQueue\")\n\n\nclass JobQueue(Generic[CCT]):\n    \"\"\"This class allows you to periodically perform tasks with the bot. It is a convenience\n    wrapper for the APScheduler library.\n\n    This class is a :class:`~typing.Generic` class and accepts one type variable that specifies\n    the type of the argument ``context`` of the job callbacks (:paramref:`~run_once.callback`) of\n    :meth:`run_once` and the other scheduling methods.\n\n    Important:\n        If you want to use this class, you must install PTB with the optional requirement\n        ``job-queue``, i.e.\n\n        .. code-block:: bash\n\n           pip install \"python-telegram-bot[job-queue]\"\n\n    Examples:\n        :any:`Timer Bot <examples.timerbot>`\n\n    .. seealso:: :wiki:`Architecture Overview <Architecture>`,\n        :wiki:`Job Queue <Extensions---JobQueue>`\n\n    .. versionchanged:: 20.0\n        To use this class, PTB must be installed via\n        ``pip install \"python-telegram-bot[job-queue]\"``.\n\n    Attributes:\n        scheduler (:class:`apscheduler.schedulers.asyncio.AsyncIOScheduler`): The scheduler.\n\n            Warning:\n                This scheduler is configured by :meth:`set_application`. Additional configuration\n                settings can be made by users. However, calling\n                :meth:`~apscheduler.schedulers.base.BaseScheduler.configure` will delete any\n                previous configuration settings. Therefore, please make sure to pass the values\n                returned by :attr:`scheduler_configuration` to the method call in addition to your\n                custom values.\n                Alternatively, you can also use methods like\n                :meth:`~apscheduler.schedulers.base.BaseScheduler.add_jobstore` to avoid using\n                :meth:`~apscheduler.schedulers.base.BaseScheduler.configure` altogether.\n\n            .. versionchanged:: 20.0\n                Uses :class:`~apscheduler.schedulers.asyncio.AsyncIOScheduler` instead of\n                :class:`~apscheduler.schedulers.background.BackgroundScheduler`\n\n    \"\"\"\n\n    __slots__ = (\"_application\", \"_executor\", \"scheduler\")\n    _CRON_MAPPING = (\"sun\", \"mon\", \"tue\", \"wed\", \"thu\", \"fri\", \"sat\")\n\n    def __init__(self) -> None:\n        if not APS_AVAILABLE:\n            raise RuntimeError(\n                \"To use `JobQueue`, PTB must be installed via `pip install \"\n                '\"python-telegram-bot[job-queue]\"`.'\n            )\n\n        self._application: Optional[weakref.ReferenceType[Application]] = None\n        self._executor = AsyncIOExecutor()\n        self.scheduler: \"AsyncIOScheduler\" = AsyncIOScheduler(  # noqa: UP037\n            **self.scheduler_configuration\n        )\n\n    def __repr__(self) -> str:\n        \"\"\"Give a string representation of the JobQueue in the form ``JobQueue[application=...]``.\n\n        As this class doesn't implement :meth:`object.__str__`, the default implementation\n        will be used, which is equivalent to :meth:`__repr__`.\n\n        Returns:\n            :obj:`str`\n        \"\"\"\n        return build_repr_with_selected_attrs(self, application=self.application)\n\n    @property\n    def application(self) -> \"Application[Any, CCT, Any, Any, Any, JobQueue[CCT]]\":\n        \"\"\"The application this JobQueue is associated with.\"\"\"\n        if self._application is None:\n            raise RuntimeError(\"No application was set for this JobQueue.\")\n        application = self._application()\n        if application is not None:\n            return application\n        raise RuntimeError(\"The application instance is no longer alive.\")\n\n    @property\n    def scheduler_configuration(self) -> JSONDict:\n        \"\"\"Provides configuration values that are used by :class:`JobQueue` for :attr:`scheduler`.\n\n        Tip:\n            Since calling\n            :meth:`scheduler.configure() <apscheduler.schedulers.base.BaseScheduler.configure>`\n            deletes any previous setting, please make sure to pass these values to the method call\n            in addition to your custom values:\n\n            .. code-block:: python\n\n                scheduler.configure(..., **job_queue.scheduler_configuration)\n\n            Alternatively, you can also use methods like\n            :meth:`~apscheduler.schedulers.base.BaseScheduler.add_jobstore` to avoid using\n            :meth:`~apscheduler.schedulers.base.BaseScheduler.configure` altogether.\n\n        .. versionadded:: 20.7\n\n        Returns:\n            dict[:obj:`str`, :obj:`object`]: The configuration values as dictionary.\n\n        \"\"\"\n        timezone: dtm.tzinfo = UTC\n        if (\n            self._application\n            and isinstance(self.application.bot, ExtBot)\n            and self.application.bot.defaults\n        ):\n            timezone = self.application.bot.defaults.tzinfo or UTC\n\n        return {\n            \"timezone\": timezone,\n            \"executors\": {\"default\": self._executor},\n        }\n\n    def _tz_now(self) -> dtm.datetime:\n        return dtm.datetime.now(self.scheduler.timezone)\n\n    @overload\n    def _parse_time_input(self, time: None, shift_day: bool = False) -> None: ...\n\n    @overload\n    def _parse_time_input(\n        self,\n        time: Union[float, dtm.timedelta, dtm.datetime, dtm.time],\n        shift_day: bool = False,\n    ) -> dtm.datetime: ...\n\n    def _parse_time_input(\n        self,\n        time: Union[float, dtm.timedelta, dtm.datetime, dtm.time, None],\n        shift_day: bool = False,\n    ) -> Optional[dtm.datetime]:\n        if time is None:\n            return None\n        if isinstance(time, (int, float)):\n            return self._tz_now() + dtm.timedelta(seconds=time)\n        if isinstance(time, dtm.timedelta):\n            return self._tz_now() + time\n        if isinstance(time, dtm.time):\n            date_time = dtm.datetime.combine(\n                dtm.datetime.now(tz=time.tzinfo or self.scheduler.timezone).date(), time\n            )\n            if date_time.tzinfo is None:\n                # dtm.combine uses the tzinfo of `time`, which might be None, so we still have\n                # to localize it\n                date_time = localize(date_time, self.scheduler.timezone)\n            if shift_day and date_time <= dtm.datetime.now(UTC):\n                date_time += dtm.timedelta(days=1)\n            return date_time\n        return time\n\n    def set_application(\n        self, application: \"Application[Any, CCT, Any, Any, Any, JobQueue[CCT]]\"\n    ) -> None:\n        \"\"\"Set the application to be used by this JobQueue.\n\n        Args:\n            application (:class:`telegram.ext.Application`): The application.\n\n        \"\"\"\n        self._application = weakref.ref(application)\n        self.scheduler.configure(**self.scheduler_configuration)\n\n    @staticmethod\n    async def job_callback(job_queue: \"JobQueue[CCT]\", job: \"Job[CCT]\") -> None:\n        \"\"\"This method is used as a callback for the APScheduler jobs.\n\n        More precisely, the ``func`` argument of :class:`apscheduler.job.Job` is set to this method\n        and the ``arg`` argument (representing positional arguments to ``func``) is set to a tuple\n        containing the :class:`JobQueue` itself and the :class:`~telegram.ext.Job` instance.\n\n        Tip:\n            This method is a static method rather than a bound method. This makes the arguments\n            more transparent and allows for easier handling of PTBs integration of APScheduler\n            when utilizing advanced features of APScheduler.\n\n        Hint:\n            This method is effectively a wrapper for :meth:`telegram.ext.Job.run`.\n\n        .. versionadded:: 20.4\n\n        Args:\n            job_queue (:class:`JobQueue`): The job queue that created the job.\n            job (:class:`~telegram.ext.Job`): The job to run.\n        \"\"\"\n        await job.run(job_queue.application)\n\n    def run_once(\n        self,\n        callback: JobCallback[CCT],\n        when: Union[float, dtm.timedelta, dtm.datetime, dtm.time],\n        data: Optional[object] = None,\n        name: Optional[str] = None,\n        chat_id: Optional[int] = None,\n        user_id: Optional[int] = None,\n        job_kwargs: Optional[JSONDict] = None,\n    ) -> \"Job[CCT]\":\n        \"\"\"Creates a new :class:`Job` instance that runs once and adds it to the queue.\n\n        Args:\n            callback (:term:`coroutine function`): The callback function that should be executed by\n                the new job. Callback signature::\n\n                    async def callback(context: CallbackContext)\n\n            when (:obj:`int` | :obj:`float` | :obj:`datetime.timedelta` |                         \\\n                  :obj:`datetime.datetime` | :obj:`datetime.time`):\n                Time in or at which the job should run. This parameter will be interpreted\n                depending on its type.\n\n                * :obj:`int` or :obj:`float` will be interpreted as \"seconds from now\" in which the\n                  job should run.\n                * :obj:`datetime.timedelta` will be interpreted as \"time from now\" in which the\n                  job should run.\n                * :obj:`datetime.datetime` will be interpreted as a specific date and time at\n                  which the job should run. If the timezone (:attr:`datetime.datetime.tzinfo`) is\n                  :obj:`None`, the default timezone of the bot will be used, which is UTC unless\n                  :attr:`telegram.ext.Defaults.tzinfo` is used.\n                * :obj:`datetime.time` will be interpreted as a specific time of day at which the\n                  job should run. This could be either today or, if the time has already passed,\n                  tomorrow. If the timezone (:attr:`datetime.time.tzinfo`) is :obj:`None`, the\n                  default timezone of the bot will be used, which is UTC unless\n                  :attr:`telegram.ext.Defaults.tzinfo` is used.\n\n            chat_id (:obj:`int`, optional): Chat id of the chat associated with this job. If\n                passed, the corresponding :attr:`~telegram.ext.CallbackContext.chat_data` will\n                be available in the callback.\n\n                .. versionadded:: 20.0\n\n            user_id (:obj:`int`, optional): User id of the user associated with this job. If\n                passed, the corresponding :attr:`~telegram.ext.CallbackContext.user_data` will\n                be available in the callback.\n\n                .. versionadded:: 20.0\n            data (:obj:`object`, optional): Additional data needed for the callback function.\n                Can be accessed through :attr:`Job.data` in the callback. Defaults to\n                :obj:`None`.\n\n                .. versionchanged:: 20.0\n                    Renamed the parameter ``context`` to :paramref:`data`.\n            name (:obj:`str`, optional): The name of the new job. Defaults to\n                :external:attr:`callback.__name__ <definition.__name__>`.\n            job_kwargs (:obj:`dict`, optional): Arbitrary keyword arguments to pass to the\n                :meth:`apscheduler.schedulers.base.BaseScheduler.add_job()`.\n\n        Returns:\n            :class:`telegram.ext.Job`: The new :class:`Job` instance that has been added to the job\n            queue.\n\n        \"\"\"\n        if not job_kwargs:\n            job_kwargs = {}\n\n        name = name or callback.__name__\n        job = Job(callback=callback, data=data, name=name, chat_id=chat_id, user_id=user_id)\n        date_time = self._parse_time_input(when, shift_day=True)\n\n        j = self.scheduler.add_job(\n            self.job_callback,\n            name=name,\n            trigger=\"date\",\n            run_date=date_time,\n            args=(self, job),\n            timezone=date_time.tzinfo or self.scheduler.timezone,\n            **job_kwargs,\n        )\n\n        job._job = j  # pylint: disable=protected-access\n        return job\n\n    def run_repeating(\n        self,\n        callback: JobCallback[CCT],\n        interval: Union[float, dtm.timedelta],\n        first: Optional[Union[float, dtm.timedelta, dtm.datetime, dtm.time]] = None,\n        last: Optional[Union[float, dtm.timedelta, dtm.datetime, dtm.time]] = None,\n        data: Optional[object] = None,\n        name: Optional[str] = None,\n        chat_id: Optional[int] = None,\n        user_id: Optional[int] = None,\n        job_kwargs: Optional[JSONDict] = None,\n    ) -> \"Job[CCT]\":\n        \"\"\"Creates a new :class:`Job` instance that runs at specified intervals and adds it to the\n        queue.\n\n        Note:\n            For a note about DST, please see the documentation of `APScheduler`_.\n\n        .. _`APScheduler`: https://apscheduler.readthedocs.io/en/stable/modules/triggers/cron.html\n                           #daylight-saving-time-behavior\n\n        Args:\n            callback (:term:`coroutine function`): The callback function that should be executed by\n                the new job. Callback signature::\n\n                    async def callback(context: CallbackContext)\n\n            interval (:obj:`int` | :obj:`float` | :obj:`datetime.timedelta`): The interval in which\n                the job will run. If it is an :obj:`int` or a :obj:`float`, it will be interpreted\n                as seconds.\n            first (:obj:`int` | :obj:`float` | :obj:`datetime.timedelta` |                        \\\n                   :obj:`datetime.datetime` | :obj:`datetime.time`, optional):\n                Time in or at which the job should run. This parameter will be interpreted\n                depending on its type.\n\n                * :obj:`int` or :obj:`float` will be interpreted as \"seconds from now\" in which the\n                  job should run.\n                * :obj:`datetime.timedelta` will be interpreted as \"time from now\" in which the\n                  job should run.\n                * :obj:`datetime.datetime` will be interpreted as a specific date and time at\n                  which the job should run. If the timezone (:attr:`datetime.datetime.tzinfo`) is\n                  :obj:`None`, the default timezone of the bot will be used.\n                * :obj:`datetime.time` will be interpreted as a specific time of day at which the\n                  job should run. This could be either today or, if the time has already passed,\n                  tomorrow. If the timezone (:attr:`datetime.time.tzinfo`) is :obj:`None`, the\n                  default timezone of the bot will be used, which is UTC unless\n                  :attr:`telegram.ext.Defaults.tzinfo` is used.\n\n                Defaults to :paramref:`interval`\n\n                Note:\n                    Setting :paramref:`first` to ``0``, ``datetime.datetime.now()`` or another\n                    value that indicates that the job should run immediately will not work due\n                    to how the APScheduler library works. If you want to run a job immediately,\n                    we recommend to use an approach along the lines of::\n\n                        job = context.job_queue.run_repeating(callback, interval=5)\n                        await job.run(context.application)\n\n                    .. seealso:: :meth:`telegram.ext.Job.run`\n\n            last (:obj:`int` | :obj:`float` | :obj:`datetime.timedelta` |                        \\\n                   :obj:`datetime.datetime` | :obj:`datetime.time`, optional):\n                Latest possible time for the job to run. This parameter will be interpreted\n                depending on its type. See :paramref:`first` for details.\n\n                If :paramref:`last` is :obj:`datetime.datetime` or :obj:`datetime.time` type\n                and ``last.tzinfo`` is :obj:`None`, the default timezone of the bot will be\n                assumed, which is UTC unless :attr:`telegram.ext.Defaults.tzinfo` is used.\n\n                Defaults to :obj:`None`.\n            data (:obj:`object`, optional): Additional data needed for the callback function.\n                Can be accessed through :attr:`Job.data` in the callback. Defaults to\n                :obj:`None`.\n\n                .. versionchanged:: 20.0\n                    Renamed the parameter ``context`` to :paramref:`data`.\n            name (:obj:`str`, optional): The name of the new job. Defaults to\n                :external:attr:`callback.__name__ <definition.__name__>`.\n            chat_id (:obj:`int`, optional): Chat id of the chat associated with this job. If\n                passed, the corresponding :attr:`~telegram.ext.CallbackContext.chat_data` will\n                be available in the callback.\n\n                .. versionadded:: 20.0\n\n            user_id (:obj:`int`, optional): User id of the user associated with this job. If\n                passed, the corresponding :attr:`~telegram.ext.CallbackContext.user_data` will\n                be available in the callback.\n\n                .. versionadded:: 20.0\n            job_kwargs (:obj:`dict`, optional): Arbitrary keyword arguments to pass to the\n                :meth:`apscheduler.schedulers.base.BaseScheduler.add_job()`.\n\n        Returns:\n            :class:`telegram.ext.Job`: The new :class:`Job` instance that has been added to the job\n            queue.\n\n        \"\"\"\n        if not job_kwargs:\n            job_kwargs = {}\n\n        name = name or callback.__name__\n        job = Job(callback=callback, data=data, name=name, chat_id=chat_id, user_id=user_id)\n\n        dt_first = self._parse_time_input(first)\n        dt_last = self._parse_time_input(last)\n\n        if dt_last and dt_first and dt_last < dt_first:\n            raise ValueError(\"'last' must not be before 'first'!\")\n\n        if isinstance(interval, dtm.timedelta):\n            interval = interval.total_seconds()\n\n        j = self.scheduler.add_job(\n            self.job_callback,\n            trigger=\"interval\",\n            args=(self, job),\n            start_date=dt_first,\n            end_date=dt_last,\n            seconds=interval,\n            name=name,\n            **job_kwargs,\n        )\n\n        job._job = j  # pylint: disable=protected-access\n        return job\n\n    def run_monthly(\n        self,\n        callback: JobCallback[CCT],\n        when: dtm.time,\n        day: int,\n        data: Optional[object] = None,\n        name: Optional[str] = None,\n        chat_id: Optional[int] = None,\n        user_id: Optional[int] = None,\n        job_kwargs: Optional[JSONDict] = None,\n    ) -> \"Job[CCT]\":\n        \"\"\"Creates a new :class:`Job` that runs on a monthly basis and adds it to the queue.\n\n        .. versionchanged:: 20.0\n            The ``day_is_strict`` argument was removed. Instead one can now pass ``-1`` to the\n            :paramref:`day` parameter to have the job run on the last day of the month.\n\n        Args:\n            callback (:term:`coroutine function`): The callback function that should be executed by\n                the new job. Callback signature::\n\n                    async def callback(context: CallbackContext)\n\n            when (:obj:`datetime.time`): Time of day at which the job should run. If the timezone\n                (``when.tzinfo``) is :obj:`None`, the default timezone of the bot will be used,\n                which is UTC unless :attr:`telegram.ext.Defaults.tzinfo` is used.\n            day (:obj:`int`): Defines the day of the month whereby the job would run. It should\n                be within the range of ``1`` and ``31``, inclusive. If a month has fewer days than\n                this number, the job will not run in this month. Passing ``-1`` leads to the job\n                running on the last day of the month.\n            data (:obj:`object`, optional): Additional data needed for the callback function.\n                Can be accessed through :attr:`Job.data` in the callback. Defaults to\n                :obj:`None`.\n\n                .. versionchanged:: 20.0\n                    Renamed the parameter ``context`` to :paramref:`data`.\n            name (:obj:`str`, optional): The name of the new job. Defaults to\n                :external:attr:`callback.__name__ <definition.__name__>`.\n            chat_id (:obj:`int`, optional): Chat id of the chat associated with this job. If\n                passed, the corresponding :attr:`~telegram.ext.Callback