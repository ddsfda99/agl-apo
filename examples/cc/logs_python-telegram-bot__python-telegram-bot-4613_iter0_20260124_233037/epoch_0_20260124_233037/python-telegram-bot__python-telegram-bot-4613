2async def job_queue(app):\n    48\u2192    jq = JobQueue()\n    49\u2192    jq.set_application(app)\n    50\u2192    await jq.start()\n    51\u2192    yield jq\n    52\u2192    await jq.stop()\n    53\u2192\n    54\u2192\n    55\u2192@pytest.mark.skipif(\n    56\u2192    TEST_WITH_OPT_DEPS, reason=\"Only relevant if the optional dependency is not installed\"\n    57\u2192)\n    58\u2192class TestNoJobQueue:\n    59\u2192    def test_init_job_queue(self):\n    60\u2192        with pytest.raises(RuntimeError, match=r\"python-telegram-bot\\[job-queue\\]\"):\n    61\u2192            JobQueue()\n    62\u2192\n    63\u2192    def test_init_job(self):\n    64\u2192        with pytest.raises(RuntimeError, match=r\"python-telegram-bot\\[job-queue\\]\"):\n    65\u2192            Job(None)\n    66\u2192\n    67\u2192\n    68\u2192@pytest.mark.skipif(\n    69\u2192    not TEST_WITH_OPT_DEPS, reason=\"Only relevant if the optional dependency is installed\"\n    70\u2192)\n    71\u2192@pytest.mark.skipif(\n    72\u2192    GITHUB_ACTIONS and platform.system() in [\"Windows\", \"Darwin\"],\n    73\u2192    reason=\"On Windows & MacOS precise timings are not accurate.\",\n    74\u2192)\n    75\u2192@pytest.mark.flaky(10, 1)  # Timings aren't quite perfect\n    76\u2192class TestJobQueue:\n    77\u2192    result = 0\n    78\u2192    job_time = 0\n    79\u2192    received_error = None\n    80\u2192\n    81\u2192    @staticmethod\n    82\u2192    def normalize(datetime: dtm.datetime, timezone: dtm.tzinfo) -> dtm.datetime:\n    83\u2192        with contextlib.suppress(AttributeError):\n    84\u2192            return timezone.normalize(datetime)\n    85\u2192\n    86\u2192        return datetime\n    87\u2192\n    88\u2192    async def test_repr(self, app):\n    89\u2192        jq = JobQueue()\n    90\u2192        jq.set_application(app)\n    91\u2192        assert repr(jq) == f\"JobQueue[application={app!r}]\"\n    92\u2192\n    93\u2192        when = dtm.datetime.utcnow() + dtm.timedelta(days=1)\n    94\u2192        callback = self.job_run_once\n    95\u2192        job = jq.run_once(callback, when, name=\"name2\")\n    96\u2192        assert repr(job) == (\n    97\u2192            f\"Job[id={job.job.id}, name={job.name}, callback=job_run_once, \"\n    98\u2192            f\"trigger=date[\"\n    99\u2192            f\"{when.strftime('%Y-%m-%d %H:%M:%S UTC')}\"\n   100\u2192            f\"]]\"\n   101\u2192        )\n   102\u2192\n   103\u2192    @pytest.fixture(autouse=True)\n   104\u2192    def _reset(self):\n   105\u2192        self.result = 0\n   106\u2192        self.job_time = 0\n   107\u2192        self.received_error = None\n   108\u2192\n   109\u2192    def test_scheduler_configuration(self, job_queue, timezone, bot):\n   110\u2192        # Unfortunately, we can't really test the executor setting explicitly without relying\n   111\u2192        # on protected attributes. However, this should be tested enough implicitly via all the\n   112\u2192        # other tests in here\n   113\u2192        assert job_queue.scheduler_configuration[\"timezone\"] is dtm.timezone.utc\n   114\u2192\n   115\u2192        tz_app = ApplicationBuilder().defaults(Defaults(tzinfo=timezone)).token(bot.token).build()\n   116\u2192        assert tz_app.job_queue.scheduler_configuration[\"timezone\"] is timezone\n   117\u2192\n   118\u2192    async def job_run_once(self, context):\n   119\u2192        if (\n   120\u2192            isinstance(context, CallbackContext)\n   121\u2192            and isinstance(context.job, Job)\n   122\u2192            and isinstance(context.update_queue, asyncio.Queue)\n   123\u2192            and context.job.data is None\n   124\u2192            and context.chat_data is None\n   125\u2192            and context.user_data is None\n   126\u2192            and isinstance(context.bot_data, dict)\n   127\u2192        ):\n   128\u2192            self.result += 1\n   129\u2192\n   130\u2192    async def job_with_exception(self, context):\n   131\u2192        raise Exception(\"Test Error\")\n   132\u2192\n   133\u2192    async def job_remove_self(self, context):\n   134\u2192        self.result += 1\n   135\u2192        context.job.schedule_removal()\n   136\u2192\n   137\u2192    async def job_run_once_with_data(self, context):\n   138\u2192        self.result += context.job.data\n   139\u2192\n   140\u2192    async def job_datetime_tests(self, context):\n   141\u2192        self.job_time = time.time()\n   142\u2192\n   143\u2192    async def error_handler_context(self, update, context):\n   144\u2192        self.received_error = (\n   145\u2192            str(context.error),\n   146\u2192            context.job,\n   147\u2192            context.user_data,\n   148\u2192            context.chat_data,\n   149\u2192        )\n   150\u2192\n   151\u2192    async def error_handler_raise_error(self, *args):\n   152\u2192        raise Exception(\"Failing bigly\")\n   153\u2192\n   154\u2192    def test_slot_behaviour(self, job_queue):\n   155\u2192        for attr in job_queue.__slots__:\n   156\u2192            assert getattr(job_queue, attr, \"err\") != \"err\", f\"got extra slot '{attr}'\"\n   157\u2192        assert len(mro_slots(job_queue)) == len(set(mro_slots(job_queue))), \"duplicate slot\"\n   158\u2192\n   159\u2192    def test_application_weakref(self, bot):\n   160\u2192        jq = JobQueue()\n   161\u2192        application = ApplicationBuilder().token(bot.token).job_queue(None).build()\n   162\u2192        with pytest.raises(RuntimeError, match=\"No application was set\"):\n   163\u2192            jq.application\n   164\u2192        jq.set_application(application)\n   165\u2192        assert jq.application is application\n   166\u2192        del application\n   167\u2192        with pytest.raises(RuntimeError, match=\"no longer alive\"):\n   168\u2192            jq.application\n   169\u2192\n   170\u2192    async def test_run_once(self, job_queue):\n   171\u2192        job_queue.run_once(self.job_run_once, 0.1)\n   172\u2192        await asyncio.sleep(0.2)\n   173\u2192        assert self.result == 1\n   174\u2192\n   175\u2192    async def test_run_once_timezone(self, job_queue, timezone):\n   176\u2192        \"\"\"Test the correct handling of aware datetimes\"\"\"\n   177\u2192        # we're parametrizing this with two different UTC offsets to exclude the possibility\n   178\u2192        # of an xpass when the test is run in a timezone with the same UTC offset\n   179\u2192        when = dtm.datetime.now(timezone)\n   180\u2192        job_queue.run_once(self.job_run_once, when)\n   181\u2192        await asyncio.sleep(0.1)\n   182\u2192        assert self.result == 1\n   183\u2192\n   184\u2192    async def test_job_with_data(self, job_queue):\n   185\u2192        job_queue.run_once(self.job_run_once_with_data, 0.1, data=5)\n   186\u2192        await asyncio.sleep(0.2)\n   187\u2192        assert self.result == 5\n   188\u2192\n   189\u2192    async def test_run_repeating(self, job_queue):\n   190\u2192        job_queue.run_repeating(self.job_run_once, 0.1)\n   191\u2192        await asyncio.sleep(0.25)\n   192\u2192        assert self.result == 2\n   193\u2192\n   194\u2192    async def test_run_repeating_first(self, job_queue):\n   195\u2192        job_queue.run_repeating(self.job_run_once, 0.5, first=0.2)\n   196\u2192        await asyncio.sleep(0.15)\n   197\u2192        assert self.result == 0\n   198\u2192        await asyncio.sleep(0.1)\n   199\u2192        assert self.result == 1\n   200\u2192\n   201\u2192    async def test_run_repeating_first_timezone(self, job_queue, timezone):\n   202\u2192        \"\"\"Test correct scheduling of job when passing a timezone-aware datetime as ``first``\"\"\"\n   203\u2192        job_queue.run_repeating(\n   204\u2192            self.job_run_once, 0.5, first=dtm.datetime.now(timezone) + dtm.timedelta(seconds=0.2)\n   205\u2192        )\n   206\u2192        await asyncio.sleep(0.05)\n   207\u2192        assert self.result == 0\n   208\u2192        await asyncio.sleep(0.25)\n   209\u2192        assert self.result == 1\n   210\u2192\n   211\u2192    async def test_run_repeating_last(self, job_queue):\n   212\u2192        job_queue.run_repeating(self.job_run_once, 0.25, last=0.4)\n   213\u2192        await asyncio.sleep(0.3)\n   214\u2192        assert self.result == 1\n   215\u2192        await asyncio.sleep(0.4)\n   216\u2192        assert self.result == 1\n   217\u2192\n   218\u2192    async def test_run_repeating_last_timezone(self, job_queue, timezone):\n   219\u2192        \"\"\"Test correct scheduling of job when passing a timezone-aware datetime as ``last``\"\"\"\n   220\u2192        job_queue.run_repeating(\n   221\u2192            self.job_run_once, 0.25, last=dtm.datetime.now(timezone) + dtm.timedelta(seconds=0.4)\n   222\u2192        )\n   223\u2192        await asyncio.sleep(0.3)\n   224\u2192        assert self.result == 1\n   225\u2192        await asyncio.sleep(0.4)\n   226\u2192        assert self.result == 1\n   227\u2192\n   228\u2192    async def test_run_repeating_last_before_first(self, job_queue):\n   229\u2192        with pytest.raises(ValueError, match=\"'last' must not be before 'first'!\"):\n   230\u2192            job_queue.run_repeating(self.job_run_once, 0.5, first=1, last=0.5)\n   231\u2192\n   232\u2192    async def test_run_repeating_timedelta(self, job_queue):\n   233\u2192        job_queue.run_repeating(self.job_run_once, dtm.timedelta(seconds=0.1))\n   234\u2192        await asyncio.sleep(0.25)\n   235\u2192        assert self.result == 2\n   236\u2192\n   237\u2192    async def test_run_custom(self, job_queue):\n   238\u2192        job_queue.run_custom(self.job_run_once, {\"trigger\": \"interval\", \"seconds\": 0.2})\n   239\u2192        await asyncio.sleep(0.5)\n   240\u2192        assert self.result == 2\n   241\u2192\n   242\u2192    async def test_multiple(self, job_queue):\n   243\u2192        job_queue.run_once(self.job_run_once, 0.1)\n   244\u2192        job_queue.run_once(self.job_run_once, 0.2)\n   245\u2192        job_queue.run_repeating(self.job_run_once, 0.2)\n   246\u2192        await asyncio.sleep(0.55)\n   247\u2192        assert self.result == 4\n   248\u2192\n   249\u2192    async def test_disabled(self, job_queue):\n   250\u2192        j1 = job_queue.run_once(self.job_run_once, 0.1)\n   251\u2192        j2 = job_queue.run_repeating(self.job_run_once, 0.5)\n   252\u2192\n   253\u2192        j1.enabled = False\n   254\u2192        j2.enabled = False\n   255\u2192\n   256\u2192        await asyncio.sleep(0.6)\n   257\u2192\n   258\u2192        assert self.result == 0\n   259\u2192\n   260\u2192        j1.enabled = True\n   261\u2192\n   262\u2192        await asyncio.sleep(0.6)\n   263\u2192\n   264\u2192        assert self.result == 1\n   265\u2192\n   266\u2192    async def test_schedule_removal(self, job_queue):\n   267\u2192        j1 = job_queue.run_once(self.job_run_once, 0.3)\n   268\u2192        j2 = job_queue.run_repeating(self.job_run_once, 0.2)\n   269\u2192\n   270\u2192        await asyncio.sleep(0.25)\n   271\u2192        assert self.result == 1\n   272\u2192\n   273\u2192        j1.schedule_removal()\n   274\u2192        j2.schedule_removal()\n   275\u2192\n   276\u2192        await asyncio.sleep(0.4)\n   277\u2192\n   278\u2192        assert self.result == 1\n   279\u2192\n   280\u2192    async def test_schedule_removal_from_within(self, job_queue):\n   281\u2192        job_queue.run_repeating(self.job_remove_self, 0.1)\n   282\u2192\n   283\u2192        await asyncio.sleep(0.5)\n   284\u2192\n   285\u2192        assert self.result == 1\n   286\u2192\n   287\u2192    async def test_longer_first(self, job_queue):\n   288\u2192        job_queue.run_once(self.job_run_once, 0.2)\n   289\u2192        job_queue.run_once(self.job_run_once, 0.1)\n   290\u2192\n   291\u2192        await asyncio.sleep(0.15)\n   292\u2192\n   293\u2192        assert self.result == 1\n   294\u2192\n   295\u2192    async def test_error(self, job_queue):\n   296\u2192        job_queue.run_repeating(self.job_with_exception, 0.1)\n   297\u2192        job_queue.run_repeating(self.job_run_once, 0.2)\n   298\u2192        await asyncio.sleep(0.3)\n   299\u2192        assert self.result == 1\n   300\u2192\n   301\u2192    async def test_in_application(self, bot_info):\n   302\u2192        app = ApplicationBuilder().bot(make_bot(bot_info)).build()\n   303\u2192        async with app:\n   304\u2192            assert not app.job_queue.scheduler.running\n   305\u2192            await app.start()\n   306\u2192            assert app.job_queue.scheduler.running\n   307\u2192\n   308\u2192            app.job_queue.run_repeating(self.job_run_once, 0.2)\n   309\u2192            await asyncio.sleep(0.3)\n   310\u2192            assert self.result == 1\n   311\u2192            await app.stop()\n   312\u2192            assert not app.job_queue.scheduler.running\n   313\u2192            await asyncio.sleep(1)\n   314\u2192            assert self.result == 1\n   315\u2192\n   316\u2192    async def test_time_unit_int(self, job_queue):\n   317\u2192        # Testing seconds in int\n   318\u2192        delta = 0.5\n   319\u2192        expected_time = time.time() + delta\n   320\u2192\n   321\u2192        job_queue.run_once(self.job_datetime_tests, delta)\n   322\u2192        await asyncio.sleep(0.6)\n   323\u2192        assert pytest.approx(self.job_time) == expected_time\n   324\u2192\n   325\u2192    async def test_time_unit_dt_timedelta(self, job_queue):\n   326\u2192        # Testing seconds, minutes and hours as datetime.timedelta object\n   327\u2192        # This is sufficient to test that it actually works.\n   328\u2192        interval = dtm.timedelta(seconds=0.5)\n   329\u2192        expected_time = time.time() + interval.total_seconds()\n   330\u2192\n   331\u2192        job_queue.run_once(self.job_datetime_tests, interval)\n   332\u2192        await asyncio.sleep(0.6)\n   333\u2192        assert pytest.approx(self.job_time) == expected_time\n   334\u2192\n   335\u2192    async def test_time_unit_dt_datetime(self, job_queue):\n   336\u2192        # Testing running at a specific datetime\n   337\u2192        delta, now = dtm.timedelta(seconds=0.5), dtm.datetime.now(UTC)\n   338\u2192        when = now + delta\n   339\u2192        expected_time = when.timestamp()\n   340\u2192\n   341\u2192        job_queue.run_once(self.job_datetime_tests, when)\n   342\u2192        await asyncio.sleep(0.6)\n   343\u2192        assert self.job_time == pytest.approx(expected_time)\n   344\u2192\n   345\u2192    async def test_time_unit_dt_time_today(self, job_queue):\n   346\u2192        # Testing running at a specific time today\n   347\u2192        delta, now = 0.5, dtm.datetime.now(UTC)\n   348\u2192        expected_time = now + dtm.timedelta(seconds=delta)\n   349\u2192        when = expected_time.time()\n   350\u2192        expected_time = expected_time.timestamp()\n   351\u2192\n   352\u2192        job_queue.run_once(self.job_datetime_tests, when)\n   353\u2192        await asyncio.sleep(0.6)\n   354\u2192        assert self.job_time == pytest.approx(expected_time)\n   355\u2192\n   356\u2192    async def test_time_unit_dt_time_tomorrow(self, job_queue):\n   357\u2192        # Testing running at a specific time that has passed today. Since we can't wait a day, we\n   358\u2192        # test if the job's next scheduled execution time has been calculated correctly\n   359\u2192        delta, now = -2, dtm.datetime.now(UTC)\n   360\u2192        when = (now + dtm.timedelta(seconds=delta)).time()\n   361\u2192        expected_time = (now + dtm.timedelta(seconds=delta, days=1)).timestamp()\n   362\u2192\n   363\u2192        job_queue.run_once(self.job_datetime_tests, when)\n   364\u2192        scheduled_time = job_queue.jobs()[0].next_t.timestamp()\n   365\u2192        assert scheduled_time == pytest.approx(expected_time)\n   366\u2192\n   367\u2192    async def test_time_unit_dt_aware_time(self, job_queue, timezone):\n   368\u2192        # Testing running at a specific tz-aware time today\n   369\u2192        delta, now = 0.5, dtm.datetime.now(timezone)\n   370\u2192        expected_time = now + dtm.timedelta(seconds=delta)\n   371\u2192        when = expected_time.timetz()\n   372\u2192        expected_time = expected_time.timestamp()\n   373\u2192\n   374\u2192        job_queue.run_once(self.job_datetime_tests, when)\n   375\u2192        await asyncio.sleep(0.6)\n   376\u2192        assert self.job_time == pytest.approx(expected_time)\n   377\u2192\n   378\u2192    async def test_run_daily(self, job_queue):\n   379\u2192        delta, now = 1, dtm.datetime.now(UTC)\n   380\u2192        time_of_day = (now + dtm.timedelta(seconds=delta)).time()\n   381\u2192        expected_reschedule_time = (now + dtm.timedelta(seconds=delta, days=1)).timestamp()\n   382\u2192\n   383\u2192        job_queue.run_daily(self.job_run_once, time_of_day)\n   384\u2192        await asyncio.sleep(delta + 0.1)\n   385\u2192        assert self.result == 1\n   386\u2192        scheduled_time = job_queue.jobs()[0].next_t.timestamp()\n   387\u2192        assert scheduled_time == pytest.approx(expected_reschedule_time)\n   388\u2192\n   389\u2192    @pytest.mark.parametrize(\"weekday\", [0, 1, 2, 3, 4, 5, 6])\n   390\u2192    async def test_run_daily_days_of_week(self, job_queue, weekday):\n   391\u2192        delta, now = 1, dtm.datetime.now(UTC)\n   392\u2192        time_of_day = (now + dtm.timedelta(seconds=delta)).time()\n   393\u2192        # offset in days until next weekday\n   394\u2192        offset = (weekday + 6 - now.weekday()) % 7\n   395\u2192        offset = offset if offset > 0 else 7\n   396\u2192        expected_reschedule_time = (now + dtm.timedelta(seconds=delta, days=offset)).timestamp()\n   397\u2192\n   398\u2192        job_queue.run_daily(self.job_run_once, time_of_day, days=[weekday])\n   399\u2192        await asyncio.sleep(delta + 0.1)\n   400\u2192        scheduled_time = job_queue.jobs()[0].next_t.timestamp()\n   401\u2192        assert scheduled_time == pytest.approx(expected_reschedule_time)\n   402\u2192\n   403\u2192    async def test_run_monthly(self, job_queue, timezone):\n   404\u2192        delta, now = 1, dtm.datetime.now(timezone)\n   405\u2192        expected_reschedule_time = now + dtm.timedelta(seconds=delta)\n   406\u2192        time_of_day = expected_reschedule_time.time().replace(tzinfo=timezone)\n   407\u2192\n   408\u2192        day = now.day\n   409\u2192        this_months_days = calendar.monthrange(now.year, now.month)[1]\n   410\u2192        if now.month == 12:\n   411\u2192            next_months_days = calendar.monthrange(now.year + 1, 1)[1]\n   412\u2192        else:\n   413\u2192            next_months_days = calendar.monthrange(now.year, now.month + 1)[1]\n   414\u2192\n   415\u2192        expected_reschedule_time += dtm.timedelta(this_months_days)\n   416\u2192        if day > next_months_days:\n   417\u2192            expected_reschedule_time += dtm.timedelta(next_months_days)\n   418\u2192\n   419\u2192        expected_reschedule_time = self.normalize(expected_reschedule_time, timezone)\n   420\u2192        # Adjust the hour for the special case that between now and next month a DST switch happens\n   421\u2192        expected_reschedule_time += dtm.timedelta(\n   422\u2192            hours=time_of_day.hour - expected_reschedule_time.hour\n   423\u2192        )\n   424\u2192        expected_reschedule_time = expected_reschedule_time.timestamp()\n   425\u2192\n   426\u2192        job_queue.run_monthly(self.job_run_once, time_of_day, day)\n   427\u2192        await asyncio.sleep(delta + 0.1)\n   428\u2192        assert self.result == 1\n   429\u2192        scheduled_time = job_queue.jobs()[0].next_t.timestamp()\n   430\u2192        assert scheduled_time == pytest.approx(expected_reschedule_time, rel=1e-3)\n   431\u2192\n   432\u2192    async def 