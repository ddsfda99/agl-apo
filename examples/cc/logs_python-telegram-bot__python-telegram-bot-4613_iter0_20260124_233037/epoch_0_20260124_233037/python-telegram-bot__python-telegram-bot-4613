t._utils.types import CCT, JobCallback\n    39\u2192\n    40\u2192if TYPE_CHECKING:\n    41\u2192    if APS_AVAILABLE:\n    42\u2192        from apscheduler.job import Job as APSJob\n    43\u2192\n    44\u2192    from telegram.ext import Application\n    45\u2192\n    46\u2192\n    47\u2192_ALL_DAYS = tuple(range(7))\n    48\u2192_LOGGER = get_logger(__name__, class_name=\"JobQueue\")\n    49\u2192\n    50\u2192\n    51\u2192class JobQueue(Generic[CCT]):\n    52\u2192    \"\"\"This class allows you to periodically perform tasks with the bot. It is a convenience\n    53\u2192    wrapper for the APScheduler library.\n    54\u2192\n    55\u2192    This class is a :class:`~typing.Generic` class and accepts one type variable that specifies\n    56\u2192    the type of the argument ``context`` of the job callbacks (:paramref:`~run_once.callback`) of\n    57\u2192    :meth:`run_once` and the other scheduling methods.\n    58\u2192\n    59\u2192    Important:\n    60\u2192        If you want to use this class, you must install PTB with the optional requirement\n    61\u2192        ``job-queue``, i.e.\n    62\u2192\n    63\u2192        .. code-block:: bash\n    64\u2192\n    65\u2192           pip install \"python-telegram-bot[job-queue]\"\n    66\u2192\n    67\u2192    Examples:\n    68\u2192        :any:`Timer Bot <examples.timerbot>`\n    69\u2192\n    70\u2192    .. seealso:: :wiki:`Architecture Overview <Architecture>`,\n    71\u2192        :wiki:`Job Queue <Extensions---JobQueue>`\n    72\u2192\n    73\u2192    .. versionchanged:: 20.0\n    74\u2192        To use this class, PTB must be installed via\n    75\u2192        ``pip install \"python-telegram-bot[job-queue]\"``.\n    76\u2192\n    77\u2192    Attributes:\n    78\u2192        scheduler (:class:`apscheduler.schedulers.asyncio.AsyncIOScheduler`): The scheduler.\n    79\u2192\n    80\u2192            Warning:\n    81\u2192                This scheduler is configured by :meth:`set_application`. Additional configuration\n    82\u2192                settings can be made by users. However, calling\n    83\u2192                :meth:`~apscheduler.schedulers.base.BaseScheduler.configure` will delete any\n    84\u2192                previous configuration settings. Therefore, please make sure to pass the values\n    85\u2192                returned by :attr:`scheduler_configuration` to the method call in addition to your\n    86\u2192                custom values.\n    87\u2192                Alternatively, you can also use methods like\n    88\u2192                :meth:`~apscheduler.schedulers.base.BaseScheduler.add_jobstore` to avoid using\n    89\u2192                :meth:`~apscheduler.schedulers.base.BaseScheduler.configure` altogether.\n    90\u2192\n    91\u2192            .. versionchanged:: 20.0\n    92\u2192                Uses :class:`~apscheduler.schedulers.asyncio.AsyncIOScheduler` instead of\n    93\u2192                :class:`~apscheduler.schedulers.background.BackgroundScheduler`\n    94\u2192\n    95\u2192    \"\"\"\n    96\u2192\n    97\u2192    __slots__ = (\"_application\", \"_executor\", \"scheduler\")\n    98\u2192    _CRON_MAPPING = (\"sun\", \"mon\", \"tue\", \"wed\", \"thu\", \"fri\", \"sat\")\n    99\u2192\n   100\u2192    def __init__(self) -> None:\n   101\u2192        if not APS_AVAILABLE:\n   102\u2192            raise RuntimeError(\n   103\u2192                \"To use `JobQueue`, PTB must be installed via `pip install \"\n   104\u2192                '\"python-telegram-bot[job-queue]\"`.'\n   105\u2192            )\n   106\u2192\n   107\u2192        self._application: Optional[weakref.ReferenceType[Application]] = None\n   108\u2192        self._executor = AsyncIOExecutor()\n   109\u2192        self.scheduler: \"AsyncIOScheduler\" = AsyncIOScheduler(  # noqa: UP037\n   110\u2192            **self.scheduler_configuration\n   111\u2192        )\n   112\u2192\n   113\u2192    def __repr__(self) -> str:\n   114\u2192        \"\"\"Give a string representation of the JobQueue in the form ``JobQueue[application=...]``.\n   115\u2192\n   116\u2192        As this class doesn't implement :meth:`object.__str__`, the default implementation\n   117\u2192        will be used, which is equivalent to :meth:`__repr__`.\n   118\u2192\n   119\u2192        Returns:\n   120\u2192            :obj:`str`\n   121\u2192        \"\"\"\n   122\u2192        return build_repr_with_selected_attrs(self, application=self.application)\n   123\u2192\n   124\u2192    @property\n   125\u2192    def application(self) -> \"Application[Any, CCT, Any, Any, Any, JobQueue[CCT]]\":\n   126\u2192        \"\"\"The application this JobQueue is associated with.\"\"\"\n   127\u2192        if self._application is None:\n   128\u2192            raise RuntimeError(\"No application was set for this JobQueue.\")\n   129\u2192        application = self._application()\n   130\u2192        if application is not None:\n   131\u2192            return application\n   132\u2192        raise RuntimeError(\"The application instance is no longer alive.\")\n   133\u2192\n   134\u2192    @property\n   135\u2192    def scheduler_configuration(self) -> JSONDict:\n   136\u2192        \"\"\"Provides configuration values that are used by :class:`JobQueue` for :attr:`scheduler`.\n   137\u2192\n   138\u2192        Tip:\n   139\u2192            Since calling\n   140\u2192            :meth:`scheduler.configure() <apscheduler.schedulers.base.BaseScheduler.configure>`\n   141\u2192            deletes any previous setting, please make sure to pass these values to the method call\n   142\u2192            in addition to your custom values:\n   143\u2192\n   144\u2192            .. code-block:: python\n   145\u2192\n   146\u2192                scheduler.configure(..., **job_queue.scheduler_configuration)\n   147\u2192\n   148\u2192            Alternatively, you can also use methods like\n   149\u2192            :meth:`~apscheduler.schedulers.base.BaseScheduler.add_jobstore` to avoid using\n   150\u2192            :meth:`~apscheduler.schedulers.base.BaseScheduler.configure` altogether.\n   151\u2192\n   152\u2192        .. versionadded:: 20.7\n   153\u2192\n   154\u2192        Returns:\n   155\u2192            dict[:obj:`str`, :obj:`object`]: The configuration values as dictionary.\n   156\u2192\n   157\u2192        \"\"\"\n   158\u2192        timezone: dtm.tzinfo = UTC\n   159\u2192        if (\n   160\u2192            self._application\n   161\u2192            and isinstance(self.application.bot, ExtBot)\n   162\u2192            and self.application.bot.defaults\n   163\u2192        ):\n   164\u2192            timezone = self.application.bot.defaults.tzinfo or UTC\n   165\u2192\n   166\u2192        return {\n   167\u2192            \"timezone\": timezone,\n   168\u2192            \"executors\": {\"default\": self._executor},\n   169\u2192        }\n   170\u2192\n   171\u2192    def _tz_now(self) -> dtm.datetime:\n   172\u2192        return dtm.datetime.now(self.scheduler.timezone)\n   173\u2192\n   174\u2192    @overload\n   175\u2192    def _parse_time_input(self, time: None, shift_day: bool = False) -> None: ...\n   176\u2192\n   177\u2192    @overload\n   178\u2192    def _parse_time_input(\n   179\u2192        self,\n   180\u2192        time: Union[float, dtm.timedelta, dtm.datetime, dtm.time],\n   181\u2192        shift_day: bool = False,\n   182\u2192    ) -> dtm.datetime: ...\n   183\u2192\n   184\u2192    def _parse_time_input(\n   185\u2192        self,\n   186\u2192        time: Union[float, dtm.timedelta, dtm.datetime, dtm.time, None],\n   187\u2192        shift_day: bool = False,\n   188\u2192    ) -> Optional[dtm.datetime]:\n   189\u2192        if time is None:\n   190\u2192            return None\n   191\u2192        if isinstance(time, (int, float)):\n   192\u2192            return self._tz_now() + dtm.timedelta(seconds=time)\n   193\u2192        if isinstance(time, dtm.timedelta):\n   194\u2192            return self._tz_now() + time\n   195\u2192        if isinstance(time, dtm.time):\n   196\u2192            date_time = dtm.datetime.combine(\n   197\u2192                dtm.datetime.now(tz=time.tzinfo or self.scheduler.timezone).date(), time\n   198\u2192            )\n   199\u2192            if date_time.tzinfo is None:\n   200\u2192                # dtm.combine uses the tzinfo of `time`, which might be None, so we still have\n   201\u2192                # to localize it\n   202\u2192                date_time = localize(date_time, self.scheduler.timezone)\n   203\u2192            if shift_day and date_time <= dtm.datetime.now(UTC):\n   204\u2192                date_time += dtm.timedelta(days=1)\n   205\u2192            return date_time\n   206\u2192        return time\n   207\u2192\n   208\u2192    def set_application(\n   209\u2192        self, application: \"Application[Any, CCT, Any, Any, Any, JobQueue[CCT]]\"\n   210\u2192    ) -> None:\n   211\u2192        \"\"\"Set the application to be used by this JobQueue.\n   212\u2192\n   213\u2192        Args:\n   214\u2192            application (:class:`telegram.ext.Application`): The application.\n   215\u2192\n   216\u2192        \"\"\"\n   217\u2192        self._application = weakref.ref(application)\n   218\u2192        self.scheduler.configure(**self.scheduler_configuration)\n   219\u2192\n   220\u2192    @staticmethod\n   221\u2192    async def job_callback(job_queue: \"JobQueue[CCT]\", job: \"Job[CCT]\") -> None:\n   222\u2192        \"\"\"This method is used as a callback for the APScheduler jobs.\n   223\u2192\n   224\u2192        More precisely, the ``func`` argument of :class:`apscheduler.job.Job` is set to this method\n   225\u2192        and the ``arg`` argument (representing positional arguments to ``func``) is set to a tuple\n   226\u2192        containing the :class:`JobQueue` itself and the :class:`~telegram.ext.Job` instance.\n   227\u2192\n   228\u2192        Tip:\n   229\u2192            This method is a static method rather than a bound method. This makes the arguments\n   230\u2192            more transparent and allows for easier handling of PTBs integration of APScheduler\n   231\u2192            when utilizing advanced features of APScheduler.\n   232\u2192\n   233\u2192        Hint:\n   234\u2192            This method is effectively a wrapper for :meth:`telegram.ext.Job.run`.\n   235\u2192\n   236\u2192        .. versionadded:: 20.4\n   237\u2192\n   238\u2192        Args:\n   239\u2192            job_queue (:class:`JobQueue`): The job queue that created the job.\n   240\u2192            job (:class:`~telegram.ext.Job`): The job to run.\n   241\u2192        \"\"\"\n   242\u2192        await job.run(job_queue.application)\n   243\u2192\n   244\u2192    def run_once(\n   245\u2192        self,\n   246\u2192        callback: JobCallback[CCT],\n   247\u2192        when: Union[float, dtm.timedelta, dtm.datetime, dtm.time],\n   248\u2192        data: Optional[object] = None,\n   249\u2192        name: Optional[str] = None,\n   250\u2192        chat_id: Optional[int] = None,\n   251\u2192        user_id: Optional[int] = None,\n   252\u2192        job_kwargs: Optional[JSONDict] = None,\n   253\u2192    ) -> \"Job[CCT]\":\n   254\u2192        \"\"\"Creates a new :class:`Job` instance that runs once and adds it to the queue.\n   255\u2192\n   256\u2192        Args:\n   257\u2192            callback (:term:`coroutine function`): The callback function that should be executed by\n   258\u2192                the new job. Callback signature::\n   259\u2192\n   260\u2192                    async def callback(context: CallbackContext)\n   261\u2192\n   262\u2192            when (:obj:`int` | :obj:`float` | :obj:`datetime.timedelta` |                         \\\n   263\u2192                  :obj:`datetime.datetime` | :obj:`datetime.time`):\n   264\u2192                Time in or at which the job should run. This parameter will be interpreted\n   265\u2192                depending on its type.\n   266\u2192\n   267\u2192                * :obj:`int` or :obj:`float` will be interpreted as \"seconds from now\" in which the\n   268\u2192                  job should run.\n   269\u2192                * :obj:`datetime.timedelta` will be interpreted as \"time from now\" in which the\n   270\u2192                  job should run.\n   271\u2192                * :obj:`datetime.datetime` will be interpreted as a specific date and time at\n   272\u2192                  which the job should run. If the timezone (:attr:`datetime.datetime.tzinfo`) is\n   273\u2192                  :obj:`None`, the default timezone of the bot will be used, which is UTC unless\n   274\u2192                  :attr:`telegram.ext.Defaults.tzinfo` is used.\n   275\u2192                * :obj:`datetime.time` will be interpreted as a specific time of day at which the\n   276\u2192                  job should run. This could be either today or, if the time has already passed,\n   277\u2192                  tomorrow. If the timezone (:attr:`datetime.time.tzinfo`) is :obj:`None`, the\n   278\u2192                  default timezone of the bot will be used, which is UTC unless\n   279\u2192                  :attr:`telegram.ext.Defaults.tzinfo` is used.\n   280\u2192\n   281\u2192            chat_id (:obj:`int`, optional): Chat id of the chat associated with this job. If\n   282\u2192                passed, the corresponding :attr:`~telegram.ext.CallbackContext.chat_data` will\n   283\u2192                be available in the callback.\n   284\u2192\n   285\u2192                .. versionadded:: 20.0\n   286\u2192\n   287\u2192            user_id (:obj:`int`, optional): User id of the user associated with this job. If\n   288\u2192                passed, the corresponding :attr:`~telegram.ext.CallbackContext.user_data` will\n   289\u2192                be available in the callback.\n   290\u2192\n   291\u2192                .. versionadded:: 20.0\n   292\u2192            data (:obj:`object`, optional): Additional data needed for the callback function.\n   293\u2192                Can be accessed through :attr:`Job.data` in the callback. Defaults to\n   294\u2192                :obj:`None`.\n   295\u2192\n   296\u2192                .. versionchanged:: 20.0\n   297\u2192                    Renamed the parameter ``context`` to :paramref:`data`.\n   298\u2192            name (:obj:`str`, optional): The name of the new job. Defaults to\n   299\u2192                :external:attr:`callback.__name__ <definition.__name__>`.\n   300\u2192            job_kwargs (:obj:`dict`, optional): Arbitrary keyword arguments to pass to the\n   301\u2192                :meth:`apscheduler.schedulers.base.BaseScheduler.add_job()`.\n   302\u2192\n   303\u2192        Returns:\n   304\u2192            :class:`telegram.ext.Job`: The new :class:`Job` instance that has been added to the job\n   305\u2192            queue.\n   306\u2192\n   307\u2192        \"\"\"\n   308\u2192        if not job_kwargs:\n   309\u2192            job_kwargs = {}\n   310\u2192\n   311\u2192        name = name or callback.__name__\n   312\u2192        job = Job(callback=callback, data=data, name=name, chat_id=chat_id, user_id=user_id)\n   313\u2192        date_time = self._parse_time_input(when, shift_day=True)\n   314\u2192\n   315\u2192        j = self.scheduler.add_job(\n   316\u2192            self.job_callback,\n   317\u2192            name=name,\n   318\u2192            trigger=\"date\",\n   319\u2192            run_date=date_time,\n   320\u2192            args=(self, job),\n   321\u2192            timezone=date_time.tzinfo or self.scheduler.timezone,\n   322\u2192            **job_kwargs,\n   323\u2192        )\n   324\u2192\n   325\u2192        job._job = j  # pylint: disable=protected-access\n   326\u2192        return job\n   327\u2192\n   328\u2192    def run_repeating(\n   329\u2192        self,\n   330\u2192        callback: JobCallback[CCT],\n   331\u2192        interval: Union[float, dtm.timedelta],\n