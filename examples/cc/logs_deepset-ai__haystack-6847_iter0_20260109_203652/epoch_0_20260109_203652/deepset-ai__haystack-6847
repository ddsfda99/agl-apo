h(data.get(\"debug_path\", \".haystack_debug/\"))\n   122→        pipe = cls(metadata=metadata, max_loops_allowed=max_loops_allowed, debug_path=debug_path)\n   123→        components_to_reuse = kwargs.get(\"components\", {})\n   124→        for name, component_data in data.get(\"components\", {}).items():\n   125→            if name in components_to_reuse:\n   126→                # Reuse an instance\n   127→                instance = components_to_reuse[name]\n   128→            else:\n   129→                if \"type\" not in component_data:\n   130→                    raise PipelineError(f\"Missing 'type' in component '{name}'\")\n   131→\n   132→                if component_data[\"type\"] not in component.registry:\n   133→                    try:\n   134→                        # Import the module first...\n   135→                        module, _ = component_data[\"type\"].rsplit(\".\", 1)\n   136→                        logger.debug(\"Trying to import %s\", module)\n   137→                        importlib.import_module(module)\n   138→                        # ...then try again\n   139→                        if component_data[\"type\"] not in component.registry:\n   140→                            raise PipelineError(\n   141→                                f\"Successfully imported module {module} but can't find it in the component registry.\"\n   142→                                \"This is unexpected and most likely a bug.\"\n   143→                            )\n   144→                    except (ImportError, PipelineError) as e:\n   145→                        raise PipelineError(f\"Component '{component_data['type']}' not imported.\") from e\n   146→\n   147→                # Create a new one\n   148→                component_class = component.registry[component_data[\"type\"]]\n   149→                instance = component_from_dict(component_class, component_data)\n   150→            pipe.add_component(name=name, instance=instance)\n   151→\n   152→   