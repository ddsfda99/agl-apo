this class decorated with @component?\"\n   191→            )\n   192→\n   193→        # Create the component's input and output sockets\n   194→        input_sockets = getattr(instance, \"__haystack_input__\", {})\n   195→        output_sockets = getattr(instance, \"__haystack_output__\", {})\n   196→\n   197→        # Add component to the graph, disconnected\n   198→        logger.debug(\"Adding component '%s' (%s)\", name, instance)\n   199→        self.graph.add_node(\n   200→            name, instance=instance, input_sockets=input_sockets, output_sockets=output_sockets, visits=0\n   201→        )\n   202→\n   203→    def connect(self, connect_from: str, connect_to: str) -> None:\n   204→        \"\"\"\n   205→        Connects two components together. All components to connect must exist in the pipeline.\n   206→        If connecting to an component that has several output connections, specify the inputs and output names as\n   207→        'component_name.connections_name'.\n   208→\n   209→        Args:\n   210→            connect_from: the component that delivers the value. This can be either just a component name or can be\n   211→                in the format `component_name.connection_name` if the component has multiple outputs.\n   212→            connect_to: the component that receives the value. This can be either just a component name or can be\n   213→                in the format `component_name.connection_name` if the component has multiple inputs.\n   214→\n   215→        Returns:\n   216→            None\n   217→\n   218→        Raises:\n   219→            PipelineConnectError: if the two components cannot be connected (for example if one of the components is\n   220→                not present in the pipeline, or the connections don't match by type, and so on).\n   221→        \"\"\"\n   222→        # Edges may be named explicitly by passing 'node_name.edge_name' to connect().\n   223→        sender, sender_socket_name = parse_connect_string(connect_from)\n   224→        receiver, receiver_socket_name = parse_connect_string(connect_to)\n   225→\n   226→        # Get the nodes data.\n   227→        try:\n   228→            from_sockets = self.graph.nodes[sender][\"output_sockets\"]\n   229→        except KeyError as exc:\n   230→            raise ValueError(f\"Component named {sender} not found in the pipeline.\") from exc\n   231→        try:\n   232→            to_sockets = self.graph.nodes[receiver][\"input_sockets\"]\n   233→        except KeyError as exc:\n   234→            raise ValueError(f\"Component named {receiver} not found in the pipeline.\") from exc\n   235→\n   236→        # If the name of either socket is given, get the socket\n   237→        sender_socket: Optional[OutputSocket] = None\n   238→        if sender_socket_name:\n   239→            sender_socket = from_sockets.get(sender_socket_name)\n   240→            if not sender_socket:\n   241→                raise PipelineConnectError(\n   242→                    f\"'{connect_from} does not exist. \"\n   243→                    f\"Output connections of {sender} are: \"\n   244→                    + \", \".join([f\"{name} (type {_type_name(socket.type)})\" for name, socket in from_sockets.items()])\n   245→                )\n   246→\n   247→        receiver_socket: Optional[InputSocket] = None\n   248→        if receiver_socket_name:\n   249→            receiver_socket = to_sockets.get(receiver_socket_name)\n   250→            if not receiver_socket:\n   251→                raise PipelineConnectError(\n   252→                    f\"'{connect_to} does not exist. \"\n   253→                    f\"Input connections of {receiver} are: \"\n   254→                    + \", \".join([f\"{name} (type {_type_name(socket.type)})\" for name, socket in to_sockets.items()])\n   255→                )\n   256→\n   257→        # Look for a matching connection among the possible ones.\n   258→        # Note that if there is more than one possible connection but two sockets match by name, they're paired.\n   259→        sender_socket_candidates: List[OutputSocket] = [sender_socket] if sender_socket else list(from_sockets.values())\n   260→        receiver_socket_candidates: List[InputSocket] = (\n   261→            [receiver_socket] if receiver_socket else list(to_sockets.values())\n   262→        )\n   263→\n   264→        # Find all possible connections between these two components\n   265→        possible_connections = [\n   266→            (sender_sock, receiver_sock)\n   267→            for sender_sock, receiver_sock in itertools.product(sender_socket_candidates, receiver_socket_candidates)\n   268→            if _types_are_compatible(sender_sock.type, receiver_sock.type)\n   269→        ]\n   270→\n   271→        # We need this status for error messages, since we might need it in multiple places we calculate it here\n   272→        status = _connections_status(\n   273→            sender_node=sender,\n   274→            sender_sockets=sender_socket_candidates,\n   275→            receiver_node=receiver,\n   276→            receiver_sockets=receiver_socket_candidates,\n   277→        )\n   278→\n   279→        if not possible_connections:\n   280→            # There's no possible connection between these two components\n   281→            if len(sender_socket_candidates) == len(receiver_socket_candidates) == 1:\n   282→                msg = (\n   283→                    f\"Cannot connect '{sender}.{sender_socket_candidates[0].name}' with '{receiver}.{receiver_socket_candidates[0].name}': \"\n   284→                    f\"their declared input and output types do not match.\\n{status}\"\n   285→                )\n   286→            else:\n   287→                msg = f\"Cannot connect '{sender}' with '{receiver}': \" f\"no matching connections available.\\n{status}\"\n   288→            raise PipelineConnectError(msg)\n   289→\n   290→        if len(possible_connections) == 1:\n   291→            # There's only one possible connection, use it\n   292→            sender_socket = possible_connections[0][0]\n   293→            receiver_socket = possible_connections[0][1]\n   294→\n   295→        if len(possible_connections) > 1:\n   296→            # There are multiple possible connection, let's try to match them by name\n   297→            name_matches = [\n   298→                (out_sock, in_sock) for out_sock, in_sock in possible_connections if in_sock.name == out_sock.name\n   299→            ]\n   300→            if len(name_matches) != 1:\n   301→                # There's are either no matches or more than one, we can't pick one reliably\n   302→                msg = (\n   303→                    f\"Cannot connect '{sender}' with '{receiver}': more than one connection is possible \"\n   304→                    \"between these components. Please specify the connection name, like: \"\n   305→                    f\"pipeline.connect('{sender}.{possible_connections[0][0].name}', \"\n   306→                    f\"'{receiver}.{possible_connections[0][1].name}').\\n{status}\"\n   307→                )\n   308→                raise PipelineConnectError(msg)\n   309→\n   310→            # Get the only possible match\n   311→            sender_socket = name_matches[0][0]\n   312→            receiver_socket = name_matches[0][1]\n   313→\n   314→        # Connection must be valid on both sender/receiver sides\n   315→        if not sender_socket or not receiver_socket or not sender or not receiver:\n   316→            if sender and sender_socket:\n   317→                sender_repr = f\"{sender}.{sender_socket.name} ({_type_name(sender_socket.type)})\"\n   318→            else:\n   319→                sender_repr = \"input needed\"\n   320→\n   321→            if receiver and receiver_socket:\n   322→                receiver_repr = f\"({_type_name(receiver_socket.type)}) {receiver}.{receiver_socket.name}\"\n   323→            else:\n   324→                receiver_repr = \"output\"\n   325→            msg = f\"Connection must have both sender and receiver: {sender_repr} -> {receiver_repr}\"\n   326→            raise PipelineConnectError(msg)\n   327→\n   328→        logger.debug(\"Connecting '%s.%s' to '%s.%s'\", sender, sender_socket.name, receiver, receiver_socket.name)\n   329→\n   330→        if receiver in sender_socket.receivers and sender in receiver_socket.senders:\n   331→            # This is already connected, nothing to do\n   332→            return\n   333→\n   334→        if receiver_socket.senders and not receiver_socket.is_variadic:\n   335→            # Only variadic input sockets can receive from multiple senders\n   336→            msg = (\n   337→                f\"Cannot connect '{sender}.{sender_socket.name}' with '{receiver}.{receiver_socket.name}': \"\n   338→                f\"{receiver}.{receiver_socket.name} is already connected to {receiver_socket.senders}.\\n\"\n   339→            )\n   340→            raise PipelineConnectError(msg)\n   341→\n   342→        # Update the sockets with the new connection\n   343→        sender_socket.receivers.append(receiver)\n   344→        receiver_socket.senders.append(sender)\n   345→\n   346→        # Create the new connection\n   347→        self.graph.add_edge(\n   348→            sender,\n   349→            receiver,\n   350→            key=f\"{sender_socket.name}/{receiver_socket.name}\",\n   351→            conn_type=_type_name(sender_socket.type),\n   352→            from_socket=sender_socket,\n   353→            to_socket=receiver_socket,\n   354→            mandatory=receiver_socket.is_mandatory,\n   355→        )\n   356→\n   357→    def get_component(self, name: str) -> Component:\n   358→        \"\"\"\n   359→        Returns an instance of a component.\n   360→\n   361→        Args:\n   362→            name: the name of the component\n   363→\n   364→        Returns:\n   365→            The instance of that component.\n   366→\n   367→        Raises:\n   368→            ValueError: if a component with that name is not present in the pipeline.\n   369→        \"\"\"\n   370→        try:\n   371→            return self.graph.nodes[name][\"instance\"]\n   372→        except KeyError as exc:\n   373→            raise ValueError(f\"Component named {name} not found in the pipeline.\") from exc\n   374→\n   375→    def inputs(self) -> Dict[str, Dict[str, Any]]:\n   376→        \"\"\"\n   377→        Returns a dictionary containing the inputs of a pipeline. Each key in the dictionary\n   378→        corresponds to a component name, and its value is another dictionary that describes the\n   379→        input sockets of that component, including their types and whether they are optional.\n   380→\n   381→        Returns:\n   382→            A dictionary where each key is a pipeline component name and each value is a dictionary of\n   383→            inputs sockets of that component.\n   384→        \"\"\"\n   385→        inputs: Dict[str, Dict[str, Any]] = {}\n   386→        for component_name, data in find_pipeline_inputs(self.graph).items():\n   387→            sockets_description = {}\n   388→            for socket in data:\n   389→                sockets_description[socket.name] = {\"type\": socket.type, \"is_mandatory\": socket.is_mandatory}\n   390→                if not socket.is_mandatory:\n   391→                    sockets_description[socket.name][\"default_value\"] = socket.default_value\n   392→\n   393→            if sockets_description:\n   394→                inputs[component_name] = sockets_description\n   395→        return inputs\n   396→\n   397→    def outputs(self) -> Dict[str, Dict[str, Any]]:\n   398→        \"\"\"\n   399→        Returns a dictionary containing the outputs of a pipeline. Each key in the dictionary\n   400→        corresponds to a component name, and its value is another dictionary that describes the\n   401→        output sockets of that component.\n   402→\n   403→        Returns:\n   404→            A dictionary where each key is a pipeline component name and each value is a dictionary of\n   405→            output sockets of that component.\n   406→        \"\"\"\n   407→        outputs = {\n   408→            comp: {socket.name: {\"type\": socket.type} for socket in data}\n   409→            for comp, data in find_pipeline_outputs(self.graph).items()\n   410→            if data\n   411→        }\n   412→        return outputs\n   413→\n   414→    def draw(self, path: Path, engine: RenderingEngines = \"mermaid-image\") -> None:\n   415→        \"\"\"\n   416→        Draws the pipeline. Requires either `graphviz` as a system dependency, or an internet connection for Mermaid.\n   417→        Run `pip install graphviz` or `pip install mermaid` to install missing dependencies.\n   418→\n   419→        Args:\n   420→            path: where to save the diagram.\n   421→            engine: which format to save the graph as. Accepts 'graphviz', 'mermaid-text', 'mermaid-image'.\n   422→                Default is 'mermaid-image'.\n   423→\n   424→        Returns:\n   425→            None\n   426→\n   427→        Raises:\n   428→            ImportError: if `engine='graphviz'` and `pygraphviz` is not installed.\n   429→            HTTPConnectionError: (and similar) if the internet connection is down or other connection issues.\n   430→        \"\"\"\n   431→        _draw(graph=networkx.MultiDiGraph(self.graph), path=path, engine=engine)\n   432→\n   433→    def warm_up(self):\n   434→        \"\"\"\n   435→        Make sure all nodes are warm.\n   436→\n   437→        It's the node's responsibility to make sure this method can be called at every `Pipeline.run()`\n   438→        without re-initializing everything.\n   439→        \"\"\"\n   440→        for node in self.graph.nodes:\n   441→            if hasattr(self.graph.nodes[node][\"instance\"], \"warm_up\"):\n   442→                logger.info(\"Warming up component %s...\", node)\n   443→                self.graph.nodes[node][\"instance\"].warm_up()\n   444→\n   445→    def _validate_input(self, data: Dict[str, Any]):\n   446→        \"\"\"\n   447→        Validates that data:\n   448→        * Each Component name actually exists in the Pipeline\n   449→        * Each Component is not missing any input\n   450→        * Each Component has only one input per input socket, if not variadic\n   451→        * Each Component doesn't receive inputs that are already sent by another Component\n   452→\n   453→        Raises ValueError if any of the above is not true.\n   454→        \"\"\"\n   455→        for component_name, component_inputs in data.items():\n   456→            if component_name not in self.graph.nodes:\n   457→                raise ValueError(f\"Component named {component_name} not found in the pipeline.\")\n   458→            instance = self.graph.nodes[component_name][\"instance\"]\n   459→            for socket_name, socket in instance.__haystack_input__.items():\n   460→                if socket.senders == [] and socket.is_mandatory and socket_name not in component_inputs:\n   461→                    raise ValueError(f\"Missing input for component {component_name}: {socket_name}\")\n   462→            for input_name in component_inputs.keys():\n   463→                if input_name not in instance.__haystack_input__:\n   464→                    raise ValueError(f\"Input {input_name} not found in component {component_name}.\")\n   465→\n   466→        for component_name in self.graph.nodes:\n   467→            instance = self.graph.nodes[component_name][\"instance\"]\n   468→            for socket_name, socket in instance.__haystack_input__.items():\n   469→                component_inputs = data.get(component_name, {})\n   470→                if socket.senders == [] and socket.is_mandatory and socket_name not in component_inputs:\n   471→                    raise ValueError(f\"Missing input for component {component_name}: {socket_name}\")\n   472→                if socket.senders and socket_name in component_inputs and not socket.is_variadic:\n   473→                    raise ValueError(\n   474→                        f\"Input {socket_name} for component {component_name} is already sent by {socket.senders}.\"\n   475→                    )\n   476→\n   477→    # TODO: We're ignoring this linting rules for the time being, after we properly optimize this function we'll remove the noqa\n   478→    def run(  # noqa: C901, PLR0912 pylint: disable=too-many-branches\n   479→        self, data: Dict[str, Any], debug: bool = False\n   480→    ) -> Dict[str, Any]:\n   481→        # NOTE: We're assuming data is formatted like so as of now\n   482→        # data = {\n   483→        #     \"comp1\": {\"input1\": 1, \"input2\": 2},\n   484→        # }\n   485→        #\n   486→        # TODO: Support also this format:\n   487→        # data = {\n   488→        #     \"input1\": 1, \"input2\": 2,\n   489→        # }\n   490→\n   491→        # TODO: Remove this warmup once we can check reliably whether a component has been warmed up or not\n   492→        # As of now it's here to make sure we don't have failing tests that assume warm_up() is called in run()\n   493→        self.warm_up()\n   494→\n   495→        # Raise if input is malformed in some way\n   496→        self._validate_input(data)\n   497→\n   498→        # NOTE: The above NOTE and TODO are technically not true.\n   499→        # This implementation of run supports only the first format, but the second format is actually\n   500→        # never received by this method. It's handled by the `run()` method of the `Pipeline` class\n   501→        # defined in `haystack/pipeline.py`.\n   502→        # As of now we're ok with this, but we'll need to merge those two classes at some point.\n   503→        for component_name, component_inputs in data.items():\n   504→            if component_name not in self.graph.nodes:\n   505→                # This is not a component name, it must be the name of one or more input sockets.\n   506→                # Those are handled in a different way, so we skip them here.\n   507→                continue\n   508→            instance = self.graph.nodes[component_name][\"instance\"]\n   509→            for component_input, input_value in component_inputs.items():\n   510→                # Handle mutable input data\n   511→                data[component_name][component_input] = copy(input_value)\n   512→                if instance.__haystack_input__[component_input].is_variadic:\n   513→                    # Components that have variadic inputs need to receive lists as input.\n   514→                    # We don't want to force the user to always pass lists, so we convert single values to lists here.\n   515→                    # If it's already a list we assume the component takes a variadic input of lists, so we\n   516→                    # convert it in any case.\n   517→                    data[component_name][component_input] = [input_value]\n   518→\n   519→        last_inputs: Dict[str, Dict[str, Any]] = {**data}\n   520→\n   521→        # Take all components that have at least 1 input not connected or is variadic,\n   522→        # and all components that have no inputs at all\n   523→        to_run: List[Tuple[str, Component]] = []\n   524→        for node_name in self.graph.nodes:\n   525→            component = self.graph.nodes[node_name][\"instance\"]\n   526→\n   527→            if len(component.__haystack_input__) == 0:\n   528→                # Component has no input, can run right away\n   529→                to_run.append((node_name, component))\n   530→                continue\n   531→\n   532→            for socket in component.__haystack_input__.values():\n   533→                if not socket.senders or socket.is_variadic:\n   534→                    # Component has at least one input not connected or is variadic, can run right away.\n   535→                    to_run.append((node_name, component))\n   536→                    break\n   537→\n   538→        # These variables are used to detect when we're stuck in a loop.\n   539→        # Stuck loops can happen when one or more components are waiting for input but\n   540→        # no other component is going to run.\n   541→        # This can happen when a whole branch of the graph is skipped for example.\n   542→        # When we find that two consecutive iterations of the loop where the waiting_for_input list is the same,\n   543→        # we know we're stuck in a loop and we can't make any progress.\n   544→        before_last_waiting_for_input: Optional[Set[str]] = None\n   545→        last_waiting_for_input: Optional[Set[str]] = None\n   546→\n   547→        # The waiting_for_input list is used to keep track of components that are waiting for input.\n   548→        waiting_for_input: List[Tuple[str, Component]] = []\n   549→\n   550→        # This is what we'll return at the end\n   551→        final_outputs = {}\n   552→        while len(to_run) > 0:\n   553→            name, comp = to_run.pop(0)\n   554→\n   555→            if any(socket.is_variadic for socket in comp.__haystack_input__.values()) and not getattr(  # type: ignore\n   556→                comp, \"is_greedy\", False\n   557→            ):\n   558→                there_are_non_variadics = False\n   559→                for _, other_comp in to_run:\n   560→                    if not any(socket.is_variadic for socket in other_comp.__haystack_input__.values()):  # type: ignore\n   561→                        there_are_non_variadics = True\n   562→                        break\n   563→\n   564→                if there_are_non_variadics:\n   565→                    if (name, comp) not in waiting_for_input:\n   566→                        waiting_for_input.append((name, comp))\n   567→                    continue\n   568→\n   569→            if name in last_inputs and len(comp.__haystack_input__) == len(last_inputs[name]):  # type: ignore\n   570→                # This component has all the inputs it needs to run\n   571→                res = comp.run(**last_inputs[name])\n   572→\n   573→                if not isinstance(res, Mapping):\n   574→                    raise PipelineRuntimeError(\n   575→                        f\"Component '{name}' didn't return a dictionary. \"\n   576→                        \"Components must always return dictionaries: check the the documentation.\"\n   577→                    )\n   578→\n   579→                # Reset the waiting for input previous states, we managed to run a component\n   580→                before_last_waiting_for_input = None\n   581→                last_waiting_for_input = None\n   582→\n   583→                if (name, comp) in waiting_for_input:\n   584→                    # We manage to run this component that was in the waiting list, we can remove it.\n   585→                    # This happens when a component was put in the waiting list but we reached it from another edge.\n   586→                    waiting_for_input.remove((name, comp))\n   587→\n   588→                # We keep track of which keys to remove from res at the end of the loop.\n   589→                # This is done after the output has been distributed to the next components, so that\n   590→                # we're sure all components that need this output have received it.\n   591→                to_remove_from_res = set()\n   592→                for sender_component_name, receiver_component_name, edge_data in self.graph.edges(data=True):\n   593→                    if receiver_component_name == name and edge_data[\"to_socket\"].is_variadic:\n   594→                        # Delete variadic inputs that were already consumed\n   595→                        last_inputs[name][edge_data[\"to_socket\"].name] = []\n   596→\n   597→                    if name != sender_component_name:\n   598→                        continue\n   599→\n   600→                    if edge_data[\"from_socket\"].name not in res:\n   601→                        # This output has not been produced by the component, skip it\n   602→                        continue\n   603→\n   604→                    if receiver_component_name not in last_inputs:\n   605→                        last_inputs[receiver_component_name] = {}\n   606→                    to_remove_from_res.add(edge_data[\"from_socket\"].name)\n   607→                    value = res[edge_data[\"from_socket\"].name]\n   608→\n   609→                    if edge_data[\"to_socket\"].is_variadic:\n   610→                        if edge_data[\"to_socket\"].name not in last_inputs[receiver_component_name]:\n   611→                            last_inputs[receiver_component_name][edge_data[\"to_socket\"].name] = []\n   612→                        # Add to the list of variadic inputs\n   613→                        last_inputs[receiver_component_name][edge_data[\"to_socket\"].name].append(value)\n   614→                    else:\n   615→                        last_inputs[receiver_component_name][edge_data[\"to_socket\"].name] = value\n   616→\n   617→                    pair = (receiver_component_name, self.graph.nodes[receiver_component_name][\"instance\"])\n   618→                    if pair not in waiting_for_input and pair not in to_run:\n   619→                        to_run.append(pair)\n   620→\n   621→                res = {k: v for k, v in res.items() if k not in to_remove_from_res}\n   622→\n   623→                if len(res) > 0:\n   624→                    final_outputs[name] = res\n   625→            else:\n   626→                # This component doesn't have enough inputs so we can't run it yet\n   627→                if (name, comp) not in waiting_for_input:\n   628→                    waiting_for_input.append((name, comp))\n   629→\n   630→            if len(to_run) == 0 and len(waiting_for_input) > 0:\n   631→                # Check if we're stuck in a loop.\n   632→                # It's important to