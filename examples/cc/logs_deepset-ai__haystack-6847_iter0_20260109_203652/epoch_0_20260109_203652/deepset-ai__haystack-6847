:\n    41\u2192        \"\"\"\n    42\u2192        Creates the Pipeline.\n    43\u2192\n    44\u2192        Args:\n    45\u2192            metadata: arbitrary dictionary to store metadata about this pipeline. Make sure all the values contained in\n    46\u2192                this dictionary can be serialized and deserialized if you wish to save this pipeline to file with\n    47\u2192                `save_pipelines()/load_pipelines()`.\n    48\u2192            max_loops_allowed: how many times the pipeline can run the same node before throwing an exception.\n    49\u2192            debug_path: when debug is enabled in `run()`, where to save the debug data.\n    50\u2192        \"\"\"\n    51\u2192        self.metadata = metadata or {}\n    52\u2192        self.max_loops_allowed = max_loops_allowed\n    53\u2192        self.graph = networkx.MultiDiGraph()\n    54\u2192        self._debug: Dict[int, Dict[str, Any]] = {}\n    55\u2192        self._debug_path = Path(debug_path)\n    56\u2192\n    57\u2192    def __eq__(self, other) -> bool:\n    58\u2192        \"\"\"\n    59\u2192        Equal pipelines share every metadata, node and edge, but they're not required to use\n    60\u2192        the same node instances: this allows pipeline saved and then loaded back to be equal to themselves.\n    61\u2192        \"\"\"\n    62\u2192        if not isinstance(other, Pipeline):\n    63\u2192            return False\n    64\u2192        return self.to_dict() == other.to_dict()\n    65\u2192\n    66\u2192    def to_dict(self) -> Dict[str, Any]:\n    67\u2192        \"\"\"\n    68\u2192        Returns this Pipeline instance as a dictionary.\n    69\u2192        This is meant to be an intermediate representation but it can be also used to save a pipeline to file.\n    70\u2192        \"\"\"\n    71\u2192        components = {}\n    72\u2192        for name, instance in self.graph.nodes(data=\"instance\"):  # type:ignore\n    73\u2192            components[name] = component_to_d