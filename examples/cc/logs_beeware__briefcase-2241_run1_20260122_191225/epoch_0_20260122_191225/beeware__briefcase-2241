oding=\"UTF-8\",\n   586\u2192    )\n   587\u2192\n   588\u2192    # The new app packages have installation artefacts created\n   589\u2192    assert (app_packages_path / \"first\").exists()\n   590\u2192    assert (app_packages_path / \"first/__main__.py\").exists()\n   591\u2192    assert (app_packages_path / \"second\").exists()\n   592\u2192    assert (app_packages_path / \"second/__main__.py\").exists()\n   593\u2192    assert (app_packages_path / \"third\").exists()\n   594\u2192    assert (app_packages_path / \"third/__main__.py\").exists()\n   595\u2192\n   596\u2192    # The old app packages no longer exist.\n   597\u2192    assert not (app_packages_path / \"old\").exists()\n   598\u2192    assert not (app_packages_path / \"ancient\").exists()\n   599\u2192\n   600\u2192    # Original app definitions haven't changed\n   601\u2192    assert myapp.requires == [\"first\", \"second\", \"third\"]\n   602\u2192    assert myapp.test_requires is None\n   603\u2192\n   604\u2192\n   605\u2192def test_app_requirements_no_requires(\n   606\u2192    create_command,\n   607\u2192    myapp,\n   608\u2192    app_requirements_path,\n   609\u2192    app_requirements_path_index,\n   610\u2192    mock_now,\n   611\u2192):\n   612\u2192    \"\"\"If an app has no requirements, a requirements file is still written.\"\"\"\n   613\u2192    myapp.requires = None\n   614\u2192\n   615\u2192    # Install requirements into the bundle\n   616\u2192    create_command.install_app_requirements(myapp, test_mode=False)\n   617\u2192\n   618\u2192    # requirements.txt doesn't exist either\n   619\u2192    assert app_requirements_path.exists()\n   620\u2192    with app_requirements_path.open(encoding=\"utf-8\") as f:\n   621\u2192        assert f.read() == f\"{GENERATED_DATETIME}\\n\"\n   622\u2192\n   623\u2192    # Original app definitions haven't changed\n   624\u2192    assert myapp.requires is None\n   625\u2192    assert myapp.test_requires is None\n   626\u2192\n   627\u2192\n   628\u