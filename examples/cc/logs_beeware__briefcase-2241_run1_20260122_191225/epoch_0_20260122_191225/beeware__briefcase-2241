n   859\u2192            self.console.warning(\n   860\u2192                \"Splash screens are now configured based on the icon. \"\n   861\u2192                \"The splash configuration will be ignored.\"\n   862\u2192            )\n   863\u2192\n   864\u2192        for extension, doctype in self.document_type_icon_targets(app).items():\n   865\u2192            self.console.info()\n   866\u2192            for size, target in doctype.items():\n   867\u2192                self.install_image(\n   868\u2192                    f\"icon for .{extension} documents\",\n   869\u2192                    size=size,\n   870\u2192                    source=app.document_types[extension][\"icon\"],\n   871\u2192                    variant=None,\n   872\u2192                    target=self.bundle_path(app) / target,\n   873\u2192                )\n   874\u2192\n   875\u2192    def cleanup_app_content(self, app: AppConfig):\n   876\u2192        \"\"\"Remove any content not needed by the final app bundle.\n   877\u2192\n   878\u2192        :param app: The config object for the app\n   879\u2192        \"\"\"\n   880\u2192        try:\n   881\u2192            # Retrieve any cleanup paths defined by the app template\n   882\u2192            paths_to_remove = self.cleanup_paths(app)\n   883\u2192        except KeyError:\n   884\u2192            paths_to_remove = []\n   885\u2192\n   886\u2192        try:\n   887\u2192            # Add any user-specified paths, expanded using the app as template context.\n   888\u2192            paths_to_remove.extend([glob.format(app=app) for glob in app.cleanup_paths])\n   889\u2192        except AttributeError:\n   890\u2192            pass\n   891\u2192\n   892\u2192        # Remove __pycache__ folders. These folders might contain stale PYC\n   893\u2192        # artefacts, or encode file paths that reflect the original source\n   894\u2192        # location. The stub binaries all disable PYC generation, to avoid\n   895\u2192        # corrupting any app bundle signatures.\n   896\u2192        paths_to_remove.append(\"**/__pycache__\")\n   897\u2192\n   898\u2192        with self.console.wait_bar(\"Removing unneeded app bundle content...\"):\n   899\u2192            for glob in paths_to_remove:\n   900\u2192                # Expand each glob into a full list of files that actually exist\n   901\u2192                # on the file system.\n   902\u2192                for path in self.bundle_path(app).glob(glob):\n   903\u2192                    relative_path = path.relative_to(self.bundle_path(app))\n   904\u2192                    if path.is_dir() and not path.is_symlink():\n   905\u2192                        self.console.verbose(f\"Removing directory {relative_path}\")\n   906\u2192                        self.tools.shutil.rmtree(path)\n   907\u2192                    else:\n   908\u2192                        self.console.verbose(f\"Removing {relative_path}\")\n   909\u2192                        path.unlink()\n   910\u2192\n   911\u2192    def create_app(self, app: AppConfig, test_mode: bool = False, **options):\n   912\u2192        \"\"\"Create an application bundle.\n   913\u2192\n   914\u2192        :param app: The config object for the app\n   915\u2192        :param test_mode: Should the app be updated in test mode? (default: False)\n   916\u2192        \"\"\"\n   917\u2192        if not app.supported:\n   918\u2192            raise UnsupportedPlatform(self.platform)\n   919\u2192\n   920\u2192        bundle_path = self.bundle_path(app)\n   921\u2192        if bundle_path.exists():\n   922\u2192            self.console.info()\n   923\u2192            confirm = self.console.input_boolean(\n   924\u2192                f\"Application {app.app_name!r} already exists; overwrite\", default=False\n   925\u2192            )\n   926\u2192            if not confirm:\n   927\u2192                self.console.error(\n   928\u2192                    f\"Aborting creation of app {app.app_name!r}; existing applicatio