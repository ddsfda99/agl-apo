t_mode=test_mode,\n   452\u2192                clean_filter=macOS_log_clean_filter,\n   453\u2192                clean_output=True,\n   454\u2192                stop_func=lambda: is_process_dead(app_pid),\n   455\u2192                log_stream=True,\n   456\u2192            )\n   457\u2192        except subprocess.CalledProcessError:\n   458\u2192            raise BriefcaseCommandError(f\"Unable to start app {app.app_name}.\")\n   459\u2192        finally:\n   460\u2192            # Ensure the App also terminates when exiting\n   461\u2192            if app_pid:  # pragma: no-cover-if-is-py310\n   462\u2192                with suppress(ProcessLookupError):\n   463\u2192                    self.tools.os.kill(app_pid, SIGTERM)\n   464\u2192\n   465\u2192\n   466\u2192def is_mach_o_binary(path):  # pragma: no-cover-if-is-windows\n   467\u2192    \"\"\"Determine if the file at the given path is a Mach-O binary.\n   468\u2192\n   469\u2192    :param path: The path to check\n   470\u2192    :returns: True if the file at the given location is a Mach-O binary.\n   471\u2192    \"\"\"\n   472\u2192    # A binary is any file that is executable, or has a suffix from a known list\n   473\u2192    if os.access(path, os.X_OK) or path.suffix.lower() in {\".dylib\", \".o\", \".so\", \"\"}:\n   474\u2192        # File is a binary; read the file magic to determine if it's Mach-O.\n   475\u2192        with path.open(\"rb\") as f:\n   476\u2192            magic = f.read(4)\n   477\u2192            return magic in (\n   478\u2192                b\"\\xca\\xfe\\xba\\xbe\",\n   479\u2192                b\"\\xcf\\xfa\\xed\\xfe\",\n   480\u2192                b\"\\xce\\xfa\\xed\\xfe\",\n   481\u2192                b\"\\xbe\\xba\\xfe\\xca\",\n   482\u2192                b\"\\xfe\\xed\\xfa\\xcf\",\n   483\u2192                b\"\\xfe\\xed\\xfa\\xce\",\n   484\u2192            )\n   485\u2192    else:\n   486\u2192        # Not a binary\n   487\u2192        return False\n   488\u2192\n   489\u2192\n   490\u2192class macOSSigningMixin:\n   491\u2192    def __init__(self, *args, **kwargs):\n   492\u2192        super().__init__(*args, **kwargs)\n   493\u2192\n   494\u2192        # External service APIs.\n   495\u2192        # These are abstracted to enable testing without patching.\n   496\u2192        self.get_identities = get_identities\n   497\u2192\n   498\u2192    def entitlements_path(self, app: AppConfig):  # pragma: no-cover-if-is-windows\n   499\u2192        return self.bundle_path(app) / self.path_index(app, \"entitlements_path\")\n   500\u2192\n   501\u2192    def select_identity(\n   502\u2192        self,\n   503\u2192        identity: str | None = None,\n   504\u2192        app_identity: SigningIdentity | None = None,\n   505\u2192        allow_adhoc: bool = True,\n   506\u2192    ) -> SigningIdentity:\n   507\u2192        \"\"\"Get the codesigning identity to use.\n   508\u2192\n   509\u2192        This can be either an application codesigning identity, or an installer\n   510\u2192        identity. An installer identity must be from the same Team ID as the application\n   511\u2192        identity.\n   512\u2192\n   513\u2192        :param identity: A pre-specified identity (either the 40-digit hex checksum, or\n   514\u2192            the string name of the identity). If provided, it will be validated against\n   515\u2192            the list of available identities to confirm that it is a valid codesigning\n   516\u2192            identity.\n   517\u2192        :param app_identity: The application signing identity to match when producing an\n   518\u2192            installer identity. Only non-app signing identities that match the team ID\n   519\u2192            for the ``app_identity`` will be presented as options. Omit this value to\n   520\u2192            select an app signing identity.\n   521\u2192        :param allow_adhoc: Should the adhoc identities be allowed?\n   522\u2192        :returns: The final identity to use\n   523\u2192        \"\"\"\n   524\u2192        # If the adhoc identity is allowed, add it first so it appears first in the list\n   525\u2192        # of options.\n   526\u2192        identities = {}\n   527\u2192        if allow_adhoc:\n   528\u2192            identities[\"-\"] = ADHOC_IDENTITY_NAME\n   529\u2192\n   530\u2192        # Obtain the valid codesigning identities. These are the identities that could\n   531\u2192        # be used for app signing.\n   532\u2192        identities.update(self.get_identities(self.tools, \"codesigning\"))\n   533\u2192\n   534\u2192        if app_identity:\n   535\u2192            ident_type = \"installer\"\n   536\u2192            ident_option = \"--installer-identity\"\n   537\u2192            # There's no way to explicitly request a list of installer identities. As a\n   538\u2192            # workaround, get the full, unfiltered list of all signing identities; then\n   539\u2192            # remove any identity that:\n   540\u2192            # 1. From a different team to the provided app identity; or\n   541\u2192            # 2. Appears on the list of app signing identities.\n   542\u2192            app_identities = identities\n   543\u2192            identities = {\n   544\u2192                key: name\n   545\u2192                for key, name in self.get_identities(self.tools).items()\n   546\u2192                if SigningIdentity.team_id_from_name(name) == app_identity.team_id\n   547\u2192                and key not in app_identities\n   548\u2192            }\n   549\u2192\n   550\u2192            if not identities:\n   551\u2192                raise BriefcaseCommandError(\n   552\u2192                    f\"No installer signing identities for team {app_identity.team_id} could be found.\"\n   553\u2192                )\n   554\u2192        else:\n   555\u2192            ident_type = \"application\"\n   556\u2192            ident_option = \"--identity\"\n   557\u2192\n   558\u2192        if identity:\n   559\u2192            try:\n   560\u2192                # Try to look up the identity as a hex checksum\n   561\u2192                identity_name = identities[identity]\n   562\u2192                return SigningIdentity(id=identity, name=identity_name)\n   563\u2192            except KeyError as e:\n   564\u2192                # Try to look up the identity as readable name\n   565\u2192                try:\n   566\u2192                    reverse_lookup = {name: ident for ident, name in identities.items()}\n   567\u2192                    identity_id = reverse_lookup[identity]\n   568\u2192                    return SigningIdentity(id=identity_id, name=identity)\n   569\u2192                except KeyError:\n   570\u2192                    # Not found as an ID or name\n   571\u2192                    raise BriefcaseCommandError(\n   572\u2192                        f\"Invalid {ident_type} signing identity {identity}\"\n   573\u2192                    ) from e\n   574\u2192\n   575\u2192        identity = self.console.selection_question(\n   576\u2192            intro=f\"Select {ident_type} signing identity to use:\",\n   577\u2192            description=f\"{ident_type.title()} Signing Identity\",\n   578\u2192            options=identities,\n   579\u2192        )\n   580\u2192        identity_name = identities[identity]\n   581\u2192        if identity == \"-\":\n   582\u2192            self.console.info(\n   583\u2192                f\"\"\"\n   584\u2192In future, you could specify this signing identity by using:\n   585\u2192\n   586\u2192    $ briefcase {self.command} macOS {self.output_format} --adhoc-sign ...\n   587\u2192\n   588\u2192\"\"\"\n   589\u2192            )\n   590\u2192        else:\n   591\u2192            self.console.info(\n   592\u2192                f\"\"\"\n   593\u2192In future, you could specify this signing identity by using:\n   594\u2192\n   595\u2192    $ briefcase {self.command} macOS {self.output_format} {ident_option} {identity} ...\n   596\u2192\n   597\u2192or\n   598\u2192\n   599\u2192    $ briefcase {self.command} macOS {self.output_format} {ident_option} \"{identity_name}\" ...\n   600\u2192\n   601\u2192\"\"\"\n   602\u2192            )\n   603\u2192\n   604\u2192        return SigningIdentity(id=identity, name=identity_name)\n   605\u2192\n   606\u2192    def sign_file(\n   607\u2192        self,\n   608\u2192        path: Path,\n   609\u2192        identity: SigningIdentity,\n   610\u2192        entitlements: Path | None = None,\n   611\u2192    ):\n   612\u2192        \"\"\"Code sign a file.\n   613\u2192\n   614\u2192        :param path: The path to the file to sign.\n   615\u2192        :param identity: The code signing identity to use.\n   616\u2192        :param entitlements: The path to the entitlements file to use.\n   617\u2192        \"\"\"\n   618\u2192        options = \"runtime\" if not identity.is_adhoc else None\n   619\u2192        process_command = [\"codesign\", path, \"--sign\", identity.id, \"--force\"]\n   620\u2192\n   621\u2192        if entitlements:\n   622\u2192            process_command.append(\"--entitlements\")\n   623\u2192            process_command.append(entitlements)\n   624\u2192        if options:\n   625\u2192            process_command.append(\"--options\")\n   626\u2192            process_command.append(options)\n   627\u2192\n   628\u2192        self.console.verbose(f\"Signing {Path(path).relative_to(self.base_path)}\")\n   629\u2192\n   630\u2192        try:\n   631\u2192            self.tools.subprocess.run(\n   632\u2192                process_command,\n   633\u2192                stderr=subprocess.PIPE,\n   634\u2192                check=True,\n   635\u2192            )\n   636\u2192        except subprocess.CalledProcessError as e:\n   637\u2192            errors = e.stderr\n   638\u2192            if any(\n   639\u2192                msg in errors\n   640\u2192                for msg in [\n   641\u2192                    # File has a signature matching the Mach-O magic,\n   642\u2192                    # but isn't actually a Mach-O binary\n   643\u2192                    \"unsupported format for signature\",\n   644\u2192                    # A folder named ``.framework`, but not actually a macOS Framework`\n   645\u2192                    \"bundle format unrecognized, invalid, or unsuitable\",\n   646\u2192                ]\n   647\u2192            ):\n   648\u2192                # We should not be signing this in the first place\n   649\u2192                self.console.verbose(\n   650\u2192                    f\"... {Path(path).relative_to(self.base_path)} does not require a signature\"\n   651\u2192                )\n   652\u2192                return\n   653\u2192            else:\n   654\u2192                raise BriefcaseCommandError(f\"Unable to code sign {path}.\")\n   655\u2192\n   656\u2192    def sign_app(\n   657\u2192        self,\n   658\u2192        app: AppConfig,\n   659\u2192        identity: SigningIdentity,\n   660\u2192    ):  # pragma: no-cover-if-is-windows\n   661\u2192        \"\"\"Sign an entire app with a specific identity.\n   662\u2192\n   663\u2192        :param app: The app to sign\n   664\u2192        :param identity: The signing identity to use\n   665\u2192        \"\"\"\n   666\u2192        bundle_path = self.binary_path(app)\n   667\u2192        resources_path = bundle_path / \"Contents/Resources\"\n   668\u2192        frameworks_path = bundle_path / \"Contents/Frameworks\"\n   669\u2192\n   670\u2192        sign_targets = []\n   671\u2192\n   672\u2192        for folder in (resources_path, frameworks_path):\n   673\u2192            # Sign all Mach-O executable objects\n   674\u2192            sign_targets.extend(\n   675\u2192                path\n   676\u2192                for path in folder.rglob(\"*\")\n   677\u2192                if not path.is_dir()\n   678\u2192                and not path.is_symlink()\n   679\u2192                and is_mach_o_binary(path)\n   680\u2192            )\n   681\u2192\n   682\u2192            # Sign all embedded frameworks\n   683\u2192            sign_targets.extend(folder.rglob(\"*.framework\"))\n   684\u2192\n   685\u2192            # Sign all embedded app objects\n   686\u2192            sign_targets.extend(folder.rglob(\"*.app\"))\n   687\u2192\n   688\u2192        # Sign the bundle path itself\n   689\u2192        sign_targets.append(bundle_path)\n   690\u2192\n   691\u2192        # Run signing through a ThreadPoolExecutor so that they run in parallel. We need\n   692\u2192        # to ensure that objects are signed from the inside out (i.e., a folder must be\n   693\u2192        # signed *after* all it's contents has been signed; files in a folder must be\n   694\u2192        # signed *after* all subfolders in that same folder); and an app that uses a\n   695\u2192        # library must be signed *after* all the libraries it uses. See\n   696\u2192        # https://developer.apple.com/documentation/xcode/creating-distribution-signed-code-for-the-mac#Determine-the-signing-order\n   697\u2192        # for details.\n   698\u2192        #\n   699\u2192        # To do this, we utilize grouping on a sorted list, and rely on the fact that a\n   700\u2192        # new group is created whenever the grouping key changes. The sorting process\n   701\u2192        # guarantees depth-first ordering; the grouping is applied over the sorted\n   702\u2192        # content, ensuring that that folders are signed before files.\n   703\u2192        #\n   704\u2192        # This approach isn't perfect. It will fail if there's an embedded app that uses\n   705\u2192        # a library in a different framework, and the app is lexically sorted before the\n   706\u2192        # library (e.g. if app_packages/foobar/Alpha.framework/Helpers/My App.app\n   707\u2192        # depends on app_packages/footbar/Beta.framework/libbeta). However, if you're\n   708\u2192        # embedding apps in frameworks in Python libraries that are installed by pip,\n   709\u2192        # you're already making poor life choices; this approach is enough to satisfy\n   710\u2192        # the one use of app-in-framework embedding that we're aware of (PySide).\n   711\u2192        progress_bar = self.console.progress_bar()\n   712\u2192        task_id = progress_bar.add_task(\"Signing App\", total=len(sign_targets))\n   713\u2192        with progress_bar:\n   714\u2192            for group in self.tools.file.sorted_depth_first_groups(sign_targets):\n   715\u2192                with concurrent.futures.ThreadPoolExecutor(\n   716\u2192                    max_workers=1 if self.console.is_deep_debug else None\n   717\u2192                ) as executor:\n   718\u2192                    futures = []\n   719\u2192                    for path in group:\n   720\u2192                        future = executor.submit(\n   721\u2192                            self.sign_file,\n   722\u2192                            path,\n   723\u2192                            entitlements=self.entitlements_path(app),\n   724\u2192                            identity=identity,\n   725\u2192                        )\n   726\u2192                        futures.append(future)\n   727\u2192                    for future in concurrent.futures.as_completed(futures):\n   728\u2192                        progress_bar.update(task_id, advance=1)\n   729\u2192                        if future.exception():\n   730\u2192                            raise future.exception()\n   731\u2192\n   732\u2192\n   733\u2192class macOSPackageMixin(macOSSigningMixin):\n   734\u2192    ADHOC_SIGN_HELP = (\n   735\u2192        \"Perform ad-hoc signing on the app. \"\n   736\u2192        \"The app will only run on this machine; it cannot be redistributed to others\"\n   737\u2192    )\n   738\u2192    IDENTITY_HELP = (\n   739\u2192        \"The code signing identity to use; either the 40-digit hex \"\n   740\u2192        \"checksum, or the full name of the identity\"\n   741\u2192    )\n   742\u2192\n   743\u2192    @property\n   744\u2192    def packaging_formats(self):\n   745\u2192        return [\"zip\", \"dmg\", \"pkg\"]\n   746\u2192\n   747\u2192    @property\n   748\u2192    def default_packaging_format(self):\n   749\u2192        # The default changes depending on whether the app is a console app or a GUI app\n   750\u2192        return None\n   751\u2192\n   752\u2192    def notarization_path(self, app: AppConfig) -> Path:\n   753\u2192        \"\"\"The file that is submitted for notarization.\"\"\"\n   754\u2192        if app.packaging_format == \"zip\":\n   755\u2192            # Notarization for bare .app's is applied to the binary, not the\n   756\u2192            # distribution artefact, with the distribution artefact being\n   757\u2192            # created after notarization has completed.\n   758\u2192            return self.binary_path(app)\n   759\u2192        else:\n   760\u2192            return self.distribution_path(app)\n   761\u2192\n   762\u2192    def distribution_path(self, app: AppConfig) -> Path:\n   763\u2192        \"\"\"The path to the final distribution artefact.\"\"\"\n   764\u2192        if app.packaging_format == \"zip\":\n   765\u2192            return self.dist_path / f\"{app.formal_name}-{app.version}.app.zip\"\n   766\u2192        elif app.packaging_format == \"pkg\":\n   767\u2192            return self.dist_path / f\"{app.formal_name}-{app.version}.pkg\"\n   768\u2192        else:\n   769\u2192            return self.dist_path / f\"{app.formal_name}-{app.version}.dmg\"\n   770\u2192\n   771\u2192    def add_options(self, parser):\n   772\u2192        super().add_options(parser)\n   773\u2192\n   774\u2192        # --no-sign-installer and --installer-identity are mutually exclusive\n   775\u2192        installer_signing_group = parser.add_mutually_exclusive_group()\n   776\u2192        installer_signing_group.add_argument(\n   777\u2192            \"--no-sign-installer\",\n   778\u2192            dest=\"sign_installer\",\n   779\u2192            help=\"Do not sign the installer. Ignored unless using PKG format\",\n   780\u2192            action=\"store_false\",\n   781\u2192        )\n   782\u2192        installer_signing_group.add_argument(\n   783\u2192            \"--installer-identity\",\n   784\u2192            dest=\"installer_identity\",\n   785\u2192            help=(\n   786\u2192                \"The code signing identity to use for signing the installer. \"\n   787\u2192                \"Ignored unless using PKG format\"\n   788\u2192            ),\n   789\u2192            required=False,\n   790\u2192        )\n   791\u2192\n   792\u2192        # We use store_const:False rather than store_false so that the\n   793\u2192        # \"unspecified\" value is None, rather than True, allowing for\n   794\u2192        # a \"default behavior\" interpretation when `--adhoc-sign` is specified\n   795\u2192        parser.add_argument(\n   796\u2192            \"--no-notarize\",\n   797\u2192            dest=\"notarize_app\",\n   798\u2192            action=\"store_const\",\n   799\u2192            const=False,\n   800\u2192            help=\"Disable notarization for the app\",\n   801\u2192        )\n   802\u2192        parser.add_argument(\n   803\u2192            \"--resume\",\n   804\u2192            dest=\"submission_id\",\n   805\u2192            help=\"The notarization submission ID to resume\",\n   806\u2192            required=False,\n   807\u2192        )\n   808\u2192\n   809\u2192    def verify_tools(self):\n   810\u2192        # Require the Xcode command line tools.\n   811\u2192        XcodeCliTools.verify(tools=self.tools)\n   812\u2192\n   813\u2192        # Verify superclass tools *after* xcode. This ensures we get the\n   814\u2192        # git check *after* the xcode check.\n   815\u2192        super().verify_tools()\n   816\u2192\n   817\u2192    def __init__(self, *args, **kwargs):\n   818\u2192        super().__init__(*args, **kwargs)\n   819\u2192\n   820\u2192        # External service APIs.\n   821\u2192        # These are abstracted to enable testing without patching.\n   822\u2192        self.dmgbuild = dmgbuild\n   823\u2192\n   824\u2192    def verify_app(self, app):\n   825\u2192        super().verify_app(app)\n   826\u2192\n   827\u2192        if app.console_app:\n   828\u2192            if app.packaging_format is None:\n   829\u2192                app.packaging_format = \"pkg\"\n   830\u2192            elif app.packaging_format != \"pkg\":\n   831\u2192                raise BriefcaseCommandError(\n   832\u2192                    \"macOS console apps must be distributed in PKG format.\"\n   833\u2192                )\n   834\u2192        elif app.packaging_format is None:\n   835\u2192            app.packaging_format = \"dmg\"\n   836\u2192\n   837\u2192    def clean_dist_folder(self, app, **options):\n   838\u2192        \"\"\"Clean up any existing artefacts in the dist folder.\n   839\u2192\n   840\u2192        If we are resuming a notarization session verify that the artefact exists,\n   841\u2192        but *do not* delete it.\n   842\u2192\n   843\u2192        :param app: The app being packaged.\n   844\u2192        :param submission_id: The notarization submission being resumed.\n   845\u2192        :param options: Any additional arguments passed to the package command.\n   846\u2192        \"\"\"\n   847\u2192        if options.get(\"submission_id\"):\n   848\u2192            if not self.notarization_path(app).exists():\n   849\u2192                raise BriefcaseCommandError(\n   850\u2192                    \"Notarization cannot be resumed, as the notarization artefact \"\n   851\u2192                    \"associated with this app \"\n   852\u2192                    f\"({self.notarization_path(app).relative_to(self.base_path)}) \"\n   853\u2192                    \"does not exist.\"\n   854\u2192                )\n   855\u2192\n   856\u2192            # If the packaging format is zip, the distribution artefact is created\n   857\u2192            # *after* completion of notarization. If there's an existing distribution\n   858\u2192            # artefact, it must be from a previous notarization/stapling attempt.\n   859\u2192            if app.packaging_format == \"zip\":\n   860\u2192                super().clean_dist_folder(app, **options)\n   861\u2192        else:\n   862\u2192            super().clean_dist_folder(app, **options)\n   863\u2192\n   864\u2192    def ditto_archive(\n   865\u2192        self,\n   866\u2192        app_filename: Path,\n   867\u2192        archive_filename: Path,\n   868\u2192    ):  # pragma: no-cover-if-not-macos\n   869\u2192        \"\"\"Create an archive of an app using ditto.\n   870\u2192\n   871\u2192        Although the archive format is \".zip\", we can't use standard Zip tools, as they\n   872\u2192        don't preserve UTF-8 encoding on all resources. Instead, we need to use `ditto`,\n   873\u2192        which is provided as part of macOS developer tooling. See\n   874\u2192        https://forums.developer.apple.com/forums/thread/116831 and\n   875\u2192        https://developer.apple.com/library/archive/technotes/tn2206/_index.html for\n   876\u2192        more details.\n   877\u2192\n   878\u2192        :param app_filename: The filename of the app to archive\n   879\u2192        :param archive_filename: The filename of the archive to produce\n   880\u2192        \"\"\"\n   881\u2192        try:\n   882\u2192            self.tools.subprocess.run(\n   883\u2192                [\n   884\u2192                    \"/usr/bin/ditto\",\n   885\u2192                    \"-c\",\n   886\u2192                    \"-k\",\n   887\u2192                    \"--sequesterRsrc\",\n   888\u2192                    \"--keepParent\",\n   889\u2192                    app_filename,\n   890\u2192                    archive_filename,\n   891\u2192                ],\n   892\u2192                check=True,\n   893\u2192            )\n   894\u2192        except subprocess.CalledProcessError as e:\n   895\u2192            raise BriefcaseCommandError(f\"Unable to archive {app_filename.name}\") from e\n   896\u2192\n   897\u2192    def notarize(\n   898\u2192        self,\n   899\u2192        app: AppConfig,\n   900\u2192        identity: SigningIdentity,\n   901\u2192        installer_identity: SigningIdentity | None = None,\n   902\u2192    ):\n   903\u2192        \"\"\"Submit a file for notarization, and wait for that notarization to be completed.\n   904\u2192\n   905\u2192        :param app: The app to notarize.\n   906\u2192        :param identity: The code signing used to notarize the app.\n   907\u2192        :param installer_identity: The signing identity to use when signing the\n   908\u2192            installer. Optional unless the packaging format is ``pkg``.\n   909\u2192        \"\"\"\n   910\u2192        # Determine the arguments that would be needed to reproduce this notarization\n   911\u2192        if installer_identity:\n   912\u2192            identity_args = (\n   913\u2192                f\"--identity {identity.id} \"\n   914\u2192                f\"--installer-identity {installer_identity.id}\"\n   915\u2192            )\n   916\u2192            notarization_identity = installer_identity\n   917\u2192        else:\n   918\u2192            identity_args = f\"--identity {identity.id}\"\n   919\u2192            notarization_identity = identity\n   920\u2192\n   921\u2192        format_args = f\"-p {app.packaging_format}\"\n   922\u2192\n   923\u2192        # Submit the app for notarization\n   924\u2192        submission_id = self.submit_notarization(app, identity=notarization_identity)\n   925\u2192\n   926\u2192        self.console.warning(\n   927\u2192            f\"\"\"\n   928\u2192Briefcase will now wait for Apple to approve the notarization request.\n   929\u2192This can take some time - in some cases, hours.\n   930\u2192\n   931\u2192If notarization is interrupted, you can resume by running:\n   932\u2192\n   933\u2192    briefcase package macOS {self.output_format} {format_args} {identity_args} --resume {submission_id}\n   934\u2192\n   935\u2192\"\"\"\n   936\u2192        )\n   937\u2192\n   938\u2192        self.finalize_notarization(\n   939\u2192            app,\n   940\u2192            identity=notarization_identity,\n   941\u2192            submission_id=submission_id,\n   942\u2192        )\n   943\u2192\n   944\u2192    def submit_notarization(self, app, identity: SigningIdentity) -> str:\n   945\u2192        \"\"\"Submit a file for notarization, returning the ID of the notarizatzion task.\n   946\u2192\n   947\u2192        If the file is a .app, it will be archived as a .zip for submission purposes.\n   948\u2192\n   949\u2192        :param app: The app to notarize.\n   950\u2192        :param identity: The code signing identity to use.\n   951\u2192        :returns: The ID of the notarization task.\n   952\u2192        \"\"\"\n   953\u2192        filename = self.notarization_path(app)\n   954\u2192        try:\n   955\u2192            if app.packaging_format == \"zip\":\n   956\u2192                self.console.info()\n   957\u2192                with self.console.wait_bar(\n   958\u2192                    f\"Archiving {filename.name} for notarization...\"\n   959\u2192                ):\n   960\u2192                    archive_filename = filename.parent / (filename.name + \".zip\")\n   961\u2192                    self.ditto_archive(filename, archive_filename)\n   962\u2192            else:\n   963\u2192                archive_filename = filename\n   964\u2192\n   965\u2192            submission_id = None\n   966\u2192            store_credentials = False\n   967\u2192            while not submission_id:\n   968\u2192                if store_credentials:\n   969\u2192                    if not self.console.input_enabled:\n   970\u2192                        raise BriefcaseCommandError(\n   971\u2192                            f\"\"\"\n   972\u2192The keychain does not contain credentials for the profile {identity.profile}.\n   973\u2192You can store these credentials by invoking:\n   974\u2192\n   975\u2192    $ xcrun notarytool store-credentials --team-id {identity.team_id} {identity.profile}\n   976\u2192\n   977\u2192\"\"\"\n   978\u2192                        )\n   979\u2192\n   980\u2192                    self.console.warning(\n   981\u2192                        \"\"\"\n   982\u2192The notarization process uses credentials stored on your system Keychain.\n   983\u2192You need to do this once for each signing certificate you use.\n   984\u2192\n   985\u2192The credentials are authenticated and stored using your Apple ID, using\n   986\u2192an app-specific Apple ID password. To generate an app-specific Apple ID\n   987\u2192password:\n   988\u2192\n   989\u2192  1. Sign into https://appleid.apple.com;\n   990\u2192  2. In the 'Sign-in and Security' section, click 'App-Specific Passwords';\n   991\u2192  3. Click on the '+' icon. You will need to provide an identifying name\n   992\u2192     for the password. You can pick any name that makes sense to you - the\n   993\u2192     name is only there so you can identify passwords. 'Briefcase' would be\n   994\u2192     one possible name.\n   995\u2192  4. Record the password somewhere safe.\n   996\u2192\"\"\"\n   997\u2192                    )\n   998\u2192                    try:\n   999\u2192                        self.tools.subprocess.run(\n  1000\u2192                            [\n  1001\u2192                                \"xcrun\",\n  1002\u2192                                \"notarytool\",\n  1003\u2192                                \"store-credentials\",\n  1004\u2192                                \"--team-id\",\n  1005\u2192                                identity.team_id,\n  1006\u2192                                identity.profile,\n  1007\u2192                            ],\n  1008\u2192                            check=True,\n  1009\u2192                            stream_output=False,  # Command reads from stdin.\n  1010\u2192                        )\n  1011\u2192                    except subprocess.CalledProcessError as e:\n  1012\u2192                        raise BriefcaseCommandError(\n  1013\u2192                            f\"Unable to store credentials for team ID {identity.team_id}.\"\n  1014\u2192                        ) from e\n  1015\u2192\n  1016\u2192                # Attempt the notarization\n  1017\u2192                try:\n  1018\u2192                    self.console.info()\n  1019\u2192                    with self.console.wait_bar(\"Submitting app for notarization...\"):\n  1020\u2192                        submission = self.tools.subprocess.parse_output(\n  1021\u2192                            json_parser,\n  1022\u2192                            [\n  1023\u2192                                \"xcrun\",\n  1024\u2192                                \"notarytool\",\n  1025\u2192                                \"submit\",\n  1026\u2192                                archive_filename,\n  1027\u2192                                \"--keychain-profile\",\n  1028\u2192                                identity.profile,\n  1029\u2192                                \"--output-format\",\n  1030\u2192                                \"json\",\n  1031\u2192                            ],\n  1032\u2192                            quiet=1,\n  1033\u2192                        )\n  1034\u2192                        submission_id = submission[\"id\"]\n  1035\u2192                except subprocess.CalledProcessError as e:\n  1036\u2192                    # Error when submitting for notarization.\n  1037\u2192                    # A return code of 69 (nice) indicates an issue with the\n  1038\u2192                    # keychain profile. If store_credentials is already True,\n  1039\u2192                    # then we've already tried to store them, so call the attempt\n  1040\u2192                    # a fail\n  1041\u2192                    if e.returncode == 69 and not store_credentials:\n  1042\u2192                        store_credentials = True\n  1043\u2192                    else:\n  1044\u2192                        self.tools.subprocess.output_error(e)\n  1045\u2192                        raise BriefcaseCommandError(\n  1046\u2192                            f\"Unable to submit {filename.relative_to(self.base_path)} for notarization.\"\n  1047\u2192                        ) from e\n  1048\u2192        finally:\n  1049\u2192            # If we're using .zip packaging, the archive is temporary and isn't used for\n  1050\u2192            # distribution, so we can clean up.\n  1051\u2192            if archive_filename != filename:\n  1052\u2192                self.tools.os.unlink(archive_filename)\n  1053\u2192\n  1054\u2192        return submission_id\n  1055\u2192\n  1056\u2192    def validate_submission_id(\n  1057\u2192        self,\n  1058\u2192        app: AppConfig,\n  1059\u2192        identity: SigningIdentity,\n  1060\u2192        submission_id: str,\n  1061\u2192    ):\n  1062\u2192        with self.console.wait_bar(\"Determining validity of submission ID...\"):\n  1063\u2192            try:\n  1064\u2192                response = self.tools.subprocess.parse_output(\n  1065\u2192                    json_parser,\n  1066\u2192                    [\n  1067\u2192                        \"xcrun\",\n  1068\u2192                        \"notarytool\",\n  1069\u2192                        \"history\",\n  1070\u2192                        \"--keychain-profile\",\n  1071\u2192                        identity.profile,\n  1072\u2192                        \"--output-format\",\n  1073\u2192                        \"json\",\n  1074\u2192                    ],\n  1075\u2192                )\n  1076\u2192\n  1077\u2192                id_matches = [\n  1078\u2192                    submission\n  1079\u2192                    for submission in response[\"history\"]\n  1080\u2192                    if submission[\"id\"] == submission_id\n  1081\u2192                ]\n  1082\u2192\n  1083\u2192                expected_filename = id_matches[0][\"name\"]\n  1084\u2192                # .app files are zipped for notarization, but the app itself is\n  1085\u2192                # notarized; strip the .zip suffix for filename matching purposes.\n  1086\u2192                if expected_filename.endswith(\".zip\"):\n  1087\u2192                    expected_filename = expected_filename[:-4]\n  1088\u2192\n  1089\u2192                if expected_filename != self.notarization_path(app).name:\n  1090\u2192                    raise BriefcaseCommandError(\n  1091\u2192                        f\"{submission_id} is not a submission ID for this project. \"\n  1092\u2192                        f\"It notarizes a file named {expected_filename}\"\n  1093\u2192                    )\n  1094\u2192            except IndexError:\n  1095\u2192                raise BriefcaseCommandError(\n  1096\u2192                    f\"{submission_id} is not a known submission ID for this identity.\"\n  1097\u2192                )\n  1098\u2192            except subprocess.CalledProcessError:\n  1099\u2192                raise BriefcaseCommandError(\n  1100\u2192                    \"Unable to invoke notarytool to determine validity of submission ID.\\n\"\n  1101\u2192                    \"Are you sure this is the identity that was used to notarize the app?\"\n  1102\u2192                )\n  1103\u2192\n  1104\u2192    def finalize_notarization(\n  1105\u2192        self,\n  1106\u2192        app: AppConfig,\n  1107\u2192        identity: SigningIdentity,\n  1108\u2192        submission_id: str,\n  1109\u2192    ):\n  1110\u2192        \"\"\"Finalize a notarization task.\n  1111\u2192\n  1112\u2192        Polls to check the current notarization status; once notarization approval is\n  1113\u2192        received, the notarization is stapled onto the distribution artefact.\n  1114\u2192\n  1115\u2192        :param app: The app to notarize.\n  1116\u2192        :param identity: The code signing identity to use.\n  1117\u2192        :param submission_id: The submission ID of the notarization task to finalize.\n  1118\u2192        \"\"\"\n  1119\u2192        try:\n  1120\u2192            with self.console.wait_bar(\"Waiting for notarization acceptance...\"):\n  1121\u2192                accepted = False\n  1122\u2192                while not accepted:\n  1123\u2192                    try:\n  1124\u2192                        response = self.tools.subprocess.parse_output(\n  1125\u2192                            json_parser,\n  1126\u2192                            [\n  1127\u2192                                \"xcrun\",\n  1128\u2192                                \"notarytool\",\n  1129\u2192                                \"log\",\n  1130\u2192                                \"--keychain-profile\",\n  1131\u2192                                identity.profile,\n  1132\u2192                                submission_id,\n  1133\u2192                            ],\n  1134\u2192                            quiet=1,\n  1135\u2192                        )\n  1136\u2192\n  1137\u2192                        if response[\"status\"] == \"Accepted\":\n  1138\u2192                            accepted = True\n  1139\u2192                        elif response[\"status\"] == \"Invalid\":\n  1140\u2192                            summary = response.get(\n  1141\u2192                                \"statusSummary\", \"No details provided\"\n  1142\u2192                            )\n  1143\u2192                            raise BriefcaseCommandError(\n  1144\u2192                                f\"Notarization was rejected: {summary}\\n\"\n  1145\u2192                                + \"\\n\".join(\n  1146\u2192                                    f\"\"\"\n  1147\u2192    * ({issue.get('se