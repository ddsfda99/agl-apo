n   217→                \"coarse_location\": \"I need to know roughly where you are\",\n   218→                \"fine_location\": \"I need to know exactly where you are\",\n   219→                \"background_location\": \"I always need to know where you are\",\n   220→            },\n   221→            {},\n   222→            {},\n   223→            {\n   224→                \"info\": {\n   225→                    \"NSLocationUsageDescription\": \"I always need to know where you are\",\n   226→                },\n   227→                \"entitlements\": {\n   228→                    \"com.apple.security.cs.allow-unsigned-executable-memory\": True,\n   229→                    \"com.apple.security.cs.disable-library-validation\": True,\n   230→                    \"com.apple.security.personal-information.location\": True,\n   231→                },\n   232→            },\n   233→        ),\n   234→        # Photo library permissions\n   235→        (\n   236→            {\n   237→                \"photo_library\": \"I need to see your library\",\n   238→            },\n   239→            {},\n   240→            {},\n   241→            {\n   242→                \"info\": {\n   243→                    \"NSPhotoLibraryUsageDescription\": \"I need to see your library\",\n   244→                },\n   245→                \"entitlements\": {\n   246→                    \"com.apple.security.cs.allow-unsigned-executable-memory\": True,\n   247→                    \"com.apple.security.cs.disable-library-validation\": True,\n   248→                    \"com.apple.security.personal-information.photo_library\": True,\n   249→                },\n   250→            },\n   251→        ),\n   252→        # Override and augment by cross-platform definitions\n   253→        (\n   254→            {\n   255→                \"fine_location\": \"I need to know where you are\",\n   256→            },\n   257→            {\n   258→                \"NSCustomMessage\": \"Custom message\",\n   259→                \"NSLocationUsageDescription\": \"Platform specific\",\n   260→            },\n   261→            {\n   262→                \"com.apple.security.personal-information.location\": False,\n   263→                \"com.apple.security.cs.disable-library-validation\": False,\n   264→                \"com.apple.vm.networking\": True,\n   265→            },\n   266→            {\n   267→                \"info\": {\n   268→                    \"NSLocationUsageDescription\": \"Platform specific\",\n   269→                    \"NSCustomMessage\": \"Custom message\",\n   270→                },\n   271→                \"entitlements\": {\n   272→                    \"com.apple.security.cs.allow-unsigned-executable-memory\": True,\n   273→                    \"com.apple.security.cs.disable-library-validation\": False,\n   274→                    \"com.apple.security.personal-information.location\": False,\n   275→                    \"com.apple.vm.networking\": True,\n   276→                },\n   277→            },\n   278→        ),\n   279→    ],\n   280→)\n   281→def test_permissions_context(\n   282→    create_command, first_app, permissions, info, entitlements, context\n   283→):\n   284→    \"\"\"Platform-specific permissions can be added to the context.\"\"\"\n   285→    # Set the permission, info and entitlement values\n   286→    first_app.permission = permissions\n   287→    first_app.info = info\n   288→    first_app.entitlement = entitlements\n   289→    # Extract the cross-platform permissions\n   290→    x_permissions = create_command._x_permissions(first_app)\n   291→    # Check that the final platform permissions are rendered as expected.\n   292→    assert context == create_command.permissions_context(first_app, x_permissions)\n   293→\n   294→\n   295→def test_install_app_resources(create_command, first_app_templated, tmp_path):\n   296→    \"\"\"The app bundle's modification time is updated when app resources are\n   297→    installed.\"\"\"\n   298→    # Get the initial app modification time\n   299→    initial_timestamp = os.path.getmtime(\n   300→        create_command.binary_path(first_app_templated)\n   301→    )\n   302→\n   303→    # Add a small sleep to make sure that a touch will definitely result in an updated\n   304→    # modification time\n   305→    time.sleep(0.1)\n   306→\n   307→    # Install resources\n   308→    create_command.install_app_resources(first_app_templated)\n   309→\n   310→    # Modification time has been updated, and is newer\n   311→    assert (\n   312→        os.path.getmtime(create_command.binary_path(first_app_templated))\n   313→        > initial_timestamp\n   314→    )\n   315→\n   316→\n   317→@pytest.mark.parametrize(\n   318→    \"host_arch, other_arch\",\n   319→    [\n   320→        (\"arm64\", \"x86_64\"),\n   321→        (\"arm64\", \"x86_64\"),\n   322→    ],\n   323→)\n   324→def test_install_app_packages(\n   325→    create_command,\n   326→    first_app_templated,\n   327→    tmp_path,\n   328→    host_arch,\n   329→    other_arch,\n   330→):\n   331→    \"\"\"A 2-pass install of app packages is performed.\"\"\"\n   332→    bundle_path = tmp_path / \"base_path/build/first-app/macos/app\"\n   333→\n   334→    create_command.tools.host_arch = host_arch\n   335→    first_app_templated.requires = [\"first\", \"second==1.2.3\", \"third>=3.2.1\"]\n   336→\n   337→    # Mock the result of finding the binary packages - 2 of the packages are binary;\n   338→    # the version on the loosely specified package doesn't match the lower bound.\n   339→    create_command.find_binary_packages = mock.Mock(\n   340→        return_value=[\n   341→            (\"second\", \"1.2.3\"),\n   342→            (\"third\", \"3.4.5\"),\n   343→        ]\n   344→    )\n   345→\n   346→    # Mock the thin command so we can confirm it was invoked.\n   347→    create_command.thin_app_packages = mock.Mock()\n   348→\n   349→    # Mock the merge command so we can confirm it was invoked.\n   350→    create_command.merge_app_packages = mock.Mock()\n   351→\n   352→    create_command.install_app_requirements(first_app_templated, test_mode=False)\n   353→\n   354→    # We looked for binary packages in the host app_packages\n   355→    create_command.find_binary_packages.assert_called_once_with(\n   356→        bundle_path / f\"app_packages.{host_arch}\",\n   357→        universal_suffix=\"_universal2\",\n   358→    )\n   359→\n   360→    # A request was made to install requirements\n   361→    assert create_command.tools[first_app_templated].app_context.run.mock_calls == [\n   362→        # First call is to install the initial packages on the host arch\n   363→        mock.call(\n   364→            [\n   365→                sys.executable,\n   366→                \"-u\",\n   367→                \"-X\",\n   368→                \"utf8\",\n   369→                \"-m\",\n   370→                \"pip\",\n   371→                \"install\",\n   372→                \"--disable-pip-version-check\",\n   373→                \"--upgrade\",\n   374→                \"--no-user\",\n   375→                f\"--target={bundle_path / ('app_packages.' + host_arch)}\",\n   376→                \"--only-binary\",\n   377→                \":all:\",\n   378→                \"--platform\",\n   379→                f\"macosx_11_0_{host_arch}\",\n   380→                \"first\",\n   381→                \"second==1.2.3\",\n   382→                \"third>=3.2.1\",\n   383→            ],\n   384→            check=True,\n   385→            encoding=\"UTF-8\",\n   386→        ),\n   387→        # Second call installs the binary packages for the other architecture.\n   388→        mock.call(\n   389→            [\n   390→                sys.executable,\n   391→                \"-u\",\n   392→                \"-X\",\n   393→                \"utf8\",\n   394→                \"-m\",\n   395→                \"pip\",\n   396→                \"install\",\n   397→                \"--disable-pip-version-check\",\n   398→                \"--upgrade\",\n   399→                \"--no-user\",\n   400→                f\"--target={bundle_path / ('app_packages.' + other_arch)}\",\n   401→                \"--no-deps\",\n   402→                \"--platform\",\n   403→                f\"macosx_11_0_{other_arch}\",\n   404→                \"--only-binary\",\n   405→                \":all:\",\n   406→                \"second==1.2.3\",\n   407→                \"third==3.4.5\",\n   408→            ],\n   409→            check=True,\n   410→            encoding=\"UTF-8\",\n   411→        ),\n   412→    ]\n   413→\n   414→    # The app packages folder has been created. The existence of the target and host\n   415→    # versions is validated as a result of the underlying install/merge methods.\n   416→    assert (bundle_path / f\"app_packages.{other_arch}\").is_dir()\n   417→\n   418    # An attempt was made thin the \"other\" arch packages.\n   419→    create_command.thin_app_packages.assert_called_once_with(\n   420→        bundle_path / f\"app_packages.{other_arch}\",\n   421→        arch=other_arch,\n   422→    )\n   423→\n   424→    # An attempt was made to merge packages.\n   425→    create_command.merge_app_packages.assert_called_once_with(\n   426→        target_app_packages=bundle_path\n   427→        / \"First App.app\"\n   428→        / \"Contents\"\n   429→        / \"Resources\"\n   430→        / \"app_packages\",\n   431→        sources=[\n   432→            bundle_path / f\"app_packages.{host_arch}\",\n   433→            bundle_path / f\"app_packages.{other_arch}\",\n   434→        ],\n   435→    )\n   436→\n   437→\n   438→def test_min_os_version(create_command, first_app_templated, tmp_path):\n   439→    \"\"\"If the app specifies a min OS version, it is used for wheel installs.\"\"\"\n   440→    create_command.tools.host_arch = \"arm64\"\n   441→\n   442→    bundle_path = tmp_path / \"base_path/build/first-app/macos/app\"\n   443→\n   444→    first_app_templated.requires = [\"first\", \"second==1.2.3\", \"third>=3.2.1\"]\n   445→\n   446→    # Set a minimum OS version.\n   447→    first_app_templated.min_os_version = \"13.2\"\n   448→\n   449→    # Mock the result of finding the binary packages - 2 of the packages are binary;\n   450→    # the version on the loosely specified package doesn't match the lower bound.\n   451→    create_command.find_binary_packages = mock.Mock(\n   452→        return_value=[\n   453→            (\"second\", \"1.2.3\"),\n   454→            (\"third\", \"3.4.5\"),\n   455→        ]\n   456→    )\n   457→\n   458→    # Mock the thin command so we can confirm it was invoked.\n   459→    create_command.thin_app_packages = mock.Mock()\n   460→\n   461→    # Mock the merge command so we can confirm it was invoked.\n   462→    create_command.merge_app_packages = mock.Mock()\n   463→\n   464→    create_command.install_app_requirements(first_app_templated, test_mode=False)\n   465→\n   466→    # We looked for binary packages in the host app_packages\n   467→    create_command.find_binary_packages.assert_called_once_with(\n   468→        bundle_path / \"app_packages.arm64\",\n   469→        universal_suffix=\"_universal2\",\n   470→    )\n   471→\n   472→    # A request was made to install requirements\n   473→    assert create_command.tools[first_app_templated].app_context.run.mock_calls == [\n   474→        # First call is to install the initial packages on the host arch\n   475→        mock.call(\n   476→            [\n   477→                sys.executable,\n   478→                \"-u\",\n   479→                \"-X\",\n   480→                \"utf8\",\n   481→                \"-m\",\n   482→                \"pip\",\n   483→                \"install\",\n   484→                \"--disable-pip-version-check\",\n   485→                \"--upgrade\",\n   486→                \"--no-user\",\n   487→                f\"--target={bundle_path / 'app_packages.arm64'}\",\n   488→                \"--only-binary\",\n   489→                \":all:\",\n   490→                \"--platform\",\n   491→                \"macosx_13_2_arm64\",\n   492→                \"first\",\n   493→                \"second==1.2.3\",\n   494→                \"third>=3.2.1\",\n   495→            ],\n   496→            check=True,\n   497→            encoding=\"UTF-8\",\n   498→        ),\n   499→        # Second call installs the binary packages for the other architecture.\n   500→        mock.call(\n   501→            [\n   502→                sys.executable,\n   503→                \"-u\",\n   504→                \"-X\",\n   505→                \"utf8\",\n   506→                \"-m\",\n   507→                \"pip\",\n   508→                \"install\",\n   509→                \"--disable-pip-version-check\",\n   510→                \"--upgrade\",\n   511→                \"--no-user\",\n   512→                f\"--target={bundle_path / 'app_packages.x86_64'}\",\n   513→                \"--no-deps\",\n   514→                \"--platform\",\n   515→                \"macosx_13_2_x86_64\",\n   516→                \"--only-binary\",\n   517→                \":all:\",\n   518→                \"second==1.2.3\",\n   519→                \"third==3.4.5\",\n   520→            ],\n   521→            check=True,\n   522→            encoding=\"UTF-8\",\n   523→        ),\n   524→    ]\n   525→\n   526→    # The app packages folder has been created. The existence of the target and host\n   527→    # versions is validated as a result of the underlying install/merge methods.\n   528→    assert (bundle_path / \"app_packages.x86_64\").is_dir()\n   529→\n   530→    # An attempt was made thin the \"other\" arch packages.\n   531→    create_command.thin_app_packages.assert_called_once_with(\n   532→        bundle_path / \"app_packages.x86_64\",\n   533→        arch=\"x86_64\",\n   534→    )\n   535→\n   536→    # An attempt was made to merge packages.\n   537→    create_command.merge_app_packages.assert_called_once_with(\n   538→        target_app_packages=bundle_path\n   539→        / \"First App.app\"\n   540→        / \"Contents\"\n   541→        / \"Resources\"\n   542→        / \"app_packages\",\n   543→        sources=[\n   544→            bundle_path / \"app_packages.arm64\",\n   545→            bundle_path / \"app_packages.x86_64\",\n   546→        ],\n   547→    )\n   548→\n   549→\n   550→def test_invalid_min_os_version(create_command, first_app_templated):\n   551→    \"\"\"If the app defines a min OS version that is incompatible with the support\n   552→    package, an error is raised.\"\"\"\n   553→    first_app_templated.requires = [\"first\", \"second==1.2.3\", \"third>=3.2.1\"]\n   554→\n   555→    # Set a min OS version that is incompatible with the support package.\n   556→    first_app_templated.min_os_version = \"10.6\"\n   557→\n   558→    with pytest.raises(\n   559→        BriefcaseCommandError,\n   560→        match=(\n   561→            r\"Your macOS app specifies a minimum macOS version of 10.6, \"\n   562→            r\"but the support package only supports 10.12\"\n   563→        ),\n   564→    ):\n   565→        create_command.install_app_requirements(first_app_templated, test_mode=False)\n   566→\n   567→    # No request was made to install requirements\n   568→    create_command.tools[first_app_templated].app_context.run.assert_not_called()\n   569→\n   570→\n   571→@pytest.mark.parametrize(\n   572→    \"host_arch, other_arch\",\n   573→    [\n   574→        (\"arm64\", \"x86_64\"),\n   575→        (\"arm64\", \"x86_64\"),\n   576→    ],\n   577→)\n   578→def test_install_app_packages_no_binary(\n   579→    create_command,\n   580→    first_app_templated,\n   581→    tmp_path,\n   582→    host_arch,\n   583→    other_arch,\n   584→):\n   585→    \"\"\"If there's no binaries in the first pass, the second pass isn't performed.\"\"\"\n   586→    bundle_path = tmp_path / \"base_path/build/first-app/macos/app\"\n   587→\n   588→    # Cre