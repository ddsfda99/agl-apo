(\n   497\u2192            [\n   498\u2192                sys.executable,\n   499\u2192                \"-u\",\n   500\u2192                \"-X\",\n   501\u2192                \"utf8\",\n   502\u2192                \"-m\",\n   503\u2192                \"pip\",\n   504\u2192                \"install\",\n   505\u2192                \"--disable-pip-version-check\",\n   506\u2192                \"--upgrade\",\n   507\u2192                \"--no-user\",\n   508\u2192                f\"--target={bundle_path / 'app_packages.x86_64'}\",\n   509\u2192                \"--no-deps\",\n   510\u2192                \"--platform\",\n   511\u2192                \"macosx_13_2_x86_64\",\n   512\u2192                \"--only-binary\",\n   513\u2192                \":all:\",\n   514\u2192                \"second==1.2.3\",\n   515\u2192                \"third==3.4.5\",\n   516\u2192            ],\n   517\u2192            check=True,\n   518\u2192            encoding=\"UTF-8\",\n   519\u2192        ),\n   520\u2192    ]\n   521\u2192\n   522\u2192    # The app packages folder has been created. The existence of the target and host\n   523\u2192    # versions is validated as a result of the underlying install/merge methods.\n   524\u2192    assert (bundle_path / \"app_packages.x86_64\").is_dir()\n   525\u2192\n   526\u2192    # An attempt was made thin the \"other\" arch packages.\n   527\u2192    create_command.thin_app_packages.assert_called_once_with(\n   528\u2192        bundle_path / \"app_packages.x86_64\",\n   529\u2192        arch=\"x86_64\",\n   530\u2192    )\n   531\u2192\n   532\u2192    # An attempt was made to merge packages.\n   533\u2192    create_command.merge_app_packages.assert_called_once_with(\n   534\u2192        target_app_packages=bundle_path\n   535\u2192        / \"First App.app\"\n   536\u2192        / \"Contents\"\n   537\u2192        / \"Resources\"\n   538\u2192        / \"app_packages\",\n   539\u2192        sources=[\n   540\u2192            bundle_path / \"app_packages.arm64\",\n   541\u2192            bundle_path / \"app_packages.x86_64\",\n   542\u2192        ],\n   543\u2192    )\n   544\u2192\n   545\u2192\n   546\u2192def test_invalid_min_os_version(create_command, first_app_templated):\n   547\u2192    \"\"\"If the app defines a min OS version that is incompatible with the support\n   548\u2192    package, an error is raised.\"\"\"\n   549\u2192    first_app_templated.requires = [\"first\", \"second==1.2.3\", \"third>=3.2.1\"]\n   550\u2192\n   551\u2192    # Set a min OS version that is incompatible with the support package.\n   552\u2192    first_app_templated.min_os_version = \"10.6\"\n   553\u2192\n   554\u2192    with pytest.raises(\n   555\u2192        BriefcaseCommandError,\n   556\u2192        match=(\n   557\u2192            r\"Your macOS app specifies a minimum macOS version of 10.6, \"\n   558\u2192            r\"but the support package only supports 10.12\"\n   559\u2192        ),\n   560\u2192    ):\n   561\u2192        create_command.install_app_requirements(first_app_templated, test_mode=False)\n   562\u2192\n   563\u2192    # No request was made to install requirements\n   564\u2192    create_command.tools[first_app_templated].app_context.run.assert_not_called()\n   565\u2192\n   566\u2192\n   567\u2192@pytest.mark.parametrize(\n   568\u2192    \"host_arch, other_arch\",\n   569\u2192    [\n   570\u2192        (\"arm64\", \"x86_64\"),\n   571\u2192        (\"arm64\", \"x86_64\"),\n   572\u2192    ],\n   573\u2192)\n   574\u2192def test_install_app_packages_no_binary(\n   575\u2192    create_command,\n   576\u2192    first_app_templated,\n   577\u2192    tmp_path,\n   578\u2192    host_arch,\n   579\u2192    other_arch,\n   580\u2192):\n   581\u2192    \"\"\"If there's no binaries in the first pass, the second pass isn't performed.\"\"\"\n   582\u2192    bundle_path = tmp_path / \"base_path/build/first-app/macos/app\"\n   583\u2192\n   584\u2192    # Create pre-existing other-arch content\n   585\u2192    create_installed_package(bundle_path / f\"app_packages.{other_arch}\", \"legacy\")\n   586\u2192\n   587\u2192    create_command.tools.host_arch = host_arch\n   588\u2192    first_app_templated.requires = [\"first\", \"second==1.2.3\", \"third>=3.2.1\"]\n   589\u2192\n   590\u2192    # Mock the result of finding no binary packages.\n   591\u2192    create_command.find_binary_packages = mock.Mock(return_value=[])\n   592\u2192\n   593\u2192    # Mock the thin command so we can confirm it was invoked.\n   594\u2192    create_command.thin_app_packages = mock.Mock()\n   595\u2192\n   596\u2192    # Mock the merge command so we can confirm it was invoked.\n   597\u2192    create_command.merge_app_packages = mock.Mock()\n   598\u2192\n   599\u2192    create_command.install_app_requirements(first_app_templated, test_mode=False)\n   600\u2192\n   601\u2192    # We looked for binary packages in the host app_packages\n   602\u2192    create_command.find_binary_packages.assert_called_once_with(\n   603\u2192        bundle_path / f\"app_packages.{host_arch}\",\n   604\u2192        universal_suffix=\"_universal2\",\n   605\u2192    )\n   606\u2192\n   607\u2192    # A request was made to install requirements\n   608\u2192    assert create_command.tools[first_app_templated].app_context.run.mock_calls == [\n   609\u2192        # Only call is to install the initial packages on the host arch\n   610\u2192        mock.call(\n   611\u2192            [\n   612\u2192                sys.executable,\n   613\u2192                \"-u\",\n   614\u2192                \"-X\",\n   615\u2192                \"utf8\",\n   616\u2192                \"-m\",\n   617\u2192                \"pip\",\n   618\u2192                \"install\",\n   619\u2192                \"--disable-pip-version-check\",\n   620\u2192                \"--upgrade\",\n   621\u2192                \"--no-user\",\n   622\u2192                f\"--target={bundle_path / ('app_packages.' + host_arch)}\",\n   623\u2192                \"--only-binary\",\n   624\u2192                \":all:\",\n   625\u2192                \"first\",\n   626\u2192                \"second==1.2.3\",\n   627\u2192                \"third>=3.2.1\",\n   628\u2192            ],\n   629\u2192            check=True,\n   630\u2192            encoding=\"UTF-8\",\n   631\u2192        ),\n   632\u2192    ]\n   633\u2192\n   634\u2192    # The app packages folder for the other architecture has been created, even though\n   635\u2192    # it isn't needed. The existence of the target and host versions is validated as a\n   636\u2192    # result of the underlying install/merge methods.\n   637\u2192    assert (bundle_path / f\"app_packages.{other_arch}\").is_dir()\n   638\u2192\n   639\u2192    # We still need to thin and merge the app packages; this is effectively just a copy.\n   640\u2192    create_command.thin_app_packages.assert_called_once_with(\n   641\u2192        bundle_path / f\"app_packages.{other_arch}\",\n   642\u2192        arch=other_arch,\n   643\u2192    )\n   644\u2192    create_command.merge_app_packages.assert_called_once_with(\n   645\u2192        target_app_packages=bundle_path\n   646\u2192        / \"First App.app\"\n   647\u2192        / \"Contents\"\n   648\u2192        / \"Resources\"\n   649\u2192        / \"app_packages\",\n   650\u2192        sources=[\n   651\u2192            bundle_path / f\"app_packages.{host_arch}\",\n   652\u2192            bundle_path / f\"app_packages.{other_arch}\",\n   653\u2192        ],\n   654\u2192    )\n   655\u2192\n   656\u2192\n   657\u2192def test_install_app_packages_failure(create_command, first_app_templated, tmp_path):\n   658\u2192    \"\"\"If the install of other-arch binaries fails, an exception is raised.\"\"\"\n   659\u2192    bundle_path = tmp_path / \"base_path/build/first-app/macos/app\"\n   660\u2192\n   661\u2192    # Create pre-existing other-arch content\n   662\u2192    create_installed_package(bundle_path / \"app_packages.x86_64\", \"legacy\")\n   663\u2192\n   664\u2192    create_command.tools.host_arch = \"arm64\"\n   665\u2192    first_app_templated.requires = [\"first\", \"second==1.2.3\", \"third>=3.2.1\"]\n   666\u2192\n   667\u2192    # Mock the result of finding the binary packages - 2 of the packages are binary;\n   668\u2192    # the version on the loosely specified package doesn't match the lower bound.\n   669\u2192    create_command.find_binary_packages = mock.Mock(\n   670\u2192        return_value=[\n   671\u2192            (\"second\", \"1.2.3\"),\n   672\u2192            (\"third\", \"3.4.5\"),\n   673\u2192        ]\n   674\u2192    )\n   675\u2192\n   676\u2192    # Mock the thin command so we can confirm it was invoked.\n   677\u2192    create_command.thin_app_packages = mock.Mock()\n   678\u2192\n   679\u2192    # Mock the merge command so we can confirm it was invoked.\n   680\u2192    create_command.merge_app_packages = mock.Mock()\n   681\u2192\n   682\u2192    # Mock a failure on the second install\n   683\u2192    create_command.tools[first_app_templated].app_context.run.side_effect = [\n   684\u2192        None,\n   685\u2192        subprocess.CalledProcessError(returncode=1, cmd=\"pip\"),\n   686\u2192    ]\n   687\u2192\n   688\u2192    # Install the requirements; this will raise an error\n   689\u2192    with pytest.raises(\n   690\u2192        BriefcaseCommandError,\n   691\u2192        match=(\n   692\u2192            r\"Unable to install requirements\\. This may be because one of your\\n\"\n   693\u2192            r\"requirements is invalid, or because pip was unable to connect\\n\"\n   694\u2192            r\"to the PyPI server.\\n\"\n   695\u2192        ),\n   696\u2192    ):\n   697\u2192        create_command.install_app_requirements(first_app_templated, test_mode=False)\n   698\u2192\n   699\u2192    # We looked for binary packages in the host app_packages\n   700\u2192    create_command.find_binary_packages.assert_called_once_with(\n   701\u2192        bundle_path / \"app_packages.arm64\",\n   702\u2192        universal_suffix=\"_universal2\",\n   703\u2192    )\n   704\u2192\n   705\u2192    # A request was made to install requirements\n   706\u2192    assert create_command.tools[first_app_templated].app_context.run.mock_calls == [\n   707\u2192        # First call is to install the initial packages on the host arch\n   708\u2192        mock.call(\n   709\u2192            [\n   710\u2192                sys.executable,\n   711\u2192                \"-u\",\n   712\u2192                \"-X\",\n   713\u2192                \"utf8\",\n   714\u2192                \"-m\",\n   715\u2192                \"pip\",\n   716\u2192                \"install\",\n   717\u2192                \"--disable-pip-version-check\",\n   718\u2192                \"--upgrade\",\n   719\u2192                \"--no-user\",\n   720\u2192                f\"--target={bundle_path / 'app_packages.arm64'}\",\n   721\u2192                \"--only-binary\",\n   722\u2192                \":all:\",\n   723\u2192                \"--platform\",\n   724\u2192                \"macosx_11_0_arm64\",\n   725\u2192                \"first\",\n   726\u2192                \"second==1.2.3\",\n   727\u2192                \"third>=3.2.1\",\n   728\u2192            ],\n   729\u2192            check=True,\n   730\u2192            encoding=\"UTF-8\",\n   731\u2192        ),\n   732\u2192        # Second call installs the binary packages for the other architecture;\n   733\u2192        # this is the call that failed.\n   734\u2192        mock.call(\n   735\u2192            [\n   736\u2192                sys.executable,\n   737\u2192                \"-u\",\n   738\u2192                \"-X\",\n   739\u2192                \"utf8\",\n   740\u2192                \"-m\",\n   741\u2192                \"pip\",\n   742\u2192                \"install\",\n   743\u2192                \"--disable-pip-version-check\",\n   744\u2192                \"--upgrade\",\n   745\u2192                \"--no-user\",\n   746\u2192                f\"--target={bundle_path / 'app_packages.x86_64'}\",\n   747\u2192                \"--no-deps\",\n   748\u2192                \"--platform\",\n   749\u2192                \"macosx_11_0_x86_64\",\n   750\u2192                \"--only-binary\",\n   751\u2192                \":all:\",\n   752\u2192                \"second==1.2.3\",\n   753\u2192                \"third==3.4.5\",\n   754\u2192            ],\n   755\u2192            check=True,\n   756\u2192            encoding=\"UTF-8\",\n   757\u2192        ),\n   758\u2192    ]\n   759\u2192\n   760\u2192    # The app packages folder for the other architecture has been created, even though\n   761\u2192    # it isn't needed. The existence of the target and host versions is validated as a\n   762\u2192    # result of the underlying install/merge methods.\n   763\u2192    assert (bundle_path / \"app_packages.x86_64\").is_dir()\n   764\u2192\n   765\u2192    # We didn't attempt to thin or  merge, because we didn't complete installing.\n   766\u2192    create_command.thin_app_packages.assert_not_called()\n   767\u2192    create_command.merge_app_packages.assert_not_called()\n   768\u2192\n   769\u2192\n   770\u2192@pytest.mark.parametrize(\n   771\u2192    \"host_arch, other_arch\",\n   772\u2192    [\n   773\u2192        (\"arm64\", \"x86_64\"),\n   774\u2192        (\"arm64\", \"x86_64\"),\n   775\u2192    ],\n   776\u2192)\n   777\u2192def test_install_app_packages_non_universal(\n   778\u2192    create_command,\n   779\u2192    first_app_templated,\n   780\u2192    tmp_path,\n   781\u2192    host_arch,\n   782\u2192    other_arch,\n   783\u2192):\n   784\u2192    \"\"\"If the app is non-universal, only a single install pass occurs, followed by\n   785\u2192    thinning.\"\"\"\n   786\u2192    bundle_path = tmp_path / \"base_path/build/first-app/macos/app\"\n   787\u2192\n   788\u2192    create_command.tools.host_arch = host_arch\n   789\u2192    first_app_templated.requires = [\"first\", \"second==1.2.3\", \"third>=3.2.1\"]\n   790\u2192    first_app_templated.universal_build = False\n   791\u2192\n   792\u2192    # Mock the find_binary_packages command so we can confirm it wasn't invoked.\n   793\u2192    create_command.find_binary_packages = mock.Mock()\n   794\u2192\n   795\u2192    # Mock the thin command so we can confirm it was invoked.\n   796\u2192    create_command.thin_app_packages = mock.Mock()\n   797\u2192\n   798\u2192    # Mock the merge command so we can confirm it wasn't invoked.\n   799\u2192    create_command.merge_app_packages = mock.Mock()\n   800\u2192\n   801\u2192    create_command.install_app_requirements(first_app_templated, test_mode=False)\n   802\u2192\n   803\u2192    # We didn't search for binary packages\n   804\u2192    create_command.find_binary_packages.assert_not_called()\n   805\u2192\n   806\u2192    # One request was made to install requirements\n   807\u2192    assert create_command.tools[first_app_templated].app_context.run.mock_calls == [\n   808\u2192        mock.call(\n   809\u2192            [\n   810\u2192                sys.executable,\n   811\u2192                \"-u\",\n   812\u2192                \"-X\",\n   813\u2192                \"utf8\",\n   814\u2192                \"-m\",\n   815\u2192                \"pip\",\n   816\u2192                \"install\",\n   817\u2192                \"--disable-pip-version-check\",\n   818\u2192                \"--upgrade\",\n   819\u2192                \"--no-user\",\n   820\u2192                f\"--target={bundle_path / 'First App.app' / 'Contents' / 'Resources' / 'app_packages'}\",\n   821\u2192                \"--only-binary\",\n   822\u2192                \":all:\",\n   823\u2192                \"first\",\n   824\u2192                \"second==1.2.3\",\n   825\u2192                \"third>=3.2.1\",\n   826\u2192            ],\n   827\u2192            check=True,\n   828\u2192            encoding=\"UTF-8\",\n   829\u2192        ),\n   830\u2192    ]\