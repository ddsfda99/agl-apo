al_name}.app\"\n    53\u2192        )\n    54\u2192\n    55\u2192    def distribution_path(self, app):\n    56\u2192        # This path won't ever be *generated*, as distribution artefacts\n    57\u2192        # can't be generated on iOS.\n    58\u2192        raise NoDistributionArtefact(\n    59\u2192            \"\"\"\n    60\u2192*************************************************************************\n    61\u2192** WARNING: No distributable artefact has been generated               **\n    62\u2192*************************************************************************\n    63\u2192\n    64\u2192    Briefcase has not generated a standalone iOS artefact, as iOS apps\n    65\u2192    must be published through Xcode.\n    66\u2192\n    67\u2192    To open Xcode for your iOS project, run:\n    68\u2192\n    69\u2192        briefcase open iOS\n    70\u2192\n    71\u2192    and use Xcode's app distribution workflow.\n    72\u2192\n    73\u2192*************************************************************************\n    74\u2192\"\"\"\n    75\u2192        )\n    76\u2192\n    77\u2192\n    78\u2192class iOSXcodeMixin(iOSXcodePassiveMixin):\n    79\u2192    def __init__(self, *args, **kwargs):\n    80\u2192        super().__init__(*args, **kwargs)\n    81\u2192\n    82\u2192        # External service APIs.\n    83\u2192        # These are abstracted to enable testing without patching.\n    84\u2192        self.get_simulators = get_simulators\n    85\u2192\n    86\u2192    def add_options(self, parser):\n    87\u2192        super().add_options(parser)\n    88\u2192        parser.add_argument(\n    89\u2192            \"-d\",\n    90\u2192            \"--device\",\n    91\u2192            dest=\"udid\",\n    92\u2192            help=\"The device to target; either a UDID, \"\n    93\u2192            'a device name (\"iPhone 11\"), '\n    94\u2192            'or a device name and OS version (\"iPhone 11::iOS 13.3\")',\n    95\u2192            required=False,\n    96\u2192        )\n    97\u2192\n    98\u2192    def select_target_device(self, udid_or_device=None):\n    99\u2192        \"\"\"Select the target device to use for iOS builds.\n   100\u2192\n   101\u2192        Interrogates the system to get the list of available simulators\n   102\u2192\n   103\u2192        If there is only a single iOS version available, that version\n   104\u2192        will be selected automatically.\n   105\u2192\n   106\u2192        If there is only one simulator available, that version will be selected\n   107\u2192        automatically.\n   108\u2192\n   109\u2192        If the user has specified a device at the command line, it will be\n   110\u2192        used in preference to any\n   111\u2192\n   112\u2192        :param udid_or_device: The device to target. Can be a device UUID, a\n   113\u2192            device name (\"iPhone 11\"), or a device name and OS version\n   114\u2192            (\"iPhone 11::13.3\"). If ``None``, the user will be asked to select\n   115\u2192            a device at runtime.\n   116\u2192        :returns: A tuple containing the udid, iOS version, and device name\n   117\u2192            for the selected device.\n   118\u2192        \"\"\"\n   119\u2192        simulators = self.get_simulators(self.tools, \"iOS\")\n   120\u2192        try:\n   121\u2192            # Try to convert to a UDID. If this succeeds, then the argument\n   122\u2192            # is a UDID.\n   123\u2192            udid = str(UUID(udid_or_device)).upper()\n   124\u2192            # User has provided a UDID at the command line; look for it.\n   125\u2192            for iOS_tag, devices in simulators.items():\n   126\u2192                try:\n   127\u2192                    device = devices[udid]\n   128\u2192                    # iOS_tag will be of the form \"iOS 15.5\"\n   129\u2192                    # Drop the \"iOS\" prefix when reporting the version.\n   130\u2192                    iOS_version = iOS_tag.split(\" \", 1)[-1]\n   131\u2192                    return udid, iOS_version, device\n   132\u2192                except KeyError:\n   133\u2192                    # UDID doesn't exist in this iOS version; try another.\n   134\u2192                    pass\n   135\u2192\n   136\u2192            # We've iterated through all available iOS versions and\n   137\u2192            # found no match; return an error.\n   138\u2192            raise InvalidDeviceError(\"device UDID\", udid)\n   139\u2192\n   140\u2192        except (ValueError, TypeError) as e:\n   141\u2192            # Provided value wasn't a UDID.\n   142\u2192            # It must be a device or device+version\n   143\u2192            if udid_or_device and \"::\" in udid_or_device:\n   144\u2192                # A device name::version.\n   145\u2192                device, iOS_tag = udid_or_device.split(\"::\")\n   146\u2192\n   147\u2192                try:\n   148\u2192                    # Convert the simulator dict into a dict where\n   149\u2192                    # the iOS versions are lower cased, then do a lookup\n   150\u2192                    # on the lower case name provided by the user.\n   151\u2192                    # However, also return the *unmodified* iOS version string\n   152\u2192                    # so we can convert the user-provided iOS version into the\n   153\u2192                    # \"clean\", official capitalization.\n   154\u2192                    iOS_tag, devices = {\n   155\u2192                        clean_iOS_tag.lower(): (clean_iOS_tag, details)\n   156\u2192                        for clean_iOS_tag, details in simulators.items()\n   157\u2192                    }[iOS_tag.lower()]\n   158\u2192\n   159\u2192                    # iOS_tag will be of the form \"iOS 15.5\"\n   160\u2192                    # Drop the \"iOS\" prefix when reporting the version.\n   161\u2192                    iOS_version = iOS_tag.split(\" \", 1)[-1]\n   162\u2192                    try:\n   163\u2192                        # Do a reverse lookup for UDID, based on a\n   164\u2192                        # case-insensitive name lookup.\n   165\u2192                        udid = {name.lower(): udid for udid, name in devices.items()}[\n   166\u2192                            device.lower()\n   167\u2192                        ]\n   168\u2192\n   169\u2192                        # Found a match;\n   170\u2192                        # normalize back to the official name and return.\n   171\u2192                        device = devices[udid]\n   172\u2192                        return udid, iOS_version, device\n   173\u2192                    except KeyError as e:\n   174\u2192                        raise InvalidDeviceError(\"device name\", device) from e\n   175\u2192                except KeyError as e:\n   176\u2192                    raise InvalidDeviceError(\"iOS Version\", iOS_tag) from e\n   177\u2192            elif udid_or_device:\n   178\u2192                # Just a device name\n   179\u2192                device = udid_or_device\n   180\u2192\n   181\u2192                # Search iOS versions, looking for most recent version first.\n   182\u2192                # The iOS tag will be something like \"iOS 15.4\";\n   183\u2192                # Drop the prefix (if it exists), convert into the tuple (15, 4),\n   184\u2192                # and sort numerically.\n   185\u2192                for iOS_tag, devices in sorted(\n   186\u2192                    simulators.items(),\n   187\u2192                    key=lambda item: tuple(\n   188\u2192                        int(v) for v in item[0].split()[-1].split(\".\")\n   189\u2192                    ),\n   190\u2192                    reverse=True,\n   191\u2192                ):\n   192\u2192                    try:\n   193\u2192                        udid = {name.lower(): udid for udid, name in devices.items()}[\n   194\u2192                            device.lower()\n   195\u2192                        ]\n   196\u2192\n   197\u2192                        # Found a match;\n   198\u2192                        # normalize back to the official name and return.\n   199\u2192                        device = devices[udid]\n   200\u2192\n   201\u2192                        # iOS_tag will be of the form \"iOS 15.5\"\n   202\u2192                        # Drop the \"iOS\" prefix when reporting the version.\n   203\u2192                        iOS_version = iOS_tag.split(\" \", 1)[-1]\n   204\u2192\n   205\u2192                        return udid, iOS_version, device\n   206\u2192                    except KeyError:\n   207\u2192                        # UDID doesn't exist in this iOS version; try another.\n   208\u2192                        pass\n   209\u2192                raise InvalidDeviceError(\"device name\", device) from e\n   210\u2192\n   211\u2192        if len(simulators) == 0:\n   212\u2192            raise BriefcaseCommandError(\"No iOS simulators available.\")\n   213\u2192        elif len(simulators) == 1:\n   214\u2192            iOS_tag = list(simulators.keys())[0]\n   215\u2192        else:\n   216\u2192            iOS_tag = self.console.selection_question(\n   217\u2192                intro=\"Select iOS version:\",\n   218\u2192                description=\"iOS Version\",\n   219\u2192                options=simulators.keys(),\n   220\u2192            )\n   221\u2192\n   222\u2192        devices = simulators[iOS_tag]\n   223\u2192\n   224\u2192        if len(devices) == 0:\n   225\u2192            raise BriefcaseCommandError(f\"No simulators available for {iOS_tag}.\")\n   226\u2192        elif len(devices) == 1:\n   227\u2192            udid = list(devices.keys())[0]\n   228\u2192        else:\n   229\u2192            udid = self.console.selection_question(\n   230\u2192                intro=\"Select simulator device to use:\",\n   231\u2192                description=\"Simulator\",\n   232\u2192                options=devices,\n   233\u2192            )\n   234\u2192\n   235\u2192        device = devices[udid]\n   236\u2192\n   237\u2192        self.console.info(\n   238\u2192            f\"\"\"\n   239\u2192In the future, you could specify this device by running:\n   240\u2192\n   241\u2192    $ briefcase {self.command} iOS -d \"{device}::{iOS_tag}\"\n   242\u2192\n   243\u2192or:\n   244\u2192\n   245\u2192    $ briefcase {self.command} iOS -d {udid}\n   246\u2192\"\"\"\n   247\u2192        )\n   248\u2192\n   249\u2192        # iOS_tag will be of the form \"iOS 15.5\"\n   250\u2192        # Drop the \"iOS\" prefix when reporting the version.\n   251\u2192        iOS_version = iOS_tag.split(\" \", 1)[-1]\n   252\u2192\n   253\u2192        return udid, iOS_version, device\n   254\u2192\n   255\u2192\n   256\u2192class iOSXcodeCreateCommand(iOSXcodePassiveMixin, CreateCommand):\n   257\u2192    description = \"Create and populate a iOS Xcode project.\"\n   258\u2192\n   259\u2192    def permissions_context(self, app: AppConfig, x_permissions: dict[str, str]):\n   260\u2192        \"\"\"Additional template context for permissions.\n   261\u2192\n   262\u2192        :param app: The config object for the app\n   263\u2192        :param x_permissions: The dictionary of known cross-platform permission\n   264\u2192            definitions.\n   265\u2192        :returns: The template context describing permissions for the app.\n   266\u2192        \"\"\"\n   267\u2192        # The collection of info.plist entries\n   268\u2192        info = {}\n   269\u2192\n   270\u2192        if x_permissions[\"camera\"]:\n   271\u2192            info[\"NSCameraUsageDescription\"] = x_permissions[\"camera\"]\n   272\u2192        if x_permissions[\"microphone\"]:\n   273\u2192            info[\"NSMicrophoneUsageDescription\"] = x_permissions[\"microphone\"]\n   274\u2192\n   275\u2192        if x_permissions[\"fine_location\"]:\n   276\u2192            info[\"NSLocationWhenInUseUsageDescription\"] = x_permissions[\"fine_location\"]\n   277\u2192            info[\"NSLocationDefaultAccuracyReduced\"] = False\n   278\u2192        elif x_permissions[\"coarse_location\"]:\n   279\u2192            info[\"NSLocationWhenInUseUsageDescription\"] = x_permissions[\n   280\u2192                \"coarse_location\"\n   281\u2192            ]\n   282\u2192            info[\"NSLocationDefaultAccuracyReduced\"] = True\n   283\u2192\n   284\u2192        if x_permissions[\"background_location\"]:\n   285\u2192            if \"NSLocationWhenInUseUsageDescription\" not in info:\n   286\u2192                info[\"NSLocationWhenInUseUsageDescription\"] = x_permissions[\n   287\u2192                    \"background_location\"\n   288\u2192                ]\n   289\u2192            info[\"NSLocationAlwaysAndWhenInUseUsageDescription\"] = x_permissions[\n   290\u2192                \"background_location\"\n   291\u2192            ]\n   292\u2192            info[\"UIBackgroundModes\"] = [\"processing\", \"location\"]\n   293\u2192\n   294\u2192        if x_permissions[\"photo_library\"]:\n   295\u2192            info[\"NSPhotoLibraryAddUsageDescription\"] = x_permissions[\"photo_library\"]\n   296\u2192\n   297\u2192        # Override any info.plist entries with the platform specific definitions\n   298\u2192        info.update(getattr(app, \"info\", {}))\n   299\u2192\n   300\u2192        return {\n   301\u2192            \"info\": info,\n   302\u2192        }\n   303\u2192\n   304\u2192    def _extra_pip_args(self, app: AppConfig):\n   305\u2192        \"\"\"Any additional arguments that must be passed to pip when installing packages.\n   306\u2192\n   307\u2192        :param app: The app configuration\n   308\u2192        :returns: A list of additional arguments\n   309\u2192        \"\"\"\n   310\u2192        return super()._extra_pip_args(app) + [\n   311\u2192            \"--only-binary=:all:\",\n   312\u2192            \"--extra-index-url\",\n   313\u2192            \"https://pypi.anaconda.org/beeware/simple\",\n   314\u2192        ]\n   315\u2192\n   316\u2192    def _install_app_requirements(\n   317\u2192        self,\n   318\u2192        app: AppConfig,\n   319\u2192        requires: list[str],\n   320\u2192        app_packages_path: Path,\n   321\u2192    ):\n   322\u2192        # Determine the min iOS version from the VERSIONS file in the support package.\n   323\u2192        versions = dict(\n   324\u2192            [part.strip() for part in line.split(\": \", 1)]\n   325\u2192            for line in (\n   326\u2192                (self.support_path(app) / \"VERSIONS\")\n   327\u2192                .read_text(encoding=\"UTF-8\")\n   328\u2192                .split(\"\\n\")\n   329\u2192            )\n   330\u2192            if \": \" in line\n   331\u2192        )\n   332\u2192        support_min_version = Version(versions.get(\"Min iOS version\", \"13.0\"))\n   333\u2192\n   334\u2192        # Check that the app's definition is compatible with the support package\n   335\u2192        ios_min_version = Version(getattr(app, \"min_os_version\", \"13.0\"))\n   336\u2192        if ios_min_version < support_min_version:\n   337\u2192            raise BriefcaseCommandError(\n   338\u2192                f\"Your iOS app specifies a minimum iOS version of {ios_min_version}, \"\n   339\u2192                f\"but the support package only supports {support_min_version}\"\n   340\u2192            )\n   341\u2192\n   342\u2192        ios_min_tag = str(ios_min_version).replace(\".\", \"_\")\n   343\u2192\n   344\u2192        # Feb 2025: The platform-site was moved into the xcframework as\n   345\u2192        # `platform-config`. Look for the new location; fall back to the old location.\n   346\u2192        device_platform_site = (\n   347\u2192            self.support_path(app)\n   348\u2192            / \"Python.xcframework/ios-arm64/platform-config/arm64-iphoneos\"\n   349\u2192        )\n   350\u2192        simulator_platform_site = (\n   351\u2192            self.support_path(app)\n   352\u2192            / \"Python.xcframework/ios-arm64_x86_64-simulator\"\n   353\u2192            / f\"platform-config/{self.tools.host_arch}-iphonesimulator\"\n   354\u2192        )\n   355\u2192        if not device_platform_site.exists():\n   356\u2192            device_platform_site = (\n   357\u2192                self.support_path(app) / \"platform-site/iphoneos.arm64\"\n   358\u2192            )\n   359\u2192            simulator_platform_site = (\n   360\u2192                self.support_path(app)\n   361\u2192                / f\"platform-site/iphonesimulator.{self.tools.host_arch}\"\n   362\u2192            )\n   363\u2192\n   364\u2192        # Perform the initial install pass targeting the \"iphoneos\" platform\n   365\u2192        super()._install_app_requirements(\n   366\u2192            app,\n   367\u2192            requires=requires,\n   368\u2192            app_packages_path=app_packages_path.parent / \"app_packages.iphoneos\",\n   369\u2192            progress_message=\"Installing app requirements for iPhone device...\",\n   370\u2192            pip_args=[\n   371\u2192                f\"--platform=ios_{ios_min_tag}_arm64_iphoneos\",\n   372\u2192            ],\n   373\u2192            pip_kwargs={\n   374\u2192                \"env\": {\n   375\u2192                    \"PYTHONPATH\": str(device_platform_site),\n   376\u2192                },\n   377\u2192            },\n   378\u2192        )\n   379\u2192\n   380\u2192        # Perform a second install pass targeting the \"iphonesimulator\" platform for the\n   381\u2192        # current architecture\n   382\u2192        super()._install_app_requirements(\n   383\u2192            app,\n   384\u2192            requires=requires,\n   385\u2192            app_packages_path=app_packages_path.parent / \"app_packages.iphonesimulator\",\n   386\u2192            progress_message=\"Installing app requirements for iPhone simulator...\",\n   387\u2192            pip_args=[\n   388\u2192                f\"--platform=ios_{ios_min_tag}_{self.tools.host_arch}_iphonesimulator\",\n   389\u2192            ],\n   390\u2192            pip_kwargs={\n   391\u2192                \"env\": {\n   392\u2192                    \"PYTHONPATH\": str(simulator_platform_site),\n   393\u2192                },\n   394\u2192            },\n   395\u2192        )\n   396\u2192\n   397\u2192\n   398\u2192class iOSXcodeUpdateCommand(iOSXcodeCreateCommand, UpdateCommand):\n   399\u2192    description = \"Update an existing iOS Xcode project.\"\n   400\u2192\n   401\u2192\n   402\u2192class iOSXcodeOpenCommand(iOSXcodePassiveMixin, OpenCommand):\n   403\u2192    description = \"Open an existing iOS Xcode project.\"\n   404\u2192\n   405\u2192\n   406\u2192class iOSXcodeBuildCommand(iOSXcodePassiveMixin, BuildCommand):\n   407\u2192    description = \"Build an iOS Xcode project.\"\n   408\u2192\n   409\u2192    def info_plist_path(self, app: AppConfig):\n   410\u2192        \"\"\"Obtain the path to the application's plist file.\n   411\u2192\n   412\u2192        :param app: The config object for the app\n   413\u2192        :return: The full path of the application's plist file.\n   414\u2192        \"\"\"\n   415\u2192        return self.bundle_path(app) / self.path_index(app, \"info_plist_path\")\n   416\u2192\n   417\u2192    def update_app_metadata(self, app: AppConfig, test_mode: bool):\n   418\u2192        with self.console.wait_bar(\"Setting main module...\"):\n   419\u2192            # Load the original plist\n   420\u2192            with self.info_plist_path(app).open(\"rb\") as f:\n   421\u2192                info_plist = plistlib.load(f)\n   422\u2192\n   423\u2192            # Set the name of the app's main module; this will depend\n   424\u2192            # on whether we're in test mode.\n   425\u2192            info_plist[\"MainModule\"] = app.main_module(test_mode)\n   426\u2192\n   427\u2192            # Write the modified plist\n   428\u2192            with self.info_plist_path(app).open(\"wb\") as f:\n   429\u2192                plistlib.dump(info_plist, f)\n   430\u2192\n   431\u2192    def build_app(self, app: AppConfig, test_mode: bool = False, **kwargs):\n   432\u2192        \"\"\"Build the Xcode project for the application.\n   433\u2192\n   434\u2192        :param app: The application to build\n   435\u2192        :param test_mode: Should the app be updated in test mode? (default: False)\n   436\u2192        \"\"\"\n   437\u2192        self.console.info(\"Updating app metadata...\", prefix=app.app_name)\n   438\u2192        self.update_app_metadata(app=app, test_mode=test_mode)\n   439\u2192\n   440\u2192        self.console.info(\"Building Xcode project...\", prefix=app.app_name)\n   441\u2192        with self.console.wait_bar(\"Building...\"):\n   442\u2192            try:\n   443\u2192                self.tools.subprocess.run(\n   444\u2192                    [\n   445\u2192                        \"xcodebuild\",\n   446\u2192                        \"build\",\n   447\u2192                        \"-project\",\n   448\u2192                        self.project_path(app),\n   449\u2192                        \"-configuration\",\n   450\u2192                        \"Debug\",\n   451\u2192                        \"-arch\",\n   452\u2192                        self.tools.host_arch,\n   453\u2192                        \"-sdk\",\n   454\u2192                        \"iphonesimulator\",\n   455\u2192                        \"-verbose\" if self.tools.console.is_deep_debug else \"-quiet\",\n   456\u2192                    ],\n   457\u2192                    check=True,\n   458\u2192                    filter_func=(\n   459\u2192                        None if self.tools.console.is_deep_debug else XcodeBuildFilter()\n   460\u2192                    ),\n   461\u2192                )\n   462\u2192            except subprocess.CalledProcessError as e:\n   463\u2192                raise BriefcaseCommandError(\n   464\u2192                    f\"Unable to build app {a