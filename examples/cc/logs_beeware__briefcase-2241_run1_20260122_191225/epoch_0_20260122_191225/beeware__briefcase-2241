rser to which options should be added.\n   871→        :param context_label: Label text for commands; the capitalized action being\n   872→            performed (e.g., \"Build\", \"Run\",...)\n   873→        \"\"\"\n   874→        parser.add_argument(\n   875→            \"--test\",\n   876→            dest=\"test_mode\",\n   877→            action=\"store_true\",\n   878→            help=f\"{context_label} the app in test mode\",\n   879→        )\n   880→\n   881→    def add_options(self, parser):\n   882→        \"\"\"Add any options that this command needs to parse from the command line.\n   883→\n   884→        :param parser: a stub argparse parser for the command.\n   885→        \"\"\"\n   886→\n   887→    def parse_config(self, filename, overrides):\n   888→        try:\n   889→            with open(filename, \"rb\") as config_file:\n   890→                # Parse the content of the pyproject.toml file, extracting\n   891→                # any platform and output format configuration for each app,\n   892→                # creating a single set of configuration options.\n   893→                global_config, app_configs = parse_config(\n   894→                    config_file,\n   895→                    platform=self.platform,\n   896→                    output_format=self.output_format,\n   897→                    console=self.console,\n   898→                )\n   899→\n   900→                # Create the global config\n   901→                global_config.update(overrides)\n   902→                self.global_config = create_config(\n   903→                    klass=GlobalConfig,\n   904→                    config=global_config,\n   905→                    msg=\"Global configuration\",\n   906→                )\n   907→\n   908→                for app_name, app_config in app_configs.items():\n   909→                    # Construct an AppConfig object with the final set of\n   910→                    # configuration options for the app.\n   911→            