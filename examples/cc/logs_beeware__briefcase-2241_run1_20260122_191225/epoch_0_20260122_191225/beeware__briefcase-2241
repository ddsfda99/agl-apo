             if not self.console.input_enabled:\n   972\u2192                        raise BriefcaseCommandError(\n   973\u2192                            f\"\"\"\n   974\u2192The keychain does not contain credentials for the profile {identity.profile}.\n   975\u2192You can store these credentials by invoking:\n   976\u2192\n   977\u2192    $ xcrun notarytool store-credentials --team-id {identity.team_id} {identity.profile}\n   978\u2192\n   979\u2192\"\"\"\n   980\u2192                        )\n   981\u2192\n   982\u2192                    self.console.warning(\n   983\u2192                        \"\"\"\n   984\u2192The notarization process uses credentials stored on your system Keychain.\n   985\u2192You need to do this once for each signing certificate you use.\n   986\u2192\n   987\u2192The credentials are authenticated and stored using your Apple ID, using\n   988\u2192an app-specific Apple ID password. To generate an app-specific Apple ID\n   989\u2192password:\n   990\u2192\n   991\u2192  1. Sign into https://appleid.apple.com;\n   992\u2192  2. In the 'Sign-in and Security' section, click 'App-Specific Passwords';\n   993\u2192  3. Click on the '+' icon. You will need to provide an identifying name\n   994\u2192     for the password. You can pick any name that makes sense to you - the\n   995\u2192     name is only there so you can identify passwords. 'Briefcase' would be\n   996\u2192     one possible name.\n   997\u2192  4. Record the password somewhere safe.\n   998\u2192\"\"\"\n   999\u2192                    )\n  1000\u2192                    try:\n  1001\u2192                        self.tools.subprocess.run(\n  1002\u2192                            [\n  1003\u2192                                \"xcrun\",\n  1004\u2192                                \"notarytool\",\n  1005\u2192                                \"store-credentials\",\n  1006\u2192                                \"--team-id\",\n  1007\u2192                                identity.team_id,\n  1008\u2192                                identity.profile,\n  1009\u2192                            ],\n  1010\u2192                            check=True,\n  1011\u2192                            stream_output=False,  # Command reads from stdin.\n  1012\u2192                        )\n  1013\u2192                    except subprocess.CalledProcessError as e:\n  1014\u2192                        raise BriefcaseCommandError(\n  1015\u2192                            f\"Unable to store credentials for team ID {identity.team_id}.\"\n  1016\u2192                        ) from e\n  1017\u2192\n  1018\u2192                # Attempt the notarization\n  1019\u2192                try:\n  1020\u2192                    self.console.info()\n  1021\u2192                    with self.console.wait_bar(\"Submitting app for notarization...\"):\n  1022\u2192                        submission = self.tools.subprocess.parse_output(\n  1023\u2192                            json_parser,\n  1024\u2192                            [\n  1025\u2192                                \"xcrun\",\n  1026\u2192                                \"notarytool\",\n  1027\u2192                                \"submit\",\n  1028\u2192                                archive_filename,\n  1029\u2192                                \"--keychain-profile\",\n  1030\u2192                                identity.profile,\n  1031\u2192                                \"--output-format\",\n  1032\u2192                                \"json\",\n  1033\u2192                            ],\n  1034\u2192                            quiet=1,\n  1035\u2192                        )\n  1036\u2192                        submission_id = submission[\"id\"]\n  1037\u2192                except subprocess.CalledProcessError as e:\n  1038\u2192                    # Error when submitting for notarization.\n  1039\u2192                    # A return code of 69 (nice) indicates an issue with the\n  1040\u2192                    # keychain profile. If store_credentials is already True,\n  1041\u2192                    # then we've already tried to store them, so call the attempt\n  1042\u2192                    # a fail\n  1043\u2192                    if e.returncode == 69 and not store_credentials:\n  1044\u2192                        store_credentials = True\n  1045\u2192                    else:\n  1046\u2192                        self.tools.subprocess.output_error(e)\n  1047\u2192                        raise BriefcaseCommandError(\n  1048\u2192                            f\"Unable to submit {filename.relative_to(self.base_path)} for notarization.\"\n  1049\u2192                        ) from e\n  1050\u2192        finally:\n  1051\u2192            # If we're using .zip packaging, the archive is temporary and isn't used for\n  1052\u2192            # distribution, so we can clean up.\n  1053\u2192            if archive_filename != filename:\n  1054\u2192                self.tools.os.unlink(archive_filename)\n  1055\u2192\n  1056\u2192        return submission_id\n  1057\u2192\n  1058\u2192    def validate_submission_id(\n  1059\u2192        self,\n  1060\u2192        app: AppConfig,\n  1061\u2192        identity: SigningIdentity,\n  1062\u2192        submission_id: str,\n  1063\u2192    ):\n  1064\u2192        with self.console.wait_bar(\"Determining validity of submission ID...\"):\n  1065\u2192            try:\n  1066\u2192                response = self.tools.subprocess.parse_output(\n  1067\u2192                    json_parser,\n  1068\u2192                    [\n  1069\u2192                        \"xcrun\",\n  1070\u2192                        \"notarytool\",\n  1071\u2192                        \"history\",\n  1072\u2192                        \"--keychain-profile\",\n  1073\u2192                        identity.profile,\n  1074\u2192                        \"--output-format\",\n  1075\u2192                        \"json\",\n  1076\u2192                    ],\n  1077\u2192                )\n  1078\u2192\n  1079\u2192                id_matches = [\n  1080\u2192                    submission\n  1081\u2192                    for submission in response[\"history\"]\n  1082\u2192                    if submission[\"id\"] == submission_id\n  1083\u2192                ]\n  1084\u2192\n  1085\u2192                expected_filename = id_matches[0][\"name\"]\n  1086\u2192                # .app files are zipped for notarization, but the app itself is\n  1087\u2192                # notarized; strip the .zip suffix for filename matching purposes.\n  1088\u2192                if expected_filename.endswith(\".zip\"):\n  1089\u2192                    expected_filename = expected_filename[:-4]\n  1090\u2192\n  1091\u2192                if expected_filename != self.notarization_path(app).name:\n  1092\u2192                    raise BriefcaseCommandError(\n  1093\u2192                        f\"{submission_id} is not a submission ID for this project. \"\n  1094\u2192                        f\"It notarizes a file named {expected_filename}\"\n  1095\u2192                    )\n  1096\u2192            except IndexError:\n  1097\u2192                raise BriefcaseCommandError(\n  1098\u2192                    f\"{submission_id} is not a known submission ID for this identity.\"\n  1099\u2192                )\n  1100\u2192            except subprocess.CalledProcessError:\n  1101\u2192                raise BriefcaseCommandError(\n  1102\u2192                    \"Unable to invoke notarytool to determine validity of submission ID.\\n\"\n  1103\u2192                    \"Are you sure this is the identity that was used to notarize the app?\"\n  1104\u2192                )\n  1105\u2192\n  1106\u2192    def finalize_notarization(\n  1107\u2192        self,\n  1108\u2192        app: AppConfig,\n  1109\u2192        identity: SigningIdentity,\n  1110\u2192        submission_id: str,\n  1111\u2192    ):\n  1112\u2192        \"\"\"Finalize a notarization task.\n  1113\u2192\n  1114\u2192        Polls to check the current notarization status; once notarization approval is\n  1115\u2192        received, the notarization is stapled onto the distribution artefact.\n  1116\u2192\n  1117\u2192        :param app: The app to notarize.\n  1118\u2192        :param identity: The code signing identity to use.\n  1119\u2192        :param submission_id: The submission ID of the notarization task to finalize.\n  1120\u2192        \"\"\"\n  1121\u2192        try:\n  1122\u2192            with self.console.wait_bar(\"Waiting for notarization acceptance...\"):\n  1123\u2192                accepted = False\n  1124\u2192                while not accepted:\n  1125\u2192                    try:\n  1126\u2192                        response = self.tools.subprocess.parse_output(\n  1127\u2192                            json_parser,\n  1128\u2192                            [\n  1129\u2192                                \"xcrun\",\n  1130\u2192                                \"notarytool\",\n  1131\u2192                                \"log\",\n  1132\u2192                                \"--keychain-profile\",\n  1133\u2192                                identity.profile,\n  1134\u2192                                submission_id,\n  1135\u2192                            ],\n  1136\u2192                            quiet=1,\n  1137\u2192                        )\n  1138\u2192\n  1139\u2192                        if response[\"status\"] == \"Accepted\":\n  1140\u2192                            accepted = True\n  1141\u2192                        elif response[\"status\"] == \"Invalid\":\n  1142\u2192                            summary = response.get(\n  1143\u2192                                \"statusSummary\", \"No details provided\"\n  1144\u2192                            )\n  1145\u2192                            raise BriefcaseCommandError(\n  1146\u2192                                f\"Notarization was rejected: {summary}\\n\"\n  1147\u2192                                + \"\\n\".join(\n  1148\u2192                                    f\"\"\"\n  1149\u2192    * ({issue.get('severity', \"?\")}) {issue.get('path')} [{issue.get('architecture', \"unknown architecture\")}]\n  1150\u2192      {issue.get('message')}\n  1151\u2192      {issue.get('docUrl', '(No additional help available)')}\"\"\"\n  1152\u2192                                    for issue in response.get(\"issues\", [])\n  1153\u2192                                )\n  1154\u2192                            )\n  1155\u2192                        else:\n  1156\u2192                            raise BriefcaseCommandError(\n  1157\u2192                                f\"Unexpected notarization status: {response['status']}\"\n  1158\u2192                            )\n  1159\u2192                    except subprocess.CalledProcessError as e:\n  1160\u2192                        if e.returncode == 69:\n  1161\u2192                            # Error code 69 (nice) indicates the server can't give a log\n  1162\u2192                            # response for the provided submission ID. We've already\n  1163\u2192                            # validated that it's a valid submission ID, so that means\n  1164\u2192                            # notarization isn't complete yet. Try again in 10 seconds.\n  1165\u2192                            time.sleep(10)\n  1166\u2192                        else:\n  1167\u2192                            self.tools.subprocess.output_error(e)\n  1168\u2192                            raise BriefcaseCommandError(\n  1169\u2192                                \"Unknown problem retrieving notarization status.\"\n  1170\u2192                            ) from e\n  1171\u2192\n  1172\u2192        except KeyboardInterrupt:\n  1173\u2192            raise NotarizationInterrupted(\"Notarization interrupted by user.\")\n  1174\u2192        else:\n  1175\u2192            filename = self.notarization_path(app)\n  1176\u2192            try:\n  1177\u2192