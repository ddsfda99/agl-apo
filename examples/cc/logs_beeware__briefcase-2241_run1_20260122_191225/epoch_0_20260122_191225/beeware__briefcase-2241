th space\\n\"\n   793\u2192    )\n   794\u2192\n   795\u2192    # Original app definitions haven't changed\n   796\u2192    assert myapp.requires == []\n   797\u2192    assert myapp.test_requires is None\n   798\u2192\n   799\u2192\n   800\u2192@pytest.mark.parametrize(\n   801\u2192    \"altsep, requirement, expected\",\n   802\u2192    [\n   803\u2192        (None, \"asdf/xcvb\", True),\n   804\u2192        (None, \"asdf>xcvb\", False),\n   805\u2192        (\">\", \"asdf/xcvb\", True),\n   806\u2192        (\">\", \"asdf>xcvb\", True),\n   807\u2192        (\">\", \"asdf+xcvb\", False),\n   808\u2192    ],\n   809\u2192)\n   810\u2192def test__is_local_path_altsep_respected(\n   811\u2192    altsep,\n   812\u2192    requirement,\n   813\u2192    expected,\n   814\u2192    monkeypatch,\n   815\u2192):\n   816\u2192    \"\"\"``os.altsep`` is included as a separator when available.\"\"\"\n   817\u2192    monkeypatch.setattr(os, \"sep\", \"/\")\n   818\u2192    monkeypatch.setattr(os, \"altsep\", altsep)\n   819\u2192    assert _is_local_path(requirement) is expected\n   820\u2192\n   821\u2192\n   822\u2192def _test_app_requirements_paths(\n   823\u2192    create_command,\n   824\u2192    myapp,\n   825\u2192    app_requirements_path,\n   826\u2192    tmp_path,\n   827\u2192    requirement,\n   828\u2192):\n   829\u2192    \"\"\"A utility method that can be used to test expansion of a specific requirement.\"\"\"\n   830\u2192    if isinstance(requirement, tuple):\n   831\u2192        requirement, converted = requirement\n   832\u2192    else:\n   833\u2192        converted = requirement\n   834\u2192    myapp.requires = [\"first\", requirement, \"third\"]\n   835\u2192\n   836\u2192    create_command.install_app_requirements(myapp, test_mode=False)\n   837\u2192    with app_requirements_path.open(encoding=\"utf-8\") as f:\n   838\u2192        assert f.read() == (\n   839\u2192            \"\\n\".join(\n   840\u2192                [\n   841\u2192                    GENERATED_DATETIME,\n   842\u2192                    \"first\",\n   843\u2192                    converted.format(tmp_path),\n   844\u2192                    \"third\",\n   845\u2192                ]\n   846\u2192            )\n   847\u2192            + \"\\n\"\n   848\u2192        )\n   849\u2192\n   850\u2192    # Original app definitions haven't changed\n   851\u2192    assert myapp.requires == [\"first\", requirement, \"third\"]\n   852\u2192    assert myapp.test_requires is None\n   853\u2192\n   854\u2192\n   855\u2192@pytest.mark.parametrize(\n   856\u2192    \"requirement\",\n   857\u2192    [\n   858\u2192        # Simple PyPI package references\n   859\u2192        \"my-package\",\n   860\u2192        \"my-package==1.2.3\",\n   861\u2192        \"my-package<=1.2.3\",\n   862\u2192        # More complex PyPI references\n   863\u2192        \"my-package[optional]<=1.2.3\",\n   864\u2192        \"my-package[optional]<=1.2.3; python_version<3.7\",\n   865\u2192        # References to git packages\n   866\u2192        \"git+https://github.com/project/package\",\n   867\u2192        \"git+https://github.com/project/package#egg=my-package\",\n   868\u2192        \"git+https://github.com/project/package@deadbeef#egg=my-package\",\n   869\u2192        \"git+https://github.com/project/package@some-branch#egg=my-package\",\n   870\u2192        # URL references to wheels\n   871\u2192        \"http://example.com/path/to/mypackage-1.2.3-py3-none-any.whl\",\n   872\u2192        \"https://example.com/path/to/mypackage-1.2.3-py3-none-any.whl\",\n   873\u2192        # Zip file source installs\n   874\u2192        \"my-package @ https://example.com/path/to/1.2.3.zip\",\n   875\u2192    ],\n   876\u2192)\n   877\u2192def test_app_requirements_non_paths(\n   878\u2192    create_command,\n   879\u2192    myapp,\n   880\u2192    app_requirements_path,\n   881\u2192    app_requirements_path_index,\n   882\u2192    tmp_path,\n   883\u2192    requirement,\n   884\u2192    mock_now,