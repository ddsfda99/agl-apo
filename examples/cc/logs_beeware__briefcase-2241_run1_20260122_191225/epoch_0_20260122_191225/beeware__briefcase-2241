elf._stream_app_logs(\n   451\u2192                app,\n   452\u2192                popen=log_popen,\n   453\u2192                test_mode=test_mode,\n   454\u2192                clean_filter=macOS_log_clean_filter,\n   455\u2192                clean_output=True,\n   456\u2192                stop_func=lambda: is_process_dead(app_pid),\n   457\u2192                log_stream=True,\n   458\u2192            )\n   459\u2192        except subprocess.CalledProcessError:\n   460\u2192            raise BriefcaseCommandError(f\"Unable to start app {app.app_name}.\")\n   461\u2192        finally:\n   462\u2192            # Ensure the App also terminates when exiting\n   463\u2192            if app_pid:  # pragma: no-cover-if-is-py310\n   464\u2192                with suppress(ProcessLookupError):\n   465\u2192                    self.tools.os.kill(app_pid, SIGTERM)\n   466\u2192\n   467\u2192\n   468\u2192def is_mach_o_binary(path):  # pragma: no-cover-if-is-windows\n   469\u2192    \"\"\"Determine if the file at the given path is a Mach-O binary.\n   470\u2192\n   471\u2192    :param path: The path to check\n   472\u2192    :returns: True if the file at the given location is a Mach-O binary.\n   473\u2192    \"\"\"\n   474\u2192    # A binary is any file that is executable, or has a suffix from a known list\n   475\u2192    if os.access(path, os.X_OK) or path.suffix.lower() in {\".dylib\", \".o\", \".so\", \"\"}:\n   476\u2192        # File is a binary; read the file magic to determine if it's Mach-O.\n   477\u2192        with path.open(\"rb\") as f:\n   478\u2192            magic = f.read(4)\n   479\u2192            return magic in (\n   480\u2192                b\"\\xca\\xfe\\xba\\xbe\",\n   481\u2192                b\"\\xcf\\xfa\\xed\\xfe\",\n   482\u2192                b\"\\xce\\xfa\\xed\\xfe\",\n   483\u2192                b\"\\xbe\\xba\\xfe\\xca\",\n   484\u2192                b\"\\xfe\\xed\\xfa\\xcf\",\n   485\u2192                b\"\\xfe\\xed\\xfa\\xce\",\n   486\u2192            )\n   487\u2192    else:\n   488\u2192        # Not a binary\n   489\u2192        return False\n   490\u2192\n   491\u2192\n   492\u2192class macOSSigningMixin:\n   493\u2192    def __init__(self, *args, **kwargs):\n   494\u2192        super().__init__(*args, **kwargs)\n   495\u2192\n   496\u2192        # External service APIs.\n   497\u2192        # These are abstracted to enable testing without patching.\n   498\u2192        self.get_identities = get_identities\n   499\u2192\n   500\u2192    def entitlements_path(self, app: AppConfig):  # pragma: no-cover-if-is-windows\n   501\u2192        return self.bundle_path(app) / self.path_index(app, \"entitlements_path\")\n   502\u2192\n   503\u2192    def select_identity(\n   504\u2192        self,\n   505\u2192        identity: str | None = None,\n   506\u2192        app_identity: SigningIdentity | None = None,\n   507\u2192        allow_adhoc: bool = True,\n   508\u2192    ) -> SigningIdentity:\n   509\u2192        \"\"\"Get the codesigning identity to use.\n   510\u2192\n   511\u2192        This can be either an application codesigning identity, or an installer\n   512\u2192        identity. An installer identity must be from the same Team ID as the application\n   513\u2192        identity.\n   514\u2192\n   515\u2192        :param identity: A pre-specified identity (either the 40-digit hex checksum, or\n   516\u2192            the string name of the identity). If provided, it will be validated against\n   517\u2192            the list of available identities to confirm that it is a valid codesigning\n   518\u2192            identity.\n   519\u2192        :param app_identity: The application signing identity to match when producing an\n   520\u2192            installer identity. Only non-app signing identities that match the team ID\n   521\u2192            for the ``app_identity`` will be presented as options. Omit this value to\n   522\u2192            select an app signing identity.\n   523\u2192        :param allow_adhoc: Should the adhoc identities be allowed?\n   524\u2192        :returns: The final identity to use\n   525\u2192        \"\"\"\n   526\u2192        # If the adhoc identity is allowed, add it first so it appears first in the list\n   527\u2192        # of options.\n   528\u2192        identities = {}\n   529\u2192        if allow_adhoc:\n   530\u2192            identities[\"-\"] = ADHOC_IDENTITY_NAME\n   531\u2192\n   532\u2192        # Obtain the valid codesigning identities. These are the identities that could\n   533\u2192        # be used for app signing.\n   534\u2192        identities.update(self.get_identities(self.tools, \"codesigning\"))\n   535\u2192\n   536\u2192        if app_identity:\n   537\u2192            ident_type = \"installer\"\n   538\u2192            ident_option = \"--installer-identity\"\n   539\u2192            # There's no way to explicitly request a list of installer identities. As a\n   540\u2192            # workaround, get the full, unfiltered list of all signing identities; then\n   541\u2192            # remove any identity that:\n   542\u2192            # 1. From a different team to the provided app identity; or\n   543\u2192            # 2. Appears on the list of app signing identities.\n   544\u2192            app_identities = identities\n   545\u2192            identities = {\n   546\u2192                key: name\n   547\u2192                for key, name in self.get_identities(self.tools).items()\n   548\u2192                if SigningIdentity.team_id_from_name(name) == app_identity.team_id\n   549\u2192                and key not in app_identities\n   550\u2192            }\n   551\u2192\n   552\u2192            if not identities:\n   553\u2192                raise BriefcaseCommandError(\n   554\u2192                    f\"No installer signing identities for team {app_identity.team_id} could be found.\"\n   555\u2192                )\n   556\u2192        else:\n   557\u2192            ident_type = \"application\"\n   558\u2192            ident_option = \"--identity\"\n   559\u2192\n   560\u2192        if identity:\n   561\u2192            try:\n   562\u2192                # Try to look up the identity as a hex checksum\n   563\u2192                identity_name = identities[identity]\n   564\u2192                return SigningIdentity(id=identity, name=identity_name)\n   565\u2192            except KeyError as e:\n   566\u2192                # Try to look up the identity as readable name\n   567\u2192                try:\n   568\u2192                    reverse_lookup = {name: ident for ident, name in identities.items()}\n   569\u2192                    identity_id = reverse_lookup[identity]\n   570\u2192                    return SigningIdentity(id=identity_id, name=identity)\n   571\u2192                except KeyError:\n   572\u2192                    # Not found as an ID or name\n   573\u2192                    raise BriefcaseCommandError(\n   574\u2192                        f\"Invalid {ident_type} signing identity {identity}\"\n   575\u2192                    ) from e\n   576\u2192\n   577\u2192        identity = self.console.selection_question(\n   578\u2192            intro=f\"Select {ident_type} signing identity to use:\",\n   579\u2192            description=f\"{ident_type.title()} Signing Identity\",\n   580\u2192            options=identities,\n   581\u2192        )\n   582\u2192        identity_name = identities[identity]\n   583\u2192        if identity == \"-\":\n   584\u2192            self.console.info(\n   585\u2192                f\"\"\"\n   586\u2192In future, you could specify this signing identity by using:\n   587\u2192\n   588\u2192    $ briefcase {self.command} macOS {self.output_format} --adhoc-sign ...\n   589\u2192\n   590\u2192\"\"\"\n   591\u2192            )\n   592\u2192        else:\n   593\u2192            self.console.info(\n   594\u2192                f\"\"\"\n   595\u2192In future, you could specify this signing identity by using:\n   596\u2192\n   597\u2192    $ briefcase {self.command} macOS {self.output_format} {ident_option} {identity} ...\n   598\u2192\n   599\u2192or\n   600\u2192\n   601\u2192    $ briefcase {self.command} macOS {self.output_format} {ident_option} \"{identity_name}\" ...\n   602\u2192\n   603\u2192\"\"\"\n   604\u2192            )\n   605\u2192\n   606\u2192        return SigningIdentity(id=identity, name=identity_name)\n   607\u2192\n   608\u2192    def sign_file(\n   609\u2192        self,\n   610\u2192        path: Path,\n   611\u2192        identity: SigningIdentity,\n   612\u2192        entitlements: Path | None = None,\n   613\u2192    ):\n   614\u2192        \"\"\"Code sign a file.\n   615\u2192\n   616\u2192        :param path: The path to the file to sign.\n   617\u2192        :param identity: The code signing identity to use.\n   618\u2192        :param entitlements: The path to the entitlements file to use.\n   619\u2192        \"\"\"\n   620\u2192        options = \"runtime\" if not identity.is_adhoc else None\n   621\u2192        process_command = [\"codesign\", path, \"--sign\", identity.id, \"--force\"]\n   622\u2192\n   623\u2192        if entitlements:\n   624\u2192            process_command.append(\"--entitlements\")\n   625\u2192            process_command.append(entitlements)\n   626\u2192        if options:\n   627\u2192            process_command.append(\"--options\")\n   628\u2192            process_command.append(options)\n   629\u2192\n   630\u2192        self.console.verbose(f\"Signing {Path(path).relative_to(self.base_path)}\")\n   631\u2192\n   632\u2192        try:\n   633\u2192            self.tools.subprocess.run(\n   634\u2192                process_command,\n   635\u2192                stderr=subprocess.PIPE,\n   636\u2192                check=True,\n   637\u2192            )\n   638\u2192        except subprocess.CalledProcessError as e:\n   639\u2192            errors = e.stderr\n   640\u2192            if any(\n   641\u2192                msg in errors\n   642\u2192                for msg in [\n   643\u2192                    # File has a signature matching the Mach-O magic,\n   644\u2192                    # but isn't actually a Mach-O binary\n   645\u2192                    \"unsupported format for signature\",\n   646\u2192                    # A folder named ``.framework`, but not actually a macOS Framework`\n   647\u2192                    \"bundle format unrecognized, invalid, or unsuitable\",\n   648\u2192                ]\n   649\u2192            ):\n   650\u2192                # We should not be signing this in the first place\n   651\u2192                self.console.verbose(\n   652\u2192                    f\"... {Path(path).relative_to(self.base_path)} does not require a signature\"\n   653\u2192                )\n   654\u2192                return\n   655\u2192            else:\n   656\u2192                raise BriefcaseCommandError(f\"Unable to code sign {path}.\")\n   657\u2192\n   658\u2192    def sign_app(\n   659\u2192        self,\n   660\u2192        app: AppConfig,\n   661\u2192        identity: SigningIdentity,\n   662\u2192    ):  # pragma: no-cover-if-is-windows\n   663\u2192        \"\"\"Sign an entire app with a specific identity.\n   664\u2192\n   665\u2192        :param app: The app to sign\n   666\u2192        :param identity: The signing identity to use\n   667\u2192        \"\"\"\n   668\u2192        bundle_path = self.binary_path(app)\n   669\u2192        resources_path = bundle_path / \"Contents/Resources\"\n   670\u2192        frameworks_path = bundle_path / \"Contents/Frameworks\"\n   671\u2192\n   672\u2192        sign_targets = []\n   673\u2192\n   674\u2192        for folder in (resources_path, frameworks_path):\n   675\u2192            # Sign all Mach-O executable objects\n   676\u2192            sign_targets.extend(\n   677\u2192                path\n   678\u2192                for path in folder.rglob(\"*\")\n   679\u2192                if not path.is_dir()\n   680\u2192                and not path.is_symlink()\n   681\u2192                and is_mach_o_binary(path)\n   682\u2192            )\n   683\u2192\n   684\u2192            # Sign all embedded frameworks\n   685\u2192            sign_targets.extend(folder.rglob(\"*.framework\"))\n   686\u2192\n   687\u2192            # Sign all embedded app objects\n   688\u2192            sign_targets.extend(folder.rglob(\"*.app\"))\n   689\u2192\n   690\u2192        # Sign the bundle path itself\n   691\u2192        sign_targets.append(bundle_path)\n   692\u2192\n   693\u2192        # Run signing through a ThreadPoolExecutor so that they run in parallel. We need\n   694\u2192        # to ensure that objects are signed from the inside out (i.e., a folder must be\n   695\u2192        # signed *after* all it's contents has been signed; files in a folder must be\n   696\u2192        # signed *after* all subfolders in that same folder); and an app that uses a\n   697\u2192        # library must be signed *after* all the libraries it uses. See\n   698\u2192        # https://developer.apple.com/documentation/xcode/creating-distribution-signed-code-for-the-mac#Determine-the-signing-order\n   699\u2192        # for details.\n   700\u2192        #\n   701\u2192        # To do this, we utilize grouping on a sorted list, and rely on the fact that a\n   702\u2192        # new group is created whenever the grouping key changes. The sorting process\n   703\u2192        # guarantees depth-first ordering; the grouping is applied over the sorted\n   704\u2192        # content, ensuring that that folders are signed before files.\n   705\u2192        #\n   706\u2192        # This approach isn't perfect. It will fail if there's an embedded app that uses\n   707\u2192        # a library in a different framework, and the app is lexically sorted before the\n   708\u2192        # library (e.g. if app_packages/foobar/Alpha.framework/Helpers/My App.app\n   709\u2192        # depends on app_packages/footbar/Beta.framework/libbeta). However, if you're\n   710\u2192        # embedding apps in frameworks in Python libraries that are installed by pip,\n   711\u2192        # you're already making poor life choices; this approach is enough to satisfy\n   712\u2192        # the one use of app-in-framework embedding that we're aware of (PySide).\n   713\u2192        progress_bar = self.console.progress_bar()\n   714\u2192        task_id = progress_bar.add_task(\"Signing App\", total=len(sign_targets))\n   715\u2192        with progress_bar:\n   716\u2192            for group in self.tools.file.sorted_depth_first_groups(sign_targets):\n   717\u2192                with concurrent.futures.ThreadPoolExecutor(\n   718\u2192                    max_workers=1 if self.console.is_deep_debug else None\n   719\u2192                ) as executor:\n   720\u2192                    futures = []\n   721\u2192                    for path in group:\n   722\u2192                        future = executor.submit(\n   723\u2192                            self.sign_file,\n   724\u2192                            path,\n   725\u2192                            entitlements=self.entitlements_path(app),\n   726\u2192                            identity=identity,\n   727\u2192                        )\n   728\u2192                        futures.append(future)\n   729\u2192                    for future in concurrent.futures.as_completed(futures):\n   730\u2192                        progress_bar.update(task_id, advance=1)\n   731\u2192                        if future.exception():\n   732\u2192                            raise future.exception()\n   733\u2192\n   734\u2192\n   735\u2192class macOSPackageMixin(macOSSigningMixin):\n   736\u2192    ADHOC_SIGN_HELP = (\n   737\u2192        \"Perform ad-hoc signing on the app. \"\n   738\u2192        \"The app will only run on this machine; it cannot be redistributed to others\"\n   739\u2192    )\n   740\u2192    IDENTITY_HELP = (\n   741\u2192        \"The code signing identity to use; either the 40-digit hex \"\n   742\u2192        \"checksum, or the full name of the identity\"\n   743\u2192    )\n   744\u2192\n   745\u2192    @property\n   746    def packaging_formats(self):\n   747\u2192        return [\"zip\", \"dmg\", \"pkg\"]\n   748\u2192\n   749\u2192    @property\n   750\u2192    def default_packaging_format(self):\n   751\u2192        # The default changes depending on whether the app is a console app or a GUI app\n   752\u2192        return None\n   753\u2192\n   754\u2192    def notarization_path(self, app: AppConfig) -> Path:\n   755\u2192        \"\"\"The file that is submitted for notarization.\"\"\"\n   756\u2192        if app.packaging_format == \"zip\":\n   757\u2192            # Notarization for bare .app's is applied to the binary, not the\n   758\u2192            # distribution artefact, with the distribution artefact being\n   759\u2192            # created after notarization has completed.\n   760\u2192            return self.binary_path(app)\n   761\u2192        else:\n   762\u2192            return self.distribution_path(app)\n   763\u2192\n   764\u2192    def distribution_path(self, app: AppConfig) -> Path:\n   765\u2192        \"\"\"The path to the final distribution artefact.\"\"\"\n   766\u2192        if app.packaging_format == \"zip\":\n   767\u2192            return self.dist_path / f\"{app.formal_name}-{app.version}.app.zip\"\n   768\u2192        elif app.packaging_format == \"pkg\":\n   769\u2192            return self.dist_path / f\"{app.formal_name}-{app.version}.pkg\"\n   770\u2192        else:\n   771\u2192            return self.dist_path / f\"{app.formal_name}-{app.version}.dmg\"\n   772\u2192\n   773\u2192    def add_options(self, parser):\n   774\u2192        super().add_options(parser)\n   775\u2192\n   776\u2192        # --no-sign-installer and --installer-identity are mutually exclusive\n   777\u2192        installer_signing_group = parser.add_mutually_exclusive_group()\n   778\u2192        installer_signing_group.add_argument(\n   779\u2192            \"--no-sign-installer\",\n   780\u2192            dest=\"sign_installer\",\n   781\u2192            help=\"Do not sign the installer. Ignored unless using PKG format\",\n   782\u2192            action=\"store_false\",\n   783\u2192        )\n   784\u2192        installer_signing_group.add_argument(\n   785\u2192            \"--installer-identity\",\n   786\u2192            dest=\"installer_identity\",\n   787\u2192            help=(\n   788\u2192                \"The code signing identity to use for signing the installer. \"\n   789\u2192                \"Ignored unless using PKG format\"\n   790\u2192            ),\n   791\u2192            required=False,\n   792\u2192        )\n   793\u2192\n   794\u2192        # We use store_const:False rather than store_false so that the\n   795\u2192        # \"unspecified\" value is None, rather than True, allowing for\n   796\u2192        # a \"default behavior\" interpretation when `--adhoc-sign` is specified\n   797\u2192        parser.add_argument(\n   798\u2192            \"--no-notarize\",\n   799\u2192            dest=\"notarize_app\",\n   800\u2192            action=\"store_const\",\n   801\u2192            const=False,\n   802\u2192            help=\"Disable notarization for the app\",\n   803\u2192        )\n   804\u2192        parser.add_argument(\n   805\u2192            \"--resume\",\n   806\u2192            dest=\"submission_id\",\n   807\u2192            help=\"The notarization submission ID to resume\",\n   808\u2192            required=False,\n   809\u2192        )\n   810\u2192\n   811\u2192    def verify_tools(self):\n   812\u2192        # Require the Xcode command line tools.\n   813\u2192        XcodeCliTools.verify(tools=self.tools)\n   814\u2192\n   815\u2192        # Verify superclass tools *after* xcode. This ensures we get the\n   816\u2192        # git check *after* the xcode check.\n   817\u2192        super().verify_tools()\n   818\u2192\n   819\u2192    def __init__(self, *args, **kwargs):\n   820\u2192        super().__init__(*args, **kwargs)\n   821\u2192\n   822\u2192        # External service APIs.\n   823\u2192        # These are abstracted to enable testing without patching.\n   824\u2192        self.dmgbuild = dmgbuild\n   825\u2192\n   826\u2192    def verify_app(self, app):\n   827\u2192        super().verify_app(app)\n   828\u2192\n   829\u2192        if app.console_app:\n   830\u2192            if app.packaging_format is None:\n   831                app.packaging_format = \"pkg\"\n   832\u2192            elif app.packaging_format != \"pkg\":\n   833\u2192                raise BriefcaseCommandError(\n   834\u2192                    \"macOS console apps must be distributed in PKG format.\"\n   835\u2192                )\n   836\u2192        elif app.packaging_format is None:\n   837\u2192            app.packaging_format = \"dmg\"\n   838\u2192\n   839\u2192    def clean_dist_folder(self, app, **options):\n   840\u2192        \"\"\"Clean up any existing artefacts in the dist folder.\n   841\u2192\n   842\u2192        If we are resuming a notarization session verify that the artefact exists,\n   843\u2192        but *do not* delete it.\n   844\u2192\n   845\u2192        :param app: The app being packaged.\n   846\u2192        :param submission_id: The notarization submission being resumed.\n   847\u2192        :param options: Any additional arguments passed to the package command.\n   848\u2192        \"\"\"\n   849\u2192        if options.get(\"submission_id\"):\n   850\u2192            if not self.notarization_path(app).exists():\n   851\u2192                raise BriefcaseCommandError(\n   852\u2192                    \"Notarization cannot be resumed, as the notarization artefact \"\n   853\u2192                    \"associated with this app \"\n   854\u2192                    f\"({self.notarization_path(app).relative_to(self.base_path)}) \"\n   855\u2192                    \"does not exist.\"\n   856\u2192                )\n   857\u2192\n   858\u2192            # If the packaging format is zip, the distribution artefact is created\n   859\u2192            # *after* completion of notarization. If there's an existing distribution\n   860\u2192            # artefact, it must be from a previous notarization/stapling attempt.\n   861\u2192            if app.packaging_format == \"zip\":\n   862\u2192                super().clean_dist_folder(app, **options)\n   863\u2192        else:\n   864\u2192            super().clean_dist_folder(app, **options)\n   865\u2192\n   866\u2192    def ditto_archive(\n   867\u2192        self,\n   868\u2192        app_filename: Path,\n   869\u2192        archive_filename: Path,\n   870\u2192    ):  # pragma: no-cover-if-not-macos\n   871\u2192        \"\"\"Create an archive of an app using ditto.\n   872\u2192\n   873\u2192        Although the archive format is \".zip\", we can't use standard Zip tools, as they\n   874\u2192        don't preserve UTF-8 encoding on all resources. Instead, we need to use `ditto`,\n   875\u2192        which is provided as part of macOS developer tooling. See\n   876\u2192        https://forums.developer.apple.com/forums/thread/116831 and\n   877\u2192        https://developer.apple.com/library/archive/technotes/tn2206/_index.html for\n   878\u2192        more details.\n   879\u2192\n   880\u2192        :param app_filename: The filename of the app to archive\n   881\u2192        :param archive_filename: The filename of the archive to produce\n   882\u2192        \"\"\"\n   883\u2192        try:\n   884\u2192            self.tools.subprocess.run(\n   885\u2192                [\n   886\u2192                    \"/usr/bin/ditto\",\n   887\u2192                    \"-c\",\n   888\u2192                    \"-k\",\n   889\u2192                    \"--sequesterRsrc\",\n   890\u2192                    \"--keepParent\",\n   891\u2192                    app_filename,\n   892\u2192                    archive_filename,\n   893\u2192                ],\n   894\u2192                check=True,\n   895\u2192            )\n   896\u2192        except subprocess.CalledProcessError as e:\n   897\u2192            raise BriefcaseCommandError(f\"Unable to archive {app_filename.name}\") from e\n   898\u2192\n   899\u2192    def notarize(\n   900\u2192        self,\n   901\u2192        app: AppConfig,\n   902\u2192        identity: SigningIdentity,\n   903\u2192        installer_identity: SigningIdentity | None = None,\n   904\u2192    ):\n   905\u2192        \"\"\"Submit a file for notarization, and wait for that notarization to be completed.\n   906\u2192\n   907\u2192        :param app: The app to notarize.\n   908\u2192        :param identity: The code signing used to notarize the app.\n   909\u2192        :param installer_identity: The signing identity to use when signing the\n   910\u2192            installer. Optional unless the packaging format is ``pkg``.\n   911\u2192        \"\"\"\n   912\u2192        # Determine the arguments that would be needed to reproduce this notarization\n   913\u2192        if installer_identity:\n   914\u2192            identity_args = (\n   915\u2192                f\"--identity {identity.id} \"\n   916\u2192                f\"--installer-identity {installer_identity.id}\"\n   917\u2192            )\n   918\u2192            notarization_identity = installer_identity\n   919\u2192        else:\n   920\u2192            identity_args = f\"--identity {identity.id}\"\n   921\u2192            notarization_identity = identity\n   922\u2192\n   923\u2192        format_args = f\"-p {app.packaging_format}\"\n   924\u2192\n   925\u2192        # Submit the app for notarization\n   926\u2192        submission_id = self.submit_notarization(app, identity=notarization_identity)\n   927\u2192\n   928\u2192        self.console.warning(\n   929\u2192            f\"\"\"\n   930\u2192Briefcase will now wait for Apple to approve the