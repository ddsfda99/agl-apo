l of other-arch binaries fails, an exception is raised.\"\"\"\n   665\u2192    bundle_path = tmp_path / \"base_path/build/first-app/macos/app\"\n   666\u2192\n   667\u2192    # Create pre-existing other-arch content\n   668\u2192    create_installed_package(bundle_path / \"app_packages.x86_64\", \"legacy\")\n   669\u2192\n   670\u2192    create_command.tools.host_arch = \"arm64\"\n   671\u2192    first_app_templated.requires = [\"first\", \"second==1.2.3\", \"third>=3.2.1\"]\n   672\u2192\n   673\u2192    # Mock the result of finding the binary packages - 2 of the packages are binary;\n   674\u2192    # the version on the loosely specified package doesn't match the lower bound.\n   675\u2192    create_command.find_binary_packages = mock.Mock(\n   676\u2192        return_value=[\n   677\u2192            (\"second\", \"1.2.3\"),\n   678\u2192            (\"third\", \"3.4.5\"),\n   679\u2192        ]\n   680\u2192    )\n   681\u2192\n   682\u2192    # Mock the thin command so we can confirm it was invoked.\n   683\u2192    create_command.thin_app_packages = mock.Mock()\n   684\u2192\n   685\u2192    # Mock the merge command so we can confirm it was invoked.\n   686\u2192    create_command.merge_app_packages = mock.Mock()\n   687\u2192\n   688\u2192    # Mock a failure on the second install\n   689\u2192    create_command.tools[first_app_templated].app_context.run.side_effect = [\n   690\u2192        None,\n   691\u2192        subprocess.CalledProcessError(returncode=1, cmd=\"pip\"),\n   692\u2192    ]\n   693\u2192\n   694\u2192    # Install the requirements; this will raise an error\n   695\u2192    with pytest.raises(\n   696\u2192        BriefcaseCommandError,\n   697\u2192        match=(\n   698\u2192            r\"Unable to install requirements\\. This may be because one of your\\n\"\n   699\u2192            r\"requirements is invalid, or because pip was unable to connect\\n\"\n   700\u2192            r\"to the PyPI server.\\n\"\n   701\u2192        ),\n   702\u2192    ):\n   703\u2192        create_command.install_app_requirements(first_app_templated, test_mode=False)\n   704\u2192\n   705\u2192    # We looked for binary packages in the host app_packages\n   706\u2192    create_command.find_binary_packages.assert_called_once_with(\n   707\u2192        bundle_path / \"app_packages.arm64\",\n   708\u2192        universal_suffix=\"_universal2\",\n   709\u2192    )\n   710\u2192\n   711\u2192    # A request was made to install requirements\n   712\u2192    assert create_command.tools[first_app_templated].app_context.run.mock_calls == [\n   713\u2192        # First call is to install the initial packages on the host arch\n   714\u2192        mock.call(\n   715\u2192            [\n   716\u2192                sys.executable,\n   717\u2192                \"-u\",\n   718\u2192                \"-X\",\n   719\u2192                \"utf8\",\n   720\u2192                \"-m\",\n   721\u2192                \"pip\",\n   722\u2192                \"install\",\n   723\u2192                \"--disable-pip-version-check\",\n   724\u2192                \"--upgrade\",\n   725\u2192                \"--no-user\",\n   726\u2192                f\"--target={bundle_path / 'app_packages.arm64'}\",\n   727\u2192                \"--only-binary\",\n   728\u2192                \":all:\",\n   729\u2192                \"--platform\",\n   730\u2192                \"macosx_11_0_arm64\",\n   731\u2192                \"first\",\n   732\u2192                \"second==1.2.3\",\n   733\u2192                \"third>=3.2.1\",\n   734\u2192            ],\n   735\u2192            check=True,\n   736\u2192            encoding=\"UTF-8\",\n   737\u2192        ),\n   738\u2192        # Second call installs the binary packages for the other architecture;\n   739\u2192        # this is the call that failed.\n   740\u2192        mock.call(\n   741\u2192            [\n   742\u2192                sys.executable,\n   743\u2192                \"-u\",\n   744\u2192               