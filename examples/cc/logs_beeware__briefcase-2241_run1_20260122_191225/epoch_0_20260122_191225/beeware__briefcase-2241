n app.__dict__.items()\n   229\u2192            if key not in self.hidden_app_properties\n   230\u2192        }\n   231\u2192\n   232\u2192        # Remove the context items that describe the template\n   233\u2192        extra_context.pop(\"template\")\n   234\u2192        extra_context.pop(\"template_branch\")\n   235\u2192\n   236\u2192        # Augment with some extra fields.\n   237\u2192        extra_context.update(\n   238\u2192            {\n   239\u2192                # Ensure the output format is in the case we expect\n   240\u2192                \"format\": self.output_format.lower(),\n   241\u2192                # Properties of the generating environment\n   242\u2192                # The full Python version string, including minor and dev/a/b/c suffixes (e.g., 3.11.0rc2)\n   243\u2192                \"python_version\": platform.python_version(),\n   244\u2192                # The host architecture\n   245\u2192                \"host_arch\": self.tools.host_arch,\n   246\u2192                # Transformations of explicit properties into useful forms\n   247\u2192                \"class_name\": app.class_name,\n   248\u2192                \"module_name\": app.module_name,\n   249\u2192                \"package_name\": app.package_name,\n   250\u2192                \"bundle_identifier\": app.bundle_identifier,\n   251\u2192                # Properties that are a function of the execution\n   252\u2192                \"year\": date.today().strftime(\"%Y\"),\n   253\u2192                \"month\": date.today().strftime(\"%B\"),\n   254\u2192            }\n   255\u2192        )\n   256\u2192\n   257\u2192        # Add in any extra template context to support permissions\n   258\u2192        extra_context.update(self.permissions_context(app, self._x_permissions(app)))\n   259\u2192\n   260\u2192        # Add in any extra template context required by the output format.\n   261\u2192        extra_context.update(self.output_format_template_context(app))\n   262\u2192\n   263\u2192        # Create the platform directory (if it doesn't already exist)\n   264\u2192        output_path = self.bundle_path(app).parent\n   265\u2192        output_path.mkdir(parents=True, exist_ok=True)\n   266\u2192\n   267\u2192        self.generate_template(\n   268\u2192            template=app.template if app.template else self.app_template_url,\n   269\u2192            branch=app.template_branch,\n   270\u2192            output_path=output_path,\n   271\u2192            extra_context=extra_context,\n   272\u2192        )\n   273\u2192\n   274\u2192    def _unpack_support_package(self, support_file_path, support_path):\n   275\u2192        \"\"\"Unpack a support package into a specific location.\n   276\u2192\n   277\u2192        :param support_file_path: The path to the support file to be unpacked.\n   278\u2192        :param support_path: The path where support files should be unpacked.\n   279\u2192        \"\"\"\n   280\u2192        try:\n   281\u2192            with self.console.wait_bar(\"Unpacking support package...\"):\n   282\u2192                support_path.mkdir(parents=True, exist_ok=True)\n   283\u2192                self.tools.file.unpack_archive(\n   284\u2192                    support_file_path,\n   285\u2192                    extract_dir=support_path,\n   286\u2192                )\n   287\u2192        except (shutil.ReadError, EOFError) as e:\n   288\u2192            raise InvalidSupportPackage(support_file_path) from e\n   289\u2192\n   290\u2192    def _cleanup_app_support_package(self, support_path):\n   291\u2192        \"\"\"The internal implementation of the app support cleanup method.\n   292\u2192\n   293\u2192        Guaranteed to only be invoked if the backend uses a support package, and the\n   294\u2192        support path exists.\n   295\u2192\n   296\u2192        :param support_path: The support path to clean up.\n   297\u2192        \"\"\"\n   298\u2192        with self.console.wait_bar(\"Removing existing support package...\"):\n   299\u2192            self.tools.shutil.rmtree(support_path)\n   300\u2192\n   301\u2192    def cleanup_app_support_package(self, app: AppConfig):\n   302\u2192        \"\"\"Clean up an existing application support package.\n   303\u2192\n   304\u2192        :param app: The config object for the app\n   305\u2192        \"\"\"\n   306\u2192        try:\n   307\u2192            support_path = self.support_path(app)\n   308\u2192        except KeyError:\n   309\u2192            # No cleanup required.\n   310\u2192            pass\n   311\u2192        else:\n   312\u2192            if support_path.exists():\n   313\u2192                self._cleanup_app_support_package(support_path)\n   314\u2192\n   315\u2192    def install_app_support_package(self, app: AppConfig):\n   316\u2192        \"\"\"Install the application support package.\n   317\u2192\n   318\u2192        :param app: The config object for the app\n   319\u2192        \"\"\"\n   320\u2192        try:\n   321\u2192            support_path = self.support_path(app)\n   322\u2192        except KeyError:\n   323\u2192            self.console.info(\"No support package required.\")\n   324\u2192        else:\n   325\u2192            support_file_path = self._download_support_package(app)\n   326\u2192            self._unpack_support_package(support_file_path, support_path)\n   327\u2192\n   328\u2192    def _download_support_package(self, app: AppConfig):\n   329\u2192        try:\n   330\u2192            # Work out if the app defines a custom override for\n   331\u2192            # the support package URL.\n   332\u2192            try:\n   333\u2192                support_package_url = app.support_package\n   334\u2192                custom_support_package = True\n   335\u2192                self.console.info(f\"Using custom support package {support_package_url}\")\n   336\u2192                try:\n   337\u2192                    # If the app has a custom support package *and* a support revision,\n   338\u2192                    # that's an error.\n   339\u2192                    app.support_revision\n   340\u2192                    self.console.warning(\n   341\u2192                        \"App specifies both a support package and a support revision; \"\n   342\u2192                        \"support revision will be ignored.\"\n   343\u2192                    )\n   344\u2192                except AttributeError:\n   345\u2192                    pass\n   346\u2192            except AttributeError:\n   347\u2192                # If the app specifies a support revision, use it;\n   348\u2192                # otherwise, use the support revision named by the template\n   349\u2192                try:\n   350\u2192                    support_revision = app.support_revision\n   351\u2192                except AttributeError:\n   352\u2192                    # No support revision specified; use the template-specified version\n   353\u2192                    try:\n   354\u2192                        support_revision = self.support_revision(app)\n   355\u2192                    except KeyError:\n   356\u2192                        # No template-specified support revision\n   357\u2192                        raise MissingSupportPackage(\n   358\u2192                            python_version_tag=self.python_version_tag,\n   359\u2192                            platform=self.platform,\n   360\u2192                            host_arch=self.tools.host_arch,\n   361\u2192                            is_32bit=self.tools.is_32bit_python,\n   362\u2192                        )\n   363\u2192\n   364\u2192                support_package_url = self.support_package_url(support_revision)\n   365\u2192                custom_support_package = False\n   366\u2192                self.console.info(f\"Using support package {support_package_url}\")\n   367\u2192\n   368\u2192            if support_package_url.startswith((\"https://\", \"http://\")):\n   369\u2192                if custom_support_package:\n   370\u2192                    # If the support package is custom, cache it using a hash of\n   371\u2192                    # the download URL. This is needed to differentiate to support\n   372\u2192                    # packages with the same filename, served at different URLs.\n   373\u2192                    # (or a custom package that collides with an official package name)\n   374\u2192                    download_path = (\n   375\u2192                        self.data_path\n   376\u2192                        / \"support\"\n   377\u2192                        / hashlib.sha256(\n   378\u2192                            support_package_url.encode(\"utf-8\")\n   379\u2192                        ).hexdigest()\n   380\u2192                    )\n   381\u2192                else:\n   382\u2192                    download_path = self.data_path / \"support\"\n   383\u2192\n   384\u2192                # Download the support file, caching the result\n   385\u2192                # in the user's briefcase support cache directory.\n   386\u2192                return self.tools.file.download(\n   387\u2192                    url=support_package_url,\n   388\u2192                    download_path=download_path,\n   389\u2192                    role=\"support package\",\n   390\u2192                )\n   391\u2192            else:\n   392\u2192                return Path(support_package_url)\n   393\u2192        except MissingNetworkResourceError as e:\n   394\u2192            # If there is a custom support package, report the missing resource as-is.\n   395\u2192            if custom_support_package:\n   396\u2192                raise\n   397\u2192            else:\n   398\u2192                raise MissingSupportPackage(\n   399\u2192                    python_version_tag=self.python_version_tag,\n   400\u2192                    platform=self.platform,\n   401\u2192                    host_arch=self.tools.host_arch,\n   402\u2192                    is_32bit=self.tools.is_32bit_python,\n   403\u2192                ) from e\n   404\u2192\n   405\u2192    def cleanup_stub_binary(self, app: AppConfig):\n   406\u2192        \"\"\"Clean up an existing application support package.\n   407\u2192\n   408\u2192        :param app: The config object for the app\n   409\u2192        \"\"\"\n   410\u2192        with self.console.wait_bar(\"Removing existing stub binary...\"):\n   411\u2192            self.binary_executable_path(app).unlink(missing_ok=True)\n   412\u2192            self.unbuilt_executable_path(app).unlink(missing_ok=True)\n   413\u2192\n   414\u2192    def install_stub_binary(self, app: AppConfig):\n   415\u2192        \"\"\"Install the application stub binary into the \"unbuilt\" location.\n   416\u2192\n   417\u2192        :param app: The config object for the app\n   418\u2192        \"\"\"\n   419\u2192        unbuilt_executable_path = self.unbuilt_executable_path(app)\n   420\u2192        stub_binary_path = self._download_stub_binary(app)\n   421\u2192\n   422\u2192        with self.console.wait_bar(\"Installing stub binary...\"):\n   423\u2192            # Ensure the folder for the stub binary exists\n   424\u2192            unbuilt_executable_path.parent.mkdir(exist_ok=True, parents=True)\n   425\u2192\n   426\u2192            # Install the stub binary into the unbuilt location.\n   427\u2192            # Allow for both raw and compressed artefacts.\n   428\u2192            try:\n   429\u2192                if self.tools.file.is_archive(stub_binary_path):\n   430\u2192                    self.tools.file.unpack_archive(\n   431\u2192                        stub_binary_path,\n   432\u2192                        extract_dir=unbuilt_executable_path.parent,\n   433\u2192                    )\n   434\u2192                elif stub_binary_path.is_file():\n   435\u2192                    self.tools.shutil.copyfile(\n   436\u2192                        stub_binary_path, unbuilt_executable_path\n   437\u