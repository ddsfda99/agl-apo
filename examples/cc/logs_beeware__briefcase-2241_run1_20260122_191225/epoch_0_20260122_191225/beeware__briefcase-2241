  414\u2192    assert (bundle_path / f\"app_packages.{other_arch}\").is_dir()\n   415\u2192\n   416\u2192    # An attempt was made thin the \"other\" arch packages.\n   417\u2192    create_command.thin_app_packages.assert_called_once_with(\n   418\u2192        bundle_path / f\"app_packages.{other_arch}\",\n   419\u2192        arch=other_arch,\n   420\u2192    )\n   421\u2192\n   422\u2192    # An attempt was made to merge packages.\n   423\u2192    create_command.merge_app_packages.assert_called_once_with(\n   424\u2192        target_app_packages=bundle_path\n   425\u2192        / \"First App.app\"\n   426\u2192        / \"Contents\"\n   427\u2192        / \"Resources\"\n   428\u2192        / \"app_packages\",\n   429\u2192        sources=[\n   430\u2192            bundle_path / f\"app_packages.{host_arch}\",\n   431\u2192            bundle_path / f\"app_packages.{other_arch}\",\n   432\u2192        ],\n   433\u2192    )\n   434\u2192\n   435\u2192\n   436\u2192def test_min_os_version(create_command, first_app_templated, tmp_path):\n   437\u2192    \"\"\"If the app specifies a min OS version, it is used for wheel installs.\"\"\"\n   438\u2192    create_command.tools.host_arch = \"arm64\"\n   439\u2192\n   440\u2192    bundle_path = tmp_path / \"base_path/build/first-app/macos/app\"\n   441\u2192\n   442\u2192    first_app_templated.requires = [\"first\", \"second==1.2.3\", \"third>=3.2.1\"]\n   443\u2192\n   444\u2192    # Set a minimum OS version.\n   445\u2192    first_app_templated.min_os_version = \"13.2\"\n   446\u2192\n   447\u2192    # Mock the result of finding the binary packages - 2 of the packages are binary;\n   448\u2192    # the version on the loosely specified package doesn't match the lower bound.\n   449\u2192    create_command.find_binary_packages = mock.Mock(\n   450\u2192        return_value=[\n   451\u2192            (\"second\", \"1.2.3\"),\n   452\u2192            (\"third\", \"3.4.5\"),\n   453\u2192        ]\n   454\u2192    )\n   455\u2192\