app_pid, SIGTERM)\n   466→\n   467→\n   468→def is_mach_o_binary(path):  # pragma: no-cover-if-is-windows\n   469→    \"\"\"Determine if the file at the given path is a Mach-O binary.\n   470→\n   471→    :param path: The path to check\n   472→    :returns: True if the file at the given location is a Mach-O binary.\n   473→    \"\"\"\n   474→    # A binary is any file that is executable, or has a suffix from a known list\n   475→    if os.access(path, os.X_OK) or path.suffix.lower() in {\".dylib\", \".o\", \".so\", \"\"}:\n   476→        # File is a binary; read the file magic to determine if it's Mach-O.\n   477→        with path.open(\"rb\") as f:\n   478→            magic = f.read(4)\n   479→            return magic in (\n   480→                b\"\\xca\\xfe\\xba\\xbe\",\n   481→                b\"\\xcf\\xfa\\xed\\xfe\",\n   482→                b\"\\xce\\xfa\\xed\\xfe\",\n   483→                b\"\\xbe\\xba\\xfe\\xca\",\n   484→                b\"\\xfe\\xed\\xfa\\xcf\",\n   485→                b\"\\xfe\\xed\\xfa\\xce\",\n   486→            )\n   487→    else:\n   488→        # Not a binary\n   489→        return False\n   490→\n   491→\n   492→class macOSSigningMixin:\n   493→    def __init__(self, *args, **kwargs):\n   494→        super().__init__(*args, **kwargs)\n   495→\n   496→        # External service APIs.\n   497→        # These are abstracted to enable testing without patching.\n   498→        self.get_identities = get_identities\n   499→\n   500→    def entitlements_path(self, app: AppConfig):  # pragma: no-cover-if-is-windows\n   501→        return self.bundle_path(app) / self.path_index(app, \"entitlements_path\")\n   502→\n   503→    def select_identity(\n   504→        self,\n   505→        identity: str | None = None,\n   506→        app_identity: SigningIdentity | None = None,\n   507→        allow_adhoc: bool = True,\n   508→    ) -> SigningIdentity:\n   509→        \"\"\"Get the codesigning identity to use.\n   510→\n   511→        This can be either an application codesigning identity, or an installer\n   512→        identity. An installer identity must be from the same Team ID as the application\n   513→        identity.\n   514→\n   515→        :param identity: A pre-specified identity (either the 40-digit hex checksum, or\n   516→            the string name of the identity). If provided, it will be validated against\n   517→            the list of available identities to confirm that it is a valid codesigning\n   518→            identity.\n   519→        :param app_identity: The application signing identity to match when producing an\n   520→            installer identity. Only non-app signing identities that match the team ID\n   521→            for the ``app_identity`` will be presented as options. Omit this value to\n   522→            select an app signing identity.\n   523→        :param allow_adhoc: Should the adhoc identities be allowed?\n   524→        :returns: The final identity to use\n   525→        \"\"\"\n   526→        # If the adhoc identity is allowed, add it first so it appears first in the list\n   527→        # of options.\n   528→        identities = {}\n   529→        if allow_adhoc:\n   530→            identities[\"-\"] = ADHOC_IDENTITY_NAME\n   531→\n   532→        # Obtain the valid codesigning identities. These are the identities that could\n   533→        # be used for app signing.\n   534→        identities.update(self.get_identities(self.tools, \"codesigning\"))\n   535→\n   536→        if app_identity:\n   537→            ident_type = \"installer\"\n   538→            ident_option = \"--installer-identity\"\n   539→            # There's no way to explicitly request a list of installer identities. As a\n   540→            # workaround, get the full, unfiltered list of all signing identities; then\n   541→            # remove any identity that:\n   542→            # 1. From a different team to the provided app identity; or\n   543→            # 2. Appears on the list of app signing identities.\n   544→            app_identities = identities\n   545→            identities = {\n   546→                key: name\n   547→                for key, name in self.get_identities(self.tools).items()\n   548→                if SigningIdentity.team_id_from_name(name) == app_identity.team_id\n   549→                and key not in app_identities\n   550→            }\n   551→\n   552→            if not identities:\n   553→                raise BriefcaseCommandError(\n   554→                    f\"No installer signing identities for team {app_identity.team_id} could be found.\"\n   555→                )\n   556→        else:\n   557→            ident_type = \"application\"\n   558→            ident_option = \"--identity\"\n   559→\n   560→        if identity:\n   561→            try:\n   562→                # Try to look up the identity as a hex checksum\n   563→                identity_name = identities[identity]\n   564→                return SigningIdentity(id=identity, name=identity_name)\n   565→            except KeyError as e:\n   566→                # Try to look up the identity as readable name\n   567→                try:\n   568→                    reverse_lookup = {name: ident for ident, name in identities.items()}\n   569→                    identity_id = reverse_lookup[identity]\n   570→                    return SigningIdentity(id=identity_id, name=identity)\n   571→                except KeyError:\n   572→                    # Not found as an ID or name\n   573→                    raise BriefcaseCommandError(\n   574→                        f\"Invalid {ident_type} signing identity {identity}\"\n   575→                    ) from e\n   576→\n   577→        identity = self.console.selection_question(\n   578→            intro=f\"Select {ident_type} signing identity to use:\",\n   579→            description=f\"{ident_type.title()} Signing Identity\",\n   580→            options=identities,\n   581→        )\n   582→        identity_name = identities[identity]\n   583→        if identity == \"-\":\n   584→            self.console.info(\n   585→                f\"\"\"\n   586→In future, you could specify this signing identity by using:\n   587→\n   588→    $ briefcase {self.command} macOS {self.output_format} --adhoc-sign ...\n   589→\n   590→\"\"\"\n   591→            )\n   592→        else:\n   593→            self.console.info(\n   594→                f\"\"\"\n   595→In future, you could specify this signing identity by using:\n   596→\n   597→    $ briefcase {self.command} macOS {self.output_format} {ident_option} {identity} ...\n   598→\n   599→or\n   600→\n   601→    $ briefcase {self.command} macOS {self.output_format} {ident_option} \"{identity_name}\" ...\n   602→\n   603→\"\"\"\n   604→            )\n   605→\n   606→        return SigningIdentity(id=identity, name=identity_name)\n   607→\n   608→    def sign_file(\n   609→        self,\n   610→        path: Path,\n   611→        identity: SigningIdentity,\n   612→        entitlements: Path | None = None,\n   613→    ):\n   614→        \"\"\"Code sign a file.\n   615→\n   616→        :param path: The path to the file to sign.\n   617→        :param identity: The code signing identity to use.\n   618→        :param entitlements: The path to the entitlements file to use.\n   619→        \"\"\"\n   620→        options = \"runtime\" if not identity.is_adhoc else None\n   621→        process_command = [\"codesign\", path, \"--sign\", identity.id, \"--force\"]\n   622→\n   623→        if entitlements:\n   624→            process_command.append(\"--entitlements\")\n   625→            process_command.append(entitlements)\n   626→        if options:\n   627→            process_command.append(\"--options\")\n   628→            process_command.append(options)\n   629→\n   630→        self.console.verbose(f\"Signing {Path(path).relative_to(self.base_path)}\")\n   631→\n   632→        try:\n   633→            self.tools.subprocess.run(\n   634→                process_command,\n   635→                stderr=subprocess.PIPE,\n   636→                check=True,\n   637→            )\n   638→        except subprocess.CalledProcessError as e:\n   639→            errors = e.stderr\n   640→            if any(\n   641→                msg in errors\n   642→                for msg in [\n   643→                    # File has a signature matching the Mach-O magic,\n   644→                    # but isn't actually a Mach-O binary\n   645→                    \"unsupported format for signature\",\n   646→                    # A folder named ``.framework`, but not actually a macOS Framework`\n   647→                    \"bundle format unrecognized, invalid, or unsuitable\",\n   648→                ]\n   649→            ):\n   650→                # We should not be signing this in the first place\n   651→                self.console.verbose(\n   652→                    f\"... {Path(path).relative_to(self.base_path)} does not require a signature\"\n   653→                )\n   654→                return\n   655→            else:\n   656→                raise BriefcaseCommandError(f\"Unable to code sign {path}.\")\n   657→\n   658→    def sign_app(\n   659→        self,\n   660→        app: AppConfig,\n   661→        identity: SigningIdentity,\n   662→    ):  # pragma: no-cover-if-is-windows\n   663→        \"\"\"Sign an entire app with a specific identity.\n   664→\n   665→        :param app: The app to sign\n   666→        :param identity: The signing identity to use\n   667→        \"\"\"\n   668→        bundle_path = self.binary_path(app)\n   669→        resources_path = bundle_path / \"Contents/Resources\"\n   670→        frameworks_path = bundle_path / \"Contents/Frameworks\"\n   671→\n   672→        sign_targets = []\n   673→\n   674→        for folder in (resources_path, frameworks_path):\n   675→            # Sign all Mach-O executable objects\n   676→            sign_targets.extend(\n   677→                path\n   678→                for path in folder.rglob(\"*\")\n   679→                if not path.is_dir()\n   680→                and not path.is_symlink()\n   681→                and is_mach_o_binary(path)\n   682→            )\n   683→\n   684→            # Sign all embedded frameworks\n   685→            sign_targets.extend(folder.rglob(\"*.framework\"))\n   686→\n   687→            # Sign all embedded app objects\n   688→            sign_targets.extend(folder.rglob(\"*.app\"))\n   689→\n   690→        # Sign the bundle path itself\n   691→        sign_targets.append(bundle_path)\n   692→\n   693→        # Run signing through a ThreadPoolExecutor so that they run in parallel. We need\n   694→        # to ensure that objects are signed from the inside out (i.e., a folder must be\n   695→        # signed *after* all it's contents has been signed; files in a folder must be\n   696→        # signed *after* all subfolders in that same folder); and an app that uses a\n   697→        # library must be signed *after* all the libraries it uses. See\n   698→        # https://developer.apple.com/documentation/xcode/creating-distribution-signed-code-for-the-mac#Determine-the-signing-order\n   699→        # for details.\n   700→        #\n   701→        # To do this, we utilize grouping on a sorted list, and rely on the fact that a\n   702→        # new group is created whenever the grouping key changes. The sorting process\n   703→        # guarantees depth-first ordering; the grouping is applied over the sorted\n   704→        # content, ensuring that that folders are signed before files.\n   705→        #\n   706→        # This approach isn't perfect. It will fail if there's an embedded app that uses\n   707→        # a library in a different framework, and the app is lexically sorted before the\n   708→        # library (e.g. if app_packages/foobar/Alpha.framework/Helpers/My App.app\n   709→        # depends on app_packages/footbar/Beta.framework/libbeta). However, if you're\n   710→        # embedding apps in frameworks in Python libraries that are installed by pip,\n   711→        # you're already making poor life choices; this approach is enough to satisfy\n   712→        # the one use of app-in-framework embedding that we're aware of (PySide).\n   713→        progress_bar = self.console.progress_bar()\n   714→        task_id = progress_bar.add_task(\"Signing App\", total=len(sign_targets))\n   715→        with progress_bar:\n   716→            for group in self.tools.file.sorted_depth_first_groups(sign_targets):\n   717→                with concurrent.futures.ThreadPoolExecutor(\n   718→                    max_workers=1 if self.console.is_deep_debug else None\n   719→                ) as executor:\n   720→                    futures = []\n   721→                    for path in group:\n   722→                        future = executor.submit(\n   723→                            self.sign_file,\n   724→                            path,\n   725→                            entitlements=self.entitlements_path(app),\n   726→                            identity=identity,\n   727→                        )\n   728→                        futures.append(future)\n   729→                    for future in concurrent.futures.as_completed(futures):\n   730→                        progress_bar.update(task_id, advance=1)\n   731→                        if future.exception():\n   732→                            raise future.exception()\n   733→\n   734→\n   735→class macOSPackageMixin(macOSSigningMixin):\n   736→    ADHOC_SIGN_HELP = (\n   737→        \"Perform ad-hoc signing on the app. \"\n   738→        \"The app will only run on this machine; it cannot be redistributed to others\"\n   739→    )\n   740→    IDENTITY_HELP = (\n   741→        \"The code signing identity to use; either the 40-digit hex \"\n   742→        \"checksum, or the full name of the identity\"\n   743→    )\n   744→\n   745→    @property\n   746    def packaging_formats(self):\n   747→        return [\"zip\", \"dmg\", \"pkg\"]\n   748→\n   749→    @property\n   750→    def default_packaging_format(self):\n   751→        # The default changes depending on whether the app is a console app or a GUI app\n   752→        return None\n   753→\n   754→    def notarization_path(self, app: AppConfig) -> Path:\n   755→        \"\"\"The file that is submitted for notarization.\"\"\"\n   756→        if app.packaging_format == \"zip\":\n   757→            # Notarization for bare .app's is applied to the binary, not the\n   758→            # distribution artefact, with the distribution artefact being\n   759→            # created after notarization has completed.\n   760→            return self.binary_path(app)\n   761→        else:\n   762→            return self.distribution_path(app)\n   763→\n   764→    def distribution_path(self, app: AppConfig) -> Path:\n   765→        \"\"\"The path to the final distribution artefact.\"\"\"\n   766→        if app.packaging_format == \"zip\":\n   767→            return self.dist_path / f\"{app.formal_name}-{app.version}.app.zip\"\n   768→        elif app.packaging_format == \"pkg\":\n   769→            return self.dist_path / f\"{app.formal_name}-{app.version}.pkg\"\n   770→        else:\n   771→            return self.dist_path / f\"{app.formal_name}-{app.version}.dmg\"\n   772→\n   773→    def add_options(self, parser):\n   774→        super().add_options(parser)\n   775→\n   776→        # --no-sign-installer and --installer-identity are mutually exclusive\n   777→        installer_signing_group = parser.add_mutually_exclusive_group()\n   778→        installer_signing_group.add_argument(\n   779→            \"--no-sign-installer\",\n   780→            dest=\"sign_installer\",\n   781→            help=\"Do not sign the installer. Ignored unless using PKG format\",\n   782→            action=\"store_false\",\n   783→        )\n   784→        installer_signing_group.add_argument(\n   785→            \"--installer-identity\",\n   786→            dest=\"installer_identity\",\n   787→            help=(\n   788→                \"The code signing identity to use for signing the installer. \"\n   789→                \"Ignored unless using PKG format\"\n   790→            ),\n   791→            required=False,\n   792→        )\n   793→\n   794→        # We use store_const:False rather than store_false so that the\n   795→        # \"unspecified\" value is None, rather than True, allowing for\n   796→        # a \"default behavior\" interpretation when `--adhoc-sign` is specified\n   797→        parser.add_argument(\n   798→            \"--no-notarize\",\n   799→            dest=\"notarize_app\",\n   800→            action=\"store_const\",\n   801→            const=False,\n   802→            help=\"Disable notarization for the app\",\n   803→        )\n   804→        parser.add_argument(\n   805→            \"--resume\",\n   806→            dest=\"submission_id\",\n   807→            help=\"The notarization submission ID to resume\",\n   808→            required=False,\n   809→        )\n   810→\n   811→    def verify_tools(self):\n   812→        # Require the Xcode command line tools.\n   813→        XcodeCliTools.verify(tools=self.tools)\n   814→\n   815→        # Verify superclass tools *after* xcode. This ensures we get the\n   816→        # git check *after* the xcode check.\n   817→        super().verify_tools()\n   818→\n   819→    def __init__(self, *args, **kwargs):\n   820→        super().__init__(*args, **kwargs)\n   821→\n   822→        # External service APIs.\n   823→        # These are abstracted to enable testing without patching.\n   824→        self.dmgbuild = dmgbuild\n   825→\n   826→    def verify_app(self, app):\n   827→        super().verify_app(app)\n   828→\n   829→        if app.console_app:\n   830→            if app.packaging_format is None:\n   831                app.packaging_format = \"pkg\"\n   832→            elif app.packaging_format != \"pkg\":\n   833→                raise BriefcaseCommandError(\n   834→                    \"macOS console apps must be distributed in PKG format.\"\n   835→                )\n   836→        elif app.packaging_format is None:\n   837→            app.packaging_format = \"dmg\"\n   838→\n   839→    def clean_dist_folder(self, app, **options):\n   840→        \"\"\"Clean up any existing artefacts in the dist folder.\n   841→\n   842→        If we are resuming a notarization session verify that the artefact exists,\n   843→        but *do not* delete it.\n   844→\n   845→        :param app: The app being packaged.\n   846→        :param submission_id: The notarization submission being resumed.\n   847→        :param options: Any additional arguments passed to the package command.\n   848→        \"\"\"\n   849→        if options.get(\"submission_id\"):\n   850→            if not self.notarization_path(app).exists():\n   851→                raise BriefcaseCommandError(\n   852→                    \"Notarization cannot be resumed, as the notarization artefact \"\n   853→                    \"associated with this app \"\n   854→                    f\"({self.notarization_path(app).relative_to(self.base_path)}) \"\n   855→                    \"does not exist.\"\n   856→                )\n   857→\n   858→            # If the packaging format is zip, the distribution artefact is created\n   859→            # *after* completion of notarization. If there's an existing distribution\n   860→            # artefact, it must be from a previous notarization/stapling attempt.\n   861→            if app.packaging_format == \"zip\":\n   862→                super().clean_dist_folder(app, **options)\n   863→        else:\n   864→            super().clean_dist_folder(app, **options)\n   865→\n   866→    def ditto_archive(\n   867→        self,\n   868→        app_filename: Path,\n   869→        archive_filename: Path,\n   870→    ):  # pragma: no-cover-if-not-macos\n   871→        \"\"\"Create an archive of an app using ditto.\n   872→\n   873→        Although the archive format is \".zip\", we can't use standard Zip tools, as they\n   874→        don't preserve UTF-8 encoding on all resources. Instead, we need to use `ditto`,\n   875→        which is provided as part of macOS developer tooling. See\n   876→        https://forums.developer.apple.com/forums/thread/116831 and\n   877→        https://developer.apple.com/library/archive/technotes/tn2206/_index.html for\n   878→        more details.\n   879→\n   880→        :param app_filename: The filename of the app to archive\n   881→        :param archive_filename: The filename of the archive to produce\n   882→        \"\"\"\n   883→        try:\n   884→            self.tools.subprocess.run(\n   885→                [\n   886→                    \"/usr/bin/ditto\",\n   887→                    \"-c\",\n   888→                    \"-k\",\n   889→                    \"--sequesterRsrc\",\n   890→                    \"--keepParent\",\n   891→                    app_filename,\n   892→                    archive_filename,\n   893→                ],\n   894→                check=True,\n   895→            )\n   896→        except subprocess.CalledProcessError as e:\n   897→            raise BriefcaseCommandError(f\"Unable to archive {app_filename.name}\") from e\n   898→\n   899→    def notarize(\n   900→        self,\n   901→        app: AppConfig,\n   902→        identity: SigningIdentity,\n   903→        installer_identity: SigningIdentity | None = None,\n   904→    ):\n   905→        \"\"\"Submit a file for notarization, and wait for that notarization to be completed.\n   906→\n   907→        :param app: The app to notarize.\n   908→        :param identity: The code signing used to notarize the app.\n   909→        :param installer_identity: The signing identity to use when signing the\n   910→            installer. Optional unless the packaging format is ``pkg``.\n   911→        \"\"\"\n   912→        # Determine the arguments that would be needed to reproduce this notarization\n   913→        if installer_identity:\n   914→            identity_args = (\n   915→                f\"--identity {identity.id} \"\n   916→                f\"--installer-identity {installer_identity.id}\"\n   917→            )\n   918→            notarization_identity = installer_identity\n   919→        else:\n   920→            identity_args = f\"--identity {identity.id}\"\n   921→            notarization_identity = identity\n   922→\n   923→        format_args = f\"-p {app.packaging_format}\"\n   924→\n   925→        # Submit the app for notarization\n   926→        submission_id = self.submit_notarization(app, identity=notarization_identity)\n   927→\n   928→        self.console.warning(\n   929→            f\"\"\"\n   930→Briefcase will now wait for Apple to approve the notarization request.\n   931→This can take some time - in some cases, hours.\n   932→\n   933→If notarization is interrupted, you can resume by running:\n   934→\n   935→    briefcase package macOS {self.output_format} {format_args} {identity_args} --resume {submission_id}\n   936→\n   937→\"\"\"\n   938→        )\n   939→\n   940→        self.finalize_notarization(\n   941→            app,\n   942→            identity=notarization_identity,\n   943→            submission_id=submission_id,\n   944→        )\n   945→\n   946→    def submit_notarization(self, app, identity: SigningIdentity) -> str:\n   947→        \"\"\"Submit a file for notarization, returning the ID of the notarizatzion task.\n   948→\n   949→        If the file is a .app, it will be archived as a .zip for submission purposes.\n   950→\n   951→        :param app: The app to notarize.\n   952→        :param identity: The code signing identity to use.\n   953→        :returns: The ID of the notarization task.\n   954→        \"\"\"\n   955→        filename = self.notarization_path(app)\n   956→        try:\n   957→            if app.packaging_format == \"zip\":\n   958→                self.console.info()\n   959→                with self.console.wait_bar(\n   960→                    f\"Archiving {filename.name} for notarization...\"\n   961→                ):\n   962→                    archive_filename = filename.parent / (filename.name + \".zip\")\n   963→                    self.ditto_archive(filename, archive_filename)\n   964→            else:\n   965→                archive_filename = filename\n   966→\n   967→            submission_id = None\n   968→            store_credentials = False\n   969→            while not submission_id:\n   970→                if store_credentials:\n   971→                    if not self.console.input_enabled:\n   972→                        raise BriefcaseCommandError(\n   973→                            f\"\"\"\n   974→The keychain does not contain credentials for the profile {identity.profile}.\n   975→You can store these credentials by invoking:\n   976→\n   977→    $ xcrun notarytool store-credentials --team-id {identity.team_id} {identity.profile}\n   978→\n   979→\"\"\"\n   980→                        )\n   981→\n   982→                    self.console.warning(\n   983→                        \"\"\"\n   984→The notarization process uses credentials stored on your system Keychain.\n   985→You need to do this once for each signing certificate you use.\n   986→\n   987→The credentials are authenticated and stored using your Apple ID, using\n   988→an app-specific Apple ID password. To generate an app-specific Apple ID\n   989→password:\n   990→\n   991→  1. Sign into https://appleid.apple.com;\n   992→  2. In the 'Sign-in and Security' section, click 'App-Specific Passwords';\n   993→  3. Click on the '+' icon. You will need to provide an identifying name\n   994→     for the password. You can pick any name that makes sense to you - the\n   995→     name is only there so you can identify passwords. 'Briefcase' would be\n   996→     one possible name.\n   997→  4. Record the password somewhere safe.\n   998→\"\"\"\n   999→                    )\n  1000→                    try:\n  1001→                        self.tools.subprocess.run(\n  1002→                            [\n  1003→                                \"xcrun\",\n  1004→                                \"notarytool\",\n  1005→                                \"store-credentials\",\n  1006→                                \"--team-id\",\n  1007→                                identity.team_id,\n  1008→                                identity.profile,\n  1009→                            ],\n  1010→                            check=True,\n  1011→                            stream_output=False,  # Command reads from stdin.\n  1012→                        )\n  1013→                    except subprocess.CalledProcessError as e:\n  1014→                        raise BriefcaseCommandError(\n  1015→                            f\"Unable to store credentials for team ID {identity.team_id}.\"\n  1016→                        ) from e\n  1017→\n  1018→                # Attempt the notarization\n  1019→                try:\n  1020→                    self.console.info()\n  1021→                    with self.console.wait_bar(\"Submitting app for notarization...\"):\n  1022→                        submission = self.tools.subprocess.parse_output(\n  1023→                            json_parser,\n  1024→                            [\n  1025→                                \"xcrun\",\n  1026→                                \"notarytool\",\n  1027→                                \"submit\",\n  1028→                                archive_filename,\n  1029→                                \"--keychain-profile\",\n  1030→                                identity.profile,\n  1031→                                \"--output-format\",\n  1032→                                \"json\",\n  1033→                            ],\n  1034→                            quiet=1,\n  1035→                        )\n  1036→                        submission_id = submission[\"id\"]\n  1037→                except subprocess.CalledProcessError as e:\n  1038→                    # Error when submitting for notarization.\n  1039→                    # A return code of 69 (nice) indicates an issue with the\n  1040→                    # keychain profile. If store_credentials is already True,\n  1041→                    # then we've already tried to store them, so call the attempt\n  1042→                    # a fail\n  1043→                    if e.returncode == 69 and not store_credentials:\n  1044→                        store_credentials = True\n  1045→                    else:\n  1046→                        self.tools.subprocess.output_error(e)\n  1047→                        raise BriefcaseCommandError(\n  1048→                            f\"Unable to submit {filename.relative_to(self.base_path)} for notarization.\"\n  1049→                        ) from e\n  1050→        finally:\n  1051→            # If we're using .zip packaging, the archive is temporary and isn't used for\n  1052→            # distribution, so we can clean up.\n  1053→            if archive_filename != filename:\n  1054→                self.tools.os.unlink(archive_filename)\n  1055→\n  1056→        return submission_id\n  1057→\n  1058→    def validate_submission_id(\n  1059→        self,\n  1060→        app: AppConfig,\n  1061→        identity: SigningIdentity,\n  1062→        submission_id: str,\n  1063→    ):\n  1064→        with self.console.wait_bar(\"Determining validity of submission ID...\"):\n  1065→            try:\n  1066→                response = self.tools.subprocess.parse_output(\n  1067→                    json_parser,\n  1068→                    [\n  1069→                        \"xcrun\",\n  1070→                        \"notarytool\",\n  1071→                        \"history\",\n  1072→                        \"--keychain-profile\",\n  1073→                        identity.profile,\n  1074→                        \"--output-format\",\n  1075→                        \"json\",\n  1076→                    ],\n  1077→                )\n  1078→\n  1079→                id_matches = [\n  1080→                    submission\n  1081→                    for submission in response[\"history\"]\n  1082→                    if submission[\"id\"] == submission_id\n  1083→                ]\n  1084→\n  1085→                expected_filename = id_matches[0][\"name\"]\n  1086→                # .app files are zipped for notarization, but the app itself is\n  1087→                # notarized; strip the .zip suffix for filename matching purposes.\n  1088→                if expected_filename.endswith(\".zip\"):\n  1089→                    expected_filename = expected_filename[:-4]\n  1090→\n  1091→                if expected_filename != self.notarization_path(app).name:\n  1092→                    raise BriefcaseCommandError(\n  1093→                        f\"{submission_id} is not a submission ID for this project. \"\n  1094→                        f\"It notarizes a file named {expected_filename}\"\n  1095→                    )\n  1096→            except IndexError:\n  1097→                raise BriefcaseCommandError(\n  1098→                    f\"{submission_id} is not a known submission ID for this identity.\"\n  1099→                )\n  1100→            except subprocess.CalledProcessError:\n  1101→                raise BriefcaseCommandError(\n  1102→                    \"Unable to invoke notarytool to determine validity of submission ID.\\n\"\n  1103→                    \"Are you sure this is the identity that was used to notarize the app?\"\n  1104→                )\n  1105→\n  1106→    def finalize_notarization(\n  1107→        self,\n  1108→        app: AppConfig,\n  1109→        identity: SigningIdentity,\n  1110→        submission_id: str,\n  1111→    ):\n  1112→        \"\"\"Finalize a notarization task.\n  1113→\n  1114→        Polls to check the current notarization status; once notarization approval is\n  1115→        received, the notarization is stapled onto the distribution artefact.\n  1116→\n  1117→        :param app: The app to notarize.\n  1118→        :param identity: The code signing identity to use.\n  1119→        :param submission_id: The submission ID of the notarization task to finalize.\n  1120→        \"\"\"\n  1121→        try:\n  1122→            with self.console.wait_bar(\"Waiting for notarization acceptance...\"):\n  1123→                accepted = False\n  1124→                while not accepted:\n  1125→                    try:\n  1126→                        response = self.tools.subprocess.parse_output(\n  1127→                            json_parser,\n  1128→                            [\n  1129→                                \"xcrun\",\n  1130→                                \"notarytool\",\n  1131→                                \"log\",\n  1132→                                \"--keychain-profile\",\n  1133→                                identity.profile,\n  1134→                                submission_id,\n  1135→                            ],\n  1136→                            quiet=1,\n  1137→                        )\n  1138→\n  1139→                        if response[\"status\"] == \"Accepted\":\n  1140→                            accepted = True\n  1141→                        elif response[\"status\"] == \"Invalid\":\n  1142→                            summary = response.get(\n  1143→                                \"statusSummary\", \"No details provided\"\n  1144→                            )\n  1145→                            raise BriefcaseCommandError(\n  1146→                                f\"Notarization was rejected: {summary}\\n\"\n  1147→                                + \"\\n\".join(\n  1148→                                    f\"\"\"\n  1149→    * ({issue.get('severity', \"?\")}) {issue.get('path')} [{issue.get('architecture', \"unknown architecture\")}]\n  1150→      {issue.get('message')}\n  1151→      {issue.get('docUrl', '(No additional help available)')}\"\"\"\n  1152→                                    for issue in response.get(\"issues\", [])\n  1153→                                )\n  1154→                            )\n  1155→                        else:\n  1156→                            raise BriefcaseCommandError(\n  1157→                                f\"Unexpected notarization status: {response['status']}\"\n  1158→                            )\n  1159→                    except subprocess.CalledProcessError as e:\n  1160→                        if e.returncode == 69:\n  1161→                            # Error code 69 (nice) indicates the server can't give a log\n  1162→                            # response for the provided submission ID. We've already\n  1163→                            # validated that it's a valid submission ID, so that means\n  1164→                            # notarization isn't complete yet. Try again in 10 seconds.\n  1165→                            time.sleep(10)\n  1166→                        else:\n  1167→                            self.tools.subprocess.output_error(e)\n  1168→                            raise BriefcaseCommandError(\n  1169→                                \"Unknown problem retrieving notarization status.\"\n  1170→                            ) from e\n  1171→\n  1172→        except KeyboardInterrupt:\n  1173→            raise NotarizationInterrupted(\"Notarization interrupted by user.\")\n  1174→        else:\n  1175→            filename = self.notarization_path(app)\n  1176→            try:\n  1177→                self.console.info()\n  1178→                self.console.info(\n  1179→                    f\"Stapling notarization onto {filename.relative_to(self.base_path)}...\"\n  1180→                )\n  1181→                self.tools.subprocess.run(\n  1182→                    [\"xcrun\", \"stapler\", \"staple\", filename],\n  1183→                    check=True,\n  1184→                )\n  1185→            except subprocess.CalledProcessError:\n  1186→                raise BriefcaseCommandError(\n  1187→                    f\"Unable to staple notarization onto {filename.relative_to(self.base_path)}\"\n  1188→                )\n  1189→\n  1190→        # Notarization on a zip package is performed on the bare app, so we can't\n  1191→        # complete packaging until notarization has completed.\n  1192→        if app.packaging_format == \"zip\":\n  1193→            self.finalize_package_zip(app)\n  1194→\n  1195→    def package_app(\n  1196→        self,\n  1197→        app: AppConfig,\n  1198→        notarize_app=None,\n  1199→        identity=None,\n  1200→        adhoc_sign=False,\n  1201→        sign_installer=True,\n  1202→        installer_identity=None,\n  1203→        submission_id=None,\n  1204→        **kwargs,\n  1205→    ):\n  1206→        \"\"\"Package an app bundle.\n  1207→\n  1208→        :param app: The application to package\n  1209→        :param notarize_app: Should the app be notarized? Default: ``True`` if the app\n  1210→            has been signed with a real identity; ``False`` if the app is unsigned, or\n  1211→            an ad-hoc signing identity has been used.\n  1212→        :param identity: The signing identity to use to sign the app. This can be either\n  1213→            the 40-digit hex checksum, or the string name of the identity. If\n  1214→            unspecified, the user will be prompted for an app signing identity. Ignored\n  1215→            if ``adhoc_sign`` is ``True``.\n  1216→        :param adhoc_sign: If ``True``, code will be signed with ad-hoc identity of \"-\",\n  1217→            and the resulting app will not be re-distributable.\n  1218→        :param sign_installer: Should the installer be signed? Ignored unless the\n  1219→            packaging format is ``pkg``.\n  1220→        :param installer_identity: The signing identity to use when signing the\n  1221→            installer. Ignored unless the packaging format is ``pkg``.\n  1222→        :param submission_id: The submission ID of the notarization task to resume.\n  1223→        \"\"\"\n  1224→        if submission_id:\n  1225→            # If we're resuming notarization, we *can't* use an adhoc identity,\n  1226→            # so don't allow it to be selected.\n  1227→            identity = self.select_identity(identity=identity, allow_adhoc=False)\n  1228→\n  1229→            if app.packaging_format == \"pkg\":\n  1230→                notarization_identity = self.select_identity(\n  1231→                    identity=installer_identity,\n  1232→                    app_identity=identity,\n  1233→                )\n  1234→            else:\n  1235→                notarization_identity = identity\n  1236→\n  1237→            self.console.info(\n  1238→                f\"Resuming notarization for submission {submission_id}\",\n  1239→                prefix=app.app_name,\n  1240→            )\n  1241→\n  1242→            self.console.info()\n  1243→            self.validate_submission_id(\n  1244→                app,\n  1245→                identity=notarization_identity,\n  1246→                submission_id=submission_id,\n  1247→            )\n  1248→\n  1249→            self.console.info()\n  1250→            self.finalize_notarization(\n  1251→                app,\n  1252→                identity=notarization_identity,\n  1253→                submission_id=submission_id,\n  1254→            )\n  1255→            return\n  1256→\n  1257→        # It's a normal packaging pass.\n  1258→        self.console.info(\"Signing app...\", prefix=app.app_name)\n  1259→        if adhoc_sign:\n  1260→            identity = SigningIdentity()\n  1261→        else:\n  1262→            identity = self.select_identity(identity=identity)\n  1263→\n  1264→        if identity.is_adhoc:\n  1265→            if notarize_app:\n  1266→                raise BriefcaseCommandError(\n  1267→                    \"Can't notarize an app with an ad-hoc signing identity\"\n  1268→                )\n  1269→            self.console.warning(\n  1270→                \"\"\"\n  1271→*************************************************************************\n  1272→** WARNING: Signing with an ad-hoc identity                            **\n  1273→*************************************************************************\n  1274→\n  1275→    This app is being signed with an ad-hoc identity. The resulting\n  1276→    app will run on this computer, but will not run on anyone else's\n  1277→    computer.\n  1278→\n  1279→    To generate an app that can be distributed to others, you must\n  1280→    obtain an application distribution certificate from Apple, and\n  1281→    select the developer identity associated with that certificate\n  1282→    when running 'briefcase package'.\n  1283→\n  1284→*************************************************************************\n  1285→\n  1286→\"\"\"\n  1287→            )\n  1288→            self.console.info(\"Signing app with ad-hoc identity...\")\n  1289→        else:\n  1290→            # If we're signing, and notarization isn't explicitly disabled,\n  1291→            # notarize by default.\n  1292→            if notarize_app is None:\n  1293→                notarize_app = True\n  1294→\n  1295→            self.console.info(f\"Signing app with identity {identity.name}...\")\n  1296→\n  1297→        self.sign_app(app=app, identity=identity)\n  1298→\n  1299→        if app.packaging_format == \"zip\":\n  1300→            self.package_zip(\n  1301→                app,\n  1302→                notarize_app=notarize_app,\n  1303→                identity=identity,\n  1304→            )\n  1305→\n  1306→        elif app.packaging_format == \"pkg\":\n  1307→            # If the user has indicated they want to sign the installer (the default),\n  1308→            # and the signing identity for the app *isn't* the adhoc identity, select an\n  1309→            # identity for signing the installer.\n  1310→            if sign_installer and not identity.is_adhoc:\n  1311→                installer_identity = self.select_identity(\n  1312→                    identity=installer_identity,\n  1313→                    app_identity=identity,\n  1314→                )\n  1315→            else:\n  1316→                installer_identity = None\n  1317→\n  1318→            self.package_pkg(\n  1319→                app,\n  1320→                notarize_app=notarize_app,\n  1321→                identity=identity,\n  1322→                installer_identity=installer_identity,\n  1323→            )\n  1324→\n  1325→        else:  # Default packaging format is DMG\n  1326→            self.package_dmg(\n  1327→                app,\n  1328→                notarize_app=notarize_app,\n  1329→                identity=identity,\n  1330→            )\n  1331→\n  1332→    def package_zip(\n  1333→        self,\n  1334→        app: AppConfig,\n  1335→        notarize_app: bool,\n  1336→        identity: SigningIdentity,\n  1337→    ):\n  1338→        \"\"\"Package an .app bundle in a zip file.\n  1339→\n  1340→        If we're notarizing, this doesn't actually create the distribution artefact.\n  1341→        Notarization on a zip package is performed on the bare app, so we can't complete\n  1342→        packaging until notarization has completed. We call ``finalize_package_zip()``\n  1343→        as part of completing zip notarization.\n  1344→        \"\"\"\n  1345→        if notarize_app:\n  1346→            self.console.info(\n  1347→                f\"Notarizing app using team ID {identity.team_id}...\",\n  1348→                prefix=app.app_name,\n  1349→            )\n  1350→            self.notarize(app, identity=identity)\n  1351→        else:\n  1352→            self.finalize_package_zip(app)\n  1353→\n  1354→    def finalize_package_zip(self, app: AppConfig):\n  1355→        \"\"\"Finalize the zip packaging process.\"\"\"\n  1356→        # Build the final