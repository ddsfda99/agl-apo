 lax\n    95\u2192        resp.unset_cookie('bar')\n    96\u2192        # change none to ''\n    97\u2192        resp.unset_cookie('baz', samesite='')\n    98\u2192        # change '' to none\n    99\u2192        resp.unset_cookie('barz', samesite='None')\n   100\u2192\n   101\u2192\n   102\u2192@pytest.fixture\n   103\u2192def client(asgi):\n   104\u2192    app = create_app(asgi)\n   105\u2192    app.add_route('/', CookieResource())\n   106\u2192    app.add_route('/test-convert', CookieResourceMaxAgeFloatString())\n   107\u2192    app.add_route('/same-site', CookieResourceSameSite())\n   108\u2192    app.add_route('/unset-cookie', CookieUnset())\n   109\u2192    app.add_route('/unset-cookie-same-site', CookieUnsetSameSite())\n   110\u2192\n   111\u2192    return testing.TestClient(app)\n   112\u2192\n   113\u2192\n   114\u2192# =====================================================================\n   115\u2192# Response\n   116\u2192# =====================================================================\n   117\u2192\n   118\u2192\n   119\u2192def test_response_base_case(client):\n   120\u2192    result = client.simulate_get('/')\n   121\u2192\n   122\u2192    cookie = result.cookies['foo']\n   123\u2192\n   124\u2192    assert cookie.name == 'foo'\n   125\u2192    assert cookie.value == 'bar'\n   126\u2192    assert cookie.domain == 'example.com'\n   127\u2192    assert cookie.http_only\n   128\u2192\n   129\u2192    # NOTE(kgriffs): Explicitly test for None to ensure\n   130\u2192    # falcon.testing.Cookie is returning exactly what we\n   131\u2192    # expect. Apps using falcon.testing.Cookie can be a\n   132\u2192    # bit more cavalier if they wish.\n   133\u2192    assert cookie.max_age is None\n   134\u2192    assert cookie.expires is None\n   135\u2192\n   136\u2192    assert cookie.path == '/'\n   137\u2192    assert cookie.secure\n   138\u2192\n   139\u2192\n   140\u2192def test_response_disable_secure_globally(client):\n   141\u2192    client.app.resp_options.secure_cookies_by_default = False\n   142\u2192    result = client.simulate_get('/')\n   143\u2192    cookie = result.cookies['foo']\n   144\u2192    assert not cookie.secure\n   145\u2192\n   146\u2192    client.app.resp_options.secure_cookies_by_default = True\n   147\u2192    result = client.simulate_get('/')\n   148\u2192    cookie = result.cookies['foo']\n   149\u2192    assert cookie.secure\n   150\u2192\n   151\u2192\n   152\u2192def test_response_complex_case(client):\n   153\u2192    result = client.simulate_head('/')\n   154\u2192\n   155\u2192    assert len(result.cookies) == 3\n   156\u2192\n   157\u2192    cookie = result.cookies['foo']\n   158\u2192    assert cookie.value == 'bar'\n   159\u2192    assert cookie.domain is None\n   160\u2192    assert cookie.expires is None\n   161\u2192    assert cookie.http_only\n   162\u2192    assert cookie.max_age == 300\n   163\u2192    assert cookie.path is None\n   164\u2192    assert cookie.secure\n   165\u2192\n   166\u2192    cookie = result.cookies['bar']\n   167\u2192    assert cookie.value == 'baz'\n   168\u2192    assert cookie.domain is None\n   169\u2192    assert cookie.expires is None\n   170\u2192    assert not cookie.http_only\n   171\u2192    assert cookie.max_age is None\n   172\u2192    assert cookie.path is None\n   173\u2192    assert cookie.secure\n   174\u2192\n   175\u2192    cookie = result.cookies['bad']\n   176\u2192    assert cookie.value == ''  # An unset cookie has an empty value\n   177\u2192    assert cookie.domain is None\n   178\u2192    assert cookie.same_site == 'Lax'\n   179\u2192\n   180\u2192    assert cookie.expires < utcnow_naive()\n   181\u2192\n   182\u2192    # NOTE(kgriffs): I know accessing a private attr like this is\n   183\u2192    # naughty of me, but we just need to sanity-check that the\n   184\u2192    # string is GMT.\n   185\u2192    assert cookie._expires.endswith('GMT')\n   186\u2192\n   187\u2192    assert cookie.http_only\n   188\u2192    assert cookie.max_age is None\n   189\u2192    assert cookie.path is None\n   190\u2192    assert cookie.secure\n   191\u2192\n   192\u2192\n   193\u2192def test_unset_cookies(client):\n   194\u2192    result = client.simulate_get('/unset-cookie')\n   195\u2192    assert len(result.cookies) == 5\n   196\u2192\n   197\u2192    def test(cookie, path, domain, samesite='Lax'):\n   198\u2192        assert cookie.value == ''  # An unset cookie has an empty value\n   199\u2192        assert cookie.domain == domain\n   200\u2192        assert cookie.path == path\n   201\u2192        assert cookie.same_site == samesite\n   202\u2192        assert cookie.expires < utcnow_naive()\n   203\u2192\n   204\u2192    test(result.cookies['foo'], path=None, domain=None)\n   205\u2192    test(result.cookies['bar'], path='/bar', domain=None)\n   206\u2192    test(result.cookies['baz'], path=None, domain='www.example.com')\n   207\u2192    test(result.cookies['foobar'], path='/foo', domain='www.example.com')\n   208\u2192    test(\n   209\u2192        result.cookies['barfoo'], path='/foo', domain='www.example.com', samesite='none'\n   210\u2192    )\n   211\u2192\n   212\u2192\n   213\u2192def test_unset_cookies_samesite(client):\n   214\u2192    # Test possible different samesite values in set_cookies\n   215\u2192    # foo, bar, lax\n   216\u2192    result_set_lax_empty = client.simulate_get('/same-site')\n   217\u2192    # bar, foo, strict\n   218\u2192    result_set_strict = client.simulate_post('/same-site')\n   219\u2192    # baz, foo, none\n   220\u2192    result_set_none = client.simulate_put('/same-site')\n   221\u2192\n   222\u2192    def test_set(cookie, value, samesite=None):\n   223\u2192        assert cookie.value == value\n   224\u2192        assert cookie.same_site == samesite\n   225\u2192\n   226\u2192    test_set(result_set_lax_empty.cookies['foo'], 'bar', samesite='Lax')\n   227\u2192    test_set(result_set_strict.cookies['bar'], 'foo', samesite='Strict')\n   228\u2192    test_set(result_set_none.cookies['baz'], 'foo', samesite='None')\n   229\u2192    # barz gets set with '', that is None value\n   230\u2192    test_set(result_set_lax_empty.cookies['barz'], 'barz')\n   231\u2192    test_set(result_set_lax_empty.cookies['barz'], 'barz', samesite=None)\n   232\u2192\n   233\u2192    # Unset the cookies with different samesite values\n   234\u2192    result_unset = client.simulate_get('/unset-cookie-same-site')\n   235\u2192    assert len(result_unset.cookies) == 4\n   236\u2192\n   237\u2192    def test_unset(cookie, samesite='Lax'):\n   238\u2192        assert cookie.value == ''  # An unset cookie has an empty value\n   239\u2192        assert cookie.same_site == samesite\n   240\u2192        assert cookie.expires < utcnow_naive()\n   241\u2192\n   242\u2192    test_unset(result_unset.cookies['foo'], samesite='Strict')\n   243\u2192    # default: bar is unset with no samesite param, so should go to Lax\n   244\u2192    test_unset(result_unset.cookies['bar'], samesite='Lax')\n   245\u2192    test_unset(result_unset.cookies['bar'])  # default in test_unset\n   246\u2192\n   247\u2192    test_unset(\n   248\u2192        result_unset.cookies['baz'], samesite=None\n   249\u2192    )  # baz gets unset to samesite = ''\n   250\u2192    test_unset(result_unset.cookies['barz'], samesite='None')\n   251\u2192    # test for false\n   252\u2192    assert result_unset.cookies['baz'].same_site != 'Strict'\n   253\u2192    assert result_unset.cookies['foo'].same_site != 'Lax'\n   254\u2192    assert not result_unset.cookies['baz'].same_site\n   255\u2192\n   256\u2192\n   257\u2192def test_cookie_expires_naive(client):\n   258\u2192    result = client.simulate_post('/')\n   259\u2192\n   260\u2192    cookie = result.cookies['foo']\n   261\u2192    assert cookie.value == 'bar'\n   262\u2192    assert cookie.domain is None\n   263\u2192    assert cookie.expires == datetime(year=2050, month=1, day=1)\n   264\u2192    assert not cookie.http_only\n   265\u2192    assert cookie.max_age is None\n   266\u2192    assert cookie.path is None\n   267\u2192    assert not cookie.secure\n   268\u2192\n   269\u2192\n   270\u2192def test_cookie_expires_aware(client):\n   271\u2192    result = client.simulate_put('/')\n   272\u2192\n   273\u2192    cookie = result.cookies['foo']\n   274\u2192    assert cookie.value == 'bar'\n   275\u2192    assert cookie.domain is None\n   276\u2192    assert cookie.expires == datetime(year=2049, month=12, day=31, hour=23)\n   277\u2192    assert not cookie.http_only\n   278\u2192    assert cookie.max_age is None\n   279\u2192    assert cookie.path is None\n   280\u2192    assert not cookie.secure\n   281\u2192\n   282\u2192\n   283\u2192def test_cookies_setable(client):\n   284\u2192    resp = falcon.Response()\n   285\u2192\n   286\u2192    assert resp._cookies is None\n   287\u2192\n   288\u2192    resp.set_cookie('foo', 'wrong-cookie', max_age=301)\n   289\u2192    resp.set_cookie('foo', 'bar', max_age=300)\n   290\u2192    morsel = resp._cookies['foo']\n   291\u2192\n   292\u2192    assert isinstance(morsel, http_cookies.Morsel)\n   293\u2192    assert morsel.key == 'foo'\n   294\u2192    assert morsel.value == 'bar'\n   295\u2192    assert morsel['max-age'] == 300\n   296\u2192\n   297\u2192\n   298\u2192@pytest.mark.parametrize('cookie_name', ('foofloat', 'foostring'))\n   299\u2192def test_cookie_max_age_float_and_string(client, cookie_name):\n   300\u2192    # NOTE(tbug): Falcon implicitly converts max-age values to integers,\n   301\u2192    # to ensure RFC 6265-compliance of the attribute value.\n   302\u2192\n   303\u2192    result = client.simulate_get('/test-convert')\n   304\u2192\n   305\u2192    cookie = result.cookies[cookie_name]\n   306\u2192    assert cookie.value == 'bar'\n   307\u2192    assert cookie.domain is None\n   308\u2192    assert cookie.expires is None\n   309\u2192    assert not cookie.http_only\n   310\u2192    assert cookie.max_age == 15\n   311\u2192    assert cookie.path is None\n   312\u2192    assert not cookie.secure\n   313\u2192\n   314\u2192\n   315\u2192def test_response_unset_cookie(client):\n   316\u2192    resp = falcon.Response()\n   317\u2192    resp.unset_cookie('bad')\n   318\u2192    resp.set_cookie('bad', 'cookie', max_age=300)\n   319\u2192    resp.unset_cookie('bad')\n   320\u2192\n   321\u2192    morsels = list(resp._cookies.values())\n   322\u2192    len(morsels) == 1\n   323\u2192\n   324\u2192    bad_cookie = morsels[0]\n   325\u2192    assert bad_cookie['expires'] == -1\n   326\u2192\n   327\u2192    output = bad_cookie.OutputString()\n   328\u2192    assert 'bad=;' in output or 'bad=\"\";' in output\n   329\u2192\n   330\u2192    match = re.search('expires=([^;]+)', output)\n   331\u2192    assert match\n   332\u2192\n   333\u2192    expiration = http_date_to_dt(match.group(1), obs_date=True)\n   334\u2192    assert expiration < utcnow_naive()\n   335\u2192\n   336\u2192\n   337\u2192def test_cookie_timezone(client):\n   338\u2192    tz = TimezoneGMT()\n   339\u2192    assert tz.tzname(timedelta(0)) == 'GMT'\n   340\u2192\n   341\u2192\n   342\u2192# =====================================================================\n   343\u2192# Request\n   344\u2192# =====================================================================\n   345\u2192\n   346\u2192\n   347\u2192def test_request_cookie_parsing():\n   348\u2192    # testing with a github-ish set of cookies\n   349\u2192    headers = [\n   350\u2192        (\n   351\u2192            'Cookie',\n   352\u2192            \"\"\"\n   353\u2192            logged_in=no;_gh_sess=eyJzZXXzaW9uX2lkIjoiN2;\n   354\u2192            tz=Europe/Berlin; _ga =GA1.2.332347814.1422308165;\n   355\u2192            tz2=Europe/Paris ; _ga2=\"line1\\\\012line2\";\n   356\u2192            tz3=Europe/Madrid ;_ga3= GA3.2.332347814.1422308165;\n   357\u2192            _gat=1;\n   358\u2192            _octo=GH1.1.201722077.1422308165\n   359\u2192            \"\"\",\n   360\u2192