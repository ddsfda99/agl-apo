 or a dict-like object that implements an ``items()`` method.\n   769\u2192                Both *name* and *value* must be of type ``str`` and\n   770\u2192                contain only US-ASCII characters.\n   771\u2192\n   772\u2192                Note:\n   773\u2192                    Falcon can process an iterable of tuples slightly faster\n   774\u2192                    than a dict.\n   775\u2192\n   776\u2192        Raises:\n   777\u2192            ValueError: `headers` was not a ``dict`` or ``list`` of ``tuple``\n   778\u2192                         or ``Iterable[[str, str]]``.\n   779\u2192        \"\"\"\n   780\u2192\n   781\u2192        header_items = getattr(headers, 'items', None)\n   782\u2192\n   783\u2192        if callable(header_items):\n   784\u2192            headers = header_items()\n   785\u2192\n   786\u2192        # NOTE(kgriffs): We can't use dict.update because we have to\n   787\u2192        # normalize the header names.\n   788\u2192        _headers = self._headers\n   789\u2192\n   790\u2192        for name, value in headers:\n   791\u2192            # NOTE(kgriffs): uwsgi fails with a TypeError if any header\n   792\u2192            # is not a str, so do the conversion here. It's actually\n   793\u2192            # faster to not do an isinstance check. str() will encode\n   794\u2192            # to US-ASCII.\n   795\u2192            value = str(value)\n   796\u2192\n   797\u2192            name = name.lower()\n   798\u2192            if name == 'set-cookie':\n   799\u2192                raise HeaderNotSupported('This method cannot be used to set cookies')\n   800\u2192\n   801\u2192            _headers[name] = value\n   802\u2192\n   803\u2192    def append_link(\n   804\u2192        self,\n   805\u2192        target,\n   806\u2192        rel,\n   807\u2192        title=None,\n   808\u2192        title_star=None,\n   809\u2192        anchor=None,\n   810\u2192        hreflang=None,\n   811\u2192        type_hint=None,\n   812\u2192     