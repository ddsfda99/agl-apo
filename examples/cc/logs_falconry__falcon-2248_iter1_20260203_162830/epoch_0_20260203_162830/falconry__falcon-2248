ibute is no longer supported. '\n   222→            'Please use the text attribute instead.'\n   223→        )\n   224→\n   225→    @property\n   226→    def data(self):\n   227→        return self._data\n   228→\n   229→    @data.setter\n   230→    def data(self, value):\n   231→        self._data = value\n   232→\n   233→    @property\n   234→    def headers(self):\n   235→        return self._headers.copy()\n   236→\n   237→    @property\n   238→    def media(self):\n   239→        return self._media\n   240→\n   241→    @media.setter\n   242→    def media(self, value):\n   243→        self._media = value\n   244→        self._media_rendered = _UNSET\n   245→\n   246→    @property\n   247→    def stream_len(self):\n   248→        # NOTE(kgriffs): Provide some additional information by raising the\n   249→        #   error explicitly.\n   250→        raise AttributeError(_STREAM_LEN_REMOVED_MSG)\n   251→\n   252→    @stream_len.setter\n   253→    def stream_len(self, value):\n   254→        # NOTE(kgriffs): We explicitly disallow setting the deprecated attribute\n   255→        #   so that apps relying on it do not fail silently.\n   256→        raise AttributeError(_STREAM_LEN_REMOVED_MSG)\n   257→\n   258→    def render_body(self):\n   259→        \"\"\"Get the raw bytestring content for the response body.\n   260→\n   261→        This method returns the raw data for the HTTP response body, taking\n   262→        into account the :attr:`~.text`, :attr:`~.data`, and :attr:`~.media`\n   263→        attributes.\n   264→\n   265→        Note:\n   266→            This method ignores :attr:`~.stream`; the caller must check\n   267→            and handle that attribute directly.\n   268→\n   269→        Returns:\n   270→            bytes: The UTF-8 encoded value of the `text` attribute, if\n   271→            set. Otherwise, the value of the `data` attribute if set, or\n   272→            finally the serialized value of the `media` attribute. If\n   273→            none of these attributes are set, ``None`` is returned.\n   274→        \"\"\"\n   275→\n   276→        text = self.text\n   277→        if text is None:\n   278→            data = self._data\n   279→\n   280→            if data is None and self._media is not None:\n   281→                # NOTE(kgriffs): We use a special _UNSET singleton since\n   282→                #   None is ambiguous (the media handler might return None).\n   283→                if self._media_rendered is _UNSET:\n   284→                    if not self.content_type:\n   285→                        self.content_type = self.options.default_media_type\n   286→\n   287→                    handler, _, _ = self.options.media_handlers._resolve(\n   288→                        self.content_type, self.options.default_media_type\n   289→                    )\n   290→\n   291→                    self._media_rendered = handler.serialize(\n   292→                        self._media, self.content_type\n   293→                    )\n   294→\n   295→                data = self._media_rendered\n   296→        else:\n   297→            try:\n   298→                # NOTE(kgriffs): Normally we expect text to be a string\n   299→                data = text.encode()\n   300→            except AttributeError:\n   301→                # NOTE(kgriffs): Assume it was a bytes object already\n   302→                data = text\n   303→\n   304→        return data\n   305→\n   306→    def __repr__(self):\n   307→        return '<%s: %s>' % (self.__class__.__name__, self.status)\n   308→\n   309→    def set_stream(self, stream, content_length):\n   310→        \"\"\"Set both `stream` and `content_length`.\n   311→\n   312→        Although the :attr:`~falcon.Response.stream` and\n   313→        :attr:`~falcon.Response.content_length` properties may be set\n   314→        directly, using this method ensures\n   315→        :attr:`~falcon.Response.content_length` is not accidentally\n   316→        neglected when the length of the stream is known in advance. Using this\n   317→        method is also slightly more performant as compared to setting the\n   318→        properties individually.\n   319→\n   320→        Note:\n   321→            If the stream length is unknown, you can set\n   322→            :attr:`~falcon.Response.stream` directly, and ignore\n   323→            :attr:`~falcon.Response.content_length`. In this case, the ASGI\n   324→            server may choose to use chunked encoding or one\n   325→            of the other strategies suggested by PEP-3333.\n   326→\n   327→        Args:\n   328→            stream: A readable file-like object.\n   329→            content_length (int): Length of the stream, used for the\n   330→                Content-Length header in the response.\n   331→        \"\"\"\n   332→\n   333→        self.stream = stream\n   334→\n   335→        # PERF(kgriffs): Set directly rather than incur the overhead of\n   336→        #   the self.content_length property.\n   337→        self._headers['content-length'] = str(content_length)\n   338→\n   339→    def set_cookie(\n   340→        self,\n   341→        name,\n   342→        value,\n   343→        expires=None,\n   344→        max_age=None,\n   345→        domain=None,\n   346→        path=None,\n   347→        secure=None,\n   348→        http_only=True,\n   349→        same_site=None,\n   350→    ):\n   351→        \"\"\"Set a response cookie.\n   352→\n   353→        Note:\n   354→            This method can be called multiple times to add one or\n   355→            more cookies to the response.\n   356→\n   357→        See Also:\n   358→            To learn more about setting cookies, see\n   359→            :ref:`Setting Cookies <setting-cookies>`. The parameters\n   360→            listed below correspond to those defined in `RFC 6265`_.\n   361→\n   362→        Args:\n   363→            name (str): Cookie name\n   364→            value (str): Cookie value\n   365→\n   366→        Keyword Args:\n   367→            expires (datetime): Specifies when the cookie should expire.\n   368→                By default, cookies expire when the user agent exits.\n   369→\n   370→                (See also: RFC 6265, Section 4.1.2.1)\n   371→            max_age (int): Defines the lifetime of the cookie in\n   372→                seconds. By default, cookies expire when the user agent\n   373→                exits. If both `max_age` and `expires` are set, the\n   374→                latter is ignored by the user agent.\n   375→\n   376→                Note:\n   377→                    Coercion to ``int`` is attempted if provided with\n   378→                    ``float`` or ``str``.\n   379→\n   380→                (See also: RFC 6265, Section 4.1.2.2)\n   381→\n   382→            domain (str): Restricts the cookie to a specific domain and\n   383→                any subdomains of that domain. By default, the user\n   384→                agent will return the cookie only to the origin server.\n   385→                When overriding this default behavior, the specified\n   386→                domain must include the origin server. Otherwise, the\n   387→                user agent will reject the cookie.\n   388→\n   389→                Note:\n   390→                    Cookies do not provide isolation by port, so the domain\n   391→                    should not provide one. (See also: RFC 6265, Section 8.5)\n   392→\n   393→                (See also: RFC 6265, Section 4.1.2.3)\n   394→\n   395→            path (str): Scopes the cookie to the given path plus any\n   396→                subdirectories under that path (the \"/\" character is\n   397→                interpreted as a directory separator). If the cookie\n   398→                does not specify a path, the user agent defaults to the\n   399→                path component of the requested URI.\n   400→\n   401→                Warning:\n   402→                    User agent interfaces do not always isolate\n   403→                    cookies by path, and so this should not be\n   404→                    considered an effective security measure.\n   405→\n   406→                (See also: RFC 6265, Section 4.1.2.4)\n   407→\n   408→            secure (bool): Direct the client to only return the cookie\n   409→                in subsequent requests if they are made over HTTPS\n   410→                (default: ``True``). This prevents attackers from\n   411→                reading sensitive cookie data.\n   412→\n   413→                Note:\n   414→                    The default value for this argument is normally\n   415→                    ``True``, but can be modified by setting\n   416→                    :py:attr:`~.ResponseOptions.secure_cookies_by_default`\n   417→                    via :any:`App.resp_options`.\n   418→\n   419→                Warning:\n   420→                    For the `secure` cookie attribute to be effective,\n   421→                    your application will need to enforce HTTPS.\n   422→\n   423→                (See also: RFC 6265, Section 4.1.2.5)\n   424→\n   425→            http_only (bool): The HttpOnly attribute limits the scope of the\n   426→                cookie to HTTP requests.  In particular, the attribute\n   427→                instructs the user agent to omit the cookie when providing\n   428→                access to cookies via \"non-HTTP\" APIs. This is intended to\n   429→                mitigate some forms of cross-site scripting. (default: ``True``)\n   430→\n   431→                Note:\n   432→                    HttpOnly cookies are not visible to javascript scripts\n   433→                    in the browser. They are automatically sent to the server\n   434→                    on javascript ``XMLHttpRequest`` or ``Fetch`` requests.\n   435→\n   436→                (See also: RFC 6265, Section 4.1.2.6)\n   437→\n   438→            same_site (str): Helps protect against CSRF attacks by restricting\n   439→                when a cookie will be attached to the request by the user agent.\n   440→                When set to ``'Strict'``, the cookie will only be sent along\n   441→                with \"same-site\" requests.  If the value is ``'Lax'``, the\n   442→                cookie will be sent with same-site requests, and with\n   443→                \"cross-site\" top-level navigations.  If the value is ``'None'``,\n   444→                the cookie will be sent with same-site and cross-site requests.\n   445→                Finally, when this attribute is not set on the cookie, the\n   446→                attribute will be treated as if it had been set to ``'None'``.\n   447→\n   448→                (See also: `Same-Site RFC Draft`_)\n   449→\n   450→        Raises:\n   451→            KeyError: `name` is not a valid cookie name.\n   452→            ValueError: `value` is not a valid cookie value.\n   453→\n   454→        .. _RFC 6265:\n   455→            http://tools.ietf.org/html/rfc6265\n   456→\n   457→        .. _Same-Site RFC Draft:\n   458→            https://tools.ietf.org/html/draft-ietf-httpbis-rfc6265bis-03#section-4.1.2.7\n   459→\n   460→        \"\"\"\n   461→\n   462→        if not is_ascii_encodable(name):\n   463→            raise KeyError('name is not ascii encodable')\n   464→        if not is_ascii_encodable(value):\n   465→            raise ValueError('value is not ascii encodable')\n   466→\n   467→        value = str(value)\n   468→\n   469→        if self._cookies is None:\n   470→            self._cookies = http_cookies.SimpleCookie()\n   471→\n   472→        try:\n   473→            self._cookies[name] = value\n   474→        except http_cookies.CookieError as e:  # pragma: no cover\n   475→            # NOTE(tbug): we raise a KeyError here, to avoid leaking\n   476→            # the CookieError to the user. SimpleCookie (well, BaseCookie)\n   477→            # only throws CookieError on issues with the cookie key\n   478→            raise KeyError(str(e))\n   479→\n   480→        if expires:\n   481→            # set Expires on cookie. Format is Wdy, DD Mon YYYY HH:MM:SS GMT\n   482→\n   483→            # NOTE(tbug): we never actually need to\n   484→            # know that GMT is named GMT when formatting cookies.\n   485→            # It is a function call less to just write \"GMT\" in the fmt string:\n   486→            fmt = '%a, %d %b %Y %H:%M:%S GMT'\n   487→            if expires.tzinfo is None:\n   488→                # naive\n   489→                self._cookies[name]['expires'] = expires.strftime(fmt)\n   490→            else:\n   491→                # aware\n   492→                gmt_expires = expires.astimezone(GMT_TIMEZONE)\n   493→                self._cookies[name]['expires'] = gmt_expires.strftime(fmt)\n   494→\n   495→        if max_age:\n   496→            # RFC 6265 section 5.2.2 says about the max-age value:\n   497→            #   \"If the remainder of attribute-value contains a non-DIGIT\n   498→            #    character, ignore the cookie-av.\"\n   499→            # That is, RFC-compliant response parsers will ignore the max-age\n   500→            # attribute if the value contains a dot, as in floating point\n   501→            # numbers. Therefore, attempt to convert the value to an integer.\n   502→            self._cookies[name]['max-age'] = int(max_age)\n   503→\n   504→        if domain:\n   505→            self._cookies[name]['domain'] = domain\n   506→\n   507→        if path:\n   508→            self._cookies[name]['path'] = path\n   509→\n   510→        is_secure = self.options.secure_cookies_by_default if secure is None else secure\n   511→\n   512→        if is_secure:\n   513→            self._cookies[name]['secure'] = True\n   514→\n   515→        if http_only:\n   516→            self._cookies[name]['httponly'] = http_only\n   517→\n   518→        # PERF(kgriffs): Morsel.__setitem__() will lowercase this anyway,\n   519→        #   so we can just pass this in and when __setitem__() calls\n   520→        #   lower() it will be very slightly faster.\n   521→        if same_site:\n   522→            same_site = same_site.lower()\n   523→\n   524→            if same_site not in _RESERVED_SAMESITE_VALUES:\n   525→                raise ValueError(\n   526→                    \"same_site must be set to either 'lax', 'strict', or 'none'\"\n   527→                )\n   528→\n   529→            self._cookies[name]['samesite'] = same_site.capitalize()\n   530→\n   531→    def unset_cookie(self, name, samesite='Lax', domain=None, path=None):\n   532→        \"\"\"Unset a cookie in the response.\n   533→\n   534→        Clears the contents of the cookie, and instructs the user\n   535→        agent to immediately expire its own copy of the cookie.\n   536→\n   537→        Note:\n   538→            Modern browsers place restriction on cookies without the\n   539→            \"same-site\" cookie attribute set. To that end this attribute\n   540→            is set to ``'Lax'`` by this method.\n   541→\n   542→            (See also: `Same-Site warnings`_)\n   543→\n   544→        Warning:\n   545→            In order to successfully remove a cookie, both the\n   546→            path and the domain must match the values that were\n   547→            used when the cookie was created.\n   548→\n   549→        Args:\n   550→            name (str): Cookie name\n   551→\n   552→        Keyword Args:\n   553→            samesite (str): Allows to override the default 'Lax' same_site\n   554→                    setting for the unset cookie.\n   555→\n   556→            domain (str): Restricts the cookie to a specific domain and\n   557→                    any subdomains of that domain. By default, the user\n   558→                    agent will return the cookie only to the origin server.\n   559→                    When overriding this default behavior, the specified\n   560→                    domain must include the origin server. Otherwise, the\n   561→                    user agent will reject the cookie.\n   562→\n   563→                    Note:\n   564→                        Cookies do not provide isolation by port, so the domain\n   565→                        should not provide one. (See also: RFC 6265, Section 8.5)\n   566→\n   567→                    (See also: RFC 6265, Section 4.1.2.3)\n   568→\n   569→            path (str): Scopes the cookie to the given path plus any\n   570→                subdirectories under that path (the \"/\" character is\n   571→                interpreted as a directory separator). If the cookie\n   572→                does not specify a path, the user agent defaults to the\n   573→                path component of the requested URI.\n   574→\n   575→                Warning:\n   576→                    User agent interfaces do not always isolate\n   577→                    cookies by path, and so this should not be\n   578→                    considered an effective security measure.\n   579→\n   580→                (See also: RFC 6265, Section 4.1.2.4)\n   581→\n   582→        .. _Same-Site warnings:\n   583→            https://developer.mozilla.org/en-US/docs/Web/HTTP/Headers/Set-Cookie/SameSite#Fixing_common_warnings\n   584→        \"\"\"  # noqa: E501\n   585→        if self._cookies is None:\n   586→            self._cookies = http_cookies.SimpleCookie()\n   587→\n   588→        self._cookies[name] = ''\n   589→\n   590→        # NOTE(Freezerburn): SimpleCookie apparently special cases the\n   591→        # expires attribute to automatically use strftime and set the\n   592→        # time as a delta from the current time. We use -1 here to\n   593→        # basically tell the browser to immediately expire the cookie,\n   594→        # thus removing it from future request objects.\n   595→        self._cookies[name]['expires'] = -1\n   596→\n   597→        # NOTE(CaselIT): Set SameSite to Lax to avoid setting invalid cookies.\n   598→        # See https://developer.mozilla.org/en-US/docs/Web/HTTP/Headers/Set-Cookie/SameSite#Fixing_common_warnings  # noqa: E501\n   599→        self._cookies[name]['samesite'] = samesite\n   600→\n   601→        if domain:\n   602→            self._cookies[name]['domain'] = domain\n   603→\n   604→        if path:\n   605→            self._cookies[name]['path'] = path\n   606→\n   607→    def get_header(self, name, default=None):\n   608→        \"\"\"Retrieve the raw string value for the given header.\n   609→\n   610→        Normally, when a header has multiple values, they will be\n   611→        returned as a single, comma-delimited string. However, the\n   612→        Set-Cookie header does not support this format, and so\n   613→        attempting to retrieve it will raise an error.\n   614→\n   615→        Args:\n   616→            name (str): Header name, case-insensitive. Must be of type ``str``\n   617→                or ``StringType``, and only character values 0x00 through 0xFF\n   618→                may be used on platforms that use wide characters.\n   619→        Keyword Args:\n   620→            default: Value to return if the header\n   621→                is not found (default ``None``).\n   622→\n   623→        Raises:\n   624→            ValueError: The value of the 'Set-Cookie' header(s) was requested.\n   625→\n   626→        Returns:\n   627→            str: The value of the specified header if set, or\n   628→            the default value if not set.\n   629→        \"\"\"\n   630→\n   631→        # NOTE(kgriffs): normalize name by lowercasing it\n   632→        name = name.lower()\n   633→\n   634→        if name == 'set-cookie':\n   635→            raise HeaderNotSupported('Getting Set-Cookie is not currently supported.')\n   636→\n   637→        return self._headers.get(name, default)\n   638→\n   639→    def set_header(self, name, value):\n   640→        \"\"\"Set a header for this response to a given value.\n   641→\n   642→        Warning:\n   643→            Calling this method overwrites any values already set for this\n   644→            header. To append an additional value for this header, use\n   645→            :meth:`~.append_header` instead.\n   646→\n   647→        Warning:\n   648→            This method cannot be used to set cookies; instead, use\n   649→            :meth:`~.append_header` or :meth:`~.set_cookie`.\n   650→\n   651→        Args:\n   652→            name (str): Header name (case-insensitive). The name may contain\n   653→                only US-ASCII characters.\n   654→            value (str): Value for the header. As with the header's name, the\n   655→                value may contain only US-ASCII characters.\n   656→\n   657→        Raises:\n   658→            ValueError: `name` cannot be ``'Set-Cookie'``.\n   659→        \"\"\"\n   660→\n   661→        # NOTE(kgriffs): uwsgi fails with a TypeError if any header\n   662→        # is not a str, so do the conversion here. It's actually\n   663→        # faster to not do an isinstance check. str() will encode\n   664→        # to US-ASCII.\n   665→        value = str(value)\n   666→\n   667→        # NOTE(kgriffs): normalize name by lowercasing it\n   668→        name = name.lower()\n   669→\n   670→        if name == 'set-cookie':\n   671→            raise HeaderNotSupported('This method cannot be used to set cookies')\n   672→\n   673→        self._headers[name] = value\n   674→\n   675→    def delete_header(self, name):\n   676→        \"\"\"Delete a header that was previously set for this response.\n   677→\n   678→        If the header was not previously set, nothing is done (no error is\n   679→        raised). Otherwise, all values set for the header will be removed\n   680→        from the response.\n   681→\n   682→        Note that calling this method is equivalent to setting the\n   683→        corresponding header property (when said property is available) to\n   684→        ``None``. For example::\n   685→\n   686→            resp.etag = None\n   687→\n   688→        Warning:\n   689→            This method cannot be used with the Set-Cookie header. Instead,\n   690→            use :meth:`~.unset_cookie` to remove a cookie and ensure that the\n   691→            user agent expires its own copy of the data as well.\n   692→\n   693→        Args:\n   694→            name (str): Header name (case-insensitive). The name may\n   695→                contain only US-ASCII characters.\n   696→\n   697→        Raises:\n   698→            ValueError: `name` cannot be ``'Set-Cookie'``.\n   699→        \"\"\"\n   700→\n   701→        # NOTE(kgriffs): normalize name by lowercasing it\n   702→        name = name.lower()\n   703→\n   704→        if name == 'set-cookie':\n   705→            raise HeaderNotSupported('This method cannot be used to remove cookies')\n   706→\n   707→        self._headers.pop(name, None)\n   708→\n   709→    def append_header(self, name, value):\n   710→        \"\"\"Set or append a header for this response.\n   711→\n   712→        If the header already exists, the new value will normally be appended\n   713→        to it, delimited by a comma. The notable exception to this rule is\n   714→        Set-Cookie, in which case a separate header line for each value will be\n   715→        included in the response.\n   716→\n   717→        Note:\n   718→            While this method can be used to efficiently append raw\n   719→            Set-Cookie headers to the response, you may find\n   720→            :py:meth:`~.set_cookie` to be more convenient.\n   721→\n   722→        Args:\n   723→            name (str): Header name (case-insensitive). The name may contain\n   724→                only US-ASCII characters.\n   725→            value (str): Value for the header. As with the header's name, the\n   726→                value may contain only US-ASCII characters.\n   727→        \"\"\"\n   728→\n   729→        # NOTE(kgriffs): uwsgi fails with a TypeError if any header\n   730→        # is