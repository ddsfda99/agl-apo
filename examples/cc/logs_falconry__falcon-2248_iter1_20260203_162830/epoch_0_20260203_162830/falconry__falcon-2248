8\u2192        ('Cookie', 'x=1;bad{cookie=bar; x=2;x=3 ; x=4;'),\n   409\u2192    ]\n   410\u2192\n   411\u2192    environ = testing.create_environ(headers=headers)\n   412\u2192    req = falcon.Request(environ)\n   413\u2192\n   414\u2192    assert req.cookies['x'] == '1'\n   415\u2192    assert req.get_cookie_values('x') == ['1', '2', '3', '4']\n   416\u2192\n   417\u2192\n   418\u2192def test_cookie_header_is_missing():\n   419\u2192    environ = testing.create_environ(headers={})\n   420\u2192\n   421\u2192    req = falcon.Request(environ)\n   422\u2192    assert req.cookies == {}\n   423\u2192    assert req.get_cookie_values('x') is None\n   424\u2192\n   425\u2192    # NOTE(kgriffs): Test again with a new object to cover calling in the\n   426\u2192    #   opposite order.\n   427\u2192    req = falcon.Request(environ)\n   428\u2192    assert req.get_cookie_values('x') is None\n   429\u2192    assert req.cookies == {}\n   430\u2192\n   431\u2192\n   432\u2192def test_unicode_inside_ascii_range():\n   433\u2192    resp = falcon.Response()\n   434\u2192\n   435\u2192    # should be ok\n   436\u2192    resp.set_cookie('non_unicode_ascii_name_1', 'ascii_value')\n   437\u2192    resp.set_cookie('unicode_ascii_name_1', 'ascii_value')\n   438\u2192    resp.set_cookie('non_unicode_ascii_name_2', 'unicode_ascii_value')\n   439\u2192    resp.set_cookie('unicode_ascii_name_2', 'unicode_ascii_value')\n   440\u2192\n   441\u2192\n   442\u2192@pytest.mark.parametrize(\n   443\u2192    'name', (UNICODE_TEST_STRING, UNICODE_TEST_STRING.encode('utf-8'), 42)\n   444\u2192)\n   445\u2192def test_non_ascii_name(name):\n   446\u2192    resp = falcon.Response()\n   447\u2192    with pytest.raises(KeyError):\n   448\u2192        resp.set_cookie(name, 'ok_value')\n   449\u2192\n   450\u2192\n   451\u2192@pytest.mark.parametrize(\n   452\u2192    'value', (UNICODE_TEST_STRING, UNICODE_TEST_STRING.encode('utf-8'), 42)\n   453\u2192)\n   454\u2192def test_non_ascii_value(value):\n   455\