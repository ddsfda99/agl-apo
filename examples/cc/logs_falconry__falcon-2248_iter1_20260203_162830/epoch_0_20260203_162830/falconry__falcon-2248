   821\u2192    resp_event_collector = helpers.ASGIResponseEventCollector()\n   822\u2192\n   823\u2192    if not _one_shot:\n   824\u2192        task_req = create_task(app(http_scope, req_event_emitter, resp_event_collector))\n   825\u2192\n   826\u2192        if _stream_result:\n   827\u2192            # NOTE(kgriffs): Wait until the response has been started and give\n   828\u2192            #   the task a chance to progress. Otherwise, we won't have a\n   829\u2192            #   status or headers to pass to StreamedResult.\n   830\u2192            while not resp_event_collector.status:\n   831\u2192                await asyncio.sleep(0)\n   832\u2192\n   833\u2192            return StreamedResult(\n   834\u2192                resp_event_collector.body_chunks,\n   835\u2192                code_to_http_status(resp_event_collector.status),\n   836\u2192                resp_event_collector.headers,\n   837\u2192                task_req,\n   838\u2192                req_event_emitter,\n   839\u2192            )\n   840\u2192\n   841\u2192        req_event_emitter.disconnect()\n   842\u2192        await task_req\n   843\u2192        return Result(\n   844\u2192            resp_event_collector.body_chunks,\n   845\u2192            code_to_http_status(resp_event_collector.status),\n   846\u2192            resp_event_collector.headers,\n   847\u2192        )\n   848\u2192\n   849\u2192    # ---------------------------------------------------------------------\n   850\u2192    # NOTE(kgriffs): 'lifespan' scope\n   851\u2192    # ---------------------------------------------------------------------\n   852\u2192    lifespan_scope = {\n   853\u2192        'type': ScopeType.LIFESPAN,\n   854\u2192        'asgi': {\n   855\u2192            'version': '3.0',\n   856\u2192            'spec_version': '2.0',\n   857\u2192        },\n   858\u2192    }\n   859\u2192\n   860\u2192    shutting_down = asyncio.Condition()\n   861\u2192    lifespan_event_emitter = helpers.ASGILifespanEventEmitter(shutting_down)\n   862\u2192    lifespan_event_collector = helpers.ASGIResponseEventCollector()\n   863\u2192    # ---------------------------------------------------------------------\n   864\u2192\n   865\u2192    async def conductor():\n   866\u2192        # NOTE(kgriffs): We assume this is a Falcon ASGI app, which supports\n   867\u2192        #   the lifespan protocol and thus we do not need to catch\n   868\u2192        #   exceptions that would signify no lifespan protocol support.\n   869\u2192        task_lifespan = get_running_loop().create_task(\n   870\u2192            app(lifespan_scope, lifespan_event_emitter, lifespan_event_collector)\n   871\u2192        )\n   872\u2192\n   873\u2192        await _wait_for_startup(lifespan_event_collector.events)\n   874\u2192\n   875\u2192        task_req = create_task(app(http_scope, req_event_emitter, resp_event_collector))\n   876\u2192        req_event_emitter.disconnect()\n   877\u2192        await task_req\n   878\u2192\n   879\u2192        # NOTE(kgriffs): Notify lifespan_event_emitter that it is OK\n   880\u2192        #   to proceed.\n   881\u2192        async with shutting_down:\n   882\u2192            shutting_down.notify()\n   883\u2192\n   884\u2192        await _wait_for_shutdown(lifespan_event_collector.events)\n   885\u2192        await task_lifespan\n   886\u2192\n   887\u2192    await conductor()\n   888\u2192\n   889\u2192    if resp_event_collector.status is None:\n   890\u2192        # NOTE(kgriffs): An immediate disconnect was simulated, and so\n   891\u2192        #   the app could not return a status.\n   892\u2192        raise ConnectionError('An immediate disconnect was simulated.')\n   893\u2192\n   894\u2192    return Result(\n   895\u2192        resp_event_collector.body_chunks,\n   896\u2192        code_to_http_status(resp_event_collector.status),\n   897\u2192        resp_event_collector.headers,\n   898\u2192    )\n   899\u2192\n   900\u2192\n   901\u2192class ASGIConductor:\n   902\u2192    \"\"\"Test conductor for ASGI apps.\n   903\u2192\n   904\u2192    This class provides more control over the lifecycle of a simulated\n   905\u2192    request as compared to :class:`~.TestClient`. In addition, the conductor's\n   906\u2192    asynchronous interface affords interleaved requests and the testing of\n   907\u2192    streaming protocols such as\n   908\u2192    :attr:`Server-Sent Events (SSE) <falcon.asgi.Response.sse>`\n   909\u2192    and :ref:`WebSocket <ws>`.\n   910\u2192\n   911\u2192    :class:`~.ASGIConductor` is implemented as a context manager. Upon\n   912\u2192    entering and exiting the context, the appropriate ASGI lifespan events\n   913\u2192    will be simulated.\n   914\u2192\n   915\u2192    Within the context, HTTP requests can be simulated using an interface\n   916\u2192    that is similar to :class:`~.TestClient`, except that all ``simulate_*()``\n   917\u2192    methods are coroutines::\n   918\u2192\n   919\u2192        async with testing.ASGIConductor(some_app) as conductor:\n   920\u2192            async def post_events():\n   921\u2192                for i in range(100):\n   922\u2192                    await conductor.simulate_post('/events', json={'id': i}):\n   923\u2192                    await asyncio.sleep(0.01)\n   924\u2192\n   925\u2192            async def get_events_sse():\n   926\u2192                # Here, we will get only some of the single server-sent events\n   927\u2192                # because the non-streaming method is \"single-shot\". In other\n   928\u2192                # words, simulate_get() will emit a client disconnect event\n   929\u2192                # into the app before returning.\n   930\u2192                result = await conductor.simulate_get('/events')\n   931\u2192\n   932\u2192                # Alternatively, we can use simulate_get_stream() as a context\n   933\u2192                # manager to perform a series of reads on the result body that\n   934\u2192                # are interleaved with the execution of the post_events()\n   935\u2192                # coroutine.\n   936\u2192                async with conductor.simulate_get_stream('/events') as sr:\n   937\u2192                    while some_condition:\n   938\u2192                        # Read next body chunk that was received (if any).\n   939\u2192                        chunk = await sr.stream.read()\n   940\u2192\n   941\u2192                        if chunk:\n   942\u2192                            # TODO: Do something with the chunk\n   943\u2192                            pass\n   944\u2192\n   945\u2192                    # Exiting the context causes the request event emitter to\n   946\u2192                    # begin emitting ``'http.disconnect'`` events and then awaits\n   947\u2192                    # the completion of the asyncio task that is running the\n   948\u2192                    # simulated ASGI request.\n   949\u2192\n   950\u2192            asyncio.gather(post_events(), get_events_sse())\n   951\u2192\n   952\u2192    Note:\n   953\u2192        Because the :class:`~.ASGIConductor` interface uses coroutines,\n   954\u2192        it cannot be used directly with synchronous testing frameworks such as\n   955\u2192        pytest.\n   956\u2192\n   957\u2192        As a workaround, the test can be adapted by wrapping it in\n   958\u2192        an inline async function and then invoking it via\n   959\u2192        :meth:`falcon.async_to_sync` or decorating the test function\n   960\u2192        with :meth:`falcon.runs_sync`.\n   961\u2192\n   962\u2192        Alternatively, you can try searching PyPI to see if an async plugin is\n   963\u2192        available for your testing framework of choice. For example, the\n   964\u2192        ``pytest-asyncio`` plugin is available for ``pytest`` users.\n   965\u2192\n   966\u2192    Similar to the :class:`TestClient`, :class:`ASGIConductor` also exposes\n   967\u2192    convenience aliases without the ``simulate_`` prefix. Just as with a\n   968\u2192    typical asynchronous HTTP client, it is possible to simply invoke::\n   969\u2192\n   970\u2192        await conductor.get('/messages')\n   971\u2192        await conductor.request('LOCK', '/files/first')\n   972\u2192\n   973\u2192    Args:\n   974\u2192        app (callable): An ASGI application to target when simulating\n   975\u2192            requests.\n   976\u2192\n   977\u2192    Keyword Arguments:\n   978\u2192        headers (dict): Default headers to set on every request (default\n   979\u2192            ``None``). These defaults may be overridden by passing values\n   980\u2192            for the same headers to one of the ``simulate_*()`` methods.\n   981\u2192\n   982\u2192    Attributes:\n   983\u2192        app: The app that this client instance was configured to use.\n   984\u2192\n   985\u2192    \"\"\"\n   986\u2192\n   987\u2192    def __init__(self, app, headers=None):\n   988\u2192        if not _is_asgi_app(app):\n   989\u2192            raise CompatibilityError('ASGIConductor may only be used with an ASGI app')\n   990\u2192\n   991\u2192        self.app = app\n   992\u2192        self._default_headers = headers\n   993\u2192\n   994\u2192        self._shutting_down = asyncio.Condition()\n   995\u2192        self._lifespan_event_collector = helpers.ASGIResponseEventCollector()\n   996\u2192        self._lifespan_task = None\n   997\u2192\n   998\u2192    async def __aenter__(self):\n   999\u2192        lifespan_scope = {\n  1000\u2192            'type': ScopeType.LIFESPAN,\n  1001\u2192            'asgi': {\n  1002\u2192                'version': '3.0',\n  1003\u2192                'spec_version': '2.0',\n  1004\u2192            },\n  1005\u2192        }\n  1006\u2192\n  1007\u2192        lifespan_event_emitter = helpers.ASGILifespanEventEmitter(self._shutting_down)\n  1008\u2192\n  1009\u2192        # NOTE(kgriffs): We assume this is a Falcon ASGI app, which supports\n  1010\u2192        #   the lifespan protocol and thus we do not need to catch\n  1011\u2192        #   exceptions that would signify no lifespan protocol support.\n  1012\u2192        self._lifespan_task = get_running_loop().create_task(\n  1013\u2192            self.app(\n  1014\u2192                lifespan_scope, lifespan_event_emitter, self._lifespan_event_collector\n  1015\u2192            )\n  1016\u2192        )\n  1017\u2192\n  1018\u2192        await _wait_for_startup(self._lifespan_event_collector.events)\n  1019\u2192\n  1020\u2192        return self\n  1021\u2192\n  1022\u2192    async def __aexit__(self, ex_type, ex, tb):\n  1023\u2192        if ex_type:\n  1024\u2192            return False\n  1025\u2192\n  1026\u2192        # NOTE(kgriffs): Notify lifespan_event_emitter that it is OK\n  1027\u2192        #   to proceed.\n  1028\u2192        async with self._shutting_down:\n  1029\u2192            self._shutting_down.notify()\n  1030\u2192\n  1031\u2192        await _wait_for_shutdown(self._lifespan_event_collector.events)\n  1032\u2192        await self._lifespan_task\n  1033\u2192\n  1034\u2192        return True\n  1035\u2192\n  1036\u2192    async def simulate_get(self, path='/', **kwargs) -> _ResultBase:\n  1037\u2192        \"\"\"Simulate a GET request to an ASGI application.\n  1038\u2192\n  1039\u2192        (See also: :py:meth:`falcon.testing.simulate_get`)\n  1040\u2192        \"\"\"\n  1041\u2192        return await self.simulate_request('GET', path, **kwargs)\n  1042\u2192\n  1043\u2192    def simulate_get_stream(self, path='/', **kwargs):\n  1044\u2192        \"\"\"Simulate a GET request to an ASGI application with a streamed response.\n  1045\u2192\n  1046\u2192        (See also: :py:meth:`falcon.testing.simulate_get` for a list of\n  1047\u2192        supported keyword arguments.)\n  1048\u2192\n  1049\u2192        This method returns an async context manager that can be used to obtain\n  1050\u2192        a managed :class:`~.StreamedResult` instance. Exiting the context\n  1051\u2192        will automatically finalize the result object, causing the request\n  1052\u2192        event emitter to begin emitting ``'http.disconnect'`` events and then\n  1053\u2192        await the completion of the task that is running the simulated ASGI\n  1054\u2192        request.\n  1055\u2192\n  1056\u2192        In the following example, a series of streamed body chunks are read\n  1057\u2192        from the response::\n  1058\u2192\n  1059\u2192            async with conductor.simulate_get_stream('/events') as sr:\n  1060\u2192                while some_condition:\n  1061\u2192                    # Read next body chunk that was received (if any).\n  1062\u2192                    chunk = await sr.stream.read()\n  1063\u2192\n  1064\u2192                    if chunk:\n  1065\u2192                        # TODO: Do something with the chunk. For example,\n  1066\u2192                        #   a series of server-sent events could be validated\n  1067\u2192                        #   by concatenating the chunks and splitting on\n  1068\u2192                        #   double-newlines to obtain individual events.\n  1069\u2192                        pass\n  1070\u2192\n  1071\u2192        \"\"\"\n  1072\u2192\n  1073\u2192        kwargs['_stream_result'] = True\n  1074\u2192\n  1075\u2192        return _AsyncContextManager(self.simulate_request('GET', path, **kwargs))\n  1076\u2192\n  1077\u2192    def simulate_ws(self, path='/', **kwargs):\n  1078\u2192        \"\"\"Simulate a WebSocket connection to an ASGI application.\n  1079\u2192\n  1080\u2192        All keyword arguments are passed through to\n  1081\u2192        :py:meth:`falcon.testing.create_scope_ws`.\n  1082\u2192\n  1083\u2192        This method returns an async context manager that can be used to obtain\n  1084\u2192        a managed :class:`falcon.testing.ASGIWebSocketSimulator` instance.\n  1085\u2192        Exiting the context will simulate a close on the WebSocket (if not\n  1086\u2192        already closed) and await the completion of the task that is\n  1087\u2192        running the simulated ASGI request.\n  1088\u2192\n  1089\u2192        In the following example, a series of WebSocket TEXT events are\n  1090\u2192        received from the ASGI app::\n  1091\u2192\n  1092\u2192            async with conductor.simulate_ws('/events') as ws:\n  1093\u2192                while some_condition:\n  1094\u2192                    message = await ws.receive_text()\n  1095\u2192\n  1096\u2192        \"\"\"\n  1097\u2192\n  1098\u2192        scope = helpers.create_scope_ws(path=path, **kwargs)\n  1099\u2192        ws = helpers.ASGIWebSocketSimulator()\n  1100\u2192\n  1101\u2192        task_req = create_task(self.app(scope, ws._emit, ws._collect))\n  1102\u2192\n  1103\u2192        return _WSContextManager(ws, task_req)\n  1104\u2192\n  1105\u2192    async def simulate_head(self, path='/', **kwargs) -> _ResultBase:\n  1106\u2192        \"\"\"Simulate a HEAD request to an ASGI application.\n  1107\u2192\n  1108\u2192        (See also: :py:meth:`falcon.testing.simulate_head`)\n  1109\u2192        \"\"\"\n  1110\u2192        return await self.simulate_request('HEAD', path, **kwargs)\n  1111\u2192\n  1112\u2192    async def simulate_post(self, path='/', **kwargs) -> _ResultBase:\n  1113\u2192        \"\"\"Simulate a POST request to an ASGI application.\n  1114\u2192\n  1115\u2192        (See also: :py:meth:`falcon.testing.simulate_post`)\n  1116\u2192        \"\"\"\n  1117\u2192        return await self.simulate_request('POST', path, **kwargs)\n  1118\u2192\n  1119\u2192    async def simulate_put(self, path='/', **kwargs) -> _ResultBase:\n  1120\u2192        \"\"\"Simulate a PUT request to an ASGI application.\n  1121\u2192\n  1122\u2192        (See also: :py:meth:`falcon.testing.simulate_put`)\n  1123\u2192        \"\"\"\n  1124\u2192        return await self.simulate_request('PUT', path, **kwargs)\n  1125\u2192\n  1126\u2192    async def simulate_options(self, path='/', **kwargs) -> _ResultBase:\n  1127\u2192        \"\"\"Simulate an OPTIONS request to an ASGI application.\n  1128\u2192\n  1129\u2192        (See also: :py:meth:`falcon.testing.simulate_options`)\n  1130\u2192        \"\"\"\n  1131\u2192        return await self.simulate_request('OPTIONS', path, **kwargs)\n  1132\u2192\n  1133\u2192    async def simulate_patch(self, path='/', **kwargs) -> _ResultBase:\n  1134\u2192        \"\"\"Simulate a PATCH request to an ASGI application.\n  1135\u2192\n  1136\u2192        (See also: :py:meth:`falcon.testing.simulate_patch`)\n  1137\u2192        \"\"\"\n  1138\u2192        return await self.simulate_request('PATCH', path, **kwargs)\n  1139\u2192\n  1140\u2192    async def simulate_delete(self, path='/', **kwargs) -> _ResultBase:\n  1141\u2192        \"\"\"Simulate a DELETE request to an ASGI application.\n  1142\u2192\n  1143\u2192        (See also: :py:meth:`falcon.testing.simulate_delete`)\n  1144\u2192        \"\"\"\n  1145\u2192        return await self.simulate_request('DELETE', path, **kwargs)\n  1146\u2192\n  1147\u2192    async def simulate_request(self, *args, **kwargs) -> _ResultBase:\n  1148\u2192        \"\"\"Simulate a request to an ASGI application.\n  1149\u2192\n  1150\u2192        Wraps :py:meth:`falcon.testing.simulate_request` to perform a\n  1151\u2192        WSGI request directly against ``self.app``. Equivalent to::\n  1152\u2192\n  1153\u2192            falcon.testing.simulate_request(self.app, *args, **kwargs)\n  1154\u2192        \"\"\"\n  1155\u2192\n  1156\u2192        if self._default_headers:\n  1157\u2192            # NOTE(kgriffs): Handle the case in which headers is explicitly\n  1158\u2192            # set to None.\n  1159\u2192            additional_headers = kwargs.get('headers', {}) or {}\n  1160\u2192\n  1161\u2192            merged_headers = self._default_headers.copy()\n  1162\u2192            merged_headers.update(additional_headers)\n  1163\u2192\n  1164\u2192            kwargs['headers'] = merged_headers\n  1165\u2192\n  1166\u2192        # NOTE(kgriffs): The conductor takes care of startup/shutdown\n  1167\u2192        kwargs['_one_shot'] = False\n  1168\u2192\n  1169\u2192        return await _simulate_request_asgi(self.app, *args, **kwargs)\n  1170\u2192\n  1171\u2192    delete = _simulate_method_alias(simulate_delete)\n  1172\u2192    get = _simulate_method_alias(simulate_get)\n  1173\u2192    get_stream = _simulate_method_alias(simulate_get_stream, replace_name='get_stream')\n  1174\u2192    head = _simulate_method_alias(simulate_head)\n  1175\u2192    options = _simulate_method_alias(simulate_options)\n  1176\u2192    patch = _simulate_method_alias(simulate_patch)\n  1177\u2192    post = _simulate_method_alias(simulate_post)\n  1178\u2192    put = _simulate_method_alias(simulate_put)\n  1179\u2192    request = _simulate_method_alias(simulate_request)\n  1180\u2192    websocket = _simulate_method_alias(simulate_ws, replace_name='websocket')\n  1181\u2192\n  1182\u2192\n  1183\u2192def simulate_get(app, path, **kwargs) -> _ResultBase:\n  1184\u2192    \"\"\"Simulate a GET request to a WSGI or ASGI application.\n  1185\u2192\n  1186\u2192    Equivalent to::\n  1187\u2192\n  1188\u2192         simulate_request(app, 'GET', path, **kwargs)\n  1189\u2192\n  1190\u2192    Note:\n  1191\u2192        In the case of an ASGI request, this method will simulate the entire\n  1192\u2192        app lifecycle in a single shot, including lifespan and client\n  1193\u2192        disconnect events. In order to simulate multiple interleaved\n  1194\u2192        requests, or to test a streaming endpoint (such as one that emits\n  1195\u2192        server-sent events), :class:`~falcon.testing.ASGIConductor` can be\n  1196\u2192        used to more precisely control the app lifecycle.\n  1197\u2192\n  1198\u2192    Args:\n  1199\u2192        app (callable): The application to call\n  1200\u2192        path (str): The URL path to request\n 