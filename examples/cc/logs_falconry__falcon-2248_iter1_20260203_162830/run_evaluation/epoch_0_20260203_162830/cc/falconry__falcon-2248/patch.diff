+# Add support for the Partitioned cookie flag (CHIPS), aligning with Chrome
+# and CPython 3.13 direction. Ensure Morsel recognizes it as a flag-style
+# attribute (i.e., rendered as "; Partitioned").
+if 'partitioned' not in _reserved_cookie_attrs:  # pragma: no cover
+    _reserved_cookie_attrs['partitioned'] = 'Partitioned'  # type: ignore
+
+_flags = getattr(http_cookies.Morsel, '_flags', None)
+if isinstance(_flags, set) and 'partitioned' not in _flags:  # pragma: no cover
+    _flags.add('partitioned')  # type: ignore
+
+# Auto-enable Partitioned whenever SameSite=None is set on a morsel
+# by temporarily overriding Morsel.__setitem__.
+if not getattr(http_cookies.Morsel, '_falcon_partitioned_patch', False):  # pragma: no cover
+    _orig_setitem = http_cookies.Morsel.__setitem__
