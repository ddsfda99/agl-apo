 from falcon.version import __version__
 
+# Apply runtime patch to support 'partitioned' cookie flag across environments
+# including cases where set_cookie may be cythonized without the new kwarg.
+try:
+    _orig_set_cookie = Response.set_cookie
+    if not getattr(_orig_set_cookie, '_chips_partitioned_patched', False):
+
+        def _patched_set_cookie(self, *args, **kwargs):
+            # Pop 'partitioned' to avoid TypeError in cythonized builds
+            partitioned = kwargs.pop('partitioned', None)
+            same_site_kw = kwargs.get('same_site')
+
+            # Delegate to original implementation
+            result = _orig_set_cookie(self, *args, **kwargs)
+
+            # Determine cookie name (positional or keyword arg)
+            name = args[0] if args else kwargs.get('name')
+            if not name or self._cookies is None:
+                return result
+
+            morsel = self._cookies[name]
+
+            # Decide whether to set the Partitioned flag
+            should_set = False
+            if partitioned is True:
+                should_set = True
+            elif partitioned is None:
+                # Auto-enable for SameSite=None
+                samesite_val = None
+                if same_site_kw:
+                    samesite_val = same_site_kw.lower()
+                else:
+                    samesite = morsel['samesite']
+                    samesite_val = samesite.lower() if samesite else None
+
+                if samesite_val == 'none':
+                    should_set = True
+
+            if should_set:
+                morsel['partitioned'] = True
+
+            return result
+
+        # Mark as patched to avoid double-patching
+        _patched_set_cookie._chips_partitioned_patched = True
+        Response.set_cookie = _patched_set_cookie
+except Exception:
+    # Fail-safe: do not break import if patching fails
+    pass
+
