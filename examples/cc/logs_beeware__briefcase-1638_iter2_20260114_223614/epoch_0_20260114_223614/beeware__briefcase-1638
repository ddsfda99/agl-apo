kwargs,\n   817→            stdout=subprocess.PIPE,\n   818→            stderr=subprocess.STDOUT,\n   819→            bufsize=1,\n   820→        )\n   821→\n   822→        # Start streaming logs for the app.\n   823→        self._stream_app_logs(\n   824→            app,\n   825→            popen=app_popen,\n   826→            test_mode=test_mode,\n   827→            clean_output=False,\n   828→        )\n   829→\n   830→\n   831→def debian_multiline_description(description):\n   832→    \"\"\"Generate a Debian multiline description string.\n   833→\n   834→    The long description in a Debian control file must *not* contain any blank lines,\n   835→    and each line must start with a single space. Convert a long description into Debian\n   836→    format.\n   837→\n   838→    :param description: A multi-line long description string.\n   839→    :returns: A string in Debian's multiline format\n   840→    \"\"\"\n   841→    return \"\\n \".join(line for line in description.split(\"\\n\") if line.strip() != \"\")\n   842→\n   843→\n   844→class LinuxSystemPackageCommand(LinuxSystemMixin, PackageCommand):\n   845→    description = \"Package a Linux system project.\"\n   846→\n   847→    @property\n   848→    def packaging_formats(self):\n   849→        return [\"deb\", \"rpm\", \"pkg\", \"system\"]\n   850→\n   851→    def _verify_packaging_tools(self, app: AppConfig):\n   852→        \"\"\"Verify that the local environment contains the packaging tools.\"\"\"\n   853→        tool_name, executable_name, package_name = {\n   854→            \"deb\": (\"dpkg\", \"dpkg-deb\", \"dpkg-dev\"),\n   855→            \"rpm\": (\"rpm-build\", \"rpmbuild\", \"rpmbuild\"),\n   856→            \"pkg\": (\"makepkg\", \"makepkg\", \"pacman\"),\n   857→        }[app.packaging_format]\n   858→\n   859→        if not self.tools.shutil.which(executable_name):\n   860→            if install_cmd := self._system_requirement_tools(app)[2]:\n   861→                raise BriefcaseCommandError(\n   862→                    f\"Can't find the {tool_name} tools. \"\n   863→                    f\"Try running `sudo {' '.join(install_cmd)} {package_name}`.\"\n   864→                )\n   865→            else:\n   866→                raise BriefcaseCommandError(\n   867→                    f\"Can't find the {executable_name} tool. \"\n   868→                    f\"Install this first to package the {app.packaging_format}.\"\n   869→                )\n   870→\n   871→    def verify_app_tools(self, app):\n   872→        super().verify_app_tools(app)\n   873→        # If \"system\" packaging format was selected, determine what that means.\n   874→        if app.packaging_format == \"system\":\n   875→            app.packaging_format = {\n   876→                DEBIAN: \"deb\",\n   877→                RHEL: \"rpm\",\n   878→                ARCH: \"pkg\",\n   879→                SUSE: \"rpm\",\n   880→            }.get(app.target_vendor_base, None)\n   881→\n   882→        if app.packaging_format is None:\n   883→            raise BriefcaseCommandError(\n   884→                \"Briefcase doesn't know the system packaging format for \"\n   885→                f\"{app.target_vendor}. You may be able to build a package \"\n   886→                \"by manually specifying a format with -p/--packaging-format\"\n   887→            )\n   888→\n   889→        if not self.use_docker:\n   890→            self._verify_packaging_tools(app)\n   891→\n   892→    def package_app(self, app: AppConfig, **kwargs):\n   893→        if app.packaging_format == \"deb\":\n   894→            self._package_deb(app, **kwargs)\n   895→        elif app.packaging_format == \"rpm\":\n   896→            self._package_rpm(app, **kwargs)\n   897→        elif app.packaging_format == \"pkg\":\n   898→            self._package_pkg(app, **kwargs)\n   899→        else:\n   900→            raise BriefcaseCommandError(\n   901→                \"Briefcase doesn't currently know how to build system packages in \"\n   902→                f\"{app.packaging_format.upper()} format.\"\n   903→            )\n   904→\n   905→    def _package_deb(self, app: AppConfig, **kwargs):\n   906→        self.logger.info(\"Building .deb package...\", prefix=app.app_name)\n   907→\n   908→        # The long description *must* exist.\n   909→        if app.long_description is None:\n   910→            raise BriefcaseCommandError(\n   911→                \"App configuration does not define `long_description`. \"\n   912→                \"Debian projects require a long description.\"\n   913→            )\n   914→\n   915→        # Write the Debian metadata control file.\n   916→        with self.input.wait_bar(\"Write Debian package control file...\"):\n   917→            DEBIAN_path = self.project_path(app) / \"DEBIAN\"\n   918→\n   919→            if DEBIAN_path.exists():\n   920→                self.tools.shutil.rmtree(DEBIAN_path)\n   921→\n   922→            DEBIAN_path.mkdir()\n   923→            # dpkg-dep requires \"DEBIAN\" directory is >=0755 and <=0775\n   924→            DEBIAN_path.chmod(0o755)\n   925→\n   926→            # Add runtime package dependencies. App config has been finalized,\n   927→            # so this will be the target-specific definition, if one exists.\n   928→            # libc6 is added because lintian complains without it, even though\n   929→            # it's a dependency of the thing we *do* care about - python.\n   930→            system_runtime_requires = \", \".join(\n   931→                [\n   932→                    f\"libc6 (>={app.glibc_version})\",\n   933→                    f\"libpython{app.python_version_tag}\",\n   934→                ]\n   935→                + getattr(app, \"system_runtime_requires\", [])\n   936→            )\n   937→\n   938→            with (DEBIAN_path / \"control\").open(\"w\", encoding=\"utf-8\") as f:\n   939→                f.write(\n   940→                    \"\\n\".join(\n   941→                        [\n   942→                            f\"Package: {app.app_name}\",\n   943→                            f\"Version: {app.version}\",\n   944→                            f\"Architecture: {self.deb_abi(app)}\",\n   945→                            f\"Maintainer: {app.author} <{app.author_email}>\",\n   946→                            f\"Homepage: {app.url}\",\n   947→                            f\"Description: {app.description}\",\n   948→                            f\" {debian_multiline_description(app.long_description)}\",\n   949→                            f\"Depends: {system_runtime_requires}\",\n   950→                            f\"Section: {getattr(app, 'system_section', 'utils')}\",\n   951→                            \"Priority: optional\\n\",\n   952→                        ]\n   953→                    )\n   954→                )\n   955→\n   956→        with self.input.wait_bar(\"Building Debian package...\"):\n   957→            try:\n   958→                # Build the dpkg.\n   959→                self.tools[app].app_context.run(\n   960→                    [\n   961→                        \"dpkg-deb\",\n   962→                        \"--build\",\n   963→                        \"--root-owner-group\",\n   964→                        f\"{app.app_name}-{app.version}\",\n   965→                    ],\n   966→                    check=True,\n   967→                    cwd=self.bundle_path(app),\n   968→                )\n   969→            except subprocess.CalledProcessError as e:\n   970→                raise BriefcaseCommandError(\n   971→                    f\"Error while building .deb package for {app.app_name}.\"\n   972→                ) from e\n   973→\n   974→            # Move the deb file to its final location\n   975→            self.tools.shutil.move(\n   976→                self.bundle_path(app) / f\"{app.app_name}-{app.version}.deb\",\n   977→                self.distribution_path(app),\n   978→            )\n   979→\n   980→    def _package_rpm(self, app: AppConfig, **kwargs):  # pragma: no-cover-if-is-windows\n   981→        self.logger.info(\"Building .rpm package...\", prefix=app.app_name)\n   982→\n   983→        # The long description *must* exist.\n   984→        if app.long_description is None:\n   985→            raise BriefcaseCommandError(\n   986→                \"App configuration does not define `long_description`. \"\n   987→                \"Red Hat projects require a long description.\"\n   988→            )\n   989→\n   990→        # Generate the rpmbuild layout\n   991→        rpmbuild_path = self.bundle_path(app) / \"rpmbuild\"\n   992→        with self.input.wait_bar(\"Generating rpmbuild layout...\"):\n   993→            if rpmbuild_path.exists():\n   994→                self.tools.shutil.rmtree(rpmbuild_path)\n   995→\n   996→            (rpmbuild_path / \"BUILD\").mkdir(parents=True)\n   997→            (rpmbuild_path / \"BUILDROOT\").mkdir(parents=True)\n   998→            (rpmbuild_path / \"RPMS\").mkdir(parents=True)\n   999→            (rpmbuild_path / \"SOURCES\").mkdir(parents=True)\n  1000→            (rpmbuild_path / \"SRPMS\").mkdir(parents=True)\n  1001→            (rpmbuild_path / \"SPECS\").mkdir(parents=True)\n  1002→\n  1003→        # Add runtime package dependencies. App config has been finalized,\n  1004→        # so this will be the target-specific definition, if one exists.\n  1005→        system_runtime_requires = [\n  1006→            \"python3\",\n  1007→        ] + getattr(app, \"system_runtime_requires\", [])\n  1008→\n  1009→        # Write the spec file\n  1010→        with self.input.wait_bar(\"Write RPM spec file...\"):\n  1011→            with (rpmbuild_path / \"SPECS\" / f\"{app.app_name}.spec\").open(\n  1012→                \"w\", encoding=\"utf-8\"\n  1013→            ) as f:\n  1014→                f.write(\n  1015→                    \"\\n\".join(\n  1016→                        [\n  1017→                            # By default, rpmbuild thinks all .py files are executable,\n  1018→                            # and if a .py doesn't have a shebang line, it will\n  1019→                            # tell you that it will remove the executable bit -\n  1020→                            # even if the executable bit isn't set.\n  1021→                            # We disable the processor that does this.\n  1022→                            \"%global __brp_mangle_shebangs %{nil}\",\n  1023→                            # rpmbuild tries to strip binaries, which messes with\n  1024→                            # binary wheels. Disable these checks.\n  1025→                            \"%global __brp_strip %{nil}\",\n  1026→                            \"%global __brp_strip_static_archive %{nil}\",\n  1027→                            \"%global __brp_strip_comment_note %{nil}\",\n  1028→                            # Disable RPATH checking, because check-rpaths can't deal with\n  1029→                            # the structure of manylinux wheels\n  1030→                            \"%global __brp_check_rpaths %{nil}\",\n  1031→                            # Disable all the auto-detection that tries to magically\n  1032→                            # determine requirements from the binaries\n  1033→                            f\"%global __requires_exclude_from ^%{{_libdir}}/{app.app_name}/.*$\",\n  1034→                            f\"%global __provides_exclude_from ^%{{_libdir}}/{app.app_name}/.*$\",\n  1035→                            # Disable debug processing.\n  1036→                            \"%global _enable_debug_package 0\",\n  1037→                            \"%global debug_package %{nil}\",\n  1038→                            \"\",\n  1039→                            # Base package metadata\n  1040→                            f\"Name:           {app.app_name}\",\n  1041→                            f\"Version:        {app.version}\",\n  1042→                            f\"Release:        {getattr(app, 'revision', 1)}%{{