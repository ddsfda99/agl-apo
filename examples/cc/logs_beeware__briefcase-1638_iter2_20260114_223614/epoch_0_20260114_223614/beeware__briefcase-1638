can be run, but\n   197→    # doesn't require that we're actually in a Linux environment.\n   198→\n   199→    @property\n   200→    def use_docker(self):\n   201→        # The system backend doesn't have a literal \"--use-docker\" option, but\n   202→        # `use_docker` is a useful flag for shared logic purposes, so evaluate\n   203→        # what \"use docker\" means in terms of target_image.\n   204→        return bool(self.target_image)\n   205→\n   206→    def app_python_version_tag(self, app: AppConfig):\n   207→        if self.use_docker:\n   208→            # If we're running in Docker, we can't know the Python3 version\n   209→            # before rolling out the template; so we fall back to \"3\". Later,\n   210→            # once we have a container in which we can run Python, this will be\n   211→            # updated to the actual Python version as part of the\n   212→            # `verify_python` app check.\n   213→            python_version_tag = \"3\"\n   214→        else:\n   215→            python_version_tag = super().app_python_version_tag(app)\n   216→        return python_version_tag\n   217→\n   218→    def _build_env_abi(self, app: AppConfig):\n   219→        \"\"\"Retrieves the ABI the packaging system is targeting in the build env.\n   220→\n   221→        Each packaging system uses different values to identify the exact ABI that\n   222→        describes the target environment...so just defer to the packaging system.\n   223→        \"\"\"\n   224→        command = {\n   225→            \"deb\": [\"dpkg\", \"--print-architecture\"],\n   226→            \"rpm\": [\"rpm\", \"--eval\", \"%_target_cpu\"],\n   227→            \"pkg\": [\"pacman-conf\", \"Architecture\"],\n   228→        }[app.packaging_format]\n   229→        try:\n   230→            return (\n   231→                self.tools[app].app_context.check_output(command).split(\"\\n\")[0].strip()\n   232→            )\n   233→        except (OSError, subprocess.CalledProcessError) as e:\n   234→            raise BriefcaseCommandError(\n   235→                \"Failed to determine build environment's ABI for packaging.\"\n   236→            ) from e\n   237→\n   238→    def deb_abi(self, app: AppConfig) -> str:\n   239→        \"\"\"The default ABI for dpkg packaging for the target environment.\"\"\"\n   240→        try:\n   241→            return self._deb_abi\n   242→        except AttributeError:\n   243→            self._deb_abi = self._build_env_abi(app)\n   244→            return self._deb_abi\n   245→\n   246→    def rpm_abi(self, app: AppConfig) -> str:\n   247→        \"\"\"The default ABI for rpm packaging for the target environment.\"\"\"\n   248→        try:\n   249→            return self._rpm_abi\n   250→        except AttributeError:\n   251→            self._rpm_abi = self._build_env_abi(app)\n   252→            return self._rpm_abi\n   253→\n   254→    def pkg_abi(self, app: AppConfig) -> str:\n   255→        \"\"\"The default ABI for pacman packaging for the target environment.\"\"\"\n   256→        try:\n   257→            return self._pkg_abi\n   258→        except AttributeError:\n   259→            self._pkg_abi = self._build_env_abi(app)\n   260→            return self._pkg_abi\n   261→\n   262→    def distribution_filename(self, app: AppConfig) -> str:\n   263→        if app.packaging_format == \"deb\":\n   264→            return (\n   265→                f\"{app.app_name}\"\n   266→                f\"_{app.version}\"\n   267→                f\"-{getattr(app, 'revision', 1)}\"\n   268→                f\"~{app.target_vendor}\"\n   269→                f\"-{app.target_codename}\"\n   270→                f\"_{self.deb_abi(app)}\"\n   271→                \".deb\"\n   272→            )\n   273→        elif app.packaging_format == \"rpm\":\n   274→            # openSUSE doesn't include a distro tag\n   275→            if app.target_vendor_base == SUSE:\n   276→                distro_tag = \"\"\n   277→            else:\n   278→                distro_tag = f\".{self.rpm_tag(app)}\"\n   279→            return (\n   280→                f\"{app.app_name}\"\n   281→                f\"-{app.version}\"\n   282→                f\"-{getattr(app, 'revision', 1)}\"\n   283→                f\"{distro_tag}\"\n   284→                f\".{self.rpm_abi(app)}\"\n   285→                f\".rpm\"\n   286→            )\n   287→        elif app.packaging_format == \"pkg\":\n   288→            return (\n   289→                f\"{app.app_name}\"\n   290→                f\"-{app.version}\"\n   291→                f\"-{getattr(app, 'revision', 1)}\"\n   292→                f\"-{self.pkg_abi(app)}\"\n   293→                \".pkg.tar.zst\"\n   294→            )\n   295→        else:\n   296→            raise BriefcaseCommandError(\n   297→                \"Briefcase doesn't currently know how to build system packages in \"\n   298→                f\"{app.packaging_format.upper()} format.\"\n   299→            )\n   300→\n   301→    def distribution_path(self, app: AppConfig):\n   302→        return self.dist_path / self.distribution_filename(app)\n   303→\n   304→    def target_glibc_version(self, app):\n   305→        \"\"\"Determine the glibc version.\n   306→\n   307→        If running in Docker, this is done by interrogating libc.so.6; outside docker,\n   308→        we can use os.confstr().\n   309→        \"\"\"\n   310→        if self.use_docker:\n   311→            try:\n   312→                output = self.tools.docker.check_output(\n   313→                    [\"ldd\", \"--version\"],\n   314→                    image_tag=app.target_image,\n   315→                )\n   316→                # On Debian/Ubuntu, ldd --version will give you output of the form:\n   317→                #\n   318→                #     ldd (Ubuntu GLIBC 2.31-0ubuntu9.9) 2.31\n   319→                #     Copyright (C) 2020 Free Software Foundation, Inc.\n   320→                #     ...\n   321→                #\n   322→                # Other platforms produce output of the form:\n   323→                #\n   324→                #     ldd (GNU libc) 2.36\n   325→                #     Copyright (C) 2020 Free Software Foundation, Inc.\n   326→                #     ...\n   327→                #\n   328→                # Note that the exact text will vary version to version.\n   329→                # Look for the \"2.NN\" pattern.\n   330→                if match := re.search(r\"\\d\\.\\d+\", output):\n   331→                    target_glibc = match.group(0)\n   332→                else:\n   333→                    raise BriefcaseCommandError(\n   334→                        \"Unable to parse glibc dependency version from version string.\"\n   335→                    )\n   336→            except subprocess.CalledProcessError:\n   337→                raise BriefcaseCommandError(\n   338→                    \"Unable to determine glibc dependency version.\"\n   339→                )\n   340→\n   341→        else:\n   342→            target_glibc = super().target_glibc_version(app)\n   343→\n   344→        return target_glibc\n   345→\n   346→    def platform_freedesktop_info(self, app: AppConfig):\n   347→        if self.use_docker:\n   348→            # Preserve the target image on the command line as the app's target\n   349→            app.target_image = self.target_image\n   350→\n   351→            # Extract release information from the image.\n   352→            with self.input.wait_bar(\n   353→                f\"Checking Docker target image {app.target_image}...\"\n   354→            ):\n   355→                output = self.tools.docker.check_output(\n   356→                    [\"cat\", \"/etc/os-release\"],\n   357→                    image_tag=app.target_image,\n   358→                )\n   359→                freedesktop_info = parse_freedesktop_os_release(output)\n   360→        else:\n   361→            freedesktop_info = super().platform_freedesktop_info(app)\n   362→\n   363→        return freedesktop_info\n   364→\n   365→    def docker_image_tag(self, app: AppConfig):\n   366→        \"\"\"The Docker image tag for an app.\"\"\"\n   367→        return f\"briefcase/{app.bundle_identifier.lower()}:{app.target_vendor}-{app.target_codename}\"\n   368→\n   369→    def verify_tools(self):\n   370→        \"\"\"If we're using Docker, verify that it is available.\"\"\"\n   371→        super().verify_tools()\n   372→        if self.use_docker:\n   373→            Docker.verify(tools=self.tools, image_tag=self.target_image)\n   374→\n   375→    def add_options(self, parser):\n   376→        super().add_options(parser)\n   377→        parser.add_argument(\n   378→            \"--target\",\n   379→            dest=\"target\",\n   380→            help=\"Docker base image tag for the distribution to target for the build (e.g., `ubuntu:jammy`)\",\n   381→            required=False,\n   382→        )\n   383→\n   384→    def parse_options(self, extra):\n   385→        \"\"\"Extract the target_image option.\"\"\"\n   386→        options, overrides = super().parse_options(extra)\n   387→        self.target_image = options.pop(\"target\")\n   388→\n   389→        return options, overrides\n   390→\n   391→    def clone_options(self, command):\n   392→        \"\"\"Clone the target_image option.\"\"\"\n   393→        super().clone_options(command)\n   394→        self.target_image = command.target_image\n   395→\n   396→    def verify_python(self, app: AppConfig):\n   397→        \"\"\"Verify that the version of Python being used to build the app in Docker is\n   398→        compatible with the version being used to run Briefcase.\n   399→\n   400→        Will raise an exception if the Python version is fundamentally\n   401→        incompatible (i.e., if Briefcase doesn't support it); any other version\n   402→        discrepancy will log a warning, but continue.\n   403→\n   404→        Requires that the app tools have been verified.\n   405→\n   406→        As a side effect of verifying Python, the `python_version_tag` will be\n   407→        updated to reflect the *actual* python version, not just a generic \"3\".\n   408→\n   409→        :param app: The application being built\n   410→        \"\"\"\n   411→        output = self.tools[app].app_context.check_output(\n   412→            [\n   413→                f\"python{app.python_version_tag}\",\n   414→                \"-c\",\n   415→                (\n   416→                    \"import sys; \"\n   417→                    \"print(f'{sys.version_info.major}.{sys.version_info.minor}')\"\n   418→                ),\n   419→            ]\n   420→        )\n   421→        # Update the python version tag with the *actual* python version.\n   422→        app.python_version_tag = output.split(\"\\n\")[0]\n   423→        target_python_version = tuple(int(v) for v in app.python_version_tag.split(\".\"))\n   424→\n   425→        if target_python_version < self.briefcase_required_python_version:\n   426→            briefcase_min_version = \".\".join(\n   427→                str(v) for v in self.briefcase_required_python_version\n   428→            )\n   429→            raise BriefcaseCommandError(\n   430→                f\"The system python3 version provided by {app.target_image} \"\n   431→                f\"is {app.python_version_tag}; Briefcase requires a \"\n   432→                f\"minimum Python3 version of {briefcase_min_version}.\"\n   433→            )\n   434→        elif target_python_version != (\n   435→            self.tools.sys.version_info.major,\n   436→            self.tools.sys.version_info.minor,\n   437→        ):\n   438→            self.logger.warning(\n   439→                f\"\"\"\n   440→*************************************************************************\n   441→** WARNING: Python version mismatch!                                   **\n   442→*************************************************************************\n   443→\n   444→    The system python3 provided by {app.target_image} is {app.python_version_tag}.\n   445→    This is not the same as your local system ({self.python_version_tag}).\n   446→\n   447→    Ensure you have tested for Python version compatibility before\n   448→    releasing this app.\n   449→\n   450→*************************************************************************\n   451→\"\"\"\n   452→            )\n   453→\n   454→    def verify_system_python(self):\n   455→        \"\"\"Verify that the Python being used to run Briefcase is the default system\n   456→        python.\n   457→\n   458→        Will raise an exception if the system Python isn't an obvious Python3, or the\n   459→        Briefcase Python isn't the same version as the system Python.\n   460→\n   461→        Requires that the app tools have been verified.\n   462→        \"\"\"\n   463→        system_python_bin = Path(\"/usr/bin/python3\").resolve()\n   464→        system_version = system_python_bin.name.split(\".\")\n   465→        if system_version[0] != \"python3\" or len(system_version) == 1:\n   466→            raise BriefcaseCommandError(\"Can't determine the system python version\")\n   467→\n   468→        if system_version[1] != str(self.tools.sys.version_info.minor):\n   469→            raise BriefcaseCommandError(\n   470→                f\"The version of Python being used to run Briefcase ({self.python_version_tag}) \"\n   471→                f\"is not the system python3 (3.{system_version[1]}).\"\n   472→            )\n   473→\n   474→    def _system_requirement_tools(self, app: AppConfig):\n   475→        \"\"\"Utility method returning the packages and tools needed to verify system\n   476→        requirements.\n   477→\n   478→        :param app: The app being built.\n   479→        :returns: A triple containing (0) The list of package names that must\n   480→            be installed at a bare minimum; (1) the arguments for the command\n   481→            used to verify the existence of a package on a system, and (2)\n   482→            the command used to install packages. All three values are `None`\n   483→            if the system cannot be identified.\n   484→        \"\"\"\n   485→        if app.target_vendor_base == DEBIAN:\n   486→            base_system_packages = [\"python3-dev\", \"build-essential\"]\n   487→            system_verify = [\"dpkg\", \"-s\"]\n   488→            system_installer = [\"apt\", \"install\"]\n   489→        elif app.target_vendor_base == RHEL:\n   490→            base_system_packages = [\n   491→                \"python3-devel\",\n   492→                \"gcc\",\n   493→                \"make\",\n   494→                \"pkgconf-pkg-config\",\n   495→            ]\n   496→            system_verify = [\"rpm\", \"-q\"]\n   497→            system_installer = [\"dnf\", \"install\"]\n   498→        elif app.target_vendor_base == SUSE:\n   499→            base_system_packages = [\n   500→                \"python3-devel\",\n   501→                \"patterns-devel-base-devel_basis\",\n   502→            ]\n   503→            system_verify = [\"rpm\", \"-q\", \"--whatprovides\"]\n   504→            system_installer = [\"zypper\", \"install\"]\n   505→        elif app.target_vendor_base == ARCH:\n   506→            base_system_packages = [\n   507→                \"python3\",\n   508→                \"base-devel\",\n   509→            ]\n   510→            system_verify = [\"pacman\", \"-Q\"]\n   511→            system_installer = [\"pacman\", \"-Syu\"]\n   512→        else:\n   513→            base_system_packages = None\n   514→            system_verify = None\n   515→            system_installer = None\n   516→\n   517→        return (\n   518→            base_system_packages,\n   519→            system_verify,\n   520→            system_installer,\n   521→        )\n   522→\n   523→    def verify_system_packages(self, app: AppConfig):\n   524→        \"\"\"Verify that the required system packages are installed.\n   525→\n   526→        :param app: The app being built.\n   527→        \"\"\"\n   528→        (\n   529→            base_system_packages,\n   530→            system_verify,\n   531→            system_installer,\n   532→        ) = self._system_requirement_tools(app)\n   533→\n   534→        if not (system_verify and self.tools.shutil.which(system_verify[0])):\n   535→            self.logger.warning(\n   536→                \"\"\"\n   537→*************************************************************************\n   538→** WARNING: Can't verify system packages                               **\n   539→*************************************************************************\n   540→\n   541→    Briefcase doesn't know how to verify the installation of system\n   542→    packages on your Linux distribution. If you have any problems\n   543→    building this app, ensure that the packages listed in the app's\n   544→    `system_requires` setting have been installed.\n   545→\n   546→*************************************************************************\n   547→\"\"\"\n   548→            )\n   549→            return\n   550→\n   551→        # Run a check for each package listed in the app's system_requires,\n   552→        # plus the baseline system packages that are required.\n   553→        missing = []\n   554→        for package in base_system_packages + getattr(app, \"system_requires\", []):\n   555→            try:\n   556→                self.tools.subprocess.check_output(system_verify + [package])\n   557→            except subprocess.CalledProcessError:\n   558→                missing.append(package)\n   559→\n   560→        # If any required packages are missing, raise an error.\n   561→        if missing:\n   562→            raise BriefcaseCommandError(\n   563→                f\"\"\"\\\n   564→Unable to build {app.app_name} due to missing system dependencies. Run:\n   565→\n   566→    sudo {\" \".join(system_installer)} {\" \".join(missing)}\n   567→\n   568→to install the missing dependencies, and re-run Briefcase.\n   569→\"\"\"\n   570→            )\n   571→\n   572→    def verify_app_tools(self, app: AppConfig):\n   573→        \"\"\"Verify App environment is prepared and available.\n   574→\n   575→        When Docker is used, create or update a Docker image for the App. Without\n   576→        Docker, the host machine will be used as the App environment.\n   577→\n   578→        :param app: The application being built\n   579→        \"\"\"\n   580→        # Verifying the App context is idempotent; but we have some\n   581→        # additional logic that we only want to run the first time through.\n   582→        # Check (and store) the pre-verify app tool state.\n   583→        verify_python = not hasattr(self.tools[app], \"app_context\")\n   584→\n   585→        if self.use_docker:\n   586→            DockerAppContext.verify(\n   587→                tools=self.tools,\n   588→                app=app,\n   589→                image_tag=self.docker_image_tag(app),\n   590→                dockerfile_path=self.bundle_path(app) / \"Dockerfile\",\n   591→                app_base_path=self.base_path,\n   592→                host_bundle_path=self.bundle_path(app),\n   593→                host_data_path=self.data_path,\n   594→                python_version=app.python_version_tag,\n   595→            )\n   596→\n   597→            # Check the system Python on the target system to see if it is\n   598→            # compatible with Briefcase.\n   599→            if verify_python:\n   600→                self.verify_python(app)\n   601→        else:\n   602→            NativeAppContext.verify(tools=self.tools, app=app)\n   603→\n   604→            # Check the system Python on the target system to see if it is\n   605→            # compatible with Briefcase, and that the required system packages\n   606→            # are installed.\n   607→            if verify_python:\n   608→                self.verify_system_python()\n   609→                self.verify_system_packages(app)\n   610→\n   611→        # Establish Docker as app context before letting super set subprocess\n   612→        super().verify_app_tools(app)\n   613→\n   614→\n   615→class LinuxSystemMixin(LinuxSystemMostlyPassiveMixin):\n   616→    def verify_host(self):\n   617→        \"\"\"If we're *not* using Docker, verify that we're actually on Linux.\"\"\"\n   618→        super().verify_host()\n   619→        if not self.use_docker:\n   620→            if self.tools.host_os != \"Linux\":\n   621→                raise UnsupportedHostError(self.supported_host_os_reason)\n   622→\n   623→\n   624→class LinuxSystemCreateCommand(LinuxSystemMixin, LocalRequirementsMixin, CreateCommand):\n   625→    description = \"Create and populate a Linux system project.\"\n   626→\n   627→    def output_format_template_context(self, app: AppConfig):\n   628→        context = super().output_format_template_context(app)\n   629→\n   630→        # Linux system templates use the target codename, rather than\n   631→        # the format \"system\" as the leaf of the bundle path\n   632→        context[\"format\"] = app.target_codename\n   633→\n   634→        # The base template context includes the host Python version;\n   635→        # override that with an app-specific Python version, allowing\n   636→        # for the app to be built with the system Python.\n   637→        context[\"python_version\"] = app.python_version_tag\n   638→\n   639→        # Add the docker base image\n   640→        context[\"docker_base_image\"] = app.target_image\n   641→\n   642→        # Add the vendor base\n   643→        context[\"vendor_base\"] = app.target_vendor_base\n   644→\n   645→        # Use the non-root user if Docker is not mapping usernames. Also use a non-root\n   646→        # user if we're on macOS; user mapping doesn't alter Docker operation, but some\n   647→        # packaging tools (e.g., Arch's makepkg) don't like running as root. If we're\n   648→        # not using Docker, this will fall back to the template default, which should be\n   649→        # enabling the root user. This might cause problems later, but it's part of a\n   650→        # much bigger \"does the project need to be updated in light of configuration\n   651→        # changes\" problem.\n   652→        try:\n   653→            context[\"use_non_root_user\"] = (\n   654→                self.tools.host_os == \"Darwin\" or not self.tools.docker.is_user_mapped\n   655→            )\n   656→        except AttributeError:\n   657→            pass  # ignore if not using Docker\n   658→\n   659→        return context\n   660→\n   661→\n   662→class LinuxSystemUpdateCommand(LinuxSystemCreateCommand, UpdateCommand):\n   663→    description = \"Update an existing Linux system project.\"\n   664→\n   665→\n   666→class LinuxSystemOpenCommand(LinuxSystemMostlyPassiveMixin, DockerOpenCommand):\n   667→    description = (\n   668→        \"Open a shell in a Docker container for an existing Linux system project.\"\n   669→    )\n   670→\n   671→\n   672→class LinuxSystemBuildCommand(LinuxSystemMixin, BuildCommand):\n   673→    description = \"Build a Linux system project.\"\n   674→\n   675→    def build_app(self, app: AppConfig, **kwargs):\n   676→        \"\"\"Build an application.\n   677→\n   678→        :param app: The application to build\n   679→        \"\"\"\n   680→        self.logger.info(\"Building application...\", prefix=app.app_name)\n   681→\n   682→        self.logger.info(\"Build bootstrap binary...\")\n   683→        with self.input.wait_bar(\"Building bootstrap binary...\"):\n   684→            try:\n   685→                # Build the bootstrap binary.\n   686→                self.tools[app].app_context.run(\n   687→                    [\n   688→                        \"make\",\n   689→                        \"-C\",\n   690→                        \"bootstrap\",\n   691→                        \"install\",\n   692→                    ],\n   693→                    check=True,\n   694→                    cwd=self.bundle_path(app),\n   695→                )\n   696→            except subprocess.CalledProcessError as e:\n   697→                raise BriefcaseCommandError(\n   698→                    f\"Error building bootstrap binary for {app.app_name}.\"\n   699→                ) from e\n   700→\n   701→        # Make the folder for docs\n   702→        doc_folder = (\n   703→            self.bundle_path(app)\n   704→            / f\"{app.app_name}-{app.version}\"\n   705→            / \"usr\"\n   706→            / \"share\"\n   707→            / \"doc\"\n   708→            / app.app_name\n   709→        )\n   710→        doc_folder.mkdir(parents=True, exist_ok=True)\n   711→\n   712→        with self.input.wait_bar(\"Installing license...\"):\n   713→            license_file = self.base_path / \"LICENSE\"\n   714→            if license_file.is_file():\n   715→                self.tools.shutil.copy(license_file, doc_folder / \"copyright\")\n   716→            else:\n   717→                raise BriefcaseCommandError(\n   718→                    \"\"\"\\\n   719→Your project does not contain a LICENSE file.\n   720→\n   721→Create a file named `LICENSE` in the same directory as your `pyproject.toml`\n   722→with your app's licensing terms.\n   723→\"\"\"\n   724→                )\n   725→\n   726→        with self.input.wait_bar(\"Installing changelog...\"):\n   727→            changelog = self.base_path / \"CHANGELOG\"\n   728→            if changelog.is_file():\n   729→                with changelog.open(encoding=\"utf-8\") as infile:\n   730→                    outfile = gzip.GzipFile(\n   731→                        doc_folder / \"changelog.gz\", mode=\"wb\", mtime=0\n   732→                    )\n   733→                    outfile.write(infile.read().encode(\"utf-8\"))\n   734→                    outfile.close()\n   735→            else:\n   736→                raise BriefcaseCommandError(\n   737→                    \"\"\"\\\n   738→Your project does not contain a CHANGELOG file.\n   739→\n   740→Create a file named `CHANGELOG` in the same directory as your `pyproject.toml`\n   741→with details about the release.\n   742→\"\"\"\n   743→                )\n   744→\n   745→        # Make a folder for manpages\n   746→        man_folder = (\n   747→            self.bundle_path(app)\n   748→            / f\"{app.app_name}-{app.version}\"\n   749→            / \"usr\"\n   750→            / \"share\"\n   751→            / \"man\"\n   752→            / \"man1\"\n   753→        )\n   754→        man_folder.mkdir(parents=True, exist_ok=True)\n   755→\n   756→        with self.input.wait_bar(\"Installing man page...\"):\n   757→            manpage_source = self.bundle_path(app) / f\"{app.app_name}.1\"\n   758→            if manpage_source.is_file():\n   759→                with manpage_source.open(encoding=\"utf-8\") as infile:\n   760→                    outfile = gzip.GzipFile(\n   761→                        man_folder / f\"{app.app_name}.1.gz\", mode=\"wb\", mtime=0\n   762→                    )\n   763→                    outfile.write(infile.read().encode(\"utf-8\"))\n   764→                    outfile.close()\n   765→            else:\n   766→                raise BriefcaseCommandError(\n   767→                    f\"Template does not provide a manpage source file `{app.app_name}.1`\"\n   768→                )\n   769→\n   770→        self.logger.info(\"Update file permissions...\")\n   771→        with self.input.wait_bar(\"Updating file permissions...\"):\n   772→            for path in self.project_path(app).glob(\"**/*\"):\n   773→                old_perms = self.tools.os.stat(path).st_mode & 0o777\n   774→                user_perms = old_perms & 0o700\n   775→                world_perms = old_perms & 0o007\n   776→\n   777→                # File permissions like 775 and 664 (where the group and user\n   778→                # permissions are the same),