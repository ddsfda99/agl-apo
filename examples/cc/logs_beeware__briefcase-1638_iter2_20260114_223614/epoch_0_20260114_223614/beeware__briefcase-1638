ile.write(infile.read().encode(\"utf-8\"))\n   764\u2192                    outfile.close()\n   765\u2192            else:\n   766\u2192                raise BriefcaseCommandError(\n   767\u2192                    f\"Template does not provide a manpage source file `{app.app_name}.1`\"\n   768\u2192                )\n   769\u2192\n   770\u2192        self.logger.info(\"Update file permissions...\")\n   771\u2192        with self.input.wait_bar(\"Updating file permissions...\"):\n   772\u2192            for path in self.project_path(app).glob(\"**/*\"):\n   773\u2192                old_perms = self.tools.os.stat(path).st_mode & 0o777\n   774\u2192                user_perms = old_perms & 0o700\n   775\u2192                world_perms = old_perms & 0o007\n   776\u2192\n   777\u2192                # File permissions like 775 and 664 (where the group and user\n   778\u2192                # permissions are the same), cause Debian heartburn. So, make\n   779\u2192                # sure the group and world permissions are the same\n   780\u2192                new_perms = user_perms | (world_perms << 3) | world_perms\n   781\u2192\n   782\u2192                # If there's been any change in permissions, apply them\n   783\u2192                if new_perms != old_perms:  # pragma: no-cover-if-is-windows\n   784\u2192                    self.logger.info(\n   785\u2192                        \"Updating file permissions on \"\n   786\u2192                        f\"{path.relative_to(self.bundle_path(app))} \"\n   787\u2192                        f\"from {oct(old_perms)[2:]} to {oct(new_perms)[2:]}\"\n   788\u2192                    )\n   789\u2192                    path.chmod(new_perms)\n   790\u2192\n   791\u2192        with self.input.wait_bar(\"Stripping binary...\"):\n   792\u2192            self.tools.subprocess.check_output([\"strip\", self.binary_path(app)])\n   793\u2192\n   794\u2192\n   795\u2192class LinuxSystemRunCommand(LinuxSystemPassiveMixin, RunCommand):\n   796\