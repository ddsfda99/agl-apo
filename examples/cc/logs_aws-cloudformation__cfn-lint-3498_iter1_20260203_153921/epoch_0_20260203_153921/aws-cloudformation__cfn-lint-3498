msg\n    36→from cfnlint.jsonschema.exceptions import (\n    37→    UndefinedTypeCheck,\n    38→    UnknownType,\n    39→    ValidationError,\n    40→)\n    41→from cfnlint.schema.resolver import RefResolver, id_of\n    42→from cfnlint.template import Template\n    43→\n    44→LOGGER = logging.getLogger(__name__)\n    45→\n    46→\n    47→def create(\n    48→    validators: Mapping[str, V] | None = None,\n    49→    function_filter: FunctionFilter | None = None,\n    50→    fn_resolvers: Mapping[str, Any] | None = None,\n    51→):\n    52→    validators_arg = validators or {}\n    53→    function_filter_arg = function_filter or FunctionFilter()\n    54→    fn_resolvers_arg = fn_resolvers or {}\n    55→\n    56→    @dataclass\n    57→    class Validator:\n    58→        \"\"\"\n    59→\n    60→        Arguments:\n    61→\n    62→            schema:\n    63→\n    64→                The schema that the validator object will validate with.\n    65→                It is assumed to be valid, and providing\n    66→                an invalid schema can lead to undefined behavior.\n    67→        \"\"\"\n    68→\n    69→        _type_checker: TypeChecker = field(\n    70→            init=False, default_factory=lambda: cfn_type_checker\n    71→        )\n    72→        format_checker: FormatChecker = field(\n    73→            init=False, default_factory=lambda: cfn_format_checker\n    74→        )\n    75→\n    76→        #: The schema that will be used to validate instances\n    77→        schema: Mapping | bool = field(repr=True, default=True)\n    78→        validators: Mapping[str, V] = field(\n    79→            init=False, default_factory=lambda: validators_arg\n    80→        )\n    81→        resolver: RefResolver = field(default=None, repr=False)  # type: ignore\n    82→        function_filter: FunctionFilter = field(\n    83→            init=True, default_factory=lambda: function_filter_arg\n    84→        )\n    85→        cfn: Template = field(default_factory=lambda: Template(None, {}))\n    86→        context: Context = field(default=None)  # type: ignore\n    87→\n    88→        fn_resolvers: Mapping[\n    89→            str,\n    90→            Callable[[\"Validator\", Any], ResolutionResult],\n    91→        ] = field(init=False, default_factory=lambda: fn_resolvers_arg)\n    92→\n    93→        def __post_init__(self):\n    94→            if self.context is None:\n    95→                self.context = create_context_for_template(self.cfn)\n    96→            if self.resolver is None:\n    97→                self.resolver = RefResolver.from_schema(\n    98→                    schema=self.schema,\n    99→                )\n   100→\n   101→        def is_type(self, instance: Any, type: str) -> bool:\n   102→            \"\"\"\n   103→            Check if the instance is of the given (JSON Schema) type.\n   104→\n   105→            Arguments:\n   106→\n   107→                instance:\n   108→\n   109→                    the value to check\n   110→\n   111→                type:\n   112→\n   113→                    the name of a known (JSON Schema) type\n   114→\n   115→            Returns:\n   116→\n   117→                whether the instance is of the given type\n   118→\n   119→            Raises:\n   120→\n   121→                `cfnlint.jsonschema.exceptions.UnknownType`:\n   122→\n   123→                    if ``type`` is not a known type\n   124→            \"\"\"\n   125→            try:\n   126→                return self._type_checker.is_type(instance, type)\n   127→            except UndefinedTypeCheck:\n   128→                raise UnknownType(type, instance, self.schema)\n   129→\n   130→        def is_valid(self, instance: Any) -> bool:\n   131→            \"\"\"\n   132→            Check if the instance is valid under the current `schema`.\n   133→\n   134→            Returns:\n   135→\n   136→                whether the instance is valid or not\n   137→\n   138→            >>> schema = {\"maxItems\" : 2}\n   139→            >>> StandardValidator(schema).is_valid([2, 3, 4])\n   140→            False\n   141→            \"\"\"\n   142→            error = next(self.iter_errors(instance), None)\n   143→            return error is None\n   144→\n   145→        def _resolve_fn(self, key: str, value: Any) -> ResolutionResult:\n   146→            for (\n   147→                value_resolved_value,\n   148→                value_resolved_validator,\n   149→                value_resolved_errs,\n   150→            ) in self.resolve_value(value):\n   151→                if value_resolved_errs:\n   152→                    continue\n   153→                for (\n   154→                    fn_resolved_value,\n   155→                    fn_resolved_validator,\n   156→                    fn_resolved_err,\n   157→                ) in self.fn_resolvers[key](\n   158→                    value_resolved_validator, value_resolved_value  # type: ignore\n   159→                ):\n   160→                    if fn_resolved_err:\n   161→                        fn_resolved_err.path.appendleft(key)\n   162→                    yield (\n   163→                        fn_resolved_value,\n   164→                        fn_resolved_validator,\n   165→                        fn_resolved_err,\n   166→                    )\n   167→\n   168→        def resolve_value(self, instance: Any) -> ResolutionResult:\n   169→            key, value = is_function(instance)\n   170→            if key in self.fn_resolvers:\n   171→                # There is no None in self.fn_resolvers\n   172→                for r_value, r_validator, r_errs in self._resolve_fn(key, value):  # type: ignore\n   173→                    if not r_errs:\n   174→                        try:\n   175→                            for _, region_context in r_validator.context.ref_value(\n   176→                                \"AWS::Region\"\n   177→                            ):\n   178→                                if self.cfn.conditions.satisfiable(\n   179→                                    region_context.conditions.status,\n   180→                                    region_context.ref_values,\n   181→                                ):\n   182→                                    yield r_value, r_validator.evolve(\n   183→                                        context=region_context.evolve(\n   184→                                            is_resolved_value=True,\n   185→                                        )\n   186→                                    ), r_errs\n   187→                        except UnknownSatisfisfaction as err:\n   188→                            LOGGER.debug(err)\n   189→                            return\n   190→                    else:\n   191→                        yield None, r_validator, r_errs  # type: ignore\n   192→                return\n   193→\n   194→            # The return type is a Protocol and we are returning an instance\n   195→            # we will ignore this error\n   196→            yield instance, self, None  # type: ignore[misc]\n   197→\n   198→        def iter_errors(self, instance: Any) -> ValidationResult:\n   199→            r\"\"\"\n   200→            Lazily yield each of the validation errors in the given instance.\n   201→\n   202→            >>> schema = {\n   203→            ...     \"type\" : \"array\",\n   204→            ...     \"items\" : {\"enum\" : [1, 2, 3]},\n   205→            ...     \"maxItems\" : 2,\n   206→            ... }\n   207→            >>> v = StandardValidator(schema)\n   208→            >>> for error in sorted(v.iter_errors([2, 3, 4]), key=str):\n   209→            ...     print(error.message)\n   210→            4 is not one of [1, 2, 3]\n   211→            [2, 3, 4] is too long\n   212→            \"\"\"\n   213→            schema = self.schema\n   214→\n   215→            if schema is True:\n   216→                return\n   217→            elif schema is False:\n   218→                yield ValidationError(\n   219→                    f\"False schema does not allow {instance!r}\",\n   220→                    validator=None,\n   221→                    validator_value=None,\n   222→                    instance=instance,\n   223→                    schema=schema,\n   224→                )\n   225→                return\n   226→\n   227→            scope = id_of(schema)\n   228→            if scope:\n   229→                self.resolver.push_scope(scope)\n   230→            try:\n   231→                # we need filter and apply schemas against the new instances\n   232→                for _instance, _schema in self.function_filter.filter(\n   233→                    self, instance, schema\n   234→                ):\n   235→                    for k, v in _schema.items():\n   236→                        validator = self.validators.get(k)\n   237→                        if validator is None:\n   238→                            continue\n   239→\n   240→                        try:\n   241→                            for err in validator(self, v, _instance, _schema) or ():\n   242→                                msg = custom_msg(k, _schema) or err.message\n   243→                                if msg is not None:\n   244→                                    err.message = msg\n   245→                                # set details if not already set by the called fn\n   246→                                err._set(\n   247→                                    validator=k,\n   248→                                    validator_value=v,\n   249→                                    instance=_instance,\n   250→                                    schema=_schema,\n   251→                                    type_checker=self._type_checker,\n   252→                                )\n   253→                                if k not in {\"if\", \"$ref\"}:\n   254→                                    err.schema_path.appendleft(k)\n   255→                                yield err\n   256→                        except Exception as err:\n   257→                            LOGGER.debug(err, exc_info=True)\n   258→                            yield ValidationError(\n   259→                                f\"Exception {str(err)!r} raised while validating {k!r}\",\n   260→                                validator=k,\n   261→                                validator_value=v,\n   262→                                instance=instance,\n   263→                                schema=self.schema,\n   264→                                schema_path=deque([k]),\n   265→                            )\n   266→            finally:\n   267→                if scope:\n   268→                    self.resolver.pop_scope()\n   269→\n   270→        def validate(self, instance: Any) -> None:\n   271→            \"\"\"\n   272→            Check if the instance is valid under the current `schema`.\n   273→\n   274→            Raises:\n   275→\n   276→                `cfnlint.jsonschema.exceptions.ValidationError`:\n   277→\n   278→                    if the instance is invalid\n   279→\n   280→            >>> schema = {\"maxItems\" : 2}\n   281→            >>> StandardValidator(schema).validate([2, 3, 4])\n   282→            Traceback (most recent call last):\n   283→                ...\n   284→            ValidationError: [2, 3, 4] is too long\n   285→            \"\"\"\n   286→            for error in self.iter_errors(instance):\n   287→                raise error\n   288→\n   289→        def descend(\n   290→            self,\n   291→            instance: Any,\n   292→            schema: Any,\n   293→            path: str | int | None = None,\n   294→            schema_path: str | int | None = None,\n   295→            property_path: str | None = None,\n   296→        ) -> ValidationResult:\n   297→            for error in self.evolve(\n   298→                schema=schema,\n   299→                context=self.context.evolve(\n   300→                    path=self.context.path.descend(\n   301→                        path=path,\n   302→                        cfn_path=property_path,\n   303→                    ),\n   304→                ),\n   305→            ).iter_errors(instance):\n   306→                if path is not None:\n   307→                    error.path.appendleft(path)\n   308→                if schema_path is not None:\n   309→                    error.schema_path.appendleft(schema_path)\n   310→                yield error\n   311→\n   312→        def evolve(self, **kwargs) -> \"Validator\":\n   313→            \"\"\"\n   314→            Create a new validator like this one, but with given changes.\n   315→\n   316→            Preserves all other attributes, so can be used to e.g. create a\n   317→            validator with a different schema but with the same :kw:`$ref`\n   318→            resolution behavior.\n   319→\n   320→            >>> validator = StandardValidator({})\n   321→            >>> validator.evolve(schema={\"type\": \"number\"})\n   322→            StandardValidator(schema={'type': 'number'}, format_checker=None)\n   323→            \"\"\"\n   324→            cls = self.__class__\n   325→            for f in fields(Validator):\n   326→                if f.init:\n   327→                    kwargs.setdefault(f.name, getattr(self, f.name))\n   328→\n   329→            return cls(**kwargs)\n   330→\n   331→        def extend(\n   332→            self,\n   333→            validators: dict[str, V] | None = None,\n   334→            function_filter: FunctionFilter | None = None,\n   335→            fn_resolvers: Mapping[str, Callable[[\"Validator\", Any], Any]] | None = None,\n   336→        ) -> \"Validator\":\n   337→            \"\"\"\n   338→            Extends the current validator.\n   339→\n   340→            Updates validator in the current instance with the validators provided.\n   341→\n   342→            >>> validator = StandardValidator({}).extend(validators={\"type\": type})\n   343→            \"\"\"\n   344→            all_validators = dict(self.validators)\n   345→            if validators is not None:\n   346→                all_validators.update(validators)\n   347→\n   348→            if function_filter is None:\n   349→                function_filter = self.function_filter\n   350→\n   351→            all_fn_resolvers = dict(self.fn_resolvers)\n   352→            if fn_resolvers is not None:\n   353→                all_fn_resolvers.update(fn_resolvers)\n   354→\n   355→            return create(  # type: ignore\n   356→                validators=all_validators,\n   357→                function_filter=function_filter,\n   358→                fn_resolvers=all_fn_resolvers,\n   359→            )\n   360→\n   361→    return Validator\n   362→\n   363→\n   364→_standard_validators: dict[str, V] = {\n   365→    \"$ref\": _keywords.ref,\n   366→    \"additionalProperties\": _keywords.additionalProperties,\n   367→    \"allOf\": _keywords.allOf,\n   368→    \"anyOf\": _keywords.anyOf,\n   369→    \"const\": _keywords.const,\n   370→    \"contains\": _keywords.contains,\n   371→    \"dependencies\": _keywords.dependencies,\n   372→    \"dependentRequired\": _keywords.dependentRequired,\n   373→    \"dependentExcluded\": _keywords.dependentExcluded,\n   374→    \"enum\": _keywords.enum,\n   375→    \"exclusiveMaximum\": _keywords.exclusiveMaximum,\n   376→    \"exclusiveMinimum\": _keywords.exclusiveMinimum,\n   377→    \"format\": _keywords.format,\n   378→    \"if\": _keywords.if_,\n   379→    \"items\": _keywords.items,\n   380→    \"maxItems\": _keywords.maxItems,\n   381→    \"maxLength\": _keywords.maxLength,\n   382→    \"maxProperties\": _keywords.maxProperties,\n   383→    \"maximum\": _keywords.maximum,\n   384→    \"minItems\": _keywords.minItems,\n   385→    \"minLength\": _keywords.minLength,\n   386→    \"minProperties\": _keywords.minProperties,\n   387    \"minimum\": _keywords.minimum,\n   388→    \"multipleOf\": _keywords.multipleOf,\n   389→    \"not\":