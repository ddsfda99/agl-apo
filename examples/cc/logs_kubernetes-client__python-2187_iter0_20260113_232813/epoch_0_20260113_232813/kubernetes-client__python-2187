tion goes through various authentication methods in user\n   278\u2192        section of kube-config and stops if it finds a valid authentication\n   279\u2192        method. The order of authentication methods is:\n   280\u2192\n   281\u2192            1. auth-provider (gcp, azure, oidc)\n   282\u2192            2. token field (point to a token file)\n   283\u2192            3. exec provided plugin\n   284\u2192            4. username/password\n   285\u2192        \"\"\"\n   286\u2192        if not self._user:\n   287\u2192            return\n   288\u2192        if self._load_auth_provider_token():\n   289\u2192            return\n   290\u2192        if self._load_user_token():\n   291\u2192            return\n   292\u2192        if self._load_from_exec_plugin():\n   293\u2192            return\n   294\u2192        self._load_user_pass_token()\n   295\u2192\n   296\u2192    def _load_auth_provider_token(self):\n   297\u2192        if 'auth-provider' not in self._user:\n   298\u2192            return\n   299\u2192        provider = self._user['auth-provider']\n   300\u2192        if 'name' not in provider:\n   301\u2192            return\n   302\u2192        if provider['name'] == 'gcp':\n   303\u2192            return self._load_gcp_token(provider)\n   304\u2192        if provider['name'] == 'azure':\n   305\u2192            return self._load_azure_token(provider)\n   306\u2192        if provider['name'] == 'oidc':\n   307\u2192            return self._load_oid_token(provider)\n   308\u2192\n   309\u2192    def _azure_is_expired(self, provider):\n   310\u2192        expires_on = provider['config']['expires-on']\n   311\u2192        if expires_on.isdigit():\n   312\u2192            return int(expires_on) < time.time()\n   313\u2192        else:\n   314\u2192            exp_time = time.strptime(expires_on, '%Y-%m-%d %H:%M:%S.%f')\n   315\u2192            return exp_time < time.gmtime()\n   316\u2192\n   317\u2192    def _load_azure_token(self, provider):\n   318\u2192        if 'config' not in provider:\n   319\u2192            return\n   320\u2192        if 'access-token' not in provider['config']:\n   321\u2192            return\n   322\u2192        if 'expires-on' in provider['config']:\n   323\u2192            if self._azure_is_expired(provider):\n   324\u2192                self._refresh_azure_token(provider['config'])\n   325\u2192        self.token = 'Bearer %s' % provider['config']['access-token']\n   326\u2192        return self.token\n   327\u2192\n   328\u2192    def _refresh_azure_token(self, config):\n   329\u2192        if 'adal' not in globals():\n   330\u2192            raise ImportError('refresh token error, adal library not imported')\n   331\u2192\n   332\u2192        tenant = config['tenant-id']\n   333\u2192        authority = 'https://login.microsoftonline.com/{}'.format(tenant)\n   334\u2192        context = adal.AuthenticationContext(\n   335\u2192            authority, validate_authority=True, api_version='1.0'\n   336\u2192        )\n   337\u2192        refresh_token = config['refresh-token']\n   338\u2192        client_id = config['client-id']\n   339\u2192        apiserver_id = '00000002-0000-0000-c000-000000000000'\n   340\u2192        try:\n   341\u2192            apiserver_id = config['apiserver-id']\n   342\u2192        except ConfigException:\n   343\u2192            # We've already set a default above\n   344\u2192            pass\n   345\u2192        token_response = context.acquire_token_with_refresh_token(\n   346\u2192            refresh_token, client_id, apiserver_id)\n   347\u2192\n   348\u2192        provider = self._user['auth-provider']['config']\n   349\u2192        provider.value['access-token'] = token_response['accessToken']\n   350\u2192        provider.value['expires-on'] = token_response['expiresOn']\n   351\u2192        if self._config_persister:\n   352\u2192            self._config_persister()\n   353\u2192\n   354\u2192    def _load_gcp_token(self, provider):\n   355\u2192        if (('config' not in provider) or\n   356\u2192                ('access-token' not in provider['config']) or\n   357\u2192                ('expiry' in provider['config'] and\n   358\u2192                 _is_expired(provider['config']['expiry']))):\n   359\u2192            # token is not available or expired, refresh it\n   360\u2192            self._refresh_gcp_token()\n   361\u2192\n   362\u2192        self.token = \"Bearer %s\" % provider['config']['access-token']\n   363\u2192        if 'expiry' in provider['config']:\n   364\u2192            self.expiry = parse_rfc3339(provider['config']['expiry'])\n   365\u2192        return self.token\n   366\u2192\n   367\u2192    def _refresh_gcp_token(self):\n   368\u2192        if 'config' not in self._user['auth-provider']:\n   369\u2192            self._user['auth-provider'].value['config'] = {}\n   370\u2192        provider = self._user['auth-provider']['config']\n   371\u2192        credentials = self._get_google_credentials()\n   372\u2192        provider.value['access-token'] = credentials.token\n   373\u2192        provider.value['expiry'] = format_rfc3339(credentials.expiry)\n   374\u2192        if self._config_persister:\n   375\u2192            self._config_persister()\n   376\u2192\n   377\u2192    def _load_oid_token(self, provider):\n   378\u2192        if 'config' not in provider:\n   379\u2192            return\n   380\u2192\n   381\u2192        reserved_characters = frozenset([\"=\", \"+\", \"/\"])\n   382\u2192        token = provider['config']['id-token']\n   383\u2192\n   384\u2192        if any(char in token for char in reserved_characters):\n   385\u2192            # Invalid jwt, as it contains url-unsafe chars\n   386\u2192            return\n   387\u2192\n   388\u2192        parts = token.split('.')\n   389\u2192        if len(parts) != 3:  # Not a valid JWT\n   390\u2192            return\n   391\u2192\n   392\u2192        padding = (4 - len(parts[1]) % 4) * '='\n   393\u2192        if len(pa