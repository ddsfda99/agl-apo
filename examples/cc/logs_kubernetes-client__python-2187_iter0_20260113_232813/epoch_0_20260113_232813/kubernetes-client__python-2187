92            stdout=subprocess.PIPE,\n   164\u2192            stderr=subprocess.PIPE,\n   165\u2192            universal_newlines=True)\n   166\u2192        (stdout, stderr) = process.communicate()\n   167\u2192        exit_code = process.wait()\n   168\u2192        if exit_code != 0:\n   169\u2192            msg = 'cmd-path: process returned %d' % exit_code\n   170\u2192            msg += \"\\nCmd: %s\" % fullCmd\n   171\u2192            stderr = stderr.strip()\n   172\u2192            if stderr:\n   173\u2192                msg += '\\nStderr: %s' % stderr\n   174\u2192            raise ConfigException(msg)\n   175\u2192        try:\n   176\u2192            data = json.loads(stdout)\n   177\u2192        except ValueError as de:\n   178\u2192            raise ConfigException(\n   179\u2192                'exec: failed to decode process output: %s' % de)\n   180\u2192        A = namedtuple('A', ['token', 'expiry'])\n   181\u2192        return A(\n   182\u2192            token=data['credential']['access_token'],\n   183\u2192            expiry=parse_rfc3339(data['credential']['token_expiry']))\n   184\u2192\n   185\u2192\n   186\u2192class KubeConfigLoader(object):\n   187\u2192\n   188\u2192    def __init__(self, config_dict, active_context=None,\n   189\u2192                 get_google_credentials=None,\n   190\u2192                 config_base_path=\"\",\n   191\u2192                 config_persister=None,\n   192\u2192                 temp_file_path=None):\n   193\u2192\n   194\u2192        if config_dict is None:\n   195\u2192            raise ConfigException(\n   196\u2192                'Invalid kube-config. '\n   197\u2192                'Expected config_dict to not be None.')\n   198\u2192        elif isinstance(config_dict, ConfigNode):\n   199\u2192            self._config = config_dict\n   200\u2192        else:\n   201\u2192            self._config = ConfigNode('kube-config', config_dict)\n   202\u2192\n   203\u2192        self._current_context = None\n 