s:\n   159\u2192        # * merging app.linux.debian into app, overwriting anything global\n   160\u2192        # * merging app.linux.ubuntu into app, overwriting anything vendor-base\n   161\u2192        #   specific\n   162\u2192        # * merging app.linux.ubuntu.focal into app, overwriting anything vendor\n   163\u2192        #   specific\n   164\u2192        # The vendor base config (e.g., redhat). The vendor base might not\n   165\u2192        # be known, so fall back to an empty vendor config.\n   166\u2192        if app.target_vendor_base:\n   167\u2192            vendor_base_config = getattr(app, app.target_vendor_base, {})\n   168\u2192        else:\n   169\u2192            vendor_base_config = {}\n   170\u2192        vendor_config = getattr(app, app.target_vendor, {})\n   171\u2192        try:\n   172\u2192            codename_config = vendor_config[app.target_codename]\n   173\u2192        except KeyError:\n   174\u2192            codename_config = {}\n   175\u2192\n   176\u2192        # Copy all the specific configurations to the app config\n   177\u2192        for config in [\n   178\u2192            vendor_base_config,\n   179\u2192            vendor_config,\n   180\u2192            codename_config,\n   181\u2192        ]:\n   182\u2192            for key, value in config.items():\n   183\u2192                setattr(app, key, value)\n   184\u2192\n   185\u2192        with self.input.wait_bar(\"Determining glibc version...\"):\n   186\u2192            app.glibc_version = self.target_glibc_version(app)\n   187\u2192        self.logger.info(f\"Targeting glibc {app.glibc_version}\")\n   188\u2192\n   189\u2192        app.python_version_tag = self.app_python_version_tag(app)\n   190\u2192\n   191\u2192        self.logger.info(f\"Targeting Python{app.python_version_tag}\")\n   192\u2192\n   193\u2192\n   194\u2192class LinuxSystemMostlyPassiveMixin(LinuxSystemPassiveMixin):\n   195\u2192    # The Mostly Passive mixin verifies that Docker exists and can be run, but\n   196\u2192    # doesn't require that we're actually in a Linux environment.\n   197\u2192\n   198\u2192    @property\n   199\u2192    def use_docker(self):\n   200\u2192        # The system backend doesn't have a literal \"--use-docker\" option, but\n   201\u2192        # `use_docker` is a useful flag for shared logic purposes, so evaluate\n   202\u2192        # what \"use docker\" means in terms of target_image.\n   203\u2192        return bool(self.target_image)\n   204\u2192\n   205\u2192    def app_python_version_tag(self, app: AppConfig):\n   206\u2192        if self.use_docker:\n   207\u2192            # If we're running in Docker, we can't know the Python3 version\n   208\u2192            # before rolling out the template; so we fall back to \"3\". Later,\n   209\u2192            # once we have a container in which we can run Python, this will be\n   210\u2192            # updated to the actual Python version as part of the\n   211\u2192            # `verify_python` app check.\n   212\u2192            python_version_tag = \"3\"\n   213\u2192        else:\n   214\u2192            python_version_tag = super().app_python_version_tag(app)\n   215\u2192        return python_version_tag\n   216\u2192\n   217\u2192    def _build_env_abi(self, app: AppConfig):\n   218\u2192        \"\"\"Retrieves the ABI the packaging system is targeting in the build env.\n   219\u2192\n   220\u2192        Each packaging system uses different values to identify the exact ABI that\n   221\u2192        describes the target environment...so just defer to the packaging system.\n   222\u2192        \"\"\"\n   223\u2192        command = {\n   224\u2192            \"deb\": [\"dpkg\", \"--print-architecture\"],\n   225\u2192            \"rpm\": [\"rpm\", \"--eval\", \"%_target_cpu\"],\n   226\u2192            \"pkg\": [\"pacman-conf\", \"Architecture\"],\n   227\u2192        }[app.packaging_format]\n   228\u2192        try:\n   229\u2192            return (\n   230\u2192                self.tools[app].app_context.check_output(command).split(\"\\n\")[0].strip()\n   231\u2192            )\n   232\u2192        except (OSError, subprocess.CalledProcessError) as e:\n   233\u2192            raise BriefcaseCommandError(\n   234\u2192                \"Failed to determine build environment's ABI for packaging.\"\n   235\u2192            ) from e\n   236\u2192\n   237\u2192    def deb_abi(self, app: AppConfig) -> str:\n   238\u2192        \"\"\"The default ABI for dpkg packaging for the target environment.\"\"\"\n   239\u2192        try:\n   240\u2192            return self._deb_abi\n   241\u2192        except AttributeError:\n   242\u2192            self._deb_abi = self._build_env_abi(app)\n   243\u2192            return self._deb_abi\n   244\u2192\n   245\u2192    def rpm_abi(self, app: AppConfig) -> str:\n   246\u2192        \"\"\"The default ABI for rpm packaging for the target environment.\"\"\"\n   247\u2192        try:\n   248\u2192            return self._rpm_abi\n   249\u2192        except AttributeError:\n   250\u2192            self._rpm_abi = self._build_env_abi(app)\n   251\u2192            return self._rpm_abi\n   252\u2192\n   253\u2192    def pkg_abi(self, app: AppConfig) -> str:\n   254\u2192        \"\"\"The default ABI for pacman packaging for the target environment.\"\"\"\n   255\u2192        try:\n   256\u2192            return self._pkg_abi\n   257\u2192        except AttributeError:\n   258\u2192            self._pkg_abi = self._build_env_abi(app)\n   259\u2192            return self._pkg_abi\n   260\u2192\n   261\u2192    def distribution_filename(self, app: AppConfig) -> str:\n   262\u2192        if app.packaging_format == \"deb\":\n   263\u2192            return (\n   264\u2192                f\"{app.app_name}_{app.version}-{getattr(app, 'revision', 1)}\"\n   265\u2192                f\"~{app.target_vendor}-{app.target_codename}_{self.deb_abi(app)}.deb\"\n   266\u2192            )\n   267\u2192        elif app.packaging_format == \"rpm\":\n   268\u2192            return (\n   269\u2192                f\"{app.app_name}-{app.version}-{getattr(app, 'revision', 1)}\"\n   270\u2192                f\".{self.rpm_tag(app)}.{self.rpm_abi(app)}.rpm\"\n   271\u2192            )\n   272\u2192        elif app.packaging_format == \"pkg\":\n   273\u2192            return (\n   274\u2192                f\"{app.app_name}-{app.version}-{getattr(app, 'revision', 1)}\"\n   275\u2192                f\"-{self.pkg_abi(app)}.pkg.tar.zst\"\n   276\u2192            )\n   277\u2192        else:\n   278\u2192            raise BriefcaseCommandError(\n   279\u2192                \"Briefcase doesn't currently know how to build system packages in \"\n   280\u2192                f\"{app.packaging_format.upper()} format.\"\n   281\u2192            )\n   282\u2192\n   283\u2192    def distribution_path(self, app: AppConfig):\n   284\u2192        return self.dist_path / self.distribution_filename(app)\n   285\u2192\n   286\u2192    def target_glibc_version(self, app):\n   287\u2192        \"\"\"Determine the glibc version.\n   288\u2192\n   289\u2192        If running in Docker, this is done by interrogating libc.so.6; outside docker,\n   290\u2192        we can use os.confstr().\n   291\u2192        \"\"\"\n   292\u2192        if self.use_docker:\n   293\u2192            try:\n   294\u2192                output = self.tools.docker.check_output(\n   295\u2192                    [\"ldd\", \"--version\"],\n   296\u2192                    image_tag=app.target_image,\n   297\u2192                )\n   298\u2192                # On Debian/Ubuntu, ldd --version will give you output of the form:\n   299\u2192                #\n   300\u2192                #     ldd (Ubuntu GLIBC 2.31-0ubuntu9.9) 2.31\n   301\u2192                #     Copyright (C) 2020 Free Software Foundation, Inc.\n   302\u2192                #     ...\n   303\u2192                #\n   304\u2192                # Other platforms produce output of the form:\n   305\u2192                #\n   306\u2192                #     ldd (GNU libc) 2.36\n   307\u2192                #     Copyright (C) 2020 Free Software Foundation, Inc.\n   308\u2192                #     ...\n   309\u2192                #\n   310\u2192                # Note that the exact text will vary version to version.\n   311\u2192                # Look for the \"2.NN\" pattern.\n   312\u2192                if match := re.search(r\"\\d\\.\\d+\", output):\n   313\u2192                    target_glibc = match.group(0)\n   314\u2192                else:\n   315\u2192                    raise BriefcaseCommandError(\n   316\u2192                        \"Unable to parse glibc dependency version from version string.\"\n   317\u2192                    )\n   318\u2192            except subprocess.CalledProcessError:\n   319\u2192                raise BriefcaseCommandError(\n   320\u2192                    \"Unable to determine glibc dependency version.\"\n   321\u2192                )\n   322\u2192\n   323\u2192        else:\n   324\u2192            target_glibc = super().target_glibc_version(app)\n   325\u2192\n   326\u2192        return target_glibc\n   327\u2192\n   328\u2192    def platform_freedesktop_info(self, app: AppConfig):\n   329\u2192        if self.use_docker:\n   330\u2192            # Preserve the target image on the command line as the app's target\n   331\u2192            app.target_image = self.target_image\n   332\u2192\n   333\u2192            # Extract release information from the image.\n   334\u2192            with self.input.wait_bar(\n   335\u2192                f\"Checking Docker target image {app.target_image}...\"\n   336\u2192            ):\n   337\u2192                output = self.tools.docker.check_output(\n   338\u2192                    [\"cat\", \"/etc/os-release\"],\n   339\u2192                    image_tag=app.target_image,\n   340\u2192                )\n   341\u2192                freedesktop_info = parse_freedesktop_os_release(output)\n   342\u2192        else:\n   343\u2192            freedesktop_info = super().platform_freedesktop_info(app)\n   344\u2192\n   345\u2192        return freedesktop_info\n   346\u2192\n   347\u2192    def docker_image_tag(self, app: AppConfig):\n   348\u2192        \"\"\"The Docker image tag for an app.\"\"\"\n   349\u2192        return f\"briefcase/{app.bundle_identifier.lower()}:{app.target_vendor}-{app.target_codename}\"\n   350\u2192\n   351\u2192    def verify_tools(self):\n   352\u2192        \"\"\"If we're using Docker, verify that it is available.\"\"\"\n   353\u2192        super().verify_tools()\n   354\u2192        if self.use_docker:\n   355\u2192            Docker.verify(tools=self.tools, image_tag=self.target_image)\n   356\u2192\n   357\u2192    def add_options(self, parser):\n   358\u2192        super().add_options(parser)\n   359\u2192        parser.add_argument(\n   360\u2192            \"--target\",\n   361\u2192            dest=\"target\",\n   362\u2192            help=\"Docker base image tag for the distribution to target for the build (e.g., `ubuntu:jammy`)\",\n   363\u2192            required=False,\n   364\u2192        )\n   365\u2192\n   366\u2192    def parse_options(self, extra):\n   367\u2192        \"\"\"Extract the target_image option.\"\"\"\n   368\u2192        options, overrides = super().parse_options(extra)\n   369\u2192        self.target_image = options.pop(\"target\")\n   370\u2192\n   371\u2192        return options, overrides\n   372\u2192\n   373\u2192    def clone_options(self, command):\n   374\u2192        \"\"\"Clone the target_image option.\"\"\"\n   375\u2192        super().clone_options(command)\n   376\u2192        self.target_image = command.target_image\n   377\u2192\n   378\u2192    def verify_python(self, app: AppConfig):\n   379\u2192        \"\"\"Verify that the version of Python being used to build the app in Docker is\n   380\u2192        compatible with the version being used to run Briefcase.\n   381\u2192\n   382\u2192        Will raise an exception if the Python version is fundamentally\n   383\u2192        incompatible (i.e., if Briefcase doesn't support it); any other version\n   384\u2192        discrepancy will log a warning, but continue.\n   385\u2192\n   386\u2192        Requires that the app tools have been verified.\n   387\u2192\n   388\u2192        As a side effect of verifying Python, the `python_version_tag` will be\n   389\u2192        updated to reflect the *actual* python version, not just a generic \"3\".\n   390\u2192\n   391\u2192        :param app: The application being built\n   392\u2192        \"\"\"\n   393\u2192        output = self.tools[app].app_context.check_output(\n   394\u2192            [\n   395\u2192                f\"python{app.python_version_tag}\",\n   396\u2192                \"-c\",\n   397\u2192                (\n   398\u2192                    \"import sys; \"\n   399\u2192                    \"print(f'{sys.version_info.major}.{sys.version_info.minor}')\"\n   400\u2192                ),\n   401\u2192            ]\n   402\u2192        )\n   403\u2192        # Update the python version tag with the *actual* python version.\n   404\u2192        app.python_version_tag = output.split(\"\\n\")[0]\n   405\u2192        target_python_version = tuple(int(v) for v in app.python_version_tag.split(\".\"))\n   406\u2192\n   407\u2192        if target_python_version < self.briefcase_required_python_version:\n   408\u2192            briefcase_min_version = \".\".join(\n   409\u2192                str(v) for v in self.briefcase_required_python_version\n   410\u2192            )\n   411\u2192            raise BriefcaseCommandError(\n   412\u2192                f\"The system python3 version provided by {app.target_image} \"\n   413\u2192                f\"is {app.python_version_tag}; Briefcase requires a \"\n   414\u2192                f\"minimum Python3 version of {briefcase_min_version}.\"\n   415\u2192            )\n   416\u2192        elif target_python_version != (\n   417\u2192            self.tools.sys.version_info.major,\n   418\u2192            self.tools.sys.version_info.minor,\n   419\u2192        ):\n   420\u2192            self.logger.warning(\n   421\u2192                f\"\"\"\n   422\u2192*************************************************************************\n   423\u2192** WARNING: Python version mismatch!                                   **\n   424\u2192*************************************************************************\n   425\u2192\n   426\u2192    The system python3 provided by {app.target_image} is {app.python_version_tag}.\n   427\u2192    This is not the same as your local system ({self.python_version_tag}).\n   428\u2192\n   429\u2192    Ensure you have tested for Python version compatibility before\n   430\u2192    releasing this app.\n   431\u2192\n   432\u2192*************************************************************************\n   433\u2192\"\"\"\n   434\u2192            )\n   435\u2192\n   436\u2192    def verify_system_python(self):\n   437\u2192        \"\"\"Verify that the Python being used to run Briefcase is the default system\n   438\u2192        python.\n   439\u2192\n   440\u2192        Will raise an exception if the system Python isn't an obvious Python3, or the\n   441\u2192        Briefcase Python isn't the same version as the system Python.\n   442\u2192\n   443\u2192        Requires that the app tools have been verified.\n   444\u2192        \"\"\"\n   445\u2192        system_python_bin = Path(\"/usr/bin/python3\").resolve()\n   446\u2192        system_version = system_python_bin.name.split(\".\")\n   447\u2192        if system_version[0] != \"python3\" or len(system_version) == 1:\n   448\u2192            raise BriefcaseCommandError(\"Can't determine the system python version\")\n   449\u2192\n   450\u2192        if system_version[1] != str(self.tools.sys.version_info.minor):\n   451\u2192            raise BriefcaseCommandError(\n   452\u2192                f\"The version of Python being used to run Briefcase ({self.python_version_tag}) \"\n   453\u2192                f\"is not the system python3 (3.{system_version[1]}).\"\n   454\u2192            )\n   455\u2192\n   456\u2192    def _system_requirement_tools(self, app: AppConfig):\n   457\u2192        \"\"\"Utility method returning the packages and tools needed to verify system\n   458\u2192        requirements.\n   459\u2192\n   460\u2192        :param app: The app being built.\n   461\u2192        :returns: A triple containing (0) The list of package names that must\n   462\u2192            be installed at a bare minimum; (1) the arguments for the command\n   463\u2192            used to verify the existence of a package on a system, and (2)\n   464\u2192            the command used to install packages. All three values are `None`\n   465\u2192            if the system cannot be identified.\n   466\u2192        \"\"\"\n   467\u2192        if app.target_vendor_base == DEBIAN:\n   468\u2192            base_system_packages = [\"python3-dev\", \"build-essential\"]\n   469\u2192            system_verify = [\"dpkg\", \"-s\"]\n   470\u2192            system_installer = [\"apt\", \"install\"]\n   471\u2192        elif app.target_vendor_base == RHEL:\n   472\u2192            base_system_packages = [\n   473\u2192                \"python3-devel\",\n   474\u2192                \"gcc\",\n   475\u2192                \"make\",\n   476\u2192                \"pkgconf-pkg-config\",\n   477\u2192            ]\n   478\u2192            system_verify = [\"rpm\", \"-q\"]\n   479\u2192            system_installer = [\"dnf\", \"install\"]\n   480\u2192        elif app.target_vendor_base == SUSE:\n   481\u2192            base_system_packages = [\n   482\u2192                \"python3-devel\",\n   483\u2192                \"patterns-devel-base-devel_basis\",\n   484\u2192            ]\n   485\u2192            system_verify = [\"rpm\", \"-q\", \"--whatprovides\"]\n   486\u2192            system_installer = [\"zypper\", \"install\"]\n   487\u2192        elif app.target_vendor_base == ARCH:\n   488\u2192            base_system_packages = [\n   489\u2192                \"python3\",\n   490\u2192                \"base-devel\",\n   491\u2192            ]\n   492\u2192            system_verify = [\"pacman\", \"-Q\"]\n   493\u2192            system_installer = [\"pacman\", \"-Syu\"]\n   494\u2192        else:\n   495\u2192            base_system_packages = None\n   496\u2192            system_verify = None\n   497\u2192            system_installer = None\n   498\u2192\n   499\u2192        return (\n   500\u2192            base_system_packages,\n   501\u2192            system_verify,\n   502\u2192            system_installer,\n   503\u2192        )\n   504\u2192\n   505\u2192    def verify_system_packages(self, app: AppConfig):\n   506\u2192        \"\"\"Verify that the required system packages are installed.\n   507\u2192\n   508\u2192        :param app: The app being built.\n   509\u2192        \"\"\"\n   510\u2192        (\n   511\u2192            base_system_packages,\n   512\u2192            system_verify,\n   513\u2192            system_installer,\n   514\u2192        ) = self._system_requirement_tools(app)\n   515\u2192\n   516\u2192        if system_verify is None:\n   517\u2192            self.logger.warning(\n   518\u2192                \"\"\"\n   519\u2192*************************************************************************\n   520\u2192** WARNING: Can't verify system packages                               **\n   521\u2192*************************************************************************\n   522\u2192\n   523\u2192    Briefcase doesn't know how to verify the installation of system\n   524\u2192    packages on your Linux distribution. If you have any problems\n   525\u2192    building this app, ensure that the packages listed in the app's\n   526\u2192    `system_requires` setting have been installed.\n   527\u2192\n   528\u2192*************************************************************************\n   529\u2192\"\"\"\n   530\u2192            )\n   531\u2192            return\n   532\u2192\n   533\u2192        # Run a check for each package listed in the app's system_requires,\n   534\u2192        # plus the baseline system packages that are required.\n   535\u2192        missing = []\n   536\u2192        for package in base_system_packages + getattr(app, \"system_requires\", []):\n   537\u2192            try:\n   538\u2192                self.tools.subprocess.check_output(system_verify + [package])\n   539\u2192            except subprocess.CalledProcessError:\n   540\u2192                missing.append(package)\n   541\u2192\n   542\u2192        # If any required packages are missing, raise an error.\n   543\u2192        if missing:\n   544\u2192            raise BriefcaseCommandError(\n   545\u2192                f\"\"\"\\\n   546\u2192Unable to build {app.app_name} due to missing system dependencies. Run:\n   547\u2192\n   548\u2192    sudo {' '.join(system_installer)} {' '.join(missing)}\n   549\u2192\n   550\u2192to install the missing dependencies, and re-run Briefcase.\n   551\u2192\"\"\"\n   552\u2192            )\n   553\u2192\n   554\u2192    def verify_app_tools(self, app: AppConfig):\n   555\u2192        \"\"\"Verify App environment is prepared and available.\n   556\u2192\n   557\u2192        When Docker is used, create or update a Docker image for the App. Without\n   558\u2192        Docker, the host machine will be used as the App environment.\n   559\u2192\n   560\u2192        :param app: The application being built\n   561\u2192        \"\"\"\n   562\u2192        # Verifying the App context is idempotent; but we have some\n   563\u2192        # additional logic that we only want to run the first time through.\n   564\u2192        # Check (and store) the pre-verify app tool state.\n   565\u2192        verify_python = not hasattr(self.tools[app], \"app_context\")\n   566\u2192\n   567\u2192        if self.use_docker:\n   568\u2192            DockerAppContext.verify(\n   569\u2192                tools=self.tools,\n   570\u2192                app=app,\n   571\u2192                image_tag=self.docker_image_tag(app),\n   572\u2192                dockerfile_path=self.bundle_path(app) / \"Dockerfile\",\n   573\u2192                app_base_path=self.base_path,\n   574\u2192                host_bundle_path=self.bundle_path(app),\n   575\u2192                host_data_path=self.data_path,\n   576\u2192                python_version=app.python_version_tag,\n   577\u2192            )\n   578\u2192\n   579\u2192            # Check the system Python on the target system to see if it is\n   580\u2192            # compatible with Briefcase.\n   581\u2192            if verify_python:\n   582\u2192                self.verify_python(app)\n   583\u2192        else:\n   584\u2192            NativeAppContext.verify(tools=self.tools, app=app)\n   585\u2192\n   586\u2192            # Check the system Python on the target system to see if it is\n   587\u2192            # compatible with Briefcase, and that the required system packages\n   588\u2192            # are installed.\n   589\u2192            if verify_python:\n   590\u2192                self.verify_system_python()\n   591\u2192                self.verify_system_packages(app)\n   592\u2192\n   593\u2192        # Establish Docker as app context before letting super set subprocess\n   594\u2192        super().verify_app_tools(app)\n   595\u2192\n   596\u2192\n   597\u2192class LinuxSystemMixin(LinuxSystemMostlyPassiveMixin):\n   598\u2192    def verify_host(self):\n   599\u2192        \"\"\"If we're *not* using Docker, verify that we're actually on Linux.\"\"\"\n   600\u2192        super().verify_host()\n   601\u2192        if not self.use_docker:\n   602\u2192            if self.tools.host_os != \"Linux\":\n   603\u2192                raise UnsupportedHostError(self.supported_host_os_reason)\n   604\u2192\n   605\u2192\n   606\u2192class LinuxSystemCreateCommand(LinuxSystemMixin, LocalRequirementsMixin, CreateCommand):\n   607\u2192    description = \"Create and populate a Linux system project.\"\n   608\u2192\n   609\u2192    def output_format_template_context(self, app: AppConfig):\n   610\u2192        context = super().output_format_template_context(app)\n   611\u2192\n   612\u2192        # Linux system templates use the target codename, rather than\n   613\u2192        # the format \"system\" as the leaf of the bundle path\n   614\u2192        context[\"format\"] = app.target_codename\n   615\u2192\n   616\u2192        # The base template context includes the host Python version;\n   617\u2192        # override that with an app-specific Python version, allowing\n   618\u2192        # for the app to be built with the system Python.\n   619\u2192        context[\"python_version\"] = app.python_version_tag\n   620\u2192\n   621\u2192        # Add the docker base image\n   622\u2192        context[\"docker_base_image\"] = app.target_image\n   623\u2192\n   624\u2192        # Add the vendor base\n   625\u2192        context[\"vendor_base\"] = app.target_vendor_base\n   626\u2192\n   627\u2192        # Use the non-root user if Docker is not mapping usernames. Also use a non-root\n   628\u2192        # user if we're on macOS; user mapping doesn't alter Docker operation, but some\n   629\u2192        # packaging tools (e.g., Arch's makepkg) don't like running as root. If we're\n   630\u2192        # not using Docker, this will fall back to the template default, which should be\n   631\u2192        # enabling the root user. This might cause problems later, but it's part of a\n   632\u2192        # much bigger \"does the project need to be updated in light of configuration\n   633\u2192        # changes\" problem.\n   634\u2192        try:\n   635\u2192            context[\"use_non_root_user\"] = (\n   636\u2192                self.tools.host_os == \"Darwin\" or not self.tools.docker.is_user_mapped\n   637\u2192            )\n   638\u2192        except AttributeError:\n   639\u2192            pass  # ignore if not using Docker\n   640\u2192\n   641\u2192        return context\n   642\u2192\n   643\u2192\n   644\u2192class LinuxSystemUpdateCommand(LinuxSystemCreateCommand, UpdateCommand):\n   645\u2192    description = \"Update an existing Linux system project.\"\n   646\u2192\n   647\u2192\n   648\u2192class LinuxSystemOpenCommand(LinuxSystemMostlyPassiveMixin, DockerOpenCommand):\n   649\u2192    description = (\n   650\u2192        \"Open a shell in a Docker container for an existing Linux system project.\"\n   651\u2192    )\n   652\u2192\n   653\u2192\n   654\u2192class LinuxSystemBuildCommand(LinuxSystemMixin, BuildCommand):\n   655\u2192    description = \"Build a Linux system project.\"\n   656\u2192\n   657\u2192    def build_app(self, app: AppConfig, **kwargs):\n   658\u2192        \"\"\"Build an application.\n   659\u2192\n   660\u2192        :param app: The application to build\n   661\u2192        \"\"\"\n   662\u2192        self.logger.info(\"Building application...\", prefix=app.app_name)\n   663\u2192\n   664\u2192        self.logger.info(\"Build bootstrap binary...\")\n   665\u2192        with self.input.wait_bar(\"Building bootstrap binary...\"):\n   666\u2192            try:\n   667\u2192                # Build the bootstrap binary.\n   668\u2192                self.tools[app].app_context.run(\n   669\u2192                    [\n   670\u2192                        \"make\",\n   671\u2192                        \"-C\",\n   672\u2192                        \"bootstrap\",\n   673\u2192                        \"install\",\n   674\u2192                    ],\n   675\u2192                    check=True,\n   676\u2192                    cwd=self.bundle_path(app),\n   677\u2192                )\n   678\u2192            except subprocess.CalledProcessError as e:\n   679\u2192                raise BriefcaseCommandError(\n   680\u2192                    f\"Error building bootstrap binary for {app.app_name}.\"\n   681\u2192                ) from e\n   682\u2192\n   683\u2192        # Make the folder for docs\n   684\u2192        doc_folder = (\n   685\u2192            self.bundle_path(app)\n   686\u2192            / f\"{app.app_name}-{app.version}\"\n   687\u2192            / \"usr\"\n   688\u2192            / \"share\"\n   689\u2192            / \"doc\"\n   690\u2192            / app.app_name\n   691\u2192        )\n   692\u2192        doc_folder.mkdir(parents=True, exist_ok=True)\n   693\u2192\n   694\u2192        with self.input.wait_bar(\"Installing license...\"):\n   695\u2192            license_file = self.base_path / \"LICENSE\"\n   696\u2192            if license_file.is_file():\n   697\u2192                self.tools.shutil.copy(license_file, doc_folder / \"copyright\")\n   698\u2192            else:\n   699\u2192                raise BriefcaseCommandError(\n   700\u2192                    \"\"\"\\\n   701\u2192Your project does not contain a LICENSE file.\n   702\u2192\n   703\u2192Create a file named `LICENSE` in the same directory as your `pyproject.toml`\n   704\u2192with your app's licensing terms.\n   705\u2192\"\"\"\n   706\u2192                )\n   707\u2192\n   708\u2192        with self.input.wait_bar(\"Installing changelog...\"):\n   709\u2192            changelog = self.base_path / \"CHANGELOG\"\n   710\u2192            if changelog.is_file():\n   711\u2192                with changelog.open(encoding=\"utf-8\") as infile:\n   712\u2192                    outfile = gzip.GzipFile(\n   713\u2192                        doc_folder / \"changelog.gz\", mode=\"wb\", mtime=0\n   714\u2192                    )\n   715\u2192                    outfile.write(infile.read().encode(\"utf-8\"))\n   716\u2192                    outfile.close()\n   717\u2192            else:\n   718\u2192                raise BriefcaseCommandError(\n   719\u2192                    \"\"\"\\\n   720\u2192Your project does not contain a CHANGELOG file.\n   721\u2192\n   722\u2192Create a file named `CHANGELOG` in the same directory as your `pyproject.toml`\n   723\u2192with details about the release.\n   724\u2192\"\"\"\n   725\u2192                )\n   726\u2192\n   727\u2192        # Make a folder for manpages\n   728\u2192        man_folder = (\n   729\u2192            self.bundle_path(app)\n   730\u2192            / f\"{app.app_name}-{app.version}\"\n   731\u2192            / \"usr\"\n   732\u2192            / \"share\"\n   733\u2192            / \"man\"\n   734\u2192            / \"man1\"\n   735\u2192        )\n   736\u2192        man_folder.mkdir(parents=True, exist_ok=True)\n   737\u2192\n   738\u2192        with self.input.wait_bar(\"Installing man page...\"):\n   739\u2192            manpage_source = self.bundle_path(app) / f\"{app.app_name}.1\"\n   740\u2192            if manpage_source.is_file():\n   741\u2192                with manpage_source.open(encoding=\"utf-8\") as infile:\n   742\u2192                    outfile = gzip.GzipFile(\n   743\u2192                        man_folder / f\"{app.app_name}.1.gz\", mode=\"wb\", mtime=0\n   744\u2192                    )\n   745\u2192                    outfile.write(infile.read().encode(\"utf-8\"))\n   746\u2192                    outfile.close()\n   747\u2192            else:\n   748\u2192                raise BriefcaseCommandError(\n   749\u2192                    f\"Template does not provide a manpage source file `{app.app_name}.1`\"\n   750\u2192                )\n   751\u2192\n   752\u2192        self.logger.info(\"Update file permissions...\")\n   753\u2192        with self.input.wait_bar(\"Updating file permissions...\"):\n   754\u2192            for path in self.project_path(app).glob(\"**/*\"):\n   755\u2192                old_perms = self.tools.os.stat(path).st_mode & 0o777\n   756\u2192                user_perms = old_perms & 0o700\n   757\u2192                world_perms = old_perms & 0o007\n   758\u2192\n   759\u2192                # File permissions like 775 and 664 (where the group and user\n   760\u2192                # permissions are the same), cause Debian heartburn. So, make\n   761\u2192                # sure the group and world permissions are the same\n   762\u2192                new_perms = user_perms | (world_perms << 3) | world_perms\n   763\u2192\n   764\u2192                # If there's been any change in permissions, apply them\n   765\u2192                if new_perms != old_perms:  # pragma: no-cover-if-is-windows\n   766\u2192                    self.logger.info(\n   767\u2192                        \"Updating file permissions on \"\n   768\u2192                        f\"{path.relative_to(self.bundle_path(app))} \"\n   769\u2192                        f\"from {oct(old_perms)[2:]} to {oct(new_perms)[2:]}\"\n   770\u2192                    )\n   771\u2192                    path.chmod(new_perms)\n   772\u2192\n   773\u2192        with self.input.wait_bar(\"Stripping binary...\"):\n   774\u2192            self.tools.subprocess.check_output([\"strip\", self.binary_path(app)])\n   775\u2192\n   776\u2192\n   777\u2192class LinuxSystemRunCommand(LinuxSystemPassiveMixin, RunCommand):\n   778\u2192    description = \"Run a Linux system project.\"\n   779\u2192    supported_host_os = {\"Linux\"}\n   780\u2192    supported_host_os_reason = \"Linux system projects can only be executed on Linux.\"\n   781\u2192\n   782\u2192    def run_app(\n   783\u2192        self, app: AppConfig, test_mode: bool, passthrough: List[str], **kwargs\n   784\u2192    ):\n   785\u2192        \"\"\"Start the application.\n   786\u2192\n   787\u2192        :param app: The config object for the app\n   788\u2192        :param test_mode: Boolean; Is the app running in test mode?\n   789\u2192        :param passthrough: The list of arguments to pass to the app\n   790\u2192        \"\"\"\n   791\u2192        # Set up the log stream\n   792\u2192        kwargs = self._prepare_app_env(app=app, test_mode=test_mode)\n   793\u2192\n   794\u2192        # Start the app in a way that lets us stream the logs\n   795\u2192        app_popen = self.tools.subprocess.Popen(\n   796\u2192            [os.fsdecode(self.binary_path(app))] + passthrough,\n   797\u2192            cwd=self.tools.home_path,\n   798\u2192            **kwargs,\n   799\u2192            stdout=subprocess.PIPE,\n   800\u2192            stderr=subprocess.STDOUT,\n   801\u2192            bufsize=1,\n   802\u2192        )\n   803\u2192\n   804\u2192        # Start streaming logs for the app.\n   805\u2192        self._stream_app_logs(\n   806\u2192            app,\n   807\u2192            popen=app_popen,\n   808\u2192            test_mode=test_mode,\n   809\u2192            clean_output=False,\n   810\u2192        )\n   811\u2192\n   812\u2192\n   813\u2192def debian_multiline_description(description):\n   814\u2192    \"\"\"Generate a Debian multiline description string.\n   815\u2192\n   816\u2192    The long description in a Debian control file must *not* contain any blank lines,\n   817\u2192    and each line must start with a single space. Convert a long description into Debian\n   818\u2192    format.\n   819\u2192\n   820\u2192    :param description: A multi-line long description string.\n   821\u2192    :returns: A string in Debian's multiline format\n   822\u2192    \"\"\"\n   823\u2192    return \"\\n \".join(line for line in description.split(\"\\n\") if line.strip() != \"\")\n   824\u2192\n   825\u2192\n   826\u2192class LinuxSystemPackageCommand(LinuxSystemMixin, PackageCommand):\n   827\u2192    description = \"Package a Linux system project.\"\n   828\u2192\n   829\u2192    @property\n   830\u2192    def packaging_formats(self):\n   831\u2192        return [\"deb\", \"rpm\", \"pkg\", \"system\"]\n   832\u2192\n   833\u2192    def _verify_deb_tools(self):\n   834\u2192        \"\"\"Verify that the local environment contains the debian packaging to