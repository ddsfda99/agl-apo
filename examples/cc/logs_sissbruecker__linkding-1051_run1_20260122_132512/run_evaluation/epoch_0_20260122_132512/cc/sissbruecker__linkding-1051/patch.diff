diff --git a/bookmarks/templatetags/shared.py b/bookmarks/templatetags/shared.py
index 5da3c1c..3744011 100644
--- a/bookmarks/templatetags/shared.py
+++ b/bookmarks/templatetags/shared.py
@@ -141,6 +141,73 @@ def render_markdown(context, markdown_text):
         renderer = context["markdown_renderer"]
 
     as_html = renderer.convert(markdown_text)
-    sanitized_html = bleach.clean(as_html, markdown_tags, markdown_attrs)
+
+    # Convert bare URLs into clickable links while avoiding code/pre/a blocks
+    # Use BeautifulSoup to safely modify HTML text nodes
+    from bs4 import BeautifulSoup
+
+    soup = BeautifulSoup(as_html, features="html.parser")
+
+    url_re = re.compile(r"((?:https?://|www\.)[^\s<]+)")
+
+    def has_forbidden_ancestor(node):
+        forbidden = {"a", "code", "pre"}
+        parent = node.parent
+        while parent is not None:
+            if getattr(parent, "name", None) in forbidden:
+                return True
+            parent = parent.parent
+        return False
+
+    for text_node in list(soup.find_all(string=True)):
+        if has_forbidden_ancestor(text_node):
+            continue
+        text = str(text_node)
+        parts = []
+        last = 0
+        changed = False
+        for m in url_re.finditer(text):
+            # Append preceding text
+            if m.start() > last:
+                parts.append(text[last:m.start()])
+            url = m.group(0)
+            href = url if url.startswith("http") else f"http://{url}"
+            a = soup.new_tag("a", href=href)
+            a["rel"] = "nofollow noopener"
+            a.string = url
+            parts.append(a)
+            last = m.end()
+            changed = True
+        if not changed:
+            continue
+        # Append remaining text
+        if last < len(text):
+            parts.append(text[last:])
+        # Replace the original text node with parts
+        parent = text_node.parent
+        insert_pos = parent.contents.index(text_node)
+        # Replace with first part
+        first = parts.pop(0)
+        text_node.replace_with(first)
+        # Insert the rest sequentially
+        for part in parts:
+            insert_pos += 1
+            parent.insert(insert_pos, part)
+
+    linkified_html = str(soup)
+
+    # Allow 'rel' attribute on anchor tags in sanitized HTML
+    try:
+        allowed_attrs = {k: (list(v) if isinstance(v, (set, tuple)) else (v.copy() if isinstance(v, list) else v)) for k, v in markdown_attrs.items()}
+    except Exception:
+        allowed_attrs = dict(markdown_attrs)
+    a_attrs = allowed_attrs.get("a", [])
+    if isinstance(a_attrs, (set, tuple)):
+        a_attrs = list(a_attrs)
+    if "rel" not in a_attrs:
+        a_attrs = list(a_attrs) + ["rel"]
+    allowed_attrs["a"] = a_attrs
+
+    sanitized_html = bleach.clean(linkified_html, markdown_tags, allowed_attrs)
 
     return mark_safe(sanitized_html)
