+        self.setup_bookmark(notes="Visit https://github.com")
+        html = self.render_template()
+
+        note_html = '<p>Visit <a href="https://github.com" rel="nofollow noopener">https://github.com</a></p>'
+        self.assertNotes(html, note_html, 1)
