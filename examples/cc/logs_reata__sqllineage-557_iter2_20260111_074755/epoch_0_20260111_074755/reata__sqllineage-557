                        "content": "     1\u2192import itertools\n     2\u2192from typing import Dict, List, Optional, Set, Tuple, Union\n     3\u2192\n     4\u2192import networkx as nx\n     5\u2192from networkx import DiGraph\n     6\u2192\n     7\u2192from sqllineage.core.metadata_provider import MetaDataProvider\n     8\u2192from sqllineage.core.models import Column, Path, Schema, SubQuery, Table\n     9\u2192from sqllineage.utils.constant import EdgeTag, EdgeType, NodeTag\n    10\u2192\n    11\u2192DATASET_CLASSES = (Path, Table)\n    12\u2192\n    13\u2192\n    14\u2192class ColumnLineageMixin:\n    15\u2192    def get_column_lineage(\n    16\u2192        self, exclude_path_ending_in_subquery=True, exclude_subquery_columns=False\n    17\u2192    ) -> Set[Tuple[Column, ...]]:\n    18\u2192        \"\"\"\n    19\u2192        :param exclude_path_ending_in_subquery:  exclude_subquery rename to exclude_path_ending_in_subquery\n    20\u2192               exclude column from SubQuery in the ending path\n    21\u2192        :param exclude_subquery_columns: exclude column from SubQuery in the path.\n    22\u2192\n    23\u2192        return a list of column tuple :class:`sqllineage.models.Column`\n    24\u2192        \"\"\"\n    25\u2192        self.graph: DiGraph  # For mypy attribute checking\n    26\u2192        # filter all the column node in the graph\n    27\u2192        column_nodes = [n for n in self.graph.nodes if isinstance(n, Column)]\n    28\u2192        column_graph = self.graph.subgraph(column_nodes)\n    29\u2192        source_columns = {column for column, deg in column_graph.in_degree if deg == 0}\n    30\u2192        # if a column lineage path ends at SubQuery, then it should be pruned\n    31\u2192        target_columns = {\n    32\u2192            node\n    33\u2192            for node, deg in column_graph.out_degree\n    34\u2192            if isinstance(node, Column) and deg == 0\n    35\u2192        }\n    36\u2192        if exclude_path_ending_in_subquery:\n    37\u2192            target_columns = {\n    38\u2192                node for node in target_columns if isinstance(node.parent, Table)\n    39\u2192            }\n    40\u2192        columns = set()\n    41\u2192        for source, target in itertools.product(source_columns, target_columns):\n    42\u2192            simple_paths = list(nx.all_simple_paths(self.graph, source, target))\n    43\u2192            for path in simple_paths:\n    44\u2192                if exclude_subquery_columns:\n    45\u2192                    path = [\n    46\u2192                        node for node in path if not isinstance(node.parent, SubQuery)\n    47\u2192                    ]\n    48\u2192                    if len(path) > 1:\n    49\u2192                        columns.add(tuple(path))\n    50\u2192                else:\n    51\u2192                    columns.add(tuple(path))\n    52\u2192        return columns\n    53\u2192\n    54\u2192\n    55\u2192class SubQueryLineageHolder(ColumnLineageMixin):\n    56\u2192    \"\"\"\n    57\u2192    SubQuery/Query Level Lineage Result.\n    58\u2192\n    59\u2192    SubQueryLineageHolder will hold attributes like read, write, cte.\n    60\u2192\n    61\u2192    Each of them is a Set[:class:`sqllineage.core.models.Table`].\n    62\u2192\n    63\u2192    This is the most atomic representation of lineage result.\n    64\u2192    \"\"\"\n    65\u2192\n    66\u2192    def __init__(self) -> None:\n    67\u2192        self.graph = nx.DiGraph()\n    68\u2192\n    69\u2192    def __or__(self, other):\n    70\u2192        self.graph = nx.compose(self.graph, other.graph)\n    71\u2192        return self\n    72\u2192\n    73\u2192    def _property_getter(self, prop) -> Set[Union[SubQuery, Table]]:\n    74\u2192        return {t for t, attr in self.graph.nodes(data=True) if attr.get(prop) is True}\n    75\u2192\n    76\u2192    def _property_setter(self, value, prop) -> None:\n    77\u2192        self.graph.add_node(value, **{prop: True})\n    78\u2192\n    79\u2192    @property\n    80\u2192    def read(self) -> Set[Union[SubQuery, Table]]:\n    81\u2192        return self._property_getter(NodeTag.READ)\n    82\u2192\n    83\u2192    def add_read(self, value) -> None:\n    84\u2192        self._property_setter(value, NodeTag.READ)\n    85\u2192        # the same table can be added (in SQL: joined) multiple times with different alias\n    86\u2192        if hasattr(value, \"alias\"):\n    87\u2192            self.graph.add_edge(value, value.alias, type=EdgeType.HAS_ALIAS)\n    88\u2192\n    89\u2192    @property\n    90\u2192    def write(self) -> Set[Union[SubQuery, Table]]:\n    91\u2192        # SubQueryLineageHolder.write can return a single SubQuery or Table, or both when __or__ together.\n    92\u2192        # This is different from StatementLineageHolder.write, where Table is the only possibility.\n    93\u2192        return self._property_getter(NodeTag.WRITE)\n    94\u2192\n    95\u2192    def add_write(self, value) -> None:\n    96\u2192        self._property_setter(value, NodeTag.WRITE)\n    97\u2192\n    98\u2192    @property\n    99\u2192    def cte(self) -> Set[SubQuery]:\n   100\u2192        return self._property_getter(NodeTag.CTE)  # type: ignore\n   101\u2192\n   102\u2192    def add_cte(self, value) -> None:\n   103\u2192        self._property_setter(value, NodeTag.CTE)\n   104\u2192\n   105\u2192    @property\n   106\u2192    def write_columns(self) -> List[Column]:\n   107\u2192        \"\"\"\n   108\u2192        return a list of columns that write table contains.\n   109\u2192        It's either manually added via `add_write_column` if specified in DML\n   110\u2192        or automatic added via `add_column_lineage` after parsing from SELECT\n   111\u2192        \"\"\"\n   112\u2192        tgt_cols = []\n   113\u2192        if tgt_tbl := self._get_target_table():\n   114\u2192            tgt_col_with_idx: List[Tuple[Column, int]] = sorted(\n   115\u2192                [\n   116\u2192                    (col, attr.get(EdgeTag.INDEX, 0))\n   117\u2192                    for tbl, col, attr in self.graph.out_edges(tgt_tbl, data=True)\n   118\u2192                    if attr[\"type\"] == EdgeType.HAS_COLUMN\n   119\u2192                ],\n   120\u2192                key=lambda x: x[1],\n   121\u2192            )\n   122\u2192            tgt_cols = [x[0] for x in tgt_col_with_idx]\n   123\u2192        return tgt_cols\n   124\u2192\n   125\u2192    def add_write_column(self, *tgt_cols: Column) -> None:\n   126\u2192        \"\"\"\n   127\u2192        in case of DML with column specified, like:\n   128\u2192\n   129\u2192        .. code-block:: sql\n   130\u2192\n   131\u2192            INSERT INTO tab1 (col1, col2)\n   132\u2192            SELECT col3, col4\n   133\u2192\n   134\u2192        this method is called to make sure tab1 has column col1 and col2 instead of col3 and col4\n   135\u2192        \"\"\"\n   136\u2192        if self.write:\n   137\u2192            tgt_tbl = list(self.write)[0]\n   138\u2192            for idx, tgt_col in enumerate(tgt_cols):\n   139\u2192                tgt_col.parent = tgt_tbl\n   140\u2192                if tgt_col in self.write_columns:\n   141\u2192                    # for DDL with PARTITIONED BY (col) or CLUSTERED BY (col), column can be added multiple times\n   142\u2192                    break\n   143\u2192                self.graph.add_edge(\n   144\u2192                    tgt_tbl, tgt_col, type=EdgeType.HAS_COLUMN, **{EdgeTag.INDEX: idx}\n   145\u2192                )\n   146\u2192\n   147\u2192    def add_column_lineage(self, src: Column, tgt: Column) -> None:\n   148\u2192        \"\"\"\n   149\u2192        link source column to target.\n   150\u2192        \"\"\"\n   151\u2192        self.graph.add_edge(src, tgt, type=EdgeType.LINEAGE)\n   152\u2192        self.graph.add_edge(tgt.parent, tgt, type=EdgeType.HAS_COLUMN)\n   153\u2192        if src.parent is not None:\n   154\u2192            # starting NetworkX v2.6, None is not allowed as node, see https://github.com/networkx/networkx/pull/4892\n   155\u2192            self.graph.add_edge(src.parent, src, type=EdgeType.HAS_COLUMN)\n   156\u2192\n   157\u2192    def get_table_columns(self, table: Union[Table, SubQuery]) -> List[Column]:\n   158\u2192        return [\n   159\u2192            tgt\n   160\u2192            for (src, tgt, edge_type) in self.graph.out_edges(nbunch=table, data=\"type\")\n   161\u2192            if edge_type == EdgeType.HAS_COLUMN\n   162\u2192            and isinstance(tgt, Column)\n   163\u2192            and tgt.raw_name != \"*\"\n   164\u2192        ]\n   165\u2192\n   166\u2192    def expand_wildcard(self, metadata_provider: MetaDataProvider) -> None:\n   167\u2192        if tgt_table := self._get_target_table():\n   168\u2192            for column in self.write_columns:\n   169\u2192                if column.raw_name == \"*\":\n   170\u2192                    tgt_wildcard = column\n   171\u2192                    for src_wildcard in self.get_source_columns(tgt_wildcard):\n   172\u2192                        if source_table := src_wildcard.parent:\n   173\u2192                            src_table_columns = []\n   174\u2192                            if isinstance(source_table, SubQuery):\n   175\u2192                                # the columns of SubQuery can be inferred from graph\n   176\u2192                                src_table_columns = self.get_table_columns(source_table)\n   177\u2192                            elif isinstance(source_table, Table) and metadata_provider:\n   178\u2192                                # search by metadata service\n   179\u2192                                src_table_columns = metadata_provider.get_table_columns(\n   180\u2192                                    source_table\n   181\u2192                                )\n   182\u2192                            if src_table_columns:\n   183\u2192                                self._replace_wildcard(\n   184\u2192                                    tgt_table,\n   185\u2192                                    src_table_columns,\n   186\u2192                                    tgt_wildcard,\n   187\u2192                                    src_wildcard,\n   188\u2192                                )\n   189\u2192\n   190\u2192    def get_alias_mapping_from_table_group(\n   191\u2192        self, table_group: List[Union[Path, Table, SubQuery]]\n   192\u2192    ) -> Dict[str, Union[Path, Table, SubQuery]]:\n   193\u2192        \"\"\"\n   194\u2192        A table can be referred to as alias, table name, or database_name.table_name, create the mapping here.\n   195\u2192        For SubQuery, it's only alias then.\n   196\u2192        \"\"\"\n   197\u2192        return {\n   198\u2192            **{\n   199\u2192                tgt: src\n   200\u2192                for src, tgt, attr in self.graph.edges(data=True)\n   201\u2192                if attr.get(\"type\") == EdgeType.HAS_ALIAS and src in table_group\n   202\u2192            },\n   203\u2192            **{\n   204\u2192                table.raw_name: table\n   205\u2192                for table in table_group\n   206\u2192                if isinstance(table, Table)\n   207\u2192            },\n   208\u2192            **{str(table): table for table in table_group if isinstance(table, Table)},\n   209\u2192        }\n   210\u2192\n   211\u2192    def _get_target_table(self) -> Optional[Union[SubQuery, Table]]:\n   212\u2192        table = None\n   213\u2192        if write_only := self.write.difference(self.read):\n   214\u2192            table = next(iter(write_only))\n   215\u2192        return table\n   216\u2192\n   217\u2192    def get_source_columns(self, node: Column) -> List[Column]:\n   218\u2192        return [\n   219\u2192            src\n   220\u2192            for (src, tgt, edge_type) in self.graph.in_edges(nbunch=node, data=\"type\")\n   221\u2192            if edge_type == EdgeType.LINEAGE and isinstance(src, Column)\n   222\u2192        ]\n   223\u2192\n   224\u2192    def _replace_wildcard(\n   225\u2192        self,\n   226\u2192        tgt_table: Union[Table, SubQuery],\n   227\u2192        src_table_columns: List[Column],\n   228\u2192        tgt_wildcard: Column,\n   229\u2192        src_wildcard: Column,\n   230\u2192    ) -> None:\n   231\u2192        target_columns = self.get_table_columns(tgt_table)\n   232\u2192        for src_col in src_table_columns:\n   233\u2192            new_column = Column(src_col.raw_name)\n   234\u2192            new_column.parent = tgt_table\n   235\u2192            if new_column in target_columns or src_col.raw_name == \"*\":\n   236\u2192                continue\n   237\u2192            self.graph.add_edge(tgt_table, new_column, type=EdgeType.HAS_COLUMN)\n   238\u2192            self.graph.add_edge(src_col.parent, src_col, type=EdgeType.HAS_COLUMN)\n   239\u2192            self.graph.add_edge(src_col, new_column, type=EdgeType.LINEAGE)\n   240\u2192        # remove wildcard\n   241\u2192        if self.graph.has_node(tgt_wildcard):\n   242\u2192            self.graph.remove_node(tgt_wildcard)\n   243\u2192        if self.graph.has_node(src_wildcard):\n   244\u2192            self.graph.remove_node(src_wildcard)\n   245\u2192\n   246\u2192\n   247\u2192class StatementLineageHolder(SubQueryLineageHolder, ColumnLineageMixin):\n   248\u2192    \"\"\"\n   249\u2192    Statement Level Lineage Result.\n   250\u2192\n   251\u2192    Based on SubQueryLineageHolder, StatementLineageHolder holds extra attributes like drop and rename\n   252\u2192\n   253\u2192    For drop, it is a Set[:class:`sqllineage.core.models.Table`].\n   254\u2192\n   255\u2192    For rename, it a Set[Tuple[:class:`sqllineage.core.models.Table`, :class:`sqllineage.core.models.Table`]],\n   256\u2192    with the first table being original table before renaming and the latter after renaming.\n   257\u2192    \"\"\"\n   258\u2192\n   259\u2192    def __str__(self):\n   260\u2192        return \"\\n\".join(\n   261\u2192            f\"table {attr}: {sorted(getattr(self, attr), key=lambda x: str(x)) if getattr(self, attr) else '[]'}\"\n   262\u2192            for attr in [\"read\", \"write\", \"cte\", \"drop\", \"rename\"]\n   263\u2192        )\n   264\u2192\n   265\u2192    def __repr__(self):\n   266\u2192        return str(self)\n   267\u2192\n   268\u2192    @property\n   269\u2192    def read(self) -> Set[Table]:  # type: ignore\n   270\u2192        return {t for t in super().read if isinstance(t, DATASET_CLASSES)}\n   271\u2192\n   272\u2192    @property\n   273\u2192    def write(self) -> Set[Table]:  # type: ignore\n   274\u2192        return {t for t in super().write if isinstance(t, DATASET_CLASSES)}\n   275\u2192\n   276\u2192    @property\n   277\u2192    def drop(self) -> Set[Table]:\n   278\u2192        return self._property_getter(NodeTag.DROP)  # type: ignore\n   279\u2192\n   280\u2192    def add_drop(self, value) -> None:\n   281\u2192        self._property_setter(value, NodeTag.DROP)\n   282\u2192\n   283\u2192    @property\n   284\u2192    def rename(self) -> Set[Tuple[Table, Table]]:\n   285\u2192        return {\n   286\u2192            (src, tgt)\n   287\u2192            for src, tgt, attr in self.graph.edges(data=True)\n   288\u2192            if attr.get(\"type\") == EdgeType.RENAME\n   289\u2192        }\n   290\u2192\n   291\u2192    def add_rename(self, src: Table, tgt: Table) -> None:\n   292\u2192        self.graph.add_edge(src, tgt, type=EdgeType.RENAME)\n   293\u2192\n   294\u2192    @staticmethod\n   295\u2192    def of(holder: SubQueryLineageHolder) -> \"StatementLineageHolder\":\n   296\u2192        stmt_holder = StatementLineageHolder()\n   297\u2192        stmt_holder.graph = holder.graph\n   298\u2192        return stmt_holder\n   299\u2192\n   300\u2192\n   301\u2192class SQLLineageHolder(ColumnLineageMixin):\n   302\u2192    def __init__(self, graph: DiGraph):\n   303\u2192        \"\"\"\n   304\u2192        The combined lineage result in representation of Directed Acyclic Graph.\n   305\u2192\n   306\u2192        :param graph: the Directed Acyclic Graph holding all the combined lineage result.\n   307\u2192        \"\"\"\n   308\u2192        self.graph = graph\n   309\u2192        self._selfloop_tables = self.__retrieve_tag_tables(NodeTag.SELFLOOP)\n   310\u2192        self._sourceonly_tables = self.__retrieve_tag_tables(NodeTag.SOURCE_ONLY)\n   311\u2192        self._targetonly_tables = self.__retrieve_tag_tables(NodeTag.TARGET_ONLY)\n   312\u2192\n   313\u2192    @property\n   314\u2192    def table_lineage_graph(self) -> DiGraph:\n   315\u2192        \"\"\"\n   316\u2192        The table level DiGraph held by SQLLineageHolder\n   317\u2192        \"\"\"\n   318\u2192        table_nodes = [n for n in self.graph.nodes if isinstance(n, DATASET_CLASSES)]\n   319\u2192        return self.graph.subgraph(table_nodes)\n   320\u2192\n   321\u2192    @property\n   322\u2192    def column_lineage_graph(self) -> DiGraph:\n   323\u2192        \"\"\"\n   324\u2192        The column level DiGraph held by SQLLineageHolder\n   325\u2192        \"\"\"\n   326\u2192        column_nodes = [n for n in self.graph.nodes if isinstance(n, Column)]\n   327\u2192        return self.graph.subgraph(column_nodes)\n   328\u2192\n   329\u2192    @property\n   330\u2192    def source_tables(self) -> Set[Table]:\n   331\u2192        \"\"\"\n   332\u2192        a list of source :class:`sqllineage.core.models.Table`\n   333\u2192        \"\"\"\n   334\u2192        source_tables = {\n   335\u2192            table for table, deg in self.table_lineage_graph.in_degree if deg == 0\n   336\u2192        }.intersection(\n   337\u2192            {table for table, deg in self.table_lineage_graph.out_degree if deg > 0}\n   338\u2192        )\n   339\u2192        source_tables |= self._selfloop_tables\n   340\u2192        source_tables |= self._sourceonly_tables\n   341\u2192        return source_tables\n   342\u2192\n   343\u2192    @property\n   344\u2192    def target_tables(self) -> Set[Table]:\n   345\u2192        \"\"\"\n   346\u2192        a list of target :class:`sqllineage.core.models.Table`\n   347\u2192        \"\"\"\n   348\u2192        target_tables = {\n   349\u2192            table for table, deg in self.table_lineage_graph.out_degree if deg == 0\n   350\u2192        }.intersection(\n   351\u2192            {table for table, deg in self.table_lineage_graph.in_degree if deg > 0}\n   352\u2192        )\n   353\u2192        target_tables |= self._selfloop_tables\n   354\u2192        target_tables |= self._targetonly_tables\n   355\u2192        return target_tables\n   356\u2192\n   357\u2192    @property\n   358\u2192    def intermediate_tables(self) -> Set[Table]:\n   359\u2192        \"\"\"\n   360\u2192        a list of intermediate :class:`sqllineage.core.models.Table`\n   361\u2192        \"\"\"\n   362\u2192        intermediate_tables = {\n   363\u2192            table for table, deg in self.table_lineage_graph.in_degree if deg > 0\n   364\u2192        }.intersection(\n   365\u2192            {table for table, deg in self.table_lineage_graph.out_degree if deg > 0}\n   366\u2192        )\n   367\u2192        intermediate_tables -= self.__retrieve_tag_tables(NodeTag.SELFLOOP)\n   368\u2192        return intermediate_tables\n   369\u2192\n   370\u2192    def __retrieve_tag_tables(self, tag) -> Set[Union[Path, Table]]:\n   371\u2192        return {\n   372\u2192            table\n   373\u2192            for table, attr in self.graph.nodes(data=True)\n   374\u2192            if attr.get(tag) is True and isinstance(table, DATASET_CLASSES)\n   375\u2192        }\n   376\u2192\n   377\u2192    @staticmethod\n   378\u2192    def _build_digraph(\n   379\u2192        metadata_provider: MetaDataProvider, *args: StatementLineageHolder\n   380\u2192    ) -> DiGraph:\n   381\u2192        g = DiGraph()\n   382\u2192        for holder in args:\n   383\u2192            g = nx.compose(g, holder.graph)\n   384\u2192            if holder.drop:\n   385\u2192                for table in holder.drop:\n   386\u2192                    if g.has_node(table) and g.degree[table] == 0:\n   387\u2192                        g.remove_node(table)\n   388\u2192            elif holder.rename:\n   389\u2192                for table_old, table_new in holder.rename:\n   390\u2192                    g = nx.relabel_nodes(g, {table_old: table_new})\n   391\u2192                    g.remove_edge(table_new, table_new)\n   392\u2192                    if g.degree[table_new] == 0:\n   393\u2192                        g.remove_node(table_new)\n   394\u2192            else:\n   395\u2192                read, write = holder.read, holder.write\n   396\u2192                if len(read) > 0 and len(write) == 0:\n   397\u2192                    # source only table comes from SELECT statement\n   398\u2192                    nx.set_node_attributes(\n   399\u2192                        g, {table: True for table in read}, NodeTag.SOURCE_ONLY\n   400\u2192                    )\n   401\u2192                elif len(read) == 0 and len(write) > 0:\n   402\u2192                    # target only table comes from case like: 1) INSERT/UPDATE constant values; 2) CREATE TABLE\n   403\u2192                    nx.set_node_attributes(\n   404\u2192                        g, {table: True for table in write}, NodeTag.TARGET_ONLY\n   405\u2192                    )\n   406\u2192                else:\n   407\u2192                    for source, target in itertools.product(read, write):\n   408\u2192                        g.add_edge(source, target, type=EdgeType.LINEAGE)\n   409\u2192        nx.set_node_attributes(\n   410\u2192            g,\n   411\u2192            {table: True for table in {e[0] for e in nx.selfloop_edges(g)}},\n   412\u2192            NodeTag.SELFLOOP,\n   413\u2192        )\n   414\u2192        # find all the columns that we can't assign accurately to a parent table (with multiple parent candidates)\n   415\u2192        unresolved_cols = [\n   416\u2192            (s, t)\n   417\u2192            for s, t in g.edges\n   418\u2192            if isinstance(s, Column) and len(s.parent_candidates) > 1\n   419\u2192        ]\n   420\u2192        for unresolved_col, tgt_col in unresolved_cols:\n   421\u2192            # check if there's only one parent candidate contains the column with same name\n   422\u2192            src_cols = []\n   423\u2192            # check if source column exists in graph (either from subquery or from table created in prev statement)\n   424\u2192            for parent in unresolved_col.parent_candidates:\n   425\u2192                src_col = Column(unresolved_col.raw_name)\n   426\u2192                src_col.parent = parent\n   427\u2192                if g.has_edge(parent, src_col):\n   428\u2192                    src_cols.append(src_col)\n   429\u2192            # if not in graph, check if defined in table schema by metadata service\n   430\u2192            if len(src_cols) == 0 and bool(metadata_provider):\n   431\u2192                for parent in unresolved_col.parent_candidates:\n   432\u2192                    if (\n   433\u2192                        isinstance(parent, Table)\n   434\u2192                        and str(parent.schema) != Schema.unknown\n   435\u2192                    ):\n   436\u2192                        columns = metadata_provider.get_table_columns(parent)\n   437\u2192                        for src_col in columns:\n   438\u2192                            if unresolved_col.raw_name == src_col.raw_name:\n   439\u2192                                src_cols.append(src_col)\n   440\u2192\n   441\u2192            # Multiple sources is a correct case for JOIN with USING\n   442\u2192            # It incorrect for JOIN with ON, but sql without specifying an alias in this case will be invalid\n   443\u2192            for src_col in s