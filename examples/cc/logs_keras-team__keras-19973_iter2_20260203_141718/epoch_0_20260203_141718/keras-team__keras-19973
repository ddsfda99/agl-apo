      # This will fail because the polymorphic_shapes that is\n   398\u2192            # automatically generated will not account for the fact that\n   399\u2192            # dynamic dimensions 1 and 2 must have the same value.\n   400\u2192            export_archive = export_lib.ExportArchive()\n   401\u2192            export_archive.track(model)\n   402\u2192            export_archive.add_endpoint(\n   403\u2192                \"call\",\n   404\u2192                model.__call__,\n   405\u2192                input_signature=signature,\n   406\u2192                jax2tf_kwargs={},\n   407\u2192            )\n   408\u2192            export_archive.write_out(temp_filepath)\n   409\u2192\n   410\u2192        export_archive = export_lib.ExportArchive()\n   411\u2192        export_archive.track(model)\n   412\u2192        export_archive.add_endpoint(\n   413\u2192            \"call\",\n   414\u2192            model.__call__,\n   415\u2192            input_signature=signature,\n   416\u2192            jax2tf_kwargs={\"polymorphic_shapes\": [\"(batch, a, a)\"]},\n   417\u2192        )\n   418\u2192        export_archive.write_out(temp_filepath)\n   419\u2192        revived_model = tf.saved_model.load(temp_filepath)\n   420\u2192        self.assertAllClose(ref_output, revived_model.call(ref_input))\n   421\u2192\n   422\u2192    @pytest.mark.skipif(\n   423\u2192        backend.backend() != \"tensorflow\",\n   424\u2192        reason=\"This test is native to the TF backend.\",\n   425\u2192    )\n   426\u2192    def test_endpoint_registration_tf_function(self):\n   427\u2192        temp_filepath = os.path.join(self.get_temp_dir(), \"exported_model\")\n   428\u2192\n   429\u2192        model = get_model()\n   430\u2192        ref_input = tf.random.normal((3, 10))\n   431\u2192        ref_output = model(ref_input)\n   432\u2192\n   433\u2192        # Test variable tracking\n   434\u2192        export_archive = export_lib.ExportArchive()\n   435\u2192        export_archive.track(model)\n   436\u2192        self.assertLen(export_archive.variables, 8)\n   437\u2192        self.assertLen(export_archive.trainable_variables, 6)\n   438\u2192        self.assertLen(export_archive.non_trainable_variables, 2)\n   439\u2192\n   440\u2192        @tf.function()\n   441\u2192        def my_endpoint(x):\n   442\u2192            return model(x)\n   443\u2192\n   444\u2192        # Test registering an endpoint that is a tf.function (called)\n   445\u2192        my_endpoint(ref_input)  # Trace fn\n   446\u2192\n   447\u2192        export_archive.add_endpoint(\n   448\u2192            \"call\",\n   449\u2192            my_endpoint,\n   450\u2192        )\n   451\u2192        export_archive.write_out(temp_filepath)\n   452\u2192\n   453\u2192        revived_model = tf.saved_model.load(temp_filepath)\n   454\u2192        self.assertFalse(hasattr(revived_model, \"_tracked\"))\n   455\u2192        self.assertAllClose(ref_output, revived_model.call(ref_input))\n   456\u2192        self.assertLen(revived_model.variables, 8)\n   457\u2192        self.assertLen(revived_model.trainable_variables, 6)\n   458\u2192        self.assertLen(revived_model.non_trainable_variables, 2)\n   459\u2192\n   460\u2192    @pytest.mark.skipif(\n   461\u2192        backend.backend() != \"jax\",\n   462\u2192        reason=\"This test is native to the JAX backend.\",\n   463\u2192    )\n   464\u2192    def test_jax_endpoint_registration_tf_function(self):\n   465\u2192        model = get_model()\n   466\u2192        ref_input = np.random.normal(size=(3, 10))\n   467\u2192        model(ref_input)\n   468\u2192\n   469\u2192        # build a JAX function\n   470\u2192        def model_call(x):\n   471\u2192            return model(x)\n   472\u2192\n   473\u2192        from jax import default_backend as jax_device\n   474\u2192        from jax.experimental import jax2tf\n   475\u2192\n   476\u2192        native_jax_compatible = not (\n   477\u2192            jax_device() == \"gpu\"\n   478\u2192            and len(tf.config.list_physical_devices(\"GPU\")) == 0\n   479\u2192        )\n   480\u2192        # now, convert JAX function\n   481\u2192        converted_model_call = jax2tf.convert(\n   482\u2192            model_call,\n   483\u2192            native_serialization=native_jax_compatible,\n   484\u2192            polymorphic_shapes=[\"(b, 10)\"],\n   485\u2192        )\n   486\u2192\n   487\u2192        # you can now build a TF inference function\n   488\u2192        @tf.function(\n   489\u2192            input_signature=[tf.TensorSpec(shape=(None, 10), dtype=tf.float32)],\n   490\u2192            autograph=False,\n   491\u2192        )\n   492\u2192        def infer_fn(x):\n   493\u2192            return converted_model_call(x)\n   494\u2192\n   495\u2192        ref_output = infer_fn(ref_input)\n   496\u2192\n   497\u2192        # Export with TF inference function as endpoint\n   498\u2192        temp_filepath = os.path.join(self.get_temp_dir(), \"my_model\")\n   499\u2192        export_archive = export_lib.ExportArchive()\n   500\u2192        export_archive.track(model)\n   501\u2192        export_archive.add_endpoint(\"serve\", infer_fn)\n   502\u2192        export_archive.write_out(temp_filepath)\n   503\u2192\n   504\u2192        # Reload and verify outputs\n   505\u2192        revived_model = tf.saved_model.load(temp_filepath)\n   506\u2192        self.assertFalse(hasattr(revived_model, \"_tracked\"))\n   507\u2192        self.assertAllClose(ref_output, revived_model.serve(ref_input))\n   508\u2192        self.assertLen(revived_model.variables, 8)\n   509\u2192        self.assertLen(revived_model.trainable_variables, 6)\n   510\u2192        self.assertLen(revived_model.non_trainable_variables, 2)\n   511\u2192\n   512\u2192        # Assert all variables wrapped as `tf.Variable`\n   513\u2192        assert isinstance(export_archive.variables[0], tf.Variable)\n   514\u2192        assert isinstance(export_archive.trainable_variables[0], tf.Variable)\n   515\u2192        assert isinstance(\n   516\u2192            export_archive.non_trainable_variables[0], tf.Variable\n   517\u2192        )\n   518\u2192\n   519\u2192    @pytest.mark.skipif(\n   520\u2192        backend.backend() != \"jax\",\n   521\u2192        reason=\"This test is native to the JAX backend.\",\n   522\u2192    )\n   523\u2192    def test_jax_multi_unknown_endpoint_registration(self):\n   524\u2192        window_size = 100\n   525\u2192\n   526\u2192        X = np.random.random((1024, window_size, 1))\n   527\u2192        Y = np.random.random((1024, window_size, 1))\n   528\u2192\n   529\u2192        model = models.Sequential(\n   530\u2192            [\n   531\u2192                layers.Dense(128, activation=\"relu\"),\n   532\u2192                layers.Dense(64, activation=\"relu\"),\n   533\u2192                layers.Dense(1, activation=\"relu\"),\n   534\u2192            ]\n   535\u2192        )\n   536\u2192\n   537\u2192        model.compile(optimizer=\"adam\", loss=\"mse\")\n   538\u2192\n   539\u2192        model.fit(X, Y, batch_size=32)\n   540\u2192\n   541\u2192        # build a JAX function\n   542\u2192        def model_call(x):\n   543\u2192            return model(x)\n   544\u2192\n   545\u2192        from jax import default_backend as jax_device\n   546\u2192        from jax.experimental import jax2tf\n   547\u2192\n   548\u2192        native_jax_compatible = not (\n   549\u2192            jax_device() == \"gpu\"\n   550\u2192            and len(tf.config.list_physical_devices(\"GPU\")) == 0\n   551\u2192        )\n   552\u2192        # now, convert JAX function\n   553\u2192        converted_model_call = jax2tf.convert(\n   554\u2192            model_call,\n   555\u2192            native_serialization=native_jax_compatible,\n   556\u2192            polymorphic_shapes=[\"(b, t, 1)\"],\n   557\u2192        )\n   558\u2192\n   559\u2192        # you can now build a TF inference function\n   560\u2192        @tf.function(\n   561\u2192            input_signature=[\n   562\u2192                tf.TensorSpec(shape=(None, None, 1), dtype=tf.float32)\n   563\u2192            ],\n   564\u2192            autograph=False,\n   565\u2192        )\n   566\u2192        def infer_fn(x):\n   567\u2192            return converted_model_call(x)\n   568\u2192\n   569\u2192        ref_input = np.random.random((1024, window_size, 1))\n   570\u2192        ref_output = infer_fn(ref_input)\n   571\u2192\n   572\u2192        # Export with TF inference function as endpoint\n   573\u2192        temp_filepath = os.path.join(self.get_temp_dir(), \"my_model\")\n   574\u2192        export_archive = export_lib.ExportArchive()\n   575\u2192        export_archive.track(model)\n   576\u2192        export_archive.add_endpoint(\"serve\", infer_fn)\n   577\u2192        export_archive.write_out(temp_filepath)\n   578\u2192\n   579\u2192        # Reload and verify outputs\n   580\u2192        revived_model = tf.saved_model.load(temp_filepath)\n   581\u2192        self.assertFalse(hasattr(revived_model, \"_tracked\"))\n   582\u2192        self.assertAllClose(ref_output, revived_model.serve(ref_input))\n   583\u2192        self.assertLen(revived_model.variables, 6)\n   584\u2192        self.assertLen(revived_model.trainable_variables, 6)\n   585\u2192        self.assertLen(revived_model.non_trainable_variables, 0)\n   586\u2192\n   587\u2192        # Assert all variables wrapped as `tf.Variable`\n   588\u2192        assert isinstance(export_archive.variables[0], tf.Variable)\n   589\u2192        assert isinstance(export_archive.trainable_variables[0], tf.Variable)\n   590\u2192\n   591\u2192    def test_layer_export(self):\n   592\u2192        temp_filepath = os.path.join(self.get_temp_dir(), \"exported_layer\")\n   593\u2192\n   594\u2192        layer = layers.BatchNormalization()\n   595\u2192        ref_input = tf.random.normal((3, 10))\n   596\u2192        ref_output = layer(ref_input)  # Build layer (important)\n   597\u2192\n   598\u2192        export_archive = export_lib.ExportArchive()\n   599\u2192        export_archive.track(layer)\n   600\u2192        export_archive.add_endpoint(\n   601\u2192            \"call\",\n   602\u2192            layer.call,\n   603\u2192            input_signature=[tf.TensorSpec(shape=(None, 10), dtype=tf.float32)],\n   604\u2192        )\n   605\u2192        export_archive.write_out(temp_filepath)\n   606\u2192        revived_layer = tf.saved_model.load(temp_filepath)\n   607\u2192        self.assertAllClose(ref_output, revived_layer.call(ref_input))\n   608\u2192\n   609\u2192    def test_multi_input_output_functional_model(self):\n   610\u2192        temp_filepath = os.path.join(self.get_temp_dir(), \"exported_model\")\n   611\u2192        x1 = layers.Input((2,))\n   612\u2192        x2 = layers.Input((2,))\n   613\u2192        y1 = layers.Dense(3)(x1)\n   614\u2192        y2 = layers.Dense(3)(x2)\n   615\u2192        model = models.Model([x1, x2], [y1, y2])\n   616\u2192\n   617\u2192        ref_inputs = [tf.random.normal((3, 2)), tf.random.normal((3, 2))]\n   618\u2192        ref_outputs = model(ref_inputs)\n   619\u2192\n   620\u2192        export_archive = export_lib.ExportArchive()\n   621\u2192        export_archive.track(model)\n   622\u2192        export_archive.add_endpoint(\n   623\u2192            \"serve\",\n   624\u2192            model.__call__,\n   625\u2192            input_signature=[\n   626\u2192                [\n   627\u2192                    tf.TensorSpec(shape=(None, 2), dtype=tf.float32),\n   628\u2192                    tf.TensorSpec(shape=(None, 2), dtype=tf.float32),\n   629\u2192                ]\n   630\u2192            ],\n   631\u2192        )\n   632\u2192        export_archive.write_out(temp_filepath)\n   633\u2192        revived_model = tf.saved_model.load(temp_filepath)\n   634\u2192        self.assertAllClose(ref_outputs[0], revived_model.serve(ref_inputs)[0])\n   635\u2192        self.assertAllClose(ref_outputs[1], revived_model.serve(ref_inputs)[1])\n   636\u2192        # Test with a different batch size\n   637\u2192        revived_model.serve(\n   638\u2192            [tf.random.normal((6, 2)), tf.random.normal((6, 2))]\n   639\u2192        )\n   640\u2192\n   641\u2192        # Now test dict inputs\n   642\u2192        model = models.Model({\"x1\": x1, \"x2\": x2}, [y1, y2])\n   643\u2192\n   644\u2192        ref_inputs = {\n   645\u2192            \"x1\": tf.random.normal((3, 2)),\n   646\u2192            \"x2\": tf.random.normal((3, 2)),\n   647\u2192        }\n   648\u2192        ref_outputs = model(ref_inputs)\n   649\u2192\n   650\u2192        export_archive = export_lib.ExportArchive()\n   651\u2192        export_archive.track(model)\n   652\u2192        export_archive.add_endpoint(\n   653\u2192            \"serve\",\n   654\u2192            model.__call__,\n   655\u2192            input_signature=[\n   656\u2192                {\n   657\u2192                    \"x1\": tf.TensorSpec(shape=(None, 2), dtype=tf.float32),\n   658\u2192                    \"x2\": tf.TensorSpec(shape=(None, 2), dtype=tf.float32),\n   659\u2192                }\n   660\u2192            ],\n   661\u2192        )\n   662\u2192        export_archive.write_out(temp_filepath)\n   663\u2192        revived_model = tf.saved_model.load(temp_filepath)\n   664\u2192        self.assertAllClose(ref_outputs[0], revived_model.serve(ref_inputs)[0])\n   665\u2192        self.assertAllClose(ref_outputs[1], revived_model.serve(ref_inputs)[1])\n   666\u2192        # Test with a different batch size\n   667\u2192        revived_model.serve(\n   668\u2192            {\n   669\u2192                \"x1\": tf.random.normal((6, 2)),\n   670\u2192                \"x2\": tf.random.normal((6, 2)),\n   671\u2192            }\n   672\u2192        )\n   673\u2192\n   674\u2192    # def test_model_with_lookup_table(self):\n   675\u2192    #     tf.debugging.disable_traceback_filtering()\n   676\u219