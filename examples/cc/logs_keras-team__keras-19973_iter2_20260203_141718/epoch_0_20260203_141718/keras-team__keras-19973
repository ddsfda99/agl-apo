\n   242\u2192    )\n   243\u2192    def test_low_level_model_export(self, model_type):\n   244\u2192        temp_filepath = os.path.join(self.get_temp_dir(), \"exported_model\")\n   245\u2192\n   246\u2192        model = get_model(model_type)\n   247\u2192        ref_input = tf.random.normal((3, 10))\n   248\u2192        ref_output = model(ref_input)\n   249\u2192\n   250\u2192        # Test variable tracking\n   251\u2192        export_archive = export_lib.ExportArchive()\n   252\u2192        export_archive.track(model)\n   253\u2192        self.assertLen(export_archive.variables, 8)\n   254\u2192        self.assertLen(export_archive.trainable_variables, 6)\n   255\u2192        self.assertLen(export_archive.non_trainable_variables, 2)\n   256\u2192\n   257\u2192        export_archive = export_lib.ExportArchive()\n   258\u2192        export_archive.track(model)\n   259\u2192        export_archive.add_endpoint(\n   260\u2192            \"call\",\n   261\u2192            model.__call__,\n   262\u2192            input_signature=[tf.TensorSpec(shape=(None, 10), dtype=tf.float32)],\n   263\u2192        )\n   264\u2192        export_archive.write_out(temp_filepath)\n   265\u2192        revived_model = tf.saved_model.load(temp_filepath)\n   266\u2192        self.assertAllClose(ref_output, revived_model.call(ref_input))\n   267\u2192        # Test with a different batch size\n   268\u2192        revived_model.call(tf.random.normal((6, 10)))\n   269\u2192\n   270\u2192    def test_low_level_model_export_with_alias(self):\n   271\u2192        temp_filepath = os.path.join(self.get_temp_dir(), \"exported_model\")\n   272\u2192\n   273\u2192        model = get_model()\n   274\u2192        ref_input = tf.random.normal((3, 10))\n   275\u2192        ref_output = model(ref_input)\n   276\u2192\n   277\u2192        export_archive = export_lib.ExportArchive()\n   278\u2192        export_archive.track(model)\n   279\u2192        fn = export_archive.add_endpoint(\n   280\u2192            \"call\",\n   281\u2192            model.__call__,\n   282\u2192            input_signature=[tf.TensorSpec(shape=(None, 10), dtype=tf.float32)],\n   283\u2192        )\n   284\u2192        export_archive.write_out(\n   285\u2192            temp_filepath,\n   286\u2192            tf.saved_model.SaveOptions(function_aliases={\"call_alias\": fn}),\n   287\u2192        )\n   288\u2192        revived_model = tf.saved_model.load(\n   289\u2192            temp_filepath,\n   290\u2192            options=tf.saved_model.LoadOptions(\n   291\u2192                experimental_load_function_aliases=True\n   292\u2192            ),\n   293\u2192        )\n   294\u2192        self.assertAllClose(\n   295\u2192            ref_output, revived_model.function_aliases[\"call_alias\"](ref_input)\n   296\u2192        )\n   297\u2192        # Test with a different batch size\n   298\u2192        revived_model.function_aliases[\"call_alias\"](tf.random.normal((6, 10)))\n   299\u2192\n   300\u2192    @parameterized.named_parameters(\n   301\u2192        named_product(model_type=[\"sequential\", \"functional\", \"subclass\"])\n   302\u2192    )\n   303\u2192    def test_low_level_model_export_with_dynamic_dims(self, model_type):\n   304\u2192\n   305\u2192        class ReductionLayer(layers.Layer):\n   306\u2192            def call(self, inputs):\n   307\u2192                return ops.max(inputs, axis=1)\n   308\u2192\n   309\u2192        temp_filepath = os.path.join(self.get_temp_dir(), \"exported_model\")\n   310\u2192\n   311\u2192        model = get_model(\n   312\u2192            model_type,\n   313\u2192            input_shape=[(None,), (None,)],\n   314\u2192            layer_list=[layers.Concatenate(), ReductionLayer()],\n   315\u2192        )\n   316\u2192        ref_input = [tf.random.normal((3, 8)), tf.random.normal((3, 6))]\n   317\u2192        ref_output = model(ref_input)\n   318\u2192\n   319\u2192        export_archive = export_lib.ExportArchive()\n   320\u2192        export_archive.track(model)\n   321\u2192        export_archive.add_endpoint(\n   322\u2192            \"call\",\n   323\u2192            model.__call__,\n   324\u2192            input_signature=[\n   325\u2192                [\n   326\u2192                    tf.TensorSpec(shape=(None, None), dtype=tf.float32),\n   327\u2192                    tf.TensorSpec(shape=(None, None), dtype=tf.float32),\n   328\u2192                ]\n   329\u2192            ],\n   330\u2192        )\n   331\u2192        export_archive.write_out(temp_filepath)\n   332\u2192        revived_model = tf.saved_model.load(temp_filepath)\n   333\u2192        self.assertAllClose(ref_output, revived_model.call(ref_input))\n   334\u2192        # Test with a different batch size\n   335\u2192        revived_model.call([tf.random.normal((6, 8)), tf.random.normal((6, 6))])\n   336\u2192        # Test with a different batch size and different dynamic sizes\n   337\u2192        revived_model.call([tf.random.normal((6, 3)), tf.random.normal((6, 5))])\n   338\u2192\n   339\u2192    @pytest.mark.skipif(\n   340\u2192        backend.backend() != \"jax\",\n   341\u2192        reason=\"This test is only for the JAX backend.\",\n   342\u2192    )\n   343\u2192    def test_low_level_model_export_with_jax2tf_kwargs(self):\n   344\u2192        temp_filepath = os.path.join(self.get_temp_dir(), \"exported_model\")\n   345\u2192\n   346\u2192        model = get_model()\n   347\u2192        ref_input = tf.random.normal((3, 10))\n   348\u2192        ref_output = model(ref_input)\n   349\u2192\n   350\u2192        export_archive = export_lib.ExportArchive()\n   351\u2192        export_archive.track(model)\n   352\u2192        export_archive.add_endpoint(\n   353\u2192            \"call\",\n   354\u2192            model.__call__,\n   355\u2192            input_signature=[tf.TensorSpec(shape=(None, 10), dtype=tf.float32)],\n   356\u2192            jax2tf_kwargs={\n   357\u2192                \"native_serialization\": True,\n