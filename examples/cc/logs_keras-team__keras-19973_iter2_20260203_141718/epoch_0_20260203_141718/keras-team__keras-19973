tf.float32)],\n   713\u2192        )\n   714\u2192        export_archive.write_out(temp_filepath)\n   715\u2192        revived_layer = tf.saved_model.load(temp_filepath)\n   716\u2192        self.assertAllClose(ref_output_1, revived_layer.call_1(ref_input_1))\n   717\u2192        self.assertAllClose(ref_output_2, revived_layer.call_2(ref_input_2))\n   718\u2192\n   719\u2192    def test_non_standard_layer_signature(self):\n   720\u2192        temp_filepath = os.path.join(self.get_temp_dir(), \"exported_layer\")\n   721\u2192\n   722\u2192        layer = layers.MultiHeadAttention(2, 2)\n   723\u2192        x1 = tf.random.normal((3, 2, 2))\n   724\u2192        x2 = tf.random.normal((3, 2, 2))\n   725\u2192        ref_output = layer(x1, x2)  # Build layer (important)\n   726\u2192        export_archive = export_lib.ExportArchive()\n   727\u2192        export_archive.track(layer)\n   728\u2192        export_archive.add_endpoint(\n   729\u2192            \"call\",\n   730\u2192            layer.call,\n   731\u2192            input_signature=[\n   732\u2192                tf.TensorSpec(shape=(None, 2, 2), dtype=tf.float32),\n   733\u2192                tf.TensorSpec(shape=(None, 2, 2), dtype=tf.float32),\n   734\u2192            ],\n   735\u2192        )\n   736\u2192        export_archive.write_out(temp_filepath)\n   737\u2192        revived_layer = tf.saved_model.load(temp_filepath)\n   738\u2192        self.assertAllClose(ref_output, revived_layer.call(x1, x2))\n   739\u2192\n   740\u2192    def test_non_standard_layer_signature_with_kwargs(self):\n   741\u2192        temp_filepath = os.path.join(self.get_temp_dir(), \"exported_layer\")\n   742\u2192\n   743\u2192        layer = layers.MultiHeadAttention(2, 2)\n   744\u2192        x1 = tf.random.normal((3, 2, 2))\n   745\u2192        x2 = tf.random.normal((3, 2, 2))\n   746\u2192        ref_output = layer(x1, x2)  # Build layer (important)\n   747\u2192        export_archive = export_lib.ExportArchive()\n   748\u2192        export_archive.track(layer)\n   749\u2192        export_archive.add_endpoint(\n   750\u2192            \"call\",\n   751\u2192            layer.call,\n   752\u2192            input_signature=[\n   753\u2192                tf.TensorSpec(shape=(None, 2, 2), dtype=tf.float32),\n   754\u2192                tf.TensorSpec(shape=(None, 2, 2), dtype=tf.float32),\n   755\u2192            ],\n   756\u2192        )\n   757\u2192        export_archive.write_out(temp_filepath)\n   758\u2192        revived_layer = tf.saved_model.load(temp_filepath)\n   759\u2192        self.assertAllClose(ref_output, revived_layer.call(query=x1, value=x2))\n   760\u2192        # Test with a different batch size\n   761\u2192        revived_layer.call(\n   762\u2192            query=tf.random.normal((6, 2, 2)), value=tf.random.normal((6, 2, 2))\n   763\u2192        )\n   764\u2192\n   765\u2192    def test_variable_collection(self):\n   766\u2192        temp_filepath = os.path.join(self.get_temp_dir(), \"exported_model\")\n   767\u2192\n   768\u2192        model = models.Sequential(\n   769\u2192            [\n   770\u2192                layers.Input((10,)),\n   771\u2192                layers.Dense(2),\n   772\u2192                layers.Dense(2),\n   773\u2192            ]\n   774\u2192        )\n   775\u2192\n   776\u2192        # Test variable tracking\n   777\u2192        export_archive = export_lib.ExportArchive()\n   778\u2192        export_archive.track(model)\n   779\u2192        export_archive.add_endpoint(\n   780\u2192            \"call\",\n   781\u2192            model.__call__,\n   782\u2192            input_signature=[tf.TensorSpec(shape=(None, 10), dtype=tf.float32)],\n   783\u2192        )\n   784\u2192        export_archive.add_variable_collection(\n   785\u2192            \"my_vars\", model.layers[1].weights\n   786\u2192        )\n   787\u2192\n   788\u2192        self.assertLen(export_archive._tf_trackable.my_vars, 2)\n   789\u2192        export_archive.write_out(temp_filepath)\n   790\u2192        revived_model = tf.saved_model.load(temp_filepath)\n   791\u2192        self.assertLen(revived_model.my_vars, 2)\n   792\u2192\n   793\u2192    def test_export_model_errors(self):\n   794\u2192        temp_filepath = os.path.join(self.get_temp_dir(), \"exported_model\")\n   795\u2192\n   796\u2192        # Model has not been built\n   797\u2192        model = models.Sequential([layers.Dense(2)])\n   798\u2192        with self.assertRaisesRegex(ValueError, \"It must be built\"):\n   799\u2192            export_lib.export_model(model, temp_filepath)\n   800\u2192\n   801\u2192        # Subclassed model has not been called\n   802\u2192        model = get_model(\"subclass\")\n   803\u2192        model.build((2, 10))\n   804\u2192        with self.assertRaisesRegex(ValueError, \"It must be called\"):\n   805\u2192            export_lib.export_model(model, temp_filepath)\n   806\u2192\n   807\u2192    def test_export_archive_errors(self):\n   808\u2192        temp_filepath = os.path.join(self.get_temp_dir(), \"exported_model\")\n   809\u2192        model = models.Sequential([layers.Dense(2)])\n   810\u2192        model(tf.random.normal((2, 3)))\n   811\u2192\n   812\u2192        # Endpoint name reuse\n   813\u2192        export_archive = export_lib.ExportArchive()\n   814\u2192        export_archive.track(model)\n   815\u2192        export_archive.add_endpoint(\n   816\u2192            \"call\",\n   817\u2192            model.__call__,\n   818\u2192            input_signature=[tf.TensorSpec(shape=(None, 3), dtype=tf.float32)],\n   819\u2192        )\n   820\u2192        with self.assertRaisesRegex(ValueError, \"already taken\"):\n   821\u2192            export_archive.add_endpoint(\n   822\u2192                \"call\",\n   823\u2192                model.__call__,\n   824\u2192                input_signature=[\n   825\u2192                    tf.TensorSpec(shape=(None, 3), dtype=tf.float32)\n   826\u2192                ],\n   827\u2192            )\n   828\u2192\n   829\u2192        # Write out with no endpoints\n   830\u2192        export_archive = export_lib.ExportArchive()\n   831\u2192        export_archive.track(model)\n   832\u2192        with self.assertRaisesRegex(ValueError, \"No endpoints have been set\"):\n   833\u2192            export_archive.write_out(temp_filepath)\n   834\u2192\n   835\u2192        # Invalid object type\n   836\u2192        with self.assertRaisesRegex(ValueError, \"Invalid resource type\"):\n   837\u2192            export_archive = export_lib.ExportArchive()\n   838\u2192            export_archive.track(\"model\")\n   839\u2192\n   840\u2192        # Set endpoint with no input signature\n   841\u2192        export_archive = export_lib.ExportArchive()\n   842\u2192        export_archive.track(model)\n   843\u2192        with self.assertRaisesRegex(\n   844\u2192            ValueError, \"you must provide an `input_signature`\"\n   845\u2192        ):\n   846\u2192            export_archive.add_endpoint(\"call\", model.__call__)\n   847\u2192\n   848\u2192        # Set endpoint that has never been called\n   849\u2192        export_archive = export_lib.ExportArchive()\n   850\u2192        export_archive.track(model)\n   851\u2192\n   852\u2192        @tf.function()\n   853\u2192        def my_endpoint(x):\n   854\u2192            return model(x)\n   855\u2192\n   856\u2192        export_archive = export_lib.ExportArchive()\n   857\u2192        export_archive.track(model)\n   858\u2192        with self.assertRaisesRegex(\n   859\u2192            ValueError, \"you must either provide a function\"\n   860\u2192        ):\n   861\u2192            export_archive.add_endpoint(\"call\", my_endpoint)\n   862\u2192\n   863\u2192    def test_export_no_assets(self):\n   864\u2192        temp_filepath = os.path.join(self.get_temp_dir(), \"exported_model\")\n   865\u2192\n   866\u2192        # Case where there are legitimately no assets.\n   867\u2192        model = models.Sequential([l