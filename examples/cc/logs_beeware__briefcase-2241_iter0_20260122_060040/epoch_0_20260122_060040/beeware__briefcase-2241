binary_revision\n   470\u2192                except AttributeError:\n   471\u2192                    stub_binary_revision = self.stub_binary_revision(app)\n   472\u2192\n   473\u2192                stub_binary_url = self.stub_binary_url(\n   474\u2192                    stub_binary_revision, app.console_app\n   475\u2192                )\n   476\u2192                custom_stub_binary = False\n   477\u2192                self.console.info(f\"Using stub binary {stub_binary_url}\")\n   478\u2192\n   479\u2192            if stub_binary_url.startswith((\"https://\", \"http://\")):\n   480\u2192                if custom_stub_binary:\n   481\u2192                    # If the support package is custom, cache it using a hash of\n   482\u2192                    # the download URL. This is needed to differentiate to support\n   483\u2192                    # packages with the same filename, served at different URLs.\n   484\u2192                    # (or a custom package that collides with an official package name)\n   485\u2192                    download_path = (\n   486\u2192                        self.data_path\n   487\u2192                        / \"stub\"\n   488\u2192                        / hashlib.sha256(stub_binary_url.encode(\"utf-8\")).hexdigest()\n   489\u2192                    )\n   490\u2192                else:\n   491\u2192                    download_path = self.data_path / \"stub\"\n   492\u2192\n   493\u2192                # Download the stub binary, caching the result\n   494\u2192                # in the user's briefcase stub cache directory.\n   495\u2192                return self.tools.file.download(\n   496\u2192                    url=stub_binary_url,\n   497\u2192                    download_path=download_path,\n   498\u2192                    role=\"stub binary\",\n   499\u2192                )\n   500\u2192            else:\n   501\u2192                return Path(stub_binary_url)\n   502\u2192        except MissingNetworkResourceError as e:\n   503\u2192            # If there is a custom support package, report the missing resource as-is.\n   504\u2192            if custom_stub_binary:\n   505\u2192                raise\n   506\u2192            else:\n   507\u2192                raise MissingStubBinary(\n   508\u2192                    python_version_tag=self.python_version_tag,\n   509\u2192                    platform=self.platform,\n   510\u2192                    host_arch=self.tools.host_arch,\n   511\u2192                    is_32bit=self.tools.is_32bit_python,\n   512\u2192                ) from e\n   513\u2192\n   514\u2192    def _write_requirements_file(\n   515\u2192        self,\n   516\u2192        app: AppConfig,\n   517\u2192        requires: list[str],\n   518\u2192        requirements_path: Path,\n   519\u2192        requirement_installer_args_path: Path | None,\n   520\u2192    ):\n   521\u2192        \"\"\"Configure application requirements by writing a requirements.txt file.\n   522\u2192\n   523\u2192        :param app: The app configuration\n   524\u2192        :param requires: The full list of requirements\n   525\u2192        :param requirements_path: The full path to a requirements.txt file that will be\n   526\u2192            written.\n   527\u2192        :param requirement_installer_args_path: The full path to where newline\n   528\u2192            delimited additional requirement installer argumentss should be written if\n   529\u2192            the template supports it.\n   530\u2192        \"\"\"\n   531\u2192\n   532\u2192        with self.console.wait_bar(\"Writing requirements file...\"):\n   533\u2192            with requirements_path.open(\"w\", encoding=\"utf-8\") as f:\n   534\u2192                # Add timestamp so build systems (such as Gradle) detect a change\n   535\u2192                # in the file and perform a re-installation of all requirements.\n   536\u2192                f.write(f\"# Generated {datetime.now()}\\n\")\n   537\u2192\n   538\u2192                if requires:\n   539\u2192                    for requirement in requires:\n   540\u2192                        # If the requirement is a local path, convert it to\n   541\u2192                        # absolute, because Flatpak moves the requirements file\n   542\u2192                        # to a different place before using it.\n   543\u2192                        if _is_local_path(requirement):\n   544\u2192                            # We use os.path.abspath() rather than Path.resolve()\n   545\u2192                            # because we *don't* want Path's symlink resolving behavior.\n   546\u2192                            requirement = os.path.abspath(self.base_path / requirement)\n   547\u2192                        f.write(f\"{requirement}\\n\")\n   548\u2192\n   549\u2192            if requirement_installer_args_path:\n   550\u2192                pip_args = \"\\n\".join(self._extra_pip_args(app))\n   551\u2192                requirement_installer_args_path.write_text(\n   552\u2192                    f\"{pip_args}\\n\", encoding=\"utf-8\"\n   553\u2192                )\n   554\u2192\n   555\u2192    def _pip_requires(self, app: AppConfig, requires: list[str]):\n   556\u2192        \"\"\"Convert the list of requirements to be passed to pip into its final form.\n   557\u2192\n   558\u2192        :param app: The app configuration\n   559\u2192        :param requires: The user-specified list of app requirements\n   560\u2192        :returns: The final list of requirement arguments to pass to pip\n   561\u2192        \"\"\"\n   562\u2192        return requires\n   563\u2192\n   564\u2192    def _extra_pip_args(self, app: AppConfig):\n   565\u2192        \"\"\"Any additional arguments that must be passed to pip when installing packages.\n   566\u2192\n   567\u2192        :param app: The app configuration\n   568\u2192        :returns: A list of additional arguments\n   569\u2192        \"\"\"\n   570\u2192        args: list[str] = []\n   571\u2192        for argument in app.requirement_installer_args:\n   572\u2192            to_append = argument\n   573\u2192            if relative_path_matcher.match(argument) and _is_local_path(argument):\n   574\u2192                abs_path = os.path.abspath(self.base_path / argument)\n   575\u2192                if Path(abs_path).exists():\n   576\u2192                    to_append = abs_path\n   577\u2192\n   578\u2192            args.append(to_append)\n   579\u2192\n   580\u2192        return args\n   581\u2192\n   582\u2192    def _pip_install(\n   583\u2192        self,\n   584\u2192        app: AppConfig,\n   585\u2192        app_packages_path: Path,\n   586\u2192        pip_args: list[str],\n   587\u2192        install_hint: str = \"\",\n   588\u2192        **pip_kwargs,\n   589\u2192    ):\n   590\u2192        \"\"\"Invoke pip to install a set of requirements.\n   591\u2192\n   592\u2192        :param app: The app configuration\n   593\u2192        :param app_packages_path: The full path of the app_packages folder into which\n   594\u2192            requirements should be installed.\n   595\u2192        :param pip_args: The list of arguments (including the list of requirements to\n   596\u2192            install) to pass to pip. This is in addition to the default arguments that\n   597\u2192            disable pip version checks, forces upgrades, and installs into the nominated\n   598\u2192            ``app_packages`` path.\n   599\u2192        :param install_hint: Additional hint information to provide in the exception\n   600\u2192            message if the pip install call fails.\n   601\u2192        :param pip_kwargs: Any additional keyword arguments to pass to ``subprocess.run``\n   602\u2192            when invoking pip.\n   603\u2192        \"\"\"\n   604\u2192        try:\n   605\u2192            self.tools[app].app_context.run(\n   606\u2192                [\n   607\u2192                    sys.executable,\n   608\u2192                    \"-u\",\n   609\u2192                    \"-X\",\n   610\u2192                    \"utf8\",\n   611\u2192                    \"-m\",\n   612\u2192                    \"pip\",\n   613\u2192                    \"install\",\n   614\u2192                    \"--disable-pip-version-check\",\n   615\u2192                    \"--upgrade\",\n   616\u2192                    \"--no-user\",\n   617\u2192                    f\"--target={app_packages_path}\",\n   618\u2192                ]\n   619\u2192                + ([\"-vv\"] if self.console.is_deep_debug else [])\n   620\u2192                + self._extra_pip_args(app)\n   621\u2192                + pip_args,\n   622\u2192                check=True,\n   623\u2192                encoding=\"UTF-8\",\n   624\u2192                **pip_kwargs,\n   625\u2192            )\n   626\u2192        except subprocess.CalledProcessError as e:\n   627\u2192            raise RequirementsInstallError(install_hint=install_hint) from e\n   628\u2192\n   629\u2192    def _install_app_requirements(\n   630\u2192        self,\n   631\u2192        app: AppConfig,\n   632\u2192        requires: list[str],\n   633\u2192        app_packages_path: Path,\n   634\u2192        progress_message: str = \"Installing app requirements...\",\n   635\u2192        pip_args: list[str] | None = None,\n   636\u2192        pip_kwargs: dict[str, str] | None = None,\n   637\u2192    ):\n   638\u2192        \"\"\"Install requirements for the app with pip.\n   639\u2192\n   640\u2192        :param app: The app configuration\n   641\u2192        :param requires: The list of requirements to install\n   642\u2192        :param app_packages_path: The full path of the app_packages folder into which\n   643\u2192            requirements should be installed.\n   644\u2192        :param progress_message: The waitbar progress message to display to the user.\n   645\u2192        :param pip_args: Any additional command line arguments to use when invoking pip.\n   646\u2192        :param pip_kwargs: Any additional keyword arguments to pass to the subprocess\n   647\u2192            when invoking pip.\n   648\u2192        \"\"\"\n   649\u2192        # Clear existing dependency directory\n   650\u2192        if app_packages_path.is_dir():\n   651\u2192            self.tools.shutil.rmtree(app_packages_path)\n   652\u2192            self.tools.os.mkdir(app_packages_path)\n   653\u2192\n   654\u2192        # Install requirements\n   655\u2192        if requires:\n   656\u2192            with self.console.wait_bar(progress_message):\n   657\u2192                self._pip_install(\n   658\u2192                    app,\n   659\u2192                    app_packages_path=app_packages_path,\n   660\u2192                    pip_args=(\n   661\u2192                        ([] if pip_args is None else pip_args)\n   662\u2192                        + self._pip_requires(app, requires)\n   663\u2192                    ),\n   664\u2192                    **(pip_kwargs if pip_kwargs else {}),\n   665\u2192                )\n   666\u2192        else:\n   667\u2192            self.console.info(\"No application requirements.\")\n   668\u2192\n   669\u2192    def install_app_requirements(self, app: AppConfig, test_mode: bool):\n   670\u2192        \"\"\"Handle requirements for the app.\n   671\u2192\n   672\u2192        This will result in either (in preferential order):\n   673\u2192         * a requirements.txt file being written at a location specified by\n   674\u2192           ``app_requirements_path`` in the template path index\n   675\u2192         * requirements being installed with pip into the location specified\n   676\u2192           by the ``app_packages_path`` in the template path index.\n   677\u2192\n   678\u2192        If ``test_mode`` is True, the test requirements will also be installed.\n   679\u2192\n   680\u2192        If the path index doesn't specify either of the path index entries,\n   681\u2192        an error is raised.\n   682\u2192\n   683\u2192        :param app: The config object for the app\n   684\u2192        :param test_mode: Should the test requirements be installed?\n   685\u2192        \"\"\"\n   686\u2192        requires = app.requires.copy() if app.requires else []\n   687\u2192        if test_mode and app.test_requires:\n   688\u2192            requires.extend(app.test_requires)\n   689\u2192\n   690\u2192        try:\n   691\u2192            requirements_path = self.app_requirements_path(app)\n   692\u2192        except KeyError:\n   693\u2192            requirements_path = None\n   694\u2192\n   695\u2192        try:\n   696\u2192            requirement_installer_args_path = self.app_requirement_installer_args_path(\n   697\u2192                app\n   698\u2192            )\n   699\u2192        except KeyError:\n   700\u2192            requirement_installer_args_path = None\n   701\u2192\n   702\u2192        if requirements_path:\n   703\u2192            self._write_requirements_file(\n   704\u2192                app, requires, requirements_path, requirement_installer_args_path\n   705\u2192            )\n   706\u2192        else:\n   707\u2192            try:\n   708\u2192                app_packages_path = self.app_packages_path(app)\n   709\u2192                self._install_app_requirements(app, requires, app_packages_path)\n   710\u2192            except KeyError as e:\n   711\u2192                raise BriefcaseCommandError(\n   712\u2192                    \"Application path index file does not define \"\n   713\u2192                    \"`app_requirements_path` or `app_packages_path`\"\n   714\u2192                ) from e\n   715\u2192\n   716\u2192    def install_app_code(self, app: AppConfig, test_mode: bool):\n   717\u2192        \"\"\"Install the application code into the bundle.\n   718\u2192\n   719\u2192        :param app: The config object for the app\n   720\u2192        :param test_mode: Should the application test code also be installed?\n   721\u2192        \"\"\"\n   722\u2192        # Remove existing app folder if it exists\n   723\u2192        app_path = self.app_path(app)\n   724\u2192        if app_path.exists():\n   725\u2192            self.tools.shutil.rmtree(app_path)\n   726\u2192        self.tools.os.mkdir(app_path)\n   727\u2192\n   728\u2192        sources = app.sources.copy() if app.sources else []\n   729\u2192        if test_mode and app.test_sources:\n   730\u2192            sources.extend(app.test_sources)\n   731\u2192\n   732\u2192        # Install app code.\n   733\u2192        if sources:\n   734\u2192            for src in sources:\n   735\u2192                with self.console.wait_bar(f\"Installing {src}...\"):\n   736\u2192                    original = self.base_path / src\n   737\u2192                    target = app_path / original.name\n   738\u2192\n   739\u2192                    # Install the new copy of the app code.\n   740\u2192                    if not original.exists():\n   741\u2192                        raise MissingAppSources(src)\n   742\u2192                    elif original.is_dir():\n   743\u2192                        self.tools.shutil.copytree(original, target)\n   744\u2192                    else:\n   745\u2192                        self.tools.shutil.copy(original, target)\n   746\u2192        else:\n   747\u2192            self.console.info(f\"No sources defined for {app.app_name}.\")\n   748\u2192\n   749\u2192        # Write the dist-info folder for the application.\n   750\u2192        write_dist_info(\n   751\u2192            app=app,\n   752\u2192            dist_info_path=self.app_path(app)\n   753\u2192            / f\"{app.module_name}-{app.version}.dist-info\",\n   754\u2192        )\n   755\u2192\n   756\u2192    def install_image(self, role, variant, size, source, target):\n   757\u2192        \"\"\"Install an icon/image of the requested size at a target location, using the\n   758\u2192        source images defined by the app config.\n   759\u2192\n   760\u2192        :param role: A string describing the role the of the image.\n   761\u2192        :param variant: The image variant. A variant of ``None`` means the image\n   762\u2192            has no variants\n   763\u2192        :param size: The requested size for the image. A size of\n   764\u2192            ``None`` means the largest available size should be used.\n   765\u2192        :param source: The image source; or a dictionary of sources for each\n   766\u2192            variant. The sources will *not* include any extension or size\n   767\u2192            modifier; these will be added based on the requested target and\n   768\u2192            variant.\n   769\u2192        :param target: The full path where the image should be installed.\n   770\u2192        \"\"\"\n   771\u2192        if source is not None:\n   772\u2192            if size is None:\n   773\u2192                if variant is None:\n   774\u2192                    source_filename = f\"{source}{target.suffix}\"\n   775\u2192                    full_role = role\n   776\u2192                else:\n   777\u2192                    try:\n   778\u2192                        full_role = f\"{variant} {role}\"\n   779\u2192                        source_filename = f\"{source[variant]}{target.suffix}\"\n   780\u2192                    except TypeError:\n   781\u2192                        source_filename = f\"{source}-{variant}{target.suffix}\"\n   782\u2192                    except KeyError:\n   783\u2192                        self.console.info(\n   784\u2192                            f\"Unknown variant {variant!r} for {role}; using default\"\n   785\u2192                        )\n   786\u2192                        return\n   787\u2192            else:\n   788\u2192                if variant is None:\n   789\u2192                    # An annoying edge case is the case of an unsized variant.\n   790\u2192                    # In that case, `size` is actually the variant, and the\n   791\u2192                    # sou