_app_properties\n   230→        }\n   231→\n   232→        # Remove the context items that describe the template\n   233→        extra_context.pop(\"template\")\n   234→        extra_context.pop(\"template_branch\")\n   235→\n   236→        # Augment with some extra fields.\n   237→        extra_context.update(\n   238→            {\n   239→                # Ensure the output format is in the case we expect\n   240→                \"format\": self.output_format.lower(),\n   241→                # Properties of the generating environment\n   242→                # The full Python version string, including minor and dev/a/b/c suffixes (e.g., 3.11.0rc2)\n   243→                \"python_version\": platform.python_version(),\n   244→                # The host architecture\n   245→                \"host_arch\": self.tools.host_arch,\n   246→                # Transformations of explicit properties into useful forms\n   247→                \"class_name\": app.class_name,\n   248→                \"module_name\": app.module_name,\n   249→                \"package_name\": app.package_name,\n   250→                \"bundle_identifier\": app.bundle_identifier,\n   251→                # Properties that are a function of the execution\n   252→                \"year\": date.today().strftime(\"%Y\"),\n   253→                \"month\": date.today().strftime(\"%B\"),\n   254→            }\n   255→        )\n   256→\n   257→        # Add in any extra template context to support permissions\n   258→        extra_context.update(self.permissions_context(app, self._x_permissions(app)))\n   259→\n   260→        # Add in any extra template context required by the output format.\n   261→        extra_context.update(self.output_format_template_context(app))\n   262→\n   263→        # Create the platform directory (if it doesn't already exist)\n   264→        output_path = self.bundle_path(app).parent\n   265→        output_path.mkdir(parents=True, exist_ok=True)\n   266→\n   267→        self.generate_template(\n   268→            template=app.template if app.template else self.app_template_url,\n   269→            branch=app.template_branch,\n   270→            output_path=output_path,\n   271→            extra_context=extra_context,\n   272→        )\n   273→\n   274→    def _unpack_support_package(self, support_file_path, support_path):\n   275→        \"\"\"Unpack a support package into a specific location.\n   276→\n   277→        :param support_file_path: The path to the support file to be unpacked.\n   278→        :param support_path: The path where support files should be unpacked.\n   279→        \"\"\"\n   280→        try:\n   281→            with self.console.wait_bar(\"Unpacking support package...\"):\n   282→                support_path.mkdir(parents=True, exist_ok=True)\n   283→                self.tools.file.unpack_archive(\n   284→                    support_file_path,\n   285→                    extract_dir=support_path,\n   286→                )\n   287→        except (shutil.ReadError, EOFError) as e:\n   288→            raise InvalidSupportPackage(support_file_path) from e\n   289→\n   290→    def _cleanup_app_support_package(self, support_path):\n   291→        \"\"\"The internal implementation of the app support cleanup method.\n   292→\n   293→        Guaranteed to only be invoked if the backend uses a support package, and the\n   294→        support path exists.\n   295→\n   296→        :param support_path: The support path to clean up.\n   297→        \"\"\"\n   298→        with self.console.wait_bar(\"Removing existing support package...\"):\n   299→            self.tools.shutil.rmtree(support_path)\n   300→\n   301→    def cleanup_app_support_package(self, app: AppConfig):\n   302→        \"\"\"Clean up an existing application support package.\n   303→\n   304→        :param app: The config object for the app\n   305→        \"\"\"\n   306→        try:\n   307→            support_path = self.support_path(app)\n   308→        except KeyError:\n   309→            # No cleanup required.\n   310→            pass\n   311→        else:\n   312→            if support_path.exists():\n   313→                self._cleanup_app_support_package(support_path)\n   314→\n   315→    def install_app_support_package(self, app: AppConfig):\n   316→        \"\"\"Install the application support package.\n   317→\n   318→        :param app: The config object for the app\n   319→        \"\"\"\n   320→        try:\n   321→            support_path = self.support_path(app)\n   322→        except KeyError:\n   323→            self.console.info(\"No support package required.\")\n   324→        else:\n   325→            support_file_path = self._download_support_package(app)\n   326→            self._unpack_support_package(support_file_path, support_path)\n   327→\n   328→    def _download_support_package(self, app: AppConfig):\n   329→        try:\n   330→            # Work out if the app defines a custom override for\n   331→            # the support package URL.\n   332→            try:\n   333→                support_package_url = app.support_package\n   334→                custom_support_package = True\n   335→                self.console.info(f\"Using custom support package {support_package_url}\")\n   336→                try:\n   337→                    # If the app has a custom support package *and* a support revision,\n   338→                    # that's an error.\n   339→                    app.support_revision\n   340→                    self.console.warning(\n   341→                        \"App specifies both a support package and a support revision; \"\n   342→                        \"support revision will be ignored.\"\n   343→                    )\n   344→                except AttributeError:\n   345→                    pass\n   346→            except AttributeError:\n   347→                # If the app specifies a support revision, use it;\n   348→                # otherwise, use the support revision named by the template\n   349→                try:\n   350→                    support_revision = app.support_revision\n   351→                except AttributeError:\n   352→                    # No support revision specified; use the template-specified version\n   353→                    try:\n   354→                        support_revision = self.support_revision(app)\n   355→                    except KeyError:\n   356→                        # No template-specified support revision\n   357→                        raise MissingSupportPackage(\n   358→                            python_version_tag=self.python_version_tag,\n   359→                            platform=self.platform,\n   360→                            host_arch=self.tools.host_arch,\n   361→                            is_32bit=self.tools.is_32bit_python,\n   362→                        )\n   363→\n   364→                support_package_url = self.support_package_url(support_revision)\n   365→                custom_support_package = False\n   366→                self.console.info(f\"Using support package {support_package_url}\")\n   367→\n   368→            if support_package_url.startswith((\"https://\", \"http://\")):\n   369→                if custom_support_package:\n   370→                    # If the support package is custom, cache it using a hash of\n   371→                    # the download URL. This is needed to differentiate to support\n   372→                    # packages with the same filename, served at different URLs.\n   373→                    # (or a custom package that collides with an official package name)\n   374→                    download_path = (\n   375→                        self.data_path\n   376→                        / \"support\"\n   377→                        / hashlib.sha256(\n   378→                            support_package_url.encode(\"utf-8\")\n   379→                        ).hexdigest()\n   380→                    )\n   381→                else:\n   382→                    download_path = self.data_path / \"support\"\n   383→\n   384→                # Download the support file, caching the result\n   385→                # in the user's briefcase support cache directory.\n   386→                return self.tools.file.download(\n   387→                    url=support_package_url,\n   388→                    download_path=download_path,\n   389→                    role=\"support package\",\n   390→                )\n   391→            else:\n   392→                return Path(support_package_url)\n   393→        except MissingNetworkResourceError as e:\n   394→            # If there is a custom support package, report the missing resource as-is.\n   395→            if custom_support_package:\n   396→                raise\n   397→            else:\n   398→                raise MissingSupportPackage(\n   399→                    python_version_tag=self.python_version_tag,\n   400→                    platform=self.platform,\n   401→                    host_arch=self.tools.host_arch,\n   402→                    is_32bit=self.tools.is_32bit_python,\n   403→                ) from e\n   404→\n   405→    def cleanup_stub_binary(self, app: AppConfig):\n   406→        \"\"\"Clean up an existing application support package.\n   407→\n   408→        :param app: The config object for the app\n   409→        \"\"\"\n   410→        with self.console.wait_bar(\"Removing existing stub binary...\"):\n   411→            self.binary_executable_path(app).unlink(missing_ok=True)\n   412→            self.unbuilt_executable_path(app).unlink(missing_ok=True)\n   413→\n   414→    def install_stub_binary(self, app: AppConfig):\n   415→        \"\"\"Install the application stub binary into the \"unbuilt\" location.\n   416→\n   417→        :param app: The config object for the app\n   418→        \"\"\"\n   419→        unbuilt_executable_path = self.unbuilt_executable_path(app)\n   420→        stub_binary_path = self._download_stub_binary(app)\n   421→\n   422→        with self.console.wait_bar(\"Installing stub binary...\"):\n   423→            # Ensure the folder for the stub binary exists\n   424→            unbuilt_executable_path.parent.mkdir(exist_ok=True, parents=True)\n   425→\n   426→            # Install the stub binary into the unbuilt location.\n   427→            # Allow for both raw and compressed artefacts.\n   428→            try:\n   429→                if self.tools.file.is_archive(stub_binary_path):\n   430→                    self.tools.file.unpack_archive(\n   431→                        stub_binary_path,\n   432→                        extract_dir=unbuilt_executable_path.parent,\n   433→                    )\n   434→                elif stub_binary_path.is_file():\n   435→                    self.tools.shutil.copyfile(\n   436→                        stub_binary_path, unbuilt_executable_path\n   437→                    )\n   438→                else:\n   439→                    raise InvalidStubBinary(stub_binary_path)\n   440→            except (shutil.ReadError, EOFError, OSError) as e:\n   441→                raise InvalidStubBinary(stub_binary_path) from e\n   442→            else:\n   443→                # Ensure the binary is executable\n   444→                self.tools.os.chmod(unbuilt_executable_path, 0o755)\n   445→\n   446→    def _download_stub_binary(self, app: AppConfig) -> Path:\n   447→        try:\n   448→            # Work out if the app defines a custom override for\n   449→            # the support package URL.\n   450→            try:\n   451→                stub_binary_url = app.stub_binary\n   452→                custom_stub_binary = True\n   453→                self.console.info(f\"Using custom stub binary {stub_binary_url}\")\n   454→                try:\n   455→                    # If the app has a custom stub binary *and* a support revision,\n   456→                    # that's an error.\n   457→                    app.stub_binary_revision\n   458→                    self.console.warning(\n   459→                        \"App specifies both a stub binary and a stub binary revision; \"\n   460→                        \"stub binary revision will be ignored.\"\n   461→                    )\n   462→                except AttributeError:\n   463→                    pass\n   464→            except AttributeError:\n   465→                # If the app specifies a support revision, use it; otherwise, use the\n   466→                # support revision named by the template. This value *must* exist, as\n   467→                # stub binary handling won't be triggered at all unless it is present.\n   468→                try:\n   469→                    stub_binary_revision = app.stub_binary_revision\n   470→                except AttributeError:\n   471→                    stub_binary_revision = self.stub_binary_revision(app)\n   472→\n   473→                stub_binary_url = self.stub_binary_url(\n   474→                    stub_binary_revision, app.console_app\n   475→                )\n   476→                custom_stub_binary = False\n   477→                self.console.info(f\"Using stub binary {stub_binary_url}\")\n   478→\n   479→            if stub_binary_url.startswith((\"https://\", \"http://\")):\n   480→                if custom_stub_binary:\n   481→                    # If the support package is custom, cache it using a hash of\n   482→                    # the download URL. This is needed to differentiate to support\n   483→                    # packages with the same filename, served at different URLs.\n   484→                    # (or a custom package that collides with an official package name)\n   485→                    download_path = (\n   486→                        self.data_path\n   487→                        / \"stub\"\n   488→                        / hashlib.sha256(stub_binary_url.encode(\"utf-8\")).hexdigest()\n   489→                    )\n   490→                else:\n   491→                    download_path = self.data_path / \"stub\"\n   492→\n   493→                # Download the stub binary, caching the result\n   494→                # in the user's briefcase stub cache directory.\n   495→                return self.tools.file.download(\n   496→                    url=stub_binary_url,\n   497→                    download_path=download_path,\n   498→                    role=\"stub binary\",\n   499→                )\n   500→            else:\n   501→                return Path(stub_binary_url)\n   502→        except MissingNetworkResourceError as e:\n   503→            # If there is a custom support package, report the missing resource as-is.\n   504→            if custom_stub_binary:\n   505→                raise\n   506→            else:\n   507→                raise MissingStubBinary(\n   508→                    python_version_tag=self.python_version_tag,\n   509→                    platform=self.platform,\n   510→                    host_arch=self.tools.host_arch,\n   511→                    is_32bit=self.tools.is_32bit_python,\n   512→                ) from e\n   513→\n   514→    def _write_requirements_file(\n   515→        self,\n   516→        app: AppConfig,\n   517→        requires: list[str],\n   518→        requirements_path: Path,\n   519→        requirement_installer_args_path: Path | None,\n   520→    ):\n   521→        \"\"\"Configure application requirements by writing a requirements.txt file.\n   522→\n   523→        :param app: The app configuration\n   524→        :param requires: The full list of requirements\n   525→        :param requirements_path: The full path to a requirements.txt file that will be\n   526→            written.\n   527→        :param requirement_installer_args_path: The full path to where newline\n   528→            delimited additional requirement installer argumentss should be written if\n   529→            the template supports it.\n   530→        \"\"\"\n   531→\n   532→        with self.console.wait_bar(\"Writing requirements file...\"):\n   533→            with requirements_path.open(\"w\", encoding=\"utf-8\") as f:\n   534→                # Add timestamp so build systems (such as Gradle) detect a change\n   535→                # in the file and perform a re-installation of all requirements.\n   536→                f.write(f\"# Generated {datetime.now()}\\n\")\n   537→\n   538→                if requires:\n   539→                    for requirement in requires:\n   540→                        # If the requirement is a local path, convert it to\n   541→                        # absolute, because Flatpak moves the requirements file\n   542→                        # to a different place before using it.\n   543→                        if _is_local_path(requirement):\n   544→                            # We use os.path.abspath() rather than Path.resolve()\n   545→                            # because we *don't* want Path's symlink resolving behavior.\n   546→                            requirement = os.path.abspath(self.base_path / requirement)\n   547→                        f.write(f\"{requirement}\\n\")\n   548→\n   549→            if requirement_installer_args_path:\n   550→                pip_args = \"\\n\".join(self._extra_pip_args(app))\n   551→                requirement_installer_args_path.write_text(\n   552→                    f\"{pip_args}\\n\", encoding=\"utf-8\"\n   553→                )\n   554→\n   555→    def _pip_requires(self, app: AppConfig, requires: list[str]):\n   556→        \"\"\"Convert the list of requirements to be passed to pip into its final form.\n   557→\n   558→        :param app: The app configuration\n   559→        :param requires: The user-specified list of app requirements\n   560→        :returns: The final list of requirement arguments to pass to pip\n   561→        \"\"\"\n   562→        return requires\n   563→\n   564→    def _extra_pip_args(self, app: AppConfig):\n   565→        \"\"\"Any additional arguments that must be passed to pip when installing packages.\n   566→\n   567→        :param app: The app configuration\n   568→        :returns: A list of additional arguments\n   569→        \"\"\"\n   570→        args: list[str] = []\n   571→        for argument in app.requirement_installer_args:\n   572→            to_append = argument\n   573→            if relative_path_matcher.match(argument) and _is_local_path(argument):\n   574→                abs_path = os.path.abspath(self.base_path / argument)\n   575→                if Path(abs_path).exists():\n   576→                    to_append = abs_path\n   577→\n   578→            args.append(to_append)\n   579→\n   580→        return args\n   581→\n   582→    def _pip_install(\n   583→        self,\n   584→        app: AppConfig,\n   585→        app_packages_path: Path,\n   586→        pip_args: list[str],\n   587→        install_hint: str = \"\",\n   588→        **pip_kwargs,\n   589→    ):\n   590→        \"\"\"Invoke pip to install a set of requirements.\n   591→\n   592→        :param app: The app configuration\n   593→        :param app_packages_path: The full path of the app_packages folder into which\n   594→            requirements should be installed.\n   595→        :param pip_args: The list of arguments (including the list of requirements to\n   596→            install) to pass to pip. This is in addition to the default arguments that\n   597→            disable pip version checks, forces upgrades, and installs into the nominated\n   598→            ``app_packages`` path.\n   599→        :param install_hint: Additional hint information to provide in the exception\n   600→            message if the pip install call fails.\n   601→        :param pip_kwargs: Any additional keyword arguments to pass to ``subprocess.run``\n   602→            when invoking pip.\n   603→        \"\"\"\n   604→        try:\n   605→            self.tools[app].app_context.run(\n   606→                [\n   607→                    sys.executable,\n   608→                    \"-u\",\n   609→                    \"-X\",\n   610→                    \"utf8\",\n   611→                    \"-m\",\n   612→                    \"pip\",\n   613→                    \"install\",\n   614→                    \"--disable-pip-version-check\",\n   615→                    \"--upgrade\",\n   616→                    \"--no-user\",\n   617→                    f\"--target={app_packages_path}\",\n   618→                ]\n   619→                + ([\"-vv\"] if self.console.is_deep_debug else [])\n   620→                + self._extra_pip_args(app)\n   621→                + pip_args,\n   622→                check=True,\n   623→                encoding=\"UTF-8\",\n   624→                **pip_kwargs,\n   625→            )\n   626→        except subprocess.CalledProcessError as e:\n   627→            raise RequirementsInstallError(install_hint=install_hint) from e\n   628→\n   629→    def _install_app_requirements(\n   630→        self,\n   631→        app: AppConfig,\n   632→        requires: list[str],\n   633→        app_packages_path: Path,\n   634→        progress_message: str = \"Installing app requirements...\",\n   635→        pip_args: list[str] | None = None,\n   636→        pip_kwargs: dict[str, str] | None = None,\n   637→    ):\n   638→        \"\"\"Install requirements for the app with pip.\n   639→\n   640→        :param app: The app configuration\n   641→        :param requires: The list of requirements to install\n   642→        :param app_packages_path: The full path of the app_packages folder into which\n   643→            requirements should be installed.\n   644→        :param progress_message: The waitbar progress message to display to the user.\n   645→        :param pip_args: Any additional command line arguments to use when invoking pip.\n   646→        :param pip_kwargs: Any additional keyword arguments to pass to the subprocess\n   647→            when invoking pip.\n   648→        \"\"\"\n   649→        # Clear existing dependency directory\n   650→        if app_packages_path.is_dir():\n   651→            self.tools.shutil.rmtree(app_packages_path)\n   652→            self.tools.os.mkdir(app_packages_path)\n   653→\n   654→        # Install requirements\n   655→        if requires:\n   656→            with self.console.wait_bar(progress_message):\n   657→                self._pip_install(\n   658→                    app,\n   659→                    app_packages_path=app_packages_path,\n   660→                    pip_args=(\n   661→                        ([] if pip_args is None else pip_args)\n   662→                        + self._pip_requires(app, requires)\n   663→                    ),\n   664→                    **(pip_kwargs if pip_kwargs else {}),\n   665→                )\n   666→        else:\n   667→            self.console.info(\"No application requirements.\")\n   668→\n   669→    def install_app_requirements(self, app: AppConfig, test_mode: bool):\n   670→        \"\"\"Handle requirements for the app.\n   671→\n   672→        This will result in either (in preferential order):\n   673→         * a requirements.txt file being written at a location specified by\n   674→           ``app_requirements_path`` in the template path index\n   675→         * requirements being installed with pip into the location specified\n   676→           by the ``app_packages_path`` in the template path index.\n   677→\n   678→        If ``test_mode`` is True, the test requirements will also be installed.\n   679→\n   680→        If the path index doesn't specify either of the path index entries,\n   681→        an error is raised.\n   682→\n   683→        :param app: The config object for the app\n   684→        :param test_mode: Should the test requirements be installed?\n   685→        \"\"\"\n   686→        requires = app.requires.copy() if app.requires else []\n   687→        if test_mode and app.test_requires:\n   688→            requires.extend(app.test_requires)\n   689→\n   690→        try:\n   691→            requirements_path = self.app_requirements_path(app)\n   692→        except KeyError:\n   693→            requirements_path = None\n   694→\n   695→        try:\n   696→            requirement_installer_args_path = self.app_requirement_installer_args_path(\n   697→                app\n   698→            )\n   699→        except KeyError:\n   700→            requirement_installer_args_path = None\n   701→\n   702→        if requirements_path:\n   703→            self._write_requirements_file(\n   704→                app, requires, requirements_path, requirement_installer_args_path\n   705→            )\n   706→        else:\n   707→            try:\n   708→                app_packages_path = self.app_packages_path(app)\n   709→                self._install_app_requirements(app, requires, app_packages_path)\n   710→            except KeyError as e:\n   711→                raise BriefcaseCommandError(\n   712→                    \"Application path index file does not define \"\n   713→                    \"`app_requirements_path` or `app_packages_path`\"\n   714→                ) from e\n   715→\n   716→    def install_app_code(self, app: AppConfig, test_mode: bool):\n   717→        \"\"\"Install the application code into the bundle.\n   718→\n   719→        :param app: The config object for the app\n   720→        :param test_mode: Should the application test code also be installed?\n   721→        \"\"\"\n   722→        # Remove existing app folder if it exists\n   723→        app_path = self.app_path(app)\n   724→        if app_path.exists():\n   725→            self.tools.shutil.rmtree(app_path)\n   726→        self.tools.os.mkdir(app_path)\n   727→\n   728→        sources = app.sources.copy() if app.sources else []\n   729→        if test_mode and app.test_sources:\n   730→            sources.extend(app.test_sources)\n   731→\n   732→        # Install app code.\n   733→        if sources:\n   734→            for src in sources:\n   735→ 