490→                \"--platform\",\n   491→                \"macosx_13_2_arm64\",\n   492→                \"first\",\n   493→                \"second==1.2.3\",\n   494→                \"third>=3.2.1\",\n   495→            ],\n   496→            check=True,\n   497→            encoding=\"UTF-8\",\n   498→        ),\n   499→        # Second call installs the binary packages for the other architecture.\n   500→        mock.call(\n   501→            [\n   502→                sys.executable,\n   503→                \"-u\",\n   504→                \"-X\",\n   505→                \"utf8\",\n   506→                \"-m\",\n   507→                \"pip\",\n   508→                \"install\",\n   509→                \"--disable-pip-version-check\",\n   510→                \"--upgrade\",\n   511→                \"--no-user\",\n   512→                f\"--target={bundle_path / 'app_packages.x86_64'}\",\n   513→                \"--no-deps\",\n   514→                \"--platform\",\n   515→                \"macosx_13_2_x86_64\",\n   516→                \"--only-binary\",\n   517→                \":all:\",\n   518→                \"second==1.2.3\",\n   519→                \"third==3.4.5\",\n   520→            ],\n   521→            check=True,\n   522→            encoding=\"UTF-8\",\n   523→        ),\n   524→    ]\n   525→\n   526→    # The app packages folder has been created. The existence of the target and host\n   527→    # versions is validated as a result of the underlying install/merge methods.\n   528→    assert (bundle_path / \"app_packages.x86_64\").is_dir()\n   529→\n   530→    # An attempt was made thin the \"other\" arch packages.\n   531→    create_command.thin_app_packages.assert_called_once_with(\n   532→        bundle_path / \"app_packages.x86_64\",\n   533→        arch=\"x86_64\",\n   534→    )\n   535→\n   536→    # An attempt was made to merge packages.\n   537→    create_command.merge_app_packages.assert_called_once_with(\n   538→        target_app_packages=bundle_path\n   539→        / \"First App.app\"\n   540→        / \"Contents\"\n   541→        / \"Resources\"\n   542→        / \"app_packages\",\n   543→        sources=[\n   544→            bundle_path / \"app_packages.arm64\",\n   545→            bundle_path / \"app_packages.x86_64\",\n   546→        ],\n   547→    )\n   548→\n   549→\n   550→def test_invalid_min_os_version(create_command, first_app_templated):\n   551→    \"\"\"If the app defines a min OS version that is incompatible with the support\n   552→    package, an error is raised.\"\"\"\n   553→    first_app_templated.requires = [\"first\", \"second==1.2.3\", \"third>=3.2.1\"]\n   554→\n   555→    # Set a min OS version that is incompatible with the support package.\n   556→    first_app_templated.min_os_version = \"10.6\"\n   557→\n   558→    with pytest.raises(\n   559→        BriefcaseCommandError,\n   560→        match=(\n   561→            r\"Your macOS app specifies a minimum macOS version of 10.6, \"\n   562→            r\"but the support package only supports 10.12\"\n   563→        ),\n   564→    ):\n   565→        create_command.install_app_requirements(first_app_templated, test_mode=False)\n   566→\n   567→    # No request was made to install requirements\n   568→    create_command.tools[first_app_templated].app_context.run.assert_not_called()\n   569→\n   570→\n   571→@pytest.mark.parametrize(\n   572→    \"host_arch, other_arch\",\n   573→    [\n   574→        (\"arm64\", \"x86_64\"),\n   575→        (\"arm64\", \"x86_64\"),\n   576→    ],\n   577→)\n   578→def test_install_app_packages_no_binary(\n   579→    create_command,\n   580→    first_app_templated,\n   581→    tmp_path,\n   582→    host_arch,\n   583→    other_arch,\n   584→):\n   585→    \"\"\"If there's no binaries in the first pass, the second pass isn't performed.\"\"\"\n   586→    bundle_path = tmp_path / \"base_path/build/first-app/macos/app\"\n   587→\n   588→    # Create pre-existing other-arch content\n   589→    create_