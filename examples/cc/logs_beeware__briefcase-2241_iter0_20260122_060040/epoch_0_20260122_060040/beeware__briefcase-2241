n_targets\n   153\u2192\n   154\u2192    def document_type_icon_targets(self, app: AppConfig):\n   155\u2192        \"\"\"Obtain the dictionary of document type icon targets that the template\n   156\u2192        requires.\n   157\u2192\n   158\u2192        :param app: The config object for the app\n   159\u2192        :return: A dictionary of document types, with the values being dictionaries\n   160\u2192            describing the icon sizes that the template supports. The inner dictionary\n   161\u2192            describes the path fragments (relative to the bundle path) for the images\n   162\u2192            that are required; the keys are the size of the splash images.\n   163\u2192        \"\"\"\n   164\u2192        # If the template specifies no document types, return an empty dictionary.\n   165\u2192        # Then, for each document type; If the template specifies a single icon\n   166\u2192        #   without a size specification, return a dictionary with a single\n   167\u2192        #   ``None`` key. Otherwise, return the full size-keyed dictionary.\n   168\u2192        try:\n   169\u2192            icon_targets = self.path_index(app, \"document_type_icon\")\n   170\u2192            return {\n   171\u2192                extension: {None: targets} if isinstance(targets, str) else targets\n   172\u2192                for extension, targets in icon_targets.items()\n   173\u2192            }\n   174\u2192\n   175\u2192        except KeyError:\n   176\u2192            return {}\n   177\u2192\n   178\u2192    def _x_permissions(self, app: AppConfig):\n   179\u2192        \"\"\"Extract the known cross-platform permission definitions from the app's\n   180\u2192        permissions definitions.\n   181\u2192\n   182\u2192        After calling this method, the ``permissions`` declaration for the app will\n   183\u2192        only contain keys that are *not* cross-platform keys.\n   184\u2192\n   185\u2192        :param app: The config object for the app\n   186\u