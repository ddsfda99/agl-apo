           \"second==1.2.3\",\n   633→                \"third>=3.2.1\",\n   634→            ],\n   635→            check=True,\n   636→            encoding=\"UTF-8\",\n   637→        ),\n   638→    ]\n   639→\n   640→    # The app packages folder for the other architecture has been created, even though\n   641→    # it isn't needed. The existence of the target and host versions is validated as a\n   642→    # result of the underlying install/merge methods.\n   643→    assert (bundle_path / f\"app_packages.{other_arch}\").is_dir()\n   644→\n   645→    # We still need to thin and merge the app packages; this is effectively just a copy.\n   646→    create_command.thin_app_packages.assert_called_once_with(\n   647→        bundle_path / f\"app_packages.{other_arch}\",\n   648→        arch=other_arch,\n   649→    )\n   650→    create_command.merge_app_packages.assert_called_once_with(\n   651→        target_app_packages=bundle_path\n   652→        / \"First App.app\"\n   653→        / \"Contents\"\n   654→        / \"Resources\"\n   655→        / \"app_packages\",\n   656→        sources=[\n   657→            bundle_path / f\"app_packages.{host_arch}\",\n   658→            bundle_path / f\"app_packages.{other_arch}\",\n   659→        ],\n   660→    )\n   661→\n   662→\n   663→def test_install_app_packages_failure(create_command, first_app_templated, tmp_path):\n   664→    \"\"\"If the install of other-arch binaries fails, an exception is raised.\"\"\"\n   665→    bundle_path = tmp_path / \"base_path/build/first-app/macos/app\"\n   666→\n   667→    # Create pre-existing other-arch content\n   668→    create_installed_package(bundle_path / \"app_packages.x86_64\", \"legacy\")\n   669→\n   670→    create_command.tools.host_arch = \"arm64\"\n   671→    first_app_templated.requires = [\"first\", \"second==1.2.3\", \"third>=3.2.1\"]\n   672→\n   673→    # Mock the result of finding the binary packages - 2 of the packages are binary;\n   674→    # the version on the loosely specified package doesn't match the lower bound.\n   675→    create_command.find_binary_packages = mock.Mock(\n   676→        return_value=[\n   677→            (\"second\", \"1.2.3\"),\n   678→            (\"third\", \"3.4.5\"),\n   679→        ]\n   680→    )\n   681→\n   682→    # Mock the thin command so we can confirm it was invoked.\n   683→    create_command.thin_app_packages = mock.Mock()\n   684→\n   685→    # Mock the merge command so we can confirm it was invoked.\n   686→    create_command.merge_app_packages = mock.Mock()\n   687→\n   688→    # Mock a failure on the second install\n   689→    create_command.tools[first_app_templated].app_context.run.side_effect = [\n   690→        None,\n   691→        subprocess.CalledProcessError(returncode=1, cmd=\"pip\"),\n   692→    ]\n   693→\n   694→    # Install the requirements; this will raise an error\n   695→    with pytest.raises(\n   696→        BriefcaseCommandError,\n   697→        match=(\n   698→            r\"Unable to install requirements\\. This may be because one of your\\n\"\n   699→            r\"requirements is invalid, or because pip was unable to connect\\n\"\n   700→            r\"to the PyPI server.\\n\"\n   701→        ),\n   702→    ):\n   703→        create_command.install_app_requirements(first_app_templated, test_mode=False)\n   704→\n   705→    # We looked for binary packages in the host app_packages\n   706→    create_command.find_binary_packages.assert_called_once_with(\n   707→        bundle_path / \"app_packages.arm64\",\n   708→        universal_suffix=\"_universal2\",\n   709→    )\n   710→\n   711→    # A request was made to install requirements\n   712→    assert create_command.tools[first_app_templated].app_context.run.mock_calls == [\n   713→        # First call is to install the initial packages on the host arch\n   714→        mock.call(\n   715→            [\n   716→                sys.executable,\n   717→                \"-u\",\n   718→                \"-X\",\n   719→         