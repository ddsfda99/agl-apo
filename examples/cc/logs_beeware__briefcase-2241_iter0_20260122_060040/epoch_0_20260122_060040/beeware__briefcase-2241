specified\n   797→        parser.add_argument(\n   798→            \"--no-notarize\",\n   799→            dest=\"notarize_app\",\n   800→            action=\"store_const\",\n   801→            const=False,\n   802→            help=\"Disable notarization for the app\",\n   803→        )\n   804→        parser.add_argument(\n   805→            \"--resume\",\n   806→            dest=\"submission_id\",\n   807→            help=\"The notarization submission ID to resume\",\n   808→            required=False,\n   809→        )\n   810→\n   811→    def verify_tools(self):\n   812→        # Require the Xcode command line tools.\n   813→        XcodeCliTools.verify(tools=self.tools)\n   814→\n   815→        # Verify superclass tools *after* xcode. This ensures we get the\n   816→        # git check *after* the xcode check.\n   817→        super().verify_tools()\n   818→\n   819→    def __init__(self, *args, **kwargs):\n   820→        super().__init__(*args, **kwargs)\n   821→\n   822→        # External service APIs.\n   823→        # These are abstracted to enable testing without patching.\n   824→        self.dmgbuild = dmgbuild\n   825→\n   826→    def verify_app(self, app):\n   827→        super().verify_app(app)\n   828→\n   829→        if app.console_app:\n   830→            if app.packaging_format is None:\n   831→                app.packaging_format = \"pkg\"\n   832→            elif app.packaging_format != \"pkg\":\n   833→                raise BriefcaseCommandError(\n   834→                    \"macOS console apps must be distributed in PKG format.\"\n   835→                )\n   836→        elif app.packaging_format is None:\n   837→            app.packaging_format = \"dmg\"\n   838→\n   839→    def clean_dist_folder(self, app, **options):\n   840→        \"\"\"Clean up any existing artefacts in the dist folder.\n   841→\n   842→        If we are resuming a notarization session verify that the artefact exists,\n   843→        but *do not* delete it.\n   844→\n   845→        :param app: The app being packaged.\n   846→        :param submission_id: The notarization submission being resumed.\n   847→        :param options: Any additional arguments passed to the package command.\n   848→        \"\"\"\n   849→        if options.get(\"submission_id\"):\n   850→            if not self.notarization_path(app).exists():\n   851→                raise BriefcaseCommandError(\n   852→                    \"Notarization cannot be resumed, as the notarization artefact \"\n   853→                    \"associated with this app \"\n   854→                    f\"({self.notarization_path(app).relative_to(self.base_path)}) \"\n   855→                    \"does not exist.\"\n   856→                )\n   857→\n   858→            # If the packaging format is zip, the distribution artefact is created\n   859→            # *after* completion of notarization. If there's an existing distribution\n   860→            # artefact, it must be from a previous notarization/stapling attempt.\n   861→            if app.packaging_format == \"zip\":\n   862→                super().clean_dist_folder(app, **options)\n   863→        else:\n   864→            super().clean_dist_folder(app, **options)\n   865→\n   866→    def ditto_archive(\n   867→        self,\n   868→        app_filename: Path,\n   869→        archive_filename: Path,\n   870→    ):  # pragma: no-cover-if-not-macos\n   871→        \"\"\"Create an archive of an app using ditto.\n   872→\n   873→        Although the archive format is \".zip\", we can't use standard Zip tools, as they\n   874→        don't preserve UTF-8 encoding on all resources. Instead, we need to use `ditto`,\n   875→        which is provided as part of macOS developer tooling. See\n   876→        https://forums.developer.apple.com/forums/thread/116831 and\n   877→        https://developer.apple.com/library/archive/technotes/tn2206/_index.html for\n   878→        more details.\n   879→\n   880→        :param app_filename: The filename of the app to archive\n   881→        :param archive_filename: The filename of the archive to produce\n   882→        \"\"\"\n   883→        try:\n   884→            self.tools.subprocess.run(\n   885→                [\n   886→                    \"/usr/bin/ditto\",\n   887→                    \"-c\",\n   888→                    \"-k\",\n   889→                    \"--sequesterRsrc\",\n   890→                    \"--keepParent\",\n   891→                    app_filename,\n   892→                    archive_filename,\n   893→                ],\n   894→                check=True,\n   895→            )\n   896→        except subprocess.CalledProcessError as e:\n   897→            raise BriefcaseCommandError(f\"Unable to archive {app_filename.name}\") from e\n   898→\n   899→    def notarize(\n   900→        self,\n   901→        app: AppConfig,\n   902→        identity: SigningIdentity,\n   903→        installer_identity: SigningIdentity | None = None,\n   904→    ):\n   905→        \"\"\"Submit a file for notarization, and wait for that notarization to be completed.\n   906→\n   907→        :param app: The app to notarize.\n   908→        :param identity: The code signing used to notarize the app.\n   909→        :param installer_identity: The signing identity to use when signing the\n   910→            installer. Optional unless the packaging format is ``pkg``.\n   911→        \"\"\"\n   912→        # Determine the arguments that would be needed to reproduce this notarization\n   913→        if installer_identity:\n   914→            identity_args = (\n   915→                f\"--identity {identity.id} \"\n   916→                f\"--installer-identity {installer_identity.id}\"\n   917→            )\n   918→            notarization_identity = installer_identity\n   919→        else:\n   920→            identity_args = f\"--identity {identity.id}\"\n   921→            notarization_identity = identity\n   922→\n   923→        format_args = f\"-p {app.packaging_format}\"\n   924→\n   925→        # Submit the app for notarization\n   926→        submission_id = self.submit_notarization(app, identity=notarization_identity)\n   927→\n   928→        self.console.warning(\n   929→            f\"\"\"\n   930→Briefcase will now wait for Apple to approve the notarization request.\n   931→This can take some time - in some cases, hours.\n   932→\n   933→If notarization is interrupted, you can resume by running:\n   934→\n   935→    briefcase package macOS {self.output_format} {format_args} {identity_args} --resume {submission_id}\n   936→\n   937→\"\"\"\n   938→        )\n   939→\n   940→        self.finalize_notarization(\n   941→            app,\n   942→            identity=notarization_identity,\n   943→            submission_id=submission_id,\n   944→        )\n   945→\n   946→    def submit_notarization(self, app, identity: SigningIdentity) -> str:\n   947→        \"\"\"Submit a file for notarization, returning the ID of the notarizatzion task.\n   948→\n   949→        If the file is a .app, it will be archived as a .zip for submission purposes.\n   950→\n   951→        :param app: The app to notarize.\n   952→        :param identity: The code signing identity to use.\n   953→        :returns: The ID of the notarization task.\n   954→        \"\"\"\n   955→        filename = self.notarization_path(app)\n   956→        try:\n   957→            if app.packaging_format == \"zip\":\n   958→                self.console.info()\n   959→                with self.console.wait_bar(\n   960→                    f\"Archiving {filename.name} for notarization...\"\n   961→                ):\n   962→                    archive_filename = filename.parent / (filename.name + \".zip\")\n   963→                    self.ditto_archive(filename, archive_filename)\n   964→            else:\n   965→                archive_filename = filename\n   966→\n   967→            submission_id = None\n   968→            store_credentials = False\n   969→            while not submission_id:\n   970→                if store_credentials:\n   971→                    if not self.console.input_enabled:\n   972→                        raise BriefcaseCommandError(\n   973→                            f\"\"\"\n   974→The keychain does not contain credentials for the profile {identity.profile}.\n   975→You can store these credentials by invoking:\n   976→\n   977→    $ xcrun notarytool store-credentials --team-id {identity.team_id} {identity.profile}\n   978→\n   979→\"\"\"\n   980→                        )\n   981→\n   982→                    self.console.warning(\n   983→                        \"\"\"\n   984→The notarization process uses credentials stored on your system Keychain.\n   985→You need to do this once for each signing certificate you use.\n   986→\n   987→The credentials are authenticated and stored using your Apple ID, using\n   988→an app-specific Apple ID password. To generate an app-specific Apple ID\n   989→password:\n   990→\n   991→  1. Sign into https://appleid.apple.com;\n   992→  2. In the 'Sign-in and Security' section, click 'App-Specific Passwords';\n   993→  3. Click on the '+' icon. You will need to provide an identifying name\n   994→     for the password. You can pick any name that makes sense to you - the\n   995→     name is only there so you can identify passwords. 'Briefcase' would be\n   996→     one possible name.\n   997→  4. Record the password somewhere safe.\n   998→\"\"\"\n   999→                    )\n  1000→                    try:\n  1001→                        self.tools.subprocess.run(\n  1002→                            [\n  1003→                                \"xcrun\",\n  1004→                                \"notarytool\",\n  1005→                                \"store-credentials\",\n  1006→                                \"--team-id\",\n  1007→                                identity.team_id,\n  1008→                                identity.profile,\n  1009→                            ],\n  1010→                            check=True,\n  1011→                            stream_output=False,  # Command reads from stdin.\n  1012→                        )\n  1013→                    except subprocess.CalledProcessError as e:\n  1014→                        raise BriefcaseCommandError(\n  1015→                            f\"Unable to store credentials for team ID {identity.team_id}.\"\n  1016→                        ) from e\n  1017→\n  1018→                # Attempt the notarization\n  1019→                try:\n  1020→                    self.console.info()\n  1021→                    with self.console.wait_bar(\"Submitting app for notarization...\"):\n  1022→                        submission = self.tools.subprocess.parse_output(\n  1023→                            json_parser,\n  1024→                            [\n  1025→                                \"xcrun\",\n  1026→                                \"notarytool\",\n  1027→                                \"submit\",\n  1028→                                archive_filename,\n  1029→                                \"--keychain-profile\",\n  1030→                                identity.profile,\n  1031→                                \"--output-format\",\n  1032→                                \"json\",\n  1033→                            ],\n  1034→                            quiet=1,\n  1035→                        )\n  1036→                        submission_id = submission[\"id\"]\n  1037→                except subprocess.CalledProcessError as e:\n  1038→                    # Error when submitting for notarization.\n  1039→                    # A return code of 69 (nice) indicates an issue with the\n  1040→                    # keychain profile. If store_credentials is already True,\n  1041→                    # then we've already tried to store them, so call the attempt\n  1042→                    # a fail\n  1043→                    if e.returncode == 69 and not store_credentials:\n  104