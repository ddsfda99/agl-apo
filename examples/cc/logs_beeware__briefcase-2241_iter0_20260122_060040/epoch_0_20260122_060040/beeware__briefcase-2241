packages is performed.\"\"\"\n   332\u2192    bundle_path = tmp_path / \"base_path/build/first-app/macos/app\"\n   333\u2192\n   334\u2192    create_command.tools.host_arch = host_arch\n   335\u2192    first_app_templated.requires = [\"first\", \"second==1.2.3\", \"third>=3.2.1\"]\n   336\u2192\n   337\u2192    # Mock the result of finding the binary packages - 2 of the packages are binary;\n   338\u2192    # the version on the loosely specified package doesn't match the lower bound.\n   339\u2192    create_command.find_binary_packages = mock.Mock(\n   340\u2192        return_value=[\n   341\u2192            (\"second\", \"1.2.3\"),\n   342\u2192            (\"third\", \"3.4.5\"),\n   343\u2192        ]\n   344\u2192    )\n   345\u2192\n   346\u2192    # Mock the thin command so we can confirm it was invoked.\n   347\u2192    create_command.thin_app_packages = mock.Mock()\n   348\u2192\n   349\u2192    # Mock the merge command so we can confirm it was invoked.\n   350\u2192    create_command.merge_app_packages = mock.Mock()\n   351\u2192\n   352\u2192    create_command.install_app_requirements(first_app_templated, test_mode=False)\n   353\u2192\n   354\u2192    # We looked for binary packages in the host app_packages\n   355\u2192    create_command.find_binary_packages.assert_called_once_with(\n   356\u2192        bundle_path / f\"app_packages.{host_arch}\",\n   357\u2192        universal_suffix=\"_universal2\",\n   358\u2192    )\n   359\u2192\n   360\u2192    # A request was made to install requirements\n   361\u2192    assert create_command.tools[first_app_templated].app_context.run.mock_calls == [\n   362\u2192        # First call is to install the initial packages on the host arch\n   363\u2192        mock.call(\n   364\u2192            [\n   365\u2192                sys.executable,\n   366\u2192                \"-u\",\n   367\u2192                \"-X\",\n   368\u2192                \"utf8\",\n   369\u2192                \"-m\",\n   370\u2192                \"