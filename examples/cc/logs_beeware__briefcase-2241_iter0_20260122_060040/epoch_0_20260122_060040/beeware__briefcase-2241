first pass, the second pass isn't performed.\"\"\"\n   586\u2192    bundle_path = tmp_path / \"base_path/build/first-app/macos/app\"\n   587\u2192\n   588\u2192    # Create pre-existing other-arch content\n   589\u2192    create_installed_package(bundle_path / f\"app_packages.{other_arch}\", \"legacy\")\n   590\u2192\n   591\u2192    create_command.tools.host_arch = host_arch\n   592\u2192    first_app_templated.requires = [\"first\", \"second==1.2.3\", \"third>=3.2.1\"]\n   593\u2192\n   594\u2192    # Mock the result of finding no binary packages.\n   595\u2192    create_command.find_binary_packages = mock.Mock(return_value=[])\n   596\u2192\n   597\u2192    # Mock the thin command so we can confirm it was invoked.\n   598\u2192    create_command.thin_app_packages = mock.Mock()\n   599\u2192\n   600\u2192    # Mock the merge command so we can confirm it was invoked.\n   601\u2192    create_command.merge_app_packages = mock.Mock()\n   602\u2192\n   603\u2192    create_command.install_app_requirements(first_app_templated, test_mode=False)\n   604\u2192\n   605\u2192    # We looked for binary packages in the host app_packages\n   606\u2192    create_command.find_binary_packages.assert_called_once_with(\n   607\u2192        bundle_path / f\"app_packages.{host_arch}\",\n   608\u2192        universal_suffix=\"_universal2\",\n   609\u2192    )\n   610\u2192\n   611\u2192    # A request was made to install requirements\n   612\u2192    assert create_command.tools[first_app_templated].app_context.run.mock_calls == [\n   613\u2192        # Only call is to install the initial packages on the host arch\n   614\u2192        mock.call(\n   615\u2192            [\n   616\u2192                sys.executable,\n   617\u2192                \"-u\",\n   618\u2192                \"-X\",\n   619\u2192                \"utf8\",\n   620\u2192                \"-m\",\n   621\u2192                \"pip\",\n   622\u2192                \"install\",\n   623\u2192                \"--disable-pip-v