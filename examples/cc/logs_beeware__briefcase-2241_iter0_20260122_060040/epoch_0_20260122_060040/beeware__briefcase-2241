       sub_kwargs = self._prepare_app_kwargs(app=app, test_mode=test_mode)\n   339\u2192        cmdline = [self.binary_path(app) / f\"Contents/MacOS/{app.formal_name}\"]\n   340\u2192        cmdline.extend(passthrough)\n   341\u2192\n   342\u2192        if test_mode:\n   343\u2192            # Stream the app's output for testing.\n   344\u2192            # When a console app runs normally, its stdout should be connected\n   345\u2192            # directly to the terminal to properly display the app. When its test\n   346\u2192            # suite is running, though, Briefcase should stream the output to\n   347\u2192            # capture the testing outcome.\n   348\u2192            app_popen = self.tools.subprocess.Popen(\n   349\u2192                cmdline,\n   350\u2192                cwd=self.tools.home_path,\n   351\u2192                stdout=subprocess.PIPE,\n   352\u2192                stderr=subprocess.STDOUT,\n   353\u2192                bufsize=1,\n   354\u2192                **sub_kwargs,\n   355\u2192            )\n   356\u2192            self._stream_app_logs(app, popen=app_popen, test_mode=test_mode)\n   357\u2192\n   358\u2192        else:\n   359\u2192            try:\n   360\u2192                # Start the app directly\n   361\u2192                self.console.info(\"=\" * 75)\n   362\u2192                self.tools.subprocess.run(\n   363\u2192                    cmdline,\n   364\u2192                    cwd=self.tools.home_path,\n   365\u2192                    check=True,\n   366\u2192                    stream_output=False,\n   367\u2192                    **sub_kwargs,\n   368\u2192                )\n   369\u2192            except subprocess.CalledProcessError:\n   370\u2192                # The command line app *could* returns an error code, which is entirely legal.\n   371\u2192                # Ignore any subprocess error here.\n   372\u2192                pass\n   373\u2192\n   374\u2192    def run_gui_app(\n   375\u2192        self,\n   376\u2192        app: AppConfig,\n   377\u2192        test_mode: bool,\n   378\u2192        passthrough: list[str],\n   379\u2192        **kwargs,\n   380\u2192    ):\n   381\u2192        \"\"\"Start the GUI application.\n   382\u2192\n   383\u2192        :param app: The config object for the app\n   384\u2192        :param test_mode: Boolean; Is the app running in test mode?\n   385\u2192        :param passthrough: The list of arguments to pass to the app\n   386\u2192        \"\"\"\n   387\u2192        # Start log stream for the app.\n   388\u2192        # Streaming the system log is... a mess. The system log contains a\n   389\u2192        # *lot* of noise from other processes; even if you filter by\n   390\u2192        # process, there's a lot of macOS-generated noise. It's very\n   391\u2192        # difficult to extract just the \"user generated\" stdout/err log\n   392\u2192        # messages.\n   393\u2192        #\n   394\u2192        # The following sets up a log stream filter that looks for:\n   395\u2192        #  1. a log sender that matches that app binary; or,\n   396\u2192        #  2. a log sender of libffi, and a process that matches the app binary.\n   397\u2192        # Case (1) works for pre-Python 3.9 static linked binaries.\n   398\u2192        # Case (2) works for Python 3.9+ dynamic linked binaries.\n   399\u2192        # It's not enough to filter on *just* the processImagePath,\n   400\u2192        # as the process will generate lots of system-level messages.\n   401\u2192        # We can't filter on *just* the senderImagePath, because other\n   402\u2192        # apps will generate log messages that would be caught by the filter.\n   403\u2192        sender = os.fsdecode(self.binary_path(app) / \"Contents/MacOS\" / app.formal_name)\n   404\u2192        log_popen = self.tools.subprocess.Popen(\n   405\u2192            [\n   406\u2192                \"log\",\n   407\u2192                \"stream\",\n   408\u2192                \"--style\",\n   409\u2192                \"compact\",\n   410\u2192                \"--predicate\",\n   411\u2192                f'senderImagePath==\"{sender}\"'\n   412\u2192                f' OR (processImagePath==\"{sender}\"'\n   413\u2192                ' AND senderImagePath==\"/usr/lib/libffi.dylib\")',\n   414\u2192            ],\n   415\u2192            stdout=subprocess.PIPE,\n   416\u2192            stderr=subprocess.STDOUT,\n   417\u2192            bufsize=1,\n   418\u2192        )\n   419\u2192\n   420\u2192        # Wait for the log stream start up\n   421\u2192        time.sleep(0.25)\n   422\u2192\n   423\u2192        app_pid = None\n   424\u2192        try:\n   425\u2192            # Set up the log stream\n   426\u2192            sub_kwargs = self._prepare_app_kwargs(app=app, test_mode=test_mode)\n   427\u2192\n   428\u2192            # Start the app in a way that lets us stream the logs\n   429\u2192            self.tools.subprocess.run(\n   430\u2192                # Force a new app to be launched\n   431\u2192                [\"open\", \"-n\", self.binary_path(app)]\n   432\u2192                + (([\"--args\"] + passthrough) if passthrough else []),\n   433\u2192                cwd=self.tools.home_path,\n   434\u2192                check=True,\n   435\u2192                **sub_kwargs,\n   436\u2192            )\n   437\u2192\n   438\u2192            # Find the App process ID so log streaming can exit when the app exits\n   439\u2192            app_pid = get_process_id_by_command(\n   440\u2192                command=str(self.binary_path(app)),\n   441\u2192                console=self.console,\n   442\u2192            )\n   443\u2192\n   444\u2192            if app_pid is None:\n   445\u2192                raise BriefcaseCommandError(\n   446\u2192                    f\"Unable to find process for app {app.app_name} to start log streaming.\"\n   447\u2192                )\n   448\u2192\n   449\u2192            # Stream the app logs.\n   450\u2192            self._stream_app_logs(\n   451\u2192                app,\n   452\u2192                popen=log_popen,\n   453\u2192                test_mode=test_mode,\n   454\u2192                clean_filter=macOS_log_clean_filter,\n   455\u2192                clean_output=True,\n   456\u2192                stop_func=lambda: is_process_dead(app_pid),\n   457\u2192                log_stream=True,\n   458\u2192            )\n   459\u2192        except subprocess.CalledProcessError:\n   460\u2192            raise BriefcaseCommandError(f\"Unable to start app {app.app_name}.\")\n   461\u2192        finally:\n   462\u2192            # Ensure the App also terminates when exiting\n   463\u2192            if app_pid:  # pragma: no-cover-if-is-py310\n   464\u2192                with suppress(ProcessLookupError):\n   465\u2192                    self.tools.os.kill(app_pid, SIGTERM)\n   466\u2192\n   467\u2192\n   468\u2192def is_mach_o_binary(path):  # pragma: no-cover-if-is-windows\n   469\u2192    \"\"\"Determine if the file at the given path is a Mach-O binary.\n   470\u2192\n   471\u2192    :param path: The path to check\n   472\u2192    :returns: True if the file at the given location is a Mach-O binary.\n   473\u2192    \"\"\"\n   474\u2192    # A binary is any file that is executable, or has a suffix from a known list\n   475\u2192    if os.access(path, os.X_OK) or path.suffix.lower() in {\".dylib\", \".o\", \".so\", \"\"}:\n   476\u2192        # File is a binary; read the file magic to determine if it's Mach-O.\n   477\u2192        with path.open(\"rb\") as f:\n   478\u2192            magic = f.read(4)\n   479\u2192            return magic in (\n   480\u2192                b\"\\xca\\xfe\\xba\\xbe\",\n   481\u2192                b\"\\xcf\\xfa\\xed\\xfe\",\n   482\u2192                b\"\\xce\\xfa\\xed\\xfe\",\n   483\u2192                b\"\\xbe\\xba\\xfe\\xca\",\n   484\u2192                b\"\\xfe\\xed\\xfa\\xcf\",\n   485\u2192                b\"\\xfe\\xed\\xfa\\xce\",\n   486\u2192            )\n   487\u2192    else:\n   488\u2192        # Not a binary\n   489\u2192        return False\n   490\u2192\n   491\u2192\n   492\u2192class macOSSigningMixin:\n   493\u2192    def __init__(self, *args, **kwargs):\n   494\u2192        super().__init__(*args, **kwargs)\n   495\u2192\n   496\u2192        # External service APIs.\n   497\u2192        # These are abstracted to enable testing without patching.\n   498\u2192        self.get_identities = get_identities\n   499\u2192\n   500\u2192    def entitlements_path(self, app: AppConfig):  # pragma: no-cover-if-is-windows\n   501\u2192        return self.bundle_path(app) / self.path_index(app, \"entitlements_path\")\n   502\u2192\n   503\u2192    def select_identity(\n   504\u2192        self,\n   505\u2192        identity: str | None = None,\n   506\u2192        app_identity: SigningIdentity | None = None,\n   507\u2192        allow_adhoc: bool = True,\n   508\u2192    ) -> SigningIdentity:\n   509\u2192        \"\"\"Get the codesigning identity to use.\n   510\u2192\n   511\u2192        This can be either an application codesigning identity, or an installer\n   512\u2192        identity. An installer identity must be from the same Team ID as the application\n   513\u2192        identity.\n   514\u2192\n   515\u2192        :param identity: A pre-specified identity (either the 40-digit hex checksum, or\n   516\u2192            the string name of the identity). If provided, it will be validated against\n   517\u2192            the list of available identities to confirm that it is a valid codesigning\n   518\u2192            identity.\n   519\u2192        :param app_identity: The application signing identity to match when producing an\n   520\u2192            installer identity. Only non-app signing identities that match the team ID\n   521\u2192            for the ``app_identity`` will be presented as options. Omit this value to\n   522\u2192            select an app signing identity.\n   523\u2192        :param allow_adhoc: Should the adhoc identities be allowed?\n   524\u2192        :returns: The final identity to use\n   525\u2192        \"\"\"\n   526\u2192        # If the adhoc identity is allowed, add it first so it appears first in the list\n   527\u2192        # of options.\n   528\u2192        identities = {}\n   529\u2192        if allow_adhoc:\n   530\u2192            identities[\"-\"] = ADHOC_IDENTITY_NAME\n   531\u2192\n   532\u2192        # Obtain the valid codesigning identities. These are the identities that could\n   533\u2192        # be used for app signing.\n   534\u2192        identities.update(self.get_identities(self.tools, \"codesigning\"))\n   535\u2192\n   536\u2192        if app_identity:\n   537\u2192            ident_type = \"installer\"\n   538\u2192            ident_option = \"--installer-identity\"\n   539\u2192            # There's no way to explicitly request a list of installer identities. As a\n   540\u2192            # workaround, get the full, unfiltered list of all signing identities; then\n   541\u2192            # remove any identity that:\n   542\u2192            # 1. From a different team to the provided app identity; or\n   543\u2192            # 2. Appears on the list of app signing identities.\n   544\u2192            app_identities = identities\n   545\u2192            identities = {\n   546\u2192                key: name\n   547\u2192                for key, name in self.get_identities(self.tools).items()\n   548\u2192                if SigningIdentity.team_id_from_name(name) == app_identity.team_id\n   549\u2192                and key not in app_identities\n   550\u2192            }\n   551\u2192\n   552\u2192            if not identities:\n   553\u2192                raise BriefcaseCommandError(\n   554\u2192                    f\"No installer signing identities for team {app_identity.team_id} could be found.\"\n   555\u2192                )\n   556\u2192        else:\n   557\u2192            ident_type = \"application\"\n   558\u2192            ident_option = \"--identity\"\n   559\u2192\n   560\u2192        if identity:\n   561\u2192            try:\n   562\u2192                # Try to look up the identity as a hex checksum\n   563\u2192                identity_name = identities[identity]\n   564\u2192                return SigningIdentity(id=identity, name=identity_name)\n   565\u2192            except KeyError as e:\n   566\u2192                # Try to look up the identity as readable name\n   567\u2192                try:\n   568\u2192                    reverse_lookup = {name: ident for ident, name in identities.items()}\n   569\u2192                    identity_id = reverse_lookup[identity]\n   570\u2192                    return SigningIdentity(id=identity_id, name=identity)\n   571\u2192                except KeyError:\n   572\u2192                    # Not found as an ID or name\n   573\u2192                    raise BriefcaseCommandError(\n   574\u2192                        f\"Invalid {ident_type} signing identity {identity}\"\n   575\u2192                    ) from e\n   576\u2192\n   577\u2192        identity = self.console.selection_question(\n   578\u2192            intro=f\"Select {ident_type} signing identity to use:\",\n   579\u2192            description=f\"{ident_type.title()} Signing Identity\",\n   580\u2192            options=identities,\n   581\u2192        )\n   582\u2192        identity_name = identities[identity]\n   583\u2192        if identity == \"-\":\n   584\u2192            self.console.info(\n   585\u2192                f\"\"\"\n   586\u2192In future, you could specify this signing identity by using:\n   587\u2192\n   588\u2192    $ briefcase {self.command} macOS {self.output_format} --adhoc-sign ...\n   589\u2192\n   590\u2192\"\"\"\n   591\u2192            )\n   592\u2192        else:\n   593\u2192            self.console.info(\n   594\u2192                f\"\"\"\n   595\u2192In future, you could specify this signing identity by using:\n   596\u2192\n   597\u2192    $ briefcase {self.command} macOS {self.output_format} {ident_option} {identity} ...\n   598\u2192\n   599\u2192or\n   600\u2192\n   601\u2192    $ briefcase {self.command} macOS {self.output_format} {ident_option} \"{identity_name}\" ...\n   602\u2192\n   603\u2192\"\"\"\n   604\u2192            )\n   605\u2192\n   606\u2192        return SigningIdentity(id=identity, name=identity_name)\n   607\u2192\n   608\u2192    def sign_file(\n   609\u2192        self,\n   610\u2192        path: Path,\n   611\u2192        identity: SigningIdentity,\n   612\u2192        entitlements: Path | None = None,\n   613\u2192    ):\n   614\u2192        \"\"\"Code sign a file.\n   615\u2192\n   616\u2192        :param path: The path to the file to sign.\n   617\u2192        :param identity: The code signing identity to use.\n   618\u2192        :param entitlements: The path to the entitlements file to use.\n   619\u2192        \"\"\"\n   620\u2192        options = \"runtime\" if not identity.is_adhoc else None\n   621\u2192        process_command = [\"codesign\", path, \"--sign\", identity.id, \"--force\"]\n   622\u2192\n   623\u2192        if entitlements:\n   624\u2192            process_command.append(\"--entitlements\")\n   625\u2192            process_command.append(entitlements)\n   626\u2192        if options:\n   627\u2192            process_command.append(\"--options\")\n   628\u2192            process_command.append(options)\n   629\u2192\n   630\u2192        self.console.verbose(f\"Signing {Path(path).relative_to(self.base_path)}\")\n   631\u2192\n   632\u2192        try:\n   633\u2192            self.tools.subprocess.run(\n   634\u2192                process_command,\n   635\u2192                stderr=subprocess.PIPE,\n   636\u2192                check=True,\n   637\u2192            )\n   638\u2192        except subprocess.CalledProcessError as e:\n   639\u2192            errors = e.stderr\n   640\u2192            if any(\n   641\u2192                msg in errors\n   642\u2192                for msg in [\n   643\u2192                    # File has a signature matching the Mach-O magic,\n   644\u2192                    # but isn't actually a Mach-O binary\n   645\u2192                    \"unsupported format for signature\",\n   646\u2192                    # A folder named ``.framework`, but not actually a macOS Framework`\n   647\u2192                    \"bundle format unrecognized, invalid, or unsuitable\",\n   648\u2192                ]\n   649\u2192            ):\n   650\u2192                # We should not be signing this in the first place\n   651\u2192                self.console.verbose(\n   652\u2192                    f\"... {Path(path).relative_to(self.base_path)} does not require a signature\"\n   653\u2192                )\n   654\u2192                return\n   655\u2192            else:\n   656\u2192                raise BriefcaseCommandError(f\"Unable to code sign {path}.\")\n   657\u2192\n   658\u2192    def sign_app(\n   659\u2192        self,\n   660\u2192        app: AppConfig,\n   661\u2192        identity: SigningIdentity,\n   662\u2192    ):  # pragma: no-cover-if-is-windows\n   663\u2192        \"\"\"Sign an entire app with a specific identity.\n   664\u2192\n   665\u2192        :param app: The app to sign\n   666\u2192        :param identity: The signing identity to use\n   667\u2192        \"\"\"\n   668\u2192        bundle_path = self.binary_path(app)\n   669\u2192        resources_path = bundle_path / \"Contents/Resources\"\n   670\u2192        frameworks_path = bundle_path / \"Contents/Frameworks\"\n   671\u2192\n   672\u2192        sign_targets = []\n   673\u2192\n   674\u2192        for folder in (resources_path, frameworks_path):\n   675\u2192            # Sign all Mach-O executable objects\n   676\u2192            sign_targets.extend(\n   677\u2192                path\n   678\u2192                for path in folder.rglob(\"*\")\n   679\u2192                if not path.is_dir()\n   680\u2192                and not path.is_symlink()\n   681                and is_mach_o_binary(path)\n   682\u2192            )\n   683\u2192\n   684\u2192            # Sign all embedded frameworks\n   685\u2192            sign_targets.extend(folder.rglob(\"*.framework\"))\n   686\u2192\n   687\u2192            # Sign all embedded app objects\n   688\u2192            sign_targets.extend(folder.rglob(\"*.app\"))\n   689\u2192\n   690\u2192        # Sign the bundle path itself\n   691\u2192        sign_targets.append(bundle_path)\n   692\u2192\n   693\u2192        # Run signing through a ThreadPoolExecutor so that they run in parallel. We need\n   694\u2192        # to ensure that objects are signed from the inside out (i.e., a folder must be\n   695\u2192        # signed *after* all it's contents has been signed; files in a folder must be\n   696\u2192        # signed *after* all subfolders in that same folder); and an app that uses a\n   697\u2192        # library must be signed *after* all the libraries it uses. See\n   698\u2192        # https://developer.apple.com/documentation/xcode/creating-distribution-signed-code-for-the-mac#Determine-the-signing-order\n   699\u2192        # for details.\n   700\u2192        #\n   701\u2192        # To do this, we utilize grouping on a sorted list, and rely on the fact that a\n   702\u2192        # new group is created whenever the grouping key changes. The sorting process\n   703\u2192        # guarantees depth-first ordering; the grouping is applied over the sorted\n   704\u2192        # content, ensuring that that folders are signed before files.\n   705\u2192        #\n   706\u2192        # This approach isn't perfect. It will fail if there's an embedded app that uses\n   707\u2192        # a library in a different framework, and the app is lexically sorted before the\n   708\u2192        # library (e.g. if app_packages/foobar/Alpha.framework/Helpers/My App.app\n   709\u2192        # depends on app_packages/footbar/Beta.framework/libbeta). However, if you're\n   710\u2192        # embedding apps in frameworks in Python libraries that are installed by pip,\n   711\u2192        # you're already making poor life choices; this approach is enough to satisfy\n   712\u2192        # the one use of app-in-framework embedding that we're aware of (PySide).\n   713\u2192        progress_bar = self.console.progress_bar()\n   714\u2192        task_id = progress_bar.add_task(\"Signing App\", total=len(sign_targets))\n   715\u2192        with progress_bar:\n   716\u2192            for group in self.tools.file.sorted_depth_first_groups(sign_targets):\n   717\u2192                with concurrent.futures.ThreadPoolExecutor(\n   718\u2192                    max_workers=1 if self.console.is_deep_debug else None\n   719\u2192                ) as executor:\n   720\u2192                    futures = []\n   721\u2192                    for path in group:\n   722\u2192                        future = executor.submit(\n   723\u2192                            self.sign_file,\n   724\u2192                            path,\n   725\u2192                            entitlements=self.entitlements_path(app),\n   726\u2192                            identity=identity,\n   727\u2192                        )\n   728\u2192                        futures.append(future)\n   729\u2192                    for future in concurrent.futures.as_completed(futures):\n   730\u2192                        progress_bar.update(task_id, advance=1)\n   731\u2192                        if future.exception():\n   732\u2192                            raise future.exception()\n   733\u2192\n   734\u2192\n   735\u2192class macOSPackageMixin(macOSSigningMixin):\n   736\u2192    ADHOC_SIGN_HELP = (\n   737\u2192        \"Perform ad-hoc signing on the app. \"\n   738\u2192        \"The app will only run on this machine; it cannot be redistributed to others\"\n   739\u2192    )\n   740\u2192    IDENTITY_HELP = (\n   741\u2192        \"The code signing identity to use; either the 40-digit hex \"\n   742\u2192        \"checksum, or the full name of the identity\"\n   743\u2192    )\n   744\u2192\n   745\u2192    @property\n   746\u2192    def packaging_formats(self):\n   747\u2192        return [\"zip\", \"dmg\", \"pkg\"]\n   748\u2192\n   749\u2192    @property\n   750\u2192    def default_packaging_format(self):\n   751\u2192        # The default changes depending on whether the app is a console app or a GUI app\n   752\u2192        return None\n   753\u2192\n   754\u2192    def notarization_path(self, app: AppConfig) -> Path:\n   755\u2192        \"\"\"The file that is submitted for notarization.\"\"\"\n   756\u2192        if app.packaging_format == \"zip\":\n   757\u2192            # Notarization for bare .app's is applied to the binary, not the\n   758\u2192            # distribution artefact, with the distribution artefact being\n   759\u2192            # created after notarization has completed.\n   760\u2192            return self.binary_path(app)\n   761\u2192        else:\n   762\u2192            return self.distribution_path(app)\n   763\u2192\n   764\u2192    def distribution_path(self, app: AppConfig) -> Path:\n   765\u2192        \"\"\"The path to the final distribution artefact.\"\"\"\n   766\u2192        if app.packaging_format == \"zip\":\n   767\u2192            return self.dist_path / f\"{app.formal_name}-{app.version}.app.zip\"\n   768\u2192        elif app.packaging_format == \"pkg\":\n   769\u2192            return self.dist_path / f\"{app.formal_name}-{app.version}.pkg\"\n   770\u2192        else:\n   771\u2192            return self.dist_path / f\"{app.formal_name}-{app.version}.dmg\"\n   772\u2192\n   773\u2192    def add_options(self, parser):\n   774\u2192        super().add_options(parser)\n   775\u2192\n   776\u2192        # --no-sign-installer and --installer-identity are mutually exclusive\n   777\u2192        installer_signing_group = parser.add_mutually_exclusive