ock()\n   351→\n   352→    create_command.install_app_requirements(first_app_templated, test_mode=False)\n   353→\n   354→    # We looked for binary packages in the host app_packages\n   355→    create_command.find_binary_packages.assert_called_once_with(\n   356→        bundle_path / f\"app_packages.{host_arch}\",\n   357→        universal_suffix=\"_universal2\",\n   358→    )\n   359→\n   360→    # A request was made to install requirements\n   361→    assert create_command.tools[first_app_templated].app_context.run.mock_calls == [\n   362→        # First call is to install the initial packages on the host arch\n   363→        mock.call(\n   364→            [\n   365→                sys.executable,\n   366→                \"-u\",\n   367→                \"-X\",\n   368→                \"utf8\",\n   369→                \"-m\",\n   370→                \"pip\",\n   371→                \"install\",\n   372→                \"--disable-pip-version-check\",\n   373→                \"--upgrade\",\n   374→                \"--no-user\",\n   375→                f\"--target={bundle_path / ('app_packages.' + host_arch)}\",\n   376→                \"--only-binary\",\n   377→                \":all:\",\n   378→                \"--platform\",\n   379→                f\"macosx_11_0_{host_arch}\",\n   380→                \"first\",\n   381→                \"second==1.2.3\",\n   382→                \"third>=3.2.1\",\n   383→            ],\n   384→            check=True,\n   385→            encoding=\"UTF-8\",\n   386→        ),\n   387→        # Second call installs the binary packages for the other architecture.\n   388→        mock.call(\n   389→            [\n   390→                sys.executable,\n   391→                \"-u\",\n   392→                \"-X\",\n   393→                \"utf8\",\n   394→                \"-m\",\n   395→                \"pip\",\n   396→                \"install\",\n   397→                \"--disable-pip-version-check\",\n   398→                \"--upgrade\",\n   399→                \"--no-user\",\n   400→                f\"--target={bundle_path / ('app_packages.' + other_arch)}\",\n   401→                \"--no-deps\",\n   402→                \"--platform\",\n   403→                f\"macosx_11_0_{other_arch}\",\n   404→                \"--only-binary\",\n   405→                \":all:\",\n   406→                \"second==1.2.3\",\n   407→                \"third==3.4.5\",\n   408→            ],\n   409→            check=True,\n   410→            encoding=\"UTF-8\",\n   411→        ),\n   412→    ]\n   413→\n   414→    # The app packages folder has been created. The existence of the target and host\n   415→    # versions is validated as a result of the underlying install/merge methods.\n   416→    assert (bundle_path / f\"app_packages.{other_arch}\").is_dir()\n   417→\n   418→    # An attempt was made thin the \"other\" arch packages.\n   419→    create_command.thin_app_packages.assert_called_once_with(\n   420→        bundle_path / f\"app_packages.{other_arch}\",\n   421→        arch=other_arch,\n   422→    )\n   423→\n   424→    # An attempt was made to merge packages.\n   425→    create_command.merge_app_packages.assert_called_once_with(\n   426→        target_app_packages=bundle_path\n   427→        / \"First App.app\"\n   428→        / \"Contents\"\n   429→        / \"Resources\"\n   430→        / \"app_packages\",\n   431→        sources=[\n   432→            bundle_path / f\"app_packages.{host_arch}\",\n   433→            bundle_path / f\"app_packages.{other_arch}\",\n   434→        ],\n   435→    )\n   436→\n   437→\n   438→def test_min_os_version(create_command, first_app_templated, tmp_path):\n   439→    \"\"\"If the app specifies a min OS version, it is used for wheel installs.\"\"\"\n   440→    create_command.tools.host_arch = \"arm64\"\n   441→\n   442→    bundle_path = tmp_path / \"base_path/build/first-app/macos/app\"\n   443→\n   444→    first_app_templated.requires = [\"first\", \"second==1.2.3\"