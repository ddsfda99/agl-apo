rget and host\n   415\u2192    # versions is validated as a result of the underlying install/merge methods.\n   416\u2192    assert (bundle_path / f\"app_packages.{other_arch}\").is_dir()\n   417\u2192\n   418\u2192    # An attempt was made thin the \"other\" arch packages.\n   419\u2192    create_command.thin_app_packages.assert_called_once_with(\n   420\u2192        bundle_path / f\"app_packages.{other_arch}\",\n   421\u2192        arch=other_arch,\n   422\u2192    )\n   423\u2192\n   424\u2192    # An attempt was made to merge packages.\n   425\u2192    create_command.merge_app_packages.assert_called_once_with(\n   426\u2192        target_app_packages=bundle_path\n   427\u2192        / \"First App.app\"\n   428\u2192        / \"Contents\"\n   429\u2192        / \"Resources\"\n   430\u2192        / \"app_packages\",\n   431\u2192        sources=[\n   432\u2192            bundle_path / f\"app_packages.{host_arch}\",\n   433\u2192            bundle_path / f\"app_packages.{other_arch}\",\n   434\u2192        ],\n   435\u2192    )\n   436\u2192\n   437\u2192\n   438\u2192def test_min_os_version(create_command, first_app_templated, tmp_path):\n   439\u2192    \"\"\"If the app specifies a min OS version, it is used for wheel installs.\"\"\"\n   440\u2192    create_command.tools.host_arch = \"arm64\"\n   441\u2192\n   442\u2192    bundle_path = tmp_path / \"base_path/build/first-app/macos/app\"\n   443\u2192\n   444\u2192    first_app_templated.requires = [\"first\", \"second==1.2.3\", \"third>=3.2.1\"]\n   445\u2192\n   446\u2192    # Set a minimum OS version.\n   447\u2192    first_app_templated.min_os_version = \"13.2\"\n   448\u2192\n   449\u2192    # Mock the result of finding the binary packages - 2 of the packages are binary;\n   450\u2192    # the version on the loosely specified package doesn't match the lower bound.\n   451\u2192    create_command.find_binary_packages = mock.Mock(\n   452\u2192        return_value=[\n   453\u2192            (\"second\", \"1.2.3\"),\n   454\u2192            (\"third\", \"3.4.5\"),\n   455\u2192        ]\n   456\u2192    )\n   457\u2192\n   458\u2192    # Mock the thin command so we can confirm it was invoked.\n   459\u2192    create_command.thin_app_packages = mock.Mock()\n   460\u2192\n   461\u2192    # Mock the merge command so we can confirm it was invoked.\n   462\u2192    create_command.merge_app_packages = mock.Mock()\n   463\u2192\n   464\u2192    create_command.install_app_requirements(first_app_templated, test_mode=False)\n   465\u2192\n   466\u2192    # We looked for binary packages in the host app_packages\n   467\u2192    create_command.find_binary_packages.assert_called_once_with(\n   468\u2192        bundle_path / \"app_packages.arm64\",\n   469\u2192        universal_suffix=\"_universal2\",\n   470\u2192    )\n   471\u2192\n   472\u2192    # A request was made to install requirements\n   473\u2192    assert create_command.tools[first_app_templated].app_context.run.mock_calls == [\n   474\u2192        # First call is to install the initial packages on the host arch\n   475\u2192        mock.call(\n   476\u2192            [\n   477\u2192                sys.executable,\n   478\u2192                \"-u\",\n   479\u2192                \"-X\",\n   480\u2192                \"utf8\",\n   481\u2192                \"-m\",\n   482\u2192                \"pip\",\n   483\u2192                \"install\",\n   484\u2192                \"--disable-pip-version-check\",\n   485\u2192                \"--upgrade\",\n   486\u2192                \"--no-user\",\n   487\u2192                f\"--target={bundle_path / 'app_packages.arm64'}\",\n   488\u2192                \"--only-binary\",\n   489\u2192                \":all:\",\n   490\u2192                \"--platform\",\n   491\u2192                \"macosx_13_2_arm64\",\n   492\u2192                \"first\",\n   493\u2192                \"second==1.2.3\",\n   494\u2192                \"third>=3.2.1\",\n   495\u2192            ],\n   496\u2192            check=True,\n   497\u2192            encoding=\"UTF-8\",\n   498\u2192        ),\n   499\u2192        # Second call installs the binary packages for the other architecture.\n   500\u2192        mock.call(\n   501\u2192            [\n   502\u2192                sys.executable,\n   503\u2192                \"-u\",\n   504\u2192                \"-X\",\n   505\u2192                \"utf8\",\n   506\u2192                \"-m\",\n   507\u2192                \"pip\",\n   508\u2192                \"install\",\n   509\u2192                \"--disable-pip-version-check\",\n   510\u2192                \"--upgrade\",\n   511\u2192                \"--no-user\",\n   512\u2192                f\"--target={bundle_path / 'app_packages.x86_64'}\",\n   513\u2192                \"--no-deps\",\n   514\u2192                \"--platform\",\n   515\u2192                \"macosx_13_2_x86_64\",\n   516\u2192                \"--only-binary\",\n   517\u2192                \":all:\",\n   518\u2192                \"second==1.2.3\",\n   519\u2192                \"third==3.4.5\",\n   520\u2192            ],\n   521\u2192            check=True,\n   522\u2192            encoding=\"UTF-8\",\n   523\u2192        ),\n   524\u2192    ]\n   525\u2192\n   526\u2192    # The app packages folder has been created. The existence of the target and host\n   527\u2192    # versions is validated as a result of the underlying install/merge methods.\n   528\u2192    assert (bundle_path / \"app_packages.x86_64\").is_dir()\n   529\u2192\n   530\u2192    # An attempt was made thin the \"other\" arch packages.\n   531\u2192    create_command.thin_app_packages.assert_called_once_with(\n   532\u2192        bundle_path / \"app_packages.x86_64\",\n   533\u2192        arch=\"x86_64\",\n   534\u2192    )\n   535\u2192\n   536\u2192    # An attempt was made to merge packages.\n   537\u2192    create_command.merge_app_packages.assert_called_once_with(\n   538\u2192        target_app_packages=bundle_path\n   539\u2192 