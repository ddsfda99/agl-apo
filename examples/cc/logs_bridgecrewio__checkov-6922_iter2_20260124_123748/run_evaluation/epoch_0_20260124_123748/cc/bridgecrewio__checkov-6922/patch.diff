@@ -47,10 +56,37 @@ class K8sValidator:
                     return is_section_valid, reason
         return True, ''
 
+    @staticmethod
+    def is_valid_name(name: Any) -> Tuple[bool, str]:
+        """
+        Public helper to validate Kubernetes names with support for double-curly braces templating.
+        """
+        return K8sValidator._is_name_valid(name)
+
     @staticmethod
     def _is_name_valid(name: Any) -> Tuple[bool, str]:
+        """
+        Validate a Kubernetes resource/name-like string.
+
+        - Accept double-curly braces templating blocks by sanitizing them to a safe token
+        - Enforce DNS-1123 subdomain constraints on the sanitized result
+        - Reject names with stray single braces outside templating blocks
+        - Enforce max length of 253 characters
+        """
+        # Basic type/length guard
         if not isinstance(name, str) or len(name) > 253:
             return False, f'name {name} is invalid'
-        if K8sValidator.name_disallowed_chars.search(name):
+
+        original = name
+        # Replace all {{ ... }} blocks with a safe alphanumeric placeholder
+        sanitized = K8sValidator._double_curly_block_re.sub('x', original)
+
+        # If any braces remain, they are stray single braces -> reject
+        if '{' in sanitized or '}' in sanitized:
+            return False, f'name {name} is invalid'
+
+        # Enforce DNS-1123 subdomain pattern on sanitized name
+        if not K8sValidator._dns1123_re.match(sanitized):
             return False, f'name {name} is invalid'
+
         return True, ''
