 class K8sValidator:
-    name_disallowed_chars = re.compile("[#{}]+")  # noqa: CCE003  # a static attribute
+    """
+    Kubernetes template validator with strict name validation that allows
+    double-curly braces templating blocks (e.g., {{ .Release.Name }}) while
+    enforcing DNS-1123 subdomain rules on the non-templated portions.
+    """
+
+    # DNS-1123 subdomain regex: start/end alphanumeric, allow '-', '.' in between
+    _dns1123_re = re.compile(r"^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$")
+    # Match double-curly-brace templating blocks lazily, allow newlines
+    _double_curly_block_re = re.compile(r"\{\{.*?\}\}", re.DOTALL)
 
