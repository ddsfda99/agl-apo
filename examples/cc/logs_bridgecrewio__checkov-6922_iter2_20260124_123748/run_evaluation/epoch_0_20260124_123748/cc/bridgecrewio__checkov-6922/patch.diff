 import pytest
 
 from checkov.kubernetes.parser.validatior import K8sValidator
+from checkov.kubernetes.parser import k8_yaml
+from checkov.kubernetes.parser.parser import parse
 
 
 @pytest.fixture
@@ -59,3 +61,58 @@ def test_k8s_template_has_required_fields(template_valid_fields):
 def test_k8s_template_is_name_valid(template_invalid_name):
     is_valid, reason = K8sValidator.is_valid_template(template_invalid_name)
     assert not is_valid
+
+
+# New tests to reproduce and validate acceptance of double-curly braces in names
+
+def test_is_valid_name_all_templated_double_curly_braces():
+    # Name consisting entirely of a double-curly braces templating placeholder
+    name = "{{ .Release.Name }}"
+    is_valid, reason = K8sValidator.is_valid_name(name)
+    assert is_valid, "Name with double-curly braces should be valid"
+
+
+def test_is_valid_name_prefix_plus_templated_double_curly_braces():
+    # Name combining a static prefix plus a templated suffix using double-curly braces
+    name = "app-{{ .Values.suffix }}"
+    is_valid, reason = K8sValidator.is_valid_name(name)
+    assert is_valid, "Name with static prefix and double-curly braces should be valid"
+
+
+def test_is_valid_template_with_templated_name_double_curly_braces():
+    template = {
+        "apiVersion": "v1",
+        "kind": "ConfigMap",
+        "metadata": {"name": "app-{{ .Values.name }}"},
+        "data": {"k": "v"},
+    }
+    is_valid, reason = K8sValidator.is_valid_template(template)
+    assert is_valid, f"Template with double-curly braces name should be valid: {reason}"
+
+
+def test_parser_parse_keeps_templated_name_double_curly_braces(tmp_path):
+    # YAML containing a templated name with double-curly braces should not be dropped
+    yaml_content = """
+apiVersion: v1
+kind: ConfigMap
+metadata:
+  name: app-{{ .Values.name }}
+data:
+  k: v
+"""
+    p = tmp_path / "cm.yaml"
+    p.write_text(yaml_content)
+
+    # Using parser.parse should return definitions and not drop the template
+    result = parse(str(p))
+    assert result is not None
+    templates, lines = result
+    assert isinstance(templates, list)
+    assert templates, "Parser should retain templates with double-curly braces in names"
+
+
+def test_invalid_name_with_illegal_char_outside_double_curly_braces_still_rejected():
+    # Illegal character like '#' outside double-curly braces should be rejected
+    name = "app#{{ .Values.name }}"
+    is_valid, reason = K8sValidator.is_valid_name(name)
+    assert not is_valid, "Name with illegal character outside double-curly braces should be invalid"
