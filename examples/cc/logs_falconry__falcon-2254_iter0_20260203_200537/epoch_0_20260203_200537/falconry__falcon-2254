hod(client, *args, **kwargs)\n    62→\n    63→    alias = async_alias if inspect.iscoroutinefunction(method) else alias\n    64→\n    65→    alias.__doc__ = method.__doc__ + '\\n        .. versionadded:: {}\\n'.format(\n    66→        version_added\n    67→    )\n    68→    if replace_name:\n    69→        alias.__doc__ = alias.__doc__.replace(method.__name__, replace_name)\n    70→        alias.__name__ = replace_name\n    71→    else:\n    72→        alias.__name__ = method.__name__.partition('simulate_')[-1]\n    73→\n    74→    return alias\n    75→\n    76→\n    77→class Cookie:\n    78→    \"\"\"Represents a cookie returned by a simulated request.\n    79→\n    80→    Args:\n    81→        morsel: A ``Morsel`` object from which to derive the cookie\n    82→            data.\n    83→\n    84→    Attributes:\n    85→        name (str): The cookie's name.\n    86→        value (str): The value of the cookie.\n    87→        expires(datetime.datetime): Expiration timestamp for the cookie,\n    88→            or ``None`` if not specified.\n    89→        path (str): The path prefix to which this cookie is restricted,\n    90→            or ``None`` if not specified.\n    91→        domain (str): The domain to which this cookie is restricted,\n    92→            or ``None`` if not specified.\n    93→        max_age (int): The lifetime of the cookie in seconds, or\n    94→            ``None`` if not specified.\n    95→        secure (bool): Whether or not the cookie may only only be\n    96→            transmitted from the client via HTTPS.\n    97→        http_only (bool): Whether or not the cookie may only be\n    98→            included in unscripted requests from the client.\n    99→        same_site (str): Specifies whether cookies are send in\n   100→            cross-site requests. Possible values are 'Lax', 'Strict'\n   101→            and 'None'. ``None`` if not specified.\n   102→        partitioned (bool): Indicates if the cookie has the\n   103→            ``Partitioned`` flag set.\n   104→    \"\"\"\n   105→\n   106→    def __init__(self, morsel):\n   107→        self._name = morsel.key\n   108→        self._value = morsel.value\n   109→\n   110→        for name in (\n   111→            'expires',\n   112→            'path',\n   113→            'domain',\n   114→            'max_age',\n   115→            'secure',\n   116→            'httponly',\n   117→            'samesite',\n   118→            'partitioned',\n   119→        ):\n   120→            value = morsel[name.replace('_', '-')] or None\n   121→            setattr(self, '_' + name, value)\n   122→\n   123→    @property\n   124→    def name(self) -> str:\n   125→        return self._name\n   126→\n   127→    @property\n   128→    def value(self) -> str:\n   129→        return self._value\n   130→\n   131→    @property\n   132→    def expires(self) -> Optional[dt.datetime]:\n   133→        if self._expires:  # type: ignore[attr-defined]\n   134→            return http_date_to_dt(self._expires, obs_date=True)  # type: ignore[attr-defined]  # noqa E501\n   135→\n   136→        return None\n   137→\n   138→    @property\n   139→    def path(self) -> str:\n   140→        return self._path  # type: ignore[attr-defined]\n   141→\n   142→    @property\n   143→    def domain(self) -> str:\n   144→        return self._domain  # type: ignore[attr-defined]\n   145→\n   146→    @property\n   147→    def max_age(self) -> Optional[int]:\n   148→        return int(self._max_age) if self._max_age else None  # type: ignore[attr-defined]  # noqa E501\n   149→\n   150→    @property\n   151→    def secure(self) -> bool:\n   152→        return bool(self._secure)  # type: ignore[attr-defined]\n   153→\n   154→    @property\n   155→    def http_only(self) -> bool:\n   156→        return bool(self._httponly)  # type: ignore[attr-defined]\n   157→\n   158→    @property\n   159→    def same_site(self) -> Optional[str]:\n   160→        return self._samesite if self._samesite else None  # type: ignore[attr-defined]\n   161→\n   162→    @property\n   163→    def partitioned(self) -> bool:\n   164→        return bool(self._partitioned)  # type: ignore[attr-defined]\n   165→\n   166→\n   167→class _ResultBase:\n   168→    \"\"\"Base class for the result of a simulated request.\n   169→\n   170→    Args:\n   171→        status (str): An HTTP status string, including status code and\n   172→            reason string\n   173→        headers (list): A list of (header_name, header_value) tuples,\n   174→            per PEP-3333\n   175→\n   176→    Attributes:\n   177→        status (str): HTTP status string given in the response\n   178→        status_code (int): The code portion of the HTTP status string\n   179→        headers (CaseInsensitiveDict): A case-insensitive dictionary\n   180→            containing all the headers in the response, except for\n   181→            cookies, which may be accessed via the `cookies`\n   182→            attribute.\n   183→\n   184→            Note:\n   185→\n   186→                Multiple instances of a header in the response are\n   187→                currently not supported; it is unspecified which value\n   188→                will \"win\" and be represented in `headers`.\n   189→\n   190→        cookies (dict): A dictionary of\n   191→            :py:class:`falcon.testing.Cookie` values parsed from the\n   192→            response, by name.\n   193→\n   194→            The cookies dictionary can be used directly in subsequent requests::\n   195→\n   196→                client = testing.TestClient(app)\n   197→                response_one = client.simulate_get('/')\n   198→                response_two = client.simulate_post('/', cookies=response_one.cookies)\n   199→\n   200→        encoding (str): Text encoding of the response body, or ``None``\n   201→            if the encoding can not be determined.\n   202→    \"\"\"\n   203→\n   204→    def __init__(self, status, headers):\n   205→        self._status = status\n   206→        self._status_code = int(status[:3])\n   207→        self._headers = CaseInsensitiveDict(headers)\n   208→\n   209→        cookies = http_cookies.SimpleCookie()\n   210→        for name, value in headers:\n   211→            if name.lower() == 'set-cookie':\n   212→                cookies.load(value)\n   213→\n   214→        self._cookies = dict(\n   215→            (morsel.key, Cookie(morsel)) for morsel in cookies.values()\n   216→        )\n   217→\n   218→        self._encoding = helpers.get_encoding_from_headers(self._headers)\n   219→\n   220→    @property\n   221→    def status(self) -> str:\n   222→        return self._status\n   223→\n   224→    @property\n   225→    def status_code(self) -> int:\n   226→        return self._status_code\n   227→\n   228→    @property\n   229→    def headers(self) -> CaseInsensitiveDict:\n   230→        # NOTE(kgriffs): It would probably be better to annotate this with\n   231→        #   a generic Mapping[str, str] type, but currently there is an\n   232→        #   incompatibility with Cython that prevents us from modifying\n   233→        #   CaseInsensitiveDict to inherit from a generic MutableMapping\n   234→        #   type. This might be resolved in the future by moving\n   235→        #   the CaseInsensitiveDict implementation to the falcon.testing\n   236→        #   module so that it is no longer cythonized.\n   237→        return self._headers\n   238→\n   239→    @property\n   240→    def cookies(self) -> Dict[str, Cookie]:\n   241→        return self._cookies\n   242→\n   243→    @property\n   244→    def encoding(self) -> str:\n   245→        return self._encoding\n   246→\n   247→\n   248→class ResultBodyStream:\n   249→    \"\"\"Simple forward-only reader for a streamed test result body.\n   250→\n   251→    Args:\n   252→        chunks (list): Reference to a list of body chunks that may\n   253→            continue to be appended to as more body events are\n   254→            collected.\n   255→    \"\"\"\n   256→\n   257→    def __init__(self, chunks: Sequence[bytes]):\n   258→        self._chunks = chunks\n   259→        self._chunk_pos = 0\n   260→\n   261→    async def read(self) -> bytes:\n   262→        \"\"\"Read any data that has been collected since the last call.\n   263→\n   264→        Returns:\n   265→            bytes: data that has been collected since the last call,\n   266→            or an empty byte string if no additional data is available.\n   267→        \"\"\"\n   268→\n   269→        # NOTE(kgriffs): Yield to other tasks to give them a chance to\n   270→        #   send us more body chunks if any are available.\n   271→        #\n   272→        #   https://bugs.python.org/issue34476\n   273→        #\n   274→        await asyncio.sleep(0)\n   275→\n   276→        if self._chunk_pos >= len(self._chunks):\n   277→            return b''\n   278→\n   279→        data = b''.join(self._chunks[self._chunk_pos :])\n   280→        self._chunk_pos = len(self._chunks)\n   281→\n   282→        return data\n   283→\n   284→\n   285→class Result(_ResultBase):\n   286→    \"\"\"Encapsulates the result of a simulated request.\n   287→\n   288→    Args:\n   289→        iterable (iterable): An iterable that yields zero or more\n   290→            bytestrings, per PEP-3333\n   291→        status (str): An HTTP status string, including status code and\n   292→            reason string\n   293→        headers (list): A list of (header_name, header_value) tuples,\n   294→            per PEP-3333\n   295→\n   296→    Attributes:\n   297→        status (str): HTTP status string given in the response\n   298→        status_code (int): The code portion of the HTTP status string\n   299→        headers (CaseInsensitiveDict): A case-insensitive dictionary\n   300→            containing all the headers in the response, except for\n   301→            cookies, which may be accessed via the `cookies`\n   302→            attribute.\n   303→\n   304→            Note:\n   305→\n   306→                Multiple instances of a header in the response are\n   307→                currently not supported; it is unspecified which value\n   308→                will \"win\" and be represented in `headers`.\n   309→\n   310→        cookies (dict): A dictionary of\n   311→            :py:class:`falcon.testing.Cookie` values parsed from the\n   312→            response, by name.\n   313→        encoding (str): Text encoding of the response body, or ``None``\n   314→            if the encoding can not be determined.\n   315→        content (bytes): Raw response body, or ``bytes`` if the\n   316→            response body was empty.\n   317→        text (str): Decoded response body of type ``str``.\n   318→            If the content type does not specify an encoding, UTF-8 is\n   319→            assumed.\n   320→        json (JSON serializable): Deserialized JSON body. Will be ``None`` if\n   321→            the body has no content to deserialize. Otherwise, raises an error\n   322→            if the response is not valid JSON.\n   323→    \"\"\"\n   324→\n   325→    def __init__(self, iterable, status, headers):\n   326→        super().__init__(status, headers)\n   327→\n   328→        self._text = None\n   329→        self._content = b''.join(iterable)\n   330→\n   331→    @property\n   332→    def content(self) -> bytes:\n   333→        return self._content\n   334→\n   335→    @property\n   336→    def text(self) -> str:\n   337→        if self._text is None:\n   338→            if not self.content:\n   339→                self._text = ''\n   340→            else:\n   341→                if self.encoding is None:\n   342→                    encoding = 'UTF-8'\n   343→                else:\n   344→                    encoding = self.encoding\n   345→\n   346→                self._text = self.content.decode(encoding)\n   347→\n   348→        return self._text\n   349→\n   350→    @property\n   351→    def json(self) -> Optional[Union[dict, list, str, int, float, bool]]:\n   352→        if not self.text:\n   353→            return None\n   354→\n   355→        return json_module.loads(self.text)\n   356→\n   357→    def __repr__(self):\n   358→        content_type = self.headers.get('Content-Type', '')\n   359→\n   360→        if len(self.content) > 40:\n   361→            content = self.content[:20] + b'...' + self.content[-20:]\n   362→        else:\n   363→            content = self.content\n   364→\n   365→        args = [self.status, content_type, str(content)]\n   366→\n   367→        repr_result = ' '.join(filter(None, args))\n   368→        return 'Result<{}>'.format(repr_result)\n   369→\n   370→\n   371→class StreamedResult(_ResultBase):\n   372→    \"\"\"Encapsulates the streamed result of an ASGI request.\n   373→\n   374→    Args:\n   375→        body_chunks (list): A list of body chunks. This list may be\n   376→            appended to after a result object has been instantiated.\n   377→        status (str): An HTTP status string, including status code and\n   378→            reason string\n   379→        headers (list): A list of (header_name, header_value) tuples,\n   380→            per PEP-3333\n   381→        task (asyncio.Task): The scheduled simulated request which may or\n   382→            may not have already finished. :meth:`~.finalize`\n   383→            will await the task before returning.\n   384→        req_event_emitter (~falcon.testing.ASGIRequestEventEmitter): A reference\n   385→            to the event emitter used to simulate events sent to the ASGI\n   386→            application via its receive() method.\n   387→            :meth:`~.finalize` will cause the event emitter to\n   388→            simulate an ``'http.disconnect'`` event before returning.\n   389→\n   390→    Attributes:\n   391→        status (str): HTTP status string given in the response\n   392→        status_code (int): The code portion of the HTTP status string\n   393→        headers (CaseInsensitiveDict): A case-insensitive dictionary\n   394→            containing all the headers in the response, except for\n   395→            cookies, which may be accessed via the `cookies`\n   396→            attribute.\n   397→\n   398→            Note:\n   399→\n   400→                Multiple instances of a header in the response are\n   401→                currently not supported; it is unspecified which value\n   402→                will \"win\" and be represented in `headers`.\n   403→\n   404→        cookies (dict): A dictionary of\n   405→            :py:class:`falcon.testing.Cookie` values parsed from the\n   406→            response, by name.\n   407→        encoding (str): Text encoding of the response body, or ``None``\n   408→            if the encoding can not be determined.\n   409→        stream (ResultStream): Raw response body, as a byte stream.\n   410→    \"\"\"\n   411→\n   412→    def __init__(self, body_chunks, status, headers, task, req_event_emitter):\n   413→        super().__init__(status, headers)\n   414→\n   415→        self._task = task\n   416→        self._stream = ResultBodyStream(body_chunks)\n   417→        self._req_event_emitter = req_event_emitter\n   418→\n   419→    @property\n   420→    def stream(self) -> ResultBodyStream:\n   421→        return self._stream\n   422→\n   423→    async def finalize(self):\n   424→        \"\"\"Finalize the encapsulated simulated request.\n   425→\n   426→        This method causes the request event emitter to begin emitting\n   427→        ``'http.disconnect'`` events and then awaits the completion of the\n   428→        asyncio task that is running the simulated ASGI request.\n   429→        \"\"\"\n   430→        self._req_event_emitter.disconnect()\n   431→        await self._task\n   432→\n   433→\n   434→# NOTE(kgriffs): The default of asgi_disconnect_ttl was chosen to be\n   435→#   relatively long (5 minutes) to help testers notice when something\n   436→#   appears to be \"hang