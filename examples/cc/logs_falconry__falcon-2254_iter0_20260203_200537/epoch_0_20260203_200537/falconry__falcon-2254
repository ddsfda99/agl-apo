d_error, ValueError)\n   680→\n   681→\n   682→@pytest.mark.asyncio\n   683→async def test_accept_with_headers_not_supported(conductor):\n   684→    class Resource:\n   685→        def __init__(self):\n   686→            self.raised_error = None\n   687→\n   688→        async def on_websocket(self, req, ws):\n   689→            try:\n   690→                assert not ws.supports_accept_headers\n   691→                await ws.accept(headers={'name': 'value'})\n   692→            except Exception as ex:\n   693→                self.raised_error = ex\n   694→\n   695→    resource = Resource()\n   696→    conductor.app.add_route('/', resource)\n   697→\n   698→    async with conductor as c:\n   699→        try:\n   700→            async with c.simulate_ws(spec_version='2.0'):\n   701→                pass\n   702→        except falcon.WebSocketDisconnected:\n   703→            pass\n   704→\n   705→    assert isinstance(resource.raised_error, falcon.OperationNotAllowed)\n   706→\n   707→\n   708→@pytest.mark.asyncio\n   709→async def test_missing_ws_handler(conductor):\n   710→    class Resource:\n   711→        async def on_get(self, req, resp):\n   712→            pass\n   713→\n   714→    conductor.app.add_route('/', Resource())\n   715→\n   716→    async with conductor as c:\n   717→        with pytest.raises(falcon.WebSocketHandlerNotFound):\n   718→            async with c.simulate_ws():\n   719→                pass\n   720→\n   721→\n   722→@pytest.mark.asyncio\n   723→async def test_unexpected_param(conductor):\n   724→    class Resource:\n   725→        async def on_websocket(self, req, ws):\n   726→            pass\n   727→\n   728→    conductor.app.add_route('/{id}', Resource())\n   729→\n   730→    async with conductor as c:\n   731→        with pytest.raises(falcon.WebSocketServerError):\n   732→            async with c.simulate_ws('/DEADBEEF'):\n   733→                pass\n   734→\n   735→\n   736→@pytest.mark.asyncio\n   737→@pytest.mark.parametrize(\n  