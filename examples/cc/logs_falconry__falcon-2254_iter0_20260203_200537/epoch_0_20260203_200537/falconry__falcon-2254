vides the name and value\n   767\u2192            for the 'Set-Cookie' header.\n   768\u2192\n   769\u2192    Returns:\n   770\u2192        :py:class:`~.Result`: The result of the request\n   771\u2192    \"\"\"\n   772\u2192\n   773\u2192    path, query_string, headers, body, extras = _prepare_sim_args(\n   774\u2192        path,\n   775\u2192        query_string,\n   776\u2192        params,\n   777\u2192        params_csv,\n   778\u2192        content_type,\n   779\u2192        headers,\n   780\u2192        body,\n   781\u2192        json,\n   782\u2192        extras,\n   783\u2192    )\n   784\u2192\n   785\u2192    # ---------------------------------------------------------------------\n   786\u2192    # NOTE(kgriffs): 'http' scope\n   787\u2192    # ---------------------------------------------------------------------\n   788\u2192    content_length = None\n   789\u2192\n   790\u2192    if body is not None:\n   791\u2192        if isinstance(body, str):\n   792\u2192            body = body.encode()\n   793\u2192\n   794\u2192        content_length = len(body)\n   795\u2192\n   796\u2192    http_scope = helpers.create_scope(\n   797\u2192        path=path,\n   798\u2192        query_string=query_string,\n   799\u2192        method=method,\n   800\u2192        headers=headers,\n   801\u2192        host=host,\n   802\u2192        scheme=protocol,\n   803\u2192        port=port,\n   804\u2192        http_version=http_version,\n   805\u2192        remote_addr=remote_addr,\n   806\u2192        root_path=root_path,\n   807\u2192        content_length=content_length,\n   808\u2192        cookies=cookies,\n   809\u2192    )\n   810\u2192\n   811\u2192    if 'method' in extras and extras['method'] != method.upper():\n   812\u2192        raise ValueError(\n   813\u2192            'ASGI scope extras may not override the request method. '\n   814\u2192            'Please use the method parameter.'\n   815\u2192        )\n   816\u2192\n   817\u2192    http_scope.update(extr