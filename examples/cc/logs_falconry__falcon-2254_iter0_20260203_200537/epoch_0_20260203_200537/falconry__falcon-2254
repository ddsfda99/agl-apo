from falcon.util.misc import is_python_func\n    40\u2192from falcon.util.sync import _should_wrap_non_coroutines\n    41\u2192from falcon.util.sync import _wrap_non_coroutine_unsafe\n    42\u2192from falcon.util.sync import get_running_loop\n    43\u2192from falcon.util.sync import wrap_sync_to_async\n    44\u2192\n    45\u2192from ._asgi_helpers import _validate_asgi_scope\n    46\u2192from ._asgi_helpers import _wrap_asgi_coroutine_func\n    47\u2192from .multipart import MultipartForm\n    48\u2192from .request import Request\n    49\u2192from .response import Response\n    50\u2192from .structures import SSEvent\n    51\u2192from .ws import http_status_to_ws_code\n    52\u2192from .ws import WebSocket\n    53\u2192from .ws import WebSocketOptions\n    54\u2192\n    55\u2192__all__ = ['App']\n    56\u2192\n    57\u2192\n    58\u2192# TODO(vytas): Clean up these foul workarounds before the 4.0 release.\n    59\u2192MultipartFormHandler._ASGI_MULTIPART_FORM = MultipartForm  # type: ignore\n    60\u2192\n    61\u2192_EVT_RESP_EOF = {'type': EventType.HTTP_RESPONSE_BODY}\n    62\u2192\n    63\u2192_BODILESS_STATUS_CODES = frozenset([100, 101, 204, 304])\n    64\u2192\n    65\u2192_TYPELESS_STATUS_CODES = frozenset([204, 304])\n    66\u2192\n    67\u2192_FALLBACK_WS_ERROR_CODE = 3011\n    68\u2192\n    69\u2192\n    70\u2192class App(falcon.app.App):\n    71\u2192    \"\"\"The main entry point into a Falcon-based ASGI app.\n    72\u2192\n    73\u2192    Each App instance provides a callable\n    74\u2192    `ASGI <https://asgi.readthedocs.io/en/latest/>`_ interface\n    75\u2192    and a routing engine  (for WSGI applications, see\n    76\u2192    :class:`falcon.App`).\n    77\u2192\n    78\u2192    Keyword Arguments:\n    79\u2192        media_type (str): Default media type to use when initializing\n    80\u2192            :py:class:`~.RequestOptions` and\n    81\u2192            :py:class:`~.ResponseOptions`. The ``falcon``\n    82\u2192            module provides a number of constants for common media types,\n    83\u2192            such as ``falcon.MEDIA_MSGPACK``, ``falcon.MEDIA_YAML``,\n    84\u2192            ``falcon.MEDIA_XML``, etc.\n    85\u2192        middleware: Either a single middleware component object or an iterable\n    86\u2192            of objects (instantiated classes) that implement the\n    87\u2192            middleware component interface shown below.\n    88\u2192\n    89\u2192            The interface provides support for handling both ASGI worker\n    90\u2192            lifespan events and per-request events. However, because lifespan\n    91\u2192            events are an optional part of the ASGI specification, they may or\n    92\u2192            may not fire depending on your ASGI server.\n    93\u2192\n    94\u2192            A lifespan event handler can be used to perform startup or shutdown\n    95\u2192            activities for the main event loop. An example of this would be\n    96\u2192            creating a connection pool and subsequently closing the connection\n    97\u2192            pool to release the connections.\n    98\u2192\n    99\u2192            Note:\n   100\u2192                In a multi-process environment, lifespan events will be\n   101\u2192                triggered independently for the individual event loop associated\n   102\u2192                with each process.\n   103\u2192\n   104\u2192            Note:\n   105\u2192                The framework requires that all middleware methods be\n   106\u2192                implemented as coroutine functions via `async def`. However,\n   107\u2192                it is possible to implement middleware classes that support\n   108\u2192                both ASGI and WSGI apps by distinguishing the ASGI methods\n   109\u2192                with an `*_async` postfix (see also:\n   110\u2192                :ref:`Middleware <middleware>`).\n   111\u2192\n   112\u2192            It is only necessary to implement the methods for the events you\n   113\u2192            would like to handle; Falcon simply skips over any missing\n   114\u2192            middleware methods::\n   115\u2192\n   116\u2192                class ExampleComponent:\n   117\u2192                    async def process_startup(self, scope, event):\n   118\u2192                        \\\"\\\"\\\"Process the ASGI lifespan startup event.\n   119\u2192\n   120\u2192                        Invoked when the server is ready to start up and\n   121\u2192                        receive connections, but before it has started to\n   122\u2192                        do so.\n   123\u2192\n   124\u2192                        To halt startup processing and signal to the server that it\n   125\u2192                        should terminate, simply raise an exception and the\n   126\u2192                        framework will convert it to a \"lifespan.startup.failed\"\n   127\u2192                        event for the server.\n   128\u2192\n   129\u2192                        Args:\n   130\u2192                            scope (dict): The ASGI scope dictionary for the\n   131\u2192                                lifespan protocol. The lifespan scope exists\n   132\u2192                                for the duration of the event loop.\n   133\u2192                            event (dict): The ASGI event dictionary for the\n   134\u2192                                startup event.\n   135\u2192                        \\\"\\\"\\\"\n   136\u2192\n   137\u2192                    async def process_shutdown(self, scope, event):\n   138\u2192                        \\\"\\\"\\\"Process the ASGI lifespan shutdown event.\n   139\u2192\n   140\u2192                        Invoked when the server has stopped accepting\n   141\u2192                        connections and closed all active connections.\n   142\u2192\n   143\u2192                        To halt shutdown processing and signal to the server\n   144\u2192                        that it should immediately terminate, simply raise an\n   145\u2192                        exception and the framework will convert it to a\n   146\u2192                        \"lifespan.shutdown.failed\" event for the server.\n   147\u2192\n   148\u2192                        Args:\n   149\u2192                            scope (dict): The ASGI scope dictionary for the\n   150\u2192                                lifespan protocol. The lifespan scope exists\n   151\u2192                                for the duration of the event loop.\n   152\u2192                            event (dict): The ASGI event dictionary for the\n   153\u2192                                shutdown event.\n   154\u2192                        \\\"\\\"\\\"\n   155\u2192\n   156\u2192                    async def process_request(self, req, resp):\n   157\u2192                        \\\"\\\"\\\"Process the request before routing it.\n   158\u2192\n   159\u2192                        Note:\n   160\u2192                            Because Falcon routes each request based on\n   161\u2192                            req.path, a request can be effectively re-routed\n   162\u2192                            by setting that attribute to a new value from\n   163\u2192                            within process_request().\n   164\u2192\n   165\u2192                        Args:\n   166\u2192                            req: Request object that will eventually be\n   167\u2192                                routed to an on_* responder method.\n   168\u2192                            resp: Response object that will be routed to\n   169\u2192                                the on_* responder.\n   170\u2192                        \\\"\\\"\\\"\n   171\u2192\n   172\u2192                    async def process_resource(self, req, resp, resource, params):\n   173\u2192                        \\\"\\\"\\\"Process the request and resource *after* routing.\n   174\u2192\n   175\u2192                        Note:\n   176\u2192                            This method is only called when the request matches\n   177\u2192                            a route to a resource.\n   178\u2192\n   179\u2192                        Args:\n   180\u2192                            req: Request object that will be passed to the\n   181\u2192                                routed responder.\n   182\u2192                            resp: Response object that will be passed to the\n   183\u2192                                responder.\n   184\u2192                            resource: Resource object to which the request was\n   185\u2192                                routed. May be ``None`` if no route was found for\n   186\u2192                                the request.\n   187\u2192                            params: A dict-like object representing any\n   188\u2192                                additional params derived from the route's URI\n   189\u2192                                template fields, that will be passed to the\n   190\u2192                                resource's responder method as keyword\n   191\u2192                                arguments.\n   192\u2192                        \\\"\\\"\\\"\n   193\u2192\n   194\u2192                    async def process_response(self, req, resp, resource, req_succeeded)\n   195\u2192                        \\\"\\\"\\\"Post-processing of the response (after routing).\n   196\u2192\n   197\u2192                        Args:\n   198\u2192                            req: Request object.\n   199\u2192                            resp: Response object.\n   200\u2192                            resource: Resource object to which the request was\n   201\u2192                                routed. May be ``None`` if no route was found\n   202\u2192                                for the request.\n   203\u2192                            req_succeeded: True if no exceptions were raised\n   204\u2192                                while the framework processed and routed the\n   205\u2192                                request; otherwise False.\n   206\u2192                        \\\"\\\"\\\"\n   207\u2192\n   208\u2192            (See also: :ref:`Middleware <middleware>`)\n   209\u2192\n   210\u2192        request_type: ``Request``-like class to use instead\n   211\u2192            of Falcon's default class. Among other things, this feature\n   212\u2192            affords inheriting from :class:`falcon.asgi.Request` in order\n   213\u2192            to override the ``context_type`` class variable\n   214\u2192            (default: :class:`falcon.asgi.Request`)\n   215\u2192\n   216\u2192        response_type: ``Response``-like class to use\n   217\u2192            instead of Falcon's default class (default:\n   218\u2192            :class:`falcon.asgi.Response`)\n   219\u2192\n   220\u2192        router (object): An instance of a custom router\n   221\u2192            to use in lieu of the default engine.\n   222\u2192            (See also: :ref:`Custom Routers <routing_custom>`)\n   223\u2192\n   224\u2192        independent_middleware (bool): Set to ``False`` if response\n   225\u2192            middleware should not be executed independently of whether or\n   226\u2192            not request middleware raises an exception (default\n   227\u2192            ``True``). When this option is set to ``False``, a middleware\n   228\u2192            component's ``process_response()`` method will NOT be called\n   229\u2192            when that same component's ``process_request()`` (or that of\n   230\u2192            a component higher up in the stack) raises an exception.\n   231\u2192\n   232\u2192        cors_enable (bool): Set this flag to ``True`` to enable a simple\n   233\u2192            CORS policy for all responses, including support for preflighted\n   234\u2192            requests. An instance of :py:class:`..CORSMiddleware` can instead be\n   235\u2192            passed to the middleware argument to customize its behaviour.\n   236\u2192            (default ``False``).\n   237\u2192            (See also: :ref:`CORS <cors>`)\n   238\u2192\n   239\u2192        sink_before_static_route (bool): Indicates if the sinks should be processed\n   240\u2192            before (when ``True``) or after (when ``False``) the static routes.\n   241\u2192            This has an effect only if no route was matched. (default ``True``)\n   242\u2192\n   243\u2192    Attributes:\n   244\u2192        req_options: A set of behavioral options related to incoming\n   245\u2192            requests. (See also: :py:class:`~.RequestOptions`)\n   246\u2192        resp_options: A set of behavioral options related to outgoing\n   247\u2192            responses. (See also: :py:class:`~.ResponseOptions`)\n   248\u2192        ws_options: A set of behavioral options related to WebSocket\n   249\u2192            connections. (See also: :py:class:`~.WebSocketOptions`)\n   250\u2192        router_options: Configuration options for the router. If a\n   251\u2192            custom router is in use, and it does not expose any\n   252\u2192            configurable options, referencing this attribute will raise\n   253\u2192            an instance of ``AttributeError``.\n   254\u2192\n   255\u2192            (See also: :ref:`CompiledRouterOptions <compiled_router_options>`)\n   256\u2192    \"\"\"\n   257\u2192\n   258\u2192    _STATIC_ROUTE_TYPE = falcon.routing.StaticRouteAsync\n   259\u2192\n   260\u2192    # NOTE(kgriffs): This makes it easier to tell what we are dealing with\n   261\u2192    #   without having to import falcon.asgi.\n   262\u2192    _ASGI = True\n   263\u2192\n   264\u2192    _default_responder_bad_request = falcon.responders.bad_request_async\n   265\u2192    _default_responder_path_not_found = falcon.responders.path_not_found_async\n   266\u2192\n   267\u2192    __slots__ = (\n   268\u2192        '_standard_response_type',\n   269\u2192        'ws_options',\n   270\u2192    )\n   271\u2192\n   272\u2192    def __init__(self, *args, request_type=Request, response_type=Response, **kwargs):\n   273\u2192        super().__init__(\n   274\u2192            *args, request_type=request_type, response_type=response_type, **kwargs\n   275\u2192        )\n   276\u2192\n   277\u2192        self.ws_options = WebSocketOptions()\n   278\u2192        self._standard_response_type = response_type is Response\n   279\u2192\n   280\u2192        self.add_error_handler(\n   281\u2192            WebSocketDisconnected, self._ws_disconnected_error_handler\n   282\u2192        )\n   283\u2192\n   284\u2192    @_wrap_asgi_coroutine_func\n   285\u2192    async def __call__(  # noqa: C901\n   286\u2192        self,\n   287\u2192        scope: dict,\n   288\u2192        receive: Callable[[], Awaitable[dict]],\n   289\u2192        send: Callable[[dict], Awaitable[None]],\n   290\u2192    ) -> None:\n   291\u2192        # NOTE(kgriffs): The ASGI spec requires the 'type' key to be present.\n   292\u2192        scope_type = scope['type']\n   293\u2192\n   294\u2192        # PERF(kgriffs): This should usually be present, so use a\n   295\u2192        #   try..except\n   296\u2192        try:\n   297\u2192            asgi_info = scope['asgi']\n   298\u2192        except KeyError:\n   299\u2192            # NOTE(kgriffs): According to the ASGI spec, \"2.0\" is\n   300\u2192            #   the default version.\n   301\u2192            asgi_info = scope['asgi'] = {'version': '2.0'}\n   302\u2192\n   303\u2192        try:\n   304\u2192            spec_version = asgi_info['spec_version']\n   305\u2192        except KeyError:\n   306\u2192            spec_version = None\n   307\u2192\n   308\u2192        try:\n   309\u2192            http_version = scope['http_version']\n   310\u2192        except KeyError:\n   311\u2192            http_version = '1.1'\n   312\u2192\n   313\u2192        spec_version = _validate_asgi_scope(scope_type, spec_version, http_version)\n   314\u2192\n   315\u2192        if scope_type != 'http':\n   316\u2192            # PERF(vytas): Evaluate the potentially recurring WebSocket path\n   317\u2192            #   first (in contrast to one-shot lifespan events).\n   318\u2192            if scope_type == 'websocket':\n   319\u2192                await self._handle_websocket(spec_version, scope, receive, send)\n   320\u2192                return\n   321\u2192\n   322\u2192            # NOTE(vytas): Else 'lifespan' -- other scope_type values have been\n   323\u2192            #   eliminated by _validate_asgi_scope at this point.\n   324\u2192            await self._call_lifespan_handlers(spec_version, scope, receive, send)\n   325\u2192            return\n   326\u2192\n   327\u2192        # NOTE(kgriffs): Per the ASGI spec, we should not proceed with request\n   328\u2192        #   processing until after we receive an initial 'http.request' event.\n   329\u2192        first_event = await receive()\n   330\u2192        first_event_type = first_event['type']\n   331\u2192        # PERF(vytas): Inline the value of EventType.HTTP_DISCONNECT in this\n   332\u2192        #   critical code path.\n   333\u2192        if first_event_type == 'http.disconnect':\n   334\u2192            # NOTE(kgriffs): Bail out immediately to minimize resource usage\n   335\u2192            return\n   336\u2192\n   337\u2192        # NOTE(kgriffs): This is the only other type defined by the ASGI spec,\n   338\u2192        #   but we just assert it to make it easier to track down a potential\n   339\u2192        #   incompatibility with a future spec version.\n   340\u2192        # PERF(vytas): Inline the value of EventType.HTTP_REQUEST in this\n   341\u2192        #   critical code path.\n   342\u2192        assert first_event_type == 'http.request'\n   343\u2192\n   344\u2192        req = self._request_type(\n   345\u2192            scope, receive, first_event=first_event, options=self.req_options\n   346\u2192        )\n   347\u2192        resp = self._response_type(options=self.resp_options)\n   348\u2192\n   349\u2192        resource = None\n   350\u2192        responder: Optional[Callable] = None\n   351\u2192        params: dict = {}\n   352\u2192\n   353\u2192        dependent_mw_resp_stack: list = []\n   354\u2192        mw_req_stack, mw_rsrc_stack, mw_resp_stack = self._middleware\n   355\u2192\n   356\u2192        req_succeeded = False\n   357\u2192\n   358\u2192        try:\n   359\u2192            if req.method in self._META_METHODS:\n   360\u2192                raise HTTPBadRequest()\n   361\u2192\n   362\u2192            # NOTE(ealogar): The execution of request middleware\n   363\u2192            # should be before routing. This will allow request mw\n   364\u2192            # to modify the path.\n   365\u2192            # NOTE: if flag set to use independent middleware, execute\n   366\u2192            # request middleware independently. Otherwise, only queue\n   367\u2192            # response middleware after request middleware succeeds.\n   368\u2192            if self._independent_middleware:\n   369\u2192                for process_request in mw_req_stack:\n   370\u2192                    await process_request(req, resp)\n   371\u2192\n   372\u2192                    if resp.complete:\n   373\u2192                        break\n   374\u2192            else:\n   375\u2192                for process_request, process_response in mw_req_stack:\n   376\u2192                    if process_request and not resp.complete:\n   377\u2192                        await process_request(req, resp)\n   378\u2192\n   379\u2192                    if process_response:\n   380\u2192                        dependent_mw_resp_stack.insert(0, process_response)\n   381\u2192\n   382\u2192            if not resp.complete:\n   383\u2192                # NOTE(warsaw): Moved this to inside the try except\n   384\u2192                # because it is possible when using object-based\n   385\u2192                # traversal for _get_responder() to fail.  An example is\n   386\u2192                # a case where an object does not have the requested\n   387\u2192                # next-hop child resource. In that case, the object\n   388\u2192                # being asked to dispatch to its child will raise an\n   389\u2192                # HTTP exception signaling the problem, e.g. a 404.\n   390\u2192                responder, params, resource, req.uri_template = self._get_responder(req)\n   391\u2192\n   392\u2192        except Exception as ex:\n   393\u2192            if not await self._handle_exception(req, resp, ex, params):\n   394\u2192                raise\n   395\u2192\n   396\u2192        else:\n   397\u2192            try:\n   398\u2192                # NOTE(kgriffs): If the request did not match any\n   399\u2192                # route, a default responder is returned and the\n   400\u2192                # resource is None. In that case, we skip the\n   401\u2192                # resource middleware methods. Resource will also be\n   402\u2192                # None when a middleware method already set\n   403\u2192                # resp.complete to True.\n   404\u2192                if resource:\n   405\u2192                    # Call process_resource middleware methods.\n   406\u2192                    for process_resource in mw_rsrc_stack:\n   407\u2192                        await process_resource(req, resp, resource, params)\n   408\u2192\n   409\u2192                        if resp.complete:\n   410\u2192                            break\n   411\u2192\n   412\u2192                if not resp.complete:\n   413\u2192                    await responder(req, resp, **params)  # type: ignore\n   414\u2192\n   415\u2192                req_succeeded = True\n   416\u2192\n   417\u2192            except Exception as ex:\n   418\u2192                if not await self._handle_exception(req, resp, ex, params):\n   419\u2192                    raise\n   420\u2192\n   421\u2192        # Call process_response middleware methods.\n   422\u2192        for process_response in mw_resp_stack or dependent_mw_resp_stack:\n   423\u2192            try:\n   424\u2192                await process_response(req, resp, resource, req_succeeded)\n   425\u2192\n   426\u2192            except Exception as ex:\n   427\u2192                if not await self._handle_exception(req, resp, ex, params):\n   428\u2192                    raise\n   429\u2192\n   430\u2192                req_succeeded = False\n   431\u2192\n   432\u2192        data = b''\n   433\u2192\n   434\u2192        try:\n   435\u2192            # NOTE(vytas): It is only safe to inline Response.render_body()\n   436\u2192            #   where we can be sure it hasn't been overridden, either directly\n   437\u2192            #   or by modifying the behavior of its dependencies.\n   438\u2192            if self._standard_response_type:\n   439\u2192                # PERF(vytas): inline Response.render_body() in this critical code\n   440\u2192                #   path in order to shave off an await.\n   441\u2192                text = resp.text\n   442\u2192                if text is None:\n   443\u2192                    data = resp._data\n   444\u2192\n   445\u2192                    if data is None and resp._media is not None:\n   446\u2192                        # NOTE(kgriffs): We use a special _UNSET singleton since\n   447\u2192                        #   None is ambiguous (the media handler might return None).\n   448\u2192                        if resp._media_rendered is _UNSET:\n   449\u2192                            opt = resp.options\n   450\u2192                            if not resp.content_type:\n   451\u2192                                resp.content_type = opt.default_media_type\n   452\u2192\n   453\u2192                            handler, serialize_sync, _ = opt.media_handlers._resolve(\n   454\u2192                                resp.content_type, opt.default_media_type\n   455