\u2192):\n   309\u2192    sample_data = os.urandom(64 * 1024)\n   310\u2192\n   311\u2192    class Resource:\n   312\u2192        def __init__(self):\n   313\u2192            self.data_received = asyncio.Event()\n   314\u2192            self.times_called = 0\n   315\u2192            self.data = None\n   316\u2192            self.ws_ready = None\n   317\u2192            self.ws_state = None\n   318\u2192            self.ws_closed = None\n   319\u2192            self.ws_client_close_code = None\n   320\u2192\n   321\u2192        async def on_websocket(self, req, ws):\n   322\u2192            self.times_called += 1\n   323\u2192\n   324\u2192            await ws.accept()\n   325\u2192\n   326\u2192            while True:\n   327\u2192                try:\n   328\u2192                    if direction == 'send':\n   329\u2192                        await ws.send_data(sample_data)\n   330\u2192\n   331\u2192                        if explicit_close_server:\n   332\u2192                            await ws.close(4099)\n   333\u2192                    else:\n   334\u2192                        self.data = await ws.receive_data()\n   335\u2192\n   336\u2192                        if explicit_close_server:\n   337\u2192                            # NOTE(kgriffs): We call ws.receive_data() again here in\n   338\u2192                            #   order to test coverage of the logic that handles\n   339\u2192                            #   the case of a closed connection while waiting on\n   340\u2192                            #   more data.\n   341\u2192                            recv_task = falcon.create_task(ws.receive_data())\n   342\u2192                            # Ensure recv_task() has a chance to get ahead\n   343\u2192                            await asyncio.sleep(0)\n   344\u2192                            ws_close = ws.close(4099)\n   345\u2192                            ws_close = asyncio.create_task(ws_close)\n   346\u2192                            await asyncio.wait([recv_task, ws_close])\n   347\u2192\n   348\u2192                        self.data_received.set()\n   349\u2192\n   350\u2192                except falcon.WebSocketDisconnected as ex:\n   351\u2192                    self.ws_ready = ws.ready\n   352\u2192                    self.ws_client_close_code = ex.code\n   353\u2192                    self.ws_state = ws._state\n   354\u2192                    self.ws_closed = ws.closed\n   355\u2192                    break\n   356\u2192\n   357\u2192    resource = Resource()\n   358\u2192    conductor.app.add_route('/', resource)\n   359\u2192\n   360\u2192    disconnect_raised = False\n   361\u2192\n   362\u2192    async with conductor as c:\n   363\u2192        try:\n   364\u2192            async with c.simulate_ws('/') as ws:\n   365\u2192                if direction == 'send':\n   366\u2192                    received_data = await ws.receive_data()\n   367\u2192                    assert received_data == sample_data\n   368\u2192                else:\n   369\u2192                    await ws.send_data(sample_data)\n   370\u2192                    await resource.data_received.wait()\n   371\u2192                    assert resource.data == sample_data\n   372\u2192\n   373\u2192                # NOTE(vytas): When testing the case where the server\n   374\u2192                #   explicitly closes the connection, try to receive some data\n   375\u2192                #   before closing from the client side (and potentially\n   376\u2192                #   winning the async race of which side closes first).\n   377\u2192                if explicit_close_server:\n   378\u2192                    await ws.receive_data()\n   379\u2192\n   380\u2192                if explicit_close_client:\n   381\u2192                    await ws.close(4042)\n   382\u2192\n   383\u2192        except falcon.WebSocketDisconnected as ex:\n   384\u2192            disconnect_raised = True\n   385\u2192            assert explicit_close_server\n   386\u2192            assert ex.code == 4099\n   387\u2192\n   388\u2192        if direction == 'send' and explicit_close_server:\n   389\u2192            assert disconnect_raised\n   390\u2192\n   391\u2192        code_expected = CloseCode.NORMAL\n   392\u2192\n   393\u2192        if explicit_close_server:\n   394\u2192            code_expected = 4099\n   395\u2192        elif explicit_close_client:\n   396\u2192            code_expected = 4042\n   397\u2192\n   398\u2192        assert resource.ws_client_close_code == code_expected\n   399\u2192        assert ws.close_code == code_expected\n   400\u2192\n   401\u2192    assert resource.times_called == 1\n   402\u2192    assert resource.ws_state == ServerWebSocketState.CLOSED\n   403\u2192    assert resource.ws_closed\n   404\u2192    assert resource.ws_ready is False\n   405\u2192\n   406\u2192\n   407\u2192@pytest.mark.asyncio\n   408\u2192@pytest.mark.parametrize('custom_text', [True, False])\n   409\u2192@pytest.mark.parametrize('custom_data', [True, False])\n   410\u2192async def test_media(custom_text, custom_data, conductor):  # NOQA: C901\n   411\u2192    # TODO(kgriffs): Refactor to reduce McCabe score\n   412\u2192\n   413\u2192    sample_doc = {\n   414\u2192        'answer': 42,\n   415\u2192        'runes': b'\\xe1\\x9a\\xa0\\xe1\\x9b\\x87\\xe1\\x9a\\xbb'.decode(),\n   416\u2192        'ascii': 'hello world',\n   417\u2192    }\n   418\u2192\n   419\u2192    sample_doc_bin = sample_doc.copy()\n   420\u2192    sample_doc_bin['bits'] = os.urandom(32)\n   421\u2192    sample_doc_bin['array'] = [0, 1, 2]\n   422\u2192\n   423\u2192    class Resource:\n   424\u2192        def __init__(self):\n   425\u2192            self.finished = asyncio.Event()\n   426\u2192            self.docs_received = []\n   427\u2192            self.deserialize_error_count = 0\n   428\u2192\n   429\u2192        async def on_websocket(self, req, ws):\n   430\u2192            try:\n   431\u2192                await ws.accept()\n   432\u2192\n   433\u2192                await ws.send_media(sample_doc)\n   434\u2192                self.docs_received.append(await ws.receive_media())\n   435\u2192                await ws.send_media(sample_doc, falcon.WebSocketPayloadType.TEXT)\n   436\u2192                self.docs_received.append(await ws.receive_media())\n   437\u2192\n   438\u2192                await ws.send_media(sample_doc_bin, falcon.WebSocketPayloadType.BINARY)\n   439\u2192                self.docs_received.append(await ws.receive_media())\n   440\u2192\n   441\u2192                for __ in range(3):\n   442\u2192                    try:\n   443\u2192                        await ws.receive_media()\n   444\u2192                    except ValueError:\n   445\u2192                        self.deserialize_error_count += 1\n   446\u2192            finally:\n   447\u2192                self.finished.set()\n   448\u2192\n   449\u2192    app = conductor.app\n   450\u2192\n   451\u2192    resource = Resource()\n   452\u2192    app.add_route('/', resource)\n   453\u2192\n   454\u2192    if custom_text:\n   455\u2192        if rapidjson is None:\n   456\u2192            pytest.skip('rapidjson is required for this test')\n   457\u2192\n   458\u2192        # Let's say we want to use a faster JSON library. You could also use this\n   459\u2192        #   pattern to add serialization support for custom types that aren't\n   460\u2192        #   normally JSON-serializable out of the box.\n   461\u2192        class RapidJSONHandler(media.TextBaseHandlerWS):\n   462\u2192            def serialize(self, media: object) -> str:\n   463\u2192                return rapidjson.dumps(media, ensure_ascii=False)\n   464\u2192\n   465\u2192            # The raw TEXT payload will be passed as a Unicode string\n   466\u2192            def deserialize(self, payload: str) -> object:\n   467\u2192                return rapidjson.loads(payload)\n   468\u2192\n   469\u2192        app.ws_options.media_handlers[falcon.WebSocketPayloadType.TEXT] = (\n   470\u2192            RapidJSONHandler()\n   471\u2192        )\n   472\u2192\n   473\u2192    if custom_data:\n   474\u2192\n   475\u2192        class CBORHandler(media.BinaryBaseHandlerWS):\n   476\u2192            def serialize(self, media: object) -> bytes:\n   477\u2192                return cbor2.dumps(media)\n   478\u2192\n   479\u2192            # The raw BINARY payload will be passed as a byte string\n   480\u2192            def deserialize(self, payload: bytes) -> object:\n   481\u2192                return cbor2.loads(payload)\n   482\u2192\n   483\u2192        app.ws_options.media_handlers[falcon.WebSocketPayloadType.BINARY] = (\n   484\u2192            CBORHandler()\n   485\u2192        )\n   486\u2192\n   487\u2192    async with conductor as c:\n   488\u2192        async with c.simulate_ws() as ws:\n   489\u2192            for __ in range(2):\n   490\u2192                doc = await ws.receive_json()\n   491\u2192                await ws.send_json(doc)\n   492\u2192\n   493\u2192            if custom_data:\n   494\u2192                data = await ws.receive_data()\n   495\u2192                cbor2.loads(data)  # NOTE(kgriffs): Validate serialization format\n   496\u2192                await ws.send_data(data)\n   497\u2192            else:\n   498\u2192                doc = await ws.receive_msgpack()\n   499\u2192                await ws.send_msgpack(doc)\n   500\u2192\n   501\u2192            # NOTE(kgriffs): The first one will work, but we include it to\n   502\u2192            #    ensure we aren't getting any false-positives.\n   503\u2192            await ws.send_text('\"DEADBEEF\"')\n   504\u2192            await ws.send_text('DEADBEEF')\n   505\u2192            await ws.send_data(b'\\xde\\xad\\xbe\\xef')\n   506\u2192\n   507\u2192            await resource.finished.wait()\n   508\u2192\n   509\u2192    assert resource.deserialize_error_count == 2\n   510\u2192\n   511\u2192    assert len(resource.docs_received) == 3\n   512\u2192    assert resource.docs_received[0] == sample_doc\n   513\u2192\n   514\u2192    expected = [sample_doc, sample_doc, sample_doc_bin]\n   515\u2192    for doc, doc_expected in zip(resource.docs_received, expected):\n   516\u2192        assert doc == doc_expected\n   517\u2192\n   518\u2192\n   519\u2192@pytest.mark.asyncio\n   520\u2192@pytest.mark.parametrize('sample_data', [b'123', b'', b'\\xe1\\x9a\\xa0\\xe1', b'\\0'])\n   521\u2192async def test_send_receive_data(sample_data, conductor):\n   522\u2192    class Resource:\n   523\u2192        def __init__(self):\n   524\u2192            self.error_count = 0\n   525\u2192\n   526\u2192        async def on_websocket(self, req, ws):\n   527\u2192            await ws.accept()\n   528\u2192\n   529\u2192            await ws.send_data(await ws.receive_data())\n   530\u2192            await ws.send_data(bytearray(await ws.receive_data()))\n   531\u2192            await ws.send_data(memoryview(await ws.receive_data()))\n   532\u2192\n   533\u2192            for c in (ws.receive_data, ws.receive_media):\n   534\u2192                for __ in range(2):\n   535\u2192                    try:\n   536\u2192                        await c()\n   537\u2192                    except falcon.PayloadTypeError:\n   538\u2192                        self.error_count += 1\n   539\u2192\n   540\u2192    resource = Resource()\n   541\u2192    conductor.app.add_route('/', resource)\n   542\u2192\n   543\u2192    async with conductor as c:\n   544\u2192        async with c.simulate_ws() as ws:\n   545\u2192            await ws.send_data(sample_data)\n   546\u2192            await ws.send_data(bytearray(sample_data))\n   547\u2192            await ws.send_data(memoryview(sample_data))\n   548\u2192\n   549\u2192            for __ in range(2):\n   550\u2192                ws._collected_client_events.append({'type': EventType.WS_RECEIVE})\n   551\u2192                ws._collected_client_events.append(\n   552\u2192                    {'type': EventType.WS_RECEIVE, 'bytes': None}\n   553\u2192                )\n   554\u2192\n   555\u2192            for __ in range(3):\n   556\u2192                assert (await ws.receive_data()) == sample_data\n   557\u2192\n   558\u2192    assert resource.error_count == 4\n   559\u2192\n   560\u2192\n   561\u2192@pytest.mark.asyncio\n   562\u2192@pytest.mark.parametrize(\n   563\u2192    'subprotocols',\n   564\u2192    [\n   565\u2192        ['SIS508'],\n   566\u2192        ('DEADBEEF', 'SIS508'),\n   567\u2192        [],\n   568\u2192        None,\n   569\u2192    ],\n   570\u2192)\n   571\u2192async def test_subprotocol(subprotocols, conductor):\n   572\u2192    class Resource:\n   573\u2192        def __init__(self):\n   574\u2192            self.test_complete = asyncio.Event()\n   575\u2192\n   576\u2192        async def on_websocket(self, req, ws):\n   577\u2192            subs = ws.subprotocols\n   578\u2192            assert isinstance(subs, tuple)\n   579\u2192\n   580\u2192            selected = subs[0] if subs else None\n   581\u2192            await ws.accept(subprotocol=selected)\n   582\u2192\n   583\u2192            await self.test_complete.wait()\n   584\u2192\n   585\u2192    resource = Resource()\n   586\u2192    conductor.app.add_route('/', resource)\n   587\u2192\n   588\u2192    async with conductor as c:\n   589\u2192        async with c.simulate_ws(subprotocols=subprotocols) as ws:\n   590\u2192            try:\n   591\u2192                if not subprotocols:\n   592\u2192                    assert ws.subprotocol is None\n   593\u2192                else:\n   594\u2192                    assert ws.subprotocol == subprotocols[0]\n   595\u2192            finally:\n   596\u2192                resource.test_complete.set()\n   597\u2192\n   598\u2192\n   599\u2192@pytest.mark.asyncio\n   600\u2192@pytest.mark.parametrize(\n   601\u2192    'headers',\n   602\u2192    [\n   603\u2192        None,\n   604\u2192        [],\n   605\u2192        iter([]),\n   606\u2192        iter([iter(['X-Name', 'Value']), ('NAME', 'Value'), ('NAME', 'Value')]),\n   607\u2192        (['X-Name', 'Value'], ('NAME', 'Value'), ('NAME', 'Value')),\n   608\u2192        {'NAME': 'value'},\n   609\u2192        {'NAME': 'value', 'NameToo': 'ValueToo'},\n   610\u2192    ],\n   611\u2192)\n   612\u2192async def test_accept_with_headers(headers, conductor):\n   613\u2192    class Resource:\n   614\u2192        def __init__(self):\n   615\u2192            self.test_complete = asyncio.Event()\n   616\u2192\n   617\u2192        async def on_websocket(self, req, ws):\n   618\u2192            await ws.accept(headers=headers)\n   619\u2192            await self.test_complete.wait()\n   620\u2192\n   621\u2192    resource = Resource()\n   622\u2192    conductor.app.add_route('/', resource)\n   623\u2192\n   624\u2192    async with conductor as c:\n   625\u2192        async with c.simulate_ws() as ws:\n   626\u2192            try:\n   627\u2192                if not headers:\n   628\u2192                    assert ws.headers is None\n   629\u2192                else:\n   630\u2192                    headers_in = headers\n   631\u2192                    if isinstance(headers, dict):\n   632\u2192                        headers_in = headers.items()\n   633\u2192\n   634\u2192                    for (name_in, value_in), (name_out, value_out) in zip(\n   635\u2192                        headers_in, ws.headers\n   636\u2192                    ):\n   637\u2192                        name_out = name_out.decode()\n   638\u2192                        value_out = value_out.decode()\n   639\u2192\n   640\u2192                        assert name_out.islower()\n   641\u2192                        assert name_in.lower() == name_out\n   642\u2192                        assert value_in == value_out\n   643\u2192\n   644\u2192            finally:\n   645\u2192                resource.test_complete.set()\n   646\u2192\n   647\u2192\n   648\u2192@pytest.