lient.simulate_head('/messages')\n  1930→\n  1931→    For convenience, :class:`TestClient` also exposes shorthand aliases without\n  1932→    the ``simulate_`` prefix. Just as with a typical Python HTTP client, it is\n  1933→    possible to simply call::\n  1934→\n  1935→        client = TestClient(app)\n  1936→        client.get('/messages')\n  1937→        client.request('LOCK', '/files/first')\n  1938→\n  1939→    Note:\n  1940→        The methods all call ``self.simulate_request()`` for convenient\n  1941→        overriding of request preparation by child classes.\n  1942→\n  1943→    Note:\n  1944→        In the case of an ASGI request, this class will simulate the entire\n  1945→        app lifecycle in a single shot, including lifespan and client\n  1946→        disconnect events. In order to simulate multiple interleaved\n  1947→        requests, or to test a streaming endpoint (such as one that emits\n  1948→        server-sent events), :class:`~falcon.testing.ASGIConductor` can be\n  1949→        used to more precisely control the app lifecycle.\n  1950→\n  1951→        An instance of :class:`~falcon.testing.ASGIConductor` may be\n  1952→        instantiated directly, or obtained from an instance of\n  1953→        :class:`~falcon.testing.TestClient` using the\n  1954→        context manager pattern, as per the following example::\n  1955→\n  1956→            client = falcon.testing.TestClient(app)\n  1957→\n  1958→            # -- snip --\n  1959→\n  1960→            async with client as conductor:\n  1961→                async with conductor.simulate_get_stream('/events') as result:\n  1962→                    pass\n  1963→\n  1964→    Args:\n  1965→        app (callable): A WSGI or ASGI application to target when simulating\n  1966→            requests\n  1967→\n  1968→    Keyword Arguments:\n  1969→        headers (dict): Default headers to set on every request (default\n  1970→            ``None``). These defaults may be overridden by passing values\n  1971→            for the same headers to one of the ``simulate_*()`` methods.\n  1972→\n  1973→    Attributes:\n  1974→        app: The app that this client instance was configured to use.\n  1975→\n  1976→    \"\"\"\n  1977→\n  1978→    # NOTE(aryaniyaps): Prevent pytest from collecting tests on the class.\n  1979→    __test__ = False\n  1980→\n  1981→    def __init__(self, app, headers=None):\n  1982→        self.app = app\n  1983→        self._default_headers = headers\n  1984→        self._conductor = None\n  1985→\n  1986→    async def __aenter__(self):\n  1987→        if not _is_asgi_app(self.app):\n  1988→            raise CompatibilityError(\n  1989→                'a conductor context manager may only be used with a Falcon ASGI app'\n  1990→            )\n  1991→\n  1992→        # NOTE(kgriffs): We normally do not expect someone to try to nest\n  1993→        #   contexts, so this is just a sanity-check.\n  1994→        assert not self._conductor\n  1995→\n  1996→        self._conductor = ASGIConductor(self.app, headers=self._default_headers)\n  1997→        await self._conductor.__aenter__()\n  1998→\n  1999→        return self._conductor\n  2000→\n  2001→    async def __aexit__(self, ex_type, ex, tb):\n  2002→        result = await self._conductor.__aexit__(ex_type, ex, tb)\n  2003→\n  2004→        # NOTE(kgriffs): Reset to allow this instance of TestClient to be\n  2005→        #   reused in another context.\n  2006→        self._conductor = None\n  2007→\n  2008→        return result\n  2009→\n  2010→    def simulate_get(self, path='/', **kwargs) -> _ResultBase:\n  2011→        \"\"\"Simulate a GET request to a WSGI application.\n  2012→\n  2013→        (See also: :py:meth:`falcon.testing.simulate_get`)\n  2014→        \"\"\"\n  2015→        return self.simulate_request('GET', path, **kwargs)\n  2016→\n  2017→    def simulate_head(self, path='/', **kwargs) -> _ResultBase:\n  2018→        \"\"\"Simulate a HEAD request to a WSGI application.\n  2019→\n  2020→        (See also: :py:meth:`falcon.testing.simulate_head`)\n  2021→        \"\"\"\n  2022→        return self.simulate_request('HEAD', path, **kwargs)\n  2023→\n  2024→    def simulate_post(self, path='/', **kwargs) -> _ResultBase:\n  2025→        \"\"\"Simulate a POST request to a WSGI application.\n  2026→\n  2027→        (See also: :py:meth:`falcon.testing.simulate_post`)\n  2028→        \"\"\"\n  2029→        return self.simulate_request('POST', path, **kwargs)\n  2030→\n  2031→    def simulate_put(self, path='/', **kwargs) -> _ResultBase:\n  2032→        \"\"\"Simulate a PUT request to a WSGI application.\n  2033→\n  2034→        (See also: :py:meth:`falcon.testing.simulate_put`)\n  2035→        \"\"\"\n  2036→        return self.simulate_request('PUT', path, **kwargs)\n  2037→\n  2038→    def simulate_options(self, path='/', **kwargs) -> _ResultBase:\n  2039→        \"\"\"Simulate an OPTIONS request to a WSGI application.\n  2040→\n  2041→        (See also: :py:meth:`falcon.testing.simulate_options`)\n  2042→        \"\"\"\n  2043→        return self.simulate_request('OPTIONS', path, **kwargs)\n  2044→\n  2045→    def simulate_patch(self, path='/', **kwargs) -> _ResultBase:\n  2046→        \"\"\"Simulate a PATCH request to a WSGI application.\n  2047→\n  2048→        (See also: :py:meth:`falcon.testing.simulate_patch`)\n  2049→        \"\"\"\n  2050→        return self.simulate_request('PATCH', path, **kwargs)\n  2051→\n  2052→    def simulate_delete(self, path='/', **kwargs) -> _ResultBase:\n  2053→        \"\"\"Simulate a DELETE request to a WSGI application.\n  2054→\n  2055→        (See also: :py:meth:`falcon.testing.simulate_delete`)\n  2056→        \"\"\"\n  2057→        return self.simulate_request('DELETE', path, **kwargs)\n  2058→\n  2059→    def simulate_request(self, *args, **kwargs) -> _ResultBase:\n  2060→        \"\"\"Simulate a request to a WSGI application.\n  2061→\n  2062→        Wraps :py:meth:`falcon.testing.simulate_request` to perf