u2192    def test_pack_query_params_several(self):\n   192\u2192        garbage_in = {'limit': 17, 'echo': True, 'doit': False, 'x': 'val', 'y': 0.2}\n   193\u2192\n   194\u2192        query_str = falcon.to_query_str(garbage_in)\n   195\u2192        fields = query_str[1:].split('&')\n   196\u2192\n   197\u2192        garbage_out = {}\n   198\u2192        for field in fields:\n   199\u2192            k, v = field.split('=')\n   200\u2192            garbage_out[k] = v\n   201\u2192\n   202\u2192        expected = {\n   203\u2192            'echo': 'true',\n   204\u2192            'limit': '17',\n   205\u2192            'x': 'val',\n   206\u2192            'y': '0.2',\n   207\u2192            'doit': 'false',\n   208\u2192        }\n   209\u2192\n   210\u2192        assert expected == garbage_out\n   211\u2192\n   212\u2192    @pytest.mark.parametrize('csv', [True, False])\n   213\u2192    @pytest.mark.parametrize(\n   214\u2192        'params',\n   215\u2192        [\n   216\u2192            {'a & b': 'a and b', 'b and c': 'b & c'},\n   217\u2192            {'apples and oranges': '\ud83c\udf4f & \ud83c\udf4a'},\n   218\u2192            {'garbage': ['&', '&+&', 'a=1&b=2', 'c=4&'], 'one': '1'},\n   219\u2192            {'&': '&amp;', '\u2122': '&trade;', '&&&': ['&amp;', '&amp;', '&amp;']},\n   220\u2192            {'&': '%26', '&&': '%26', '&&&': ['%26', '%2', '%']},\n   221\u2192        ],\n   222\u2192    )\n   223\u2192    def test_to_query_str_encoding(self, params, csv):\n   224\u2192        query_str = falcon.to_query_str(params, comma_delimited_lists=csv, prefix=False)\n   225\u2192\n   226\u2192        assert uri.parse_query_string(query_str, csv=csv) == params\n   227\u2192\n   228\u2192    def test_uri_encode(self):\n   229\u2192        url = 'http://example.com/v1/fizbit/messages?limit=3&echo=true'\n   230\u2192        assert uri.encode(url) == url\n   231\u2192\n   232\u2192        url = 'http://example.com/v1/fiz bit/messages'\n   233\u2192        expected = 'http://example.com/v1/fiz%20bit/messages'\n   234\u2192        assert uri.encode(url) == expected\n   235\u2192\n   236\u2192        url = 'http://example.com/v1/fizbit/messages?limit=3&e\\u00e7ho=true'\n   237\u2192        expected = 'http://example.com/v1/fizbit/messages?limit=3&e%C3%A7ho=true'\n   238\u2192        assert uri.encode(url) == expected\n   239\u2192\n   240\u2192        # NOTE(minesja): Addresses #1872\n   241\u2192        assert uri.encode('%26') == '%2526'\n   242\u2192        assert uri.decode(uri.encode('%26')) == '%26'\n   243\u2192\n   244\u2192    def test_uri_encode_double(self):\n   245\u2192        url = 'http://example.com/v1/fiz bit/messages'\n   246\u2192        expected = 'http://example.com/v1/fiz%20bit/messages'\n   247\u2192        assert uri.encode_check_escaped(uri.encode_check_escaped(url)) == expected\n   248\u2192\n   249\u2192        url = 'http://example.com/v1/fizbit/messages?limit=3&e\\u00e7ho=true'\n   250\u2192        expected = 'http://example.com/v1/fizbit/messages?limit=3&e%C3%A7ho=true'\n   251\u2192        assert uri.encode_check_escaped(uri.encode_check_escaped(url)) == expected\n   252\u2192\n   253\u2192        url = 'http://example.com/v1/fiz%bit/mess%ages/%'\n   254\u2192        expected = 'http://example.com/v1/fiz%25bit/mess%25ages/%25'\n   255\u2192        assert uri.encode_check_escaped(uri.encode_check_escaped(url)) == expected\n   256\u2192\n   257\u2192        url = 'http://example.com/%%'\n   258\u2192        expected = 'http://example.com/%25%25'\n   259\u2192        assert uri.encode_check_escaped(uri.encode_check_escaped(url)) == expected\n   260\u2192\n   261\u2192        # NOTE(kgriffs): Specific example cited in GH issue\n   262\u2192        url = 'http://something?redirect_uri=http%3A%2F%2Fsite'\n   263\u2192        assert uri.encode_check_escaped(url) == url\n   264\u2192\n   265\u2192        hex_digits = 'abcdefABCDEF0123456789'\n   266\u2192        for c1 in hex_digits:\n   267\u2192            for c2 in hex_digits:\n   268\u2192                url = 'http://example.com/%' + c1 + c2\n   269\u2192                encoded = uri.encode_check_escaped(uri.encode_check_escaped(url))\n   270\u2192                assert encoded == url\n   271\u2192\n   272\u2192    def test_uri_encode_value(self):\n   273\u2192        assert uri.encode_value('abcd') == 'abcd'\n   274\u2192        assert uri.encode_value('abcd') == 'abcd'\n   275\u2192        assert uri.encode_value('ab cd') == 'ab%20cd'\n   276\u2192        assert uri.encode_value('\\u00e7') == '%C3%A7'\n   277\u2192        assert uri.encode_value('\\u00e7\\u20ac') == '%C3%A7%E2%82%AC'\n   278\u2192        assert uri.encode_value('ab/cd') == 'ab%2Fcd'\n   279\u2192        assert uri.encode_value('ab+cd=42,9') == 'ab%2Bcd%3D42%2C9'\n   280\u2192\n   281\u2192        # NOTE(minesja): Addresses #1872\n   282\u2192        assert uri.encode_value('%26') == '%2526'\n   283\u2192        assert uri.decode(uri.encode_value('%26')) == '%26'\n   284\u2192\n   285\u2192    def test_uri_decode(self, decode_approach):\n   286\u2192        assert uri.decode('abcd') == 'abcd'\n   287\u2192        assert uri.decode('ab%20cd') == 'ab cd'\n   288\u2192\n   289\u2192        assert uri.decode('This thing is %C3%A7') == 'This thing is \\u00e7'\n   290\u2192\n   291\u2192        assert (\n   292\u2192            uri.decode('This thing is %C3%A7%E2%82%AC') == 'This thing is \\u00e7\\u20ac'\n   293\u2192        )\n   294\u2192\n   295\u2192        assert uri.decode('ab%2Fcd') == 'ab/cd'\n   296\u2192\n   297\u2192        assert (\n   298\u2192            uri.decode('http://example.com?x=ab%2Bcd%3D42%2C9')\n   299\u2192            == 'http://example.com?x=ab+cd=42,9'\n   300\u2192        )\n   301\u2192\n   302\u2192    @pytest.mark.parametrize(\n   303\u2192        'encoded,expected',\n   304\u2192        [\n   305\u2192            ('ab%2Gcd', 'ab%2Gcd'),\n   306\u2192            ('ab%2Fcd: 100% coverage', 'ab/cd: 100% coverage'),\n   307\u2192            ('%s' * 100, '%s' * 100),\n   308\u2192        ],\n   309\u2192    )\n   310\u2192    def test_uri_decode_bad_coding(self, encoded, expected, decode_approach):\n   311\u2192        assert uri.decode(encoded) == expected\n   312\u2192\n   313\u2192    @pytest.mark.parametrize(\n   314\u2192        'encoded,expected',\n   315\u2192        [\n   316\u2192            ('+%80', ' \ufffd'),\n   317\u2192            ('+++%FF+++', '   \ufffd   '),  # impossible byte\n   318\u2192            ('%fc%83%bf%bf%bf%bf', '\ufffd\ufffd\ufffd\ufffd\ufffd\ufffd'),  # overlong sequence\n   319\u2192            ('%ed%ae%80%ed%b0%80', '\ufffd\ufffd\ufffd\ufffd\ufffd\ufffd'),  # paired UTF-16 surrogates\n   320\u2192        ],\n   321\u2192    )\n   322\u2192    def test_uri_decode_bad_unicode(self, encoded, expected, decode_approach):\n   323\u2192        assert uri.decode(encoded) == expected\n   324\u2192\n   325\u2192    def test_uri_decode_unquote_plus(self, decode_approach):\n   326\u2192        assert uri.decode('/disk/lost+found/fd0') == '/disk/lost found/fd0'\n   327\u2192        assert uri.decode('/disk/lost+found/fd0', unquote_plus=True) == (\n   328\u2192            '/disk/lost found/fd0'\n   329\u2192        )\n   330\u2192        assert uri.decode('/disk/lost+found/fd0', unquote_plus=False) == (\n   331\u2192            '/disk/lost+found/fd0'\n   332\u2192        )\n   333\u2192\n   334\u2192        assert uri.decode('http://example.com?x=ab%2Bcd%3D42%2C9') == (\n   335\u2192            'http://example.com?x=ab+cd=42,9'\n   336\u2192        )\n   337\u2192        assert uri.decode(\n   338\u2192            'http://example.com?x=ab%2Bcd%3D42%2C9', unquote_plus=True\n   339\u2192        ) == ('http://example.com?x=ab+cd=42,9')\n   340\u2192        assert uri.decode(\n   341\u2192            'http://example.com?x=ab%2Bcd%3D42%2C9', unquote_plus=False\n   342\u2192        ) == ('http://example.com?x=ab+cd=42,9')\n   343\u2192\n   344\u2192    def test_prop_uri_encode_models_stdlib_quote(self):\n   345\u2192        equiv_quote = functools.partial(quote, safe=uri._ALL_ALLOWED)\n   346\u2192        for case in self.uris:\n   347\u2192            expect = equiv_quote(case)\n   348\u2192            actual = uri.encode(case)\n   349\u2192            assert expect == actual\n   350\u2192\n   351\u2192    def test_prop_uri_encode_value_models_stdlib_quote_safe_tilde(self):\n   352\u2192        equiv_quote = functools.partial(quote, safe='~')\n   353\u2192        for case in self.uris:\n   354\u2192            expect = equiv_quote(case)\n   355\u2192            actual = uri.encode_value(case)\n   356\u2192            assert expect == actual\n   357\u2192\n   358\u2192    def test_prop_uri_decode_models_stdlib_unquote_plus(self):\n   359\u2192        stdlib_unquote = unquote_plus\n   360\u2192        for case in self.uris:\n   361\u2192            case = uri.encode_value(case)\n   362\u2192\n   363\u2192            expect = stdlib_unquote(case)\n   364\u2192            actual = uri.decode(case)\n   365\u2192            assert expect == actual\n   366\u2192\n   367\u2192    def test_unquote_string(self):\n   368\u2192        assert uri.unquote_string('v') == 'v'\n   369\u2192        assert uri.unquote_string('not-quoted') == 'not-quoted'\n   370\u2192        assert uri.unquote_string('partial-quoted\"') == 'partial-quoted\"'\n   371\u2192        assert uri.unquote_string('\"partial-quoted') == '\"partial-quoted'\n   372\u2192        assert uri.unquote_string('\"partial-quoted\"') == 'partial-quoted'\n   373\u2192\n   374\u2192    def test_parse_query_string(self):\n   375\u2192        query_string = (\n   376\u2192            'a=http%3A%2F%2Ffalconframework.org%3Ftest%3D1'\n   377\u2192            '&b=%7B%22test1%22%3A%20%22data1%22%'\n   378\u2192            '2C%20%22test2%22%3A%20%22data2%22%7D'\n   379\u2192            '&c=1,2,3'\n   380\u2192            '&d=test'\n   381\u2192            '&e=a,,%26%3D%2C'\n   382\u2192            '&f=a&f=a%3Db'\n   383\u2192            '&%C3%A9=a%3Db'\n   384\u2192        )\n   385\u2192        decoded_url = 'http://falconframework.org?test=1'\n   386\u2192        decoded_json = '{\"test1\": \"data1\", \"test2\": \"data2\"}'\n   387\u2192\n   388\u2192        result = uri.parse_query_string(query_string)\n   389\u2192        assert result['a'] == decoded_url\n   390\u2192        assert result['b'] == decoded_json\n   391\u2192        assert result['c'] == '1,2,3'\n   392\u2192        assert result['d'] == 'test'\n   393\u2192        assert result['e'] == 'a,,&=,'\n   394\u2192        assert result['f'] == ['a', 'a=b']\n   395\u2192        assert result['\u00e9'] == 'a=b'\n   396\u2192\n   397\u2192        result = uri.parse_query_string(query_string, True, True)\n   398\u2192        assert result['a'] == decoded_url\n   399\u2192        assert result['b'] == decoded_json\n   400\u2192        assert result['c'] == ['1', '2', '3']\n   401\u2192        assert result['d'] == 'test'\n   402\u2192        assert result['e'] == ['a', '', '&=,']\n   403\u2192        assert result['f'] == ['a', 'a=b']\n   404\u2192        assert result['\u00e9'] == 'a=b'\n   405\u2192\n   406\u2192        result = uri.parse_query_string(query_string, csv=True)\n   407\u2192        assert result['a'] == decoded_url\n   408\u2192        assert result['b'] == decoded_json\n   409\u2192        assert result['c'] == ['1', '2', '3']\n   410\u2192        assert result['d'] == 'test'\n   411\u2192        assert result['e'] == ['a', '&=,']\n   412\u2192        assert result['f'] == ['a', 'a=b']\n   413\u2192        assert result['\u00e9'] == 'a=b'\n   414\u2192\n   415\u2192    @pytest.mark.parametrize(\n   416\u2192        'query_string,keep_blank,expected',\n   417\u2192        [\n   418\u2192            ('', True, {}),\n   419\u2192            ('', False, {}),\n   420\u2192            ('flag1&&&&&flag2&&&', True, {'flag1': '', 'flag2': ''}),\n   421\u2192            ('flag1&&&&&flag2&&&', False, {}),\n   422\u2192            ('malformed=%FG%1%Hi%%%a', False, {'malformed': '%FG%1%Hi%%%a'}),\n   423\u2192            ('=', False, {}),\n   424\u2192            ('==', False, {'': '='}),\n   425\u2192            (\n   426\u2192                '%==+==&&&&&&&&&%%==+=&&&&&&%0g%=%=',\n   427\u2192                False,\n   428\u2192                {'%': '= ==', '%%': '= =', '%0g%': '%='},\n   429\u2192            ),\n   430\u2192            ('%=&%%=&&%%%=', False, {}),\n   431\u2192            ('%=&%%=&&%%%=', True, {'%': '', '%%': '', '%%%': ''}),\n   432\u2192            ('+=&%+=&&%++=', True, {' ': '', '% ': '', '%  ': ''}),\n   433\u2192            ('=x=&=x=+1=x=&%=x', False, {'': ['x=', 'x= 1=x='], '%': 'x'}),\n   434\u2192            (\n   435\u2192                ''.join(\n   436\u2192                    itertools.chain.from_iterable(itertools.permutations('%=+&', 4))\n   437\u2192                ),\n   438\u2192                False,\n   439\u2192                {\n   440\u2192                    '': ['%', ' %', '%', ' ', ' =%', '%', '% ', ' %'],\n   441\u2192                    ' ': ['=% ', ' %', '%'],\n   442\u2192                    '%': [' ', ' ', ' '],\n   443\u2192                },\n   444\u2192            ),\n   445\u2192            # NOTE(vytas): Sanity check that we do not accidentally use C-strings\n   446\u2192            #   anywhere in the cythonized variant.\n   447\u2192            ('%%%\\x00%\\x00==\\x00\\x00==', True, {'%%%\\x00%\\x00': '=\\x00\\x00=='}),\n   448\u2192            ('spade=\u2660&spade=\u2660', False, {'spade': ['\u2660', '\u2660']}),  # Unicode query\n   449\u2192        ],\n   450\u2192    )\n   451\u2192    def test_parse_query_string_edge_cases(self, query_string, keep_blank, expected):\n   452\u2192        assert uri.parse_query_string(query_string, keep_blank=keep_blank) == (expected)\n   453\u2192\n   454\u2192    def test_parse_host(self):\n   455\u2192        assert uri.parse_host('::1') == ('::1', None)\n   456\u2192        assert uri.parse_host('2001:ODB8:AC10:FE01::') == (\n   457\u2192            '2001:ODB8:AC10:FE01::',\n   458\u2192            None,\n   459\u2192        )\n   460\u2192        assert uri.parse_host('2001:ODB8:AC10:FE01::', default_port=80) == (\n   461\u2192            '2001:ODB8:AC10:FE01::',\n   462\u2192            80,\n   463\u2192        )\n   464\u2192\n   465\u2192        ipv6_addr = '2001:4801:1221:101:1c10::f5:116'\n   466\u2192\n   467\u2192        assert uri.parse_host(ipv6_addr) == (ipv6_addr, None)\n   468\u2192        assert uri.parse_host('[' + ipv6_addr + ']') == (ipv6_addr, None)\n   469\u2192        assert uri.parse_host('[' + ipv6_addr + ']:28080') == (ipv6_addr, 28080)\n   470\u2192        assert uri.parse_host('[' + ipv6_addr + ']:8080') == (ipv6_addr, 8080)\n   471\u2192        assert uri.parse_host('[' + ipv6_addr + ']:123') == (ipv6_addr, 123)\n   472\u2192        assert uri.parse_host('[' + ipv6_addr + ']:42') == (ipv6_addr, 42)\n   473\u2192\n   474\u2192        assert uri.parse_host('173.203.44.122') == ('173.203.44.122', None)\n   475\u2192        assert uri.parse_host('173.203.44.122', default_port=80) == (\n   476\u2192            '173.203.44.122',\n   477\u2192            80,\n   478\u2192        )\n   479\u2192        assert uri.parse_host('173.203.44.122:27070') == ('173.203.44.122', 27070)\n   480\u2192        assert uri.parse_host('173.203.44.122:123') == ('173.203.44.122', 123)\n   481\u2192        assert uri.parse_host('173.203.44.122:42') == ('173.203.44.122', 42)\n   482\u2192\n   483\u2192        assert uri.parse_host('example.com') == ('example.com', None)\n   484\u2192        assert uri.parse_host('example.com', default_port=443) == ('example.com', 443)\n   485\u2192        assert uri.parse_host('falcon.example.com') == ('falcon.example.com', None)\n   486\u2192        assert uri.parse_host('falcon.example.com:9876') == ('falcon.example.com', 9876)\n   487\u2192        assert uri.parse_host('falcon.example.com:42') == ('falcon.example.com', 42)\n   488\u2192\n   489\u2192    def test_get_http_status_warns(self):\n   490\u2192        with pytest.warns(UserWarning, match='Please use falcon'):\n   491\u2192            falcon.get_http_status(400)\n   492\u2192\n   493\u2192    @pytest.mark.filterwarnings('ignore')\n   494\u2192    def test_get_http_status(self):\n   495\u2192        assert falcon.get_http_status(404) == falcon.HTTP_404\n   496\u2192        assert falcon.get_http_status(404.3) == falcon.HTTP_404\n   497\u2192        assert falcon.get_http_status('404.3') == falcon.HTTP_404\n   498\u2192        assert falcon.get_http_status(404.9) == falcon.HTTP_404\n   499\u2192        assert falcon.get_http_status('404') == falcon.HTTP_404\n   500\u2192        assert falcon.get_http_status(123) == '123 Unknown'\n   501\u2192        with pytest.raises(ValueError):\n   502\u2192            falcon.get_http_status('not_a_number')\n   503\u2192        with pytest.raises(ValueError):\n   504\u2192            falcon.get_http_status(0)\n   505\u2192        with pytest.raises(ValueError):\n   506\u2192            falcon.get_http_status(0)\n   507\u2192        with pytest.raises(ValueError):\n   508\u2192            falcon.get_http_status(99)\n   509\u2192        with pytest.raises(ValueError):\n   510\u2192            falcon.get_http_status(-404.3)\n   511\u2192        with pytest.raises(ValueError):\n   512\u2192            falcon.get_http_status('-404')\n   513\u2192        with pytest.raises(ValueError):\n   514\u2192            falcon.get_http_status('-404.3')\n   515\u2192        assert falcon.get_http_status(123, 'Go Away') == '123 Go Away'\n   516\u2192\n   517\u2192    @pytest.mark.parametrize(\n   518\u2192        'v_in,v_out',\n   519\u2192        [\n   520\u2192            (703, falcon.HTTP_703),\n   521\u2192            (404, falcon.HTTP_404),\n   522\u2192            (404.9, falcon.HTTP_404),\n   523\u2192            (falcon.HTTP_200, falcon.HTTP_200),\n   524\u2192            (falcon.HTTP_307, falcon.HTTP_307),\n   525\u2192            (falcon.HTTP_404, falcon.HTTP_404),\n   526\u2192            (123, '123 Unknown'),\n   527\u2192            ('123 Wow Such Status', '123 Wow Such Status'),\n   528\u2192            (b'123 Wow Such Status', '123 Wow Such Status'),\n   529\u2192            (b'200 OK', falcon.HTTP_OK),\n   530\u2192            (http.HTTPStatus(200), falcon.HTTP_200),\n   531\u2192            (http.HTTPStatus(307), falcon.HTTP_307),\n   532\u2192            (http.HTTPStatus(401), falcon.HTTP_401),\n   533\u2192            (http.HTTPStatus(410), falcon.HTTP_410),\n   534\u2192            (http.HTTPStatus(429), falcon.HTTP_429),\n   535\u2192            (http.HTTPStatus(500), falcon.HTTP_500),\n   536\u2192        ],\n   537\u2192    )\n   538\u2192    def test_code_to_http_status(self, v_in, v_out):\n   539\u2192        assert falcon.code_to_http_status(v_in) == v_out\n   540\u2192\n   541\u2192    @pytest.mark.parametrize(\n   542\u2192        'v',\n   543\u2192        [\n   544\u2192            0,\n   545\u2192            13,\n   546\u2192            99,\n   547\u2192            1000,\n   548\u2192            1337.01,\n   549\u2192            -99,\n   550\u2192            -404.3,\n   551\u2192            -404,\n   552\u2192            -404.3,\n   553\u2192            'Successful',\n   554\u2192            'Failed',\n   555\u2192            None,\n   556\u2192        ],\n   557\u2192    )\n   558\u2192    def test_code_to_http_status_value_error(self, v):\n   559\u2192        with pytest.raises(ValueError):\n   560\u2192            falcon.code_to_http_status(v)\n   561\u2192\n   562\u2192    @pytest.mark.parametrize(\n   563\u2192        'v_in,v_out',\n   564\u2192        [\n   565\u2192            # NOTE(kgriffs): Include some codes not used elsewhere so that\n   566\u2192            #   we get past the LRU.\n   567\u2192            (http.HTTPStatus(505), 505),\n   568\u2192            (712, 712),\n   569\u2192            ('712', 712),\n   570\u2192            (b'404 Not Found', 404),\n   571\u2192            (b'712 NoSQL', 712),\n   572\u2192            ('404 Not Found', 404),\n   573\u2192            ('123 Wow Such Status', 123),\n   574\u2192            # NOTE(kgriffs): Test LRU\n   575\u2192            (http.HTTPStatus(505), 505),\n   576\u2192            ('123 Wow Such Status', 123),\n   577\u2192        ],\n   578\u2192    )\n   579\u2192    def test_http_status_to_code(self, v_in, v_out):\n   580\u2192        assert falcon.http_status_to_code(v_in) == v_out\n   581\u2192\n   582\u2192    @pytest.mark.parametrize('v', ['', ' ', '1', '12', '99', 'catsup', b'', 5.2])\n   583\u2192    def test_http_status_to_code_neg(self, v):\n   584\u2192        with pytest.raises(ValueError):\n   585\u2192            falcon.http_status_to_code(v)\n   586\u2192\n   587\u2192    def test_etag_dumps_to_header_format(self):\n   588\u2192        etag = structures.ETag('67ab43')\n   589\u2192\n   590\u2192        assert etag.dumps() == '\"67ab43\"'\n   591\u2192\n   592\u2192        etag.is_weak = True\n   593\u2192        assert etag.dumps() == 'W/\"67ab43\"'\n   594\u2192\n   595\u2192        assert structures.ETag('67a b43').dumps() == '\"67a b43\"'\n   596\u2192\n   597\u2192    def test_etag_strong_vs_weak_comparison(self):\n   598\u2192        strong_67ab43_one = structures.ETag.loads('\"67ab43\"')\n   599\u2192        strong_67ab43_too = structures.ETag.loads('\"67ab43\"')\n   600\u2192        strong_67aB43 = structures.ETag.loads('\"67aB43\"')\n   601\u2192        weak_67ab43_one = structures.ETag.loads('W/\"67ab43\"')\n   602\u2192        weak_67ab43_two = structures.ETag.loads('W/\"67ab43\"')\n   603\u2192        weak_67aB43 = structures.ETag.loads('W/\"67aB43\"')\n   604\u2192\n   605\u2192        assert strong_67aB43 == strong_67aB43\n   606\u2192        assert weak_67aB43 == weak_67aB43\n   607\u2192        assert strong_67aB43 == weak_67aB43\n   608\u2192        assert weak_67aB43 == strong_67aB43\n   609\u2192        assert strong_67ab43_one == strong_67ab43_too\n   610\u2192        assert weak_67ab43_one == weak_67ab43_two\n   611\u2192\n   612\u2192        assert strong_67aB43 != strong_67ab43_one\n   613\u2192        assert strong_67ab43_one != strong_67aB43\n   614\u2192\n   615\u2192        assert strong_67aB43.strong_compare(strong_67aB43)\n   616\u2192        assert strong_67ab43_one.strong_compare(strong_67ab43_too)\n   617\u2192        assert not strong_67aB43.strong_compare(strong_67ab43_one)\n   618\u2192        assert not strong_67ab43_one.strong_compare(strong_67aB43)\n   619\u2192\n   620\u2192        assert not strong_67ab43_one.strong_compare(weak_67ab43_one)\n   621\u2192        assert not weak_67ab43_one.strong_compare(strong_67ab43_one)\n   622\u2192\n   623\u2192        assert not weak_67aB43.strong_compare(weak_67aB43)\n   624\u2192        assert not weak_67ab43_one.strong_compare(weak_67ab43_two)\n   625\u2192\n   626\u2192        assert not weak_67ab43_one.strong_compare(weak_67aB43)\n   627\u2192        assert not weak_67aB43.strong_compare(weak_67ab43_one)\n   628\u2192\n   629\u2192    @pytest.mark.parametrize(\n   630\u2192        'filename,expected',\n   631\u2192        [\n   632\u2192            ('.', '_'),\n   633\u2192            ('..', '_.'),\n   634\u2192            ('hello.txt', 'hello.txt'),\n   635\u2192            ('\u0104\u017euolai \u017ealiuos.jpeg', 'A_z_uolai_z_aliuos.jpeg'),\n   636\u2192            ('/etc/shadow', '_etc_shadow'),\n   637\u2192            ('. \u2b05 a dot', '____a_dot'),\n   638\u2192            ('C:\\\\Windows\\\\kernel32.dll', 'C__Windows_kernel32.dll'),\n   639\u2192        ],\n   640\u2192    )\n   641\u2192    def test_secure_filename(self, filename, expected):\n   642\u2192        assert misc.secure_filename(filename) == expected\n   643\u2192\n   644\u2192    def test_secure_filename_empty_value(self):\n   645\u2192        with pytest.raises(ValueError):\n   646\u2192            misc.secure_filename('')\n   647\u2192\n   648\u2192    @pytest.mark.parametrize(\n   649\u2192        'string,expected_ascii',\n   650\u2192        [\n   651\u2192            ('', True),\n   652\u2192            ('/', True),\n   653\u2192            ('/api', True),\n   654\u2192            ('/data/items/something?query=apples%20and%20oranges', True),\n   655\u2192            ('/food?item=\u00f0\\x9f\\x8d\\x94', False),\n   656\u2192            ('\\x00\\x00\\x7f\\x00\\x00\\x7f\\x00', True),\n   657\u2192            ('\\x00\\x00\\x7f\\x00\\x00\\x80\\x00', False),\n   658\u2192        ],\n   659\u2192    )\n   660\u2192    @pytest.mark.parametrize('method', ['isascii', '_isascii'])\n   661\u2192    def test_misc_isascii(self, string, expected_ascii, method):\n   662\u2192        isascii = getattr(misc, method)\n   663\u2192        if expected_ascii:\n   664\u2192            assert isascii(string)\n   665\u2192        else:\n   666\u2192            assert not isascii(string)\n   667\u2192\n   668\u2192\n   669\u2192@pytest.mark.parametrize(\n   670\u2192    'protocol,method',\n   671\u2192    zip(\n   672\u2192        ['https'] * len(falcon.HTTP_METHODS) + ['http'] * len(falcon.HTTP_METHODS),\n   673\u2192        falcon.HTTP_METHODS * 2,\n   674\u2192    ),\n   675\u2192)\n   676\u2192def test_simulate_request_protocol(asgi, protocol, method):\n   677\u2192    sink_called = [False]\n   678\u2192\n   679\u2192    def sink(req, resp):\n   680\u2192        sink_called[0] = True\n   681\u2192        assert req.protocol == protocol\n   682\u2192\n   683\u2192    if asgi:\n   684\u2192        sink = to_coroutine(sink)\n   685\u2192\n   686\u2192    app = create_app(asgi)\n   687\u2192    app.add_sink(sink, '/test')\n   688\u2192\n   689\u2192    client = testing.TestClient(app)\n   690\u2192\n   691\u2192    try:\n   692\u2192        simulate = client.getattr('simulate_' + method.lower())\n   693\u2192        simulate('/test', protocol=protocol)\n   694\u2192        assert sink_called[0]\n   695\u2192    except AttributeError:\n   696\u2192        # NOTE(kgriffs): simulate_* helpers do not exist for all methods\n   697\u2192        pass\n   698\u2192\n   699\u2192\n   700\u2192@pytest.mark.parametrize(\n   701\u2192    'simulate',\n   702\u2192    [\n   703\u2192        testing.simulate_get,\n   704\u2192        testing.simulate_head,\n   705\u2192        testing.simulate_post,\n   706\u2192        testing.simulate_put,\n   707\u2192        testing.simulate_options,\n   708\u2192        testing.simulate_patch,\n   709\u2192        testing.simulate_delete,\n   710\u2192    ],\n   711\u2192)\n   712\u2192def test_simulate_free_functions(asgi, simulate):\n   713\u2192    sink_called = [False]\n   714\u2192\n   715\u2192    def sink(req, resp):\n   716\u2192        sink_called[0] = True\n   717\u2192\n   718\u2192    if asgi:\n   719\u2192        sink = to_coroutine(sink)\n   720\u2192\n   721\u2192    app = create_app(asgi)\n   722\u2192    app.add_sink(sink, '/test')\n   723\u2192\n   724\u2192    simulate(app, '/test')\n   725\u2192    assert sink_called[0]\n   726\u2192\n   727\u2192\n   728\u2192class TestFalconTestingUtils:\n   729\u2192    \"\"\"Verify some branches not covered elsewhere.\"\"\"\n   730\u2192\n   731\u2192    def test_path_escape_chars_in_create_environ(self):\n   732\u2192        env = testing.create_environ('/hello%20world%21')\n   733\u2192        assert env['PATH_INFO'] == '/hello world!'\n   734\u2192\n   735\u2192    def test_no_prefix_allowed_for_query_strings_in_create_environ(self):\n   736\u2192        with pytest.raises(ValueError):\n   737\u2192            testing.create_environ(query_string='?foo=bar')\n   738\u2192\n   739\u2192    def test_plus_in_path_in_create_environ(self):\n   740\u2192        env = testing.create_environ('/mnt/grub2/lost+found/inode001')\n   741\u2192        assert env['PATH_INFO'] == '/mnt/grub2/lost+found/inode001'\n   742\u2192\n   743\u2192    def test_none_header_value_in_create_environ(self):\n   744\u2192        env = testing.create_environ('/', headers={'X-Foo': None})\n   745\u2192        assert env['HTTP_X_FOO'] == ''\n   746\u2192\n   747\u2192    def test_decode_empty_result(self, app):\n   748\u2192        client = testing.TestClient(app)\n   749\u2192        response = client.simulate_request(path='/')\n   750\u2192        assert response.json == falcon.HTTPNotFound().to_dict()\n   751\u2192\n   752\u2192    def test_httpnow_alias_for_backwards_compat(self):\n   753\u2192        assert testing.httpnow is util.http_now\n   754\u2192\n   755\u2192    def test_default_headers(self, app):\n   756\u2192        resource = testing.SimpleTestResource()\n   757\u2192        app.add_route('/', resource)\n   758\u2192\n   759\u2192        headers = {\n   760\u2192            'Authorization': 'Bearer 123',\n   761\u2192        }\n   762\u2192\n   763\u2192        client = testing.TestClient(app, headers=headers)\n   764\u2192\n   765\u2192        client.simulate_get()\n   766\u2192        assert resource.captured_req.auth == headers['Authorization']\n   767\u2192\n   768\u2192        client.simulate_get(headers=None)\n   769\u2192        assert resource.captured_req.auth == headers['Authorization']\n   770\u2192\n   771\u2192    def test_default_headers_with_override(self, app):\n   772\u2192        resource = testing.SimpleTestResource()\n   773\u2192        app.add_route('/', resource)\n   774\u2192\n   775\u2192        override_before = 'something-something'\n   776\u2192        override_after = 'something-something'[::-1]\n   777\u2192\n   778\u2192        headers = {\n   779\u2192            'Authorization': 'Bearer XYZ',\n   780\u2192            'Accept': 'application/vnd.siren+json',\n   781\u2192            'X-Override-Me': override_before,\n   782\u2192        }\n   783\u2192\n   784\u2192        client = testing.TestClient(app, headers=headers)\n   785\u2192        client.simulate_get(headers={'X-Override-Me': override_after})\n   786\u2192\n   787\u2192        assert resource.captured_req.auth == headers['Authorization']\n   788\u2192        assert resource.captured_req.accept == headers['Accept']\n   789\u2192        assert resource.captured_req.get_header('X-Override-Me') == override_after\n   790\u2192\n   791\u2192    def test_status(self, app):\n   792\u2192        resource = testing.SimpleTestResource(status=falcon.HTTP_702)\n   793\u2192        app.add_route('/', resource)\n   794\u2192        client = testing.TestClient(app)\n   795\u2192\n   796\u2192        result = client.simulate_get()\n   797\u2192        assert result.status == falcon.HTTP_702\n   798\u2192\n   799\u2192    @pytest.mark.parametrize(\n   800\u2192        'simulate',\n   801\u2192        [\n   802\u2192            testing.simulate_get,\n   803\u2192            testing.simulate_post,\n   804\u2192        ],\n   805\u2192    )\n   806\u2192    @pytest.mark.parametrize(\n   807\u2192        'value',\n   808\u2192        (\n   809\u2192            'd\\xff\\xff\\x00',\n   810\u2192            'quick fox jumps over the lazy dog',\n   811\u2192            '{\"hello\": \"WORLD!\"}',\n   812\u2192            'Lorem ipsum dolor sit amet, consectetur adipiscing elit. Praese',\n   813\u2192            '{\"hello\": \"WORLD!\", \"greetings\": \"fellow traveller\"}',\n   814\u2192            '\\xe9\\xe8',\n   815\u2192        ),\n   816\u2192    )\n   817\u2192    def test_repr_result_when_body_varies(self, asgi, value, simulate):\n   818\u2192        if isinstance(value, str):\n   819\u2192            value = bytes(value, 'UTF-8')\n   820\u2192\n   821\u2192        if asgi:\n   822\u2192            resource = testing.SimpleTestResourceAsync(body=value)\n   823\u2192        else:\n   824\u2192            resource = testing.SimpleTestResource(body=value)\n   825\u2192\n   826\u2192        app = create_app(asgi)\n   827\u2192        app.add_route('/hello', resource)\n   828\u2192\n   829\u2192        result = simulate(app, '/hello')\n   830\u2192        captured_resp = resource.captured_resp\n   831\u2192        content = captured_resp.text\n   832\u2192\n   833\u2192        if len(value) > 40:\n   834\u2192            content = value[:20] + b'...' + value[-20:]\n   835\u2192        else:\n   836\u2192            content = value\n   837\u2192\n   838\u2192        args = [\n   839\u2192            captured_resp.status,\n   840\u2192            captured_resp.headers['content-type'],\n   841\u2192            str(content),\n   842\u2192        ]\n   843\u2192\n   844\u2192        expected_content = ' '.join(filter(None, args))\n   845\u2192\n   846\u2192        expected_result = 'Result<{}>'.format(expected_content)\n   847\u2192\n   848\u2192        assert str(result) == expected_result\n   849\u2192\n   850\u2192    def test_repr_without_content_type_header(self, asgi):\n   851\u2192        value = b'huh'\n   852\u2192        header = [('Not-content-type', 'no!')]\n   853\u2192        result = falcon.testing.Result([value], falcon.HTTP_200, header)\n   854\u2192\n   855\u2192        expected_result = 'Result<200 OK {}>'.format(value)\n   856\u2192        assert str(result) == expected_result\n   857\u2192\n   858\u2192    def test_wsgi_iterable_not_closeable(self):\n   859\u2192        result = testing.Result([], falcon.HTTP_200, [])\n   860\u2192        assert not result.content\n   861\u2192        assert result.json is None\n   862\u2192\n   863\u2192    def test_path_must_start_with_slash(self, app):\n   864\u2192        app.add_route('/', testing.SimpleTestResource())\n   865\u2192        client = testing.TestClient(app)\n   866\u2192        with pytest.raises(ValueError):\n   867\u2192            client.simulate_get('foo')\n   868\u2192\n   869\u2192    def test_cached_text_in_result(self, app):\n   870\u2192        app.add_route('/', testing.SimpleTestResource(body='test'))\n   871\u2192        client = testing.TestClient(app)\n   872\u2192\n   873\u2192        result = client.simulate_get()\n   874\u2192        assert result.text == result.text\n   875\u2192\n   876\u2192    @pytest.mark.parametrize(\n   877\u2192        'resource_type',\n   878\u2192        [\n   879\u2192            testing.SimpleTestResource,\n   880\u2192            testing.SimpleTestResourceAsync,\n   881\u2192        ],\n   882\u2192    )\n   883\u2192    def test_simple_resource_body_json_xor(self, resource_type):\n   884\u2192        with pytest.raises(ValueError):\n   885\u2192            resource_type(body='', json={})\n   886\u2192\n   887\u2192    def test_query_string(self, app):\n   888\u2192        class SomeResource:\n   889\u2192            def on_get(self, req, resp):\n   890\u2192                doc = {}\n   891\u2192\n   892\u2192                doc['oid'] = req.get_param_as_int('oid')\n   893\u2192                doc['detailed'] = req.get_param_as_bool('detailed')\n   894\u2192                doc['things'] = req.get_param_as_list('things', int)\n   895\u2192                doc['query_string'] = req.query_string\n   896\u2192\n   897\u2192                resp.text = json.dumps(doc)\n   898\u2192\n   899\u2192        app.req_options.auto_parse_qs_csv = True\n   900\u2192        app.add_route('/', SomeResource())\n   901\u2192        client = testing.TestClient(app)\n   902\u2192\n   903\u2192        result = client.simulate_get(query_string='oid=42&detailed=no&things=1')\n   904\u2192        assert result.json['oid'] == 42\n   905\u2192        assert not result.json['detailed']\n   906\u2192        assert result.json['things'] == [1]\n   907\u2192\n   908\u2192        params = {'oid': 42, 'detailed': False}\n   909\u2192        result = client.simulate_get(params=params)\n   910\u2192        assert result.json['oid'] == params['oid']\n   911\u2192        assert not result.json['detailed']\n   912\u2192        assert result.json['things'] is None\n   913\u2192\n   914\u2192        params = {'oid': 1978, 'detailed': 'yes', 'things': [1, 2, 3]}\n   915\u2192        result = client.simulate_get(params=params)\n   916\u2192        assert result.json['oid'] == params['oid']\n   917\u2192        assert result.json['detailed']\n   918\u2192        assert result.json['things'] == params['things']\n   919\u2192\n   920\u2192        expected_qs = 'things=1&things=2&things=3'\n   921\u2192        result = client.simulate_get(params={'things': [1, 2, 3]})\n   922\u2192        assert result.json['query_string'] == expected_qs\n   923\u2192\n   924\u2192        expected_qs = 'things=1,2,3'\n   925\u2192        result = client.simulate_get(params={'things': [1, 2, 3]}, params_csv=True)\n   926\u2192        assert result.json['query_string'] == expected_qs\n   927\u2192\n   928\u2192    def test_query_string_no_question(self, app):\n   929\u2192        app.add_route('/', testing.SimpleTestResource())\n   930\u2192        client = testing.TestClient(app)\n   931\u2192        with pytest.raises(ValueError):\n   932\u2192            client.simulate_get(query_string='?x=1')\n   933\u2192\n   934\u2192    def test_query_string_in_path(self, app):\n   935\u2192        resource = testing.SimpleTestResource()\n   936\u2192        app.add_route('/thing', resource)\n   937\u2192        client = testing.TestClient(app)\n   938\u2192\n   939\u2192        with pytest.raises(ValueError):\n   940\u2192            client.simulate_get(path='/thing?x=1', query_string='things=1,2,3')\n   941\u2192        with pytest.raises(ValueError):\n   942\u2192            client.simulate_get(path='/thing?x=1', params={'oid': 1978})\n   943\u2192        with pytest.raises(ValueError):\n   944\u2192            client.simulate_get(\n   945\u2192                path='/thing?x=1', query_string='things=1,2,3', params={'oid': 1978}\n   946\u2192            )\n   947\u2192\n   948\u2192        client.simulate_get(path='/thing?detailed=no&oid=1337')\n   949\u2192        assert resource.captured_req.path == '/thing'\n   950\u2192        assert resource.captured_req.query_string == 'detailed=no&oid=1337'\n   951\u2192\n   952\u2192    @pytest.mark.parametrize(\n   953\u2192        'document',\n   954\u2192        [\n   955\u2192            # NOTE(vytas): using an exact binary fraction here to avoid special\n   956\u2192            # code branch for approximate equality as it is not the focus here\n   957\u2192            16.0625,\n   958\u2192            123456789,\n   959\u2192            True,\n   960\u2192            '',\n   961\u2192            'I am a \\u1d0a\\ua731\\u1d0f\\u0274 string.',\n   962\u2192            [1, 3, 3, 7],\n   963\u2192            {'message': '\\xa1Hello Unicode! \\U0001f638'},\n   964\u2192            {\n   965\u2192                'count': 4,\n   966\u2192                'items': [\n   967\u2192                    {'number': 'one'},\n   968\u2192                    {'number': 'two'},\n   969\u2192                    {'number': 'three'},\n   970\u2192                    {'number': 'four'},\n   971\u2192                ],\n   972\u2192                'next': None,\n   973\u2192            },\n   974\u2192        ],\n   975\u2192    )\n   976\u2192    def test_simulate_json_body(self, asgi, document):\n   977\u2192        resource = (\n   978\u2192            testing.SimpleTestResourceAsync() if asgi else testing.SimpleTestResource()\n   979\u2192        )\n   980\u2192        app = create_app(asgi)\n   981\u2192        app.add_route('/', resource)\n   982\u2192\n   983\u2192        json_types = ('application/json', 'application/json; charset=UTF-8')\n   984\u2192        client = testing.TestClient(app)\n   985\u2192        client.simulate_post(\n   986\u2192            '/', json=document, headers={'capture-req-body-bytes': '-1'}\n   987\u2192        )\n   988\u2192        assert json.loads(resource.captured_req_body.decode()) == document\n   989\u2192        assert resource.captured_req.content_type in json_types\n   990\u2192\n   991\u2192        headers = {\n   992\u2192            'Content-Type': 'x-falcon/peregrine',\n   993\u2192            'X-Falcon-Type': 'peregrine',\n   994\u2192            'capture-req-media': 'y',\n   995\u2192        }\n   996\u2192        body = 'If provided, `json` parameter overrides `body`.'\n   997\u2192        client.simulate_post('/', headers=headers, body=body, json=document)\n   998\u2192        assert resource.captured_req_media == document\n   999\u2192        assert resource.captured_req.content_type in json_types\n  1000\u2192        assert resource.captured_req.get_header('X-Falcon-Type') == 'peregrine'\n  1001\u2192\n  1002\u2192    @pytest.mark.parametrize(\n  1003\u2192        'remote_addr',\n  1004\u2192        [\n  1005\u2192            None,\n  1006\u2192            '127.0.0.1',\n  1007\u2192            '8.8.8.8',\n  1008\u2192            '104.24.101.85',\n  1009\u2192            '2606:4700:30::6818:6455',\n  1010\u2192        ],\n  1011\u2192    )\n  1012\u2192    def test_simulate_remote_addr(self, app, remote_addr):\n  1013\u2192        class ShowMyIPResource:\n  1014\u2192            def on_get(self, req, resp):\n  1015\u2192                resp.text = req.remote_addr\n  1016\u2192                resp.content_type = falcon.MEDIA_TEXT\n  1017\u2192\n  1018\u2192        app.add_route('/', ShowMyIPResource())\n  1019\u2192\n  1020\u2192        client = testing.TestClient(app)\n  1021\u2192        resp = client.simulate_get('/', remote_addr=remote_addr)\n  1022\u2192        assert resp.status_code == 200\n  1023\u2192\n  1024\u2192        if remote_addr is None:\n  1025\u2192            assert resp.text == '127.0.0.1'\n  1026\u2192        else:\n  1027\u2192            assert resp.text == remote_addr\n  1028\u2192\n  1029\u2192    def test_simulate_hostname(self, app):\n  1030\u2192        resource = testing.SimpleTestResource()\n  1031\u2192        app.add_route('/', resource)\n  1032\u2192\n  1033\u2192        client = testing.TestClient(app)\n  1034\u2192        client.simulate_get('/', protocol='https', host='falcon.readthedocs.io')\n  1035\u2192        assert resource.captured_req.uri == 'https://falcon.readthedocs.io/'\n  1036\u2192\n  1037\u2192    @pytest.mark.parametrize(\n  1038\u2192        'extras,expected_headers',\n  1039\u2192        [\n  1040\u2192            (\n  1041\u2192                {},\n  1042\u2192                (('user-agent', 'falcon-client/' + falcon.__version__),),\n  1043\u2192            ),\n  1044\u2192            (\n  1045\u2192                {'HTTP_USER_AGENT': 'URL/Emacs', 'HTTP_X_FALCON': 'peregrine'},\n  1046\u2192                (('user-agent', 'URL/Emacs'), ('x-falcon', 'peregrine')),\n  1047\u2192            ),\n  1048\u2192        ],\n  1049\u2192    )\n  1050\u2192    def test_simulate_with_environ_extras(self, extras, expected_headers):\n  1051\u2192        app = falcon.App()\n  1052\u2192        resource = testing.SimpleTestResource()\n  1053\u2192        app.add_route('/', resource)\n  1054\u2192\n  1055\u2192        client = testing.TestClient(app)\n  1056\u2192        client.simulate_get('/', extras=extras)\n  1057\u2192\n  1058\u2192        for header, value in expected_headers:\n  1059\u2192            assert resource.captured_req.get_header(header) == value\n  1060\u2192\n  1061\u2192    def test_override_method_with_extras(self, asgi):\n  1062\u2192        app = create_app(asgi)\n  1063\u2192        app.add_route('/', testing.SimpleTestResource(body='test'))\n  1064\u2192        client = testing.TestClient(app)\n  1065\u2192\n  1066\u2192        with pytest.raises(ValueError):\n  1067\u2192            if asgi:\n  1068\u2192                client.simulate_get('/', extras={'method': 'PATCH'})\n  1069\u2192            else:\n  1070\u2192                client.simulate_get('/', extras={'REQUEST_METHOD': 'PATCH'})\n  1071\u2192\n  1072\u2192        result = client.simulate_get('/', extras={'REQUEST_METHOD': 'GET'})\n  1073\u2192        assert result.status_code == 200\n  1074\u2192        assert result.text == 'test'\n  1075\u2192\n  1076\u2192    @pytest.mark.parametrize(\n  1077\u2192        'content_type',\n  1078\u2192        [\n  1079\u2192            'application/json',\n  1080\u2192            'application/json; charset=UTF-8',\n  1081\u2192            'application/yaml',\n  1082\u2192        ],\n  1083\u2192    )\n  1084\u2192    def test_simulate_content_type(self, content_type):\n  1085\u2192        class MediaMirror:\n  1086\u2192            def on_post(self, req, resp):\n  1087\u2192                resp.media = req.media\n  1088\u2192\n  1089\u2192        app = create_app(asgi=False)\n  1090\u2192        app.add_route('/', MediaMirror())\n  1091\u2192\n  1092\u2192        client = testing.TestClient(app)\n  1093\u2192        headers = {'Content-Type': content_type}\n  1094\u2192        payload = b'{\"hello\": \"world\"}'\n  1095\u2192\n  1096\u2192        resp = client.simulate_post('/', headers=headers, body=payload)\n  1097\u2192\n  1098\u2192        if MEDIA_JSON in content_type:\n  1099\u2192            assert resp.status_code == 200\n  1100\u2192            assert resp.json == {'hello': 'world'}\n  1101\u2192        else:\n  1102\u2192            # JSON handler should not have been called for YAML\n  1103\u2192            assert resp.status_code == 415\n  1104\u2192\n  1105\u2192    @pytest.mark.parametrize(\n  1106\u2192        'content_type',\n  1107\u2192        [\n  1108\u2192            MEDIA_JSON,\n  1109\u2192            MEDIA_JSON + '; charset=UTF-8',\n  1110            MEDIA_YAML,\n  1111\u2192            MEDIA_MSGPACK,\n  1112\u2192            MEDIA_URLENCODED,\n  1113\u2192        ],\n  1114\u2192    )\n  1115\u2192    def test_simulate_content_type_extra_handler(self, asgi, content_type):\n  1116\u2192        class TestResourceAsync(testing.SimpleTestResourceAsync):\n  1117\u2192            def __init__(self):\n  1118\u2192                super().__init__()\n  1119\u2192\n  1120\u2192            async def on_post(self, req, resp):\n  1121\u2192                await super().on_post(req, resp)\n  1122\u2192\n  1123\u2192                resp.media = {'hello': 'back'}\n  1124\u2192                resp.content_type = content_type\n  1125\u2192\n  1126\u2192        class TestResource(testing.SimpleTestResource):\n  1127\u2192            def __init__(self):\n  1128\u2192                super().__init__()\n  1129\u2192\n  1130\u2192            def on_post(self, req, resp):\n  1131\u2192                super().on_post(req, resp)\n  1132\u2192\n  1133\u2192                resp.media = {'hello': 'back'}\n  1134\u2192                resp.content_type = content_type\n  1135\u2192\n  1136\u2192        resource = TestResourceAsync() if asgi else TestResource()\n  1137\u2192        app = create_app(asgi)\n  1138\u2192        app.add_route('/', resource)\n  1139\u2192\n  1140\u2192        json_handler = TrackingJSONHandler()\n  1141\u2192        msgpack_handler = TrackingMessagePackHandler()\n  1142\u2192        form_handler = TrackingFormHandler()\n  1143\u2192\n  1144\u2192        # NOTE(kgriffs): Do not use MEDIA_* so that we can sanity-check that\n  1145\u2192        #   our constants that are used in the pytest parametrization match\n  1146\u2192        #   up to what we expect them to be.\n  1147\u2192        extra_handlers = {\n  1148\u2192            'application/json': json_handler,\n  1149\u2192            'application/msgpack': msgpack_handler,\n  1150\u2192            'application/x-www-form-urlencoded': form_handler,\n  1151\u2192        }\n  1152\u2192        app.req_options.media_handlers.update(extra_handlers)\n  1153\u2192        app.resp_options.media_handlers.update(extra_handlers)\n  1154\u2192\n  1155\u2192        client = testing.TestClient(app)\n  1156\u2192        headers = {\n  1157\u2192            'Content-Type': content_type,\n  1158\u2192            'capture-req-media': 'y',\n  1159\u2192        }\n  1160\u2192\n  1161\u2192        if MEDIA_JSON in content_type:\n  1162\u2192            payload = b'{\"hello\": 