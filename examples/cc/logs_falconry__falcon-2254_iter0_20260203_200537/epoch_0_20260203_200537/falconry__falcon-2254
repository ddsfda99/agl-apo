n    47\u2192\n    48\u2192    __slots__ = (\n    49\u2192        '_asgi_receive',\n    50\u2192        '_asgi_send',\n    51\u2192        '_buffered_receiver',\n    52\u2192        '_close_code',\n    53\u2192        '_supports_accept_headers',\n    54\u2192        '_mh_bin_deserialize',\n    55\u2192        '_mh_bin_serialize',\n    56\u2192        '_mh_text_deserialize',\n    57\u2192        '_mh_text_serialize',\n    58\u2192        '_state',\n    59\u2192        'subprotocols',\n    60\u2192    )\n    61\u2192\n    62\u2192    def __init__(\n    63\u2192        self,\n    64\u2192        ver: str,\n    65\u2192        scope: dict,\n    66\u2192        receive: Callable[[], Awaitable[dict]],\n    67\u2192        send: Callable[[dict], Awaitable],\n    68\u2192        media_handlers: Mapping[\n    69\u2192            WebSocketPayloadType,\n    70\u2192            Union[media.BinaryBaseHandlerWS, media.TextBaseHandlerWS],\n    71\u2192        ],\n    72\u2192        max_receive_queue: int,\n    73\u2192    ):\n    74\u2192        self._supports_accept_headers = ver != '2.0'\n    75\u2192\n    76\u2192        # NOTE(kgriffs): Normalize the iterable to a stable tuple; note that\n    77\u2192        #   ordering is significant, and so we preserve it here.\n    78\u2192        self.subprotocols = tuple(scope.get('subprotocols', []))\n    79\u2192\n    80\u2192        # TODO(kgriffs): Should we make the use of _BufferedReceiver\n    81\u2192        #   configurable? For example, if the developer knows that\n    82\u2192        #   they will be interleaving receives and sends, then they\n    83\u2192        #   will be able to find out about the 'websocket.disconnect'\n    84\u2192        #   event via one of their receive() calls, and there is no\n    85\u2192        #   need for the added overhead.\n    86\u2192        self._buffered_receiver = _BufferedReceiver(receive, max_receive_queue)\n    87\u2192        self._asgi_receive = self._buffered_receiver.receive\n    88\u2192        self._asgi_send = send\n    89\u2192\n    90\u2192        mh_text = media_handlers[WebSocketPayloadType.TEXT]\n    91\u2192        self._mh_text_serialize = mh_text.serialize\n    92\u2192        self._mh_text_deserialize = mh_text.deserialize\n    93\u2192\n    94\u2192        mh_bin = media_handlers[WebSocketPayloadType.BINARY]\n    95\u2192        self._mh_bin_serialize = mh_bin.serialize\n    96\u2192        self._mh_bin_deserialize = mh_bin.deserialize\n    97\u2192\n    98\u2192        self._state = _WebSocketState.HANDSHAKE\n    99\u2192        self._close_code = None  # type: Optional[int]\n   100\u2192\n   101\u2192    @property\n   102\u2192    def unaccepted(self) -> bool:\n   103\u2192        return self._state == _WebSocketState.HANDSHAKE\n   104\u2192\n   105\u2192    @property\n   106\u2192    def closed(self) -> bool:\n   107\u2192        return (\n   108\u2192            self._state == _WebSocketState.CLOSED\n   109\u2192            or self._buffered_receiver.client_disconnected\n   110\u2192        )\n   111\u2192\n   112\u2192    @property\n   113\u2192    def ready(self) -> bool:\n   114\u2192        return (\n   115\u2192            self._state == _WebSocketState.ACCEPTED\n   116\u2192            and not self._buffered_receiver.client_disconnected\n   117\u2192        )\n   118\u2192\n   119\u2192    @property\n   120\u2192    def supports_accept_headers(self) -> bool:\n   121\u2192        return self._supports_accept_headers\n   122\u2192\n   123\u2192    async def accept(\n   124\u2192        self,\n   125\u2192        subprotocol: Optional[str] = None,\n   126\u2192        headers: Optional[Union[Iterable[Iterable[str]], Mapping[str, str]]] = None,\n   127\u2192    ):\n   128\u2192        \"\"\"Accept the incoming WebSocket connection.\n   129\u2192\n   130\u2192        If, after examining the connection's attributes (headers, advertised\n   131\u2192        subprotocols, etc.) the request should be accepted, the responder must\n   132\u2192        first await this coroutine method to finalize the WebSocket handshake.\n   133\u2192        Alternatively, the responder may deny the connection request by awaiting\n   134\u2192        the :meth:`~.close` method.\n   135\u2192\n   136\u2192        Keyword Arguments:\n   137\u2192            subprotocol (str): The subprotocol the app wishes to accept,\n   138\u2192                out of the list of protocols that the client suggested. If\n   139\u2192                more than one of the suggested protocols is acceptable,\n   140\u2192                the first one in the list from the client should be\n   141\u2192                selected (see also: :attr:`~.subprotocols`).\n   142\u2192\n   143\u2192                When left unspecified, a Sec-WebSocket-Protocol header will\n   144\u2192                not be included in the response to the client. The\n   145\u2192                client may choose to abandon the connection in this case,\n   146\u2192                if it does not receive an explicit protocol selection.\n   147\u2192\n   148\u2192            headers (Iterable[[str, str]]): An iterable of ``[name: str, value: str]``\n   149\u2192                two-item iterables, representing a collection of HTTP headers to\n   150\u2192                include in the handshake response. Both *name* and *value* must\n   151\u2192                be of type ``str`` and contain only US-ASCII characters.\n   152\u2192\n   153\u2192                Alternatively, a dict-like object may be passed that implements\n   154\u2192                an ``items()`` method.\n   155\u2192\n   156\u2192                Note:\n   157\u2192                    This argument is only supported for ASGI servers that\n   158\u2192                    implement spec version 2.1 or better. If an app needs to\n   159\u2192                    be compatible with multiple ASGI servers, it can\n   160\u2192                    reference the :attr:`~.supports_accept_headers` property to\n   161\u2192                    determine if the hosting server supports this feature.\n   162\u2192\n   163\u2192        \"\"\"\n   164\u2192\n   165\u2192        if self.closed:\n   166\u2192            raise errors.OperationNotAllowed(\n   167\u2192                'accept() may not be called on a closed WebSocket connection'\n   168\u2192            )\n   169\u2192\n   170\u2192        if self._state != _WebSocketState.HANDSHAKE:\n   171\u2192            raise errors.OperationNotAllowed(\n   172\u2192                'accept() may only be called once on an open WebSocket connection'\n   173\u2192            )\n   174\u2192\n   175\u2192        event: Dict[str, Any] = {\n   176\u2192            'type': EventType.WS_ACCEPT,\n   177\u2192        }\n   178\u2192\n   179\u2192        if subprotocol is not None:\n   180\u2192            if not isinstance(subprotocol, str):\n   181\u2192                raise ValueError('WebSocket subprotocol must be a string')\n   182\u2192\n   183\u2192            event['subprotocol'] = subprotocol\n   184\u2192\n   185\u2192        if headers:\n   186\u2192            if not self._supports_accept_headers:\n   187\u2192                raise errors.OperationNotAllowed(\n   188\u2192                    'The ASGI server that is running this app '\n   189\u2192                    'does not support accept headers.'\n   190\u2192                )\n   191\u2192\n   192\u2192            header_items = getattr(headers, 'items', None)\n   193\u2192\n   194\u2192            if callable(header_items):\n   195\u2192                headers = header_items()\n   196\u2192\n   197\u2192            event['headers'] = parsed_headers = [\n   198\u2192                (name.lower().encode('ascii'), value.encode('ascii'))\n   199\u2192                for name, value in headers  # type: ignore\n   200\u2192            ]\n   201\u2192\n   202\u2192            for name, __ in parsed_headers:\n   203\u2192                if name == b'sec-websocket-protocol':\n   204\u2192                    raise ValueError(\n   205\u2192                        'Per the ASGI spec, the headers iterable must not '\n   206\u2192                        'contain \"sec-websocket-protocol\". Instead, the '\n   207\u2192                        'subprotocol argument can be used to indicate the '\n   208\u2192                        'accepted protocol.'\n   209\u2192                    )\n   210\u2192\n   211\u2192        await self._send(event)\n   212\u2192        self._state = _WebSocketState.ACCEPTED\n   213\u2192\n   214\u2192        self._buffered_receiver.start()\n   215\u2192\n   216\u2192        # NOTE(kgriffs): We have to buffer received events so that we\n   217\u2192        #   will know when a disconnect happens and we can alert the app\n   218\u2192        #   via falcon.errors.WebSocketDisconnected so that the app knows\n   219\u2192        #   it should bail out if it is just emitting a series of messages\n   220\u2192        #   without ever reading any from the client.\n   221\u2192        #\n   222\u2192        # TODO(kgriffs): Bring this use case to the attention of the\n   223\u2192        #   ASGI spec committee and see if they can't come up with a better\n   224\u2192        #   way to deal with this.\n   225\u2192\n   226\u2192    async def close(self, code: Optional[int] = None) -> None:\n   227\u2192        \"\"\"Close the WebSocket connection.\n   228\u2192\n   229\u2192        This coroutine method sends a WebSocket ``CloseEvent`` to the client and\n   230\u2192        then proceeds to actually close the connection.\n   231\u2192\n   232\u2192        The responder can also use this method to deny a connection request\n   233\u2192        simply by awaiting it instead of :meth:`~.accept`. In this case,\n   234\u2192        the client will receive an HTTP 403 response to the handshake.\n   235\u2192\n   236\u2192        Keyword Arguments:\n   237\u2192            code (int): The close code to use for the `CloseEvent` (default\n   238\u2192                1000). See also:\n   239\u2192                https://developer.mozilla.org/en-US/docs/Web/API/CloseEvent\n   240\u2192\n   241\u2192        \"\"\"\n   242\u2192\n   243\u2192        # NOTE(kgriffs): Do this first to be sure we clean things up\n   244\u2192        #   in the case that we are going to raise an error next.\n   245\u2192        await self._buffered_receiver.stop()\n   246\u2192\n   247\u2192        if code is None:\n   248\u2192            code = WSCloseCode.NORMAL\n   249\u2192        elif not isinstance(code, int):\n   250\u2192            raise ValueError('code must be an int')\n   251\u2192        elif code < 1000:\n   252\u2192            raise ValueError('Invalid close code. The value must be >= 1000')\n   253\u2192        elif 1015 <= code <= 1999 or 1004 <= code <= 1006:\n   254\u2192            raise ValueError('Invalid close code. Only unreserved codes may be used.')\n   255\u2192\n   256\u2192        # NOTE(kgriffs): Only do this after we validate the code, to avoid\n   257\u2192        #   masking errors.\n   258\u2192        if self.closed:\n   259\u2192            return\n   260\u2192\n   261\u2192        await self._asgi_send(\n   262\u2192            {\n   263\u2192                'type': EventType.WS_CLOSE,\n   264\u2192                'code': code,\n   265\u2192            }\n   266\u2192        )\n   267\u2192\n   268\u2192        self._state = _WebSocketState.CLOSED\n   269\u2192        self._close_code = code\n   270\u2192\n   271\u2192    async def send_media(\n   272\u2192        self,\n   273\u2192        media: object,\n   274\u2192        payload_type: WebSocketPayloadType = WebSocketPayloadType.TEXT,\n   275\u2192    ) -> None:\n   276\u2192        \"\"\"Send a serializable object to the client.\n   277\u2192\n   278\u2192        The payload type determines the media handler that will be used\n   279\u2192        to serialize the given object (see also: :ref:`ws_media_handlers`).\n   280\u2192\n   281\u2192        Arguments:\n   282\u2192            media (object): The object to send.\n   283\u2192\n   284\u2192        Keyword Arguments:\n   285\u2192            payload_type (falcon.WebSocketPayloadType): The payload type to\n   286\u2192                use for the message (default ``falcon.WebSocketPayloadType.TEXT``).\n   287\u2192\n   288\u2192                Must be one of:\n   289\u2192\n   290\u2192                .. code:: python\n   291\u2192\n   292\u2192                    falcon.WebSocketPayloadType.TEXT\n   293\u2192                    falcon.WebSocketPayloadType.BINARY\n   294\u2192        \"\"\"\n   295\u2192\n   296\u2192        self._require_accepted()\n   297\u2192\n   298\u2192        if payload_type is WebSocketPayloadType.TEXT:\n   299\u2192            await self._send(\n   300\u2192                {\n   301\u2192                    'type': EventType.WS_SEND,\n   302\u2192                    'text': self._mh_text_serialize(media),\n   303\u2192                }\n   304\u2192            )\n   305\u2192        else:\n   306\u2192            await self._send(\n   307\u2192                {\n   308\u2192                    'type': EventType.WS_SEND,\n   309\u2192                    'bytes': self._mh_bin_serialize(media),\n   310\u2192                }\n   311\u2192            )\n   312\u2192\n   313\u2192    async def send_text(self, payload: str) -> None:\n   314\u2192        \"\"\"Send a message to the client with a Unicode string payload.\n   315\u2192\n   316\u2192        Arguments:\n   317\u2192            payload (str): The string to send.\n   318\u2192        \"\"\"\n   319\u2192\n   320\u2192        self._require_accepted()\n   321\u2192\n   322\u2192        # NOTE(kgriffs): We have to check ourselves because some ASGI\n   323\u2192        #   servers are not very strict which can lead to hard-to-debug\n   324\u2192        #   errors.\n   325\u2192        if not isinstance(payload, str):\n   326\u2192            raise TypeError('payload must be a string')\n   327\u2192\n   328\u2192        await self._send(\n   329\u2192            {\n   330\u2192                'type': EventType.WS_SEND,\n   331\u2192                'text': payload,\n   332\u2192            }\n   333\u2192        )\n   334\u2192\n   335\u2192    async def send_data(self, payload: Union[bytes, bytearray, memoryview]) -> None:\n   336\u2192        \"\"\"Send a message to the client with a binary data payload.\n   337\u2192\n   338\u2192        Arguments:\n   339\u2192            payload (Union[bytes, bytearray, memoryview]): The binary data to send.\n   340\u2192        \"\"\"\n   341\u2192\n   342\u2192        # NOTE(kgriffs): We have to check ourselves because some ASGI\n   343\u2192        #   servers are not very strict which can lead to hard-to-debug\n   344\u2192        #   errors.\n   345\u2192        if not isinstance(payload, (bytes, bytearray, memoryview)):\n   346\u2192            raise TypeError('payload must be a byte string')\n   347\u2192\n   348\u2192        self._require_accepted()\n   349\u2192\n   350\u2192        await self._send(\n   351\u2192            {\n   352\u2192                'type': EventType.WS_SEND,\n   353\u2192                'bytes': bytes(payload),\n   354\u2192            }\n   355\u2192        )\n   356\u2192\n   357\u2192    async def receive_text(self) -> str:\n   358\u2192        \"\"\"Receive a message from the client with a Unicode string payload.\n   359\u2192\n   360\u2192        Awaiting this coroutine will block until a message is available or\n   361\u2192        the WebSocket is disconnected.\n   362\u2192        \"\"\"\n   363\u2192\n   364\u2192        self._require_accepted()\n   365\u2192\n   366\u2192        event = await self._receive()\n   367\u2192\n   368\u2192        # PERF(kgriffs): When we normally expect the key to be\n   369\u2192        #   present, this pattern is faster than get()\n   370\u2192        try:\n   371\u2192            text = event['text']\n   372\u2192        except KeyError:\n   373\u2192            text = None\n   374\u2192\n   375\u2192        # NOTE(kgriffs): Even if the key is present, it may be None\n   376\u2192        if text is None:\n   377\u2192            raise errors.PayloadTypeError('Missing TEXT (0x01) payload')\n   378\u2192\n   379\u2192        return text\n   380\u2192\n   381\u2192    async def receive_data(self) -> bytes:\n   382\u2192        \"\"\"Receive a message from the client with a binary data payload.\n   383\u2192\n   384\u2192        Awaiting this coroutine will block until a message is available or\n   385\u2192        the WebSocket is disconnected.\n   386\u2192        \"\"\"\n   387\u2192\n   388\u2192        self._require_accepted()\n   389\u2192\n   390\u2192        event = await self._receive()\n   391\u2192\n   392\u2192        # PERF(kgriffs): When we normally expect the key to be\n   393\u2192        #   present, EAFP is faster than get()\n   394\u2192        try:\n   395\u2192            data = event['bytes']\n   396\u2192        except KeyError:\n   397\u2192            data = None\n   398\u2192\n   399\u2192        # NOTE(kgriffs): Even if the key is present, it may be None\n   400\u2192        if data is None:\n   401\u2192            raise errors.PayloadTypeError('Missing BINARY (0x02) payload')\n   402\u2192\n   403\u2192        return data\n   404\u2192\n   405\u2192    async def receive_media(self) -> object:\n   406\u2192        \"\"\"Receive a deserialized object from the client.\n   407\u2192\n   408\u2192        The incoming payload type determines the media handler that will be used\n   409\u2192        to deserialize the object (see also: :ref:`ws_media_handlers`).\n   410\u2192        \"\"\"\n   411\u2192\n   412\u2192        self._require_accepted()\n   413\u2192\n   414\u2192        event = await self._receive()\n   415\u2192\n   416\u2192        # NOTE(kgriffs): Most likely case is going to be JSON via text\n   417\u2192        #   payload, so try