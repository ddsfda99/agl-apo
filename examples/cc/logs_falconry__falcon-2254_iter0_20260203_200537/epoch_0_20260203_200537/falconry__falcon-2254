               else:\n   344\u2192                    encoding = self.encoding\n   345\u2192\n   346\u2192                self._text = self.content.decode(encoding)\n   347\u2192\n   348\u2192        return self._text\n   349\u2192\n   350\u2192    @property\n   351\u2192    def json(self) -> Optional[Union[dict, list, str, int, float, bool]]:\n   352\u2192        if not self.text:\n   353\u2192            return None\n   354\u2192\n   355\u2192        return json_module.loads(self.text)\n   356\u2192\n   357\u2192    def __repr__(self):\n   358\u2192        content_type = self.headers.get('Content-Type', '')\n   359\u2192\n   360\u2192        if len(self.content) > 40:\n   361\u2192            content = self.content[:20] + b'...' + self.content[-20:]\n   362\u2192        else:\n   363\u2192            content = self.content\n   364\u2192\n   365\u2192        args = [self.status, content_type, str(content)]\n   366\u2192\n   367\u2192        repr_result = ' '.join(filter(None, args))\n   368\u2192        return 'Result<{}>'.format(repr_result)\n   369\u2192\n   370\u2192\n   371\u2192class StreamedResult(_ResultBase):\n   372\u2192    \"\"\"Encapsulates the streamed result of an ASGI request.\n   373\u2192\n   374\u2192    Args:\n   375\u2192        body_chunks (list): A list of body chunks. This list may be\n   376\u2192            appended to after a result object has been instantiated.\n   377\u2192        status (str): An HTTP status string, including status code and\n   378\u2192            reason string\n   379\u2192        headers (list): A list of (header_name, header_value) tuples,\n   380\u2192            per PEP-3333\n   381\u2192        task (asyncio.Task): The scheduled simulated request which may or\n   382\u2192            may not have already finished. :meth:`~.finalize`\n   383\u2192            will await the task before returning.\n   384\u2192        req_event_emitter (~falcon.testing.ASGIRequestEventEmitter): A reference\n   385\u2192            to the event emitter used to simulate events sent to the ASGI\n   386\u2192            application via its receive() method.\n   387\u2192            :meth:`~.finalize` will cause the event emitter to\n   388\u2192            simulate an ``'http.disconnect'`` event before returning.\n   389\u2192\n   390\u2192    Attributes:\n   391\u2192        status (str): HTTP status string given in the response\n   392\u2192        status_code (int): The code portion of the HTTP status string\n   393\u2192        headers (CaseInsensitiveDict): A case-insensitive dictionary\n   394\u2192            containing all the headers in the response, except for\n   395\u2192            cookies, which may be accessed via the `cookies`\n   396\u2192            attribute.\n   397\u2192\n   398\u2192            Note:\n   399\u2192\n   400\u2192                Multiple instances of a header in the response are\n   401\u2192                currently not supported; it is unspecified which value\n   402\u2192                will \"win\" and be represented in `headers`.\n   403\u2192\n   404\u2192        cookies (dict): A dictionary of\n   405\u2192            :py:class:`falcon.testing.Cookie` values parsed from the\n   406\u2192            response, by name.\n   407\u2192        encoding (str): Text encoding of the response body, or ``None``\n   408\u2192            if the encoding can not be determined.\n   409\u2192        stream (ResultStream): Raw response body, as a byte stream.\n   410\u2192    \"\"\"\n   411\u2192\n   412\u2192    def __init__(self, body_chunks, status, headers, task, req_event_emitter):\n   413\u2192        super().__init__(status, headers)\n   414\u2192\n   415\u2192        self._task = task\n   416\u2192        self._stream = ResultBodyStream(body_chunks)\n   417\u2192        self._req_event_emitter = req_event_emitter\n   418\u2192\n   419\u2192    @property\n   420\u2192    def stream(self) -> ResultBodyStream:\n   421\u2192        return self._stream\n   422\u2192\n   423\u2192    async def finalize(self):\n   424\u2192        \"\"\"Finalize the encapsulated simulated request.\n   425\u2192\n   426\u2192        This method causes the request event emitter to begin emitting\n   427\u2192        ``'http.disconnect'`` events and then awaits the completion of the\n   428\u2192        asyncio task that is running the simulated ASGI request.\n   429\u2192        \"\"\"\n   430\u2192        self._req_event_emitter.disconnect()\n   431\u2192        await self._task\n   432\u2192\n   433\u2192\n   434\u2192# NOTE(kgriffs): The default of asgi_disconnect_ttl was chosen to be\n   435\u2192#   relatively long (5 minutes) to help testers notice when something\n   436\u2192#   appears to be \"hanging\", which might indicates that the app is\n   437\u2192#   not handling the reception of events correctly.\n   438\u2192def simulate_request(\n   439\u2192    app,\n   440\u2192    method='GET',\n   441\u2192    path='/',\n   442\u2192    query_string=None,\n   443\u2192    headers=None,\n   444\u2192    content_type=None,\n   445\u2192    body=None,\n   446\u2192    json=None,\n   447\u2192    file_wrapper=None,\n   448\u2192    wsgierrors=None,\n   449\u2192    params=None,\n   450\u2192    params_csv=False,\n   451\u2192    protocol='http',\n   452\u2192    host=helpers.DEFAULT_HOST,\n   453\u2192    remote_addr=None,\n   454\u2192    extras=None,\n   455\u2192    http_version='1.1',\n   456\u2192    port=None,\n   457\u2192    root_path=None,\n   458\u2192    cookies=None,\n   459\u2192    asgi_chunk_size=4096,\n   460\u2192    asgi_disconnect_ttl=300,\n   461\u2192) -> _ResultBase:\n   462\u2192    \"\"\"Simulate a request to a WSGI or ASGI application.\n   463\u2192\n   464\u2192    Performs a request against a WSGI or ASGI application. In the case of\n   465\u2192    WSGI, uses :any:`wsgiref.validate` to ensure the response is valid.\n   466\u2192\n   467\u2192    Note:\n   468\u2192        In the case of an ASGI request, this method will