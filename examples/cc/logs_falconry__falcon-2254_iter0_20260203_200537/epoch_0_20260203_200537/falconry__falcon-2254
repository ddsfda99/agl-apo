tus,\n   561\u2192                    'headers': resp._asgi_headers('text/event-stream'),\n   562\u2192                }\n   563\u2192            )\n   564\u2192\n   565\u2192            # PERF(vytas): Check resp._registered_callbacks directly to shave\n   566\u2192            #   off a function call since this is a hot/critical code path.\n   567\u2192            if resp._registered_callbacks:\n   568\u2192                self._schedule_callbacks(resp)\n   569\u2192\n   570\u2192            handler, _, _ = self.resp_options.media_handlers._resolve(\n   571\u2192                MEDIA_JSON, MEDIA_JSON, raise_not_found=False\n   572\u2192            )\n   573\u2192\n   574\u2192            # TODO(kgriffs): Do we need to do anything special to handle when\n   575\u2192            #   a connection is closed?\n   576\u2192            async for event in sse_emitter:\n   577\u2192                if not event:\n   578\u2192                    event = SSEvent()\n   579\u2192\n   580\u2192                # NOTE(kgriffs): According to the ASGI spec, once the client\n   581\u2192                #   disconnects, send() acts as a no-op. We have to check\n   582\u2192                #   the connection state using watch_disconnect() above.\n   583\u2192                await send(\n   584\u2192                    {\n   585\u2192                        'type': EventType.HTTP_RESPONSE_BODY,\n   586\u2192                        'body': event.serialize(handler),\n   587\u2192                        'more_body': True,\n   588\u2192                    }\n   589\u2192                )\n   590\u2192\n   591\u2192                if watcher.done():  # pragma: no py39,py310 cover\n   592\u2192                    break\n   593\u2192\n   594\u2192            watcher.cancel()\n   595\u2192            try:\n   596\u2192                await watcher\n   597\u2192            except asyncio.CancelledError:\n   598\u2192                pass\n   599\u2192\n   600\u2192            await send({'type': EventType.HTTP_RESPONSE_BODY})\n   601\u2192            return\n   602\u2192\n   603\u2192        if data is not None:\n   604\u2192            # PERF(kgriffs): B\u00f6se mu\u00dft sein. Operate directly on resp._headers\n   605\u2192            #   to reduce overhead since this is a hot/critical code path.\n   606\u2192            # NOTE(kgriffs): We always set content-length to match the\n   607\u2192            #   body bytes length, even if content-length is already set. The\n   608\u2192            #   reason being that web servers and LBs behave unpredictably\n   609\u2192            #   when the header doesn't match the body (sometimes choosing to\n   610\u2192            #   drop the HTTP connection prematurely, for example).\n   611\u2192            resp._headers['content-length'] = str(len(data))\n   612\u2192\n   613\u2192            await send(\n   614\u2192                {\n   615\u2192                    # PERF(vytas): Inline the value of\n   616\u2192                    #   EventType.HTTP_RESPONSE_START in this critical code path.\n   617\u2192                    'type': 'http.response.start',\n   618\u2192                    'status': resp_status,\n   619\u2192                    'headers': resp._asgi_headers(default_media_type),\n   620\u2192                }\n   621\u2192            )\n   622\u2192\n   623\u2192            await send(\n   624\u2192                {\n   625\u2192                    # PERF(vytas): Inline the value of\n   626\u2192                    #   EventType.HTTP_RESPONSE_BODY in this critical code path.\n   627\u2192                    'type': 'http.response.body',\n   628\u2192                    'body': data,\n   629\u2192                }\n   630\u2192            )\n   631\u2192\n   632\u2192            # PERF(vytas): Check resp._registered_callbacks directly to shave\n   633\u2192            #   off a function call since this is a hot/critical code path.\n   634\u2192            if resp._registered_callbacks:\n   635\u2192                self._schedule_callbacks(resp)\n   636\u2192            return\n   637\u2192\n   638\u2192        stream = resp.stream\n   639\u2192        if not stream:\n   640\u2192            resp._headers['content-length'] = '0'\n   641\u2192\n   642\u2192        await send(\n   643\u2192            {\n   644\u2192                # PERF(vytas): Inline the value of\n   645\u2192                #   EventType.HTTP_RESPONSE_START in this critical code path.\n   646\u2192                'type': 'http.response.start',\n   647\u2192                'status': resp_status,\n   648\u2192                'headers': resp._asgi_headers(default_media_type),\n   649\u2192            }\n   650\u2192        )\n   651\u2192\n   652\u2192        if stream:\n   653\u2192            # Detect whether this is one of the following:\n   654\u2192            #\n   655\u2192            #   (a) async file-like object (e.g., aiofiles)\n   656\u2192            #   (b) async generator\n   657\u2192            #   (c) async iterator\n   658\u2192            #\n   659\u2192\n   660\u2192            if hasattr(stream, 'read'):\n   661\u2192                try:\n   662\u2192                    while True:\n   663\u2192                        data = await stream.read(self._STREAM_BLOCK_SIZE)\n   664\u2192                        if data == b'':\n   665\u2192                            break\n   666\u2192                        else:\n   667\u2192                            await send(\n   668\u2192                                {\n   669\u2192                                    'type': EventType.HTTP_RESPONSE_BODY,\n   670\u2192                                    # NOTE(kgriffs): Handle the case in which\n   671\u2192                                    #   data is None\n   672\u2192                                    'body': data or b'',\n   673\u2192                                    'more_body': True,\n   674\u2192                                }\n   675\u2192                            )\n   676\u2192                finally:\n   677\u2192                    if hasattr(stream, 'close'):\n   678\u2192                        await stream.close()\n   679\u2192            else:\n   680\u2192                # NOTE(kgriffs): Works for both async generators and iterators\n   681\u2192                try:\n   682\u2192                    async for data in stream:\n   683\u2192                        # NOTE(kgriffs): We can not rely on StopIteration\n   684\u2192                        #   because of Pep 479 that is implemented starting\n   685\u2192                        #   with Python 3.7. AFAICT this is only an issue\n   686\u2192                        #   when using an async iterator instead of an async\n   687\u2192                        #   generator.\n   688\u2192                        if data is None:\n   689\u2192                            break\n   690\u2192\n   691\u2192                        await send(\n   692\u2192                            {\n   693\u2192                                'type': EventType.HTTP_RESPONSE_BODY,\n   694\u2192                                'body': data,\n   695\u2192                                'more_body': True,\n   696\u2192                            }\n   697\u2192                        )\n   698\u2192                except TypeError as ex:\n   699\u2192                    if isasyncgenfunction(stream):\n   700\u2192                        raise TypeError(\n   701\u2192                            'The object assigned to Response.stream appears to '\n   702\u2192                            'be an async generator function. A generator '\n   703\u2192                            'object is expected instead. This can be obtained '\n   704\u2192                            'simply by calling the generator function, e.g.: '\n   705\u2192                            'resp.stream = some_asyncgen_function()'\n   706\u2192                        )\n   707\u2192\n   708\u2192                    raise TypeError(\n   709\u2