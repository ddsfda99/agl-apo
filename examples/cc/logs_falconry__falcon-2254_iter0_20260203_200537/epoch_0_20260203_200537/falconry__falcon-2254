7\u2192    def simulate_ws(self, path='/', **kwargs):\n  1088\u2192        \"\"\"Simulate a WebSocket connection to an ASGI application.\n  1089\u2192\n  1090\u2192        All keyword arguments are passed through to\n  1091\u2192        :py:meth:`falcon.testing.create_scope_ws`.\n  1092\u2192\n  1093\u2192        This method returns an async context manager that can be used to obtain\n  1094\u2192        a managed :class:`falcon.testing.ASGIWebSocketSimulator` instance.\n  1095\u2192        Exiting the context will simulate a close on the WebSocket (if not\n  1096\u2192        already closed) and await the completion of the task that is\n  1097\u2192        running the simulated ASGI request.\n  1098\u2192\n  1099\u2192        In the following example, a series of WebSocket TEXT events are\n  1100\u2192        received from the ASGI app::\n  1101\u2192\n  1102\u2192            async with conductor.simulate_ws('/events') as ws:\n  1103\u2192                while some_condition:\n  1104\u2192                    message = await ws.receive_text()\n  1105\u2192\n  1106\u2192        \"\"\"\n  1107\u2192\n  1108\u2192        scope = helpers.create_scope_ws(path=path, **kwargs)\n  1109\u2192        ws = helpers.ASGIWebSocketSimulator()\n  1110\u2192\n  1111\u2192        task_req = create_task(self.app(scope, ws._emit, ws._collect))\n  1112\u2192\n  1113\u2192        return _WSContextManager(ws, task_req)\n  1114\u2192\n  1115\u2192    async def simulate_head(self, path='/', **kwargs) -> _ResultBase:\n  1116\u2192        \"\"\"Simulate a HEAD request to an ASGI application.\n  1117\u2192\n  1118\u2192        (See also: :py:meth:`falcon.testing.simulate_head`)\n  1119\u2192        \"\"\"\n  1120\u2192        return await self.simulate_request('HEAD', path, **kwargs)\n  1121\u2192\n  1122\u2192    async def simulate_post(self, path='/', **kwargs) -> _ResultBase:\n  1123\u2192        \"\"\"Simulate a POST request to an ASGI application.\n  1124\u2192\n  1125\u2192        (See a