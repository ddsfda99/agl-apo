diff --git a/src/streamlink/stream/dash/manifest.py b/src/streamlink/stream/dash/manifest.py
index 43eee496..8fb884ac 100644
--- a/src/streamlink/stream/dash/manifest.py
+++ b/src/streamlink/stream/dash/manifest.py
@@ -363,6 +363,16 @@ class MPD(MPDNode):
                 urlp[2], _ = urlp[2].rsplit("/", 1)
             self._base_url = urlunparse(urlp)
 
+        # Derive base URL from MPD document location if not explicitly set
+        # Use the parent directory of the MPD URL and drop any query/fragment
+        if not self._base_url and self.url:
+            urlp = urlsplit(self.url)
+            path = urlp.path
+            if path and not path.endswith("/"):
+                path = path.rsplit("/", 1)[0] + "/"
+            # Reconstruct URL with empty query/fragment
+            self._base_url = urlunsplit((urlp.scheme, urlp.netloc, path, "", ""))
+
         self.baseURLs = self.children(BaseURL)
         self.periods = self.children(Period, minimum=1)
         self.programInformation = self.children(ProgramInformation)
