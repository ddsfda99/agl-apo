9→                next_dvar_dp_eval = dvar_dp_func(t, u, inputs_stacked)\n   470→                if idx == 0:\n   471→                    dvar_dy_eval = next_dvar_dy_eval\n   472→                    dvar_dp_eval = next_dvar_dp_eval\n   473→                else:\n   474→                    dvar_dy_eval = casadi.diagcat(dvar_dy_eval, next_dvar_dy_eval)\n   475→                    dvar_dp_eval = casadi.vertcat(dvar_dp_eval, next_dvar_dp_eval)\n   476→\n   477→            # Compute sensitivity\n   478→            S_var = dvar_dy_eval @ dy_dp + dvar_dp_eval\n   479→            all_S_var.append(S_var)\n   480→\n   481→        S_var = casadi.vertcat(*all_S_var)\n   482→        sensitivities = {\"all\": S_var}\n   483→\n   484→        # Add the individual sensitivity\n   485→        start = 0\n   486→        for name, inp in self.all_inputs[0].items():\n   487→            end = start + inp.shape[0]\n   488→            sensitivities[name] = S_var[:, start:end]\n   489→            start = end\n   490→\n   491→        # Save attribute\n   492→        self._sensitivities = sensitivities\n   493→\n   494→    @property\n   495→    def hermite_interpolation(self):\n   496→        return self.all_yps is not None\n   497→\n   498→\n   499→class ProcessedVariable0D(ProcessedVariable):\n   500→    def __init__(\n   501→        self,\n   502→        base_variables,\n   503→        base_variables_casadi,\n   504→        solution,\n   505→        time_integral: Optional[pybamm.ProcessedVariableTimeIntegral] = None,\n   506→    ):\n   507→        self.dimensions = 0\n   508→        super().__init__(\n   509→            base_variables,\n   510→            base_variables_casadi,\n   511→            solution,\n   512→            time_integral=time_integral,\n   513→        )\n   514→\n   515→    def _observe_raw_python(self):\n   516→        pybamm.logger.debug(\"Observing the variable raw data in Python\")\n   517→        # initialise empty array of the correct size\n   518→        entries = np.empty(self._shape(self.t_pts))\n   519→        idx = 0\n   520→        # Evaluate the base_variable index-by-index\n   521→        for ts, ys, inputs, base_var_casadi in zip(\n   522→            self.all_ts, self.all_ys, self.all_inputs_casadi, self.base_variables_casadi\n   523→        ):\n   524→            for inner_idx, t in enumerate(ts):\n   525→                t = ts[inner_idx]\n   526→                y = ys[:, inner_idx]\n   527→                entries[idx] = float(base_var_casadi(t, y, inputs))\n   528→\n   529→                idx += 1\n   530→        return entries\n   531→\n   532→    def _observe_postfix(self, entries, t):\n   533→        if self.time_integral is None:\n   534→            return entries\n   535→        if self.time_integral.method == \"discrete\":\n   536→            return np.sum(entries, axis=0, initial=self.time_integral.initial_condition)\n   537→        elif self.time_integral.method == \"continuous\":\n   538→            return cumulative_trapezoid(\n   539→                entries, self.t_pts, initial=float(self.time_integral.initial_condition)\n   540→            )\n   541→        else:\n   542→            raise ValueError(\n   543→                \"time_integral method must be 'discrete' or 'continuous'\"\n   544→            )  # pragma: no cover\n   545→\n   546→    def _interp_setup(self, entries, t):\n   547→        # save attributes for interpolation\n   548→        entries_for_interp = entries\n   549→        coords_for_interp = {\"t\": t}\n   550→\n   551→        return entries_for_interp, coords_for_interp\n   552→\n   553→    def _shape(self, t):\n   554→        return [len(t)]\n   555→\n   556→\n   557→class ProcessedVariable1D(ProcessedVariable):\n   558→    \"\"\"\n   559→    An object that can be evaluated at arbitrary (scalars or vectors) t and x, and\n   560→    returns the (interpolated) value of the base variable at that t and x.\n   561→\n   562→    Parameters\n   563→    ----------\n   564→    base_variable