_casadi = to_casadi(x_s_edge, y_sol)\n   493\u2192        processed_x_s_edge = pybamm.process_variable(\n   494\u2192            [x_s_edge],\n   495\u2192            [x_s_casadi],\n   496\u2192            self._sol_default(t_sol, y_sol, yp_sol),\n   497\u2192        )\n   498\u2192        np.testing.assert_array_equal(\n   499\u2192            x_s_edge.entries.flatten(), processed_x_s_edge.entries[:, :, 0].T.flatten()\n   500\u2192        )\n   501\u2192\n   502\u2192    @pytest.mark.parametrize(\"hermite_interp\", _hermite_args)\n   503\u2192    def test_processed_variable_2D_space_only(self, hermite_interp):\n   504\u2192        var = pybamm.Variable(\n   505\u2192            \"var\",\n   506\u2192            domain=[\"negative particle\"],\n   507\u2192            auxiliary_domains={\"secondary\": [\"negative electrode\"]},\n   508\u2192        )\n   509\u2192        x = pybamm.SpatialVariable(\"x\", domain=[\"negative electrode\"])\n   510\u2192        r = pybamm.SpatialVariable(\n   511\u2192            \"r\",\n   512\u2192            domain=[\"negative particle\"],\n   513\u2192            auxiliary_domains={\"secondary\": [\"negative electrode\"]},\n   514\u2192        )\n   515\u2192\n   516\u2192        disc = tests.get_p2d_discretisation_for_testing()\n   517\u2192        disc.set_variable_slices([var])\n   518\u2192        x_sol = disc.process_symbol(x).entries[:, 0]\n   519\u2192        r_sol = disc.process_symbol(r).entries[:, 0]\n   520\u2192        # Keep only the first iteration of entries\n   521\u2192        r_sol = r_sol[: len(r_sol) // len(x_sol)]\n   522\u2192        var_sol = disc.process_symbol(var)\n   523\u2192        t_sol = np.array([0])\n   524\u2192        y_sol = np.ones(len(x_sol) * len(r_sol))[:, np.newaxis]\n   525\u2192        yp_sol = self._get_yps(y_sol, hermite_interp)\n   526\u2192\n   527\u2192        var_casadi = to_casadi(var_sol, y_sol)\n   528\u2192        processed_var = pybamm.process_variable(\n   529\u2192            [var_sol],\n   530\u2192            [var_casadi],\n   531\u2192            self._sol_default(t_sol, y_sol, yp_sol),\n   532\u2192        )\n   533\u2192        np.testing.assert_array_equal(\n   534\u2192            processed_var.entries,\n   535\u2192            np.reshape(y_sol, [len(r_sol), len(x_sol), len(t_sol)]),\n   536\u2192        )\n   537\u2192\n   538\u2192    @pytest.mark.parametrize(\"hermite_interp\", _hermite_args)\n   539\u2192    def test_processed_variable_2D_scikit(self, hermite_interp):\n   540\u2192        var = pybamm.Variable(\"var\", domain=[\"current collector\"])\n   541\u2192\n   542\u2192        disc = tests.get_2p1d_discretisation_for_testing()\n   543\u2192        disc.set_variable_slices([var])\n   544\u2192        y = disc.mesh[\"current collector\"].edges[\"y\"]\n   545\u2192        z = disc.mesh[\"current collector\"].edges[\"z\"]\n   546\u2192        var_sol = disc.process_symbol(var)\n   547\u2192        var_sol.mesh = disc.mesh[\"current collector\"]\n   548\u2192        t_sol = np.linspace(0, 1)\n   549\u2192        u_sol = np.ones(var_sol.shape[0])[:, np.newaxis] * np.linspace(0, 5)\n   550\u2192        yp_sol = self._get_yps(u_sol, hermite_interp)\n   551\u2192\n   552\u2192        var_casadi = to_casadi(var_sol, u_sol)\n   553\u2192        processed_var = pybamm.process_variable(\n   554\u2192            [var_sol],\n   555\u2192            [var_casadi],\n   556\u2192            self._sol_default(t_sol, u_sol, yp_sol),\n   557\u2192        )\n   558\u2192        np.testing.assert_array_equal(\n   559\u2192            processed_var.entries, np.reshape(u_sol, [len(y), len(z), len(t_sol)])\n   560\u2192        )\n   561\u2192\n   562\u2192    @pytest.mark.parametrize(\"hermite_interp\", _hermite_args)\n   563\u2192    def test_processed_variable_2D_fixed_t_scikit(self, hermite_interp):\n   564\u2192        var = pybamm.Variable(\"var\", domain=[\"current collector\"])\n   565\u2192\n   566\u2192        disc = tests.get_2p1d_discretisation_for_testing()\n   567\u2192        disc.set_variable_slices([var])\n   568\u2192        y = disc.mesh[\"current collector\"].edges[\"y\"]\n   569\u2192        z = disc.mesh[\"current collector\"].edges[\"z\"]\n   570\u2192        var_sol = disc.process_symbol(var)\n   571\u2192        var_sol.mesh = disc.mesh[\"current collector\"]\n   572\u2192        t_sol = np.array([0])\n   573\u2192        u_sol = np.ones(var_sol.shape[0])[:, np.newaxis]\n   574\u2192        yp_sol = self._get_yps(u_sol, hermite_interp)\n   575\u2192\n   576\u2192        var_casadi = to_casadi(var_sol, u_sol)\n   577\u2192        model = tests.get_base_model_with_battery_geometry(\n   578\u2192            options={\"dimensionality\": 2}\n   579\u2192        )\n   580\u2192        processed_var = pybamm.process_variable(\n   581\u2192            [var_sol],\n   582\u2192            [var_casadi],\n   583\u2192            pybamm.Solution(t_sol, u_sol, model, {}, all_yps=yp_sol),\n   584\u2192        )\n   585\u2192        np.testing.assert_array_equal(\n   586\u2192            processed_var.entries, np.reshape(u_sol, [len(y), len(z), len(t_sol)])\n   587\u2192        )\n   588\u2192\n   589\u2192    @pytest.mark.parametrize(\"hermite_interp\", _hermite_args)\n   590\u2192    def test_processed_var_0D_interpolation(self, hermite_interp):\n   591\u2192        # without spatial dependence\n   592\u2192        t = pybamm.t\n   593\u2192        y = pybamm.StateVector(slice(0, 1))\n   594\u2192        var = y\n   595\u2192        eqn = t * y\n   596\u2192        var.mesh = None\n   597\u2192        eqn.mesh = None\n   598\u2192\n   599\u2192        t_sol = np.linspace(0, 1, 1000)\n   600\u2192        y_sol = np.array([5 * t_sol])\n   601\u2192        yp_sol = self._get_yps(y_sol, hermite_interp, values=5)\n   602\u2192        var_casadi = to_casadi(var, y_sol)\n   603\u2192        processed_var = pybamm.process_variable(\n   604\u2192            [var],\n   605\u2192            [var_casadi],\n   606\u2192            self._sol_default(t_sol, y_sol, yp_sol),\n   607\u2192        )\n   608\u2192        # vector\n   609\u2192        np.testing.assert_array_equal(processed_var(t_sol), y_sol[0])\n   610\u2192        # scalar\n   611\u2192        np.testing.assert_array_almost_equal(processed_var(0.5), 2.5)\n   612\u2192        np.testing.assert_array_almost_equal(processed_var(0.7), 3.5)\n   613\u2192\n   614\u2192        eqn_casadi = to_casadi(eqn, y_sol)\n   615\u2192        processed_eqn = pybamm.process_variable(\n   616\u2192            [eqn],\n   617\u2192            [eqn_casadi],\n   618\u2192            self._sol_default(t_sol, y_sol, yp_sol),\n   619\u2192        )\n   620\u2192        np.testing.assert_array_equal(processed_eqn(t_sol), t_sol * y_sol[0])\n   621\u2192\n   622\u2192        assert processed_eqn(0.5).shape == ()\n   623\u2192\n   624\u2192        np.testing.assert_array_almost_equal(processed_eqn(0.5), 0.5 * 2.5)\n   625\u2192        np.testing.assert_array_equal(processed_eqn(2, fill_value=100), 100)\n   626\u2192        # Suppress warning for this test\n   627\u2192        pybamm.set_logging_level(\"ERROR\")\n   628\u2192        np.testing.assert_array_equal(processed_eqn(2), np.nan)\n   629\u2192        pybamm.set_logging_level(\"WARNING\")\n   630\u2192\n   631\u2192    @pytest.mark.parametrize(\"hermite_interp\", _hermite_args)\n   632\u2192    def test_processed_var_0D_fixed_t_interpolation(self, hermite_interp):\n   633\u2192        y = pybamm.StateVector(slice(0, 1))\n   634\u2192        var = y\n   635\u2192        eqn = 2 * y\n   636\u2192        var.mesh = None\n   637\u2192        eqn.mesh = None\n   638\u2192\n   639\u2192        t_sol = np.array([10])\n   640\u2192        y_sol = np.array([[100]])\n   641\u2192        yp_sol = self._get_yps(y_sol, hermite_interp)\n   642\u2192        eqn_casadi = to_casadi(eqn, y_sol)\n   643\u2192        processed_var = pybamm.process_variable(\n   644\u2192            [eqn],\n   645\u2192            [eqn_casadi],\n   646\u2192            self._sol_default(t_sol, y_sol, yp_sol, pybamm.BaseModel()),\n   647\u2192        )\n   648\u2192\n   649\u2192        assert processed_var() == 200\n   650\u2192\n   651\u2192    @pytest.mark.parametrize(\"hermite_interp\", _hermite_args)\n   652\u2192    def test_processed_var_1D_interpolation(self, hermite_interp):\n   653\u2192        t = pybamm.t\n   654\u2192        var = pybamm.Variable(\"var\", domain=[\"negative electrode\", \"separator\"])\n   655\u2192        x = pybamm.SpatialVariable(\"x\", domain=[\"negative electrode\", \"separator\"])\n   656\u2192        eqn = t * var + x\n   657\u2192\n   658\u2192        disc = tests.get_discretisation_for_testing()\n   659\u2192        disc.set_variable_slices([var])\n   660\u2192        x_sol = disc.process_symbol(x).entries[:, 0]\n   661\u2192        var_sol = disc.process_symbol(var)\n   662\u2192        eqn_sol = disc.process_symbol(eqn)\n   663\u2192        t_sol = np.linspace(0, 1)\n   664\u2192        y_sol = x_sol[:, np.newaxis] * (5 * t_sol)\n   665\u2192        yp_sol = self._get_yps(y_sol, hermite_interp, values=5)\n   666\u2192\n   667\u2192        var_casadi = to_casadi(var_sol, y_sol)\n   668\u2192        processed_var = pybamm.process_variable(\n   669\u2192            [var_sol],\n   670\u2192            [var_casadi],\n   671\u2192            self._sol_default(t_sol, y_sol, yp_sol),\n   672\u2192        )\n   673\u2192\n   674\u2192        # 2 vectors\n   675\u2192        np.testing.assert_array_almost_equal(processed_var(t_sol, x_sol), y_sol)\n   676\u2192        # 1 vector, 1 scalar\n   677\u2192        np.testing.assert_array_almost_equal(processed_var(0.5, x_sol), 2.5 * x_sol)\n   678\u2192        np.testing.assert_array_almost_equal(\n   679\u2192            processed_var(t_sol, x_sol[-1]),\n   680\u2192            x_sol[-1] * np.linspace(0, 5),\n   681\u2192        )\n   682\u2192        # 2 scalars\n   683\u2192        np.testing.assert_array_almost_equal(\n   684\u2192            processed_var(0.5, x_sol[-1]), 2.5 * x_sol[-1]\n   685\u2192        )\n   686\u2192        eqn_casadi = to_casadi(eqn_sol, y_sol)\n   687\u2192        processed_eqn = pybamm.process_variable(\n   688\u2192            [eqn_sol],\n   689\u2192            [eqn_casadi],\n   690\u2192            self._sol_default(t_sol, y_sol, yp_sol),\n   691\u2192        )\n   692\u2192        # 2 vectors\n   693\u2192        np.testing.assert_array_almost_equal(\n   694\u2192            processed_eqn(t_sol, x_sol), t_sol * y_sol + x_sol[:, np.newaxis]\n   695\u2192        )\n   696\u2192        # 1 vector, 1 scalar\n   697\u2192        assert processed_eqn(0.5, x_sol[10:30]).shape == (20,)\n   698\u2192        assert processed_eqn(t_sol[4:9], x_sol[-1]).shape == (5,)\n   699\u2192        # 2 scalars\n   700\u2192        assert processed_eqn(0.5, x_sol[-1]).shape == ()\n   701\u2192\n   702\u2192        # test x\n   703\u2192        x_disc = disc.process_symbol(x)\n   704\u2192        x_casadi = to_casadi(x_disc, y_sol)\n   705\u2192\n   706\u2192        processed_x = pybamm.process_variable(\n   707\u2192            [x_disc],\n   708\u2192            [x_casadi],\n   709\u2192            self._sol_default(t_sol, y_sol, yp_sol),\n   710\u2192        )\n   711\u2192        np.testing.assert_array_almost_equal(processed_x(t=0, x=x_sol), x_sol)\n   712\u2192\n   713\u2192        # In particles\n   714\u2192        r_n = pybamm.Matrix(\n   715\u2192            disc.mesh[\"negative particle\"].nodes, domain=\"negative particle\"\n   716\u2192        )\n   717\u2192        r_n.mesh = disc.mesh[\"negative particle\"]\n   718\u2192        r_n_casadi = to_casadi(r_n, y_sol)\n   719\u2192        processed_r_n = pybamm.process_variable(\n   720\u2192            [r_n],\n   721\u2192            [r_n_casadi],\n   722\u2192            self._sol_default(t_sol, y_sol, yp_sol),\n   723\u2192        )\n   724\u2192        np.testing.assert_array_equal(r_n.entries[:, 0], processed_r_n.entries[:, 0])\n   725\u2192        r_test = np.linspace(0, 0.5)\n   726\u2192        np.testing.assert_array_almost_equal(processed_r_n(0, r=r_test), r_test)\n   727\u2192\n   728\u2192        # On size domain\n   729\u2192        R_n = pybamm.Matrix(\n   730\u2192            disc.mesh[\"negative particle size\"].nodes, domain=\"negative particle size\"\n   731\u2192        )\n   732\u2192        R_n.mesh = disc.mesh[\"negative particle size\"]\n   733\u2192        R_n_casadi = to_casadi(R_n, y_sol)\n   734\u2192        model = tests.get_base_model_with_battery_geometry(\n   735\u2192            options={\"particle size\": \"distribution\"}\n   736\u2192        )\n   737\u2192        processed_R_n = pybamm.process_variable(\n   738\u2192            [R_n],\n   739\u2192            [R_n_casadi],\n   740\u2192            pybamm.Solution(t_sol, y_sol, model, {}),\n   741\u2192        )\n   742\u2192        np.testing.assert_array_equal(R_n.entries[:, 0], processed_R_n.entries[:, 0])\n   743\u2192        R_test = np.linspace(0, 1)\n   744\u2192        np.testing.assert_array_almost_equal(processed_R_n(0, R=R_test), R_test)\n   745\u2192\n   746\u2192    @pytest.mark.parametrize(\"hermite_interp\", _hermite_args)\n   747\u2192    def test_processed_var_1D_fixed_t_interpolation(self, hermite_interp):\n   748\u2192        var = pybamm.Variable(\"var\", domain=[\"negative electrode\", \"separator\"])\n   749\u2192        x = pybamm.SpatialVariable(\"x\", domain=[\"negative electrode\", \"separator\"])\n   750\u2192        eqn = var + x\n   751\u2192\n   752\u2192        disc = tests.get_discretisation_for_testing()\n   753\u2192        disc.set_variable_slices([var])\n   754\u2192        x_sol = disc.process_symbol(x).entries[:, 0]\n   755\u2192        eqn_sol = disc.process_symbol(eqn)\n   756\u2192        t_sol = np.array([1])\n   757\u2192        y_sol = x_sol[:, np.newaxis]\n   758\u2192        yp_sol = self._get_yps(y_sol, hermite_interp)\n   759\u2192