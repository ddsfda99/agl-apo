\u2192            else:\n   295\u2192                processed_entries = entries_for_interp\n   296\u2192        else:\n   297\u2192            processed_entries = entries\n   298\u2192\n   299\u2192        if not is_sorted:\n   300\u2192            idxs_unsort = np.zeros_like(idxs_sort)\n   301\u2192            idxs_unsort[idxs_sort] = np.arange(len(t_observe))\n   302\u2192\n   303\u2192            processed_entries = processed_entries[..., idxs_unsort]\n   304\u2192\n   305\u2192        # Remove a singleton time dimension if we interpolate in time with hermite\n   306\u2192        if hermite_time_interp and t_observe.size == 1:\n   307\u2192            processed_entries = np.squeeze(processed_entries, axis=-1)\n   308\u2192\n   309\u2192        return processed_entries\n   310\u2192\n   311\u2192    def _xr_interpolate(\n   312\u2192        self,\n   313\u2192        entries_for_interp,\n   314\u2192        coords,\n   315\u2192        observe_raw,\n   316\u2192        t=None,\n   317\u2192        x=None,\n   318\u2192        r=None,\n   319\u2192        y=None,\n   320\u2192        z=None,\n   321\u2192        R=None,\n   322\u2192        fill_value=None,\n   323\u2192    ):\n   324\u2192        \"\"\"\n   325\u2192        Evaluate the variable at arbitrary *dimensional* t (and x, r, y, z and/or R),\n   326\u2192        using interpolation\n   327\u2192        \"\"\"\n   328\u2192        if observe_raw:\n   329\u2192            if not self.xr_array_raw_initialized:\n   330\u2192                self._xr_array_raw = xr.DataArray(entries_for_interp, coords=coords)\n   331\u2192            xr_data_array = self._xr_array_raw\n   332\u2192        else:\n   333\u2192            xr_data_array = xr.DataArray(entries_for_interp, coords=coords)\n   334\u2192\n   335\u2192        kwargs = {\"t\": t, \"x\": x, \"r\": r, \"y\": y, \"z\": z, \"R\": R}\n   336\u2192\n   337\u2192        # Remove any None arguments\n   338\u2192        kwargs = {key: value for key, value in kwargs.items() if value is not None}\n   339\u2192\n   340\u2192        # Use xarray interpolation, return numpy array\n   341\u2192        # xarray>=0.20 supports kwargs for backend, but to be robust across versions\n   342\u2192        # perform interpolation first, then replace NaNs/out-of-domain with fill_value\n   343\u2192        try:\n   344\u2192            out_da = xr_data_array.interp(**kwargs, kwargs={\"fill_value\": fill_value})\n   345\u2192            out = out_da.values\n   346\u2192        except TypeError:\n   347\u2192            out_da = xr_data_array.interp(**kwargs)\n   348\u2192            out = out_da.values\n   349\u2192            if fill_value is not None and not (isinstance(fill_value, str) and fill_value == \"extrapolate\"):\n   350\u2192                # replace NaNs with fill_value\n   351\u2192                if np.isscalar(fill_value):\n   352\u2192                    out = np.where(np.isnan(out), fill_value, out)\n   353\u2192        return out\n   354\u2192\n   355\u2192        return out\n   356\u2192\n   357\u2192    def _check_observe_raw(self, t):\n   358\u2192        \"\"\"\n   359\u2192        Checks if the raw data should be observed exactly at the solution time points\n   360\u2192\n   361\u2192        Args:\n   362\u2192            t (np.ndarray, list, None): time points to observe\n   363\u2192\n   364\u2192        Returns:\n   365\u2192            t_observe (np.ndarray): time points to observe\n   366\u2192            observe_raw (bool): True if observing the raw data\n   367\u2192        \"\"\"\n   368\u2192        # if this is a time integral variable, t must be None and we observe either the\n   369\u2192        # data times (for a discrete sum) or the solution times (for a continuous sum)\n   370\u2192        if self.time_integral is not None:\n   371\u2192            if self.time_integral.method == \"discrete\":\n   372\u2192                # discrete sum should be observed at the discrete times\n   373\u2192                t = self.time_integral.discrete_times\n   374\u2192            else:\n   375\u2192                # assume we can do a sufficiently accurate trapezoidal integration at t_pts\n   376\u2192                t = self.t_pts\n   377\u2192\n   378\u2192        observe_raw = (t is None) or (\n   379\u2192            np.asarray(t).size == len(self.t_pts) and np.all(t == self.t_pts)\n   380\u2192        )\n   381\u2192\n   382\u2192        if observe_raw:\n   383\u2192            t_observe = self.t_pts\n   384\u2192        elif not isinstance(t, np.ndarray):\n   385\u2192            if not isinstance(t, list):\n   386\u2192                t = [t]\n   387\u2192            t_observe = np.array(t)\n   388\u2192        else:\n   389\u2192            t_observe = t\n   390\u2192\n   391\u2192        if t_observe[0] < self.t_pts[0]:\n   392\u2192            raise ValueError(\n   393\u2192                \"The interpolation points must be greater than or equal to the initial solution time\"\n   394\u2192            )\n   395\u2192\n   396\u2192        return t_observe, observe_raw\n   397\u2192\n   398\u2192    @property\n   399\u2192    def entries(self):\n   400\u2192        \"\"\"\n   401\u2192        Returns the raw data entries of the processed variable. If the processed\n   402\u2192        variable has not been initialized (i.e. the entries have not been\n   403\u2192        calculated), then the processed variable is initialized first.\n   404\u2192        \"\"\"\n   405\u2192        self.initialise()\n   406\u2192        return self._entries_raw\n   407\u2192\n   408\u2192    @property\n   409\u2192    def data(self):\n   410\u2192        \"\"\"Same as entries, but different name\"\"\"\n   411\u2192        return self.entries\n   412\u2192\n   413\u2192    @property\n   414\u2192    def entries_raw_initialized(self):\n   415\u2192        return self._entries_raw is not None\n   416\u2192\n   417\u2192    @property\n   418\u2192    def xr_array_raw_initialized(self):\n   419\u2192        return self._xr_array_raw is not None\n   420\u2192\n   421\u2192    @property\n   422\u2192    def sensitivities(self):\n   423\u2192        \"\"\"\n   424\u2192        Returns a dictionary of sensitivities for each input parameter.\n   425\u2192        The keys are the input parameters, and the value is a matrix of size\n   426\u2192        (n_x * n_t, n_p), where n_x is the number of states, n_t is the number of time\n   427\u2192        points, and n_p is the size of the input parameter\n   428\u2192        \"\"\"\n   429\u2192        # No sensitivities if there are no inputs\n   430\u2192        if len(self.all_inputs[0]) == 0:\n   431\u2192            return {}\n   432\u2192        # Otherwise initialise and return sensitivities\n   433\u2192        if self._sensitivities is None:\n   434\u2192            if self.all_solution_sensitivities:\n   435\u2192                self.initialise_sensitivity_explicit_forward()\n   436\u2192            else:\n   437\u2192                raise ValueError(\n   438\u2192                    \"Cannot compute sensitivities. The 'calculate_sensitivities' \"\n   439\u2192                    \"argument of the solver.solve should be changed from 'None' to \"\n   440\u2192                    \"allow sensitivities calculations. Check solver documentation for \"\n   441\u2192                    \"details.\"\n   442\u2192                )\n   443\u2192        return self._sensitivities\n   444\u2192\n   445\u2192    def initialise_sensitivity_explicit_forward(self):\n   446\u2192        \"Set up the sensitivity dictionary\"\n   447\u2192\n   448\u2192        all_S_var = []\n   449\u2192        for ts, ys, inputs_stacked, inputs, base_variable, dy_dp in zip(\n   450\u2192            self.all_ts,\n   451\u2192            self.all_ys,\n   452\u2192            self.all_inputs_casadi,\n   453\u2192            self.all_inputs,\n   454\u2192            self.base_variables,\n   455\u2192            self.all_solution_sensitivities[\"all\"],\n   456\u2192        ):\n   457\u2192            # Set up symbolic variables\n   458\u2192            t_casadi = casadi.MX.sym(\"t\")\n   459\u2192            y_casadi = casadi.MX.sym(\"y\", ys.shape[0])\n   460\u2192            p_casadi = {\n   461\u2192                name: casadi.MX.sym(name, value.shape[0])\n   462\u2192                for name, value in inputs.items()\n   463\u2192            }\n   464\u2192\n   465\u2192            p_casadi_stacked = casadi.vertcat(*[p for p in p_casadi.values()])\n   466\u2192\n   467\u2192            # Convert variable to casadi format for differentiating\n   468\u2192            var_casadi = base_variable.to_casadi(t_casadi, y_casadi, inputs=p_casadi)\n   469\u2192            dvar_dy = casadi.jacobian(var_casadi, y_casadi)\n   470\u2192            dvar_dp = casadi.jacobian(var_casadi, p_casadi_stacked)\n   471\u2192\n   472\u2192            # Convert to functions and evaluate index-by-index\n   473\u2192            dvar_dy_func = casadi.Function(\n   474\u2192                \"dvar_dy\", [t_casadi, y_casadi, p_casadi_stacked], [dvar_dy]\n   475\u2192            )\n   476\u2192            dvar_dp_func = casadi.Function(\n   477\u2192                \"dvar_dp\", [t_casadi, y_casadi, p_casadi_stacked], [dvar_dp]\n   478\u2192            )\n   479\u2192            for idx, t in enumerate(ts):\n   480\u2192                u = ys[:, idx]\n   481\u2192                next_dvar_dy_eval = dvar_dy_func(t, u, inputs_stacked)\n   482\u2192                next_dvar_dp_eval = dvar_dp_func(t, u, inputs_stacked)\n   483\u2192                if idx == 0:\n   484\u2192                    dvar_dy_eval = next_dvar_dy_eval\n   485\u2192                    dvar_dp_eval = next_dvar_dp_eval\n   486\u2192                else:\n   487\u2192                    dvar_dy_eval = casadi.diagcat(dvar_dy_eval, next_dvar_dy_eval)\n   488\u2192                    dvar_dp_eval = casadi.vertcat(dvar_dp_eval, next_dvar_dp_eval)\n   489\u2192\n   490\u2192            # Compute sensitivity\n   491\u2192            S_var = dvar_dy_eval @ dy_dp + dvar_dp_eval\n   492\u2192            all_S_var.append(S_var)\n   493\u2192\n   494\u2192        S_var = casadi.vertcat(*all_S_var)\n   495\u2192        sensitivities = {\"all\": S_var}\n   496\u2192\n   497\u2192        # Add the individual sensitivity\n   498\u2192        start = 0\n   499\u2192        for name, inp in self.all_inputs[0].items():\n   500\u2192            end = start + inp.shape[0]\n   501\u2192            sensitivities[name] = S_var[:, start:end]\n   502\u2192            start = end\n   503\u2192\n   504\u2192        # Save attribute\n   505\u2192        self._sensitivities = sensitivities\n   506\u2192\n   507\u2192    @property\n   508\u2192    def hermite_interpolation(self):\n   509\u2192        return self.all_yps is not None\n   510\u2192\n   511\u2192\n   512\u2192class ProcessedVariable0D(ProcessedVariable):\n   513\u2192    def __init__(\n   514\u2192        self,\n   515\u2192        base_variables,\n   516\u2192        base_variables_casadi,\n   517\u2192        solution,\n   518\u2192        time_integral: Optional[pybamm.ProcessedVariableTimeIntegral] = None,\n   519\u2192    ):\n   520\u2192        self.dimensions = 0\n   521\u2192        super().__init__(\n   522\u2192            base_variables,\n   523\u2192            base_variables_casadi,\n   524\u2192            solution,\n   525\u2192            time_integral=time_integral,\n   526\u2192        )\n   527\u2192\n   528\u2192    def _observe_raw_python(self):\n   529\u2192        pybamm.logger.debug(\"Observing the variable raw data in Python\")\n   530\u2192        # initialise empty array of the correct size\n   531\u2192        entries = np.empty(self._shape(self.t_pts))\n   532\u2192        idx = 0\n   533\u2192        # Evaluate the base_variable index-by-index\n   534\u2192        for ts, ys, inputs, base_var_casadi in zip(\n   535\u2192            self.all_ts, self.all_ys, self.