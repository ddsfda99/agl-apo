not None:\n   913→                    mesh = node.mesh\n   914→                    domain = getattr(node, \"domain\", domain)\n   915→                if secondary_mesh is None and hasattr(node, \"secondary_mesh\"):\n   916→                    if node.secondary_mesh is not None:\n   917→                        secondary_mesh = node.secondary_mesh\n   918→                # break early if we have what we need\n   919→                if mesh is not None and (secondary_mesh is not None or base_eval_size):\n   920→                    pass\n   921→        except Exception:\n   922→            # If pre_order not available or something unexpected, keep best-effort values\n   923→            pass\n   924→\n   925→    # handle 2D (in space) finite element variables differently\n   926→    if (\n   927→        mesh is not None\n   928→        and \"current collector\" in (domain or [])\n   929→        and isinstance(mesh, pybamm.ScikitSubMesh2D)\n   930→    ):\n   931→        return ProcessedVariable2DSciKitFEM(base_variables, *args, **kwargs)\n   932→\n   933→    # If we still don't have a mesh, conservatively treat as 0D\n   934→    if mesh is None:\n   935→        return ProcessedVariable0D(base_variables, *args, **kwargs)\n   936→\n   937→    # check for 1D variables based on mesh size\n   938→    n = mesh.npts\n   939→    base_shape = base_eval_shape[0]\n   940→    if base_shape in [n, n + 1]:\n   941→        return ProcessedVariable1D(base_variables, *args, **kwargs)\n   942→\n   943→    # Try some shapes that could make the variable a 2D variable\n   944→    first_dim_nodes = mesh.nodes\n   945→    first_dim_edges = mesh.edges\n   946→    if secondary_mesh is None:\n   947→        # attempt traversal if not already found\n   948→        try:\n   949→            for node in base_var.pre_order():\n   950→                if hasattr(node, \"secondary_mesh\") and node.secondary_mesh is not None:\n   951→                    secondary_mesh = node.secondary_mesh\n   952→        