eNdArray(inputs)\n   163\u2192\n   164\u2192        # Generate the serialized C++ functions only once\n   165\u2192        funcs_unique = {}\n   166\u2192        funcs = [None] * len(idxs)\n   167\u2192        for i in range(len(idxs)):\n   168\u2192            vars = self.base_variables_casadi[idxs[i]]\n   169\u2192            if vars not in funcs_unique:\n   170\u2192                funcs_unique[vars] = vars.serialize()\n   171\u2192            funcs[i] = funcs_unique[vars]\n   172\u2192\n   173\u2192        return ts, ys, yps, funcs, inputs, is_f_contiguous\n   174\u2192\n   175\u2192    def _observe_hermite_cpp(self, t):\n   176\u2192        pybamm.logger.debug(\"Observing and Hermite interpolating the variable in C++\")\n   177\u2192\n   178\u2192        ts, ys, yps, funcs, inputs, _ = self._setup_cpp_inputs(t, full_range=False)\n   179\u2192        shapes = self._shape(t)\n   180\u2192        return pybamm.solvers.idaklu_solver.idaklu.observe_hermite_interp(\n   181\u2192            t, ts, ys, yps, inputs, funcs, shapes\n   182\u2192        )\n   183\u2192\n   184\u2192    def _observe_raw_cpp(self):\n   185\u2192        pybamm.logger.debug(\"Observing the variable raw data in C++\")\n   186\u2192        t = self.t_pts\n   187\u2192        ts, ys, _, funcs, inputs, is_f_contiguous = self._setup_cpp_inputs(\n   188\u2192            t, full_range=True\n   189\u2192        )\n   190\u2192        shapes = self._shape(self.t_pts)\n   191\u2192\n   192\u2192        return pybamm.solvers.idaklu_solver.idaklu.observe(\n   193\u2192            ts, ys, inputs, funcs, is_f_contiguous, shapes\n   194\u2192        )\n   195\u2192\n   196\u2192    def _observe_raw_python(self):\n   197\u2192        raise NotImplementedError  # pragma: no cover\n   198\u2192\n   199\u2192    def _observe_postfix(self, entries, t):\n   200\u2192        return entries\n   201\u2192\n   202\u2192    def _interp_setup(self, entries, t):\n   203\u2192        raise NotImplementedError  # pragma: no cover\n   204\u2192\n   205\u2192    def _shape(self, t):\n   206\u2192        raise NotImplementedError  # pragma: no cover\n   207\u2192\n   208\u2192    def _process_spatial_variable_names(self, spatial_variable):\n   209\u2192        if len(spatial_variable) == 0:\n   210\u2192            return None\n   211\u2192\n   212\u2192        # Extract names\n   213\u2192        raw_names = []\n   214\u2192        for var in spatial_variable:\n   215\u2192            # Ignore tabs in domain names\n   216\u2192            if var == \"tabs\":\n   217\u2192                continue\n   218\u2192            if isinstance(var, str):\n   219\u2192                raw_names.append(var)\n   220\u2192            else:\n   221\u2192                raw_names.append(var.name)\n   222\u2192\n   223\u2192        # Rename battery variables to match PyBaMM convention\n   224\u2192        if all([var.startswith(\"r\") for var in raw_names]):\n   225\u2192            return \"r\"\n   226\u2192        elif all([var.startswith(\"x\") for var in raw_names]):\n   227\u2192            return \"x\"\n   228\u2192        elif all([var.startswith(\"R\") for var in raw_names]):\n   229\u2192            return \"R\"\n   230\u2192        elif len(raw_names) == 1:\n   231\u2192            return raw_names[0]\n   232\u2192        else:\n   233\u2192            raise NotImplementedError(\n   234\u2192                f\"Spatial variable name not recognized for {spatial_variable}\"\n   235\u2192            )\n   236\u2192\n   237\u2192    def __call__(\n   238\u2192        self,\n   239\u2192        t=None,\n   240\u2192        x=None,\n   241\u2192        r=None,\n   242\u2192        y=None,\n   243\u2192        z=None,\n   244\u2192        R=None,\n   245\u2192        fill_value=np.nan,\n   246\u2192    ):\n   247\u2192        # Check to see if we are interpolating exactly onto the raw solution time points\n   248\u2192        t_observe, observe_raw = self._check_observe_raw(t)\n   249\u2192\n   250\u2