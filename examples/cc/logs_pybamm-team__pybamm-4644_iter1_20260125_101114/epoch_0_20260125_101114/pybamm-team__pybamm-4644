essedVariable1D(ProcessedVariable):\n   571→    \"\"\"\n   572→    An object that can be evaluated at arbitrary (scalars or vectors) t and x, and\n   573→    returns the (interpolated) value of the base variable at that t and x.\n   574→\n   575→    Parameters\n   576→    ----------\n   577→    base_variables : list of :class:`pybamm.Symbol`\n   578→        A list of base variables with a method `evaluate(t,y)`, each entry of which\n   579→        returns the value of that variable for that particular sub-solution.\n   580→        A Solution can be comprised of sub-solutions which are the solutions of\n   581→        different models.\n   582→        Note that this can be any kind of node in the expression tree, not\n   583→        just a :class:`pybamm.Variable`.\n   584→        When evaluated, returns an array of size (m,n)\n   585→    base_variables_casadi : list of :class:`casadi.Function`\n   586→        A list of casadi functions. When evaluated, returns the same thing as\n   587→        `base_Variable.evaluate` (but more efficiently).\n   588→    solution : :class:`pybamm.Solution`\n   589→        The solution object to be used to create the processed variables\n   590→    \"\"\"\n   591→\n   592→    def __init__(\n   593→        self,\n   594→        base_variables,\n   595→        base_variables_casadi,\n   596→        solution,\n   597→        time_integral: Optional[pybamm.ProcessedVariableTimeIntegral] = None,\n   598→    ):\n   599→        self.dimensions = 1\n   600→        super().__init__(\n   601→            base_variables,\n   602→            base_variables_casadi,\n   603→            solution,\n   604→            time_integral=time_integral,\n   605→        )\n   606→\n   607→    def _observe_raw_python(self):\n   608→        pybamm.logger.debug(\"Observing the variable raw data in Python\")\n   609→        entries = np.empty(self._shape(self.t_pts))\n   610→\n   611→        # Evaluate the base_variable index-by-index\n   612→        idx = 0\n   613→        for ts, ys, inputs, base_var_casadi in zip(\n   614→            self.all_ts, self.all_ys, self.all_inputs_casadi, self.base_variables_casadi\n   615→        ):\n   616→            for inner_idx, t in enumerate(ts):\n   617→                t = ts[inner_idx]\n   618→                y = ys[:, inner_idx]\n   619→                entries[:, idx] = base_var_casadi(t, y, inputs).full()[:, 0]\n   620→                idx += 1\n   621→        return entries\n   622→\n   623→    def _interp_setup(self, entries, t):\n   624→        # Get node and edge values\n   625→        nodes = self.mesh.nodes\n   626→        edges = self.mesh.edges\n   627→        if entries.shape[0] == len(nodes):\n   628→            space = nodes\n   629→        elif entries.shape[0] == len(edges):\n   630→            space = edges\n   631→\n   632→        # add points outside domain for extrapolation to boundaries\n   633→        extrap_space_left = np.array([2 * space[0] - space[1]])\n   634→        extrap_space_right = np.array([2 * space[-1] - space[-2]])\n   635→        space = np.concatenate([extrap_space_left, space, extrap_space_right])\n   636→        extrap_entries_left = 2 * entries[0] - entries[1]\n   637→        extrap_entries_right = 2 * entries[-1] - entries[-2]\n   638→        entries_for_interp = np.vstack(\n   639→            [extrap_entries_left, entries, extrap_entries_right]\n   640→        )\n   641→\n   642→        # assign attributes for reference (either x_sol or r_sol)\n   643→        self.spatial_variable_names = {\n   644→            k: self._process_spatial_variable_names(v)\n   645→            for k, v in self.spatial_variables.items()\n   646→        }\n   647→        self.first_dimension = self.spatial_variable_names[\"primary\"]\n   648→\n   649→        # assign attributes for reference\n   650→        pts_for_interp = space\n   651→        self.internal_boundaries = self.mesh.internal_boundaries\n   652→\n   653→        # Set first_dim_pts to edges for nicer pl