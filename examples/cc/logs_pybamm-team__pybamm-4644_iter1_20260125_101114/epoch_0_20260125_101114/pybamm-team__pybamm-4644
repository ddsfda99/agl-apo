                        "content": "     1\u2192#\n     2\u2192# Processed Variable class\n     3\u2192#\n     4\u2192from typing import Optional\n     5\u2192import casadi\n     6\u2192import numpy as np\n     7\u2192import pybamm\n     8\u2192from scipy.integrate import cumulative_trapezoid\n     9\u2192import xarray as xr\n    10\u2192import bisect\n    11\u2192\n    12\u2192\n    13\u2192class ProcessedVariable:\n    14\u2192    \"\"\"\n    15\u2192    An object that can be evaluated at arbitrary (scalars or vectors) t and x, and\n    16\u2192    returns the (interpolated) value of the base variable at that t and x.\n    17\u2192\n    18\u2192    Parameters\n    19\u2192    ----------\n    20\u2192    base_variables : list of :class:`pybamm.Symbol`\n    21\u2192        A list of base variables with a method `evaluate(t,y)`, each entry of which\n    22\u2192        returns the value of that variable for that particular sub-solution.\n    23\u2192        A Solution can be comprised of sub-solutions which are the solutions of\n    24\u2192        different models.\n    25\u2192        Note that this can be any kind of node in the expression tree, not\n    26\u2192        just a :class:`pybamm.Variable`.\n    27\u2192        When evaluated, returns an array of size (m,n)\n    28\u2192    base_variables_casadi : list of :class:`casadi.Function`\n    29\u2192        A list of casadi functions. When evaluated, returns the same thing as\n    30\u2192        `base_Variable.evaluate` (but more efficiently).\n    31\u2192    solution : :class:`pybamm.Solution`\n    32\u2192        The solution object to be used to create the processed variables\n    33\u2192    time_integral : :class:`pybamm.ProcessedVariableTimeIntegral`, optional\n    34\u2192        Not none if the variable is to be time-integrated (default is None)\n    35\u2192    \"\"\"\n    36\u2192\n    37\u2192    def __init__(\n    38\u2192        self,\n    39\u2192        base_variables,\n    40\u2192        base_variables_casadi,\n    41\u2192        solution,\n    42\u2192        time_integral: Optional[pybamm.ProcessedVariableTimeIntegral] = None,\n    43\u2192    ):\n    44\u2192        self.base_variables = base_variables\n    45\u2192        self.base_variables_casadi = base_variables_casadi\n    46\u2192\n    47\u2192        self.all_ts = solution.all_ts\n    48\u2192        self.all_ys = solution.all_ys\n    49\u2192        self.all_yps = solution.all_yps\n    50\u2192        self.all_inputs = solution.all_inputs\n    51\u2192        self.all_inputs_casadi = solution.all_inputs_casadi\n    52\u2192\n    53\u2192        # Mesh and domain information may be absent for meshless symbols (e.g. pybamm.t**2)\n    54\u2192        self.mesh = getattr(base_variables[0], \"mesh\", None)\n    55\u2192        self.domain = getattr(base_variables[0], \"domain\", [])\n    56\u2192        self.domains = getattr(base_variables[0], \"domains\", {})\n    57\u2192        self.time_integral = time_integral\n    58\u2192\n    59\u2192        # Process spatial variables\n    60\u2192        geometry = solution.all_models[0].geometry\n    61\u2192        self.spatial_variables = {}\n    62\u2192        for domain_level, domain_names in self.domains.items():\n    63\u2192            variables = []\n    64\u2192            for domain in domain_names:\n    65\u2192                variables += list(geometry[domain].keys())\n    66\u2192            self.spatial_variables[domain_level] = variables\n    67\u2192\n    68\u2192        # Sensitivity starts off uninitialized, only set when called\n    69\u2192        self._sensitivities = None\n    70\u2192        self.all_solution_sensitivities = solution._all_sensitivities\n    71\u2192\n    72\u2192        # Store time\n    73\u2192        self.t_pts = solution.t\n    74\u2192\n    75\u2192        # Evaluate base variable at initial time\n    76\u2192        self.base_eval_shape = self.base_variables[0].shape\n    77\u2192        self.base_eval_size = self.base_variables[0].size\n    78\u2192\n    79\u2192        self._xr_array_raw = None\n    80\u2192        self._entries_raw = None\n    81\u2192        self._entries_for_interp_raw = None\n    82\u2192        self._coords_raw = None\n    83\u2192\n    84\u2192    def initialise(self):\n    85\u2192        if self.entries_raw_initialized:\n    86\u2192            return\n    87\u2192\n    88\u2192        entries = self.observe_raw()\n    89\u2192\n    90\u2192        t = self.t_pts\n    91\u2192        entries_for_interp, coords = self._interp_setup(entries, t)\n    92\u2192\n    93\u2192        self._entries_raw = entries\n    94\u2192        self._entries_for_interp_raw = entries_for_interp\n    95\u2192        self._coords_raw = coords\n    96\u2192\n    97\u2192    def observe_and_interp(self, t, fill_value):\n    98\u2192        \"\"\"\n    99\u2192        Interpolate the variable at the given time points and y values.\n   100\u2192        t must be a sorted array of time points.\n   101\u2192        \"\"\"\n   102\u2192\n   103\u2192        entries = self._observe_hermite_cpp(t)\n   104\u2192        processed_entries = self._observe_postfix(entries, t)\n   105\u2192\n   106\u2192        tf = self.t_pts[-1]\n   107\u2192        if t[-1] > tf and fill_value != \"extrapolate\":\n   108\u2192            # fill the rest\n   109\u2192            idx = np.searchsorted(t, tf, side=\"right\")\n   110\u2192            processed_entries[..., idx:] = fill_value\n   111\u2192\n   112\u2192        return processed_entries\n   113\u2192\n   114\u2192    def observe_raw(self):\n   115\u2192        \"\"\"\n   116\u2192        Evaluate the base variable at the given time points and y values.\n   117\u2192        \"\"\"\n   118\u2192        t = self.t_pts\n   119\u2192\n   120\u2192        # For small number of points, use Python\n   121\u2192        if pybamm.has_idaklu():\n   122\u2192            entries = self._observe_raw_cpp()\n   123\u2192        else:\n   124\u2