ck no ys are too large\n   127→        if check_solution:\n   128→            self.check_ys_are_not_too_large()\n   129→\n   130→        # Events\n   131→        self._t_event = t_event\n   132→        self._y_event = y_event\n   133→        self._termination = termination\n   134→        self.closest_event_idx = None\n   135→\n   136→        # Initialize times\n   137→        self.set_up_time = None\n   138→        self.solve_time = None\n   139→        self.integration_time = None\n   140→\n   141→        # initialize empty variables and data\n   142→        self._variables = pybamm.FuzzyDict()\n   143→        self._data = pybamm.FuzzyDict()\n   144→\n   145→        # Add self as sub-solution for compatibility with ProcessedVariable\n   146→        self._sub_solutions = [self]\n   147→\n   148→        # initialize empty cycles\n   149→        self._cycles = []\n   150→\n   151→        # Initialize empty summary variables\n   152→        self._summary_variables = None\n   153→\n   154→        # Initialise initial start time\n   155→        self.initial_start_time = None\n   156→\n   157→        # Solution now uses CasADi\n   158→        pybamm.citations.register(\"Andersson2019\")\n   159→\n   160→    def has_sensitivities(self) -> bool:\n   161→        if isinstance(self._all_sensitivities, bool):\n   162→            return self._all_sensitivities\n   163→        elif isinstance(self._all_sensitivities, dict):\n   164→            return len(self._all_sensitivities) > 0\n   165→\n   166→    def extract_explicit_sensitivities(self):\n   167→        self._all_sensitivities = {}\n   168→\n   169→        # extract sensitivities from each sub-solution\n   170→        for index, (model, ys, ts, inputs) in enumerate(\n   171→            zip(self.all_models, self.all_ys, self.all_ts, self.all_inputs)\n   172→        ):\n   173→            self._all_ys[index], sens_segment = self._extract_explicit_sensitivities(\n   174→                model, ys, ts, inputs\n   175→            )\n   176→            for key, value in sens_segment.items():\n   177→                if key in self._all_sensitivities:\n   178→                    self._all_sensitivities[key] = self._all_sensitivities[key] + [\n   179→                        value\n   180→                    ]\n   181→                else:\n   182→                    self._all_sensitivities[key] = [value]\n   183→\n   184→    def _extract_sensitivity_matrix(self, model, y):\n   185→        n_states = model.len_rhs_and_alg\n   186→        n_rhs = model.len_rhs\n   187→        n_alg = model.len_alg\n   188→        # Get the point where the algebraic equations start\n   189→        if model.len_rhs != 0:\n   190→            n_p = model.len_rhs_sens // model.len_rhs\n   191→        else:\n   192→            n_p = model.len_alg_sens // model.len_alg\n   193→        len_rhs_and_sens = model.len_rhs + model.len_rhs_sens\n   194→\n   195→        # y gets the part of the solution vector that correspond to the\n   196→        # actual ODE/DAE solution\n   197→\n   198→        # save sensitivities as a dictionary\n   199→        # first save the whole sensitivity matrix\n   200→        # reshape using Fortran order to get the right array:\n   201→        #   t0_x0_p0, t0_x0_p1, ..., t0_x0_pn\n   202→        #   t0_x1_p0, t0_x1_p1, ..., t0_x1_pn\n   203→        #   ...\n   204→        #   t0_xn_p0, t0_xn_p1, ..., t0_xn_pn\n   205→        #   t1_x0_p0, t1_x0_p1, ..., t1_x0_pn\n   206→        #   t1_x1_p0, t1_x1_p1, ..., t1_x1_pn\n   207→        #   ...\n   208→        #   t1_xn_p0, t1_xn_p1, ..., t1_xn_pn\n   209→        #   ...\n   210→        #   tn_x0_p0, tn_x0_p1, ..., tn_x0_pn\n   211→        #   tn_x1_p0, tn_x1_p1, ..., tn_x1_pn\n   212→        #   ...\n   213→        #   tn_xn_p0, tn_xn_p1, ..., tn_xn_pn\n   214→        # 1, Extract rhs and alg sensitivities and reshape into 3D matrices\n   215→        # with shape (n_p, n_states, n_t)\n   216→        if isinstance(y, casadi.DM):\n   217→            y_full = y.full()\n   218→        else:\n   219→            y_full = y\n   220→\n   221→        n_t = y.shape[1]\n   222→        ode_sens = y_full[n_rhs:len_rhs_and_sens, :].reshape(n_p, n_rhs, n_t)\n   223→        alg_sens = y_full[len_rhs_and_sens + n_alg :, :].reshape(n_p, n_alg, n_t)\n   224→        # 2. Concatenate into a single 3D matrix with shape (n_p, n_states, n_t)\n   225→        # i.e. along first axis\n   226→        full_sens_matrix = np.concatenate([ode_sens, alg_sens], axis=1)\n   227→        # Transpose and reshape into a (n_states * n_t, n_p) matrix\n   228→        full_sens_matrix = full_sens_matrix.transpose(2, 1, 0).reshape(\n   229→            n_t * n_states, n_p\n   230→        )\n   231→\n   232→        # convert back to casadi (todo: this is not very efficient, should refactor\n   233→        # to avoid this)\n   234→        full_sens_matrix = casadi.DM(full_sens_matrix)\n   235→\n   236→        y_dae = np.vstack(\n   237→            [\n   238→                y[: model.len_rhs, :],\n   239→                y[len_rhs_and_sens : len_rhs_and_sens + model.len_alg, :],\n   240→            ]\n   241→        )\n   242→        return y_dae, full_sens_matrix\n   243→\n   244→    def _extract_explicit_sensitivities(self, model, y, t_eval, inputs):\n   245→        \"\"\"\n   246→        given a model and a solution y, extracts the sensitivities\n   247→\n   248→        Parameters\n   249→        --------\n   250→        model : :class:`pybamm.BaseModel`\n   251→            A model that has been already setup by this base solver\n   252→        y: ndarray\n   253→            The solution of the full explicit sensitivity equations\n   254→        t_eval: ndarray\n   255→            The evaluation times\n   256→        inputs: dict\n   257→            parameter inputs\n   258→\n   259→        Returns\n   260→        -------\n   261→        y: ndarray\n   262→            The solution of the ode/dae in model\n   263→        sensitivities: dict of (string: ndarray)\n   264→            A dictionary of parameter names, and the corresponding solution of\n   265→            the sensitivity equations\n   266→        \"\"\"\n   267→\n   268→        y_dae, full_sens_matrix = self._extract_sensitivity_matrix(model, y)\n   269→\n   270→        # Save the full sensitivity matrix\n   271→        sensitivity = {\"all\": full_sens_matrix}\n   272→\n   273→        # also save the sensitivity wrt each parameter (read the columns of the\n   274→        # sensitivity matrix)\n   275→        start = 0\n   276→        for name in model.calculate_sensitivities:\n   277→            inp = inputs[name]\n   278→            input_size = inp.shape[0]\n   279→            end = start + input_size\n   280→            sensitivity[name] = full_sens_matrix[:, start:end]\n   281→            start = end\n   282→\n   283→        return y_dae, sensitivity\n   284→\n   285→    @property\n   286→    def t(self):\n   287→        \"\"\"Times at which the solution is evaluated\"\"\"\n   288→        try:\n   289→            return self._t\n   290→        except AttributeError:\n   291→            self.set_t()\n   292→            return self._t\n   293→\n   294→    def set_t(self):\n   295→        self._t = np.concatenate(self.all_ts)\n   296→        if any(np.diff(self._t) <= 0):\n   297→            raise ValueError(\"Solution time vector must be strictly increasing\")\n   298→\n   299→    @property\n   300→    def y(self):\n   301→        \"\"\"Values of the solution\"\"\"\n   302→        try:\n   303→            return self._y\n   304→        except AttributeError:\n   305→            # if y is evaluated before sensitivities then need to extract them\n   306→            if isinstance(self._all_sensitivities, bool) and self._all_sensitivities:\n   307→                self.extract_explicit_sensitivities()\n   308→\n   309→            self.set_y()\n   310→\n   311→            return self._y\n   312→\n   313→    @property\n   314→    def data(self):\n   315→        for k, v in self._variables.items():\n   316→            if k not in self._data:\n   317→                self._data[k] = v.data\n   318→        return self._data\n   319→\n   320→    @property\n   321→    def sensitivities(self):\n   322→        \"\"\"Values of the sensitivities. Returns a dict of param_name: np_array\"\"\"\n   323→        try:\n   324→            return self._sensitivities\n   325→        except AttributeError:\n   326→            self.set_sensitivities()\n   327→        return self._sensitivities\n   328→\n   329→    @sensitivities.setter\n   330→    def sensitivities(self, value):\n   331→        \"\"\"Updates the sensitivity if False or True. Raises an error if sensitivities are a dict\"\"\"\n   332→        # sensitivities must be a dict or bool\n   333→        if not isinstance(value, bool):\n   334→            raise TypeError(\"sensitivities arg needs to be a bool\")\n   335→\n   336→        if isinstance(self._all_sensitivities, dict):\n   337→            raise NotImplementedError(\n   338→                \"Setting sensitivities is not supported if sensitivities are \"\n   339→                \"already provided as a dict of {parameter: sensitivities} pairs.\"\n   340→            )\n   341→\n   342→        self._all_sensitivities = value\n   343→\n   344→    def set_sensitivities(self):\n   345→        if not self.has_sensitivities():\n   346→            self._sensitivities = {}\n   347→            return\n   348→\n   349→        # extract sensitivities if they are not already extracted\n   350→        if isinstance(self._all_sensitivities, bool) and self._all_sensitivities:\n   351→            self.extract_explicit_sensitivities()\n   352→\n   353→        is_casadi = isinstance(\n   354→            next(iter(self._all_sensitivities.values()))[0], (casadi.DM, casadi.MX)\n   355→        )\n   356→        self._sensitivities = {}\n   357→        for key, sens in self._all_sensitivities.items():\n   358→            if is_casadi:\n   359→                self._sensitivities[key] = casadi.vertcat(*sens)\n   360→            else:\n   361→                self._sensitivities[key] = np.vstack(sens)\n   362→\n   363→    def set_y(self):\n   364→        try:\n   365→            if isinstance(self.all_ys[0], (casadi.DM, casadi.MX)):\n   366→                self._y = casadi.horzcat(*self.all_ys)\n   367→            else:\n   368→                self._y = np.hstack(self.all_ys)\n   369→        except ValueError as error:\n   370→            raise pybamm.SolverError(\n   371→                \"The solution is made up from different models, so `y` cannot be \"\n   372→                \"computed explicitly.\"\n   373→            ) from error\n   374→\n   375→    def check_ys_are_not_too_large(self):\n   376→        # Only check last one so that it doesn't take too long\n   377→        # We only care about the cases where y is growing too large without any\n   378→        # restraint, so if y gets large in the middle then comes back down that is ok\n   379→        y, model = self.all_ys[-1], self.all_models[-1]\n   380→        y = y[:, -1]\n   381→        if np.any(y > pybamm.settings.max_y_value):\n   382→            for var in [*model.rhs.keys(), *model.algebraic.keys()]:\n   383→                var = model.variables[var.name]\n   384→                # find the statevector corresponding to this variable\n   385→                statevector = None\n   386→                for node in var.pre_order():\n   387→                    if isinstance(node, pybamm.StateVector):\n   388→                        statevector = node\n   389→\n   390→                # there will always be a statevector, but just in case\n   391→                if statevector is None:  # pragma: no cover\n   392→                    raise RuntimeError(\n   393→                        f\"Cannot find statevector corresponding to variable {var.name}\"\n   394→                    )\n   395→                y_var = y[statevector.y_slices[0]]\n   396→                if np.any(y_var > pybamm.settings.max_y_value):\n   397→                    pybamm.logger.error(\n   398→                        f\"Solution for '{var}' exceeds the maximum allowed value \"\n   399→                        f\"of `{pybamm.settings.max_y_value}. This could be due to \"\n   400→                        \"incorrect scaling, model formulation, or \"\n   401→                        \"parameter values. The maximum allowed value is set by \"\n   402→                        \"'pybammm.settings.max_y_value'.\"\n   403→                    )\n   404→\n   405→    @property\n   406→    def all_ts(self):\n   407→        return self._all_ts\n   408→\n   409→    @property\n   410→    def all_ys(self):\n   411→        return self._all_ys\n   412→\n   413→    @property\n   414→    def all_models(self):\n   415→        \"\"\"Model(s) used for solution\"\"\"\n   416→        return self._all_models\n   417→\n   418→    @cached_property\n   419→    def all_inputs_casadi(self):\n   420→        return [casadi.vertcat(*inp.values()) for inp in self.all_inputs]\n   421→\n   422→    @property\n   423→    def all_yps(self):\n   424→        return self._all_yps\n   425→\n   426→    @property\n   427→    def hermite_interpolation(self):\n   428→        return self.all_yps is not None\n   429→\n   430→    @property\n   431→    def t_event(self):\n   432→        \"\"\"Time at which the event happens\"\"\"\n   433→        return self._t_event\n   434→\n   435→    @property\n   436→    def y_event(self):\n   437→        \"\"\"Value of the solution at the time of the event\"\"\"\n   438→        return self._y_event\n   439→\n   440→    @property\n   441→    def termination(self):\n   442→        \"\"\"Reason for termination\"\"\"\n   443→        return self._termination\n   444→\n   445→    @termination.setter\n   446→    def termination(self, value):\n   447→        \"\"\"Updates the reason for termination\"\"\"\n   448→        self._termination = value\n   449→\n   450→    @cached_property\n   451→    def first_state(self):\n   452→        \"\"\"\n   453→        A Solution object that only contains the first state. This is faster to evaluate\n   454→        than the full solution when only the first state is needed (e.g. to initialize\n   455→        a model with the solution)\n   456→        \"\"\"\n   457→        if isinstance(self._all_sensitivities, bool):\n   458→            sensitivities = self._all_sensitivities\n   459→        elif isinstance(self._all_sensitivities, dict):\n   460→            sensitivities = {}\n   461→            n_states = self.all_models[0].len_rhs_and_alg\n   462→            for key in self._all_sensitivities:\n   463→                sensitivities[key] = self._all_sensitivities[key][0][-n_states:, :]\n   464→\n   465→        if self.all_yps is None:\n   466→            all_yps = None\n   467→        else:\n   468→            all_yps = self.all_yps[0][:, :1]\n   469→\n   470→        if not self.variables_returned:\n   471→            all_ys = self.all_ys[0][:, :1]\n   472→        else:\n   473→            # Get first state from initial conditions as all_ys is empty\n   474→            all_ys = self.all_models[0].y0full.reshape(-1, 1)\n   475→\n   476→        new_sol = Solution(\n   477→            self.all_ts[0][:1],\n   478→            all_ys,\n   479→            self.all_models[:1],\n   480→            self.all_inputs[:1],\n   481→            None,\n   482→            None,\n   483→            \"final time\",\n   484→            all_sensitivities=sensitivities,\n   485→            all_yps=all_yps,\n   486→        )\n   487→        new_sol._all_inputs_casadi = self.all_inputs_casadi[:1]\n   488→        new_sol._sub_solutions = self.sub_solutions[:1]\n   489→\n   490→        new_sol.solve_time = 0\n   491→        new_sol.integration_time = 0\n   492→        new_sol.set_up_time = 0\n   493→\n   494→        return new_sol\n   495→\n   496→    @cached_property\n   497→    def last_state(self):\n   498→        \"\"\"\n   499→        A Solution object that only contains the final state. This is faster to evaluate\n   500→        than the full solution when only the final state is needed (e.g. to initialize\n   501→        a model with the solution)\n   502→        \"\"\"\n   503→        if isinstance(self._all_sensitivities, bool):\n   504→            sensitivities = self._all_sensitivities\n   505→        elif isinstance(self._all_sensitivities, dict):\n   506→            sensitivities = {}\n   507→            n_states = self.all_models[-1].len_rhs_and_alg\n   508→            for key in self._all_sensitivities:\n   509→                sensitivities[key] = self._all_sensitivities[key][-1][-n_states:, :]\n   510→\n   511→        if self.all_yps is None:\n   512→            all_yps = None\n   513→        else:\n   514→            all_yps = self.all_yps[-1][:, -1:]\n   515→\n   516→        if not self.variables_returned:\n   517→            all_ys = self.all_ys[-1][:, -1:]\n   518→        else:\n   519→            # Get last state from y_event as all_ys is empty\n   520→            all_ys = self.y_event.reshape(len(self.y_event), 1)\n   521→\n   522→        new_sol = Solution(\n   523→            self.all_ts[-1][-1:],\n   524→            all_ys,\n   525→            self.all_models[-1:],\n   526→            self.all_inputs[-1:],\n   527→            self.t_event,\n   528→            self.y_event,\n   529→            self.termination,\n   530→            all_sensitivities=sensitivities,\n   531→            all_yps=all_yps,\n   532→        )\n   533→        new_sol._all_inputs_casadi = self.all_inputs_casadi[-1:]\n   534→        new_sol._sub_solutions = self.sub_solutions[-1:]\n   535→        new_sol.solve_time = 0\n   536→        new_sol.integration_time = 0\n   537→        new_sol.set_up_time = 0\n   538→\n   539→        return new_sol\n   540→\n   541→    @property\n   542→    def total_time(self):\n   543→        return self.set_up_time + self.solve_time\n   544→\n   545→    @property\n   546→    def cycles(self):\n   547→        return self._cycles\n   548→\n   549→    @cycles.setter\n   550→    def cycles(self, cycles):\n   551→        self._cycles = cycles\n   552→\n   553→    @property\n   554→    def summary_variables(self):\n   555→        return self._summary_variables\n   556→\n   557→    @property\n   558→    def initial_start_time(self):\n   559→        return self._initial_start_time\n   560→\n   561→    @initial_start_time.setter\n   562→    def initial_start_time(self, value):\n   563→        \"\"\"Updates the initial start time of the experiment\"\"\"\n   564→        self._initial_start_time = value\n   565→\n   566→    def set_summary_variables(self, all_summary_variables):\n   567→        summary_variables = {var: [] for var in all_summary_variables[0]}\n   568→        for sum_vars in all_summary_variables:\n   569→            for name, value in sum_vars.items():\n   570→                summary_variables[name].append(value)\n   571→\n   572→        summary_variables[\"Cycle number\"] = range(1, len(all_summary_variables) + 1)\n   573→        self.all_summary_variables = all_summary_variables\n   574→        self._summary_variables = pybamm.FuzzyDict(\n   575→            {name: np.array(value) for name, value in summary_variables.items()}\n   576→        )\n   577→\n   578→    def update(self, variables):\n   579→        \"\"\"Add ProcessedVariables to the dictionary of variables in the solution\"\"\"\n   580→        # make sure that sensitivities are extracted if required\n   581→        if isinstance(self._all_sensitivities, bool) and self._all_sensitivities:\n   582→            self.extract_explicit_sensitivities()\n   583→\n   584→        # Single variable\n   585→        if isinstance(variables, str):\n   586→            variables = [variables]\n   587→\n   588→        # Process\n   589→        for variable in variables:\n   590→            self._update_variable(variable)\n   591→\n   592→    def _update_variable(self, variable):\n   593→        time_integral = None\n   594→        pybamm.logger.debug(f\"Post-processing {variable}\")\n   595→        vars_pybamm = [\n   596→            model.variables_and_events[variable] for model in self.all_models\n   597→        ]\n   598→\n   599→        # Iterate through all models, some may be in the list several times and\n   600→        # therefore only get set up once\n   601→        vars_casadi = []\n   602→        for i, (model, ys, inputs, var_pybamm) in enumerate(\n   603→            zip(self.all_models, self.all_ys, self.all_inputs, vars_pybamm)\n   604→        ):\n   605→            if self.variables_returned and var_pybamm.has_symbol_of_classes(\n   606→                pybamm.expression_tree.state_vector.StateVector\n   607→            ):\n   608→                raise KeyError(\n   609→                    f\"Cannot process variable '{variable}' as it was not part of the \"\n   610→                    \"solve. Please re-run the solve with `output_variables` set to \"\n   611→                    \"include this variable.\"\n   612→                )\n   613→            elif isinstance(\n   614→                var_pybamm, (pybamm.ExplicitTimeIntegral, pybamm.DiscreteTimeSum)\n   615→            ):\n   616→                time_integral = pybamm.ProcessedVariableTimeIntegral.from_pybamm_var(\n   617→                    var_pybamm\n   618→                )\n   619→                var_pybamm = var_pybamm.child\n   620→                if variable in model._variables_casadi:\n   621→                    var_casadi = model._variables_casadi[variable]\n   622→                else:\n   623→                    var_casadi = self.process_casadi_var(\n   624→                        var_pybamm,\n   625→                        inputs,\n   626→                        ys.shape,\n   627→                    )\n   628→                    model._variables_casadi[variable] = var_casadi\n   629→                vars_pybamm[i] = var_pybamm\n   630→            elif variable in model._variables_casadi:\n   631→                var_casadi = model._variables_casadi[variable]\n   632→            else:\n   633→                var_casadi = self.process_casadi_var(\n   634→                    var_pybamm,\n   635→                    inputs,\n   636→                    ys.shape,\n   637→                )\n   638→                model._variables_casadi[variable] = var_casadi\n   639→            vars_casadi.append(var_casadi)\n   640→        var = pybamm.process_variable(\n   641→            vars_pybamm, vars_casadi, self, time_integral=time_integral\n   642→        )\n   643→\n   644→        self._variables[variable] = var\n   645→\n   646→    def process_casadi_var(self, var_pybamm, inputs, ys_shape):\n   647→        t_MX = casadi.MX.sym(\"t\")\n   648→        y_MX = casadi.MX.sym(\"y\", ys_shape[0])\n   649→        inputs_MX_dict = {\n   650→            key: casadi.MX.sym(\"input\", value.shape[0]) for key, value in inputs.items()\n   651→        }\n   652→        inputs_MX = casadi.vertcat(*[p for p in inputs_MX_dict.values()])\n   653→        var_sym = var_pybamm.to_casadi(t_MX, y_MX, inputs=inputs_MX_dict)\n   654→\n   655→        opts = {\n   656→            \"cse\": True,\n   657→            \"inputs_check\": False,\n   658→            \"is_diff_in\": [False, False, False],\n   659→            \"is_diff_out\": [False],\n   660→            \"regularity_check\": False,\n   661→            \"error_on_fail\": False,\n   662→            \"enable_jacobian\": False,\n   663→        }\n   664→\n   665→        # Casadi has a bug where it does not correctly handle arrays with\n   666→        # zeros padded at the beginning or end. To avoid this, we add and\n   667→        # subtract the same number to the variable to reinforce the\n   668→        # variable bounds. This does not affect the answer\n   669→        epsilon = 1.0\n   670→        var_sym = (var_sym - epsilon) + epsilon\n   671→\n   672→        var_casadi = casadi.Function(\n   673→            \"variable\",\n   674→            [t_MX, y_MX, inputs_MX],\n   675→            [var_sym],\n   676→            opts,\n   677→        )\n   678→\n   679→        # Some variables, like interpolants, cannot be expanded\n   680→        try:\n   681→            var_casadi_out = var_casadi.expand()\n   682→        except RuntimeError as error:\n   683→            if \"'eval_sx' not defined for\" not in str(error):\n   684→                raise error  # pragma: no cover\n   685→            var_casadi_out = var_casadi\n   686→\n   687→        return var_casadi_out\n   688→\n   689→    def __getitem__(self, key):\n   690→        \"\"\"Read a variable from the solution. Variables are created 'just in time', i.e.\n   691→        only when they are called.\n   692→\n   693→        Parameters\n   694→        ----------\n   695→        key : str\n   696→            The name of the variable\n   697→\n   698→        Returns\n   699→        -------\n   700→        :class:`pybamm.ProcessedVariable` or :class:`pybamm.ProcessedVariableComputed`\n   701→            A variable that can be evaluated at any time or spatial point. The\n   702→            underlying data for this variable is available in its attribute \".data\"\n   703→        \"\"\"\n   704→\n   705→        # return it if it exists\n   706→        if key in self._variables:\n   707→            return self._variables[key]\n   708→        else:\n   709→            # otherwise create it, save it and then return it\n   710→            self.update(key)\n   711→            return self._variables[key]\n   712→\n   713→    def plot(self, output_variables=None, **kwargs):\n   714→        \"\"\"\n   715→        A method to quickly plot the outputs of the solution. Creates a\n   716→        :class:`pybamm.QuickPlot` object (with keyword arguments 'kwargs') and\n   717→        then calls :meth:`pybamm.QuickPlot.dynamic_plot`.\n   718→\n   719→        Parameters\n   720→        ----------\n   721→        output_variables: list, optional\n   722→            A list of the variables to plot.\n   723→        **kwargs\n   724→            Additional keyword arguments passed to\n   725→            :meth:`pybamm.QuickPlot.dynamic_plot`.\n   726→            For a list of all possible keyword arguments see :class:`pybamm.QuickPlot`.\n   727→        \"\"\"\n   728→        return pybamm.dynamic_plot(self, output_variables=output_variables, **kwargs)\n   729→\n   730→    def save(self, filename):\n   731→        \"\"\"Save the whole solution using pickle\"\"\"\n   732→        # No warning here if len(self.data)==0 as solution can be loaded\n   733→        # and used to process new variables\n   734→\n   735→        with open(filename, \"wb\") as f:\n   736→            pickle.dump(self, f, pickle.HIGHEST_PROTOCOL)\n   737→\n   738→    def get_data_dict(self, variables=None, short_names=None, cycles_and_steps=True):\n   739→        \"\"\"\n   740→        Construct a (standard python) dictionary of the solution data containing the\n   741→        variables in `variables`. If `variables` is None then all variables are\n   742→        returned. Any variable names in short_names are replaced with the corresponding\n   743→        short name.\n   744→\n   745→        If the solution has cycles, then the cycle numbers and step numbers are also\n   746→        returned in the dictionary.\n   747→\n   748→        Parameters\n   749→        ----------\n   750→        variables : list, optional\n   751→            List of variables to return. If None, returns all variables in solution.data\n   752→        short_names : dict, optional\n   753→            Dictionary of shortened names to use when saving.\n   754→        cycles_and_steps : bool, optional\n   755→            Whether to include the cycle numbers and step numbers in the dictionary\n   756→\n   757→        Returns\n   758→        -------\n   759→        dict\n   760→            A dictionary of the solution data\n   761→        \"\"\"\n   762→        if variables is None:\n   763→            # variables not explicitly provided -> save all variables that have been\n   764→            # computed\n   765→            data_long_names = self.data\n   766→        else:\n   767→            if isinstance(variables, str):\n   768→                variables = [variables]\n   769→            # otherwise, save only the variables specified\n   770→            data_long_names = {}\n   771→            for name in variables:\n   772→                data_long_names[name] = self[name].data\n   773→        if len(data_long_names) == 0:\n   774→            raise ValueError(\n   775→                \"\"\"\n   776→                Solution does not have any data. Please provide a list of variables\n   777→                to save.\n   778→                \"\"\"\n   779→            )\n   780→\n   781→        # Use any short names if provided\n   782→        data_short_names = {}\n   783→        short_names = short_names or {}\n   784→        for name, var in data_long_names.items():\n   785→            name = short_names.get(name, name)  # return name if no short name\n   786→            data_short_names[name] = var\n   787→\n   788→        # Save cycle number and step number if the solution has them\n   789→        if cycles_and_steps and len(self.cycles) > 0:\n   790→            data_short_names[\"Cycle\"] = np.array([])\n   791→            data_short_names[\"Step\"] = np.array([])\n   792→            for i, cycle in enumerate(self.cycles):\n   793→                data_short_names[\"Cycle\"] = np.concatenate(\n   794→                    [data_short_names[\"Cycle\"], i * np.ones_like(cycle.t)]\n   795→                )\n   796→                for j, step in enumerate(cycle.steps):\n   797→                    data_short_names[\"Step\"] = np.concatenate(\n   798→                        [data_short_names[\"Step\"], j * np.ones_like(step.t)]\n   799→                    )\n   800→\n   801→        return data_short_names\n   802→\n   803→    def save_data(\n   804→        self, filename=None, variables=None, to_format=\"pickle\", short_names=None\n   805→    ):\n   806→        \"\"\"\n   807→        Save solution data only (raw arrays)\n   808→\n   809→        Parameters\n   810→        ----------\n   811→        filename : str, optional\n   812→            The name of the file to save data to. If None, then a str is returned\n   813→        variables : list, optional\n   814→            List of variables to save. If None, saves all of the variables that have\n   815→            been created so far\n   816→        to_format : str, optional\n   817→            The format to save to. Options are:\n   818→\n   819→            - 'pickle' (default): creates a pickle file with the data dictionary\n   820→            - 'matlab': creates a .mat file, for loading in matlab\n   821→            - 'csv': creates a csv file (0D variables only)\n   822→            - 'json': creates a json file\n   823→        short_names : dict, optional\n   824→            Dictionary of shortened names to use when saving. This may be necessary when\n   825→            saving to MATLAB, since no spaces or special characters are allowed in\n   826→            MATLAB variable names. Note that not all the variables need to be given\n   827→            a short name.\n   828→\n   829→        Returns\n   830→        -------\n   831→        data : str, optional\n   832→            str if 'csv' or 'json' is chosen and filename is None, otherwise None\n   833→        \"\"\"\n   834→        data = self.get_data_dict(variables=variables, short_names=short_names)\n   835→\n   836→        if to_format == \"pickle\":\n   837→            if filename is None:\n   838→                raise ValueError(\"pickle format must be written to a file\")\n   839→            with open(filename, \"wb\") as f:\n   840→                pickle.dump(data, f, pickle.HIGHEST_PROTOCOL)\n   841→        elif to_format == \"matlab\":\n   842→            if filename is None:\n   843→                raise ValueError(\"matlab format must be written to a file\")\n   844→            # Check all the variable names only contain a-z, A-Z or _ or numbers\n   845→            for name in data.keys():\n   846→                # Check the string only contains the following ASCII:\n   847→                # a-z (97-122)\n   848→                # A-Z (65-90)\n   849→                # _ (95)\n   850→                # 0-9 (48-57) but not in the first position\n   851→                for i, s in enumerate(name):\n   852→                    if not (\n   853→                        97 <= ord(s) <= 122\n   854→                        or 65 <= ord(s) <= 90\n   855→                        or ord(s) == 95\n   856→                        or (i > 0 and 48 <= ord(s) <= 57)\n   857→                    ):\n   858→                        raise ValueError(\n   859→                            f\"Invalid character '{s}' found in '{name}'. \"\n   860→                            + \"MATLAB variable names must only contain a-z, A-Z, _, \"\n   861→                            \"or 0-9 (except the first position). \"\n   862→                            \"Use the 'short_names' argument to pass an alternative \"\n   863→                            \"variable name, e.g. \\n\\n\"\n   864→                            \"\\tsolution.save_data(filename, \"\n   865→                            \"['Electrolyte concentration'], to_format='matlab, \"\n   866→                            \"short_names={'Electrolyte concentration': 'c_e'})\"\n   867→                        )\n   868→            savemat(filename, data)\n   869→        elif to_format == \"csv\":\n   870→            for name, var in data.items():\n   871→                if var.ndim >= 2:\n   872→                    raise ValueError(\n   873→                        f\"only 0D variables can be saved to csv, but '{name}' is {var.ndim - 1}D\"\n   874→                    )\n   875→            df = pd.DataFrame(data)\n   876→            return df.to_csv(filename, index=False)\n   877→        elif to_format == \"json\":\n   878→            if filename is None:\n   879→                return json.dumps(data, cls=NumpyEncoder)\n   880→            else:\n   881→                with open(filename, \"w\") as outfile:\n   882→                    json.dump(data, outfile, cls=NumpyEncoder)\n   883→        else:\n   884→            raise ValueError(f\"format '{to_format}' not recognised\")\n   885→\n   886→    @property\n   887→    def sub_solutions(self):\n   888→        \"\"\"List of sub solutions that have been\n   889→        concatenated to form the full solution\"\"\"\n   890→\n   891→        return self._sub_solutions\n   892→\n   893→    def __add__(self, other):\n   894→        \"\"\"Adds two solutions together, e.g. when stepping\"\"\"\n   895→        if other is None or isinstance(other, EmptySolution):\n   896→            return self.copy()\n   897→        if not isinstance(other, Solution):\n   898→            raise pybamm.SolverError(\n   899→                \"Only a Solution or None can be added to a Solution\"\n   900→            )\n   901→        # Special case: new solution only has one timestep and it is already in the\n   902→        # existing solution. In this case, return a copy of the existing solution\n   903→        if (\n   904→            len(other.all_ts) == 1\n   905→            and len(other.all_ts[0]) == 1\n   906→            and other.all_ts[0][0] == self.all_ts[-1][-1]\n   907→        ):\n   908→            new_sol = self.copy()\n   909→            # Update termination using the latter solution\n   910→            new_sol._termination = other.termination\n   911→            new_sol._t_event = other._t_event\n   912→            new_sol._y_event = other._y_event\n   913→            return new_sol\n   914→\n   915→        # Update list of sub-solutions\n   916→        hermite_interpolation = (\n   917→            other.hermite_interpolation and self.hermite_interpolation\n   918→        )\n   919→        if other.all_ts[0][0] == self.all_ts[-1][-1]:\n   920→            # Skip first time step if it is repeated\n   921→            all_ts = self.all_ts + [other.all_ts[0][1:]] + other.all_ts[1:]\n   922→            all_ys = self.all_ys + [other.all_ys[0][:, 1:]] + other.all_ys[1:]\n   923→            if hermite_interpolation:\n   924→                all_yps = self.all_yps + [other.all_yps[0][:, 1:]] + other.all_yps[1:]\n   925→        else:\n   926→            all_ts = self.all_ts + other.all_ts\n   927→            all_ys = self.all_ys + other.all_ys\n   928→            if hermite_interpolation:\n   929→                all_yps = self.all_yps + other.all_yps\n   930→\n   931→        if not hermite_interpolation:\n   932→            all_yps = None\n   933→\n   934→        # sensitivities can be:\n   935→        # - bool if not using sensitivities or using explicit sensitivities which still\n   936→        #   need to be extracted\n   937→        # - dict if sensitivities are provided as a dict of {parameter: sensitivities}\n   938→        # both self and other should have the same type of sensitivities\n   939→        # OR both can be either False or {} (i.e. no sensitivities)\n   940→        if isinstance(self._all_sensitivities, bool) and isinstance(\n   941→            other._all_sensitivities, bool\n   942→        ):\n   943→            all_sensitivities = self._all_sensitivities or other._all_sensitivities\n   944→        elif isinstance(self._all_sensitivities, dict) and isinstance(\n   945→            other._all_sensitivities, dict\n   946→        ):\n   947→            all_sensitivities = self._all_sensitivities\n   948→            # we can assume that the keys are the same for both solutions\n   949→            for key in other._all_sensitivities:\n   950→                all_sensitivities[key] = (\n   951→                    all_sensitivities[key] + other._all_sensitivities[key]\n   952→                )\n   953→        elif no