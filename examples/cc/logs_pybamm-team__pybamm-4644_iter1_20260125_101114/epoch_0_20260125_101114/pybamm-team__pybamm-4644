ybamm.Symbol`\n   578\u2192        A list of base variables with a method `evaluate(t,y)`, each entry of which\n   579\u2192        returns the value of that variable for that particular sub-solution.\n   580\u2192        A Solution can be comprised of sub-solutions which are the solutions of\n   581\u2192        different models.\n   582\u2192        Note that this can be any kind of node in the expression tree, not\n   583\u2192        just a :class:`pybamm.Variable`.\n   584\u2192        When evaluated, returns an array of size (m,n)\n   585\u2192    base_variables_casadi : list of :class:`casadi.Function`\n   586\u2192        A list of casadi functions. When evaluated, returns the same thing as\n   587\u2192        `base_Variable.evaluate` (but more efficiently).\n   588\u2192    solution : :class:`pybamm.Solution`\n   589\u2192        The solution object to be used to create the processed variables\n   590\u2192    \"\"\"\n   591\u2192\n   592\u2192    def __init__(\n   593\u2192        self,\n   594\u2192        base_variables,\n   595\u2192        base_variables_casadi,\n   596\u2192        solution,\n   597\u2192        time_integral: Optional[pybamm.ProcessedVariableTimeIntegral] = None,\n   598\u2192    ):\n   599\u2192        self.dimensions = 1\n   600\u2192        super().__init__(\n   601\u2192            base_variables,\n   602\u2192            base_variables_casadi,\n   603\u2192            solution,\n   604\u2192            time_integral=time_integral,\n   605\u2192        )\n   606\u2192\n   607\u2192    def _observe_raw_python(self):\n   608\u2192        pybamm.logger.debug(\"Observing the variable raw data in Python\")\n   609\u2192        entries = np.empty(self._shape(self.t_pts))\n   610\u2192\n   611\u2192        # Evaluate the base_variable index-by-index\n   612\u2192        idx = 0\n   613\u2192        for ts, ys, inputs, base_var_casadi in zip(\n   614\u2192            self.all_ts, self.all_ys, self.all_inputs_casadi, self.base_variables_casadi\n   615\u2192        ):\n   616\u2192            for inner_idx, t in enumerate(ts):\n   617\u2192                t = ts[inner_idx]\n   618\u2192                y = ys[:, inner_idx]\n   619\u2192                entries[:, idx] = base_var_casadi(t, y, inputs).full()[:, 0]\n   620\u2192                idx += 1\n   621\u2192        return entries\n   622\u2192\n   623\u2192    def _interp_setup(self, entries, t):\n   624\u2192        # Get node and edge values\n   625\u2192        nodes = self.mesh.nodes\n   626\u2192        edges = self.mesh.edges\n   627\u2192        if entries.shape[0] == len(nodes):\n   628\u2192            space = nodes\n   629\u2192        elif entries.shape[0] == len(edges):\n   630\u2192            space = edges\n   631\u2192\n   632\u2192        # add points outside domain for extrapolation to boundaries\n   633\u2192        extrap_space_left = np.array([2 * space[0] - space[1]])\n   634\u2192        extrap_space_right = np.array([2 * space[-1] - space[-2]])\n   635\u2192        space = np.concatenate([extrap_space_left, space, extrap_space_right])\n   636\u2192        extrap_entries_left = 2 * entries[0] - entries[1]\n   637\u2192        extrap_entries_right = 2 * entries[-1] - entries[-2]\n   638\u2192        entries_for_interp = np.vstack(\n   639\u2192            [extrap_entries_left, entries, extrap_entries_right]\n   640\u2192        )\n   641\u2192\n   642\u2192        # assign attributes for reference (either x_sol or r_sol)\n   643\u2192        self.spatial_variable_names = {\n   644\u2192            k: self._process_spatial_variable_names(v)\n   645\u2192            for k, v in self.spatial_variables.items()\n   646\u2192        }\n   647\u2192        self.first_dimension = self.spatial_variable_names[\"primary\"]\n   648\u2192\n   649\u2192        # assign attributes for reference\n   650\u2192        pts_for_interp = space\n   651\u2192        self.internal_boundaries = self.mesh.internal_boundaries\n   652\u2192\n   653\u2192        # Set first_dim_pts to edges for nicer plotting\n   654\u2192        self.first_dim_pts = edges\n   655\u2192\n   656\u2192        # save attributes for interpolation\n   657\u2192        coords_for_interp = {self.first_dimension: pts_for_interp, \"t\": t}\n   658\u2192\n   659\u2192        return entries_for_interp, coords_for_interp\n   660\u2192\n   661\u2192    def _shape(self, t):\n   662\u2192        t_size = len(t)\n   663\u2192        space_size = self.base_eval_shape[0]\n   664\u2192        return [space_size, t_size]\n   665\u2192\n   666\u2192\n   667\u2192class ProcessedVariable2D(ProcessedVariable):\n   668\u2192    \"\"\"\n   669\u2192    An object that can be evaluated at arbitrary (scalars or vectors) t and x, and\n   670\u2192    returns the (interpolated) value of the base variable at that t and x.\n   671\u2192\n   672\u2192    Parameters\n   673\u2192    ----------\n   674\u2192    base_variables : list of :class:`pybamm.Symbol`\n   675\u2192        A list of base variables with a method `evaluate(t,y)`, each entry of which\n   676\u2192        returns the value of that variable for that particular sub-solution.\n   677\u2192        A Solution can be comprised of sub-solutions which are the solutions of\n   678\u2192        different models.\n   679\u2192        Note that this can be any kind of node in the expression tree, not\n   680\u2192        just a :class:`pybamm.Variable`.\n   681\u2192        When evaluated, returns an array of size (m,n)\n   682\u2192    base_variables_casadi : list of :class:`casadi.Function`\n   683\u2192        A list of casadi functions. When evaluated, returns the same thing as\n   684\u2192        `base_Variable.evaluate` (but more efficiently).\n   685\u2192    solution : :class:`pybamm.Solution`\n   686\u2192        The solution object to be used to create the processed variables\n   687\u2192    \"\"\"\n   688\u2192\n   689\u2192    def __init__(\n   690\u2192        self,\n   691\u2192        base_variables,\n   692\u2192        base_variables_casadi,\n   693\u2192        solution,\n   694\u2192        time_integral: Optional[pybamm.ProcessedVariableTimeIntegral] = None,\n   695\u2192    ):\n   696\u2192        self.dimensions = 2\n   697\u2192        super().__init__(\n   698\u2192            base_variables,\n   699\u2192            base_variables_casadi,\n   700\u2192            solution,\n   701\u2192            time_integral=time_integral,\n   702\u2192        )\n   703\u2192        first_dim_nodes = self.mesh.nodes\n   704\u2192        first_dim_edges = self.mesh.edges\n   705\u2192        second_dim_nodes = self.base_variables[0].secondary_mesh.nodes\n   706\u2192        if self.base_eval_size // len(second_dim_nodes) == len(first_dim_nodes):\n   707\u2192            first_dim_pts = first_dim_nodes\n   708\u2192        elif self.base_eval_size // len(second_dim_nodes) == len(first_dim_edges):\n   709\u2192            first_dim_pts = first_dim_edges\n   710\u2192\n   711\u2192        second_dim_pts = second_dim_nodes\n   712\u2192        self.first_dim_size = len(first_dim_pts)\n   713\u2192        self.second_dim_size = len(second_dim_pts)\n   714\u2192\n   715\u2192    def _observe_raw_python(self):\n   716\u2192        \"\"\"\n   717\u2192        Initialise a 2D object that depends on x and r, x and z, x and R, or R and r.\n   718\u2192        \"\"\"\n   719\u2192        pybamm.logger.debug(\"Observing the variable raw data in Python\")\n   720\u2192        first_dim_size, second_dim_size, t_size = self._shape(self.t_pts)\n   721\u2192        entries = np.empty((first_dim_size, second_dim_size, t_size))\n   722\u2192\n   723\u2192        # Evaluate the base_variable index-by-index\n   724\u2192        idx = 0\n   725\u2192        for ts, ys, inputs, base_var_casadi in zip(\n   726\u2192            self.all_ts, self.all_ys, self.all_inputs_casadi, self.base_variables_casadi\n   727\u2192        ):\n   728\u2192            for inner_idx, t in enumerate(ts)