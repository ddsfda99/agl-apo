dx]\n   606→                entries[:, idx] = base_var_casadi(t, y, inputs).full()[:, 0]\n   607→                idx += 1\n   608→        return entries\n   609→\n   610→    def _interp_setup(self, entries, t):\n   611→        # Get node and edge values\n   612→        nodes = self.mesh.nodes\n   613→        edges = self.mesh.edges\n   614→        if entries.shape[0] == len(nodes):\n   615→            space = nodes\n   616→        elif entries.shape[0] == len(edges):\n   617→            space = edges\n   618→\n   619→        # add points outside domain for extrapolation to boundaries\n   620→        extrap_space_left = np.array([2 * space[0] - space[1]])\n   621→        extrap_space_right = np.array([2 * space[-1] - space[-2]])\n   622→        space = np.concatenate([extrap_space_left, space, extrap_space_right])\n   623→        extrap_entries_left = 2 * entries[0] - entries[1]\n   624→        extrap_entries_right = 2 * entries[-1] - entries[-2]\n   625→        entries_for_interp = np.vstack(\n   626→            [extrap_entries_left, entries, extrap_entries_right]\n   627→        )\n   628→\n   629→        # assign attributes for reference (either x_sol or r_sol)\n   630→        self.spatial_variable_names = {\n   631→            k: self._process_spatial_variable_names(v)\n   632→            for k, v in self.spatial_variables.items()\n   633→        }\n   634→        self.first_dimension = self.spatial_variable_names[\"primary\"]\n   635→\n   636→        # assign attributes for reference\n   637→        pts_for_interp = space\n   638→        self.internal_boundaries = self.mesh.internal_boundaries\n   639→\n   640→        # Set first_dim_pts to edges for nicer plotting\n   641→        self.first_dim_pts = edges\n   642→\n   643→        # save attributes for interpolation\n   644→        coords_for_interp = {self.first_dimension: pts_for_interp, \"t\": t}\n   645→\n   646→        return entries_for_interp, coords_for_interp\n   647→\n   648→    def _shape(self, t):\n   649→        t_size = len(t)\n   650→        space_size = self.base_eval_shape[0]\n   651→        return [space_size, t_size]\n   652→\n   653→\n   654→class ProcessedVariable2D(ProcessedVariable):\n   655→    \"\"\"\n   656→    An object that can be evaluated at arbitrary (scalars or vectors) t and x, and\n   657→    returns the (interpolated) value of the base variable at that t and x.\n   658→\n   659→    Parameters\n   660→    ----------\n   661→    base_variables : list of :class:`pybamm.Symbol`\n   662→        A list of base variables with a method `evaluate(t,y)`, each entry of which\n   663→        returns the value of that variable for that particular sub-solution.\n   664→        A Solution can be comprised of sub-solutions which are the solutions of\n   665→        different models.\n   666→        Note that this can be any kind of node in the expression tree, not\n   667→        just a :class:`pybamm.Variable`.\n   668→        When evaluated, returns an array of size (m,n)\n   669→    base_variables_casadi : list of :class:`casadi.Function`\n   670→        A list of casadi functions. When evaluated, returns the same thing as\n   671→        `base_Variable.evaluate` (but more efficiently).\n   672→    solution : :class:`pybamm.Solution`\n   673→        The solution object to be used to create the processed variables\n   674→    \"\"\"\n   675→\n   676→    def __init__(\n   677→        self,\n   678→        base_variables,\n   679→        base_variables_casadi,\n   680→        solution,\n   681→        time_integral: Optional[pybamm.ProcessedVariableTimeIntegral] = None,\n   682→    ):\n   683→        self.dimensions = 2\n   684→        super().__init__(\n   685→            base_variables,\n   686→            base_variables_casadi,\n   687→            solution,\n   688→            time_integral=time_integral,\n   689→        )\n   690→        first_dim_nodes = self.mesh.nodes\n   691→        first_dim_edges = self.mesh.edges\n   692→        second_dim_nodes = self.base_variables[0].secondary_mesh.nodes\n   693→        if self.base_eval_size // len(second_dim_nodes) == len(first_dim_nodes):\n   694→            first_dim_pts = first_dim_nodes\n   695→        elif self.base_eval_size // len(second_dim_nodes) == len(first_dim_edges):\n   696→            first_dim_pts = first_dim_edges\n   697→\n   698→        second_dim_pts = second_dim_nodes\n   699→        self.first_dim_size = len(first_dim_pts)\n   700→        self.second_dim_size = len(second_dim_pts)\n   701→\n   702→    def _observe_raw_python(self):\n   703→        \"\"\"\n   704→        Initialise a 2D object that depends on x and r, x and z, x and R, or R and r.\n   705→        \"\"\"\n   706→        pybamm.logger.debug(\"Observing the variable raw data in Python\")\n   707→        first_dim_size, second_dim_size, t_size = self._shape(self.t_pts)\n   708→        entries = np.empty((first_dim_size, second_dim_size, t_size))\n   709→\n   710→        # Evaluate the base_variable index-by-index\n   711→        idx = 0\n   712→        for ts, ys, inputs, base_var_casadi in zip(\n   713→            self.all_ts, self.all_ys, self.all_inputs_casadi, self.base_variables_casadi\n   714→        ):\n   715→            for inner_idx, t in enumerate(ts):\n   716→                t = ts[inner_idx]\n   717→                y = ys[:, inner_idx]\n   718→                entries[:, :, idx] = np.reshape(\n   719→                    base_var_casadi(t, y, inputs).full(),\n   720→                    [first_dim_size, second_dim_size],\n   721→                    order=\"F\",\n   722→                )\n   723→                idx += 1\n   724→        return entries\n   725→\n   726→    def _interp_setup(self, entries, t):\n   727→        \"\"\"\n   728→        Initialise a 2D object that depends on x and r, x and z, x and R, or R and r.\n   729→        \"\"\"\n   730→        first_dim_nodes = self.mesh.nodes\n   731→        first_dim_edges = self.mesh.edges\n   732→        second_dim_nodes = self.base_variables[0].secondary_mesh.nodes\n   733→        second_dim_edges = self.base_variables[0].secondary_mesh.edges\n   734→        if self.base_eval_size // len(second_dim_nodes) == len(first_dim_nodes):\n   735→            first_dim_pts = first_dim_nodes\n   736→        elif self.base_eval_size // len(second_dim_nodes) == len(first_dim_edges):\n   737→            first_dim_pts = first_dim_edges\n   738→\n   739→        second_dim_pts = second_dim_nodes\n   740→\n   741→        # add points outside first dimension domain for extrapolation to\n   742→        # boundaries\n   743→        extrap_space_first_dim_left = np.array(\n   744→            [2 * first_dim_pts[0] - first_dim_pts[1]]\n   745→        )\n   746→        extrap_space_first_dim_right = np.array(\n   747→            [2 * first_dim_pts[-1] - first_dim_pts[-2]]\n   748→        )\n   749→        first_dim_pts = np.concatenate(\n   750→            [extrap_space_first_dim_left, first_dim_pts, extrap_space_first_dim_right]\n   751→        )\n   752→        extrap_entries_left = np.expand_dims(2 * entries[0] - entries[1], axis=0)\n   753→        extrap_entries_right = np.expand_dims(2 * entries[-1] - entries[-2], axis=0)\n   754→        entries_for_interp = np.concatenate(\n   755→            [extrap_entries_left, entries, extrap_entries_right], axis=0\n   756→        )\n   757→\n   758→        # add points outside second dimension domain for extrapolation to\n   759→        # boundaries\n   760→        extrap_space_second_dim_left = np.array(\n   761→            [2 * second_dim_pts[0] - second_dim_pts[1]]\n   762→        )\n   763→        extrap_space_second_dim_right = np.array(\n   764→            [2 * second_dim_pts[-1] - second_dim_pts[-2]]\n   765→        )\n   766→        second_dim_pts = np.concatenate(\n   767→            [\n   768→                extrap_space_second_dim_left,\n   769→                second_dim_pts,\n   770→                extrap_space_second_dim_right,\n   771→            ]\n   772→        )\n   773→        extrap_entries_second_dim_left = np.expand_dims(\n   774→            2 * entries_for_interp[:, 0, :] - entries_for_interp[:, 1, :], axis=1\n   775→        )\n   776→        extrap_entries_second_dim_right = np.expand_dims(\n   777→            2 * entries_for_interp[:, -1, :] - entries_for_interp[:, -2, :], axis=1\n   778→        )\n   779→        entries_for_interp = np.concatenate(\n   780→            [\n   781→                extrap_entries_second_dim_left,\n   782→                entries_for_interp,\n   783→                extrap_entries_second_dim_right,\n   784→            ],\n   785→            axis=1,\n   786→        )\n   787→\n   788→        self.spatial_variable_names = {\n   789→            k: self._process_spatial_variable_names(v)\n   790→            for k, v in self.spatial_variables.items()\n   791→        }\n   792→\n   793→        self.first_dimension = self.spatial_variable_names[\"primary\"]\n   794→        self.second_dimension = self.spatial_variable_names[\"secondary\"]\n   795→\n   796→        # assign attributes for reference\n   797→        first_dim_pts_for_interp = first_dim_pts\n   798→        second_dim_pts_for_interp = second_dim_pts\n   799→\n   800→        # Set pts to edges for nicer plotting\n   801→        self.first_dim_pts = first_dim_edges\n   802→        self.second_dim_pts = second_dim_edges\n   803→\n   804→        # save attributes for interpolation\n   805→        coords_for_interp = {\n   806→            self.first_dimension: first_dim_pts_for_interp,\n   807→            self.second_dimension: second_dim_pts_for_interp,\n   808→            \"t\": t,\n   809→        }\n   810→\n   811→        return entries_for_interp, coords_for_interp\n   812→\n   813→    def _shape(self, t):\n   814→        first_dim_size = self.first_dim_size\n   815→        second_dim_size = self.second_dim_size\n   816→        t_size = len(t)\n   817→        return [first_dim_size, second_dim_size, t_size]\n   818