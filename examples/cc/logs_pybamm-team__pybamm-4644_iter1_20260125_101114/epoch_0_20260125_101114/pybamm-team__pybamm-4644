a_const * data_t\n   180\u2192        data = pybamm.DiscreteTimeData(data_t, data_v, \"test_data\")\n   181\u2192        var = (y - data) ** order\n   182\u2192        expected_entries = (y_sol - data_v) ** order\n   183\u2192        var.mesh = None\n   184\u2192        model = pybamm.BaseModel()\n   185\u2192        var_casadi = to_casadi(var, y_sol)\n   186\u2192        processed_var = pybamm.process_variable(\n   187\u2192            [var],\n   188\u2192            [var_casadi],\n   189\u2192            self._sol_default(t_sol, y_sol, yp_sol, model),\n   190\u2192        )\n   191\u2192        np.testing.assert_array_equal(processed_var.entries, expected_entries.flatten())\n   192\u2192        np.testing.assert_array_equal(processed_var(data_t), expected_entries.flatten())\n   193\u2192\n   194\u2192        # data is different timepoints as solution\n   195\u2192        data_t = np.linspace(0, 1, 7)\n   196\u2192        data_v = -data_const * data_t\n   197\u2192        y_sol_interp = (np.interp(data_t, t_sol, y_sol[0]),)\n   198\u2192        data_v_interp = np.interp(t_sol, data_t, data_v)\n   199\u2192        data = pybamm.DiscreteTimeData(data_t, data_v, \"test_data\")\n   200\u2192\n   201\u2192        # check data interp\n   202\u2192        np.testing.assert_array_almost_equal(\n   203\u2192            data.evaluate(t=t_sol).flatten(), data_v_interp\n   204\u2192        )\n   205\u2192\n   206\u2192        var = (y - data) ** order\n   207\u2192        expected = (y_sol_interp - data_v) ** order\n   208\u2192        expected_entries = (y_sol - data_v_interp) ** order\n   209\u2192        var.mesh = None\n   210\u2192        model = pybamm.BaseModel()\n   211\u2192        var_casadi = to_casadi(var, y_sol)\n   212\u2192        processed_var = pybamm.process_variable(\n   213\u2192            [var],\n   214\u2192            [var_casadi],\n   215\u2192            self._sol_default(t_sol, y_sol, yp_sol, model),\n   216\u2192        )\n   217\u2192        np.testing.assert_array_almost_equal(\n   218\u2192            processed_var.entries, expected_entries.flatten(), decimal=10\n   219\u2192        )\n   220\u2192        np.testing.assert_array_almost_equal(\n   221\u2192            processed_var(t=data_t), expected.flatten(), decimal=10\n   222\u2192        )\n   223\u2192\n   224\u2192    @pytest.mark.parametrize(\"hermite_interp\", _hermite_args)\n   225\u2192    def test_processed_variable_0D_no_sensitivity(self, hermite_interp):\n   226\u2192        # without space\n   227\u2192        t = pybamm.t\n   228\u2192        y = pybamm.StateVector(slice(0, 1))\n   229\u2192        var = t * y\n   230\u2192        var.mesh = None\n   231\u2192        t_sol = np.linspace(0, 1)\n   232\u2192        y_sol = np.array([np.linspace(0, 5)])\n   233\u2192        yp_sol = self._get_yps(y_sol, hermite_interp)\n   234\u2192        var_casadi = to_casadi(var, y_sol)\n   235\u2192        processed_var = pybamm.process_variable(\n   236\u2192            [var],\n   237\u2192            [var_casadi],\n   238\u2192            self._sol_default(t_sol, y_sol, yp_sol, pybamm.BaseModel()),\n   239\u2192        )\n   240\u2192\n   241\u2192        # test no inputs (i.e. no sensitivity)\n   242\u2192        assert processed_var.sensitivities == {}\n   243\u2192\n   244\u2192        # with parameter\n   245\u2192        t = pybamm.t\n   246\u2192        y = pybamm.StateVector(slice(0, 1))\n   247\u2192        a = pybamm.InputParameter(\"a\")\n   248\u2192        var = t * y * a\n   249\u2192        var.mesh = None\n   250\u2192        t_sol = np.linspace(0, 1)\n   251\u2192        y_sol = np.array([np.linspace(0, 5)])\n   252\u2192        inputs = {\"a\": np.array([1.0])}\n   253\u2192        var_casadi = to_casadi(var, y_sol, inputs=inputs)\n   254\u2192        processed_var = pybamm.process_variable(\n   255\u2192            [var],\n   256\u2192            [var_casadi],\n   257\u2192            pybamm.Solution(t_sol, y_sol, pybamm.BaseModel(), inputs),\n   258\u2192        )\n   259\u2192\n   260\u2192        # test no sensitivity raises error\n   261\u2192        with pytest.raises(ValueError, match=\"Cannot compute sensitivities\"):\n   262\u2192            print(processed_var.sensitivities)\n   263\u2192\n   264\u2192    @pytest.mark.parametrize(\"hermite_interp\", _hermite_args)\n   265\u2192    def test_processed_variable_1D(self, hermite_interp):\n   266\u2192        t = pybamm.t\n   267\u2192        var = pybamm.Variable(\"var\", domain=[\"negative electrode\", \"separator\"])\n   268\u2192        x = pybamm.SpatialVariable(\"x\", domain=[\"negative electrode\", \"separator\"])\n   269\u2192        eqn = t * var + x\n   270\u2192\n   271\u2192        # On nodes\n   272\u2192        disc = tests.get_discretisation_for_testing()\n   273\u2192        disc.set_variable_slices([var])\n   274\u2192        x_sol = disc.process_symbol(x).entries[:, 0]\n   275\u2192        var_sol = disc.process_symbol(var)\n   276\u2192        eqn_sol = disc.process_symbol(eqn)\n   277\u2192        t_sol = np.linspace(0, 1)\n   278\u2192        y_sol = np.ones_like(x_sol)[:, np.newaxis] * np.linspace(0, 5)\n   279\u2192        yp_sol = self._get_yps(y_sol, hermite_interp, values=5)\n   280\u2192\n   281\u2192        var_casadi = to_casadi(var_sol, y_sol)\n   282\u2192        processed_var = pybamm.process_variable(\n   283\u2192            [var_sol],\n   284\u2192            [var_casadi],\n   285\u2192            self._sol_default(t_sol, y_sol, yp_sol),\n   286\u2192        )\n   287\u2192        np.testing.assert_array_equal(processed_var.entries, y_sol)\n   288\u2192        np.testing.assert_array_almost_equal(processed_var(t_sol, x_sol), y_sol)\n   289\u2192        eqn_casadi = to_casadi(eqn_sol, y_sol)\n   290\u2192        processed_eqn = pybamm.process_variable(\n   291\u2192            [eqn_sol],\n   292\u2192            [eqn_casadi],\n   293\u2192            self._sol_default(t_sol, y_sol, yp_sol),\n   294\u2192        )\n   295\u2192        np.testing.assert_array_almost_equal(\n   296\u2192            processed_eqn(t_sol, x_sol), t_sol * y_sol + x_sol[:, np.newaxis]\n   297\u2192        )\n   298\u2192\n   299\u2192        # Test extrapolation\n   300\u2192        np.testing.assert_array_equal(processed_var.entries[0], 2 * y_sol[0] - y_sol[1])\n   301\u2192        np.testing.assert_array_equal(\n   302\u2192            processed_var.entries[1], 2 * y_sol[-1] - y_sol[-2]\n   303\u2192        )\n   304\u2192\n   305\u2192        # On edges\n   306\u2192        x_s_edge = pybamm.Matrix(disc.mesh[\"separator\"].edges, domain=\"separator\")\n   307\u2192        x_s_edge.mesh = disc.mesh[\"separator\"]\n   308\u2192        x_s_casadi = to_casadi(x_s_edge, y_sol)\n   309\u2192        processed_x_s_edge = pybamm.process_variable(\n   310\u2192            [x_s_edge],\n   311\u2192            [x_s_casadi],\n   312\u2192            self._sol_default(t_sol, y_sol, yp_sol),\n   313\u2192        )\n   314\u2192        np.testing.assert_array_equal(\n   315\u2192            x_s_edge.entries[:, 0], processed_x_s_edge.entries[:, 0]\n   316\u2192        )\n   317\u2192\n   318\u2192        # space only\n   319\u2192        eqn = var + x\n   320\u2192        eqn_sol = disc.process_symbol(eqn)\n   321\u2192        t_sol = np.array([0])\n   322\u2192        y_sol = np.ones_like(x_sol)[:, np.newaxis]\n   323\u2192        yp_sol = self._get_yps(y_sol, hermite_interp, values=0)\n   324\u2192        eqn_casadi = to_casadi(eqn_sol, y_sol)\n   325\u2192        processed_eqn2 = pybamm.process_variable(\n   326\u2192            [eqn_sol],\n   327\u2192            [eqn_casadi],\n   328\u2192            self._sol_default(t_sol, y_sol, yp_sol),\n   329\u2192        )\n   330\u2192        np.testing.assert_array_equal(\n   331\u2192            processed_eqn2.entries, y_sol + x_sol[:, np.newaxis]\n   332\u2192        )\n   333\u2192\n   334\u2192        # check that C++ and Python give the same result\n   335\