  def _interp_setup(self, entries, t):\n   740→        \"\"\"\n   741→        Initialise a 2D object that depends on x and r, x and z, x and R, or R and r.\n   742→        \"\"\"\n   743→        first_dim_nodes = self.mesh.nodes\n   744→        first_dim_edges = self.mesh.edges\n   745→        second_dim_nodes = self.base_variables[0].secondary_mesh.nodes\n   746→        second_dim_edges = self.base_variables[0].secondary_mesh.edges\n   747→        if self.base_eval_size // len(second_dim_nodes) == len(first_dim_nodes):\n   748→            first_dim_pts = first_dim_nodes\n   749→        elif self.base_eval_size // len(second_dim_nodes) == len(first_dim_edges):\n   750→            first_dim_pts = first_dim_edges\n   751→\n   752→        second_dim_pts = second_dim_nodes\n   753→\n   754→        # add points outside first dimension domain for extrapolation to\n   755→        # boundaries\n   756→        extrap_space_first_dim_left = np.array(\n   757→            [2 * first_dim_pts[0] - first_dim_pts[1]]\n   758→        )\n   759→        extrap_space_first_dim_right = np.array(\n   760→            [2 * first_dim_pts[-1] - first_dim_pts[-2]]\n   761→        )\n   762→        first_dim_pts = np.concatenate(\n   763→            [extrap_space_first_dim_left, first_dim_pts, extrap_space_first_dim_right]\n   764→        )\n   765→        extrap_entries_left = np.expand_dims(2 * entries[0] - entries[1], axis=0)\n   766→        extrap_entries_right = np.expand_dims(2 * entries[-1] - entries[-2], axis=0)\n   767→        entries_for_interp = np.concatenate(\n   768→            [extrap_entries_left, entries, extrap_entries_right], axis=0\n   769→        )\n   770→\n   771→        # add points outside second dimension domain for extrapolation to\n   772→        # boundaries\n   773→        extrap_space_second_dim_left = np.array(\n   774→            [2 * second_dim_pts[0] - second_dim_pts[1]]\n   775→        )\n   776→        extrap_space_second_dim_right = np.array(\n   777→     