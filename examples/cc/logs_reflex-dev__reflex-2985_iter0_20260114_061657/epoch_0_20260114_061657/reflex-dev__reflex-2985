        f.add_done_callback(_mark_complete)\n   887→                result_futures.append(f)\n   888→\n   889→            # Compile all page components.\n   890→            for route in self.pages:\n   891→                _submit_work(ExecutorSafeFunctions.compile_page, route)\n   892→\n   893→            # Compile the app wrapper.\n   894→            _submit_work(ExecutorSafeFunctions.compile_app)\n   895→\n   896→            # Compile the custom components.\n   897→            custom_components_future = executor.submit(\n   898→                ExecutorSafeFunctions.compile_custom_components,\n   899→            )\n   900→            custom_components_future.add_done_callback(_mark_complete)\n   901→\n   902→            # Compile the root stylesheet with base styles.\n   903→            _submit_work(compiler.compile_root_stylesheet, self.stylesheets)\n   904→\n   905→            # Compile the theme.\n   906→            _submit_work(ExecutorSafeFunctions.compile_theme)\n   907→\n   908→            # Compile the Tailwind config.\n   909→            if config.tailwind is not None:\n   910→                config.tailwind[\"content\"] = config.tailwind.get(\n   911→                    \"content\", constants.Tailwind.CONTENT\n   912→                )\n   913                _submit_work(compiler.compile_tailwind, config.tailwind)\n   914→            else:\n   915→                _submit_work(compiler.remove_tailwind_from_postcss)\n   916→\n   917→            # Wait for all compilation tasks to complete.\n   918→            for future in concurrent.futures.as_completed(result_futures):\n   919→                compile_results.append(future.result())\n   920→\n   921→            # Special case for custom_components, since we need the compiled imports\n   922→            # to install proper frontend packages.\n   923→            (\n   924→                *custom_components_result,\n   925→                custom_components_imports,\n   926→            ) = custom_components_future.result()\n   927→            compile_results.append(custom_components_result)\n   928→            all_imports.update(custom_components_imports)\n   929→\n   930→        # Get imports from AppWrap components.\n   931→        all_imports.update(app_root.get_imports())\n   932→\n   933→        progress.advance(task)\n   934→\n   935→        # Empty the .web pages directory.\n   936→        compiler.purge_web_pages_dir()\n   937→\n   938→        progress.advance(task)\n   939→        progress.stop()\n   940→\n   941→        # Install frontend packages.\n   942→        self.get_frontend_packages(all_imports)\n   943→\n   944→        for output_path, code in compile_results:\n   945→            compiler_utils.write_page(output_path, code)\n   946→\n   947→    @contextlib.asynccontextmanager\n   948→    async def modify_state(self, token: str) -> AsyncIterator[BaseState]:\n   949→        \"\"\"Modify the state out of band.\n   950→\n   951→        Args:\n   952→            token: The token to modify the state for.\n   953→\n   954→        Yields:\n   955→            The state to modify.\n   956→\n   957→        Raises:\n   958→            RuntimeError: If the app has not been initialized yet.\n   959→        \"\"\"\n   960→        if self.event_namespace is None:\n   961→            raise RuntimeError(\"App has not been initialized yet.\")\n   962→\n   963→        # Get exclusive access to the state.\n   964→        async with self.state_manager.modify_state(token) as state:\n   965→            # No other event handler can modify the state while in this context.\n   966→            yield state\n   967→            delta = state.get_delta()\n   968→            if delta:\n   969→                # When the state is modified reset dirty status and emit the delta to the frontend.\n   970→                state._clean()\n   971→                await self.event_namespace.emit_update(\n   972→                    update=StateUpdate(delta=delta),\n   973→                    sid=state.router.session.session_id,\n   974→                )\n   975→\n   976→    def _process_background(\n   977→        self, state: BaseState, event: Event\n   978→    ) -> asyncio.Task | None:\n   979→        \"\"\"Process an event in the background and emit updates as they arrive.\n   980→\n   981→        Args:\n   982→            state: The state to process the event for.\n   983→            event: The event to process.\n   984→\n   985→        Returns:\n   986→            Task if the event was backgroundable, otherwise None\n   987→        \"\"\"\n   988→        substate, handler = state._get_event_handler(event)\n   989→        if not handler.is_background:\n   990→            return None\n   991→\n   992→        async def _coro():\n   993→            \"\"\"Coroutine to process the event and emit updates inside an asyncio.Task.\n   994→\n   995→            Raises:\n   996→                RuntimeError: If the app has not been initialized yet.\n   997→            \"\"\"\n   998→            if self.event_namespace is None:\n   999→                raise RuntimeError(\"App has not been initialized yet.\")\n  1000→\n  1001→            # Process the event.\n  1002→            async for update in state._process_event(\n  1003→                handler=handler, state=substate, payload=event.payload\n  1004→            ):\n  1005→                # Postprocess the event.\n  1006→                update = await self.postprocess(state, event, update)\n  1007→\n  1008→                # Send the update to the client.\n  1009→                await self.event_namespace.emit_update(\n  1010→                    update=update,\n  1011→                    sid=state.router.session.session_id,\n  1012→                )\n  1013→\n  1014→        task = asyncio.create_task(_coro())\n  1015→        self.background_tasks.add(task)\n  1016→        # Clean up task from background_tasks set when complete.\n  1017→        task.add_done_callback(self.background_tasks.discard)\n  1018→        retu