40→        step: TimeoutType = None,\n   441→    ) -> T | bool:\n   442→        \"\"\"Generic polling logic for async functions.\n   443→\n   444→        Args:\n   445→            target: callable that returns truthy if polling condition is met.\n   446→            timeout: max polling time\n   447→            step: interval between checking target()\n   448→\n   449→        Returns:\n   450→            return value of target() if truthy within timeout\n   451→            False if timeout elapses\n   452→        \"\"\"\n   453→        if timeout is None:\n   454→            timeout = DEFAULT_TIMEOUT\n   455→        if step is None:\n   456→            step = POLL_INTERVAL\n   457→        deadline = time.time() + timeout\n   458→        while time.time() < deadline:\n   459→            success = await target()\n   460→            if success:\n   461→                return success\n   462→            await asyncio.sleep(step)\n   463→        return False\n   464→\n   465→    def _poll_for_servers(self, timeout: TimeoutType = None) -> socket.socket:\n   466→        \"\"\"Poll backend server for listening sockets.\n   467→\n   468→        Args:\n   469→            timeout: how long to wait for listening socket.\n   470→\n   471→        Returns:\n   472→            first active listening socket on the backend\n   473→\n   474→        Raises:\n   475→            RuntimeError: when the backend hasn't started running\n   476→            TimeoutError: when server or sockets are not ready\n   477→        \"\"\"\n   478→        if self.backend is None:\n   479→            raise RuntimeError(\"Backend is not running.\")\n   480→        backend = self.backend\n   481→        # check for servers to be initialized\n   482→        if not self._poll_for(\n   483→            target=lambda: getattr(backend, \"servers\", False),\n   484→            timeout=timeout,\n   485→        ):\n   486→            raise TimeoutError(\"Backend servers are not initialized.\")\n   487→        # chec