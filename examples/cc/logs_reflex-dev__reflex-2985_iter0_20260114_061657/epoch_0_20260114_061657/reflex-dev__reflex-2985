ient states.\n   126→    _state_manager: Optional[StateManager] = None\n   127→\n   128→    # The styling to apply to each component.\n   129→    style: ComponentStyle = {}\n   130→\n   131→    # Middleware to add to the app.\n   132→    middleware: List[Middleware] = []\n   133→\n   134→    # List of event handlers to trigger when a page loads.\n   135→    load_events: Dict[str, List[Union[EventHandler, EventSpec]]] = {}\n   136→\n   137→    # Admin dashboard\n   138→    admin_dash: Optional[AdminDash] = None\n   139→\n   140→    # The async server name space\n   141→    event_namespace: Optional[EventNamespace] = None\n   142→\n   143→    # Components to add to the head of every page.\n   144→    head_components: List[Component] = []\n   145→\n   146→    # The language to add to the html root tag of every page.\n   147→    html_lang: Optional[str] = None\n   148→\n   149→    # Attributes to add to the html root tag of every page.\n   150→    html_custom_attrs: Optional[Dict[str, str]] = None\n   151→\n   152→    # A component that is present on every page.\n   153→    overlay_component: Optional[\n   154→        Union[Component, ComponentCallable]\n   155→    ] = default_overlay_component\n   156→\n   157→    # Background tasks that are currently running\n   158→    background_tasks: Set[asyncio.Task] = set()\n   159→\n   160→    # The radix theme for the entire app\n   161→    theme: Optional[Component] = themes.theme(accent_color=\"blue\")\n   162→\n   163→    def __init__(self, *args, **kwargs):\n   164→        \"\"\"Initialize the app.\n   165→\n   166→        Args:\n   167→            *args: Args to initialize the app with.\n   168→            **kwargs: Kwargs to initialize the app with.\n   169→\n   170→        Raises:\n   171→            ValueError: If the event namespace is not provided in the config.\n   172→                        Also, if there are multiple client subclasses of rx.BaseState(Subclasses of rx.BaseState should consist\n   173→                        of the DefaultState and the client app state).\n   174→        \"\"\"\n   175→        if \"connect_error_component\" in kwargs:\n   176→            raise ValueError(\n   177→                \"`connect_error_component` is deprecated, use `overlay_component` instead\"\n   178→            )\n   179→        super().__init__(*args, **kwargs)\n   180→        base_state_subclasses = BaseState.__subclasses__()\n   181→\n   182→        # Special case to allow test cases have multiple subclasses of rx.BaseState.\n   183→        if not is_testing_env():\n   184→            # Only one Base State class is allowed.\n   185→            if len(base_state_subclasses) > 1:\n   186→                raise ValueError(\n   187→                    \"rx.BaseState cannot be subclassed multiple times. use rx.State instead\"\n   188→                )\n   189→\n   190→            if \"state\" in kwargs:\n   191→                console.deprecate(\n   192→                    feature_name=\"`state` argument for App()\",\n   193→                    reason=\"due to all `rx.State` subclasses being inferred.\",\n   194→                    deprecation_version=\"0.3.5\",\n   195→                    removal_version=\"0.5.0\",\n   196→                )\n   197→        # Add middleware.\n   198→        self.middleware.append(HydrateMiddleware())\n   199→\n   200→        # Set up the API.\n   201→        self.api = FastAPI()\n   202→        self.add_cors()\n   203→        self.add_default_endpoints()\n   204→\n   205→        self.setup_state()\n   206→\n   207→        # Set up the admin dash.\n   208→        self.setup_admin_dash()\n   209→\n   210→    def enable_state(self) -> None:\n   211→        \"\"\"Enable state for the app.\"\"\"\n   212→        if not self.state:\n   213→            self.state = State\n   214→            self.setup_state()\n   215→\n   216→    def setup_state(self) -> None:\n   217→        \"\"\"Set up the state for the app.\n   218→\n   219→        Raises:\n   220→            ValueError: If the event namespace is not provided in the config.\n   221→                        If the state has not been enabled.\n   222→        \"\"\"\n   223→        if not self.state:\n   224→            return\n   225→\n   226→        config = get_config()\n   227→\n   228→        # Set up the state manager.\n   229→        self._state_manager = StateManager.create(state=self.state)\n   230→\n   231→        # Set up the Socket.IO AsyncServer.\n   232→        self.sio = AsyncServer(\n   233→            async_mode=\"asgi\",\n   234→            cors_allowed_origins=(\n   235→                \"*\"\n   236→                if config.cors_allowed_origins == [\"*\"]\n   237→                else config.cors_allowed_origins\n   238→            ),\n   239→            cors_credentials=True,\n   240→            max_http_buffer_size=constants.POLLING_MAX_HTTP_BUFFER_SIZE,\n   241→            ping_interval=constants.Ping.INTERVAL,\n   242→            ping_timeout=constants.Ping.TIMEOUT,\n   243→        )\n   244→\n   245→        # Create the socket app. Note event endpoint constant replaces the default 'socket.io' path.\n   246→        self.socket_app = ASGIApp(self.sio, socketio_path=\"\")\n   247→        namespace = config.get_event_namespace()\n   248→\n   249→        if not namespace:\n   250→            raise ValueError(\"event namespace must be provided in the config.\")\n   251→\n   252→        # Create the event namespace and attach the main app. Not related to any paths.\n   253→        self.event_namespace = EventNamespace(namespace, self)\n   254→\n   255→        # Register the event namespace with the socket.\n   256→        self.sio.register_namespace(self.event_namespace)\n   257→        # Mount the socket app with the API.\n   258→        self.api.mount(str(constants.Endpoint.EVENT), self.socket_app)\n   259→\n   260→    def __repr__(self) -> str:\n   261→        \"\"\"Get the string representation of the app.\n   262→\n   263→        Returns:\n   264→            The string representation of the app.\n   265→        \"\"\"\n   266→        return f\"<App state={self.state.__name__ if self.state else None}>\"\n   267→\n   268→    def __call__(self) -> FastAPI:\n   269→        \"\"\"Run the backend api instance.\n   270→\n   271→        Returns:\n   272→            The backend api.\n   273→        \"\"\"\n   274→        return self.api\n   275→\n   276→    def add_default_endpoints(self):\n   277→        \"\"\"Add default api endpoints (ping).\"\"\"\n   278→        # To test the server.\n   279→        self.api.get(str(constants.Endpoint.PING))(ping)\n   280→\n   281→    def add_optional_endpoints(self):\n   282→        \"\"\"Add optional api endpoints (_upload).\"\"\"\n   283→        # To upload files.\n   284→        if Upload.is_used:\n   285→            self.api.post(str(constants.Endpoint.UPLOAD))(upload(self))\n   286→\n   287→            # To access uploaded files.\n   288→            self.api.mount(\n   289→                str(constants.Endpoint.UPLOAD),\n   290→                StaticFiles(directory=get_upload_dir()),\n   291→                name=\"uploaded_files\",\n   292→            )\n   293→\n   294→    def add_cors(self):\n   295→        \"\"\"Add CORS middleware to the app.\"\"\"\n   296→        self.api.add_middleware(\n   297→            cors.CORSMiddleware,\n   298→            allow_credentials=True,\n   299→            allow_methods=[\"*\"],\n   300→            allow_headers=[\"*\"],\n   301→            allow_origins=[\"*\"],\n   302→        )\n   303→\n   304→    @property\n   305→    def state_manager(self) -> StateManager:\n   306→        \"\"\"Get the state manager.\n   307→\n   308→        Returns:\n   309→            The initialized state manager.\n   310→\n   311→        Raises:\n   312→            ValueError: if the state has not been initialized.\n   313→        \"\"\"\n   314→        if self._state_manager is None:\n   315→            raise ValueError(\"The state manager has not been initialized.\")\n   316→        return self._state_manager\n   317→\n   318→    async def preprocess(self, state: BaseState, event: Event) -> StateUpdate | None:\n   319→        \"\"\"Preprocess the event.\n   320→\n   321→        This is where middleware can modify the event before it is processed.\n   322→        Each middleware is called in the order it was added to the app.\n   323→\n   324→        If a middleware returns an update, the event is not processed and the\n   325→        update is returned.\n   326→\n   327→        Args:\n   328→            state: The state to preprocess.\n   329→            event: The event to preprocess.\n   330→\n   331→        Returns:\n   332→            An optional state to return.\n   333→        \"\"\"\n   334→        for middleware in self.middleware:\n   335→            if asyncio.iscoroutinefunction(middleware.preprocess):\n   336→                out = await middleware.preprocess(app=self, state=state, event=event)  # type: ignore\n   337→            else:\n   338→                out = middleware.preprocess(app=self, state=state, event=event)  # type: ignore\n   339→            if out is not None:\n   340→                return out  # type: ignore\n   341→\n   342→    async def postprocess(\n   343→        self, state: BaseState, event: Event, update: StateUpdate\n   344→    ) -> StateUpdate:\n   345→        \"\"\"Postprocess the event.\n   346→\n   347→        This is where middleware can modify the delta after it is processed.\n   348→        Each middleware is called in the order it was added to the app.\n   349→\n   350→        Args:\n   351→            state: The state to postprocess.\n   352→            event: The event to postprocess.\n   353→            update: The current state update.\n   354→\n   355→        Returns:\n   356→            The state update to return.\n   357→        \"\"\"\n   358→        for middleware in self.middleware:\n   359→            if asyncio.iscoroutinefunction(middleware.postprocess):\n   360→                out = await middleware.postprocess(\n   361→                    app=self, state=state, event=event, update=update  # type: ignore\n   362→                )\n   363→            else:\n   364→                out = middleware.postprocess(\n   365→                    app=self, state=state, event=event, update=update  # type: ignore\n   366→                )\n   367→            if out is not None:\n   368→                return out  # type: ignore\n   369→        return update\n   370→\n   371→    def add_middleware(self, middleware: Middleware, index: int | None = None):\n   372→        \"\"\"Add middleware to the app.\n   373→\n   374→        Args:\n   375→            middleware: The middleware to add.\n   376→            index: The index to add the middleware at.\n   377→        \"\"\"\n   378→        if index is None:\n   379→            self.middleware.append(middleware)\n   380→        else:\n   381→            self.middleware.insert(index, middleware)\n   382→\n   383→    @staticmethod\n   384→    def _generate_component(component: Component | ComponentCallable) -> Component:\n   385→        \"\"\"Generate a component from a callable.\n   386→\n   387→        Args:\n   388→            component: The component function to call or Component to return as-is.\n   389→\n   390→        Returns:\n   391→            The generated component.\n   392→\n   393→        Raises:\n   394→            TypeError: When an invalid component function is passed.\n   395→            exceptions.MatchTypeError: If the return types of match cases in rx.match are different.\n   396→        \"\"\"\n   397→        try:\n   398→            return component if isinstance(component, Component) else component()\n   399→        except exceptions.MatchTypeError:\n   400→            raise\n   401→        except TypeError as e:\n   402→            message = str(e)\n   403→            if \"BaseVar\" in message or \"ComputedVar\" in message:\n   404→                raise TypeError(\n   405→                    \"You may be trying to use an invalid Python function on a state var. \"\n   406→                    \"When referencing a var inside your render code, only limited var operations are supported. \"\n   407→                    \"See the var operation docs here: https://reflex.dev/docs/vars/var-operations/\"\n   408→                ) from e\n   409→            raise e\n   410→\n   411→    def add_page(\n   412→        self,\n   413→        component: Component | ComponentCallable,\n   414→        route: str | None = None,\n   415→        title: str | None = None,\n   416→        description: str | None = None,\n   417→        image: str = constants.DefaultPage.IMAGE,\n   418→        on_load: (\n   419→            EventHandler | EventSpec | list[EventHandler | EventSpec] | None\n   420→        ) = None,\n   421→        meta: list[dict[str, str]] = constants.DefaultPage.META_LIST,\n   422→        script_tags: list[Component] | None = None,\n   423→    ):\n   424→        \"\"\"Add a page to the app.\n   425→\n   426→        If the component is a callable, by default the route is the name of the\n   427→        function. Otherwise, a route must be provided.\n   428→\n   429→        Args:\n   430→            component: The component to display at the page.\n   431→            route: The route to display the component at.\n   432→            title: The title of the page.\n   433→            description: The description of the page.\n   434→            image: The image to display on the page.\n   435→            on_load: The event handler(s) that will be called each time the page load.\n   436→            meta: The metadata of the page.\n   437→            script_tags: List of script tags to be added to component\n   438→        \"\"\"\n   439→        # If the route is not set, get it from the callable.\n   440→        if route is None:\n   441→            assert isinstance(\n   442→                component, Callable\n   443→            ), \"Route must be set if component is not a callable.\"\n   444→            # Format the route.\n   445→            route = format.format_route(component.__name__)\n   446→        else:\n   447→            route = format.format_route(route, format_case=False)\n   448→\n   449→        # Check if the route given is valid\n   450→        verify_route_validity(route)\n   451→\n   452→        # Setup dynamic args for the route.\n   453→        # this state assignment is only required for tests using the deprecated state kwarg for App\n   454→        state = self.state if self.state else State\n   455→        state.setup_dynamic_args(get_route_args(route))\n   456→\n   457→        # Generate the component if it is a callable.\n   458→        component = self._generate_component(component)\n   459→\n   460→        # Ensure state is enabled if this page uses state.\n   461→        if self.state is None:\n   462→            if on_load or component._has_event_triggers():\n   463→                self.enable_state()\n   464→            else:\n   465→                for var in component._get_vars(include_children=True):\n   466→                    if not var._var_data:\n   467→                        continue\n   468→                    if not var._var_data.state:\n   469→                        continue\n   470→                    self.enable_state()\n   471→                    break\n   472→\n   473→        component = OverlayFragment.create(component)\n   474→\n   475→        meta_args = {\n   476→            \"title\": (\n   477→                title\n   478→                if title is not None\n   479→                else format.make_default_page_title(get_config().app_name, route)\n   480→            ),\n   481→            \"image\": image,\n   482→            \"meta\": meta,\n   483→        }\n   484→\n   485→        if description is not None:\n   486→            meta_args[\"description\"] = description\n   487→\n   488→        # Add meta information to the component.\n   489→        compiler_utils.add_meta(\n   490→            component,\n   491→            **meta_args,\n   492→        )\n   493→\n   494→        # Add script tags if given\n   495→        if script_tags:\n   496→            console.deprecate(\n   497→                feature_name=\"Passing script tags to add_page\",\n   498→                reason=\"Add script components as children to the page component instead\",\n   499→                deprecation_version=\"0.2.9\",\n   500→                removal_version=\"0.5.0\",\n   501→            )\n   502→            component.children.extend(script_tags)\n   503→\n   504→        # Add the page.\n   505→        self._check_routes_conflict(route)\n   506→        self.pages[route] = component\n   507→\n   508→        # Add the load events.\n   509→        if on_load:\n   510→            if not isinstance(on_load, list):\n   511→                on_load = [on_load]\n   512→            self.load_events[route] = on_load\n   513→\n   514→    def get_load_events(self, route: str) -> list[EventHandler | EventSpec]:\n   515→        \"\"\"Get the load events for a route.\n   516→\n   517→        Args:\n   518→            route: The route to get the load events for.\n   519→\n   520→        Returns:\n   521→            The load events for the route.\n   522→        \"\"\"\n   523→        route = route.lstrip(\"/\")\n   524→        if route == \"\":\n   525→            route = constants.PageNames.INDEX_ROUTE\n   526→        return self.load_events.get(route, [])\n   527→\n   528→    def _check_routes_conflict(self, new_route: str):\n   529→        \"\"\"Verify if there is any conflict between the new route and any existing route.\n   530→\n   531→        Based on conflicts that NextJS would throw if not intercepted.\n   532→\n   533→        Raises:\n   534→            ValueError: exception showing which conflict exist with the route to be added\n   535→\n   536→        Args:\n   537→            new_route: the route being newly added.\n   538→        \"\"\"\n   539→        newroute_catchall = catchall_in_route(new_route)\n   540→        if not newroute_catchall:\n   541→            return\n   542→\n   543→        for route in self.pages:\n   544→            route = \"\" if route == \"index\" else route\n   545→\n   546→            if new_route.startswith(f\"{route}/[[...\"):\n   547→                raise ValueError(\n   548→                    f\"You cannot define a route with the same specificity as a optional catch-all route ('{route}' and '{new_route}')\"\n   549→                )\n   550→\n   551→            route_catchall = catchall_in_route(route)\n   552→            if (\n   553→                route_catchall\n   554→                and newroute_catchall\n   555→                and catchall_prefix(route) == catchall_prefix(new_route)\n   556→            ):\n   557→                raise ValueError(\n   558→                    f\"You cannot use multiple catchall for the same dynamic route ({route} !== {new_route})\"\n   559→                )\n   560→\n   561→    def add_custom_404_page(\n   562→        self,\n   563→        component: Component | ComponentCallable | None = None,\n   564→        title: str = constants.Page404.TITLE,\n   565→        image: str = constants.Page404.IMAGE,\n   566→        description: str = constants.Page404.DESCRIPTION,\n   567→        on_load: (\n   568→            EventHandler | EventSpec | list[EventHandler | EventSpec] | None\n   569→        ) = None,\n   570→        meta: list[dict[str, str]] = constants.DefaultPage.META_LIST,\n   571→    ):\n   572→        \"\"\"Define a custom 404 page for any url having no match.\n   573→\n   574→        If there is no page defined on 'index' route, add the 404 page to it.\n   575→        If there is no global catchall defined, add the 404 page with a catchall\n   576→\n   577→        Args:\n   578→            component: The component to display at the page.\n   579→            title: The title of the page.\n   580→            description: The description of the page.\n   581→            image: The image to display on the page.\n   582→            on_load: The event handler(s) that will be called each time the page load.\n   583→            meta: The metadata of the page.\n   584→        \"\"\"\n   585→        if component is None:\n   586→            component = Default404Page.create()\n   587→        self.add_page(\n   588→            component=wait_for_client_redirect(self._generate_component(component)),\n   589→            route=constants.Page404.SLUG,\n   590→            title=title or constants.Page404.TITLE,\n   591→            image=image or constants.Page404.IMAGE,\n   592→            description=description or constants.Page404.DESCRIPTION,\n   593→            on_load=on_load,\n   594→            meta=meta,\n   595→        )\n   596→\n   597→    def setup_admin_dash(self):\n   598→        \"\"\"Setup the admin dash.\"\"\"\n   599→        # Get the admin dash.\n   600→        admin_dash = self.admin_dash\n   601→\n   602→        if admin_dash and admin_dash.models:\n   603→            # Build the admin dashboard\n   604→            admin = (\n   605→                admin_dash.admin\n   606→                if admin_dash.admin\n   607→                else Admin(\n   608→                    engine=Model.get_db_engine(),\n   609→                    title=\"Reflex Admin Dashboard\",\n   610→                    logo_url=\"https://reflex.dev/Reflex.svg\",\n   611→                )\n   612→            )\n   613→\n   614→            for model in admin_dash.models:\n   615→                view = admin_dash.view_overrides.get(model, ModelView)\n   616→                admin.add_view(view(model))\n   617→\n   618→            admin.mount_to(self.api)\n   619→\n   620→    def get_frontend_packages(self, imports: Dict[str, set[ImportVar]]):\n   621→        \"\"\"Gets the frontend packages to be installed and filters out the unnecessary ones.\n   622→\n   623→        Args:\n   624→            impor