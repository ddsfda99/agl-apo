→        self.error_page_map = error_page_map\n   706→        super().__init__(*args, **kwargs)\n   707→\n   708→    def send_error(\n   709→        self, code: int, message: str | None = None, explain: str | None = None\n   710→    ) -> None:\n   711→        \"\"\"Send the error page for the given error code.\n   712→\n   713→        If the code matches a custom error page, then message and explain are\n   714→        ignored.\n   715→\n   716→        Args:\n   717→            code: the error code\n   718→            message: the error message\n   719→            explain: the error explanation\n   720→        \"\"\"\n   721→        error_page = self.error_page_map.get(code)\n   722→        if error_page:\n   723→            self.send_response(code, message)\n   724→            self.send_header(\"Connection\", \"close\")\n   725→            body = error_page.read_bytes()\n   726→            self.send_header(\"Content-Type\", self.error_content_type)\n   727→            self.send_header(\"Content-Length\", str(len(body)))\n   728→            self.end_headers()\n   729→            self.wfile.write(body)\n   730→        else:\n   731→            super().send_error(code, message, explain)\n   732→\n   733→\n   734→class Subdir404TCPServer(socketserver.TCPServer):\n   735→    \"\"\"TCPServer for SimpleHTTPRequestHandlerCustomErrors that serves from a subdir.\"\"\"\n   736→\n   737→    def __init__(\n   738→        self,\n   739→        *args,\n   740→        root: pathlib.Path,\n   741→        error_page_map: dict[int, pathlib.Path] | None,\n   742→        **kwargs,\n   743→    ):\n   744→        \"\"\"Initialize the server.\n   745→\n   746→        Args:\n   747→            root: the root directory to serve from\n   748→            error_page_map: map of error code to error page path\n   749→            *args: passed through to superclass\n   750→            **kwargs: passed through to superclass\n   751→        \"\"\"\n   752→        self.root = root\n   753→        se