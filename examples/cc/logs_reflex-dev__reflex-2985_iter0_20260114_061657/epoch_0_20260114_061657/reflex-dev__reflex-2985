r.Firefox and want_headless:\n   527→            options = webdriver.FirefoxOptions()\n   528→            options.add_argument(\"-headless\")\n   529→        elif driver_clz is webdriver.Edge and want_headless:\n   530→            options = webdriver.EdgeOptions()\n   531→            options.add_argument(\"headless\")\n   532→        if options and (args := os.environ.get(\"APP_HARNESS_DRIVER_ARGS\")):\n   533→            for arg in args.split(\",\"):\n   534→                options.add_argument(arg)\n   535→        driver = driver_clz(options=options)  # type: ignore\n   536→        driver.get(self.frontend_url)\n   537→        self._frontends.append(driver)\n   538→        return driver\n   539→\n   540→    async def get_state(self, token: str) -> BaseState:\n   541→        \"\"\"Get the state associated with the given token.\n   542→\n   543→        Args:\n   544→            token: The state token to look up.\n   545→\n   546→        Returns:\n   547→            The state instance associated with the given token\n   548→\n   549→        Raises:\n   550→            RuntimeError: when the app hasn't started running\n   551→        \"\"\"\n   552→        if self.state_manager is None:\n   553→            raise RuntimeError(\"state_manager is not set.\")\n   554→        try:\n   555→            return await self.state_manager.get_state(token)\n   556→        finally:\n   557→            if isinstance(self.state_manager, StateManagerRedis):\n   558→                await self.state_manager.close()\n   559→\n   560→    async def set_state(self, token: str, **kwargs) -> None:\n   561→        \"\"\"Set the state associated with the given token.\n   562→\n   563→        Args:\n   564→            token: The state token to set.\n   565→            kwargs: Attributes to set on the state.\n   566→\n   567→        Raises:\n   568→            RuntimeError: when the app hasn't started running\n   569→        \"\"\"\n   570→        if self.state_manager is None:\n   571→            raise RuntimeError(\"state_manager is not set.\")\n   572→        state = await self.get_state(token)\n   573→        for key, value in kwargs.items():\n   574→            setattr(state, key, value)\n   575→        try:\n   576→            await self.state_manager.set_state(token, state)\n   577→        finally:\n   578→            if isinstance(self.state_manager, StateManagerRedis):\n   579→                await self.state_manager.close()\n   580→\n   581→    @contextlib.asynccontextmanager\n   582→    async def modify_state(self, token: str) -> AsyncIterator[State]:\n   583→        \"\"\"Modify the state associated with the given token and send update to frontend.\n   584→\n   585→        Args:\n   586→            token: The state token to modify\n   587→\n   588→        Yields:\n   589→            The state instance associated with the given token\n   590→\n   591→        Raises:\n   592→            RuntimeError: when the app hasn't started running\n   593→        \"\"\"\n   594→        if self.state_manager is None:\n   595→            raise RuntimeError(\"state_manager is not set.\")\n   596→        if self.app_instance is None:\n   597→            raise RuntimeError(\"App is not running.\")\n   598→        app_state_manager = self.app_instance.state_manager\n   599→        if isinstance(self.state_manager, StateManagerRedis):\n   600→            # Temporarily replace the app's state manager with our own, since\n   601→            # the redis connection is on the backend_thread event loop\n   602→            self.app_instance._state_manager = self.state_manager\n   603→        try:\n   604→            async with self.app_instance.modify_state(token) as state:\n   605→                yield state\n   606→        finally:\n   607→            if isinstance(self.state_manager, StateManagerRedis):\n   608→                self.app_instance._state_manager = app_state_manager\n   609→                await self.state_manager.close()\n   610→\n   611→    def poll_for_c