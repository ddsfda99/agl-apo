1→        order = sorted(app_wrappers, key=lambda k: k[0], reverse=True)\n   662→        root = parent = copy.deepcopy(app_wrappers[order[0]])\n   663→        for key in order[1:]:\n   664→            child = copy.deepcopy(app_wrappers[key])\n   665→            parent.children.append(child)\n   666→            parent = child\n   667→        return root\n   668→\n   669→    def _should_compile(self) -> bool:\n   670→        \"\"\"Check if the app should be compiled.\n   671→\n   672→        Returns:\n   673→            Whether the app should be compiled.\n   674→        \"\"\"\n   675→        # Check the environment variable.\n   676→        if should_skip_compile():\n   677→            return False\n   678→\n   679→        # Check the nocompile file.\n   680→        if os.path.exists(constants.NOCOMPILE_FILE):\n   681→            # Delete the nocompile file\n   682→            os.remove(constants.NOCOMPILE_FILE)\n   683→            return False\n   684→\n   685→        # By default, compile the app.\n   686→        return True\n   687→\n   688→    def _add_overlay_to_component(self, component: Component) -> Component:\n   689→        if self.overlay_component is None:\n   690→            return component\n   691→\n   692→        children = component.children\n   693→        overlay_component = self._generate_component(self.overlay_component)\n   694→\n   695→        if children[0] == overlay_component:\n   696→            return component\n   697→\n   698→        # recreate OverlayFragment with overlay_component as first child\n   699→        component = OverlayFragment.create(overlay_component, *children)\n   700→\n   701→        return component\n   702→\n   703→    def _setup_overlay_component(self):\n   704→        \"\"\"If a State is not used and no overlay_component is specified, do not render the connection modal.\"\"\"\n   705→        if self.state is None and self.overlay_component is default_overlay_component:\n   706→            self.overlay_component = None\n   707→        for k, component in self.pages.items():\n   708→            self.pages[k] = self._add_overlay_to_component(component)\n   709→\n   710→    def compile(self):\n   711→        \"\"\"compile_() is the new function for performing compilation.\n   712→        Reflex framework will call it automatically as needed.\n   713→        \"\"\"\n   714→        console.deprecate(\n   715→            feature_name=\"app.compile()\",\n   716→            reason=\"Explicit calls to app.compile() are not needed.\"\n   717→            \" Method will be removed in 0.4.0\",\n   718→            deprecation_version=\"0.3.8\",\n   719→            removal_version=\"0.5.0\",\n   720→        )\n   721→        return\n   722→\n   723→    def _apply_decorated_pages(self):\n   724→        \"\"\"Add @rx.page decorated pages to the app.\n   725→\n   726→        This has to be done in the MainThread for py38 and py39 compatibility, so the\n   727→        decorated pages are added to the app before the app is compiled (in a thread)\n   728→        to workaround REF-2172.\n   729→\n   730→        This can move back into `compile_` when py39 support is dropped.\n   731→        \"\"\"\n   732→        # Add the @rx.page decorated pages to collect on_load events.\n   733→        for render, kwargs in DECORATED_PAGES:\n   734→            self.add_page(render, **kwargs)\n   735→\n   736→    def compile_(self):\n   737→        \"\"\"Compile the app and output it to the pages folder.\n   738→\n   739→        Raises:\n   740→            RuntimeError: When any page uses state, but no rx.State subclass is defined.\n   741→        \"\"\"\n   742→        # Render a default 404 page if the user didn't supply one\n   743→        if constants.Page404.SLUG not in self.pages:\n   744→            self.add_custom_404_page()\n   745→\n   746→        # Add the optional endpoints (_upload)\n   747→        self.add_optional_endpoints()\n   748→\n   749→        if not self._should_compile():\n   750→            return\n   751→\n   752→        self._setup_overlay_component()\n   753→\n   754→        # Create a progress bar.\n   755→        progress = Progress(\n   756→            *Progress.get_default_columns()[:-1],\n   757→            MofNCompleteColumn(),\n   758→            TimeElapsedColumn(),\n   759→        )\n   760→\n   761→        # try to be somewhat accurate - but still not 100%\n   762→        adhoc_steps_without_executor = 6\n   763→        fixed_pages_within_executor = 5\n   764→        progress.start()\n   765→        task = progress.add_task(\n   766→            \"Compiling:\",\n   767→            total=len(self.pages)\n   768→            + fixed_pages_within_executor\n   769→            + adhoc_steps_without_executor,\n   770→        )\n   771→\n   772→        # Get the env mode.\n   773→        config = get_config()\n   774→\n   775→        # Store the compile results.\n   776→        compile_results = []\n   777→\n   778→        # Add the app wrappers.\n   779→        app_wrappers: Dict[tuple[int, str], Component] = {\n   780→            # Default app wrap component renders {children}\n   781→            (0, \"AppWrap\"): AppWrap.create()\n   782→        }\n   783→        if self.theme is not None:\n   784→            # If a theme component was provided, wrap the app with it\n   785→            app_wrappers[(20, \"Theme\")] = self.theme\n   786→\n   787→        progress.advance(task)\n   788→\n   789→        # Fix up the style.\n   790→        self.style = evaluate_style_namespaces(self.style)\n   791→\n   792→        # Track imports and custom components found.\n   793→        all_imports = {}\n   794→        custom_components = set()\n   795→\n   796→        for _route, component in self.pages.items():\n   797→            # Merge the component style with the app style.\n   798→            component.add_style(self.style)\n   799→\n   800→            component.apply_theme(self.theme)\n   801→\n   802→            # Add component.get_imports() to all_imports.\n   803→            all_imports.update(component.get_imports())\n   804→\n   805→            # Add the app wrappers from this component.\n   806→            app_wrappers.update(component.get_app_wrap_components())\n   807→\n   808→            # Add the custom components from the page to the set.\n   809→            custom_components |= component.get_custom_components()\n   810→\n   811→        progress.advance(task)\n   812→\n   813→        # Perform auto-memoization of stateful components.\n   814→        (\n   815→            stateful_components_path,\n   816→            stateful_components_code,\n   817→            page_components,\n   818→        ) = compiler.compile_stateful_components(self.pages.values())\n   819→\n   820→        progress.advance(task)\n   821→\n   822→        # Catch \"static\" apps (that do not define a rx.State subclass) which are trying to access rx.State.\n   823→        if code_uses_state_contexts(stateful_components_code) and self.state is None:\n   824→            raise RuntimeError(\n   825→                \"To access rx.State in frontend components, at least one \"\n   826→                \"subclass of rx.State must be defined in the app.\"\n   827→            )\n   828→        compile_results.append((stateful_components_path, stateful_components_code))\n   829→\n   830→        # Compile the root document before fork.\n   831→        compile_results.append(\n   832→            compiler.compile_document_root(\n   833→                self.head_components,\n   834→                html_lang=self.html_lang,\n   835→                html_custom_attrs=self.html_custom_attrs,  # type: ignore\n   836→            )\n   837→        )\n   838→\n   839→        # Compile the contexts before fork.\n   840→        compile_results.append(\n   841→            compiler.compile_contexts(self.state, self.theme),\n   842→        )\n   843→\n   844→        app_root = self._app_root(app_wrappers=app_wrappers)\n   845→\n   846→        progress.advance