                        event = call_event_handler(v, args_spec)\n   409\u2192                    except ValueError as err:\n   410\u2192                        raise ValueError(\n   411\u2192                            f\" {err} defined in the `{type(self).__name__}` component\"\n   412\u2192                        ) from err\n   413\u2192\n   414\u2192                    # Add the event to the chain.\n   415\u2192                    events.append(event)\n   416\u2192                elif isinstance(v, EventSpec):\n   417\u2192                    # Add the event to the chain.\n   418\u2192                    events.append(v)\n   419\u2192                elif isinstance(v, Callable):\n   420\u2192                    # Call the lambda to get the event chain.\n   421\u2192                    events.extend(call_event_fn(v, args_spec))\n   422\u2192                else:\n   423\u2192                    raise ValueError(f\"Invalid event: {v}\")\n   424\u2192\n   425\u2192        # If the input is a callable, create an event chain.\n   426\u2192        elif isinstance(value, Callable):\n   427\u2192            events = call_event_fn(value, args_spec)\n   428\u2192\n   429\u2192        # Otherwise, raise an error.\n   430\u2192        else:\n   431\u2192            raise ValueError(f\"Invalid event chain: {value}\")\n   432\u2192\n   433\u2192        # Add args to the event specs if necessary.\n   434\u2192        events = [e.with_args(get_handler_args(e)) for e in events]\n   435\u2192\n   436\u2192        # Collect event_actions from each spec\n   437\u2192        event_actions = {}\n   438\u2192        for e in events:\n   439\u2192            event_actions.update(e.event_actions)\n   440\u2192\n   441\u2192        # Return the event chain.\n   442\u2192        if isinstance(args_spec, Var):\n   443\u2192            return EventChain(\n   444\u2192                events=events,\n   445\u2192                args_spec=None,\n   446\u2192                event_actions=event_