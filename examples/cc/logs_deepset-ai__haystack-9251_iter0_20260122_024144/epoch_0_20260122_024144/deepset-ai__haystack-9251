teps of {max_agent_steps}, stopping.\",\n   381→                    max_agent_steps=self.max_agent_steps,\n   382→                )\n   383→            span.set_content_tag(\"haystack.agent.output\", state.data)\n   384→            span.set_tag(\"haystack.agent.steps_taken\", counter)\n   385→        return state.data\n   386→\n   387→    def _check_exit_conditions(self, llm_messages: List[ChatMessage], tool_messages: List[ChatMessage]) -> bool:\n   388→        \"\"\"\n   389→        Check if any of the LLM messages' tool calls match an exit condition and if there are no errors.\n   390→\n   391→        :param llm_messages: List of messages from the LLM\n   392→        :param tool_messages: List of messages from the tool invoker\n   393→        :return: True if an exit condition is met and there are no errors, False otherwise\n   394→        \"\"\"\n   395→        matched_exit_conditions = set()\n   396→        has_errors = False\n   397→\n   398→        for msg in llm_messages:\n   399→            if msg.tool_call and msg.tool_call.tool_name in self.exit_conditions:\n   400→                matched_exit_conditions.add(msg.tool_call.tool_name)\n   401→\n   402→                # Check if any error is specifically from the tool matching the exit condition\n   403→                tool_errors = [\n   404→                    tool_msg.tool_call_result.error\n   405→                    for tool_msg in tool_messages\n   406→                    if tool_msg.tool_call_result is not None\n   407→                    and tool_msg.tool_call_result.origin.tool_name == msg.tool_call.tool_name\n   408→                ]\n   409→                if any(tool_errors):\n   410→                    has_errors = True\n   411→                    # No need to check further if we found an error\n   412→                    break\n   413→\n   414→        # Only return True if at least one exit condition was matched AND none had errors\n   415→        return bool(matched_exit_conditions) and not has