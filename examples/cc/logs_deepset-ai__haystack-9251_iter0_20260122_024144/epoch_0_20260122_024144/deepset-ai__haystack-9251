                        "content": "     1\u2192# SPDX-FileCopyrightText: 2022-present deepset GmbH <info@deepset.ai>\n     2\u2192#\n     3\u2192# SPDX-License-Identifier: Apache-2.0\n     4\u2192\n     5\u2192import json\n     6\u2192from dataclasses import asdict, dataclass, field\n     7\u2192from enum import Enum\n     8\u2192from typing import Any, Dict, List, Optional, Sequence, Union\n     9\u2192\n    10\u2192from haystack import logging\n    11\u2192\n    12\u2192logger = logging.getLogger(__name__)\n    13\u2192\n    14\u2192\n    15\u2192LEGACY_INIT_PARAMETERS = {\"role\", \"content\", \"meta\", \"name\"}\n    16\u2192\n    17\u2192\n    18\u2192class ChatRole(str, Enum):\n    19\u2192    \"\"\"\n    20\u2192    Enumeration representing the roles within a chat.\n    21\u2192    \"\"\"\n    22\u2192\n    23\u2192    #: The user role. A message from the user contains only text.\n    24\u2192    USER = \"user\"\n    25\u2192\n    26\u2192    #: The system role. A message from the system contains only text.\n    27\u2192    SYSTEM = \"system\"\n    28\u2192\n    29\u2192    #: The assistant role. A message from the assistant can contain text and Tool calls. It can also store metadata.\n    30\u2192    ASSISTANT = \"assistant\"\n    31\u2192\n    32\u2192    #: The tool role. A message from a tool contains the result of a Tool invocation.\n    33\u2192    TOOL = \"tool\"\n    34\u2192\n    35\u2192    @staticmethod\n    36\u2192    def from_str(string: str) -> \"ChatRole\":\n    37\u2192        \"\"\"\n    38\u2192        Convert a string to a ChatRole enum.\n    39\u2192        \"\"\"\n    40\u2192        enum_map = {e.value: e for e in ChatRole}\n    41\u2192        role = enum_map.get(string)\n    42\u2192        if role is None:\n    43\u2192            msg = f\"Unknown chat role '{string}'. Supported roles are: {list(enum_map.keys())}\"\n    44\u2192            raise ValueError(msg)\n    45\u2192        return role\n    46\u2192\n    47\u2192\n    48\u2192@dataclass\n    49\u2192class ToolCall:\n    50\u2192    \"\"\"\n    51\u2192    Represents a Tool call prepared by the model, usually contained in an assistant message.\n    52\u2192\n    53\u2192    :param id: The ID of the Tool call.\n    54\u2192    :param tool_name: The name of the Tool to call.\n    55\u2192    :param arguments: The arguments to call the Tool with.\n    56\u2192    \"\"\"\n    57\u2192\n    58\u2192    tool_name: str\n    59\u2192    arguments: Dict[str, Any]\n    60\u2192    id: Optional[str] = None  # noqa: A003\n    61\u2192\n    62\u2192\n    63\u2192@dataclass\n    64\u2192class ToolCallResult:\n    65\u2192    \"\"\"\n    66\u2192    Represents the result of a Tool invocation.\n    67\u2192\n    68\u2192    :param result: The result of the Tool invocation.\n    69\u2192    :param origin: The Tool call that produced this result.\n    70\u2192    :param error: Whether the Tool invocation resulted in an error.\n    71\u2192    \"\"\"\n    72\u2192\n    73\u2192    result: str\n    74\u2192    origin: ToolCall\n    75\u2192    error: bool\n    76\u2192\n    77\u2192\n    78\u2192@dataclass\n    79\u2192class TextContent:\n    80\u2192    \"\"\"\n    81\u2192    The textual content of a chat message.\n    82\u2192\n    83\u2192    :param text: The text content of the message.\n    84\u2192    \"\"\"\n    85\u2192\n    86\u2192    text: str\n    87\u2192\n    88\u2192\n    89\u2192ChatMessageContentT = Union[TextContent, ToolCall, ToolCallResult]\n    90\u2192\n    91\u2192\n    92\u2192def _deserialize_content(serialized_content: List[Dict[str, Any]]) -> List[ChatMessageContentT]:\n    93\u2192    \"\"\"\n    94\u2192    Deserialize the `content` field of a serialized ChatMessage.\n    95\u2192\n    96\u2192    :param serialized_content:\n    97\u2192        The `content` field of a serialized ChatMessage (a list of dictionaries).\n    98\u2192\n    99\u2192    :returns:\n   100\u2192        Deserialized `content` field as a list of `ChatMessageContentT` objects.\n   101\u2192    \"\"\"\n   102\u2192    content: List[ChatMessageContentT] = []\n   103\u2192\n   104\u2192    for part in serialized_content:\n   105\u2192        if \"text\" in part:\n   106\u2192            content.append(TextContent(text=part[\"text\"]))\n   107\u2192        elif \"tool_call\" in part:\n   108\u2192            content.append(ToolCall(**part[\"tool_call\"]))\n   109\u2192        elif \"tool_call_result\" in part:\n   110\u2192            result = part[\"tool_call_result\"][\"result\"]\n   111\u2192            origin = ToolCall(**part[\"tool_call_result\"][\"origin\"])\n   112\u2192            error = part[\"tool_call_result\"][\"error\"]\n   113\u2192            tcr = ToolCallResult(result=result, origin=origin, error=error)\n   114\u2192            content.append(tcr)\n   115\u2192        else:\n   116\u2192            raise ValueError(f\"Unsupported part in serialized ChatMessage: `{part}`\")\n   117\u2192\n   118\u2192    return content\n   119\u2192\n   120\u2192\n   121\u2192@dataclass\n   122\u2192class ChatMessage:\n   123\u2192    \"\"\"\n   124\u2192    Represents a message in a LLM chat conversation.\n   125\u2192\n   126\u2192    Use the `from_assistant`, `from_user`, `from_system`, and `from_tool` class methods to create a ChatMessage.\n   127\u2192    \"\"\"\n   128\u2192\n   129\u2192    _role: ChatRole\n   130\u2192    _content: Sequence[ChatMessageContentT]\n   131\u2192    _name: Optional[str] = None\n   132\u2192    _meta: Dict[str, Any] = field(default_factory=dict, hash=False)\n   133\u2192\n   134\u2192    def __new__(cls, *args, **kwargs):\n   135\u2192        \"\"\"\n   136\u2192        This method is reimplemented to make the changes to the `ChatMessage` dataclass more visible.\n   137\u2192        \"\"\"\n   138\u2192\n   139\u2192        general_msg = (\n   140\u2192            \"Use the `from_assistant`, `from_user`, `from_system`, and `from_tool` class methods to create a \"\n   141\u2192            \"ChatMessage. For more information about the new API and how to migrate, see the documentation:\"\n   142\u2192            \" https://docs.haystack.deepset.ai/docs/chatmessage\"\n   143\u2192        )\n   144\u2192\n   145\u2192        if any(param in kwargs for param in LEGACY_INIT_PARAMETERS):\n   146\u2192            raise TypeError(\n   147\u2192                \"The `role`, `content`, `meta`, and `name` init parameters of `ChatMessage` have been removed. \"\n   148\u2192                f\"{general_msg}\"\n   149\u2192            )\n   150\u2192\n   151\u2192        allowed_content_types = (TextContent, ToolCall, ToolCallResult)\n   152\u2192        if len(args) > 1 and not isinstance(args[1], allowed_content_types):\n   153\u2192            raise TypeError(\n   154\u2192                \"The `_content` parameter of `ChatMessage` must be one of the following types: \"\n   155\u2192                f\"{', '.join(t.__name__ for t in allowed_content_types)}. \"\n   156\u2192                f\"{general_msg}\"\n   157\u2192            )\n   158\u2192\n   159\u2192        return super(ChatMessage, cls).__new__(cls)\n   160\u2192\n   161\u2192    def __getattribute__(self, name):\n   162\u2192        \"\"\"\n   163\u2192        This method is reimplemented to make the `content` attribute removal more visible.\n   164\u2192        \"\"\"\n   165\u2192\n   166\u2192        if name == \"content\":\n   167\u2192            msg = (\n   168\u2192                \"The `content` attribute of `ChatMessage` has been removed. \"\n   169\u2192                \"Use the `text` property to access the textual value. \"\n   170\u2192                \"For more information about the new API and how to migrate, see the documentation: \"\n   171\u2192                \"https://docs.haystack.deepset.ai/docs/chatmessage\"\n   172\u2192            )\n   173\u2192            raise AttributeError(msg)\n   174\u2192        return object.__getattribute__(self, name)\n   175\u2192\n   176\u2192    def __len__(self):\n   177\u2192        return len(self._content)\n   178\u2192\n   179\u2192    @property\n   180\u2192    def role(self) -> ChatRole:\n   181\u2192        \"\"\"\n   182\u2192        Returns the role of the entity sending the message.\n   183\u2192        \"\"\"\n   184\u2192        return self._role\n   185\u2192\n   186\u2192    @property\n   187\u2192    def meta(self) -> Dict[str, Any]:\n   188\u2192        \"\"\"\n   189\u2192        Returns the metadata associated with the message.\n   190\u2192        \"\"\"\n   191\u2192        return self._meta\n   192\u2192\n   193\u2192    @property\n   194\u2192    def name(self) -> Optional[str]:\n   195\u2192        \"\"\"\n   196\u2192        Returns the name associated with the message.\n   197\u2192        \"\"\"\n   198\u2192        return self._name\n   199\u2192\n   200\u2192    @property\n   201\u2192    def texts(self) -> List[str]:\n   202\u2192        \"\"\"\n   203\u2192        Returns the list of all texts contained in the message.\n   204\u2192        \"\"\"\n   205\u2192        return [content.text for content in self._content if isinstance(content, TextContent)]\n   206\u2192\n   207\u2192    @property\n   208\u2192    def text(self) -> Optional[str]:\n   209\u2192        \"\"\"\n   210\u2192        Returns the first text contained in the message.\n   211\u2192        \"\"\"\n   212\u2192        if texts := self.texts:\n   213\u2192            return texts[0]\n   214\u2192        return None\n   215\u2192\n   216\u2192    @property\n   217\u2192    def tool_calls(self) -> List[ToolCall]:\n   218\u2192        \"\"\"\n   219\u2192        Returns the list of all Tool calls contained in the message.\n   220\u2192        \"\"\"\n   221\u2192        return [content for content in self._content if isinstance(content, ToolCall)]\n   222\u2192\n   223\u2192    @property\n   224\u2192    def tool_call(self) -> Optional[ToolCall]:\n   225\u2192        \"\"\"\n   226\u2192        Returns the first Tool call contained in the message.\n   227\u2192        \"\"\"\n   228\u2192        if tool_calls := self.tool_calls:\n   229\u2192            return tool_calls[0]\n   230\u2192        return None\n   231\u2192\n   232\u2192    @property\n   233\u2192    def tool_call_results(self) -> List[ToolCallResult]:\n   234\u2192        \"\"\"\n   235\u2192        Returns the list of all Tool call results contained in the message.\n   236\u2192        \"\"\"\n   237\u2192        return [content for content in self._content if isinstance(content, ToolCallResult)]\n   238\u2192\n   239\u2192    @property\n   240\u2192    def tool_call_result(self) -> Optional[ToolCallResult]:\n   241\u2192        \"\"\"\n   242\u2192        Returns the first Tool call result contained in the message.\n   243\u2192        \"\"\"\n   244\u2192        if tool_call_results := self.tool_call_results:\n   245\u2192            return tool_call_results[0]\n   246\u2192        return None\n   247\u2192\n   248\u2192    def is_from(self, role: Union[ChatRole, str]) -> bool:\n   249\u2192        \"\"\"\n   250\u2192        Check if the message is from a specific role.\n   251\u2192\n   252\u2192        :param role: The role to check against.\n   253\u2192        :returns: True if the message is from the specified role, False otherwise.\n   254\u2192        \"\"\"\n   255\u2192        if isinstance(role, str):\n   256\u2192            role = ChatRole.from_str(role)\n   257\u2192        return self._role == role\n   258\u2192\n   259\u2192    @classmethod\n   260\u2192    def from_user(cls, text: str, meta: Optional[Dict[str, Any]] = None, name: Optional[str] = None) -> \"ChatMessage\":\n   261\u2192        \"\"\"\n   262\u2192        Create a message from the user.\n   263\u2192\n   264\u2192        :param text: The text content of the message.\n   265\u2192        :param meta: Additional metadata associated with the message.\n   266\u2192        :param name: An optional name for the participant. This field is only supported by OpenAI.\n   267\u2192        :returns: A new ChatMessage instance.\n   268\u2192        \"\"\"\n   269\u2192        return cls(_role=ChatRole.USER, _content=[TextContent(text=text)], _meta=meta or {}, _name=name)\n   270\u2192\n   271\u2192    @classmethod\n   272\u2192    def from_system(cls, text: str, meta: Optional[Dict[str, Any]] = None, name: Optional[str] = None) -> \"ChatMessage\":\n   273\u2192        \"\"\"\n   274\u2192        Create a message from the system.\n   275\u2192\n   276\u2192        :param text: The text content of the message.\n   277\u2192        :param meta: Additional metadata associated with the message.\n   278\u2192        :param name: An optional name for the participant. This field is only supported by OpenAI.\n   279\u2192        :returns: A new ChatMessage instance.\n   280\u2192        \"\"\"\n   281\u2192        return cls(_role=ChatRole.SYSTEM, _content=[TextContent(text=text)], _meta=meta or {}, _name=name)\n   282\u2192\n   283\u2192    @classmethod\n   284\u2192    def from_assistant(\n   285\u2192        cls,\n   286\u2192        text: Optional[str] = None,\n   287\u2192        meta: Optional[Dict[str, Any]] = None,\n   288\u2192        name: Optional[str] = None,\n   289\u2192        tool_calls: Optional[List[ToolCall]] = None,\n   290\u2192    ) -> \"ChatMessage\":\n   291\u2192        \"\"\"\n   292\u2192        Create a message from the assistant.\n   293\u2192\n   294\u2192        :param text: The text content of the message.\n   295\u2192        :param meta: Additional metadata associated with the message.\n   296\u2192        :param tool_calls: The Tool calls to include in the message.\n   297\u2192        :param name: An optional name for the participant. This field is only supported by OpenAI.\n   298\u2192        :returns: A new ChatMessage instance.\n   299\u2192        \"\"\"\n   300\u2192        content: List[ChatMessageContentT] = []\n   301\u2192        if text is not None:\n   302\u2192            content.append(TextContent(text=text))\n   303\u2192        if tool_calls:\n   304\u2192            content.extend(tool_calls)\n   305\u2192\n   306\u2192        return cls(_role=ChatRole.ASSISTANT, _content=content, _meta=meta or {}, _name=name)\n   307\u2192\n   308\u2192    @classmethod\n   309\u2192    def from_tool(\n   310\u2192        cls, tool_result: str, origin: ToolCall, error: bool = False, meta: Optional[Dict[str, Any]] = None\n   311\u2192    ) -> \"ChatMessage\":\n   312\u2192        \"\"\"\n   313\u2192        Create a message from a Tool.\n   314\u2192\n   315\u2192        :param tool_result: The result of the Tool invocation.\n   316\u2192        :param origin: The Tool call that produced this result.\n   317\u2192        :param error: Whether the Tool invocation resulted in an error.\n   318\u2192        :param meta: Additional metadata associated with the message.\n   319\u2192        :returns: A new ChatMessage instance.\n   320\u2192        \"\"\"\n   321\u2192        return cls(\n   322\u2192            _role=ChatRole.TOOL,\n   323\u2192            _content=[ToolCallResult(result=tool_result, origin=origin, error=error)],\n   324\u2192            _meta=meta or {},\n   325\u2192        )\n   326\u2192\n   327\u2192    def to_dict(self) -> Dict[str, Any]:\n   328\u2192        \"\"\"\n   329\u2192        Converts ChatMessage into a dictionary.\n   330\u2192\n   331\u2192        :returns:\n   332\u2192            Serialized version of the object.\n   333\u2192        \"\"\"\n   334\u2192\n   335\u2192        serialized: Dict[str, Any] = {}\n   336\u2192        serialized[\"role\"] = self._role.value\n   337\u2192        serialized[\"meta\"] = self._meta\n   338\u2192        serialized[\"name\"] = self._name\n   339\u2192        content: List[Dict[str, Any]] = []\n   340\u2192        for part in self._content:\n   341\u2192            if isinstance(part, TextContent):\n   342\u2192                content.append({\"text\": part.text})\n   343\u2192            elif isinstance(part, ToolCall):\n   344\u2192                content.append({\"tool_call\": asdict(part)})\n   345\u2192            elif isinstance(part, ToolCallResult):\n   346\u2192                content.append({\"tool_call_result\": asdict(part)})\n   347\u2192            else:\n   348\u2192                raise TypeError(f\"Unsupported type in ChatMessage content: `{type(part).__name__}` for `{part}`.\")\n   349\u2192\n   350\u2192        serialized[\"content\"] = content\n   351\u2192        return serialized\n   352\u2192\n   353\u2192    @classmethod\n   354\u2192    def from_dict(cls, data: Dict[str, Any]) -> \"ChatMessage\":\n   355\u2192        \"\"\"\n   356\u2192        Creates a new ChatMessage object from a dictionary.\n   357\u2192\n   358\u2192        :param data:\n   359\u2192            The dictionary to build the ChatMessage object.\n   360\u2192        :returns:\n   361\u2192            The created object.\n   362\u2192        \"\"\"\n   363\u2192        if \"content\" in data:\n   364\u2192            init_params: Dict[str, Any] = {\n   365\u2192                \"_role\": ChatRole(data[\"role\"]),\n   366\u2192                \"_name\": data.get(\"name\"),\n   367\u2192                \"_meta\": data.get(\"meta\") or {},\n   368\u2192            }\n   369\u2192\n   370\u2192            if isinstance(data[\"content\"], list):\n   371\u2192                # current format - the serialized `content` field is a list of dictionaries\n   372\u2192                init_params[\"_content\"] = _deserialize_content(data[\"content\"])\n   373\u2192            elif isinstance(data[\"content\"], str):\n   374\u2192                # pre 2.9.0 format - the `content` field is a string\n   375\u2192                init_params[\"_content\"] = [TextContent(text=data[\"content\"])]\n   376\u2192            else:\n   377\u2192                raise TypeError(f\"Unsupported content type in serialized ChatMessage: `{(data['content'])}`\")\n   378\u2192            return cls(**init_params)\n   379\u2192\n   380\u2192        if \"_content\" in data:\n   381\u2192            # format for versions >=2.9.0 and <2.12.0 - the serialized `_content` field is a list of dictionaries\n   382\u2192            return cls(\n   383\u2192                _role=ChatRole(data[\"_role\"]),\n   384\u2192                _content=_deserialize_content(data[\"_content\"]),\n   385\u2192                _name=data.get(\"_name\"),\n   386\u2192                _meta=data.get(\"_meta\") or {},\n   387\u2192            )\n   388\u2192\n   389\u2192        raise ValueError(f\"Missing 'content' or '_content' in serialized ChatMessage: `{data}`\")\n   390\u2192\n   391\u2192    def to_openai_dict_format(self) -> Dict[str, Any]:\n   392\u2192        \"\"\"\n   393\u2192        Convert a ChatMessage to the dictionary format expected by OpenAI's Chat API.\n   394\u2192        \"\"\"\n   395\u2192        text_contents = self.texts\n   396\u2192        tool_calls = self.tool_calls\n   397\u2192        tool_call_results = self.tool_call_results\n   398\u2192\n   399\u2192        if not text_contents and not tool_calls and not tool_call_results:\n   400\u2192            raise ValueError(\n   401\u2192                \"A `ChatMessage` must contain at least one `TextContent`, `ToolCall`, or `ToolCallResult`.\"\n   402\u2192            )\n   403\u2192        if len(text_contents) + len(tool_call_results) > 1:\n   404\u2192            raise ValueError(\"A `ChatMessage` can only contain one `TextContent` or one `ToolCallResult`.\")\n   405\u2192\n   406\u2192        openai_msg: Dict[str, Any] = {\"role\": self._role.value}\n   407\u2192\n   408\u2192        # Add name field if present\n   409\u2192        if self._name is not None:\n   410\u2192            openai_msg[\"name\"] = self._name\n   411\u2192\n   412\u2192        if tool_call_results:\n   413\u2192            result = tool_call_results[0]\n   414\u2192            if result.origin.id i