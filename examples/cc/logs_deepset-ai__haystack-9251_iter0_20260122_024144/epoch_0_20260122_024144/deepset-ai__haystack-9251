              tool_messages = tool_invoker_result[\"tool_messages\"]\n   279→                state = tool_invoker_result[\"state\"]\n   280→                state.set(\"messages\", tool_messages)\n   281→\n   282→                # 4. Check if any LLM message's tool call name matches an exit condition\n   283→                if self.exit_conditions != [\"text\"] and self._check_exit_conditions(llm_messages, tool_messages):\n   284→                    counter += 1\n   285→                    break\n   286→\n   287→                # 5. Fetch the combined messages and send them back to the LLM\n   288→                messages = state.get(\"messages\")\n   289→                counter += 1\n   290→\n   291→            if counter >= self.max_agent_steps:\n   292→                logger.warning(\n   293→                    \"Agent reached maximum agent steps of {max_agent_steps}, stopping.\",\n   294→                    max_agent_steps=self.max_agent_steps,\n   295→                )\n   296→            span.set_content_tag(\"haystack.agent.output\", state.data)\n   297→            span.set_tag(\"haystack.agent.steps_taken\", counter)\n   298→        return state.data\n   299→\n   300→    async def run_async(\n   301→        self,\n   302→        messages: List[ChatMessage],\n   303→        streaming_callback: Optional[StreamingCallbackT] = None,\n   304→        **kwargs: Dict[str, Any],\n   305→    ) -> Dict[str, Any]:\n   306→        \"\"\"\n   307→        Asynchronously process messages and execute tools until the exit condition is met.\n   308→\n   309→        This is the asynchronous version of the `run` method. It follows the same logic but uses\n   310→        asynchronous operations where possible, such as calling the `run_async` method of the ChatGenerator\n   311→        if available.\n   312→\n   313→        :param messages: List of chat messages to process\n   314→        :param streaming_callback: A callback that will be invoked when a response is streamed from th