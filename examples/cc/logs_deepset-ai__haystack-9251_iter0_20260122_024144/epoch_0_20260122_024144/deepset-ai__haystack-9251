,\n    66→        exit_conditions: Optional[List[str]] = None,\n    67→        state_schema: Optional[Dict[str, Any]] = None,\n    68→        max_agent_steps: int = 100,\n    69→        raise_on_tool_invocation_failure: bool = False,\n    70→        streaming_callback: Optional[StreamingCallbackT] = None,\n    71→    ):\n    72→        \"\"\"\n    73→        Initialize the agent component.\n    74→\n    75→        :param chat_generator: An instance of the chat generator that your agent should use. It must support tools.\n    76→        :param tools: List of Tool objects or a Toolset that the agent can use.\n    77→        :param system_prompt: System prompt for the agent.\n    78→        :param exit_conditions: List of conditions that will cause the agent to return.\n    79→            Can include \"text\" if the agent should return when it generates a message without tool calls,\n    80→            or tool names that will cause the agent to return once the tool was executed. Defaults to [\"text\"].\n    81→        :param state_schema: The schema for the runtime state used by the tools.\n    82→        :param max_agent_steps: Maximum number of steps the agent will run before stopping. Defaults to 100.\n    83→            If the agent exceeds this number of steps, it will stop and return the current state.\n    84→        :param raise_on_tool_invocation_failure: Should the agent raise an exception when a tool invocation fails?\n    85→            If set to False, the exception will be turned into a chat message and passed to the LLM.\n    86→        :param streaming_callback: A callback that will be invoked when a response is streamed from the LLM.\n    87→        :raises TypeError: If the chat_generator does not support tools parameter in its run method.\n    88→        \"\"\"\n    89→        # Check if chat_generator supports tools parameter\n    90→        chat_generator_run_method = inspect.signature(chat_generator.run)\n    91→        if \"tools\" not in chat_generator_run_method.parameters:\n    92→            raise TypeError(\n    93→                f\"{type(chat_generator).__name__} does not accept tools parameter in its run method. \"\n    94→                \"The Agent component requires a chat generator that supports tools.\"\n    95→            )\n    96→\n    97→        valid_exits = [\"text\"] + [tool.name for tool in tools or []]\n    98→        if exit_conditions is None:\n    99→            exit_conditions = [\"text\"]\n   100→        if not all(condition in valid_exits for condition in exit_conditions):\n   101→            raise ValueError(\n   102→                f\"Invalid exit conditions provided: {exit_conditions}. \"\n   103→                f\"Valid exit conditions must be a subset of {valid_exits}. \"\n   104→                \"Ensure that each exit condition corresponds to either 'text' or a valid tool name.\"\n   105→            )\n   106→\n   107→        # Validate state schema if provided\n   108→        if state_schema is not None:\n   109→            _validate_schema(state_schema)\n   110→        self._state_schema = state_schema or {}\n   111→\n   112→        # Initialize state schema\n   113→        resolved_state_schema = deepcopy(self._state_schema)\n   114→        if resolved_state_schema.get(\"messages\") is None:\n   115→            resolved_state_schema[\"messages\"] = {\"type\": List[ChatMessage], \"handler\": merge_lists}\n   116→        self.state_schema = resolved_state_schema\n   117→\n   118→        self.chat_generator = chat_generator\n   119→        self.tools = tools or []\n   120→        self.system_prompt = system_prompt\n   121→        self.exit_conditions = exit_conditions\n   122→        self.max_agent_steps = max_agent_steps\n   123→        self.raise_on_tool_invocation_failure = raise_on_tool_invocation_failure\n   124→        self.streaming_callback = streaming_callback\n   125→\n   126→        output_types = {}\n   127→        for param, config in self.state_schema.items():