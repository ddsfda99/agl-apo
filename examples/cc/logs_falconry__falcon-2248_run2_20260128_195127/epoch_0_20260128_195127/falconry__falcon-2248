n   402\u2192        \"\"\"Convert headers into the format expected by ASGI servers.\n   403\u2192\n   404\u2192        Header names must be lowercased and both name and value must be\n   405\u2192        byte strings.\n   406\u2192\n   407\u2192        See also: https://asgi.readthedocs.io/en/latest/specs/www.html#response-start\n   408\u2192\n   409\u2192        Args:\n   410\u2192            media_type: Default media type to use for the Content-Type\n   411\u2192                header if the header was not set explicitly (default ``None``).\n   412\u2192\n   413\u2192        \"\"\"\n   414\u2192\n   415\u2192        headers = self._headers\n   416\u2192        # PERF(vytas): uglier inline version of Response._set_media_type\n   417\u2192        if media_type is not None and 'content-type' not in headers:\n   418\u2192            headers['content-type'] = media_type\n   419\u2192\n   420\u2192        try:\n   421\u2192            # NOTE(vytas): Supporting ISO-8859-1 for historical reasons as per\n   422\u2192            #   RFC 7230, Section 3.2.4; and to strive for maximum\n   423\u2192            #   compatibility with WSGI.\n   424\u2192\n   425\u2192            # PERF(vytas): On CPython, _encode_items_to_latin1 is implemented\n   426\u2192            #   in Cython (with a pure Python fallback), where the resulting\n   427\u2192            #   C code speeds up the method substantially by directly invoking\n   428\u2192            #   CPython's C API functions such as PyUnicode_EncodeLatin1.\n   429\u2192            items = _encode_items_to_latin1(headers)\n   430\u2192        except UnicodeEncodeError as ex:\n   431\u2192            # TODO(vytas): In 3.1.0, update this error message to highlight the\n   432\u2192            #   fact that we decided to allow ISO-8859-1?\n   433\u2192            raise ValueError(\n   434\u2192                'The modern series of HTTP standards require that header '\n   435\u2192                f'names and values use only ASCII characters: {ex}'\n   436\u2192            )\n   437\u2192\n   438\u2192        if self._extra_headers:\n   439\u2192            items += [\n   440\u2192                (n.encode('ascii'), v.encode('ascii')) for n, v in self._extra_headers\n   441\u2192            ]\n   442\u2192\n   443\u2192        # NOTE(kgriffs): It is important to append these after self._extra_headers\n   444\u2192        #   in case the latter contains Set-Cookie headers that should be\n   445\u2192        #   overridden by a call to unset_cookie().\n   446\u2192        if self._cookies is not None:\n   447\u2192            # PERF(tbug):\n   448\u2192            # The below implementation is ~23% faster than\n   449\u2192            # the alternative:\n   450\u2192            #\n   451\u2192            #     self._cookies.output().split(\"\\\\r\\\\n\")\n   452\u2192            #\n   453\u2192            # Even without the .split(\"\\\\r\\\\n\"), the below\n   454\u2192            # is still ~17% faster, so don't use .output()\n   455\u2192            items += [\n   456\u2192                (b'set-cookie', c.OutputString().encode('ascii'))\n   457\u2192                for c in self._cookies.values()\n   458\u2192            ]\n   459\u2192        return items\n   460\u2192\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"
