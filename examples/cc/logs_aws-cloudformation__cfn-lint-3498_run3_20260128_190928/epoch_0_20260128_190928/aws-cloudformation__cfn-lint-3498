k_implies(self, scenarios: dict[str, bool], implies: str) -> bool:\n   244→        \"\"\"Based on a bunch of scenario conditions and their Truth/False value\n   245→        determine if implies condition is True any time the scenarios are satisfied\n   246→        solver, solver_params = self._build_solver(list(scenarios.keys()) + [implies])\n   247→\n   248→        Args:\n   249→            scenarios (dict[str, bool]): A list of condition names\n   250→            and if they are True or False implies: the condition name that\n   251→            we are implying will also be True\n   252→\n   253→        Returns:\n   254→            bool: if the implied condition will be True if the scenario is True\n   255→        \"\"\"\n   256→        try:\n   257→            cnf = self._cnf.copy()\n   258→            # if the implies condition has to be false in the scenarios we\n   259→            # know it can never be true\n   260→            if not scenarios.get(implies, True):\n   261→                return False\n   262→\n   263→            conditions = []\n   264→            for condition_name, opt in scenarios.items():\n   265→                if opt:\n   266→                    conditions.append(\n   267→                        self._conditions[condition_name].build_true_cnf(\n   268→                            self._solver_params\n   269→                        )\n   270→                    )\n   271→                else:\n   272→                    conditions.append(\n   273→                        self._conditions[condition_name].build_false_cnf(\n   274→                            self._solver_params\n   275→                        )\n   276→                    )\n   277→\n   278→            implies_condition = self._conditions[implies].build_true_cnf(\n   279→                self._solver_params\n   280→            )\n   281→\n   282→            and_condition = And(*conditions)\n   283→            cnf.add_prop(and_condition)\n   284→\n   285→            # if the impl