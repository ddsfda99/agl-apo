omething)\n   556\u2192        component2.create(\n   557\u2192            on_open=[test_state.do_something_arg, test_state.do_something]\n   558\u2192        )\n   559\u2192    # However lambdas are okay.\n   560\u2192    component2.create(on_click=lambda: test_state.do_something_arg(1))\n   561\u2192    component2.create(\n   562\u2192        on_click=lambda: [test_state.do_something_arg(1), test_state.do_something]\n   563\u2192    )\n   564\u2192    component2.create(\n   565\u2192        on_click=lambda: [test_state.do_something_arg(1), test_state.do_something()]\n   566\u2192    )\n   567\u2192\n   568\u2192    # Controlled event handlers should take args.\n   569\u2192    # This is okay.\n   570\u2192    component2.create(on_open=test_state.do_something_arg)\n   571\u2192\n   572\u2192\n   573\u2192def test_get_hooks_nested(component1, component2, component3):\n   574\u2192    \"\"\"Test that a component returns hooks from child components.\n   575\u2192\n   576\u2192    Args:\n   577\u2192        component1: test component.\n   578\u2192        component2: another component.\n   579\u2192        component3: component with hooks defined.\n   580\u2192    \"\"\"\n   581\u2192    c = component1.create(\n   582\u2192        component2.create(arr=[]),\n   583\u2192        component3.create(),\n   584\u2192        component3.create(),\n   585\u2192        component3.create(),\n   586\u2192        text=\"a\",\n   587\u2192        number=1,\n   588\u2192    )\n   589\u2192    assert c._get_all_hooks() == component3()._get_all_hooks()\n   590\u2192\n   591\u2192\n   592\u2192def test_get_hooks_nested2(component3, component4):\n   593\u2192    \"\"\"Test that a component returns both when parent and child have hooks.\n   594\u2192\n   595\u2192    Args:\n   596\u2192        component3: component with hooks defined.\n   597\u2192        component4: component with different hooks defined.\n   598\u2192    \"\"\"\n   599\u2192    exp_hooks = {**component3()._get_all_hook