() == number\n   363→\n   364→\n   365→@pytest.mark.parametrize(\n   366→    \"text,number\", [(\"\", \"bad_string\"), (13, 1), (\"test\", [1, 2, 3])]\n   367→)\n   368→def test_invalid_prop_type(component1, text: str, number: int):\n   369→    \"\"\"Test that an invalid prop type raises an error.\n   370→\n   371→    Args:\n   372→        component1: A test component.\n   373→        text: A test string.\n   374→        number: A test number.\n   375→    \"\"\"\n   376→    # Check that\n   377→    with pytest.raises(TypeError):\n   378→        component1.create(text=text, number=number)\n   379→\n   380→\n   381→def test_var_props(component1, test_state):\n   382→    \"\"\"Test that we can set a Var prop.\n   383→\n   384→    Args:\n   385→        component1: A test component.\n   386→        test_state: A test state.\n   387→    \"\"\"\n   388→    c1 = component1.create(text=\"hello\", number=test_state.num)\n   389→    assert c1.number.equals(test_state.num)\n   390→\n   391→\n   392→def test_get_event_triggers(component1, component2):\n   393→    \"\"\"Test that we can get the triggers of a component.\n   394→\n   395→    Args:\n   396→        component1: A test component.\n   397→        component2: A test component.\n   398→    \"\"\"\n   399→    default_triggers = {\n   400→        EventTriggers.ON_FOCUS,\n   401→        EventTriggers.ON_BLUR,\n   402→        EventTriggers.ON_CLICK,\n   403→        EventTriggers.ON_CONTEXT_MENU,\n   404→        EventTriggers.ON_DOUBLE_CLICK,\n   405→        EventTriggers.ON_MOUSE_DOWN,\n   406→        EventTriggers.ON_MOUSE_ENTER,\n   407→        EventTriggers.ON_MOUSE_LEAVE,\n   408→        EventTriggers.ON_MOUSE_MOVE,\n   409→        EventTriggers.ON_MOUSE_OUT,\n   410→        EventTriggers.ON_MOUSE_OVER,\n   411→        EventTriggers.ON_MOUSE_UP,\n   412→        EventTriggers.ON_SCROLL,\n   413→        EventTriggers.ON_MOUNT,\n   414→        EventTriggers.ON_UNMOUNT,\n   415→    }\n   416→    assert set(component1().get_event_triggers().keys()) == default_triggers\n   417→    assert (\n   418→        component2().get_event_triggers().keys()\n   419→        == {\"on_open\", \"on_close\"} | default_triggers\n   420→    )\n   421→\n   422→\n   423→@pytest.fixture\n   424→def test_component() -> Type[Component]:\n   425→    \"\"\"A test component.\n   426→\n   427→    Returns:\n   428→        A test component.\n   429→    \"\"\"\n   430→\n   431→    class TestComponent(Component):\n   432→        pass\n   433→\n   434→    return TestComponent\n   435→\n   436→\n   437→# Write a test case to check if the create method filters out None props\n   438→def test_create_filters_none_props(test_component):\n   439→    child1 = test_component()\n   440→    child2 = test_component()\n   441→    props = {\n   442→        \"prop1\": \"value1\",\n   443→        \"prop2\": None,\n   444→        \"prop3\": \"value3\",\n   445→        \"prop4\": None,\n   446→        \"style\": {\"color\": \"white\", \"text-align\": \"center\"},  # Adding a style prop\n   447→    }\n   448→\n   449→    component = test_component.create(child1, child2, **props)\n   450→\n   451→    # Assert that None props are not present in the component's props\n   452→    assert \"prop2\" not in component.get_props()\n   453→    assert \"prop4\" not in component.get_props()\n   454→\n   455→    # Assert that the style prop is present in the component's props\n   456→    assert component.style[\"color\"] == \"white\"\n   457→    assert component.style[\"text-align\"] == \"center\"\n   458→\n   459→\n   460→class C1State(BaseState):\n   461→    \"\"\"State for testing C1 component.\"\"\"\n   462→\n   463→    def mock_handler(self, _e, _bravo, _charlie):\n   464→        \"\"\"Mock handler.\"\"\"\n   465→        pass\n   466→\n   467→\n   468→def test_component_event_trigger_arbitrary_args():\n   469→    \"\"\"Test that we can define arbitrary types for the args of an event trigger.\"\"\"\n   470→\n   471→    class Obj(Base):\n   472→        custom: int = 0\n   473→\n   474→    def on_foo_spec(_e, alpha: str, bravo: Dict[str, Any], charlie: Obj):\n   475→        return [_e.target.value, bravo[\"nested\"], charlie.custom + 42]\n   476→\n   477→    class C1(Component):\n   478→        library = \"/local\"\n   479→        tag = \"C1\"\n   480→\n   481→        def get_event_triggers(self) -> Dict[str, Any]:\n   482→            return {\n   483→                **super().get_event_triggers(),\n   484→                \"on_foo\": on_foo_spec,\n   485→            }\n   486→\n   487→    comp = C1.create(on_foo=C1State.mock_handler)\n   488→\n   489→    assert comp.render()[\"props\"][0] == (\n   490→        \"onFoo={(__e,_alpha,_bravo,_charlie) => addEvents(\"\n   491→        '[Event(\"c1_state.mock_handler\", {_e:__e.target.value,_bravo:_bravo[\"nested\"],_charlie:((_charlie.custom) + (42))})], '\n   492→        \"(__e,_alpha,_bravo,_charlie), {})}\"\n   493→    )\n   494→\n   495→\n   496→def test_create_custom_component(my_component):\n   497→    \"\"\"Test that we can create a custom component.\n   498→\n   499→    Args:\n   500→        my_component: A test custom component.\n   501→    \"\"\"\n   502→    component = CustomComponent(component_fn=my_component, prop1=\"test\", prop2=1)\n   503→    assert component.tag == \"MyComponent\"\n   504→    assert component.get_props() == set()\n   505→    assert component._get_all_custom_components() == {component}\n   506→\n   507→\n   508→def test_custom_component_hash(my_component):\n   509→    \"\"\"Test that the hash of a custom component is correct.\n   510→\n   511→    Args:\n   512→        my_component: A test custom component.\n   513→    \"\"\"\n   514→    component1 = CustomComponent(component_fn=my_component, prop1=\"test\", prop2=1)\n   515→    component2 = CustomComponent(component_fn=my_component, prop1=\"test\", prop2=2)\n   516→    assert {component1, component2} == {component1}\n   517→\n   518→\n   519→def test_custom_component_wrapper():\n   520→    \"\"\"Test that the wrapper of a custom component is correct.\"\"\"\n   521→\n   522→    @custom_component\n   523→    def my_component(width: Var[int], color: Var[str]):\n   524→        return rx.box(\n   525→            width=width,\n   526→            color=color,\n   527→        )\n   528→\n   529→    from reflex.components.radix.themes.typography.text import Text\n   530→\n   531→    ccomponent = my_component(\n   532→        rx.text(\"child\"), width=Var.create(1), color=Var.create(\"red\")\n   533→    )\n   534→    assert isinstance(ccomponent, CustomComponent)\n   535→    assert len(ccomponent.children) == 1\n   536→    assert isinstance(ccomponent.children[0], Text)\n   537→\n   538→    component = ccomponent.get_component(ccomponent)\n   539→    assert isinstance(component, Box)\n   540→\n   541→\n   542→def test_invalid_event_handler_args(component2, test_state):\n   543→    \"\"\"Test that an invalid event handler raises an error.\n   544→\n   545→    Args:\n   546→        component2: A test component.\n   547→        test_state: A test state.\n   548→    \"\"\"\n   549→    # Uncontrolled event handlers should not take args.\n   550→    # This is okay.\n   551→    component2.create(on_click=test_state.do_something)\n   552→    # This is not okay.\n   553→    with pytest.raises(ValueError):\n   554→        component2.create(on_click=test_state.do_something_arg)\n   555→        component2.create(on_open=test_state.do_something)\n   556→        component2.create(\n   557→            on_open=[test_state.do_something_arg, test_state.do_something]\n   558→        )\n   559→    # However lambdas are okay.\n   560→    component2.create(on_click=lambda: test_state.do_something_arg(1))\n   561→    component2.create(\n   562→        on_click=lambda: [test_state.do_something_arg(1), test_state.do_something]\n   563→    )\n   564→    component2.create(\n   565→        on_click=lambda: [test_state.do_something_arg(1), test_state.do_something()]\n   566→    )\n   567→\n   568→    # Controlled event handlers should take args.\n   569→    # This is okay.\n   570→    component2.create(on_open=test_state.do_something_arg)\n   571→\n   572→\n   573→def test_get_hooks_nested(component1, component2, component3):\n   574→    \"\"\"Test that a component returns hooks from child components.\n   575→\n   576→    Args:\n   577→        component1: test component.\n   578→        component2: another component.\n   579→        component3: component with hooks defined.\n   580→    \"\"\"\n   581→    c = component1.create(\n   582→        component2.create(arr=[]),\n   583→        component3.create(),\n   584→        component3.create(),\n   585→        component3.create(),\n   586→        text=\"a\",\n   587→        number=1,\n   588→    )\n   589→    assert c._get_all_hooks() == component3()._get_all_hooks()\n   590→\n   591→\n   592→def test_get_hooks_nested2(component3, component4):\n   593→    \"\"\"Test that a component returns both when parent and child have hooks.\n   594→\n   595→    Args:\n   596→        component3: component with hooks defined.\n   597→        component4: component with different hooks defined.\n   598→    \"\"\"\n   599→    exp_hooks = {**component3()._get_all_hooks(), **component4()._get_all_hooks()}\n   600→    assert component3.create(component4.create())._get_all_hooks() == exp_hooks\n   601→    assert component4.create(component3.create())._get_all_hooks() == exp_hooks\n   602→    assert (\n   603→        component4.create(\n   604→            component3.create(),\n   605→            component4.create(),\n   606→            component3.create(),\n   607→        )._get_all_hooks()\n   608→        == exp_hooks\n   609→    )\n   610→\n   611→\n   612→@pytest.mark.parametrize(\"fixture\", [\"component5\", \"component6\"])\n   613→def test_unsupported_child_components(fixture, request):\n   614→    \"\"\"Test that a value error is raised when an unsupported component (a child component found in the\n   615→    component's invalid children list) is provided as a child.\n   616→\n   617→    Args:\n   618→        fixture: the test component as a fixture.\n   619→        request: Pytest request.\n   620→    \"\"\"\n   621→    component = request.getfixturevalue(fixture)\n   622→    with pytest.raises(ValueError) as err:\n   623→        comp = component.create(rx.text(\"testing component\"))\n   624→        comp.render()\n   625→    assert (\n   626→        err.value.args[0]\n   627→        == f\"The component `{component.__name__}` cannot have `Text` as a child component\"\n   628→    )\n   629→\n   630→\n   631→def test_unsupported_parent_components(component5):\n   632→    \"\"\"Test that a value error is raised when an component is not in _valid_parents of one of its children.\n   633→\n   634→    Args:\n   635→        component5: component with valid parent of \"Text\" only\n   636→    \"\"\"\n   637→    with pytest.raises(ValueError) as err:\n   638→        rx.box(component5.create())\n   639→    assert (\n   640→        err.value.args[0]\n   641→        == f\"The component `{component5.__name__}` can only be a child of the components: `{component5._valid_parents[0]}`. Got `Box` instead.\"\n   642→    )\n   643→\n   644→\n   645→@pytest.mark.parametrize(\"fixture\", [\"component5\", \"component7\"])\n   646→def test_component_with_only_valid_children(fixture, request):\n   647→    \"\"\"Test that a value error is raised when an unsupported component (a child component not found in the\n   648→    component's valid children list) is provided as a child.\n   649→\n   650→    Args:\n   651→        fixture: the test component as a fixture.\n   652→        request: Pytest request.\n   653→    \"\"\"\n   654→    component = request.getfixturevalue(fixture)\n   655→    with pytest.raises(ValueError) as err:\n   656→        comp = component.create(rx.box(\"testing component\"))\n   657→        comp.render()\n   658→    assert (\n   659→        err.value.args[0]\n   660→        == f\"The component `{component.__name__}` only allows the components: `Text` as children. \"\n   661→        f\"Got `Box` instead.\"\n   662→    )\n   663→\n   664→\n   665→@pytest.mark.parametrize(\n   666→    \"component,rendered\",\n   667→    [\n   668→        (rx.text(\"hi\"), \"<RadixThemesText as={`p`}>\\n  {`hi`}\\n</RadixThemesText>\"),\n   669→        (\n   670→            rx.box(rx.chakra.heading(\"test\", size=\"md\")),\n   671→            \"<RadixThemesBox>\\n  <Heading size={`md`}>\\n  {`test`}\\n</Heading>\\n</RadixThemesBox>\",\n   672→        ),\n   673→    ],\n   674→)\n   675→def test_format_component(component, rendered):\n   676→    \"\"\"Test that a component is formatted correctly.\n   677→\n   678→    Args:\n   679→        component: The component to format.\n   680→        rendered: The expected rendered component.\n   681→    \"\"\"\n   682→    assert str(component) == rendered\n   683→\n   684→\n   685→def test_stateful_component(test_state):\n   686→    \"\"\"Test that a stateful component is created correctly.\n   687→\n   688→    Args:\n   689→        test_state: A test state.\n   690→    \"\"\"\n   691→    text_component = rx.text(test_state.num)\n   692→    stateful_component = StatefulComponent.compile_from(text_component)\n   693→    assert isinstance(stateful_component, StatefulComponent)\n   694→    assert stateful_component.tag is not None\n   695→    assert stateful_component.tag.startswith(\"Text_\")\n   696→    assert stateful_component.references == 1\n   697→    sc2 = StatefulComponent.compile_from(rx.text(test_state.num))\n   698→    assert isinstance(sc2, StatefulComponent)\n   699→    assert stateful_component.references == 2\n   700→    assert sc2.references == 2\n   701→\n   702→\n   703→def test_stateful_component_memoize_event_trigger(test_state):\n   704→    \"\"\"Test that a stateful component is created correctly with events.\n   705→\n   706→    Args:\n   707→        test_state: A test state.\n   708→    \"\"\"\n   7