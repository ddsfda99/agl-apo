e: Any = None\n   185→\n   186→    # Special component props.\n   187→    special_props: Set[Var] = set()\n   188→\n   189→    # Whether the component should take the focus once the page is loaded\n   190→    autofocus: bool = False\n   191→\n   192→    # components that cannot be children\n   193→    _invalid_children: List[str] = []\n   194→\n   195→    # only components that are allowed as children\n   196→    _valid_children: List[str] = []\n   197→\n   198→    # only components that are allowed as parent\n   199→    _valid_parents: List[str] = []\n   200→\n   201→    # props to change the name of\n   202→    _rename_props: Dict[str, str] = {}\n   203→\n   204→    # custom attribute\n   205→    custom_attrs: Dict[str, Union[Var, str]] = {}\n   206→\n   207→    # When to memoize this component and its children.\n   208→    _memoization_mode: MemoizationMode = MemoizationMode()\n   209→\n   210→    # State class associated with this component instance\n   211→    State: Optional[Type[reflex.state.State]] = None\n   212→\n   213→    @classmethod\n   214→    def __init_subclass__(cls, **kwargs):\n   215→        \"\"\"Set default properties.\n   216→\n   217→        Args:\n   218→            **kwargs: The kwargs to pass to the superclass.\n   219→        \"\"\"\n   220→        super().__init_subclass__(**kwargs)\n   221→\n   222→        # Get all the props for the component.\n   223→        props = cls.get_props()\n   224→\n   225→        # Convert fields to props, setting default values.\n   226→        for field in cls.get_fields().values():\n   227→            # If the field is not a component prop, skip it.\n   228→            if field.name not in props:\n   229→                continue\n   230→\n   231→            # Set default values for any props.\n   232→            if types._issubclass(field.type_, Var):\n   233→                field.required = False\n   234→                field.default = Var.create(field.default)\n   235→            elif types._issubclass(field.type_, EventHandler):\n   236→                field.required = False\n   237→\n   238→        # Ensure renamed props from parent classes are applied to the subclass.\n   239→        if cls._rename_props:\n   240→            inherited_rename_props = {}\n   241→            for parent in reversed(cls.mro()):\n   242→                if issubclass(parent, Component) and parent._rename_props:\n   243→                    inherited_rename_props.update(parent._rename_props)\n   244→            cls._rename_props = inherited_rename_props\n   245→\n   246→    def __init__(self, *args, **kwargs):\n   247→        \"\"\"Initialize the component.\n   248→\n   249→        Args:\n   250→            *args: Args to initialize the component.\n   251→            **kwargs: Kwargs to initialize the component.\n   252→\n   253→        Raises:\n   254→            TypeError: If an invalid prop is passed.\n   255→        \"\"\"\n   256→        # Set the id and children initially.\n   257→        children = kwargs.get(\"children\", [])\n   258→        initial_kwargs = {\n   259→            \"id\": kwargs.get(\"id\"),\n   260→            \"children\": children,\n   261→            **{\n   262→                prop: Var.create(kwargs[prop])\n   263→                for prop in self.get_initial_props()\n   264→                if prop in kwargs\n   265→            },\n   266→        }\n   267→        super().__init__(**initial_kwargs)\n   268→\n   269→        self._validate_component_children(children)\n   270→\n   271→        # Get the component fields, triggers, and props.\n   272→        fields = self.get_fields()\n   273→        component_specific_triggers = self.get_event_triggers()\n   274→        triggers = component_specific_triggers.keys()\n   275→        props = self.get_props()\n   276→\n   277→        # Add any events triggers.\n   278→        if \"event_triggers\" not in kwargs:\n   279→            kwargs[\"event_triggers\"] = {}\n   280→        kwargs[\"event_triggers\"] = kwargs[\"event_triggers\"].copy()\n   281→\n   282→        # Iterate through the kwargs and set the props.\n   283→        for key, value in kwargs.items():\n   284→            if key in triggers:\n   285→                # Event triggers are bound to event chains.\n   286→                field_type = EventChain\n   287→            elif key in props:\n   288→                # Set the field type.\n   289→                field_type = fields[key].type_\n   290→\n   291→            else:\n   292→                continue\n   293→\n   294→            # Check whether the key is a component prop.\n   295→            if types._issubclass(field_type, Var):\n   296→                try:\n   297→                    # Try to create a var from the value.\n   298→                    kwargs[key] = Var.create(value)\n   299→\n   300→                    # Check that the var type is not None.\n   301→                    if kwargs[key] is None:\n   302→                        raise TypeError\n   303→\n   304→                    expected_type = fields[key].outer_type_.__args__[0]\n   305→                    # validate literal fields.\n   306→                    types.validate_literal(\n   307→                        key, value, expected_type, type(self).__name__\n   308→                    )\n   309→                    # Get the passed type and the var type.\n   310→                    passed_type = kwargs[key]._var_type\n   311→                    expected_type = (\n   312→                        type(expected_type.__args__[0])\n   313→                        if types.is_literal(expected_type)\n   314→                        else expected_type\n   315→                    )\n   316→                except TypeError:\n   317→                    # If it is not a valid var, check the base types.\n   318→                    passed_type = type(value)\n   319→                    expected_type = fields[key].outer_type_\n   320→                if not types._issubclass(passed_type, expected_type):\n   321→                    value_name = value._var_name if isinstance(value, Var) else value\n   322→                    raise TypeError(\n   323→                        f\"Invalid var passed for prop {key}, expected type {expected_type}, got value {value_name} of type {passed_type}.\"\n   324→                    )\n   325→\n   326→            # Check if the key is an event trigger.\n   327→            if key in triggers:\n   328→                # Temporarily disable full control for event triggers.\n   329→                kwargs[\"event_triggers\"][key] = self._create_event_chain(\n   330→                    value=value, args_spec=component_specific_triggers[key]\n   331→                )\n   332→\n   333→        # Remove any keys that were added as events.\n   334→        for key in kwargs[\"event_triggers\"]:\n   335→            del kwargs[key]\n   336→\n   337→        # Add style props to the component.\n   338→        style = kwargs.get(\"style\", {})\n   339→        if isinstance(style, List):\n   340→            # Merge styles, the later ones overriding keys in the earlier ones.\n   341→            style = {k: v for style_dict in style for k, v in style_dict.items()}\n   342→\n   343→        kwargs[\"style\"] = Style(\n   344→            {\n   345→                **self.get_fields()[\"style\"].default,\n   346→                **style,\n   347→                **{attr: value for attr, value in kwargs.items() if attr not in fields},\n   348→            }\n   349→        )\n   350→        if \"custom_attrs\" not in kwargs:\n   351→            kwargs[\"custom_attrs\"] = {}\n   352→\n   353→        # Convert class_name to str if it's list\n   354→        class_name = kwargs.get(\"class_name\", \"\")\n   355→        if isinstance(class_name, (List, tuple)):\n   356→            kwargs[\"class_name\"] = \" \".join(class_name)\n   357→\n   358→        # Construct the component.\n   359→        super().__init__(*args, **kwargs)\n   360→\n   361→    def _create_event_chain(\n   362→        self,\n   363→        args_spec: Any,\n   364→        value: Union[\n   365→            Var, EventHandler, EventSpec, List[Union[EventHandler, EventSpec]], Callable\n   366→        ],\n   367→    ) -> Union[EventChain, Var]:\n   368→        \"\"\"Create an event chain from a variety of input types.\n   369→\n   370→        Args:\n   371→            args_spec: The args_spec of the the event trigger being bound.\n   372→            value: The value to create the event chain from.\n   373→\n   374→        Returns:\n   375→            The event chain.\n   376→\n   377→        Raises:\n   378→            ValueError: If the value is not a valid event chain.\n   379→        \"\"\"\n   380→        # If it's an event chain var, return it.\n   381→        if isinstance(value, Var):\n   382→            if value._var_type is not EventChain:\n   383→                raise ValueError(f\"Invalid event chain: {value}\")\n   384→            return value\n   385→        elif isinstance(value, EventChain):\n   386→            # Trust that the caller knows what they're doing passing an EventChain directly\n   387→            return value\n   388→\n   389→        # If the input is a single event handler, wrap it in a list.\n   390→        if isinstance(value, (EventHandler, EventSpec)):\n   391→            value = [value]\n   392→\n   393→        # If the input is a list of event handlers, create an event chain.\n   394→        if isinstance(value, List):\n   395→            events: list[EventSpec] = []\n   396→            for v in value:\n   397→                if isinstance(v, EventHandler):\n   398→                    # Call the event handler to get the event.\n   399→                    try:\n   400→                        event = call_event_handler(v, args_spec)\n   401→                    except ValueError as err:\n   402→                        raise ValueError(\n   403→                            f\" {err} defined in the `{type(self).__name__}` component\"\n   404→                        ) from err\n   405→\n   406→                    # Add the event to the chain.\n   407→                    events.append(event)\n   408→                elif isinstance(v, EventSpec):\n   409→                    # Add the event to the chain.\n   410→                    events.append(v)\n   411→                elif isinstance(v, Callable):\n   412→                    # Call the lambda to get the event chain.\n   413→                    events.extend(call_event_fn(v, args_spec))\n   414→                else:\n   415→                    raise ValueError(f\"Invalid event: {v}\")\n   416→\n   417→        # If the input is a callable, create an event chain.\n   418→        elif isinstance(value, Callable):\n   419→            events = call_event_fn(value, args_spec)\n   420→\n   421→        # Otherwise, raise an error.\n   422→        else:\n   423→            raise ValueError(f\"Invalid event chain: {value}\")\n   424→\n   425→        # Add args to the event specs if necessary.\n   426→        events = [e.with_args(get_handler_args(e)) for e in events]\n   427→\n   428→        # Collect event_actions from each spec\n   429→        event_actions = {}\n   430→        for e in events:\n   431→            event_actions.update(e.event_actions)\n   432→\n   433→        # Return the event chain.\n   434→        if isinstance(args_spec, Var):\n   435→            return EventChain(\n   436→                events=events,\n   437→                args_spec=None,\n   438→                event_actions=event_actions,\n   439→            )\n   440→        else:\n   441→            return EventChain(\n   442→                events=events,\n   443→                args_spec=args_spec,\n   444→                event_actions=event_actions,\n   445→            )\n   446→\n   447→    def get_event_triggers(self) -> Dict[str, Any]:\n   448→        \"\"\"Get the event triggers for the component.\n   449→\n   450→        Returns:\n   451→            The event triggers.\n   452→        \"\"\"\n   453→        default_triggers = {\n   454→            EventTriggers.ON_FOCUS: lambda: [],\n   455→            EventTriggers.ON_BLUR: lambda: [],\n   456→            EventTriggers.ON_CLICK: lambda: [],\n   457→            EventTriggers.ON_CONTEXT_MENU: lambda: [],\n   458→            EventTriggers.ON_DOUBLE_CLICK: lambda: [],\n   459→            EventTriggers.ON_MOUSE_DOWN: lambda: [],\n   460→            EventTriggers.ON_MOUSE_ENTER: lambda: [],\n   461→            EventTriggers.ON_MOUSE_LEAVE: lambda: [],\n   462→            EventTriggers.ON_MOUSE_MOVE: lambda: [],\n   463→            EventTriggers.ON_MOUSE_OUT: lambda: [],\n   464→            EventTriggers.ON_MOUSE_OVER: lambda: [],\n   465→            EventTriggers.ON_MOUSE_UP: lambda: [],\n   466→            EventTriggers.ON_SCROLL: lambda: [],\n   467→            EventTriggers.ON_MOUNT: lambda: [],\n   468→            EventTriggers.ON_UNMOUNT: lambda: [],\n   469→        }\n   470→        # Look for component specific triggers,\n   471→        # e.g. variable declared as EventHandler types.\n   472→        for field in self.get_fields().values():\n   473→            if types._issubclass(field.type_, EventHandler):\n   474→                default_triggers[field.name] = getattr(\n   475→                    field.type_, \"args_spec\", lambda: []\n   476→                )\n   477→        return default_triggers\n   478→\n   479→    def __repr__(self) -> str:\n   480→        \"\"\"Represent the component in React.\n   481→\n   482→        Returns:\n   483→            The code to render the component.\n   484→        \"\"\"\n   485→        return format.json_dumps(self.render())\n   486→\n   487→    def __str__(self) -> str:\n   488→        \"\"\"Represent the component in React.\n   489→\n   490→        Returns:\n   491→            The code to render the component.\n   492→        \"\"\"\n   493→        from reflex.compiler.compiler import _compile_component\n   494→\n   495→        return _compile_component(self)\n   496→\n   497→    def _apply_theme(self, theme: Optional[Component]):\n   498→        \"\"\"Apply the theme to this component.\n   499→\n   500→        Args:\n   501→            theme: The theme to apply.\n   502→        \"\"\"\n   503→        pass\n   504→\n   505→    def apply_theme(self, theme: Optional[Component]):\n   506→        \"\"\"Apply a theme to the component and its children.\n   507→\n   508→        Args:\n   509→            theme: The theme to apply.\n   510→        \"\"\"\n   511→        self._apply_theme(theme)\n   512→        for child in self.children:\n   513→            if isinstance(child, Component):\n   514→                child.apply_theme(theme)\n   515→\n   516→    def _exclude_props(self) -> list[str]:\n   517→        \"\"\"Props to exclude when adding the component props to the Tag.\n   518→\n   519→        Returns:\n   520→            A list of component props to exclude.\n   521→        \"\"\"\n   522→        return []\n   523→\n   524→    def _render(self, props: dict[str, Any] | None = None) -> Tag:\n   525→        \"\"\"Define how to render the component in React.\n   526→\n   527→        Args:\n   528→            props: The props to render (if None, then use get_props).\n   529→\n   530→        Returns:\n   531→            The tag to render.\n   532→        \"\"\"\n   533→        # Create the base tag.\n   534→        tag = Tag(\n   535→            name=self.tag if not self.alias else self.alias,\n   536→            special_props=self.special_props,\n   537→        )\n   538→\n   539→        if props is None:\n   540→            # Add component props to the tag.\n   541→            props = {\n   542→                attr[:-1] if attr.endswith(\"_\") else attr: getattr(self, attr)\n   543→                for attr in self.get_props()\n   544→            }\n   545→\n   546→            # Add ref to element if `id` is not None.\n   547→            ref = self.get_ref()\n   548→            if ref is not None:\n   549→                props[\"ref\"] = Var.create(ref, _var_is_local=False)\n   550→        else:\n   551→            props = props.copy()\n   552→\n   553→        props.update(\n   554→            **{\n   555→                trigger: handler\n   556→                for trigger, handler in self.event_triggers.items()\n   557→                if trigger not in {EventTriggers.ON_MOUNT, EventTriggers.ON_UNMOUNT}\n   558→            },\n   559→            key=self.key,\n   560→            id=self.id,\n   561→            class_name=self.class_name,\n   562→        )\n   563→        props.update(self._get_style())\n   564→        props.update(self.custom_attrs)\n   565→\n   566→        # remove excluded props from prop dict before adding to tag.\n   567→        for prop_to_exclude in self._exclude_props():\n   568→            props.pop(prop_to_exclude, None)\n   569→\n   570→        return tag.add_props(**props)\n   571→\n   572→    @classmethod\n   573→    @lru_cache(maxsize=None)\n   574→    def get_props(cls) -> Set[str]:\n   575→        \"\"\"Get the unique fields for the component.\n   576→\n   577→        Returns:\n   578→            The unique fields.\n   579→        \"\"\"\n   580→        return set(cls.get_fields()) - set(Component.get_fields())\n   581→\n   582→    @classmethod\n   583→    @lru_cache(maxsize=None)\n   584→    def get_initial_props(cls) -> Set[str]:\n   585→        \"\"\"Get the initial props to set for the component.\n   586→\n   587→        Returns:\n   588→            The initial props to set.\n   589→        \"\"\"\n   590→        return set()\n   591→\n   592→    @classmethod\n   593→    @lru_cache(maxsize=None)\n   594→    def get_component_props(cls) -> set[str]:\n   595→        \"\"\"Get the props that expected a component as value.\n   596→\n   597→        Returns:\n   598→            The components props.\n   599→        \"\"\"\n   600→        return {\n   601→            name\n   602→            for name, field in cls.get_fields().items()\n   603→            if name in cls.get_props()\n   604→            and types._issubclass(field.outer_type_, Component)\n   605→        }\n   606→\n   607→    @classmethod\n   608→    def create(cls, *children, **props) -> Component:\n   609→        \"\"\"Create the component.\n   610→\n   611→        Args:\n   612→            *children: The children of the component.\n   613→            **props: The props of the component.\n   614→\n   615→        Returns:\n   616→            The component.\n   617→\n   618→        Raises:\n   619→            TypeError: If an invalid child is passed.\n   620→        \"\"\"\n   621→        # Import here to avoid circular imports.\n   622→        from reflex.components.base.bare import Bare\n   623→\n   624→        # Translate deprecated props to new names.\n   625→        new_prop_names = [\n   626→            prop for prop in cls.get_props() if prop in [\"type\", \"min\", \"max\"]\n   627→        ]\n   628→        for prop in new_prop_names:\n   629→            under_prop = f\"{prop}_\"\n   630→            if under_prop in props:\n   631→                console.deprecate(\n   632→                    f\"Underscore suffix for prop `{under_prop}`\",\n   633→                    reason=f\"for consistency. Use `{prop}` instead.\",\n   634→                    deprecation_version=\"0.4.0\",\n   635→                    removal_version=\"0.5.0\",\n   636→                    dedupe=False,\n   637→                )\n   638→                props[prop] = props.pop(under_prop)\n   639→\n   640→        # Filter out None props\n   641→        props = {key: value for key, value in props.items() if value is not None}\n   642→\n   643→        # Validate all the children.\n   644→        for child in children:\n   645→            # Make sure the child is a valid type.\n   646→            if not types._isinstance(child, ComponentChild):\n   647→                raise TypeError(\n   648→                    \"Children of Reflex components must be other componen