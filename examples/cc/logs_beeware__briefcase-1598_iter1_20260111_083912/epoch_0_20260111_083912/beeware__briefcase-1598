e a manpage source file `{app.app_name}.1`\"\n   750→                )\n   751→\n   752→        self.logger.info(\"Update file permissions...\")\n   753→        with self.input.wait_bar(\"Updating file permissions...\"):\n   754→            for path in self.project_path(app).glob(\"**/*\"):\n   755→                old_perms = self.tools.os.stat(path).st_mode & 0o777\n   756→                user_perms = old_perms & 0o700\n   757→                world_perms = old_perms & 0o007\n   758→\n   759→                # File permissions like 775 and 664 (where the group and user\n   760→                # permissions are the same), cause Debian heartburn. So, make\n   761→                # sure the group and world permissions are the same\n   762→                new_perms = user_perms | (world_perms << 3) | world_perms\n   763→\n   764→                # If there's been any change in permissions, apply them\n   765→                if new_perms != old_perms:  # pragma: no-cover-if-is-windows\n   766→                    self.logger.info(\n   767→                        \"Updating file permissions on \"\n   768→                        f\"{path.relative_to(self.bundle_path(app))} \"\n   769→                        f\"from {oct(old_perms)[2:]} to {oct(new_perms)[2:]}\"\n   770→                    )\n   771→                    path.chmod(new_perms)\n   772→\n   773→        with self.input.wait_bar(\"Stripping binary...\"):\n   774→            self.tools.subprocess.check_output([\"strip\", self.binary_path(app)])\n   775→\n   776→\n   777→class LinuxSystemRunCommand(LinuxSystemPassiveMixin, RunCommand):\n   778→    description = \"Run a Linux system project.\"\n   779→    supported_host_os = {\"Linux\"}\n   780→    supported_host_os_reason = \"Linux system projects can only be executed on Linux.\"\n   781→\n   782→    def run_app(\n   783→        self, app: AppConfig, test_mode: bool, passthrough: List[str], **kwargs\n   784→    ):\n   785→        \"\"\"Start the application.\n   786→\