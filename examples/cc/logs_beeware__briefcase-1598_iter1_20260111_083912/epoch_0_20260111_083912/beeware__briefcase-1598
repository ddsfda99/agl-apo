ue)\n   987→\n   988→        # Add runtime package dependencies. App config has been finalized,\n   989→        # so this will be the target-specific definition, if one exists.\n   990→        system_runtime_requires = [\n   991→            \"python3\",\n   992→        ] + getattr(app, \"system_runtime_requires\", [])\n   993→\n   994→        # Write the spec file\n   995→        with self.input.wait_bar(\"Write RPM spec file...\"):\n   996→            with (rpmbuild_path / \"SPECS\" / f\"{app.app_name}.spec\").open(\n   997→                \"w\", encoding=\"utf-8\"\n   998→            ) as f:\n   999→                f.write(\n  1000→                    \"\\n\".join(\n  1001→                        [\n  1002→                            # By default, rpmbuild thinks all .py files are executable,\n  1003→                            # and if a .py doesn't have a shebang line, it will\n  1004→                            # tell you that it will remove the executable bit -\n  1005→                            # even if the executable bit isn't set.\n  1006→                            # We disable the processor that does this.\n  1007→                            \"%global __brp_mangle_shebangs %{nil}\",\n  1008→                            # rpmbuild tries to strip binaries, which messes with\n  1009→                            # binary wheels. Disable these checks.\n  1010→                            \"%global __brp_strip %{nil}\",\n  1011→                            \"%global __brp_strip_static_archive %{nil}\",\n  1012→                            \"%global __brp_strip_comment_note %{nil}\",\n  1013→                            # Disable RPATH checking, because check-rpaths can't deal with\n  1014→                            # the structure of manylinux wheels\n  1015→                            \"%global __brp_check_rpaths %{nil}\",\n  1016→                            # Disable all the auto-detection that tries to magically\n  1017→                            # determine r