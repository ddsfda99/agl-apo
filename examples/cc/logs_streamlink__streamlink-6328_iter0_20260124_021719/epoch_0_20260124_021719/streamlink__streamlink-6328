video-2799000-0.mp4?z32=CENSORED_SESSION\"\n   472→\n   473→            video_segments = [x.uri for x in itertools.islice(segments, 3)]\n   474→            assert video_segments == [\n   475→                \"http://test.se/video-time=0-2799000-0.m4s?z32=CENSORED_SESSION\",\n   476→                \"http://test.se/video-time=4000-2799000-0.m4s?z32=CENSORED_SESSION\",\n   477→                \"http://test.se/video-time=8000-2799000-0.m4s?z32=CENSORED_SESSION\",\n   478→            ]\n   479→\n   480→    def test_bitrate_rounded(self):\n   481→        def mock_rep(bandwidth):\n   482→            node = Mock(\n   483→                tag=\"Representation\",\n   484→                attrib={\n   485→                    \"id\": \"test\",\n   486→                    \"bandwidth\": bandwidth,\n   487→                    \"mimeType\": \"video/mp4\",\n   488→                },\n   489→            )\n   490→            node.findall.return_value = []\n   491→\n   492→            root = Mock()\n   493→            root.parent = None\n   494→            period = Mock()\n   495→            period.parent = root\n   496→            aset = Mock()\n   497→            aset.parent = period\n   498→\n   499→            return Representation(node, root=root, parent=aset, period=period)\n   500→\n   501→        assert mock_rep(1.2 * 1000.0).bandwidth_rounded == pytest.approx(1.2)\n   502→        assert mock_rep(45.6 * 1000.0).bandwidth_rounded == pytest.approx(46.0)\n   503→        assert mock_rep(134.0 * 1000.0).bandwidth_rounded == pytest.approx(130.0)\n   504→        assert mock_rep(1324.0 * 1000.0).bandwidth_rounded == pytest.approx(1300.0)\n   505→\n   506→    def test_duplicated_resolutions(self):\n   507→        \"\"\"\n   508→        Verify the fix for https://github.com/streamlink/streamlink/issues/3365\n   509→        \"\"\"\n   510→        with xml(\"dash/test_10.mpd\") as mpd_xml:\n   511→            mpd = MPD(mpd_xml, base_url=\"http://test.se/\", url=\"http://test.se/manifest.mpd\")\n   512→\n   513→            representations_0 = mpd.periods[0].adaptationSets[0].representations[0]\n   514→            assert representations_0.height == 804\n   515→            assert representations_0.bandwidth == pytest.approx(10000.0)\n   516→            representations_1 = mpd.periods[0].adaptationSets[0].representations[1]\n   517→            assert representations_1.height == 804\n   518→            assert representations_1.bandwidth == pytest.approx(8000.0)\n   519→\n   520→    def test_segments_static_periods_duration(self):\n   521→        \"\"\"\n   522→        Verify the fix for https://github.com/streamlink/streamlink/issues/2873\n   523→        \"\"\"\n   524→        with xml(\"dash/test_11_static.mpd\") as mpd_xml:\n   525→            mpd = MPD(mpd_xml, base_url=\"http://test.se/\", url=\"http://test.se/manifest.mpd\")\n   526→            duration = mpd.periods[0].duration.total_seconds()\n   527→            assert duration == pytest.approx(204.32)\n   528→\n   529→    def test_segments_byterange(self):\n   530→        with xml(\"dash/test_segments_byterange.mpd\") as mpd_xml:\n   531→            mpd = MPD(mpd_xml, base_url=\"http://test/\", url=\"http://test/manifest.mpd\")\n   532→\n   533→        segment_urls = [\n   534→            [(seg.uri, seg.init, seg.byterange) for seg in adaptationset.representations[0].segments()]\n   535→            for adaptationset in mpd.periods[0].adaptationSets\n   536→        ]  # fmt: skip\n   537→\n   538→        assert segment_urls == [\n   539→            [\n   540→                (\"http://test/video-frag.mp4\", True, (36, 711)),\n   541→                (\"http://test/video-frag.mp4\", False, (747, 875371)),\n   542→                (\"http://test/video-frag.mp4\", False, (876118, 590796)),\n   543→                (\"http://test/video-frag.mp4\", False, (1466914, 487041)),\n   544→                (\"http://test/video-frag.mp4\", False, (1953955, 40698)),\n   545→            ],\n   546→            [\n   5