   url = urlunsplit(parts)\n   407→            return urljoin(url, other)\n   408→        else:\n   409→            return other\n   410→\n   411→\n   412→class Location(MPDNode):\n   413→    __tag__ = \"Location\"\n   414→\n   415→\n   416→class Period(MPDNode):\n   417→    __tag__ = \"Period\"\n   418→\n   419→    def __init__(self, *args, **kwargs) -> None:\n   420→        super().__init__(*args, **kwargs)\n   421→\n   422→        self.i = kwargs.get(\"i\", 0)\n   423→        self.id = self.attr(\"id\")\n   424→        self.bitstreamSwitching = self.attr(\n   425→            \"bitstreamSwitching\",\n   426→            parser=MPDParsers.bool_str,\n   427→        )\n   428→        self.duration = self.attr(\n   429→            \"duration\",\n   430→            parser=MPDParsers.duration(self.root.publishTime),\n   431→            default=timedelta(),\n   432→        )\n   433→        self.start = self.attr(\n   434→            \"start\",\n   435→            parser=MPDParsers.duration(self.root.publishTime),\n   436→            default=timedelta(),\n   437→        )\n   438→\n   439→        # anchor time for segment availability\n   440→        offset = self.start if self.root.type == \"dynamic\" else timedelta()\n   441→        self.availabilityStartTime = self.root.availabilityStartTime + offset\n   442→\n   443→        # TODO: Early Access Periods\n   444→\n   445→        self.baseURLs = self.children(BaseURL)\n   446→        self.segmentBase = self.only_child(SegmentBase, period=self)\n   447→        self.segmentList = self.only_child(SegmentList, period=self)\n   448→        self.segmentTemplate = self.only_child(SegmentTemplate, period=self)\n   449→        self.adaptationSets = self.children(AdaptationSet, minimum=1)\n   450→        self.assetIdentifier = self.only_child(AssetIdentifier)\n   451→        self.eventStream = self.children(EventStream)\n   452→        self.subset = self.children(Subset)\n   453→\n   454→\n   455→class AssetIdentifier(MPDNode):\n 