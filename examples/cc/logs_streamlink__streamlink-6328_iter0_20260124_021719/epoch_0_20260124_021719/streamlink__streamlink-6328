lization.source_url),\n   739→                num=-1,\n   740→                duration=0.0,\n   741→                available_at=self.period.availabilityStartTime,\n   742→                init=True,\n   743→                content=False,\n   744→                byterange=self.initialization.range,\n   745→            )\n   746→        for num, segment_url in self.segment_urls(ident, init):\n   747→            yield DASHSegment(\n   748→                uri=self.make_url(segment_url.media),\n   749→                num=num,\n   750→                duration=self.duration_seconds,\n   751→                available_at=self.period.availabilityStartTime,\n   752→                init=False,\n   753→                content=True,\n   754→                byterange=segment_url.media_range,\n   755→            )\n   756→\n   757→    def segment_urls(self, ident: TTimelineIdent, init: bool) -> Iterator[tuple[int, SegmentURL]]:\n   758→        if init:\n   759→            if self.root.type == \"static\":\n   760→                # yield all segments in a static manifest\n   761→                start_number = self.startNumber\n   762→                segment_urls = self.segmentURLs\n   763→            else:\n   764→                # yield a specific number of segments from the live-edge of dynamic manifests\n   765→                start_number = self.calculate_optimal_start()\n   766→                segment_urls = self.segmentURLs[start_number - self.startNumber :]\n   767→\n   768→        else:\n   769→            # skip segments with a lower number than the remembered segment number\n   770→            # and check if we've skipped any segments after reloading the manifest\n   771→            start_number = self.root.timelines[ident]\n   772→            offset = start_number - self.startNumber\n   773→\n   774→            if offset >= 0:\n   775→                # no segments were skipped: yield a slice of the segments\n   776→                segment_urls = self.segmentURLs[offset:]\n   777→            else:\n   778→                # segments were skipped: yield all segments and set the correct segment number\n   779→                log.warning(\n   780→                    (\n   781→                        f\"Skipped segments {start_number}-{self.startNumber - 1} after manifest reload. \"\n   782→                        if offset < -1\n   783→                        else f\"Skipped segment {start_number} after manifest reload. \"\n   784→                    )\n   785→                    + \"This is unsupported and will result in incoherent output data.\",\n   786→                )\n   787→                start_number = self.startNumber\n   788→                segment_urls = self.segmentURLs\n   789→\n   790→        # remember the next segment number\n   791→        self.root.timelines[ident] = start_number + len(segment_urls)\n   792→\n   793→        yield from enumerate(segment_urls, start_number)\n   794→\n   795→    def calculate_optimal_start(self) -> int:\n   796→        \"\"\"Calculate the optimal segment number to start based on the suggestedPresentationDelay\"\"\"\n   797→        suggested_delay = self.root.suggestedPresentationDelay\n   798→\n   799→        if self.duration_seconds == 0.0:\n   800→            log.info(f\"Unknown segment duration. Falling back to an offset of {MPD.DEFAULT_LIVE_EDGE_SEGMENTS} segments.\")\n   801→            offset = MPD.DEFAULT_LIVE_EDGE_SEGMENTS\n   802→        else:\n   803→            offset = max(0, math.ceil(suggested_delay.total_seconds() / self.duration_seconds))\n   804→\n   805→        start = self.startNumber + len(self.segmentURLs) - offset\n   806→        log.debug(f\"Calculated optimal offset is {offset} segments. First segment is {start}.\")\n   807→\n   808→        return start\n   809→\n   810→    def make_url(self, url: str | None) -> str:\n   811→        return BaseURL.join(self.base_url, url) if url else self.base_url\n   812→\n   813→\n   814→class SegmentTemplate(_MultipleSegmentBase