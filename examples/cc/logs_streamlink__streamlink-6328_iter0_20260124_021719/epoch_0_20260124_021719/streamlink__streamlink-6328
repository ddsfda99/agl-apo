G\", \"streamlink.stream.dash\")\n   317→\n   318→        # init manifest\n   319→        with xml(\"dash/test_dynamic_segment_list_p1.mpd\") as mpd_xml:\n   320→            mpd = MPD(mpd_xml, base_url=\"http://test/\", url=\"http://test/manifest.mpd\")\n   321→        segments_iterator = mpd.periods[0].adaptationSets[0].representations[0].segments(init=True)\n   322→\n   323→        assert [(segment.uri, segment.num) for segment in segments_iterator] == [\n   324→            (\"http://test/init.m4s\", -1),\n   325→            (\"http://test/13.m4s\", 13),\n   326→            (\"http://test/14.m4s\", 14),\n   327→            (\"http://test/15.m4s\", 15),\n   328→        ], \"Queues the init segment and the correct number of segments from the live-edge\"\n   329→        assert mpd.timelines[\"0\", \"0\", \"0\"] == 16, \"Remembers the next segment number\"\n   330→        assert [(record.name, record.levelname, record.message) for record in caplog.records] == []\n   331→\n   332→        # regular continuation\n   333→        with xml(\"dash/test_dynamic_segment_list_p2.mpd\") as mpd_xml:\n   334→            mpd = MPD(mpd_xml, base_url=\"http://test/\", url=\"http://test/manifest.mpd\", timelines=mpd.timelines)\n   335→        segments_iterator = mpd.periods[0].adaptationSets[0].representations[0].segments(init=False)\n   336→\n   337→        assert [(segment.uri, segment.num) for segment in segments_iterator] == [\n   338→            (\"http://test/16.m4s\", 16),\n   339→            (\"http://test/17.m4s\", 17),\n   340→            (\"http://test/18.m4s\", 18),\n   341→        ], \"All segments from the remembered segment number were queued\"\n   342→        assert mpd.timelines[\"0\", \"0\", \"0\"] == 19, \"Remembers the next segment number\"\n   343→        assert [(record.name, record.levelname, record.message) for record in caplog.records] == []\n   344→\n   345→        # regular continuation with a different offset\n   346→        with xml(\"dash/test_dynamic_seg