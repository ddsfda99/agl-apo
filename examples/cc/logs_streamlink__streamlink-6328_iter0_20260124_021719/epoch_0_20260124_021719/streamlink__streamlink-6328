ueued\"\n   378→        assert mpd.timelines[\"0\", \"0\", \"0\"] == 40, \"Remembers the next segment number\"\n   379→        assert [(record.name, record.levelname, record.message) for record in caplog.records] == [\n   380→            (\n   381→                \"streamlink.stream.dash.manifest\",\n   382→                \"warning\",\n   383→                \"Skipped segments 25-29 after manifest reload. This is unsupported and will result in incoherent output data.\",\n   384→            ),\n   385→        ]\n   386→\n   387→        caplog.records.clear()\n   388→\n   389→        # skipped single segment\n   390→        with xml(\"dash/test_dynamic_segment_list_p5.mpd\") as mpd_xml:\n   391→            mpd = MPD(mpd_xml, base_url=\"http://test/\", url=\"http://test/manifest.mpd\", timelines=mpd.timelines)\n   392→        segments_iterator = mpd.periods[0].adaptationSets[0].representations[0].segments(init=False)\n   393→\n   394→        assert [(segment.uri, segment.num) for segment in segments_iterator] == [\n   395→            (\"http://test/41.m4s\", 41),\n   396→            (\"http://test/42.m4s\", 42),\n   397→            (\"http://test/43.m4s\", 43),\n   398→            (\"http://test/44.m4s\", 44),\n   399→            (\"http://test/45.m4s\", 45),\n   400→            (\"http://test/46.m4s\", 46),\n   401→            (\"http://test/47.m4s\", 47),\n   402→            (\"http://test/48.m4s\", 48),\n   403→            (\"http://test/49.m4s\", 49),\n   404→            (\"http://test/50.m4s\", 50),\n   405→        ], \"All segments from the remembered segment number were queued\"\n   406→        assert mpd.timelines[\"0\", \"0\", \"0\"] == 51, \"Remembers the next segment number\"\n   407→        assert [(record.name, record.levelname, record.message) for record in caplog.records] == [\n   408→            (\n   409→                \"streamlink.stream.dash.manifest\",\n   410→                \"warning\",\n   411→                \"Skipped segment 40 after manifest reload. This is unsupported and will result in incoherent output data.\",\n   412→            ),\n   413→        ]\n   414→\n   415→    def test_dynamic_segment_list_no_duration(self):\n   416→        with xml(\"dash/test_dynamic_segment_list_no_duration.mpd\") as mpd_xml:\n   417→            mpd = MPD(mpd_xml, base_url=\"http://test/\", url=\"http://test/manifest.mpd\")\n   418→\n   419→        segments_iterator = mpd.periods[0].adaptationSets[0].representations[0].segments(init=True)\n   420→        assert [segment.uri for segment in segments_iterator] == [\n   421→            \"http://test/init.m4s\",\n   422→            \"http://test/13.m4s\",\n   423→            \"http://test/14.m4s\",\n   424→            \"http://test/15.m4s\",\n   425→        ]\n   426→\n   427→    def test_dynamic_timeline_continued(self):\n   428→        with xml(\"dash/test_dynamic_timeline_continued_p1.mpd\") as mpd_xml_p1:\n   429→            mpd_p1 = MPD(mpd_xml_p1, base_url=\"http://test/\", url=\"http://test/manifest.mpd\")\n   430→            iter_segment_p1 = mpd_p1.periods[0].adaptationSets[0].representations[0].segments()\n   431→            segments_p1 = [\n   432→                (segment.uri, segment.num, segment.duration, segment.available_at)\n   433→                for segment in itertools.islice(iter_segment_p1, 100)\n   434→            ]  # fmt: skip\n   435→\n   436→        assert segments_p1 == [\n   437→            (\"http://test/video/init.mp4\", -1, 0.0, datetime.datetime(2018, 1, 1, 1, 0, 0, tzinfo=UTC)),\n   438→            (\"http://test/video/1006000.mp4\", 7, 1.0, datetime.datetime(2018, 1, 1, 12, 59, 56, tzinfo=UTC)),\n   439→            (\"http://test/video/1007000.mp4\", 8, 1.0, datetime.datetime(2018, 1, 1, 12, 59, 57, tzinfo=UTC)),\n   440→            (\"http://test/video/1008000.mp4\", 9, 1.0, datetime.datetime(2018, 1, 1, 12, 59, 58, tzinfo=UTC)),\n   441→            (\"http://test/video/1009000.mp4\", 10, 1.0, datetime.datetime(2018, 1, 1, 12, 59, 59, tzi