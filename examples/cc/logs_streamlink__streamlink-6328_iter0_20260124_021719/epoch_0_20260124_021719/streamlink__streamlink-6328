  36\u2192    @pytest.mark.parametrize(\n    37\u2192        (\"available_at\", \"expected\"),\n    38\u2192        [\n    39\u2192            (datetime.datetime(2000, 1, 2, 3, 4, 5, 123456, tzinfo=UTC), 1 * 86400 + 3 * 3600 + 4 * 60 + 5 + 0.123456),\n    40\u2192            (datetime.datetime(2000, 1, 1, 0, 0, 0, 0, tzinfo=UTC), 0.0),\n    41\u2192            (datetime.datetime(1999, 12, 31, 23, 59, 59, 999999, tzinfo=UTC), 0.0),\n    42\u2192        ],\n    43\u2192    )\n    44\u2192    def test_available_in(self, available_at: datetime.datetime, expected: float):\n    45\u2192        segment = DASHSegment(\n    46\u2192            uri=\"foo\",\n    47\u2192            num=-1,\n    48\u2192            duration=0.0,\n    49\u2192            available_at=available_at,\n    50\u2192        )\n    51\u2192        with freeze_time(\"2000-01-01T00:00:00Z\"):\n    52\u2192            assert segment.available_in == pytest.approx(expected)\n    53\u2192\n    54\u2192    def test_availability(self):\n    55\u2192        segment = DASHSegment(\n    56\u2192            uri=\"foo\",\n    57\u2192            num=-1,\n    58\u2192            duration=0.0,\n    59\u2192            available_at=datetime.datetime(2000, 1, 2, 3, 4, 5, 123456, tzinfo=UTC),\n    60\u2192        )\n    61\u2192        with freeze_time(\"2000-01-01T00:00:00Z\"):\n    62\u2192            assert segment.availability == \"2000-01-02T03:04:05.123456Z / 2000-01-01T00:00:00.000000Z\"\n    63\u2192\n    64\u2192\n    65\u2192class TestMPDParsers:\n    66\u2192    def test_bool_str(self):\n    67\u2192        assert MPDParsers.bool_str(\"true\")\n    68\u2192        assert MPDParsers.bool_str(\"TRUE\")\n    69\u2192        assert MPDParsers.bool_str(\"True\")\n    70\u2192\n    71\u2192        assert not MPDParsers.bool_str(\"0\")\n    72\u2192        assert not MPDParsers.bool_str(\"False\")\n    73\u2192        assert not MPDParsers.bool_str(\"false\")\n    74\u2192        assert not MPDParsers.bool_str(\"FALSE\")\n    75\u2192\n    76\u2192    def test_type(self):\n    77\u2192        assert MPDParsers.type(\"dynamic\") == \"dynamic\"\n    78\u2192        assert MPDParsers.type(\"static\") == \"static\"\n    79\u2192        with pytest.raises(MPDParsingError):\n    80\u2192            # noinspection PyTypeChecker\n    81\u2192            MPDParsers.type(\"other\")\n    82\u2192\n    83\u2192    def test_duration(self):\n    84\u2192        assert MPDParsers.duration()(\"PT1S\") == datetime.timedelta(seconds=1)\n    85\u2192        assert MPDParsers.duration()(\"P1W\") == datetime.timedelta(seconds=7 * 24 * 3600)\n    86\u2192\n    87\u2192        assert MPDParsers.duration(EPOCH_START)(\"P3M\") == datetime.timedelta(days=31 + 28 + 31)\n    88\u2192        assert MPDParsers.duration(EPOCH_START + datetime.timedelta(31))(\"P3M\") == datetime.timedelta(days=28 + 31 + 30)\n    89\u2192\n    90\u2192        assert MPDParsers.duration(EPOCH_START)(\"P3Y\") == datetime.timedelta(days=3 * 365 + 1)\n    91\u2192        assert MPDParsers.duration(EPOCH_START + datetime.timedelta(3 * 365))(\"P3Y\") == datetime.timedelta(days=3 * 365)\n    92\u2192\n    93\u2192        with freeze_time(EPOCH_START):\n    94\u2192            assert MPDParsers.duration()(\"P3M\") == datetime.timedelta(days=31 + 28 + 31)\n    95\u2192            assert MPDParsers.duration()(\"P3Y\") == datetime.timedelta(days=3 * 365 + 1)\n    96\u2192\n    97\u2192    def test_datetime(self):\n    98\u2192        assert MPDParsers.datetime(\"2018-01-01T00:00:00Z\") == datetime.datetime(2018, 1, 1, 0, 0, 0, tzinfo=UTC)\n    99\u2192\n   100\u2192    def test_segment_template(self):\n   101\u2192        assert MPDParsers.segment_template(\"$Time$-$Number$-$Other$\")(Time=1, Number=2, Other=3) == \"1-2-3\"\n   102\u2192        assert MPDParsers.segment_template(\"$Number%05d$\")(Number=123) == \"00123\"\n   103\u2192        assert MPDParsers.segment_template(\"$Time%0.02f$\")(Time=100.234) == \"100.23\"\n   104\u2192\n   105\u2192    def test_frame_rate(self):\n   106\u2192        assert MPDParsers.frame_rate(\"1/25\") == pytest.approx(1.0 / 25.0)\n   107\u2192        assert MPDParsers.frame_rate(\"0.2\") == pytest.approx(0.2)\n   108\u2192\n   109\u2192    def test_timedelta(self):\n   110\u2192        assert MPDParsers.timedelta(1)(100) == datetime.timedelta(0, 100.0)\n   111\u2192        assert MPDParsers.timedelta(10)(100) == datetime.timedelta(0, 10.0)\n   112\u2192\n   113\u2192    def test_range(self):\n   114\u2192        assert MPDParsers.range(\"100-\") == (100, None)\n   115\u2192        assert MPDParsers.range(\"100-199\") == (100, 100)\n   116\u2192        with pytest.raises(MPDParsingError):\n   117\u2192            MPDParsers.range(\"100\")\n   118\u2192\n   119\u2192\n   120\u2192class TestMPDParser:\n   121\u2192    @pytest.mark.parametrize(\n   122\u2192        (\"min_buffer_time\", \"expected\"),\n   123\u2192        [\n   124\u2192            pytest.param(\"PT1S\", 3.0, id=\"minBufferTime lower than suggestedPresentationDelay\"),\n   125\u2192            pytest.param(\"PT5S\", 5.0, id=\"minBufferTime greater than suggestedPresentationDelay\"),\n   126\u2192        ],\n   127\u2192    )\n   128\u2192    def test_suggested_presentation_delay(self, min_buffer_time: str, expected: float):\n   129\u2192        with xml(\"dash/test_suggested_presentation_delay.mpd\") as mpd_xml:\n   130\u2192            mpd_xml.attrib[\"minBufferTime\"] = min_buffer_time\n   131\u2192            mpd = MPD(mpd_xml, base_url=\"http://test/\", url=\"http://test/manifest.mpd\")\n   132\u2192        assert mpd.suggestedPresentationDelay.total_seconds() == expected\n   133\u2192\n   134\u2192    def test_no_segment_list_or_template(self):\n   135\u2192        with xml(\"dash/test_no_segment_list_or_template.mpd\") as mpd_xml:\n   136\u2192            mpd = MPD(mpd_xml, base_url=\"http://test/\", url=\"http://test/manifest.mpd\")\n   137\u2192            segments = [\n   138\u2192                {\n   139\u2192                    \"ident\": representation.ident,\n   140\u2192                    \"mimeType\": representation.mimeType,\n   141\u2192                    \"segments\": [\n   142\u2192                        (segment.uri, segment.num, segment.duration, segment.available_at, segment.init, segment.content)\n   143\u2192                        for segment in itertools.islice(representation.segments(), 100)\n   144\u2192                    ],\n   145\u2192                }\n   146\u2192                for adaptationset in mpd.periods[0].adaptationSets\n   147\u2192                for representation in adaptationset.representations\n   148\u2192                if representation.id in (\"1\", \"5\", \"6\")\n   149\u2192            ]\n   150\u2192        availability = datetime.datetime(1970, 1, 1, 0, 0, 0, tzinfo=UTC)\n   151\u2192\n   152\u2192        assert segments == [\n   153\u2192            {\n   154\u2192                \"ident\": (None, None, \"1\"),\n   155\u2192                \"mimeType\": \"audio/mp4\",\n   156\u2192                \"segments\": [(\"http://cdn1.example.com/7657412348.mp4\", -1, 3256.0, availability, True, True)],\n   157\u2192            },\n   158\u2192            {\n   159\u2192                \"ident\": (None, None, \"5\"),\n   160\u2192                \"mimeType\": \"application/ttml+xml\",\n   161\u2192                \"segments\": [(\"http://cdn1.example.com/796735657.xml\", -1, 3256.0, availability, True, True)],\n   162\u2192            },\n   163\u2192            {\n   164\u2192                \"ident\": (None, None, \"6\"),\n   165\u2192                \"mimeType\": \"video/mp4\",\n   166\u2192                \"segments\": [(\"http://cdn1.example.com/8563456473.mp4\", -1, 3256.0, availability, True, True)],\n   167\u2192            },\n   168\u2192        ]\n   169\u2192\n   170\u2192    def test_segments_number_time(self):\n   171\u2192        with xml(\"dash/test_1.mpd\") as mpd_xml:\n   172\u2192            mpd = MPD(mpd_xml, base_url=\"http://test.se/\", url=\"http://test.se/manifest.mpd\")\n   173\u2192\n   174\u2192            segments = mpd.periods[0].adaptationSets[0].representations[0].segments()\n   175\u2192            init_segment = next(segments)\n   176\u2192            assert init_segment.uri == \"http://test.se/tracks-v3/init-1526842800.g_m4v\"\n   177\u2192\n   178\u2192            # suggested delay is 11 seconds, each segment is 5 seconds long - so there should be 3\n   179\u2192            assert [segment.uri for segment in itertools.islice(segments, 5)] == [\n   180\u2192                \"http://test.se/tracks-v3/dvr-1526842800-698.g_m4v?t=3403000\",\n   181\u2192                \"http://test.se/tracks-v3/dvr-1526842800-699.g_m4v?t=3408000\",\n   182\u2192                \"http://test.se/tracks-v3/dvr-1526842800-700.g_m4v?t=3413000\",\n   183\u2192            ]\n   184\u2192\n   185\u2192    def test_segments_static_number(self):\n   186\u2192        with xml(\"dash/test_2.mpd\") as mpd_xml:\n   187\u2192            mpd = MPD(mpd_xml, base_url=\"http://test.se/\", url=\"http://test.se/manifest.mpd\")\n   188\u2192\n   189\u2192            segments = mpd.periods[0].adaptationSets[3].representations[0].segments()\n   190\u2192            init_segment = next(segments)\n   191\u2192            assert init_segment.uri == \"http://test.se/video/250kbit/init.mp4\"\n   192\u2192\n   193\u2192            video_segments = [segment.uri for segment in itertools.islice(segments, 100000)]\n   194\u2192            assert len(video_segments) == 444\n   195\u2192            assert video_segments[:5] == [\n   196\u2192                \"http://test.se/video/250kbit/segment_1.m4s\",\n   197\u2192                \"http://test.se/video/250kbit/segment_2.m4s\",\n   198\u2192                \"http://test.se/video/250kbit/segment_3.m4s\",\n   199\u2192                \"http://test.se/video/250kbit/segment_4.m4s\",\n   200\u2192                \"http://test.se/video/250kbit/segment_5.m4s\",\n   201\u2192            ]\n   202\u2192\n   203\u2192    def test_segments_dynamic_time(self):\n   204\u2192        with xml(\"dash/test_3.mpd\") as mpd_xml:\n   205\u2192            mpd = MPD(mpd_xml, base_url=\"http://test.se/\", url=\"http://test.se/manifest.mpd\")\n   206\u2192\n   207\u2192            segments = mpd.periods[0].adaptationSets[0].representations[0].segments()\n   208\u2192            init_segment = next(segments)\n   209\u2192            assert init_segment.uri == \"http://test.se/video-2800000-0.mp4?z32=\"\n   210\u2192\n   211\u2192            # default suggested delay is 3 seconds, each segment is 4 seconds long - so there should be 1 segment\n   212\u2192            assert [segment.uri for segment in itertools.islice(segments, 3)] == [\n   213\u2192                \"http://test.se/video-time=1525450872000-2800000-0.m4s?z32=\",\n   214\u2192            ]\n   215\u2192\n   216\u2192    # access manifest one hour after its availabilityStartTime\n   217\u2192    @pytest.mark.parametrize(\n   218\u2192        (\"frozen_time\", \"timestamp\"),\n   219\u2192        [\n   220\u2192            pytest.param(\n   221\u2192                freeze_time(\"2000-01-01T01:00:00Z\"),\n   222\u2192                None,\n   223\u2192                id=\"Without explicit timestamp\",\n   224\u2192            ),\n   225\u2192            pytest.param(\n   226\u2192                nullcontext(),\n   227\u2192                datetime.datetime(2000, 1, 1, 1, 0, 0, 0, tzinfo=UTC),\n   228\u2192                id=\"With explicit timestamp\",\n   229\u2192            ),\n   230\u2192        ],\n   231\u2192    )\n   232\u2192    def test_segments_dynamic_number(self, frozen_time, timestamp):\n   233\u2192        with xml(\"dash/test_segments_dynamic_number.mpd\") as mpd_xml, frozen_time:\n   234\u2192            mpd = MPD(mpd_xml, base_url=\"http://test/\", url=\"http://test/manifest.mpd\")\n   235\u2192            segments_iterator = mpd.periods[0].adaptationSets[0].representations[0].segments(timestamp=timestamp)\n   236\u2192            stream_urls = [(segment.uri, segment.available_at) for segment in itertools.islice(segments_iterator, 4)]\n   237\u2192\n   238\u2192        assert stream_urls == [\n   239\u2192            (\n   240\u2192                \"http://test/hd-5-init.mp4\",\n   241\u2192                datetime.datetime(2000, 1, 1, 0, 1, 30, tzinfo=UTC),\n   242\u2192            ),\n   243\u2192            (\n   244\u2192                \"http://test/hd-5_000000793.mp4\",\n   245\u2192                datetime.datetime(2000, 1, 1, 0, 59, 15, tzinfo=UTC),\n   246\u2192            ),\n   247\u2192            (\n   248\u2192                \"http://test/hd-5_000000794.mp4\",\n   249\u2192                datetime.datetime(2000, 1, 1, 0, 59, 20, tzinfo=UTC),\n   250\u2192            ),\n   251\u2192            (\n   252\u2192                \"http://test/hd-5_000000795.mp4\",\n   253\u2192                datetime.datetime(2000, 1, 1, 0, 59, 25, tzinfo=UTC),\n   254\u2192            ),\n   255\u2192        ]\n   256\u2192\n   257\u2192    def test_static_no_publish_time(self):\n   258\u2192        with xml(\"dash/test_static_no_publish_time.mpd\") as mpd_xml:\n   259\u2192            mpd = MPD(mpd_xml, base_url=\"http://test/\", url=\"http://test/manifest.mpd\")\n   260\u2192\n   261\u2192        segments = mpd.periods[0].adaptationSets[1].representations[0].segments()\n   262\u2192        segment_urls = [(segment.uri, segment.available_at) for segment in itertools.islice(segments, 4)]\n   263\u2192        # ignores period start time in static manifests\n   264\u2192        expected_availability = datetime.datetime(2020, 1, 1, 0, 0, 0, tzinfo=UTC)\n   265\u2192\n   266\u2192        assert segment_urls == [\n   267\u2192            (\"http://test/dash/150633-video_eng=194000.dash\", expected_availability),\n   268\u2192            (\"http://test/dash/150633-video_eng=194000-0.dash\", expected_availability),\n   269\u2192            (\"http://test/dash/150633-video_eng=194000-2000.dash\", expected_availability),\n   270\u2192            (\"http://test/dash/150633-video_eng=194000-4000.dash\", expected_availability),\n   271\u2192        ]\n   272\u2192\n   273\u2192    @pytest.mark.parametrize(\n   274\u2192        (\"manifest\", \"expected_time\"),\n   275\u2192        [\n   276\u2192            pytest.param(\"dash/test_dynamic_no_publish_time_timeline_with_start.mpd\", \"155994772214430\", id=\"with-start\"),\n   277\u2192            pytest.param(\"dash/test_dynamic_no_publish_time_timeline_without_start.mpd\", \"4320000\", id=\"without-start\"),\n   278\u2192        ],\n   279\u2192    )\n   280\u2192    def test_dynamic_no_publish_time_with_timeline(self, manifest: str, expected_time: str):\n   281\u2192        with xml(manifest) as mpd_xml:\n   282\u2192            mpd = MPD(mpd_xml, base_url=\"http://test/\", url=\"http://test/manifest.mpd\")\n   283\u2192\n   284\u2192        segments = [\n   285\u2192            (segment.uri, segment.num, segment.duration, segment.available_at, segment.init, segment.content)\n   286\u2192            for segment in itertools.islice(mpd.periods[0].adaptationSets[0].representations[0].segments(), 100)\n   287\u2192        ]\n   288\u2192        assert segments == [\n   289\u2192            (\n   290\u2192                f\"http://test/video_1920x1080_avc1-{expected_time}.m4s\",\n   291\u2192                9,\n   292\u2192                6.0,\n   293\u2192                datetime.datetime(1970, 1, 1, 0, 0, 0, tzinfo=UTC),\n   294\u2192                False,\n   295\u2192                True,\n   296\u2192            ),\n   297\u2192        ]\n   298\u2192\n   299\u2192    def test_segment_list(self):\n   300\u2192        with xml(\"dash/test_segment_list.mpd\") as mpd_xml:\n   301\u2192            mpd = MPD(mpd_xml, base_url=\"http://test/\", url=\"http://test/manifest.mpd\")\n   302\u2192\n   303\u2192        segments = mpd.periods[0].adaptationSets[0].representations[0].segments()\n   304\u2192        segment_urls = [(segment.uri, segment.available_at) for segment in itertools.islice(segments, 4)]\n   305\u2192        # ignores period start time in static manifests\n   306\u2192        expected_availability = datetime.datetime(2020, 1, 1, 0, 0, 0, tzinfo=UTC)\n   307\u2192\n   308\u2192        assert segment_urls == [\n   309\u2192            (\"http://test/chunk_ctvideo_ridp0va0br4332748_cinit_mpd.m4s\", expected_availability),\n   310\u2192            (\"http://test/chunk_ctvideo_ridp0va0br4332748_cn1_mpd.m4s\", expected_availability),\n   311\u2192            (\"http://test/chunk_ctvideo_ridp0va0br4332748_cn2_mpd.m4s\", expected_availability),\n   312\u2192            (\"http://test/chunk_ctvideo_ridp0va0br4332748_cn3_mpd.m4s\", expected_availability),\n   313\u2192        ]\n   314\u2192\n   315\u2192    def test_dynamic_segment_list_continued(self, caplog: pytest.LogCaptureFixture):\n   316\u2192        caplog.set_level(\"WARNING\", \"streamlink.stream.dash\")\n   317\u2192\n   318\u2192        # init manifest\n   319\u2192        with xml(\"dash/test_dynamic_segment_list_p1.mpd\") as mpd_xml:\n   320\u2192            mpd = MPD(mpd_xml, base_url=\"http://test/\", url=\"http://test/manifest.mpd\")\n   321\u2192        segments_iterator = mpd.periods[0].adaptationSets[0].representations[0].segments(init=True)\n   322\u2192\n   323\u2192        assert [(segment.uri, segment.num) for segment in segments_iterator] == [\n   324\u2192            (\"http://test/init.m4s\", -1),\n   325\u2192            (\"http://test/13.m4s\", 13),\n   326\u2192            (\"http://test/14.m4s\", 14),\n   327\u2192            (\"http://test/15.m4s\", 15),\n   328\u2192        ], \"Queues the init segment and the correct number of segments from the live-edge\"\n   329\u2192        assert mpd.timelines[\"0\", \"0\", \"0\"] == 16, \"Remembers the next segment number\"\n   330\u2192        assert [(record.name, re