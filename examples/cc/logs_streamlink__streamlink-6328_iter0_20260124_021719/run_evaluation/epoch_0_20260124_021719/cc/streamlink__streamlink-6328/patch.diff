+            scheme, netloc, path, query, fragment = urlsplit(url)
+            # If base path does not end with a slash, decide whether it's a file or directory.
+            # Treat paths whose last segment looks like a file (contains a dot) as files and
+            # join against their parent directory. Otherwise, treat as a directory and add a trailing slash.
+            if not path.endswith("/"):
+                last = path.rsplit("/", 1)[-1] if path else ""
+                if "." in last:
+                    # remove the last segment (file name)
+                    path = path.rsplit("/", 1)[0] if "/" in path else ""
+                    if path and not path.endswith("/"):
+                        path += "/"
+                    elif not path:
+                        path = "/"
+                else:
+                    path += "/"
+            # Clear query and fragment when joining relative paths
+            base = urlunsplit((scheme, netloc, path, "", ""))
+            return urljoin(base, other)
         else:
             return other
 
