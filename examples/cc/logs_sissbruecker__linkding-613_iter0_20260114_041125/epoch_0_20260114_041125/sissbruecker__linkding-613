elf.setup_bookmark(tags=tags, shared=True)\n\n        rendered_template = self.render_template(\n            context_type=contexts.SharedTagCloudContext,\n            url=\"/test?q=%23tag1 %23tag2\",\n            user=AnonymousUser(),\n        )\n\n        self.assertTagGroups(rendered_template, [[\"tag3\", \"tag4\", \"tag5\"]])\n        self.assertNumSelectedTags(rendered_template, 2)\n        self.assertInHTML(\n            \"\"\"\n            <a href=\"?q=%23tag2\"\n               class=\"text-bold mr-2\">\n                <span>-tag1</span>\n            </a>\n        \"\"\",\n            rendered_template,\n        )\n\n        self.assertInHTML(\n            \"\"\"\n            <a href=\"?q=%23tag1\"\n               class=\"text-bold mr-2\">\n                <span>-tag2</span>\n            </a>\n        \"\"\",\n            rendered_template,\n        )\n",
