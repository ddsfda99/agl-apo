h_preferences\n    74→        )\n    75→\n    76→        query_set = self.get_bookmark_query_set()\n    77→        page_number = request.GET.get(\"page\")\n    78→        paginator = Paginator(query_set, DEFAULT_PAGE_SIZE)\n    79→        bookmarks_page = paginator.get_page(page_number)\n    80→        # Prefetch related objects, this avoids n+1 queries when accessing fields in templates\n    81→        models.prefetch_related_objects(bookmarks_page.object_list, \"owner\", \"tags\")\n    82→\n    83→        self.items = [\n    84→            BookmarkItem(bookmark, user, user_profile) for bookmark in bookmarks_page\n    85→        ]\n    86→\n    87→        self.is_empty = paginator.count == 0\n    88→        self.bookmarks_page = bookmarks_page\n    89→        self.bookmarks_total = paginator.count\n    90→        self.return_url = self.generate_return_url(\n    91→            self.search, self.get_base_url(), page_number\n    92→        )\n    93→        self.action_url = self.generate_action_url(\n    94→            self.search, self.get_base_action_url(), self.return_url\n    95→        )\n    96→        self.link_target = user_profile.bookmark_link_target\n    97→        self.date_display = user_profile.bookmark_date_display\n    98→        self.show_url = user_profile.display_url\n    99→        self.show_favicons = user_profile.enable_favicons\n   100→        self.show_notes = user_profile.permanent_notes\n   101→\n   102→    @staticmethod\n   103→    def generate_return_url(search: BookmarkSearch, base_url: str, page: int = None):\n   104→        query_params = search.query_params\n   105→        if page is not None:\n   106→            query_params[\"page\"] = page\n   107→        query_string = urllib.parse.urlencode(query_params)\n   108→\n   109→        return base_url if query_string == \"\" else base_url + \"?\" + query_string\n   110→\n   111→    @staticmethod\n   112→    def generate_action_url(\n   113→        search: BookmarkSearch, base_action_url: