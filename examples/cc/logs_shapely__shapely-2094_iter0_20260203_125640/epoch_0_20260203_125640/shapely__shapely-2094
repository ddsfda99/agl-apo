5→    **kwargs\n   466→        See :ref:`NumPy ufunc docs <ufuncs.kwargs>` for other keyword arguments.\n   467→\n   468→    See Also\n   469→    --------\n   470→    is_valid : returns True or False\n   471→\n   472→    Examples\n   473→    --------\n   474→    >>> from shapely import LineString, Polygon\n   475→    >>> is_valid_reason(LineString([(0, 0), (1, 1)]))\n   476→    'Valid Geometry'\n   477→    >>> is_valid_reason(Polygon([(0, 0), (1, 1), (1, 2), (1, 1), (0, 0)]))\n   478→    'Self-intersection[1 2]'\n   479→    >>> is_valid_reason(None) is None\n   480→    True\n   481→\n   482→    \"\"\"\n   483→    return lib.is_valid_reason(geometry, **kwargs)\n   484→\n   485→\n   486→@multithreading_enabled\n   487→def crosses(a, b, **kwargs):\n   488→    \"\"\"Return True if A and B spatially cross.\n   489→\n   490→    A crosses B if they have some but not all interior points in common,\n   491→    the intersection is one dimension less than the maximum dimension of A or B,\n   492→    and the intersection is not equal to either A or B.\n   493→\n   494→    Parameters\n   495→    ----------\n   496→    a, b : Geometry or array_like\n   497→        Geometry or geometries to check.\n   498→    **kwargs\n   499→        See :ref:`NumPy ufunc docs <ufuncs.kwargs>` for other keyword arguments.\n   500→\n   501→    See Also\n   502→    --------\n   503→    prepare : improve performance by preparing ``a`` (the first argument)\n   504→\n   505→    Examples\n   506→    --------\n   507→    >>> from shapely import LineString, MultiPoint, Point, Polygon\n   508→    >>> line = LineString([(0, 0), (1, 1)])\n   509→    >>> # A contains B:\n   510→    >>> crosses(line, Point(0.5, 0.5))\n   511→    False\n   512→    >>> # A and B intersect at a point but do not share all points:\n   513→    >>> crosses(line, MultiPoint([(0, 1), (0.5, 0.5)]))\n   514→    True\n   515→    >>> crosses(line, LineString([(0, 1), (1, 0)]))\n   516→    True\n   517→    >>> # A is contained by B; their intersection is a line (same dimension):\n   518→    >>> crosses(line, LineString([(0, 0), (2, 2)]))\n   519→    False\n   520→    >>> area = Polygon([(0, 0), (1, 0), (1, 1), (0, 1), (0, 0)])\n   521→    >>> # A contains B:\n   522→    >>> crosses(area, line)\n   523→    False\n   524→    >>> # A and B intersect with a line (lower dimension) but do not share all points:\n   525→    >>> crosses(area, LineString([(0, 0), (2, 2)]))\n   526→    True\n   527→    >>> # A contains B:\n   528→    >>> crosses(area, Point(0.5, 0.5))\n   529→    False\n   530→    >>> # A contains some but not all points of B; they intersect at a point:\n   531→    >>> crosses(area, MultiPoint([(2, 2), (0.5, 0.5)]))\n   532→    True\n   533→\n   534→    \"\"\"\n   535→    return lib.crosses(a, b, **kwargs)\n   536→\n   537→\n   538→@multithreading_enabled\n   539→def contains(a, b, **kwargs):\n   540→    \"\"\"Return True if geometry B is completely inside geometry A.\n   541→\n   542→    A contains B if no points of B lie in the exterior of A and at least one\n   543→    point of the interior of B lies in the interior of A.\n   544→\n   545→    Note: following this definition, a geometry does not contain its boundary,\n   546→    but it does contain itself. See ``contains_properly`` for a version where\n   547→    a geometry does not contain itself.\n   548→\n   549→    Parameters\n   550→    ----------\n   551→    a, b : Geometry or array_like\n   552→        Geometry or geometries to check.\n   553→    **kwargs\n   554→        See :ref:`NumPy ufunc docs <ufuncs.kwargs>` for other keyword arguments.\n   555→\n   556→    See Also\n   557→    --------\n   558→    within : ``contains(A, B) == within(B, A)``\n   559→    contains_properly : contains with no common boundary points\n   560→    prepare : improve performance by preparing ``a`` (the first argument)\n   561→    contains_xy : variant for checking against a Point with x, y coordinates\n   562→\n   563→    Examples\n   564→    --------\n   565→    >>> from shapely import LineString, Point, Polygon\n   566→    >>> line = LineString([(0, 0), (1, 1)])\n   567→    >>> contains(line, Point(0, 0))\n   568→    False\n   569→    >>> contains(line, Point(0.5, 0.5))\n   570→    True\n   571→    >>> area = Polygon([(0, 0), (1, 0), (1, 1), (0, 1), (0, 0)])\n   572→    >>> contains(area, Point(0, 0))\n   573→    False\n   574→    >>> contains(area, line)\n   575→    True\n   576→    >>> contains(area, LineString([(0, 0), (2, 2)]))\n   577→    False\n   578→    >>> polygon_with_hole = Polygon(\n   579→    ...     [(0, 0), (0, 10), (10, 10), (10, 0), (0, 0)],\n   580→    ...     holes=[[(2, 2), (2, 4), (4, 4), (4, 2), (2, 2)]]\n   581→    ... )\n   582→    >>> contains(polygon_with_hole, Point(1, 1))\n   583→    True\n   584→    >>> contains(polygon_with_hole, Point(2, 2))\n   585→    False\n   586→    >>> contains(polygon_with_hole, LineString([(1, 1), (5, 5)]))\n   587→    False\n   588→    >>> contains(area, area)\n   589→    True\n   590→    >>> contains(area, None)\n   591→    False\n   592→\n   593→    \"\"\"\n   594→    return lib.contains(a, b, **kwargs)\n   595→\n   596→\n   597→@multithreading_enabled\n   598→def contains_properly(a, b, **kwargs):\n   599→    \"\"\"Return True if geometry B is completely inside geometry A, with no common\n   600→    boundary points.\n   601→\n   602→    A contains B properly if B intersects the interior of A but not the\n   603→    boundary (or exterior). This means that a geometry A does not\n   604→    \"contain properly\" itself, which contrasts with the ``contains`` function,\n   605→    where common points on the boundary are allowed.\n   606→\n   607→    Note: this function will prepare the geometries under the hood if needed.\n   608→    You can prepare the geometries in advance to avoid repeated preparation\n   609→    when calling this function multiple times.\n   610→\n   611→    Parameters\n   612→    ----------\n   613→    a, b : Geometry or array_like\n   614→        Geometry or geometries to check.\n   615→    **kwargs\n   616→        See :ref:`NumPy ufunc docs <ufuncs.kwargs>` for other keyword arguments.\n   617→\n   618→    See Also\n   619→    --------\n   620→    contains : contains which allows common boundary points\n   621→    prepare : improve performance by preparing ``a`` (the first argument)\n   622→\n   623→    Examples\n   624→    --------\n   625→    >>> from shapely import Polygon\n   626→    >>> area1 = Polygon([(0, 0), (3, 0), (3, 3), (0, 3), (0, 0)])\n   627→    >>> area2 = Polygon([(0, 0), (1, 0), (1, 1), (0, 1), (0, 0)])\n   628→    >>> area3 = Polygon([(1, 1), (2, 1), (2, 2), (1, 2), (1, 1)])\n   629→\n   630→    ``area1`` and ``area2`` have a common border:\n   631→\n   632→    >>> contains(area1, area2)\n   633→    True\n   634→    >>> contains_properly(area1, area2)\n   635→    False\n   636→\n   637→    ``area3`` is completely inside ``area1`` with no common border:\n   638→\n   639→    >>> contains(area1, area3)\n   640→    True\n   641→    >>> contains_properly(area1, area3)\n   642→    True\n   643→\n   644→    \"\"\"  # noqa: D205\n   645→    return lib.contains_properly(a, b, **kwargs)\n   646→\n   647→\n   648→@multithreading_enabled\n   649→def covered_by(a, b, **kwargs):\n   650→    \"\"\"Return True if no point in geometry A is outside geometry B.\n   651→\n   652→    Parameters\n   653→    ----------\n   654→    a, b : Geometry or array_like\n   655→        Geometry or geometries to check.\n   656→    **kwargs\n   657→        See :ref:`NumPy ufunc docs <ufuncs.kwargs>` for other keyword arguments.\n   658→\n   659→    See Also\n   660→    --------\n   661→    covers : ``covered_by(A, B) == covers(B, A)``\n   662→    prepare : improve performance by preparing ``a`` (the first argument)\n   663→\n   664→    Examples\n   665→    --------\n   666→    >>> from shapely import LineString, Point, Polygon\n   667→    >>> line = LineString([(0, 0), (1, 1)])\n   668→    >>> covered_by(Point(0, 0), line)\n   669→    True\n   670→    >>> covered_by(Point(0.5, 0.5), line)\n   671→    True\n   672→    >>> area = Polygon([(0, 0), (1, 0), (1, 1), (0, 1), (0, 0)])\n   673→    >>> covered_by(Point(0, 0), area)\n   674→    True\n   675→    >>> covered_by(line, area)\n   676→    True\n   677→    >>> covered_by(LineString([(0, 0), (2, 2)]), area)\n   678→    False\n   679→    >>> polygon_with_hole = Polygon(\n   680→    ...     [(0, 0), (0, 10), (10, 10), (10, 0), (0, 0)],\n   681→    ...     holes=[[(2, 2), (2, 4), (4, 4), (4, 2), (2, 2)]]\n   682→    ... )\n   683→    >>> covered_by(Point(1, 1), polygon_with_hole)\n   684→    True\n   685→    >>> covered_by(Point(2, 2), polygon_with_hole)\n   686→    True\n   687→    >>> covered_by(LineString([(1, 1), (5, 5)]), polygon_with_hole)\n   688→    False\n   689→    >>> covered_by(area, area)\n   690→    True\n   691→    >>> covered_by(None, area)\n   692→    False\n   693→\n   694→    \"\"\"\n   695→    return lib.covered_by(a, b, **kwargs)\n   696→\n   697→\n   698→@multithreading_enabled\n   699→def covers(a, b, **kwargs):\n   700→    \"\"\"Return True if no point in geometry B is outside geometry A.\n   701→\n   702→    Parameters\n   703→    ----------\n   704→    a, b : Geometry or array_like\n   705→        Geometry or geometries to check.\n   706→    **kwargs\n   707→        See :ref:`NumPy ufunc docs <ufuncs.kwargs>` for other keyword arguments.\n   708→\n   709→    See Also\n   710→    --------\n   711→    covered_by : ``covers(A, B) == covered_by(B, A)``\n   712→    prepare : improve performance by preparing ``a`` (the first argument)\n   713→\n   714→    Examples\n   715→    --------\n   716→    >>> from shapely import LineString, Point, Polygon\n   717→    >>> line = LineString([(0, 0), (1, 1)])\n   718→    >>> covers(line, Point(0, 0))\n   719→    True\n   720→    >>> covers(line, Point(0.5, 0.5))\n   721→    True\n   722→    >>> area = Polygon([(0, 0), (1, 0), (1, 1), (0, 1), (0, 0)])\n   723→    >>> covers(area, Point(0, 0))\n   724→    True\n   725→    >>> covers(area, line)\n   726→    True\n   727→    >>> covers(area, LineString([(0, 0), (2, 2)]))\n   728→    False\n   729→    >>> polygon_with_hole = Polygon(\n   730→    ...     [(0, 0), (0, 10), (10, 10), (10, 0), (0, 0)],\n   731→    ...     holes=[[(2, 2), (2, 4), (4, 4), (4, 2), (2, 2)]]\n   732→    ... )\n   733→    >>> covers(polygon_with_hole, Point(1, 1))\n   734→    True\n   735→    >>> covers(polygon_with_hole, Point(2, 2))\n   736→    True\n   737→    >>> covers(polygon_with_hole, LineString([(1, 1), (5, 5)]))\n   738→    False\n   739→    >>> covers(area, area)\n   740→    True\n   741→    >>> covers(area, None)\n   742→    False\n   743→\n   744→    \"\"\"\n   745→    return lib.covers(a, b, **kwargs)\n   746→\n   747→\n   748→@multithreading_enabled\n   749→def disjoint(a, b, **kwargs):\n   750→    \"\"\"Return True if A and B do not share any point in space.\n   751→\n   752→    Disjoint implies that overlaps, touches, within, and intersects are False.\n   753→    Note missing (None) values are never disjoint.\n   754→\n   755→    Parameters\n   756→    ----------\n   757→    a, b : Geometry or array_like\n   758→        Geometry or geometries to check.\n   759→    **kwargs\n   760→        See :ref:`NumPy ufunc docs <ufuncs.kwargs>` for other keyword arguments.\n   761→\n   762→    See Also\n   763→    --------\n   764→    intersects : ``disjoint(A, B) == ~intersects(A, B)``\n   765→    prepare : improve performance by preparing ``a`` (the first argument)\n   766→\n   767→    Examples\n   768→    --------\n   769→    >>> from shapely import GeometryCollection, LineString, Point\n   770→    >>> line = LineString([(0, 0), (1, 1)])\n   771→    >>> disjoint(line, Point(0, 0))\n   772→    False\n   773→    >>> disjoint(line, Point(0, 1))\n   774→    True\n   775→    >>> disjoint(line, LineString([(0, 2), (2, 0)]))\n   776→    False\n   777→    >>> empty = GeometryCollection()\n   778→    >>> disjoint(line, empty)\n   779→    True\n   780→    >>> disjoint(empty, empty)\n   781→    True\n   782→    >>> disjoint(empty, None)\n   783→    False\n   784→    >>> disjoint(None, None)\n   785→    False\n   786→\n   787→    \"\"\"\n   788→    return lib.disjoint(a, b, **kwargs)\n   789→\n   790→\n   791→@multithreading_enabled\n   792→def equals(a, b, **kwargs):\n   793→    \"\"\"Return True if A and B are spatially equal.\n   794→\n   795→    If A is within B and B is within A, A and B are considered equal. The\n   796→    ordering of points can be different.\n   797→\n   798→    Parameters\n   799→    ----------\n   800→    a, b : Geometry or array_like\n   801→        Geometry or geometries to check.\n   802→    **kwargs\n   803→        See :ref:`NumPy ufunc docs <ufuncs.kwargs>` for other keyword arguments.\n   804→\n   805→    See Also\n   806→    --------\n   807→    equals_exact : Check if A and B are structurally equal given a specified\n   808→        tolerance.\n   809→\n   810→    Examples\n   811→    --------\n   812→    >>> from shapely import GeometryCollection, LineString, Polygon\n   813→    >>> line = LineString([(0, 0), (5, 5), (10, 10)])\n   814→    >>> equals(line, LineString([(0, 0), (10, 10)]))\n   815→    True\n   816→    >>> equals(Polygon(), GeometryCollection())\n   817→    True\n   818→    >>> equals(None, None)\n   819→    False\n   820→\n   821→    \"\"\"\n   822→    return lib.equals(a, b, **kwargs)\n   823→\n   824→\n   825→@multithreading_enabled\n   826→def intersects(a, b, **kwargs):\n   827→    \"\"\"Return True if A and B share any portion of space.\n   828→\n   829→    Intersects implies that overlaps, touches, covers, or within are True.\n   830→\n   831→    Parameters\n   832→    ----------\n   833→    a, b : Geometry or array_like\n   834→        Geometry or geometries to check.\n   835→    **kwargs\n   836→        See :ref:`NumPy ufunc docs <ufuncs.kwargs>` for other keyword arguments.\n   837→\n   838→    See Also\n   839→    --------\n   840→    disjoint : ``intersects(A, B) == ~disjoint(A, B)``\n   841→    prepare : improve performance by preparing ``a`` (the first argument)\n   842→    intersects_xy : variant for checking against a Point with x, y coordinates\n   843→\n   844→    Examples\n   845→    --------\n   846→    >>> from shapely import LineString, Point\n   847→    >>> line = LineString([(0, 0), (1, 1)])\n   848→    >>> intersects(line, Point(0, 0))\n   849→    True\n   850→    >>> intersects(line, Point(0, 1))\n   851→    False\n   852→    >>> intersects(line, LineString([(0, 2), (2, 0)]))\n   853→    True\n   854→    >>> intersects(None, None)\n   855→    False\n   856→\n   857→    \"\"\"\n   858→    return lib.intersects(a, b, **kwargs)\n   859→\n   860→\n   861→@multithreading_enabled\n   862→def overlaps(a, b, **kwargs):\n   863→    \"\"\"Return True if A and B spatially overlap.\n   864→\n   865→    A and B overlap if they have some but not all points in common, have the\n   866→    same dimension, and the intersection of the interiors of the two geometries\n   867→    has the same dimension as the geometries themselves.  That is, only polyons\n   868→    can overlap other polygons and only lines can overlap other lines.\n   869→\n   870→    If either A or B are None, the output is always False.\n   871→\n   872→    Parameters\n   873→    ----------\n   874→    a, b : Geometry or array_like\n   875→        Geometry or geometries to check.\n   876→    **kwargs\n   877→        See :ref:`NumPy ufunc docs <ufuncs.kwargs>` for other keyword arguments.\n   878→\n   879→    See Also\n   880→    --------\n   881→    prepare : improve performance by preparing ``a`` (the first argument)\n   882→\n   883→    Examples\n   884→    --------\n   885→    >>> from shapely import LineString, Point, Polygon\n   886→    >>> poly = Polygon([(0, 0), (0, 4), (4, 4), (4, 0), (0, 0)])\n   887→    >>> # A and B share all points (are spatially equal):\n   888→    >>> overlaps(poly, poly)\n   889→    False\n   890→    >>> # A contains B; all points of B are within A:\n   891→    >>> overlaps(poly, Polygon([(0, 0), (0, 2), (2, 2), (2, 0), (0, 0)]))\n   892→    False\n   893→    >>> # A partially overlaps with B:\n   894→    >>> overlaps(poly, Polygon([(2, 2), (2, 6), (6, 6), (6, 2), (2, 2)]))\n   895→    True\n   896→    >>> line = LineString([(2, 2), (6, 6)])\n   897→    >>> # A and B are different dimensions; they cannot overlap:\n   898→    >>> overlaps(poly, line)\n   899→    False\n   900→    >>> overlaps(poly, Point(2, 2))\n   901→    False\n   902→    >>> # A and B share some but not all points:\n   903→    >>> overlaps(line, LineString([(0, 0), (4, 4)]))\n   904→    True\n   905→    >>> # A and B intersect only at a point (lower dimension); they do not overlap\n   906→    >>> overlaps(line, LineString([(6, 0), (0, 6)]))\n   907→    False\n   908→    >>> overlaps(poly, None)\n   909→    False\n   910→    >>> overlaps(None, None)\n   911→    False\n   912→\n   913→    \"\"\"\n   914→    return lib.overlaps(a, b, **kwargs)\n   915→\n   916→\n   917→@multithreading_enabled\n   918→def touches(a, b, **kwargs):\n   919→    \"\"\"Return True if the only points shared between A and B are on their boundaries.\n   920→\n   921→    Parameters\n   922→    ----------\n   923→    a, b : Geometry or array_like\n   924→        Geometry or geometries to check.\n   925→    **kwargs\n   926→        See :ref:`NumPy ufunc docs <ufuncs.kwargs>` for other keyword arguments.\n   927→\n   928→    See Also\n   929→    --------\n   930→    prepare : improve performance by preparing ``a`` (the first argument)\n   931→\n   932→    Examples\n   933→    --------\n   934→    >>> from shapely import LineString, Point, Polygon\n   935→    >>> line = LineString([(0, 2), (2, 0)])\n   936→    >>> touches(line, Point(0, 2))\n   937→    True\n   938→    >>> touches(line, Point(1, 1))\n   939→    False\n   940→    >>> touches(line, LineString([(0, 0), (1, 1)]))\n   941→    True\n   942→    >>> touches(line, LineString([(0, 0), (2, 2)]))\n   943→    False\n   944→    >>> area = Polygon([(0, 0), (1, 0), (1, 1), (0, 1), (0, 0)])\n   945→    >>> touches(area, Point(0.5, 0))\n   946→    True\n   947→    >>> touches(area, Point(0.5, 0.5))\n   948→    False\n   949→    >>> touches(area, line)\n   950→    True\n   951→    >>> touches(area, Polygon([(0, 1), (1, 1), (1, 2), (0, 2), (0, 1)]))\n   952→    True\n   953→\n   954→    \"\"\"\n   955→    return lib.touches(a, b, **kwargs)\n   956→\n   957→\n   958→@multithreading_enabled\n   959→def within(a, b, **kwargs):\n   960→    \"\"\"Return True if geometry A is completely inside geometry B.\n   961→\n   962→    A is within B if no points of A lie in the exterior of B and at least one\n   963→    point of the interior of A lies in the interior of B.\n   964→\n   965→    Parameters\n   966→    ----------\n   967→    a, b : Geometry or array_like\n   968→        Geometry or geometries to check.\n   969→    **kwargs\n   970→        See :ref:`NumPy ufunc docs <ufuncs.kwargs>` for other keyword arguments.\n   971→\n   972→    See Also\n   973→    --------\n   974→    contains : ``within(A, B) == contains(B, A)``\n   975→    prepare : improve performance by preparing ``a`` (the first argument)\n   976→\n   977→    Examples\n   978→    --------\n   979→    >>> from shapely import LineString, Point, Polygon\n   980→    >>> line = LineString([(0, 0), (1, 1)])\n   981→    >>> within(Point(0, 0), line)\n   982→    False\n   983→    >>> within(Point(0.5, 0.5), line)\n   984→    True\n   985→    >>> area = Polygon([(0, 0), (1, 0), (1, 1), (0, 1), (0, 0)])\n   986→    >>> within(Point(0, 0), area)\n   987→    False\n   988→    >>> within(line, area)\n   989→    True\n   990→    >>> within(LineString([(0, 0), (2, 2)]), area)\n   991→    False\n   992→    >>> polygon_with_hole = Polygon(\n   993→    ...     [(0, 0), (0, 10), (10, 10), (10, 0), (0, 0)],\n   994→    ...     holes=[[(2, 2), (2, 4), (4, 4), (4, 2), (2, 2)]]\n   995→    ... )\n   996→    >>> within(Point(1, 1), polygon_with_hole)\n   997→    True\n   998→    >>> within(Point(2, 2), polygon_with_hole)\n   999→    False\n  1000→    >>> within(LineString([(1, 1), (5, 5)]), polygon_with_hole)\n  1001→    False\n  1002→    >>> within(area, area)\n  1003→    True\n  1004→    >>> within(None, area)\n  1005→    False\n  1006→\n  1007→    \"\"\"\n  1008→    return lib.within(a, b, **kwargs)\n  1009→\n  1010→\n  1011→@multithreading_enabled\n  1012→def equals_exact(a, b, tolerance=0.0, normalize=False, **kwargs):\n  1013→    \"\"\"Return True if the geometries are structurally equivalent within a given\n  1014→    tolerance.\n  1015→\n  1016→    This method uses exact coordinate equality, which requires coordinates\n  1017→    to be equal (within specified tolerance) and in the same order for\n  1018→    all components (vertices, rings, or parts) of a geometry. This is in\n  1019→    contrast with the :func:`equals` function which uses spatial\n  1020→    (topological) equality and does not require all components to be in the\n  1021→    same order. Because of this, it is possible for :func:`equals` to\n  1022→    be ``True`` while :func:`equals_exact` is ``False``.\n  1023→\n  1024→    The order of the coordinates can be normalized (by setting the `normalize`\n  1025→    keyword to ``True``) so that this function will return ``True`` when geometries\n  1026→    are structurally equivalent but differ only in the ordering of vertices.\n  1027→    However, this function will still return ``False`` if the order of interior\n  1028→    rings within a :class:`Polygon` or the order of geometries within a multi\n  1029→    geometry are different.\n  1030→\n  1031→    Parameters\n  1032→    ----------\n  1033→    a, b : Geometry or array_like\n  1034→        Geometry or geometries to check.\n  1035→    tolerance : float or array_like (default: 0.)\n  1036→        The tolerance to use in the comparison.\n  1037→    normalize : bool, optional (default: