         depth -= 1\n    return result\n\n\ndef _repair_polygon(data):\n    # Keep the prefix up to the first '(' (type and optional dimension tokens)\n    idx = data.find(\"(\")\n    if idx == -1:\n        return data\n    prefix = data[:idx].rstrip()\n    rest = data[idx:]\n    # Extract each ring content at depth==2\n    rings = _extract_substrings_at_depth(rest, 2)\n    if not rings:\n        return data\n    repaired_rings = [\"(\" + _repair_ring(r) + \")\" for r in rings]\n    # Rebuild using the outer parentheses from rest\n    return f\"{prefix}{rest[0]}{', '.join(repaired_rings)}{rest[-1]}\"\n\n\ndef _repair_multipolygon(data):\n    idx = data.find(\"(\")\n    if idx == -1:\n        return data\n    prefix = data[:idx].rstrip()\n    rest = data[idx:]\n    # For multipolygon, rings are at depth 3, and each polygon content at depth 2\n    polygons = _extract_substrings_at_depth(rest, 2)  # contents of each polygon (within ((...)))\n    if not polygons:\n        return data\n    # Each polygon content itself has one or more rings enclosed in parentheses\n    repaired_polygons = []\n    for poly_content in polygons:\n        # poly_content contains e.g. \"(ring1), (ring2)\" without the outer parentheses\n        rings = _extract_substrings_at_depth(\"(\" + poly_content + \")\", 2)\n        repaired_rings = [\"(\" + _repair_ring(r) + \")\" for r in rings]\n        repaired_polygons.append(\"(\" + \", \".join(repaired_rings) + \")\")\n    return f\"{prefix}{rest[0]}{', '.join(repaired_polygons)}{rest[-1]}\"\n\n\ndef _split_collection_items(inner):\n    # inner is the content inside GEOMETRYCOLLECTION (...)\n    items = []\n    depth = 0\n    start = 0\n    for i, ch in enumerate(inner):\n        if ch == \"(\":\n            depth += 1\n        elif ch == \")\":\n            depth -= 1\n        elif ch == \",\" and depth == 0:\n            items.append(inner[start:i].strip())\n            start = i + 1\n    tail = inner[start:].strip()\n    if tail:\n        items.append(tail)\n    return items\n\n\ndef _repair_geometrycollection(data):\n    idx = data.find(\"(\")\n    if idx == -1:\n        return data\n    prefix = data[:idx].rstrip()\n    # find matching closing for the first '('\n    depth = 0\n    end = None\n    for i in range(idx, len(data)):\n        ch = data[i]\n        if ch == \"(\":\n            depth += 1\n        elif ch == \")\":\n            depth -= 1\n            if depth == 0:\n                end = i\n                break\n    if end is None:\n        return data\n    inner = data[idx + 1 : end]\n    items = _split_collection_items(inner)\n    repaired_items = [_repair_wkt(item) for item in items]\n    return f\"{prefix}({', '.join(repaired_items)})\"\n\n\ndef _repair_wkt(data):\n    # Attempt to repair common structural issues for polygons and collections\n    s = data.strip()\n    # If EMPTY geometries, return as-is\n    if \"EMPTY\" in s.upper():\n        return data\n    upper = s.upper()\n    if upper.startswith(\"POLYGON\"):\n        return _repair_polygon(s)\n    if upper.startswith(\"MULTIPOLYGON\"):\n        return _repair_multipolygon(s)\n    if upper.startswith(\"GEOMETRYCOLLECTION\"):\n        return _repair_geometrycollection(s)\n    if upper.startswith(\"LINEARRING\"):\n        # Close the ring\n        idx = s.find(\"(\")\n        if idx != -1:\n            content = s[idx + 1 : -1]\n            repaired = _repair_ring(content)\n            return f\"{s[:idx]}({repaired})\"\n        return s\n    # other types left unchanged\n    return data\n\n\ndef loads(data, strict=True, fix_structure=None):\n    \"\"\"Load a geometry from a WKT string.\n\n    Parameters\n    ----------\n    data : str\n        A WKT string\n    strict : bool, default True\n        If False, attempt to repair common structural issues when reading,\n        such as automatically closing LinearRings in Polygons.\n        This is an alias for ``fix_structure=True``.\n    fix_structure : bool, optional\n        If True, attempt to repair common structural issues when reading.\n        If not provided, it is inferred from ``strict``.\n\n    Returns\n    -------\n    Shapely geometry object\n\n    \"\"\"\n    if fix_structure is None:\n        fix_structure = not strict\n    if fix_structure:\n        data = _repair_wkt(data)\n    return shapely.from_wkt(data)\n\n\ndef load(fp, strict=True, fix_structure=None):\n    \"\"\"Load a geometry from an open file.\n\n    Parameters\n    ----------\n    fp :\n        A file-like object which implements a `read` method.\n    strict : bool, default True\n        If False, attempt to repair common structural issues when reading,\n        such as automatically closing LinearRings in Polygons.\n        This is an alias for ``fix_structure=True``.\n    fix_structure : bool, optional\n        If True, attempt to repair common structural issues when reading.\n        If not provided, it is inferred from ``strict``.\n\n    Returns\n    -------\n    Shapely geometry object\n\n    \"\"\"\n    data = fp.read()\n    if fix_structure is None:\n        fix_structure = not strict\n    if fix_structure:\n        data = _repair_wkt(data)\n    return loads(data)\n\n\ndef dumps(ob, trim=False, rounding_precision=-1, **kw):\n    \"\"\"Dump a WKT representation of a geometry to a string.\n\n    Parameters\n    ----------\n    ob :\n        A geometry object of any type to be dumped to WKT.\n    trim : bool, default False\n        Remove excess decimals from the WKT.\n    rounding_precision : int, default -1\n        Round output to the specified number of digits.\n        Default behavior returns full precision.\n    **kw : kwargs, optional\n        Keyword output options passed to :func:`~shapely.to_wkt`.\n\n    Returns\n    -------\n    input geometry as WKT string\n\n    \"\"\"\n    return shapely.to_wkt(ob, trim=trim, rounding_precision=rounding_precision, **kw)\n\n\ndef dump(ob, fp, **settings):\n    \"\"\"Dump a geometry to an open file.\n\n    Parameters\n    ----------\n    ob :\n        A geometry object of any type to be dumped to WKT.\n    fp :\n        A file-like object which implements a `write` method.\n    **settings : kwargs, optional\n        Keyword output options passed to :func:`~shapely.wkt.dumps`.\n\n    Returns\n    -------\n    None\n\n    \"\"\"\n    fp.write(dumps(ob, **settings))\n",
