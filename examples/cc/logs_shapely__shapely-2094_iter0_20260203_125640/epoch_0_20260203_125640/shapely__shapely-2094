pected) - coordinate_length\n   913\u2192    assert len(actual) == header_length + coordinate_length\n   914\u2192    assert actual[:header_length] == expected[:header_length]\n   915\u2192    assert np.isnan(struct.unpack(\"<4d\", actual[header_length:])).all()\n   916\u2192\n   917\u2192\n   918\u2192@pytest.mark.parametrize(\n   919\u2192    \"geom,expected\",\n   920\u2192    [\n   921\u2192        pytest.param(empty_point, POINT_NAN_WKB, id=\"POINT EMPTY\"),\n   922\u2192        pytest.param(multi_point_empty, MULTIPOINT_NAN_WKB, id=\"MULTIPOINT EMPTY\"),\n   923\u2192        pytest.param(\n   924\u2192            shapely.geometrycollections([empty_point]),\n   925\u2192            GEOMETRYCOLLECTION_NAN_WKB,\n   926\u2192            id=\"GEOMETRYCOLLECTION (POINT EMPTY)\",\n   927\u2192        ),\n   928\u2192        pytest.param(\n   929\u2192            shapely.geometrycollections([multi_point_empty]),\n   930\u2192            NESTED_COLLECTION_NAN_WKB,\n   931\u2192            id=\"GEOMETRYCOLLECTION (MULTIPOINT EMPTY)\",\n   932\u2192        ),\n   933\u2192    ],\n   934\u2192)\n   935\u2192def test_to_wkb_point_empty_2d_output_dim_3(geom, expected):\n   936\u2192    actual = shapely.to_wkb(geom, output_dimension=3, byte_order=1)\n   937\u2192    # Split 'actual' into header and coordinates\n   938\u2192    coordinate_length = 16\n   939\u2192    header_length = len(expected) - coordinate_length\n   940\u2192    # Check the total length (this checks the correct dimensionality)\n   941\u2192    assert len(actual) == header_length + coordinate_length\n   942\u2192    # Check the header\n   943\u2192    assert actual[:header_length] == expected[:header_length]\n   944\u2192    # Check the coordinates (using numpy.isnan; there are many byte representations for\n   945\u2192    # NaN)\n   946\u2192    assert np.isnan(struct.unpack(\"<2d\", actual[header_length:])).all()\n   947\u2192\n   948\u2192\n   949\u2192@pytest.mark.parametrize(\n   950\u2192    \"wkb,expected_type,expected_dim\",\n   951\u2192    [\n   952\u2192        pytest.param(POINT_NAN_WKB, 0, 2, id=\"POINT_NAN_WKB\"),\n   953\u2192        pytest.param(POINTZ_NAN_WKB, 0, 3, id=\"POINTZ_NAN_WKB\"),\n   954\u2192        pytest.param(MULTIPOINT_NAN_WKB, 4, 2, id=\"MULTIPOINT_NAN_WKB\"),\n   955\u2192        pytest.param(MULTIPOINTZ_NAN_WKB, 4, 3, id=\"MULTIPOINTZ_NAN_WKB\"),\n   956\u2192        pytest.param(GEOMETRYCOLLECTION_NAN_WKB, 7, 2, id=\"GEOMETRYCOLLECTION_NAN_WKB\"),\n   957\u2192        pytest.param(\n   958\u2192            GEOMETRYCOLLECTIONZ_NAN_WKB, 7, 3, id=\"GEOMETRYCOLLECTIONZ_NAN_WKB\"\n   959\u2192        ),\n   960\u2192        pytest.param(NESTED_COLLECTION_NAN_WKB, 7, 2, id=\"NESTED_COLLECTION_NAN_WKB\"),\n   961\u2192        pytest.param(NESTED_COLLECTIONZ_NAN_WKB, 7, 3, id=\"NESTED_COLLECTIONZ_NAN_WKB\"),\n   962\u2192    ],\n   963\u2192)\n   964\u2192def test_from_wkb_point_empty(wkb, expected_type, expected_dim):\n   965\u2192    geom = shapely.from_wkb(wkb)\n   966\u2192    # POINT (nan nan) transforms to an empty point\n   967\u2192    assert shapely.is_empty(geom)\n   968\u2192    assert shapely.get_type_id(geom) == expected_type\n   969\u2192    assert shapely.get_coordinate_dimension(geom) == expected_dim\n   970\u2192\n   971\u2192\n   972\u2192@pytest.mark.skipif(\n   973\u2192    shapely.geos_version < (3, 12, 0),\n   974\u2192    reason=\"M coordinates not supported with GEOS < 3.12\",\n   975\u2192)\n   976\u2192@pytest.mark.parametrize(\n   977\u2192    \"wkb,expected_type\",\n   978\u2192    [\n   979\u2192        pytest.param(POINTM_NAN_WKB, 0, id=\"POINTM_NAN_WKB\"),\n   980\u2192        pytest.param(MULTIPOINTM_NAN_WKB, 4, id=\"MULTIPOINTM_NAN_WKB\"),\n   981\u2192        pytest.param(GEOMETRYCOLLECTIONM_NAN_WKB, 7, id=\"GEOMETRYCOLLECTIONM_NAN_WKB\"),\n   982\u2192        pytest.param(NESTED_COLLECTIONM_NAN_WKB, 7, id=\"NESTED_COLLECTIONM_NAN_WKB\"),\n   983\u2192    ],\n   984\u2192)\n   985\u2192def test_from_wkb_point_empty_m(wkb, expected_type):\n   986\u2192    geom = shapely.from_wkb(wkb)\n   987\u2192\n   988\u2192    assert shapely.is_empty(geom)\n   989\u2192    assert shapely.get_type_id(geom) == expected_type\n   990\u2192    assert shapely.get_coordinate_dimension(geom) == 3\n   991\u2192    assert not shapely.has_z(geom)\n   992\u2192    assert shapely.has_m(geom)\n   993\u2192\n   994\u2192\n   995\u2192@pytest.mark.skipif(\n   996\u2192    shapely.geos_version < (3, 12, 0),\n   997\u2192    reason=\"M coordinates not supported with GEOS < 3.12\",\n   998\u2192)\n   999\u2192@pytest.mark.parametrize(\n  1000\u2192    \"wkb,expected_type\",\n  1001\u2192    [\n  1002\u2192        pytest.param(POINTZM_NAN_WKB, 0, id=\"POINTZM_NAN_WKB\"),\n  1003\u2192        pytest.param(MULTIPOINTZM_NAN_WKB, 4, id=\"MULTIPOINTZM_NAN_WKB\"),\n  1004\u2192        pytest.param(\n  1005\u2192            GEOMETRYCOLLECTIONZM_NAN_WKB, 7, id=\"GEOMETRYCOLLECTIONZM_NAN_WKB\"\n  1006\u2192        ),\n  1007\u2192        pytest.param(NESTED_COLLECTIONZM_NAN_WKB, 7, id=\"NESTED_COLLECTIONZM_NAN_WKB\"),\n  1008\u2192    ],\n  1009\u2192)\n  1010\u2192def test_from_wkb_point_empty_zm(wkb, expected_type):\n  1011\u2192    geom = shapely.from_wkb(wkb)\n  1012\u2192\n  1013\u2192    assert shapely.is_empty(geom)\n  1014\u2192    assert shapely.get_type_id(geom) == expected_type\n  1015\u2192    assert shapely.get_coordinate_dimension(geom) == 4\n  1016\u2192    assert shapely.has_z(geom)\n  1017\u2192    assert shapely.has_m(geom)\n  1018\u2192\n  1019\u2192\n  1020\u2192def test_to_wkb_point_empty_srid():\n  1021\u2192    expected = shapely.set_srid(empty_point, 4236)\n  1022\u2192    wkb = shapely.to_wkb(expected, include_srid=True)\n  1023\u2192    actual = shapely.from_wkb(wkb)\n  1024\u2192    assert shapely.get_srid(actual) == 4236\n  1025\u2192\n  1026\u2192\n  1027\u2192@pytest.mark.parametrize(\"geom\", all_types + (point_z, empty_point))\n  1028\u2192def test_pickle(geom):\n  1029\u2192 