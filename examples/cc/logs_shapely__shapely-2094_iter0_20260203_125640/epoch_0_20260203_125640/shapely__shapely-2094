s\")\n   286\u2192\n   287\u2192    invalid_handler = np.uint8(DecodingErrorOptions.get_value(on_invalid))\n   288\u2192\n   289\u2192    return lib.from_wkt(geometry, invalid_handler, **kwargs)\n   290\u2192\n   291\u2192\n   292\u2192def from_wkb(geometry, on_invalid=\"raise\", **kwargs):\n   293\u2192    r\"\"\"Create geometries from the Well-Known Binary (WKB) representation.\n   294\u2192\n   295\u2192    The Well-Known Binary format is defined in the `OGC Simple Features\n   296\u2192    Specification for SQL <https://www.opengeospatial.org/standards/sfs>`__.\n   297\u2192\n   298\u2192    Parameters\n   299\u2192    ----------\n   300\u2192    geometry : str or array_like\n   301\u2192        The WKB byte object(s) to convert.\n   302\u2192    on_invalid : {\"raise\", \"warn\", \"ignore\"}, default \"raise\"\n   303\u2192        - raise: an exception will be raised if a WKB input geometry is invalid.\n   304\u2192        - warn: a warning will be raised and invalid WKB geometries will be\n   305\u2192          returned as ``None``.\n   306\u2192        - ignore: invalid WKB geometries will be returned as ``None`` without a warning.\n   307\u2192    **kwargs\n   308\u2192        See :ref:`NumPy ufunc docs <ufuncs.kwargs>` for other keyword arguments.\n   309\u2192\n   310\u2192    Examples\n   311\u2192    --------\n   312\u2192    >>> from_wkb(b'\\x01\\x01\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\xf0?\\x00\\x00\\x00\\x00\\x00\\x00\\xf0?')\n   313\u2192    <POINT (1 1)>\n   314\u2192\n   315\u2192    \"\"\"  # noqa: E501\n   316\u2192    if not np.isscalar(on_invalid):\n   317\u2192        raise TypeError(\"on_invalid only accepts scalar values\")\n   318\u2192\n   319\u2192    invalid_handler = np.uint8(DecodingErrorOptions.get_value(on_invalid))\n   320\u2192\n   321\u2192    # ensure the input has object dtype, to avoid numpy inferring it as a\n   322\u2192    # fixed-length string dtype (which removes trailing null bytes upon access\n   323\u2192    #