ion_test_state\": {\"plain_friends\": []}},\n   470→                ),\n   471→                (\n   472→                    \"list_mutation_test_state.make_friend\",\n   473→                    {\"list_mutation_test_state\": {\"plain_friends\": [\"another-fd\"]}},\n   474→                ),\n   475→            ],\n   476→            id=\"delitem then append\",\n   477→        ),\n   478→        pytest.param(\n   479→            [\n   480→                (\n   481→                    \"list_mutation_test_state.make_friends_with_colleagues\",\n   482→                    {\n   483→                        \"list_mutation_test_state\": {\n   484→                            \"plain_friends\": [\"Tommy\", \"Peter\", \"Jimmy\"]\n   485→                        }\n   486→                    },\n   487→                ),\n   488→                (\n   489→                    \"list_mutation_test_state.remove_tommy\",\n   490→                    {\"list_mutation_test_state\": {\"plain_friends\": [\"Peter\", \"Jimmy\"]}},\n   491→                ),\n   492→                (\n   493→                    \"list_mutation_test_state.remove_last_friend\",\n   494→                    {\"list_mutation_test_state\": {\"plain_friends\": [\"Peter\"]}},\n   495→                ),\n   496→                (\n   497→                    \"list_mutation_test_state.unfriend_all_friends\",\n   498→                    {\"list_mutation_test_state\": {\"plain_friends\": []}},\n   499→                ),\n   500→            ],\n   501→            id=\"extend, remove, pop, clear\",\n   502→        ),\n   503→        pytest.param(\n   504→            [\n   505→                (\n   506→                    \"list_mutation_test_state.add_jimmy_to_second_group\",\n   507→                    {\n   508→                        \"list_mutation_test_state\": {\n   509→                            \"friends_in_nested_list\": [[\"Tommy\"], [\"Jenny\", \"Jimmy\"]]\n   510→                        }\n   511→          