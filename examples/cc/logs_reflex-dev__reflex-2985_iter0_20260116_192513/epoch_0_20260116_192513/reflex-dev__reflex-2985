 \"address\": [{}, {\"work\": \"work address\"}]\n   655→                        }\n   656→                    },\n   657→                ),\n   658→                (\n   659→                    \"dict_mutation_test_state.add_street_to_home_address\",\n   660→                    {\n   661→                        \"dict_mutation_test_state\": {\n   662→                            \"address\": [\n   663→                                {\"street\": \"street address\"},\n   664→                                {\"work\": \"work address\"},\n   665→                            ]\n   666→                        }\n   667→                    },\n   668→                ),\n   669→            ],\n   670→            id=\"dict in list\",\n   671→        ),\n   672→        pytest.param(\n   673→            [\n   674→                (\n   675→                    \"dict_mutation_test_state.change_friend_name\",\n   676→                    {\n   677→                        \"dict_mutation_test_state\": {\n   678→                            \"friend_in_nested_dict\": {\n   679→                                \"name\": \"Nikhil\",\n   680→                                \"friend\": {\"name\": \"Tommy\"},\n   681→                            }\n   682→                        }\n   683→                    },\n   684→                ),\n   685→                (\n   686→                    \"dict_mutation_test_state.add_friend_age\",\n   687→                    {\n   688→                        \"dict_mutation_test_state\": {\n   689→                            \"friend_in_nested_dict\": {\n   690→                                \"name\": \"Nikhil\",\n   691→                                \"friend\": {\"name\": \"Tommy\", \"age\": 30},\n   692→                            }\n   693→                        }\n   694→                    },\n   695→                ),\n   696→                (\n   697→                    \"dict_mutation_test_state.remove_friend\",\n   698→                    {\n   699→                        \"dict_mutation_test_state\": {\n   700→                            \"friend_in_nested_dict\": {\"name\": \"Nikhil\"}\n   701→                        }\n   702→                    },\n   703→                ),\n   704→            ],\n   705→            id=\"nested dict\",\n   706→        ),\n   707→    ],\n   708→)\n   709→async def test_dict_mutation_detection__plain_list(\n   710→    event_tuples: List[Tuple[str, List[str]]],\n   711→    dict_mutation_state: State,\n   712→    token: str,\n   713→):\n   714→    \"\"\"Test dict mutation detection\n   715→    when reassignment is not explicitly included in the logic.\n   716→\n   717→    Args:\n   718→        event_tuples: From parametrization.\n   719→        dict_mutation_state: A state with dict mutation features.\n   720→        token: a Token.\n   721→    \"\"\"\n   722→    for event_name, expected_delta in event_tuples:\n   723→        result = await dict_mutation_state._process(\n   724→            Event(\n   725→                token=token,\n   726→                name=event_name,\n   727→                router_data={\"pathname\": \"/\", \"query\": {}},\n   728→                payload={},\n   729→            )\n   730→        ).__anext__()\n   731→\n   732→        assert result.delta == expected_delta\n   733→\n   734→\n   735→@pytest.mark.asyncio\n   736→@pytest.mark.parametrize(\n   737→    (\"state\", \"delta\"),\n   738→    [\n   739→        (\n   740→            FileUploadState,\n   741→            {\"state.file_upload_state\": {\"img_list\": [\"image1.jpg\", \"image2.jpg\"]}},\n   742→        ),\n   743→        (\n   744→            ChildFileUploadState,\n   745→            {\n   746→                \"state.file_state_base1.child_file_upload_state\": {\n   747→                    \"img_list\": [\"image1.jpg\", \"image2.jpg\"]\n   748→                }\n   749→            },\n   750→        ),\n   751→        (\n   752→            GrandChildFileUploadState,\n   753→            {\n   754→                \"state.file_state_base1.file_state_base2.grand_child_file_upload_state\": {\n   755→                    \"img_list\": [\"image1.jpg\", \"image2.jpg\"]\n   756→                }\n   757→            },\n   758→        ),\n   759→    ],\n   760→)\n   761→async def test_upload_file(tmp_path, state, delta, token: str, mocker):\n   762→    \"\"\"Test that file upload works correctly.\n   763→\n   764→    Args:\n   765→        tmp_path: Temporary path.\n   766→        state: The state class.\n   767→        delta: Expected delta\n   768→        token: a Token.\n   769→        mocker: pytest mocker object.\n   770→    \"\"\"\n   771→    mocker.patch(\n   772→        \"reflex.state.State.class_subclasses\",\n   773→        {state if state is FileUploadState else FileStateBase1},\n   774→    )\n   775→    state._tmp_path = tmp_path\n   776→    # The App state must be the \"root\" of the state tree\n   777→    app = App(state=State)\n   778→    app.event_namespace.emit = AsyncMock()  # type: ignore\n   779→    current_state = await app.state_manager.get_state(_substate_key(token, state))\n   780→    data = b\"This is binary data\"\n   781→\n   782→    # Create a binary IO object and write data to it\n   783→    bio = io.BytesIO()\n   784→    bio.write(data)\n   785→\n   786→    request_mock = unittest.mock.Mock()\n   787→    request_mock.headers = {\n   788→        \"reflex-client-token\": token,\n   789→        \"reflex-event-handler\": f\"{state.get_full_name()}.multi_handle_upload\",\n   790→    }\n   791→\n   792→    file1 = UploadFile(\n   793→        filename=f\"image1.jpg\",\n   794→        file=bio,\n   795→    )\n   796→    file2 = UploadFile(\n   797→        filename=f\"image2.jpg\",\n   798→        file=bio,\n   799→    )\n   800→    upload_fn = upload(app)\n   801→    streaming_response = await upload_fn(request_mock, [file1, file2])\n   802→    async for state_update in streaming_response.body_iterator:\n   803→        assert (\n   804→            state_update\n   805→            == StateUpdate(delta=delta, events=[], final=True).json() + \"\\n\"\n   806→        )\n   807→\n   808→    current_state = await app.state_manager.get_state(_substate_key(token, state))\n   809→    state_dict = current_state.dict()[state.get_full_name()]\n   810→    assert state_dict[\"img_list\"] == [\n   811→        \"image1.jpg\",\n   812→        \"image2.jpg\",\n   813→    ]\n   814→\n   815→    if isinstance(app.state_manager, StateManagerRedis):\n   816→        await app.state_manager.close()\n   817→\n   818→\n   819→@pytest.mark.asyncio\n   820→@pytest.mark.parametrize(\n   821→    \"state\",\n   822→    [FileUploadState, ChildFileUploadState, GrandChildFileUploadState],\n   823→)\n   824→async def test_upload_file_without_annotation(state, tmp_path, token):\n   825→    \"\"\"Test that an error is thrown when there's no param annotated with rx.UploadFile or List[UploadFile].\n   826→\n   827→    Args:\n   828→        state: The state class.\n   829→        tmp_path: Temporary path.\n   830→        token: a Token.\n   831→    \"\"\"\n   832→    state._tmp_path = tmp_path\n   833→    app = App(state=State)\n   834→\n   835→    request_mock = unittest.mock.Mock()\n   836→    request_mock.headers = {\n   837→        \"reflex-client-token\": token,\n   838→        \"reflex-event-handler\": f\"{state.get_full_name()}.handle_upload2\",\n   839→    }\n   840→    file_mock = unittest.mock.Mock(filename=\"image1.jpg\")\n   841→    fn = upload(app)\n   842→    with pytest.raises(ValueError) as err:\n   843→        await fn(request_mock, [file_mock])\n   844→    assert (\n   845→        err.value.args[0]\n   846→        == f\"`{state.get_full_name()}.handle_upload2` handler should have a parameter annotated as List[rx.UploadFile]\"\n   847→    )\n   848→\n   849→    if isinstance(app.state_manager, StateManagerRedis):\n   850→        await app.state_manager.close()\n   851→\n   852→\n   853→@pytest.mark.asyncio\n   854→@pytest.mark.parametrize(\n   855→    \"state\",\n   856→    [FileUploadState, ChildFileUploadState, GrandChildFileUploadState],\n   857→)\n   858→async def test_upload_file_background(state, tmp_path, token):\n   859→    \"\"\"Test that an error is thrown handler is a background task.\n   860→\n   861→    Args:\n   862→        state: The state class.\n   863→        tmp_path: Temporary path.\n   864→        token: a Token.\n   865→    \"\"\"\n   866→    state._tmp_path = tmp_path\n   867→    app = App(state=State)\n   868→\n   869→    request_mock = unittest.mock.Mock()\n   870→    request_mock.headers = {\n   871→        \"reflex-client-token\": token,\n   872→        \"reflex-event-handler\": f\"{state.get_full_name()}.bg_upload\",\n   873→    }\n   874→    file_mock = unittest.mock.Mock(filename=\"image1.jpg\")\n   875→    fn = upload(app)\n   876→    with pytest.raises(TypeError) as err:\n   877→        await fn(request_mock, [file_mock])\n   878→    assert (\n   879→        err.value.args[0]\n   880→        == f\"@rx.background is not supported for upload handler `{state.get_full_name()}.bg_upload`.\"\n   881→    )\n   882→\n   883→    if isinstance(app.state_manager, StateManagerRedis):\n   884→        await app.state_manager.close()\n   885→\n   886→\n   887→class DynamicState(BaseState):\n   888→    \"\"\"State class for testing dynamic route var.\n   889→\n   890→    This is defined at module level because event handlers cannot be addressed\n   891→    correctly when the class is defined as a local.\n   892→\n   893→    There are several counters:\n   894→      * loaded: counts how many times `on_load` was triggered by the hydrate middleware\n   895→      * counter: counts how many times `on_counter` was triggered by a non-navigational event\n   896→          -> these events should NOT trigger reload or recalculation of router_data dependent vars\n   897→      * side_effect_counter: counts how many times a computed var was\n   898→        recalculated when the dynamic route var was dirty\n   899→    \"\"\"\n   900→\n   901→    is_hydrated: bool = False\n   902→    loaded: int = 0\n   903→    counter: int = 0\n   904→\n   905→    # side_effect_counter: int = 0\n   906→\n   907→    def on_load(self):\n   908→        \"\"\"Event handler for page on_load, should trigger for all navigation events.\"\"\"\n   909→        self.loaded = self.loaded + 1\n   910→\n   911→    def on_counter(self):\n   912→        \"\"\"Increment the counter var.\"\"\"\n   913→        self.counter = self.counter + 1\n   914→\n   915→    @ComputedVar\n   916→    def comp_dynamic(self) -> str:\n   917→        \"\"\"A computed var that depends on the dynamic var.\n   918→\n   919→        Returns:\n   920→            same as self.dynamic\n   921→        \"\"\"\n   922→        # self.side_effect_counter = self.side_effect_counter + 1\n   923→        return self.dynamic\n   924→\n   925→    on_load_internal = OnLoadInternalState.on_load_internal.fn\n   926→\n   927→\n   928→@pytest.mark.asyncio\n   929→async def test_dynamic_route_var_route_change_completed_on_load(\n   930→    index_page,\n   931→    windows_platform: bool,\n   932→    token: str,\n   933→    app_module_mock: unittest.mock.Mock,\n   934→    mocker,\n   935→):\n   936→    \"\"\"Create app with dynamic route var, and simulate navigation.\n   937→\n   938→    on_load should fire, allowing any additional vars to be updated before the\n   939→    initial page hydrate.\n   940→\n   941→    Args:\n   942→        index_page: The index page.\n   943→        windows_platform: Whether the system is windows.\n   944→        token: a Token.\n   945→        app_module_mock: Mocked app module.\n   946→        mocker: pytest mocker object.\n   947→    \"\"\"\n   948→    arg_name = \"dynamic\"\n   949→    route = f\"/test/[{arg_name}]\"\n   950→    if windows_platform:\n   951→        route.lstrip(\"/\").replace(\"/\", \"\\\\\")\n   952→    app = app_module_mock.app = App(state=DynamicState)\n   953→    assert arg_name not in app.state.vars\n   954→    app.add_page(index_page, route=route, on_load=DynamicState.on_load)  # type: ignore\n   955→    assert arg_name in app.state.vars\n   956→    assert arg_name in app.state.computed_vars\n   957→    assert app.state.computed_vars[arg_name]._deps(objclass=DynamicState) == {\n   958→        constants.ROUTER\n   959→    }\n   960→    assert constants.ROUTER in app.state()._computed_var_dependencies\n   961→\n   962→    substate_token = _substate_key(token, DynamicState)\n   963→    sid = \"mock_sid\"\n   964→    client_ip = \"127.0.0.1\"\n   965→    state = await app.state_manager.get_state(substate_token)\n   966→    assert state.dynamic == \"\"\n   967→    exp_vals = [\"foo\", \"foobar\", \"baz\"]\n   968→\n   969→    def _event(name, val, **kwargs):\n   970→        return Event(\n   971→            token=kwargs.pop(\"token\", token),\n   972→            name=name,\n   973→            router_data=kwargs.pop(\n   974→                \"router_data\", {\"pathname\": route, \"query\": {arg_name: val}}\n   975→            ),\n   976→            payload=kwargs.pop(\"payload\", {}),\n   977→            **kwargs,\n   978→        )\n   979→\n   980→    def _dynamic_state_event(name, val, **kwargs):\n   981→        return _event(\n   982→            name=format.format_event_handler(getattr(DynamicState, name)),  # type: ignore\n   983→            val=val,\n   984→            **kwargs,\n   985→        )\n   986→\n   987→    prev_exp_val = \"\"\n   988→    for exp_index, exp_val in enumerate(exp_vals):\n   989→        on_load_internal = _event(\n   990→            name=f\"{state.get_full_name()}.{constants.CompileVars.ON_LOAD_INTERNAL.rpartition('.')[2]}\",\n   991→            val=exp_val,\n   992→        )\n   993→        exp_router_data = {\n   994→            \"headers\": {},\n   995→            \"ip\": client_ip,\n   996→            \"sid\": sid,\n   997→            \"token\": token,\n   998→            **on_load_internal.router_data,\n   999→        }\n  1000→        exp_router = RouterData(exp_router_data)\n  1001→        process_coro = process(\n  1002→            app,\n  1003→            event=on_load_internal,\n  1004→            sid=sid,\n  1005→            headers={},\n  1006→            client_ip=client_ip,\n  1007→        )\n  1008→        update = await process_coro.__anext__()\n  1009→        # route change (on_load_internal) triggers: [call on_load events, call set_is_hydrated(True)]\n  1010→        assert update == StateUpdate(\n  1011→            delta={\n  1012→                state.get_name(): {\n  1013→                    arg_name: exp_val,\n  1014→                    f\"comp_{arg_name}\": exp_val,\n  1015→                    constants.CompileVars.IS_HYDRATED: False,\n  1016→                    # \"side_effect_counter\": exp_index,\n  1017→                    \"router\": exp_router,\n  1018→                }\n  1019→            },\n  1020→            events=[\n  1021→                _dynamic_state_event(\n  1022→                    name=\"on_load\",\n  1023→                    val=exp_val,\n  1024→                ),\n  1025→                _event(\n  1026→                    name=\"state.set_is_hydrated\",\n  1027→                    payload={\"value\": True},\n  1028→                    val=exp_val,\n  1029→                    router_data={},\n  1030→                ),\n  1031→            ],\n  1032→        )\n  1033→        if isinstance(app.state_manager, StateManagerRedis):\n  1034→            # When redis is used, the state is not updated until the processing is complete\n  1035→            state = await app.state_manager.get_state(substate_token)\n  1036→            assert state.dynamic == prev_exp_val\n  1037→\n  1038→        # complete the processing\n  1039→        with pytest.raises(StopAsyncIteration):\n  1040→            await process_coro.__anext__()\n  1041→\n  1042→        # check that router data was written to the state_manager store\n  1043→        state = await app.state_manager.get_state(substate_token)\n  1044→        assert state.dynamic == exp_val\n  1045→\n  1046→        process_coro = process(\n  1047→            app,\n  1048→            event=_dynamic_state_event(name=\"on_load\", val=exp_val),\n  1049→            sid=sid,\n  1050→            headers={},\n  1051→            client_ip=client_ip,\n  1052→        )\n  1053→        on_load_update = await process_coro.__anext__()\n  1054→        assert on_load_update == StateUpdate(\n  1055→            delta={\n  1056→                state.get_name(): {\n  1057→                    # These computed vars _shouldn't_ be here, because they didn't change\n  1058→                    arg_name: exp_val,\n  1059→                    f\"comp_{arg_name}\": exp_val,\n  1060→                    \"loaded\": exp_index + 1,\n  1061→                },\n  1062→            },\n  1063→            events=[],\n  1064→        )\n  1065→        # complete the processing\n  1066→        with pytest.raises(StopAsyncIteration):\n  1067→            await process_coro.__anext__()\n  1068→        process_coro = process(\n  1069→            app,\n  1070→            event=_dynamic_state_event(\n  1071→                name=\"set_is_hydrated\", payload={\"value\": True}, val=exp_val\n  1072→            ),\n  1073→            sid=sid,\n  1074→            headers={},\n  1075→            client_ip=client_ip,\n  1076→        )\n  1077→        on_set_is_hydrated_update = await process_coro.__anext__()\n  1078→        assert on_set_is_hydrated_update == StateUpdate(\n  1079→            delta={\n  1080→                state.get_name(): {\n  1081→                    # These computed vars _shouldn't_ be here, because they didn't change\n  1082→                    arg_name: exp_val,\n  1083→                    f\"comp_{arg_name}\": exp_val,\n  1084→                    \"is_hydrated\": True,\n  1085→                },\n  1086→            },\n  1087→            events=[],\n  1088→        )\n  1089→        # complete the processing\n  1090→        with pytest.raises(StopAsyncIteration):\n  1091→            await process_coro.__anext__()\n  1092→\n  1093→        # a simple state update event should NOT trigger on_load or route var side effects\n  1094→        process_coro = process(\n  1095→            app,\n  1096→            event=_dynamic_state_event(name=\"on_counter\", val=exp_val),\n  1097→            sid=sid,\n  1098→            headers={},\n  1099→            client_ip=client_ip,\n  1100→        )\n  1101→        update = await process_coro.__anext__()\n  1102→        assert update == StateUpdate(\n  1103→            delta={\n  1104→                state.get_name(): {\n  1105→                    # These computed vars _shouldn't_ be here, because they didn't change\n  1106→                    f\"comp_{arg_name}\": exp_val,\n  1107→                    arg_name: exp_val,\n  1108→                    \"counter\": exp_index + 1,\n  1109→                }\n  1110→            },\n  1111→            events=[],\n  1112→        )\n  1113→        # complete the processing\n  1114→        with pytest.raises(StopAsyncIteration):\n  1115→            await process_coro.__anext__()\n  1116→\n  1117→        prev_exp_val = exp_val\n  1118→    state = await app.state_manager.get_state(substate_token)\n  1119→    assert state.loaded == len(exp_vals)\n  1120→    assert state.counter == len(exp_vals)\n  1121→    # print(f\"Expected {exp_vals} rendering side effects, got {state.side_effect_counter}\")\n  1122→    # assert state.side_effect_counter == len(exp_vals)\n  1123→\n  1124→    if isinstance(app.state_manager, StateManagerRedis):\n  1125→        await app.state_manager.close()\n  1126→\n  1127→\n  1128→@pytest.mark.asyncio\n  1129→async def test_process_events(mocker, token: str):\n  1130→    \"\"\"Test that an event is processed properly and that it is postprocessed\n  1131→    n+1 times. Also check that the processing flag of the last stateupdate is set to\n  1132→    False.\n  1133→\n  1134→    Args:\n  1135→        mocker: mocker object.\n  1136→        token: a Token.\n  1137→    \"\"\"\n  1138→    router_data = {\n  1139→        \"pathname\": \"/\",\n  1140→        \"query\": {},\n  1141→        \"token\": token,\n  1142→        \"sid\": \"mock_sid\",\n  1143→        \"headers\": {},\n  1144→        \"ip\": \"127.0.0.1\",\n  1145→    }\n  1146→    app = App(state=GenState)\n  1147→    mocker.patch.object(app, \"postprocess\", AsyncMock())\n  1148→    event = Event(\n  1149→        token=token, name=\"gen_state.go\", payload={\"c\": 5}, router_data=router_data\n  1150→    )\n  1151→\n  1152→    async for _update in process(app, event, \"mock_sid\", {}, \"127.0.0.1\"):\n  1153→        pass\n  1154→\n  1155→    assert (await app.state_manager.get_state(event.substate_token)).value == 5\n  1156→    assert app.postprocess.call_count == 6\n  1157→\n  1158→    if isinstance(app.state_manager, StateManagerRedis):\n  1159→        await app.state_manager.close()\n  1160→\n  1161→\n  1162→@pytest.mark.parametrize(\n  1163→    (\"state\", \"overlay_component\", \"exp_page_child\"),\n  1164→    [\n  1165→        (None, default_overlay_component, None),\n  1166→        (None, None, None),\n  1167→        (None, Text.create(\"foo\"), Text),\n  1168→        (State, default_overlay_component, Fragment),\n  1169→        (State, None, None),\n  1170→        (State, Text.create(\"foo\"), Text),\n  1171→        (State, lambda: Text.create(\"foo\"), Text),\n  1172→    ],\n  1173→)\n  1174→def test_overlay_component(\n  1175→    state: State | None,\n  1176→    overlay_component: Component | ComponentCallable | None,\n  1177→    exp_page_child: Type[Component] | None,\n  1178→):\n  1179→    \"\"\"Test that the overlay component is set correctly.\n  1180→\n  1181→    Args:\n  1182→        state: The state class to pass to App.\n  1183→        overlay_component: The overlay_component to pass to App.\n  1184→        exp_page_child: The type of the expected child in the page fragment.\n  1185→    \"\"\"\n  1186→    app = App(state=state, overlay_component=overlay_component)\n  1187→    app._setup_overlay_component()\n  1188→    if exp_page_child is None:\n  1189→        assert app.overlay_component is None\n  1190→    elif isinstance(exp_page_child, OverlayFragment):\n  1191→        assert app.overlay_component is not None\n  1192→        generated_component = app._generate_component(app.overlay_component)  # type: ignore\n  1193→        assert isinstance(generated_component, OverlayFragment)\n  1194→        assert isinstance(\n  1195→            generated_component.children[0],\n  1196→            Cond,  # ConnectionModal is a Cond under the hood\n  1197→        )\n  1198→    else:\n  1199→        assert app.overlay_component is not None\n  1200→        assert isinstance(\n  1201→            app._generate_component(app.overlay_component),  # type: ignore\n  1202→            exp_page_child,\n  1203→        )\n  1204→\n  1205→    app.add_page(rx.box(\"Index\"), route=\"/test\")\n  1206→    # overlay components are wrapped during compile only\n  1207→    app._setup_overlay_component()\n  1208→    page = app.pages[\"test\"]\n  1209→\n  1210→    if exp_page_child is not None:\n  1211→        assert len(page.children) == 3\n  1212→        children_types = (type(child) for child in page.children)\n  1213→        assert exp_page_child in children_types\n  1214→    else:\n  1215→        assert len(page.children) == 2\n  1216→\n  1217→\n  1218→@pytest.fixture\n  1219→def compilable_app(tmp_path) -> Generator[tuple[App, Path], None, None]:\n  1220→    \"\"\"Fixture for an app that can be compiled.\n  1221→\n  1222→    Args:\n  1223→        tmp_path: Temporary path.\n  1224→\n  1225→    Yields:\n  1226→        Tuple containing (app instance, Path to \".web\" directory)\n  1227→\n  1228→        The working directory is set to the app dir (parent of .web),\n  1229→        allowing app.compile() to be called.\n  1230→    \"\"\"\n  1