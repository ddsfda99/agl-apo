      file.write(merged_pyproject)\n   695\u2192\n   696\u2192    def migrate_necessary_files(self, project_dir, test_source_dir, module_name):\n   697\u2192        \"\"\"Copy and merge the necessary files from project_dir to the current base path.\n   698\u2192\n   699\u2192        Will warn a LICENSE or CHANGELOG file is missing.\n   700\u2192\n   701\u2192        :param project_dir: The path to the project created by the cookiecutter.\n   702\u2192        :param test_source_dir: The path to the directory that should contain the test\n   703\u2192            entry script\n   704\u2192        \"\"\"\n   705\u2192        self.merge_or_copy_pyproject(project_dir / \"pyproject.toml\")\n   706\u2192\n   707\u2192        # Copy license file if not already there\n   708\u2192        license_file = self.pep621_data.get(\"license\", {}).get(\"file\")\n   709\u2192\n   710\u2192        if license_file is None and not (self.base_path / \"LICENSE\").exists():\n   711\u2192            self.logger.warning(\n   712\u2192                f\"\\nLicense file not found in '{self.base_path}'. \"\n   713\u2192                \"Briefcase will create a template 'LICENSE' file.\"\n   714\u2192            )\n   715\u2192            copy2(project_dir / \"LICENSE\", self.base_path / \"LICENSE\")\n   716\u2192\n   717\u2192        # Copy changelog file\n   718\u2192        changelog_file = self.base_path / \"CHANGELOG\"\n   719\u2192        if not changelog_file.is_file():\n   720\u2192            self.logger.warning(\n   721\u2192                f\"\\nChangelog file not found in '{self.base_path}'. You should either \"\n   722\u2192                f\"create a new '{self.base_path / 'CHANGELOG'}' file, or rename an \"\n   723\u2192                \"already existing changelog file to 'CHANGELOG'.\"\n   724\u2192            )\n   725\u2192\n   726\u2192        # Copy tests or test entry script\n   727\u2192        test_path = self.base_path / test_source_dir\n   728\u2192        if test_path.ex