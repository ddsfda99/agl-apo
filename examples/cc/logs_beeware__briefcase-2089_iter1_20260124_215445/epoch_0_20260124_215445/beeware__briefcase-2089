→        default_app_name = self.make_app_name(formal_name)\n   475→        app_name = self.input_text(\n   476→            intro=(\n   477→                \"Next, we need a name that can serve as a machine-readable Python \"\n   478→                \"package name for your application.\\n\"\n   479→                \"\\n\"\n   480→                \"This name must be PEP508-compliant - that means the name may only \"\n   481→                \"contain letters, numbers, hyphens and underscores; it can't contain \"\n   482→                \"spaces or punctuation, and it can't start with a hyphen or \"\n   483→                \"underscore.\\n\"\n   484→                \"\\n\"\n   485→                \"Based on your formal name, we suggest an app name of \"\n   486→                f\"{default_app_name!r}, but you can use another name if you want.\"\n   487→            ),\n   488→            variable=\"app name\",\n   489→            default=default_app_name,\n   490→            validator=self.validate_app_name,\n   491→            override_value=project_overrides.pop(\"app_name\", None),\n   492→        )\n   493→\n   494→        # The module name can be completely derived from the app name.\n   495→        module_name = self.make_module_name(app_name)\n   496→        source_dir = f\"src/{module_name}\"\n   497→        test_source_dir = \"tests\"\n   498→\n   499→        bundle = self.input_text(\n   500→            intro=(\n   501→                \"Now we need a bundle identifier for your application.\\n\"\n   502→                \"\\n\"\n   503→                \"App stores need to protect against having multiple applications with \"\n   504→                \"the same name; the bundle identifier is the namespace they use to \"\n   505→                \"identify applications that come from you. The bundle identifier is \"\n   506→                \"usually the domain name of your company or project, in reverse order.\\n\"\n   507→                \"\\n\"\n   508→            