et_source_dir_hint(self, app_name: str, module_name: str) -> tuple[str, str]:\n   166→        \"\"\"Parse folder layout to get hint for the source directory.\n   167→\n   168→        :returns: The source directory hint\n   169→        :returns: The description text for the source dir prompt.\n   170→        \"\"\"\n   171→        possible_src_dirs = [\n   172→            p.parent for p in self.base_path.glob(f\"**/{module_name}/__main__.py\")\n   173→        ]\n   174→        if (self.base_path / f\"src/{module_name}\") in possible_src_dirs:\n   175→            default = self.base_path / f\"src/{module_name}\"\n   176→        elif (self.base_path / module_name) in possible_src_dirs:\n   177→            default = self.base_path / module_name\n   178→        elif possible_src_dirs:\n   179→            default = min(\n   180→                possible_src_dirs,\n   181→                key=lambda p: (len(p.parents), len(str(p))),\n   182→            )\n   183→        else:  # We have already checked that there are directories in the project root\n   184→            raise BriefcaseCommandError(\n   185→                \"Cannot find a suitable source directory for the app.\\n\"\n   186→                \"\\n\"\n   187→                f\"Based on your app name, '{app_name}', you must have a directory \"\n   188→                f\"named '{module_name}', either in your project root or a subdirectory \"\n   189→                f\"(e.g. 'src/{module_name}'), that contains a '__main__.py'.\"\n   190→            )\n   191→\n   192→        default = str(default.relative_to(self.base_path)).replace(\"\\\\\", \"/\")\n   193→        intro = (\n   194→            \"To set up an existing project for Briefcase, we need to know the path \"\n   195→            \"of the application entry point relative to the project root (the current \"\n   196→            \"working directory).\\n\"\n   197→            \"\\n\"\n   198→            \"For example, if you have an existing project 'myapp', and you can start \"\n   199→            \"'myapp' by running 'src/myapp/__main__.py', then you should set the source \"\n   200→            \"directory to 'src/myapp'.\\n\"\n   201→            \"\\n\"\n   202→            f\"Based on your project's folder layout, we believe it might be '{default}'.\"\n   203→        )\n   204→        return default, intro\n   205→\n   206→    def input_source_dir(\n   207→        self,\n   208→        app_name: str,\n   209→        module_name: str,\n   210→        override_value: str | None,\n   211→    ) -> str:\n   212→        \"\"\"Ask about the source dir, using hints from the project folder layout.\n   213→\n   214→        :returns: The source directory\n   215→        \"\"\"\n   216→        default, intro = self.get_source_dir_hint(app_name, module_name)\n   217→        return self.input_text(\n   218→            intro=intro,\n   219→            variable=\"source directory\",\n   220→            default=default,\n   221→            validator=partial(self.validate_source_dir, module_name),\n   222→            override_value=override_value,\n   223→        )\n   224→\n   225→    def input_test_source_dir(self, module_name, override_value) -> str:\n   226→        \"\"\"Ask about the test source dir, using hints from the project folder layout.\n   227→\n   228→        :returns: The test source directory\n   229→        \"\"\"\n   230→        intro = (\n   231→            \"We also need to know the path to the test suite (if it exists). The test path \"\n   232→            \"should be relative to the project root directory.\\n\"\n   233→            \"\\n\"\n   234→            \"If the provided directory doesn't exist, it will be created and populated with \"\n   235→            \"some default test files.\"\n   236→        )\n   237→        if (self.base_path / \"tests\").is_dir():\n   238→            default = \"tests\"\n   239→            intro += (\n   240→                \"\\n\\nBased on your project's folder structure, we believe \"\n   241→                + \"'tests' might be your test directory\"\n   242→            )\n   243→        elif (self.base_path / \"test\").is_dir():\n   244→            default = \"test\"\n   245→            intro += (\n   246→                \"\\n\\nBased on your project's folder structure, we believe \"\n   247→                \"'test' might be your test directory\"\n   248→            )\n   249→        else:\n   250→            default = \"tests\"\n   251→\n   252→        return self.input_text(\n   253→            intro=intro,\n   254→            variable=\"test source directory\",\n   255→            default=default,\n   256→            validator=partial(self.validate_test_source_dir, module_name),\n   257→            override_value=override_value,\n   258→        )\n   259→\n   260→    def input_description(self, override_value: str | None) -> str:\n   261→        \"\"\"Ask about the app description, using hints from the pyproject.toml file if\n   262→        there are any.\n   263→\n   264→        If the description is specified in a PEP621 compliant pyproject.toml file, then\n   265→        it is used without prompting.\n   266→\n   267→        :returns: The app description\n   268→        \"\"\"\n   269→        if \"description\" in self.pep621_data and override_value is None:\n   270→            description = self.pep621_data[\"description\"]\n   271→\n   272→            self.prompt_divider(title=\"Description\")\n   273→            self.input.prompt()\n   274→            self.input.prompt(\n   275→                f\"Using value from PEP621 formatted pyproject.toml {description!r}\"\n   276→            )\n   277→            return description\n   278→\n   279→        return self.input_text(\n   280→            intro=\"Now, we need a one line description for your application.\",\n   281→            variable=\"description\",\n   282→            default=\"My first application\",\n   283→            override_value=override_value,\n   284→        )\n   285→\n   286→    def input_url(self, app_name, override_value: str | None) -> str:\n   287→        \"\"\"Ask about the URL, using hints from the pyproject.toml file if there are any.\n   288→\n   289→        :returns: The project\n   290→        \"\"\"\n   291→        options = list(self.pep621_data.get(\"urls\", {}).values())\n   292→\n   293→        if not options or override_value:\n   294→            default = self.make_project_url(\"com.example\", app_name)\n   295→            return self.input_text(\n   296→                intro=(\n   297→                    \"What website URL do you want to use for this application? Based \"\n   298→                    f\"on your existing 'pyproject.toml', this might be {default}\"\n   299→                ),\n   300→                variable=\"application URL\",\n   301→                default=default,\n   302→                validator=validate_url,\n   303→                override_value=override_value,\n   304→            )\n   305→\n   306→        options.append(\"Other\")\n   307→        url = self.select_option(\n   308→            intro=(\n   309→                \"What website URL do you want to use for this application? The \"\n   310→                \"following URLs are defined in your existing 'pyproject.toml'; \"\n   311→                \"select 'Other' to provide a different URL.\"\n   312→            ),\n   313→            variable=\"application URL\",\n   314→            default=None,\n   315→            options=options,\n   316→            override_value=override_value,\n   317→        )\n   318→\n   319→        if url == \"Other\":\n   320→            url = self.input_text(\n   321→                intro=\"What website URL do you want to use for the application?\",\n   322→                variable=\"application URL\",\n   323→                default=self.make_project_url(\"com.example\", app_name),\n   324→                validator=validate_url,\n   325→            )\n   326→\n   327→        return url\n   328→\n   329→    def input_bundle(self, url, app_name, override_value: str | None) -> str:\n   330→        default = \".\".join(reversed(urlparse(url).netloc.split(\".\")))\n   331→        return self.input_text(\n   332→            intro=(\n   333→                \"Now we need a bundle identifier for your application.\\n\"\n   334→                \"\\n\"\n   335→                \"App stores need to protect against having multiple applications with \"\n   336→                \"the same name; the bundle identifier is the namespace they use to \"\n   337→                \"identify applications that come from you. The bundle identifier is \"\n   338→                \"usually the domain name of your company or project, in reverse \"\n   339→                \"order.\\n\"\n   340→                \"\\n\"\n   341→                \"Based on the application URL you selected, it looks like your bundle \"\n   342→                f\"should be '{default}'. The bundle will be combined with your \"\n   343→                \"application's machine readable name to form a complete application \"\n   344→                f\"identifier ('{default}.{app_name}').\"\n   345→            ),\n   346→            variable=\"bundle identifier\",\n   347→            default=default,\n   348→            validator=self.validate_bundle,\n   349→            override_value=override_value,\n   350→        )\n   351→\n   352→    def input_author(self, override_value: str | None) -> str:\n   353→        \"\"\"Ask about the author name, using hints from the pyproject.toml file if there\n   354→        are any.\n   355→\n   356→        :returns: author name\n   357→        \"\"\"\n   358→        intro = (\n   359→            \"Who do you want to be credited as the author of this application? \"\n   360→            \"This could be your own name, or the name of your company you work for.\"\n   361→        )\n   362→\n   363→        options = [\n   364→            author[\"name\"]\n   365→            for author in self.pep621_data.get(\"authors\", [])\n   366→            if \"name\" in author\n   367→        ]\n   368→\n   369→        if not options or override_value is not None:\n   370→            return self.input_text(\n   371→                intro=intro,\n   372→                variable=\"author\",\n   373→                default=\"Jane Developer\",\n   374→                override_value=override_value,\n   375→            )\n   376→        elif len(options) > 1:\n   377→            # Add a line with all authors joined: E.g. 'Jane Developer & Joe Developer'\n   378→            # and a line with Other\n   379→            options.append(\", \".join(options[:-1]) + f\" & {options[-1]}\")\n   380→\n   381→        options.append(\"Other\")\n   382→\n   383→        # We want to use the input_text-function if override_value is provided or if the selected author is \"Other\"\n   384→        # However, since we don't want the select_option prompt if an override value is provided, we need to\n   385→        # initialise the author variable here.\n   386→        author = self.select_option(\n   387→            intro=(\n   388→                intro\n   389→                + \"\\n\\n\"\n   390→                + \"We found these author names in the PEP621 formatted \"\n   391→                + \"'pyproject.toml'. Who do you want to be credited as the author of \"\n   392→                + \"this application?\"\n   393→            ),\n   394→            variable=\"Author\",\n   395→            options=options,\n   396→            default=None,\n   397→            override_value=None,\n   398→        )\n   399→        if author == \"Other\":\n   400→            author = self.input_text(\n   401→                intro=\"Who do you want to be credited as the author of this application?\",\n   402→                variable=\"author\",\n   403→                default=\"Jane Developer\",\n   404→                override_value=None,\n   405→            )\n   406→\n   407→        return author\n   408→\n   409→    def input_email(self, author: str, bundle: str, override_value: str | None) -> str:\n   410→        \"\"\"Ask about the author email, using hints from the pyproject.toml file if there\n   411→        are any.\n   412→\n   413→        :returns: author email\n   414→        \"\"\"\n   415→        default = self.make_author_email(author, bundle)\n   416→        default_source = \"the author name and bundle\"\n   417→        for author_info in self.pep621_data.get(\"authors\", []):\n   418→            if author_info.get(\"name\") == author and author_info.get(\"email\"):\n   419→                default = author_info[\"email\"]\n   420→                default_source = \"the selected author name\"\n   421→\n   422→        intro = (\n   423→            \"What email address should people use to contact the developers of this \"\n   424→            \"application? This might be your own email address, or a generic contact address \"\n   425→            f\"you set up specifically for this application. Based on {default_source}, \"\n   426→            f\"we believe it could be '{default}'.\"\n   427→        )\n   428→\n   429→        author_email = self.input_text(\n   430→            intro=intro,\n   431→            variable=\"author's email\",\n   432→            default=default,\n   433→            validator=self.validate_email,\n   434→            override_value=override_value,\n   435→        )\n   436→\n   437→        return author_email\n   438→\n   439→    def get_license_from_text(self, license_text: str) -> str:\n   440→        \"\"\"Infer the license from the license file.\"\"\"\n   441→        # The order here is quite important. If we have GPLvX+ after GPLvX, then it will\n   442→        # never be matched if the license text is GPLvX+, since it will already have\n   443→        # matched GPLvX. We search for MIT last, because words like PERMITTED and\n   444→        # LIMITED will generate a false match.\n   445→\n   446→        hint_patterns = {\n   447→            \"Apache Software License\": [\"Apache\"],\n   448            \"BSD license\": [\n   449→                \"Redistribution and use in source and binary forms\",\n   450→                \"BSD\",\n   451→            ],\n   452→            \"GNU General Public License v2 or later (GPLv2+)\": [\n   453→                \"Free Software Foundation, either version 2 of the License\",\n   454→                \"GPLv2+\",\n   455→            ],\n   456→            \"GNU General Public License v2 (GPLv2)\": [\n   457→                \"version 2 of the GNU General Public License\",\n   458→                \"GPLv2\",\n   459→            ],\n   460→            \"GNU General Public License v3 or later (GPLv3+)\": [\n   461→                \"either version 3 of the License\",\n   462→                \"GPLv3+\",\n   463→            ],\n   464→            \"GNU General Public License v3 (GPLv3)\": [\n   465→                \"version 3 of the GNU General Public License\",\n   466→                \"GPLv3\",\n   467→            ],\n   468→            \"MIT license\": [\n   469→                \"Permission is hereby granted, free of charge\",\n   470→                \"MIT\",\n   471→            ],\n   472→        }\n   473→        for hint, license_patterns in hint_patterns.items():\n   474→            for license_pattern in license_patterns:\n   475→                if license_pattern.lower() in license_text.lower():\n   476→                    return hint\n   477→\n   478→        return \"Other\"\n   479→\n   480→    def get_license_hint(self) -> tuple[str | None, str]:\n   481→        \"\"\"Get hint for project license, either by reading pyproject.toml or the license\n   482→        file.\n   483→\n   484→        :returns: The default value of the license - None if we cannot infer a license.\n   485→        :returns: The intro text to use when prompting the license\n   486→        \"\"\"\n   487→        intro = \"What license do you want to use for this project's code? \"\n   488→        default = None\n   489→\n   490→        # If there is license information in the pyproject.toml file, use that, otherwise check the license file\n   491→        if \"text\" in self.pep621_data.get(\"license\", {}):\n   492→            default = self.get_license_from_text(self.pep621_data[\"license\"][\"text\"])\n   493→            default_source = \"the PEP621 formatted pyproject.toml\"\n   494→        elif \"file\" in self.pep621_data.get(\"license\", {}):\n   495→            license_text = (\n   496→                self.base_path / self.pep621_data[\"license\"][\"file\"]\n   497→            ).read_text(encoding=\"utf-8\")\n   498→            default = self.get_license_from_text(license_text)\n   499→            default_source = \"the license file\"\n   500→        elif (self.base_path / \"LICENSE\").exists():\n   501→            license_text = (self.base_path / \"LICENSE\").read_text(encoding=\"utf-8\")\n   502→            default = self.get_license_from_text(license_text)\n   503→            default_source = \"the license file\"\n   504→        elif (self.base_path / \"LICENCE\").exists():\n   505→            license_text = (self.base_path / \"LICENCE\").read_text(encoding=\"utf-8\")\n   506→            default = self.get_license_from_text(license_text)\n   507→            default_source = \"the license file\"\n   508→        else:\n   509→            return None, intro\n   510→\n   511→        intro += f\"\\nBased on {default_source} we believe it is {default!r}.\"\n   512→        return default, intro\n   513→\n   514→    def input_license(self, override_value: str | None) -> str:\n   515→        \"\"\"Ask about the license, using hints from the pyproject.toml or license file if\n   516→        there are any.\n   517→\n   518→        :returns: The project\n   519→        \"\"\"\n   520→        default, intro = self.get_license_hint()\n   521→        options = [\n   522→            \"BSD license\",\n   523→            \"MIT license\",\n   524→            \"Apache Software License\",\n   525→            \"GNU General Public License v2 (GPLv2)\",\n   526→            \"GNU General Public License v2 or later (GPLv2+)\",\n   527→            \"GNU General Public License v3 (GPLv3)\",\n   528→            \"GNU General Public License v3 or later (GPLv3+)\",\n   529→            \"Proprietary\",\n   530→            \"Other\",\n   531→        ]\n   532→\n   533→        return self.select_option(\n   534→            intro=intro,\n   535→            variable=\"Project License\",\n   536→            options=options,\n   537→            default=default,\n   538→            override_value=override_value,\n   539→        )\n   540→\n   541→    def build_app_context(self, project_overrides):\n   542→        \"\"\"Ask the user for details about the app to be created.\n   543→\n   544→        :returns: A context dictionary to be used in the cookiecutter project template.\n   545→        \"\"\"\n   546→        app_name = self.input_app_name(\n   547→            override_value=project_overrides.pop(\"app_name\", None)\n   548→        )\n   549→        formal_name = self.input_formal_name(\n   550→            app_name, override_value=project_overrides.pop(\"formal_name\", None)\n   551→        )\n   552→        # The class name can be completely derived from the formal name.\n   553→        class_name = make_class_name(formal_name)\n   554→        # The module name can be completely derived from the app name.\n   555→        module_name = self.make_module_name(app_name)\n   556→        source_dir = self.input_source_dir(\n   557→            app_name,\n   558→            module_name,\n   559→            override_value=project_overrides.pop(\"source_dir\", None),\n   560→        )\n   561→        test_source_dir = self.input_test_source_dir(\n   562→            module_name, override_value=project_overrides.pop(\"test_source_dir\", None)\n   563→        )\n   564→        project_name = self.input_project_name(\n   565→            formal_name, override_value=project_overrides.pop(\"project_name\", None)\n   566→        )\n   567→        description = self.input_description(\n   568→            override_value=project_overrides.pop(\"description\", None)\n   569→        )\n   570→        url = self.input_url(app_name, project_overrides.pop(\"url\", None))\n   571→        bundle = self.input_bundle(url, app_name, project_overrides.pop(\"bundle\", None))\n   572→        author = self.input_author(override_value=project_overrides.pop(\"author\", None))\n   573→        author_email = self.input_email(\n   574→            author, bundle, override_value=project_overrides.pop(\"author_email\", None)\n   575→        )\n   576→        project_license = self.input_license(\n   577→            override_value=project_overrides.pop(\"license\", None)\n   578→        )\n   579→\n   580→        return {\n   581→            \"formal_name\": formal_name,\n   582→            \"app_name\": app_name,\n   583→            \"class_name\": class_name,\n   584→            \"module_name\": module_name,\n   585→            \"project_name\": project_name,\n   586→            \"source_dir\": source_dir,\n   587→            \"test_source_dir\": test_source_dir,\n   588→            \"description\": description,\n   589→            \"author\": author,\n   590→            \"author_email\": author_email,\n   591→            \"bundle\": bundle,\n   592→            \"url\": url,\n   593→            \"license\": project_license,\n   594→        }\n   595→\n   596→    def build_gui_context(\n   597→        self,\n   598→        context: dict[str, str],\n   599→        project_overrides: dict[str, str],\n   600→    ) -> dict[str, str]:\n   601→        # We must set the GUI-framework to None here since the convert-command uses the new-command\n   602→        # template. This template includes dependencies for the GUI-frameworks. However, if a project\n   603→        # already is set up for a GUI-framework, then those dependencies should already be listed.\n   604→        # To prevent the same dependency being listed twice (once in the PEP621-section and once in the\n   605→        # briefcase-section), possibly with different versions, we set the GUI-framework to None here.\n   606→        return {\"gui_framework\": \"None\"}\n   607→\n   608→    def merge_or_copy_pyproject(self, briefcase_config_file: Path) -> None:\n   609→        \"\"\"Merge pyproject.toml file made by the cookiecutter with the one in the\n   610→        existing project.\n   611→\n   612→        If the target directory doesn't have a pyproject.toml file, then the newly\n   613→        created will be copied\n   614→\n   615→        :param briefcase_config_file: The path to the project created by the\n   616→            cookiecutter.\n   617→        \"\"\"\n   618→        pyproject_file = self.base_path / \"pyproject.toml\"\n   619→\n   620→        briefcase_pyproject = briefcase_config_file.read_text(encoding=\"utf-8\")\n   621→        if pyproject_file.exists():\n   622→            pep621_pyproject = pyproject_file.read_text(encoding=\"utf-8\")\n   623→\n   624→            # The pyproject.toml file in the target directory has no briefcase keys, so it's\n   625→            # safe to copy-paste the text, and that way also keep formatting and comments.\n   626→            # We merge it this way to preserve comments in the original pyproject.toml file\n   627→            briefcase_comment = \"# content below this line added by briefcase convert\"\n   628→            merged_pyproject = (\n   629→                f\"{pep621_pyproject}\\n\\n\\n{briefcase_comment}\\n{briefcase_pyproject}\"\n   630→            )\n   631→        else:\n   632→            merged_pyproject = briefcase_pyproject\n   633→\n   634→        with open(pyproject_file, \"w\", encoding=\"utf-8\") as file:\n   635→            file.write(merged_pyproject)\n   636→\n   637→    def migrate_necessary_files(self, project_dir, test_source_dir, module_name):\n   638→        \"\"\"Copy and merge the necessary files from project_dir to the current base path.\n   639→\n   640→        Will warn a LICENSE or CHANGELOG file is missing.\n   641→\n   642→        :param project_dir: The path to the project created by the cookiecutter.\n   643→        :param test_source_dir: The path to the directory that should contain the test\n   644→            entry script\n   645→        \"\"\"\n   646→        self.merge_or_copy_pyproject(project_dir / \"pyproject.toml\")\n   647→\n   648→        # Copy license file if not already there\n   649→        license_file = self.pep621_data.get(\"license\", {}).get(\"file\")\n   650→\n   651→        if license_file is None and not (self.base_path / \"LICENSE\").exists():\n   652→            self.logger.warning(\n   653→                f\"\\nLicense file not found in '{self.base_path}'. \"\n   654→                \"Briefcase will create a template 'LICENSE' file.\"\n   655→            )\n   656→            copy2(project_dir / \"LICENSE\", self.base_path / \"LICENSE\")\n   657→\n   658→        # Copy changelog file\n   659→        changelog_file = self.base_path / \"CHANGELOG\"\n   660→        if not changelog_file.is_file():\n   661→            self.logger.warning(\n   662→                f\"\\nChangelog file not found in '{self.base_path}'. You should either \"\n   663→                f\"create a new '{self.base_path / 'CHANGELOG'}' file, or rename an \"\n   664→                \"already existing changelog file to 'CHANGELOG'.\"\n   665→            )\n   666→\n   667→        # Copy tests or test entry script\n   668→        test_path = self.base_path / test_source_dir\n   669→        if test_path.exists():\n   670→            test_entry_script = project_dir / test_source_dir / f\"{module_name}.py\"\n   671→            copy2(\n   672→                test_entry_script,\n   673→                test_path / f\"{module_name}.py\",\n   674→            )\n   675→        else:\n   676→            copytree(project_dir / test_source_dir, test_path)\n   677→\n   678→    def convert_app(\n   679→        self,\n   680→        tmp_path: Path,\n   681→        template: str | None = None,\n   682→        template_branch: str | None = None,\n   683→        project_overrides: dict[str, str] | None = None,\n   684→        **options,\n   685→    ) -> None:\n   686→        \"\"\"Run the wizard in a temporary directory and copy the necessary files into the\n   687→        project.\n   688→\n   689→        :param tmp_path: Temporary path that should contain the files generated by\n   690→            cookiecutter.\n   691→        :param template: The cookiecutter template to use.\n   692→        :param template_branch: The git branch that the template should use.\n   693→        \"\"\"\n   694→        self.input.prompt()\n   695→        self.input.prompt(\"Let's setup an existing project as a Briefcase app!\")\n   696→        context = self.build_context(project_overrides)\n   697→        self.prompt_divider()  # close the prompting section of output\n   698→\n   699→        self.warn_unused_overrides(project_overrides)\n   700→\n   701→        self.logger.info()\n   702→        self.logger.info(\n   703→            f\"Generating required files to set up '{context['formal_name']}' with Briefcase\",\n   704→            prefix=context[\"app_name\"],\n   705→        )\n   706→\n   707→        # Create the project files\n   708→        self.generate_template(\n   709→            template=(\n   710→                template\n   711→                if template\n   712→                else \"https://github.com/beeware/briefcase-template\"\n   713→            ),\n   714→            branch=template_branch,\n   715→            output_path=tmp_path,\n   716→            extra_context=context,\n   717→        )\n   718→\n   719→        project_dir = tmp_path / context[\"app_name\"]\n   720→        self.migrate_necessary_files(\n   721→            project_dir, context[\"test_source_dir\"], context[\"module_name\"]\n   722→        )\n   723→\n   724→        self.logger.info(\n   725→            f\"Converted existing application '{context['formal_name']}'\",\n   726→            prefix=context[\"app_name\"],\n   727→        )\n   728→        self.logger.info(\n   729→            \"\"\"\n   730→To run your application, type:\n   731→\n   732→    $ briefcase dev\n   733→\n   734→\"\"\"\n   735→        )\n   736→\n   737→    def validate_pyproject_file(self) -> None:\n   738→        \"\"\"Cannot setup new app if it already has briefcase settings in pyproject.\"\"\"\n   739→        if not (self.base_path / \"pyproject.toml\").exists():\n   740→            raise BriefcaseCommandError(\n   741→                \"Cannot automatically set up Briefcase for a project without a \"\n   742→                \"'pyproject.toml' file.\"\n   743→            )\n   744→\n   745→        with open(self.base_path / \"pyproject.toml\", \"rb\") as file:\n   746→            pyproject = tomllib.load(file)\n   747→\n   748→        if \"tool\" in pyproject and \"briefcase\" in pyproject[\"tool\"]:\n   749→            raise BriefcaseCommandError(\n   750→                \"Your 'pyproject.toml' file already contains a Briefcase configuration.\"\n   751→            )\n   752→\n   753→    def __call__(\n   754→        self,\n   755→        template: str | None = None,\n   756→        template_branch: str | None = None,\n   757→        project_overrides: list[str] = None,\n   758→        **options,\n   759→    ):\n   760→        # Confirm host compatibility, and that all required tools are available.\n   761→        # There are no apps, so finalize() will be a no op on app configurations.\n   762→        self.finalize()\n   763→\n   764→        self.validate_pyproject_file()\n   765→\n   766→        # Setup the app for briefcase\n   767→        with TemporaryDirectory() as tmp_path:\n   768→            tmp_path = Path(tmp_path)\n   769→            self.convert_app(\n   770→                tmp_path=tmp_path,\n   771→                template=template,\n   772→                template_branch=template_branch,\n   773→                project_overrides=parse_project_overrides(project_overrides),\n   774→                **options,\n   775→            )\n   776→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"b8576796-b3e8-47c9-b941-ba78672f276f","uuid":"226dd3c4-2d64-4c89-8a3d-30096e0496a5","tool_use_result":{"type":"text","file":{"filePath":"/testbed/src/briefcase/commands/convert.py","content":"from __future__ import annotations\n\nimport re\nimport sys\nfrom functools import cached_property, partial\nfrom pathlib import Path\nfrom shutil import copy2, copytree\nfrom tempfile import TemporaryDirectory\nfrom urllib.parse import urlparse\n\nfrom packaging.utils import canonicalize_name\n\nfrom ..config import is_valid_app_name\nfrom .new import NewCommand, parse_project_overrides, titlecase\n\nif sys.version_info >= (3, 11):  # pragma: no-cover-if-lt-py311\n    import tomllib\nelse:  # pragma: no-cover-if-gte-py311\n    import tomli as tomllib\n\nfrom briefcase.config import make_class_name, validate_url\nfrom briefcase.exceptions import BriefcaseCommandError\n\n\nclass ConvertCommand(NewCommand):\n    cmd_line = \"briefcase convert\"\n    command = \"convert\"\n    platform = \"all\"\n    output_format = None\n    description = \"Set up an existing project for Briefcase.\"\n\n    @cached_property\n    def pyproject(self):\n        \"\"\"The contents of the pyproject.toml file (as a dictionary).\"\"\"\n        pyproject_file = self.base_path / \"pyproject.toml\"\n        if pyproject_file.exists():\n            with open(pyproject_file, \"rb\") as file:\n                return tomllib.load(file)\n        else:\n            return {}\n\n    @cached_property\n    def pep621_data(self):\n        \"\"\"The pyproject[\"project\"] dictionary.\n\n        Empty dict if [project] is not in the pyproject.toml file.\n        \"\"\"\n        return self.pyproject.get(\"project\", {})\n\n    def validate_test_source_dir(self, module_name: str, test_source_dir: str) -> bool:\n        \"\"\"Determine if the test_source_dir is valid.\n\n        :param test_source_dir: The candidate test source directory\n        :returns: True. If there are any validation problems, raises ValueError with a\n            diagnostic message.\n        \"\"\"\n        test_path = self.base_path / test_source_dir\n        if (test_entry := test_path / f\"{module_name}.py\").exists():\n            raise ValueError(\n                f\"'{test_entry}' is reserved for the briefcase test entry script, but it already exists.\\n\"\n                \"\\n\"\n                \"Briefcase expects this file to contain the test entry script, so if \"\n                f\"'{self.base_path / test_source_dir}' is your test directory, you must \"\n                f\"rename '{test_entry}' before setting up your project for briefcase.\"\n            )\n\n        return True\n\n    def validate_source_dir(self, module_name: str, source_dir: str) -> bool:\n        \"\"\"Determine if the source_dir is valid.\n\n        :param source_dir: The candidate source directory\n        :returns: True. If there are any validation problems, raises ValueError with a\n            diagnostic message.\n        \"\"\"\n        if (self.base_path / source_dir).name != module_name:\n            raise ValueError(\n                f\"The source directory '{self.base_path / source_dir}' must have \"\n                f\"the same name as the app, but with underscores instead of dashes \"\n                f\"('{module_name}'), not '{(self.base_path / source_dir).name}'.\"\n            )\n\n        if not (self.base_path / source_dir).is_dir():\n            raise ValueError(\n                \"The source directory must exist and contain a '__main__.py' file.\"\n            )\n\n        if not (self.base_path / source_dir / \"__main__.py\").is_file():\n            raise ValueError(\"The source directory must contain a '__main__.py' file\")\n\n        return True\n\n    def _validate_existing_app_name(self, candidate):\n        \"\"\"Override default validation to allow app names with a pre-existing\n        directory.\"\"\"\n        pass\n\n    def input_app_name(self, override_value: str | None) -> str:\n        \"\"\"Ask about the app name, using hints from the pyproject.toml file or directory\n        name if there are any.\n\n        If the name is specified in a PEP621 compliant pyproject.toml file, then it is\n        used without prompting.\n\n        :returns: The app name\n        \"\"\"\n        intro = (\n            \"We need a name that can serve as a machine-readable Python package name for \"\n            \"your application. This name must be PEP508-compliant - that means the name \"\n            \"may only contain letters, numbers, hyphens and underscores; it can't contain \"\n            \"spaces or punctuation, and it can't start with a hyphen or underscore.\"\n        )\n\n        default = \"hello-world\"\n        if (\n            \"name\" in self.pep621_data\n            and is_valid_app_name(self.pep621_data[\"name\"])\n            and override_value is None\n        ):\n            app_name = canonicalize_name(self.pep621_data[\"name\"])\n            self.prompt_divider(title=\"App name\")\n            self.input.prompt()\n            self.input.prompt(\n                f\"Using value from PEP621 formatted pyproject.toml {app_name!r}\"\n            )\n            return app_name\n\n        if is_valid_app_name(self.base_path.name):  # Directory name is normalised\n            default = canonicalize_name(self.base_path.name)\n            intro += (\n                \"\\n\\n\"\n                f\"Based on your PEP508 formatted directory name, we suggest an \"\n                f\"app name of '{default}', but you can use another name if you want.\"\n            )\n\n        return self.input_text(\n            intro=intro,\n            variable=\"app name\",\n            default=default,\n            validator=self.validate_app_name,\n            override_value=override_value,\n        )\n\n    def input_formal_name(self, app_name: str, override_value: str | None) -> str:\n        \"\"\"Ask about formal name.\n\n        :returns: The source directory\n        \"\"\"\n        default = titlecase(\" \".join(re.split(\"[-_]\", app_name)))\n        return self.input_text(\n            intro=(\n                \"We need a formal name for your application. This is the name that \"\n                \"will be displayed to humans whenever the name of the application is \"\n                \"displayed. It can include spaces and punctuation, and any \"\n                \"capitalization will be used as you type it here.\\n\"\n                \"\\n\"\n                f\"Based on the app name, we suggest a formal name of '{default}', but \"\n                \"you can use another name if you want.\"\n            ),\n            variable=\"formal name\",\n            default=default,\n            override_value=override_value,\n        )\n\n    def get_source_dir_hint(self, app_name: str, module_name: str) -> tuple[str, str]:\n        \"\"\"Parse folder layout to get hint for the source directory.\n\n        :returns: The source directory hint\n        :returns: The description text for the source dir prompt.\n        \"\"\"\n        possible_src_dirs = [\n            p.parent for p in self.base_path.glob(f\"**/{module_name}/__main__.py\")\n        ]\n        if (self.base_path / f\"src/{module_name}\") in possible_src_dirs:\n            default = self.base_path / f\"src/{module_name}\"\n        elif (self.base_path / module_name) in possible_src_dirs:\n            default = self.base_path / module_name\n        elif possible_src_dirs:\n            default = min(\n                possible_src_dirs,\n                key=lambda p: (len(p.parents), len(str(p))),\n            )\n        else:  # We have already checked that there are directories in the project root\n            raise BriefcaseCommandError(\n                \"Cannot find a suitable source directory for the app.\\n\"\n                \"\\n\"\n                f\"Based on your app name, '{app_name}', you must have a directory \"\n                f\"named '{module_name}', either in your project root or a subdirectory \"\n                f\"(e.g. 'src/{module_name}'), that contains a '__main__.py'.\"\n            )\n\n        default = str(default.relative_to(self.base_path)).replace(\"\\\\\", \"/\")\n        intro = (\n            \"To set up an existing project for Briefcase, we need to know the path \"\n            \"of the application entry point relative to the project root (the current \"\n            \"working directory).\\n\"\n            \"\\n\"\n            \"For example, if you have an existing project 'myapp', and you can start \"\n            \"'myapp' by running 'src/myapp/__main__.py', then you should set the source \"\n            \"directory to 'src/myapp'.\\n\"\n            \"\\n\"\n            f\"Based on your project's folder layout, we believe it might be '{default}'.\"\n        )\n        return default, intro\n\n    def input_source_dir(\n        self,\n        app_name: str,\n        module_name: str,\n        override_value: str | None,\n    ) -> str:\n        \"\"\"Ask about the source dir, using hints from the project folder layout.\n\n        :returns: The source directory\n        \"\"\"\n        default, intro = self.get_source_dir_hint(app_name, module_name)\n        return self.input_text(\n            intro=intro,\n            variable=\"source directory\",\n            default=default,\n            validator=partial(self.validate_source_dir, module_name),\n            override_value=override_value,\n        )\n\n    def input_test_source_dir(self, module_name, override_value) -> str:\n        \"\"\"Ask about the test source dir, using hints from the project folder layout.\n\n        :returns: The test source directory\n        \"\"\"\n        intro = (\n            \"We also need to know the path to the test suite (if it exists). The test path \"\n            \"should be relative to the project root directory.\\n\"\n            \"\\n\"\n            \"If the provided directory doesn't exist, it will be created and populated with \"\n            \"some default test files.\"\n        )\n        if (self.base_path / \"tests\").is_dir():\n            default = \"tests\"\n            intro += (\n                \"\\n\\nBased on your project's folder structure, we believe \"\n                + \"'tests' might be your test directory\"\n            )\n        elif (self.base_path / \"test\").is_dir():\n            default = \"test\"\n            intro += (\n                \"\\n\\nBased on your project's folder structure, we believe \"\n                \"'test' might be your test directory\"\n            )\n        else:\n            default = \"tests\"\n\n        return self.input_text(\n            intro=intro,\n            variable=\"test source directory\",\n            default=default,\n            validator=partial(self.validate_test_source_dir, module_name),\n            override_value=override_value,\n        )\n\n    def input_description(self, override_value: str | None) -> str:\n        \"\"\"Ask about the app description, using hints from the pyproject.toml file if\n        there are any.\n\n        If the description is specified in a PEP621 compliant pyproject.toml file, then\n        it is used without prompting.\n\n        :returns: The app description\n        \"\"\"\n        if \"description\" in self.pep621_data and override_value is None:\n            description = self.pep621_data[\"description\"]\n\n            self.prompt_divider(title=\"Description\")\n            self.input.prompt()\n            self.input.prompt(\n                f\"Using value from PEP621 formatted pyproject.toml {description!r}\"\n            )\n            return description\n\n        return self.input_text(\n            intro=\"Now, we need a one line description for your application.\",\n            variable=\"description\",\n            default=\"My first application\",\n            override_value=override_value,\n        )\n\n    def input_url(self, app_name, override_value: str | None) -> str:\n        \"\"\"Ask about the URL, using hints from the pyproject.toml file if there are any.\n\n        :returns: The project\n        \"\"\"\n        options = list(self.pep621_data.get(\"urls\", {}).values())\n\n        if not options or override_value:\n            default = self.make_project_url(\"com.example\", app_name)\n            return self.input_text(\n                intro=(\n                    \"What website URL do you want to use for this application? Based \"\n                    f\"on your existing 'pyproject.toml', this might be {default}\"\n                ),\n                variable=\"application URL\",\n                default=default,\n                validator=validate_url,\n                override_value=override_value,\n            )\n\n        options.append(\"Other\")\n        url = self.select_option(\n            intro=(\n                \"What website URL do you want to use for this application? The \"\n                \"following URLs are defined in your existing 'pyproject.toml'; \"\n                \"select 'Other' to provide a different URL.\"\n            ),\n            variable=\"application URL\",\n            default=None,\n            options=options,\n            override_value=override_value,\n        )\n\n        if url == \"Other\":\n            url = self.input_text(\n    