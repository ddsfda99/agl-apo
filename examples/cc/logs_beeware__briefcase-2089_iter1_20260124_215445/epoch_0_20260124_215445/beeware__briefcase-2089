nual of Style rules for capitalization (roughly).\n    36→\n    37→    * Capitalize *only* the first letter of each word\n    38→    * ... unless the word is an acronym (e.g., URL)\n    39→    * ... or the word is on the exclude list ('of', 'and', 'the')\n    40→    :param s: The input string\n    41→    :returns: A capitalized string.\n    42→    \"\"\"\n    43→    return \" \".join(\n    44→        (\n    45→            word\n    46→            if (\n    47→                word.isupper()\n    48→                or word\n    49→                in {\n    50→                    \"a\",\n    51→                    \"an\",\n    52→                    \"and\",\n    53→                    \"as\",\n    54→                    \"at\",\n    55→                    \"but\",\n    56→                    \"by\",\n    57→                    \"en\",\n    58→                    \"for\",\n    59→                    \"if\",\n    60→                    \"in\",\n    61→                    \"of\",\n    62→                    \"on\",\n    63→                    \"or\",\n    64→                    \"the\",\n    65→                    \"to\",\n    66→                    \"via\",\n    67→                    \"vs\",\n    68→                }\n    69→            )\n    70→            else word.capitalize()\n    71→        )\n    72→        for word in s.split(\" \")\n    73→    )\n    74→\n    75→\n    76→def get_gui_bootstraps() -> dict[str, type[BaseGuiBootstrap]]:\n    77→    \"\"\"Loads built-in and third-party GUI bootstraps.\"\"\"\n    78→    return {\n    79→        entry_point.name: entry_point.load()\n    80→        for entry_point in entry_points(group=\"briefcase.bootstraps\")\n    81→    }\n    82→\n    83→\n    84→def parse_project_overrides(project_overrides: list[str]) -> dict[str, str]:\n    85→    \"\"\"Parse the command-line arguments to override new project defaults.\"\"\"\n    86→    overrides = {}\n    87→\n    88→    if project_overrides:\n    89→        for override in project_overrides:\n    90→            try:\n    91→                key, value = override.split(\"=\", 1)\n    92→            except ValueError as e:\n    93→                raise BriefcaseCommandError(\n    94→                    f\"Unable to parse project configuration override {override!r}\"\n    95→                ) from e\n    96→            else:\n    97→                if not ((key := key.strip()) and (value := value.strip())):\n    98→                    raise BriefcaseCommandError(\n    99→                        f\"Invalid Project configuration override {override!r}\"\n   100→                    )\n   101→                if key in overrides:\n   102→                    raise BriefcaseCommandError(\n   103→                        f\"Project configuration override {key!r} specified multiple times\"\n   104→                    )\n   105→                overrides[key] = value\n   106→    return overrides\n   107→\n   108→\n   109→class NewCommand(BaseCommand):\n   110→    cmd_line = \"briefcase new\"\n   111→    command = \"new\"\n   112→    platform = \"all\"\n   113→    output_format = None\n   114→    description = \"Create a new Briefcase project.\"\n   115→\n   116→    def bundle_path(self, app):\n   117→        \"\"\"A placeholder; New command doesn't have a bundle path.\"\"\"\n   118→        raise NotImplementedError()\n   119→\n   120→    def binary_path(self, app):\n   121→        \"\"\"A placeholder; New command doesn't have a binary path.\"\"\"\n   122→        raise NotImplementedError()\n   123→\n   124→    def parse_config(self, filename, overrides):\n   125→        \"\"\"There is no configuration when starting a new project; this implementation\n   126→        overrides the base so that no config is parsed.\"\"\"\n   127→        pass\n   128→\n   129→    def add_options(self, parser):\n   130→        parser.add_argument(\n   131→            \"-t\",\n   132→            \"--template\",\n   133→            dest=\"template\",\n   134→            help=\