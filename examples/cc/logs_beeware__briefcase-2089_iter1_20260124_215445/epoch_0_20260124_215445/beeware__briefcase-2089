efcase settings in pyproject.\"\"\"\n   739\u2192        if not (self.base_path / \"pyproject.toml\").exists():\n   740\u2192            raise BriefcaseCommandError(\n   741\u2192                \"Cannot automatically set up Briefcase for a project without a \"\n   742\u2192                \"'pyproject.toml' file.\"\n   743\u2192            )\n   744\u2192\n   745\u2192        with open(self.base_path / \"pyproject.toml\", \"rb\") as file:\n   746\u2192            pyproject = tomllib.load(file)\n   747\u2192\n   748\u2192        if \"tool\" in pyproject and \"briefcase\" in pyproject[\"tool\"]:\n   749\u2192            raise BriefcaseCommandError(\n   750\u2192                \"Your 'pyproject.toml' file already contains a Briefcase configuration.\"\n   751\u2192            )\n   752\u2192\n   753\u2192    def __call__(\n   754\u2192        self,\n   755\u2192        template: str | None = None,\n   756\u2192        template_branch: str | None = None,\n   757\u2192        project_overrides: list[str] = None,\n   758\u2192        **options,\n   759\u2192    ):\n   760\u2192        # Confirm host compatibility, and that all required tools are available.\n   761\u2192        # There are no apps, so finalize() will be a no op on app configurations.\n   762\u2192        self.finalize()\n   763\u2192\n   764\u2192        self.validate_pyproject_file()\n   765\u2192\n   766\u2192        # Setup the app for briefcase\n   767\u2192        with TemporaryDirectory() as tmp_path:\n   768\u2192            tmp_path = Path(tmp_path)\n   769\u2192            self.convert_app(\n   770\u2192                tmp_path=tmp_path,\n   771\u2192                template=template,\n   772\u2192                template_branch=template_branch,\n   773\u2192                project_overrides=parse_project_overrides(project_overrides),\n   774\u2192                **options,\n   775\u2192            )\n   776\u2192\n\n<system-reminder>\nWhenever you read a file, you should consider whether it woul