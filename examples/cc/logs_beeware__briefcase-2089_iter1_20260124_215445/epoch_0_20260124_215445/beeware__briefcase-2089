 logging enabled via the -vv flag?\n   321\u2192\n   322\u2192        This includes debug logging from third party tools.\n   323\u2192        \"\"\"\n   324\u2192        return self.verbosity >= LogLevel.DEBUG\n   325\u2192\n   326\u2192    @property\n   327\u2192    def is_deep_debug(self):\n   328\u2192        \"\"\"Is deep debug logging enabled via the -vvv flag?\n   329\u2192\n   330\u2192        This includes debug logging from third party tools.\n   331\u2192        \"\"\"\n   332\u2192        return self.verbosity >= LogLevel.DEEP_DEBUG\n   333\u2192\n   334\u2192    def configure_stdlib_logging(self, logger_name: str):\n   335\u2192        \"\"\"Configure stdlib logging for a third party tool to log through Rich.\n   336\u2192\n   337\u2192        When a third party tool written in Python uses the stdlib logging for their\n   338\u2192        logging, it may provide an abstraction to enable the logging in the console or\n   339\u2192        may require a handler to be added externally. Either way, the default handler\n   340\u2192        to write to the console, i.e. logging.StreamHandler, will bypass Rich logging\n   341\u2192        and therefore not be included in the logfile. To avoid this issue, this will\n   342\u2192        add a handler that specifically writes to the console through Rich.\n   343\u2192\n   344\u2192        :param logger_name: Name of the logger the third party tool uses. Typically,\n   345\u2192            this is the package name or path to a submodule for the package. Since\n   346\u2192            logging uses namespaces for logging, enabling DEBUG logging for `git` will\n   347\u2192            also enable it for others like `git.cmd`, `git.remote`, `git.config`, etc.\n   348\u2192        \"\"\"\n   349\u2192        if not self.is_deep_debug:\n   350\u2192            return\n   351\u2192\n   352\u2192        logger = logging.getLogger(logger_name)\n   353\u2192\n   354\u2192        # do not add another rich handler if one already exists\n   355\u2192        if not any(isinstance(h, RichLoggingHandler) for h in logger.handlers):\n   356\u2192            logger.addHandler(RichLoggingHandler(stream=RichLoggingStream(logger=self)))\n   357\u2192            logger.setLevel(logging.DEBUG)\n   358\u2192\n   359\u2192    def capture_stacktrace(self, label=\"Main thread\"):\n   360\u2192        \"\"\"Preserve Rich stacktrace from exception while in except block.\n   361\u2192\n   362\u2192        :param label: An identifying label for the thread that has raised the\n   363\u2192            stacktrace. Defaults to the main thread.\n   364\u2192        \"\"\"\n   365\u2192        exc_info = sys.exc_info()\n   366\u2192        try:\n   367\u2192            self.skip_log = exc_info[1].skip_logfile\n   368\u2192        except AttributeError:\n   369\u2192            pass\n   370\u2192\n   371\u2192        self.stacktraces.append((label, Traceback.extract(*exc_info, show_locals=True)))\n   372\u2192\n   373\u2192    def add_log_file_extra(self, func: Callable[[], object]):\n   374\u2192        \"\"\"Register a function to be called in the event that a log file is written.\n   375\u2192\n   376\u2192        This can be used to provide additional debugging information which is too\n   377\u2192        expensive to gather pre-emptively.\n   378\u2192        \"\"\"\n   379\u2192        self.log_file_extras.append(func)\n   380\u2192\n   381\u2192    def save_log_to_file(self, command):\n   382\u2192        \"\"\"Save the current application log to file.\"\"\"\n   383\u2192        # A log file is always written if a Command ran and `--log` was provided.\n   384\u2192        # If `--log` was not provided, then the log is written when an exception\n   385\u2192        # occurred and the exception was not explicitly configured to skip the log.\n   386\u2192        if not (\n   387\u2192            command and (self.save_log or (self.stacktraces and not self.skip_log))\n   388\u2192        ):\n   389\u2192            return\n   390\u2192\n   391\u2192        with command.input.wait_bar(\"Saving log...\", transient=True):\n   392\u2192            self.print.to_console()\n   393\u2192            log_filename = f\"briefcase.{datetime.now().strftime('%Y_%m_%d-%H_%M_%S')}.{command.command}.log\"\n   394\u2192            log_filepath = command.base_path / self.LOG_DIR / log_filename\n   395\u2192            try:\n   396\u2192                log_filepath.parent.mkdir(parents=True, exist_ok=True)\n   397\u2192                with open(\n   398\u2192                    log_filepath, \"w\", encoding=\"utf-8\", errors=\"backslashreplace\"\n   399\u2192                ) as log_file:\n   400\u2192                    log_file.write(self._build_log(command))\n   401\u2192            except OSError as e:\n   402\u2192                self.error(f\"Failed to save log to {log_filepath}: {e}\")\n   403\u2192            else:\n   404\u2192                self.warning(f\"Log saved to {log_filepath}\")\n   405\u2192            self.print.to_console()\n   406\u2192\n   407\u2192    def _build_log(self, command) -> str:\n   408\u2192        \"\"\"Accumulate all information to include in the log file.\"\"\"\n   409\u2192        # Add the exception stacktraces to end of log if any were captured\n   410\u2192        if self.stacktraces:\n   411\u2192            # using print.log.print() instead of print.to_log() to avoid\n   412\u2192            # timestamp and code location inclusion for the stacktrace box.\n   413\u2192            for thread, stacktrace in self.stacktraces:\n   414\u2192                self.print.log.print(\n   415\u2192                    f\"{thread} traceback:\",\n   416\u2192                    Traceback(\n   417\u2192                        trace=stacktrace,\n   418\u2192                        width=self.print.log_width,\n   419\u2192                        show_locals=True,\n   420\u2192                    ),\n   421\u2192                    new_line_start=True,\n   422\u2192                )\n   423\u2192\n   424\u2192        # Retrieve additional logging added by the Command\n   425\u2192        if self.log_file_extras:\n   426\u2192            with command.input.wait_bar(\n   427\u2192                \"Collecting extra information for log...\",\n   428\u2192                transient=True,\n   429\u2192            ):\n   430\u2192                self.debug()\n   431\u2192                self.debug(\"Extra information:\")\n   432\u2192                for func in self.log_file_extras:\n   433\u2192                    try:\n   434\u2192                        func()\n   435\u2192                    except Exception:\n   436\u2192                        self.error(traceback.format_exc())\n   437\u2192\n   438\u2192        # Capture env vars removing any potentially sensitive information\n   439\u2192        sanitized_env_vars = \"\\n\".join(\n   440\u2192            f\"\\t{env_var}={value if not SENSITIVE_SETTING_RE.search(env_var) else '********************'}\"\n   441\u2192            for env_var, value in sorted(command.tools.os.environ.items())\n   442\u2192        )\n   443\u2192\n   444\u2192        # Capture pyproject.toml if one exists in the current directory\n   445\u2192        try:\n   446\u2192            with open(Path.cwd() / \"pyproject.toml\", encoding=\"utf-8\") as f:\n   447\u2192                pyproject_toml = f.read().strip()\n   448\u2192        except OSError as e:\n   449\u2192            pyproject_toml = str(e)\n   450\u2192\n   451\u2192        # Build log with buffered log from Rich\n   452\u2192        uname = platform.uname()\n   453\u2192        return (\n   454\u2192            f\"Date/Time:       {datetime.now().strftime('%Y-%m-%d %H:%M:%S %Z')}\\n\"\n   455\u2192            f\"Command line:    {' '.join(sys.argv)}\\n\"\n   456\u2192            \"\\n\"\n   457\u2192            f\"OS Release:      {uname.system} {uname.release}\\n\"\n   458\u2192            f\"OS Version:      {uname.version}\\n\"\n   459\u2192            f\"Architecture:    {uname.machine}\\n\"\n   460\u2192            f\"Platform:        {platform.platform(aliased=True)}\\n\"\n   461\u2192            \"\\n\"\n   462\u2192            f\"Python exe:      {sys.executable}\\n\"\n   463\u2192            # replace line breaks with spaces (use chr(10) since '\\n' isn't allowed in f-strings...)\n   464\u2192            f\"Python version:  {sys.version.replace(chr(10), ' ')}\\n\"\n   465\u2192            # sys.real_prefix was used in older versions of virtualenv.\n   466\u2192            # sys.base_prefix is always the python exe's original site-specific directory (e.g. /usr/local).\n   467\u2192            # sys.prefix is updated (from base_prefix's value) to the virtual env's site-specific directory.\n   468\u2192            f\"Virtual env:     {hasattr(sys, 'real_prefix') or sys.base_prefix != sys.prefix}\\n\"\n   469\u2192            # for conda, prefix and base_prefix are likely the same but contain a conda-meta dir.\n   470\u2192            f\"Conda env:       {(Path(sys.prefix) / 'conda-meta').exists()}\\n\"\n   471\u2192            \"\\n\"\n   472\u2192            f\"Briefcase:       {__version__}\\n\"\n   473\u2192            f\"Target platform: {command.platform}\\n\"\n   474\u2192            f\"Target format:   {command.output_format}\\n\"\n   475\u2192            \"\\n\"\n   476\u2192            \"Environment Variables:\\n\"\n   477\u2192            f\"{sanitized_env_vars}\\n\"\n   478\u2192            \"\\n\"\n   479\u2192            \"pyproject.toml:\\n\"\n   480\u2192            f\"{pyproject_toml}\\n\"\n   481\u2192            \"\\n\"\n   482\u2192            \"Briefcase Log:\\n\"\n   483\u2192            f\"{self.print.export_log()}\"\n   484\u2192        )\n   485\u2192\n   486\u2192\n   487\u2192class NotDeadYet:\n   488\u2192    # I\u2019m getting better! No you\u2019re not, you\u2019ll be stone dead in a minute.\n   489\u2192\n   490\u2192    def __init__(self, printer: Printer):\n   491\u2192        \"\"\"A keep-alive spinner for long-running processes without console output.\n   492\u2192\n   493\u2192        Returned by the Wait Bar's context manager but can be used independently. Use in\n   494\u2192        a loop that calls update() each iteration. A keep-alive message will be printed\n   495\u2192        every 10 seconds.\n   496\u2192        \"\"\"\n   497\u2192        self.printer: Printer = printer\n   498\u2192        self.interval_sec: int = 10\n   499\u2192        self.message: str = \"... still waiting\"\n   500\u2192        self.ready_time: float = 0.0\n   501\u2192\n   502\u2192        self.reset()  # initialize\n   503\u2192\n   504\u2192    def update(self):\n   505\u2192        \"\"\"Write keep-alive message if the periodic interval has elapsed.\"\"\"\n   506\u2192        if self.ready_time < time.time():\n   507\u2192            self.printer(self.message)\n   508\u2192            self.reset()\n   509\u2192\n   510\u2192    def reset(self):\n   511\u2192        \"\"\"Initialize periodic interval to now; next message prints after interval.\"\"\"\n   512\u2192        self.ready_time = time.time() + self.interval_sec\n   513\u2192\n   514\u2192\n   515\u2192class Console:\n   516\u2192    def __init__(self, printer: Printer | None = None, enabled: bool = True):\n   517\u2192        self.enabled = enabled\n   518\u2192        self.print = Printer() if printer is None else printer\n   519\u2192        # Use Rich's input() to read from user\n   520\u2192        self.input = self.print.console.input\n   521\u2192        self._wait_bar: Progress | None = None\n   522\u2192        # Signal that Rich is dynamically controlling the console output. Therefore,\n   523\u2192        # all output must be printed to the screen by Rich to prevent corruption of\n   524\u2192        # dynamic elements like the Wait Bar.\n   525\u2192        self.is_console_controlled = False\n   526\u2192\n   527\u2192    @property\n   528\u2192    def is_interactive(self):\n   529\u2192        \"\"\"Returns interactivity mode based on the presence of a tty for stdout.\n   530\u2192\n   531\u2192        In a non-interactive session, Rich's dynamic elements like progress bars should\n   532\u2192        be disabled. By default, Rich will not render dynamic elements if a tty is not\n   533\u2192        available. However, environment variables like FORCE_COLOR can override this\n   534\u2192        behavior in Rich to not only show ANSI color and style but also dynamic\n   535\u2192        elements. In a CI environment with this configuration, a long-lived progress bar\n   536\u2192        can dramatically compromise the quality of logged output. So, dynamic elements\n   537\u2192        should be specifically disabled in non-interactive sessions.\n   538\u2192        \"\"\"\n   539\u2192        # `sys.__stdout__` is used because Rich captures and redirects `sys.stdout`\n   540\u2192        return os.isatty(sys.__stdout__.fileno())\n   541\u2192\n   542\u2192    @property\n   543\u2192    def is_color_enabled(self):\n   544\u2192        \"\"\"Is the underlying Rich console using color?\n   545\u2192\n   546\u2192        Rich can be explicitly configured to not use color at Console initialization or\n   547\u2192        the NO_COLOR environment variable; alternatively, the derived color system for\n   548\u2192        the terminal is influenced by attributes of the platform as well as FORCE_COLOR.\n   549\u2192        \"\"\"\n   550\u2192        # no_color has precedence since color_system can be set even if color is disabled\n   551\u2192        if self.print.console.no_color:\n   552\u2192            return False\n   553\u2192        else:\n   554\u2192            return self.print.console.color_system is not None\n   555\u2192\n   556\u2192    def progress_bar(self):\n   557\u2192        \"\"\"Returns a progress bar as a context manager.\"\"\"\n   558\u2192        return Progress(\n   559\u2192            TextColumn(\"  \"),\n   560\u2192            SpinnerColumn(\"line\", speed=1.5, style=\"default\"),\n   561\u2192            BarColumn(bar_width=50),\n   562\u2192            TextColumn(\"{task.percentage:>3.1f}%\", style=\"default\"),\n   563\u2192            TextColumn(\"\u2022\", style=\"default\"),\n   564\u2192            TimeRemainingColumn(compact=True, elapsed_when_finished=True),\n   565\u2192            disable=not self.is_interactive,\n   566\u2192            console=self.print.console,\n   567\u2192        )\n   568\u2192\n   569\u2192    @contextmanager\n   570\u2192    def wait_bar(\n   571\u2192        self,\n   572\u2192        message: str = \"\",\n   573\u2192        done_message: str = \"done\",\n   574\u2192        *,\n   575\u2192        transient: bool = False,\n   576\u2192        markup: bool = False,\n   577\u2192    ) -> NotDeadYet:\n   578\u2192        \"\"\"Activates the Wait Bar as a context manager.\n   579\u2192\n   580\u2192        If the Wait Bar is already active, then its message is updated for the new\n   581\u2192        context. Once the new context is complete, the previous Wait Bar message\n   582\u2192        is restored.\n   583\u2192\n   584\u2192        :param message: text explaining what is being awaited; should end in '...'\n   585\u2192        :param done_message: text appended to the message after exiting\n   586\u2192        :param transient: if True, remove bar and message from screen after exiting;\n   587\u2192            if False (default), the message will remain on the screen without pulsing bar.\n   588\u2192        :param markup: whether to interpret Rich styling markup in the message; if True,\n   589\u2192            the message must already be escaped; defaults False.\n   590\u2192        :returns:  Keep-alive spinner to notify user Briefcase is still waiting\n   591\u2192        \"\"\"\n   592\u2192        is_wait_bar_disabled = not self.is_interactive\n   593\u2192        show_outcome_message = message and (is_wait_bar_disabled or not transient)\n   594\u2192\n   595\u2192        if self._wait_bar is None:\n   596\u2192            self._wait_bar = Progress(\n   597\u2192                TextColumn(\"    \"),\n   598\u2192                BarColumn(bar_width=20, style=\"black\", pulse_style=\"white\"),\n   599\u2192                TextColumn(\"{task.fields[message]}\"),\n   600\u2192                transient=True,\n   601\u2192                disable=is_wait_bar_disabled,\n   602\u2192                console=self.print.console,\n   603\u2192            )\n   604\u2192            # start=False causes the progress bar to \"pulse\"\n   605\u2192            # message=None is a sentinel the Wait Bar should be inactive\n   606\u2192            self._wait_bar.add_task(\"\", start=False, message=None)\n   607\u2192\n   608\u2192        self.print(\n   609\u2192            f\"{message} started\", markup=markup, show=message and is_wait_bar_disabled\n   610\u2192        )\n   611\u2192\n   612\u2192        self.is_console_controlled = True\n   613\u2192        wait_bar_task = self._wait_bar.tasks[0]\n   614\u2192        previous_message = wait_bar_task.fields[\"message\"]\n   615\u2192        self._wait_bar.update(wait_bar_task.id, message=message)\n   616\u2192\n   617\u2192        try:\n   618\u2192            self._wait_bar.start()\n   619\u2192            yield NotDeadYet(printer=self.print)\n   620\u2192        except BaseException as e:\n   621\u2192            # capture BaseException so message is left on the screen even if user sends CTRL+C\n   622\u2192            error_message = \"aborted\" if isinstance(e, KeyboardInterrupt) else \"errored\"\n   623\u2192            self.print(\n   624\u2192                f\"{message} {error_message}\", markup=markup, show=show_outcome_message\n   625\u2192            )\n   626\u2192            raise\n   627\u2192        else:\n   628\u2192            self.print(\n   629\u2192                f\"{message} {done_message}\", markup=markup, show=show_outcome_message\n   630\u2192            )\n   631\u2192        finally:\n   632\u2192            self._wait_bar.update(wait_bar_task.id, message=previous_message)\n   633\u2192            # Deactivate the Wait Bar if returning to its initial state\n   634\u2192            if previous_message is None:\n   635\u2192                self._wait_bar.stop()\n   636\u2192                self.is_console_controlled = False\n   637\u2192\n   638\u2192    @contextmanager\n   639\u2192    def release_console_control(self):\n   640\u2192        \"\"\"Context manager to remove console elements such as the Wait Bar.\n   641\u2192\n   642\u2192        This is useful to temporarily release control of the console when, e.g., a\n   643\u2192        process is interrupted or a user needs to be prompted. For instance, when batch\n   644\u2192        scripts are interrupted by CTRL+C in cmd.exe, the user may be prompted to abort\n   645\u2192        the script; so, the console cannot be controlled while such scripts run or the\n   646\u2192        prompt may be hidden from the user.\n   647\u2192        \"\"\"\n   648\u2192        # Preserve current console state\n   649\u2192        is_output_controlled = self.is_console_controlled\n   650\u2192        is_wait_bar_running = self._wait_bar and self._wait_bar.live.is_started\n   651\u2192\n   652\u2192        # Stop any active dynamic console elements\n   653\u2192        if is_wait_bar_running:\n   654\u2192            self._wait_bar.stop()\n   655\u2192\n   656\u2192        self.is_console_controlled = False\n   657\u2192        try:\n   658\u2192            yield\n   659\u2192        finally:\n   660\u2192            self.is_console_controlled = is_output_controlled\n   661\u2192            # Restore previous console state\n   662\u2192            if is_wait_bar_running:\n   663\u2192                self._wait_bar.start()\n   664\u2192\n   665\u2192    def textwrap(self, text: str, width: int = MAX_TEXT_WIDTH) -> str:\n   666\u2192        \"\"\"Wrap text to the console width, a default max width, or a specified width.\"\"\"\n   667\u2192        # textwrap isn't really designed to format text that already contains newlines.\n   668\u2192        # So, instead, break the text by newlines and format each line individually.\n   669\u2192        return \"\\n\".join(\n   670\u2192            \"\\n\".join(textwrap.wrap(line, width)) for line in text.splitlines()\n   671\u2192        )\n   672\u2192\n   673\u2192    def prompt(self, *values, markup=False, **kwargs):\n   674\u2192        \"\"\"Print to the screen for soliciting user interaction if input enabled.\n   675\u2192\n   676\u2192        :param values: strings to print as the user prompt\n   677\u2192        :param markup: True if prompt contains Rich markup\n   678\u2192        \"\"\"\n   679\u2192        if self.enabled:\n   680\u2192            self.print(*values, markup=markup, stack_offset=4, **kwargs)\n   681\u2192\n   682\u2192    def boolean_input(self, question: str, default: bool = False) -> bool:\n   683\u2192        \"\"\"Get a boolean input from user, in the form of y/n.\n   684\u2192\n   685\u2192        The user might press \"y\" for true or \"n\" for false. If input is disabled,\n   686\u2192        returns default. If input is disabled and default is *not* defined,\n   687\u2192        InputDisabled is raised.\n   688\u2192\n   689\u2192        :param question: A string message specifying the question to be answered by the\n   690\u2192            user.\n   691\u2192        :param default: (optional) Default response (True/False)\n   692\u2192        :returns: True if the user selected \"y\", or False if they selected \"n\".\n   693\u2192        \"\"\"\n   694\u2192        if default is None:\n   695\u2192            yes_no = \"y/n\"\n   696\u2192            default_text = None\n   697\u2192        elif default:\n   698\u2192            yes_no = \"[Y/n]\"\n   699\u2192            default_text = \"y\"\n   700\u2192        else:\n   701\u2