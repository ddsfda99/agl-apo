                    \"App names must not be reserved keywords such as 'and', 'for' and \"\n   214\u2192                    \"'while'. They must also be PEP508 compliant (i.e., they can only \"\n   215\u2192                    \"include letters, numbers, '-' and '_'; must start with a letter; \"\n   216\u2192                    \"and cannot end with '-' or '_').\"\n   217\u2192                )\n   218\u2192            )\n   219\u2192\n   220\u2192        # Validate if the existing app name\n   221\u2192        self._validate_existing_app_name(candidate)\n   222\u2192\n   223\u2192        return True\n   224\u2192\n   225\u2192    def make_module_name(self, app_name):\n   226\u2192        \"\"\"Construct a valid module name from an app name.\n   227\u2192\n   228\u2192        :param app_name: The app name\n   229\u2192        :returns: The app's module name.\n   230\u2192        \"\"\"\n   231\u2192        return app_name.replace(\"-\", \"_\")\n   232\u2192\n   233\u2192    def validate_bundle(self, candidate):\n   234\u2192        \"\"\"Determine if the bundle identifier is valid.\n   235\u2192\n   236\u2192        :param candidate: The candidate bundle identifier\n   237\u2192        :returns: True. If there are any validation problems, raises ValueError with a\n   238\u2192            diagnostic message.\n   239\u2192        \"\"\"\n   240\u2192        if not is_valid_bundle_identifier(candidate):\n   241\u2192            raise ValueError(\n   242\u2192                self.input.textwrap(\n   243\u2192                    f\"{candidate!r} is not a valid bundle identifier.\\n\"\n   244\u2192                    \"\\n\"\n   245\u2192                    \"The bundle should be a reversed domain name. It must contain at \"\n   246\u2192                    \"least 2 dot-separated sections; each section may only include \"\n   247\u2192                    \"letters, numbers, and hyphens; and each section may not contain any \"\n   248\u2192                    \"reserved words (like 'switch', or 'while').\"\n   249\u2192                )\n   250\u2192            )\n   251\u2192\n   252\u2192        return True\n   253\u2192\n   254\u2192    def make_domain(self, bundle):\n   255\u2192        \"\"\"Construct a candidate domain from a bundle identifier.\n   256\u2192\n   257\u2192        :param bundle: The bundle identifier\n   258\u2192        :returns: The candidate domain\n   259\u2192        \"\"\"\n   260\u2192        return \".\".join(bundle.split(\".\")[::-1])\n   261\u2192\n   262\u2192    def make_author_email(self, author, bundle):\n   263\u2192        \"\"\"Construct a candidate email address from the authors name and the bundle\n   264\u2192        identifier.\n   265\u2192\n   266\u2192        The candidate is based on the assumption that the author's name is in\n   267\u2192        \"first/last\" format, or it a corporate name; the \"first\" part is split off, and\n   268\u2192        prepended to the domain extracted from the bundle.\n   269\u2192\n   270\u2192        It's not a perfect system, but it's better than putting up \"me@example.com\" as a\n   271\u2192        candidate default value.\n   272\u2192\n   273\u2192        :param author: The authors name.\n   274\u2192        :param bundle: The bundle identifier.\n   275\u2192        :returns: The candidate author's name\n   276\u2192        \"\"\"\n   277\u2192        return f\"{author.split(' ')[0].lower()}@{self.make_domain(bundle)}\"\n   278\u2192\n   279\u2192    def validate_email(self, candidate):\n   280\u2192        \"\"\"Determine if the email address is valid.\n   281\u2192\n   282\u2192        :param candidate: The candidate email address\n   283\u2192        :returns: True. If there are any validation problems, raises ValueError with a\n   284\u2192            diagnostic message.\n   285\u2192        \"\"\"\n   286\u2192        if parseaddr(candidate)[1] != candidate:\n   287\u2192            raise ValueError(\"Not a valid email address\")\n   288\u2192        return True\n   289\u2192\n   290\u2192    def make_project_url(self, bundle, app_name):\n   291\u2192        \"\"\"Construct a candidate project URL from the bundle and app name.\n   292\u2192\n   293\u2192        It's not a perfect guess, but it's better than having\n   294\u2192        \"https://example.com\".\n   295\u2192\n   296\u2192        :param bundle: The bundle identifier.\n   297\u2192        :param app_name: The app name.\n   298\u2192        :returns: The candidate project URL\n   299\u2192        \"\"\"\n   300\u2192        return f\"https://{self.make_domain(bundle)}/{app_name}\"\n   301\u2192\n   302\u2192    def prompt_divider(self, title: str = \"\"):\n   303\u2192        \"\"\"Writes a divider with an optional title.\"\"\"\n   304\u2192        title = f\"-- {title} \" if title else \"\"\n   305\u2192        self.input.prompt()\n   306\u2192        self.input.prompt()\n   307\u2192        self.input.prompt(f\"{title}{'-' * (MAX_TEXT_WIDTH - len(title))}\", style=\"bold\")\n   308\u2192\n   309\u2192    def prompt_intro(self, intro: str):\n   310\u2192        \"\"\"Write the introduction for a prompt.\"\"\"\n   311\u2192        self.input.prompt()\n   312\u2192        self.input.prompt(self.input.textwrap(intro))\n   313\u2192        self.input.prompt()\n   314\u2192\n   315\u2192    def validate_user_input(self, validator, answer) -> bool:\n   316\u2192        \"\"\"Validate a user's input is acceptable.\n   317\u2192\n   318\u2192        A warning message is issued if input is enabled. Otherwise, an exception is\n   319\u2192        raised and project creation is aborted.\n   320\u2192        \"\"\"\n   321\u2192        error_msg = f\"Invalid value; {answer}\"\n   322\u2192        try:\n   323\u2192            if validator is None or validator(answer):\n   324\u2192                return True\n   325\u2192        except ValueError as e:\n   326\u2192            error_msg = str(e)\n   327\u2192\n   328\u2192        if not self.input.enabled:\n   329\u2192            raise BriefcaseCommandError(error_msg)\n   330\u2192        self.logger.warning()\n   331\u2192        self.logger.warning(error_msg)\n   332\u2192\n   333\u2192        return False\n   334\u2192\n   335\u2192    def validate_override(self, override_value: str | None, validator=None) -> bool:\n   336\u2192        \"\"\"Validates and returns override value for a project configuration.\"\"\"\n   337\u2192        if override_value is not None:\n   338\u2192            self.input.prompt()\n   339\u2192            self.input.prompt(f\"Using override value {override_value!r}\")\n   340\u2192            if not self.validate_user_input(validator, override_value):\n   341\u2192                return False\n   342\u2192        return True\n   343\u2192\n   344\u2192    def validate_selection_override(\n   345\u2192        self,\n   346\u2192        choices: Iterable[str],\n   347\u2192        override_value: str | None,\n   348\u2192    ) -> bool:\n   349\u2192        \"\"\"Validate a project override value against a list of options.\"\"\"\n   350\u2192        return self.validate_override(override_value, validator=lambda c: c in choices)\n   351\u2192\n   352\u2192    def input_text(self, intro, variable, default, validator=None, override_value=None):\n   353\u2192        \"\"\"Read a text answer from the user.\n   354\u2192\n   355\u2192        :param intro: An introductory paragraph explaining the question being asked.\n   356\u2192        :param variable: The name of the variable being entered.\n   357\u2192        :param default: The default value if the user hits enter without typing anything.\n   358\u2192        :param validator: (optional) A validator function; accepts a single input (the\n   359\u2192            candidate response), returns True if the answer is valid, or raises\n   360\u2192            ValueError() with a debugging message if the candidate value isn't valid.\n   361\u2192        :param override_value: value to return instead of soliciting input\n   362\u2192        :returns: a string, guaranteed to meet the validation criteria of ``validator``\n   363\u2192        \"\"\"\n   364\u2192        variable = titlecase(variable)\n   365\u2192        self.prompt_divider(title=variable)\n   366\u2192\n   367\u2192        if override_value and self.validate_override(override_value, validator):\n   368\u2192            return override_value\n   369\u2192\n   370\u2192        self.prompt_intro(intro=intro)\n   371\u2192        while True:\n   372\u2192            answer = self.input.text_input(f\"{variable} [{default}]: \", default=default)\n   373\u2192\n   374\u2192            if self.validate_user_input(validator, answer):\n   375\u2192                return answer\n   376\u2192\n   377\u2192            self.input.prompt()\n   378\u2192\n   379\u2192    def select_option(\n   380\u2192        self,\n   381\u2192        intro: str,\n   382\u2192        variable: str,\n   383\u2192        default: str | None,\n   384\u2192        options: Sequence[str],\n   385\u2192        override_value: str | None,\n   386\u2192    ) -> str:\n   387\u2192        variable = titlecase(variable)\n   388\u2192        self.prompt_divider(title=variable)\n   389\u2192\n   390\u2192        if override_value is not None:\n   391\u2192            if self.validate_selection_override(options, override_value):\n   392\u2192                return override_value\n   393\u2192            else:\n   394\u2192                self.logger.warning(\n   395\u2192                    f\"Invalid override value {override_value!r} for {variable}, using user-provided value.\"\n   396\u2192                )\n   397\u2192\n   398\u2192        if default is not None:\n   399\u2192            default = str(options.index(default) + 1)\n   400\u2192        else:\n   401\u2192            default = \"1\"\n   402\u2192\n   403\u2192        self.prompt_intro(intro=intro)\n   404\u2192        return _select_option(\n   405\u2192            prompt=f\"{variable} [{default}]: \",\n   406\u2192            input=self.input,\n   407\u2192            default=default,\n   408\u2192            options=list(zip(options, options)),\n   409\u2192        )\n   410\u2192\n   411\u2192    def input_project_name(self, formal_name, override_value):\n   412\u2192        return self.input_text(\n   413\u2192            intro=(\n   414\u2192                \"Briefcase can manage projects that contain multiple applications, so \"\n   415\u2192                \"we need a Project name.\\n\"\n   416\u2192                \"\\n\"\n   417\u2192                \"If you're only planning to have one application in this project, you \"\n   418\u2192                \"can use the formal name as the project name.\"\n   419\u2192            ),\n   420\u2192            variable=\"project name\",\n   421\u2192            default=formal_name,\n   422\u2192            override_value=override_value,\n   423\u2192        )\n   424\u2192\n   425\u2192    def input_license(self, override_value: str | None):\n   426\u2192        licenses = [\n   427\u2192            \"BSD license\",\n   428\u2192            \"MIT license\",\n   429\u2192            \"Apache Software License\",\n   430\u2192            \"GNU General Public License v2 (GPLv2)\",\n   431\u2192            \"GNU General Public License v2 or later (GPLv2+)\",\n   432\u2192            \"GNU General Public License v3 (GPLv3)\",\n   433\u2192            \"GNU General Public License v3 or later (GPLv3+)\",\n   434\u2192            \"Proprietary\",\n   435\u2192            \"Other\",\n   436\u2192        ]\n   437\u2192        return self.select_option(\n   438\u2192            intro=\"What license do you want to use for this project's code?\",\n   439\u2192            variable=\"Project License\",\n   440\u2192            options=licenses,\n   441\u2192            default=None,\n   442\u2192            override_value=override_value,\n   443\u2192        )\n   444\u2192\n   445\u2192    def build_context(self, project_overrides: dict[str, str]) -> dict[str, str]:\n   446\u2192        \"\"\"Builds the cookiecutter context dict for the new project.\"\"\"\n   447\u2192        context = self.build_app_context(project_overrides)\n   448\u2192        context.update(self.build_gui_context(context, project_overrides))\n   449\u2192\n   450\u2192        return context\n   451\u2192\n   452\u2192    def build_app_context(self, project_overrides: dict[str, str]) -> dict[str, str]:\n   453\u2192        \"\"\"Ask the user for details about the app to be created.\n   454\u2192\n   455\u2192        :returns: A context dictionary to be used in the cookiecutter project template.\n   456\u2192        \"\"\"\n   457\u2192        formal_name = self.input_text(\n   458\u2192            intro=(\n   459\u2192                \"First, we need a formal name for your application.\\n\"\n   460\u2192                \"\\n\"\n   461\u2192                \"This is the name that will be displayed to humans whenever the name \"\n   462\u2192                \"of the application is displayed. It can have spaces and punctuation \"\n   463\u2192                \"if you like, and any capitalization will be used as you type it.\"\n   464\u2192            ),\n   465\u2192            variable=\"formal name\",\n   466\u2192            default=\"Hello World\",\n   467\u2192            validator=self.validate_formal_name,\n   468\u2192            override_value=project_overrides.pop(\"formal_name\", None),\n   469\u2192        )\n   470\u2192\n   471\u2192        # The class name can be completely derived from the formal name.\n   472\u2192        class_name = make_class_name(formal_name)\n   473\u2192\n   474\u2192        default_app_name = self.make_app_name(formal_name)\n   475\u2192        app_name = self.input_text(\n   476\u2192            intro=(\n   477\u2192                \"Next, we need a name that can serve as a machine-readable Python \"\n   478\u2192                \"package name for your application.\\n\"\n   479\u2192                \"\\n\"\n   480\u2192                \"This name must be PEP508-compliant - that means the name may only \"\n   481\u2192                \"contain letters, numbers, hyphens and underscores; it can't contain \"\n   482\u2192                \"spaces or punctuation, and it can't start with a hyphen or \"\n   483\u2192                \"underscore.\\n\"\n   484\u2192                \"\\n\"\n   485\u2192                \"Based on your formal name, we suggest an app name of \"\n   486\u2192                f\"{default_app_name!r}, but you can use another name if you want.\"\n   487\u2192            ),\n   488\u2192            variable=\"app name\",\n   489\u2192            default=default_app_name,\n   490\u2192            validator=self.validate_app_name,\n   491\u2192            override_value=project_overrides.pop(\"app_name\", None),\n   492\u2192        )\n   493\u2192\n   494\u2192        # The module name can be completely derived from the app name.\n   495\u2192        module_name = self.make_module_name(app_name)\n   496\u2192        source_dir = f\"src/{module_name}\"\n   497\u2192        test_source_dir = \"tests\"\n   498\u2192\n   499\u2192        bundle = self.input_text(\n   500\u2192            intro=(\n   501\u2192                \"Now we need a bundle identifier for your application.\\n\"\n   502\u2192                \"\\n\"\n   503\u2192                \"App stores need to protect against having multiple applications with \"\n   504\u2192                \"the same name; the bundle identifier is the namespace they use to \"\n   505\u2192                \"identify applications that come from you. The bundle identifier is \"\n   506\u2192                \"usually the domain name of your company or project, in reverse order.\\n\"\n   507\u2192                \"\\n\"\n   508\u2192                \"For example, if you are writing an application for Example Corp, \"\n   509\u2192                \"whose website is example.com, your bundle would be 'com.example'. \"\n   510\u2192                \"The bundle will be combined with your application's machine readable \"\n   511\u2192                \"name to form a complete application identifier (e.g., \"\n   512\u2192                f\"com.example.{app_name}).\"\n   513\u2192            ),\n   514\u2192            variable=\"bundle identifier\",\n   515\u2192            default=\"com.example\",\n   516\u2192            validator=self.validate_bundle,\n   517\u2192            override_value=project_overrides.pop(\"bundle\", None),\n   518\u2192        )\n   519\u2192\n   520\u2192        project_name = self.input_project_name(\n   521\u2192            formal_name, project_overrides.pop(\"project_name\", None)\n   522\u2192        )\n   523\u2192\n   524\u2192        description = self.input_text(\n   525\u2192            intro=\"Now, we need a one line description for your application.\",\n   526\u2192            variable=\"description\",\n   527\u2192            default=\"My first application\",\n   528\u2192            override_value=project_overrides.pop(\"description\", None),\n   529\u2192        )\n   530\u2192\n   531\u2192        author = self.input_text(\n   532\u2192            intro=(\n   533\u2192                \"Who do you want to be credited as the author of this application?\\n\"\n   534\u2192                \"\\n\"\n   535\u2192                \"This could be your own name, or the name of your company you work for.\"\n   536\u2192            ),\n   537\u2192            variable=\"author\",\n   538\u2192            default=\"Jane Developer\",\n   539\u2192            override_value=project_overrides.pop(\"author\", None),\n   540\u2192        )\n   541\u2192\n   542\u2192        author_email = self.input_text(\n   543\u2192            intro=(\n   544\u2192                \"What email address should people use to contact the developers of \"\n   545\u2192                \"this application?\\n\"\n   546\u2192                \"\\n\"\n   547\u2192                \"This might be your own email address, or a generic contact address \"\n   548\u2192                \"you set up specifically for this application.\"\n   549\u2192            ),\n   550\u2192            variable=\"author's email\",\n   551\u2192            default=self.make_author_email(author, bundle),\n   552\u2192            validator=self.validate_email,\n   553\u2192            override_value=project_overrides.pop(\"author_email\", None),\n   554\u2192        )\n   555\u2192\n   556\u2192        url = self.input_text(\n   557\u2192            intro=(\n   558\u2192                \"What is the website URL for this application?\\n\"\n   559\u2192                \"\\n\"\n   560\u2192                \"If you don't have a website set up yet, you can put in a dummy URL.\"\n   561\u2192            ),\n   562\u2192            variable=\"application URL\",\n   563\u2192            default=self.make_project_url(bundle, app_name),\n   564\u2192            validator=validate_url,\n   565\u2192            override_value=project_overrides.pop(\"url\", None),\n   566\u2192        )\n   567\u2192        project_license = self.input_license(\n   568\u2192            override_value=project_overrides.pop(\"license\", None)\n   569\u2192        )\n   570\u2192\n   571\u2192        return {\n   572\u2192            \"formal_name\": formal_name,\n   573\u2192            \"app_name\": app_name,\n   574\u2192            \"class_name\": class_name,\n   575\u2192            \"module_name\": module_name,\n   576\u2192            \"source_dir\": source_dir,\n   577\u2192            \"test_source_dir\": test_source_dir,\n   578\u2192            \"project_name\": project_name,\n   579\u2192            \"description\": description,\n   580\u2192            \"author\": author,\n   581\u2192            \"author_email\": author_email,\n   582\u2192            \"bundle\": bundle,\n   583\u2192            \"url\": url,\n   584\u2192            \"license\": project_license,\n   585\u2192        }\n   586\u2192\n   587\u2192    def build_gui_context(\n   588\u2192        self,\n   589\u2192        context: dict[str, str],\n   590\u2192        project_overrides: dict[str, str],\n   591\u2192    ) -> dict[str, str]:\n   592\u2192        \"\"\"Build context specific to the GUI toolkit.\"\"\"\n   593\u2192        bootstraps = get_gui_bootstraps()\n   594\u2192        bootstrap_options = self._gui_bootstrap_choices(bootstraps)\n   595\u2192\n   596\u2192        # Map the override value to the annotated override value so we can use it with self.select_option\n   597\u2192        # If a user specifies the override value PySide6, then we want it to be mapped to the annotated value\n   598\u2192        # \"PySide6       (does not support iOS/Android deployment)\"\n   599\u2192        # since that is the option presented to the user. To accomplish this, we map the bootstrap classes\n   600\u2192        # to their annotated names and do a reverse lookup from the override bootstrap class to the annotated name.\n   601\u2192        #\n   602\u2192        # We do it this way to ensure consistent prompting for the user.\n   603\u2192        if bootstrap_override := project_overrides.pop(\"bootstrap\", None):\n   604\u2192            reverse_lookup = {v: k for k, v in bootstrap_options.items()}\n   605\u2192            if self.validate_selection_override(bootstraps.keys(), bootstrap_override):\n   606\u2192                bootstrap_override = reverse_lookup[bootstraps[bootstrap_override]]\n   607\u2192\n   608\u2192        selected_bootstrap = self.select_option(\n   609\u2192            intro=(\n   610\u2192                \"What GUI toolkit do you want to use for this project?\\n\"\n   611\u2192                \"\\n\"\n   612\u2192                \"Additional GUI bootstraps are available; visit \"\n   613\u2192                \"https://beeware.org/bee/briefcase-bootstraps \"\n   614\u2192                \"for a full list of known GUI bootstraps.\"\n   615\u2192            ),\n   616\u2192            variable=\"GUI Framework\",\n   617\u2192            default=None,\n   618\u2192            options=bootstrap_options.keys(),\n   619\u2192            override_value=bootstrap_override,\n   620\u2192        )\n   621\u2192        bootstrap_class = bootstrap_options[selected_bootstrap]\n   622\u2192\n   623\u2192        gui_context = {}\n   624\u2192\n   625\u2192        if bootstrap_class is not None:\n   626\u2192            bootstrap: BaseGuiBootstrap = bootstrap_class(context=context)\n   627\u2192\n   628\u2192            # Iterate over the Bootstrap interface to build the context.\n   629\u2192            # Returning ``None`` is a special case that means the field should not be\n   630\u2192            # included in the context and instead deferred to the template default.\n   631\u2192\n   632\u2192            if hasattr(bootstrap, \"extra_context\"):\n   633\u2192                if (additional_context := bootstrap.extra_context()) is not None:\n   634\u2192                    gui_context.update(additional_context)\n   635\u2192\n   636\u2192            for context_field in bootstrap.fields:\n   637\u2192                if (context_value := getattr(bootstrap, context_field)()) is not None:\n   638\u2192                    gui_context[context_field] = context_value\n   639\u2192\n   640\u2192        return gui_context\n   641\u2192\n   642\u2192    def _gui_bootstrap_choices(self, bootstraps):\n   643\u2192        \"\"\"Construct the list of available GUI bootstraps to display to the user.\"\"\"\n   644\u2192        # Sort the options alphabetically first\n   645\u2192        ordered = OrderedDict(sorted(bootstraps.items()))\n   646\u2192\n   647\u2192        # Ensure the first 5 options are: Toga, PySide6, Pygame\n   648\u2192        ordered.move_to_end(\"Pygame\", last=False)\n   649\u2192        ordered.move_to_end(\"PySide6\", last=False)\n   650\u2192        ordered.move_to_end(\"Toga\", last=False)\n   651\u2192\n   652\u2192        # Option None should always be last\n   653\u2192        ordered[\"None\"] = None\n   654\u2192        ordered.move_to_end(\"None\")\n   655\u2192\n   656\u2192        # Construct the bootstrap options as they should be presented to users.\n   657\u2192        # The name of the bootstrap is its registered entry point name. Along with the\n   658\u2192        # bootstrap's name, a short message important to a user's choice can be shown\n   659\u2192        # also; for instance, several show \"does not support iOS/Android deployment\".\n   660\u2192        bootstrap_choices = {}\n   661\u2192        max_len = max(map(len, ordered))\n   662\u2192        for name, klass in ordered.items():\n   663\u2192            if annotation := getattr(klass, \"display_name_annotation\", \"\"):\n   664\u2192                annotation = f\"{' ' * (max_len - len(name))} ({annotation})\"\n   665\u2192            bootstrap_choices[f\"{name}{annotation or ''}\"] = klass\n   666\u2192\n   667\u2192        return bootstrap_choices\n   668\u2192\n   669\u2192    def warn_unused_overrides(self, project_overrides: dict[str, str] | None):\n   670\u2192        \"\"\"Inform user of project configuration overrides that were not used.\"\"\"\n   671\u2192        if project_overrides:\n   672\u2192            unused_overrides = \"\\n    \".join(\n   673\u2192                f\"{key} = {value}\" for key, value in project_overrides.items()\n   674\u2192            )\n   675\u2192            self.logger.warning()\n   676\u2192            self.logger.warning(\n   677\u2192                \"WARNING: These project configuration overrides were not used:\\n\\n\"\n   678\u2192                f\"    {unused_overrides}\"\n   679\u2192            )\n   680\u2192\n   681\u2192    def new_app(\n   682\u2192        self,\n   683\u2192        template: str | None = None,\n   684\u2192        template_branch: str | None = None,\n   685\u2192        project_ov