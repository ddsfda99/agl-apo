pp description, using hints from the pyproject.toml file if\n   262\u2192        there are any.\n   263\u2192\n   264\u2192        If the description is specified in a PEP621 compliant pyproject.toml file, then\n   265\u2192        it is used without prompting.\n   266\u2192\n   267\u2192        :returns: The app description\n   268\u2192        \"\"\"\n   269\u2192        if \"description\" in self.pep621_data and override_value is None:\n   270\u2192            description = self.pep621_data[\"description\"]\n   271\u2192\n   272\u2192            self.prompt_divider(title=\"Description\")\n   273\u2192            self.input.prompt()\n   274\u2192            self.input.prompt(\n   275\u2192                f\"Using value from PEP621 formatted pyproject.toml {description!r}\"\n   276\u2192            )\n   277\u2192            return description\n   278\u2192\n   279\u2192        return self.input_text(\n   280\u2192            intro=\"Now, we need a one line description for your application.\",\n   281\u2192            variable=\"description\",\n   282\u2192            default=\"My first application\",\n   283\u2192            override_value=override_value,\n   284\u2192        )\n   285\u2192\n   286\u2192    def input_url(self, app_name, override_value: str | None) -> str:\n   287\u2192        \"\"\"Ask about the URL, using hints from the pyproject.toml file if there are any.\n   288\u2192\n   289\u2192        :returns: The project\n   290\u2192        \"\"\"\n   291\u2192        options = list(self.pep621_data.get(\"urls\", {}).values())\n   292\u2192\n   293\u2192        if not options or override_value:\n   294\u2192            default = self.make_project_url(\"com.example\", app_name)\n   295\u2192            return self.input_text(\n   296\u2192                intro=(\n   297\u2192                    \"What website URL do you want to use for this application? Based \"\n   298\u2192                    f\"on your existing 'pyproject.toml', this might be {default}\"\n   299\u2192                ),\n   300\u2192                variable=\"application URL\",\n   301\u2192                default=default,\n   302\u2192                validator=validate_url,\n   303\u2192                override_value=override_value,\n   304\u2192            )\n   305\u2192\n   306\u2192        options.append(\"Other\")\n   307\u2192        url = self.select_option(\n   308\u2192            intro=(\n   309\u2192                \"What website URL do you want to use for this application? The \"\n   310\u2192                \"following URLs are defined in your existing 'pyproject.toml'; \"\n   311\u2192                \"select 'Other' to provide a different URL.\"\n   312\u2192            ),\n   313\u2192            variable=\"application URL\",\n   314\u2192            default=None,\n   315\u2192            options=options,\n   316\u2192            override_value=override_value,\n   317\u2192        )\n   318\u2192\n   319\u2192        if url == \"Other\":\n   320\u2192            url = self.input_text(\n   321\u2192                intro=\"What website URL do you want to use for the application?\",\n   322\u2192                variable=\"application URL\",\n   323\u2192                default=self.make_project_url(\"com.example\", app_name),\n   324\u2192                validator=validate_url,\n   325\u2192            )\n   326\u2192\n   327\u2192        return url\n   328\u2192\n   329\u2192    def input_bundle(self, url, app_name, override_value: str | None) -> str:\n   330\u2192        default = \".\".join(reversed(urlparse(url).netloc.split(\".\")))\n   331\u2192        return self.input_text(\n   332\u2192            intro=(\n   333\u2192                \"Now we need a bundle identifier for your application.\\n\"\n   334\u2192                \"\\n\"\n   335\u2192                \"App stores need to protect against having multiple applications with \"\n   336\u2192                \"the same name; the bundle identifier is the namespace they use to \"\n   337\u2192                \"identify applications that come from you. The bundle identifier is \"\n   338\u2192                \"usually the domain name of your company or project, in reverse \"\n   339\u2192                \"order.\\n\"\n   340\u2192                \"\\n\"\n   341\u2192                \"Based on the application URL you selected, it looks like your bundle \"\n   342\u2192                f\"should be '{default}'. The bundle will be combined with your \"\n   343\u2192                \"application's machine readable name to form a complete application \"\n   344\u2192                f\"identifier ('{default}.{app_name}').\"\n   345\u2192            ),\n   346\u2192            variable=\"bundle identifier\",\n   347\u2192            default=default,\n   348\u2192            validator=self.validate_bundle,\n   349\u2192            override_value=override_value,\n   350\u2192        )\n   351\u2192\n   352\u2192    def input_author(self, override_value: str | None) -> str:\n   353\u2192        \"\"\"Ask about the author name, using hints from the pyproject.toml file if there\n   354\u2192        are any.\n   355\u2192\n   356\u2192        :returns: author name\n   357\u2192        \"\"\"\n   358\u2192        intro = (\n   359\u2192            \"Who do you want to be credited as the author of this application? \"\n   360\u2192            \"This could be your own name, or the name of your company you work for.\"\n   361\u2192        )\n   362\u2192\n   363\u2192        options = [\n   364\u2192            author[\"name\"]\n   365\u2192            for author in self.pep621_data.get(\"authors\", [])\n   366\u2192            if \"name\" in author\n   367\u2192        ]\n   368\u2192\n   369\u2192        if not options or override_value is not None:\n   370\u2192            return self.input_text(\n   371\u2192                intro=intro,\n   372\u2192                variable=\"author\",\n   373\u2192                default=\"Jane Developer\",\n   374\u2192                override_value=override_value,\n   375\u2192            )\n   376\u2192        elif len(options) > 1:\n   377\u2192            # Add a line with all authors joined: E.g. 'Jane Developer & Joe Developer'\n   378\u2192            # and a line with Other\n   379\u2192            options.append(\", \".join(options[:-1]) + f\" & {options[-1]}\")\n   380\u2192\n   381\u2192        options.append(\"Other\")\n   382\u2192\n   383\u2192        # We want to use the input_text-function if override_value is provided or if the selected author is \"Other\"\n   384\u2192        # However, since we don't want the select_option prompt if an override value is provided, we need to\n   385\u2192        # initialise the author variable here.\n   386\u2192        author = self.select_option(\n   387\u2192            intro=(\n   388\u2192                intro\n   389\u2192                + \"\\n\\n\"\n   390\u2192                + \"We found these author names in the PEP621 formatted \"\n   391\u2192                + \"'pyproject.toml'. Who do you want to be credited as the author of \"\n   392\u2192                + \"this application?\"\n   393\u2192            ),\n   394\u2192            variable=\"Author\",\n   395\u2192            options=options,\n   396\u2192            default=None,\n   397\u2192            override_value=None,\n   398\u2192        )\n   399\u2192        if author == \"Other\":\n   400\u2192            author = self.input_text(\n   401\u2192                intro=\"Who do you want to be credited as the author of this application?\",\n   402\u2192                variable=\"author\",\n   403\u2192                default=\"Jane Developer\",\n   404\u2192                override_value=None,\n   405\u2192            )\n   406\u2192\n   407\u2192        return author\n   408\u2192\n   409\u2192    def input_email(self, author: str, bundle: str, override_value: str | None) -> str:\n   410\u2192        \"\"\"Ask about the author email, using hints from the pyproject.toml file if there\n   411\u2192        are any.\n   412\u2192\n   413\u2192        :returns: author email\n   414\u2192        \"\"\"\n   415\u2192        default = self.make_author_email(author, bundle)\n   416\u2192        default_source = \"the author name and bundle\"\n   417\u2192        for author_info in self.pep621_data.get(\"authors\", []):\n   418\u2192            if author_info.get(\"name\") == author and author_info.get(\"email\"):\n   419\u2192                default = author_info[\"email\"]\n   420\u2192                default_source = \"the selected author name\"\n   421\u2192\n   422\u2192        intro = (\n   423\u2192            \"What email address should people use to contact the developers of this \"\n   424\u2192            \"application? This might be your own email address, or a generic contact address \"\n   425\u2192            f\"you set up specifically for this application. Based on {default_source}, \"\n   426\u2192            f\"we believe it could be '{default}'.\"\n   427\u2192        )\n   428\u2192\n   429\u2192        author_email = self.input_text(\n   430\u2192            intro=intro,\n   431\u2192            variable=\"author's email\",\n   432\u2192            default=default,\n   433\u2192            validator=self.validate_email,\n   434\u2192            override_value=override_value,\n   435\u2192        )\n   436\u2192\n   437\u2192        return author_email\n   438\u2192\n   439\u2192    def get_license_from_text(self, license_text: str) -> str:\n   440\u2192        \"\"\"Infer the license from the license file.\"\"\"\n   441\u2192        # The order here is quite important. If we have GPLvX+ after GPLvX, then it will\n   442\u2192        # never be matched if the license text is GPLvX+, since it will already have\n   443\u2192        # matched GPLvX. We search for MIT last, because words like PERMITTED and\n   444\u2192        # LIMITED will generate a false match.\n   445\u2192\n   446\u2192        hint_patterns = {\n   447\u2192            \"Apache Software License\": [\"Apache\"],\n   448            \"BSD license\": [\n   449\u2192                \"Redistribution and use in source and binary forms\",\n   450\u2192                \"BSD\",\n   451\u2192            ],\n   452\u2192            \"GNU General Public License v2 or later (GPLv2+)\": [\n   453\u2192                \"Free Software Foundation, either version 2 of the License\",\n   454\u2192                \"GPLv2+\",\n   455\u2192            ],\n   456\u2192            \"GNU General Public License v2 (GPLv2)\": [\n   457\u2192                \"version 2 of the GNU General Public License\",\n   458\u2192                \"GPLv2\",\n   459\u2192            ],\n   460\u2192            \"GNU General Public License v3 or later (GPLv3+)\": [\n   461\u2192                \"either version 3 of the License\",\n   462\u2192                \"GPLv3+\",\n   463\u2192            ],\n   464\u2192            \"GNU General Public License v3 (GPLv3)\": [\n   465\u2192                \"version 3 of the GNU General Public License\",\n   466\u2192                \"GPLv3\",\n   467\u2192            ],\n   468\u2192            \"MIT license\": [\n   469\u2192                \"Permission is hereby granted, free of charge\",\n   470\u2192                \"MIT\",\n   471\u2192            ],\n   472\u2192        }\n   473\u2192        for hint, license_patterns in hint_patterns.items():\n   474\u2192            for license_pattern in license_patterns:\n   475\u2192                if license_pattern.lower() in license_text.lower():\n   476\u2192                    return hint\n   477\u2192\n   478\u2192        return \"Other\"\n   479\u2192\n   480\u2192    def get_license_hint(self) -> tuple[str | None, str]:\n   481\u2192        \"\"\"Get hint for project license, either by reading pyproject.toml or the license\n   482\u2192        file.\n   483\u2192\n   484\u2192        :returns: The default value of the license - None if we cannot infer a license.\n   485\u2192        :returns: The intro text to use when prompting the license\n   486\u2192        \"\"\"\n   487\u2192        intro = \"What license do you want to use for this project's code? \"\n   488\u2192        default = None\n   489\u2192\n   490\u2192        # If there is license information in the pyproject.toml file, use that, otherwise check the license file\n   491\u2192        if \"text\" in self.pep621_data.get(\"license\", {}):\n   492\u2192            default = self.get_license_from_text(self.pep621_data[\"license\"][\"text\"])\n   493\u2192            default_source = \"the PEP621 formatted pyproject.toml\"\n   494\u2192        elif \"file\" in self.pep621_data.get(\"license\", {}):\n   495\u2192            license_text = (\n   496\u2192                self.base_path / self.pep621_data[\"license\"][\"file\"]\n   497\u2192            ).read_text(encoding=\"utf-8\")\n   498\u2192            default = self.get_license_from_text(license_text)\n   499\u2192            default_source = \"the license file\"\n   500\u2192        elif (self.base_path / \"LICENSE\").exists():\n   501\u2192            license_text = (self.base_path / \"LICENSE\").read_text(encoding=\"utf-8\")\n   502\u2192            default = self.get_license_from_text(license_text)\n   503\u2192            default_source = \"the license file\"\n   504\u2192        elif (self.base_path / \"LICENCE\").exists():\n   505\u2192            license_text = (self.base_path / \"LICENCE\").read_text(encoding=\"utf-8\")\n   506\u2192            default = self.get_license_from_text(license_text)\n   507\u2192            default_source = \"the license file\"\n   508\u2192        else:\n   509\u2192            return None, intro\n   510\u2192\n   511\u2192        intro += f\"\\nBased on {default_source} we believe it is {default!r}.\"\n   512\u2192        return default, intro\n   513\u2192\n   514\u2192    def input_license(self, override_value: str | None) -> str:\n   515\u2192        \"\"\"Ask about the license, using hints from the pyproject.toml or license file if\n   516\u2192        there are any.\n   517\u2192\n   518\u2192        :returns: The project\n   519\u2192        \"\"\"\n   520\u2192        default, intro = self.get_license_hint()\n   521\u2192        options = [\n   522\u2192            \"BSD license\",\n   523\u2192            \"MIT license\",\n   524\u2192            \"Apache Software License\",\n   525\u2192            \"GNU General Public License v2 (GPLv2)\",\n   526\u2192            \"GNU General Public License v2 or later (GPLv2+)\",\n   527\u2192            \"GNU General Public License v3 (GPLv3)\",\n   528\u2192            \"GNU General Public License v3 or later (GPLv3+)\",\n   529\u2192            \"Proprietary\",\n   530\u2192            \"Other\",\n   531\u2192        ]\n   532\u2192\n   533\u2192        return self.select_option(\n   534\u2192            intro=intro,\n   535\u2192            variable=\"Project License\",\n   536\u2192            options=options,\n   537\u2192            default=default,\n   538\u2192            override_value=override_value,\n   539\u2192        )\n   540\u2192\n   541\u2192    def build_app_context(self, project_overrides):\n   542\u2192        \"\"\"Ask the user for details about the app to be created.\n   543\u2192\n   544\u2192        :returns: A context dictionary to be used in the cookiecutter project template.\n   545\u2192        \"\"\"\n   546\u2192        app_name = self.input_app_name(\n   547\u2192            override_value=project_overrides.pop(\"app_name\", None)\n   548\u2192        )\n   549\u2192        formal_name = self.input_formal_name(\n   550\u2192            app_name, override_value=project_overrides.pop(\"formal_name\", None)\n   551\u2192        )\n   552\u2192        # The class name can be completely derived from the formal name.\n   553\u2192        class_name = make_class_name(formal_name)\n   554\u2192        # The module name can be completely derived from the app name.\n   555\u2192        module_name = self.make_module_name(app_name)\n   556\u2192        source_dir = self.input_source_dir(\n   557\u2192            app_name,\n   558\u2192            module_name,\n   559\u2192            override_value=project_overrides.pop(\"source_dir\", None),\n   560\u2192        )\n   561\u2192        test_source_dir = self.input_test_source_dir(\n   562\u2192            module_name, override_value=project_overrides.pop(\"test_source_dir\", None)\n   563\u2192        )\n   564\u2192        project_name = self.input_project_name(\n   565\u2192            formal_name, override_value=project_overrides.pop(\"project_name\", None)\n   566\u2192        )\n   567\u2192        description = self.input_description(\n   568\u2192            override_value=project_overrides.pop(\"description\", None)\n   569\u2192        )\n   570\u2192        url = self.input_url(app_name, project_overrides.pop(\"url\", None))\n   571\u2192        bundle = self.input_bundle(url, app_name, project_overrides.pop(\"bundle\", None))\n   572\u2192        author = self.input_author(override_value=project_overrides.pop(\"author\", None))\n   573\u2192        author_email = self.input_email(\n   574\u2192            author, bundle, override_value=project_overrides.pop(\"author_email\", None)\n   575\u2192        )\n   576\u2192        project_license = self.input_license(\n   577\u2192            override_value=project_overrides.pop(\"license\", None)\n   578\u2192        )\n   579\u2192\n   580\u2192        return {\n   581\u2192            \"formal_name\": formal_name,\n   582\u2192            \"app_name\": app_name,\n   583\u2192            \"class_name\": class_name,\n   584\u2192            \"module_name\": module_name,\n   585\u2192            \"project_name\": project_name,\n   586\u2192            \"source_dir\": source_dir,\n   587\u2192            \"test_source_dir\": test_source_dir,\n   588\u2192            \"description\": description,\n   589\u2192            \"author\": author,\n   590\u2192            \"author_email\": author_email,\n   591\u2192            \"bundle\": bundle,\n   592\u2192            \"url\": url,\n   593\u2192            \"license\": project_license,\n   594\u2192        }\n   595\u2192\n   596\u2192    def build_gui_context(\n   597\u2192        self,\n   598\u2192        context: dict[str, str],\n   599\u2192        project_overrides: dict[str, str],\n   600\u2192    ) -> dict[str, str]:\n   601\u2192        # We must set the GUI-framework to None here since the convert-command uses the new-command\n   602\u2192        # template. This template includes dependencies for the GUI-frameworks. However, if a project\n   603\u2192        # already is set up for a GUI-framework, then those dependencies should already be listed.\n   604\u2192        # To prevent the same dependency being listed twice (once in the PEP621-section and once in the\n   605\u2192        # briefcase-section), possibly with different versions, we set the GUI-framework to None here.\n   606\u2192        return {\"gui_framework\": \"None\"}\n   607\u2192\n   608\u2192    def merge_or_copy_pyproject(self, briefcase_config_file: Path) -> None:\n   609\u2192        \"\"\"Merge pyproject.toml file made by the cookiecutter with the one in the\n   610\u2192        existing project.\n   611\u2192\n   612\u2192        If the target directory doesn't have a pyproject.toml file, then the newly\n   613\u2192        created will be copied\n   614\u2192\n   615\u2192        :param briefcase_config_file: The path to the project created by the\n   616\u2192            cookiecutter.\n   617\u2192        \"\"\"\n   618\u2192        pyproject_file = self.base_path / \"pyproject.toml\"\n   619\u2192\n   620\u2192        briefcase_pyproject = briefcase_config_file.read_text(encoding=\"utf-8\")\n   621\u2192        if pyproject_file.exists():\n   622\u2192            pep621_pyproject = pyproject_file.read_text(encoding=\"utf-8\")\n   623\u2192\n   624\u2192            # The pyproject.toml file in the target directory has no briefcase keys, so it's\n   625\u2192            # safe to copy-paste the text, and that way also keep formatting and comments.\n   626\u2192            # We merge it this way to preserve comments in the original pyproject.toml file\n   627\u2192            briefcase_comment = \"# content below this line added by briefcase convert\"\n   628\u2192            merged_pyproject = (\n   629\u2192                f\"{pep621_pyproject}\\n\\n\\n{briefcase_comment}\\n{briefcase_pyproject}\"\n   630\u2192            )\n   631\u2192        else:\n   632\u2192            merged_pyproject = briefcase_pyproject\n   633\u2192\n   634\u2192        with open(pyproject_file, \"w\", encoding=\"utf-8\") as file:\n   635\u2192            file.write(merged_pyproject)\n   636\u2192\n   637\u2192    def migrate_necessary_files(self, project_dir, test_source_dir, module_name):\n   638\u2192        \"\"\"Copy and merge the necessary files from project_dir to the current base path.\n   639\u2192\n   640\u2192        Will warn a LICENSE or CHANGELOG file is missing.\n   641\u2192\n   642\u2192        :param project_dir: The path to the project created by the cookiecutter.\n   643\u2192        :param test_source_dir: The path to the directory that should contain the test\n   644\u2192            entry script\n   645\u2192        \"\"\"\n   646\u2192        self.merge_or_copy_pyproject(project_dir / \"pyproject.toml\")\n   647\u2192\n   648\u2192        # Copy license file if not already there\n   649\u2192        license_file = self.pep621_data.get(\"license\", {}).get(\"file\")\n   650\u2192\n   651\u2192        if license_file is None and not (self.base_path / \"LICENSE\").exists():\n   652\u2192            self.logger.warning(\n   653\u2192                f\"\\nLicense file not found in '{self.base_path}'. \"\n   654\u2192                \"Briefcase will create a template 'LICENSE' file.\"\n   655\u21