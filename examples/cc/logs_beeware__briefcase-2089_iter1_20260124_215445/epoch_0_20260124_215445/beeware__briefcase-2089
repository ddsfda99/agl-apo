  If a data path is provided during construction, use it. This usually indicates\n   199→        we're under test conditions. If there's no data path provided, look for a\n   200→        BRIEFCASE_HOME environment variable. If that isn't defined, use a platform-\n   201→        specific default data path.\n   202→        \"\"\"\n   203→        if data_path is None:\n   204→            try:\n   205→                briefcase_home = os.environ[\"BRIEFCASE_HOME\"]\n   206→                data_path = Path(briefcase_home).resolve()\n   207→                # Path(\"\") converts to \".\", so check for that edge case.\n   208→                if briefcase_home == \"\" or not data_path.is_dir():\n   209→                    raise BriefcaseCommandError(\n   210→                        \"The path specified by BRIEFCASE_HOME does not exist.\"\n   211→                    )\n   212→            except KeyError:\n   213→                if platform.system() == \"Darwin\":  # pragma: no-cover-if-not-macos\n   214→                    # macOS uses a bundle name, rather than just the app name\n   215→                    app_name = \"org.beeware.briefcase\"\n   216→                else:  # pragma: no-cover-if-is-macos\n   217→                    app_name = \"briefcase\"\n   218→\n   219→                data_path = PlatformDirs(\n   220→                    appname=app_name,\n   221→                    appauthor=\"BeeWare\",\n   222→                ).user_cache_path\n   223→\n   224→        data_path = os.fsdecode(data_path)\n   225→\n   226→        if \" \" in data_path:\n   227→            raise BriefcaseCommandError(\n   228→                f\"\"\"\n   229→The location Briefcase will use to store tools and support files:\n   230→\n   231→    {data_path}\n   232→\n   233→contains spaces. This will cause problems with some tools, preventing\n   234→you from building and packaging applications.\n   235→\n   236→You can set the environment variable BRIEFCASE_HOME to specify\n   237→a custom location for Briefcase's tools.\n   238→\n   239→\"\"\"\n   240→            )\n   241→\n   242→        if not os.path.exists(data_path):\n   243→            try:\n   244→                # The Windows Store version of Python can redirect filesystem\n   245→                # interactions within %LOCALAPPDATA% to a sandboxed location.\n   246→                # To bypass this, the Briefcase cache directory creation is\n   247→                # performed via ``cmd.exe`` in a different process. Once this\n   248→                # directory exists in the \"real\" %LOCALAPPDATA%, Windows will\n   249→                # allow normal interactions without attempting to sandbox them.\n   250→                if platform.system() == \"Windows\":  # pragma: no-cover-if-not-windows\n   251→                    subprocess.run(\n   252→                        [\"mkdir\", data_path],\n   253→                        shell=True,\n   254→                        check=True,\n   255→                        stdout=subprocess.DEVNULL,\n   256→                        stderr=subprocess.DEVNULL,\n   257→                    )\n   258→                else:  # pragma: no-cover-if-is-windows\n   259→                    os.makedirs(data_path, exist_ok=True)\n   260→            except (subprocess.CalledProcessError, OSError):\n   261→                raise BriefcaseCommandError(\n   262→                    f\"\"\"\n   263→Failed to create the Briefcase directory to store tools and support files:\n   264→\n   265→    {data_path}\n   266→\n   267→You can set the environment variable BRIEFCASE_HOME to specify\n   268→a custom location for Briefcase's tools.\n   269→\n   270→\"\"\"\n   271→                )\n   272→\n   273→        return Path(data_path)\n   274→\n   275→    def validate_locale(self):\n   276→        \"\"\"Validate the system's locale is compatible.\"\"\"\n   277→        if self.tools.host_os == \"Linux\" and self.tools.system_encoding != \"UTF-8\":\n   278→            self.logger.warning(\n   279→                f\"\"\"\n   280→*************************************************************************\n   281→** WARNING: Default system encoding is not supported                   **\n   282→*************************************************************************\n   283→\n   284→    Briefcase and the third-party tools it uses only support UTF-8.\n   285→\n   286→    The detected default system encoding is {self.tools.system_encoding}.\n   287→\n   288→    Briefcase will proceed but some console output could be corrupted and\n   289→    created files or artefacts may contain corrupted text.\n   290→\n   291→    Update your system's encoding to UTF-8 to avoid issues.\n   292→\n   293→*************************************************************************\n   294→\"\"\"\n   295→            )\n   296→\n   297→    def _command_factory(self, command_name: str):\n   298→        \"\"\"Command factory for the current platform and format.\n   299→\n   300→        :param command_name: name of Command (e.g. 'create', 'build', 'run', etc.)\n   301→        :return: instantiated Command\n   302→        \"\"\"\n   303→        format_module = importlib.import_module(self.__module__)\n   304→        command = getattr(format_module, command_name)(\n   305→            base_path=self.base_path,\n   306→            apps=self.apps,\n   307→            logger=self.logger,\n   308→            console=self.input,\n   309→            tools=self.tools,\n   310→            is_clone=True,\n   311→        )\n   312→        command.clone_options(self)\n   313→        return command\n   314→\n   315→    @property\n   316→    def create_command(self):\n   317→        \"\"\"Create Command factory for the same platform and format.\"\"\"\n   318→        return self._command_factory(\"create\")\n   319→\n   320→    @property\n   321→    def update_command(self):\n   322→        \"\"\"Update Command factory for the same platform and format.\"\"\"\n   323→        return self._command_factory(\"update\")\n   324→\n   325→    @property\n   326→    def build_command(self):\n   327→        \"\"\"Build Command factory for the same platform and format.\"\"\"\n   328→        return self._command_factory(\"build\")\n   329→\n   330→    @property\n   331→    def run_command(self):\n   332→        \"\"\"Run Command factory for the same platform and format.\"\"\"\n   333→        return self._command_factory(\"run\")\n   334→\n   335→    @property\n   336→    def package_command(self):\n   337→        \"\"\"Package Command factory for the same platform and format.\"\"\"\n   338→        return self._command_factory(\"package\")\n   339→\n   340→    @property\n   341→    def publish_command(self):\n   342→        \"\"\"Publish Command factory for the same platform and format.\"\"\"\n   343→        return self._command_factory(\"publish\")\n   344→\n   345→    def template_cache_path(self, template) -> Path:\n   346→        \"\"\"The path where Briefcase keeps template checkouts.\n   347→\n   348→        :param template: The URL for the template that will be cached locally.\n   349→        \"\"\"\n   350→        template = template.rstrip(\"/\")\n   351→        tail = template.split(\"/\")[-1]\n   352→        cache_name = tail.rsplit(\".git\")[0]\n   353→        return self.data_path / \"templates\" / cache_name\n   354→\n   355→    def build_path(self, app) -> Path:\n   356→        \"\"\"The path in which all platform artefacts for the app will be built.\n   357→\n   358→        :param app: The app config\n   359→        \"\"\"\n   360→        return self.base_path / \"build\" / app.app_name / self.platform.lower()\n   361→\n   362→    @property\n   363→    def dist_path(self) -> Path:\n   364→        \"\"\"The path for all applications for this command's platform.\"\"\"\n   365→        return self.base_path / \"dist\"\n   366→\n   367→    def bundle_path(self, app) -> Path:\n   368→        \"\"\"The path to the bundle for the app in the output format.\n   369→\n   370→        The bundle is the template-generated source form of the app. The path will\n   371→        usually be a directory, the existence of which is indicative that the template\n   372→        has been rolled out for an app. The leaf of this path is the base of the content\n   373→        generated from template.\n   374→\n   375→        :param app: The app config\n   376→        \"\"\"\n   377→        return self.build_path(app) / self.output_format.lower()\n   378→\n   379→    @abstractmethod\n   380→    def binary_path(self, app) -> Path:\n   381→        \"\"\"The path to the executable artefact for the app in the output format.\n   382→\n   383→        This may be a binary file produced by compilation; however, if the output format\n   384→        doesn't require compilation, it may be the same as the bundle path (assuming the\n   385→        bundle path is inherently \"executable\"), or a path that reasonably represents\n   386→        the thing that can be executed.\n   387→\n   388→        :param app: The app config\n   389→        \"\"\"\n   390→\n   391→    def binary_executable_path(self, app) -> Path:\n   392→        \"\"\"The path to the actual binary object for the app in the output format.\n   393→\n   394→        For most platforms, this will be the same as the binary path. However, for\n   395→        platforms that use an \"executable bundle\" (e.g., macOS), this will be actual\n   396→        binary that is embedded in the bundle.\n   397→\n   398→        :param app: The app config\n   399→        \"\"\"\n   400→        return self.binary_path(app)\n   401→\n   402→    def unbuilt_executable_path(self, app) -> Path:\n   403→        \"\"\"The path to the unbuilt form of the binary object for the app.\n   404→\n   405→        The pre-built stub binary may need to undergo some manipulation before it can be\n   406→        used; to mark that this manipulation is required, the \"unbuilt\" binary has a\n   407→        \"raw\" name that doesn't involve any app details. The build step moves the binary\n   408→        to the final name.\n   409→\n   410→        :param app: The app config\n   411→        \"\"\"\n   412→        return self.binary_executable_path(app).parent / (\n   413→            \"Stub\" + self.binary_executable_path(app).suffix\n   414→        )\n   415→\n   416→    def briefcase_toml(self, app: AppConfig) -> dict[str, ...]:\n   417→        \"\"\"Load the ``briefcase.toml`` file provided by the app template.\n   418→\n   419→        :param app: The config object for the app\n   420→        :return: The contents of ``briefcase.toml``\n   421→        \"\"\"\n   422→        try:\n   423→            return self._briefcase_toml[app]\n   424→        except KeyError:\n   425→            try:\n   426→                with (self.bundle_path(app) / \"briefcase.toml\").open(\"rb\") as f:\n   427→                    self._briefcase_toml[app] = tomllib.load(f)\n   428→            except OSError as e:\n   429→                raise MissingAppMetadata(self.bundle_path(app)) from e\n   430→            else:\n   431→                return self._briefcase_toml[app]\n   432→\n   433→    def path_index(self, app: AppConfig, path_name: str) -> str | dict | list:\n   434→        \"\"\"Return a path from the path index provided by the app template.\n   435→\n   436→        Raises KeyError if ``path_name`` is not defined in the index.\n   437→\n   438→        :param app: The config object for the app\n   439→        :param path_name: Name of the filepath to retrieve\n   440→        :return: filepath for requested path\n   441→        \"\"\"\n   442→        return self.briefcase_toml(app)[\"paths\"][path_name]\n   443→\n   444→    def template_target_version(self, app: AppConfig) -> str | None:\n   445→        \"\"\"The target version of Briefcase for the app from ``briefcase.toml``.\n   446→\n   447→        This value represents a version epoch specific to the platform. An epoch begins\n   448→        when a breaking change is introduced. Therefore, this value would remain the\n   449→        version of Briefcase that introduced a breaking change for a template until\n   450→        another such change requires a new epoch.\n   451→\n   452→        :param app: The config object for the app\n   453→        :return: target version or None if one isn't specified\n   454→        \"\"\"\n   455→        try:\n   456→            return self.briefcase_toml(app)[\"briefcase\"][\"target_version\"]\n   457→        except KeyError:\n   458→            return None\n   459→\n   460→    def stub_binary_revision(self, app: AppConfig) -> str:\n   461→        \"\"\"Obtain the stub binary revision that the template requires.\n   462→\n   463→        :param app: The config object for the app\n   464→        :return: The stub binary revision required by the template.\n   465→        \"\"\"\n   466→        return self.path_index(app, \"stub_binary_revision\")\n   467→\n   468→    def support_path(self, app: AppConfig) -> Path:\n   469→        \"\"\"Obtain the path into which the support package should be unpacked.\n   470→\n   471→        :param app: The config object for the app\n   472→        :return: The full path where the support package should be unpacked.\n   473→        \"\"\"\n   474→        return self.bundle_path(app) / self.path_index(app, \"support_path\")\n   475→\n   476→    def support_revision(self, app: AppConfig) -> str:\n   477→        \"\"\"Obtain the support package revision that the template requires.\n   478→\n   479→        :param app: The config object for the app\n   480→        :return: The support revision required by the template.\n   481→        \"\"\"\n   482→        return self.path_index(app, \"support_revision\")\n   483→\n   484→    def cleanup_paths(self, app: AppConfig) -> list[str]:\n   485→        \"\"\"Obtain the paths generated by the app template that should be cleaned up\n   486→        prior to release.\n   487→\n   488→        :param app: The config object