nd any \"\n   155→                \"capitalization will be used as you type it here.\\n\"\n   156→                \"\\n\"\n   157→                f\"Based on the app name, we suggest a formal name of '{default}', but \"\n   158→                \"you can use another name if you want.\"\n   159→            ),\n   160→            variable=\"formal name\",\n   161→            default=default,\n   162→            override_value=override_value,\n   163→        )\n   164→\n   165→    def get_source_dir_hint(self, app_name: str, module_name: str) -> tuple[str, str]:\n   166→        \"\"\"Parse folder layout to get hint for the source directory.\n   167→\n   168→        :returns: The source directory hint\n   169→        :returns: The description text for the source dir prompt.\n   170→        \"\"\"\n   171→        possible_src_dirs = [\n   172→            p.parent for p in self.base_path.glob(f\"**/{module_name}/__main__.py\")\n   173→        ]\n   174→        if (self.base_path / f\"src/{module_name}\") in possible_src_dirs:\n   175→            default = self.base_path / f\"src/{module_name}\"\n   176→        elif (self.base_path / module_name) in possible_src_dirs:\n   177→            default = self.base_path / module_name\n   178→        elif possible_src_dirs:\n   179→            default = min(\n   180→                possible_src_dirs,\n   181→                key=lambda p: (len(p.parents), len(str(p))),\n   182→            )\n   183→        else:  # We have already checked that there are directories in the project root\n   184→            raise BriefcaseCommandError(\n   185→                \"Cannot find a suitable source directory for the app.\\n\"\n   186→                \"\\n\"\n   187→                f\"Based on your app name, '{app_name}', you must have a directory \"\n   188→                f\"named '{module_name}', either in your project root or a subdirectory \"\n   189→                f\"(e.g. 'src/{module_name}'), that contains a '__main__.py'.\"\n   190→   