lass is not None:\n   626→            bootstrap: BaseGuiBootstrap = bootstrap_class(context=context)\n   627→\n   628→            # Iterate over the Bootstrap interface to build the context.\n   629→            # Returning ``None`` is a special case that means the field should not be\n   630→            # included in the context and instead deferred to the template default.\n   631→\n   632→            if hasattr(bootstrap, \"extra_context\"):\n   633→                if (additional_context := bootstrap.extra_context()) is not None:\n   634→                    gui_context.update(additional_context)\n   635→\n   636→            for context_field in bootstrap.fields:\n   637→                if (context_value := getattr(bootstrap, context_field)()) is not None:\n   638→                    gui_context[context_field] = context_value\n   639→\n   640→        return gui_context\n   641→\n   642→    def _gui_bootstrap_choices(self, bootstraps):\n   643→        \"\"\"Construct the list of available GUI bootstraps to display to the user.\"\"\"\n   644→        # Sort the options alphabetically first\n   645→        ordered = OrderedDict(sorted(bootstraps.items()))\n   646→\n   647→        # Ensure the first 5 options are: Toga, PySide6, Pygame\n   648→        ordered.move_to_end(\"Pygame\", last=False)\n   649→        ordered.move_to_end(\"PySide6\", last=False)\n   650→        ordered.move_to_end(\"Toga\", last=False)\n   651→\n   652→        # Option None should always be last\n   653→        ordered[\"None\"] = None\n   654→        ordered.move_to_end(\"None\")\n   655→\n   656→        # Construct the bootstrap options as they should be presented to users.\n   657→        # The name of the bootstrap is its registered entry point name. Along with the\n   658→        # bootstrap's name, a short message important to a user's choice can be shown\n   659→        # also; for instance, several show \"does not support iOS/Android deployment\".\n   660→        bootstrap_choices = {}\