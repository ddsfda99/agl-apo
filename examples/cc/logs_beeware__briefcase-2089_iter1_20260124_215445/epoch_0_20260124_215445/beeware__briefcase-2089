92        :return: The full path where the support package should be unpacked.\n   473\u2192        \"\"\"\n   474\u2192        return self.bundle_path(app) / self.path_index(app, \"support_path\")\n   475\u2192\n   476\u2192    def support_revision(self, app: AppConfig) -> str:\n   477\u2192        \"\"\"Obtain the support package revision that the template requires.\n   478\u2192\n   479\u2192        :param app: The config object for the app\n   480\u2192        :return: The support revision required by the template.\n   481\u2192        \"\"\"\n   482\u2192        return self.path_index(app, \"support_revision\")\n   483\u2192\n   484\u2192    def cleanup_paths(self, app: AppConfig) -> list[str]:\n   485\u2192        \"\"\"Obtain the paths generated by the app template that should be cleaned up\n   486\u2192        prior to release.\n   487\u2192\n   488\u2192        :param app: The config object for the app\n   489\u2192        :return: The list of path globs inside the app template that should be cleaned\n   490\u2192            up.\n   491\u2192        \"\"\"\n   492\u2192        return self.path_index(app, \"cleanup_paths\")\n   493\u2192\n   494\u2192    def app_requirements_path(self, app: AppConfig) -> Path:\n   495\u2192        \"\"\"Obtain the path into which a requirements.txt file should be written.\n   496\u2192\n   497\u2192        :param app: The config object for the app\n   498\u2192        :return: The full path where the requirements.txt file should be written\n   499\u2192        \"\"\"\n   500\u2192        return self.bundle_path(app) / self.path_index(app, \"app_requirements_path\")\n   501\u2192\n   502\u2192    def app_requirement_installer_args_path(self, app: AppConfig) -> Path:\n   503\u2192        \"\"\"Obtain the path into which a newline delimited requirement installer args\n   504\u2192        file should be written.\n   505\u2192\n   506\u2192        :param app: The config object for the app\n   507\u2192        :return: The full path where the file should be written\n   508\u2192        \"\"\"\n   509\u2192        return self.bundle_path(app) / self.path_index(\n   510\u2192            app, \"app_requirement_installer_args_path\"\n   511\u2192        )\n   512\u2192\n   513\u2192    def app_packages_path(self, app: AppConfig) -> Path:\n   514\u2192        \"\"\"Obtain the path into which requirements should be installed.\n   515\u2192\n   516\u2192        :param app: The config object for the app\n   517\u2192        :return: The full path where application requirements should be installed.\n   518\u2192        \"\"\"\n   519\u2192        return self.bundle_path(app) / self.path_index(app, \"app_packages_path\")\n   520\u2192\n   521\u2192    def app_path(self, app: AppConfig) -> Path:\n   522\u2192        \"\"\"Obtain the path into which the application should be installed.\n   523\u2192\n   524\u2192        :param app: The config object for the app\n   525\u2192        :return: The full path where application code should be installed.\n   526\u2192        \"\"\"\n   527\u2192        return self.bundle_path(app) / self.path_index(app, \"app_path\")\n   528\u2192\n   529\u2192    def app_module_path(self, app: AppConfig) -> Path:\n   530\u2192        \"\"\"Find the path for the application module for an app.\n   531\u2192\n   532\u2192        :param app: The config object for the app\n   533\u2192        :returns: The Path to the dist-info folder.\n   534\u2192        \"\"\"\n   535\u2192        app_home = [\n   536\u2192            path.split(\"/\")\n   537\u2192            for path in app.sources\n   538\u2192            if path.rsplit(\"/\", 1)[-1] == app.module_name\n   539\u2192        ]\n   540\u2192\n   541\u2192        if len(app_home) == 0:\n   542\u2192            raise BriefcaseCommandError(\n   543\u2192                f\"Unable to find code for application {app.app_name!r}\"\n   544\u2192            )\n   545\u2192        elif len(app_home) == 1:\n   546\u2192            path = Path(str(self.base_path), *app_home[0])\n   547\u2192        else:\n   548\u2192            raise BriefcaseCommandError(\n   549\u2192                f\"Multiple paths in sources found for application {app.app_name!r}\"\n   550\u2192            )\n   551\u2192\n   552\u2192        return path\n   553\u2192\n   554\u2192    @property\n   555\u2192    def briefcase_required_python_version(self):\n   556\u2192        \"\"\"The major.minor of the minimum Python version required by Briefcase itself.\n   557\u2192\n   558\u2192        This is extracted from packaging metadata.\n   559\u2192        \"\"\"\n   560\u2192        # Native format is \">=3.8\"\n   561\u2192        return tuple(\n   562\u2192            int(v)\n   563\u2192            for v in importlib.metadata.metadata(\"briefcase\")[\"Requires-Python\"]\n   564\u2192            .split(\"=\")[1]\n   565\u2192            .strip()\n   566\u2192            .split(\".\")\n   567\u2192        )\n   568\u2192\n   569\u2192    @property\n   570\u2192    def python_version_tag(self):\n   571\u2192        \"\"\"The major.minor of the Python version in use, as a string.\n   572\u2192\n   573\u2192        This is used as a repository label/tag to identify the appropriate templates,\n   574\u2192        etc. to use.\n   575\u2192        \"\"\"\n   576\u2192        return (\n   577\u2192            f\"{self.tools.sys.version_info.major}.{self.tools.sys.version_info.minor}\"\n   578\u2192        )\n   579\u2192\n   580\u2192    def verify_host(self):\n   581\u2192        \"\"\"Verify the host OS is supported by the Command.\"\"\"\n   582\u2192        if self.tools.host_os not in self.supported_host_os:\n   583\u2192            raise UnsupportedHostError(self.supported_host_os_reason)\n   584\u2192\n   585\u2192    def verify_tools(self):\n   586\u2192        \"\"\"Verify that the tools needed to run this Command exist.\n   587\u2192\n   588\u2192        Raises MissingToolException if a required system tool is missing.\n   589\u2192        \"\"\"\n   590\u2192\n   591\u2192    def finalize_app_config(self, app: AppConfig):\n   592\u2192        \"\"\"Finalize the application config.\n   593\u2192\n   594\u2192        Some app configurations (notably, Linux system packages like .deb) have\n   595\u2192        configurations that are deeper than other platforms, because they need to\n   596\u2192        include components that are dependent on command-line arguments. They may also\n   597\u2192        require the existence of system tools to complete configuration.\n   598\u2192\n   599\u2192        The final app configuration merges those \"deep\" properties into the app\n   600\u2192        configuration, and performs any other app-specific platform configuration and\n   601\u2192        verification that is required as a result of command-line arguments.\n   602\u2192\n   603\u2192        :param app: The app configuration to finalize.\n   604\u2192        \"\"\"\n   605\u2192\n   606\u2192    def finalize(self, app: AppConfig | None = None):\n   607\u2192        \"\"\"Finalize Briefcase configuration.\n   608\u2192\n   609\u2192        This will:\n   610\u2192\n   611\u2192        1. Ensure that the host has been verified\n   612\u2192        2. Ensure that the platform tools have been verified\n   613\u2192        3. Ensure that app configurations have been finalized.\n   614\u2192\n   615\u2192        App finalization will only occur once per invocation.\n   616\u2192\n   617\u2192        :param app: If provided, the specific app configuration\n   618\u2192            to finalize. By default, all apps will be finalized.\n   619\u2192        \"\"\"\n   620\u2192        self.verify_host()\n   621\u2192        self.verify_tools()\n   622\u2192\n   623\u2192        if app is None:\n   624\u2192            for app in self.apps.values():\n   625\u2192                if hasattr(app, \"__draft__\"):\n   626\u2192                    self.finalize_app_config(app)\n   627\u2192                    delattr(app, \"__draft__\")\n   628\u2192        else:\n   629\u2192            if hasattr(app, \"__draft__\"):\n   630\u2192                self.finalize_app_config(app)\n   631\u2192                delattr(app, \"__draft__\")\n   632\u2192\n   633\u2192    def verify_app(self, app: AppConfig):\n   634\u2192        \"\"\"Verify the app is compatible and the app tools are available.\n   635\u2192\n   636\u2192        This is the last step of verification for a Command before running the Command's\n   637\u2192        business logic. It runs _after_ pre-requisite Commands have been verified and\n   638\u2192        run.\n   639\u2192\n   640\u2192        :param app: app configuration\n   641\u2192        \"\"\"\n   642\u2192        self.verify_app_template(app)\n   643\u2192        self.verify_app_tools(app)\n   644\u2192        self.verify_required_python(app)\n   645\u2192\n   646\u2192    def verify_app_tools(self, app: AppConfig):\n   647\u2192        \"\"\"Verify that tools needed to run the command for this app exist.\"\"\"\n   648\u2192\n   649\u2192    def verify_app_template(self, app: AppConfig):\n   650\u2192        \"\"\"Verify the template targets the same Briefcase version as the Command.\n   651\u2192\n   652\u2192        :param app: app configuration\n   653\u2192        \"\"\"\n   654\u2192\n   655\u2192        # Skip this check if the template isn't rolled out\n   656\u2192        # or if the command doesn't support templates\n   657\u2192        try:\n   658\u2192            template_target_version = self.template_target_version(app)\n   659\u2192        except (MissingAppMetadata, NotImplementedError):\n   660\u2192            return\n   661\u2192\n   662\u2192        if self.platform_target_version != template_target_version:\n   663\u2192            raise BriefcaseCommandError(\n   664\u2192                f\"\"\"\\\n   665\u2192The app template used to generate this app is not compatible with this version\n   666\u2192of Briefcase.\n   667\u2192\n   668If the app was generated with an earlier version of Briefcase using the default\n   669\u2192Briefcase template, you can run:\n   670\u2192\n   671\u2192     $ briefcase create {self.platform} {self.output_format}\n   672\u2192\n   673\u2192to re-generate your app with a compatible version of the template.\n   674\u2192\n   675\u2192If you are using a custom template, you'll need to update the template to correct\n   676\u2192any compatibility problems, and then add the compatibility declaration.\n   677\u2192\"\"\"\n   678\u2192            )\n   679\u2192\n   680\u2192    def verify_required_python(self, app: AppConfig):\n   681\u2192        \"\"\"Verify that the running version of Python meets the project's specifications.\"\"\"\n   682\u2192\n   683\u2192        requires_python = getattr(self.global_config, \"requires_python\", None)\n   684\u2192        if not requires_python:\n   685\u2192            return\n   686\u2192\n   687\u2192        try:\n   688\u2192            spec = Specifier(requires_python)\n   689\u2192        except InvalidSpecifier as e:\n   690\u2192            raise BriefcaseConfigError(\n   691\u2192                f\"Invalid requires-python in pyproject.toml: {e}\"\n   692\u2192            ) from e\n   693\u2192\n   694\u2192        running_version = platform.python_version()\n   695\u2192\n   696\u2192        if not spec.contains(running_version, prereleases=True):\n   697\u2192            raise UnsupportedPythonVersion(\n   698\u2192                version_specifier=requires_python, running_version=running_version\n   699\u2192            )\n   700\u2192\n   701\u2192    def parse_options(self, extra):\n   702\u2192        \"\"\"Parse the command line arguments for the Command.\n   703\u2192\n   704\u2192        After the initial ArgumentParser runs to choose the Command for the selected\n   705\u2192        platform and format, a new ArgumentParser is created here to parse the remaining\n   706\u2192        command line arguments specific to the Command. Additionally, the default\n   707\u2192        options for disabling input, log verbosity, and log saving are parsed out and\n   708\u2192        saved to the Command.\n   709\u2192\n   710\u2192        :param extra: the remaining command line arguments after the initial\n   711\u2192            ArgumentParser runs over the command line.\n   712\u2192        :return: dictionary of parsed arguments for Command, and a dictionary of parsed\n   713\u2192            configuration overrides.\n   714\u2192        \"\"\"\n   715\u2192        default_format = getattr(\n   716\u2192            get_platforms().get(self.platform), \"DEFAULT_OUTPUT_FORMAT\", None\n   717\u2192        )\n   718\u2192        # only show supported formats for Commands that support formats\n   719\u2192        if default_format is not None and self.command not in {\"new\", \"dev\", \"upgrade\"}:\n   720\u2192            formats = list(get_output_formats(self.platform).keys())\n   721\u2192            formats[formats.index(default_format)] = f\"{default_format} (default)\"\n   722\u2192            supported_formats_helptext = (\n   723\u2192                f\"Supported formats:\\n  {', '.join(sorted(formats, key=str.lower))}\"\n   724\u2192            )\n   725\u2192        else:\n   726\u2192            supported_formats_helptext = \"\"\n   727\u2192\n   728\u2192        parser = argparse.ArgumentParser(\n   729\u2192            prog=self.cmd_line.format(\n   730\u2192                command=self.command,\n   731\u2192                platform=self.platform,\n   732\u2192                output_format=self.output_format,\n   733\u2192            ),\n   734\u2192            description=self.input.textwrap(\n   735\u2192                f\"{self.description}\\n\\n{supported_formats_helptext}\"\n   736\u2192            ),\n   737\u2192            formatter_class=(\n   738\u2192                lambda prog: RawDescriptionHelpFormatter(prog, width=MAX_TEXT_WIDTH)\n   739\u2192            ),\n   740\u2192        )\n   741\u2192\n   742\u2192        self.add_default_options(parser)\n   743\u2192        self.add_options(parser)\n   744\u2192\n   745\u2192        # If the command allows passthrough arguments, add an option for the help,\n   746\u2192        # then process the argument list to strip out the passthrough args.\n   747\u2192        if self.allows_passthrough:\n   748\u2192            parser.add_argument(\n   749\u2192                \"--\",\n   750\u2192                dest=\"passthrough\",\n   751\u2192                metavar=\"ARGS ...\",\n   752\u2192                required=False,\n   753\u2192                help=\"Arguments to pass to the app\",\n   754\u2192            )\n   755\u2192            args, passthrough = split_passthrough(extra)\n   756\u2192        else:\n   757\u2192            args = extra\n   758\u2192\n   759\u2192        # Parse the full set of command line options from the content\n   760\u2192        # remaining after the basic command/platform/output format\n   761\u2192        # has been extracted.\n   762\u2192        options = vars(parser.parse_args(args))\n   763\u2192\n   764\u2192        if self.allows_passthrough:\n   765\u2192            options[\"passthrough\"] = passthrough\n   766\u2192\n   767\u2192        # Extract the base default options onto the command\n   768\u2192        self.input.enabled = options.pop(\"input_enabled\")\n   769\u2192        self.logger.verbosity = options.pop(\"verbosity\")\n   770\u2192        self.logger.save_log = options.pop(\"save_log\")\n   771\u2192\n   772\u2192        # Parse the configuration overrides\n   773\u2192        overrides = parse_config_overrides(options.pop(\"config_overrides\"))\n   774\u2192\n   775\u2192        return options, overrides\n   776\u2192\n   777\u2192    def clone_options(self, command):\n   778\u2192        \"\"\"Clone options from one command to this one.\n   779\u2192\n   780\u2192        :param command: The command whose options are to be cloned\n   781\u2192        \"\"\"\n   782\u2192\n   783\u2192    def add_default_options(self, parser):\n   784\u2192        \"\"\"Add the default options that exist on *all* commands.\n   785\u2192\n   786\u2192        :param parser: a stub argparse parser for the command.\n   787\u2192        \"\"\"\n   788\u2192        parser.add_argument(\n   789\u2192            \"-C\",\n   790\u2192            \"--config\",\n   791\u2192            dest=\"config_overrides\",\n   792\u2192            action=\"append\",\n   793\u2192            metavar=\"KEY=VALUE\",\n   794\u2192            help=\"Override the value of the app configuration item KEY with VALUE\",\n   795\u2192        )\n   796\u2192        parser.add_argument(\n   797\u2192            \"-v\",\n   798\u2192            \"--verbosity\",\n   799\u2192            action=\"count\",\n   800\u2192            default=0,\n   801\u2192            help=\"Enable verbose logging. Use -vv and -vvv to increase logging verbosity\",\n   802\u2192        )\n   803\u2192        parser.add_argument(\"-V\", \"--version\", action=\"version\", version=__version__)\n   804\u2192        parser.add_argument(\n   805\u2192            \"--no-input\",\n   806\u2192            action=\"store_false\",\n   807\u2192            default=True,\n   808\u2192            dest=\"input_enabled\",\n   809\u2192            help=(\n   810\u2192                \"Don't ask for user input. If any action would be destructive, \"\n   811\u2192                \"an error will be raised; otherwise, default answers will be \"\n   812\u2192                \"assumed\"\n   813\u2192            ),\n   814\u2192        )\n   815\u2192        parser.add_argument(\n   816\u2192            \"--log\",\n   817\u2192            action=\"store_true\",\n   818\u2192            dest=\"save_log\",\n   819\u2192            help=\"Save a detailed log to file. By default, this log file is only created for critical errors\",\n   820\u2192        )\n   821\u2192\n   822\u2192    def _add_update_options(\n   823\u2192        self,\n   824\u2192        parser,\n   825\u2192        context_label=\"\",\n   826\u2192        update=True,\n   827\u2192    ):\n   828\u2192        \"\"\"Internal utility method for adding common update options.\n   829\u2192\n   830\u2192        :param parser: The parser to which options should be added.\n   831\u2192        :param context_label: Label text that will be added to the end of the help text\n   832\u2192            to describe when the update will be applied (e.g., \"before building\")\n   833\u2192        :param update: Should the --update and --no-update options be exposed?\n   834\u2192        \"\"\"\n   835\u2192        if update:\n   836\u2192            parser.add_argument(\n   837\u2192                \"-u\",\n   838\u2192                \"--update\",\n   839\u2192                action=\"store_true\",\n   840\u2192                help=f\"Update the app{context_label}\",\n   841\u2192            )\n   842\u2192\n   843\u2192        parser.add_argument(\n   844\u2192            \"-r\",\n   845\u2192            \"--update-requirements\",\n   846\u2192            action=\"store_true\",\n   847\u2192            help=f\"Update requirements for the app{context_label}\",\n   848\u2192        )\n   849\u2192\n   850\u2192        parser.add_argument(\n   851\u2192            \"--update-support\",\n   852\u2192            action=\"store_true\",\n   853\u2192            help=f\"Update support package for the app{context_label}\",\n   854\u2192        )\n   855\u2192\n   856\u2192        parser.add_argument(\n   857\u2192            \"--update-stub\",\n   858\u2192            action=\"store_true\",\n   859\u2192            help=f\"Update stub binary for the app{context_label}\",\n   860\u2192        )\n   861\u2192\n   862\u2192        parser.add_argument(\n   863\u2192            \"--update-resources\",\n   864\u2192            action=\"store_true\",\n   865\u2192            help=f\"Update app resources (icons, splash screens, etc){context_label}\",\n   866\u2192        )\n   867\u2192\n   868\u2192        if update:\n   869\u2192            parser.add_argument(\n   870\u2192                \"--no-update\",\n   871\u2192                action=\"store_true\",\n   872\u2192                help=f\"Prevent any automated update{context_label}\",\n   873\u2192            )\n   874\u2192\n   875\u2192    def _add_test_options(self, parser, context_label):\n   876\u2192        \"\"\"Internal utility method for adding common test-related options.\n   877\u2192\n   878\u2192        :param parser: The parser to which options should be added.\n   879\u2192        :param context_label: Label text for commands; the capitalized action being\n   880\u2192            performed (e.g., \"Build\", \"Run\",...)\n   881\u2192        \"\"\"\n   882\u2192        parser.add_argument(\n   883\u2192            \"--test\",\n   884\u2192            dest=\"test_mode\",\n   885\u2192            action=\"store_true\",\n   886\u2192            help=f\"{context_label} the app in test mode\",\n   887\u2192        )\n   888\u2192\n   889\u2192    def add_options(self, parser):\n   890\u2192        \"\"\"Add any options that this command needs to parse from the command line.\n   891\u2192\n   892\u2192        :param parser: a stub argparse parser for the command.\n   893\u2192        \"\"\"\n   894\u2192\n   895\u2192    def parse_config(self, filename, overrides):\n   896\u2192        try:\n   897\u2192            with open(filename, \"rb\") as config_file:\n   898\u2192                # Parse the content of the pyproject.toml file, extracting\n   899\u2192                # any platform and output format configuration for each app,\n   900\u2192                # creating a single set of configuration options.\n   901\u2192                global_config, app_configs = parse_config(\n   902\u2192                    config_file,\n   903\u2192                    platform=self.platform,\n   904\u2192                    output_format=self.output_format,\n   905\u2192                    logger=self.logger,\n   906\u2192                )\n   907\u2192\n   908\u2192                # Create the global config\n   909\u2192                global_config.update(overrides)\n   910\u2192                self.global_config = create_config(\n   911\u2192                    klass=GlobalConfig,\n   912\u2192                    config=global_config,\n   913\u2192                    msg=\"Global configuration\",\n   914\u2192                )\n   915\u2192\n   916\u2192                for app_name, app_config in app_configs.items():\n   917\u2192                    # Construct an AppConfig object with the final set of\n   918\u2192                    # configuration options for the app.\n   919\u2192                    app_config.update(overrides)\n   920\u2192                    self.apps[app_name] = create_config(\n   921\u2192                        klass=AppConfig,\n   922\u2192                        config=app_config,\n   923\u2192                        msg=f\"Configuration for '{app_name}'\",\n   924\u2192                    )\n   925\u2192\n   926\u2192        except OSError as e:\n   927\u2192            raise BriefcaseConfigError(\n   928\u2192                f\"\"\"\\\n   929\u2192Configuration file not found.\n   930\u2192\n   931\u2192Did you run Briefcase in a project directory that contains {filename.name!r}?\"\"\"\n   932\u2192            ) from e\n   933\u2192\n   934\u2192    def update_cookiecutter_cache(self, template: str, branch=\"master\"):\n   935\u2192        \"\"\"Ensure that we have a current checkout of a template path.\n   936\u2192\n   937\u2192        If the path is a local path, use the path as is.\n   938\u2192\n   939\u2192        If the path is a URL, look for a local cache; if one exists, update it,\n   940\u2192        including checking out the required branch.\n   941\u2192\n   942\u2192        :param template: The template URL or path.\n   943\u2192        :param branch: The template branch to use. Default: ``master``\n   944\u2192        :return: The path to the cached template. This may be the originally\n   945\u2192            provided path if the template was a file path.\n   946\u2192        \"\"\"\n   947\u2192        if is_repo_url(template):\n   948\u2192            # The app template is a repository URL.\n   949\u2192            #\n   950\u2192            # Look for a Briefcase cache of the template.\n   951\u2192            cached_template = self.template_cache_path(template)\n   952\u2192\n   953\u2192            if cached_template.exists():\n   954\u2192                # There is a pre-existing cache of the template. Attempt to update it;\n   955\u2192                # if the fetch fails, use the existing state of the cache. Any other\n   956\u2192                # failure is surfaced to the user.\n   957\u2192                try:\n   958\u2192                    repo = self.tools.git.Repo(cached_template)\n   959\u2192                except self.tools.git.exc.GitError:\n   960\u2192                    # Template repository is in a weird state. Delete it\n   961\u2192                    self.logger.warning(\n   962\u2192                        \"Template cache is in a weird state. Getting a clean clone.\"\n   963\u2192                    )\n   964\u2192                    self.tools.shutil.rmtree(cached_template)\n   965\u2192\n   966\u2192            if not cached_template.exists():\n   967\u2192                # There's no pre-existing template. It's either the first time seeing\n   968\u2192                # the template, or the template was in a weird state. Perform a blobless\n   969\u2192                # clone.\n   970\u2192                try:\n   971\u2192                    self.logger.info(f\"Cloning template {template!r}...\")\n   972\u2192                    cached_template.mkdir(exist_ok=True, parents=True)\n   973\u2192                    repo = self.tools.git.Repo.clone_from(\n   974\u2192                        url=template,\n   975\u2192                        to_path=cached_template,\n   976\u2192                        filter=[\"blob:none\"],\n   977\u2192                        no_checkout=True,\n   978\u2192                    )\n   979\u2192                except KeyboardInterrupt:\n   980\u2192                    # The user has aborted the initial clone. Git is fairly resilient to\n   981\u2192                    # being interrupted, but if the *initial* clone fails, it's very\n   982\u2192                    # hard to recover. To avoid problems on the next run, remove the\n   983\u2192                    # partial repo clone.\n   984\u2192                    if cached_template.exists():\n   985\u2192                        self.tools.shutil.rmtree(cached_template)\n   986\u2192                    raise\n   987\u2192                except self.tools.git.exc.GitError as e:\n   988\u2192                    # The clone failed; to make sure the repo is in a clean state, clean up\n   989\u2192                    # any partial remnants of this initial clone.\n   990\u2192                    # If we're getting a GitError, we know the directory must exist.\n   991\u2192                    self.tools.shutil.rmtree(cached_template)\n   992\u2192                    git_fatal_message = re.findall(r\"(?<=fatal: ).*?$\", e.stderr, re.S)\n   993\u2192                    if git_fatal_message:\n   994\u2192                        # GitError captures stderr with single quotes. Because the regex above\n   995\u2192                        # takes everything after git's \"fatal\" message, we need to strip that final single quote.\n   996\u2192                        hint = git_fatal_message[0].rstrip(\"'\").strip()\n   997\u2192\n   998\u2192                        # git is inconsistent with capitalisation of the first word of the message\n   999\u2192                        # and about periods at the end of the message.\n  1000\u2192                        hint = f\"{hint[0].upper()}{hint[1:]}{'' if hint[-1] == '.' else '.'}\"\n  1001\u2192                    else:\n  1002\u2192                        hint = (\n  1003\u2192                            \"This may be because your computer is offline, or \"\n  1004\u2192                            \"because the repository URL is incorrect.\"\n  1005\u2192                        )\n  1006\u2192\n  1007\u2192                    raise BriefcaseCommandError(\n  1008\u2192                        f\"Unable to clone repository {template!r}.\\n\\n{hint}\"\n  1009\u2192                    ) from e\n  1010\u2192\n  1011\u2192            try:\n  1012\u2192                # Raises ValueError if \"origin\" isn't a valid remote\n  1013\u2192                remote = repo.remote(name=\"origin\")\n  1014\u2192                # Ensure the existing repo's origin URL points to the location\n  1015\u2192                # being requested. A difference can occur, for instance, if a\n  1016\u2192                # fork of the template is used.\n  1017\u2192                remote.set_url(new_url=template)\n  1018\u2192                try:\n  1019\u2192                    # Attempt to update the repository\n  1020\u2192                    remote.fetch()\n  1021\u2192                except self.tools.git.exc.GitCommandError as e:\n  1022\u2192                    # We are offline, or otherwise unable to contact the origin git\n  1023\u2192                    # repo. It's OK to continue; but capture the error in the log and\n  1024\u2192                    # warn the user that the template may be stale.\n  1025\u2192                    self.logger.debug(str(e))\n  1026\u2192                    self.logger.warning(\n  1027\u2192                        \"\"\"\n  1028\u2192*************************************************************************\n  1029\u2192** WARNING: Unable to update template                                  **\n  1030\u2192***********************************************