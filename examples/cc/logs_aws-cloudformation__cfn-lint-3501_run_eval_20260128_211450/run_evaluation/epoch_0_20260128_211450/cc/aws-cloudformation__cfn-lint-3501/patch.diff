+    def _gather_refs_from_include(self, cfn: Template) -> Tuple[List[str], List[str]]:
+        """Scan Fn::Transform blocks using AWS::Include for local file references
+        and collect Ref and Fn::Sub parameter usages from the included content.
+
+        Only local file paths are processed. Remote includes (s3://, http://, https://)
+        are skipped to avoid external dependencies during linting.
+        """
+        include_refs: List[str] = []
+        include_subs: List[str] = []
+
+        try:
+            transform_paths = cfn.search_deep_keys("Fn::Transform")
+        except Exception:
+            transform_paths = []
+
+        for tpath in transform_paths:
+            # Last element is the value of Fn::Transform
+            value = tpath[-1]
+            if not isinstance(value, dict):
+                continue
+            name = value.get("Name")
+            if name != "AWS::Include":
+                continue
+            params = value.get("Parameters", {})
+            if not isinstance(params, dict):
+                continue
+            location = params.get("Location")
+            # Only process local file paths
+            if not isinstance(location, str):
+                continue
+            if location.startswith("s3://") or location.startswith("http://") or location.startswith("https://"):
+                continue
+            try:
+                included = yaml_load(location)
+            except Exception:
+                # If loading fails, skip without breaking lint run
+                continue
+
+            try:
+                temp_cfn = Template(None, included)
+            except Exception:
+                # Fail-safe: if Template construction fails, skip
+                continue
+
+            # Collect Ref usages from included content
+            try:
+                for ref_path in temp_cfn.search_deep_keys("Ref"):
+                    ref_val = ref_path[-1]
+                    if isinstance(ref_val, str):
+                        include_refs.append(ref_val)
+            except Exception:
+                pass
+
+            # Collect Fn::Sub parameter usages from included content
+            try:
+                for sub_path in temp_cfn.search_deep_keys("Fn::Sub"):
+                    sub_val = sub_path[-1]
+                    if isinstance(sub_val, list):
+                        # [string, mapping] form
+                        string_part = sub_val[0]
+                        include_subs.extend(temp_cfn.get_sub_parameters(string_part))
+                    elif isinstance(sub_val, str):
+                        include_subs.extend(temp_cfn.get_sub_parameters(sub_val))
+            except Exception:
+                pass
+
+        return include_refs, include_subs
+
     def match(self, cfn: Template) -> RuleMatches:
         matches: RuleMatches = []
 
