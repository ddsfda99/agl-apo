            for condition_name, condition_values in result.items():\n  1089→                        if condition_name in results:\n  1090→                            results[condition_name].union(condition_values)\n  1091→                        else:\n  1092→                            results[condition_name] = condition_values\n  1093→\n  1094→        return list(self.conditions.build_scenarios(results, region))\n  1095→\n  1096→    def get_conditions_scenarios_from_object(self, objs, region=None):\n  1097→        \"\"\"\n  1098→        Get the conditions that are applicable for the given path in the template.\n  1099→\n  1100→        This function recursively traverses the template, following the provided path,\n  1101→        and collects all the conditions that are relevant for the given path.\n  1102→\n  1103→        Args:\n  1104→            template (dict): The CloudFormation template to analyze.\n  1105→            path (list): The path within the template to analyze.\n  1106→\n  1107→        Returns:\n  1108→            dict: A dictionary where the keys are the condition names, and the values\n  1109→            are sets of boolean values (True or False) indicating the possible\n  1110→            outcomes for that condition.\n  1111→        \"\"\"\n  1112→\n  1113→        def get_conditions_from_property(value):\n  1114→            \"\"\"Recursively get conditions\"\"\"\n  1115→            results = set()\n  1116→            if isinstance(value, dict):\n  1117→                if len(value) == 1:\n  1118→                    for k, v in value.items():\n  1119→                        if k == \"Fn::If\":\n  1120→                            if isinstance(v, list) and len(v) == 3:\n  1121→                                if isinstance(v[0], str):\n  1122→                                    results.add(v[0])\n  1123→                                    results = results.union(\n  1124→                                        get_conditions_from_property(v[1])\n  1125→                                    )\n  1126→                                    results = results.union(\n  1127→                                        get_conditions_from_property(v[2])\n  1128→                                    )\n  1129→            elif isinstance(value, list):\n  1130→                for v in value:\n  1131→                    results = results.union(get_conditions_from_property(v))\n  1132→\n  1133→            return results\n  1134→\n  1135→        con = set()\n  1136→\n  1137→        if isinstance(objs, dict):\n  1138→            objs = [objs]\n  1139→\n  1140→        for obj in objs:\n  1141→            if isinstance(obj, dict):\n  1142→                for k, v in obj.items():\n  1143→                    # handle conditions directly under the object\n  1144→                    if len(obj) == 1 and k == \"Fn::If\" and len(v) == 3:\n  1145→                        con.add(v[0])\n  1146→                        for r_c in v[1:]:\n  1147→                            if isinstance(r_c, dict):\n  1148→                                for s_k, s_v in r_c.items():\n  1149→                                    if s_k == \"Fn::If\":\n  1150→                                        con = con.union(\n  1151→                                            get_conditions_from_property({s_k: s_v})\n  1152→                                        )\n  1153→                    else:\n  1154→                        con = con.union(get_conditions_from_property(v))\n  1155→\n  1156→        return list(self.conditions.build_scenarios(dict.fromkeys(list(con)), region))\n  1157→\n  1158→    def get_conditions_from_path(\n  1159→        self,\n  1160→        text: Any,\n  1161→        path: Path,\n  1162→        include_resource_conditions: bool = True,\n  1163→        include_if_in_function: bool = True,\n  1164→        only_last: bool = False,\n  1165→    ) -> dict[str, set[bool]]:\n  1166→        \"\"\"\n  1167→        Parent function to handle resources with conditions.\n  1168→\n  1169→        This function recursively processes the provided text and path to identify\n  1170→        the conditions that are relevant for the given path.\n  1171→\n  1172→        Args:\n  1173→            text (dict): The object to start processing through the path.\n  1174→            path (list): The path to recursively look for conditions.\n  1175→            include_resource_conditions (bool, optional): Whether to include conditions\n  1176→                from the resource itself. Defaults to True.\n  1177→            include_if_in_function (bool, optional): Whether to include conditions\n  1178→                from Fn::If functions. Defaults to True.\n  1179→            only_last (bool, optional): Whether to only return the conditions for the\n  1180→                last element in the path. Defaults to False.\n  1181→\n  1182→        Returns:\n  1183→            dict: A dictionary where the keys are the condition names, and the values\n  1184→            are sets of boolean values (True or False) indicating the possible\n  1185→            outcomes for that condition.\n  1186→        \"\"\"\n  1187→\n  1188→        results = self._get_conditions_from_path(\n  1189→            text, path, include_if_in_function, only_last\n  1190→        )\n  1191→        if include_resource_conditions:\n  1192→            if len(path) >= 2:\n  1193→                if path[0] in [\"Resources\", \"Outputs\"]:\n  1194→                    condition = text.get(path[0], {}).get(path[1], {}).get(\"Condition\")\n  1195→                    if isinstance(condition, str):\n  1196→                        if not results.get(condition):\n  1197→                            results[condition] = set()\n  1198→                        results[condition].add(True)\n  1199→\n  1200→        return results\n  1201→\n  1202→    def _get_conditions_from_path(\n  1203→        self,\n  1204→        text: Any,\n  1205→        path: Path,\n  1206→        include_if_in_function: bool =