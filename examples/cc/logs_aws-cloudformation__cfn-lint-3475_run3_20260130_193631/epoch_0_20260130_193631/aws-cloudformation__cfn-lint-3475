       for schema in self.store.values()\n    82→                if isinstance(schema, Mapping) and \"$id\" in schema\n    83→            )\n    84→\n    85→    @classmethod\n    86→    def from_schema(cls, schema, **kwargs):\n    87→        \"\"\"\n    88→        Construct a resolver from a JSON schema object.\n    89→\n    90→        Arguments:\n    91→\n    92→            schema:\n    93→\n    94→                the referring schema\n    95→\n    96→        Returns:\n    97→\n    98→            `RefResolver`\n    99→        \"\"\"\n   100→        return cls(base_uri=id_of(schema), referrer=schema, **kwargs)\n   101→\n   102→    def push_scope(self, scope):\n   103→        \"\"\"\n   104→        Enter a given sub-scope.\n   105→\n   106→        Treats further dereferences as being performed underneath the\n   107→        given scope.\n   108→        \"\"\"\n   109→        self._scopes_stack.append(\n   110→            self._urljoin_cache(self.resolution_scope, scope),\n   111→        )\n   112→\n   113→    def pop_scope(self):\n   114→        \"\"\"\n   115→        Exit the most recent entered scope.\n   116→\n   117→        Treats further dereferences as being performed underneath the\n   118→        original scope.\n   119→\n   120→        Don't call this method more times than `push_scope` has been\n   121→        called.\n   122→        \"\"\"\n   123→        try:\n   124→            self._scopes_stack.pop()\n   125→        except IndexError as e:\n   126→            raise RefResolutionError(\n   127→                \"Failed to pop the scope from an empty stack. \"\n   128→                \"`pop_scope()` should only be called once for every \"\n   129→                \"`push_scope()`\",\n   130→            ) from e\n   131→\n   132→    def resolve_from_url(self, url):\n   133→        \"\"\"\n   134→        Resolve the given URL.\n   135→        \"\"\"\n   136→        url, fragment = urldefrag(url)\n   137→        if url:\n   138→            try:\n   139→      