n   119\u2192        :param args: command line to run in subprocess\n   120\u2192        :returns: the return value for the Subprocess method\n   121\u2192        \"\"\"\n   122\u2192        # Just run the command if no dynamic elements are active\n   123\u2192        if not sub.tools.console.is_console_controlled:\n   124\u2192            return sub_method(sub, args, *wrapped_args, **wrapped_kwargs)\n   125\u2192\n   126\u2192        remove_dynamic_elements = False\n   127\u2192\n   128\u2192        # Batch (.bat) scripts on Windows.\n   129\u2192        # If cmd.exe is interrupted with CTRL+C while running a bat script,\n   130\u2192        # it may prompt the user to abort the script and dynamic elements\n   131\u2192        # such as the Wait Bar can hide this message from the user.\n   132\u2192        if sub.tools.host_os == \"Windows\":\n   133\u2192            executable = str(args[0]).strip() if args else \"\"\n   134\u2192            remove_dynamic_elements |= executable.lower().endswith(\".bat\")\n   135\u2192\n   136\u2192        # Release control for commands that cannot be streamed.\n   137\u2192        remove_dynamic_elements |= wrapped_kwargs.get(\"stream_output\") is False\n   138\u2192\n   139\u2192        # Run subprocess command with or without console control\n   140\u2192        if remove_dynamic_elements:\n   141\u2192            with sub.tools.console.release_console_control():\n   142\u2192                return sub_method(sub, args, *wrapped_args, **wrapped_kwargs)\n   143\u2192        else:\n   144\u2192            return sub_method(sub, args, *wrapped_args, **wrapped_kwargs)\n   145\u2192\n   146\u2192    return inner\n   147\u2192\n   148\u2192\n   149\u2192class PopenOutputStreamer(threading.Thread):\n   150\u2192    def __init__(\n   151\u2192        self,\n   152\u2192        label: str,\n   153\u2192        popen_process: subprocess.Popen,\n   154\u2192        console: Console,\n   155\u2192        capture_output: bool = False,\n   156\u2192        filter_func: Callable[[str], Iterator[str]] | None = None,\n   157\u2192    ):\n   158\u2192        \"\"\"Thread for streaming stdout for a Popen process.\n   159\u2192\n   160\u2192        :param label: Descriptive name for process being streamed\n   161\u2192        :param popen_process: Popen process with stdout to stream\n   162\u2192        :param console: console for printing to console\n   163\u2192        :param capture_output: Retain process output in ``output_queue`` via a\n   164\u2192            ``queue.Queue`` instead of printing to console\n   165\u2192        :param filter_func: a callable that will be invoked on every line of output\n   166\u2192            that is streamed; see ``Subprocess.stream_output`` for details\n   167\u2192        \"\"\"\n   168\u2192        super().__init__(name=f\"{label} output streamer\", daemon=True)\n   169\u2192\n   170\u2192        self.popen_process = popen_process\n   171\u2192        self.console = console\n   172\u2192        self.capture_output = capture_output\n   173\u2192        self.filter_func = filter_func\n   174\u2192\n   175\u2192        # arbitrarily large maxsize to prevent unbounded memory use if things go south\n   176\u2192        self.output_queue = queue.Queue(maxsize=10_000_000)\n   177\u2192        self.stop_flag = threading.Event()\n   178\u2192\n   179\u2192    def run(self):\n   180\u2192        \"\"\"Stream output for a Popen process.\"\"\"\n   181\u2192        try:\n   182\u2192            while output_line := self._readline():\n   183\u2192                # The stop_flag is intentionally checked both at the top and bottom of\n   184\u2192                # this loop; if the flag was set during the call to readline(), then\n   185\u2192                # processing the output is skipped altogether. And if the flag is set\n   186\u2192                # as a consequence of filter_func(), the streamer still exits before\n   187\u2192                # calling readline() again and potentially blocking indefinitely.\n   188\u2192                if not self.stop_flag.is_set():\n   189\u2192                    filtered_output, stop_streaming = self._filter(output_line)\n   190\u2192\n   191\u2192                    for filtered_line in filtered_output:\n   192\u2192                        if self.capture_output:\n   193\u2192                            self.output_queue.put_nowait(filtered_line)\n   194\u2192                        else:\n   195\u2192                            self.console.info(filtered_line)\n   196\u2192\n   197\u2192                    if stop_streaming:\n   198\u2192                        self.stop_flag.set()\n   199\u2192\n   200\u2192                if self.stop_flag.is_set():\n   201\u2192                    break\n   202\u2192        except Exception as e:\n   203\u2192            self.console.error(f\"Error while streaming output: {type(e).__name__}: {e}\")\n   204\u2192            self.console.capture_stacktrace(\"Output thread\")\n   205\u2192\n   206\u2192    def request_stop(self):\n   207\u2192        \"\"\"Set the stop flag to cause the streamer to exit.\n   208\u2192\n   209\u2192        If the streamer is currently blocking on `readline()` because the process'\n   210\u2192        stdout buffer is empty, then the streamer will not exit until `readline()`\n   211\u2192        returns or until Briefcase exits.\n   212\u2192        \"\"\"\n   213\u2192        self.stop_flag.set()\n   214\u2192\n   215\u2192    @property\n   216\u2192    def captured_output(self) -> str:\n   217\u2192        \"\"\"The captured output from the process.\"\"\"\n   218\u2192        output = []\n   219\u2192        while not self.output_queue.empty():\n   220\u2192            with contextlib.suppress(queue.Empty):\n   221\u2192                output.append(self.output_queue.get_nowait())\n   222\u2192                self.output_queue.task_done()\n   223\u2192        return \"\".join(output)\n   224\u2192\n   225\u2192    def _readline(self) -> str:\n   226\u2192        \"\"\"Read a line of output from the process while blocking.\n   227\u2192\n   228\u2192        Calling readline() for stdout always returns at least a newline, i.e. \"\\n\",\n   229\u2192        UNLESS the process is exiting or already exited; in that case, an empty string\n   230\u2192        is returned.\n   231\u2192\n   232\u2192        :returns: one line of output or \"\" if nothing more can be read from stdout\n   233\u2192        \"\"\"\n   234\u2192        try:\n   235\u2192            return ensure_str(self.popen_process.stdout.readline())\n   236\u2192        except ValueError as e:\n   237\u2192            # Catch ValueError if stdout is unexpectedly closed; this can\n   238\u2192            # happen, for instance, if the user starts spamming CTRL+C.\n   239\u2192            if \"I/O operation on closed file\" in str(e):\n   240\u2192                self.console.warning(\n   241\u2192                    \"WARNING: stdout was unexpectedly closed while streaming output\"\n   242\u2192                )\n   243\u2192                return \"\"\n   244\u2192            else:\n   245\u2192                raise\n   246\u2192\n   247\u2192    def _filter(self, line: str) -> tuple[list[str], bool]:\n   248\u2192        \"\"\"Run filter function over output from process.\"\"\"\n   249\u2192        filtered_output = []\n   250\u2192        stop_streaming = False\n   251\u2192\n   252\u2192        if self.filter_func is not None:\n   253\u2192            try:\n   254\u2192                for filtered_line in self.filter_func(line.strip(\"\\n\")):\n   255\u2192                    filtered_output.append(filtered_line)\n   256\u2192            except StopStreaming:\n   257\u2192                stop_streaming = True\n   258\u2192        else:\n   259\u2192            filtered_output.append(line)\n   260\u2192\n   261\u2192        return filtered_output, stop_streaming\n   262\u2192\n   263\u2192\n   264\u2192class NativeAppContext(Tool):\n   265\u2192    \"\"\"A wrapper around subprocess for use as an app-bound tool.\"\"\"\n   266\u2192\n   267\u2192    name = \"app_context_subprocess\"\n   268\u2192\n   269\u2192    @classmethod\n   270\u2192    def verify_install(cls, tools: ToolCache, app: AppConfig, **kwargs) -> Subprocess:\n   271\u2192        \"\"\"Make subprocess available as app-bound tool.\"\"\"\n   272\u2192        # short circuit since already verified and available\n   273\u2192        if hasattr(tools[app], \"app_context\"):\n   274\u2192            return tools[app].app_context\n   275\u2192\n   276\u2192        tools[app].app_context = tools.subprocess\n   277\u2192        return tools[app].app_context\n   278\u2192\n   279\u2192\n   280\u2192class Subprocess(Tool):\n   281\u2192    \"\"\"A wrapper around subprocess that can be used as a logging point for commands that\n   282\u2192    are executed.\"\"\"\n   283\u2192\n   284\u2192    name = \"subprocess\"\n   285\u2192    full_name = \"Subprocess\"\n   286\u2192\n   287\u2192    def __init__(self, tools: ToolCache):\n   288\u2192        super().__init__(tools=tools)\n   289\u2192        self._subprocess = subprocess\n   290\u2192\n   291\u2192    def prepare(self):\n   292\u2192        \"\"\"Perform any environment preparation required to execute processes.\"\"\"\n   293\u2192        # This is a no-op; the native subprocess environment is ready-to-use.\n   294\u2192        pass\n   295\u2192\n   296\u2192    @contextlib.contextmanager\n   297\u2192    def run_app_context(self, subprocess_kwargs: dict[str, ...]) -> dict[str, ...]:\n   298\u2192        \"\"\"A manager to wrap subprocess calls to run a Briefcase project app.\n   299\u2192\n   300\u2192        :param subprocess_kwargs: initialized keyword arguments for subprocess calls\n   301\u2192        \"\"\"\n   302\u2192        # This is a no-op; the native subprocess environment is ready-to-use.\n   303\u2192        yield subprocess_kwargs\n   304\u2192\n   305\u2192    def full_env(self, overrides: dict[str, str | None] | None) -> dict[str, str]:\n   306\u2192        \"\"\"Generate the full environment in which the command will run.\n   307\u2192\n   308\u2192        If an env var in `overrides` is set to `None`, then that env var\n   309\u2192        will be altogether absent in the returned environment.\n   310\u2192\n   311\u2192        :param overrides: The environment passed to the subprocess call;\n   312\u2192            can be `None` if there are no explicit environment changes.\n   313\u2192        \"\"\"\n   314\u2192        env = self.tools.os.environ.copy()\n   315\u2192        if overrides:\n   316\u2192            env.update(overrides)\n   317\u2192            env = {k: v for k, v in env.items() if v is not None}\n   318\u2192        return env\n   319\u2192\n   320\u2192    def final_kwargs(self, **kwargs) -> dict[str, str]:\n   321\u2192        \"\"\"Convert subprocess keyword arguments into their final form.\n   322\u2192\n   323\u2192        This involves:\n   324\u2192         * Converting any environment overrides into a full environment\n   325\u2192         * Converting the `cwd` into a string\n   326\u2192         * Default `text` to True so all outputs are strings\n   327\u2192         * Convert start_new_session=True to creationflags on Windows\n   328\u2192        \"\"\"\n   329\u2192        # If `env` has been provided, inject a full copy of the local\n   330\u2192        # environment, with the values in `env` overriding the local\n   331\u2192        # environment.\n   332\u2192        try:\n   333\u2192            overrides = kwargs.pop(\"env\")\n   334\u2192            kwargs[\"env\"] = self.full_env(overrides)\n   335\u2192        except KeyError:\n   336\u2192            # No explicit environment provided.\n   337\u2192            pass\n   338\u2192\n   339\u2192        # If `cwd` has been provided, ensure it is in string form.\n   340\u2192        try:\n   341\u2192            cwd = kwargs.pop(\"cwd\")\n   342\u2192            kwargs[\"cwd\"] = str(cwd)\n   343\u2192        except KeyError:\n   344\u2192            pass\n   345\u2192\n   346\u2192        # Default to running subprocess in \"text\" mode so all output is returned as\n   347\u2192        # strings instead of bytes. The legacy setting of `universal_newlines` is\n   348\u2192        # converted to `text` for calling subprocess.\n   349\u2192        kwargs[\"text\"] = kwargs.pop(\"universal_newlines\", kwargs.get(\"text\", True))\n   350\u2192\n   351\u2192        # Enable text mode if an `encoding` or `errors` is specified; this aligns with\n   352\u2192        # the default behavior of subprocess.\n   353\u2192        kwargs[\"text\"] |= any(kwargs.get(kw) for kw in [\"encoding\", \"errors\"])\n   354\u2192\n   355\u2192        # Configure subprocess for text mode\n   356\u2192        if kwargs[\"text\"]:\n   357\u2192            # Ensure an appropriate encoding is specified.\n   358\u2192            # If an encoding isn't provided, default to the encoding that Python is\n   359\u2192            # using for stdout. This is for the benefit of Windows which uses cp437 for\n   360\u2192            # console output when the system encoding is cp1252.\n   361\u2192            # `sys.__stdout__` is used because Rich captures and redirects `sys.stdout`.\n   362\u2192            # The fallback to \"UTF-8\" is needed to catch the case where stdout is\n   363\u2192            # redirected to a non-tty (e.g. during pytest conditions).\n   364\u2192            kwargs.setdefault(\n   365\u2192                \"encoding\", os.device_encoding(sys.__stdout__.fileno()) or \"UTF-8\"\n   366\u2192            )\n   367\u2192\n   368\u2192            # Use relaxed output decoding by default.\n   369\u2192            # subprocess defaults to \"strict\" handling for errors arising from decoding\n   370\u2192            # output to Unicode. To avoid Unicode exceptions from misbehaving commands,\n   371\u2192            # set `errors` so output that cannot be decoded for the specified encoding\n   372\u2192            # are replaced with hex of the raw bytes.\n   373\u2192            kwargs.setdefault(\"errors\", \"backslashreplace\")\n   374\u2192\n   375\u2192        # For Windows, convert start_new_session=True to creation flags\n   376\u2192        if self.tools.host_os == \"Windows\":\n   377\u2192            try:\n   378\u2192                if kwargs.pop(\"start_new_session\") is True:\n   379\u2192                    if \"creationflags\" in kwargs:\n   380\u2192                        raise AssertionError(\n   381\u2192                            \"Subprocess called with creationflags set and \"\n   382\u2192                            \"start_new_session=True.\\nThis will result in \"\n   383\u2192                            \"CREATE_NEW_PROCESS_GROUP and CREATE_NO_WINDOW \"\n   384\u2192                            \"being merged in to the creationflags.\\n\\nEnsure \"\n   385\u2192                            \"this is desired configuration or don't set \"\n   386\u2192                            \"start_new_session=True.\"\n   387\u2192                        )\n   388\u2192                    # CREATE_NEW_PROCESS_GROUP: Promotes the new process to the root\n   389\u2192                    #    process of a new process group. This also disables CTRL+C\n   390\u2192                    #    signal handlers for all processes of the new process group.\n   391\u2192                    # CREATE_NO_WINDOW: Creates a new console for the process but\n   392\u2192                    #    does not open a visible window for that console. This flag\n   393\u2192                    #    is used instead of DETACHED_PROCESS since the new process\n   394\u2192                    #    can spawn a new console itself (in the absence of one being\n   395\u2192                    #    available) but that console creation will also spawn a\n   396\u2192                    #    visible console window.\n   397\u2192                    new_session_flags = (\n   398\u2192                        self._subprocess.CREATE_NEW_PROCESS_GROUP\n   399\u2192                        | self._subprocess.CREATE_NO_WINDOW\n   400\u2192                    )\n   401\u2192                    # merge these flags in to any existing flags already provided\n   402\u2192                    kwargs[\"creationflags\"] = (\n   403\u2192                        kwargs.get(\"creationflags\", 0) | new_session_flags\n   404\u2192                    )\n   405\u2192            except KeyError:\n   406\u2192                pass\n   407\u2192\n   408\u2192        return kwargs\n   409\u2192\n   410\u2192    @classmethod\n   411\u2192    def verify_install(cls, tools: ToolCache, **kwargs) -> Subprocess:\n   412\u2192        \"\"\"Make subprocess available in tool cache.\"\"\"\n   413\u2192        # short circuit since already verified and available\n   414\u2192        if hasattr(tools, \"subprocess\"):\n   415\u2192            return tools.subprocess\n   416\u2192\n   417\u2192        tools.subprocess = Subprocess(tools=tools)\n   418\u2192        return tools.subprocess\n   419\u2192\n   420\u2192    @ensure_console_is_safe\n   421\u2192    def run(\n   422\u2192        self,\n   423\u2192        args: SubprocessArgsT,\n   424\u2192        stream_output: bool = True,\n   425\u2192        filter_func: Callable[[str], Iterator[str]] | None = None,\n   426\u2192        **kwargs,\n   427\u2192    ) -> CompletedProcess:\n   428\u2192        \"\"\"A wrapper for subprocess.run().\n   429\u2192\n   430\u2192        This method implements the behavior of subprocess.run() with some notable\n   431\u2192        differences:\n   432\u2192\n   433\u2192          - The command's output is streamed if ``stream_output=True`` or if dynamic\n   434\u2192            console content such as the Wait Bar is active and I/O is not redirected.\n   435\u2192          - If dynamic content is not active, ``stream_output=False`` will disable\n   436\u2192            streaming.\n   437\u2192          - If the ``env`` argument is provided, the current system environment will be\n   438\u2192            copied, and the contents of env overwritten into that environment.\n   439\u2192          - The ``text`` argument is defaulted to True so all output is returned as\n   440\u2192            strings instead of bytes.\n   441\u2192\n   442\u2192        Output Streaming Primer\n   443\u2192        ~~~~~~~~~~~~~~~~~~~~~~~\n   444\u2192\n   445\u2192        What is output streaming?\n   446\u2192        -------------------------\n   447\u2192\n   448\u2192        When a command is invoked via ``subprocess.run()``, by default, its stdout and\n   449\u2192        stderr are connected directly to the console and the output is presented to the\n   450\u2192        user as though the command was invoked natively. When output streaming is\n   451\u2192        active, Briefcase reads the command's output and prints it in to the console on\n   452\u2192        behalf of the command.\n   453\u2192\n   454\u2192        Why is output streaming necessary?\n   455\u2192        ----------------------------------\n   456\u2192\n   457\u2192        Allowing commands to print directly to the console can provide superior UX since\n   458\u2192        it allows tools to provide their native experience to users.\n   459\u2192\n   460\u2192        However, a primary mechanism for providing support for Briefcase is asking users\n   461\u2192        to provide the log file when errors occur. Often, these errors are raised by\n   462\u2192        invoked commands; streaming the output of commands allows Briefcase to capture\n   463\u2192        that output and include it in the log file as well as the console.\n   464\u2192\n   465\u2192        Additionally, the content of the console can become corrupted if other processes\n   466\u2192        print to the console while Rich's dynamic console elements such as a Progress\n   467\u2192        Bar are active. Streaming such output allows Rich to maintain integrity of all\n   468\u2192        the console content.\n   469\u2192\n   470\u2192        How does output streaming work?\n   471\u2192        -------------------------------\n   472\u2192\n   473\u2192        Streaming is activated when:\n   474\u2192\n   475\u2192          1. dynamic content such as the Wait Bar is active and I/O is not redirected\n   476\u2192\n   477\u2192          2. the ``stream_output`` argument is ``True`` (as it is by default)\n   478\u2192\n   479\u2192        I/O is considered redirected when both ``stdout`` and ``stderr`` are specified\n   480\u2192        (e.g., when ``stdout`` and ``stderr`` are set to``subprocess.PIPE`` so the\n   481\u2192        output is available to the caller).\n   482\u2192\n   483\u2192        To facilitate streaming the output, ``stdout`` is set to ``subprocess.PIPE``. If\n   484\u2192        ``stderr`` is not specified by calling code, then it is set to\n   485\u2192        ``subprocess.STDOUT`` so it is interlaced with stdout output.\n   486\u2192\n   487\u2192        The process is created for the command with ``Popen``, and a separate thread is\n   488\u2192        started for continuously reading and printing the stdout to the console from the\n   489\u2192        command process. It is necessary to read from stdout in a thread because the\n   490\u2192        read is uninterruptible; so, a user may not be able to abort with CTRL-C.\n   491\u2192\n   492\u2192        When the process ends (or the user sends CTRL-C), a call is made to ensure the\n   493\u2192        command process terminates; this, in turn, ensures the thread for streaming can\n   494\u2192        properly exit its otherwise infinite loop. The calling code is either returned a\n   495\u2192        ``CompletedProcess`` object or ``CalledProcessError`` could be raised.\n   496\u2192\n   497\u2192        Output streaming ultimately strives to simulate calling ``subprocess.run()``\n   498\u2192        while proxying the command's output to the console.\n   499\u2192\n   500\u2192        When *not* to use output streaming?\n   501\u2192        -----------------------------------\n   502\u2192\n   503\u2192        When streaming is disabled, the command's output **WILL NOT** be included the\n   504\u2192        Briefcase log file. This makes troubleshooting difficult and should be avoided.\n   505\u2192        However, there are some situations where disabling streaming is unavoidable.\n   506\u2192\n   507\u2192        Some commands use their own dynamic console content such as progress bars,\n   508\u2192        spinners, and other animations. When such output is streamed, its quality can be\n   509\u2192        significantly compromised and look terrible in the console for users. If it is\n   510\u2192        not possible to disable such output with e.g. a flag for the command, then\n   511\u2192        disabling streaming may be necessary. As an example, the ``flatpak install``\n   512\u2192        command uses many animations.\n   513\u2192\n   514\u2192        If a command requires user input, do not use output streaming. The output\n   515\u2192        streaming implementation doesn't provide any facilities to send input to the\n   516\u2192        process and doesn't provide any special handling of stdin. Additionally, when\n   517\u2192        the command process prompts the user for input, that doesn't always trigger\n   518\u2192        ``readline()`` to return; so, the console may actually end up waiting for user\n   519\u2192        input before displaying a prompt to the user. As an example, accepting Android\n   520\u2192        SDK licenses requires user input.\n   521\u2192\n   522\u2192        :param args: args for ``subprocess.run()``\n   523\u2192        :param stream_output: simulate ``run()`` while streaming the output to the\n   524\u2192            console. Set to False if the command requires