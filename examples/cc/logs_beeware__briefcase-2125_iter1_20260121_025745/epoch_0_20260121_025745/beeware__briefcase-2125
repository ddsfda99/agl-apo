  326→    The location pointed to by the {sdk_source_env} environment\n   327→    variable:\n   328→\n   329→    {sdk_root_env}\n   330→\n   331→    doesn't appear to contain an Android SDK with the Command-line Tools installed.\n   332→\n   333→    If {sdk_source_env} is an Android SDK, ensure it is the root directory\n   334→    of the Android SDK instance such that\n   335→\n   336→    ${sdk_source_env}{os.sep}{sdk.sdkmanager_path.relative_to(sdk.root_path)}\n   337→\n   338→    is a valid filepath.\n   339→\n   340→    Briefcase will proceed using its own SDK instance.\n   341→\n   342→*************************************************************************\n   343→\"\"\"\n   344→                )\n   345→                sdk = None\n   346→\n   347→        # Verify Briefcase-managed Android SDK\n   348→        if sdk is None:\n   349→            sdk_root_path = tools.base_path / \"android_sdk\"\n   350→            sdk = AndroidSDK(tools=tools, root_path=sdk_root_path)\n   351→\n   352→            if not sdk.exists():\n   353→                if not install:\n   354→                    raise MissingToolError(\"Android SDK\")\n   355→\n   356→                sdk.delete_legacy_sdk_tools()\n   357→\n   358→                if sdk.cmdline_tools_path.parent.exists():\n   359→                    tools.console.info(\"Upgrading Android SDK...\", prefix=cls.name)\n   360→                else:\n   361→                    tools.console.info(\n   362→                        \"The Android SDK was not found; downloading and installing...\",\n   363→                        prefix=cls.name,\n   364→                    )\n   365→                    tools.console.info(\n   366→                        \"To use an existing Android SDK instance, specify its root \"\n   367→                        \"directory path in the ANDROID_HOME environment variable.\"\n   368→                    )\n   369→                    tools.console.info()\n   370→                sdk.install()\n   371→\n   372→        # Licences must be accepted to use the SDK\n   373→        sdk.verify_license()\n   374→\n   375→        tools.console.debug(f\"Using Android SDK at {sdk.root_path}\")\n   376→        tools.android_sdk = sdk\n   377→        return sdk\n   378→\n   379→    def exists(self) -> bool:\n   380→        \"\"\"Confirm that the SDK actually exists.\n   381→\n   382→        Look for the sdkmanager; and, if necessary, confirm that it is executable.\n   383→        \"\"\"\n   384→        return self.sdkmanager_path.is_file() and (\n   385→            self.tools.host_os == \"Windows\"\n   386→            or self.tools.os.access(self.sdkmanager_path, self.tools.os.X_OK)\n   387→        )\n   388→\n   389→    @property\n   390→    def managed_install(self) -> bool:\n   391→        \"\"\"Is the Android SDK install managed by Briefcase?\"\"\"\n   392→        # Although the end-user can provide their own SDK, the SDK also\n   393→        # provides a built-in upgrade mechanism. Therefore, all Android SDKs\n   394→        # are managed installs.\n   395→        return True\n   396→\n   397→    def uninstall(self):\n   398→        \"\"\"The Android SDK is upgraded in-place instead of being reinstalled.\"\"\"\n   399→\n   400→    def install(self):\n   401→        \"\"\"Download and install the Android SDK.\"\"\"\n   402→        cmdline_tools_zip_path = self.tools.file.download(\n   403→            url=self.cmdline_tools_url,\n   404→            download_path=self.tools.base_path,\n   405→            role=\"Android SDK Command-Line Tools\",\n   406→        )\n   407→\n   408→        # The cmdline-tools package *must* be installed as:\n   409→        #     <sdk_path>/cmdline-tools/<cmdline-tools version>\n   410→        #\n   411→        # However, the zip file unpacks a top-level folder named `cmdline-tools`.\n   412→        # So, the unpacking process is:\n   413→        #\n   414→        #  1. Make a <sdk_path>/cmdline-tools folder\n   415→        #  2. Unpack the zip file into that folder, creating <sdk_path>/cmdline-tools/cmdline-tools\n   416→        #  3. Move <sdk_path>/cmdline-tools/cmdline-tools to <sdk_path>/cmdline-tools/<cmdline-tools version>\n   417→\n   418→        with self.tools.console.wait_bar(\n   419→            f\"Installing Android SDK Command-Line Tools {self.SDK_MANAGER_VER}...\"\n   420→        ):\n   421→            self.cmdline_tools_path.parent.mkdir(parents=True, exist_ok=True)\n   422→            try:\n   423→                self.tools.file.unpack_archive(\n   424→                    cmdline_tools_zip_path, extract_dir=self.cmdline_tools_path.parent\n   425→                )\n   426→            except (shutil.ReadError, EOFError) as e:\n   427→                raise BriefcaseCommandError(\n   428→                    f\"\"\"\\\n   429→Unable to unpack Android SDK Command-Line Tools ZIP file. The download may have been interrupted\n   430→or corrupted.\n   431→\n   432→Delete {cmdline_tools_zip_path} and run briefcase again.\n   433→\"\"\"\n   434→                ) from e\n   435→\n   436→            # If there's an existing version of the cmdline tools, delete them.\n   437→            if self.cmdline_tools_path.exists():\n   438→                self.tools.shutil.rmtree(self.cmdline_tools_path)\n   439→\n   440→            # Rename the top level zip content to the final name\n   441→            (self.cmdline_tools_path.parent / \"cmdline-tools\").rename(\n   442→                self.cmdline_tools_path\n   443→            )\n   444→\n   445→            # Zip file no longer needed once unpacked.\n   446→            cmdline_tools_zip_path.unlink()\n   447→\n   448→            # Python zip unpacking ignores permission metadata.\n   449→            # On non-Windows, we manually fix permissions.\n   450→            if (  # pragma: no branch\n   451→                self.tools.host_os != \"Windows\"\n   452→            ):  # pragma: no-cover-if-is-windows\n   453→                for binpath in (self.cmdline_tools_path / \"bin\").glob(\"*\"):\n   454→                    if not self.tools.os.access(binpath, self.tools.os.X_OK):\n   455→                        binpath.chmod(0o755)\n   456→\n   457→        with self.tools.console.wait_bar(\"Removing older Android SDK packages...\"):\n   458→            self.cleanup_old_installs()\n   459→\n   460→    def upgrade(self):\n   461→        \"\"\"Upgrade the Android SDK.\"\"\"\n   462→        try:\n   463→            # Using subprocess.run() with no I/O redirection so the user sees\n   464→            # the full output and can send input.\n   465→            self.tools.subprocess.run(\n   466→                [self.sdkmanager_path, \"--update\"],\n   467→                env=self.env,\n   468→                check=True,\n   469→                stream_output=False,\n   470→            )\n   471→        except subprocess.CalledProcessError as e:\n   472→            raise BriefcaseCommandError(\n   473→                f\"\"\"\\\n   474→Error while updating the Android SDK manager. Please run this command and examine\n   475→its output for errors.\n   476→\n   477→    $ {self.sdkmanager_path} --update\n   478→\"\"\"\n   479→            ) from e\n   480→\n   481→    def install_cmdline_tools(self) -> bool:\n   482→        \"\"\"Attempt to use 'latest' cmdline-tools to install the currently required\n   483→        version of the Command-Line Tools.\n   484→\n   485→        The Briefcase-managed SDK should always have the required version of cmdline-\n   486→        tools installed; however, user-provided SDKs may not have it.\n   487→\n   488→        :returns: True if successfully installed; False otherwise\n   489→        \"\"\"\n   490→        self.tools.console.info(\n   491→            f\"Installing Android Command-Line Tools {self.SDK_MANAGER_VER}...\",\n   492→            prefix=self.full_name,\n   493→        )\n   494→        self.tools.console.info(f\"Using Android SDK at {self.root_path}\")\n   495→        latest_sdkmanager_path = (\n   496→            self.root_path\n   497→            / \"cmdline-tools\"\n   498→            / \"latest\"\n   499→            / \"bin\"\n   500→            / self.sdkmanager_filename\n   501→        )\n   502→        try:\n   503→            self.tools.subprocess.run(\n   504→                [\n   505→                    latest_sdkmanager_path,\n   506→                    f\"cmdline-tools;{self.SDK_MANAGER_VER}\",\n   507→                ],\n   508→                check=True,\n   509→                stream_output=False,\n   510→            )\n   511→        except (OSError, subprocess.CalledProcessError) as e:\n   512→            self.tools.console.debug(str(e))\n   513→            self.tools.console.warning(\n   514→                f\"Failed to install cmdline-tools;{self.SDK_MANAGER_VER}\"\n   515→            )\n   516→            return False\n   517→        return True\n   518→\n   519→    def delete_legacy_sdk_tools(self):\n   520→        \"\"\"Delete any legacy Android SDK tools that are installed.\n   521→\n   522→        If no versions of the Command-Line Tools are installed but the 'tools' directory\n   523→        exists, the legacy SDK Tools are probably installed. Since they have been\n   524→        deprecated by more recent releases of SDK Manager, delete them and perform a\n   525→        fresh install.\n   526→\n   527→        The Android SDK Tools were deprecated in Sept 2017.\n   528→        \"\"\"\n   529→        if (\n   530→            not self.cmdline_tools_path.parent.exists()\n   531→            and (self.root_path / \"tools\").exists()\n   532→        ):\n   533→            self.tools.console.warning(\n   534→                f\"\"\"\n   535→*************************************************************************\n   536→** WARNING: Upgrading Android SDK tools                                **\n   537→*************************************************************************\n   538→\n   539→    Briefcase needs to replace the older Android SDK Tools with the\n   540→    newer Android SDK Command-Line Tools. This will involve some large\n   541→    downloads, as well as re-accepting the licenses for the Android\n   542→    SDKs.\n   543→\n   544→    Any emulators created with the older Android SDK Tools will not be\n   545→    compatible with the new tools. You will need to create new\n   546→    emulators. Old emulators can be removed by deleting the files\n   547→    in {self.avd_path} matching the emulator name.\n   548→\n   549→*************************************************************************\n   550→\"\"\"\n   551→            )\n   552→            self.tools.shutil.rmtree(self.root_path)\n   553→\n   554→    def cleanup_old_installs(self):\n   555→        \"\"\"Remove old versions of Android SDK packages and version markers.\n   556→\n   557→        When the Android SDK is upgraded, old versions of packages should be removed to\n   558→        keep the SDK tidy. This is namely the Command-line Tools that are used to manage\n   559→        the SDK and AVDs. Additionally, previous version of Briefcase created a version\n   560→        marker file that needs to be deleted.\n   561→        \"\"\"\n   562→        if (ver_file := self.cmdline_tools_path.parent / \"8092744\").is_file():\n   563→            self.tools.os.unlink(ver_file)\n   564→        if (latest := self.cmdline_tools_path.parent / \"latest\").is_dir():\n   565→            self.tools.shutil.rmtree(latest)\n   566→\n   567→    def list_packages(self):\n   568→        \"\"\"In debug output, list the packages currently managed by the SDK.\"\"\"\n   569→        try:\n   570→            # check_output always writes its output to debug\n   571→            self.tools.subprocess.check_output(\n   572→                [self.sdkmanager_path, \"--list_installed\"],\n   573→                env=self.env,\n   574→            )\n   575→        except subprocess.CalledProcessError as e:\n   576→            raise BriefcaseCommandError(\n   577→                \"Unable to invoke the Android SDK manager\"\n   578→            ) from e\n   579→\n   580→    def adb(self, device: str) -> ADB:\n   581→        \"\"\"Obtain an ADB instance for managing a specific device.\n   582→\n   583→        :param device: The device ID to manage.\n   584→        \"\"\"\n   585→        return ADB(tools=self.tools, device=device)\n   586→\n   587→    def verify_license(self):\n   588→        \"\"\"Verify that all necessary licenses have been accepted.\n   589→\n   590→        If they haven't, prompt the user to do so.\n   591→\n   592→        Raises an error if licenses are not.\n   593→        \"\"\"\n   594→        license_path = self.root_path / \"licenses/android-sdk-license\"\n   595→        if license_path.exists():\n   596→            return\n   597→\n   598→        self.tools.console.info(\n   599→            \"\"\"\n   600→The Android tools provided by Google have license terms that you must accept\n   601→before you may use those tools.\n   602→\"\"\"\n   603→        )\n   604→        try:\n   605→            # Using subprocess.run() with no I/O redirection so the user sees\n   606→            # the full output and can send input.\n   607→            self.tools.subprocess.run(\n   608→                [self.sdkmanager_path, \"--licenses\"],\n   609→                env=self.env,\n   610→                check=True,\n   611→                stream_output=False,\n   612→            )\n   613→        except (subprocess.CalledProcessError, OSError) as e:\n   614→            raise BriefcaseCommandError(\n   615→                f\"\"\"\\\n   616→Error while reviewing Android SDK licenses. Please run this command and examine\n   617→its output for errors.\n   618→\n   619→    $ {self.sdkmanager_path} --licenses\n   620→\"\"\"\n   621→            ) from e\n   622→\n   623→        if not license_path.exists():\n   624→            raise BriefcaseCommandError(\n   625→                \"\"\"\\\n   626→You did not accept the Android SDK licenses. Please re-run the briefcase command\n   627→and accept the Android SDK license when prompted. You may need an Internet\n   628→connection.\n   629→\"\"\"\n   630→            )\n   631→\n   632→    def verify_emulator(self):\n   633→        \"\"\"Verify that Android emulator has been installed, and is in a runnable state.\n   634→\n   635→        Raises an error if the emulator can't be installed.\n   636→        \"\"\"\n   637→        # Ensure the `platforms` folder exists.\n   638→        # See the discussion on #766 for details; as of June 2022, if this folder\n   639→        # doesn't exist, the emulator won't start, raising the error:\n   640→        #\n   641→        #    PANIC: Cannot find AVD system path. Please define ANDROID_SDK_ROOT\n   642→        #\n   643→        # Creating an empty platforms folder is enough to overcome this. This folder\n   644→        # will be created automatically when you build a project; but if you have a\n   645→        # clean Android SDK install that hasn't been used to build a project, it\n   646→        # might be missing.\n   647→        (self.root_path / \"platforms\").mkdir(exist_ok=True)\n   648→\n   649→        if self.emulator_path.exists():\n   650→            self.tools.console.debug(\"Android emulator is already installed.\")\n   651→            return\n   652→\n   653→        self.tools.console.info(\"Downloading the Android emulator...\")\n   654→        try:\n   655→            self.tools.subprocess.run(\n   656→                [self.sdkmanager_path, \"platform-tools\", \"emulator\"],\n   657→                env=self.env,\n   658→                check=True,\n   659→                stream_output=False,\n   660→            )\n   661→        except subprocess.CalledProcessError as e:\n   662→            raise BriefcaseCommandError(\n   663→                \"Error while installing Android emulator.\"\n   664→            ) from e\n   665→\n   666→    def verify_avd(self, avd: str):\n   667→        \"\"\"Verify that the AVD has the necessary system components to launch.\n   668→\n   669→        This includes:\n   670→            * AVD system image\n   671→            * Emulator skin\n   672→\n   673→        :param avd: The AVD name to verify.\n   674→        \"\"\"\n   675→        # Read the AVD configuration to retrieve the system image.\n   676→        # This is stored in the AVD configuration file with the key:\n   677→        #   image.sysdir.1=system-images/android-31/default/arm64-v8a/\n   678→        avd_config = self.avd_config(avd)\n   679→\n   680→        try:\n   681→            system_image_path = Path(avd_config[\"image.sysdir.1\"])\n   682→\n   683→            # Convert the path into a system image name, and verify it.\n   684→            self.verify_system_image(\";\".join(system_image_path.parts))\n   685→        except KeyError:\n   686→            self.tools.console.warning(\n   687→                f\"\"\"\n   688→*************************************************************************\n   689→** WARNING: Unable to determine AVD system image                       **\n   690→*************************************************************************\n   691→\n   692→    Briefcase was unable to determine the system image of the Android\n   693→    emulator AVD {avd!r} from it's configuration file.\n   694→\n   695→    Briefcase will proceed assuming the emulator is correctly\n   696→    configured. If you experience any problems running the emulator,\n   697→    this may be the cause of the problem.\n   698→\n   699→*************************************************************************\n   700→\"\"\"\n   701→            )\n   702→\n   703→        try:\n   704→            skin = avd_config[\"skin.name\"]\n   705→            skin_path = Path(avd_config[\"skin.path\"])\n   706→            if skin_path == Path(\"_no_skin\"):\n   707→                self.tools.console.debug(\"Emulator does not use a skin.\")\n   708→            elif skin_path != Path(\"skins\") / skin:\n   709→                self.tools.console.warning(\n   710→                    f\"\"\"\n   711→*************************************************************************\n   712→** WARNING: Unrecognized device skin                                   **\n   713→*************************************************************************\n   714→\n   715→    Briefcase does not recognize the skin {skin!r} used by the\n   716→    Android emulator AVD {avd!r}.\n   717→\n   718→    Briefcase will proceed assuming the emulator is correctly\n   719→    configured. If you experience any problems running the emulator,\n   720→    this may be the cause of the problem.\n   721→\n   722→*************************************************************************\n   723→\"\"\"\n   724→                )\n   725→            else:\n   726→                # Convert the path into a system image name, and verify it.\n   727→                self.verify_emulator_skin(skin)\n   728→\n   729→        except KeyError:\n   730→            self.tools.console.debug(f\"Device {avd!r} doesn't define a skin.\")\n   731→\n   732→    def verify_system_image(self, system_image: str):\n   733→        \"\"\"Verify that the required system image is installed.\n   734→\n   735→        :param system_image: The SDKManager identifier for the system image (e.g.,\n   736→            ``\"system-images;android-31;default;x86_64\"``)\n   737→        \"\"\"\n   738→        # Look for the directory named as a system image.\n   739→        # If it exists, we already have the system image.\n   740→        system_image_parts = system_image.split(\";\")\n   741→\n   742→        if len(system_image_parts) < 4 or system_image_parts[0] != \"system-images\":\n   743→            raise BriefcaseCommandError(\n   744→                f\"{system_image!r} is not a valid system image name.\"\n   745→            )\n   746→\n   747→        if system_image_parts[-1] != self.emulator_abi:\n   748→            self.tools.console.warning(\n   749→                f\"\"\"\n   750→*************************************************************************\n   751→** WARNING: Unexpected emulator ABI                                    **\n   752→*************************************************************************\n   753→\n   754→    The system image {system_image!r}\n   755→    does not match the architecture of this computer ({self.emulator_abi}).\n   756→\n   757→    Briefcase will proceed assuming the emulator is correctly\n   758→    configured. If you experience any problems running the emulator,\n   759→    this may be the cause of the problem.\n   760→\n   761→*************************************************************************\n   762→\"\"\"\n   763→            )\n   764→\n   765→        # Convert the system image into a path where that system image\n   766→        # would be expected, and see if the location exists.\n   767→        system_image_path = self.root_path\n   768→        for part in system_image_parts:\n   769→            system_image_path = system_image_path / part\n   770→\n   771→        if system_image_path.exists():\n   772→            # Found the system image.\n   773→            return\n   774→\n   775→        # System image not found; download it.\n   776→        self.tools.console.info(\n   777→            f\"Downloading the {system_image!r} Android system image...\",\n   778→            prefix=self.name,\n   779→        )\n   780→        try:\n   781→            self.tools.subprocess.run(\n   782→                [self.sdkmanager_path, system_image],\n   783→                env=self.env,\n   784→                check=True,\n   785→                stream_output=False,\n   786→            )\n   787→        except subprocess.CalledProcessError as e:\n   788→            raise BriefcaseCommandError(\n   789→                f\"Error while installing the {system_image!r} Android system image.\"\n   790→            ) from e\n   791→\n   792→    def verify_emulator_skin(self, skin: str):\n   793→        \"\"\"Verify that an emulator skin is available.\n   794→\n   795→        A human-readable list of available skins can be found here:\n   796→\n   797→            https://android.googlesource.com/platform/tools/adt/idea/+/refs/heads/mirror-goog-studio-main/artwork/resources/device-art-resources/\n   798→\n   799→        :param skin: The name of the skin to obtain\n   800→        \"\"\"\n   801→        # Check for a device skin. If it doesn't exist, download it.\n   802→        skin_path = self.root_path / \"skins\" / skin\n   803→        if skin_path.exists():\n   804→            self.tools.console.debug(f\"Device skin {skin!r} already exists.\")\n   805→            return\n   806→\n   807→        self.tools.console.info(f\"Obtaining {skin} device skin...\", prefix=self.name)\n   808→\n   809→        skin_url = (\n   810→            \"https://android.googlesource.com/platform/tools/adt/idea/\"\n   811→            \"+archive/refs/heads/mirror-goog-studio-main/\"\n   812→            f\"artwork/resources/device-art-resources/{skin}.tar.gz\"\n   813→        )\n   814→\n   815→        skin_tgz_path = self.tools.file.download(\n   816→            url=skin_url,\n   817→            download_path=self.root_path,\n   818→            role=f\"{skin} device skin\",\n   819→        )\n   820→\n   821→        # Unpack skin archive\n   822→        with self.tools.console.wait_bar(\"Installing device skin...\"):\n   823→            try:\n   824→                self.tools.file.unpack_archive(\n   825→                    skin_tgz_path,\n   826→                    extract_dir=skin_path,\n   827→                )\n   828→            except (shutil.ReadError, EOFError) as e:\n   829→                raise BriefcaseCommandError(\n   830→                    f\"Unable to unpack {skin} device skin.\"\n   831→                ) from e\n   832→\n   833→            # Delete the downloaded file.\n   834→            skin_tgz_path.unlink()\n   835→\n   836→    def emulators(self) -> list[str]:\n   837→        \"\"\"Find the list of emulators that are available.\"\"\"\n   838→        try:\n   839→            emulators = self.tools.subprocess.check_output(\n   840→                [self.emulator_path, \"-list-avds\"]\n   841→            ).strip()\n   842→        except subprocess.CalledProcessError as e:\n   843→            raise BriefcaseCommandError(\"Unable to obtain Android emulator list\") from e\n   844→        else:\n   845→            return [\n   846→                emu\n   847→                for emu in emulators.split(\"\\n\")\n   848→                # ignore any logging output included in output list\n   849→                if emu and not emu.startswith((\"INFO    |\", \"WARNING |\", \"ERROR   |\"))\n   850→            ]\n   851→\n   852→    def devices(self) -> dict[str, dict[str, str | bool]]:\n   853→        \"\"\"Find the devices that are attached and available to ADB.\"\"\"\n   854→        try:\n   855→            output = self.tools.subprocess.check_output(\n   856→                [self.adb_path, \"devices\", \"-l\"]\n   857→            ).strip()\n   858→            # Process the output of `adb devices -l`.\n   859→            # The first line is header information.\n   860→            # Each subsequent line is a single device descriptor.\n   861→            devices = {}\n   862→            header_found = False\n   863→            for line in output.split(\"\\n\"):\n   864→                if line == \"List of devices attached\":\n   865→                    header_found = True\n   866→                elif header_found and line:\n   867→                    parts = re.sub(r\"\\s+\", \" \", line).split(\" \")\n   868→\n   869→                    details = {}\n   870→                    for part in parts[2:]:\n   871→                        try:\n   872→                            key, value = part.split(\":\")\n   873→                            details[key] = value\n   874→                        except ValueError:\n   875→                            # Ignore any entry that isn't in \"key:value\" format.\n   876→                            pass\n   877→\n   878→                    if parts[1] == \"device\":\n   879→                        try:\n   880→                            name = details[\"model\"].replace(\"_\", \" \")\n   881→                        except KeyError:\n   882→                            name = \"Unknown device (no model name)\"\n   883→                        authorized = True\n   884→                    elif parts[1] == \"offline\":\n   885→                        name = \"Unknown device (offline)\"\n   886→                        authorized = False\n   887→                    else:\n   888→                        name = f\"Device not available for development ({' '.join(parts[1:])})\"\n   889→                        authorized = False\n   890→\n   891→                    devices[parts[0]] = {\n   892→                        \"name\": name,\n   893→                        \"authorized\": authorized,\n   894→                    }\n   895→\n   896→            return devices\n   897→        except subprocess.CalledProcessError as e:\n   898→            raise BriefcaseCommandError(\"Unable to obtain Android device list\") from e\n   899→\n   900→    def select_target_device(\n   901→        self,\n   902→        device_or_avd: str | None,\n   903→    ) -> tuple[str | None, str | None, str | None]:\n   904→        \"\"\"Select a device to be the target for actions.\n   905→\n   906→        Interrogates the system to get the list of available devices.\n   907→\n   908→        If the user has specified a device at the command line, that device will\n   909→        be validated, and then automatically selected.\n   910→\n   911→        :param device_or_avd: The device or AVD to target. Can be a physical\n   912→            device id (a hex string), an emulator id (``emulator-5554``), or an\n   913→            emulator AVD name (``@robotfriend``), or a JSON payload describing\n   914→            the properties of an emulator that will be created (e.g.,\n   915→            ``'{\"avd\":\"beePhone\",\"device_type\":\"pixel\",\"skin\":\"pixel_3a\",\"system_image\":\"system-images;android-31;default;arm64-v8a\"}'``)\n   916→            If ``None``, the user will be asked to select a device from the list\n   917→            available.\n   918→        :returns: A tuple containing ``(device, name, avd)``. ``avd`` will only\n   919→            be provided if an emulator with that AVD is not currently running.\n   920→            If ``device`` is None, a new emulator should be created.\n   921→        \"\"\"\n   922→        # If the device_or_avd starts with \"{\", it's a definition for a new\n   923→        # emulator to be created.\n   924→        if device_or_avd and device_or_avd.startswith(\"{\"):\n   925→            try:\n   926→                emulator_config = json.loads(device_or_avd)\n   927→                emulators = set(self.emulators())\n   928→\n   929→                # If an emulator with this AVD already exists, use it\n   930→                avd = emulator_config[\"avd\"]\n   931→                if avd not in emulators:\n   932→                    self._create_emulator(**emulator_config)\n   933→\n   934→                return None, f\"@{avd} (emulator)\", avd\n   935→            except json.JSONDecodeError as e:\n   936→                raise BriefcaseCommandError(\n   937→                    f\"Unable to create emulator with definition {device_or_avd!r}\"\n   938→                ) from e\n   939→            except KeyError:\n   940→                raise BriefcaseCommandError(\"No AVD provided for new device.\")\n   941→            except TypeError as e:\n   942→                property = str(e).split(\" \")[-1]\n   943→                raise BriefcaseCommandError(f\"Unknown device property {property}.\")\n   944→\n   945→        # Get the list of attached devices (includes running emulators)\n   946→        running_devices = self.devices()\n   947→\n   948→        # Choices is an ordered list of options that can be shown to the user.\n   949→        # Each device should appear only once, and be keyed by AVD only if\n   950→        # a device ID isn't available.\n   951→        choices = {}\n   952→        # A full index of available devices. Devices can be looked up by any valid key -\n   953→        # ID *or* AVD.\n   954→        device_index = {}\n   955→\n   956→        # Iterate over all the running devices.\n   957→        # If the device is a virtual device, use ADB to get the emulator AVD name.\n   958→        # If it is a physical device, use the device name.\n   959→        # Keep a log of all running AVDs\n   960→        running_avds = {}\n   961→        for d, details in sorted(running_devices.items(), key=lambda d: d[1][\"name\"]):\n   962→            name = details[\"name\"]\n   963→            avd = self.adb(d).avd_name()\n   964→            if avd:\n   965→                # It's a running emulator\n   966→                running_avds[avd] = d\n   967→                full_name = f\"@{avd} (running emulator)\"\n   968→                choices[d] = full_name\n   969→\n   970→                # Save the AVD as a device detail.\n   971→                details[\"avd\"] = avd\n   972→\n   973→                # Device can be looked up by device ID or AVD\n   974→                device_index[d] = full_name\n   975→                device_index[f\"@{avd}\"] = full_name\n   976→            else:\n   977→                # It's a physical device (might be disabled)\n   978→                full_name = f\"{name} ({d})\"\n   979→                choices[d] = full_name\n   980→                device_index[d] = full_name\n   981→\n   982→        # Add any non-running emulator AVDs to the list of candidate devices\n   983→        for avd in self.emulators():\n   984→            if avd not in running_avds:\n   985→                name = f\"@{avd} (emulator)\"\n   986→                choices[f\"@{avd}\"] = name\n   987→                device_index[f\"@{avd}\"] = name\n   988→\n   989→        # If a device or AVD has been provided, check it against the available\n   990→        # device list.\n   991→        if device_or_avd:\n   992→            try:\n   993→                name = device_index[device_or_avd]\n   994→\n   995→                if device_or_avd.startswith(\"@\"):\n   996→                    # specifier is an AVD\n   997→                    avd = device_or_avd[1:]\n   998→                    try:\n   999→                        device = running_avds[avd]\n  1000→                    except KeyError:\n  1001→                        # device_or_avd isn't in the list of running avds;\n  1002→                        # it must be a non-running emulator.\n  1003→                        return None, name, avd\n  1004→                else:\n  1005→                    # Specifier is a direct device ID\n  1006→                    device = device_or_avd\n  1007→\n  1008→                details = running_devices[device]\n  1009→                avd = details.get(\"avd\")\n  1010→                if details[\"authorized\"]:\n  1011→                    # An authorized, running device (emulator or physical)\n  1012→                    return device, name, avd\n  1013→                else:\n  1014→                    # An unauthorized physical device\n  1015→                    raise AndroidDeviceNotAuthorized(device)\n  1016→\n  1017→            except KeyError as e:\n  1018→                # Provided device_or_id isn't a valid device identifier.\n  1019→                id_type = (\n  1020→                    \"emulator AVD\" if device_or_avd.startswith(\"@\") else \"device ID\"\n  1021→                )\n  1022→                raise InvalidDeviceError(id_type, device_or_avd) from e\n  1023→        # We weren't given a device/AVD; we have to select from the list.\n  1024→        # If we're selecting from a list, there's always one last choice\n  1025→        choices[\"-\"] = \"Create a new Android emulator\"\n  1026→\n  1027→        # Show the choices to the user.\n  1028→        try:\n  1029→            choice = self.tools.console.selection_question(\n  1030→                intro=\"Select Android device to use:\",\n  1031→                description=\"Android device\",\n  1032→                options=choices,\n  1033→            )\n  1034→        except InputDisabled as e:\n  1035→            # If input is disabled, and there's only one actual simulator,\n  1036→            # select it. If there are no simulators, select \"Create simulator\"\n  1037→            if len(choices) <= 2:\n  1038→                choice = next(iter(choices))\n  1039→            else:\n  1040→                raise BriefcaseCommandError(\n  1041→                    \"\"\"\\\n  1042→Input has been disabled; can't select a device to target.\n  1043→Use the -d/--device option to explicitly specify the device to use.\n  1044→\"\"\"\n  1045→                ) from e\n  1046→\n  1047→        # Process the user's choice\n  1048→        if choice == \"-\":\n  1049→            # Create a new emulator. No device ID or AVD.\n  1050→            device = None\n  1051→            avd = None\n  1052→            name = None\n  1053→        elif choice.startswith(\"@\"):\n  1054→            # A non-running emulator. We have an AVD, but no device ID.\n  1055→            device = None\n  1056→            name = device_index[choice]\n  1057→            avd = choice[1:]\n  1058→        else:\n  1059→            # Either a running emulator, or a physical device. Regardless,\n  1060→            # we need to check if the device is developer enabled.\n  1061→            # Functionally, we know the device *must* be in the list of\n  1062→            # choices; which means it's also in the list of running devices\n  1063→            # and the list of device choices, so any KeyError on those lookups\n  1064→            # indicates a deeper problem.\n  1065→            details = running_devices[choice]\n  1066→            if not details[\"authorized\"]:\n  1067→                # An unauthorized physical device\n  1068→                raise AndroidDeviceNotAuthorized(choice)\n  1069→\n  1070→            # Return the device ID and name.\n  1071→            device = choice\n  1072→            name = device_index[choice]\n  1073→            avd = details.get(\"avd\")\n  1074→\n  1075→        if avd:\n  1076→            self.tools.console.info(\n  1077→                f\"\"\"\n  1078→In future, you can specify this device by running:\n  1079→\n  1080→    $ briefcase run android -d \"@{avd}\"\n  1081→\"\"\"\n  1082→            )\n  1083→        elif device:\n  1084→            self.tools.console.info(\n  1085→                f\"\"\"\n  1086→In future, you can specify this device by running:\n  1087→\n  1088→    $ briefcase run android -d {device}\n  1089→\"\"\"\n  1090→            )\n  1091→\n  1092→        return device, name, avd\n  1093→\n  1094→    def create_emulator(self) -> str:\n  1095→        \"\"\"Create a new Android emulator.\n  1096→\n  1097→        :returns: The AVD of the newly created emulator.\n  1098→        \"\"\"\n  1099→        # Get the list of existing emulators\n  1100→        emulators = set(self.emulators())\n  1101→\n  1102→        default_avd = \"beePhone\"\n  1103→        i = 1\n  1104→        # Make sure the default name is unique\n  1105→        while default_avd in emulators:\n  1106→            i += 1\n  1107→            default_avd = f\"beePhone{i}\"\n  1108→\n  1109→        # Prompt for a device avd until a valid one is provided.\n  1110→        avd = self.tools.console.text_question(\n  1111→            intro=f\"\"\"\\\n  1112→You need to select a name for your new emulator. This is an identifier that\n  1113→can be used to start the emulator in future. It should follow the same naming\n  1114→conventions as a Python package (i.e., it may only contain letters, numbers,\n  1115→hyphens and underscores). If you don't provide a name, Briefcase will use the\n  1116→a default name '{default_avd}'.\n  1117→\"\"\",\n  1118→            description=\"Emulator Name\",\n  1119→            default=default_avd,\n  1120→            validator=create_avd_validator(emulators),\n  1121→        )\n  1122→\n  1123→        # TODO: Provide a list of options for device types with matching skins\n  1124→        device_type = self.DEFAULT_DEVICE_TYPE\n  1125→        skin = self.DEFAULT_DEVICE_SKIN\n  1126→\n  1127→        # TODO: Provide a list of options for system images.\n  1128→        system_image = self.DEFAULT_SYSTEM_IMAGE\n  1129→\n  1130→        self._create_emulator(\n  1131→            avd=avd,\n  1132→            device_type=device_type,\n  1133→            skin=skin,\n  1134→            system_image=system_image,\n  1135→        )\n  1136→\n  1137→        self.tools.console.info(\n  1138→            f\"\"\"\n  1139→Android emulator '{avd}' created.\n  1140→\n  1141→In future, you can specify this device by running:\n  1142→\n  1143→    $ briefcase run android -d @{avd}\n  1144→\"\"\"\n  1145→        )\n  1146→\n  1147→        return avd\n  1148→\n  1149→    def _create_emulator(\n  1150→        self,\n  1151→        avd: str,\n  1152→        device_type: str | None = None,\n  1153→        skin: str | None = None,\n  1154→        system_image: str | None = None,\n  1155→    ):\n  1156→        \"\"\"Internal method that does the actual work of creating the emulator.\n  1157→\n  1158→        AVD is the only required argument; all other arguments will assume reasonable\n  1159→        defaults.\n  1160→\n  1161→        :param avd: The AVD for the new emulator\n  1162→        :param device_type: The device type for the new emulator (e.g., \"pixel\")\n  1163→        :param skin: The skin for the new emulator to use (e.g., \"pixel_3a\")\n  1164→        :param system_image: The system image to use on the new emulator. (e.g.,\n  1165→            \"system-images;android-31;default;arm64-v8a\")\n  1166→        \"\"\"\n  1167→        if device_type is None:\n  1168→            device_type = self.DEFAULT_DEVICE_TYPE\n  1169→        if skin is None:\n  1170→            skin = self.DEFAULT_DEVICE_SKIN\n  1171→        if system_image is None:\n  1172→            system_image = self.DEFAULT_SYSTEM_IMAGE\n  1173→\n  1174→        # Ensure the required skin is available.\n  1175→        self.verify_emulator_skin(skin)\n  1176→\n  1177→        # Ensure the required system image is available.\n  1178→        self.verify_system_image(system_image)\n  1179→\n  1180→        with self.tools.console.wait_bar(f\"Creating Android emulator {avd}...\"):\n  1181→            try:\n  1182→                self.tools.subprocess.check_output(\n  1183→                    [\n  1184→                        self.avdmanager_path,\n  1185→                        \"--verbose\",\n  1186→                        \"create\",\n  1187→                        \"avd\",\n  1188→                        \"--name\",\n  1189→                        avd,\n  1190→                        \"--abi\",\n  1191→                        self.emulator_abi,\n  1192→                        \"--package\",\n  1193→                        system_image,\n  1194→                        \"--device\",\n  1195→                        device_type,\n  1196→                    ],\n  1197→                    # Ensure XDG_CONFIG_HOME is not set so avdmanager uses the default\n  1198→                    # location (i.e. ~/.android) because the emulator does not respect\n  1199→                    # XDG_CONFIG_HOME and will not be able to find the AVD to run it.\n  1200→                    env={\n  1201→                        **self.env,\n  1202→                        **{\"XDG_CONFIG_HOME\": None},\n  1203→                    },\n  1204→                )\n  1205→            except subprocess.CalledProcessError as e:\n  1206→                raise BriefcaseCommandError(\"Unable to create Android emulator\") from e\n  1207→\n  1208→        with self.tools.console.wait_bar(\"Adding extra device configuration...\"):\n  1209→            self.update_emulator_config(\n  1210→                avd,\n  1211→                {\n  1212→                    \"avd.id\": avd,\n  1213→                    \"avd.name\": avd,\n  1214→                    \"disk.dataPartition.size\": \"4096M\",\n  1215→                    \"hw.keyboard\": \"yes\",\n  1216→                    \"skin.dynamic\": \"yes\",\n  1217→                    \"skin.name\": skin,\n  1218→                    \"skin.path\": f\"skins/{skin}\",\n  1219→                    \"showDeviceFrame\": \"yes\",\n  1220→                },\n  1221→            )\n  1222→\n  1223→    def avd_config(self, avd: str) -> dict[str, str]:\n  1224→        \"\"\"Obtain the AVD configuration as key-value pairs.\n  1225→\n  1226→        :params avd: The AVD whose config will be retrieved\n  1227→        \"\"\"\n  1228→        # Parse the existing config into key-value pairs\n  1229→        avd_config = {}\n  1230→        try:\n  1231→            with self.avd_config_filename(avd).open(\"r\", encoding=\"utf-8\") as f:\n  1232→                for line in f:\n  1233→                    try:\n  1234→                        key, value = line.rstrip().split(\"=\", 1)\n  1235→                        avd_config[key.strip()] = value.strip()\n  1236→                    except ValueError:\n  1237→                        pass\n  1238→        except OSError as e:\n  1239→            raise BriefcaseCommandError(\n  1240→                f\"Unable to read configuration of AVD @{avd}\"\n  1241→            ) from e\n  1242→\n  1243→        return avd_config\n  1244→\n  1245→    def update_emulator_config(self, avd: str, updates: dict[str, str]):\n  1246→        \"\"\"Update the AVD configuration with specific values.\n  1247→\n  1248→        :params avd: The AVD whose config will be updated\n  1249→        :params updates: A dictionary containing the new key-value to add to the device\n  1250→            configuration.\n  1251→        \"\"\"\n  1252→        avd_config = self.avd_config(avd)\n  1253→\n  1254→        # Augment the config with the new key-values pairs\n  1255→        avd_config.update(updates)\n  1256→\n  1257→        # Write the update configuration.\n  1258→        with self.avd_config_filename(avd).open(\"w\", encoding=\"utf-8\") as f:\n  1259→            for key, value in avd_config.items():\n  1260→                f.write(f\"{key}={value}\\n\")\n  1261→\n  1262→    def start_emulator(\n  1263→        self,\n  1264→        avd: str,\n  1265→        extra_args: list[str] | None = None,\n  1266→    ) -> tuple[str, str]:\n  1267→        \"\"\"Start an existing Android emulator.\n  1268→\n  1269→        Returns when the emulator is booted and ready to accept apps.\n  1270→\n  1271→        :param avd: The AVD of the device.\n  1272→        :param extra_args: Additional command line arguments to pass when starting the\n  1273→            emulator.\n  1274→        \"\"\"\n  1275→        if avd not in set(self.emulators()):\n  1276→            raise InvalidDeviceError(\"emulator AVD\", avd)\n  1277→\n  1278→        if extra_args is None:\n  1279→            extra_args = []\n  1280→\n  1281        # Start the emulator\n  1282→        emulator_popen = self.tools.subprocess.Popen(\n  1283→            [self.emulator_path, f\"@{avd}\", \"-dns-server\", \"8.8.8.8\"] + extra_args,\n  1284→            env=self.env,\n  1285→            stdout=subprocess.PIPE,\n  1286→            stderr=subprocess.STDOUT,\n  1287→            bufsize=1,\n  1288→            start_new_session=True,\n  1289→        )\n  1290→\n  1291→        # Start capturing the emulator's output\n  1292→        # On Windows, the emulator can block until stdout is read and the emulator will\n  1293→        # not actually run until the user sends CTRL+C to Briefcase (#1573). This\n  1294→        # avoids that scenario while also ensuring emulator output is always available\n  1295→        # to print in the console if other issues occur.\n  1296→        emulator_streamer = self.tools.subprocess.stream_output_non_blocking(\n  1297→            label=\"Android emulator\",\n  1298→            popen_process=emulator_popen,\n  1299→            capture_output=True,\n  1300→        )\n  1301→\n  1302→        # wrap AVD name in quotes since '@' is a special char in PowerShell\n  1303→        emulator_command = \" \".join(\n  1304→            f'\"{arg}\"' if arg.startswith(\"@\") else arg\n  1305→            for arg in map(str, emulator_popen.args)\n  1306→        )\n  1307→\n  1308→        general_error_msg = f\"\"\"\n  1309→Review the emulator output above for:\n  1310→ - Troubleshooting or resolution steps such as enabling hardware acceleration\n  1311→ - Other errors or warnings that may be suggesting the cause of the startup failure\n  1312→\n  1313→Ensure your Android SDK is up-to-date by running:\n  1314→\n  1315→    $ briefcase upgrade {AndroidSDK.name}\n  1316→\n  1317→To review Google's general troubleshooting steps for the emulator, visit:\n  1318→\n  1319→    https://developer.android.com/studio/run/emulator-troubleshooting\n  1320→\n  1321→You can also start the emulator manually by running:\n  1322→\n  1323→    $ {emulator_command}\n  1324→\"\"\"\n  1325→\n  1326→        failed_startup_error_msg = f\"{{prologue}}\\n{general_error_msg}\"\n  1327→\n  1328→        # The boot process happens in 2 phases.\n  1329→        # First, the emulator appears in the device list. However, it's not ready until\n  1330→        # the boot process has finished. To determine the boot status, we need the\n  1331→        # device ID, and an ADB connection.\n  1332→\n  1333→        # Phase 1: Wait for the device to appear so we can get an ADB instance for it.\n  1334→        try:\n  1335→            with self.tools.console.wait_bar(\"Starting emulator...\") as keep_alive:\n  1336→                adb = None\n  1337→                known_devices = set()\n  1338→                while adb is None:\n  1339→                    if emulator_popen.poll() is not None:\n  1340→                        raise BriefcaseCommandError(\n  1341→                            failed_startup_error_msg.format(\n  1342→                                prologue=\"Android emulator was unable to start!\"\n  1343→                            )\n  1344→                        )\n  1345→\n  1346→                    for device, details in sorted(self.devices().items()):\n  1347→                        # Only process authorized devices that we haven't seen.\n  1348→                        if details[\"authorized\"] and device not in known_devices:\n  1349→                            adb = self.adb(device)\n  1350→                            device_avd = adb.avd_name()\n  1351→\n  1352→                            if device_avd == avd:\n  1353→                                # Found an active device that matches\n  1354→                                # the AVD we are starting.\n  1355→                                full_name = f\"@{avd} (running emulator)\"\n  1356→                                break\n  1357→                            else:\n  1358→                                # Not the one. Zathras knows.\n  1359→                                adb = None\n  1360→                                known_devices.add(device)\n  1361→\n  1362→                    # If we haven't found a device, try again in 2 seconds...\n  1363→                    if adb is None:\n  1364→                        keep_alive.update()\n  1365→                        self.sleep(2)\n  1366→\n  1367→            # Phase 2: Wait for the boot process to complete\n  1368→            if not adb.has_booted():\n  1369→                with self.tools.console.wait_bar(\"Booting emulator...\") as keep_alive:\n  1370→                    while not adb.has_booted():\n  1371→                        if emulator_popen.poll() is not None:\n  1372→                            raise BriefcaseCommandError(\n  1373→                                failed_startup_error_msg.format(\n  1374→                                    prologue=\"Android emulator was unable to boot!\"\n  1375→                                )\n  1376→                            )\n  1377→\n  1378→                        # Try again in 2 seconds...\n  1379→                        keep_alive.update()\n  1380→                        self.sleep(2)\n  1381→        except BaseException as e:\n  1382→            self.tools.console.warning(\n  1383→                \"Emulator output log for startup failure\",\n  1384→                prefix=self.name,\n  1385→            )\n  1386→            self.tools.console.info(emulator_streamer.captured_output)\n  1387→\n  1388→            # Provide troubleshooting steps if user gives up on the emulator starting\n  1389→            if isinstance(e, KeyboardInterrupt):\n  1390→                self.tools.console.warning(\n  1391→                    \"Is the Android emulator not starting up properly?\",\n  1392→                    prefix=self.name,\n  1393→                )\n  1394→                self.tools.console.info(\n  1395→                    \"\"\"\n  1396→If the emulator opened after pressing CTRL+C, then leave the emulator open and\n  1397→run Briefcase again. The running emulator can then be selected from the list.\n  1398→\"\"\"\n  1399→                )\n  1400→                self.tools.console.info(general_error_msg)\n  1401→\n  1402→            raise\n  1403→        finally:\n  1404→            emulator_streamer.request_stop()\n  1405→\n  1406→        # Return the device ID and full name.\n  1407→        return device, full_name\n  1408→\n  1409→\n  1410→class ADB:\n  1411→    def __init__(self, tools: ToolCache, device: str):\n  1412→        \"\"\"An API integration for the Android Debug Bridge (ADB).\n  1413→\n  1414→        :param tools: ToolCache of available tools\n  1415→        :param device: The ID of the device to target (in a format usable by `adb -s`)\n  1416→        \"\"\"\n  1417→        self.tools = tools\n  1418→        self.device = device\n  1419→\n  1420→    def avd_name(self) -> str | None:\n  1421→        \"\"\"Get the AVD name for the device.\n  1422→\n  1423→        :returns: The AVD name for the device; or ``None`` if the device isn't\n  1424→            an emulator\n  1425→        \"\"\"\n  1426→        try:\n  1427→            output = self.run(\"emu\", \"avd\", \"name\")\n  1428→            return output.split(\"\\n\")[0]\n  1429→        except subprocess.CalledProcessError as e:\n  1430→            # Status code 1 is a normal \"it's not an emulator\" error response\n  1431→            if e.returncode == 1:\n  1432→                return None\n  1433→            else:\n  1434→                raise BriefcaseCommandError(\n  1435→                    f\"Unable to interrogate AVD name of device {self.device}\"\n  1436→                ) from e\n  1437→\n  1438→    def has_booted(self) -> bool:\n  1439→        \"\"\"Determine if the device has completed booting.\n  1440→\n  1441→        :returns: True if it has booted; False otherwise.\n  1442→        \"\"\"\n  1443→        try:\n  1444→            # When the sys.boot_completed property of the device\n  1445→            # returns '1', the boot is complete. Any other response indicates\n  1446→            # booting is underway.\n  1447→            output = self.run(\"shell\", \"getprop\", \"sys.boot_completed\")\n  1448→            return output.strip() == \"1\"\n  1449→        except subprocess.CalledProcessError as e:\n  1450→            raise BriefcaseCommandError(\n  1451→                f\"Unable to determine if emulator {self.device} has booted.\"\n  1452→            ) from e\n  1453→\n  1454→    def run(self, *arguments: SubprocessArgT, quiet: bool = False) -> str:\n  1455→        \"\"\"Run a command on a device using Android debug bridge, `adb`. The device name\n  1456→        is mandatory to ensure clarity in the case of multiple attached devices.\n  1457→\n  1458→        :param arguments: List of strings to pass to `adb` as arguments.\n  1459→        :param quiet: Should the invocation of this command be silent, and\n  1460→            *not* appear in the logs? This should almost always be False;\n  1461→            however, for some calls (most notably, calls that are called\n  1462→            frequently to evaluate the status of another process), logging can\n  1463→            be turned off so that log output isn't corrupted by thousands of\n  1464→            polling calls.\n  1465→        :returns: `adb` output on success; raises an exception on failure.\n  1466→        \"\"\"\n  1467→        # The ADB integration operates on the basis of running commands before\n  1468→        # checking that they are valid, then parsing output to notice errors.\n  1469→        # This keeps performance good in the success case.\n  1470→        try:\n  1471→            output = self.tools.subprocess.check_output(\n  1472→                [self.tools.android_sdk.adb_path, \"-s\", self.device] + list(arguments),\n  1473→                quiet=quiet,\n  1474→            )\n  1475→            # add returns status code 0 in the case of failure. The only tangible evidence\n  1476→            # of failure is the message \"Failure [INSTALL_FAILED_OLDER_SDK]\" in the,\n  1477→            # console output; so if that message exists in the output, raise an exception.\n  1478→            if \"Failure [INSTALL_FAILED_OLDER_SDK]\" in output:\n  1479→                raise BriefcaseCommandError(\n  1480→                    \"Your device doesn't meet the minimum SDK requirements of this app.\"\n  1481→                )\n  1482→            return output\n  1483→        except subprocess.CalledProcessError as e:\n  1484→            if any(DEVICE_NOT_FOUND.match(line) for line in e.output.split(\"\\n\")):\n  1485→                raise InvalidDeviceError(\"device id\", self.device) from e\n  1486→            raise\n  1487→\n  1488→    def install_apk(self, apk_path: str | Path):\n  1489→        \"\"\"Install an APK file on an Android device.\n  1490→\n  1491→        :param apk_path: The path of the Android APK file to install.\n  1492→        :returns: `None` on success; raises an exception on failure.\n  1493→        \"\"\"\n  1494→        try:\n  1495→            self.run(\"install\", \"-r\", apk_path)\n  1496→        except subprocess.CalledProcessError as e:\n  1497→            raise BriefcaseCommandError(\n  1498→                f\"Unable to install APK {apk_path} on {self.device}\"\n  1499→            ) from e\n  1500→\n  1501→    def force_stop_app(self, package: str):\n  1502→        \"\"\"Force-stop an app, specified as a package name.\n  1503→\n  1504→        :param package: The name of the Android package, e.g., com.username.myapp.\n  1505→        :returns: `None` on success; raises an exception on failure.\n  1506→        \"\"\"\n  1507→        # In my testing, `force-stop` exits with status code 0 (success) so long\n  1508→        # as you pass a package name, even if the package does not exist, or the\n  1509→        # package is not running.\n  1510→        try:\n  1511→            self.run(\"shell\", \"am\", \"force-stop\", package)\n  1512→        except subprocess.CalledProcessError as e:\n  1513→            raise BriefcaseCommandError(\n  1514→                f\"Unable to force stop app {package} on {self.device}\"\n  1515→            ) from e\n  1516→\n  1517→    def start_app(self, package: str, activity: str, passthrough: list[str]):\n  1518→        \"\"\"Start an app, specified as a package name & activity name.\n  1519→\n  1520→        If you have an APK file, and you are not sure of the package or activity\n  1521→        name, you can find it using `aapt dump badging filename.apk` and looking\n  1522→        for \"package\" and \"launchable-activity\" in the output.\n  1523→\n  1524→        :param package: The name of the Android package, e.g., com.username.myapp.\n  1525→        :param activity: The activity of the APK to start.\n  1526→        :param passthrough: Arguments to pass to the app.\n  1527→        :returns: `None` on success; raises an exception on failure.\n  1528→        \"\"\"\n  1529→        try:\n  1530→            # `am start` also accepts string array extras, but we pass the arguments as a\n  1531→            # single JSON string, because JSON deals with edge cases like whitespace and\n  1532→            # escaping in a reliable and well-documented way.\n  1533→            output = self.run(\n  1534→                \"shell\",\n  1535→                \"am\",\n  1536→                \"start\",\n  1537→                \"-n\",\n  1538→                f\"{package}/{activity}\",\n  1539→                \"-a\",\n  1540→                \"android.intent.action.MAIN\",\n  1541→                \"-c\",\n  1542→                \"android.intent.category.LAUNCHER\",\n  1543→                \"--es\",\n  1544→                \"org.beeware.ARGV\",\n  1545→                shlex.quote(json.dumps(passthrough)),  # Protect from Android's shell\n  1546→            )\n  1547→\n  1548→            # `adb shell am start` always exits with status zero. We look for error\n  1549→            # messages in the output.\n  1550→            if any(\n  1551→                line.startswith(\"Error: Activity class \")\n  1552→                and line.endswith(\"does not exist.\")\n  1553→                for line in output.split(\"\\n\")\n  1554→            ):\n  1555→                raise BriefcaseCommandError(\n  1556→                    f\"\"\"\\\n  1557→Activity class not found while starting app.\n  1558→\n  1559→`adb` output:\n  1560→\n  1561→    {output}\n  1562→\"\"\"\n  1563→                )\n  1564→        except subprocess.CalledProcessError as e:\n  1565→            raise BriefcaseCommandError(\n  1566→                f\"Unable to start {package}/{activity} on {self.device}\"\n  1567→            ) from e\n  1568→\n  1569→    def logcat(self, pid: str) -> subprocess.Popen:\n  1570→        \"\"\"Start following the adb log for the device.\n  1571→\n  1572→        :param pid: The PID whose logs you want to display.\n  1573→        :returns: A Popen object for the logcat call\n  1574→        \"\"\"\n  1575→        # As best as we can make out, adb logcat returns UTF-8 output.\n  1576→        # See #1425 for details.\n  1577→        return self.tools.subprocess.Popen(\n  1578→            [\n  1579→                self.tools.android_sdk.adb_path,\n  1580→                \"-s\",\n  1581→                self.device,\n  1582→                \"logcat\",\n  1583→                \"--format=tag\",\n  1584→                \"--pid\",  # This option is available since API level 24.\n  1585→                pid,\n  1586→            ]\n  1587→            # Filter out some noisy and useless tags.\n  1588→            + [f\"{tag}:S\" for tag in [\"EGL_emulation\"]]\n  1589→            + ([\"--format=color\"] if self.tools.console.is_color_enabled else []),\n  1590→            env=self.tools.android_sdk.env,\n  1591→            encoding=\"UTF-8\",\n  1592→            stdout=subprocess.PIPE,\n  1593→            stderr=subprocess.STDOUT,\n  1594→            bufsize=1,\n  1595→        )\n  1596→\n  1597→    def logcat_tail(self, since: datetime):\n  1598→        \"\"\"Show the tail of the logs for Python-like apps, starting from a given\n  1599→        timestamp.\n  1600→\n  1601→        :param since: The start time from which logs should be displayed\n  1602→        \"\"\"\n  1603→        try:\n  1604→            # As best as we can make out, adb logcat returns UTF-8 output.\n  1605→            # See #1425 for details.\n  1606→            self.tools.subprocess.run(\n  1607→                [\n  1608→                    self.tools.android_sdk.adb_path,\n  1609→                    \"-s\",\n  1610→                    self.device,\n  1611→                    \"logcat\",\n  1612→                    \"--format=tag\",\n  1613→                    \"-t\",\n  1614→                    since.strftime(\"%m-%d %H:%M:%S.000000\"),\n  1615→                    \"-s\",\n  1616→                    # This is a collection of log labels that should catch\n  1617→                    # most Python app output.\n  1618→                    \"MainActivity:*\",\n  1619→                    \"stdio:*\",\n  1620→                    \"python.stdout:*\",\n  1621→                    \"AndroidRuntime:*\",\n  1622→                ]\n  1623→                + ([\"--format=color\"] if self.tools.console.is_color_enabled else []),\n  1624→                env=self.tools.android_sdk.env,\n  1625→                check=True,\n  1626→                encoding=\"UTF-8\",\n  1627→            )\n  1628→        except subprocess.CalledProcessError as e:\n  1629→            raise BriefcaseCommandError(\"Error starting ADB logcat.\") from e\n  1630→\n  1631→    def pidof(self, package: str, **kwargs) -> str | None:\n  1632→        \"\"\"Obtain the PID of a running app by package name.\n  1633→\n  1634→        :param package: The package ID for the application (e.g.,\n  1635→            ``org.beeware.tutorial``)\n  1636→        :returns: The PID of the given app as a string, or None if it isn't\n  1637→        running.\n  1638→        \"\"\"\n  1639→        # The pidof command is available since API level 24. The level 23 emulator image also\n  1640→        # includes it, but it doesn't work correctly (it returns all processes).\n  1641→        try:\n  1642→            # Exit status is unreliable: some devices (e.g. Nexus 4) return 0 even when no\n  1643→            # process was found.\n  1644→            return self.run(\"shell\", \"pidof\", \"-s\", package, **kwargs).strip() or None\n  1645→        except subprocess.CalledProcessError:\n  1646→            return None\n  1647→\n  1648→    def pid_exists(self, pid: str, **kwargs) -> bool:\n  1649→        \"\"\"Confirm if the PID exists on the emulator.\n  1650→\n  1651→        :param pid: The PID to check\n  1652→        :returns: True if the PID exists, False if it doesn't.\n  1653→        \"\"\"\n  1654→        # Look for the existence of /proc/<PID> on the device filesystem.\n  1655→        # If that file exists, so does the process.\n  1656→        try:\n  1657→            self.run(\"shell\", \"test\", \"-e\", f\"/proc/{pid}\", **kwargs)\n  1658→            return True\n  1659→        except subprocess.CalledProcessError:\n  1660→            return False\n  1661→\n  1662→    def kill(self):\n  1663→        \"\"\"Stop the running Android emulator.\"\"\"\n  1664→        try:\n  1665→            self.run(\"emu\", \"kill\")\n  1666→        except subprocess.CalledProcessError as e:\n  1667→            raise BriefcaseCommandError(\"Error stopping the Android emulator.\") from e\n  1668→\n  1669→    def datetime(self) -> datetime:\n  1670→        \"\"\"Obtain the device's current date/time.\n  1671→\n  1672→        This date/time is naive (i.e. not timezone aware) and in the device's \"local\"\n  1673→        time. Therefore, it may be quite different from the date/time for Briefcase and\n  1674→        caution should be used if comparing it to machine's \"local\" time.\n  1675→        \"\"\"\n  1676→        datetime_format = \"%Y-%m-%d %H:%M:%S\"\n  1677→        try:\n  1678→            device_datetime = self.run(\"shell\", \"date\", f\"+'{datetime_format}'\").strip()\n  1679→            return datetime.strptime(device_datetime, datetime_format)\n  1680→        except (ValueError, subprocess.CalledProcessError) as e:\n  1681→            raise BriefcaseCommandError(\"Error obtaining device date/time.\") from e\n  1682→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"582d24d0-a652-4401-a2f1-683615c9cc76","uuid":"5b5f5528-edc6-4401-880d-96d1fb5f01b5","tool_use_result":{"type":"text","file":{"filePath":"/testbed/src/briefcase/integrations/android_sdk.py","content":"from __future__ import annotations\n\nimport json\nimport os\nimport re\nimport shlex\nimport shutil\nimport subprocess\nimport time\nfrom datetime import datetime\nfrom pathlib import Path\n\nfrom briefcase.config import PEP508_NAME_RE\nfrom briefcase.exceptions import (\n    BriefcaseCommandError,\n    IncompatibleToolError,\n    InputDisabled,\n    InvalidDeviceError,\n    MissingToolError,\n)\nfrom briefcase.integrations.base import ManagedTool, ToolCache\nfrom briefcase.integrations.java import JDK\nfrom briefcase.integrations.subprocess import SubprocessArgT\n\nDEVICE_NOT_FOUND = re.compile(r\"^error: device '[^']*' not found\")\n\n\ndef create_avd_validator(emulators):\n    def _validate_avd_name(avd):\n        if not PEP508_NAME_RE.match(avd):\n            raise ValueError(\n                \"An emulator name may only contain letters, numbers, hyphens and underscores.\"\n            )\n        elif avd in emulators:\n            raise ValueError(f\"An emulator named '{avd}' already exists.\")\n        return True\n\n    return _validate_avd_name\n\n\nclass AndroidDeviceNotAuthorized(BriefcaseCommandError):\n    def __init__(self, device):\n        self.device = device\n        super().__init__(\n            f\"\"\"\nThe device you have selected ({device}) has not had developer options and\nUSB debugging enabled. These must be enabled before a device can be used  as a\ntarget for deployment. For details on how to enable Developer Options, visit:\n\n    https://developer.android.com/studio/debug/dev-options#enable\n\nOnce you have enabled these options on your device, you will be able to select\nthis device as a deployment target.\n\n\"\"\"\n        )\n\n\nclass AndroidSDK(ManagedTool):\n    name = \"android_sdk\"\n    full_name = \"Android SDK\"\n\n    # Latest version for Command-Line Tools download as of May 2024\n    # **Be sure the gradle.rst docs stay in sync with version updates here**\n    SDK_MANAGER_DOWNLOAD_VER = \"11076708\"\n    SDK_MANAGER_VER = \"12.0\"\n\n    def __init__(self, tools: ToolCache, root_path: Path):\n        super().__init__(tools=tools)\n        self.dot_android_path = self.tools.home_path / \".android\"\n        self.root_path = root_path\n\n        # A wrapper for testing purposes\n        self.sleep = time.sleep\n\n    @property\n    def cmdline_tools_url(self) -> str:\n        \"\"\"The Android SDK Command-Line Tools URL appropriate for the current machine.\n\n        The SDK largely only supports typical development environments; if a machine is\n        using an unsupported architecture, `sdkmanager` will error while installing the\n        emulator as a dependency of the build-tools. However, for some of the platforms\n        that are unsupported by sdkmanager, users can set up their own SDK install.\n        \"\"\"\n        try:\n            platform_name = {\n                \"Darwin\": {\n                    \"arm64\": \"mac\",\n                    \"x86_64\": \"mac\",\n                },\n                \"Linux\": {\n                    \"x86_64\": \"linux\",\n                },\n                \"Windows\": {\n                    \"AMD64\": \"win\",\n                },\n            }[self.tools.host_os][self.tools.host_arch]\n        except KeyError as e:\n            raise IncompatibleToolError(\n                tool=self.full_name, env_var=\"ANDROID_HOME\"\n            ) from e\n\n        return (\n            f\"https://dl.google.com/android/repository/\"\n            f\"commandlinetools-{platform_name}-{self.SDK_MANAGER_DOWNLOAD_VER}_latest.zip\"\n        )\n\n    @property\n    def cmdline_tools_path(self) -> Path:\n        \"\"\"Version-specific Command-line tools install root directory.\"\"\"\n        return self.root_path / \"cmdline-tools\" / self.SDK_MANAGER_VER\n\n    @property\n    def sdkmanager_filename(self) -> str:\n        return \"sdkmanager.bat\" if self.tools.host_os == \"Windows\" else \"sdkmanager\"\n\n    @property\n    def sdkmanager_path(self) -> Path:\n        return self.cmdline_tools_path / \"bin\" / self.sdkmanager_filename\n\n    @property\n    def adb_path(self) -> Path:\n        adb = \"adb.exe\" if self.tools.host_os == \"Windows\" else \"adb\"\n        return self.root_path / \"platform-tools\" / adb\n\n    @property\n    def avdmanager_path(self) -> Path:\n        avdmanager = (\n            \"avdmanager.bat\" if self.tools.host_os == \"Windows\" else \"avdmanager\"\n        )\n        return self.cmdline_tools_path / \"bin\" / avdmanager\n\n    @property\n    def emulator_path(self) -> Path:\n        emulator = \"emulator.exe\" if self.tools.host_os == \"Windows\" else \"emulator\"\n        return self.root_path / \"emulator\" / emulator\n\n    @property\n    def avd_path(self) -> Path:\n        return self.dot_android_path / \"avd\"\n\n    def avd_config_filename(self, avd: str) -> Path:\n        return self.avd_path / f\"{avd}.avd/config.ini\"\n\n    @property\n    def env(self) -> dict[str, str]:\n        return {\n            \"ANDROID_HOME\": os.fsdecode(self.root_path),\n            \"ANDROID_SDK_ROOT\": os.fsdecode(self.root_path),\n            \"JAVA_HOME\": str(self.tools.java.java_home),\n        }\n\n    @property\n    def emulator_abi(self) -> str:\n        \"\"\"The ABI to use for the Android emulator.\"\"\"\n        try:\n            return {\n                \"Linux\": {\n                    \"x86_64\": \"x86_64\",\n                    \"aarch64\": \"arm64-v8a\",\n                },\n                \"Darwin\": {\n                    \"x86_64\": \"x86_64\",\n                    \"arm64\": \"arm64-v8a\",\n                },\n                \"Windows\": {\n                    \"AMD64\": \"x86_64\",\n                },\n            }[self.tools.host_os][self.tools.host_arch]\n        except KeyError:\n            raise BriefcaseCommandError(\n                \"The Android emulator does not currently support \"\n                f\"{self.tools.host_os} {self.tools.host_arch} hardware.\"\n            )\n\n    @property\n    def DEFAULT_DEVICE_TYPE(self) -> str:\n        return \"pixel\"\n\n    @property\n    def DEFAULT_DEVICE_SKIN(self) -> str:\n        return \"pixel_7_pro\"\n\n    @property\n    def DEFAULT_SYSTEM_IMAGE(self) -> str:\n        return f\"system-images;android-31;default;{self.emulator_abi}\"\n\n    @classmethod\n    def sdk_path_from_env(cls, tools: ToolCache) -> tuple[str | None, str | None]:\n        \"\"\"Determine the file path to an Android SDK from the environment.\n\n        Android has historically supported several env vars to set the location of an\n        Android SDK for build tools. The currently preferred source is ANDROID_HOME;\n        however, ANDROID_SDK_ROOT is also supported as a deprecated setting.\n\n        These values must be same if both set; otherwise, Gradle will error.\n\n        :param tools: ToolCache of available tools\n        :returns: Tuple of path to SDK and the env var name that provided that path\n        \"\"\"\n        android_home = tools.os.environ.get(\"ANDROID_HOME\")\n        android_sdk_root = tools.os.environ.get(\"ANDROID_SDK_ROOT\")\n\n        if android_home:\n            if android_sdk_root and android_sdk_root != android_home:\n                tools.console.warning(\n                    f\"\"\"\n*************************************************************************\n** WARNING: ANDROID_HOME and ANDROID_SDK_ROOT are inconsistent         **\n*************************************************************************\n\n    The ANDROID_HOME and ANDROID_SDK_ROOT environment variables are set\n    to different paths:\n\n        ANDROID_HOME:     {android_home}\n        ANDROID_SDK_ROOT: {android_sdk_root}\n\n    Briefcase will ignore ANDROID_SDK_ROOT and only use the path\n    specified by ANDROID_HOME.\n\n    You should update your environment configuration to either not set\n    ANDROID_SDK_ROOT, or set both environment variables to the same\n    path.\n\n*************************************************************************\n\"\"\"\n                )\n            sdk_root = android_home\n            sdk_source = \"ANDROID_HOME\"\n        elif android_sdk_root:\n            sdk_root = android_sdk_root\n            sdk_source = \"ANDROID_SDK_ROOT\"\n        else:\n            sdk_root = None\n            sdk_source = None\n\n        return sdk_root, sdk_source\n\n    @classmethod\n    def verify_install(\n        cls,\n        tools: ToolCache,\n        install: bool = True,\n        **kwargs,\n    ) -> AndroidSDK:\n        \"\"\"Verify an Android SDK is available.\n\n        The file paths in ANDROID_HOME and ANDROID_SDK_ROOT environment variables will\n        be checked for a valid SDK.\n\n        If those file paths do not contain an SDK, or no file path is provided, an SDK\n        is downloaded.\n\n        :param tools: ToolCache of available tools\n        :param install: Should the tool be installed if it is not found?\n        :returns: A valid Android SDK wrapper. If Android SDK is not available, and was\n            not installed, raises MissingToolError.\n        \"\"\"\n        # short circuit since already verified and available\n        if hasattr(tools, \"android_sdk\"):\n            return tools.android_sdk\n\n        JDK.verify(tools=tools, install=install)\n\n        sdk = None\n\n        # Verify externally-managed Android SDK\n        sdk_root_env, sdk_source_env = cls.sdk_path_from_env(tools=tools)\n        if sdk_root_env:\n            tools.console.debug(\"Evaluating ANDROID_HOME...\", prefix=cls.full_name)\n            tools.console.debug(f\"{sdk_source_env}={sdk_root_env}\")\n            sdk = AndroidSDK(tools=tools, root_path=Path(sdk_root_env))\n\n            if sdk.exists():\n                if sdk_source_env == \"ANDROID_SDK_ROOT\":\n                    tools.console.warning(\n                        \"\"\"\n*************************************************************************\n** WARNING: Using Android SDK from ANDROID_SDK_ROOT                    **\n*************************************************************************\n\n    Briefcase is using the Android SDK specified by the ANDROID_SDK_ROOT\n    environment variable.\n\n    Android has deprecated ANDROID_SDK_ROOT in favor of the\n    ANDROID_HOME environment variable.\n\n    Update your environment configuration to set ANDROID_HOME instead of\n    ANDROID_SDK_ROOT to ensure future compatibility.\n\n*************************************************************************\n\"\"\"\n                    )\n            elif sdk.cmdline_tools_path.parent.exists():\n                # a cmdline-tools directory exists but the required version isn't installed.\n                # try to install the required version using the 'latest' version.\n                if not sdk.install_cmdline_tools():\n                    sdk = None\n                    tools.console.warning(\n                        f\"\"\"\n*************************************************************************\n** WARNING: Incompatible Command-Line Tools Version                    **\n*************************************************************************\n\n    The Android SDK specified by {sdk_source_env} at:\n\n    {sdk_root_env}\n\n    does not contain Command-Line Tools version {cls.SDK_MANAGER_VER}. Briefcase requires\n    this version to be installed to use an external Android SDK.\n\n    Use Android Studio's SDK Manager to install Command-Line Tools {cls.SDK_MANAGER_VER}.\n\n    Briefcase will proceed using its own SDK instance.\n\n*************************************************************************\n\"\"\"\n                    )\n            else:\n                tools.console.warning(\n                    f\"\"\"\n*************************************************************************\n** {f\"WARNING: {sdk_source_env} does not point to an Android SDK\":67} **\n*************************************************************************\n\n    The location pointed to by the {sdk_source_env} environment\n    variable:\n\n    {sdk_root_env}\n\n    doesn't appear to contain an Android SDK with the Command-line Tools installed.\n\n    If {sdk_source_env} is an Android SDK, ensure it is the root directory\n    of the Android SDK instance such that\n\n    ${sdk_source_env}{os.sep}{sdk.sdkmanager_path.relative_to(sdk.root_path)}\n\n    is a valid filepath.\n\n    Briefcase will proceed using its own SDK instance.\n\n*************************************************************************\n\"\"\"\n                )\n                sdk = None\n\n        # Verify Briefcase-managed Android SDK\n        if sdk is None:\n            sdk_root_path = tools.base_path / \"android_sdk\"\n            sdk = AndroidSDK(tools=tools, root_path=sdk_root_path)\n\n            if not sdk.exists():\n                if not install:\n                    raise MissingToolError(\"Android SDK\")\n\n                sdk.delete_legacy_sdk_tools()\n\n                if sdk.cmdline_tools_path.parent.exists():\n                    tools.console.info(\"Upgrading Android SDK...\", prefix=cls.name)\n                else:\n                    tools.console.info(\n                        \"The Android SDK was not found; downloading and installing...\",\n                        prefix=cls.name,\n                    )\n                    tools.console.info(\n                        \"To use an existing Android SDK instance, specify its root \"\n                        \"directory path in the ANDROID_HOME environment variable.\"\n                    )\n                    tools.console.info()\n                sdk.install()\n\n        # Licences must be accepted to use the SDK\n        sdk.verify_license()\n\n        tools.console.debug(f\"Using Android SDK at {sdk.root_path}\")\n        tools.android_sdk = sdk\n        return sdk\n\n    def exists(self) -> bool:\n        \"\"\"Confirm that the SDK actually exists.\n\n        Look for the sdkmanager; and, if necessary, confirm that it is executable.\n        \"\"\"\n        return self.sdkmanager_path.is_file() and (\n            self.tools.host_os == \"Windows\"\n            or self.tools.os.access(self.sdkmanager_path, self.tools.os.X_OK)\n        )\n\n    @property\n    def managed_install(self) -> bool:\n        \"\"\"Is the Android SDK install managed by Briefcase?\"\"\"\n        # Although the end-user can provide their own SDK, the SDK also\n        # provides a built-in upgrade mechanism. Therefore, all Android SDKs\n        # are managed installs.\n        return True\n\n    def uninstall(self):\n        \"\"\"The Android SDK is upgraded in-place instead of being reinstalled.\"\"\"\n\n    def install(self):\n        \"\"\"Download and install the Android SDK.\"\"\"\n        cmdline_tools_zip_path = self.tools.file.download(\n            url=self.cmdline_tools_url,\n            download_path=self.tools.base_path,\n            role=\"Android SDK Command-Line Tools\",\n        )\n\n        # The cmdline-tools package *must* be installed as:\n        #     <sdk_path>/cmdline-tools/<cmdline-tools version>\n        #\n        # However, the zip file unpacks a top-level folder named `cmdline-tools`.\n        # So, the unpacking process is:\n        #\n        #  1. Make a <sdk_path>/cmdline-tools folder\n        #  2. Unpack the zip file into that folder, creating <sdk_path>/cmdline-tools/cmdline-tools\n        #  3. Move <sdk_path>/cmdline-tools/cmdline-tools to <sdk_path>/cmdline-tools/<cmdline-tools version>\n\n        with self.tools.console.wait_bar(\n            f\"Installing Android SDK Command-Line Tools {self.SDK_MANAGER_VER}...\"\n        ):\n            self.cmdline_tools_path.parent.mkdir(parents=True, exist_ok=True)\n            try:\n                self.tools.file.unpack_archive(\n                    cmdline_tools_zip_path, extract_dir=self.cmdline_tools_path.parent\n                )\n            except (shutil.ReadError, EOFError) as e:\n                raise BriefcaseCommandError(\n                    f\"\"\"\\\nUnable to unpack Android SDK Command-Line Tools ZIP file. The download may have been interrupted\nor corrupted.\n\nDelete {cmdline_tools_zip_path} and run briefcase again.\n\"\"\"\n                ) from e\n\n            # If there's an existing version of the cmdline tools, delete them.\n            if self.cmdline_tools_path.exists():\n                self.tools.shutil.rmtree(self.cmdline_tools_path)\n\n            # Rename the top level zip content to the final name\n            (self.cmdline_tools_path.parent / \"cmdline-tools\").rename(\n                self.cmdline_tools_path\n            )\n\n            # Zip file no longer needed once unpacked.\n            cmdline_tools_zip_path.unlink()\n\n            # Python zip unpacking ignores permission metadata.\n            # On non-Windows, we manually fix permissions.\n            if (  # pragma: no branch\n                self.tools.host_os != \"Windows\"\n            ):  # pragma: no-cover-if-is-windows\n                for binpath in (self.cmdline_tools_path / \"bin\").glob(\"*\"):\n                    if not self.tools.os.access(binpath, self.tools.os.X_OK):\n                        binpath.chmod(0o755)\n\n        with self.tools.console.wait_bar(\"Removing older Android SDK packages...\"):\n            self.cleanup_old_installs()\n\n    def upgrade(self):\n        \"\"\"Upgrade the Android SDK.\"\"\"\n        try:\n            # Using subprocess.run() with no I/O redirection so the user sees\n            # the full output and can send input.\n            self.tools.subprocess.run(\n                [self.sdkmanager_path, \"--update\"],\n                env=self.env,\n                check=True,\n                stream_output=False,\n            )\n        except subprocess.CalledProcessError as e:\n            raise BriefcaseCommandError(\n                f\"\"\"\\\nError while updating the Android SDK manager. Please run this command and examine\nits output for errors.\n\n    $ {self.sdkmanager_path} --update\n\"\"\"\n            ) from e\n\n    def install_cmdline_tools(self) -> bool:\n        \"\"\"Attempt to use 'latest' cmdline-tools to install the currently required\n        version of the Command-Line Tools.\n\n        The Briefcase-managed SDK should always have the required version of cmdline-\n        tools installed; however, user-provided SDKs may not have it.\n\n        :returns: True if successfully installed; False otherwise\n        \"\"\"\n        self.tools.console.info(\n            f\"Installing Android Command-Line Tools {self.SDK_MANAGER_VER}...\",\n            prefix=self.full_name,\n        )\n        self.tools.console.info(f\"Using Android SDK at {self.root_path}\")\n        latest_sdkmanager_path = (\n            self.root_path\n            / \"cmdline-tools\"\n            / \"latest\"\n            / \"bin\"\n            / self.sdkmanager_filename\n        )\n        try:\n            self.tools.subprocess.run(\n                [\n                    latest_sdkmanager_path,\n                    f\"cmdline-tools;{self.SDK_MANAGER_VER}\",\n                ],\n                check=True,\n                stream_output=False,\n            )\n        except (OSError, subprocess.CalledProcessError) as e:\n            self.tools.console.debug(str(e))\n            self.tools.console.warning(\n                f\"Failed to install cmdline-tools;{self.SDK_MANAGER_VER}\"\n            )\n            return False\n        return True\n\n    def delete_legacy_sdk_tools(self):\n        \"\"\"Delete any legacy Android SDK tools that are installed.\n\n        If no versions of the Command-Line Tools are installed but the 'tools' directory\n        exists, the legacy SDK Tools are probably installed. Since they have been\n        deprecated by more recent releases of SDK Manager, delete them and perform a\n        fresh install.\n\n        The Android SDK Tools were deprecated in Sept 2017.\n        \"\"\"\n        if (\n            not self.cmdline_tools_path.parent.exists()\n            and (self.root_path / \"tools\").exists()\n        ):\n            self.tools.console.warning(\n                f\"\"\"\n*************************************************************************\n** WARNING: Upgrading Android SDK tools                                **\n*************************************************************************\n\n    Briefcase needs to replace the older Android SDK Tools with the\n    newer Android SDK Command-Line Tools. This will involve some large\n    downloads, as well as re-accepting the licenses for the Android\n    SDKs.\n\n    Any emulators created with the older Android SDK Tools will not be\n    compatible with the new tools. You will need to create new\n    emulators. Old emulators can be removed by deleting the files\n    in {self.avd_path} matching the emulator name.\n\n*************************************************************************\n\"\"\"\n            )\n            self.tools.shutil.rmtree(self.root_path)\n\n    def cleanup_old_installs(self):\n        \"\"\"Remove old versions of Android SDK packages and version markers.\n\n        When the Android SDK is upgraded, old versions of packages should be removed to\n        keep the SDK tidy. This is namely the Command-line Tools that are used to manage\n        the SDK and AVDs. Additionally, previous version of Briefcase created a version\n        marker file that needs to be deleted.\n        \"\"\"\n        if (ver_file := self.cmdline_tools_path.parent / \"8092744\").is_file():\n            self.tools.os.unlink(ver_file)\n        if (latest := self.cmdline_tools_path.parent / \"latest\").is_dir():\n            self.tools.shutil.rmtree(latest)\n\n    def list_packages(self):\n        \"\"\"In debug output, list the packages currently managed by the SDK.\"\"\"\n        try:\n            # check_output always writes its output to debug\n            self.tools.subprocess.check_output(\n                [self.sdkmanager_path, \"--list_installed\"],\n                env=self.env,\n            )\n        except subprocess.CalledProcessError as e:\n            raise BriefcaseCommandError(\n                \"Unable to invoke the Android SDK manager\"\n            ) from e\n\n    def adb(self, device: str) -> ADB:\n        \"\"\"Obtain an ADB instance for managing a specific device.\n\n        :param device: The device ID to manage.\n        \"\"\"\n        return ADB(tools=self.tools, device=device)\n\n    def verify_license(self):\n        \"\"\"Verify that all necessary licenses have been accepted.\n\n        If they haven't, prompt the user to do so.\n\n        Raises an error if licenses are not.\n        \"\"\"\n        license_path = self.root_path / \"licenses/android-sdk-license\"\n        if license_path.exists():\n            return\n\n        self.tools.console.info(\n            \"\"\"\nThe Android tools provided by Google have license terms that you must accept\nbefore you may use those tools.\n\"\"\"\n        )\n        try:\n            # Using subprocess.run() with no I/O redirection so the user sees\n            # the full output and can send input.\n            self.tools.subprocess.run(\n                [self.sdkmanager_path, \"--licenses\"],\n                env=self.env,\n                check=True,\n                stream_output=False,\n            )\n        except (subprocess.CalledProcessError, OSError) as e:\n            raise BriefcaseCommandError(\n                f\"\"\"\\\nError while reviewing Android SDK licenses. Please run this command and examine\nits output for errors.\n\n    $ {self.sdkmanager_path} --licenses\n\"\"\"\n            ) from e\n\n        if not license_path.exists():\n            raise BriefcaseCommandError(\n                \"\"\"\\\nYou did not accept the Android SDK licenses. Please re-run the briefcase command\nand accept the Android SDK license when prompted. You may need an Internet\nconnection.\n\"\"\"\n            )\n\n    def verify_emulator(self):\n        \"\"\"Verify that Android emulator has been installed, and is in a runnable state.\n\n        Raises an error if the emulator can't be installed.\n        \"\"\"\n        # Ensure the `platforms` folder exists.\n        # See the discussion on #766 for details; as of June 2022, if this folder\n        # doesn't exist, the emulator won't start, raising the error:\n        #\n        #    PANIC: Cannot find AVD system path. Please define ANDROID_SDK_ROOT\n        #\n        # Creating an empty platforms folder is enough to overcome this. This folder\n        # will be created automatically when you build a project; but if you have a\n        # clean Android SDK install that hasn't been used to build a project, it\n        # might be missing.\n        (self.root_path / \"platforms\").mkdir(exist_ok=True)\n\n        if self.emulator_path.exists():\n            self.tools.console.debug(\"Android emulator is already installed.\")\n            return\n\n        self.tools.console.info(\"Downloading the Android emulator...\")\n        try:\n            self.tools.subprocess.run(\n                [self.sdkmanager_path, \"platform-tools\", \"emulator\"],\n                env=self.env,\n                check=True,\n                stream_output=False,\n            )\n        except subprocess.CalledProcessError as e:\n            raise BriefcaseCommandError(\n                \"Error while installing Android emulator.\"\n            ) from e\n\n    def verify_avd(self, avd: str):\n        \"\"\"Verify that the AVD has the necessary system components to launch.\n\n        This includes:\n            * AVD system image\n            * Emulator skin\n\n        :param avd: The AVD name to verify.\n        \"\"\"\n        # Read the AVD configuration to retrieve the system image.\n        # This is stored in the AVD configuration file with the key:\n        #   image.sysdir.1=system-images/android-31/default/arm64-v8a/\n        avd_config = self.avd_config(avd)\n\n        try:\n            system_image_path = Path(avd_config[\"image.sysdir.1\"])\n\n            # Convert the path into a system image name, and verify it.\n            self.verify_system_image(\";\".join(system_image_path.parts))\n        except KeyError:\n            self.tools.console.warning(\n                f\"\"\"\n*************************************************************************\n** WARNING: Unable to determine AVD system image                       **\n*************************************************************************\n\n    Briefcase was unable to determine the system image of the Android\n    emulator AVD {avd!r} from it's configuration file.\n\n    Briefcase will proceed assuming the emulator is correctly\n    configured. If you experience any problems running the emulator,\n    this may be the cause of the problem.\n\n*************************************************************************\n\"\"\"\n            )\n\n        try:\n            skin = avd_config[\"skin.name\"]\n            skin_path = Path(avd_config[\"skin.path\"])\n            if skin_path == Path(\"_no_skin\"):\n                self.tools.console.debug(\"Emulator does not use a skin.\")\n            elif skin_path != Path(\"skins\") / skin:\n                self.tools.console.warning(\n                    f\"\"\"\n*************************************************************************\n** WARNING: Unrecognized device skin                                   **\n*************************************************************************\n\n    Briefcase does not recognize the skin {skin!r} used by the\n    Android emulator AVD {avd!r}.\n\n    Briefcase will proceed assuming the emulator is correctly\n    configured. If you experience any problems running the emulator,\n    this may be the cause of the problem.\n\n*************************************************************************\n\"\"\"\n                )\n            else:\n                # Convert the path into a system image name, and verify it.\n                self.verify_emulator_skin(skin)\n\n        except KeyError:\n            self.tools.console.debug(f\"Device {avd!r} doesn't define a skin.\")\n\n    def verify_system_image(self, system_image: str):\n        \"\"\"Verify that the required system image is installed.\n\n        :param system_image: The SDKManager identifier for the system image (e.g.,\n            ``\"system-images;android-31;default;x86_64\"``)\n        \"\"\"\n        # Look for the directory named as a system image.\n        # If it exists, we already have the system image.\n        system_image_parts = system_image.split(\";\")\n\n        if len(system_image_parts) < 4 or system_image_parts[0] != \"system-images\":\n            raise BriefcaseCommandError(\n                f\"{system_image!r} is not a valid system image name.\"\n            )\n\n        if system_image_parts[-1] != self.emulator_abi:\n            self.tools.console.warning(\n                f\"\"\"\n*************************************************************************\n** WARNING: Unexpected emulator ABI                                    **\n*************************************************************************\n\n    The system image {system_image!r}\n    does not match the architecture of this computer ({self.emulator_abi}).\n\n    Briefcase will proceed assuming the emulator is correctly\n    configured. If you experience any problems running the emulator,\n    this may be the cause of the problem.\n\n*************************************************************************\n\"\"\"\n            )\n\n        # Convert the system image into a path where that system image\n        # would be expected, and see if the location exists.\n        system_image_path = self.root_path\n        for part in system_image_parts:\n            system_image_path = system_image_path / part\n\n        if system_image_path.exists():\n            # Found the system image.\n            return\n\n        # System image not found; download it.\n        self.tools.console.info(\n            f\"Downloading the {system_image!r} Android system image...\",\n            prefix=self.name,\n        )\n        try:\n            self.tools.subprocess.run(\n                [self.sdkmanager_path, system_image],\n                env=self.env,\n                check=True,\n                stream_output=False,\n            )\n        except subprocess.CalledProcessError as e:\n            raise BriefcaseCommandError(\n                f\"Error while installing the {system_image!r} Android system image.\"\n            ) from e\n\n    def verify_emulator_skin(self, skin: str):\n        \"\"\"Verify that an emulator skin is available.\n\n        A human-readable list of available skins can be found here:\n\n            https://android.googlesource.com/platform/tools/adt/idea/+/refs/heads/mirror-goog-studio-main/artwork/resources/device-art-resources/\n\n        :param skin: The name of the skin to obtain\n        \"\"\"\n        # Check for a device skin. If it doesn't exist, download it.\n        skin_path = self.root_path / \"skins\" / skin\n        if skin_path.exists():\n            self.tools.console.debug(f\"Device skin {skin!r} already exists.\")\n            return\n\n        self.tools.console.info(f\"Obtaining {skin} device skin...\", prefix=self.name)\n\n        skin_url = (\n            \"https://android.googlesource.com/platform/tools/adt/idea/\"\n            \"+archive/refs/heads/mirror-goog-studio-main/\"\n            f\"artwork/resources/device-art-resources/{skin}.tar.gz\"\n        )\n\n        skin_tgz_path = self.tools.file.download(\n            url=skin_url,\n            download_path=self.root_path,\n            role=f\"{skin} device skin\",\n        )\n\n        # Unpack skin archive\n        with self.tools.console.wait_bar(\"Installing device skin...\"):\n            try:\n                self.tools.file.unpack_archive(\n                    skin_tgz_path,\n                    extract_dir=skin_path,\n                )\n            except (shutil.ReadError, EOFError) as e:\n                raise BriefcaseCommandError(\n                    f\"Unable to unpack {skin} device skin.\"\n                ) from e\n\n            # Delete the downloaded file.\n            skin_tgz_path.unlink()\n\n    def emulators(self) -> list[str]:\n        \"\"\"Find the list of emulators that are available.\"\"\"\n        try:\n            emulators = self.tools.subprocess.check_output(\n                [self.emulator_path, \"-list-avds\"]\n            ).strip()\n        except subprocess.CalledProcessError as e:\n            raise BriefcaseCommandError(\"Unable to obtain Android emulator list\") from e\n        else:\n            return [\n                emu\n                for emu in emulators.split(\"\\n\")\n                # ignore any logging output included in output list\n                if emu and not emu.startswith((\"INFO    |\", \"WARNING |\", \"ERROR   |\"))\n            ]\n\n    def devices(self) -> dict[str, dict[str, str | bool]]:\n        \"\"\"Find the devices that are attached and available to ADB.\"\"\"\n        try:\n            output = self.tools.subprocess.check_output(\n                [self.adb_path, \"devices\", \"-l\"]\n            ).strip()\n            # Process the output of `adb devices -l`.\n            # The first line is header information.\n            # Each subsequent line is a single device descriptor.\n            devices = {}\n            header_found = False\n            for line in output.split(\"\\n\"):\n                if line == \"List of devices attached\":\n                    header_found = True\n                elif header_found and line:\n                    parts = re.sub(r\"\\s+\", \" \", line).split(\" \")\n\n                    details = {}\n                    for part in parts[2:]:\n                        try:\n                            key, value = part.split(\":\")\n                            details[key] = value\n                        except ValueError:\n                            # Ignore any entry that isn't in \"key:value\" format.\n                            pass\n\n                    if parts[1] == \"device\":\n                        try:\n                            name = details[\"model\"].replace(\"_\", \" \")\n                        except KeyError:\n                            name = \"Unknown device (no model name)\"\n                        authorized = True\n                    elif parts[1] == \"offline\":\n                        name = \"Unknown device (offline)\"\n                        authorized = False\n                    else:\n                        name = f\"Device not available for development ({' '.join(parts[1:])})\"\n                        authorized = False\n\n                    devices[parts[0]] = {\n                        \"name\": name,\n                        \"authorized\": authorized,\n                    }\n\n            return devices\n        except subprocess.CalledProcessError as e:\n            raise BriefcaseCommandError(\"Unable to obtain Android device list\") from e\n\n    def select_target_device(\n        self,\n        device_or_avd: str | None,\n    ) -> tuple[str | None, str | None, str | None]:\n        \"\"\"Select a device to be the target for actions.\n\n        Interrogates the system to get the list of available devices.\n\n        If the user has specified a device at the command line, that device will\n        be validated, and then automatically selected.\n\n        :param device_or_avd: The device or AVD to target. Can be a physical\n            device id (a hex string), an emulator id (``emulator-5554``), or an\n            emulator AVD name (``@robotfriend``), or a JSON payload describing\n            the properties of an emulator that will be created (e.g.,\n            ``'{\"avd\":\"beePhone\",\"device_type\":\"pixel\",\"skin\":\"pixel_3a\",\"system_image\":\"system-images;android-31;default;arm64-v8a\"}'``)\n            If ``None``, the user will be asked to select a device from the list\n            available.\n        :returns: A tuple containing ``(device, name, avd)``. ``avd`` will only\n            be provided if an emulator with that AVD is not currently running.\n            If ``device`` is None, a new emulator should be created.\n        \"\"\"\n        # If the device_or_avd starts with \"{\", it's a definition for a new\n        # emulator to be created.\n        if device_or_avd and device_or_avd.startswith(\"{\"):\n            try:\n                emulator_config = json.loads(device_or_avd)\n                emulators = set(self.emulators())\n\n                # If an emulator with this AVD already exists, use it\n                avd = emulator_config[\"avd\"]\n                if avd not in emulators:\n                    self._create_emulator(**emulator_config)\n\n                return None, f\"@{avd} (emulator)\", avd\n            except json.JSONDecodeError as e:\n                raise BriefcaseCommandError(\n                    f\"Unable to create emulator with definition {device_or_avd!r}\"\n                ) from e\n            except KeyError:\n                raise BriefcaseCommandError(\"No AVD provided for new device.\")\n            except TypeError as e:\n                property = str(e).split(\" \")[-1]\n                raise BriefcaseCommandError(f\"Unknown device property {property}.\")\n\n        # Get the list of attached devices (includes running emulators)\n        running_devices = self.devices()\n\n        # Choices is an ordered list of options that can be shown to the user.\n        # Each device should appear only once, and be keyed by AVD only if\n        # a device ID isn't available.\n        choices = {}\n        # A full index of available devices. Devices can be looked up by any valid key -\n        # ID *or* AVD.\n        device_index = {}\n\n        # Iterate over all the running devices.\n        # If the device is a virtual device, use ADB to get the emulator AVD name.\n        # If it is a physical device, use the device name.\n        # Keep a log of all running AVDs\n        running_avds = {}\n        for d, details in sorted(running_devices.items(), key=lambda d: d[1][\"name\"]):\n            name = details[\"name\"]\n            avd = self.adb(d).avd_name()\n            if avd:\n                # It's a running emulator\n                running_avds[avd] = d\n                full_name = f\"@{avd} (running emulator)\"\n                choices[d] = full_name\n\n                # Save the AVD as a device detail.\n                details[\"avd\"] = avd\n\n                # Device can be looked up by device ID or AVD\n                device_index[d] = full_name\n                device_index[f\"@{avd}\"] = full_name\n            else:\n                # It's a physical device (might be disabled)\n                full_name = f\"{name} ({d})\"\n                choices[d] = full_name\n                device_index[d] = full_name\n\n        # Add any non-running emulator AVDs to the list of candidate devices\n        for avd in self.emulators():\n            if avd not in running_avds:\n                name = f\"@{avd} (emulator)\"\n                choices[f\"@{avd}\"] = name\n                device_index[f\"@{avd}\"] = name\n\n        # If a device or AVD has been provided, check it against the available\n        # device list.\n        if device_or_avd:\n            try:\n                name = device_index[device_or_avd]\n\n                if device_or_avd.startswith(\"@\"):\n                    # specifier is an AVD\n                    avd = device_or_avd[1:]\n                    try:\n                        device = running_avds[avd]\n                    except KeyError:\n                        # device_or_avd isn't in the list of running avds;\n                        # it must be a non-running emulator.\n                        return None, name, avd\n                else:\n                    # Specifier is a direct device ID\n                    device = device_or_avd\n\n                details = running_devices[device]\n                avd = details.get(\"avd\")\n                if details[\"authorized\"]:\n                    # An authorized, running device (emulator or physical)\n                    return device, name, avd\n                else:\n                    # An unauthorized physical device\n                    raise AndroidDeviceNotAuthorized(device)\n\n            except KeyError as e:\n                # Provided device_or_id isn't a valid device identifier.\n                id_type = (\n                    \"emulator AVD\" if device_or_avd.startswith(\"@\") else \"device ID\"\n                )\n                raise InvalidDeviceError(id_type, device_or_avd) from e\n        # We weren't given a device/AVD; we have to select from the list.\n        # If we're selecting from a list, there's always one last choice\n        choices[\"-\"] = \"Create a new Android emulator\"\n\n        # Show the choices to the user.\n        try:\n            choice = self.tools.console.selection_question(\n                intro=\"Select Android device to use:\",\n                description=\"Android device\",\n                options=choices,\n            )\n        except InputDisabled as e:\n            # If input is disabled, and there's only one actual simulator,\n            # select it. If there are no simulators, select \"Create simulator\"\n            if len(choices) <= 2:\n                choice = next(iter(choices))\n            else:\n                raise BriefcaseCommandError(\n                    \"\"\"\\\nInput has been disabled; can't select a device to target.\nUse the -d/--device option to explicitly specify the device to use.\n\"\"\"\n                ) from e\n\n        # Process the user's choice\n        if choice == \"-\":\n            # Create a new emulator. No device ID or AVD.\n            device = None\n            avd = None\n            name = None\n        elif choice.startswith(\"@\"):\n            # A non-running emulator. We have an AVD, but no device ID.\n            device = None\n            name = device_index[choice]\n            avd = choice[1:]\n        else:\n            # Either a running emulator, or a physical device. Regardless,\n            # we need to check if the device is developer enabled.\n            # Functionally, we know the device *must* be in the list of\n            # choices; which means it's also in the list of running devices\n            # and the list of device choices, so any KeyError on those lookups\n            # indicates a deeper problem.\n            details = running_devices[choice]\n            if not details[\"authorized\"]:\n                # An unauthorized physical device\n                raise AndroidDeviceNotAuthorized(choice)\n\n            # Return the device ID and name.\n            device = choice\n            name = device_index[choice]\n            avd = details.get(\"avd\")\n\n        if avd:\n            self.tools.console.info(\n                f\"\"\"\nIn future, you can specify this device by running:\n\n    $ briefcase run android -d \"@{avd}\"\n\"\"\"\n            )\n        elif device:\n            self.tools.console.info(\n                f\"\"\"\nIn future, you can specify this device by running:\n\n    $ briefcase run android -d {device}\n\"\"\"\n            )\n\n        return device, name, avd\n\n    def create_emulator(self) -> str:\n        \"\"\"Create a new Android emulator.\n\n        :returns: The