\n    28→    TimeRemainingColumn,\n    29→)\n    30→from rich.traceback import Trace, Traceback\n    31→\n    32→from briefcase import __version__\n    33→from briefcase.exceptions import InputDisabled\n    34→\n    35→# Max width for printing to console; matches argparse's default width\n    36→MAX_TEXT_WIDTH = max(min(shutil.get_terminal_size().columns, 80) - 2, 20)\n    37→\n    38→# Regex to identify settings likely to contain sensitive information\n    39→SENSITIVE_SETTING_RE = re.compile(r\"API|TOKEN|KEY|SECRET|PASS|SIGNATURE\", flags=re.I)\n    40→\n    41→# 7-bit C1 ANSI escape sequences\n    42→ANSI_ESC_SEQ_RE_DEF = r\"\\x1B(?:[@-Z\\\\-_]|\\[[0-?]*[ -/]*[@-~])\"\n    43→ANSI_ESCAPE_RE = re.compile(ANSI_ESC_SEQ_RE_DEF)\n    44→\n    45→\n    46→def sanitize_text(text: str) -> str:\n    47→    \"\"\"Remove control codes and ANSI escape sequences from a line of text.\n    48→\n    49→    This is useful for extracting the plain text from the output of third party tools\n    50→    that may be including markup for display in the console.\n    51→    \"\"\"\n    52→    return ANSI_ESCAPE_RE.sub(\"\", strip_control_codes(text))\n    53→\n    54→\n    55→class RichConsoleHighlighter(RegexHighlighter):\n    56→    \"\"\"Custom Rich highlighter for printing to the console.\n    57→\n    58→    This highlighter limits text highlighting to only URLs.\n    59→\n    60→    By default, Rich applies several highlighting rules to anything it prints for\n    61→    concepts like UUIDs, markup, IP addresses, numbers, etc. All these colorful\n    62→    additions to the text can become overbearing and distracting given much of the\n    63→    output does not benefit from coloring.\n    64→\n    65→    This defines a visually simpler style that highlights URLs in a way that is vaguely\n    66→    consistent with a default HTML stylesheet, but otherwise renders content as-is.\n    67→    \"\"\"\n    68→\n    69→    base_style = \"repr.\"\n    70→    highlights = [\n    71→        r\"(?P<url>(file|https|http|ws|wss)://[-0-9a-zA-Z$_+!`(),.?/;:&=%#~]*)\"\n    72→    ]\n    73→\n    74→\n    75→class RichLoggingStream:\n    76→    \"\"\"Stream for logging.StreamHandler that prints to console via debug logging.\"\"\"\n    77→\n    78→    def __init__(self, console: Console):\n    79→        self.console = console\n    80→\n    81→    def write(self, msg: str) -> None:\n    82→        self.console.debug(msg)\n    83→\n    84→\n    85→class RichLoggingHandler(logging.StreamHandler):\n    86→    \"\"\"A debug handler for third party tools using stdlib logging.\"\"\"\n    87→\n    88→    def __init__(self, stream: RichLoggingStream):\n    89→        super().__init__(stream=stream)\n    90→        self.setLevel(logging.DEBUG)\n    91→        self.setFormatter(logging.Formatter(\"%(levelname)s %(name)s: %(message)s\"))\n    92→\n    93→\n    94→class LogLevel(IntEnum):\n    95→    INFO = 0\n    96→    VERBOSE = 1\n    97→    DEBUG = 2\n    98→    DEEP_DEBUG = 3\n    99→\n   100→\n   101→class NotDeadYet:\n   102→    # I’m getting better! No you’re not, you’ll be stone dead in a minute.\n   103→\n   104→    def __init__(self, console: Console):\n   105→        \"\"\"A keep-alive spinner for long-running processes without console output.\n   106→\n   107→        Returned by the Wait Bar's context manager but can be used independently. Use in\n   108→        a loop that calls update() each iteration. A keep-alive message will be printed\n   109→        every 10 seconds.\n   110→        \"\"\"\n   111→        self.console = console\n   112→        self.interval_sec: int = 10\n   113→        self.message: str = \"... still waiting\"\n   114→        self.ready_time: float = 0.0\n   115→\n   116→        self.reset()  # initialize\n   117→\n   118→    def update(self):\n   119→        \"\"\"Write keep-alive message if the periodic interval has elapsed.\"\"\"\n   120→        if self.ready_time < time.time():\n   121→            self.console.print(self.message)\n   122→            self.reset()\n   123→\n   124→    def reset(self):\n   125→        \"\"\"Initialize periodic interval to now; next message prints after interval.\"\"\"\n   126→        self.ready_time = time.time() + self.interval_sec\n   127→\n   128→\n   129→class Console:\n   130→    # subdirectory of command.base_path to store log files\n   131→    LOG_DIR = \"logs\"\n   132→\n   133→    def __init__(\n   134→        self,\n   135→        input_enabled: bool = True,\n   136→        verbosity: LogLevel = LogLevel.INFO,\n   137→        log_width: int = 180,\n   138→    ):\n   139→        \"\"\"Interface for printing and managing output to the console and/or log.\n   140→\n   141→        :param input_enabled: Is the console current enabled for input?\n   142→        :param verbosity: Controls how much output is displayed to the user.\n   143→        :param log_width: The width at which content should be wrapped in the log file.\n   144→            The default width is wide enough to render the output of ``sdkmanager\n   145→            --list_installed`` in the log file without line wrapping.\n   146→        \"\"\"\n   147→        self.log_width = log_width\n   148→\n   149→        # A wrapper around the console\n   150→        self._console_impl = RichConsole(\n   151→            highlighter=RichConsoleHighlighter(),\n   152→            emoji=False,\n   153→            soft_wrap=True,\n   154→        )\n   155→\n   156→        # Rich only records what's being logged if it is actually written somewhere;\n   157→        # writing to /dev/null allows Rich to do so without needing to print the\n   158→        # logs in the console or save them to file before it is known a file is wanted.\n   159→        self._dev_null = open(os.devnull, \"w\", encoding=\"utf-8\", errors=\"ignore\")\n   160→        self._log_impl = RichConsole(\n   161→            file=self._dev_null,\n   162→            record=True,\n   163→            width=self.log_width,\n   164→            force_interactive=False,\n   165→            force_terminal=False,\n   166→            no_color=True,\n   167→            color_system=None,\n   168→            markup=False,\n   169→            emoji=False,\n   170→            highlight=False,\n   171→            soft_wrap=True,\n   172→        )\n   173→\n   174→        ##################################################################\n   175→        # Logging properties\n   176→        ##################################################################\n   177→\n   178→        # --verbosity flag: see LogLevel for valid values\n   179→        self.verbosity = verbosity\n   180→        # --log flag to force logfile creation\n   181→        self.save_log = False\n   182→        # flag set by exceptions to skip writing the log; save_log takes precedence.\n   183→        self.skip_log = False\n   184→        # Rich stacktraces of exceptions for logging to file.\n   185→        # A list of tuples containing a label for the thread context, and the Trace object\n   186→        self.stacktraces: list[tuple[str, Trace]] = []\n   187→        # functions to run for additional logging if creating a logfile\n   188→        self.log_file_extras: list[Callable[[], object]] = []\n   189→        # The current context for the log\n   190→        self._context = \"\"\n   191→\n   192→        ##################################################################\n   193→        # Console management properties\n   194→        ##################################################################\n   195→        self.input_enabled = input_enabled\n   196→\n   197→        self._wait_bar: Progress | None = None\n   198→        # Signal that Rich is dynamically controlling the console output. Therefore,\n   199→        # all output must be printed to the screen by Rich to prevent corruption of\n   200→        # dynamic elements like the Wait Bar.\n   201→        self.is_console_controlled = False\n   202→\n   203→    def __del__(self):\n   204→        self._dev_null.close()\n   205→\n   206→    #################################################################\n   207→    # Console primitives\n   208→    #################################################################\n   209→\n   210→    def print(self, *messages, stack_offset=5, show=True, **kwargs):\n   211→        \"\"\"Entry point for all printing to the console and the log.\n   212→\n   213→        The log records all content that is printed whether it is shown in the console\n   214→        or not (e.g. debug output). When execution completes, the log is conditionally\n   215→        exported and saved to a file.\n   216→\n   217→        :param messages: content to print and/or log\n   218→        :param show: True (default) to print and log messages; False to only log.\n   219→        :param stack_offset: number of levels up the stack where logging was invoked.\n   220→            This tells Rich the number of levels to recurse up the stack to find the\n   221→            filename to put in the right column of the Rich log. Defaults to 5 since\n   222→            most uses are 5 levels deep from the actual logging.\n   223→        \"\"\"\n   224→        if show:\n   225→            self.to_console(*messages, **kwargs)\n   226→        self.to_log(*messages, stack_offset=stack_offset, **kwargs)\n   227→\n   228→    def to_console(self, *messages, **kwargs):\n   229→        \"\"\"Write only to the console and skip writing to the log.\"\"\"\n   230→        self._console_impl.print(*messages, **kwargs)\n   231→\n   232→    def to_log(self, *messages, stack_offset=5, **kwargs):\n   233→        \"\"\"Write only to the log and skip writing to the console.\"\"\"\n   234→        self._log_impl.log(\n   235→            *map(sanitize_text, messages), _stack_offset=stack_offset, **kwargs\n   236→        )\n   237→\n   238→    def export_log(self):\n   239→        \"\"\"Export the text of the entire log; the log is also cleared.\"\"\"\n   240→        return self._log_impl.export_text()\n   241→\n   242→    #################################################################\n   243→    # Logging controls\n   244→    #################################################################\n   245→    @contextmanager\n   246→    def context(self, context: str):\n   247→        \"\"\"Wrap a collection of output in a logging context.\n   248→\n   249→        A logging context is a prefix on every logging line. It is used when a set of\n   250→        commands (and output) is being run in a very specific way that needs to be\n   251→        highlighted, such as running a command in a Docker container.\n   252→\n   253→        :param context: The name of the context to enter. This *must* be simple text,\n   254→            with no markup or other special characters.\n   255→        \"\"\"\n   256→        self.info()\n   257→        self.info(f\"Entering {context} context...\")\n   258→        old_context = self._context\n   259→        self._context = f\"{context}| \"\n   260→        self.info(\"-\" * (72 - len(context)))\n   261→        try:\n   262→            yield\n   263→        finally:\n   264→            self.info(\"-\" * (72 - len(context)))\n   265→            self._context = old_context\n   266→            self.info(f\"Leaving {context} context.\")\n   267→            self.info()\n   268→\n   269→    def _log(\n   270→        self,\n   271→        preface=\"\",\n   272→        prefix=\"\",\n   273→        message=\"\",\n   274→        show=True,\n   275→        markup=False,\n   276→        style=None,\n   277→    ):\n   278→        \"\"\"Funnel to log all messages.\n   279→\n   280→        :param preface: value to be printed on the far left of the message and symbolic\n   281→            of the type of message being printed.\n   282→        :param prefix: text prepended to the message wrapped in brackets and will be\n   283→            presented as dimmer compared to the styling of the message text.\n   284→        :param message: text to log; can contain Rich tags if markup=True.\n   285→        :param show: True to print message to console; False to not print it. This is to\n   286→            allow logs to be saved to a file without printing them.\n   287→        :param markup: whether to interpret Rich markup in the prefix, preface, and\n   288→            message; if True, all text must already be escaped; defaults False.\n   289→        :param style: Rich style to apply to everything printed for message.\n   290→        \"\"\"\n   291→        if not message:\n   292→            # When a message is not provided, only output the context;\n   293→            # This type of call is just clearing some vertical space.\n   294→            self.print(self._context, show=show)\n   295→        else:\n   296→            if prefix:\n   297→                # insert vertical space before for all messages with a prefix\n   298→                self.print(self._context, show=show)\n   299→                if not markup:\n   300→                    preface, prefix, message = (\n   301→                        escape(text) for text in (preface, prefix, message)\n   302→                    )\n   303→                prefix = f\"[dim]\\\\[{prefix}][/dim] \"\n   304→                markup = True\n   305→            for line in message.splitlines():\n   306→                self.print(\n   307→                    f\"{self._context}{preface}{prefix}{line}\",\n   308→                    show=show,\n   309→                    markup=markup,\n   310→                    style=style,\n   311→                )\n   312→\n   313→    def debug(self, message=\"\", *, preface=\"\", prefix=\"\", markup=False):\n   314→        \"\"\"Log messages at debug level; included if verbosity >= 2.\"\"\"\n   315→        self._log(\n   316→            preface=preface,\n   317→            prefix=prefix,\n   318→            message=message,\n   319→            show=self.is_debug,\n   320→            markup=markup,\n   321→            style=\"dim\",\n   322→        )\n   323→\n   324→    def verbose(self, message=\"\", *, prefix=\"\", markup=False):\n   325→        \"\"\"Log message at verbose level; included if verbosity >= 1.\"\"\"\n   326→        self._log(prefix=prefix, message=message, show=self.is_verbose, markup=markup)\n   327→\n   328→    def info(self, message=\"\", *, prefix=\"\", markup=False):\n   329→        \"\"\"Log message at info level; always included in output.\"\"\"\n   330→        self._log(prefix=prefix, message=message, markup=markup)\n   331→\n   332→    def warning(self, message=\"\", *, prefix=\"\", markup=False):\n   333→        \"\"\"Log message at warning level; always included in output.\"\"\"\n   334→        self._log(prefix=prefix, message=message, markup=markup, style=\"bold yellow\")\n   335→\n   336→    def error(self, message=\"\", *, prefix=\"\", markup=False):\n   337→        \"\"\"Log message at error level; always included in output.\"\"\"\n   338→        self._log(prefix=prefix, message=message, markup=markup, style=\"bold red\")\n   339→\n   340→    @property\n   341→    def verbosity(self) -> LogLevel:\n   342→        return self._verbosity\n   343→\n   344→    @verbosity.setter\n   345→    def verbosity(self, value: int | LogLevel):\n   346→        \"\"\"Clamp verbosity between valid log levels.\"\"\"\n   347→        self._verbosity = LogLevel(max(min(LogLevel), min(value, max(LogLevel))))\n   348→\n   349→    @property\n   350→    def is_verbose(self):\n   351→        \"\"\"Is verbose logging enabled via the -v flag?\n   352→\n   353→        This includes Briefcase logging that isn't relevant during normal operation.\n   354→        \"\"\"\n   355→        return self.verbosity >= LogLevel.VERBOSE\n   356→\n   357→    @property\n   358→    def is_debug(self):\n   359→        \"\"\"Is debug logging enabled via the -vv flag?\n   360→\n   361→        This includes debug logging from third party tools.\n   362→        \"\"\"\n   363→        return self.verbosity >= LogLevel.DEBUG\n   364→\n   365→    @property\n   366→    def is_deep_debug(self):\n   367→        \"\"\"Is deep debug logging enabled via the -vvv flag?\n   368→\n   369→        This includes debug logging from third party tools.\n   370→        \"\"\"\n   371→        return self.verbosity >= LogLevel.DEEP_DEBUG\n   372→\n   373→    def configure_stdlib_logging(self, logger_name: str):\n   374→        \"\"\"Configure stdlib logging for a third party tool to log through Rich.\n   375→\n   376→        When a third party tool written in Python uses the stdlib logging for their\n   377→        logging, it may provide an abstraction to enable the logging in the console or\n   378→        may require a handler to be added externally. Either way, the default handler\n   379→        to write to the console, i.e. logging.StreamHandler, will bypass Rich logging\n   380→        and therefore not be included in the logfile. To avoid this issue, this will\n   381→        add a handler that specifically writes to the console through Rich.\n   382→\n   383→        :param logger_name: Name of the logger the third party tool uses. Typically,\n   384→            this is the package name or path to a submodule for the package. Since\n   385→            logging uses namespaces for logging, enabling DEBUG logging for `git` will\n   386→            also enable it for others like `git.cmd`, `git.remote`, `git.config`, etc.\n   387→        \"\"\"\n   388→        if not self.is_deep_debug:\n   389→            return\n   390→\n   391→        logger = logging.getLogger(logger_name)\n   392→\n   393→        # do not add another rich handler if one already exists\n   394→        if not any(isinstance(h, RichLoggingHandler) for h in logger.handlers):\n   395→            logger.addHandler(\n   396→                RichLoggingHandler(stream=RichLoggingStream(console=self))\n   397→            )\n   398→            logger.setLevel(logging.DEBUG)\n   399→\n   400→    def capture_stacktrace(self, label=\"Main thread\"):\n   401→        \"\"\"Preserve Rich stacktrace from exception while in except block.\n   402→\n   403→        :param label: An identifying label for the thread that has raised the\n   404→            stacktrace. Defaults to the main thread.\n   405→        \"\"\"\n   406→        exc_info = sys.exc_info()\n   407→        try:\n   408→            self.skip_log = exc_info[1].skip_logfile\n   409→        except AttributeError:\n   410→            pass\n   411→\n   412→        self.stacktraces.append((label, Traceback.extract(*exc_info, show_locals=True)))\n   413→\n   414→    def add_log_file_extra(self, func: Callable[[], object]):\n   415→        \"\"\"Register a function to be called in the event that a log file is written.\n   416→\n   417→        This can be used to provide additional debugging information which is too\n   418→        expensive to gather pre-emptively.\n   419→        \"\"\"\n   420→        self.log_file_extras.append(func)\n   421→\n   422→    def save_log_to_file(self, command):\n   423→        \"\"\"Save the current application log to file.\"\"\"\n   424→        # A log file is always written if a Command ran and `--log` was provided.\n   425→        # If `--log` was not provided, then the log is written when an exception\n   426→        # occurred and the exception was not explicitly configured to skip the log.\n   427→        if not (\n   428→            command and (self.save_log or (self.stacktraces and not self.skip_log))\n   429→        ):\n   430→            return\n   431→\n   432→        with command.console.wait_bar(\"Saving log...\", transient=True):\n   433→            self.to_console()\n   434→            log_filename = f\"briefcase.{datetime.now().strftime('%Y_%m_%d-%H_%M_%S')}.{command.command}.log\"\n   435→            log_filepath = command.base_path / self.LOG_DIR / log_filename\n   436→            try:\n   437→                log_filepath.parent.mkdir(parents=True, exist_ok=True)\n   438→                with open(\n   439→                    log_filepath, \"w\", encoding=\"utf-8\", errors=\"backslashreplace\"\n   440→                ) as log_file:\n   441→                    log_file.write(self._build_log(command))\n   442→            except OSError as e:\n   443→                self.error(f\"Failed to save log to {log_filepath}: {e}\")\n   444→            else:\n   445→                self.warning(f\"Log saved to {log_filepath}\")\n   446→            self.to_console()\n   447→\n   448→    def _build_log(self, command) -> str:\n   449→        \"\"\"Accumulate all information to include in the log file.\"\"\"\n   450→        # Add the exception stacktraces to end of log if any were captured\n   451→        if self.stacktraces:\n   452→            # using print() instead of to_log() to avoid\n   453→            # timestamp and code location inclusion for the stacktrace box.\n   454→            for thread, stacktrace in self.stacktraces:\n   455→                self._log_impl.print(\n   456→                    f\"{thread} traceback:\",\n   457→                    Traceback(\n   458→                        trace=stacktrace,\n   459→                        width=self.log_width,\n   460→                        show_locals=True,\n   461→                    ),\n   462→                    new_line_start=True,\n   463→                )\n   464→\n   465→        # Retrieve additional logging added by the Command\n   466→        if self.log_file_extras:\n   467→            with self.wait_bar(\n   468→                \"Collecting extra information for log...\",\n   469→                transient=True,\n   470→            ):\n   471→                self.debug()\n   472→                self.debug(\"Extra information:\")\n   473→                for func in self.log_file_extras:\n   474→                    try:\n   475→                        func()\n   476→                    except Exception:\n   477→                        self.error(traceback.format_exc())\n   478→\n   479→        # Capture env vars removing any potentially sensitive information\n   480→        sanitized_env_vars = \"\\n\".join(\n   481→            f\"\\t{env_var}={value if not SENSITIVE_SETTING_RE.search(env_var) else '********************'}\"\n   482→            for env_var, value in sorted(command.tools.os.environ.items())\n   483→        )\n   484→\n   485→        # Capture pyproject.toml if one exists in the current directory\n   486→        try:\n   487→            with open(Path.cwd() / \"pyproject.toml\", encoding=\"utf-8\") as f:\n   488→                pyproject_toml = f.read().strip()\n   489→        except OSError as e:\n   490→            pyproject_toml = str(e)\n   491→\n   492→        # Build log with buffered log from Rich\n   493→        uname = platform.uname()\n   494→        return (\n   495→            f\"Date/Time:       {datetime.now().strftime('%Y-%m-%d %H:%M:%S %Z')}\\n\"\n   496→            f\"Command line:    {' '.join(sys.argv)}\\n\"\n   497→            \"\\n\"\n   498→            f\"OS Release:      {uname.system} {uname.release}\\n\"\n   499→            f\"OS Version:      {uname.version}\\n\"\n   500→            f\"Architecture:    {uname.machine}\\n\"\n   501→            f\"Platform:        {platform.platform(aliased=True)}\\n\"\n   502→            \"\\n\"\n   503→            f\"Python exe:      {sys.executable}\\n\"\n   504→            # replace line breaks with spaces (use chr(10) since '\\n' isn't allowed in f-strings...)\n   505→            f\"Python version:  {sys.version.replace(chr(10), ' ')}\\n\"\n   506→            # sys.real_prefix was used in older versions of virtualenv.\n   507→            # sys.base_prefix is always the python exe's original site-specific directory (e.g. /usr/local).\n   508→            # sys.prefix is updated (from base_prefix's value) to the virtual env's site-specific directory.\n   509→            f\"Virtual env:     {hasattr(sys, 'real_prefix') or sys.base_prefix != sys.prefix}\\n\"\n   510→            # for conda, prefix and base_prefix are likely the same but contain a conda-meta dir.\n   511→            f\"Conda env:       {(Path(sys.prefix) / 'conda-meta').exists()}\\n\"\n   512→            \"\\n\"\n   513→            f\"Briefcase:       {__version__}\\n\"\n   514→            f\"Target platform: {command.platform}\\n\"\n   515→            f\"Target format:   {command.output_format}\\n\"\n   516→            \"\\n\"\n   517→            \"Environment Variables:\\n\"\n   518→            f\"{sanitized_env_vars}\\n\"\n   519→            \"\\n\"\n   520→            \"pyproject.toml:\\n\"\n   521→            f\"{pyproject_toml}\\n\"\n   522→            \"\\n\"\n   523→            \"Briefcase Log:\\n\"\n   524→            f\"{self.export_log()}\"\n   525→        )\n   526→\n   527→    #################################################################\n   528→    # Console controls\n   529→    #################################################################\n   530→\n   531→    @property\n   532→    def is_interactive(self):\n   533→        \"\"\"Returns interactivity mode based on the presence of a tty for stdout.\n   534→\n   535→        In a non-interactive session, Rich's dynamic elements like progress bars should\n   536→        be disabled. By default, Rich will not render dynamic elements if a tty is not\n   537→        available. However, environment variables like FORCE_COLOR can override this\n   538→        behavior in Rich to not only show ANSI color and style but also dynamic\n   539→        elements. In a CI environment with this configuration, a long-lived progress bar\n   540→        can dramatically compromise the quality of logged output. So, dynamic elements\n   541→        should be specifically disabled in non-interactive sessions.\n   542→        \"\"\"\n   543→        # `sys.__stdout__` is used because Rich captures and redirects `sys.stdout`\n   544→        return os.isatty(sys.__stdout__.fileno())\n   545→\n   546→    @property\n   547→    def is_color_enabled(self):\n   548→        \"\"\"Is the underlying Rich console using color?\n   549→\n   550→        Rich can be explicitly configured to not use color at Console initialization or\n   551→        the NO_COLOR environment variable; alternatively, the derived color system for\n   552→        the terminal is influenced by attributes of the platform as well as FORCE_COLOR.\n   553→        \"\"\"\n   554→        # no_color has precedence since color_system can be set even if color is disabled\n   555→        if self._console_impl.no_color:\n   556→            return False\n   557→        else:\n   558→            return self._console_impl.color_system is not None\n   559→\n   560→    def progress_bar(self):\n   561→        \"\"\"Returns a progress bar as a context manager.\"\"\"\n   562→        return Progress(\n   563→            TextColumn(\"  \"),\n   564→            SpinnerColumn(\"line\", speed=1.5, style=\"default\"),\n   565→            BarColumn(bar_width=50),\n   566→            TextColumn(\"{task.percentage:>3.1f}%\", style=\"default\"),\n   567→            TextColumn(\"•\", style=\"default\"),\n   568→            TimeRemainingColumn(compact=True, elapsed_when_finished=True),\n   569→            disable=not self.is_interactive,\n   570→            console=self._console_impl,\n   571→        )\n   572→\n   573→    @contextmanager\n   574→    def wait_bar(\n   575→        self,\n   576→        message: str = \"\",\n   577→        done_message: str = \"done\",\n   578→        *,\n   579→        transient: bool = False,\n   580→        markup: bool = False,\n   581→    ) -> NotDeadYet:\n   582→        \"\"\"Activates the Wait Bar as a context manager.\n   583→\n   584→        If the Wait Bar is already active, then its message is updated for the new\n   585→        context. Once the new context is complete, the previous Wait Bar message\n   586→        is restored.\n   587→\n   588→        :param message: text explaining what is being awaited; should