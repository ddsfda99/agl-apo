\") and (\n   474\u2192                not self.train_on_input or is_multimodal\n   475\u2192            )\n   476\u2192            messages.append(Message(role=role, content=content, masked=masked))\n   477\u2192\n   478\u2192        return {\"messages\": messages}\n   479\u2192\n   480\u2192\n   481\u2192class OpenAIToMessages(Transform):\n   482\u2192    \"\"\"\n   483\u2192    Convert a single chat sample adhering to the `OpenAI chat completion <https://platform.openai.com/docs/api-reference/chat>`_\n   484\u2192    JSON structure to torchtune's :class:`~torchtune.data.Message` structure. This supports both\n   485\u2192    text and image messages.\n   486\u2192\n   487\u2192    A single sample typically consists of a single optional system prompt and one or multiple\n   488\u2192    turns of user and assistant messages.\n   489\u2192\n   490\u2192    For example::\n   491\u2192\n   492\u2192        {\n   493\u2192            \"messages\": [\n   494\u2192                {\n   495\u2192                    \"role\": <system|user|assistant>,\n   496\u2192                    \"content\": [\n   497\u2192                        {\n   498\u2192                            \"type\": \"text\",\n   499\u2192                            \"text\": \"What'\\''s in this image?\",\n   500\u2192                        },\n   501\u2192                        {\n   502\u2192                            \"type\": \"image_url\",\n   503\u2192                            \"image_url\": {\n   504\u2192                                \"url\": <url>,\n   505\u2192                            },\n   506\u2192                        },\n   507\u2192                },\n   508\u2192                ...\n   509\u2192            ]\n   510\u2192        }\n   511\u2192\n   512\u2192    :class:`~torchtune.data.Message` follows::\n   513\u2192\n   514\u2192        [\n   515\u2192            {\n   516\u2192                \"role\": <system|user|assistant>,\n   517\u2192                \"content\": [\n   518\u2192                    {\n   519\u2192                        \"type\": \"text\",\n   520\u2192                        \"content\": \"What'\\''s in this image?\",\n   521\u2192                    },\n   522\u2192                    {\n   523\u2192                        \"type\": \"image\",\n   524\u2192                        \"content\": <PIL.Image.Image>,\n   525\u2192                    },\n   526\u2192                ],\n   527\u2192            },\n   528\u2192            ...\n   529\u2192        ]\n   530\u2192\n   531\u2192    Args:\n   532\u2192        train_on_input (bool): whether the prompt should remain unmasked. Default: False\n   533\u2192        column_map (Optional[Dict[str, str]]): a mapping from the expected columns (\"messages\")\n   534\u2192            to the new column names in the dataset. Key should be \"messages\" and value should be\n   535\u2192            the new column name. If None, keep the default \"messages\".\n   536\u2192            Default is None.\n   537\u2192        new_system_prompt (Optional[str]): if specified, prepend a system message. This can\n   538\u2192            serve as instructions to guide the model response. Setting this will OVERRIDE any system\n   539\u2192            messages already present in the dataset. Default is None.\n   540\u2192\n   541\u2192    Raises:\n   542\u2192        ValueError: If ``column_map`` is provided and ``messages`` not in ``column_map``.\n   543\u2192    \"\"\"\n   544\u2192\n   545\u2192    def __init__(\n   546\u2192        self,\n   547\u2192        train_on_input: bool = False,\n   548\u2192        column_map: Optional[Dict[str, str]] = None,\n   549\u2192        new_system_prompt: Optional[str] = None,\n   550\u2192    ):\n   551\u2192        self.train_on_input = train_on_input\n   552\u2192        self.new_system_prompt = new_system_prompt\n   553\u2192        if column_map:\n   554\u2192            if \"messages\" not in column_map:\n   555\u2192                raise V