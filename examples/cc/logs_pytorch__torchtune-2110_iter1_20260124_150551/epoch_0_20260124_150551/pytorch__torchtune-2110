                [\n    38\u2192                    {\"type\": \"image\", \"content\": <PIL.Image.Image>},\n    39\u2192                    {\"type\": \"text\", \"content\": \"What is in this image?\"},\n    40\u2192                ]\n    41\u2192\n    42\u2192        masked (bool): whether the message is masked in the sample. If True, do not use\n    43\u2192            in loss calculation. Default: False\n    44\u2192        ipython (bool): whether the message is a tool call. Default: False\n    45\u2192        eot (bool): whether the message corresponds to the end of a turn, where control is handed over\n    46\u2192            to the assistant from the user or the user from the assistant. Default: True. Should be true\n    47\u2192            in most cases except for:\n    48\u2192\n    49\u2192            - For multiple consecutive assistant messages (i.e., tool calls\n    50\u2192              by assistant), only the last assistant message will have ``eot=True``\n    51\u2192            - All ipython messages (tool call returns) should set ``eot=False``.\n    52\u2192\n    53\u2192    Note:\n    54\u2192        Message class expects any image content to be in\n    55\u2192        `PIL Image format <https://pillow.readthedocs.io/en/stable/reference/Image.html#PIL.Image.Image>`_.\n    56\u2192    \"\"\"\n    57\u2192\n    58\u2192    def __init__(\n    59\u2192        self,\n    60\u2192        role: Role,\n    61\u2192        content: Union[str, List[Dict[str, Any]]],\n    62\u2192        masked: bool = False,\n    63\u2192        ipython: bool = False,\n    64\u2192        eot: bool = True,\n    65\u2192    ):\n    66\u2192        self.role = role\n    67\u2192        self.content = self._convert_to_list_of_dict(content)\n    68\u2192        self.masked = masked\n    69\u2192        self.ipython = ipython\n    70\u2192        self.eot = eot\n    71\u2192\n    72\u2192        self._validate_message()\n    73\u2192\n    74\u2192    def _convert_to_list_of_dict(self, content) -> List[Dict[str, Any]]:\n    75\u2192        \"\"\"User is currently allowed to pass in a string for text-only content.\n    76\u2192        This ensures that the content is formatted as a list of dictionaries.\"\"\"\n    77\u2192        if isinstance(content, str):\n    78\u2192            return [{\"type\": \"text\", \"content\": content}]\n    79\u2192\n    80\u2192        assert isinstance(\n    81\u2192            content, list\n    82\u2192        ), f\"content must be of type List[Dict[str, Any]], got {content}\"\n    83\u2192\n    84\u2192        return content\n    85\u2192\n    86\u2192    @classmethod\n    87\u2192    def from_dict(cls, d: dict) -> \"Message\":\n    88\u2192        \"\"\"\n    89\u2192        Construct a Message from a dictionary.\n    90\u2192\n    91\u2192        Args:\n    92\u2192            d (dict): dictionary containing the fields of the Message.\n    93\u2192\n    94\u2192        Returns:\n    95\u2192            Message: constructed Message.\n    96\u2192        \"\"\"\n    97\u2192        return cls(\n    98\u2192            role=d[\"role\"],\n    99\u2192            content=d[\"content\"],\n   100\u2192            masked=d.get(\"masked\", False),\n   101\u2192            ipython=d.get(\"ipython\", False),\n   102\u2192            eot=d.get(\"eot\", True),\n   103\u2192        )\n   104\u2192\n   105\u2192    def get_media(self) -> List[\"PIL.Image.Image\"]:\n   106\u2192        \"\"\"\n   107\u2192        Returns media content of the message.\n   108\u2192        \"\"\"\n   109\u2192        return [\n   110\u2192            content[\"content\"] for content in self.content if content[\"type\"] == \"image\"\n   111\u2192        ]\n   112\u2192\n   113\u2192    @property\n   114\u2192    def contains_media(self) -> bool:\n   115\u2192        \"\"\"\n   116\u2192        Returns whether the message contains media.\n   117\u2192        \"\"\"\n   118\u2192        return any(content[\"type\"] == \"image\" for content in self.content)\n   119\u2192\n   120\u2192    @property\n   121\u2192    def text_content(self) -> str:\n   122\u2192        \"\"\"\n   123\u2192        Returns text-only content of the message.\n   124\u2192        \"\"\"\n   125\u2192        return \"\".join(\n   126\u2192            content[\"content\"] for content in self.content if content[\"type\"] == \"text\"\n   127\u2192        )\n   128\u2192\n   129\u2192    def _validate_message(self) -> None:\n   130\u2192        if self.ipython and self.contains_media:\n   131\u2192            raise ValueError(\n   132\u2192                f\"Media tokens in tool calls are not supported. Both are set in message: {self.text_content}\"\n   133\u2192            )\n   134\u2192        if self.ipython and self.role != \"assistant\":\n   135\u2192            raise ValueError(\n   136\u2192                f\"Only assistant messages can be tool calls. Found role {self.role} in message: {self.text_content}\"\n   137\u2192            )\n   138\u2192\n   139\u2192    def __repr__(self) -> str:\n   140\u2192        content_only = [content[\"content\"] for content in self.content]\n   141\u2192        return f\"Message(role='{self.role}', content={content_only!r})\"\n   142\u2192\n   143\u2192\n   144\u2192class InputOutputToMessages(Transform):\n   145\u2192    \"\"\"\n   146\u2192    Message transform class that converts a single sample with \"input\" and \"output\" fields,\n   147\u2192    (or equivalent fields specified in column_map) to user and assistant messages,\n   148\u2192    respectively. This is useful for datasets that have two columns, one containing\n   149\u2192    the user prompt string and the other containing the model response string::\n   150\u2192\n   151\u2192        |  input          |  output          |\n   152\u2192        |-----------------|------------------|\n   153\u2192        | \"user prompt\"   | \"model response\" |\n   154\u2192\n   155\u2192    Args:\n   156\u2192        train_on_input (bool): Whether the model is trained on the user prompt or not.\n   157\u2192            Default is False.\n   158\u2192        column_map (Optional[Dict[str, str]]): a mapping to change the expected \"input\"\n   159\u2192            and \"output\" column names to the actual column names in the dataset. Keys should\n   160\u2192            be \"input\" and \"output\" and values should be the actual column names. Default is None,\n   161\u2192            keeping the default \"input\" and \"output\" column names.\n   162\u2192        new_system_prompt (Optional[str]): if specified, prepend a system message. This can\n   163\u2192            serve as instructions to guide the model response. Default is None.\n   164\u2192        image_dir (Optional[Path]): path to the directory containing the images that is prepended to all image\n   165\u2192            paths in the dataset. For example, if ``image_dir=\"/home/user/dataset/\"` and the sample image path\n   166\u2192            was ``\"images/1.jpg\"``, the final image path that will be loaded is ``\"/home/user/dataset/images/1.jpg\"``.\n   167\u2192            If None, assume images are available in current working directory or are located\n   168\u2192            on a remote url. For text-only, leave as None. Default is None.\n   169\u2192\n   170\u2192    Raises:\n   171\u2192        ValueError: If ``column_map`` is provided and ``input`` not in ``column_map``, or\n   172\u2192            ``output`` not in ``column_map``.\n   173\u2192    \"\"\"\n   174\u2192\n   175\u2192    def __init__(\n   176\u2192        self,\n   177\u2192        train_on_input: bool = False,\n   178\u2192        column_map: Optional[Dict[str, str]] = None,\n   179\u2192        new_system_prompt: Optional[str] = None,\n   180\u2192        image_dir: Optional[Path] = None,\n   181\u2192    ):\n   182\u2192        self.train_on_input = train_on_input\n   183\u2192        self.new_system_prompt = new_system_prompt\n   184\u2192\n   185\u2192        self.column_map = column_map\n   186\u2192\n   187\u2192        if self.column_map is not None:\n   188\u2192            if \"input\" not in self.column_map:\n   189\u2192                raise ValueError(\n   190\u2192                    f\"Expected a key of 'input' in column_map but found {self.column_map.keys()}.\"\n   191\u2192                )\n   192\u2192            if \"output\" not in self.column_map:\n   193\u2192                raise ValueError(\n   194\u2192                    f\"Expected a key of 'output' in column_map but found {self.column_map.keys()}.\"\n   195\u2192                )\n   196\u2192        else:\n   197\u2192            self.column_map = {\"input\": \"input\", \"output\": \"output\", \"image\": \"image\"}\n   198\u2192\n   199\u2192        self.image_dir = image_dir\n   200\u2192\n   201\u2192    def __call__(self, sample: Mapping[str, Any]) -> Mapping[str, Any]:\n   202\u2192        is_multimodal = \"image\" in sample or (\n   203\u2192            \"image\" in self.column_map and self.column_map[\"image\"] in sample\n   204\u2192        )\n   205\u2192\n   206\u2192        if is_multimodal:\n   207\u2192            image_path = sample[self.column_map[\"image\"]]\n   208\u2192            if isinstance(image_path, str):\n   209\u2192                if self.image_dir is not None:\n   210\u2192                    image_path = self.image_dir / image_path\n   211\u2192                # Load if not loaded\n   212\u2192                pil_image = load_image(image_path)\n   213\u2192            else:\n   214\u2192                pil_image = image_path\n   215\u2192            content = [\n   216\u2192                {\"type\": \"image\", \"content\": pil_image},\n   217\u2192                {\"type\": \"text\", \"content\": sample[self.column_map[\"input\"]]},\n   218\u2192            ]\n   219\u2192        else:\n   220\u2192            content = [{\"type\": \"text\", \"content\": sample[self.column_map[\"input\"]]}]\n   221\u2192\n   222\u2192        output_content = [\n   223\u2192            {\"type\": \"text\", \"content\": sample[self.column_map[\"output\"]]}\n   224\u2192        ]\n   225\u2192\n   226\u2192        messages = [\n   227\u2192            Message(\n   228\u2192                role=\"user\",\n   229\u2192                content=content,\n   230\u2192                masked=not self.train_on_input,\n   231\u2192                eot=True,\n   232\u2192            ),\n   233\u2192            Message(\n   234\u2192                role=\"assistant\",\n   235\u2192                content=output_content,\n   236\u2192                masked=False,\n   237\u2192                eot=True,\n   238\u2192            ),\n   239\u2192        ]\n   240\u2192        if self.new_system_prompt is not None:\n   241\u2192            messages = [\n   242\u2192                Message(\n   243\u2192                    role=\"system\", content=self.new_system_prompt, masked=True, eot=True\n   244\u2192                )\n   245\u2192            ] + messages\n   246\u2192        return {\"messages\": messages}\n   247\u2192\n   248\u2192\n   249\u2192class ChosenRejectedToMessages(Transform):\n   250\u2192    \"\"\"\n   251\u2192    Transform for converting a single sample from datasets with \"chosen\" and \"rejected\" columns\n   252\u2192    containing conversations to a list of chosen and rejected messages. For example::\n   253\u2192\n   254\u2192        |  chosen                                |  rejected                              |\n   255\u2192        |----------------------------------------|----------------------------------------|\n   256\u2192        | [{\"role\": \"user\", \"content\": Q1},      | [{\"role\": \"user\", \"content\": Q1},      |\n   257\u2192        |  {\"role\": \"assistant\", \"content\": A1}] |  {\"role\": \"assistant\", \"content\": A2}] |\n   258\u2192\n   259\u2192    will be converted to:\n   260\u2192\n   261\u2192    .. code-block:: python\n   262\u2192\n   263\u2192        chosen = [\n   264\u2192            Message(role=\"user\", content=\"Q1\"),\n   265\u2192            Message(role=\"assistant\", content=\"A1\"),\n   266\u2192        ]\n   267\u2192        rejected = [\n   268\u2192            Message(role=\"user\", content=\"Q1\"),\n   269\u2192            Message(role=\"assistant\", content=\"A2\"),\n   270\u2192        ]\n   271\u2192\n   272\u2192    A single sample typically consists of a single optional system prompt and one or multiple\n   273\u2192    turns of user and assistant messages.\n   274\u2192\n   275\u2192    Args:\n   276\u2192        train_on_input (bool): Whether the model is trained on the user prompt or not.\n   277\u2192            Default is False.\n   278\u2192        column_map (Optional[Dict[str, str]]): a mapping to change the expected\n   279\u2192            \"chosen\" and \"rejected\" column names to the actual column names in the dataset.\n   280\u2192            Keys should be \"chosen\" and \"rejected\" and values should be the actual column names.\n   281\u2192            Default is None, keeping the default column names.\n   282\u2192        new_system_prompt (Optional[str]): if specified, prepend a system message. This can\n   283\u2192            serve as instructions to guide the model response. Setting this will OVERRIDE any system\n   284\u2192            messages already present in the dataset. Default is None.\n   285\u2192\n   286\u2192    Raises:\n   287\u2192        ValueError: If ``column_map`` is provided and ``chosen`` not in ``column_map``, or\n   288\u2192            ``rejected`` not in ``column_map``.\n   289\u2192    \"\"\"\n   290\u2192\n   291\u2192    def __init__(\n   292\u2192        self,\n   293\u2192        train_on_input: bool = False,\n   294\u2192        column_map: Optional[Dict[str, str]] = None,\n   295\u2192        new_system_prompt: Optional[str] = None,\n   296\u2192    ):\n   297\u2192        self.train_on_input = train_on_input\n   298\u2192        self.new_system_prompt = new_system_prompt\n   299\u2192        if column_map:\n   300\u2192            if \"chosen\" not in column_map:\n   301\u2192                raise ValueError(\n   302\u2192                    f\"Expected a key of 'chosen' in column_map but found {column_map.keys()}.\"\n   303\u2192                )\n   304\u2192            if \"rejected\" not in column_map:\n   305\u2192                raise ValueError(\n   306\u2192                    f\"Expected a key of 'rejected' in column_map but found {column_map.keys()}.\"\n   307\u2192                )\n   308\u2192            self._column_map = column_map\n   309\u2192        else:\n   310\u2192            self._column_map = {\"chosen\": \"chosen\", \"rejected\": \"rejected\"}\n   311\u2192\n   312\u2192    def __call__(self, sample: Mapping[str, Any]) -> Mapping[str, Any]:\n   313\u2192        chosen_messages = []\n   314\u2192        for message in sample[self._column_map[\"chosen\"]]:\n   315\u2192            if message[\"role\"] == \"system\" and self.new_system_prompt is not None:\n   316\u2192                continue\n   317\u2192            message[\"masked\"] = (message[\"role\"] != \"assistant\") and (\n   318\u2192                not self.train_on_input\n   319\u2192            )\n   320\u2192            chosen_messages.append(Message.from_dict(message))\n   321\u2192\n   322\u2192        rejected_messages = []\n   323\u2192        for message in sample[self._column_map[\"rejected\"]]:\n   324\u2192            if message[\"role\"] == \"system\" and self.new_system_prompt is not None:\n   325\u2192                continue\n   326\u2192            message[\"masked\"] = (message[\"role\"] != \"assistant\") and (\n   327\u2192                not self.train_on_input\n   328\u2192            )\n   329\u2192            rejected_messages.append(Message.from_dict(message))\n   330\u2192\n   331\u2192        if self.new_system_prompt is not None:\n   332\u2192            chosen_messages = [\n   333\u2192                Message(\n   334\u2192                    role=\"system\", content=self.new_system_prompt, masked=True, eot=True\n   335\u2192                )\n   336\u2192            ] + chosen_messages\n   337\u2192            rejected_messages = [\n   338\u2192                Message(\n   339\u2192                    role=\"system\", content=self.new_system_prompt, masked=True, eot=True\n   340\u2192                )\n   341\u2192            ] + rejected_messages\n   342\u2192\n   343\u2192        return {\"chosen\": chosen_messages, \"rejected\": rejected_messages}\n   344\u2192\n   345\u2192\n   346\u2192class ShareGPTToMessages(Transform):\n   347\u2192    \"\"\"\n   348\u2192    Convert a single chat sample adhering to the ShareGPT JSON structure to torchtune's :class:`~torchtune.data.Message`\n   349\u2192    structure.\n   350\u2192\n   351\u2192    A single sample typically consists of a single optional system prompt and one or multiple\n   352\u2192    turns of user and assistant messages.\n   353\u2192\n   354\u2192    ShareGPT follows::\n   355\u2192\n   356\u2192        {\n   357\u2192            \"conversations\": [\n   358\u2192                {\n   359\u2192                    \"from\": <system|human|gpt>,\n   360\u2192                    \"value\": <message>,\n   361\u2192                },\n   362\u2192                ...\n   363\u2192            ]\n   364\u2192        }\n   365\u2192\n   366\u2192    :class:`~torchtune.data.Message` follows::\n   367\u2192\n   368\u2192        [\n   369\u2192            {\n   370\u2192                \"role\": <system|user|assistant>,\n   371\u2192                \"content\": <message>,\n   372\u2192            },\n   373\u2192            ...\n   374\u2192        ]\n   375\u2192\n   376\u2192    Args:\n   377\u2192        train_on_input (bool): whether the prompt should remain unmasked. For multimodal datasets, ``train_on_input``\n   378\u2192            is always False and this value is ignored. Default: False\n   379\u2192        column_map (Optional[Dict[str, str]]): a mapping from the expected columns (\"conversations\")\n   380\u2192            to the new column names in the dataset. Key should be \"conversations\" and value should\n   381\u2192            be the new column name. If None, keep the default \"conversations\".\n   382\u2192            Default is None.\n   383\u2192        new_system_prompt (Optional[str]): if specified, prepend a system message. This can\n   384\u2192            serve as instructions to guide the model response. Setting this will OVERRIDE any system\n   385\u2192            messages already present in the dataset. Default is None.\n   386\u2192        image_dir (Optional[Path]): path to the directory containing the images that is prepended to all image\n   387\u2192            paths in the dataset. For example, if ``image_dir=\"/home/user/dataset/\"` and the sample image path\n   388\u2192            was ``\"images/1.jpg\"``, the final image path that will be loaded is ``\"/home/user/dataset/images/1.jpg\"``.\n   389\u2192            If None, assume images are available in current working directory or are located\n   390\u2192            on a remote url. For text-only, leave as None. Default is None.\n   391\u2192        image_tag (Optional[str]): placeholder tags in the text content of each message to be replaced by image\n   392\u2192            special tokens. If images are present and this is None, then will prepend image tokens to the first\n   393\u2192            user message in the sample by default. If text-only, this field is ignored. Default is ``\"<image>\"``.\n   394\u2192\n   395\u2192    Raises:\n   396\u2192        ValueError: If ``column_map`` is provided and ``conversations`` not in ``column_map``.\n   397\u2192    \"\"\"\n   398\u2192\n   399\u2192    def __init__(\n   400\u2192        self,\n   401\u2192        train_on_input: bool = False,\n   402\u2192        column_map: Optional[Dict[str, str]] = None,\n   403\u2192        new_system_prompt: Optional[str] = None,\n   404\u2192        image_dir: Optional[Path] = None,\n   405\u2192        image_tag: Optional[str] = \"<image>\",\n   406\u2192    ):\n   407\u2192        self.train_on_input = train_on_input\n   408\u2192        self.new_system_prompt = new_system_prompt\n   409\u2192        if column_map:\n   410\u2192            if \"conversations\" not in column_map:\n   411\u2192                raise ValueError(\n   412\u2192                    f\"Expected a key of 'conversations' in column_map but found {column_map.keys()}.\"\n   413\u2192                )\n   414\u2192            self._column_map = column_map\n   415\u2192        else:\n   416\u2192            self._column_map = {\"conversations\": \"conversations\", \"image\": \"image\"}\n   417\u2192        self.image_dir = image_dir\n   418\u2192        self.image_tag = image_tag\n   419\u2192\n   420\u2192    def __call__(self, sample: Mapping[str, Any]) -> Mapping[str, Any]:\n   421\u2192        \"\"\"\n   422\u2192        Return a list of Message objects from the provided sample dict.\n   423\u2192\n   424\u2192        Args:\n   425\u2192            sample (Mapping[str, Any]): a single data sample with \"messages\" field pointing\n   426\u2192                to a list of dict messages.\n   427\u2192\n   428\u2192        Returns:\n   429\u2192            List[Message]: A list of messages with \"role\" and \"content\" fields.\n   430\u2192        \"\"\"\n   431\u2192        role_map = {\"system\": \"system\", \"human\": \"user\", \"gpt\": \"assistant\"}\n   432\u2192        messages = []\n   433\u2192        if self.new_system_prompt is not None:\n   434\u2192            messages.append(\n   435\u2192                Message(\n   436\u2192                    role=\"system\", content=self.new_system_prompt, masked=True, eot=True\n   437\u2192                )\n   438\u2192            )\n   439\u2192\n   440\u2192        is_multimodal = \"image\" in sample or (\n   441\u2192            