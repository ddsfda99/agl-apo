     if self.new_system_prompt is not None:\n   594\u2192            updated_messages.append(\n   595\u2192                Message(\n   596\u2192                    role=\"system\", content=self.new_system_prompt, masked=True, eot=True\n   597\u2192                )\n   598\u2192            )\n   599\u2192        for message in sample[self._column_map[\"messages\"]]:\n   600\u2192            if message[\"role\"] == \"system\" and self.new_system_prompt is not None:\n   601\u2192                continue\n   602\u2192            masked = (message[\"role\"] != \"assistant\") and (not self.train_on_input)\n   603\u2192            if isinstance(message[\"content\"], list):\n   604\u2192                content = self._convert_from_openai_content(message[\"content\"])\n   605\u2192            elif isinstance(message[\"content\"], str):\n   606\u2192                content = message[\"content\"]\n   607\u2192            updated_messages.append(\n   608\u2192                Message(\n   609\u2192                    role=message[\"role\"],\n   610\u2192                    content=content,\n   611\u2192                    masked=masked,\n   612\u2192                ),\n   613\u2192            )\n   614\u2192\n   615\u2192        return {\"messages\": updated_messages}\n   616\u2192\n   617\u2192\n   618\u2192def validate_messages(\n   619\u2192    messages: List[Message],\n   620\u2192) -> None:\n   621\u2192    \"\"\"\n   622\u2192    Given a list of messages, ensure that messages form a valid\n   623\u2192    back-and-forth conversation. An error will be raised if:\n   624\u2192\n   625\u2192    - There is a system message that's not the first message\n   626\u2192    - There are two consecutive user messages\n   627\u2192    - An assistant message comes before the first user message\n   628\u2192    - The message is empty\n   629\u2192    - Messages are shorter than length of 2 (min. one user-assistant turn)\n   630\u2192\n   631\u2192\n   632\u2192    Args:\n   633\u2192        messages (List[Message]): the messages to validate.\n   634\u2192\n   635\u2192    Raises:\n   636\u2192        ValueError: If the messages are invalid.\n   637\u2192    \"\"\"\n   638\u2192    if len(messages) < 2:\n   639\u2192        raise ValueError(\n   640\u2192            f\"Messages must be at least length 2, but got {len(messages)} messages\"\n   641\u2192        )\n   642\u2192\n   643\u2192    last_turn = \"assistant\"\n   644\u2192    for i, message in enumerate(messages):\n   645\u2192        if message.role == \"assistant\" and last_turn != \"user\":\n   646\u2192            raise ValueError(\n   647\u2192                f\"Assistant message before expected user message at index {i} in messages\"\n   648\u2192            )\n   649\u2192        if message.role == \"user\" and last_turn == \"user\":\n   650\u2192            raise ValueError(\n   651\u2192                f\"Two consecutive user messages at index {i} and {i - 1} in messages\"\n   652\u2192            )\n   653\u2192        if message.role == \"system\" and i > 0:\n   654\u2192            raise ValueError(\n   655\u2192                f\"System message at index {i} in messages, but system messages must come first\"\n   656\u2192            )\n   657\u2192        last_turn = message.role\n   658\u2192\n   659\u2192\n   660\u2192class AlpacaToMessages(Transform):\n   661\u2192    \"\"\"\n   662\u2192    Message transform class for Alpaca-style datasets with \"instruction\", \"input\", and \"output\"\n   663\u2192    (or equivalent fields specified in column_map) columns. User messages are formed from the\n   664\u2192    instruction + input columns and assistant messages are formed from the output column. Prompt\n   665\u2192    templating is conditional on the presence of the \"input\" column, and thus is handled directly\n   666\u2192    in this transform class instead of a dedicated :class:`~torchtune.data.PromptTemplate` class\n   667\u2192    due to this custom logic.\n   668\u2192\n   669\u2192    Args:\n   670\u2192        train_on_input (bool): Whether the model is trained on the user prompt or not.\n   671\u2192            Default is True.\n   672\u2192        column_map (Optional[Dict[str, str]]): a mapping to change the expected \"instruction\", \"input\",\n   673\u2192            and \"output\" column names to the actual column names in the dataset. Default is None,\n   674\u2192            keeping the default column names.\n   675\u2192    \"\"\"\n   676\u2192\n   677\u2192    def __init__(\n   678\u2192        self, train_on_input: bool = True, column_map: Optional[Dict[str, str]] = None\n   679\u2192    ):\n   680\u2192        self.train_on_input = train_on_input\n   681\u2192        self.column_map = column_map\n   682\u2192        self.template = {\n   683\u2192            \"prompt_input\": (\n   684\u2192                \"Below is an instruction that describes a task, paired with an input that provides further context. \"\n   685\u2192                \"Write a response that appropriately completes the request.\\n\\n\"\n   686\u2192                \"### Instruction:\\n{instruction}\\n\\n### Input:\\n{input}\\n\\n### Response:\\n\"\n   687\u2192            ),\n   688\u2192            \"prompt_no_input\": (\n   689\u2192                \"Below is an instruction that describes a task. \"\n   690\u2192                \"Write a response that appropriately completes the request.\\n\\n\"\n   691\u2192                \"### Instruction:\\n{instruction}\\n\\n### Response:\\n\"\n   692\u2192            ),\n   693\u2192        }\n   694\u2192\n   695\u2192    def __call__(self, sample: Mapping[str, Any]) -> Mapping[str, Any]:\n   696\u2192        column_map = self.column_map or {}\n   697\u2192        key_input = column_map.get(\"input\", \"input\")\n   698\u2192        key_instruction = column_map.get(\"instruction\", \"instruction\")\n   699\u2192        key_output = column_map.get(\"output\", \"output\")\n   700\u2192\n   701\u2192        