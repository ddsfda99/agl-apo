ge(self) -> None:\n   130→        if self.ipython and self.contains_media:\n   131→            raise ValueError(\n   132→                f\"Media tokens in tool calls are not supported. Both are set in message: {self.text_content}\"\n   133→            )\n   134→        if self.ipython and self.role != \"assistant\":\n   135→            raise ValueError(\n   136→                f\"Only assistant messages can be tool calls. Found role {self.role} in message: {self.text_content}\"\n   137→            )\n   138→\n   139→    def __repr__(self) -> str:\n   140→        content_only = [content[\"content\"] for content in self.content]\n   141→        return f\"Message(role='{self.role}', content={content_only!r})\"\n   142→\n   143→\n   144→class InputOutputToMessages(Transform):\n   145→    \"\"\"\n   146→    Message transform class that converts a single sample with \"input\" and \"output\" fields,\n   147→    (or equivalent fields specified in column_map) to user and assistant messages,\n   148→    respectively. This is useful for datasets that have two columns, one containing\n   149→    the user prompt string and the other containing the model response string::\n   150→\n   151→        |  input          |  output          |\n   152→        |-----------------|------------------|\n   153→        | \"user prompt\"   | \"model response\" |\n   154→\n   155→    Args:\n   156→        train_on_input (bool): Whether the model is trained on the user prompt or not.\n   157→            Default is False.\n   158→        column_map (Optional[Dict[str, str]]): a mapping to change the expected \"input\"\n   159→            and \"output\" column names to the actual column names in the dataset. Keys should\n   160→            be \"input\" and \"output\" and values should be the actual column names. Default is None,\n   161→            keeping the default \"input\" and \"output\" column names.\n   162→        new_system_prompt (Optional[str]): if specified, prepend a system message. This can\n   163→            serve as instructions to guide the model response. Default is None.\n   164→        image_dir (Optional[Path]): path to the directory containing the images that is prepended to all image\n   165→            paths in the dataset. For example, if ``image_dir=\"/home/user/dataset/\"` and the sample image path\n   166→            was ``\"images/1.jpg\"``, the final image path that will be loaded is ``\"/home/user/dataset/images/1.jpg\"``.\n   167→            If None, assume images are available in current working directory or are located\n   168→            on a remote url. For text-only, leave as None. Default is None.\n   169→\n   170→    Raises:\n   171→        ValueError: If ``column_map`` is provided and ``input`` not in ``column_map``, or\n   172→            ``output`` not in ``column_map``.\n   173→    \"\"\"\n   174→\n   175→    def __init__(\n   176→        self,\n   177→        train_on_input: bool = False,\n   178→        column_map: Optional[Dict[str, str]] = None,\n   179→        new_system_prompt: Optional[str] = None,\n   180→        image_dir: Optional[Path] = None,\n   181→    ):\n   182→        self.train_on_input = train_on_input\n   183→        self.new_system_prompt = new_system_prompt\n   184→\n   185→        self.column_map = column_map\n   186→\n   187→        if self.column_map is not None:\n   188→            if \"input\" not in self.column_map:\n   189→                raise ValueError(\n   190→                    f\"Expected a key of 'input' in column_map but found {self.column_map.keys()}.\"\n   191→                )\n   192→            if \"output\" not in self.column_map:\n   193→                raise ValueError(\n   194→                    f\"Expected a key of 'output' in column_map but found {self.column_map.keys()}.\"\n   195→                )\n   196→        else:\n   197→            self.column_map = {\"input\": \"input\", \"output\": \"output\", \"image\": \"image\"}\n   198→\n   199→        self.image_dir = image_dir\n   200→\n   201→    def __call__(self, sample: Mapping[str, Any]) -> Mapping[str, Any]:\n   202→        is_multimodal = \"image\" in sample or (\n   203→            \"image\" in self.column_map and self.column_map[\"image\"] in sample\n   204→        )\n   205→\n   206→        if is_multimodal:\n   207→            image_path = sample[self.column_map[\"image\"]]\n   208→            if isinstance(image_path, str):\n   209→                if self.image_dir is not None:\n   210→                    image_path = self.image_dir / image_path\n   211→                # Load if not loaded\n   212→                pil_image = load_image(image_path)\n   213→            else:\n   214→                pil_image = image_path\n   215→            content = [\n   216→                {\"type\": \"image\", \"content\": pil_image},\n   217→                {\"type\": \"text\", \"content\": sample[self.column_map[\"input\"]]},\n   218→            ]\n   219→        else:\n   220→            content = [{\"type\": \"text\", \"content\": sample[self.column_map[\"input\"]]}]\n   221→\n   222→        output_content = [\n   223→            {\"type\": \"text\", \"content\": sample[self.column_map[\"output\"]]}\n   224→        ]\n   225→\n   226→        messages = [\n   227→            Message(\n   228→                role=\"user\",\n   229→                content=content,\n   230→                masked=not self.train_on_input,\n   231→                eot=True,\n   232→            ),\n   233→            Message(\n   234→                role=\"assistant\",\n   235→                content=output_content,\n   236→                masked=False,\n   237→                eot=True,\n   238→            ),\n   239→        ]\n   240→        if self.new_system_prompt is not None:\n   241→            messages = [\n   242→                Message(\n   243→                    role=\"system\", content=self.new_system_prompt, masked=True, eot=True\n   244→                )\n   245→            ] + messages\n   246→        return {\"messages\": messages}\n   247→\n   248→\n   249→class ChosenRejectedToMessages(Transform):\n   250→    \"\"\"\n   251→    Transform for converting a single sample from datasets with \"chosen\" and \"rejected\" columns\n   252→    containing conversations to a list of chosen and rejected messages. For example::\n   253→\n   254→        |  chosen                                |  rejected                              |\n   255→        |----------------------------------------|----------------------------------------|\n   256→        | [{\"role\": \"user\", \"content\": Q1},      | [{\"role\": \"user\", \"content\": Q1},      |\n   257→        |  {\"role\": \"assistant\", \"content\": A1}] |  {\"role\": \"assistant\", \"content\": A2}] |\n   258→\n   259→    will be converted to:\n   260→\n   261→    .. code-block:: python\n   262→\n   263→        chosen = [\n   264→            Message(role=\"user\", content=\"Q1\"),\n   265→            Message(role=\"assistant\", content=\"A1\"),\n   266→        ]\n   267→        rejected = [\n   268→            Message(role=\"user\", content=\"Q1\"),\n   269→            Message(role=\"assistant\", content=\"A2\"),\n   270→        ]\n   271→\n   272→    A single sample typically consists of a single optional system prompt and one or multiple\n   273→    turns of user and assistant messages.\n   274→\n   275→    Args:\n   276→        train_on_input (bool): Whether the model is trained on the user prompt or not.\n   277→            Default is False.\n   278→        column_map (Optional[Dict[str, str]]): a mapping to change the expected\n   279→            \"chosen\" and \"rejected\" column names to the actual column names in the dataset.\n   280→            Keys should be \"chosen\" and \"rejected\" and values should be the actual column names.\n   281→            Default is None, keeping the default column names.\n   282→        new_system_prompt (Optional[str]): if specified, prepend a system message. This can\n   283→            serve as instructions to guide the model response. Setting this will OVERRIDE any system\n   284→            messages already present in the dataset. Default is None.\n   285→\n   286→    Raises:\n   287→        ValueError: If ``column_map`` is provided and ``chosen`` not in ``column_map``, or\n   288→            ``rejected`` not in ``column_map``.\n   289→    \"\"\"\n   290→\n   291→    def __init__(\n   292→        self,\n   293→        train_on_input: bool = False,\n   294→        column_map: Optional[Dict[str, str]] = None,\n   295→        new_system_prompt: Optional[str] = None,\n   296→    ):\n   297→        self.train_on_input = train_on_input\n   298→        self.new_system_prompt = new_system_prompt\n   299→        if column_map:\n   300→            if \"chosen\" not in column_map:\n   301→                raise ValueError(\n   302→                    f\"Expected a key of 'chosen' in column_map but found {column_map.keys()}.\"\n   303→                )\n   304→            if \"rejected\" not in column_map:\n   305→                raise ValueError(\n   306→                    f\"Expected a key of 'rejected' in column_map but found {column_map.keys()}.\"\n   307→                )\n   308→            self._column_map = column_map\n   309→        else:\n   310→            self._column_map = {\"chosen\": \"chosen\", \"rejected\": \"rejected\"}\n   311→\n   312→    def __call__(self, sample: Mapping[str, Any]) -> Mapping[str, Any]:\n   313→        chosen_messages = []\n   314→        for message in sample[self._column_map[\"chosen\"]]:\n   315→            if message[\"role\"] == \"system\" and self.new_system_prompt is not None:\n   316→                continue\n   317→            message[\"masked\"] = (message[\"role\"] != \"assistant\") and (\n   318→                not self.train_on_input\n   319→            )\n   320→            chosen_messages.append(Message.from_dict(message))\n   321→\n   322→        rejected_messages = []\n   323→        for message in sample[self._column_map[\"rejected\"]]:\n   324→            if message[\"role\"] == \"system\" and self.new_system_prompt is not None:\n   325→                continue\n   326→            message[\"masked\"] = (message[\"role\"] != \"assistant\") and (\n   327→                not self.train_on_input\n   328→            )\n   329→            rejected_messages.append(Message.from_dict(message))\n   330→\n   331→        if self.new_system_prompt is not None:\n   332→            chosen_messages = [\n   333→                Message(\n   334→                    role=\"system\", content=self.new_system_prompt, masked=True, eot=True\n   335→                )\n   336→            ] + chosen_messages\n   337→            rejected_messages = [\n   338→                Message(\n   339→                    role=\"system\", content=self.new_system_prompt, masked=True, eot=True\n   340→                )\n   341→            ] + rejected_messages\n   342→\n   343→        return {\"chosen\": chosen_messages, \"rejected\": rejected_messages}\n   344→\n   345→\n   346→class ShareGPTToMessages(Transform):\n   347→    \"\"\"\n   348→    Convert a single chat sample adhering to the ShareGPT JSON structure to torchtune's :class:`~torchtune.data.Message`\n   349→    structure.\n   350→\n   351→    A single sample typically consists of a single optional system prompt and one or multiple\n   352→    turns of user and assistant messages.\n   353→\n   354→    ShareGPT follows::\n   355→\n   356→        {\n   357→            \"conversations\": [\n   358→                {\n   359→                    \"from\": <system|human|gpt>,\n   360→                    \"value\": <message>,\n   361→                },\n   362→                ...\n   363→            ]\n   364→        }\n   365→\n   366→    :class:`~torchtune.data.Message` follows::\n   367→\n   368→        [\n   369→            {\n   370→                \"role\": <system|user|assistant>,\n   371→                \"content\": <message>,\n   372→            },\n   373→            ...\n   374→        ]\n   375→\n   376→    Args:\n   377→        train_on_input (bool): whether the prompt should remain unmasked. For multimodal datasets, ``train_on_input``\n   378→            is always False and this value is ignored. Default: False\n   379→        column_map (Optional[Dict[str, str]]): a mapping from the expected columns (\"conversations\")\n   380→            to the new column names in the dataset. Key should be \"conversations\" and value should\n   381→            be the new column name. If None, keep the default \"conversations\".\n   382→            Default is None.\n   383→        new_system_prompt (Optional[str]): if specified, prepend a system message. This can\n   384→            serve as instructions to guide the model response. Setting this will OVERRIDE any system\n   385→            messages already present in the dataset. Default is None.\n   386→        image_dir (Optional[Path]): path to the directory containing the images that is prepended to all image\n   387→            paths in the dataset. For example, if ``image_dir=\"/home/user/dataset/\"` and the sample image path\n   388→            was ``\"images/1.jpg\"``, the final image path that will be loaded is ``\"/home/user/dataset/images/1.jpg\"``.\n   389→            If None, assume images are available in current working directory or are located\n   390→            on a remote url. For text-only, leave as None. Default is None.\n   391→        image_tag (Optional[str]): placeholder tags in the text content of each message to be replaced by image\n   392→            special tokens. If images are present and this is None, then will prepend image tokens to the first\n   393→            user message in the sample by default. If text-only, this field is ignored. Default is ``\"<image>\"``.\n   394→\n   395→    Raises:\n   396→        ValueError: If ``column_map`` is provided and ``conversations`` not in ``column_map``.\n   397→    \"\"\"\n   398→\n   399→    def __init__(\n   400→        self,\n   401→        train_on_input: bool = False,\n   402→        column_map: Optional[Dict[str, str]] = None,\n   403→        new_system_prompt: Optional[str] = None,\n   404→        image_dir: Optional[Path] = None,\n   405→        image_tag: Optional[str] = \"<image>\",\n   406→    ):\n   407→        self.train_on_input = train_on_input\n   408→        self.new_system_prompt = new_system_prompt\n   409→        if column_map:\n   410→            if \"conversations\" not in column_map:\n   411→                raise ValueError(\n   412→                    f\"Expected a key of 'conversations' in column_map but found {column_map.keys()}.\"\n   413→                )\n   414→            self._column_map = column_map\n   415→        else:\n   416→            self._column_map = {\"conversations\": \"conversations\", \"image\": \"image\"}\n   417→        self.image_dir = image_dir\n   418→        self.image_tag = image_tag\n   419→\n   420→    def __call__(self, sample: Mapping[str, Any]) -> Mapping[str, Any]:\n   421→        \"\"\"\n   422→        Return a list of Message objects from the provided sample dict.\n   423→\n   424→        Args:\n   425→            sample (Mapping[str, Any]): a single data sample with \"messages\" field pointing\n   426→                to a list of dict messages.\n   427→\n   428→        Returns:\n   429→            List[Message]: A list of messages with \"role\" and \"content\" fields.\n   430→        \"\"\"\n   431→        role_map = {\"system\": \"system\", \"human\": \"user\", \"gpt\": \"assistant\"}\n   432→        messages = []\n   433→        if self.new_system_prompt is not None:\n   434→            messages.append(\n   435→                Message(\n   436→                    role=\"system\", content=self.new_system_prompt, masked=True, eot=True\n   437→                )\n   438→            )\n   439→\n   440→        is_multimodal = \"image\" in sample or (\n   441→            \"image\" in self._column_map and self._column_map[\"image\"] in sample\n   442→        )\n   443→\n   444→        # Gate variable to ensure that we only prepend image tokens to the first user message\n   445→        image_loaded = False\n   446→        for message in sample[self._column_map[\"conversations\"]]:\n   447→            role = role_map[message[\"from\"]]\n   448→            content = message[\"value\"]\n   449→            if role == \"system\" and self.new_system_prompt is not None:\n   450→                continue\n   451→            if role == \"user\":\n   452→                if is_multimodal and not image_loaded:\n   453→                    image_path = sample[self._column_map[\"image\"]]\n   454→                    if self.image_dir is not None:\n   455→                        image_path = self.image_dir / image_path\n   456→                    pil_image = load_image(image_path)\n   457→                    # If image tag is not specified, prepend by default\n   458→                    if self.image_tag is None:\n   459→                        content = [\n   460→                            {\"type\": \"image\", \"content\": pil_image},\n   461→                            {\"type\": \"text\", \"content\": content},\n   462→                        ]\n   463→                    else:\n   464→                        content = format_content_with_images(\n   465→                            content,\n   466→                            image_tag=self.image_tag,\n   467→                            images=[pil_image],\n   468→                        )\n   469→                    image_loaded = True\n   470→\n   471→            # If multimodal and user message, always mask\n   472→            # Otherwise, if user message, mask if train_on_input is False\n   473→            masked = (role != \"assistant\") and (\n   474→                not self.train_on_input or is_multimodal\n   475→            )\n   476→            messages.append(Message(role=role, content=content, masked=masked))\n   477→\n   478→        return {\"messages\": messages}\n   479→\n   480→\n   481→class OpenAIToMessages(Transform):\n   482→    \"\"\"\n   483→    Convert a single chat sample adhering to the `OpenAI chat completion <https://platform.openai.com/docs/api-reference/chat>`_\n   484→    JSON structure to torchtune's :class:`~torchtune.data.Message` structure. This supports both\n   485→    text and image messages.\n   486→\n   487→    A single sample typically consists of a single optional system prompt and one or multiple\n   488→    turns of user and assistant messages.\n   489→\n   490→    For example::\n   491→\n   492→        {\n   493→            \"messages\": [\n   494→                {\n   495→                    \"role\": <system|user|assistant>,\n   496→                    \"content\": [\n   497→                        {\n   498→                            \"type\": \"text\",\n   499→                            \"text\": \"What'\\''s in this image?\",\n   500→                        },\n   501→                        {\n   502→                            \"type\": \"image_url\",\n   503→                            \"image_url\": {\n   504→                                \"url\": <url>,\n   505→                            },\n   506→                        },\n   507→                },\n   508→                ...\n   509→            ]\n   510→        }\n   511→\n   512→    :class:`~torchtune.data.Message` follows::\n   513→\n   514→        [\n   515→            {\n   516→                \"role\": <system|user|assistant>,\n   517→                \"content\": [\n   518→                    {\n   519→                        \"type\": \"text\",\n   520→                        \"content\": \"What'\\''s in this image?\",\n   521→                    },\n   522→                    {\n   523→                        \"type\": \"image\",\n   524→                        \"content\": <PIL.Image.Image>,\n   525→                    },\n   526→                ],\n   527→            },\n   528→            ...\n   529→        ]\n   530→\n   531→    Args:\n   532→        train_on_input (bool): whether the prompt should remain unmasked. Default: False\n   533→        column_map (Optional[Dict[str, str]]): a mapping from the expected columns (\"messages\")\n   534→            to the new column names in the dataset. Key should be \"messages\" and value should be\n   535→            the new column name. If None, keep the default \"messages\".\n   536→            Default is None.\n   537→        new_system_prompt (Optional[str]): if specified, prepend a system message. This can\n   538→            serve as instructions to guide the model response. Setting this will OVERRIDE any system\n   539→            messages already present in the dataset. Default is None.\n   540→\n   541→    Raises:\n   542→        ValueError: If ``column_map`` is provided and ``messages`` not in ``column_map``.\n   543→    \"\"\"\n   544→\n   545→    def __init__(\n   546→        self,\n   547→        train_on_input: bool = False,\n   548→        column_map: Optional[Dict[str, str]] = None,\n   549→        new_system_prompt: Optional[str] = None,\n   550→    ):\n   551→        self.train_on_input = train_on_input\n   552→        self.new_system_prompt = new_system_prompt\n   553→        if column_map:\n   554→            if \"messages\" not in column_map:\n   555→                raise ValueError(\n   556→                    f\"Expected a key of 'messages' in column_map but found {column_map.keys()}.\"\n   557→                )\n   558→            self._column_map = column_map\n   559→        else:\n   560→            self._column_map = {\"messages\": \"messages\"}\n   561→\n   562→    def _convert_from_openai_content(\n   563→        self, content: List[Dict[str, Any]]\n   564→    ) -> List[Dict[str, Any]]:\n   565→        \"\"\"Converts a list of content dicts from the OpenAI format to the torchtune format.\"\"\"\n   566→        converted_content = []\n   567→        for content_dict in content:\n   568→            if content_dict[\"type\"] == \"text\":\n   569→                converted_content.append(\n   570→                    {\"type\": \"text\", \"content\": content_dict[\"text\"]}\n   571→                )\n   572→            elif content_dict[\"type\"] == \"image_url\":\n   573→                converted_content.append(\n   574→                    {\n   575→                        \"type\": \"image\",\n   576→                        \"content\": load_image(content_dict[\"image_url\"][\"url\"]),\n   577→                    }\n   578→                )\n   579→        return converted_content\n   580→\n   581→    def __call__(self, sample: Mapping[str, Any]) -> Mapping[str, Any]:\n   582→        \"\"\"\n   583→        Return a list of Message objects from the provided sample dict.\n   584→\n   585→        Args:\n   586→            sample (Mapping[str, Any]): a single data sample with \"messages\" field pointing\n   587→                to a list of dict messages.\n   588→\n   589→        Returns:\n   590→            List[Message]: A list of messages with \"role\" and \"content\" fields.\n   591→        \"\"\"\n   592→        updated_messages = []\n   593→        if self.new_system_prompt is not None:\n   594→            updated_messages.append(\n   595→                Message(\n   596→                    role=\"system\", content=self.new_system_prompt, masked=True, eot=True\n   597→                )\n   598→            )\n   599→        for message in sample[self._column_map[\"messages\"]]:\n   600→            if message[\"role\"] == \"system\" and self.new_system_prompt is not None:\n   601→                continue\n   602→            masked = (message[\"role\"] != \"assistant\") and (not self.train_on_input)\n   603→            if isinstance(message[\"content\"], list):\n   604→                content = self._convert_from_openai_content(message[\"content\"])\n   605→            elif isinstance(message[\"content\"], str):\n   606→                content = message[\"content\"]\n   607→            updated_messages.append(\n   608→                Message(\n   609→                    role=message[\"role\"],\n   610→                    content=content,\n   611→                    masked=masked,\n   612→                ),\n   613→            )\n   614→\n   615→        return {\"messages\": updated_messages}\n   616→\n   617→\n   618→def validate_messages(\n   619→    messages: List[Message],\n   620→) -> None:\n   621→    \"\"\"\n   622→    Given a list of messages, ensure that messages form a valid\n   623→    back-and-forth conversation. An error will be raised if:\n   624→\n   625→    - There is a system message that's not the first message\n   626→    - There are two consecutive user messages\n   627→    - An assistant message comes before the first user message\n   628→    - The message is empty\n   629→    - Messages are shorter than length of 2 (min. one user-assistant turn)\n   630→\n   631→\n   632→    Args:\n   633→        messages (List[Message]): the messages to validate.\n   634→\n   635→    Raises:\n   636→        ValueError: If the messages are invalid.\n   637→    \"\"\"\n   638→    if len(messages) < 2:\n   639→        raise ValueError(\n   640→            f\"Messages must be at least length 2, but got {len(messages)} messages\"\n   641→        )\n   642→\n   643→    last_turn = \"assistant\"\n   644→    for i, message in enumerate(messages):\n   645→        if message.role == \"assistant\" and last_turn != \"user\":\n   646→            raise ValueError(\n   647→                f\"Assistant message before expected user message at index {i} in messages\"\n   648→            )\n   649→        if message.role == \"user\" and last_turn == \"user\":\n   650→            raise ValueError(\n   651→                f\"Two consecutive user messages at index {i} and {i - 1} in messages\"\n   652→            )\n   653→        if message.role == \"system\" and i > 0:\n   654→            raise ValueError(\n   655→                f\"System message at index {i} in messages, but system messages must come first\"\n   656→            )\n   657→        last_turn = message.role\n   658→\n   659→\n   660→class AlpacaToMessages(Transform):\n   661→    \"\"\"\n   662→    Message transform class for Alpaca-style datasets with \"instruction\", \"input\", and \"output\"\n   663→    (or equivalent fields specified in column_map) columns. User messages are formed from the\n   664→    instruction + input columns and assistant messages are formed from the output column. Prompt\n   665→    templating is conditional on the presence of the \"input\" column, and thus is handled directly\n   666→    in this transform class instead of a dedicated :class:`~torchtune.data.PromptTemplate` class\n   667→    due to this custom logic.\n   668→\n   669→    Args:\n   670→        train_on_input (bool): Whether the model is trained on the user prompt or not.\n   671→            Default is True.\n   672→        column_map (Optional[Dict[str, str]]): a mapping to change the expected \"instruction\", \"input\",\n   673→            and \"output\" column names to the actual column names in the dataset. Default is None,\n   674→            keeping the default column names.\n   675→    \"\"\"\n   676→\n   677→    def __init__(\n   678→        self, train_on_input: bool = True, column_map: Optional[Dict[str, str]] = None\n   679→    ):\n   680→        self.train_on_input = train_on_input\n   681→        self.column_map = column_map\n   682→        self.template = {\n   683→            \"prompt_input\": (\n   684→                \"Below is an instruction that describes a task, paired with an input that provides further context. \"\n   685→                \"Write a response that appropriately completes the request.\\n\\n\"\n   686→                \"### Instruction:\\n{instruction}\\n\\n### Input:\\n{input}\\n\\n### Response:\\n\"\n   687→            ),\n   688→            \"prompt_no_input\": (\n   689→                \"Below is an instruction that describes a task. \"\n   690→                \"Write a response that appropriately completes the request.\\n\\n\"\n   691→                \"### Instruction:\\n{instruction}\\n\\n### Response:\\n\"\n   692→            ),\n   693→        }\n   694→\n   695→    def __call__(self, sample: Mapping[str, Any]) -> Mapping[str, Any]:\n   696→        column_map = self.column_map or {}\n   697→        key_input = column_map.get(\"input\", \"input\")\n   698→        key_instruction = column_map.get(\"instruction\", \"instruction\")\n   699→        key_output = column_map.get(\"output\", \"output\")\n   700→\n   701→        if key_input in sample and sample[key_input]:\n   702→            prompt = self.template[\"prompt_input\"].format(\n   703→                instruction=sample[key_instruction], input=sample[key_input]\n   704→            )\n   705→        else:\n   706→            prompt = self.template[\"prompt_no_input\"].format(\n   707→                instruction=sample[key_instruction]\n   708→            )\n   709→\n   710→        messages = [\n   711→            Message(\n   712→                role=\"user\",\n   713→                content=prompt,\n   714→                masked=not self.train_on_input,\n   715→                eot=True,\n   716→            ),\n   717→            Message(\n   718→                role=\"assistant\",\n   719→                content=sample[key_output],\n   720→                masked=False,\n   721→                eot=True,\n   722→            ),\n   723→        ]\n   724→        return {\"messages\": messages}\n   725→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"292f5ccd-d06b-4b30-b4ca-2a2dee3cf466","uuid":"b2eb2600-8ec1-47e9-864f-c8ff81b8cf89","tool_use_result":{"type":"text","file":{"filePath":"/testbed/torchtune/data/_messages.py","content":"# Copyright (c) Meta Platforms, Inc. and affiliates.\n# All rights reserved.\n#\n# This source code is licensed under the BSD-style license found in the\n# LICENSE file in the root directory of this source tree.\n\nfrom pathlib import Path\nfrom typing import Any, Dict, List, Literal, Mapping, Optional, Union\n\nfrom torchtune.data._utils import format_content_with_images, load_image\n\nfrom torchtune.modules.transforms import Transform\n\nRole = Literal[\n    \"system\",  # Origin is system prompt\n    \"user\",  # Origin is user\n    \"assistant\",  # Origin is the model output\n    \"ipython\",  # Origin is return from a tool call\n]\n\n\nclass Message:\n    \"\"\"\n    This class represents individual messages in a fine-tuning dataset. It supports\n    text-only content, text with interleaved images, and tool calls. The :class:`~torchtune.modules.tokenizers.ModelTokenizer`\n    will tokenize the content of the message using ``tokenize_messages`` and attach\n    the appropriate special tokens based on the flags set in this class.\n\n    Args:\n        role (Role): role of the message writer. Can be \"system\" for system prompts,\n            \"user\" for human prompts, \"assistant\" for model responses, or \"ipython\"\n            for tool call returns.\n        content (Union[str, List[Dict[str, Any]]]): content of the message. If it is text only content,\n            you can pass in a string. If it is multimodal content, pass in a list of dictionaries formatted\n            as follows::\n\n                [\n                    {\"type\": \"image\", \"content\": <PIL.Image.Image>},\n                    {\"type\": \"text\", \"content\": \"What is in this image?\"},\n                ]\n\n        masked (bool): whether the message is masked in the sample. If True, do not use\n            in loss calculation. Default: False\n        ipython (bool): whether the message is a tool call. Default: False\n        eot (bool): whether the message corresponds to the end of a turn, where control is handed over\n            to the assistant from the user or the user from the assistant. Default: True. Should be true\n            in most cases except for:\n\n            - For multiple consecutive assistant messages (i.e., tool calls\n              by assistant), only the last assistant message will have ``eot=True``\n            - All ipython messages (tool call returns) should set ``eot=False``.\n\n    Note:\n        Message class expects any image content to be in\n        `PIL Image format <https://pillow.readthedocs.io/en/stable/reference/Image.html#PIL.Image.Image>`_.\n    \"\"\"\n\n    def __init__(\n        self,\n        role: Role,\n        content: Union[str, List[Dict[str, Any]]],\n        masked: bool = False,\n        ipython: bool = False,\n        eot: bool = True,\n    ):\n        self.role = role\n        self.content = self._convert_to_list_of_dict(content)\n        self.masked = masked\n        self.ipython = ipython\n        self.eot = eot\n\n        self._validate_message()\n\n    def _convert_to_list_of_dict(self, content) -> List[Dict[str, Any]]:\n        \"\"\"User is currently allowed to pass in a string for text-only content.\n        This ensures that the content is formatted as a list of dictionaries.\"\"\"\n        if isinstance(content, str):\n            return [{\"type\": \"text\", \"content\": content}]\n\n        assert isinstance(\n            content, list\n        ), f\"content must be of type List[Dict[str, Any]], got {content}\"\n\n        return content\n\n    @classmethod\n    def from_dict(cls, d: dict) -> \"Message\":\n        \"\"\"\n        Construct a Message from a dictionary.\n\n        Args:\n            d (dict): dictionary containing the fields of the Message.\n\n        Returns:\n            Message: constructed Message.\n        \"\"\"\n        return cls(\n            role=d[\"role\"],\n            content=d[\"content\"],\n            masked=d.get(\"masked\", False),\n            ipython=d.get(\"ipython\", False),\n            eot=d.get(\"eot\", True),\n        )\n\n    def get_media(self) -> List[\"PIL.Image.Image\"]:\n        \"\"\"\n        Returns media content of the message.\n        \"\"\"\n        return [\n            content[\"content\"] for content in self.content if content[\"type\"] == \"image\"\n        ]\n\n    @property\n    def contains_media(self) -> bool:\n        \"\"\"\n        Returns whether the message contains media.\n        \"\"\"\n        return any(content[\"type\"] == \"image\" for content in self.content)\n\n    @property\n    def text_content(self) -> str:\n        \"\"\"\n        Returns text-only content of the message.\n        \"\"\"\n        return \"\".join(\n            content[\"content\"] for content in self.content if content[\"type\"] == \"text\"\n        )\n\n    def _validate_message(self) -> None:\n        if self.ipython and self.contains_media:\n            raise ValueError(\n                f\"Media tokens in tool calls are not supported. Both are set in message: {self.text_content}\"\n            )\n        if self.ipython and self.role != \"assistant\":\n            raise ValueError(\n                f\"Only assistant messages can be tool calls. Found role {self.role} in message: {self.text_content}\"\n            )\n\n    def __repr__(self) -> str:\n        content_only = [content[\"content\"] for content in self.content]\n        return f\"Message(role='{self.role}', content={content_only!r})\"\n\n\nclass InputOutputToMessages(Transform):\n    \"\"\"\n    Message transform class that converts a single sample with \"input\" and \"output\" fields,\n    (or equivalent fields specified in column_map) to user and assistant messages,\n    respectively. This is useful for datasets that have two columns, one containing\n    the user prompt string and the other containing the model response string::\n\n        |  input          |  output          |\n        |-----------------|------------------|\n        | \"user prompt\"   | \"model response\" |\n\n    Args:\n        train_on_input (bool): Whether the model is trained on the user prompt or not.\n            Default is False.\n        column_map (Optional[Dict[str, str]]): a mapping to change the expected \"input\"\n            and \"output\" column names to the actual column names in the dataset. Keys should\n            be \"input\" and \"output\" and values should be the actual column names. Default is None,\n            keeping the default \"input\" and \"output\" column names.\n        new_system_prompt (Optional[str]): if specified, prepend a system message. This can\n            serve as instructions to guide the model response. Default is None.\n        image_dir (Optional[Path]): path to the directory containing the images that is prepended to all image\n            paths in the dataset. For example, if ``image_dir=\"/home/user/dataset/\"` and the sample image path\n            was ``\"images/1.jpg\"``, the final image path that will be loaded is ``\"/home/user/dataset/images/1.jpg\"``.\n            If None, assume images are available in current working directory or are located\n            on a remote url. For text-only, leave as None. Default is None.\n\n    Raises:\n        ValueError: If ``column_map`` is provided and ``input`` not in ``column_map``, or\n            ``output`` not in ``column_map``.\n    \"\"\"\n\n    def __init__(\n        self,\n        train_on_input: bool = False,\n        column_map: Optional[Dict[str, str]] = None,\n        new_system_prompt: Optional[str] = None,\n        image_dir: Optional[Path] = None,\n    ):\n        self.train_on_input = train_on_input\n        self.new_system_prompt = new_system_prompt\n\n        self.column_map = column_map\n\n        if self.column_map is not None:\n            if \"input\" not in self.column_map:\n                raise ValueError(\n                    f\"Expected a key of 'input' in column_map but found {self.column_map.keys()}.\"\n                )\n            if \"output\" not in self.column_map:\n                raise ValueError(\n                    f\"Expected a key of 'output' in column_map but found {self.column_map.keys()}.\"\n                )\n        else:\n            self.column_map = {\"input\": \"input\", \"output\": \"output\", \"image\": \"image\"}\n\n        self.image_dir = image_dir\n\n    def __call__(self, sample: Mapping[str, Any]) -> Mapping[str, Any]:\n        is_multimodal = \"image\" in sample or (\n            \"image\" in self.column_map and self.column_map[\"image\"] in sample\n        )\n\n        if is_multimodal:\n            image_path = sample[self.column_map[\"image\"]]\n            if isinstance(image_path, str):\n                if self.image_dir is not None:\n                    image_path = self.image_dir / image_path\n                # Load if not loaded\n                pil_image = load_image(image_path)\n            else:\n                pil_image = image_path\n            content = [\n                {\"type\": \"image\", \"content\": pil_image},\n                {\"type\": \"text\", \"content\": sample[self.column_map[\"input\"]]},\n            ]\n        else:\n            content = [{\"type\": \"text\", \"content\": sample[self.column_map[\"input\"]]}]\n\n        output_content = [\n            {\"type\": \"text\", \"content\": sample[self.column_map[\"output\"]]}\n        ]\n\n        messages = [\n            Message(\n                role=\"user\",\n                content=content,\n                masked=not self.train_on_input,\n                eot=True,\n            ),\n            Message(\n                role=\"assistant\",\n                content=output_content,\n                masked=False,\n                eot=True,\n            ),\n        ]\n        if self.new_system_prompt is not None:\n            messages = [\n                Message(\n                    role=\"system\", content=self.new_system_prompt, masked=True, eot=True\n                )\n            ] + messages\n        return {\"messages\": messages}\n\n\nclass ChosenRejectedToMessages(Transform):\n    \"\"\"\n    Transform for converting a single sample from datasets with \"chosen\" and \"rejected\" columns\n    containing conversations to a list of chosen and rejected messages. For example::\n\n        |  chosen                                |  rejected                              |\n        |----------------------------------------|----------------------------------------|\n        | [{\"role\": \"user\", \"content\": Q1},      | [{\"role\": \"user\", \"content\": Q1},      |\n        |  {\"role\": \"assistant\", \"content\": A1}] |  {\"role\": \"assistant\", \"content\": A2}] |\n\n    will be converted to:\n\n    .. code-block:: python\n\n        chosen = [\n            Message(role=\"user\", content=\"Q1\"),\n            Message(role=\"assistant\", content=\"A1\"),\n        ]\n        rejected = [\n            Message(role=\"user\", content=\"Q1\"),\n            Message(role=\"assistant\", content=\"A2\"),\n        ]\n\n    A single sample typically consists of a single optional system prompt and one or multiple\n    turns of user and assistant messages.\n\n    Args:\n        train_on_input (bool): Whether the model is trained on the user prompt or not.\n            Default is False.\n        column_map (Optional[Dict[str, str]]): a mapping to change the expected\n            \"chosen\" and \"rejected\" column names to the actual column names in the dataset.\n            Keys should be \"chosen\" and \"rejected\" and values should be the actual column names.\n            Default is None, keeping the default column names.\n        new_system_prompt (Optional[str]): if specified, prepend a system message. This can\n            serve as instructions to guide the model response. Setting this will OVERRIDE any system\n            messages already present in the dataset. Default is None.\n\n    Raises:\n        ValueError: If ``column_map`` is provided and ``chosen`` not in ``column_map``, or\n            ``rejected`` not in ``column_map``.\n    \"\"\"\n\n    def __init__(\n        self,\n        train_on_input: bool = False,\n        column_map: Optional[Dict[str, str]] = None,\n        new_system_prompt: Optional[str] = None,\n    ):\n        self.train_on_input = train_on_input\n        self.new_system_prompt = new_system_prompt\n        if column_map:\n            if \"chosen\" not in column_map:\n                raise ValueError(\n                    f\"Expected a key of 'chosen' in column_map but found {column_map.keys()}.\"\n                )\n            if \"rejected\" not in column_map:\n                raise ValueError(\n                    f\"Expected a key of 'rejected' in column_map but found {column_map.keys()}.\"\n                )\n            self._column_map = column_map\n        else:\n            self._column_map = {\"chosen\": \"chosen\", \"rejected\": \"rejected\"}\n\n    def __call__(self, sample: Mapping[str, Any]) -> Mapping[str, Any]:\n        chosen_messages = []\n        for message in sample[self._column_map[\"chosen\"]]:\n            if message[\"role\"] == \"system\" and self.new_system_prompt is not None:\n                continue\n            message[\"masked\"] = (message[\"role\"] != \"assistant\") and (\n                not self.train_on_input\n            )\n            chosen_messages.append(Message.from_dict(message))\n\n        rejected_messages = []\n        for message in sample[self._column_map[\"rejected\"]]:\n            if message[\"role\"] == \"system\" and self.new_system_prompt is not None:\n                continue\n            message[\"masked\"] = (message[\"role\"] != \"assistant\") and (\n                not self.train_on_input\n            )\n            rejected_messages.append(Message.from_dict(message))\n\n        if self.new_system_prompt is not None:\n            chosen_messages = [\n                Message(\n                    role=\"system\", content=self.new_system_prompt, masked=True, eot=True\n                )\n            ] + chosen_messages\n            rejected_messages = [\n                Message(\n                    role=\"system\", content=self.new_system_prompt, masked=True, eot=True\n                )\n            ] + rejected_messages\n\n        return {\"chosen\": chosen_messages, \"rejected\": rejected_messages}\n\n\nclass ShareGPTToMessages(Transform):\n    \"\"\"\n    Convert a single chat sample adhering to the ShareGPT JSON structure to torchtune's :class:`~torchtune.data.Message`\n    structure.\n\n    A single sample typically consists of a single optional system prompt and one or multiple\n    turns of user and assistant messages.\n\n    ShareGPT follows::\n\n        {\n            \"conversations\": [\n                {\n                    \"from\": <system|human|gpt>,\n                    \"value\": <message>,\n                },\n                ...\n            ]\n        }\n\n    :class:`~torchtune.data.Message` follows::\n\n        [\n            {\n                \"role\": <system|user|assistant>,\n                \"content\": <message>,\n            },\n            ...\n        ]\n\n    Args:\n        train_on_input (bool): whether the prompt should remain unmasked. For multimodal datasets, ``train_on_input``\n            is always False and this value is ignored. Default: False\n        column_map (Optional[Dict[str, str]]): a mapping from the expected columns (\"conversations\")\n            to the new column names in the dataset. Key should be \"conversations\" and value should\n            be the new column name. If None, keep the default \"conversations\".\n            Default is None.\n        new_system_prompt (Optional[str]): if specified, prepend a system message. This can\n            serve as instructions to guide the model response. Setting this will OVERRIDE any system\n            messages already present in the dataset. Default is None.\n        image_dir (Optional[Path]): path to the directory containing the images that is prepended to all image\n            paths in the dataset. For example, if ``image_dir=\"/home/user/dataset/\"` and the sample image path\n            was ``\"images/1.jpg\"``, the final image path that will be loaded is ``\"/home/user/dataset/images/1.jpg\"``.\n            If None, assume images are available in current working directory or are located\n            on a remote url. For text-only, leave as None. Default is None.\n        image_tag (Optional[str]): placeholder tags in the text content of each message to be replaced by image\n            special tokens. If images are present and this is None, then will prepend image tokens to the first\n            user message in the sample by default. If text-only, this field is ignored. Default is ``\"<image>\"``.\n\n    Raises:\n        ValueError: If ``column_map`` is provided and ``conversations`` not in ``column_map``.\n    \"\"\"\n\n    def __init__(\n        self,\n        train_on_input: bool = False,\n        column_map: Optional[Dict[str, str]] = None,\n        new_system_prompt: Optional[str] = None,\n        image_dir: Optional[Path] = None,\n        image_tag: Optional[str] = \"<image>\",\n    ):\n        self.train_on_input = train_on_input\n        self.new_system_prompt = new_system_prompt\n        if column_map:\n            if \"conversations\" not in column_map:\n                raise ValueError(\n                    f\"Expected a key of 'conversations' in column_map but found {column_map.keys()}.\"\n                )\n            self._column_map = column_map\n        else:\n            self._column_map = {\"conversations\": \"conversations\", \"image\": \"image\"}\n        self.image_dir = image_dir\n        self.image_tag = image_tag\n\n    def __call__(self, sample: Mapping[str, Any]) -> Mapping[str, Any]:\n        \"\"\"\n        Return a list of Message objects from the provided sample dict.\n\n        Args:\n            sample (Mapping[str, Any]): a single data sample with \"messages\" field pointing\n                to a list of dict messages.\n\n        Returns:\n            List[Message]: A list of messages with \"role\" and \"content\" fields.\n        \"\"\"\n        role_map = {\"system\": \"system\", \"human\": \"user\", \"gpt\": \"assistant\"}\n        messages = []\n        if self.new_system_prompt is not None:\n            messages.append(\n                Message(\n                    role=\"system\", content=self.new_system_prompt, masked=True, eot=True\n                )\n            )\n\n        is_multimodal = \"image\" in sample or (\n            \"image\" in self._column_map and self._column_map[\"image\"] in sample\n        )\n\n        # Gate variable to ensure that we only prepend image tokens to the first user message\n        image_loaded = False\n        for message in sample[self._column_map[\"conversations\"]]:\n            role = role_map[message[\"from\"]]\n            content = message[\"value\"]\n            if role == \"system\" and self.new_system_prompt is not None:\n                continue\n            if role == \"user\":\n                if is_multimodal and not image_loaded:\n                    image_path = sample[self._column_map[\"image\"]]\n                    if self.image_dir is not None:\n                        image_path = self.image_dir / image_path\n                    pil_image = load_image(image_path)\n                    # If image tag is not specified, prepend by default\n                    if self.image_tag is None:\n                        content = [\n                            {\"type\": \"image\", \"content\": pil_image},\n                            {\"type\": \"text\", \"content\": content},\n                        ]\n                    else:\n                        content = format_content_with_images(\n                            content,\n                            image_tag=self.image_tag,\n                            images=[pil_image],\n                        )\n                    image_loaded = True\n\n            # If multimodal and user message, always mask\n            # Otherwise, if user message, mask if train_on_input is False\n            masked = (role != \"assistant\") and (\n                not self.train_on_input or is_multimodal\n            )\n            messages.append(Message(role=role, content=content, masked=masked))\n\n        return {\"messages\": messages}\n\n\nclass OpenAIToMessages(Transform):\n    \"\"\"\n    Convert a single chat sample adhering to the `OpenAI chat completion <https://platform.openai.com/docs/api-reference/chat>`_\n    JSON structure to torchtune's :class:`~torchtune.data.Message` structure. This supports both\n    text and image messages.\n\n    A single sample typically consists of a single optional system prompt and one or multiple\n    turns of user and assistant messages.\n\n    For example::\n\n        {\n            \"messages\": [\n                {\n                    \"role\": <system|user|assistant>,\n                    \"content\": [\n                        {\n                            \"type\": \"text\",\n                            \"text\": \"What'\\''s in this image?\",\n                        },\n                        {\n                            \"type\": \"image_url\",\n                            \"image_url\": {\n                                \"url\": <url>,\n                            },\n                        },\n                },\n                ...\n            ]\n        }\n\n    :class:`~torchtune.data.Message` follows::\n\n        [\n            {\n                \"role\": <system|user|assistant>,\n                \"content\": [\n                    {\n                        \"type\": \"text\",\n                        \"content\": \"What'\\''s in this image?\",\n                    },\n                    {\n                        \"type\": \"image\",\n                        \"content\": <PIL.Image.Image>,\n                    },\n                ],\n            },\n            ...\n        ]\n\n    Args:\n        train_on_input (bool): whether the prompt should remain unmasked. Default: False\n        column_map (Optional[Dict[str, str]]): a mapping from the expected columns (\"messages\")\n            to the new column names in the dataset. Key should be \"messages\" and value should be\n            the new column name. If None, keep the default \"messages\".\n            Default is None.\n        new_system_prompt (Optional[str]): if specified, prepend a system message. This can\n            serve as instructions to guide the model response. Setting this will OVERRIDE any system\n            messages already present in the dataset. Default is None.\n\n    Raises:\n        ValueError: If ``column_map`` is provided and ``messages`` not in ``column_map``.\n    \"\"\"\n\n    def __init__(\n        self,\n        train_on_input: bool = False,\n        column_map: Optional[Dict[str, str]] = None,\n        new_system_prompt: Optional[str] = None,\n    ):\n        self.train_on_input = train_on_input\n        self.new_system_prompt = new_system_prompt\n        if column_map:\n            if \"messages\" not in column_map:\n                raise ValueError(\n                    f\"Expected a key of 'messages' in column_map but found {column_map.keys()}.\"\n                )\n            self._column_map = column_map\n        else:\n            self._column_map = {\"messages\": \"messages\"}\n\n    def _convert_from_openai_content(\n        self, content: List[Dict[str, Any]]\n    ) -> List[Dict[str, Any]]:\n        \"\"\"Converts a list of content dicts from the OpenAI format to the torchtune format.\"\"\"\n        converted_content = []\n        for content_dict in content:\n            if content_dict[\"type\"] == \"text\":\n                converted_content.append(\n                    {\"type\": \"text\", \"content\": content_dict[\"text\"]}\n                )\n            elif content_dict[\"type\"] == \"image_url\":\n                converted_content.append(\n                    {\n                        \"type\": \"image\",\n                        \"content\": load_image(content_dict[\"image_url\"][\"url\"]),\n                    }\n                )\n        return converted_content\n\n    def __call__(self, sample: Mapping[str, Any]) -> Mapping[str, Any]:\n        \"\"\"\n        Return a list of Message objects from the provided sample dict.\n\n        Args:\n            sample (Mapping[str, Any]): a single data sample with \"messages\" field pointing\n                to a list of dict messages.\n\n        Returns:\n            List[Message]: A list of messages with \"role\" and \"content\" fields.\n        \"\"\"\n        updated_messages = []\n        if self.new_system_prompt is not None:\n            updated_messages.append(\n                Message(\n                    role=\"system\", content=self.new_system_prompt, masked=True, eot=True\n                )\n            )\n        for message in sample[self._column_map[\"messages\"]]:\n            if message[\"role\"] == \"system\" and self.new_system_prompt is not None:\n                continue\n            masked = (message[\"role\"] != \"assistant\") and (not self.train_on_input)\n            if isinstance(message[\"content\"], list):\n                content = self._convert_from_openai_content(message[\"content\"])\n            elif isinstance(message[\"content\"], str):\n                content = message[\"content\"]\n            updated_messages.append(\n                Message(\n                    role=message[\"role\"],\n                    content=content,\n                    masked=masked,\n                ),\n            )\n\n        return {\"messages\": updated_messages}\n\n\ndef validate_messages(\n    messages: List[Message],\n) -> None:\n    \"\"\"\n    Given a list of messages, ensure that messages form a valid\n    back-and-forth conversation. An error will be raised if:\n\n    - There is a system message that's not the first message\n    - There are two consecutive user messages\n    - An assistant message comes before the first user message\n    - The message is empty\n    - Messages are shorter than length of 2 (min. one user-assistant turn)\n\n\n    Args:\n        messages (List[Message]): the messages to validate.\n\n    Raises:\n        ValueError: If the messages are invalid.\n    \"\"\"\n    if len(messages) < 2:\n        raise ValueError(\n            f\"Messages must be at least length 2, but got {len(messages)} messages\"\n        )\n\n    last_turn = \"assistant\"\n    for i, message in enumerate(messages):\n        if message.role == \"assistant\" and last_turn != \"user\":\n            raise ValueError(\n                f\"Assistant message before expected user message at index {i} in messages\"\n            )\n        if message.role == \"user\" and last_turn == \"user\":\n            raise ValueError(\n                f\"Two consecutive user messages at index {i} and {i - 1} in messages\"\n            )\n        if message.role == \"system\" and i > 0:\n            raise ValueError(\n                f\"System message at index {i} in messages, but system messages must come first\"\n            )\n        last_turn = message.role\n\n\nclass AlpacaToMessages(Transform):\n    \"\"\"\n    Message transform class for Alpaca-style datasets with \"instruction\", \"input\", and \"output\"\n    (or equivalent fields specified in column_map) columns. User messages are formed from the\n    instruction + input columns and assistant messages are formed from the output column. Prompt\n    templating is conditional on the presence of the \"input\" column, and thus is handled directly\n    in this transform class instead of a dedicated :class:`~torchtune.data.PromptTemplate` class\n    due to this custom logic.\n\n    Args:\n        train_on_input (bool): Whether the model is trained on the user prompt or not.\n            Default is True.\n        column_map (Optional[Dict[str, str]]): a mapping to change the expected \"instruction\", \"input\",\n            and \"output\" column names to the actual column names in the dataset. Default is None,\n            keeping the default column names.\n    \"\"\"\n\n    def __init__(\n        self, train_on_input: bool = True, column_map: Optional[Dict[str, str]] = None\n    ):\n        self.train_on_input = train_on_input\n        self.column_map = column_map\n        self.template = {\n            \"prompt_input\": (\n                \"Below is an instruction that describes a task, paired with an input that provides further context. \"\n                \"Write a response that appropriately completes the request.\\n\\n\"\n                \"### Instruction:\\n{instruction}\\n\\n### Input:\\n{input}\\n\\n### Response:\\n\"\n            ),\n            \"prompt_no_input\": (\n                \"Below is an instruction that describes a task. \"\n                \"Write a response that appropriately completes the request.\\n\\n\"\n                \"### Instruction:\\n{instruction}\\n\\n### Response:\\n\"\n            ),\n        }\n\n    def __call__(self, sample: Mapping[str, Any]) -> Mapping[str, Any]:\n        column_map = self.column_map or {}\n        key_input = column_map.get(\"input\", \"input\")\n        key_instruction = column_map.get(\"instruction\", \"instruction\")\n        key_output = column_map.get(\"output\", \"output\")\n\n        if key_input in sample and sample[key_input]:\n            prompt = self.template[\"prompt_input\"].format(\n                instruction=sample[key_instruction], input=sample[key_input]\n            )\n        else:\n            prompt = self.template[\"prompt_no_input\"].format(\n                instruction=sample[key_instruction]\n            )\n\n        messages = [\n            Message(\n                role=\"user\",\n                content=prompt,\n                masked=not self.train_on_input,\n                eot=True,\n            ),\n            Message(\n                role=\"assistant\",\n                content=sample[key_output],\n                masked=False,\n                eot=True,\n            ),\n        ]\n        return {\"messages\": messages}\n","numLines":725,"startLine":1,"totalLines":725}}},{"type":"assistant","message":{"id":"chatcmpl-D1S1n8MyjqZPwke9HEgRgLT8wRsKQ","type":"message","role":"assistant","content":[{"type":"tool_use","id":"call_QDqCZGJGXZBxi4laszgjl9Q1","name":"Glob","input":{"pattern":"**/tests/torchtune/data/**"}}],"model":"gpt-5-2025-08-07","stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":19084,"output_tokens":96},"context_management":null},"parent_tool_use_id":null,"session_id":"292f5ccd-d06b-4b30-b4ca-2a2dee3cf466","uuid":"a15883fd-f8cd-467b-875f-35d5f526687e"},{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_QDqCZGJGXZBxi4laszgjl9Q1","type":"tool_result","content":"/testbed/tests/torchtune/data/test_collate.py\n/testbed/tests/torchtune/data/test_prompt_templates.py\n/testbed/tests/torchtune/data/test_messages.py\n/testbed/tests/torchtune/data/test_data_utils.py\n/testbed/tests/torchtune/data/__pycache__/test_collate.cpython-311-pytest-7.4.0.pyc\n/testbed/tests/torchtune/data/__pycache__/test_prompt_templates.cpython-311-pytest-7.4.0.pyc\n/testbed/tests/torchtune/data/__pycache__/test_data_utils.cpython-311-pytest-7.4.0.pyc\n/testbed/tests/torchtune/data/__pycache__/test_messages.cpython-311-pytest-7.4.0.pyc"}]},"parent_tool_use_id":null,"session_id":"292f5ccd-d06b-4b30-b4ca-2a2dee3cf466","uuid":"08c95605-1f6d-41e7-a872-3115506eb5b7","tool_use_result":{"filenames":["/testbed/tests/torchtune/data/