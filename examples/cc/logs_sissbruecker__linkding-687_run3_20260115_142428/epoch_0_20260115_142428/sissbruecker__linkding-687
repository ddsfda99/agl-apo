str], delimiter: str = \",\"):\n    50\u2192    return delimiter.join(tag_names)\n    51\u2192\n    52\u2192\n    53\u2192class Bookmark(models.Model):\n    54\u2192    url = models.CharField(max_length=2048, validators=[BookmarkURLValidator()])\n    55\u2192    title = models.CharField(max_length=512, blank=True)\n    56\u2192    description = models.TextField(blank=True)\n    57\u2192    notes = models.TextField(blank=True)\n    58\u2192    website_title = models.CharField(max_length=512, blank=True, null=True)\n    59\u2192    website_description = models.TextField(blank=True, null=True)\n    60\u2192    web_archive_snapshot_url = models.CharField(max_length=2048, blank=True)\n    61\u2192    favicon_file = models.CharField(max_length=512, blank=True)\n    62\u2192    unread = models.BooleanField(default=False)\n    63\u2192    is_archived = models.BooleanField(default=False)\n    64\u2192    shared = models.BooleanField(default=False)\n    65\u2192    date_added = models.DateTimeField()\n    66\u2192    date_modified = models.DateTimeField()\n    67\u2192    date_accessed = models.DateTimeField(blank=True, null=True)\n    68\u2192    owner = models.ForeignKey(get_user_model(), on_delete=models.CASCADE)\n    69\u2192    tags = models.ManyToManyField(Tag)\n    70\u2192\n    71\u2192    @property\n    72\u2192    def resolved_title(self):\n    73\u2192        if self.title:\n    74\u2192            return self.title\n    75\u2192        elif self.website_title:\n    76\u2192            return self.website_title\n    77\u2192        else:\n    78\u2192            return self.url\n    79\u2192\n    80\u2192    @property\n    81\u2192    def resolved_description(self):\n    82\u2192        return self.website_description if not self.description else self.description\n    83\u2192\n    84\u2192    @property\n    85\u2192    def tag_names(self):\n    86\u2192        return [tag.name for tag in self.tags.all()]\n    87\u2192\n    88\u2192    def __str__(self):\n    89\u2192        return self.resolved_title + \" (\" + self.url[:30] + \"...)\"\n    90\u2192\n    91\u2192\n    92\u2192class BookmarkAsset(models.Model):\n    93\u2192    TYPE_SNAPSHOT = \"snapshot\"\n    94\u2192\n    95\u2192    CONTENT_TYPE_HTML = \"text/html\"\n    96\u2192\n    97\u2192    STATUS_PENDING = \"pending\"\n    98\u2192    STATUS_COMPLETE = \"complete\"\n    99\u2192    STATUS_FAILURE = \"failure\"\n   100\u2192\n   101\u2192    bookmark = models.ForeignKey(Bookmark, on_delete=models.CASCADE)\n   102\u2192    date_created = models.DateTimeField(auto_now_add=True, null=False)\n   103\u2192    file = models.CharField(max_length=2048, blank=True, null=False)\n   104\u2192    file_size = models.IntegerField(null=True)\n   105\u2192    asset_type = models.CharField(max_length=64, blank=False, null=False)\n   106\u2192    content_type = models.CharField(max_length=128, blank=False, null=False)\n   107\u2192    display_name = models.CharField(max_length=2048, blank=True, null=False)\n   108\u2192    status = models.CharField(max_length=64, blank=False, null=False)\n   109\u2192    gzip = models.BooleanField(default=False, null=False)\n   110\u2192\n   111\u2192    def save(self, *args, **kwargs):\n   112\u2192        if self.file:\n   113\u2192            try:\n   114\u2192                file_path = os.path.join(settings.LD_ASSET_FOLDER, self.file)\n   115\u2192                if os.path.isfile(file_path):\n   116\u2192                    self.file_size = os.path.getsize(file_path)\n   117\u2192            except Exception:\n   118\u2192                pass\n   119\u2192        super().save(*args, **kwargs)\n   120\u2192\n   121\u2192\n   122\u2192@receiver(post_delete, sender=BookmarkAsset)\n   123\u2192def bookmark_asset_deleted(sender, instance, **kwargs):\n   124\u2192    if instance.file:\n   125\u2192        filepath = os.path.join(settings.LD_ASSET_FOLDER, instance.file)\n   126\u2192        if os.path.isfile(filepath):\n   127\u2192            try:\n   128\u2192                os.remove(filepath)\n   129\u2192            except Exception as error:\n   130\u2192                logger.error(f\"Failed to delete asset file: {filepath}\", exc_info=error)\n   131\u2192\n   132\u2192\n   133\u2192class BookmarkForm(forms.ModelForm):\n   134\u2192    # Use URLField for URL\n   135\u2192    url = forms.CharField(validators=[BookmarkURLValidator()])\n   136\u2192    tag_string = forms.CharField(required=False)\n   137\u2192    # Do not require title and description in form as we fill these automatically if they are empty\n   138\u2192    title = forms.CharField(max_length=512, required=False)\n   139\u2192    description = forms.CharField(required=False, widget=forms.Textarea())\n   140\u2192    # Include website title and description as hidden field as they only provide info when editing bookmarks\n   141\u2192    website_title = forms.CharField(\n   142\u2192        max_length=512, required=False, widget=forms.HiddenInput()\n   143\u2192    )\n   144\u2192    website_description = forms.CharField(required=False, widget=forms.HiddenInput())\n   145\u2192    unread = forms.BooleanField(required=False)\n   146\u2192    shared = forms.BooleanField(required=False)\n   147\u2192    # Hidden field that determines whether to close window/tab after saving the bookmark\n   148\u2192    auto_close = forms.CharField(required=False)\n   149\u2192\n   150\u2192    class Meta:\n   151\u2192        model = Bookmark\n   152\u2192        fields = [\n   153\u2192            \"url\",\n   154\u2192            \"tag_string\",\n   155\u2192            \"title\",\n   156\u2192            \"description\",\n   157\u2192            \"notes\",\n   158\u2192            \"website_title\",\n   159\u2192            \"website_description\",\n   160\u2192            \"unread\",\n   161\u2192            \"shared\",\n   162\u2192            \"auto_close\",\n   163\u2192        ]\n   164\u2192\n   165\u2192    @property\n   166\u2192    def has_notes(self):\n   167\u2192        return self.instance and self.instance.notes\n   168\u2192\n   169\u2192\n   170\u2192class BookmarkSearch:\n   171\u2192    SORT_ADDED_ASC = \"added_asc\"\n   172\u2192    SORT_ADDED_DESC = \"added_desc\"\n   173\u2192    SORT_TITLE_ASC = \"title_asc\"\n   174\u2192    SORT_TITLE_DESC = \"title_desc\"\n   175\u2192\n   176\u2192    FILTER_SHARED_OFF = \"off\"\n   177\u2192    FILTER_SHARED_SHARED = \"yes\"\n   178\u2192    FILTER_SHARED_UNSHARED = \"no\"\n   179\u2192\n   180\u2192    FILTER_UNREAD_OFF = \"off\"\n   181\u2192    FILTER_UNREAD_YES = \"yes\"\n   182\u2192    FILTER_UNREAD_NO = \"no\"\n   183\u2192\n   184\u2192    params = [\"q\", \"user\", \"sort\", \"shared\", \"unread\"]\n   185\u2192    preferences = [\"sort\", \"shared\", \"unread\"]\n   186\u2192    defaults = {\n   187\u2192        \"q\": \"\",\n   188\u2192        \"user\": \"\",\n   189\u2192        \"sort\": SORT_ADDED_DESC,\n   190\u2192        \"shared\": FILTER_SHARED_OFF,\n   191\u2192        \"unread\": FILTER_UNREAD_OFF,\n   192\u2192    }\n   193\u2192\n   194\u2192    def __init__(\n   195\u2192        self,\n   196\u2192        q: str = None,\n   197\u2192        user: str = None,\n   198\u2192        sort: str = None,\n   199\u2192        shared: str = None,\n   200\u2192        unread: str = None,\n   201\u2192        preferences: dict = None,\n   202\u2192    ):\n   203\u2192        if not preferences:\n   204\u2192            preferences = {}\n   205\u2192        self.defaults = {**BookmarkSearch.defaults, **preferences}\n   206\u2192\n   207\u2192        self.q = q or self.defaults[\"q\"]\n   208\u2192        self.user = user or self.defaults[\"user\"]\n   209\u2192        self.sort = sort or self.defaults[\"sort\"]\n   210\u2192        self.shared = shared or self.defaults[\"shared\"]\n   211\u2192        self.unread = unread or self.defaults[\"unread\"]\n   212\u2192\n   213\u2192    def is_modified(self, param):\n   214\u2192        value = self.__dict__[param]\n   215\u2192        return value != self.defaults[param]\n   216\u2192\n   217\u2192    @property\n   218\u2192    def modified_params(self):\n   219\u2192        return [field for field in self.params if self.is_modified(field)]\n   220\u2192\n   221\u2192    @property\n   222\u2192    def modified_preferences(self):\n   223\u2192        return [\n   224\u2192            preference\n   225\u2192            for preference in self.preferences\n   226\u2192            if self.is_modified(preference)\n   227\u2192        ]\n   228\u2192\n   229\u2192    @property\n   230\u2192    def has_modifications(self):\n   231\u2192        return len(self.modified_params) > 0\n   232\u2192\n   233\u2192    @property\n   234\u2192    def has_modified_preferences(self):\n   235\u2192        return len(self.modified_preferences) > 0\n   236\u2192\n   237\u2192    @property\n   238\u2192    def query_params(self):\n   239\u2192        return {param: self.__dict__[param] for param in self.modified_params}\n   240\u2192\n   241\u2192    @property\n   242\u2192    def preferences_dict(self):\n   243\u2192        return {\n   244\u2192            preference: self.__dict__[preference] for preference in self.preferences\n   245\u2192        }\n   246\u2192\n   247\u2192    @staticmethod\n   248\u2192    def from_request(query_dict: QueryDict, preferences: dict = None):\n   249\u2192        initial_values = {}\n   250\u2192        for param in BookmarkSearch.params:\n   251\u2192            value = query_dict.get(param)\n   252\u2192            if value:\n   253\u2192                initial_values[param] = value\n   254\u2192\n   255\u2192        return BookmarkSearch(**initial_values, preferences=preferences)\n   256\u2192\n   257\u2192\n   258\u2192class BookmarkSearchForm(forms.Form):\n   259\u2192    SORT_CHOICES = [\n   260\u2192        (BookmarkSearch.SORT_ADDED_ASC, \"Added \u2191\"),\n   261\u2192        (BookmarkSearch.SORT_ADDED_DESC, \"Added \u2193\"),\n   262\u2192  