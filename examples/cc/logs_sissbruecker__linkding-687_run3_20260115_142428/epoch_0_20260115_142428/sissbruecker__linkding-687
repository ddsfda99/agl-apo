aram]\n   301\u2192\n   302\u2192            # Mark non-editable modified fields as hidden. That way, templates\n   303\u2192            # rendering a form can just loop over hidden_fields to ensure that\n   304\u2192            # all necessary search options are kept when submitting the form.\n   305\u2192            if search.is_modified(param) and param not in editable_fields:\n   306\u2192                self.fields[param].widget = forms.HiddenInput()\n   307\u2192\n   308\u2192\n   309\u2192class UserProfile(models.Model):\n   310\u2192    THEME_AUTO = \"auto\"\n   311\u2192    THEME_LIGHT = \"light\"\n   312\u2192    THEME_DARK = \"dark\"\n   313\u2192    THEME_CHOICES = [\n   314\u2192        (THEME_AUTO, \"Auto\"),\n   315\u2192        (THEME_LIGHT, \"Light\"),\n   316\u2192        (THEME_DARK, \"Dark\"),\n   317\u2192    ]\n   318\u2192    BOOKMARK_DATE_DISPLAY_RELATIVE = \"relative\"\n   319\u2192    BOOKMARK_DATE_DISPLAY_ABSOLUTE = \"absolute\"\n   320\u2192    BOOKMARK_DATE_DISPLAY_HIDDEN = \"hidden\"\n   321\u2192    BOOKMARK_DATE_DISPLAY_CHOICES = [\n   322\u2192        (BOOKMARK_DATE_DISPLAY_RELATIVE, \"Relative\"),\n   323\u2192        (BOOKMARK_DATE_DISPLAY_ABSOLUTE, \"Absolute\"),\n   324\u2192        (BOOKMARK_DATE_DISPLAY_HIDDEN, \"Hidden\"),\n   325\u2192    ]\n   326\u2192    BOOKMARK_DESCRIPTION_DISPLAY_INLINE = \"inline\"\n   327\u2192    BOOKMARK_DESCRIPTION_DISPLAY_SEPARATE = \"separate\"\n   328\u2192    BOOKMARK_DESCRIPTION_DISPLAY_CHOICES = [\n   329\u2192        (BOOKMARK_DESCRIPTION_DISPLAY_INLINE, \"Inline\"),\n   330\u2192        (BOOKMARK_DESCRIPTION_DISPLAY_SEPARATE, \"Separate\"),\n   331\u2192    ]\n   332\u2192    BOOKMARK_LINK_TARGET_BLANK = \"_blank\"\n   333\u2192    BOOKMARK_LINK_TARGET_SELF = \"_self\"\n   334\u2192    BOOKMARK_LINK_TARGET_CHOICES = [\n   335\u2192        (BOOKMARK_LINK_TARGET_BLANK, \"New page\"),\n   336\u2192        (BOOKMARK_LINK_TARGET_SELF, \"Same page\"),\n   337\u2192    ]\n   338\u2192    WEB_ARCHI