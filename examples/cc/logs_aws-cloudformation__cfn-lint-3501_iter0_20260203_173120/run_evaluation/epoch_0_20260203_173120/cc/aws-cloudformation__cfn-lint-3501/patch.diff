diff --git a/src/cfnlint/rules/parameters/Used.py b/src/cfnlint/rules/parameters/Used.py
index b0f6a0033..7617e98f5 100644
--- a/src/cfnlint/rules/parameters/Used.py
+++ b/src/cfnlint/rules/parameters/Used.py
@@ -22,6 +22,27 @@ class Used(CloudFormationLintRule):
     def match(self, cfn: Template) -> RuleMatches:
         matches: RuleMatches = []
 
+        # If the template uses AWS::Include via Fn::Transform we cannot reliably
+        # detect parameter usage from the included files. To avoid false positives
+        # (e.g., OpenAPI specs included in RestApi Body), disable this check.
+        for t in cfn.search_deep_keys("Fn::Transform"):
+            try:
+                transform_value = t[-1]
+                if isinstance(transform_value, dict):
+                    name = transform_value.get("Name")
+                    if isinstance(name, str) and name == "AWS::Include":
+                        self.logger.debug(
+                            (
+                                "Template contains Fn::Transform Name 'AWS::Include'. "
+                                "Disabling check %s to prevent false positives."
+                            ),
+                            self.id,
+                        )
+                        return matches
+            except Exception:  # pylint: disable=broad-except
+                # If anything goes wrong just continue as usual
+                pass
+
         le_refs = None
         if cfn.has_language_extensions_transform():
             le_refs = cfn.search_deep_keys("Ref")
