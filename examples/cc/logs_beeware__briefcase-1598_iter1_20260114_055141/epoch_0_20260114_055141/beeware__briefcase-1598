arget_python_version != (\n   417\u2192            self.tools.sys.version_info.major,\n   418\u2192            self.tools.sys.version_info.minor,\n   419\u2192        ):\n   420\u2192            self.logger.warning(\n   421\u2192                f\"\"\"\n   422\u2192*************************************************************************\n   423\u2192** WARNING: Python version mismatch!                                   **\n   424\u2192*************************************************************************\n   425\u2192\n   426\u2192    The system python3 provided by {app.target_image} is {app.python_version_tag}.\n   427\u2192    This is not the same as your local system ({self.python_version_tag}).\n   428\u2192\n   429\u2192    Ensure you have tested for Python version compatibility before\n   430\u2192    releasing this app.\n   431\u2192\n   432\u2192*************************************************************************\n   433\u2192\"\"\"\n   434\u2192            )\n   435\u2192\n   436\u2192    def verify_system_python(self):\n   437\u2192        \"\"\"Verify that the Python being used to run Briefcase is the default system\n   438\u2192        python.\n   439\u2192\n   440\u2192        Will raise an exception if the system Python isn't an obvious Python3, or the\n   441\u2192        Briefcase Python isn't the same version as the system Python.\n   442\u2192\n   443\u2192        Requires that the app tools have been verified.\n   444\u2192        \"\"\"\n   445\u2192        system_python_bin = Path(\"/usr/bin/python3\").resolve()\n   446\u2192        system_version = system_python_bin.name.split(\".\")\n   447\u2192        if system_version[0] != \"python3\" or len(system_version) == 1:\n   448\u2192            raise BriefcaseCommandError(\"Can't determine the system python version\")\n   449\u2192\n   450\u2192        if system_version[1] != str(self.tools.sys.version_info.minor):\n   451\u2192            raise BriefcaseCommandError(\n   452\u2192                f\"The version of Python being used to run Briefcase ({self.python_version_tag}) \"\n   453\u2192                f\"is not the system python3 (3.{system_version[1]}).\"\n   454\u2192            )\n   455\u2192\n   456\u2192    def _system_requirement_tools(self, app: AppConfig):\n   457\u2192        \"\"\"Utility method returning the packages and tools needed to verify system\n   458\u2192        requirements.\n   459\u2192\n   460\u2192        :param app: The app being built.\n   461\u2192        :returns: A triple containing (0) The list of package names that must\n   462\u2192            be installed at a bare minimum; (1) the arguments for the command\n   463\u2192            used to verify the existence of a package on a system, and (2)\n   464\u2192            the command used to install packages. All three values are `None`\n   465\u2192            if the system cannot be identified.\n   466\u2192        \"\"\"\n   467\u2192        if app.target_vendor_base == DEBIAN:\n   468\u2192            base_system_packages = [\"python3-dev\", \"build-essential\"]\n   469\u2192            system_verify = [\"dpkg\", \"-s\"]\n   470\u2192            system_installer = [\"apt\", \"install\"]\n   471\u2192        elif app.target_vendor_base == RHEL:\n   472\u2192            base_system_packages = [\n   473\u2192                \"python3-devel\",\n   474\u2192                \"gcc\",\n   475\u2192                \"make\",\n   476\u2192                \"pkgconf-pkg-config\",\n   477\u2192            ]\n   478\u2192            system_verify = [\"rpm\", \"-q\"]\n   479\u2192            system_installer = [\"dnf\", \"install\"]\n   480\u2192        elif app.target_vendor_base == SUSE:\n   481\u2192            base_system_packages = [\n   482\u2192                \"python3-devel\",\n   483\u2192                \"patterns-devel-base-devel_basis\",\n   484\u2192            ]\n   485\u2192            system_verify = [\"rpm\", \"-q\", \"--whatprovides\"]\n   486\u2192            system_installer = [\"zypper\", \"install\"]\n   487\u2192        elif app.target_vendor_base == ARCH:\n   488\u2192            base_system_packages = [\n   489\u2192                \"python3\",\n   490\u2192                \"base-devel\",\n   491\u2192            ]\n   492\u2192            system_verify = [\"pacman\", \"-Q\"]\n   493\u2192            system_installer = [\"pacman\", \"-Syu\"]\n   494\u2192        else:\n   495\u2192            base_system_packages = None\n   496\u2192            system_verify = None\n   497\u2192            system_installer = None\n   498\u2192\n   499\u2192        return (\n   500\u2192            base_system_packages,\n   501\u2192            system_verify,\n   502\u2192            system_installer,\n   503\u2192        )\n   504\u2192\n   505\u2192    def verify_system_packages(self, app: AppConfig):\n   506\u2192        \"\"\"Verify that the required system packages are installed.\n   507\u2192\n   508\u2192        :param app: The app being built.\n   509\u2192        \"\"\"\n   510\u2192        (\n   511\u2192            base_system_packages,\n   512\u2192            system_verify,\n   513\u2192            system_installer,\n   514\u2192        ) = self._system_requirement_tools(app)\n   515\u2192\n   516\u2192        if system_verify is None:\n   517\u2192            self.logger.warning(\n   518\u2192                \"\"\"\n   519\u2192*************************************************************************\n   520\u2192** WARNING: Can't verify system packages                               **\n   521\u2192*************************************************************************\n   522\u2192\n   523\u2192    Briefcase doesn't know how to verify the installation of system\n   524\u2192    packages on your Linux distribution. If you have any problems\n   525\u2192    building this app, ensure that the packages listed in the app's\n   526\u2192    `system_requires` setting have been installed.\n   527\u2192\n   528\u2192*************************************************************************\n   529\u2192\"\"\"\n   530\u2192            )\n   531\u2192            return\n   532\u2192\n   533\u2192        # Run a check for each package listed in the app's system_requires,\n   534\u2192        # plus the baseline system packages that are required.\n   535\u2192        missing = []\n   536\u2192        for package in base_system_packages + getattr(app, \"system_requires\", []):\n   537\u2192            try:\n   538\u2192                self.tools.subprocess.check_output(system_verify + [package])\n   539\u2192            except subprocess.CalledProcessError:\n   540\u2192                missing.append(package)\n   541\u2192\n   542\u2192        # If any required packages are missing, raise an error.\n   543\u2192        if missing:\n   544\u2192            raise BriefcaseCommandError(\n   545\u2192                f\"\"\"\\\n   546\u2192Unable to build {app.app_name} due to missing system dependencies. Run:\n   547\u2192\n   548\u2192    sudo {' '.join(system_installer)} {' '.join(missing)}\n   549\u2192\n   550\u2192to install the missing dependencies, and re-run Briefcase.\n   551\u2192\"\"\"\n   552\u2192            )\n   553\u2192\n   554\u2192    def verify_app_tools(self, app: AppConfig):\n   555\u2192        \"\"\"Verify App environment is prepared and available.\n   556\u2192\n   557\u2192        When Docker is used, create or update a Docker image for the App. Without\n   558\u2192        Docker, the host machine will be used as the App environment.\n   559\u2192\n   560\u2192        :param app: The application being built\n   561\u2192        \"\"\"\n   562\u2192        # Verifying the App context is idempotent; but we have some\n   563\u2192        # additional logic that we only want to run the first time through.\n   564\u2192        # Check (and store) the pre-verify app tool state.\n   565\u2192        verify_python = not hasattr(self.tools[app], \"app_context\")\n   566\u2192\n   567\u2192        if self.use_docker:\n   568\u2192            DockerAppContext.verify(\n   569\u2192                tools=self.tools,\n   570\u2192                app=app,\n   571\u2192                image_tag=self.docker_image_tag(app),\n   572\u2192                dockerfile_path=self.bundle_path(app) / \"Dockerfile\",\n   573\u2192                app_base_path=self.base_path,\n   574\u2192                host_bundle_path=self.bundle_path(app),\n   575\u2192                host_data_path=self.data_path,\n   576\u2192                python_version=app.python_version_tag,\n   577\u2192            )\n   578\u2192\n   579\u2192            # Check the system Python on the target system to see if it is\n   580\u2192            # compatible with Briefcase.\n   581\u2192            if verify_python:\n   582\u2192                self.verify_python(app)\n   583\u2192        else:\n   584\u2192            NativeAppContext.verify(tools=self.tools, app=app)\n   585\u2192\n   586\u2192            # Check the system Python on the target system to see if it is\n   587\u2192            # compatible with Briefcase, and that the required system packages\n   588\u2192            # are installed.\n   589\u2192            if verify_python:\n   590\u2192                self.verify_system_python()\n   591\u2192                self.verify_system_packages(app)\n   592\u2192\n   593\u2192        # Establish Docker as app context before letting super set subprocess\n   594\u2192        super().verify_app_tools(app)\n   595\u2192\n   596\u2192\n   597\u2192class LinuxSystemMixin(LinuxSystemMostlyPassiveMixin):\n   598\u2192    def verify_host(self):\n   599\u2192        \"\"\"If we're *not* using Docker, verify that we're actually on Linux.\"\"\"\n   600\u2192        super().verify_host()\n   601\u2192        if not self.use_docker:\n   602\u2192            if self.tools.host_os != \"Linux\":\n   603\u2192                raise UnsupportedHostError(self.supported_host_os_reason)\n   604\u2192\n   605\u2192\n   606\u2192class LinuxSystemCreateCommand(LinuxSystemMixin, LocalRequirementsMixin, CreateCommand):\n   607\u2192    description = \"Create and populate a Linux system project.\"\n   608\u2192\n   609\u2192    def output_format_template_context(self, app: AppConfig):\n   610\u2192        context = super().output_format_template_context(app)\n   611\u2192\n   612\u2192        # Linux system templates use the target codename, rather than\n   613\u2192        # the format \"system\" as the leaf of the bundle path\n   614\u2192        context[\"format\"] = app.target_codename\n   615\u2192\n   616\u2192        # The base template context includes the host Python version;\n   617\u2192        # override that with an app-specific Python version, allowing\n   618\u2192        # for the app to be built with the system Python.\n   619\u2192        context[\"python_version\"] = app.python_version_tag\n   620\u2192\n   621\u2192        # Add the docker base image\n   622\u2192        context[\"docker_base_image\"] = app.target_image\n   623\u2192\n   624\u2192        # Add the vendor base\n   625\u2192        context[\"vendor_base\"] = app.target_vendor_base\n   626\u2192\n   627\u2192        # Use the non-root user if Docker is not mapping usernames. Also use a non-root\n   628\u2192        # user if we're on macOS; user mapping doesn't alter Docker operation, but some\n   629\u2192        # packaging tools (e.g., Arch's makepkg) don't like running as root. If we're\n   630\u2192        # not using Docker, this will fall back to the template default, which should be\n   631\u2192        # enabling the root user. This might cause problems later, but it's part of a\n   632\u2192        # much bigger \"does the project need to be updated in light of configuration\n   633\u2192        # changes\" problem.\n   634\u2192        try:\n   635\u2192            context[\"use_non_root_user\"] = (\n   636\u2192                self.tools.host_os == \"Darwin\" or not self.tools.docker.is_user_mapped\n   637\u2192            )\n   638\u2192        except AttributeError:\n   639\u2192            pass  # ignore if not using Docker\n   640\u2192\n   641\u2192        return context\n   642\u2192\n   643\u2192\n   644\u2192class LinuxSystemUpdateCommand(LinuxSystemCreateCommand, UpdateCommand):\n   645\u2192    description = \"Update an existing Linux system project.\"\n   646\u2192\n   647\u2192\n   648\u2192class LinuxSystemOpenCommand(LinuxSystemMostlyPassiveMixin, DockerOpenCommand):\n   649\u2192    description = (\n   650\u2192        \"Open a shell in a Docker container for an existing Linux system project.\"\n   651\u2192    )\n   652\u2192\n   653\u2192\n   654\u2192class LinuxSystemBuildCommand(LinuxSystemMixin, BuildCommand):\n   655\u2192    description = \"Build a Linux system project.\"\n   656\u2192\n   657\u2192    def build_app(self, app: AppConfig, **kwargs):\n   658\u2192        \"\"\"Build an application.\n   659\u2192\n   660\u2192        :param app: The application to build\n   661\u2192        \"\"\"\n   662\u2192        self.logger.info(\"Building application...\", prefix=app.app_name)\n   663\u2192\n   664\u2192        self.logger.info(\"Build bootstrap binary...\")\n   665\u2192        with self.input.wait_bar(\"Building bootstrap binary...\"):\n   666\u2192            try:\n   667\u2192                # Build the bootstrap binary.\n   668\u2192                self.tools[app].app_context.run(\n   669\u2192                    [\n   670\u2192                        \"make\",\n   671\u2192                        \"-C\",\n   672\u2192                        \"bootstrap\",\n   673\u2192                        \"install\",\n   674\u2192                    ],\n   675\u2192                    check=True,\n   676\u2192                    cwd=self.bundle_path(app),\n   677\u2192                )\n   678\u2192            except subprocess.CalledProcessError as e:\n   679\u2192                raise BriefcaseCommandError(\n   680\u2192                    f\"Error building bootstrap binary for {app.app_name}.\"\n   681\u2192                ) from e\n   682\u2192\n   683\u2192        # Make the folder for docs\n   684\u2192        doc_folder = (\n   685\u2192            self.bundle_path(app)\n   686\u2192            / f\"{app.app_name}-{app.version}\"\n   687\u2192            / \"usr\"\n   688\u2192            / \"share\"\n   689\u2192            / \"doc\"\n   690\u2192            / app.app_name\n   691\u2192        )\n   692\u2192        doc_folder.mkdir(parents=True, exist_ok=True)\n   693\u2192\n   694\u2192        with self.input.wait_bar(\"Installing license...\"):\n   695\u2192            license_file = self.base_path / \"LICENSE\"\n   696\u2192            if license_file.is_file():\n   697\u2192                self.tools.shutil.copy(license_file, doc_folder / \"copyright\")\n   698\u2192            else:\n   699\u2192                raise BriefcaseCommandError(\n   700\u2192                    \"\"\"\\\n   701\u2192Your project does not contain a LICENSE file.\n   702\u2192\n   703\u2192Create a file named `LICENSE` in the same directory as your `pyproject.toml`\n   704\u2192with your app's licensing terms.\n   705\u2192\"\"\"\n   706\u2192                )\n   707\u2192\n   708\u2192        with self.input.wait_bar(\"Installing changelog...\"):\n   709\u2192            changelog = self.base_path / \"CHANGELOG\"\n   710\u2192            if changelog.is_file():\n   711\u2192                with changelog.open(encoding=\"utf-8\") as infile:\n   712\u2192                    outfile = gzip.GzipFile(\n   713\u2192                        doc_folder / \"changelog.gz\", mode=\"wb\", mtime=0\n   714                    )\n   715\u2192                    outfile.write(infile.read().encode(\"utf-8\"))\n   716\u2192                    outfile.close()\n   717\u2192            else:\n   718\u2192                raise BriefcaseCommandError(\n   719\u2192                    \"\"\"\\\n   720