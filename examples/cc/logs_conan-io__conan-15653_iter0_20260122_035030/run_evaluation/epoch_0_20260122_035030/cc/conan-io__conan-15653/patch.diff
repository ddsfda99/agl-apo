@@ -116,3 +116,15 @@ def test_wrong_range_option_syntax(version_range):
     but for now this test ensures we don't change it without realizing"""
     vr = VersionRange(version_range)
     assert all(cs.prerelease for cs in vr.condition_sets)
+
+
+def test_build_metadata_in_greater_equal_range():
+    r = VersionRange('>=1.0.0+2')
+    assert r.contains(Version('1.0.0+2'), None)
+    assert not r.contains(Version('1.0.0+1'), None)
+
+
+def test_build_metadata_in_less_than_range():
+    r = VersionRange('<1.0.0+2')
+    assert r.contains(Version('1.0.0+1'), None)
+    assert not r.contains(Version('1.0.0+2'), None)
