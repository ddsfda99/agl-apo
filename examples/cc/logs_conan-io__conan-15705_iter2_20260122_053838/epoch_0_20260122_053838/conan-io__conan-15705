initions_complex_strings():\n   316→    # https://github.com/conan-io/conan/issues/11043\n   317→    client = TestClient(path_with_spaces=False)\n   318→    profile = textwrap.dedent(r'''\n   319→        include(default)\n   320→        [conf]\n   321→        tools.build:defines+=[\"escape=partially \\\"escaped\\\"\"]\n   322→        tools.build:defines+=[\"spaces=me you\"]\n   323→        tools.build:defines+=[\"foobar=bazbuz\"]\n   324→        tools.build:defines+=[\"answer=42\"]\n   325→    ''')\n   326→\n   327→    conanfile = textwrap.dedent(r'''\n   328→        from conan import ConanFile\n   329→        from conan.tools.cmake import CMake, CMakeToolchain, cmake_layout\n   330→\n   331→        class Test(ConanFile):\n   332→            exports_sources = \"CMakeLists.txt\", \"src/*\"\n   333→            settings = \"os\", \"compiler\", \"arch\", \"build_type\"\n   334→\n   335→            def generate(self):\n   336→                tc = CMakeToolchain(self)\n   337→                tc.preprocessor_definitions[\"escape2\"] = \"partially \\\"escaped\\\"\"\n   338→                tc.preprocessor_definitions[\"spaces2\"] = \"me you\"\n   339→                tc.preprocessor_definitions[\"foobar2\"] = \"bazbuz\"\n   340→                tc.preprocessor_definitions[\"answer2\"] = 42\n   341→                tc.preprocessor_definitions[\"NOVALUE_DEF\"] = None\n   342→                tc.preprocessor_definitions.release[\"escape_release\"] = \"release partially \\\"escaped\\\"\"\n   343→                tc.preprocessor_definitions.release[\"spaces_release\"] = \"release me you\"\n   344→                tc.preprocessor_definitions.release[\"foobar_release\"] = \"release bazbuz\"\n   345→                tc.preprocessor_definitions.release[\"answer_release\"] = 42\n   346→                tc.preprocessor_definitions.release[\"NOVALUE_DEF_RELEASE\"] = None\n   347→\n   348→                tc.preprocessor_definitions.debug[\"escape_debug\"] = \"debug partially \\\"escaped\\\"\"\n 