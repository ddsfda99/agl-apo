  if isinstance(self._value, dict):\n   257→            self._value = {k: os.path.join(folder, v) for k, v in self._value.items()}\n   258→        elif isinstance(self._value, str):\n   259→            self._value = os.path.join(folder, self._value)\n   260→\n   261→\n   262→class Conf:\n   263→    # Putting some default expressions to check that any value could be false\n   264→    boolean_false_expressions = (\"0\", '\"0\"', \"false\", '\"false\"', \"off\")\n   265→\n   266→    def __init__(self):\n   267→        # It being ordered allows for Windows case-insensitive composition\n   268→        self._values = OrderedDict()  # {var_name: [] of values, including separators}\n   269→\n   270→    def __bool__(self):\n   271→        return bool(self._values)\n   272→\n   273→    def __repr__(self):\n   274→        return \"Conf: \" + repr(self._values)\n   275→\n   276→    def __eq__(self, other):\n   277→        \"\"\"\n   278→        :type other: Conf\n   279→        \"\"\"\n   280→        return other._values == self._values\n   281→\n   282→    def clear(self):\n   283→        self._values.clear()\n   284→\n   285→    def validate(self):\n   286→        for conf in self._values:\n   287→            self._check_conf_name(conf)\n   288→\n   289→    def items(self):\n   290→        # FIXME: Keeping backward compatibility\n   291→        for k, v in self._values.items():\n   292→            yield k, v.value\n   293→\n   294→    def get(self, conf_name, default=None, check_type=None, choices=None):\n   295→        \"\"\"\n   296→        Get all the values of the given configuration name.\n   297→\n   298→        :param conf_name: Name of the configuration.\n   299→        :param default: Default value in case of conf does not have the conf_name key.\n   300→        :param check_type: Check the conf type(value) is the same as the given by this param.\n   301→                           There are two default smart conversions for bool and str types.\n   302→        :param choices: list of possible values this conf can have, if value not in it, errors.\n   303→        \"\"\"\n   304→        # Skipping this check only the user.* configurations\n   305→        self._check_conf_name(conf_name)\n   306→\n   307→        conf_value = self._values.get(conf_name)\n   308→        if conf_value:\n   309→            v = conf_value.value\n   310→            if choices is not None and v not in choices:\n   311→                raise ConanException(f\"Unknown value '{v}' for '{conf_name}'\")\n   312→            # Some smart conversions\n   313→            if check_type is bool and not isinstance(v, bool):\n   314→                # Perhaps, user has introduced a \"false\", \"0\" or even \"off\"\n   315→                return str(v).lower() not in Conf.boolean_false_expressions\n   316→            elif check_type is str and not isinstance(v, str):\n   317→                return str(v)\n   318→            elif v is None:  # value was unset\n   319→                return default\n   320→            elif (check_type is not None and not isinstance(v, check_type) or\n   321→                  check_type is int and isinstance(v, bool)):\n   322→                raise ConanException(f\"[conf] {conf_name} must be a \"\n   323→                                     f\"{check_type.__name__}-like object. The value '{v}' \"\n   324→                                     f\"introduced is a {type(v).__name__} object\")\n   325→            return v\n   326→        else:\n   327→            return default\n   328→\n   329→    def pop(self, conf_name, default=None):\n   330→        \"\"\"\n   331→        Remove the given configuration, returning its value.\n   332→\n   333→        :param conf_name: Name of the configuration.\n   334→        :param default: Default value to return in case the configuration doesn't exist.\n   335→        :return:\n   336→        \"\"\"\n   337→        value = self.get(conf_name, default=default)\n   338→        self._values.pop(conf_name, Non