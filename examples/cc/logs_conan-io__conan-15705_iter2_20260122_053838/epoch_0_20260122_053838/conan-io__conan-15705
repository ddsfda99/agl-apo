ient.load(\"conanfile.py\")\n   289\u2192    pref = client.create(ref, conanfile=cf)\n   290\u2192    p_folder = client.get_latest_pkg_layout(pref).package()\n   291\u2192    assert not os.path.exists(os.path.join(p_folder, \"mylibs\"))\n   292\u2192    assert os.path.exists(os.path.join(p_folder, \"lib\"))\n   293\u2192\n   294\u2192    # Edit the cpp.package.libdirs and check if the library is placed anywhere else\n   295\u2192    cf = client.load(\"conanfile.py\")\n   296\u2192    cf = cf.replace(\"cmake_layout(self)\",\n   297\u2192                    'cmake_layout(self)\\n        self.cpp.package.libdirs = [\"mylibs\"]')\n   298\u2192\n   299\u2192    pref = client.create(ref, conanfile=cf)\n   300\u2192    p_folder = client.get_latest_pkg_layout(pref).package()\n   301\u2192    assert os.path.exists(os.path.join(p_folder, \"mylibs\"))\n   302\u2192    assert not os.path.exists(os.path.join(p_folder, \"lib\"))\n   303\u2192\n   304\u2192    b_folder = client.get_latest_pkg_layout(pref).build()\n   305\u2192    if platform.system() != \"Windows\":\n   306\u2192        gen_folder = os.path.join(b_folder, \"build\", \"Release\", \"generators\")\n   307\u2192    else:\n   308\u2192        gen_folder = os.path.join(b_folder, \"build\", \"generators\")\n   309\u2192\n   310\u2192    toolchain = client.load(os.path.join(gen_folder, \"conan_toolchain.cmake\"))\n   311\u2192    assert 'set(CMAKE_INSTALL_LIBDIR \"mylibs\")' in toolchain\n   312\u2192\n   313\u2192\n   314\u2192@pytest.mark.tool(\"cmake\")\n   315\u2192def test_cmake_toolchain_definitions_complex_strings():\n   316\u2192    # https://github.com/conan-io/conan/issues/11043\n   317\u2192    client = TestClient(path_with_spaces=False)\n   318\u2192    profile = textwrap.dedent(r'''\n   319\u2192        include(default)\n   320\u2192        [conf]\n   321\u2192        tools.build:defines+=[\"escape=partially \\\"escaped\\\"\"]\n   322\u2192        tools.build:defines+=[\"spaces=me you\"]\n   323\u2192        