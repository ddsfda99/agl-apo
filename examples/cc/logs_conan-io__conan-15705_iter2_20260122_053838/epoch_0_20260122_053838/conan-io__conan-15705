pile(r\"^(tools\\..+|tools):.*\")\n   126→USER_CONF_PATTERN = re.compile(r\"^(user\\..+|user):.*\")\n   127→\n   128→\n   129→def _is_profile_module(module_name):\n   130→    # These are the modules that are propagated to profiles and user recipes\n   131→    _profiles_modules_patterns = USER_CONF_PATTERN, TOOLS_CONF_PATTERN\n   132→    return any(pattern.match(module_name) for pattern in _profiles_modules_patterns)\n   133→\n   134→\n   135→# FIXME: Refactor all the next classes because they are mostly the same as\n   136→#        conan.tools.env.environment ones\n   137→class _ConfVarPlaceHolder:\n   138→    pass\n   139→\n   140→\n   141→class _ConfValue(object):\n   142→\n   143→    def __init__(self, name, value, path=False, update=None):\n   144→        if name != name.lower():\n   145→            raise ConanException(\"Conf '{}' must be lowercase\".format(name))\n   146→        self._name = name\n   147→        self._value = value\n   148→        self._value_type = type(value)\n   149→        self._path = path\n   150→        self._update = update\n   151→\n   152→    def __repr__(self):\n   153→        return repr(self._value)\n   154→\n   155→    @property\n   156→    def value(self):\n   157→        if self._value_type is list and _ConfVarPlaceHolder in self._value:\n   158→            v = self._value[:]\n   159→            v.remove(_ConfVarPlaceHolder)\n   160→            return v\n   161→        return self._value\n   162→\n   163→    def copy(self):\n   164→        # Using copy for when self._value is a mutable list\n   165→        return _ConfValue(self._name, copy.copy(self._value), self._path, self._update)\n   166→\n   167→    def dumps(self):\n   168→        if self._value is None:\n   169→            return \"{}=!\".format(self._name)  # unset\n   170→        elif self._value_type is list and _ConfVarPlaceHolder in self._value:\n   171→            v = self._value[:]\n   172→            v.remove(_ConfVarPlaceHolder)\n   173→            return \"{}={}\".format(self._name, v)\n   174→        else:\n   175→            return \"{}={}\".format(self._name, self._value)\n   176→\n   177→    def serialize(self):\n   178→        if self._value is None:\n   179→            _value = \"!\"  # unset\n   180→        elif self._value_type is list and _ConfVarPlaceHolder in self._value:\n   181→            v = self._value[:]\n   182→            v.remove(_ConfVarPlaceHolder)\n   183→            _value = v\n   184→        else:\n   185→            _value = self._value\n   186→        return {self._name: _value}\n   187\n   188→    def update(self, value):\n   189→        assert self._value_type is dict, \"Only dicts can be updated\"\n   190→        assert isinstance(value, dict), \"Only dicts can update\"\n   191→        self._value.update(value)\n   192→\n   193→    def remove(self, value):\n   194→        if self._value_type is list:\n   195→            self._value.remove(value)\n   196→        elif self._value_type is dict:\n   197→            self._value.pop(value, None)\n   198→\n   199→    def append(self, value):\n   200→        if self._value_type is not list:\n   201→            raise ConanException(\"Only list-like values can append other values.\")\n   202→\n   203→        if isinstance(value, list):\n   204→            self._value.extend(value)\n   205→        else:\n   206→            self._value.append(value)\n   207→\n   208→    def prepend(self, value):\n   209→        if self._value_type is not list:\n   210→            raise ConanException(\"Only list-like values can prepend other values.\")\n   211→\n   212→        if isinstance(value, list):\n   213→            self._value = value + self._value\n   214→        else:\n   215→            self._value.insert(0, value)\n   216→\n   217→    def compose_conf_value(self, other):\n   218→        \"\"\"\n   219→        self has precedence, the \"other\" will add/append if possible and not conflicting, but\n   220→        self mandates what to do. If self has define()