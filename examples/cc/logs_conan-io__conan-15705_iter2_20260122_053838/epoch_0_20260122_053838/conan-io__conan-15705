                        "content": "     1\u2192import json\n     2\u2192import os\n     3\u2192import platform\n     4\u2192import re\n     5\u2192import textwrap\n     6\u2192\n     7\u2192import pytest\n     8\u2192\n     9\u2192from conan.tools.cmake.presets import load_cmake_presets\n    10\u2192from conans.model.recipe_ref import RecipeReference\n    11\u2192from conan.tools.microsoft.visual import vcvars_command\n    12\u2192from conans.test.assets.cmake import gen_cmakelists\n    13\u2192from conans.test.assets.genconanfile import GenConanfile\n    14\u2192from conans.test.utils.tools import TestClient, TurboTestClient\n    15\u2192from conans.util.files import save, load, rmdir\n    16\u2192\n    17\u2192\n    18\u2192@pytest.mark.skipif(platform.system() != \"Windows\", reason=\"Only for windows\")\n    19\u2192@pytest.mark.parametrize(\"compiler, version, update, runtime\",\n    20\u2192                         [(\"msvc\", \"192\", None, \"dynamic\"),\n    21\u2192                          (\"msvc\", \"192\", \"6\", \"static\"),\n    22\u2192                          (\"msvc\", \"192\", \"8\", \"static\")])\n    23\u2192def test_cmake_toolchain_win_toolset(compiler, version, update, runtime):\n    24\u2192    client = TestClient(path_with_spaces=False)\n    25\u2192    settings = {\"compiler\": compiler,\n    26\u2192                \"compiler.version\": version,\n    27\u2192                \"compiler.update\": update,\n    28\u2192                \"compiler.cppstd\": \"17\",\n    29\u2192                \"compiler.runtime\": runtime,\n    30\u2192                \"build_type\": \"Release\",\n    31\u2192                \"arch\": \"x86_64\"}\n    32\u2192\n    33\u2192    # Build the profile according to the settings provided\n    34\u2192    settings = \" \".join('-s %s=\"%s\"' % (k, v) for k, v in settings.items() if v)\n    35\u2192\n    36\u2192    conanfile = GenConanfile().with_settings(\"os\", \"compiler\", \"build_type\", \"arch\").\\\n    37\u2192        with_generator(\"CMakeToolchain\")\n    38\u2192\n    39\u2192    client.save({\"conanfile.py\": conanfile})\n    40\u2192    client.run(\"install . {}\".format(settings))\n    41\u2192    toolchain = client.load(\"conan_toolchain.cmake\")\n    42\u2192    if update is not None:  # Fullversion\n    43\u2192        value = \"version=14.{}{}\".format(version[-1], update)\n    44\u2192    else:\n    45\u2192        value = \"v14{}\".format(version[-1])\n    46\u2192    assert 'set(CMAKE_GENERATOR_TOOLSET \"{}\" CACHE STRING \"\" FORCE)'.format(value) in toolchain\n    47\u2192\n    48\u2192\n    49\u2192def test_cmake_toolchain_user_toolchain():\n    50\u2192    client = TestClient(path_with_spaces=False)\n    51\u2192    conanfile = GenConanfile().with_settings(\"os\", \"compiler\", \"build_type\", \"arch\").\\\n    52\u2192        with_generator(\"CMakeToolchain\")\n    53\u2192    save(client.cache.new_config_path, \"tools.cmake.cmaketoolchain:user_toolchain+=mytoolchain.cmake\")\n    54\u2192\n    55\u2192    client.save({\"conanfile.py\": conanfile})\n    56\u2192    client.run(\"install .\")\n    57\u2192    toolchain = client.load(\"conan_toolchain.cmake\")\n    58\u2192    assert 'include(\"mytoolchain.cmake\")' in toolchain\n    59\u2192\n    60\u2192\n    61\u2192def test_cmake_toolchain_custom_toolchain():\n    62\u2192    client = TestClient(path_with_spaces=False)\n    63\u2192    conanfile = GenConanfile().with_settings(\"os\", \"compiler\", \"build_type\", \"arch\").\\\n    64\u2192        with_generator(\"CMakeToolchain\")\n    65\u2192    save(client.cache.new_config_path, \"tools.cmake.cmaketoolchain:toolchain_file=mytoolchain.cmake\")\n    66\u2192\n    67\u2192    client.save({\"conanfile.py\": conanfile})\n    68\u2192    client.run(\"install .\")\n    69\u2192    assert not os.path.exists(os.path.join(client.current_folder, \"conan_toolchain.cmake\"))\n    70\u2192    presets = load_cmake_presets(client.current_folder)\n    71\u2192    assert \"mytoolchain.cmake\" in presets[\"configurePresets\"][0][\"toolchainFile\"]\n    72\u2192    assert \"binaryDir\" in presets[\"configurePresets\"][0]\n    73\u2192\n    74\u2192\n    75\u2192@pytest.mark.skipif(platform.system() != \"Darwin\",\n    76\u2192                    reason=\"Single config test, Linux CI still without 3.23\")\n    77\u2192@pytest.mark.tool(\"cmake\", \"3.23\")\n    78\u2192@pytest.mark.parametrize(\"existing_user_presets\", [None, \"user_provided\", \"conan_generated\"])\n    79\u2192@pytest.mark.parametrize(\"schema2\", [True, False])\n    80\u2192def test_cmake_user_presets_load(existing_user_presets, schema2):\n    81\u2192    \"\"\"\n    82\u2192    Test if the CMakeUserPresets.cmake is generated and use CMake to use it to verify the right\n    83\u2192    syntax of generated CMakeUserPresets.cmake and CMakePresets.cmake. If the user already provided\n    84\u2192    a CMakeUserPresets.cmake, leave the file untouched, and only generate or modify the file if\n    85\u2192    the `conan` object exists in the `vendor` field.\n    86\u2192    \"\"\"\n    87\u2192    t = TestClient()\n    88\u2192    t.run(\"new -d name=mylib -d version=1.0 -f cmake_lib\")\n    89\u2192    t.run(\"create . -s:h build_type=Release\")\n    90\u2192    t.run(\"create . -s:h build_type=Debug\")\n    91\u2192\n    92\u2192    consumer = textwrap.dedent(\"\"\"\n    93\u2192        from conan import ConanFile\n    94\u2192        from conan.tools.cmake import cmake_layout\n    95\u2192\n    96\u2192        class Consumer(ConanFile):\n    97\u2192\n    98\u2192            settings = \"build_type\", \"os\", \"arch\", \"compiler\"\n    99\u2192            requires = \"mylib/1.0\"\n   100\u2192            generators = \"CMakeToolchain\", \"CMakeDeps\"\n   101\u2192\n   102\u2192            def layout(self):\n   103\u2192                cmake_layout(self)\n   104\u2192\n   105\u2192    \"\"\")\n   106\u2192\n   107\u2192    cmakelist = textwrap.dedent(\"\"\"\n   108\u2192        cmake_minimum_required(VERSION 3.1)\n   109\u2192        project(PackageTest CXX)\n   110\u2192        find_package(mylib REQUIRED CONFIG)\n   111\u2192        \"\"\")\n   112\u2192\n   113\u2192    user_presets = None\n   114\u2192    if existing_user_presets == \"user_provided\":\n   115\u2192        user_presets = \"{}\"\n   116\u2192    elif existing_user_presets == \"conan_generated\":\n   117\u2192        user_presets = '{ \"vendor\": {\"conan\": {} } }'\n   118\u2192\n   119\u2192    files_to_save = {\"conanfile.py\": consumer, \"CMakeLists.txt\": cmakelist}\n   120\u2192\n   121\u2192    if user_presets:\n   122\u2192        files_to_save['CMakeUserPresets.json'] = user_presets\n   123\u2192    t.save(files_to_save, clean_first=True)\n   124\u2192    t.run(\"install . -s:h build_type=Debug -g CMakeToolchain\")\n   125\u2192    t.run(\"install . -s:h build_type=Release -g CMakeToolchain\")\n   126\u2192\n   127\u2192    user_presets_path = os.path.join(t.current_folder, \"CMakeUserPresets.json\")\n   128\u2192    assert os.path.exists(user_presets_path)\n   129\u2192\n   130\u2192    user_presets_data = json.loads(load(user_presets_path))\n   131\u2192    if existing_user_presets == \"user_provided\":\n   132\u2192        assert not user_presets_data\n   133\u2192    else:\n   134\u2192        assert \"include\" in user_presets_data.keys()\n   135\u2192\n   136\u2192    if existing_user_presets is None:\n   137\u2192        t.run_command(\"cmake . --preset conan-release\")\n   138\u2192        assert 'CMAKE_BUILD_TYPE=\"Release\"' in t.out\n   139\u2192        t.run_command(\"cmake . --preset conan-debug\")\n   140\u2192        assert 'CMAKE_BUILD_TYPE=\"Debug\"' in t.out\n   141\u2192\n   142\u2192\n   143\u2192def test_cmake_toolchain_user_toolchain_from_dep():\n   144\u2192    client = TestClient()\n   145\u2192    conanfile = textwrap.dedent(\"\"\"\n   146\u2192        import os\n   147\u2192        from conan import ConanFile\n   148\u2192        from conan.tools.files import copy\n   149\u2192        class Pkg(ConanFile):\n   150\u2192            exports_sources = \"*\"\n   151\u2192            def package(self):\n   152\u2192                copy(self, \"*\", self.build_folder, self.package_folder)\n   153\u2192            def package_info(self):\n   154\u2192                f = os.path.join(self.package_folder, \"mytoolchain.cmake\")\n   155\u2192                self.conf_info.append(\"tools.cmake.cmaketoolchain:user_toolchain\", f)\n   156\u2192        \"\"\")\n   157\u2192    client.save({\"conanfile.py\": conanfile,\n   158\u2192                 \"mytoolchain.cmake\": 'message(STATUS \"mytoolchain.cmake !!!running!!!\")'})\n   159\u2192    client.run(\"create . --name=toolchain --version=0.1\")\n   160\u2192\n   161\u2192    conanfile = textwrap.dedent(\"\"\"\n   162\u2192        from conan import ConanFile\n   163\u2192        from conan.tools.cmake import CMake\n   164\u2192        class Pkg(ConanFile):\n   165\u2192            settings = \"os\", \"compiler\", \"arch\", \"build_type\"\n   166\u2192            exports_sources = \"CMakeLists.txt\"\n   167\u2192            build_requires = \"toolchain/0.1\"\n   168\u2192            generators = \"CMakeToolchain\"\n   169\u2192            def build(self):\n   170\u2192                cmake = CMake(self)\n   171\u2192                cmake.configure()\n   172\u2192        \"\"\")\n   173\u2192\n   174\u2192    client.save({\"conanfile.py\": conanfile,\n   175\u2192                 \"CMakeLists.txt\": gen_cmakelists()}, clean_first=True)\n   176\u2192    client.run(\"create . --name=pkg --version=0.1\")\n   177\u2192    assert \"mytoolchain.cmake !!!running!!!\" in client.out\n   178\u2192\n   179\u2192\n   180\u2192def test_cmake_toolchain_without_build_type():\n   181\u2192    # If \"build_type\" is not defined, toolchain will still be generated, it will not crash\n   182\u2192    # Main effect is CMAKE_MSVC_RUNTIME_LIBRARY not being defined\n   183\u2192    client = TestClient(path_with_spaces=False)\n   184\u2192    conanfile = GenConanfile().with_settings(\"os\", \"compiler\", \"arch\").\\\n   185\u2192        with_generator(\"CMakeToolchain\")\n   186\u2192\n   187\u2192    client.save({\"conanfile.py\": conanfile})\n   188\u2192    client.run(\"install .\")\n   189\u2192    toolchain = client.load(\"conan_toolchain.cmake\")\n   190\u2192    assert \"CMAKE_MSVC_RUNTIME_LIBRARY\" not in toolchain\n   191\u2192    assert \"CMAKE_BUILD_TYPE\" not in toolchain\n   192\u2192\n   193\u2192\n   194\u2192@pytest.mark.tool(\"cmake\")\n   195\u2192def test_cmake_toolchain_multiple_user_toolchain():\n   196\u2192    \"\"\" A consumer consuming two packages that declare:\n   197\u2192            self.conf_info[\"tools.cmake.cmaketoolchain:user_toolchain\"]\n   198\u2192        The consumer wants to use apply both toolchains in the CMakeToolchain.\n   199\u2192        There are two ways to customize the CMakeToolchain (parametrized):\n   200\u2192                1. Altering the context of the block (with_context = True)\n   201\u2192                2. Using the t.blocks[\"user_toolchain\"].user_toolchains = [] (with_context = False)\n   202\u2192    \"\"\"\n   203\u2192    client = TestClient()\n   204\u2192    conanfile = textwrap.dedent(\"\"\"\n   205\u2192        import os\n   206\u2192        from conan import ConanFile\n   207\u2192        from conan.tools.files import copy\n   208\u2192        class Pkg(ConanFile):\n   209\u2192            exports_sources = \"*\"\n   210\u2192            def package(self):\n   211\u2192                copy(self, \"*\", self.source_folder, self.package_folder)\n   212\u2192            def package_info(self):\n   213\u2192                f = os.path.join(self.package_folder, \"mytoolchain.cmake\")\n   214\u2192                self.conf_info.append(\"tools.cmake.cmaketoolchain:user_toolchain\", f)\n   215\u2192        \"\"\")\n   216\u2192    client.save({\"conanfile.py\": conanfile,\n   217\u2192                 \"mytoolchain.cmake\": 'message(STATUS \"mytoolchain1.cmake !!!running!!!\")'})\n   218\u2192    client.run(\"create . --name=toolchain1 --version=0.1\")\n   219\u2192    client.save({\"conanfile.py\": conanfile,\n   220\u2192                 \"mytoolchain.cmake\": 'message(STATUS \"mytoolchain2.cmake !!!running!!!\")'})\n   221\u2192    client.run(\"create . --name=toolchain2 --version=0.1\")\n   222\u2192\n   223\u2192    conanfile = textwrap.dedent(\"\"\"\n   224\u2192        from conan import ConanFile\n   225\u2192        from conan.tools.cmake import CMake, CMakeToolchain\n   226\u2192        class Pkg(ConanFile):\n   227\u2192            settings = \"os\", \"compiler\", \"arch\", \"build_type\"\n   228\u2192            exports_sources = \"CMakeLists.txt\"\n   229\u2192            tool_requires = \"toolchain1/0.1\", \"toolchain2/0.1\"\n   230\u2192            generators = \"CMakeToolchain\"\n   231\u2192\n   232\u2192            def build(self):\n   233\u2192                cmake = CMake(self)\n   234\u2192                cmake.configure()\n   235\u2192        \"\"\")\n   236\u2192\n   237\u2192    client.save({\"conanfile.py\": conanfile,\n   238\u2192                 \"CMakeLists.txt\": gen_cmakelists()}, clean_first=True)\n   239\u2192    client.run(\"create . --name=pkg --version=0.1\")\n   240\u2192    assert \"mytoolchain1.cmake !!!running!!!\" in client.out\n   241\u2192    assert \"mytoolchain2.cmake !!!running!!!\" in client.out\n   242\u2192    assert \"CMake Warning\" not in client.out\n   243\u2192\n   244\u2192\n   245\u2192@pytest.mark.tool(\"cmake\")\n   246\u2192def test_cmaketoolchain_no_warnings():\n   247\u2192    \"\"\"Make sure uninitialized variables do not cause any warnings, passing -Werror=dev\n   248\u2192    and --warn-uninitialized, calling \"cmake\" with conan_toolchain.cmake used to fail\n   249\u2192    \"\"\"\n   250\u2192    # Issue https://github.com/conan-io/conan/issues/10288\n   251\u2192 