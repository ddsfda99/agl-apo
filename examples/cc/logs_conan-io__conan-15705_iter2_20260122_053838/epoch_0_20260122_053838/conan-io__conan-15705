sert os.path.exists(os.path.join(client.current_folder,\n   796→                                           \"build\", \"{}-release-{}\".format(default_compiler, shared_str),\n   797→                                           \"generators\"))\n   798→\n   799→    client.run(\"install . {}\".format(conf_layout))\n   800→    assert os.path.exists(os.path.join(client.current_folder,\n   801→                                       \"build\", \"{}-release-static\".format(default_compiler),\n   802→                                       \"generators\"))\n   803→\n   804→    user_presets_path = os.path.join(client.current_folder, \"CMakeUserPresets.json\")\n   805→    assert os.path.exists(user_presets_path)\n   806→\n   807→    # We can build with cmake manually\n   808→    if platform.system() == \"Darwin\":\n   809→        for shared in (True, False):\n   810→            shared_str = \"shared\" if shared else \"static\"\n   811→            client.run_command(\"cmake . --preset conan-apple-clang-release-{}\".format(shared_str))\n   812→            client.run_command(\"cmake --build --preset conan-apple-clang-release-{}\".format(shared_str))\n   813→            client.run_command(\"ctest --preset conan-apple-clang-release-{}\".format(shared_str))\n   814→            the_lib = \"libhello.a\" if not shared else \"libhello.dylib\"\n   815→            path = os.path.join(client.current_folder,\n   816→                                \"build\", \"apple-clang-release-{}\".format(shared_str), the_lib)\n   817→            assert os.path.exists(path)\n   818→\n   819→\n   820→@pytest.mark.tool(\"cmake\", \"3.23\")\n   821→@pytest.mark.skipif(platform.system() != \"Windows\", reason=\"Needs windows\")\n   822→def test_cmake_presets_multiple_settings_multi_config():\n   823→    client = TestClient(path_with_spaces=False)\n   824→    client.run(\"new cmake_exe -d name=hello -d version=0.1\")\n   825→    settings_layout = '-c tools.cmake.cmake_layout:build_folder_vars=' \\\n   826→                      '\\'[\"settings.compiler.runtime\", \"settings.compiler.cppstd\"]\\''\n   827→\n   828→    user_presets_path = os.path.join(client.current_folder, \"CMakeUserPresets.json\")\n   829→\n   830→    # Check that all generated names are expected, both in the layout and in the Presets\n   831→    settings = \"-s compiler=msvc -s compiler.version=191 -s compiler.runtime=dynamic \" \\\n   832→               \"-s compiler.cppstd=14\"\n   833→    client.run(\"install . {} {}\".format(settings, settings_layout))\n   834→    assert os.path.exists(os.path.join(client.current_folder, \"build\", \"dynamic-14\", \"generators\"))\n   835→    assert os.path.exists(user_presets_path)\n   836→    user_presets = json.loads(load(user_presets_path))\n   837→    assert len(user_presets[\"include\"]) == 1\n   838→    presets = json.loads(load(user_presets[\"include\"][0]))\n   839→    assert len(presets[\"configurePresets\"]) == 1\n   840→    assert len(presets[\"buildPresets\"]) == 1\n   841→    assert len(presets[\"testPresets\"]) == 1\n   842→    assert presets[\"configurePresets\"][0][\"name\"] == \"conan-dynamic-14\"\n   843→    assert presets[\"buildPresets\"][0][\"name\"] == \"conan-dynamic-14-release\"\n   844→    assert presets[\"buildPresets\"][0][\"configurePreset\"] == \"conan-dynamic-14\"\n   845→    assert presets[\"testPresets\"][0][\"name\"] == \"conan-dynamic-14-release\"\n   846→    assert presets[\"testPresets\"][0][\"configurePreset\"] == \"conan-dynamic-14\"\n   847→\n   848→    # If we create the \"Debug\" one, it has the same toolchain and preset file, that is\n   849→    # always multiconfig\n   850→    client.run(\"install . {} -s build_type=Debug {}\".format(settings, settings_layout))\n   851→    assert os.path.exists(os.path.join(client.current_folder, \"build\", \"dynamic-14\", \"generators\"))\n   852→    assert os.path.exists(user_presets_path)\n   853→    user_presets = json.loads(load(user_presets_path))\n   854→    assert len(user_presets[\"include\"]) == 1\n   855→    presets = json.loads(load(user_presets[\"include\"][0]))\n   856→    assert len(presets[\"configurePresets\"]) == 1\n   857→    assert len(presets[\"buildPresets\"]) == 2\n   858→    assert len(presets[\"testPresets\"]) == 2\n   859→    assert presets[\"configurePresets\"][0][\"name\"] == \"conan-dynamic-14\"\n   860→    assert presets[\"buildPresets\"][0][\"name\"] == \"conan-dynamic-14-release\"\n   861→    assert presets[\"buildPresets\"][1][\"name\"] == \"conan-dynamic-14-debug\"\n   862→    assert presets[\"buildPresets\"][0][\"configurePreset\"] == \"conan-dynamic-14\"\n   863→    assert presets[\"buildPresets\"][1][\"configurePreset\"] == \"conan-dynamic-14\"\n   864→    assert presets[\"testPresets\"][0][\"name\"] == \"conan-dynamic-14-release\"\n   865→    assert presets[\"testPresets\"][1][\"name\"] == \"conan-dynamic-14-debug\"\n   866→    assert presets[\"testPresets\"][0][\"configurePreset\"] == \"conan-dynamic-14\"\n   867→    assert presets[\"testPresets\"][1][\"configurePreset\"] == \"conan-dynamic-14\"\n   868→\n   869→    # But If we change, for example, the cppstd and the compiler version, the toolchain\n   870→    # and presets will be different, but it will be appended to the UserPresets.json\n   871→    settings = \"-s compiler=msvc -s compiler.version=191 -s compiler.runtime=static \" \\\n   872→               \"-s compiler.cppstd=17\"\n   873→    client.run(\"install . {} {}\".format(settings, settings_layout))\n   874→    assert os.path.exists(os.path.join(client.current_folder, \"build\", \"static-17\", \"generators\"))\n   875→    assert os.path.exists(user_presets_path)\n   876→    user_presets = json.loads(load(user_presets_path))\n   877→    # The [0] is the msvc dynamic/14 the [1] is the static/17\n   878→    assert len(user_presets[\"include\"]) == 2\n   879→    presets = json.loads(load(user_presets[\"include\"][1]))\n   880→    assert len(presets[\"configurePresets\"]) == 1\n   881→    assert len(presets[\"buildPresets\"]) == 1\n   882→    assert len(presets[\"testPresets\"]) == 1\n   883→    assert presets[\"configurePresets\"][0][\"name\"] == \"conan-static-17\"\n   884→    assert presets[\"buildPresets\"][0][\"name\"] == \"conan-static-17-release\"\n   885→    assert presets[\"buildPresets\"][0][\"configurePreset\"] == \"conan-static-17\"\n   886→    assert presets[\"testPresets\"][0][\"name\"] == \"conan-static-17-release\"\n   887→    assert presets[\"testPresets\"][0][\"configurePreset\"] == \"conan-static-17\"\n   888→\n   889→    # We can build with cmake manually\n   890→    client.run_command(\"cmake . --preset conan-dynamic-14\")\n   891\n   892→    client.run_command(\"cmake --build --preset conan-dynamic-14-release\")\n   893→    client.run_command(\"ctest --preset conan-dynamic-14-release\")\n   894→    client.run_command(\"build\\\\dynamic-14\\\\Release\\\\hello\")\n   895→    assert \"Hello World Release!\" in client.out\n   896→    assert \"MSVC_LANG2014\" in client.out\n   897→\n   898→    client.run_command(\"cmake --build --preset conan-dynamic-14-debug\")\n   899→    client.run_command(\"ctest --preset conan-dynamic-14-debug\")\n   900→    client.run_command(\"build\\\\dynamic-14\\\\Debug\\\\hello\")\n   901→    assert \"Hello World Debug!\" in client.out\n   902→    assert \"MSVC_LANG2014\" in client.out\n   903→\n   904→    client.run_command(\"cmake . --preset conan-static-17\")\n   905→\n   906→    client.run_command(\"cmake --build --preset conan-static-17-release\")\n   907→    client.run_command(\"ctest --preset conan-static-17-release\")\n   908→    client.run_command(\"build\\\\static-17\\\\Release\\\\hello\")\n   909→    assert \"Hello World Release!\" in client.out\n   910→    assert \"MSVC_LANG2017\" in client.out\n   911→\n   912→\n   913→@pytest.mark.tool(\"cmake\")\n   914→def test_cmaketoolchain_sysroot():\n   915→    client = TestClient(path_with_spaces=False)\n   916→\n   917→    conanfile = textwrap.dedent(\"\"\"\n   918→        from conan import ConanFile\n   919→        from conan.tools.cmake import CMakeToolchain, CMake, cmake_layout\n   920→\n   921→        class AppConan(ConanFile):\n   922→            settings = \"os\", \"compiler\", \"build_type\", \"arch\"\n   923→            exports_sources = \"CMakeLists.txt\"\n   924→\n   925→            def generate(self):\n   926→                tc = CMakeToolchain(self)\n   927→                {}\n   928→                tc.generate()\n   929→\n   930→            def build(self):\n   931→                cmake = CMake(self)\n   932→                cmake.configure()\n   933→                cmake.build()\n   934→        \"\"\")\n   935→\n   936→    cmakelist = textwrap.dedent(\"\"\"\n   937→        cmake_minimum_required(VERSION 3.15)\n   938→        set(CMAKE_CXX_COMPILER_WORKS 1)\n   939→        project(app CXX)\n   940→        message(\"sysroot: '${CMAKE_SYSROOT}'\")\n   941→        message(\"osx_sysroot: '${CMAKE_OSX_SYSROOT}'\")\n   942→        \"\"\")\n   943→\n   944→    client.save({\n   945→        \"conanfile.py\": conanfile.format(\"\"),\n   946→        \"CMakeLists.txt\": cmakelist\n   947→    })\n   948→\n   949→    fake_sysroot = client.current_folder\n   950→    output_fake_sysroot = fake_sysroot.replace(\"\\\\\", \"/\") if platform.system() == \"Windows\" else fake_sysroot\n   951→    client.run(\"create . --name=app --version=1.0 -c tools.build:sysroot='{}'\".format(fake_sysroot))\n   952→    assert \"sysroot: '{}'\".format(output_fake_sysroot) in client.out\n   953→\n   954→    # set in a block instead of using conf\n   955→    set_sysroot_in_block = 'tc.blocks[\"generic_system\"].values[\"cmake_sysroot\"] = \"{}\"'.format(output_fake_sysroot)\n   956→    client.save({\n   957→        \"conanfile.py\": conanfile.format(set_sysroot_in_block),\n   958→    })\n   959→    client.run(\"create . --name=app --version=1.0\")\n   960→    assert \"sysroot: '{}'\".format(output_fake_sysroot) in client.out\n   961→\n   962→\n   963→@pytest.mark.tool(\"cmake\", \"3.23\")\n   964→def test_cmake_presets_with_conanfile_txt():\n   965→    c = TestClient()\n   966→\n   967→    c.run(\"new cmake_exe -d name=foo -d version=1.0\")\n   968→    os.unlink(os.path.join(c.current_folder, \"conanfile.py\"))\n   969→    c.save({\"conanfile.txt\": textwrap.dedent(\"\"\"\n   970→        [generators]\n   971→        CMakeToolchain\n   972→\n   973→        [layout]\n   974→        cmake_layout\n   975→        \"\"\")})\n   976→\n   977→    c.run(\"install .\")\n   978→    c.run(\"install . -s build_type=Debug\")\n   979→\n   980→    if platform.system() != \"Windows\":\n   981→        c.run_command(\"cmake --preset conan-debug\")\n   982→        c.run_command(\"cmake --build --preset conan-debug\")\n   983→        c.run_command(\"ctest --preset conan-debug\")\n   984→        c.run_command(\"./build/Debug/foo\")\n   985→    else:\n   986→        c.run_command(\"cmake --preset conan-default\")\n   987→        # this second called used to fail\n   988→        # https://github.com/conan-io/conan/issues/13792, CMake ignoring toolchain architecture\n   989→        # and toolset\n   990→        c.run_command(\"cmake --preset conan-default\")\n   991→        c.run_command(\"cmake --build --preset conan-debug\")\n   992→        c.run_command(\"ctest --preset conan-debug\")\n   993→        c.run_command(\"build\\\\Debug\\\\foo\")\n   994→\n   995→    assert \"Hello World Debug!\" in c.out\n   996→\n   997→    if platform.system() != \"Windows\":\n   998→        c.run_command(\"cmake --preset conan-release\")\n   999→        c.run_command(\"cmake --build --preset conan-release\")\n  1000→        c.run_command(\"ctest --preset conan-release\")\n  1001→        c.run_command(\"./build/Release/foo\")\n  1002→    else:\n  1003→        c.run_command(\"cmake --build --preset conan-release\")\n  1004→        c.run_command(\"ctest --preset conan-release\")\n  1005→        c.run_command(\"build\\\\Release\\\\foo\")\n  1006→\n  1007→    assert \"Hello World Release!\" in c.out\n  1008→\n  1009→\n  1010→@pytest.mark.skipif(platform.system() != \"Windows\", reason=\"Needs windows\")\n  1011→@pytest.mark.tool(\"ninja\")\n  1012→@pytest.mark.tool(\"cmake\", \"3.23\")\n  1013→def test_cmake_presets_with_conanfile_txt_ninja():\n  1014→    c = TestClient()\n  1015→\n  1016→    c.run(\"new cmake_exe -d name=foo -d version=1.0\")\n  1017→    os.unlink(os.path.join(c.current_folder, \"conanfile.py\"))\n  1018→    c.save({\"conanfile.txt\": textwrap.dedent(\"\"\"\n  1019→        [generators]\n  1020→        CMakeToolchain\n  1021→\n  1022→        [layout]\n  1023→        cmake_layout\n  1024→        \"\"\")})\n  1025→\n  1026→    conf = \"-c tools.cmake.cmaketoolchain:generator=Ninja\"\n  1027→    c.run(f\"install . {conf}\")\n  1028→    c.run(f\"install . -s build_type=Debug {conf}\")\n  1029→\n  1030→    c.run_command(\"build\\\\Release\\\\generators\\\\conanbuild.bat && cmake --preset conan-release\")\n  1031→    c.run_command(\"build\\\\Release\\\\generators\\\\conanbuild.bat && cmake --preset conan-release\")\n  1032→    c.run_command(\"build\\\\Release\\\\generators\\\\conanbuild.bat && cmake --build --preset conan-release\")\n  1033→    c.run_command(\"build\\\\Release\\\\generators\\\\conanbuild.bat && ctest --preset conan-release\")\n  1034→    c.run_command(\"build\\\\Release\\\\foo\")\n  1035→\n  1036→    assert \"Hello World Release!\" in c.out\n  1037→\n  1038→\n  1039→def test_cmake_presets_not_forbidden_build_type():\n  1040→    client = TestClient(path_with_spaces=False)\n  1041→    client.run(\"new cmake_exe -d name=hello -d version=0.1\")\n  1042→    settings_layout = '-c tools.cmake.cmake_layout:build_folder_vars=' \\\n  1043→                      '\\'[\"options.missing\", \"settings.build_type\"]\\''\n  1044→    client.run(\"install . {}\".format(settings_layout))\n  1045→    assert os.path.exists(os.path.join(client.current_folder,\n  1046→                                       \"build/rel