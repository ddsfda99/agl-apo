                        "type": "tool_result",
                        "content": "     1\u2192\"\"\"Basic data structures used to represent the Ledger entries.\n     2\u2192\"\"\"\n     3\u2192__copyright__ = \"Copyright (C) 2013-2017  Martin Blais\"\n     4\u2192__license__ = \"GNU GPLv2\"\n     5\u2192\n     6\u2192import builtins\n     7\u2192import datetime\n     8\u2192import enum\n     9\u2192import sys\n    10\u2192\n    11\u2192from decimal import Decimal\n    12\u2192from typing import Any, Dict, List, NamedTuple, Optional, Set, Union\n    13\u2192\n    14\u2192from beancount.core.amount import Amount\n    15\u2192from beancount.core.number import D\n    16\u2192from beancount.core.position import Cost\n    17\u2192from beancount.core.position import CostSpec\n    18\u2192from beancount.core.account import has_component\n    19\u2192from beancount.utils.bisect_key import bisect_left_with_key\n    20\u2192\n    21\u2192\n    22\u2192# Type declarations.\n    23\u2192Account = str\n    24\u2192Currency = str\n    25\u2192Flag = str\n    26\u2192Meta = Dict[str, Any]\n    27\u2192\n    28\u2192\n    29\u2192# An immutable constant for all empty sets. This is used to set links and tags\n    30\u2192# and ensure that they never has a None value. This makes some of the processing\n    31\u2192# code a bit simpler.\n    32\u2192EMPTY_SET = frozenset()\n    33\u2192\n    34\u2192\n    35\u2192# A set of valid booking method names for positions on accounts.\n    36\u2192# See http://furius.ca/beancount/doc/inventories for a full explanation.\n    37\u2192@enum.unique\n    38\u2192class Booking(enum.Enum):\n    39\u2192\n    40\u2192    # Reject ambiguous matches with an error.\n    41\u2192    STRICT = 'STRICT'\n    42\u2192\n    43\u2192    # Strict booking method, but disambiguate further with sizes. Reject\n    44\u2192    # ambiguous matches with an error but if a lot matches the size exactly,\n    45\u2192    # accept it the oldest.\n    46\u2192    STRICT_WITH_SIZE = 'STRICT_WITH_SIZE'\n    47\u2192\n    48\u2192    # Disable matching and accept the creation of mixed inventories.\n    49\u2192    NONE = 'NONE'\n    50\u2192\n    51\u2192    # Average cost booking: merge all matching lots before and after.\n    52\u2192    AVERAGE = 'AVERAGE'\n    53\u2192\n    54\u2192    # First-in first-out in the case of ambiguity.\n    55\u2192    FIFO = 'FIFO'\n    56\u2192\n    57\u2192    # Last-in first-out in the case of ambiguity.\n    58\u2192    LIFO = 'LIFO'\n    59\u2192\n    60\u2192    # Highest-in first-out in the case of ambiguity.\n    61\u2192    HIFO = 'HIFO'\n    62\u2192\n    63\u2192# All possible types of entries. These are the main data structures in use\n    64\u2192# within the program. They are all treated as immutable.\n    65\u2192#\n    66\u2192# Common Attributes (prepended to declared list):\n    67\u2192#   meta: A dict of strings to objects, potentially attached to each of the\n    68\u2192#     directive types. The values may be strings, account names, tags, dates,\n    69\u2192#     numbers, amounts and currencies. There are two special attributes which\n    70\u2192#     are always present on all directives: 'filename' and 'lineno'.\n    71\u2192#   date: A datetime.date instance; all directives have an associated date. Note:\n    72\u2192#     Beancount does not consider time, only dates. The line where the directive\n    73\u2192#     shows up in the file is used as a secondary sort key beyond the date.\n    74\u2192\n    75\u2192\n    76\u2192class Open(NamedTuple):\n    77\u2192    \"\"\"\n    78\u2192    An \"open account\" directive.\n    79\u2192\n    80\u2192    Attributes:\n    81\u2192      meta: See above.\n    82\u2192      date: See above.\n    83\u2192      account: A string, the name of the account that is being opened.\n    84\u2192      currencies: A list of strings, currencies that are allowed in this account.\n    85\u2192        May be None, in which case it means that there are no restrictions on which\n    86\u2192        currencies may be stored in this account.\n    87\u2192      booking: A Booking enum, the booking method to use to disambiguate\n    88\u2192        postings to this account (when zero or more than one postings match the\n    89\u2192        specification), or None if not specified. In practice, this attribute will\n    90\u2192        be should be left unspecified (None) in the vast majority of cases. See\n    91\u2192        Booking below for a selection of valid methods.\n    92\u2192    \"\"\"\n    93\u2192    meta: Meta\n    94\u2192    date: datetime.date\n    95\u2192    account: Account\n    96\u2192    currencies: List[Currency]\n    97\u2192    booking: Optional[Booking]\n    98\u2192\n    99\u2192\n   100\u2192class Close(NamedTuple):\n   101\u2192    \"\"\"\n   102\u2192    A \"close account\" directive.\n   103\u2192\n   104\u2192    Attributes:\n   105\u2192      meta: See above.\n   106\u2192      date: See above.\n   107\u2192      account: A string, the name of the account that is being closed.\n   108\u2192    \"\"\"\n   109\u2192    meta: Meta\n   110\u2192    date: datetime.date\n   111\u2192    account: Account\n   112\u2192\n   113\u2192\n   114\u2192class Commodity(NamedTuple):\n   115\u2192    \"\"\"\n   116\u2192    An optional commodity declaration directive. Commodities generally do not need\n   117\u2192    to be declared, but they may, and this is mainly created as intended to be\n   118\u2192    used to attach meta-data on a commodity name. Whenever a plugin needs\n   119\u2192    per-commodity meta-data, you would define such a commodity directive. Another\n   120\u2192    use is to define a commodity that isn't otherwise (yet) used anywhere in an\n   121\u2192    input file. (At the moment the date is meaningless but is specified for\n   122\u2192    coherence with all the other directives; if you can think of a good use case,\n   123\u2192    let us know).\n   124\u2192\n   125\u2192    Attributes:\n   126\u2192      meta: See above.\n   127\u2192      date: See above.\n   128\u2192      currency: A string, the commodity under consideration.\n   129\u2192    \"\"\"\n   130\u2192    meta: Meta\n   131\u2192    date: datetime.date\n   132\u2192    currency: Currency\n   133\u2192\n   134\u2192\n   135\u2192class Pad(NamedTuple):\n   136\u2192    \"\"\"\n   137\u2192    A \"pad this account with this other account\" directive. This directive\n   138\u2192    automatically inserts transactions that will make the next chronological\n   139\u2192    balance directive succeeds. It can be used to fill in missing date ranges of\n   140\u2192    transactions, as a convenience. You don't have to use this, it's sugar coating\n   141\u2192    in case you need it, while you're entering past history into your Ledger.\n   142\u2192\n   143\u2192    Attributes:\n   144\u2192      meta: See above.\n   145\u2192      date: See above.\n   146\u2192      account: A string, the name of the account which needs to be filled.\n   147\u2192      source_account: A string, the name of the account which is used to debit from\n   148\u2192        in order to fill 'account'.\n   149\u2192    \"\"\"\n   150\u2192    meta: Meta\n   151\u2192    date: datetime.date\n   152\u2192    account: Account\n   153\u2192    source_account: Account\n   154\u2192\n   155\u2192\n   156\u2192class Balance(NamedTuple):\n   157\u2192    \"\"\"\n   158\u2192    A \"check the balance of this account\" directive. This directive asserts that\n   159\u2192    the declared account should have a known number of units of a particular\n   160\u2192    currency at the beginning of its date. This is essentially an assertion, and\n   161\u2192    corresponds to the final \"Statement Balance\" line of a real-world statement.\n   162\u2192    These assertions act as checkpoints to help ensure that you have entered your\n   163\u2192    transactions correctly.\n   164\u2192\n   165\u2192    Attributes:\n   166\u2192      meta: See above.\n   167\u2192      date: See above.\n   168\u2192      account: A string, the account whose balance to check at the given date.\n   169\u2192      amount: An Amount, the number of units of the given currency you're\n   170\u2192        expecting 'account' to have at this date.\n   171\u2192      diff_amount: None if the balance check succeeds. This value is set to\n   172\u2192        an Amount instance if the balance fails, the amount of the difference.\n   173\u2192      tolerance: A Decimal object, the amount of tolerance to use in the\n   174\u2192        verification.\n   175\u2192    \"\"\"\n   176\u2192    meta: Meta\n   177\u2192    date: datetime.date\n   178\u2192    account: Account\n   179\u2192    amount: Amount\n   180\u2192    tolerance: Optional[Decimal]\n   181\u2192    diff_amount: Optional[Amount]\n   182\u2192\n   183\u2192\n   184\u2192class Posting(NamedTuple):\n   185\u2192    \"\"\"\n   186\u2192    Postings are contained in Transaction entries. These represent the individual\n   187\u2192    legs of a transaction. Note: a posting may only appear within a single entry\n   188\u2192    (multiple transactions may not share a Posting instance), and that's what the\n   189\u2192    entry field should be set to.\n   190\u2192\n   191\u2192    Attributes:\n   192\u2192      account: A string, the account that is modified by this posting.\n   193\u2192      units: An Amount, the units of the position.\n   194\u2192      cost: A Cost or CostSpec instances, the units of the position.\n   195\u2192      price: An Amount, the price at which the position took place, or\n   196\u2192        None, where not relevant. Providing a price member to a posting\n   197\u2192        automatically adds a price in the prices database at the date of the\n   198\u2192        transaction.\n   199\u2192      flag: An optional flag, a one-character string or None, which is to be\n   200\u2192        associated with the posting. Most postings don't have a flag, but it can\n   201\u2192        be convenient to mark a particular posting as problematic or pending to\n   202\u2192        be reconciled for a future import of its account.\n   203\u2192      meta: A dict of strings to values, the metadata that was attached\n   204\u2192        specifically to that posting, or None, if not provided. In practice, most\n   205\u2192        of the instances will be unlikely to have metadata.\n   206\u2192    \"\"\"\n   207\u2192    account: Account\n   208\u2192    units: Amount\n   209\u2192    cost: Optional[Union[Cost, CostSpec]]\n   210\u2192    price: Optional[Amount]\n   211\u2192    flag: Optional[Flag]\n   212\u2192    meta: Optional[Meta]\n   213\u2192\n   214\u2192\n   215\u2192class Transaction(NamedTuple):\n   216\u2192    \"\"\"\n   217\u2192    A transaction! This is the main type of object that we manipulate, and the\n   218\u2192    entire reason this whole project exists in the first place, because\n   219\u2192    representing these types of structures with a spreadsheet is difficult.\n   220\u2192\n   221\u2192    Attributes:\n   222\u2192      meta: See above.\n   223\u2192      date: See above.\n   224\u2192      flag: A single-character string or None. This user-specified string\n   225\u2192        represents some custom/user-defined state of the transaction. You can use\n   226\u2192        this for various purposes. Otherwise common, pre-defined flags are defined\n   227\u2192        under beancount.core.flags, to flags transactions that are automatically\n   228\u2192        generated.\n   229\u2192      payee: A free-form string that identifies the payee, or None, if absent.\n   230\u2192      narration: A free-form string that provides a description for the transaction.\n   231\u2192        All transactions have at least a narration string, this is never None.\n   232\u2192      tags: A set of tag strings (without the '#'), or EMPTY_SET.\n   233\u2192      links: A set of link strings (without the '^'), or EMPTY_SET.\n   234\u2192      postings: A list of Posting instances, the legs of this transaction. See the\n   235\u2192        doc under Posting above.\n   236\u2192    \"\"\"\n   237\u2192    meta: Meta\n   238\u2192    date: datetime.date\n   239\u2192    flag: Flag\n   240\u2192    payee: Optional[str]\n   241\u2192    narration: str\n   242\u2192    tags: Set\n   243\u2192    links: Set\n   244\u2192    postings: List[Posting]\n   245\u2192\n   246\u2192\n   247\u2192class TxnPosting(NamedTuple):\n   248\u2192    \"\"\"\n   249\u2192    A pair of a Posting and its parent Transaction. This is inserted as\n   250\u2192    temporaries in lists of postings-of-entries, which is the product of a\n   251\u2192    realization.\n   252\u2192\n   253\u2192    Attributes:\n   254\u2192      txn: The parent Transaction instance.\n   255\u2192      posting: The Posting instance.\n   256\u2192    \"\"\"\n   257\u2192    txn: Transaction\n   258\u2192    posting: Posting\n   259\u2192\n   260\u2192\n   261\u2192class Note(NamedTuple):\n   262\u2192    \"\"\"\n   263\u2192    A note directive, a general note that is attached to an account. These are\n   264\u2192    used to attach text at a particular date in a specific account. The notes can\n   265\u2192    be anything; a typical use would be to jot down an answer from a phone call to\n   266\u2192    the institution represented by the account. It should show up in an account's\n   267\u2192    journal. If you don't want this rendered, use the comment syntax in the input\n   268\u2192    file, which does not get parsed and stored.\n   269\u2192\n   270\u2192    Attributes:\n   271\u2192      meta: See above.\n   272\u2192      date: See above.\n   273\u2192      account: A string, the account which the note is to be attached to. This is\n   274\u2192        never None, notes always have an account they correspond to.\n   275\u2192      comment: A free-form string, the text of the note. This can be long if you\n   276\u2192        want it to.\n   277\u2192    \"\"\"\n   278\u2192    meta: Meta\n   279\u2192    date: datetime.date\n   280\u2192    account: Account\n   281\u2192    comment: str\n   282\u2192    tags: Optional[Set]\n   283\u2192    links: Optional[Set]\n   284\u2192\n   285\u2192\n   286\u2192class Event(NamedTuple):\n   287\u2192    \"\"\"\n   288\u2192    An \"event value change\" directive. These directives are used as string\n   289\u2192    variables that have different values over time. You can use these to track an\n   290\u2192    address, your location, your current employer, anything you like. The kind of\n   291\u2192    reporting that is made of these generic events is based on days and a\n   292\u2192    timeline. For instance, if you need to track the number of days you spend in\n   293\u2192    each country or state, create a \"location\" event and whenever you travel, add\n   294\u2192    an event directive to indicate its new value. You should be able to write\n   295\u2192    simple scripts against those in order to compute if you were present somewhere\n   296\u2192    for a particular number of days. Here's an illustrative example usage, in\n   297\u2192    order to maintain your health insurance coverage in Canada, you need to be\n   298\u2192    present in the country for 183 days or more, excluding trips of less than 30\n   299\u2192    days. There is a similar test to be done in the US by aliens to figure out if\n   300\u2192    they need to be considered as residents for tax purposes (the so-called\n   301\u2192    \"substantial presence test\"). By integrating these directives into your\n   302\u2192    bookkeeping, you can easily have a little program that computes the tests for\n   303\u2192    you. This is, of course, entirely optional and somewhat auxiliary to the main\n   304\u2192    purpose of double-entry bookkeeping, but correlates strongly with the\n   305\u2192    transactions you insert in it, and so it's a really convenient thing to have\n   306\u2192    in the same input file.\n   307\u2192\n   308\u2192    Attributes:\n   309\u2192      meta: See above.\n   310\u2192      date: See above.\n   311\u2192      \"type\": A short string, typically a single lowercase word, that defines a\n   312\u2192        unique variable whose value changes over time. For example, 'location'.\n   313\u2192      description: A free-form string, the value of the variable as of the date\n   314\u2192        of the transaction.\n   315\u2192    \"\"\"\n   316\u2192    meta: Meta\n   317\u2192    date: datetime.date\n   318\u2192    type: str\n   319\u2192    description: str\n   320\u2192\n   321\u2192\n   322\u2192class Query(NamedTuple):\n   323\u2192    \"\"\"\n   324\u2192    A named query declaration. This directive is used to create pre-canned queries\n   325\u2192    that can then be automatically run or made available to the shell, or perhaps be\n   326\u2192    rendered as part of a web interface. The purpose of this routine is to define\n   327\u2192    useful queries for the context of the particular given Beancount input file.\n   328\u2192\n   329\u2192    Attributes:\n   330\u2192      meta: See above.\n   331\u2192      date: The date at which this query should be run. All directives following\n   332\u2192        this date will be ignored automatically. This is essentially equivalent to\n   333\u2192        the CLOSE modifier in the shell syntax.\n   334\u2192      name: A string, the unique identifier for the query.\n   335\u2192      query_string: The SQL query string to be run or made available.\n   336\u2192    \"\"\"\n   337\u2192    meta: Meta\n   338\u2192    date: datetime.date\n   339\u2192    name: str\n   340\u2192    query_string: str\n   341\u2192\n   342\u2192\n   343\u2192class Price(NamedTuple):\n   344\u2192    \"\"\"\n   345\u2192    A price declaration directive. This establishes the price of a currency in\n   346\u2192    terms of another currency as of the directive's date. A history of the prices\n   347\u2192    for each currency pairs is built and can be queried within the bookkeeping\n   348\u2192    system. Note that because Beancount does not store any data at time-of-day\n   349\u2192    resolution, it makes no sense to have multiple price directives at the same\n   350\u2192    date. (Beancount will not attempt to solve this problem; this is beyond the\n   351\u2192    general scope of double-entry bookkeeping and if you need to build a day\n   352\u2192    trading system, you should probably use something else).\n   353\u2192\n   354\u2192    Attributes:\n   355\u2192      meta: See above.\n   356\u2192      date: See above.\n   357\u2192     currency: A string, the currency that is being priced, e.g. HOOL.\n   358\u2192     amount: An instance of Amount, the number of units and currency that\n   359\u2192       'currency' is worth, for instance 1200.12 USD.\n   360\u2192    \"\"\"\n   361\u2192    meta: Meta\n   362\u2192    date: datetime.date\n   363\u2192    currency: Currency\n   364\u2192    amount: Amount\n   365\u2192\n   366\u2192\n   367\u2192class Document(NamedTuple):\n   368\u2192    \"\"\"\n   369\u2192    A document file declaration directive. This directive is used to attach a\n   370\u2192    statement to an account, at a particular date. A typical usage would be to\n   371\u2192    render PDF files or scans of your bank statements into the account's journal.\n   372\u2192    While you can explicitly create those directives in the input syntax, it is\n   373\u2192    much more convenient to provide Beancount with a root directory to search for\n   374\u2192    filenames in a hierarchy mirroring the chart of accounts, filenames which\n   375\u2192    should match the following dated format: \"YYYY-MM-DD.*\". See options for\n   376\u2192    detail. Beancount will automatically create these documents directives based\n   377\u2192    on the file hierarchy, and you can get them by parsing the list of entries.\n   378\u2192\n   379\u2192    Attributes:\n   380\u2192      meta: See above.\n   381\u2192      date: See above.\n   382\u2192      account: A string, the account which the statement or document is associated\n   383\u2192        with.\n   384\u2192      filename: The absolute filename of the document file.\n   385\u2192      tags: A set of tag strings (without the '#'), or None, if an empty set.\n   386\u2192      links: A set of link strings (without the '^'), or None, if an empty set.\n   387\u2192    \"\"\"\n   388\u2192    meta: Meta\n   389\u2192    date: datetime.date\n   390\u2192    account: Account\n   391\u2192    filename: str\n   392\u2192    tags: Optional[Set]\n   393\u2192    links: Optional[Set]\n   394\u2192\n   395\u2192\n   396\u2192class Custom(NamedTuple):\n   397\u2192    \"\"\"\n   398\u2192    A custom directive. This directive can be used to implement new experimental\n   399\u2192    dated features in the Beancount file. This is meant as an intermediate measure\n   400\u2192    to be used when you would need to implement a new directive in a plugin. These\n   401\u2192    directives will be parsed liberally... any list of tokens are supported. All\n   402\u2192    that is required is some unique name for them that acts as a \"type\". These\n   403\u2192    directives are included in the stream and a plugin should be able to gather\n   404\u2192    them.\n   405\u2192\n   406\u2192    Attributes:\n   407\u2192      meta: See above.\n   408\u2192      type: A string that represents the type of the directive.\n   409\u2192      values: A list of values of various simple types supported by the grammar.\n   410\u2192        (Note that this list is not enforced to be consistent for all directives\n   411\u2192        of the same type by the parser.)\n   412\u2192    \"\"\"\n   413\u2192    meta: Meta\n   414\u2192    date: datetime.date\n   415\u2192    type: str\n   416\u2192    values: List\n   417\u2192\n   418\u2192\n   419\u2192# A list of all the valid directive types.\n   420\u2192ALL_DIRECTIVES = (\n   421\u2192    Open,\n   422\u2192    Close,\n   423\u2192    Commodity,\n   424\u2192    Pad,\n   425\u2192    Balance,\n   426\u2192    Transaction,\n   427\u2192    Note,\n   428\u2192    Event,\n   429\u2192    Query,\n   430\u2192    Price,\n   431\u2192    Document,\n   432\u2192    Custom\n   433\u2192)\n   434\u2192\n   435\u2192# Type for any of the directives.\n   436\u2192Directive = Union[\n   437\u2192    Open,\n   438\u2192    Close,\n   439\u2192    Commodity,\n   440\u2192    Pad,\n   441\u2192    Balance,\n   442\u2192    Transaction,\n   443\u2192    Note,\n   444\u2192    Event,\n   445\u2192    Query,\n   446\u2192    Price,\n   447\u2192    Document,\n   448\u2192    Custom\n   449\u2192]\n   450\u2192\n   451\u2192\n   452\u2192class dtypes:  # pylint: disable=invalid-name\n   453\u2192    \"Types of directives.\"\n   454\u2192    Open = Open\n   455\u2192    Close = Close\n   456\u2192    Commodity = Commodity\n   457\u2192    Pad = Pad\n   458\u2192    Balance = Balance\n   459\u2192    Transaction = Transaction\n   460\u2192    Note = Note\n   461\u2192    Event = Event\n   462\u2192    Query = Query\n   463\u2192    Price = Price\n   464\u2192    Document = Document\n   465\u2192    Custom = Custom\n   466\u2192\n   467\u2192\n   468\u2192# Type for the list of entries and options map.\n   469\u2192# Note: In v3, make the terminology 'Entries' obsolete.\n   470\u2192Entries = List[Directive]\n   471\u2192Directives = List[Directive]\n   472\u2192Options = Dict[str, Any]\n   473\n   474\u2192\n   475\u2192def new_metadata(filename, lineno, kvlist=None):\n   476\u2192    \"\"\"Create a new metadata container from the filename and line number.\n   477\u2192\n   478\u2192    Args:\n   479\u2192      filename: A string, the filename for the creator of this directive.\n   480\u2192      lineno: An integer, the line number where the directive has been created.\n   481\u2192      kvlist: An optional container of key-values.\n   482\u2192    Returns:\n   483\u2192      A metadata dict.\n   484\u2192    \"\"\"\n   485\u2192    meta = {'filename': filename,\n   486\u2192            'lineno': lineno}\n   487\u2192    if kvlist:\n   488\u2192        meta.update(kvlist)\n   489\u2192    return meta\n   490\u2192\n   491\u2192\n   492\u2192def create_simple_posting(entry, account, number, currency):\n   493\u2192    \"\"\"Create a simple posting on the entry, with just a number and currency (no cost).\n   494\u2192\n   495\u2192    Args:\n   496\u2192      entry: The entry instance to add the posting to.\n   497\u2192      account: A string, the account to use on the posting.\n   498\u2192      number: A Decimal number or string to use in the posting's Amount.\n   499\u2192      currency: A string, the currency for the Amount.\n   500\u2192    Returns:\n   501\u2192      An instance of Posting, and as a side-effect the entry has had its list of\n   502\u2192      postings modified with the new Posting instance.\n   503\u2192    \"\"\"\n   504\u2192    if isinstance(account, str):\n   505\u2192        pass\n   506\u2192    if number is None:\n   507\u2192        units = None\n   508\u2192    else:\n   509\u2192        if not isinstance(number, Decimal):\n   510\u2192            number = D(number)\n   511\u2192        units = Amount(number, currency)\n   512\u2192    posting = Posting(account, units, None, None, None, None)\n   513\u2192    if entry is not None:\n   514\u2192        entry.postings.append(posting)\n   515\u2192    return posting\n   516\u2192\n   517\u2192\n   518\u2192def create_simple_posting_with_cost(entry, account,\n   519\u2192                                    number, currency,\n   520\u2192                                    cost_number, cost_currency):\n   521\u2192    \"\"\"Create a simple posting on the entry, with just a number and currency (no cost).\n   522\u2192\n   523\u2192    Args:\n   524\u2192      entry: The entry instance to add the posting to.\n   525\u2192      account: A string, the account to use on the posting.\n   526\u2192      number: A Decimal number or string to use in the posting's Amount.\n   527\u2192      currency: A string, the currency for the Amount.\n   528\u2192      cost_number: A Decimal number or string to use for the posting's cost Amount.\n   529\u2192      cost_currency: a string, the currency for the cost Amount.\n   530\u2192    Returns:\n   531\u2192      An instance of Posting, and as a side-effect the entry has had its list of\n   532\u2192      postings modified with the new Posting instance.\n   533\u2192    \"\"\"\n   534\u2192    if isinstance(account, str):\n   535\u2192        pass\n   536\u2192    if not isinstance(number, Decimal):\n   537\u2192        number = D(number)\n   538\u2192    if cost_number and not isinstance(cost_number, Decimal):\n   539\u2192        cost_number = D(cost_number)\n   540\u2192    units = Amount(number, currency)\n   541\u2192    cost = Cost(cost_number, cost_currency, None, None)\n   542\u2192    posting = Posting(account, units, cost, None, None, None)\n   543\u2192    if entry is not None:\n   544\u2192        entry.postings.append(posting)\n   545\u2192    return posting\n   546\u2192\n   547\u2192\n   548\u2192NoneType = type(None)\n   549\u2192\n   550\u2192def sanity_check_types(entry, allow_none_for_tags_and_links=False):\n   551\u2192    \"\"\"Check that the entry and its postings has all correct data types.\n   552\u2192\n   553\u2192    Args:\n   554\u2192      entry: An instance of one of the entries to be checked.\n   555\u2192      allow_none_for_tags_and_links: A boolean, whether to allow plugins to\n   556\u2192        generate Transaction objects with None as value for the 'tags' or 'links'\n   557\u2192        attributes.\n   558\u2192    Raises:\n   559\u2192      AssertionError: If there is anything that is unexpected, raises an exception.\n   560\u2192    \"\"\"\n   561\u2192    assert isinstance(entry, ALL_DIRECTIVES), \"Invalid directive type\"\n   562\u2192    assert isinstance(entry.meta, dict), \"Invalid type for meta\"\n   563\u2192    assert 'filename' in entry.meta, \"Missing filename in metadata\"\n   564\u2192    assert 'lineno' in entry.meta, \"Missing line number in metadata\"\n   565\u2192    assert isinstance(entry.date, datetime.date), \"Invalid date type\"\n   566\u2192    if isinstance(entry, Transaction):\n   567\u2192        assert isinstance(entry.flag, (NoneType, str)), \"Invalid flag type\"\n   568\u2192        assert isinstance(entry.payee, (NoneType, str)), \"Invalid payee type\"\n   569\u2192        assert isinstance(entry.narration, (NoneType, str)), \"Invalid narration type\"\n   570\u2192        set_types = ((NoneType, set, frozenset)\n   571\u2192                     if allow_none_for_tags_and_links\n   572\u2192                     else (set, frozenset))\n   573\u2192        assert isinstance(entry.tags, set_types), (\n   574\u2192            \"Invalid tags type: {}\".format(type(entry.tags)))\n   575\u2192        assert isinstance(entry.links, set_types), (\n   576\u2192            \"Invalid links type: {}\".format(type(entry.links)))\n   577\u2192        assert isinstance(entry.postings, list), \"Invalid postings list type\"\n   578\u2192        for posting in entry.postings:\n   579\u2192            assert isinstance(posting, Posting), \"Invalid posting type\"\n   580\u2192            assert isinstance(posting.account, str), \"Invalid account type\"\n   581\u2192            assert isinstance(posting.units, (Amount, NoneType)), \"Invalid units type\"\n   582\u2192            assert isinstance(posting.cost, (Cost, CostSpec, NoneType)), \"Invalid cost type\"\n   583\u2192            assert isinstance(posting.price, (Amount, NoneType)), \"Invalid price type\"\n   584\u2192            assert isinstance(posting.flag, (str, NoneType)), \"Invalid flag type\"\n   585\u2192\n   586\u2192\n   587\u2192def posting_has_conversion(posting):\n   588\u2192    \"\"\"Return true if this position involves a conversion.\n   589\u2192\n   590\u2192    A conversion is when there is a price attached to the amount but no cost.\n   591\u2192    This is used on transactions to convert between units.\n   592\u2192\n   593\u2192    Args:\n   594\u2192      posting: an instance of Posting\n   595\u2192    Return:\n   596\u2192      A boolean, true if this posting has a price conversion.\n   597\u2192    \"\"\"\n   598\u2192    return (posting.cost is None and\n   599\u2192            posting.price is not None)\n   600\u2192\n   601\u2192\n   602\u2192def transaction_has_conversion(transaction):\n   603\u2192    \"\"\"Given a Transaction entry, return true if at least one of\n   604\u2192    the postings has a price conversion (without an associated\n   605\u2192    cost). These are the source of non-zero conversion balances.\n   606\u2192\n   607\u2192    Args:\n   608\u2192      transaction: an instance of a Transaction entry.\n   609\u2192    Returns:\n   610\u2192      A boolean, true if this transaction contains at least one posting with a\n   611\u2192      price conversion.\n   612\u2192    \"\"\"\n   613\u2192    assert isinstance(transaction, Transaction), (\n   614\u2192        \"Invalid type of entry for transaction: {}\".format(transaction))\n   615\u2192    for posting in transaction.postings:\n   616\u2192        if posting_has_conversion(posting):\n   617\u2192            return True\n   618\u2192    return False\n   619\u2192\n   620\u2192\n   621\u2192def get_entry(posting_or_entry):\n   622\u2192    \"\"\"Return the entry associated with the posting or entry.\n   623\u2192\n   624\u2192    Args:\n   625\u2192      entry: A TxnPosting or entry instance\n   626\u2192    Returns:\n   627\u2192      A datetime instance.\n   628\u2192    \"\"\"\n   629\u2192    return (posting_or_entry.txn\n   630\u2192            if isinstance(posting_or_entry, TxnPosting)\n   631\u2192            else posting_or_entry)\n   632\u2192\n   633\u2192\n   634\u2192# Sorting order of directives on the same day, by type:\n   635\u2192# - Open entries should always be first.\n   636\u2192# - Balance entries should appear before Transactions, because\n   637\u2192#   they are defined to apply at the beginning of the day.\n   638\u2192# - All other directives come next (including Transactions).\n   639\u2192# - Document directives should appear after Transactions because\n   640\u2192#   they can be inserted on the statement date, which may include\n   641\u2192#   transactions on that date.\n   642\u2192# - Close directives should always appear last.\n   643\u2192# This is the rationale for this sorting order.\n   644\u2192SORT_ORDER = {Open: -2, Balance: -1, Document: 1, Close: 2}\n   645\u2192\n   646\u2192\n   647\u2192def entry_sortkey(entry):\n   648\u2192    \"\"\"Sort-key for entries. We sort by date, except that checks\n   649\u2192    should be placed in front of every list of entries of that same day,\n   650\u2192    in order to balance linearly.\n   651\u2192\n   652\u2192    Args:\n   653\u2192      entry: An entry instance.\n   654\u2192    Returns:\n   655\u2192      A tuple of (date, integer, integer), that forms the sort key for the\n   656\u2192      entry.\n   657\u2192    \"\"\"\n   658\u2192    return (entry.date, SORT_ORDER.get(type(entry), 0), entry.meta[\"lineno\"])\n   659\u2192\n   660\u2192\n   661\u2192def sorted(entries):\n   662\u2192    \"\"\"A convenience to sort a list of entries, using entry_sortkey().\n   663\u2192\n   664\u2192    Args:\n   665\u2192      entries: A list of directives.\n   666\u2192    Returns:\n   667\u2192      A sorted list of directives.\n   668\u2192    \"\"\"\n   669\u2192    return builtins.sorted(entries, key=entry_sortkey)\n   670\u2192\n   671\u2192\n   672\u2192def posting_sortkey(entry):\n   673\u2192    \"\"\"Sort-key for entries or postings. We sort by date, except that checks\n   674\u2192    should be placed in front of every list of entries of that same day,\n   675\u2192    in order to balance linearly.\n   676\u2192\n   677\u2192    Args:\n   678\u2192      entry: A Posting or entry instance\n   679\u2192    Returns:\n   680\u2192      A tuple of (date, integer, integer), that forms the sort key for the\n   681\u2192      posting or entry.\n   682\u2192    \"\"\"\n   683\u2192    if isinstance(entry, TxnPosting):\n   684\u2192        entry = entry.txn\n   685\u2192    return (entry.date, SORT_ORDER.get(type(entry), 0), entry.meta[\"lineno\"])\n   686\u2192\n   687\u2192\n   688\u2192# TODO(blais): Rename 'txns' to 'transactions' for clarity.\n   689\u2192def filter_txns(entries):\n   690\u2192    \"\"\"A generator that yields only the Transaction instances.\n   691\u2192\n   692\u2192    This is such an incredibly common operation that it deserves a terse\n   693\u2192    filtering mechanism.\n   694\u2192\n   695\u2192    Args:\n   696\u2192      entries: A list of directives.\n   697\u2192    Yields:\n   698\u2192      A sorted list of only the Transaction directives.\n   699\u2192    \"\"\"\n   700\u2192    for entry in entries:\n   701\u2192        if isinstance(entry, Transaction):\n   702\u2192            yield entry\n   703\u2192\n   704\u2192\n   705\u2192def has_entry_account_component(entry, component):\n   706\u2192    \"\"\"Return true if one of the entry's postings has an account component.\n   707\u2192\n   708\u2192    Args:\n   709\u2192      entry: A Transaction entry.\n   710\u2192      component: A string, a component of an account name. For instance,\n   711\u2192        ``Food`` in ``Expenses:Food:Restaurant``. All components are considered.\n   712\u2192    Returns:\n   713\u2192      Boolean: true if the component is in the account. Note that a component\n   714\u2192      name must be whole, that is ``NY`` is not in ``Expenses:Taxes:StateNY``.\n   715\u2192    \"\"\"\n   716\u2192    return (isinstance(entry, Transaction) and\n   717\u2192            any(has_component(posting.account, component)\n   718\u2192                for posting in entry.postings))\n   719\u2192\n   720\u2192\n   721\u2192def find_closest(entries, filename, lineno):\n   722\u2192    \"\"\"Find the closest entry from entries to (filename, lineno).\n   723\u2192\n   724\u2192    Args:\n   725\u2192      entries: A list of directives.\n   726\u2192      filename: A string, the name of the ledger file to look for. Be careful\n   727\u2192        to provide the very same filename, and note that the parser stores the\n   728\u2192        absolute path of the filename here.\n   729\u2192      lineno: An integer, the line number closest after the directive we're\n   730\u2192        looking for. This may be the exact/first line of the directive.\n   731\u2192    Returns:\n   732\u2192      The closest entry found in the given file for the given filename, or\n   733\u2192      None, if none could be found.\n   734\u2192    \"\"\"\n   735\u2192    min_diffline = sys.maxsize\n   736\u2192    closest_entry = None\n   737\u2192    for entry in entries:\n   738\u2192        emeta = entry.meta\n   739\u2192        if emeta[\"filename\"] == filename and emeta[\"lineno\"] > 0:\n   740\u2192            diffline = lineno - emeta[\"lineno\"]\n   741\u2192            if 0 <= diffline < min_diffline:\n   742\u2192                min_diffline = diffline\n   743\u2192                closest_entry = entry\n   744\u2192    return closest_entry\n   745\u2192\n   746\u2192\n   747\u2192def remove_account_postings(account, entries):\n   748\u2192    \"\"\"Remove all postings with the given account.\n   749\u2192\n   750\u2192    Args:\n   751\u2192      account: A string, the account name whose postings we want to remove.\n   752\u2192    Returns:\n   753\u2192      A list of entries without the rounding postings.\n   754\u2192    \"\"\"\n   755\u2192    new_entries = []\n   756\u2192    for entry in entries:\n   757\u2192        if isinstance(entry, Transaction) and (\n   758\u2192                any(posting.account == account for posting in entry.postings)):\n   759\u2192            entry = entry._replace(postings=[posting\n   760\u2192                                             for posting in entry.postings\n   761\u2192                                             if posting.account != account])\n   762\u2192        new_entries.append(entry)\n   763\u2192    return new_entries\n   764\u2192\n   765\u2192\n   766\u2192def iter_entry_dates(entries, date_begin, date_end):\n   767\u2192    \"\"\"Iterate over the entries in a date window.\n   768\u2192\n   769\u2192    Args:\n   770\u2192      entries: A date-sorted list of dated directives.\n   771\u2192      date_begin: A datetime.date instance, the first date to include.\n   772\u2192      date_end: A datetime.date instance, one day beyond the last date.\n   773\u2192    Yields:\n   774\u2192      Instances of the dated directives, between the dates, and in the order in\n   775\u2192      which they appear.\n   776\u2192    \"\"\"\n   777\u2192    getdate = lambda entry: entry.date\n   778\u2192    index_begin = bisect_left_with_key(entries, date_begin, key=getdate)\n   779\u2192    index_end = bisect_left_with_key(entries, date_end, key=getdate)\n   780\u2192    for index in range(index_begin, index_end):\n   781\u2192        yield entries[index]\n   782\u2192\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"
