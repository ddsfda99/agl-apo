 str, cost: Cost) -> position: Position\n     7→\n     8→where\n     9→\n    10→  'currency': The commodity under consideration, USD, CAD, or stock units such\n    11→     as HOOL, MSFT, AAPL, etc.;\n    12→\n    13→  'cost': None or a Cost instance existing of cost currency, number, date, and\n    14→     label;\n    15→\n    16→  'position': A Position object, whose 'units' attribute is guaranteed to have\n    17→    the same currency as 'currency' and whose 'cost' attribute is equal to the\n    18→    'cost' key. It basically stores the number of units.\n    19→\n    20→This is meant to accommodate both booked and non-booked amounts. The clever\n    21→trick that we pull to do this is that for positions which aren't booked, we\n    22→simply leave the 'cost' as None. This is the case for most of the transactions.\n    23→\n    24→= Conversions =\n    25→\n    26→If it often desired to convert this inventory into an equivalent position for\n    27→its cost, or to just flatten all the positions with the same currency and count\n    28→the number of units, or to compute the market value for the inventory at a\n    29→specific date. You do these conversions using the reduce() method:\n    30→\n    31→  inventory.reduce(convert.get_cost)\n    32→  inventory.reduce(convert.get_units)\n    33→  inventory.reduce(convert.get_value, price_map, date)\n    34→\n    35→\"\"\"\n    36→__copyright__ = \"Copyright (C) 2013-2017  Martin Blais\"\n    37→__license__ = \"GNU GPLv2\"\n    38→\n    39→import collections\n    40→from collections.abc import Iterable\n    41→from decimal import Decimal\n    42→import enum\n    43→import re\n    44→\n    45→from beancount.core.number import ZERO\n    46→from beancount.core.number import same_sign\n    47→from beancount.core.amount import Amount\n    48→from beancount.core.position import Cost\n    49→from beancount.core.position import Position\n    50→from beancount.core.position import from_string as position_from_string\n    51→from beancount.core import convert\n    52→from beancount.core.display_context import DEFAULT_FORMATTER\n    53→\n    54→\n    55→# Enable this in tests to assert types being passed to Inventory.\n    56→ASSERTS_TYPES = False\n    57→\n    58→\n    59→class MatchResult(enum.Enum):\n    60→    \"\"\"Result of booking a new lot to an existing inventory.\"\"\"\n    61→    # A new lot was created.\n    62→    CREATED = 1\n    63→    # An existing lot was reduced.\n    64→    REDUCED = 2\n    65→    # An existing lot was augmented.\n    66→    AUGMENTED = 3\n    67→    # No change was applied.\n    68→    IGNORED = 4\n    69→\n    70→\n    71→# FIXME: You should disallow __getitem__, __delitem__ and __setitem__.\n    72→# Move the dict inside the container.\n    73→class Inventory(dict):\n    74→    \"\"\"An Inventory is a set of positions, indexed for efficiency.\n    75→    \"\"\"\n    76→\n    77→    def __init__(self, positions=None):\n    78→        \"\"\"Create a new inventory using a list of existing positions.\n    79→\n    80→        Args:\n    81→          positions: A list of Position instances or an existing dict or\n    82→            Inventory instance.\n    83→        \"\"\"\n    84→        if isinstance(positions, (dict, Inventory)):\n    85→            dict.__init__(self, positions)\n    86→        else:\n    87→            dict.__init__(self)\n    88→            if positions:\n    89→                assert isinstance(positions, Iterable)\n    90→                for position in positions:\n    91→                    self.add_position(position)\n    92→\n    93→    def __iter__(self):\n    94→        \"\"\"Iterate over the positions. Note that there is no guaranteed order.\"\"\"\n    95→        return iter(self.values())\n    96→\n    97→    def __lt__(self, other):\n    98→        \"\"\"Inequality comparison operator.\"\"\"\n    99→        return sorted(self) < sorted(other)\n   100→\n   101→    # TODO(blais): In v3, remove 'parens' and never render parens. (What a\n   102→    # stupid idea this was.)\n   103→    def to_string(self, dformat=DEFAULT_FORMATTER, parens=True):\n   104→        \"\"\"Convert an Inventory instance to a printable string.\n   105→\n   106→        Args:\n   107→          dformat: An instance of DisplayFormatter.\n   108→          parents: A boolean, true if we should surround the results by parentheses.\n   109→        Returns:\n   110→          A formatted string of the quantized amount and symbol.\n   111→        \"\"\"\n   112→        fmt = '({})' if parens else '{}'\n   113→        return fmt.format(\n   114→            ', '.join(pos.to_string(dformat) for pos in sorted(self)))\n   115→\n   116→    def __str__(self):\n   117→        \"\"\"Render as a human-readable string.\n   118→\n   119→        Returns:\n   120→          A string, for human consumption.\n   121→        \"\"\"\n   122→        return self.to_string()\n   123→\n   124→    __repr__ = __str__\n   125→\n   126→    def is_empty(self):\n   127→        \"\"\"Return true if the inventory is empty, that is, has no positions.\n   128→\n   129→        Returns:\n   130→          A boolean.\n   131→        \"\"\"\n   132→        return len(self) == 0\n   133→\n   134→    def __bool__(self):\n   135→        # Don't define this, be explicit by using is_empty() instead.\n   136→        raise NotImplementedError(\"Use explicit is_empty() method instead.\")\n   137→\n   138→    def __copy__(self):\n   139→        \"\"\"A shallow copy of this inventory object.\n   140→\n   141→        Returns:\n   142→          An instance of Inventory, equal to this one.\n   143→        \"\"\"\n   144→        return Inventory(self)\n   145→\n   146→    def is_small(self, tolerances):\n   147→        \"\"\"Return true if all the positions in the inventory are small.\n   148→\n   149→        Args:\n   150→          tolerances: A Decimal, the small number of units under which a position\n   151→            is considered small, or a dict of currency to such epsilon precision.\n   152→        Returns:\n   153→          A boolean.\n   154→        \"\"\"\n   155→        if isinstance(tolerances, dict):\n   156→            for position in self:\n   157→                tolerance = tolerances.get(position.units.currency, ZERO)\n   158→                if abs(position.units.number) > tolerance:\n   159→                    return False\n   160→            small = True\n   161→        else:\n   162→            small = not any(abs(position.units.number) > tolerances\n   163→                            for position in self)\n   164→        return small\n   165→\n   166→    def is_mixed(self):\n   167→        \"\"\"Return true if the inventory contains a mix of positive and negative lots for\n   168→        at least one instrument.\n   169→\n   170→        Returns:\n   171→          A boolean.\n   172→        \"\"\"\n   173→        signs_map = {}\n   174→        for position in self:\n   175→            sign = position.units.number >= 0\n   176→            prev_sign = signs_map.setdefault(position.units.currency, sign)\n   177→            if sign != prev_sign:\n   178→                return True\n   179→        return False\n   180→\n   181→    def is_reduced_by(self, ramount):\n   182→        \"\"\"Return true if the amount could reduce this inventory.\n   183→\n   184→        Args:\n   185→          ramount: An instance of Amount.\n   186→        Returns:\n   187→          A boolean.\n   188→        \"\"\"\n   189→        if ramount.number == ZERO:\n   190→            return False\n   191→        for position in self:\n   192→            units = position.units\n   193→            if (ramount.currency == units.currency and\n   194→                not same_sign(ramount.number, units.number)):\n   195→                return True\n   196→        return False\n   197→\n   198→    def __neg__(self):\n   199→        \"\"\"Return an inventory with the negative of values of this one.\n   200→\n   201→        Returns:\n   202→          An instance of Inventory.\n   203→        \"\"\"\n   204→        return Inventory({key: -pos for key, pos in self.items()})\n   205→\n   206→    def __abs__(self):\n   207→        \"\"\"Return an inventory with the absolute value of each position.\n   208→\n   209→        Returns:\n   210→          An instance of Inventory.\n   211→        \"\"\"\n   212→        return Inventory({key: abs(pos) for key, pos in self.items()})\n   213→\n   214→    def __mul__(self, scalar):\n   215→        \"\"\"Scale/multiply the contents of the inventory.\n   216→\n   217→        Args:\n   218→          scalar: A Decimal.\n   219→        Returns:\n   220→          An instance of Inventory.\n   221→        \"\"\"\n   222→        return Inventory({key: pos * scalar for key, pos in self.items()})\n   223→\n   224→    #\n   225→    # Methods to access portions of an inventory.\n   226→    #\n   227→\n   228→    def currencies(self):\n   229→        \"\"\"Return the list of unit currencies held in this inventory.\n   230→\n   231→        Returns:\n   232→          A list of currency strings.\n   233→        \"\"\"\n   234→        return set(currency for currency, _ in self.keys())\n   235→\n   236→    def cost_currencies(self):\n   237→        \"\"\"Return the list of unit currencies held in this inventory.\n   238→\n   239→        Returns:\n   240→          A set of currency strings.\n   241→        \"\"\"\n   242→        return set(cost.currency\n   243→                   for _, cost in self.keys()\n   244→                   if cost is not None)\n   245→\n   246→    def currency_pairs(self):\n   247→        \"\"\"Return the commodities held in this inventory.\n   248→\n   249→        Returns:\n   250→          A set of currency strings.\n   251→        \"\"\"\n   252→        return set(position.currency_pair() for position in self)\n   253→\n   254→    def get_positions(self):\n   255→        \"\"\"Return the positions in this inventory.\n   256→\n   257→        Returns:\n   258→          A shallow copy of the list of positions.\n   259→        \"\"\"\n   260→        return list(iter(self))\n   261→\n   262→    def get_only_position(self):\n   263→        \"\"\"Return the first position and assert there are no more.\n   264→        If the inventory is empty, return None.\n   265→        \"\"\"\n   266→        if len(self) > 0:\n   267→            if len(self) > 1:\n   268→                raise AssertionError(\"Inventory has more than one expected \"\n   269→                                     \"position: {}\".format(self))\n   270→            return next(iter(self))\n   271→\n   272→    def get_currency_units(self, currency):\n   273→        \"\"\"Fetch the total amount across all the position in the given currency.\n   274→        This may sum multiple lots in the same currency denomination.\n   275→\n   276→        Args:\n   277→          currency: A string, the currency to filter the positions with.\n   278→        Returns:\n   279→          An instance of Amount, with the given currency.\n   280→        \"\"\"\n   281→        total_units = ZERO\n   282→        for position in self:\n   283→            if position.units.currency == currency:\n   284→                total_units += position.units.number\n   285→        return Amount(total_units, currency)\n   286→\n   287→    # TODO(blais): Remove this, use split() below instead when needed.\n   288→    # TODO(blais): Rename this method to something more explicitly clear.\n   289→    def segregate_units(self, currencies):\n   290→        \"\"\"Split up the list of positions to the given currencies.\n   291→\n   292→        Args:\n   293→          currencies: A list of currency strings, the currencies to isolate.\n   294→        Returns:\n   295→          A dict of currency to Inventory instances.\n   296→        \"\"\"\n   297→        per_currency_dict = {currency: Inventory()\n   298→                             for currency in currencies}\n   299→        per_currency_dict[None] = Inventory()\n   300→        for position in self:\n   301→            currency = position.units.currency\n   302→            key = (currency if currency in currencies else None)\n   303→            per_currency_dict[key].add_position(position)\n   304→        return per_currency_dict\n   305→\n   306→    def split(self):\n   307→        \"\"\"Split up the list of positions to their corresponding currencies.\n   308→\n   309→        Returns:\n   310→          A dict of currency to Inventory instances.\n   311→        \"\"\"\n   312→        per_currency_dict = collections.defaultdict(Inventory)\n   313→        for position in self:\n   314→            per_currency_dict[position.units.currency].add_position(position)\n   315→        return dict(per_currency_dict)\n   316→\n   317→    # TODO(blais): We could use a new method that computes the aggregated units\n   318→    # and cost for each currency.\n   319→\n   320→    #\n   321→    # Methods to convert an Inventory into another.\n   322→    #\n   323→\n   324→    # TODO(blais): An improved design would allow conversions to market value to\n   325→    # return the difference between the weight and the inserted value, so it can\n   326→    # get inserted elsewhere on the balance sheet (e.g. to an unrealized gains\n   327→    # account). This should be a natural by-product of conversions and operators\n   328→    # should be modified to make this obvious or even difficult to ignore.\n   329→    #\n   330→    # TODO(blais): This returns another Inventory instance; rename this function\n   331→    # to \"map()\" and create a proper \"reduce()\" in the new API.\n   332→    def reduce(self, reducer, *args):\n   333→        \"\"\"Reduce an inventory using one of the conversion functions.\n   334→\n   335→        See functions in beancount.core.convert.\n   336→\n   337→        Returns:\n   338→          An instance of Inventory.\n   339→        \"\"\"\n   340→        inventory = Inventory()\n   341→        for position in self:\n   342→            inventory.add_amount(reducer(position, *args))\n   343→        return inventory\n   344→\n   345→    def average(self):\n   346→        \"\"\"Average all lots of the same currency together.\n   347→\n   348→        Use the minimum date from each aggregated set of lots.\n   349→\n   350→        Returns:\n   351→          An instance of Inventory.\n   352→        \"\"\"\n   353→        groups = collections.defaultdict(list)\n   354→        for position in self:\n   355→            key = (position.units.currency,\n   356→                   position.cost.currency if position.cost else None)\n   357→            groups[key].append(position)\n   358→\n   359→        average_inventory = Inventory()\n   360→        for (currency, cost_currency), positions in groups.items():\n   361→            total_units = sum(position.units.number\n   362→                              for position in positions)\n   363→            # Explicitly skip aggregates when resulting in zero units.\n   364→            if total_units == ZERO:\n   365→                continue\n   366→            units_amount = Amount(total_units, currency)\n   367→\n   368→            if cost_currency:\n   369→                total_cost = sum(convert.get_cost(position).number\n   370→                                 for position in positions)\n   371→                cost_number = (Decimal('Infinity')\n   372→                               if total_units == ZERO\n   373→                               else (total_cost / total_units))\n   374→                min_date = None\n   375→                for pos in positions:\n   376→                    pos_date = pos.cost.date if pos.cost else None\n   377→                    if pos_date is not None:\n   378→                        min_date = (pos_date\n   379→                                    if min_date is None\n   380→                                    else min(min_date, pos_date))\n   381→                cost = Cost(cost_number, cost_currency, min_date, None)\n   382→            else:\n   383→                cost = None\n   384→\n   385→            average_inventory.add_amount(units_amount, cost)\n   386→\n   387→        return average_inventory\n   388→\n   389→\n   390→    #\n   391→    # Methods to build an Inventory instance.\n   392→    #\n   393→\n   394→    def add_amount(self, units, cost=None):\n   395→        \"\"\"Add to this inventory using amount and cost. This adds with strict lot\n   396→        matching, that is, no partial matches are done on the arguments to the\n   397→        keys of the inventory.\n   398→\n   399→        Args:\n   400→          units: An Amount instance to add.\n   401→          cost: An instance of Cost or None, as a key to the inventory.\n   402→        Returns:\n   403→          A pair of (position, matched) where 'position' is the position that\n   404→          that was modified BEFORE it was modified, and where 'matched' is a\n   405→          MatchResult enum that hints at how the lot was booked to this inventory.\n   406→          Position may be None if there is no corresponding Position object,\n   407→          e.g. the position was deleted.\n   408→        \"\"\"\n   409→        if ASSERTS_TYPES:\n   410→            assert isinstance(units, Amount), (\n   411→                \"Internal error: {!r} (type: {})\".format(units, type(units).__name__))\n   412→            assert cost is None or isinstance(cost, Cost), (\n   413→                \"Internal error: {!r} (type: {})\".format(cost, type(cost).__name__))\n   414→\n   415→        # Find the position.\n   416→        key = (units.currency, cost)\n   417→        pos = self.get(key, None)\n   418→\n   419→        if pos is not None:\n   420→            # Note: In order to augment or reduce, all the fields have to match.\n   421→\n   422→            # Check if reducing.\n   423→            booking = (MatchResult.REDUCED\n   424→                       if not same_sign(pos.units.number, units.number)\n   425→                       else MatchResult.AUGMENTED)\n   426→\n   427→            # Compute the new number of units.\n   428→            number = pos.units.number + units.number\n   429→            if number == ZERO:\n   430→                # If empty, delete the position.\n   431→                del self[key]\n   432→            else:\n   433→                # Otherwise update it.\n   434→                self[key] = Position(Amount(number, units.currency), cost)\n   435→        else:\n   436→            # If not found, create a new one.\n   437→            if units.number == ZERO:\n   438→                booking = MatchResult.IGNORED\n   439→            else:\n   440→                self[key] = Position(units, cost)\n   441→                booking = MatchResult.CREATED\n   442→\n   443→        return pos, booking\n   444→\n   445→    def add_position(self, position):\n   446→        \"\"\"Add using a position (with strict lot matching).\n   447→        Return True if this position was booked against and reduced another.\n   448→\n   449→        Args:\n   450→          position: The Posting or Position to add to this inventory.\n   451→        Returns:\n   452→          A pair of (position, booking) where 'position' is the position that\n   453→          that was modified, and where 'matched' is a MatchResult enum that\n   454→          hints at how the lot was booked to this inventory.\n   455→        \"\"\"\n   456→        if ASSERTS_TYPES:\n   457→            assert hasattr(position, 'units') and hasattr(position, 'cost'), (\n   458→                \"Invalid type for position: {}\".format(position))\n   459→            assert isinstance(position.cost, (type(None), Cost)), (\n   460→                \"Invalid type for cost: {}\".format(position.cost))\n   461→        return self.add_amount(position.units, position.cost)\n   462→\n   463→    def add_inventory(self, other):\n   464→        \"\"\"Add all the positions of another Inventory instance to this one.\n   465→\n   466→        Args:\n   467→          other: An instance of Inventory to add to this one.\n   468→        Returns:\n   469→          This inventory, modified.\n   470→        \"\"\"\n   471→        if self.is_empty():\n   472→            # Optimization for empty inventories; if the current one is empty,\n   473→            # adopt all of the other inventory's positions without running\n   474→            # through the full aggregation checks. This should be very cheap. We\n   475→            # can do this because the positions are immutable.\n   476→            self.update(other)\n   477→        else:\n   478→            for position in other.get_positions():\n   479→                self.add_position(position)\n   480→        return self\n   481→\n   482→    def __add__(self, other):\n   483→        \"\"\"Add another inventory to this one. This inventory is not modified.\n   484→\n   485→        Args:\n   486→          other: An instance of Inventory.\n   487→        Returns:\n   488→          A new instance of Inventory.\n   489→        \"\"\"\n   490→        new_inventory = self.__copy__()\n   491→        new_inventory.add_inventory(other)\n   492→        return new_inventory\n   493→\n   494→    __iadd__ = add_inventory\n   495→\n   496→    @staticmethod\n   497→    def from_string(string):\n   498→        \"\"\"Create an Inventory from a string. This is useful for writing tests.\n   499→\n   500→        Args:\n   501→          string: A comma-separated string of <number> <currency> with an\n   502→            optional {<number> <currency>} for the cost.\n   503→        Returns:\n   504→          A new instance of Inventory with the given balances.\n   505→        \"\"\"\n   506→        new_inventory = Inventory()\n   507→        # We need to split the comma-separated positions but ignore commas\n   508→        # occurring within a {...cost...} specification.\n   509→        position_strs = re.split(\n   510→            r'([-+]?[0-9,.]+\\s+[A-Z]+\\s*(?:{[^}]*})?)\\s*,?\\s*', string)[1: