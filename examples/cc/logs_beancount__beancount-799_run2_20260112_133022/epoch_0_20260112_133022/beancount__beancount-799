d.\n   175\u2192    Yields:\n   176\u2192      Tuples of (root, account-name, dirs, files), similar to os.walk().\n   177\u2192    \"\"\"\n   178\u2192    for root, dirs, files in os.walk(root_directory):\n   179\u2192        dirs.sort()\n   180\u2192        files.sort()\n   181\u2192        relroot = root[len(root_directory)+1:]\n   182\u2192        account_name = relroot.replace(os.sep, sep)\n   183\u2192        # The regex module does not handle Unicode characters in decomposed\n   184\u2192        # form. Python uses the normal form for representing string. However,\n   185\u2192        # some filesystems use the canonical decomposition form.\n   186\u2192        # See https://docs.python.org/3/library/unicodedata.html#unicodedata.normalize\n   187\u2192        account_name = unicodedata.normalize('NFKC', account_name)\n   188\u2192        if is_valid(account_name):\n   189\u2192            yield (root, account_name, dirs, files)\n   190\u2192\n   191\u2192\n   192\u2192def parent_matcher(account_name: Account) -> Callable[[str], Any]:\n   193\u2192    \"\"\"Build a predicate that returns whether an account is under the given one.\n   194\u2192\n   195\u2192    Args:\n   196\u2192      account_name: The name of the parent account we want to check for.\n   197\u2192    Returns:\n   198\u2192      A callable, which, when called, will return true if the given account is a\n   199\u2192      child of ``account_name``.\n   200\u2192    \"\"\"\n   201\u2192    return re.compile(r'{}($|{})'.format(re.escape(account_name), sep)).match\n   202\u2192\n   203\u2192\n   204\u2192def parents(account_name: Account) -> Iterator[Account]:\n   205\u2192    \"\"\"A generator of the names of the parents of this account, including this account.\n   206\u2192\n   207\u2192    Args:\n   208\u2192      account_name: The name of the account we want to start iterating from.\n   209\u2192    Returns:\n   210\u2192      A generator of account name strings.\n   211\u2192    \"\"\"\n   212\