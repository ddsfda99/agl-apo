ame\n   606→\n   607→        # Try to import the module.\n   608→        #\n   609→        # Note: We intercept import errors and continue but let other plugin\n   610→        # import time exceptions fail a run, by choice.\n   611→        try:\n   612→            module = importlib.import_module(plugin_name)\n   613→            if not hasattr(module, '__plugins__'):\n   614→                continue\n   615→        except ImportError:\n   616→            # Upon failure, just issue an error.\n   617→            formatted_traceback = traceback.format_exc().replace(\"\\n\", \"\\n  \")\n   618→            errors.append(LoadError(data.new_metadata(\"<load>\", 0),\n   619→                                    'Error importing \"{}\": {}'.format(\n   620→                                        plugin_name, formatted_traceback), None))\n   621→            continue\n   622→\n   623→        # Apply it.\n   624→        with misc_utils.log_time(plugin_name, log_timings, indent=2):\n   625→            # Run each transformer function in the plugin.\n   626→            for function_name in module.__plugins__:\n   627→                if isinstance(function_name, str):\n   628→                    # Support plugin functions provided by name.\n   629→                    callback = getattr(module, function_name)\n   630→                else:\n   631→                    # Support function types directly, not just names.\n   632→                    callback = function_name\n   633→\n   634→                # Provide arguments if config is provided.\n   635→                # TODO(blais): Make this consistent in v3, not conditional.\n   636→                args = () if plugin_config is None else (plugin_config,)\n   637→\n   638→                # Catch all exceptions raised in running the plugin, except exits.\n   639→                try:\n   640→                    entries, plugin_errors = callback(entries, options_map, *args)\n   641→                    errors.extend(plugin_errors)\n   642→