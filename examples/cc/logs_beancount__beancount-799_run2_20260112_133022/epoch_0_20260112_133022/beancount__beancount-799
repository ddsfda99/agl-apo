in lists of\n     5→Posting instances instead of Transactions, or other entry types that are\n     6→attached to an account, such as a Balance or Note entry.\n     7→\n     8→The interface of RealAccount corresponds to that of a regular Python dict, where\n     9→the keys are the names of the individual components of an account's name, and\n    10→the values are always other RealAccount instances. If you want to get an account\n    11→by long account name, there are helper functions in this module for this purpose\n    12→(see realization.get(), for instance). RealAccount instances also contain the\n    13→final balance of that account, resulting from its list of postings.\n    14→\n    15→You should not build RealAccount trees yourself; instead, you should filter the\n    16→list of desired directives to display and call the realize() function with them.\n    17→\"\"\"\n    18→__copyright__ = \"Copyright (C) 2013-2016  Martin Blais\"\n    19→__license__ = \"GNU GPLv2\"\n    20→\n    21→import collections\n    22→import copy\n    23→import functools\n    24→import io\n    25→import operator\n    26→\n    27→from beancount.core.data import Transaction\n    28→from beancount.core.data import Posting\n    29→from beancount.core.data import TxnPosting\n    30→from beancount.core.data import Balance\n    31→from beancount.core.data import Open\n    32→from beancount.core.data import Close\n    33→from beancount.core.data import Pad\n    34→from beancount.core.data import Note\n    35→from beancount.core.data import Document\n    36→from beancount.core.data import Custom\n    37→from beancount.core import inventory\n    38→from beancount.core import amount\n    39→from beancount.core import data\n    40→from beancount.core import account\n    41→from beancount.core import convert\n    42→\n    43→\n    44→class RealAccount(dict):\n    45→    \"\"\"A realized account, inserted in a tree, that contains the list of realized entries.\n    46→\n    47→    Attributes:\n    48→      account: A string, the full name of the corresponding account.\n    49→      postings: A list of postings associated with this accounting (does not\n    50→        include the postings of children accounts).\n    51→      balance: The final balance of the list of postings associated with this account.\n    52→    \"\"\"\n    53→    __slots__ = ('account', 'txn_postings', 'balance')\n    54→\n    55→    def __init__(self, account_name, *args, **kwargs):\n    56→        \"\"\"Create a RealAccount instance.\n    57→\n    58→        Args:\n    59→          account_name: a string, the name of the account. Maybe not be None.\n    60→        \"\"\"\n    61→        super().__init__(*args, **kwargs)\n    62→        assert isinstance(account_name, str)\n    63→        self.account = account_name\n    64→        self.txn_postings = []\n    65→        self.balance = inventory.Inventory()\n    66→\n    67→    def __setitem__(self, key, value):\n    68→        \"\"\"Prevent the setting of non-string or non-empty keys on this dict.\n    69→\n    70→        Args:\n    71→          key: The dictionary key. Must be a string.\n    72→          value: The value, must be a RealAccount instance.\n    73→        Raises:\n    74→          KeyError: If the key is not a string, or is invalid.\n    75→          ValueError: If the value is not a RealAccount instance.\n    76→        \"\"\"\n    77→        if not isinstance(key, str) or not key:\n    78→            raise KeyError(\"Invalid RealAccount key: '{}'\".format(key))\n    79→        if not isinstance(value, RealAccount):\n    80→            raise ValueError(\"Invalid RealAccount value: '{}'\".format(value))\n    81→        if not value.account.endswith(key):\n    82→            raise ValueError(\"RealAccount name '{}' inconsistent with key: '{}'\".format(\n    83→                value.account, key))\n    84→        return super().__setitem__(key, value)\n    85→\n    86→    def copy(self):\n    87→        \"\"\"Override dict.copy() to clone a RealAccount.\n    88→\n    89→        This is only necessary to correctly implement the copy method.\n    90→        Otherwise, calling .copy() on a RealAccount instance invokes the base\n    91→        class' method, which return just a dict.\n    92→\n    93→        Returns:\n    94→          A cloned instance of RealAccount, with all members shallow-copied.\n    95→        \"\"\"\n    96→        return copy.copy(self)\n    97→\n    98→    def __eq__(self, other):\n    99→        \"\"\"Equality predicate. All attributes are compared.\n   100→\n   101→        Args:\n   102→          other: Another instance of RealAccount.\n   103→        Returns:\n   104→          A boolean, True if the two real accounts are equal.\n   105→        \"\"\"\n   106→        return (dict.__eq__(self, other) and\n   107→                self.account == other.account and\n   108→                self.balance == other.balance and\n   109→                self.txn_postings == other.txn_postings)\n   110→\n   111→    def __ne__(self, other):\n   112→        \"\"\"Not-equality predicate. See __eq__.\n   113→\n   114→        Args:\n   115→          other: Another instance of RealAccount.\n   116→        Returns:\n   117→          A boolean, True if the two real accounts are not equal.\n   118→        \"\"\"\n   119→        return not self.__eq__(other)\n   120→\n   121→\n   122→def iter_children(real_account, leaf_only=False):\n   123→    \"\"\"Iterate this account node and all its children, depth-first.\n   124→\n   125→    Args:\n   126→      real_account: An instance of RealAccount.\n   127→      leaf_only: A boolean flag, true if we should yield only leaves.\n   128→    Yields:\n   129→      Instances of RealAccount, beginning with this account. The order is\n   130→      undetermined.\n   131→    \"\"\"\n   132→    if leaf_only:\n   133→        if len(real_account) == 0:\n   134→            yield real_account\n   135→        else:\n   136→            for key, real_child in sorted(real_account.items()):\n   137→                for real_subchild in iter_children(real_child, leaf_only):\n   138→                    yield real_subchild\n   139→    else:\n   140→        yield real_account\n   141→        for key, real_child in sorted(real_account.items()):\n   142→            for real_subchild in iter_children(real_child):\n   143→                yield real_subchild\n   144→\n   145→\n   146→def get(real_account, account_name, default=None):\n   147→    \"\"\"Fetch the subaccount name from the real_account node.\n   148→\n   149→    Args:\n   150→      real_account: An instance of RealAccount, the parent node to look for\n   151→        children of.\n   152→      account_name: A string, the name of a possibly indirect child leaf\n   153→        found down the tree of 'real_account' nodes.\n   154→      default: The default value that should be returned if the child\n   155→        subaccount is not found.\n   156→    Returns:\n   157→      A RealAccount instance for the child, or the default value, if the child\n   158→      is not found.\n   159→    \"\"\"\n   160→    if not isinstance(account_name, str):\n   161→        raise ValueError\n   162→    components = account.split(account_name)\n   163→    for component in components:\n   164→        real_child = real_account.get(component, default)\n   165→        if real_child is default:\n   166→            return default\n   167→        real_account = real_child\n   168→    return real_account\n   169→\n   170→\n   171→def get_or_create(real_account, account_name):\n   172→    \"\"\"Fetch the subaccount name from the real_account node.\n   173→\n   174→    Args:\n   175→      real_account: An instance of RealAccount, the parent node to look for\n   176→        children of, or create under.\n   177→      account_name: A string, the name of the direct or indirect child leaf\n   178→        to get or create.\n   179→    Returns:\n   180→      A RealAccount instance for the child, or the default value, if the child\n   181→      is not found.\n   182→    \"\"\"\n   183→    if not isinstance(account_name, str):\n   184→        raise ValueError\n   185→    components = account.split(account_name)\n   186→    path = []\n   187→    for component in components:\n   188→        path.append(component)\n   189→        real_child = real_account.get(component, None)\n   190→        if real_child is None:\n   191→            real_child = RealAccount(account.join(*path))\n   192→            real_account[component] = real_child\n   193→        real_account = real_child\n   194→    return real_account\n   195→\n   196→\n   197→def contains(real_account, account_name):\n   198→    \"\"\"True if the given account node contains the subaccount name.\n   199→\n   200→    Args:\n   201→      account_name: A string, the name of a direct or indirect subaccount of\n   202→        this node.\n   203→    Returns:\n   204→      A boolean, true the name is a child of this node.\n   205→    \"\"\"\n   206→    return get(real_account, account_name) is not None\n   207→\n   208→\n   209→# TODO(blais): Reconcile this with balance_by_account() {2196104406ab}.\n   210→def realize(entries, min_accounts=None, compute_balance=True):\n   211→    r\"\"\"Group entries by account, into a \"tree\" of realized accounts. RealAccount's\n   212→    are essentially containers for lists of postings and the final balance of\n   213→    each account, and may be non-leaf accounts (used strictly for organizing\n   214→    accounts into a hierarchy). This is then used to issue reports.\n   215→\n   216→    The lists of postings in each account my be any of the entry types, except\n   217→    for Transaction, whereby Transaction entries are replaced by the specific\n   218→    Posting legs that belong to the account. Here's a simple diagram that\n   219→    summarizes this seemingly complex, but rather simple data structure:\n   220→\n   221→       +-------------+ postings  +------+\n   222→       | RealAccount |---------->| Open |\n   223→       +-------------+           +------+\n   224→                                     |\n   225→                                     v\n   226→                              +------------+     +-------------+\n   227→                              | TxnPosting |---->| Transaction |\n   228→                              +------------+     +-------------+\n   229→                                     |      \\                 \\\\\\\n   230→                                     v       `\\.__          +---------+\n   231→                                  +-----+         `-------->| Posting |\n   232→                                  | Pad |                   +---------+\n   233→                                  +-----+\n   234→                                     |\n   235→                                     v\n   236→                                +---------+\n   237→                                | Balance |\n   238→                                +---------+\n   239→                                     |\n   240→                                     v\n   241→                                 +-------+\n   242→                                 | Close |\n   243→                                 +-------+\n   244→                                     |\n   245→                                     .\n   246→\n   247→    Args:\n   248→      entries: A list of directives.\n   249→      min_accounts: A list of strings, account names to ensure we create,\n   250→        regardless of whether there are postings on those accounts or not.\n   251→        This can be used to ensure the root accounts all exist.\n   252→      compute_balance: A boolean, true if we should compute the final\n   253→        balance on the realization.\n   254→    Returns:\n   255→      The root RealAccount instance.\n   256→    \"\"\"\n   257→    # Create lists of the entries by account.\n   258→    txn_postings_map = postings_by_account(entries)\n   259→\n   260→    # Create a RealAccount tree and compute the balance for each.\n   261→    real_root = RealAccount('')\n   262→    for account_name, txn_postings in txn_postings_map.items():\n   263→        real_account = get_or_create(real_root, account_name)\n   264→        real_account.txn_postings = txn_postings\n   265→        if compute_balance:\n   266→            real_account.balance = compute_postings_balance(txn_postings)\n   267→\n   268→    # Ensure a minimum set of accounts that should exist. This is typically\n   269→    # called with an instance of AccountTypes to make sure that those exist.\n   270→    if min_accounts:\n   271→        for account_name in min_accounts:\n   272→            get_or_create(real_root, account_name)\n   273→\n   274→    return real_root\n   275→\n   276→\n   277→def postings_by_account(entries):\n   278→    \"\"\"Create lists of postings and balances by account.\n   279→\n   280→    This routine aggregates postings and entries grouping them by account name.\n   281→    The resulting lists contain postings in-lieu of Transaction directives, but\n   282→    the other directives are stored as entries. This yields a list of postings\n   283→    or other entries by account. All references to accounts are taken into\n   284→    account.\n   285→\n   286→    Args:\n   287→      entries: A list of directives.\n   288→    Returns:\n   289→       A mapping of account name to list of TxnPosting instances or\n   290→       non-Transaction directives, sorted in the same order as the entries.\n   291→    \"\"\"\n   292→    txn_postings_map = collections.defaultdict(list)\n   293→    for entry in entries:\n   294→\n   295→        if isinstance(entry, Transaction):\n   296→            # Insert an entry for each of the postings.\n   297→            for posting in entry.postings:\n   298→                txn_postings_map[posting.account].append(\n   299→                    TxnPosting(entry, posting))\n   300→\n   301→        elif isinstance(entry, (Open, Close, Balance, Note, Document)):\n   302→            # Append some other entries in the realized list.\n   303→            txn_postings_map[entry.account].append(entry)\n   304→\n   305→        elif isinstance(entry, Pad):\n   306→            # Insert the pad entry in both realized accounts.\n   307→            txn_postings_map[entry.account].append(entry)\n   308→            txn_postings_map[entry.source_account].append(entry)\n   309→\n   310→        elif isinstance(entry, Custom):\n   311→            # Insert custom entry for each account in its values.\n   312→            for custom_value in entry.values:\n   313→                if custom_value.dtype == account.TYPE:\n   314→                    txn_postings_map[custom_value.value].append(entry)\n   315→\n   316→    return txn_postings_map\n   317→\n   318→\n   319→# TODO(blais): Invert this in v3, so it's isomorphic to functools.filter().\n   320→def filter(real_account, predicate):\n   321→    \"\"\"Filter a RealAccount tree of nodes by the predicate.\n   322→\n   323→    This function visits the tree and applies the predicate on each node. It\n   324→    returns a partial clone of RealAccount whereby on each node\n   325→    - either the predicate is true, or\n   326→    - for at least one child of the node the predicate is true.\n   327→    All the leaves have the predicate be true.\n   328→\n   329→    Args:\n   330→      real_account: An instance of RealAccount.\n   331→      predicate: A callable/function which accepts a RealAccount and returns\n   332→        a boolean. If the function returns True, the node is kept.\n   333→    Returns:\n   334→      A shallow clone of RealAccount is always returned.\n   335→    \"\"\"\n   336→    assert isinstance(real_account, RealAccount)\n   337→\n   338→    real_copy = RealAccount(real_account.account)\n   339→    real_copy.balance = real_account.balance\n   340→    real_copy.txn_postings = real_account.txn_postings\n   341→\n   342→    for child_name, real_child in real_account.items():\n   343→        real_child_copy = filter(real_child, predicate)\n   344→        if real_child_copy is not None:\n   345→            real_copy[child_name] = real_child_copy\n   346→\n   347→    if len(real_copy) > 0 or predicate(real_account):\n   348→        return real_copy\n   349→\n   350→\n   351→def get_postings(real_account):\n   352→    \"\"\"Return a sorted list a RealAccount's postings and children.\n   353→\n   354→    Args:\n   355→      real_account: An instance of RealAccount.\n   356→    Returns:\n   357→      A list of Posting or directories.\n   358→    \"\"\"\n   359→    # We accumulate all the postings at once here instead of incrementally\n   360→    # because we need to return them sorted.\n   361→    accumulator = []\n   362→    for real_child in iter_children(real_account):\n   363→        accumulator.extend(real_child.txn_postings)\n   364→    accumulator.sort(key=data.posting_sortkey)\n   365→    return accumulator\n   366→\n   367→\n   368→def iterate_with_balance(txn_postings):\n   369→    \"\"\"Iterate over the entries, accumulating the running balance.\n   370→\n   371→    For each entry, this yields tuples of the form:\n   372→\n   373→      (entry, postings, change, balance)\n   374→\n   375→    entry: This is the directive for this line. If the list contained Posting\n   376→      instance, this yields the corresponding Transaction object.\n   377→    postings: A list of postings on this entry that affect the balance. Only the\n   378→      postings encountered in the input list are included; only those affect the\n   379→      balance. If 'entry' is not a Transaction directive, this should always be\n   380→      an empty list. We preserve the original ordering of the postings as they\n   381→      appear in the input list.\n   382→    change: An Inventory object that reflects the total change due to the\n   383→      postings from this entry that appear in the list. For example, if a\n   384→      Transaction has three postings and two are in the input list, the sum of\n   385→      the two postings will be in the 'change' Inventory object. However, the\n   386→      position for the transactions' third posting--the one not included in the\n   387→      input list--will not be in this inventory.\n   388→    balance: An Inventory object that reflects the balance *after* adding the\n   389→      'change' inventory due to this entry's transaction. The 'balance' yielded\n   390→      is never None, even for entries that do not affect the balance, that is,\n   391→      with an empty 'change' inventory. It's up to the caller, the one rendering\n   392→      the entry, to decide whether to render this entry's change for a\n   393→      particular entry type.\n   394→\n   395→    Note that if the input list of postings-or-entries is not in sorted date\n   396→    order, two postings for the same entry appearing twice with a different date\n   397→    in between will cause the entry appear twice. This is correct behavior, and\n   398→    it is expected that in practice this should never happen anyway, because the\n   399→    list of postings or entries should always be sorted. This method attempts to\n   400→    detect this and raises an assertion if this is seen.\n   401→\n   402→    Args:\n   403→      txn_postings: A list of postings or directive instances.\n   404→        Postings affect the balance; other entries do not.\n   405→    Yields:\n   406→      Tuples of (entry, postings, change, balance) as described above.\n   407→    \"\"\"\n   408→\n   409→    # The running balance.\n   410→    running_balance = inventory.Inventory()\n   411→\n   412→    # Previous date.\n   413→    prev_date = None\n   414→\n   415→    # A list of entries at the current date.\n   416→    date_entries = []\n   417→\n   418→    first = lambda pair: pair[0]\n   419→    for txn_posting in txn_postings:\n   420→\n   421→        # Get the posting if we are dealing with one.\n   422→        assert not isinstance(txn_posting, Posting)\n   423→        if isinstance(txn_posting, TxnPosting):\n   424→            posting = txn_posting.posting\n   425→            entry = txn_posting.txn\n   426→        else:\n   427→            posting = None\n   428→            entry = txn_posting\n   429→\n   430→        if entry.date != prev_date:\n   431→            assert prev_date is None or entry.date > prev_date, (\n   432→                \"Invalid date order for postings: {} > {}\".format(prev_date, entry.date))\n   433→            prev_date = entry.date\n   434→\n   435→            # Flush the dated entries.\n   436→            for date_entry, date_postings in date_entries:\n   437→                change = inventory.Inventory()\n   438→                if date_postings:\n   439→                    # Compute the change due to this transaction and update the\n   440→                    # total balance at the same time.\n   441→                    for date_posting in date_postings:\n   442→                        change.add_position(date_posting)\n   443→                        running_balance.add_position(date_posting)\n   444→                yield date_entry, date_postings, change, running_balance\n   445→\n   446→            date_entries.clear()\n   447→            assert not date_entries\n   448→\n   449→        if posting is not None:\n   450→            # De-dup multiple postings on the same transaction entry by\n   451→            # grouping their positions together.\n   452→            index = index_key(date_entries, entry, first, operator.is_)\n   453→            if index is None:\n   454→                date_entries.append((entry, [posting]))\n   455→            else:\n   456→                # We are indeed de-duping!\n   457→                postings = date_entries[index][1]\n   458→                postings.append(posting)\n   459→        else:\n   460→            # This is a regular entry; nothing to add/remove.\n   461→            date_entries.append((entry, []))\n   462→\n