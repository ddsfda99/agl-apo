he root account types, just the general syntax.\n    49\u2192\n    50\u2192    Args:\n    51\u2192      string: A string, to be checked for account name pattern.\n    52\u2192    Returns:\n    53\u2192      A boolean, true if the string has the form of an account's name.\n    54\u2192    \"\"\"\n    55\u2192    return (isinstance(string, str) and\n    56\u2192            bool(regex.match('{}$'.format(ACCOUNT_RE), string)))\n    57\u2192\n    58\u2192\n    59\u2192def join(*components: Tuple[str]) -> Account:\n    60\u2192    \"\"\"Join the names with the account separator.\n    61\u2192\n    62\u2192    Args:\n    63\u2192      *components: Strings, the components of an account name.\n    64\u2192    Returns:\n    65\u2192      A string, joined in a single account name.\n    66\u2192    \"\"\"\n    67\u2192    return sep.join(components)\n    68\u2192\n    69\u2192\n    70\u2192def split(account_name: Account) -> List[str]:\n    71\u2192    \"\"\"Split an account's name into its components.\n    72\u2192\n    73\u2192    Args:\n    74\u2192      account_name: A string, an account name.\n    75\u2192    Returns:\n    76\u2192      A list of strings, the components of the account name (without the separators).\n    77\u2192    \"\"\"\n    78\u2192    return account_name.split(sep)\n    79\u2192\n    80\u2192\n    81\u2192def parent(account_name: Account) -> Account:\n    82\u2192    \"\"\"Return the name of the parent account of the given account.\n    83\u2192\n    84\u2192    Args:\n    85\u2192      account_name: A string, the name of the account whose parent to return.\n    86\u2192    Returns:\n    87\u2192      A string, the name of the parent account of this account.\n    88\u2192    \"\"\"\n    89\u2192    assert isinstance(account_name, str), account_name\n    90\u2192    if not account_name:\n    91\u2192        return None\n    92\u2192    components = account_name.split(sep)\n    93\u2192    components.pop(-1)\n    94\u2192    return sep.join(components)\n    95\u2192\n    96\u2192\n    97\u2192def leaf(account_name: Account) -> Account:\n    98\u2192    \"\"\"Get the name of the leaf of this account.\n    99\u2192\n   100\u2192    Args:\n   101\u2192      account_name: A string, the name of the account whose leaf name to return.\n   102\u2192    Returns:\n   103\u2192      A string, the name of the leaf of the account.\n   104\u2192    \"\"\"\n   105\u2192    assert isinstance(account_name, str)\n   106\u2192    return account_name.split(sep)[-1] if account_name else None\n   107\u2192\n   108\u2192\n   109\u2192def sans_root(account_name: Account)-> Account:\n   110\u2192    \"\"\"Get the name of the account without the root.\n   111\u2192\n   112\u2192    For example, an input of 'Assets:BofA:Checking' will produce 'BofA:Checking'.\n   113\u2192\n   114\u2192    Args:\n   115\u2192      account_name: A string, the name of the account whose leaf name to return.\n   116\u2192    Returns:\n   117\u2192      A string, the name of the non-root portion of this account name.\n   118\u2192    \"\"\"\n   119\u2192    assert isinstance(account_name, str)\n   120\u2192    components = account_name.split(sep)[1:]\n   121\u2192    return join(*components) if account_name else None\n   122\u2192\n   123\u2192\n   124\u2192def root(num_components: int, account_name: Account) -> str:\n   125\u2192    \"\"\"Return the first few components of an account's name.\n   126\u2192\n   127\u2192    Args:\n   128\u2192      num_components: An integer, the number of components to return.\n   129\u2192      account_name: A string, an account name.\n   130\u2192    Returns:\n   131\u2192      A string, the account root up to 'num_components' components.\n   132\u2192    \"\"\"\n   133\u2192    return join(*(split(account_name)[:num_components]))\n   134\u2192\n   135\u2192\n   136\u2192def has_component(account_name: Account, component: str) -> bool:\n   137\u2192    \"\"\"Return true if one of the account contains a given component.\n   138\