r omap in itertools.chain((options_map,), other_options_map):\n   492→        if omap.get(\"insert_pythonpath\", False):\n   493→            pythonpath.add(path.dirname(omap[\"filename\"]))\n   494→    options_map[\"pythonpath\"] = sorted(pythonpath)\n   495→\n   496→    return options_map\n   497→\n   498→\n   499→def _load(sources, log_timings, extra_validations, encoding):\n   500→    \"\"\"Parse Beancount input, run its transformations and validate it.\n   501→\n   502→    (This is an internal method.)\n   503→    This routine does all that is necessary to obtain a list of entries ready\n   504→    for realization and working with them. This is the principal call for of the\n   505→    scripts that load a ledger. It returns a list of entries transformed and\n   506→    ready for reporting, a list of errors, and parser's options dict.\n   507→\n   508→    Args:\n   509→      sources: A list of (filename-or-string, is-filename) where the first\n   510→        element is a string, with either a filename or a string to be parsed directly,\n   511→        and the second argument is a boolean that is true if the first is a filename.\n   512→        You may provide a list of such arguments to be parsed. Filenames must be absolute\n   513→        paths.\n   514→      log_timings: A file object or function to write timings to,\n   515→        or None, if it should remain quiet.\n   516→      extra_validations: A list of extra validation functions to run after loading\n   517→        this list of entries.\n   518→      encoding: A string or None, the encoding to decode the input filename with.\n   519→    Returns:\n   520→      See load() or load_string().\n   521→    \"\"\"\n   522→    assert isinstance(sources, list) and all(isinstance(el, tuple) for el in sources)\n   523→\n   524→    if hasattr(log_timings, 'write'):\n   525→        log_timings = log_timings.write\n   526→\n   527→    # Parse all the files recursively. Ensure that the entries are sorted before\n   528→    # running any processes on them.\n   529→    with misc_utils.log_time('parse', log_timings, indent=1):\n   530→        entries, parse_errors, options_map = _parse_recursive(\n   531→            sources, log_timings, encoding)\n   532→        entries.sort(key=data.entry_sortkey)\n   533→\n   534→    # Run interpolation on incomplete entries.\n   535→    with misc_utils.log_time('booking', log_timings, indent=1):\n   536→        entries, balance_errors = booking.book(entries, options_map)\n   537→        parse_errors.extend(balance_errors)\n   538→\n   539→    # Transform the entries.\n   540→    with misc_utils.log_time('run_transformations', log_timings, indent=1):\n   541→\n   542→        # Insert the user PYTHONPATH entries before processing the plugins.\n   543→        saved_pythonpath = list(sys.path)\n   544→        try:\n   545→            if \"pythonpath\" in options_map:\n   546→                sys.path[0:0] = options_map[\"pythonpath\"]\n   547→            entries, errors = run_transformations(entries, parse_errors, options_map,\n   548→                                                  log_timings)\n   549→        finally:\n   550→            sys.path[:] = saved_pythonpath\n   551→\n   552→    # Validate the list of entries.\n   553→    with misc_utils.log_time('beancount.ops.validate', log_timings, indent=1):\n   554→        valid_errors = validation.validate(entries, options_map, log_timings,\n   555→                                           extra_validations)\n   556→        errors.extend(valid_errors)\n   557→\n   558→        # Note: We could go hardcore here and further verify that the entries\n   559→        # haven't been modified by user-provided validation routines, by\n   560→        # comparing hashes before and after. Not needed for now.\n   561→\n   562→    # Compute the input hash.\n   563→    options_map['input_hash'] = compute_input_hash(options_map['include'])\n   564→\n   565→    return entries, errors, options_map\n   566→\n   567→\