 ]\n   938\u2192                    )\n   939\u2192                )\n   940\u2192\n   941\u2192        with self.input.wait_bar(\"Building Debian package...\"):\n   942\u2192            try:\n   943\u2192                # Build the dpkg.\n   944\u2192                self.tools[app].app_context.run(\n   945\u2192                    [\n   946\u2192                        \"dpkg-deb\",\n   947\u2192                        \"--build\",\n   948\u2192                        \"--root-owner-group\",\n   949\u2192                        f\"{app.app_name}-{app.version}\",\n   950\u2192                    ],\n   951\u2192                    check=True,\n   952\u2192                    cwd=self.bundle_path(app),\n   953\u2192                )\n   954\u2192            except subprocess.CalledProcessError as e:\n   955\u2192                raise BriefcaseCommandError(\n   956\u2192                    f\"Error while building .deb package for {app.app_name}.\"\n   957\u2192                ) from e\n   958\u2192\n   959\u2192            # Move the deb file to its final location\n   960\u2192            self.tools.shutil.move(\n   961\u2192                self.bundle_path(app) / f\"{app.app_name}-{app.version}.deb\",\n   962\u2192                self.distribution_path(app),\n   963\u2192            )\n   964\u2192\n   965\u2192    def _package_rpm(self, app: AppConfig, **kwargs):  # pragma: no-cover-if-is-windows\n   966\u2192        self.logger.info(\"Building .rpm package...\", prefix=app.app_name)\n   967\u2192\n   968\u2192        # The long description *must* exist.\n   969\u2192        if app.long_description is None:\n   970\u2192            raise BriefcaseCommandError(\n   971\u2192                \"App configuration does not define `long_description`. \"\n   972\u2192                \"Red Hat projects require a long description.\"\n   973\u2192            )\n   974\u2192\n   975\u2192        # Generate the rpmbuild layout\n   976\u2192        rpmbuild_path = self.bundle_pat