ath)\n   906→\n   907→            DEBIAN_path.mkdir()\n   908→            # dpkg-dep requires \"DEBIAN\" directory is >=0755 and <=0775\n   909→            DEBIAN_path.chmod(0o755)\n   910→\n   911→            # Add runtime package dependencies. App config has been finalized,\n   912→            # so this will be the target-specific definition, if one exists.\n   913→            # libc6 is added because lintian complains without it, even though\n   914→            # it's a dependency of the thing we *do* care about - python.\n   915→            system_runtime_requires = \", \".join(\n   916→                [\n   917→                    f\"libc6 (>={app.glibc_version})\",\n   918→                    f\"libpython{app.python_version_tag}\",\n   919→                ]\n   920→                + getattr(app, \"system_runtime_requires\", [])\n   921→            )\n   922→\n   923→            with (DEBIAN_path / \"control\").open(\"w\", encoding=\"utf-8\") as f:\n   924→                f.write(\n   925→                    \"\\n\".join(\n   926→                        [\n   927→                            f\"Package: {app.app_name}\",\n   928→                            f\"Version: {app.version}\",\n   929→                            f\"Architecture: {self.deb_abi(app)}\",\n   930→                            f\"Maintainer: {app.author} <{app.author_email}>\",\n   931→                            f\"Homepage: {app.url}\",\n   932→                            f\"Description: {app.description}\",\n   933→                            f\" {debian_multiline_description(app.long_description)}\",\n   934→                            f\"Depends: {system_runtime_requires}\",\n   935→                            f\"Section: {getattr(app, 'system_section', 'utils')}\",\n   936→                            \"Priority: optional\\n\",\n   937→                        ]\n   938→                    )\n   939→                )\n   940→\n   941→        with self.input.wait_bar(\"Building Debian packag