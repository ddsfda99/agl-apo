omment_note %{nil}\",\n   175\u2192                \"%global __brp_check_rpaths %{nil}\",\n   176\u2192                \"%global __requires_exclude_from ^%{_libdir}/first-app/.*$\",\n   177\u2192                \"%global __provides_exclude_from ^%{_libdir}/first-app/.*$\",\n   178\u2192                \"%global _enable_debug_package 0\",\n   179\u2192                \"%global debug_package %{nil}\",\n   180\u2192                \"\",\n   181\u2192                \"Name:           first-app\",\n   182\u2192                \"Version:        0.0.1\",\n   183\u2192                \"Release:        1%{?dist}\",\n   184\u2192                \"Summary:        The first simple app \\\\ demonstration\",\n   185\u2192                \"\",\n   186\u2192                \"License:        Unknown\",\n   187\u2192                \"URL:            https://example.com/first-app\",\n   188\u2192                \"Source0:        %{name}-%{version}.tar.gz\",\n   189\u2192                \"\",\n   190\u2192                \"Requires:       python3\",\n   191\u2192                \"\",\n   192\u2192                \"ExclusiveArch:  wonky\",\n   193\u2192                \"\",\n   194\u2192                \"%description\",\n   195\u2192                \"Long description\",\n   196\u2192                \"for the app\",\n   197\u2192                \"\",\n   198\u2192                \"%prep\",\n   199\u2192                \"%autosetup\",\n   200\u2192                \"\",\n   201\u2192                \"%build\",\n   202\u2192                \"\",\n   203\u2192                \"%install\",\n   204\u2192                \"cp -r usr %{buildroot}/usr\",\n   205\u2192                \"\",\n   206\u2192                \"%files\",\n   207\u2192                '\"/usr/bin/first-app\"',\n   208\u2192                '%dir \"/usr/lib/first-app\"',\n   209\u2192                '%dir \"/usr/lib/first-app/app\"',\n   210\u2192                '\"/usr/lib/first-app/app/support.so\"',\n   211\u2192           