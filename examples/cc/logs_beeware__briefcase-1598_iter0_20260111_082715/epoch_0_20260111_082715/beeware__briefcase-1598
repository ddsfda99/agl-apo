ols.\"\"\"\n   835\u2192        if not Path(\"/usr/bin/dpkg-deb\").exists():\n   836\u2192            raise BriefcaseCommandError(\n   837\u2192                \"Can't find the dpkg tools. Try running `sudo apt install dpkg-dev`.\"\n   838\u2192            )\n   839\u2192\n   840\u2192    def _verify_rpm_tools(self):\n   841\u2192        \"\"\"Verify that the local environment contains the redhat packaging tools.\"\"\"\n   842\u2192        if not Path(\"/usr/bin/rpmbuild\").exists():\n   843\u2192            raise BriefcaseCommandError(\n   844\u2192                \"Can't find the rpm-build tools. Try running `sudo dnf install rpm-build`.\"\n   845\u2192            )\n   846\u2192\n   847\u2192    def _verify_pkg_tools(self):\n   848\u2192        \"\"\"Verify that the local environment contains the arch packaging tools(ABS).\"\"\"\n   849\u2192        if not Path(\"/usr/bin/makepkg\").exists():\n   850\u2192            raise BriefcaseCommandError(\n   851\u2192                \"Can't find the `makepkg` tool. Try running `sudo pacman -Syu pacman`.\"\n   852\u2192                # makepkg is part of pacman package\n   853\u2192            )\n   854\u2192\n   855\u2192    def verify_app_tools(self, app):\n   856\u2192        super().verify_app_tools(app)\n   857\u2192        # If \"system\" packaging format was selected, determine what that means.\n   858\u2192        if app.packaging_format == \"system\":\n   859\u2192            app.packaging_format = {\n   860\u2192                DEBIAN: \"deb\",\n   861\u2192                RHEL: \"rpm\",\n   862\u2192                ARCH: \"pkg\",\n   863\u2192                SUSE: \"rpm\",\n   864\u2192            }.get(app.target_vendor_base, None)\n   865\u2192\n   866\u2192        if app.packaging_format is None:\n   867\u2192            raise BriefcaseCommandError(\n   868\u2192                \"Briefcase doesn't know the system packaging format for \"\n   869\u2192                f\"{app.target_vendor}. You may be able to build a package \"\n   870\u2192                \"by manually specifying a format with -p/--packaging-format\"\n   871\u2192            )\n   872\u2192\n   873\u2192        if not self.use_docker:\n   874\u2192            # Check for the format-specific packaging tools.\n   875\u2192            getattr(self, f\"_verify_{app.packaging_format}_tools\")()\n   876\u2192\n   877\u2192    def package_app(self, app: AppConfig, **kwargs):\n   878\u2192        if app.packaging_format == \"deb\":\n   879\u2192            self._package_deb(app, **kwargs)\n   880\u2192        elif app.packaging_format == \"rpm\":\n   881\u2192            self._package_rpm(app, **kwargs)\n   882\u2192        elif app.packaging_format == \"pkg\":\n   883\u2192            self._package_pkg(app, **kwargs)\n   884\u2192        else:\n   885\u2192            raise BriefcaseCommandError(\n   886\u2192                \"Briefcase doesn't currently know how to build system packages in \"\n   887\u2192                f\"{app.packaging_format.upper()} format.\"\n   888\u2192            )\n   889\u2192\n   890\u2192    def _package_deb(self, app: AppConfig, **kwargs):\n   891\u2192        self.logger.info(\"Building .deb package...\", prefix=app.app_name)\n   892\u2192\n   893\u2192        # The long description *must* exist.\n   894\u2192        if app.long_description is None:\n   895\u2192            raise BriefcaseCommandError(\n   896\u2192                \"App configuration does not define `long_description`. \"\n   897\u2192                \"Debian projects require a long description.\"\n   898\u2192            )\n   899\u2192\n   900\u2192        # Write the Debian metadata control file.\n   901\u2192        with self.input.wait_bar(\"Write Debian package control file...\"):\n   902\u2192            DEBIAN_path = self.project_path(app) / \"DEBIAN\"\n   903\u2192\n   904\u2192            if DEBIAN_path.exists():\n   905\u2192                self.tools.shutil.rmtree(DEBIAN_path)\n   906\u2192\n   907\