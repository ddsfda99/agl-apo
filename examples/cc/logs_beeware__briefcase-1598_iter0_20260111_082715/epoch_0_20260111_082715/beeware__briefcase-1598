erms & 0o007\n   758\u2192\n   759\u2192                # File permissions like 775 and 664 (where the group and user\n   760\u2192                # permissions are the same), cause Debian heartburn. So, make\n   761\u2192                # sure the group and world permissions are the same\n   762\u2192                new_perms = user_perms | (world_perms << 3) | world_perms\n   763\u2192\n   764\u2192                # If there's been any change in permissions, apply them\n   765\u2192                if new_perms != old_perms:  # pragma: no-cover-if-is-windows\n   766\u2192                    self.logger.info(\n   767\u2192                        \"Updating file permissions on \"\n   768\u2192                        f\"{path.relative_to(self.bundle_path(app))} \"\n   769\u2192                        f\"from {oct(old_perms)[2:]} to {oct(new_perms)[2:]}\"\n   770\u2192                    )\n   771\u2192                    path.chmod(new_perms)\n   772\u2192\n   773\u2192        with self.input.wait_bar(\"Stripping binary...\"):\n   774\u2192            self.tools.subprocess.check_output([\"strip\", self.binary_path(app)])\n   775\u2192\n   776\u2192\n   777\u2192class LinuxSystemRunCommand(LinuxSystemPassiveMixin, RunCommand):\n   778\u2192    description = \"Run a Linux system project.\"\n   779\u2192    supported_host_os = {\"Linux\"}\n   780\u2192    supported_host_os_reason = \"Linux system projects can only be executed on Linux.\"\n   781\u2192\n   782\u2192    def run_app(\n   783\u2192        self, app: AppConfig, test_mode: bool, passthrough: List[str], **kwargs\n   784\u2192    ):\n   785\u2192        \"\"\"Start the application.\n   786\u2192\n   787\u2192        :param app: The config object for the app\n   788\u2192        :param test_mode: Boolean; Is the app running in test mode?\n   789\u2192        :param passthrough: The list of arguments to pass to the app\n   790\u2192        \"\"\"\n   791\u2192        # Set up the log stream\n   792\u2192        kw