98\u2192        geometry,\n   199\u2192        np.bool_(hex),\n   200\u2192        np.intc(output_dimension),\n   201\u2192        np.intc(byte_order),\n   202\u2192        np.bool_(include_srid),\n   203\u2192        np.intc(flavor),\n   204\u2192        **kwargs,\n   205\u2192    )\n   206\u2192\n   207\u2192\n   208\u2192@requires_geos(\"3.10.0\")\n   209\u2192def to_geojson(geometry, indent=None, **kwargs):\n   210\u2192    \"\"\"Convert to the GeoJSON representation of a Geometry.\n   211\u2192\n   212\u2192    The GeoJSON format is defined in the `RFC 7946 <https://geojson.org/>`__.\n   213\u2192    NaN (not-a-number) coordinates will be written as 'null'.\n   214\u2192\n   215\u2192    The following are currently unsupported:\n   216\u2192\n   217\u2192    - Geometries of type LINEARRING: these are output as 'null'.\n   218\u2192    - Three-dimensional geometries: the third dimension is ignored.\n   219\u2192\n   220\u2192    Parameters\n   221\u2192    ----------\n   222\u2192    geometry : str, bytes or array_like\n   223\u2192        Geometry or geometries to convert to GeoJSON.\n   224\u2192    indent : int, optional\n   225\u2192        If indent is a non-negative integer, then GeoJSON will be formatted.\n   226\u2192        An indent level of 0 will only insert newlines. None (the default)\n   227\u2192        selects the most compact representation.\n   228\u2192    **kwargs\n   229\u2192        See :ref:`NumPy ufunc docs <ufuncs.kwargs>` for other keyword arguments.\n   230\u2192\n   231\u2192    Examples\n   232\u2192    --------\n   233\u2192    >>> from shapely import Point\n   234\u2192    >>> point = Point(1, 1)\n   235\u2192    >>> to_geojson(point)\n   236\u2192    '{\"type\":\"Point\",\"coordinates\":[1.0,1.0]}'\n   237\u2192    >>> print(to_geojson(point, indent=2))\n   238\u2192    {\n   239\u2192      \"type\": \"Point\",\n   240\u2192      \"coordinates\": [\n   241\u2192          1.0,\n   242\u2192          1.0\n   243\u2192      ]\n   24