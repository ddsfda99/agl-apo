sert_geometries_equal(actual, expected)\n   221\u2192\n   222\u2192\n   223\u2192def test_from_wkb_none():\n   224\u2192    # None propagates\n   225\u2192    assert shapely.from_wkb(None) is None\n   226\u2192\n   227\u2192\n   228\u2192def test_from_wkb_exceptions():\n   229\u2192    with pytest.raises(TypeError, match=\"Expected bytes or string, got int\"):\n   230\u2192        shapely.from_wkb(1)\n   231\u2192\n   232\u2192    # invalid WKB\n   233\u2192    with pytest.raises(\n   234\u2192        shapely.GEOSException,\n   235\u2192        match=(\n   236\u2192            \"Unexpected EOF parsing WKB|\"\n   237\u2192            \"ParseException: Input buffer is smaller than requested object size\"\n   238\u2192        ),\n   239\u2192    ):\n   240\u2192        result = shapely.from_wkb(b\"\\x01\\x01\\x00\\x00\\x00\\x00\")\n   241\u2192        assert result is None\n   242\u2192\n   243\u2192    # invalid ring in WKB\n   244\u2192    with pytest.raises(\n   245\u2192        shapely.GEOSException,\n   246\u2192        match=\"Points of LinearRing do not form a closed linestring\",\n   247\u2192    ):\n   248\u2192        result = shapely.from_wkb(INVALID_WKB)\n   249\u2192        assert result is None\n   250\u2192\n   251\u2192\n   252\u2192def test_from_wkb_warn_on_invalid_warn():\n   253\u2192    # invalid WKB\n   254\u2192    with pytest.warns(Warning, match=\"Invalid WKB\"):\n   255\u2192        result = shapely.from_wkb(b\"\\x01\\x01\\x00\\x00\\x00\\x00\", on_invalid=\"warn\")\n   256\u2192        assert result is None\n   257\u2192\n   258\u2192    # invalid ring in WKB\n   259\u2192    with pytest.warns(Warning, match=\"Invalid WKB\"):\n   260\u2192        result = shapely.from_wkb(INVALID_WKB, on_invalid=\"warn\")\n   261\u2192        assert result is None\n   262\u2192\n   263\u2192\n   264\u2192def test_from_wkb_ignore_on_invalid_ignore():\n   265\u2192    # invalid WKB\n   266\u2192    with warnings.catch_warnings():\n   267\u2192        warnings.simplefilter(\"error\")  # no warning\n   268\u2192        result = shapely.from_wkb(b\"\\x01\\x01\\x00\\x00\\x00\\x00\", on_invalid=\"ignore\")\n   269\u2192        assert result is None\n   270\u2192\n   271\u2192    # invalid ring in WKB\n   272\u2192    with warnings.catch_warnings():\n   273\u2192        warnings.simplefilter(\"error\")  # no warning\n   274\u2192        result = shapely.from_wkb(INVALID_WKB, on_invalid=\"ignore\")\n   275\u2192        assert result is None\n   276\u2192\n   277\u2192\n   278\u2192def test_from_wkb_on_invalid_unsupported_option():\n   279\u2192    with pytest.raises(ValueError, match=\"not a valid option\"):\n   280\u2192        shapely.from_wkb(b\"\\x01\\x01\\x00\\x00\\x00\\x00\", on_invalid=\"unsupported_option\")\n   281\u2192\n   282\u2192\n   283\u2192@pytest.mark.parametrize(\"geom\", all_types)\n   284\u2192@pytest.mark.parametrize(\"use_hex\", [False, True])\n   285\u2192@pytest.mark.parametrize(\"byte_order\", [0, 1])\n   286\u2192def test_from_wkb_all_types(geom, use_hex, byte_order):\n   287\u2192    if shapely.get_type_id(geom) == shapely.GeometryType.LINEARRING:\n   288\u2192        pytest.skip(\"Linearrings are not preserved in WKB\")\n   289\u2192    wkb = shapely.to_wkb(geom, hex=use_hex, byte_order=byte_order)\n   290\u2192    actual = shapely.from_wkb(wkb)\n   291\u2192    assert_geometries_equal(actual, geom)\n   292\u2192\n   293\u2192\n   294\u2192@pytest.mark.parametrize(\"geom\", all_types_z)\n   295\u2192@pytest.mark.parametrize(\"use_hex\", [False, True])\n   296\u2192@pytest.mark.parametrize(\"byte_order\", [0, 1])\n   297\u2192def test_from_wkb_all_types_z(geom, use_hex, byte_order):\n   298\u2192    if shapely.get_type_id(geom) == shapely.GeometryType.LINEARRING:\n   299\u2192        pytest.skip(\"Linearrings are not preserved in WKB\")\n   300\u2192    wkb = shapely.to_wkb(geom, hex=use_hex, byte_order=byte_order)\n   301\u2192    actual = shapely.from_wkb(wkb)\n   302\u2192    assert_geometries_equal(actual, geom)\n   303\u2192\n   304\u2192\n   305\u2192@pytest.mark.skipif(\n   306\u2192    shapely.geos_version < (3, 12, 0),\n   307\u2192    reason=\"M coordinates not supported with GEOS < 3.12\",\n   308\u2192)\n   309\u2192@pytest.mark.parametrize(\"geom\", all_types_m)\n   310\u2192@pytest.mark.parametrize(\"use_hex\", [False, True])\n   311\u2192@pytest.mark.parametrize(\"byte_order\", [0, 1])\n   312\u2192def test_from_wkb_all_types_m(geom, use_hex, byte_order):\n   313\u2192    if shapely.get_type_id(geom) == shapely.GeometryType.LINEARRING:\n   314\u2192        pytest.skip(\"Linearrings are not preserved in WKB\")\n   315\u2192    wkb = shapely.to_wkb(geom, hex=use_hex, byte_order=byte_order)\n   316\u2192    actual = shapely.from_wkb(wkb)\n   317\u2192    assert_geometries_equal(actual, geom)\n   318\u2192\n   319\u2192\n   320\u2192@pytest.mark.skipif(\n   321\u2192    shapely.geos_version < (3, 12, 0),\n   322\u2192    reason=\"M coordinates not supported with GEOS < 3.12\",\n   323\u2192)\n   324\u2192@pytest.mark.parametrize(\"geom\", all_types_zm)\n   325\u2192@pytest.mark.parametrize(\"use_hex\", [False, True])\n   326\u2192@pytest.mark.parametrize(\"byte_order\", [0, 1])\n   327\u2192def test_from_wkb_all_types_zm(geom, use_hex, byte_order):\n   328\u2192    if shapely.get_type_id(geom) == shapely.GeometryType.LINEARRING:\n   329\u2192        pytest.skip(\"Linearrings are not preserved in WKB\")\n   330\u2192    wkb = shapely.to_wkb(geom, hex=use_hex, byte_order=byte_order)\n   331\u2192    actual = shapely.from_wkb(wkb)\n   332\u2192    assert_geometries_equal(actual, geom)\n   333\u2192\n   334\u2192\n   335\u2192@pytest.mark.parametrize(\n   336\u2192    \"geom\",\n   337\u2192    (Point(), LineString(), Polygon(), GeometryCollection()),\n   338\u2192)\n   339\u2192def test_from_wkb_empty(geom):\n   340\u2192    wkb = shapely.to_wkb(geom)\n   341\u2192    geom = shapely.from_wkb(wkb)\n   342\u2192    assert shapely.is_geometry(geom).all()\n   343\u2192    assert shapely.is_empty(geom).all()\n   344\u2192    assert shapely.to_wkb(geom) == wkb\n   345\u2192\n   346\u2192\n   347\u2192def test_to_wkt():\n   348\u2192    point = shapely.points(1, 1)\n   349\u2192    actual = shapely.to_wkt(point)\n   350\u2192    assert actual == \"POINT (1 1)\"\n   351\u2192\n   352\u2192    actual = shapely.to_wkt(point, trim=False)\n   353\u2192    assert actual == \"POINT (1.000000 1.000000)\"\n   354\u2192\n   355\u2192    actual = shapely.to_wkt(point, rounding_precision=3, trim=False)\n   356\u2192    assert actual == \"POINT (1.000 1.000)\"\n   357\u2192\n   358\u2192\n   359\u2192def test_to_wkt_z():\n   360\u2192    point = shapely.points(1, 2, 3)\n   361\u2192\n   362\u2192    assert shapely.to_wkt(point) == \"POINT Z (1 2 3)\"\n   363\u2192    assert shapely.to_wkt(point, output_dimension=2) == \"POINT (1 2)\"\n   364\u2192    assert shapely.to_wkt(point, output_dimension=3) == \"POINT Z (1 2 3)\"\n   365\u2192    assert shapely.to_wkt(point, old_3d=True) == \"POINT (1 2 3)\"\n   366\u2192\n   367\u2192    if shapely.geos_version >= (3, 12, 0):\n   368\u2192        assert shapely.to_wkt(point, output_dimension=4) == \"POINT Z (1 2 3)\"\n   369\u2192\n   370\u2192\n   371\u2192def test_to_wkt_m():\n   372\u2192    point = shapely.from_wkt(\"POINT M (1 2 4)\")\n   373\u2192\n   374\u2192    assert shapely.to_wkt(point, output_dimension=2) == \"POINT (1 2)\"\n   375\u2192\n   376\u2192    if shapely.geos_version < (3, 12, 0):\n   377\u2192        # previous behavior was to incorrectly parse M as Z\n   378\u2192        assert shapely.to_wkt(point) == \"POINT Z (1 2 4)\"\n   379\u2192        assert shapely.to_wkt(point, output_dimension=3) == \"POINT Z (1 2 4)\"\n   380\u2192        assert shapely.to_wkt(point, old_3d=True) == \"POINT (1 2 4)\"\n   381\u2192    else:\n   382\u2192        assert shapely.to_wkt(point) == \"POINT M (1 2 4)\"\n   383\u2192        assert shapely.to_wkt(point, output_dimension=3) == \"POINT M (1 2 4)\"\n   384\u2192        assert shapely.to_wkt(point, output_dimension=4) == \"POINT M (1 2 4)\"\n   385\u2192        assert shapely.to_wkt(point, old_3d=True) == \"POINT M (1 2 4)\"\n   386\u2192\n   387\u2192\n   388\u2192def test_to_wkt_zm():\n   389\u2192    point = shapely.from_wkt(\"POINT ZM (1 2 3 4)\")\n   390\u2192\n   391\u2192    assert shapely.to_wkt(point, output_dimension=2) == \"POINT (1 2)\"\n   392\u2192    assert shapely.to_wkt(point, output_dimension=3) == \"POINT Z (1 2 3)\"\n   393\u2192\n   394\u2192    if shapely.geos_version < (3, 12, 0):\n   395\u2192        # previous behavior was to parse and ignore M\n   396\u2192        assert shapely.to_wkt(point) == \"POINT Z (1 2 3)\"\n   397\u2192        assert shapely.to_wkt(point, old_3d=True) == \"POINT (1 2 3)\"\n   398\u2192    else:\n   399\u2192        assert shapely.to_wkt(point) == \"POINT ZM (1 2 3 4)\"\n   400\u2192        assert shapely.to_wkt(point, output_dimension=4) == \"POINT ZM (1 2 3 4)\"\n   401\u2192        assert shapely.to_wkt(point, old_3d=True) == \"POINT (1 2 3 4)\"\n   402\u2192\n   403\u2192\n   404\u2192def test_to_wkt_none():\n   405\u2192    # None propagates\n   406\u2192    assert shapely.to_wkt(None) is None\n   407\u2192\n   408\u2192\n   409\u2192def test_to_wkt_array_with_empty_z():\n   410\u2192    # See GH-2004\n   411\u2192    empty_wkt = [\"POINT Z EMPTY\", None, \"POLYGON Z EMPTY\"]\n   412\u2192    empty_geoms = shapely.from_wkt(empty_wkt)\n   413\u2192    assert list(shapely.to_wkt(empty_geoms)) == empty_wkt\n   414\u2192\n   415\u2192\n   416\u2192def test_to_wkt_exceptions():\n   417\u2192    with pytest.raises(TypeError):\n   418\u2192        shapely.to_wkt(1)\n   419\u2192\n   420\u2192    with pytest.raises(shapely.GEOSException):\n   421\u2192        shapely.to_wkt(point, output_dimension=5)\n   422\u2192\n   423\u2192\n   424\u2192def test_to_wkt_point_empty():\n   425\u2192    assert shapely.to_wkt(empty_point) == \"POINT EMPTY\"\n   426\u2192\n   427\u2192\n   428\u2192@pytest.mark.parametrize(\n   429\u2192    \"wkt\",\n   430\u2192    [\n   431\u2192        \"POINT Z EMPTY\",\n   432\u2192        \"LINESTRING Z EMPTY\",\n   433\u2192        \"LINEARRING Z EMPTY\",\n   434\u2192        \"POLYGON Z EMPTY\",\n   435\u2192    ],\n   436\u2192)\n   437\u2192def test_to_wkt_empty_z(wkt):\n   438\u2192    assert shapely.to_wkt(shapely.from_wkt(wkt)) == wkt\n   439\u2192\n   440\u2192\n   441\u2192def test_to_wkt_geometrycollection_with_point_empty():\n   442\u2192    collection = shapely.geometrycollections([empty_point, point])\n   443\u2192    # do not check the full value as some GEOS versions give\n   444\u2192    # GEOMETRYCOLLECTION Z (...) and others give GEOMETRYCOLLECTION (...)\n   445\u2192    assert shapely.to_wkt(collection).endswith(\"(POINT EMPTY, POINT (2 3))\")\n   446\u2192\n   447\u2192\n   448\u2192def test_to_wkt_multipoint_with_point_empty():\n   449\u2192    geom = shapely.multipoints([empty_point, point])\n   450\u2192    if shapely.geos_version >= (3, 12, 0):\n   451\u2192        expected = \"MULTIPOINT (EMPTY, (2 3))\"\n   452\u2192    else:\n   453\u2192        # invalid WKT form\n   454\u2192        expected = \"MULTIPOINT (EMPTY, 2 3)\"\n   455\u2192    assert shapely.to_wkt(geom) == expected\n   456\u2192\n   457\u2192\n   458\u2192@pytest.mark.parametrize(\"geom\", [Point(1e100, 0), Point(0, 1e100)])\n   459\u2192def test_to_wkt_large_float_ok(geom):\n   460\u2192    # https://github.com/shapely/shapely/issues/1903\n   461\u2192    shapely.to_wkt(geom)\n   462\u2192    assert \"Exception in WKT writer\" not in repr(geom)\n   463\u2192\n   464\u2192\n   465\u2192@pytest.mark.parametrize(\"geom\", [Point(1e101, 0), Point(0, 1e101)])\n   466\u2192def test_to_wkt_large_float(geom):\n   467\u2192    if shapely.geos_version >= (3, 13, 0):\n   468\u2192        # round-trip WKT\n   469\u2192        assert geom.equals(shapely.from_wkt(shapely.to_wkt(geom)))\n   470\u2192    else:\n   471\u2192        # https://github.com/shapely/shapely/issues/1903\n   472\u2192        with pytest.raises(\n   473\u2192            ValueError, match=\"WKT output of coordinates greater than.*\"\n   474\u2192        ):\n   475\u2192            shapely.to_wkt(geom)\n   476\u2192        assert \"Exception in WKT writer\" in repr(geom)\n   477\u2192\n   478\u2192\n   479\u2192@pytest.mark.parametrize(\n   480\u2192    \"geom\",\n   481\u2192    [\n   482\u2192        # We implemented our own \"GetZMax\", so go through all geometry types:\n   483\u2192        Point(0, 0, 1e101),\n   484\u2192        LineString([(0, 0, 0), (0, 0, 1e101)]),\n   485\u2192        LinearRing([(0, 0, 0), (0, 1, 0), (1, 0, 1e101), (0, 0, 0)]),\n   486\u2192        Polygon([(0, 0, 0), (0, 1, 0), (1, 0, 1e101), (0, 0, 0)]),\n   487\u2192        Polygon(\n   488\u2192            [(0, 0, 0), (0, 10, 0), (10, 0, 0), (0, 0, 0)],\n   489\u2192            [[(0, 0, 0), (0, 1, 0), (1, 0, 1e101), (0, 0, 0)]],\n   490\u2192        ),\n   491\u2192        MultiPoint([(0, 0, 0), (0, 0, 1e101)]),\n   492\u2192        MultiLineString(\n   493\u2192            [LineString([(0, 0, 0), (0, 1, 0)]), LineString([(0, 0, 0), (0, 1, 1e101)])]\n   494\u2192        ),\n   495\u2192        MultiPolygon(\n   496\u2192            [polygon_z, Polygon([(0, 0, 0), (0, 1, 0), (1, 0, 1e101), (0, 0, 0)])]\n   497\u2192        ),\n   498\u2192        GeometryCollection([point_z, Point(0, 0, 1e101)]),\n   499\u2192        GeometryCollection([GeometryCollection([Point(0, 0, 1e101)])]),\n   500\u2192        LineString([(0, 0, np.nan), (0, 0, 1e101)]),\n   501\u2192        Polygon([(0, 0, np.nan), (0, 1, 0), (1, 0, 1e101), (0, 0, 0)]),\n   502\u2192        GeometryCollection([Point(0, 0), Point(0, 0, 1e101)]),\n   503\u2192    ],\n   504\u2192)\n   505\u2192def test_to_wkt_large_float_3d_no_crash(geom):\n   506\u2192    # https://github.com/shapely/shapely/issues/1903\n   507\u2192    # just test if there is a crash (detailed behaviour differs per GEOS version)\n   508\u2192    try:\n   509\u2192        shapely.to_wkt(geom)\n   510\u2192    except ValueError as e:\n   511\u2192        assert str(e).startswith(\"WKT output of coordinates greater than\")\n   512\u2192    repr(geom)\n   513\u2192\n   514\u2192\n   515\u2192def test_to_wkt_large_float_skip_z():\n   516\u2192    # https://github.com/shapely/shapely/issues/1903\n   517\u2192    assert shapely.to_wkt(Point(0, 0, 1e101), output_dimension=2) == \"POINT (0 0)\"\n   518\u2192\n   519\u2192\n   520\u2192def test_to_wkt_large_float_no_trim():\n   521\u2192    # https://github.com/shapely/shapely/issues/1903\n   522\u2192    # don't test the exact number, it is ridiculously large and probably platform\n   523\u2192    # dependent\n   524\u2192    assert shapely.to_wkt(Point(1e101, 0), trim=False).startswith(\"POINT (\")\n   525\u2192\n   526\u2192\n   527\u2192def test_repr():\n   528\u2192    assert repr(point) == \"<POINT (2 3)>\"\n   529\u2192    assert repr(point_z) == \"<POINT Z (2 3 4)>\"\n   530\u2192\n   531\u2192\n   532\u2192@pytest.mark.skipif(\n   533\u2192    shapely.geos_version < (3, 12, 0),\n   534\u2192    reason=\"M coordinates not supported with GEOS < 3.12\",\n   535\u2192)\n   536\u2192def test_repr_m():\n   537\u2192    assert repr(point_m) == \"<POINT M (2 3 5)>\"\n   538\u2192    assert repr(point_zm) == \"<POINT ZM (2 3 4 5)>\"\n   539\u2192\n   540\u2192\n   541\u2192def test_repr_max_length():\n   542\u2192    # the repr is limited to 80 characters\n   543\u2192    geom = shapely.linestrings(np.arange(1000), np.arange(1000))\n   544\u2192    representation = repr(geom)\n   545\u2192    assert len(representation) == 80\n   546\u2192    assert representation.endswith(\"...>\")\n   547\u2192\n   548\u2192\n   549\u2192def test_repr_point_z_empty():\n   550\u2192    assert repr(empty_point_z) == \"<POINT Z EMPTY>\"\n   551\u2192\n   552\u2192\n   553\u2192@pytest.mark.skipif(\n   554\u2192    shapely.geos_version < (3, 12, 0),\n   555\u2192    reason=\"M coordinates not supported with GEOS < 3.12\",\n   556\u2192)\n   557\u2192def test_repr_point_m_empty():\n   558\u2192    assert repr(empty_point_m) == \"<POINT M EMPTY>\"\n   559\u2192    assert repr(empty_point_zm) == \"<POINT ZM EMPTY>\"\n   560\u2192\n   561\u2192\n   562\u2192def test_to_wkb():\n   563\u2192    point = shapely.points(1, 1)\n   564\u2192    actual = shapely.to_wkb(point, byte_order=1)\n   565\u2192    assert actual == POINT11_WKB\n   566\u2192\n   567\u2192\n   568\u2192def test_to_wkb_hex():\n   569\u2192    point = shapely.points(1, 1)\n   570\u2192    actual = shapely.to_wkb(point, hex=True, byte_order=1)\n   571\u2192    le = \"01\"\n   572\u2192    point_type = \"01000000\"\n   573\u2192    coord = \"000000000000F03F\"  # 1.0 as double (LE)\n   574\u2192    assert actual == le + point_type + 2 * coord\n   575\u2192\n   576\u2192\n   577\u2192def test_to_wkb_z():\n   578\u2192    point = shapely.points(1, 2, 3)\n   579\u2192\n   580\u2192    expected_wkb = struct.pack(\"<BI2d\", 1, 1, 1.0, 2.0)\n   581\u2192    expected_wkb_z = struct.pack(\"<BI3d\", 1, 1 | EWKBZ, 1.0, 2.0, 3.0)\n   582\u2192\n   583\u2192    assert shapely.to_wkb(point, byte_order=1) == expected_wkb_z\n   584\u2192    assert shapely.to_wkb(point, output_dimension=2, byte_order=1) == expected_wkb\n   585\u2192    assert shapely.to_wkb(point, output_dimension=3, byte_order=1) == expected_wkb_z\n   586\u2192    if shapely.geos_version >= (3, 12, 0):\n   587\u2192        assert shapely.to_wkb(point, output_dimension=4, byte_order=1) == expected_wkb_z\n   588\u2192\n   589\u2192\n   590\u2192def test_to_wkb_m():\n   591\u2192    # POINT M (1 2 4)\n   592\u2192    point = shapely.from_wkb(struct.pack(\"<BI3d\", 1, 1 | EWKBM, 1.0, 2.0, 4.0))\n   593\u2192\n   594\u2192    expected_wkb = struct.pack(\"<BI2d\", 1, 1, 1.0, 2.0)\n   595\u2192    expected_wkb_m = struct.pack(\"<BI3d\", 1, 1 | EWKBM, 1.0, 2.0, 4.0)\n   596\u2192    if shapely.geos_version < (3, 12, 0):\n   597\u2192        # previous behavior was to ignore M, treat as 2D\n   598\u2192        expected_wkb_m = expected_wkb\n   599\u2192\n   600\u2192    assert shapely.to_wkb(point, byte_order=1) == expected_wkb_m\n   601\u2192    assert shapely.to_wkb(point, output_dimension=2, byte_order=1) == expected_wkb\n   602\u2192    assert shapely.to_wkb(point, output_dimension=3, byte_order=1) == expected_wkb_m\n   603\u2192    if shapely.geos_version >= (3, 12, 0):\n   604\u2192        assert shapely.to_wkb(point, output_dimension=4, byte_order=1) == expected_wkb_m\n   605\u2192\n   606\u2192\n   607\u2192def test_to_wkb_zm():\n   608\u2192    # POINT ZM (1 2 3 4)\n   609\u2192    point = shapely.from_wkb(struct.pack(\"<BI4d\", 1, 1 | EWKBZM, 1.0, 2.0, 3.0, 4.0))\n   610\u2192\n   611\u2192    expected_wkb = struct.pack(\"<BI2d\", 1, 1, 1.0, 2.0)\n   612\u2192    expected_wkb_z = struct.pack(\"<BI3d\", 1, 1 | EWKBZ, 1.0, 2.0, 3.0)\n   613\u2192    expected_wkb_zm = struct.pack(\"<BI4d\", 1, 1 | EWKBZM, 1.0, 2.0, 3.0, 4.0)\n   614\u2192    if shapely.geos_version < (3, 12, 0):\n   615\u2192        # previous behavior was to ignore M, treat as XYZ\n   616\u2192        expected_wkb_zm = expected_wkb_z\n   617\u2192\n   618\u2192    assert shapely.to_wkb(point, byte_order=1) == expected_wkb_zm\n   619\u2192    assert shapely.to_wkb(point, output_dimension=2, byte_order=1) == expected_wkb\n   620\u2192    assert shapely.to_wkb(point, output_dimension=3, byte_order=1) == expected_wkb_z\n   621\u2192    if shapely.geos_version >= (3, 12, 0):\n   622\u2192        assert (\n   623\u2192            shapely.to_wkb(point, output_dimension=4, byte_order=1) == expected_wkb_zm\n   624\u2192        )\n   625\u2192\n   626\u2192\n   627\u2192def test_to_wkb_none():\n   628\u2192    # None propagates\n   629\u2192    assert shapely.to_wkb(None) is None\n   630\u2192\n   631\u2192\n   632\u2192def test_to_wkb_exceptions():\n   633\u2192    with pytest.raises(TypeError):\n   634\u2192        shapely.to_wkb(1)\n   635\u2192\n   636\u2192    with pytest.raises(shapely.GEOSException):\n   637\u2192        shapely.to_wkb(point, output_dimension=5)\n   638\u2192\n   639\u2192    with pytest.raises(ValueError):\n   640\u2192        shapely.to_wkb(point, flavor=\"other\")\n   641\u2192\n   642\u2192\n   643\u2192def test_to_wkb_byte_order():\n   644\u2192    point = shapely.points(1.0, 1.0)\n   645\u2192    be = b\"\\x00\"\n   646\u2192    le = b\"\\x01\"\n   647\u2192    point_type = b\"\\x01\\x00\\x00\\x00\"  # 1 as 32-bit uint (LE)\n   648\u2192    coord = b\"\\x00\\x00\\x00\\x00\\x00\\x00\\xf0?\"  # 1.0 as double (LE)\n   649\u2192\n   650\u2192    assert shapely.to_wkb(point, byte_order=1) == le + point_type + 2 * coord\n   651\u2192    assert (\n   652\u2192        shapely.to_wkb(point, byte_order=0) == be + point_type[::-1] + 2 * coord[::-1]\n   653\u2192    )\n   654\u2192\n   655\u2192\n   656\u2192def test_to_wkb_srid():\n   657\u2192    # hex representation of POINT (0 0) with SRID=4\n   658\u2192    ewkb = \"01010000200400000000000000000000000000000000000000\"\n   659\u2192    wkb = \"010100000000000000000000000000000000000000\"\n   660\u2192\n   661\u2192    actual = shapely.from_wkb(ewkb)\n   662\u2192    assert shapely.to_wkt(actual, trim=True) == \"POINT (0 0)\"\n   663\u2192\n   664\u2192    assert shapely.to_wkb(actual, hex=True, byte_order=1) == wkb\n   665\u2192    assert shapely.to_wkb(actual, hex=True, include_srid=True, byte_order=1) == ewkb\n   666\u2192\n   667\u2192    point = shapely.points(1, 1)\n   668\u2192    point_with_srid = shapely.set_srid(point, np.int32(4326))\n   669\u2192    result = shapely.to_wkb(point_with_srid, include_srid=True, byte_order=1)\n   670\u2192    assert np.frombuffer(result[5:9], \"<u4\").item() == 4326\n   671\u2192\n   672\u2192\n   673\u2192@pytest.mark.skipif(shapely.geos_version < (3, 10, 0), reason=\"GEOS < 3.10.0\")\n   674\u2192def test_to_wkb_flavor():\n   675\u2192    # http://libgeos.org/specifications/wkb/#extended-wkb\n   676\u2192    actual = shapely.to_wkb(point_z, byte_order=1)  # default \"extended\"\n   677\u2192    assert actual.hex()[2:10] == struct.pack(\"<I\", 1 | EWKBZ).hex()\n   678\u2192    actual = shapely.to_wkb(point_z, byte_order=1, flavor=\"extended\")\n   679\u2192    assert actual.hex()[2:10] == struct.pack(\"<I\", 1 | EWKBZ).hex()\n   680\u2192    actual = shapely.to_wkb(point_z, byte_order=1, flavor=\"iso\")\n   681\u2192    assert actual.hex()[2:10] == struct.pack(\"<I\", 1 | ISOWKBZ).hex()\n   682\u2192\n   683\u2192\n   684\u2192@pytest.mark.skipif(\n   685\u2192    shapely.geos_version < (3, 12, 0),\n   686\u2192    reason=\"M coordinates not supported with GEOS < 3.12\",\n   687\u2192)\n   688\u2192def test_to_wkb_m_flavor():\n   689\u2192    # XYM\n   690\u2192    actual = shapely.to_wkb(point_m, byte_order=1)  # default \"extended\"\n   691\u2192    assert actual.hex()[2:10] == struct.pack(\"<I\", 1 | EWKBM).hex()\n   692\u2192    actual = shapely.to_wkb(point_m, byte_order=1, flavor=\"iso\")\n   693\u2192    assert actual.hex()[2:10] == struct.pack(\"<I\", 1 | ISOWKBM).hex()\n   694\u2192\n   695\u2192    # XYZM\n   696\u2192    actual = shapely.to_wkb(point_zm, byte_order=1)  # default \"extended\"\n   697\u2192    assert actual.hex()[2:10] == struct.pack(\"<I\", 1 | EWKBZM).hex()\n   698\u2192    actual = shapely.to_wkb(point_zm, byte_order=1, flavor=\"iso\")\n   699\u2192    assert actual.hex()[2:10] == struct.pack(\"<I\", 1 | ISOWKBZM).hex()\n   700\u2192\n   701\u2192\n   702\u2192@pytest.mark.skipif(shapely.geos_version < (3, 10, 0), reason=\"GEOS < 3.10.0\")\n   703\u2192def test_to_wkb_flavor_srid():\n   704\u2192    with pytest.raises(ValueError, match=\"cannot be used together\"):\n   705\u2192        shapely.to_wkb(point_z, include_srid=True, flavor=\"iso\")\n   706\u2192\n   707\u2192\n   708\u2192@pytest.mark.skipif(shapely.geos_version >= (3, 10, 0), reason=\"GEOS < 3.10.0\")\n   709\u2192def test_to_wkb_flavor_unsupported_geos():\n   710\u2192    with pytest.raises(UnsupportedGEOSVersionError):\n   711\u2192        shapely.to_wkb(point_z, flavor=\"iso\")\n   712\u2192\n   713\u2192\n   714\u2192@pytest.mark.parametrize(\n   715\u2192    \"geom,expected\",\n   716\u2192    [\n   717\u2192        pytest.param(empty_point, POINT_NAN_WKB, id=\"POINT EMPTY\"),\n   718\u2192        pytest.param(empty_point_z, POINT_NAN_WKB, id=\"POINT Z EMPTY\"),\n   719\u2192        pytest.param(empty_point_m, POINT_NAN_WKB, id=\"POINT M EMPTY\"),\n   720\u2192        pytest.param(empty_point_zm, POINT_NAN_WKB, id=\"POINT ZM EMPTY\"),\n   721\u2192        pytest.param(\n   722\u2192            multi_point_empty,\n   723\u2192            MULTIPOINT_NAN_WKB,\n   724\u2192            id=\"MULTIPOINT EMPTY\",\n   725\u2192        ),\n   726\u2192        pytest.param(\n   727\u2192            multi_point_empty_z,\n   728\u2192            MULTIPOINT_NAN_WKB,\n   729\u2192            id=\"MULTIPOINT Z EMPTY\",\n   730\u2192        ),\n   731\u2192        pytest.param(\n   732\u2192            multi_point_empty_m,\n   733\u2192            MULTIPOINT_NAN_WKB,\n   734\u2192            id=\"MULTIPOINT M EMPTY\",\n   735\u2192        ),\n   736\u2192        pytest.param(\n   737\u2192            multi_point_empty_zm,\n   738\u2192            MULTIPOINT_NAN_WKB,\n   739\u2192            id=\"MULTIPOINT ZM EMPTY\",\n   740\u2192        ),\n   741\u2192        pytest.param(\n   742\u2192            shapely.geometrycollections([empty_point]),\n   743\u2192            GEOMETRYCOLLECTION_NAN_WKB,\n   744\u2192            id=\"GEOMETRYCOLLECTION (POINT EMPTY)\",\n   745\u2192        ),\n   746\u2192        pytest.param(\n   747\u2192            shapely.geometrycollections([empty_point_z]),\n   748\u2192            GEOMETRYCOLLECTION_NAN_WKB,\n   749\u2192            id=\"GEOMETRYCOLLECTION (POINT Z EMPTY)\",\n   750\u2192        ),\n   751\u2192        pytest.param(\n   752\u2192            shapely.geometrycollections([empty_point_m]),\n   753\u2192            GEOMETRYCOLLECTION_NAN_WKB,\n   754\u2192            id=\"GEOMETRYCOLLECTION (POINT M EMPTY)\",\n   755\u2192        ),\n   756\u2192        pytest.param(\n   757\u2192            shapely.geometrycollections([empty_point_zm]),\n   758\u2192            GEOMETRYCOLLECTION_NAN_WKB,\n   759\u2192            id=\"GEOMETRYCOLLECTION (POINT ZM EMPTY)\",\n   760\u2192        ),\n   761\u2192        pytest.param(\n   762\u2192            shapely.geometrycollections([multi_point_empty]),\n   763\u2192            NESTED_COLLECTION_NAN_WKB,\n   764\u2192            id=\"GEOMETRYCOLLECTION (MULTIPOINT EMPTY)\",\n   765\u2192        ),\n   766\u2192        pytest.param(\n   767\u2192            shapely.geometrycollections([multi_point_empty_z]),\n   768\u2192            NESTED_COLLECTION_NAN_WKB,\n   769\u2192            id=\"GEOMETRYCOLLECTION (MULTIPOINT Z EMPTY)\",\n   770\u2192        ),\n   771\u2192        pytest.param(\n   772\u2192            shapely.geometrycollections([multi_point_empty_m]),\n   773\u2192            NESTED_COLLECTION_NAN_WKB,\n   774\u2192            id=\"GEOMETRYCOLLECTION (MULTIPOINT M EMPTY)\",\n   775\u2192        ),\n   776\u2192        pytest.param(\n   777\u2192            shapely.geometrycollections([multi_point_empty_zm]),\n   778\u2192            NESTED_COLLECTION_NAN_WKB,\n   779\u2192            id=\"GEOMETRYCOLLECTION (MULTIPOINT ZM EMPTY)\",\n   780\u2192        ),\n   781\u2192    ],\n   782\u2192)\n   783\u2192def test_to_wkb_point_empty_2d(geom, expected):\n   784\u2192    actual = shapely.to_wkb(geom, output_dimension=2, byte_order=1)\n   785\u2192    # Split 'actual' into header and coordinates\n   786\u2192    coordinate_length = 16\n   787\u2192    header_length = len(expected) - coordinate_length\n   788\u2192    # Check the total length (this checks the correct dimensionality)\n   789\u2192    assert len(actual) == header_length + coordinate_length\n   790\u2192    # Check the header\n   791\u2192    assert actual[:header_length] == expected[:header_length]\n   792\u2192    # Check the coordinates (using numpy.isnan; there are many byte representations for\n   793\u2192    # NaN)\n   794\u2192    assert np.isnan(struct.unpack(\"<2d\", actual[header_length:])).all()\n   795\u2192\n   796\u2192\n   797\u2192@pytest.mark.parametrize(\n   798\u2192    \"geom,expected\",\n   799\u2192    [\n   800\u2192        pytest.param(empty_point_z, POINTZ_NAN_WKB, id=\"POINT Z EMPTY\"),\n   801\u2192        pytest.param(empty_point_zm, POINTZ_NAN_WKB, id=\"POINT ZM EMPTY\"),\n   802\u2192        pytest.param(\n   803\u2192            multi_point_empty_z,\n   804\u2192            MULTIPOINTZ_NAN_WKB,\n   805\u2192            id=\"MULTIPOINT Z EMPTY\",\n   806\u2192        ),\n   807\u2192        pytest.param(\n   808\u2192            multi_point_empty_zm,\n   809\u2192            MULTIPOINTZ_NAN_WKB,\n   810\u2192            id=\"MULTIPOINT ZM EMPTY\",\n   811\u2192        ),\n   812\u2192        pytest.param(\n   813\u2192            shapely.geometrycollections([empty_point_z]),\n   814\u2192            GEOMETRYCOLLECTIONZ_NAN_WKB,\n   815\u2192            id=\"GEOMETRYCOLLECTION (POINT Z EMPTY)\",\n   816\u2192        ),\n   817\u2192        pytest.param(\n   818\u2192            shapely.geometrycollections([empty_point_zm]),\n   819\u2192            GEOMETRYCOLLECTIONZ_NAN_WKB,\n   820\u2192            id=\"GEOMETRYCOLLECTION (POINT ZM EMPTY)\",\n   821\u2192        ),\n   822\u2192        pytest.param(\n   823\u2192            shapely.geometrycollections([multi_point_empty_z]),\n   824\u2192            NESTED_COLLECTIONZ_NAN_WKB,\n   825\u2192            id=\"GEOMETRYCOLLECTION (MULTIPOINT Z EMPTY)\",\n   826\u2192        ),\n   827\u2192        pytest.param(\n   828\u2192            shapely.geometrycollections([multi_point_empty_zm]),\n   829\u2192            NESTED_COLLECTIONZ_NAN_WKB,\n   830\u2192            id=\"GEOMETRYCOLLECTION (MULTIPOINT ZM EMPTY)\",\n   831\u2192        ),\n   832\u2192    ],\n   833\u2192)\n   834\u2192def test_to_wkb_point_empty_z(geom, expected):\n   835\u2192    actual = shapely.to_wkb(geom, output_dimension=3, byte_order=1)\n   836\u2192    # Split 'actual' into header and coordinates\n   837\u2192    coordinate_length = 8 * 3\n   838\u2192    header_length = len(expected) - coordinate_length\n   839\u2192    # Check the total length (this checks the correct dimensionality)\n   840\u2192    assert len(actual) == header_length + coordinate_length\n   841\u2192    # Check the header\n   842\u2192    assert actual[:header_length] == expected[:header_length]\n   843\u2192    # Check the coordinates (using numpy.isnan; there are many byte representations for\n   844\u2192    # NaN)\n   845\u2192    assert np.isnan(struct.unpack(\"<3d\", actual[header_length:])).all()\n   846\u2192\n   847\u2192\n   848\u2192@pytest.mark.skipif(\n   849\u2192    shapely.geos_version < (3, 12, 0),\n   850\u2192    reason=\"M coordinates not supported with GEOS < 3.12\",\n   851\u2192)\n   852\u2192@pytest.mark.parametrize(\n   853\u2192    \"geom,expected\",\n   854\u2192    [\n   855\u2192        pytest.param(empty_point_m, POINTM_NAN_WKB, id=\"POINT M EMPTY\"),\n   856\u2192        pytest.param(\n   857\u2192            multi_point_empty_m,\n   858\u2192            MULTIPOINTM_NAN_WKB,\n   859\u2192            id=\"MULTIPOINT M EMPTY\",\n   860\u2192        ),\n   861\u2192        pytest.param(\n   862\u2192            shapely.geometrycollections([empty_point_m]),\n   863\u2192            GEOMETRYCOLLECTIONM_NAN_WKB,\n   864\u2192            id=\"GEOMETRYCOLLECTION (POINT M EMPTY)\",\n   865\u2192        ),\n   866\u2192        pytest.param(\n   867\u2192            shapely.geometrycollections([multi_point_empty_m]),\n   868\u2192            NESTED_COLLECTIONM_NAN_WKB,\n   869\u2192            id=\"GEOMETRYCOLLECTION (MULTIPOINT M EMPTY)\",\n   870\u2192        ),\n   871\u2192    ],\n   872\u2192)\n   873\u2192def test_to_wkb_point_empty_m(geom, expected):\n   874\u2192    actual = shapely.to_wkb(geom, output_dimension=3, byte_order=1)\n   875\u2192    # Split 'actual' into header and coordinates\n   876\u2192    coordinate_length = 8 * 3\n   877\u2192    header_length = len(expected) - coordinate_length\n   878\u2192    assert len(actual) == header_length + coordinate_length\n   879\u2192    assert actual[:header_length] == expected[:header_length]\n   880\u2192    assert np.isnan(struct.unpack(\"<3d\", actual[header_length:])).all()\n   881\u2192\n   882\u2192\n   883\u2192@pytest.mark.skipif(\n   884\u2192    shapely.geos_version < (3, 12, 0),\n   885\u2192    reason=\"M coordinates not supported with GEOS < 3.12\",\n   886\u2192)\n   887\u2192@pytest.mark.parametrize(\n   888\u2192    \"geom,expected\",\n   889\u2192    [\n   890\u2192        pytest.param(empty_point_zm, POINTZM_NAN_WKB, id=\"POINT ZM EMPTY\"),\n   891\u2192        pytest.param(\n   892\u2192            multi_point_empty_zm,\n   893\u2192            MULTIPOINTZM_NAN_WKB,\n   894\u2192            id=\"MULTIPOINT ZM EMPTY\",\n   895\u2192        ),\n   896\u2192        pytest.param(\n   897\u2192            shapely.geometrycollections([empty_point_zm]),\n   898\u2192            GEOMETRYCOLLECTIONZM_NAN_WKB,\n   899\u2192            id=\"GEOMETRYCOLLECTION (POINT ZM EMPTY)\",\n   900\u2192        ),\n   901\u2192        pytest.param(\n   902\u2192            shapely.geometrycollections([multi_point_empty_zm]),\n   903\u2192            NESTED_COLLECTIONZM_NAN_WKB,\n   904\u2192            id=\"GEOMETRYCOLLECTION (MULTIPOINT ZM EMPTY)\",\n   905\u2192        ),\n   906\u2192    ],\n   907\u2192)\n   908\u2192def test_to_wkb_point_empty_zm(geom, expected):\n   909\u2192    actual = shapely.to_wkb(geom, output_dimension=4, byte_order=1)\n   910\u2192    # Split 'actual' into header and coordinates\n   911\u2192    coordinate_length = 8 * 4\n   912\u2192    header_length = len(expected) - coordinate_length\n   913\u2192    assert len(actual) == header_length + coordinate_length\n   914\u2192    assert actual[:header_length] == expected[:header_length]\n   915\u2192    assert np.isnan(struct.unpack(\"<4d\", actual[header_length:])).all()\n   916\u2192\n   917\u2192\n   918\u2192@pytest.mark.parametrize(\n   919\u2192    \"geom,expected\",\n   920\u2192    [\n   921\u2192        pytest.param(empty_point, POINT_NAN_WKB, id=\"POINT EMPTY\"),\n   922\u2192        pytest.param(multi_point_empty, MULTIPOINT_NAN_WKB, id=\"MULTIPOINT EMPTY\"),\n   923\u2192        pytest.param(\n   924\u2192            shapely.geometrycollections([empty_point]),\n   925\u2192            GEOMETRYCOLLECTION_NAN_WKB,\n   926\u2192            id=\"GEOMETRYCOLLECTION (POINT EMPTY)\",\n   927\u2192        ),\n   928\u2192        pytest.param(\n   929\u2192            shapely.geometrycollections([multi_point_empty]),\n   930\u2192            NESTED_COLLECTION_NAN_WKB,\n   931\u2192            id=\"GEOMETRYCOLLECTION (MULTIPOINT EMPTY)\",\n   932\u2192        ),\n   933\u2192    ],\n   934\u2192)\n   935\u2192def test_to_wkb_point_empty_2d_output_dim_3(geom, expected):\n   936\u2192    actual = shapely.to_wkb(geom, output_dimension=3, byte_order=1)\n   937\u2192    # Split 'actual' into header and coordinates\n   938\u2192    coordinate_length = 16\n   939\u2192    header_length = len(expected) - coordinate_length\n   940\u2192    # Check the total length (this checks the correct dimensionality)\n   941\u2192    assert len(actual) == header_length + coordinate_length\n   942\u2192    # Check the header\n   943\u2192    assert actual[:header_length] == expected[:header_length]\n   944\u2192    # Check the coordinates (using numpy.isnan; there are many byte representations for\n   945\u2192    # NaN)\n   946\u2192    assert np.isnan(struct.unpack(\"<2d\", actual[header_length:])).all()\n   947\u2192\n   948\u2192\n   949\u2192@pytest.mark.parametrize(\n   950\u2192    \"wkb,expected_type,expected_dim\",\n   951\u2192    [\n   952\u2192        pytest.param(POINT_NAN_WKB, 0, 2, id=\"POINT_NAN_WKB\"),\n   953\u2192        pytest.param(POINTZ_NAN_WKB, 0, 3, id=\"POINTZ_NAN_WKB\"),\n   954\u2192        pytest.param(MULTIPOINT_NAN_WKB, 4, 2, id=\"MULTIPOINT_NAN_WKB\"),\n   955\u2192        pytest.param(MULTIPOINTZ_NAN_WKB, 4, 3, id=\"MULTIPOINTZ_NAN_WKB\"),\n   956\u2192        pytest.param(GEOMETRYCOLLECTION_NAN_WKB, 7, 2, id=\"GEOMETRYCOLLECTION_NAN_WKB\"),\n   957\u2192        pytest.param(\n   958\u2192            GEOMETRYCOLLECTIONZ_NAN_WKB, 7, 3, id=\"GEOMETRYCOLLECTIONZ_NAN_WKB\"\n   959\u2192        ),\n   960\u2192        pytest.param(NESTED_COLLECTION_NAN_WKB, 7, 2, id=\"NESTED_COLLECTION_NAN_WKB\"),\n   961\u2192        pytest.param(NESTED_COLLECTIONZ_NAN_WKB, 7, 3, id=\"NESTED_COLLECTIONZ_NAN_WKB\"),\n   962\u2192    ],\n   963\u2192)\n   964\u2192def test_from_wkb_point_empty(wkb, expected_type, expected_dim):\n   965\u2192    geom = shapely.from_wkb(wkb)\n   966\u2192    # POINT (nan nan) transforms to an empty point\n   967\u2192    assert shapely.is_empty(geom)\n   968\u2192    assert shapely.get_type_id(geom) == expected_type\n   969\u2192    assert shapely.get_coordinate_dimension(geom) == expected_dim\n   970\u2192\n   971\u2192\n   972\u2192@pytest.mark.skipif(\n   973\u2192    shapely.geos_version < (3, 12, 0),\n   974\u2192    reason=\"M coordinates not supported with GEOS < 3.12\",\n   975\u2192)\n   976\u2192@pytest.mark.parametrize(\n   977\u2192    \"wkb,expected_type\",\n   978\u2192    [\n   979\u2192        pytest.param(POINTM_NAN_WKB, 0, id=\"POINTM_NAN_WKB\"),\n   980\u2192        pytest.param(MULTIPOINTM_NAN_WKB, 4, id=\"MULTIPOINTM_NAN_WKB\"),\n   981\u2192        pytest.param(GEOMETRYCOLLECTIONM_NAN_WKB, 7, id=\"GEOMETRYCOLLECTIONM_NAN_WKB\"),\n   982\u2192        pytest.param(NESTED_COLLECTIONM_NAN_WKB, 7, id=\"NESTED_COLLECTIONM_NAN_WKB\"),\n   983\u2192    ],\n   984\u2192)\n   985\u2192def test_from_wkb_point_empty_m(wkb, expected_type):\n   986\u2192    geom = shapely.from_wkb(wkb)\n   987\u2192\n   988\u2192    assert shapely.is_empty(geom)\n   989\u2192    assert shapely.get_type_id(geom) == expected_type\n   990\u2192    assert shapely.get_coordinate_dimension(geom) == 3\n   991\u2192    assert not shapely.has_z(geom)\n   992\u2192    assert shapely.has_m(geom)\n   993\u2192\n   994\u2192\n   995\u2192@pytest.mark.skipif(\n   996\u2192    shapely.geos_version < (3, 12, 0),\n   997\u2192    reason=\"M coordinates not supported with GEOS < 3.12\",\n   998\u2192)\n   999\u2192@pytest.mark.parametrize(\n  1000\u2192    \"wkb,expected_type\",\n  1001\u2192    [\n  1002\u2192        pytest.param(POINTZM_NAN_WKB, 0, id=\"POINTZM_NAN_WKB\"),\n  1003\u2192        pytest.param(MULTIPOINTZM_NAN_WKB, 4, id=\"MULTIPOINTZM_NAN_WKB\"),\n  1004\u2192        pytest.param(\n  1005\u2192            GEOMETRYCOLLECTIONZM_NAN_WKB, 7, id=\"GEOMETRYCOLLECTIONZM_NAN_WKB\"\n  1006\u2192        ),\n  1007\u2192        pytest.param(NESTED_COLLECTIONZM_NAN_WKB, 7, id=\"NESTED_COLLECTIONZM_NAN_WKB\"),\n  1008\u2192    ],\n  1009\u2192)\n  1010\u2192def test_from_wkb_point_empty_zm(wkb, expected_type):\n  1011\u2192    geom = shapely.from_wkb(wkb)\n  1012\u2192\n  1013\u2192    assert shapely.is_empty(geom)\n  1014\u2192    assert shapely.get_type_id(geom) == expected_type\n  1015\u2192    assert shapely.get_coordinate_dimension(geom) == 4\n  1016\u2192    assert shapely.has_z(geom)\n  1017\u2192    assert shapely.has_m(geom)\n  1018\u2192\n  1019\u2192\n  1020\u2192def test_to_wkb_point_empty_srid():\n  1021\u2192    expected = shapely.set_srid(empty_point, 4236)\n  1022\u2192    wkb = shapely.to_wkb(expected, include_srid=True)\n  1023\u2192    actual = shapely.from_wkb(wkb)\n  1024\u2192    assert shapely.get_srid(actual) == 4236\n  1025\u2192\n  1026\u2192\n  1027\u2192@pytest.mark.parametrize(\"geom\", all_types + (point_z, empty_point))\n  1028\u2192def test_pickle(geom):\n  1029\u2192    pickled = pickle.dumps(geom)\n  1030\u2192    assert_geometries_equal(pickle.loads(pickled), geom, tolerance=0)\n  1031\u2192\n  1032\u2192\n  1033\u2192@pytest.mark.parametrize(\"geom\", all_types_z)\n  1034\u2192def test_pickle_z(geom):\n  1035\u2192    if shapely.get_type_id(geom) == shapely.GeometryType.LINEARRING:\n  1036\u2192        # https://github.com/shapely/shapely/pull/1808#discussion_r1182174077\n  1037\u2192        pytest.xfail(\"TODO: Z gets dropped for LinearRing\")\n  1038\u2192    pickled = pickle.dumps(geom)\n  1039\u2192    actual = pickle.loads(pickled)\n  1040\u2192    assert_geometries_equal(actual, geom, tolerance=0)\n  1041\u2192    if not actual.is_empty:  # GEOSHasZ with EMPTY geometries is inconsistent\n  1042\u2192        assert actual.has_z\n  1043\u2192    if shapely.geos_version >= (3, 12, 0):\n  1044\u2192        assert not actual.has_m\n  1045\u2192\n  1046\u2192\n  1047\u2192@pytest.mark.skipif(\n  1048\u2192    shapely.geos_version < (3, 12, 0),\n  1049\u2192    reason=\"M coordinates not supported with GEOS < 3.12\",\n  1050\u2192)\n  1051\u2192@pytest.mark.parametrize(\"geom\", all_types_m)\n  1052\u2192def test_pickle_m(geom):\n  1053\u2192    if shapely.get_type_id(geom) == shapely.GeometryType.LINEARRING:\n  1054\u2192        pytest.xfail(\"TODO: M gets dropped for LinearRing types; see GH-2005\")\n  1055\u2192    pickled = pickle.dumps(geom)\n  1056\u2192    actual = pickle.loads(pickled)\n  1057\u2192    assert_geometries_equal(actual, geom, tolerance=0)\n  1058\u2192    assert not actual.has_z\n  1059\u2192    if not actual.is_empty:  # GEOSHasM with EMPTY geometries is inconsistent\n  1060\u2192        assert actual.has_m\n  1061\u2192\n  1062\u2192\n  1063\u2192@pytest.mark.skipif(\n  1064\u2192    shapely.geos_version < (3, 12, 0),\n  1065\u2192    reason=\"M coordinates not supported with GEOS < 3.12\",\n  1066\u2192)\n  1067\u2192@pytest.mark.parametrize(\"geom\", all_types_zm)\n  1068\u2192def test_pickle_zm(geom)