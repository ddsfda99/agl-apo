  ([point, None, empty], [point, None, empty]),\n   235→    ],\n   236→)\n   237→def test_make_valid_1d(geom, expected):\n   238→    actual = shapely.make_valid(geom)\n   239→    # normalize needed to handle variation in output across GEOS versions\n   240→    assert np.all(shapely.normalize(actual) == shapely.normalize(expected))\n   241→\n   242→\n   243→@pytest.mark.skipif(shapely.geos_version < (3, 10, 0), reason=\"GEOS < 3.10\")\n   244→@pytest.mark.parametrize(\n   245→    \"geom,expected\",\n   246→    [\n   247→        (point, point),  # a valid geometry stays the same (but is copied)\n   248→        # an L shaped polygon without area is converted to a linestring\n   249→        (\n   250→            Polygon([(0, 0), (1, 1), (1, 2), (1, 1), (0, 0)]),\n   251→            LineString([(0, 0), (1, 1), (1, 2), (1, 1), (0, 0)]),\n   252→        ),\n   253→        # a polygon with self-intersection (bowtie) is converted into polygons\n   254→        (\n   255→            Polygon([(0, 0), (2, 2), (2, 0), (0, 2), (0, 0)]),\n   256→            MultiPolygon(\n   257→                [\n   258→                    Polygon([(1, 1), (2, 2), (2, 0), (1, 1)]),\n   259→                    Polygon([(0, 0), (0, 2), (1, 1), (0, 0)]),\n   260→                ]\n   261→            ),\n   262→        ),\n   263→        (empty, empty),\n   264→        ([empty], [empty]),\n   265→    ],\n   266→)\n   267→def test_make_valid_structure(geom, expected):\n   268→    actual = shapely.make_valid(geom, method=\"structure\")\n   269→    assert actual is not expected\n   270→    # normalize needed to handle variation in output across GEOS versions\n   271→    assert shapely.normalize(actual) == expected\n   272→\n   273→\n   274→@pytest.mark.skipif(shapely.geos_version < (3, 10, 0), reason=\"GEOS < 3.10\")\n   275→@pytest.mark.parametrize(\n   276→    \"geom,expected\",\n   277→    [\n   278→        (point, point),  # a valid geometry stays the same (but is copied)\n   279→        # an L shaped polygon without area is converted to Empty Polygon\n   280→        (\n   281→            Polygon([(0, 0), (1, 1), (1, 2), (1, 1), (0, 0)]),\n   282→            Polygon(),\n   283→        ),\n   284→        # a polygon with self-intersection (bowtie) is converted into polygons\n   285→        (\n   286→            Polygon([(0, 0), (2, 2), (2, 0), (0, 2), (0, 0)]),\n   287→            MultiPolygon(\n   288→                [\n   289→                    Polygon([(1, 1), (2, 2), (2, 0), (1, 1)]),\n   290→                    Polygon([(0, 0), (0, 2), (1, 1), (0, 0)]),\n   291→                ]\n   292→            ),\n   293→        ),\n   294→        (empty, empty),\n   295→        ([empty], [empty]),\n   296→    ],\n   297→)\n   298→def test_make_valid_structure_keep_collapsed_false(geom, expected):\n   299→    actual = shapely.make_valid(geom, method=\"structure\", keep_collapsed=False)\n   300→    assert actual is not expected\n   301→    # normalize needed to handle variation in output across GEOS versions\n   302→    assert shapely.normalize(actual) == expected\n   303→\n   304→\n   305→@pytest.mark.skipif(shapely.geos_version >= (3, 10, 0), reason=\"GEOS >= 3.10\")\n   306→def test_make_valid_structure_unsupported_geos():\n   307→    with pytest.raises(\n   308→        ValueError, match=\"The 'structure' method is only available in GEOS >= 3.10.0\"\n   309→    ):\n   310→        _ = shapely.make_valid(Point(), method=\"structure\")\n   311→\n   312→\n   313→@pytest.mark.skipif(shapely.geos_version < (3, 10, 0), reason=\"GEOS < 3.10\")\n   314→@pytest.mark.parametrize(\n   315→    \"method, keep_collapsed, error_type, error\",\n   316→    [\n   317→        (\n   318→            np.array([\"linework\", \"structure\"]),\n   319→            True,\n   320→            TypeError,\n   321→            \"method only accepts scalar values\",\n   322→        ),\n   323→        (\n   324→            \"linework\",\n   325→            [True, False],\n   326→            TypeError,