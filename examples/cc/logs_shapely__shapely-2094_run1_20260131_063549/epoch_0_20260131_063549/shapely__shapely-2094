ult, np.ndarray)\n   705→    assert result.shape == (2,)\n   706→    assert result[0] == expected\n   707→    assert result[1] == expected\n   708→\n   709→    arr = np.array([[lines, lines], [lines, lines], [lines, lines]])\n   710→    assert arr.shape == (3, 2, 3)\n   711→    result = shapely.polygonize(arr)\n   712→    assert isinstance(result, np.ndarray)\n   713→    assert result.shape == (3, 2)\n   714→    for res in result.flatten():\n   715→        assert res == expected\n   716→\n   717→\n   718→def test_polygonize_array_axis():\n   719→    lines = [\n   720→        LineString([(0, 0), (1, 1)]),\n   721→        LineString([(0, 0), (0, 1)]),\n   722→        LineString([(0, 1), (1, 1)]),\n   723→    ]\n   724→    arr = np.array([lines, lines])  # shape (2, 3)\n   725→    result = shapely.polygonize(arr, axis=1)\n   726→    assert result.shape == (2,)\n   727→    result = shapely.polygonize(arr, axis=0)\n   728→    assert result.shape == (3,)\n   729→\n   730→\n   731→def test_polygonize_missing():\n   732→    # set of geometries that is all missing\n   733→    result = shapely.polygonize([None, None])\n   734→    assert result == GeometryCollection()\n   735→\n   736→\n   737→def test_polygonize_full():\n   738→    lines = [\n   739→        None,\n   740→        LineString([(0, 0), (1, 1)]),\n   741→        LineString([(0, 0), (0, 1)]),\n   742→        LineString([(0, 1), (1, 1)]),\n   743→        LineString([(1, 1), (1, 0)]),\n   744→        None,\n   745        LineString([(1, 0), (0, 0)]),\n   746→        LineString([(5, 5), (6, 6)]),\n   747→        LineString([(1, 1), (100, 100)]),\n   748→        Point(0, 0),\n   749→        None,\n   750→    ]\n   751→    result = shapely.polygonize_full(lines)\n   752→    assert len(result) == 4\n   753→    assert all(shapely.get_type_id(geom) == 7 for geom in result)  # GeometryCollection\n   754→    polygons, cuts, dangles, invalid = result\n   755→    expected_polygons = GeometryCollection(\n   756→        [\n   75