diff --git a/src/cfnlint/rules/parameters/Used.py b/src/cfnlint/rules/parameters/Used.py
index b0f6a0033..6af8390fc 100644
--- a/src/cfnlint/rules/parameters/Used.py
+++ b/src/cfnlint/rules/parameters/Used.py
@@ -22,6 +22,22 @@ class Used(CloudFormationLintRule):
     def match(self, cfn: Template) -> RuleMatches:
         matches: RuleMatches = []
 
+        # If the template includes external content via AWS::Include, we can't reliably
+        # determine parameter usage. Avoid false positives by disabling this check.
+        transform_trees = cfn.search_deep_keys("Fn::Transform")
+        for t in transform_trees:
+            value = t[-1]
+            if isinstance(value, dict):
+                name = value.get("Name")
+                if isinstance(name, str) and name == "AWS::Include":
+                    self.logger.debug(
+                        (
+                            "Template uses Fn::Transform with AWS::Include. Disabling check %r"
+                        ),
+                        self.id,
+                    )
+                    return matches
+
         le_refs = None
         if cfn.has_language_extensions_transform():
             le_refs = cfn.search_deep_keys("Ref")
