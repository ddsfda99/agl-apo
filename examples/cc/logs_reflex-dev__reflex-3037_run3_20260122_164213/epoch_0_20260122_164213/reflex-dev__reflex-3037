\n    57\u2192\n    58\u2192    # The children nested within the component.\n    59\u2192    children: List[BaseComponent] = []\n    60\u2192\n    61\u2192    # The library that the component is based on.\n    62\u2192    library: Optional[str] = None\n    63\u2192\n    64\u2192    # List here the non-react dependency needed by `library`\n    65\u2192    lib_dependencies: List[str] = []\n    66\u2192\n    67\u2192    # The tag to use when rendering the component.\n    68\u2192    tag: Optional[str] = None\n    69\u2192\n    70\u2192    @abstractmethod\n    71\u2192    def render(self) -> dict:\n    72\u2192        \"\"\"Render the component.\n    73\u2192\n    74\u2192        Returns:\n    75\u2192            The dictionary for template of the component.\n    76\u2192        \"\"\"\n    77\u2192\n    78\u2192    @abstractmethod\n    79\u2192    def _get_all_hooks_internal(self) -> dict[str, None]:\n    80\u2192        \"\"\"Get the reflex internal hooks for the component and its children.\n    81\u2192\n    82\u2192        Returns:\n    83\u2192            The code that should appear just before user-defined hooks.\n    84\u2192        \"\"\"\n    85\u2192\n    86\u2192    @abstractmethod\n    87\u2192    def _get_all_hooks(self) -> dict[str, None]:\n    88\u2192        \"\"\"Get the React hooks for this component.\n    89\u2192\n    90\u2192        Returns:\n    91\u2192            The code that should appear just before returning the rendered component.\n    92\u2192        \"\"\"\n    93\u2192\n    94\u2192    @abstractmethod\n    95\u2192    def _get_all_imports(self) -> imports.ImportDict:\n    96\u2192        \"\"\"Get all the libraries and fields that are used by the component.\n    97\u2192\n    98\u2192        Returns:\n    99\u2192            The import dict with the required imports.\n   100\u2192        \"\"\"\n   101\u2192\n   102\u2192    @abstractmethod\n   103\u2192    def _get_all_dynamic_imports(self) -> set[str]:\n   104\u2192        \"\"\"Get dynamic imports for the component.\n   105\u2192\n   106\u2192        Returns:\n   107\u2192            The dynamic imports.\n   108\u2192        \"\"\"\n   109\u2192\n   110\u2192    @abstractmethod\n   111\u2192    def _get_all_custom_code(self) -> set[str]:\n   112\u2192        \"\"\"Get custom code for the component.\n   113\u2192\n   114\u2192        Returns:\n   115\u2192            The custom code.\n   116\u2192        \"\"\"\n   117\u2192\n   118\u2192    @abstractmethod\n   119\u2192    def _get_all_refs(self) -> set[str]:\n   120\u2192        \"\"\"Get the refs for the children of the component.\n   121\u2192\n   122\u2192        Returns:\n   123\u2192            The refs for the children.\n   124\u2192        \"\"\"\n   125\u2192\n   126\u2192\n   127\u2192class ComponentNamespace(SimpleNamespace):\n   128\u2192    \"\"\"A namespace to manage components with subcomponents.\"\"\"\n   129\u2192\n   130\u2192    def __hash__(self) -> int:\n   131\u2192        \"\"\"Get the hash of the namespace.\n   132\u2192\n   133\u2192\n   134\u2192        Returns:\n   135\u2192            The hash of the namespace.\n   136\u2192        \"\"\"\n   137\u2192        return hash(self.__class__.__name__)\n   138\u2192\n   139\u2192\n   140\u2192def evaluate_style_namespaces(style: ComponentStyle) -> dict:\n   141\u2192    \"\"\"Evaluate namespaces in the style.\n   142\u2192\n   143\u2192    Args:\n   144\u2192        style: The style to evaluate.\n   145\u2192\n   146\u2192    Returns:\n   147\u2192        The evaluated style.\n   148\u2192    \"\"\"\n   149\u2192    return {\n   150\u2192        k.__call__ if isinstance(k, ComponentNamespace) else k: v\n   151\u2192        for k, v in style.items()\n   152\u2192    }\n   153\u2192\n   154\u2192\n   155\u2192# Map from component to styling.\n   156\u2192ComponentStyle = Dict[\n   157\u2192    Union[str, Type[BaseComponent], Callable, ComponentNamespace], Any\n   158\u2192]\n   159\u2192ComponentChild = Union[types.PrimitiveType, Var, BaseComponent]\n   160\u2192\n   161\u2192\n   162\u2192class Component(BaseComponent, ABC):\n   163\u2192    \"\"\"A component with style, event trigger and other props.\"\"\"\n   164\u2192\n   165\u2192    # The style of the component.\n   166\u2192    style: Style = Style()\n   167\u2192\n   168\u2192    # A mapping from event triggers to event chains.\n   169\u2192    event_triggers: Dict[str, Union[EventChain, Var]] = {}\n   170\u2192\n   171\u2192    # The alias for the tag.\n   172\u2192    alias: Optional[str] = None\n   173\u2192\n   174\u2192    # Whether the import is default or named.\n   175\u2192    is_default: Optional[bool] = False\n   176\u2192\n   177\u2192    # A unique key for the component.\n   178\u2192    key: Any = None\n   179\u2192\n   180\u2192    # The id for the component.\n   181\u2192    id: Any = None\n   182\u2192\n   183\u2192    # The class name for the component.\n   184\u2192    class_name: Any = None\n   185\u2192\n   186\u2192    # Special component props.\n   187\u2192    special_props: Set[Var] = set()\n   188\u2192\n   189\u2192    # Whether the component should take the focus once the page is loaded\n   190\u2192    autofocus: bool = False\n   191\u2192\n   192\u2192    # components that cannot be children\n   193\u2192    _invalid_children: List[str] = []\n   194\u2192\n   195\u2192    # only components that are allowed as children\n   196\u2192    _valid_children: List[str] = []\n   197\u2192\n   198\u2192    # only components that are allowed as parent\n   199\u2192    _valid_parents: List[str] = []\n   200\u2192\n   201\u2192    # props to change the name of\n   202\u2192    _rename_props: Dict[str, str] = {}\n   203\u2192\n   204\u2192    # custom attribute\n   205\u2192    custom_attrs: Dict[str, Union[Var, str]] = {}\n   206\u2192\n   207\u2192    # When to memoize this component and its children.\n   208\u2192    _memoization_mode: MemoizationMode = MemoizationMode()\n   209\u2192\n   210\u2192    # State class associated with this component instance\n   211\u2192    State: Optional[Type[reflex.state.State]] = None\n   212\u2192\n   213\u2192    @classmethod\n   214\u2192    def __init_subclass__(cls, **kwargs):\n   215\u2192        \"\"\"Set default properties.\n   216\u2192\n   217\u2192        Args:\n   218\u2192            **kwargs: The kwargs to pass to the superclass.\n   219\u2192        \"\"\"\n   220\u2192        super().__init_subclass__(**kwargs)\n   221\u2192\n   222\u2192        # Get all the props for the component.\n   223\u2192        props = cls.get_props()\n   224\u2192\n   225\u2192        # Convert fields to props, setting default values.\n   226\u2192        for field in cls.get_fields().values():\n   227\u2192            # If the field is not a component prop, skip it.\n   228\u2192            if field.name not in props:\n   229\u2192                continue\n   230\u2192\n   231\u2192            # Set default values for any props.\n   232\u2192            if types._issubclass(field.type_, Var):\n   233\u2192                field.required = False\n   234\u2192                field.default = Var.create(field.default)\n   235\u2192            elif types._issubclass(field.type_, EventHandler):\n   236\u2192                field.required = False\n   237\u2192\n   238\u2192        # Ensure renamed props from parent classes are applied to the subclass.\n   239\u2192        if cls._rename_props:\n   240\u2192            inherited_rename_props = {}\n   241\u2192            for parent in reversed(cls.mro()):\n   242\u2192                if issubclass(parent, Component) and parent._rename_props:\n   243\u2192                    inherited_rename_props.update(parent._rename_props)\n   244\u2192            cls._rename_props = inherited_rename_props\n   245\u2192\n   246\u2192    def __init__(self, *args, **kwargs):\n   247\u2192        \"\"\"Initialize the component.\n   248\u2192\n   249\u2192        Args:\n   250\u2192            *args: Args to initialize the component.\n   251\u2192            **kwargs: Kwargs to initialize the component.\n   252\u2192\n   253\u2192        Raises:\n   254\u2192            TypeError: If an invalid prop is passed.\n   255\u2192        \"\"\"\n   256\u2192        # Set the id and children initially.\n   257\u2192        children = kwargs.get(\"children\", [])\n   258\u2192        initial_kwargs = {\n   259\u2192            \"id\": kwargs.get(\"id\"),\n   260\u2192            \"children\": children,\n   261\u2192            **{\n   262\u2192                prop: Var.create(kwargs[prop])\n   263\u2192                for prop in self.get_initial_props()\n   264\u2192                if prop in kwargs\n   265\u2192            },\n   266\u2192        }\n   267\u2192        super().__init__(**initial_kwargs)\n   268\u2192\n   269\u2192        self._validate_component_children(children)\n   270\u2192\n   271\u2192        # Get the component fields, triggers, and props.\n   272\u2192        fields = self.get_fields()\n   273\u2192        component_specific_triggers = self.get_event_triggers()\n   274\u2192        triggers = component_specific_triggers.keys()\n   275\u2192        props = self.get_props()\n   276\u2192\n   277\u2192        # Add any events triggers.\n   278\u2192        if \"event_triggers\" not in kwargs:\n   279\u2192            kwargs[\"event_triggers\"] = {}\n   280\u2192        kwargs[\"event_triggers\"] = kwargs[\"event_triggers\"].copy()\n   281\u2192\n   282\u2192        # Iterate through the kwargs and set the props.\n   283\u2192        for key, value in kwargs.items():\n   284\u2192            if key in triggers:\n   285\u2192                # Event triggers are bound to event chains.\n   286\u2192                field_type = EventChain\n   287\u2192            elif key in props:\n   288\u2192                # Set the field type.\n   289\u2192                field_type = fields[key].type_\n   290\u2192\n   291\u2192            else:\n   292\u2192                continue\n   293\u2192\n   294\u2192            # Check whether the key is a component prop.\n   295\u2192            if types._issubclass(field_type, Var):\n   296\u2192                try:\n   297\u2192                    # Try to create a var from the value.\n   298\u2192                    kwargs[key] = Var.create(value)\n   299\u2192\n   300\u2192                    # Check that the var type is not None.\n   301\u2192                    if kwargs[key] is None:\n   302\u2192                        raise TypeError\n   303\u2192\n   304\u2192                    expected_type = fields[key].outer_type_.__args__[0]\n   305\u2192                    # validate literal fields.\n   306\u2192                    types.validate_literal(\n   307\u2192                        key, value, expected_type, type(self).__name__\n   308\u2192                    )\n   309\u2192                    # Get the passed type and the var type.\n   310\u2192                    passed_type = kwargs[key]._var_type\n   311\u2192                    expected_type = (\n   312\u2192                        type(expected_type.__args__[0])\n   313\u2192                        if types.is_literal(expected_type)\n   314\u2192                        else expected_type\n   315\u2192                    )\n   316\u2192                except TypeError:\n   317\u2192                    # If it is not a valid var, check the base types.\n   318\u2192                    passed_type = type(value)\n   319\u2192                    expected_type = fields[key].outer_type_\n   320\u2192                if not types._issubclass(passed_type, expected_type):\n   321\u2192                    value_name = value._var_name if isinstance(value, Var) else value\n   322\u2192                    raise TypeError(\n   323\u2192                        f\"Invalid var passed for prop {key}, expected type {expected_type}, got value {value_name} of type {passed_type}.\"\n   324\u2192                    )\n   325\u2192\n   326\u2192            # Check if the key is an event trigger.\n   327\u2192            if key in triggers:\n   328\u2192                # Temporarily disable full control for event triggers.\n   329\u2192                kwargs[\"event_triggers\"][key] = self._create_event_chain(\n   330\u2192                    value=value, args_spec=component_specific_triggers[key]\n   331\u2192                )\n   332\u2192\n   333\u2192        # Remove any keys that were added as events.\n   334\u2192        for key in kwargs[\"event_triggers\"]:\n   335\u2192            del kwargs[key]\n   336\u2192\n   337\u2192        # Add style props to the component.\n   338\u2192        style = kwargs.get(\"style\", {})\n   339\u2192        if isinstance(style, List):\n   340\u2192            # Merge styles, the later ones overriding keys in the earlier ones.\n   341\u2192            style = {k: v for style_dict in style for k, v in style_dict.items()}\n   342\u2192\n   343\u2192        kwargs[\"style\"] = Style(\n   344\u2192            {\n   345\u2192                **self.get_fields()[\"style\"].default,\n   346\u2192                **style,\n   347\u2192                **{attr: value for attr, value in kwargs.items() if attr not in fields},\n   348\u2192            }\n   349\u2192        )\n   350\u2192        if \"custom_attrs\" not in kwargs:\n   351\u2192            kwargs[\"custom_attrs\"] = {}\n   352\u2192\n   353\u2192        # Convert class_name to str if it's list\n   354\u2192        class_name = kwargs.get(\"class_name\", \"\")\n   355\u2192        if isinstance(class_name, (List, tuple)):\n   356\u2192            kwargs[\"class_name\"] = \" \".join(class_name)\n   357\u2192\n   358\u2192        # Construct the component.\n   359\u2192        super().__init__(*args, **kwargs)\n   360\u2192\n   361\u2192    def _create_event_chain(\n   362\u2192        self,\n   363\u2192        args_spec: Any,\n   364\u2192        value: Union[\n   365\u2192            Var, EventHandler, EventSpec, List[Union[EventHandler, EventSpec]], Callable\n   366\u2192        ],\n   367\u2192    ) -> Union[EventChain, Var]:\n   368\u2192        \"\"\"Create an event chain from a variety of input types.\n   369\u2192\n   370\u2192        Args:\n   371\u2192            args_spec: The args_spec of the the event trigger being bound.\n   372\u2192            value: The value to create the event chain from.\n   373\u2192\n   374\u2192        Returns:\n   375\u2192            The event chain.\n   376\u2192\n   377\u2192        Raises:\n   378\u2192            ValueError: If the value is not a valid event chain.\n   379\u2192        \"\"\"\n   380\u2192        # If it's an event chain var, return it.\n   381\u2192        if isinstance(value, Var):\n   382\u2192            if value._var_type is not EventChain:\n   383\u2192                raise ValueError(f\"Invalid event chain: {value}\")\n   384\u2192            return value\n   385\u2192        elif isinstance(value, EventChain):\n   386\u2192            # Trust that the caller knows what they're doing passing an EventChain directly\n   387\u2192            return value\n   388\u2192\n   389\u2192        # If the input is a single event handler, wrap it in a list.\n   390\u2192        if isinstance(value, (EventHandler, EventSpec)):\n   391\u2192            value = [value]\n   392\u2192\n   393\u2192        # If the input is a list of event handlers, create an event chain.\n   394\u2192        if isinstance(value, List):\n   395\u2192            events: list[EventSpec] = []\n   396\u2192            for v in value:\n   397\u2192                if isinstance(v, EventHandler):\n   398\u2192                    # Call the event handler to get the event.\n   399\u2192                    try:\n   400\u2192                        event = call_event_handler(v, args_spec)\n   401\u2192                    except ValueError as err:\n   402\u2192                        raise ValueError(\n   403\u2192                            f\" {err} defined in the `{type(self).__name__}` component\"\n   404\u2192                        ) from err\n   405\u2192\n   406\u2192                    # Add the event to the chain.\n   407\u2192                    events.append(event)\n   408\u2192                elif isinstance(v, EventSpec):\n   409\u2192                    # Add the event to the chain.\n   410\u2192                    events.append(v)\n   411\u2192                elif isinstance(v, Callable):\n   412\u2192                    # Call the lambda to get the event chain.\n   413\u2192                    events.extend(call_event_fn(v, args_spec))\n   414\u2192                else:\n   415\u2192                    raise ValueError(f\"Invalid event: {v}\")\n   416\u2192\n   417\u2192        # If the input is a callable, create an event chain.\n   418\u2192        elif isinstance(value, Callable):\n   419\u2192            events = call_event_fn(value, args_spec)\n   420\u2192\n   421\u2192        # Otherwise, raise an error.\n   422\u2192        else:\n   423\u2192            raise ValueError(f\"Invalid event chain: {value}\")\n   424\u2192\n   425\u2192        # Add args to the event specs if necessary.\n   426\u2192        events = [e.with_args(get_handler_args(e)) for e in events]\n   427\u2192\n   428\u2192        # Collect event_actions from each spec\n   429\u2192        event_actions = {}\n   430\u2192        for e in events:\n   431\u2192            event_actions.update(e.event_actions)\n   432\u2192\n   433\u2192        # Return the event chain.\n   434\u2192        if isinstance(args_spec, Var):\n   435\u2192            return EventChain(\n   436\u2192                events=events,\n   437\u2192                args_spec=None,\n   438\u2192                event_actions=event_actions,\n   439\u2192            )\n   440\u2192        else:\n   441\u2192            return EventChain(\n   442\u2192                events=events,\n   443\u2192                args_spec=args_spec,\n   444\u2192                event_actions=event