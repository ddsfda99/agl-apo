rops.update(\n   554→            **{\n   555→                trigger: handler\n   556→                for trigger, handler in self.event_triggers.items()\n   557→                if trigger not in {EventTriggers.ON_MOUNT, EventTriggers.ON_UNMOUNT}\n   558→            },\n   559→            key=self.key,\n   560→            id=self.id,\n   561→            class_name=self.class_name,\n   562→        )\n   563→        props.update(self._get_style())\n   564→        props.update(self.custom_attrs)\n   565→\n   566→        # remove excluded props from prop dict before adding to tag.\n   567→        for prop_to_exclude in self._exclude_props():\n   568→            props.pop(prop_to_exclude, None)\n   569→\n   570→        return tag.add_props(**props)\n   571→\n   572→    @classmethod\n   573→    @lru_cache(maxsize=None)\n   574→    def get_props(cls) -> Set[str]:\n   575→        \"\"\"Get the unique fields for the component.\n   576→\n   577→        Returns:\n   578→            The unique fields.\n   579→        \"\"\"\n   580→        return set(cls.get_fields()) - set(Component.get_fields())\n   581→\n   582→    @classmethod\n   583→    @lru_cache(maxsize=None)\n   584→    def get_initial_props(cls) -> Set[str]:\n   585→        \"\"\"Get the initial props to set for the component.\n   586→\n   587→        Returns:\n   588→            The initial props to set.\n   589→        \"\"\"\n   590→        return set()\n   591→\n   592→    @classmethod\n   593→    @lru_cache(maxsize=None)\n   594→    def get_component_props(cls) -> set[str]:\n   595→        \"\"\"Get the props that expected a component as value.\n   596→\n   597→        Returns:\n   598→            The components props.\n   599→        \"\"\"\n   600→        return {\n   601→            name\n   602→            for name, field in cls.get_fields().items()\n   603→            if name in cls.get_props()\n   604→            and types._issubclass(field.outer_type_, Component)\n   605→        }\n   606→\n   607→    @classmethod\n   608→    def create(cls, *children, **props) -> Component:\n   609→        \"\"\"Create the component.\n   610→\n   611→        Args:\n   612→            *children: The children of the component.\n   613→            **props: The props of the component.\n   614→\n   615→        Returns:\n   616→            The component.\n   617→\n   618→        Raises:\n   619→            TypeError: If an invalid child is passed.\n   620→        \"\"\"\n   621→        # Import here to avoid circular imports.\n   622→        from reflex.components.base.bare import Bare\n   623→\n   624→        # Translate deprecated props to new names.\n   625→        new_prop_names = [\n   626→            prop for prop in cls.get_props() if prop in [\"type\", \"min\", \"max\"]\n   627→        ]\n   628→        for prop in new_prop_names:\n   629→            under_prop = f\"{prop}_\"\n   630→            if under_prop in props:\n   631→                console.deprecate(\n   632→                    f\"Underscore suffix for prop `{under_prop}`\",\n   633→                    reason=f\"for consistency. Use `{prop}` instead.\",\n   634→                    deprecation_version=\"0.4.0\",\n   635→                    removal_version=\"0.5.0\",\n   636→                    dedupe=False,\n   637→                )\n   638→                props[prop] = props.pop(under_prop)\n   639→\n   640→        # Filter out None props\n   641→        props = {key: value for key, value in props.items() if value is not None}\n   642→\n   643→        # Validate all the children.\n   644→        for child in children:\n   645→            # Make sure the child is a valid type.\n   646→            if not types._isinstance(child, ComponentChild):\n   647→                raise TypeError(\n   648→                    \"Children of Reflex components must be other components, \"\n   649→                    \"state vars, or primitive Python types. \"\n   650→                    f\"Got child {child} of type {type(child)}.\",\n   651→                )\n   652→\n   653→        children = [\n   654→            (\n   655→                child\n   656→                if isinstance(child, Component)\n   657→                else Bare.create(contents=Var.create(child, _var_is_string=True))\n   658→            )\n   659→            for child in children\n   660→        ]\n   661→\n   662→        return cls(children=children, **props)\n   663→\n   664→    def _add_style(self, style: dict):\n   665→        \"\"\"Add additional style to the component.\n   666→\n   667→        Args:\n   668→            style: A style dict to apply.\n   669→        \"\"\"\n   670→        self.style.update(style)\n   671→\n   672→    def _add_style_recursive(self, style: ComponentStyle) -> Component:\n   673→        \"\"\"Add additional style to the component and its children.\n   674→\n   675→        Args:\n   676→            style: A dict from component to styling.\n   677→\n   678→        Returns:\n   679→            The component with the additional style.\n   680→        \"\"\"\n   681→        component_style = None\n   682→        if type(self) in style:\n   683→            # Extract the style for this component.\n   684→            component_style = Style(style[type(self)])\n   685→        if self.create in style:\n   686→            component_style = Style(style[self.create])\n   687→        if component_style is not None:\n   688→            # Only add style props that are not overridden.\n   689→            component_style = {\n   690→                k: v for k, v in component_style.items() if k not in self.style\n   691→            }\n   692→\n   693→            # Add the style to the component.\n   694→            self._add_style(component_style)\n   695→\n   696→        # Recursively add style to the children.\n   697→        for child in self.children:\n   698→            # Skip BaseComponent and StatefulComponent children.\n   699→            if not isinstance(child, Component):\n   700→                cont