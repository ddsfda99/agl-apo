ot in [\n   795→                *self._valid_children,\n   796→                *allowed_components,\n   797→            ]:\n   798→                valid_child_list = \", \".join(\n   799→                    [f\"`{v_child}`\" for v_child in self._valid_children]\n   800→                )\n   801→                raise ValueError(\n   802→                    f\"The component `{comp_name}` only allows the components: {valid_child_list} as children. Got `{child_name}` instead.\"\n   803→                )\n   804→\n   805→            if child._valid_parents and comp_name not in [\n   806→                *child._valid_parents,\n   807→                *allowed_components,\n   808→            ]:\n   809→                valid_parent_list = \", \".join(\n   810→                    [f\"`{v_parent}`\" for v_parent in child._valid_parents]\n   811→                )\n   812→                raise ValueError(\n   813→                    f\"The component `{child_name}` can only be a child of the components: {valid_parent_list}. Got `{comp_name}` instead.\"\n   814→                )\n   815→\n   816→        for child in children:\n   817→            validate_child(child)\n   818→\n   819→    @staticmethod\n   820→    def _get_vars_from_event_triggers(\n   821→        event_triggers: dict[str, EventChain | Var],\n   822→    ) -> Iterator[tuple[str, list[Var]]]:\n   823→        \"\"\"Get the Vars associated with each event trigger.\n   824→\n   825→        Args:\n   826→            event_triggers: The event triggers from the component instance.\n   827→\n   828→        Yields:\n   829→            tuple of (event_name, event_vars)\n   830→        \"\"\"\n   831→        for event_trigger, event in event_triggers.items():\n   832→            if isinstance(event, Var):\n   833→                yield event_trigger, [event]\n   834→            elif isinstance(event, EventChain):\n   835→                event_args = []\n   836→                for spec in event.events:\n   837→                  