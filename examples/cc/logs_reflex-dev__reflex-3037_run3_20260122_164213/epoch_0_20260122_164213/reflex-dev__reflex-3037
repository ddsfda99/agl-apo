                elif isinstance(v, EventSpec):\n   409→                    # Add the event to the chain.\n   410→                    events.append(v)\n   411→                elif isinstance(v, Callable):\n   412→                    # Call the lambda to get the event chain.\n   413→                    events.extend(call_event_fn(v, args_spec))\n   414→                else:\n   415→                    raise ValueError(f\"Invalid event: {v}\")\n   416→\n   417→        # If the input is a callable, create an event chain.\n   418→        elif isinstance(value, Callable):\n   419→            events = call_event_fn(value, args_spec)\n   420→\n   421→        # Otherwise, raise an error.\n   422→        else:\n   423→            raise ValueError(f\"Invalid event chain: {value}\")\n   424→\n   425→        # Add args to the event specs if necessary.\n   426→        events = [e.with_args(get_handler_args(e)) for e in events]\n   427→\n   428→        # Collect event_actions from each spec\n   429→        event_actions = {}\n   430→        for e in events:\n   431→            event_actions.update(e.event_actions)\n   432→\n   433→        # Return the event chain.\n   434→        if isinstance(args_spec, Var):\n   435→            return EventChain(\n   436→                events=events,\n   437→                args_spec=None,\n   438→                event_actions=event_actions,\n   439→            )\n   440→        else:\n   441→            return EventChain(\n   442→                events=events,\n   443→                args_spec=args_spec,\n   444→                event_actions=event_actions,\n   445→            )\n   446→\n   447→    def get_event_triggers(self) -> Dict[str, Any]:\n   448→        \"\"\"Get the event triggers for the component.\n   449→\n   450→        Returns:\n   451→            The event triggers.\n   452→        \"\"\"\n   453→        default_triggers = {\n   454→            EventTriggers.ON_FOCUS: lambda: [],\n   455→            EventTriggers.ON_BLUR: lambda: [],\n   456→            EventTriggers.ON_CLICK: lambda: [],\n   457→            EventTriggers.ON_CONTEXT_MENU: lambda: [],\n   458→            EventTriggers.ON_DOUBLE_CLICK: lambda: [],\n   459→            EventTriggers.ON_MOUSE_DOWN: lambda: [],\n   460→            EventTriggers.ON_MOUSE_ENTER: lambda: [],\n   461→            EventTriggers.ON_MOUSE_LEAVE: lambda: [],\n   462→            EventTriggers.ON_MOUSE_MOVE: lambda: [],\n   463→            EventTriggers.ON_MOUSE_OUT: lambda: [],\n   464→            EventTriggers.ON_MOUSE_OVER: lambda: [],\n   465→            EventTriggers.ON_MOUSE_UP: lambda: [],\n   466→            EventTriggers.ON_SCROLL: lambda: [],\n   467→            EventTriggers.ON_MOUNT: lambda: [],\n   468→            EventTriggers.ON_UNMOUNT: lambda: [],\n   469→        }\n   470→        # Look for component specific triggers,\n   471→        # e.g. variable declared as EventHandler types.\n   472→        for field in self.get_fields().values():\n   473→            if types._issubclass(field.type_, EventHandler):\n   474→                default_triggers[field.name] = getattr(\n   475→                    field.type_, \"args_spec\", lambda: []\n   476→                )\n   477→        return default_triggers\n   478→\n   479→    def __repr__(self) -> str:\n   480→        \"\"\"Represent the component in React.\n   481→\n   482→        Returns:\n   483→            The code to render the component.\n   484→        \"\"\"\n   485→        return format.json_dumps(self.render())\n   486→\n   487→    def __str__(self) -> str:\n   488→        \"\"\"Represent the component in React.\n   489→\n   490→        Returns:\n   491→            The code to render the component.\n   492→        \"\"\"\n   493→        from reflex.compiler.compiler import _compile_component\n   494→\n   495→        return _compile_component(self)\n   496→\n   497→    def _apply_theme(self, theme: Optional[Component]):\n   498→        \"\"\"Apply the theme to this component.\n   499→\n