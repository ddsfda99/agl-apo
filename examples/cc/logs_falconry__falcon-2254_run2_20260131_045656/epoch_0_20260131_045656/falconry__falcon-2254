This typing is wrong on py311+, but mypy accepts it.\n    43→    #   It doesn't, OTOH, accept any of my ostensibly valid attempts to\n    44→    #   describe it.\n    45→    def __call__(self) -> _DummyRunner:\n    46→        # NOTE(vytas): Sometimes our runner's loop can get picked and consumed\n    47→        #   by other utilities and test methods. If that happens, recreate the runner.\n    48→        if self._runner.get_loop().is_closed():\n    49→            # NOTE(vytas): This condition is never hit on _DummyRunner.\n    50→            self._runner = self._runner_cls()  # pragma: nocover\n    51→        return self._runner\n    52→\n    53→\n    54→_active_runner = _ActiveRunner(getattr(asyncio, 'Runner', _DummyRunner))\n    55→_one_thread_to_rule_them_all = ThreadPoolExecutor(max_workers=1)\n    56→\n    57→create_task = asyncio.create_task\n    58→get_running_loop = asyncio.get_running_loop\n    59→\n    60→\n    61→def wrap_sync_to_async_unsafe(func: Callable[..., Any]) -> Callable[..., Any]:\n    62→    \"\"\"Wrap a callable in a coroutine that executes the callable directly.\n    63→\n    64→    This helper makes it easier to use synchronous callables with ASGI\n    65→    apps. However, it is considered \"unsafe\" because it calls the wrapped\n    66→    function directly in the same thread as the asyncio loop. Generally, you\n    67→    should use :func:`~.wrap_sync_to_async` instead.\n    68→\n    69→    Warning:\n    70→        This helper is only to be used for functions that do not perform any\n    71→        blocking I/O or lengthy CPU-bound operations, since the entire async\n    72→        loop will be blocked while the wrapped function is executed.\n    73→        For a safer, non-blocking alternative that runs the function in a\n    74→        thread pool executor, use :func:`~.sync_to_async` instead.\n    75→\n    76→    Arguments:\n    77→        func (callable): Function, method, or other callable to wrap\n    78→\n    79→    Returns:\n    80→        function: An awaitable coroutine function that wraps the\n    81→        synchronous callable.\n    82→    \"\"\"\n    83→\n    84→    @wraps(func)\n    85→    async def wrapper(*args: Any, **kwargs: Any) -> Callable[..., Any]:\n    86→        return func(*args, **kwargs)\n    87→\n    88→    return wrapper\n    89→\n    90→\n    91→def wrap_sync_to_async(\n    92→    func: Callable[..., Any], threadsafe: Optional[bool] = None\n    93→) -> Callable[..., Any]:\n    94→    \"\"\"Wrap a callable in a coroutine that executes the callable in the background.\n    95→\n    96→    This helper makes it easier to call functions that can not be\n    97→    ported to use async natively (e.g., functions exported by a database\n    98→    library that does not yet support asyncio).\n    99→\n   100→    To execute blocking operations safely, without stalling the async\n   101→    loop, the wrapped callable is scheduled to run in the background, on a\n   102→    separate thread, when the wrapper is called.\n   103→\n   104→    Normally, the default executor for the running loop is used to schedule the\n   105→    synchronous callable. If the callable is not thread-safe, it can be\n   106→    scheduled serially in a global single-threaded executor.\n   107→\n   108→    Warning:\n   109→        Wrapping a synchronous function safely adds a fair amount of overhead\n   110→        to the function call, and should only be used when a native async\n   111→        library is not available for the operation you wish to perform.\n   112→\n   113→    Arguments:\n   114→        func (callable): Function, method, or other callable to wrap\n   115→\n   116→    Keyword Arguments:\n   117→        threadsafe (bool): Set to ``False`` when the callable is not\n   118→            thread-safe (default ``True``). When this argument is ``False``,\n   119→            the wrapped callable will be scheduled to run serially in a\n   120→            global single-threaded executor.\n   121→\n   122→    Returns:\n   123→        function: An awaitable coroutine function that wraps the\n   124→        synchronous callable.\n   125→    \"\"\"\n   126→\n   127→    if threadsafe is None or threadsafe:\n   128→        executor = None  # Use default\n   129→    else:\n   130→        executor = _one_thread_to_rule_them_all\n   131→\n   132→    @wraps(func)\n   133→    async def wrapper(*args: Any, **kwargs: Any) -> Any:\n   134→        return await get_running_loop().run_in_executor(\n   135→            executor, partial(func, *args, **kwargs)\n   136→        )\n   137→\n   138→    return wrapper\n   139→\n   140→\n   141→async def sync_to_async(\n   142→    func: Callable[..., Any], *args: Any, **kwargs: Any\n   143→) -> Callable[..., Awaitable[Any]]:\n   144→    \"\"\"Schedule a synchronous callable on the default executor and await the result.\n   145→\n   146→    This helper makes it easier to call functions that can not be\n   147→    ported to use async natively (e.g., functions exported by a database\n   148→    library that does not yet support asyncio).\n   149→\n   150→    To execute blocking operations safely, without stalling the async\n   151→    loop, the wrapped callable is scheduled to run in the background, on a\n   152→    separate thread, when the wrapper is called.\n   153→\n   154→    The default executor for the running loop is used to schedule the\n   155→    synchronous callable.\n   156→\n   157→    Warning:\n   158→        This helper can only be used to execute thread-safe callables. If\n   159→        the callable is not thread-safe, it can be executed serially\n   160→        by first wrapping it with :func:`~.wrap_sync_to_async`, and then\n   161→        executing the wrapper directly.\n   162→\n   163→    Warning:\n   164→        Calling a synchronous function safely from an asyncio event loop\n   165→        adds a fair amount of overhead to the function call, and should\n   166→        only be used when a native async library is not av