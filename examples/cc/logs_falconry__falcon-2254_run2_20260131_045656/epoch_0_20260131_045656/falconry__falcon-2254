(default\n   238\u2192                1000). See also:\n   239\u2192                https://developer.mozilla.org/en-US/docs/Web/API/CloseEvent\n   240\u2192\n   241\u2192        \"\"\"\n   242\u2192\n   243\u2192        # NOTE(kgriffs): Do this first to be sure we clean things up\n   244\u2192        #   in the case that we are going to raise an error next.\n   245\u2192        await self._buffered_receiver.stop()\n   246\u2192\n   247\u2192        if code is None:\n   248\u2192            code = WSCloseCode.NORMAL\n   249\u2192        elif not isinstance(code, int):\n   250\u2192            raise ValueError('code must be an int')\n   251\u2192        elif code < 1000:\n   252\u2192            raise ValueError('Invalid close code. The value must be >= 1000')\n   253\u2192        elif 1015 <= code <= 1999 or 1004 <= code <= 1006:\n   254\u2192            raise ValueError('Invalid close code. Only unreserved codes may be used.')\n   255\u2192\n   256\u2192        # NOTE(kgriffs): Only do this after we validate the code, to avoid\n   257\u2192        #   masking errors.\n   258\u2192        if self.closed:\n   259\u2192            return\n   260\u2192\n   261\u2192        await self._asgi_send(\n   262\u2192            {\n   263\u2192                'type': EventType.WS_CLOSE,\n   264\u2192                'code': code,\n   265\u2192            }\n   266\u2192        )\n   267\u2192\n   268\u2192        self._state = _WebSocketState.CLOSED\n   269\u2192        self._close_code = code\n   270\u2192\n   271\u2192    async def send_media(\n   272\u2192        self,\n   273\u2192        media: object,\n   274\u2192        payload_type: WebSocketPayloadType = WebSocketPayloadType.TEXT,\n   275\u2192    ) -> None:\n   276\u2192        \"\"\"Send a serializable object to the client.\n   277\u2192\n   278\u2192        The payload type determines the media handler that will be used\n   279\u2192        to serialize the given object (see also: :ref:`ws_media_handlers`).\n   280\