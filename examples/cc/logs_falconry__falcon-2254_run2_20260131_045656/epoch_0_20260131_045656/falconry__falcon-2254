n receive queue. Falcon's queue can be disabled altogether by\n   528\u2192            setting `max_receive_queue` to ``0`` (see also: :ref:`ws_lost_connection`).\n   529\u2192\n   530\u2192    \"\"\"\n   531\u2192\n   532\u2192    __slots__ = ['error_close_code', 'max_receive_queue', 'media_handlers']\n   533\u2192\n   534\u2192    def __init__(self) -> None:\n   535\u2192        try:\n   536\u2192            import msgpack\n   537\u2192        except ImportError:\n   538\u2192            msgpack = None\n   539\u2192\n   540\u2192        bin_handler: media.BinaryBaseHandlerWS\n   541\u2192\n   542\u2192        if msgpack:\n   543\u2192            bin_handler = media.MessagePackHandlerWS()\n   544\u2192        else:\n   545\u2192            bin_handler = media.MissingDependencyHandler(\n   546\u2192                'default WebSocket media handler for BINARY payloads', 'msgpack'\n   547\u2192            )\n   548\u2192\n   549\u2192        self.media_handlers: Dict[\n   550\u2192            WebSocketPayloadType,\n   551\u2192            Union[media.TextBaseHandlerWS, media.BinaryBaseHandlerWS],\n   552\u2192        ] = {\n   553\u2192            WebSocketPayloadType.TEXT: media.JSONHandlerWS(),\n   554\u2192            WebSocketPayloadType.BINARY: bin_handler,\n   555\u2192        }\n   556\u2192\n   557\u2192        # Internal Error\n   558\u2192        #\n   559\u2192        #   See also: https://developer.mozilla.org/en-US/docs/Web/API/CloseEvent\n   560\u2192        #\n   561\u2192        self.error_close_code: int = WSCloseCode.SERVER_ERROR\n   562\u2192\n   563\u2192        # NOTE(kgriffs): The websockets library itself will buffer, so we keep\n   564\u2192        #   this value fairly small by default to mitigate buffer bloat. But in\n   565\u2192        #   the case that we have a large spillover from the websocket server's\n   566\u2192        #   own queue, increasing the queue length on our side may reduce the\n   567\u2192        #   number of pauses in t